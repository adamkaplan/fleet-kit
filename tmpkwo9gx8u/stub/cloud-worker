#!/usr/bin/python3
import json, os, sys
argv = sys.argv[1:]
log = os.environ["STUB_DIR"] + "/calls.log"
open(log, "a").write(json.dumps(argv) + "\n")
command, worker = argv[0], argv[1]
import hashlib
tf = os.environ.get("CW_CLOUD_TOKEN_FILE")
login = {"command": command, "argv": argv, "env": dict(os.environ), "token_ok": bool(tf) and hashlib.sha256(open(tf).read().encode()).hexdigest() == os.environ.get("STUB_TOKEN_SHA"),
         "token_mode": oct(os.stat(tf).st_mode & 0o777) if tf else None}
open(os.environ["STUB_DIR"] + "/login.log", "a").write(json.dumps(login) + "\n")
CREATE_OPTIONS = ("--repo", "--branch", "--idle", "--hard", "--max-hard", "--shape", "--image", "--stack", "--wait", "--pull-secret", "--run-secret-fd", "--run-id", "--password-fd", "--json")   # what the launcher's create knows (main, fb4b9f2)
if command == "create":
    unknown = [a for a in argv[2:] if a.startswith("--") and a not in CREATE_OPTIONS]
    if unknown:
        sys.stderr.write("error: unrecognized arguments: " + " ".join(unknown) + "\n")
        sys.exit(2)
    shape = argv[argv.index("--shape") + 1] if "--shape" in argv else "XS"
    if shape not in ("XS", "S", "M"):
        sys.stderr.write("error: shape must be XS, S or M\n")
        sys.exit(2)
if command == "create":
    for item in argv:
        if "=" in item and item.split("=")[0] in ("model-auth", "git-token"):
            fd = int(item.split("=")[1])
            open(os.environ["STUB_DIR"] + "/received-" + item.split("=")[0], "w").write(os.read(fd, 100000).decode())
    if os.environ.get("STUB_CREATE_FAIL"):
        every = [open(os.environ["STUB_DIR"] + "/received-" + n).read() for n in ("model-auth", "git-token")] + [open(tf).read()]
        sys.stderr.write(" | ".join(every) + "\n")
        sys.exit(3)
if command == "create":
    fd = int(argv[argv.index("--password-fd") + 1])
    os.write(fd, (os.environ["STUB_PASSWORD"] + "\n").encode())
    os.close(fd)
    print(json.dumps({"worker": worker, "url": os.environ["STUB_URL"], "auth_ref": "file:/etc/passwd", "runtime_id": "pod/%s-7f9c" % worker,
                      "idle_deadline": "2099-10-14T12:10:00Z", "hard_deadline": "2099-10-14T14:00:00Z"}))
elif command == "stop":
    code = int(os.environ.get("STUB_STOP_EXIT", "0"))
    if code:
        sys.stderr.write("push refused by the remote\n")
        sys.exit(code)
    print(json.dumps({"worker": worker, "runtime_id": "pod/%s-7f9c" % worker, "pushed": True, "wip_branch": worker + "/wip"}))
elif command == "status":
    print(json.dumps({"worker": worker, "runtime_id": "pod/%s-7f9c" % worker, "phase": "running", "cost_estimate_usd": 0.07}))
