{
  "version": 1,
  "areas": [
    {
      "name": "switchboard",
      "paths": [
        "bin/fleet-switchboard",
        "bin/fleet-switchboard.parts/**",
        "bin/switchboard/**",
        "bin/switchboard-trial",
        "bin/*.py",
        "bin/ci-test-files.txt",
        "bin/test-switchboard",
        "bin/test-path-suites",
        "bin/test-impact-brief",
        "bin/test-host-liveness",
        "shims/**",
        "tests/**",
        "tools/**",
        "docs/guard-set.json"
      ],
      "exclude": ["**/*.md", "bin/cloud_*.py", "bin/decisions_pull.py", "bin/fleet_health.py", "bin/health_records.py"],
      "steps": [
        {"name": "public-names", "cmd": "python3 bin/check-public-names"},
        {"name": "guard-set", "cmd": "tools/guard-set --run"},
        {"name": "suites-of-the-change", "cmd": "python3 bin/fleet-switchboard heavy --changed --base {base}"},
        {"name": "gh-hold", "cmd": "bin/test-gh-hold"}
      ]
    },
    {
      "name": "cloud",
      "paths": ["cloud/**", "bin/cloud_*.py", "bin/cloud-*", "bin/test-cloud-*", "bin/decisions_pull.py", "bin/test-decisions-pull", "bin/test-app-mint"],
      "exclude": ["**/*.md"],
      "steps": [
        {"name": "public-names", "cmd": "python3 bin/check-public-names"},
        {"name": "cloud-neutral-names", "cmd": "bin/test-cloud-neutral-names"},
        {"name": "cloud-worker", "cmd": "bin/test-cloud-worker"},
        {"name": "cloud-tests", "cmd": "env CLOUD_TEST_SKIP_DOCKER=1 cloud/tests/test-cloud"},
        {"name": "cloud-launcher", "cmd": "bin/test-cloud-launcher"},
        {"name": "suites-of-the-change", "cmd": "python3 bin/fleet-switchboard heavy --changed --base {base}"}
      ]
    },
    {
      "name": "doctor-heartbeat",
      "paths": [
        "bin/fleet-doctor*",
        "bin/fleet-heartbeat",
        "bin/heartbeat-ack",
        "bin/fleet_health.py",
        "bin/health_records.py",
        "bin/test-fleet-doctor*",
        "bin/test-heartbeat",
        "bin/test-health-records"
      ],
      "exclude": ["**/*.md"],
      "steps": [
        {"name": "public-names", "cmd": "python3 bin/check-public-names"},
        {"name": "heartbeat", "cmd": "bin/test-heartbeat"},
        {"name": "health-records", "cmd": "bin/test-health-records"},
        {"name": "fleet-doctor", "cmd": "bin/test-fleet-doctor"},
        {"name": "fleet-doctor-config", "cmd": "bin/test-fleet-doctor-config"},
        {"name": "fleet-doctor-heartbeat", "cmd": "bin/test-fleet-doctor-heartbeat"}
      ]
    },
    {
      "name": "plugins",
      "paths": ["plugins/**"],
      "exclude": ["**/*.md"],
      "steps": [
        {"name": "public-names", "cmd": "python3 bin/check-public-names"},
        {"name": "hooks", "cmd": "node --test plugins/fleet-hooks/index.test.mjs"},
        {"name": "decisions-tui", "cmd": "node --test plugins/fleet-decisions-tui/health.test.mjs plugins/fleet-decisions-tui/click.test.mjs plugins/fleet-decisions-tui/kind.test.mjs"}
      ]
    },
    {
      "name": "docs",
      "paths": ["docs/**", "skills/**", "agents/**", "*.md", "**/*.md"],
      "exclude": ["docs/guard-set.json"],
      "steps": [
        {"name": "public-names", "cmd": "python3 bin/check-public-names"},
        {"name": "doc-consistency", "cmd": "python3 bin/test-switchboard TestArchitectureDocument TestHygiene TestWorkerRulesInSkills TestSkillsSync TestCommissioningDocs TestReviewLawsStarterSet TestAgentDefinitions TestArchitectureSafetyNet"},
        {"name": "path-suites-docs", "cmd": "bin/test-path-suites -k TestSkillsAndDocs"},
        {"name": "cloud-docs-wording", "cmd": "python3 cloud/launcher/tests/test_cloud_docs_wording.py"}
      ]
    },
    {
      "name": "all",
      "paths": ["**"],
      "exclude": [
        "**/*.md",
        "bin/fleet-switchboard", "bin/fleet-switchboard.parts/**", "bin/switchboard/**", "bin/switchboard-trial", "bin/*.py", "bin/ci-test-files.txt",
        "bin/test-switchboard", "bin/test-path-suites", "bin/test-impact-brief", "bin/test-host-liveness",
        "shims/**", "tests/**", "tools/**", "docs/guard-set.json",
        "cloud/**", "bin/cloud-*", "bin/test-cloud-*", "bin/test-decisions-pull", "bin/test-app-mint",
        "bin/fleet-doctor*", "bin/fleet-heartbeat", "bin/heartbeat-ack", "bin/test-fleet-doctor*", "bin/test-heartbeat", "bin/test-health-records",
        "plugins/**", "docs/**", "skills/**", "agents/**"
      ],
      "steps": [
        {"name": "public-names", "cmd": "python3 bin/check-public-names"},
        {"name": "guard-set", "cmd": "tools/guard-set --run"},
        {"name": "scenario-validate", "cmd": "bin/fleet-scenario validate"},
        {"name": "scenario-coverage", "cmd": "bin/fleet-scenario coverage --enforce --through-pr 4"},
        {"name": "workflow-split", "cmd": "bin/test-workflow-split"}
      ]
    }
  ]
}
