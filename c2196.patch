+def plan_rows(event="pull_request", base="integration", draft=False, action="", prior_run="", prior_legs=None, head="abc123", text=None):
+    """Run the real plan script with the given prior run (the `prior` step's two outputs); return (the rows' os values, the job-summary text)."""
+    text = WORKFLOW.read_text() if text is None else text
+    start = text.index("          python3 - <<'PY'\n")
+    end = text.index("\n          PY\n", start)
+    run = "\n".join(l[10:] for l in text[start:end + len("\n          PY")].splitlines()) + "\n"
+    with tempfile.TemporaryDirectory() as tmp:
+        out, summary = os.path.join(tmp, "out.txt"), os.path.join(tmp, "summary.md")
+        open(out, "w").close()
+        open(summary, "w").close()
+        env = dict(os.environ, EVENT=event, BASE=base, DRAFT="true" if draft else "false", ACTION=action, GITHUB_OUTPUT=out, GITHUB_STEP_SUMMARY=summary,
