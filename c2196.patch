+        subprocess.run(["bash", "-c", run], cwd=tmp, env=env, check=True, capture_output=True)
+        line = [l for l in open(out).read().splitlines() if l.startswith("matrix=")][-1]
+        return sorted(r["os"] for r in json.loads(line[len("matrix="):])), open(summary).read()
+
+
+BOTH = ["macos-latest", "ubuntu-latest"]
+
+
