#!/usr/bin/env python3
"""A trial of the fleet switchboard you can sit in front of.

This is a thin wrapper for an isolated experiment: the pieces it puts into its profile come from the
same functions `fleet-switchboard install` uses (agents, skills, plugins, cli.json). A real user does not
run this: they follow INSTALL.md, whose Fleet Switchboard step runs `fleet-switchboard install`.

The Lab (bin/proof-switchboard) proves the system with a scripted model. The
trial is the same isolation with a real model: its own OpenCode v2 data, its own
config, its own switchboard state, and a herdr workspace of its own. Nothing
here reads or writes the live OpenCode, herdr or switchboard directories.

    switchboard-trial init  --repo OWNER/REPO --charter N   # once
    switchboard-trial login                                 # once: device login
    switchboard-trial up                                    # daemon, Chief of Staff, orchestrator
    switchboard-trial status
    switchboard-trial down

docs/switchboard-trial.md walks through what to try.
"""
import argparse
import getpass
import importlib.machinery
import importlib.util
import json
import os
import shlex
import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
REPO_ROOT = HERE.parent
DEFAULT_MODEL = "github-copilot/claude-sonnet-5.5"
SERVICE_PORT = 49380  # v2 manages one service per profile on a fixed port; the Lab holds 49374
WORKSPACE_LABEL = "Switchboard Trial"
KEY_NAME_PATTERN = "(_API_KEY|_SECRET|_PASSWORD|_ACCESS_KEY|_ACCESS_KEY_ID)$"
EXIT_OK, EXIT_ERROR = 0, 1


class TrialError(RuntimeError):
    pass


def load_proof():
    """bin/proof-switchboard, for the Lab machinery the trial reuses (install, herdr integration)."""
    loader = importlib.machinery.SourceFileLoader("proof_switchboard", str(HERE / "proof-switchboard"))
    spec = importlib.util.spec_from_loader("proof_switchboard", loader)
    module = importlib.util.module_from_spec(spec)
    sys.modules["proof_switchboard"] = module
    loader.exec_module(module)
    return module


def load_switchboard():
    """bin/fleet-switchboard, for the install functions the trial shares with `fleet-switchboard install`:
    one path puts the kit's agents, skills and plugins into a profile, whoever asks."""
    loader = importlib.machinery.SourceFileLoader("fleet_switchboard_install", str(HERE / "fleet-switchboard"))
    spec = importlib.util.spec_from_loader("fleet_switchboard_install", loader)
    module = importlib.util.module_from_spec(spec)
    sys.modules["fleet_switchboard_install"] = module
    loader.exec_module(module)
    return module


def trial_root():
    override = os.environ.get("FLEET_SWITCHBOARD_TRIAL_DIR")
    if override:
        return Path(override)
    base = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    return Path(base) / "fleet-switchboard-trial"


class Trial:
    def __init__(self, root=None):
        proof = load_proof()
        self.proof = proof
        self.sb = load_switchboard()
        self.root = Path(root or trial_root())
        self.lab = proof.Lab(str(self.root))  # the same layout as the Lab, a different root
        self.profile = Path(self.lab.profile)
        self.wrapper = Path(self.lab.wrapper)
        self.config_home = self.profile / "config"
        self.state_home = self.profile / "state"
        self.switchboard_config = self.config_home / "fleet-switchboard" / "config.json"
        self.switchboard_state = self.state_home / "fleet-switchboard"
        self.settings_file = self.root / "trial.json"
        self.work = self.root / "work"
        self.daemon_log = self.root / "daemon.log"
        self.fleet_bin = REPO_ROOT / "bin" / "fleet-switchboard"
        self.herdr_socket = self.live_herdr_socket()
        self.gh_config_dir = self.live_gh_config_dir()
        self.gh_bin = shutil.which("gh") or "gh"
        self.gh_user = self.settings().get("gh_user")  # the account the trial runs as, pinned at init

    @staticmethod
    def live_herdr_socket():
        """The running herdr's socket, read before the trial's XDG_CONFIG_HOME can hide it."""
        if os.environ.get("HERDR_SOCKET_PATH"):
            return os.environ["HERDR_SOCKET_PATH"]
        base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
        return os.path.join(base, "herdr", "herdr.sock")

    @staticmethod
    def live_gh_config_dir():
        """Where gh keeps its account list, read before the trial's XDG_CONFIG_HOME can hide it. The
        token itself stays in gh's own store; nothing is copied."""
        if os.environ.get("GH_CONFIG_DIR"):
            return os.environ["GH_CONFIG_DIR"]
        base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
        return os.path.join(base, "gh")

    def gh_token(self):
        """The pinned account's token, or None when no account is pinned or gh will not give one.
        `gh` serves whichever account is *active*, which can change under the trial between runs."""
        if not self.gh_user:
            return None
        done = subprocess.run([self.gh_bin, "auth", "token", "--user", self.gh_user], capture_output=True,
                              text=True, env=dict(os.environ, GH_CONFIG_DIR=self.gh_config_dir))
        return done.stdout.strip() or None

    def label_prefix(self):
        """The skill says the label prefix is what `whoami` answers: the OS user, not the GitHub handle."""
        return getpass.getuser()

    def ensure_repo_labels(self, repo, charter):
        """Create the labels the charter convention needs and put the orchestrator label on the charter.
        Idempotent (`--force` updates an existing label). Without them an orchestrator, correctly, will
        not make repo changes it was not asked for, and cannot mark its own charter."""
        prefix = self.label_prefix()
        env = dict(os.environ, GH_CONFIG_DIR=self.gh_config_dir, GH_TOKEN=self.gh_token() or "")
        wanted = ((prefix + ":orchestrator", "5319e7", "A charter: an orchestrator's standing job"),
                  (prefix + ":awaiting-cos", "fbca04", "Waiting on the Chief of Staff: it resolves or escalates"),
                  (prefix + ":awaiting-user", "d93f0b", "Blocked on the user: the fleet's only blocking channel"))
        steps = [["label", "create", name, "--repo", repo, "--color", color, "--description", text, "--force"]
                 for name, color, text in wanted]
        steps.append(["issue", "edit", str(charter), "--repo", repo, "--add-label", prefix + ":orchestrator"])
        for args in steps:
            done = subprocess.run([self.gh_bin] + args, capture_output=True, text=True, env=env)
            if done.returncode:
                raise TrialError("`gh %s` failed: %s" % (" ".join(args[:2]), (done.stderr or done.stdout).strip()))
        return [name for name, _, _ in wanted]

    def detect_gh_user(self):
        done = subprocess.run([self.gh_bin, "api", "user", "--jq", ".login"], capture_output=True, text=True,
                              env=dict(os.environ, GH_CONFIG_DIR=self.gh_config_dir))
        return done.stdout.strip() or None

    # -- settings

    def settings(self):
        try:
            return json.loads(self.settings_file.read_text())
        except (OSError, ValueError):
            return {}

    def save(self, data):
        self.settings_file.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n")

    def require_init(self):
        if not self.settings().get("repo"):
            raise TrialError("not set up: run `switchboard-trial init --repo OWNER/REPO --charter N` first")
        return self.settings()

    # -- environments

    def clean_env(self):
        """This process's environment minus any herdr pane identity: the daemon and the CLI
        are not running in a pane, and must never report as one."""
        env = dict(os.environ)
        for name in list(env):
            if name.startswith("HERDR_"):
                del env[name]
        return env

    def switchboard_env(self):
        """For fleet-switchboard: the trial's config and state, never the user's."""
        env = self.clean_env()
        env["XDG_CONFIG_HOME"] = str(self.config_home)
        env["XDG_STATE_HOME"] = str(self.state_home)
        env["HERDR_SOCKET_PATH"] = self.herdr_socket  # herdr finds its socket under XDG_CONFIG_HOME otherwise
        env["GH_CONFIG_DIR"] = self.gh_config_dir     # so does gh: under the trial's dir it is logged out
        token = self.gh_token()
        if token:  # the pinned account, in this process's environment only: never written anywhere
            env["GH_TOKEN"] = token
        env.pop("FLEET_SWITCHBOARD_LAB", None)
        return env

    def run_fleet(self, *args, check=True):
        done = subprocess.run([sys.executable, str(self.fleet_bin)] + list(args), env=self.switchboard_env(),
                              capture_output=True, text=True)
        if check and done.returncode:
            raise TrialError("fleet-switchboard %s failed: %s" % (" ".join(args), (done.stderr or done.stdout).strip()))
        return done

    def wrapper_run(self, *args, env=None, tty=False):
        kwargs = {} if tty else {"capture_output": True, "text": True}
        return subprocess.run([str(self.wrapper)] + list(args), env=env or self.clean_env(), **kwargs)

    # -- init

    def wrapper_text(self):
        return WRAPPER.format(root=self.root, fleet_bin=self.fleet_bin, kit_bin=HERE, kit_shims=REPO_ROOT / "shims", key_pattern=KEY_NAME_PATTERN,
                              gh=self.gh_bin, gh_config=self.gh_config_dir,
                              gh_user_flag="--user %s" % shlex.quote(self.gh_user) if self.gh_user else "")

    def init(self, repo, charter, model, gh_user=None):
        proof = self.proof
        self.gh_user = gh_user or self.detect_gh_user()
        if not self.gh_user or not self.gh_token():
            raise TrialError("cannot get a gh token for %r: log in with `gh auth login` or pass --gh-user"
                             % (self.gh_user,))
        for directory in (self.lab.v2_dir, self.lab.bin_dir, self.lab.opencode_config,
                          os.path.join(self.lab.opencode_config, "agents"),
                          os.path.join(self.lab.opencode_config, "plugins"), str(self.work),
                          str(self.switchboard_state.parent), str(self.config_home / "fleet-switchboard")):
            os.makedirs(directory, exist_ok=True)
        for name in ("config", "data", "state", "cache", "tmp", "home"):
            os.makedirs(self.profile / name, exist_ok=True)
        os.chmod(self.state_home, 0o700)
        report = {"v2": proof.ensure_v2(self.lab)}
        if proof.write_if_changed(str(self.wrapper), self.wrapper_text()):
            os.chmod(self.wrapper, 0o755)
            report["wrapper"] = "written"
        opencode_json = self.opencode_config(model)
        proof.write_if_changed(os.path.join(self.lab.opencode_config, "opencode.json"),
                               json.dumps(opencode_json, indent=2) + "\n")
        self.guarded(self.sb.install_agents, self.lab.opencode_config, model, REPO_ROOT)  # the same functions
        self.install_skills()                                                              # `fleet-switchboard install` calls
        report["decisions plugin"] = self.install_decisions_plugin()
        self.guarded(self.sb.install_hooks_plugin, self.lab.opencode_config, REPO_ROOT)
        done = self.wrapper_run("service", "set", "port", str(SERVICE_PORT))
        if done.returncode:
            raise TrialError("cannot set the service port: %s" % (done.stderr or done.stdout).strip())
        report["service port"] = SERVICE_PORT
        report["herdr home link"] = proof.ensure_home_link(self.lab)
        report["herdr integration"] = proof.ensure_herdr_integration(self.lab)
        self.write_gitconfig()
        herdr = shutil.which("herdr")
        gh = shutil.which("gh")
        if not herdr or not gh:
            raise TrialError("herdr and gh must be on PATH (herdr: %s, gh: %s)" % (herdr, gh))
        config = {
            "opencode": str(self.wrapper), "opencode_executable": self.lab.v2_bin,
            "launch_env": {"FLEET_SWITCHBOARD_LAB_PANE": "1"},
            "herdr": herdr, "gh": gh, "github_repos": [repo], "intent_repo": repo,
            "jev": {}, "shadow_judges": True, "classifier_mode": "act",
            "policy": {"enabled": True}, "poll_seconds": 5,
        }
        self.switchboard_config.write_text(json.dumps(config, indent=2, sort_keys=True) + "\n")
        self.save(dict(self.settings(), repo=repo, charter=charter, model=model, gh_user=self.gh_user))
        report["gh account"] = self.gh_user
        report["repo labels"] = ", ".join(self.ensure_repo_labels(repo, charter))
        report["switchboard config"] = str(self.switchboard_config)
        return report

    def guarded(self, function, *args):
        """Call one of the shared install functions; its refusals are this driver's errors."""
        try:
            return function(*args)
        except self.sb.InstallError as err:
            raise TrialError(str(err)) from None

    def skills_dir(self):
        return self.root / "skills"

    def opencode_config(self, model):
        """The trial's opencode.json. `skills.paths` is how the kit's skills reach the agents: v2 scans
        the real home for skills even under the trial's HOME, so the live fleet's (older) copy of a
        skill of the same name would otherwise win. A configured path is read after those and wins."""
        return {"$schema": "https://opencode.ai/config.json", "update": "disable", "share": "disabled",
                "model": model, "skills": {"paths": [str(self.skills_dir())]}}

    def install_skills(self):
        """Copy the kit's skills into the trial's own skills directory."""
        self.guarded(self.sb.install_skills, self.skills_dir(), REPO_ROOT)
        return self.sb.kit_skill_names(REPO_ROOT)

    def install_decisions_plugin(self):
        """Copy the Decisions TUI plugin into the trial profile and name its directory in cli.json, keeping
        every other plugin and key there. Idempotent. The wrapper (written by init) sets the environment
        variable the plugin reads. Nothing is restarted: a TUI loads plugins when it starts."""
        changed = self.guarded(self.sb.install_decisions_plugin, self.lab.opencode_config, REPO_ROOT)
        if self.wrapper.exists() and self.proof.write_if_changed(str(self.wrapper), self.wrapper_text()):
            os.chmod(self.wrapper, 0o755)  # an older trial's wrapper lacks FLEET_SWITCHBOARD_STATE, which the plugin reads
            changed = True
        return "installed" if changed else "unchanged"

    def decisions_plugin_status(self):
        """`installed`, `not installed`, or `out of date` (a file differs from the kit's), for `status`."""
        status = self.sb.decisions_plugin_status(self.lab.opencode_config, REPO_ROOT)
        return "out of date: run `switchboard-trial up`" if status == "out of date" else status

    def write_gitconfig(self):
        """git in an agent's shell (HOME is the trial's) pushes through gh's credential helper,
        which reads GH_TOKEN from the service's environment. No token is written anywhere."""
        text = ("[user]\n\tname = Fleet Trial\n\temail = fleet-trial@users.noreply.github.com\n"
                "[credential \"https://github.com\"]\n\thelper =\n\thelper = !gh auth git-credential\n")
        self.proof.write_if_changed(str(self.profile / "home" / ".gitconfig"), text)

    # -- login

    def logged_in(self):
        done = self.wrapper_run("auth", "list")
        return "copilot" in (done.stdout + done.stderr).lower()

    def model_problem(self, model):
        """None when v2 lists `model`, else a sentence naming the Copilot models it does list."""
        listed = self.wrapper_run("models").stdout.split()
        if model in listed:
            return None
        copilot = [m for m in listed if m.startswith("github-copilot/")]
        return "model %s is not available; v2 lists: %s" % (model, ", ".join(copilot) or "no Copilot models")

    # -- service and daemon

    def service_running(self):
        return self.wrapper_run("service", "status").stdout.strip().startswith("http")

    def ensure_service(self):
        """Start the v2 service if it is not running. A running one is left alone: the panes'
        TUIs are connected to it, and stopping it would cut them off mid-turn."""
        if self.service_running():
            return "already running"
        done = self.wrapper_run("service", "start")
        if done.returncode:
            raise TrialError("could not start the v2 service: %s" % (done.stderr or done.stdout).strip())
        return "started with the trial profile"

    def daemon_pid(self):
        try:
            pid = int((self.root / "daemon.pid").read_text())
            os.kill(pid, 0)
            return pid
        except (OSError, ValueError):
            return None

    def start_daemon(self):
        if self.daemon_pid():
            return "already running"
        with open(self.daemon_log, "ab") as log:
            proc = subprocess.Popen([sys.executable, str(self.fleet_bin), "run"], env=self.switchboard_env(),
                                    stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True)
        (self.root / "daemon.pid").write_text(str(proc.pid))
        time.sleep(2)
        if proc.poll() is not None:
            raise TrialError("the daemon exited at once; see %s" % self.daemon_log)
        return "started (pid %d)" % proc.pid

    def stop_daemon(self):
        pid = self.daemon_pid()
        if pid:
            os.kill(pid, signal.SIGTERM)
        return pid

    # -- workspace and agents

    def workspace_id(self, create=False):
        proof = self.proof
        for ws in proof.herdr("workspace", "list").get("workspaces") or []:
            if ws.get("label") == WORKSPACE_LABEL:
                return ws["workspace_id"]
        if not create:
            return None
        made = proof.herdr("workspace", "create", "--label", WORKSPACE_LABEL, "--cwd", str(self.work))
        ws = made.get("workspace") or made
        wid = ws.get("workspace_id")
        if not wid:
            raise TrialError("herdr did not create a workspace: %s" % json.dumps(made)[:200])
        # herdr gives a new workspace one empty shell pane. It is ours and is not an agent:
        # remember it, and `close_spare_pane` removes it once the agents have their own tabs.
        root = (made.get("root_pane") or {}).get("pane_id")
        if root:
            self.save(dict(self.settings(), spare_pane=root))
        return wid

    def close_spare_pane(self):
        """Close the empty shell pane herdr made with the workspace, if it is still there and
        the workspace has other panes. Only the pane recorded at creation is ever closed."""
        spare = self.settings().get("spare_pane")
        if not spare:
            return False
        panes = [p.get("pane_id") for p in
                 (self.proof.herdr("pane", "list", "--workspace", spare.split(":")[0]).get("panes") or [])]
        if spare in panes and len(panes) > 1:
            self.proof.herdr("pane", "close", spare)
        settings = self.settings()
        settings.pop("spare_pane", None)
        self.save(settings)
        return spare in panes and len(panes) > 1

    def checkout(self, repo):
        target = self.work / repo.split("/")[-1]
        if not (target / ".git").is_dir():
            done = subprocess.run(["gh", "repo", "clone", repo, str(target)], capture_output=True, text=True)
            if done.returncode:
                raise TrialError("cannot clone %s: %s" % (repo, done.stderr.strip()))
        return target

    def launched(self, name):
        done = self.run_fleet("pending", name, "--json", check=False)
        try:
            return bool(json.loads(done.stdout).get("observation"))
        except ValueError:
            return False

    def observation(self, name):
        """{"session", "pane", ...} for an agent a pane is running now, else None."""
        done = self.run_fleet("pending", name, "--json", check=False)
        try:
            return json.loads(done.stdout).get("observation")
        except ValueError:
            return None

    def latest_session(self, name):
        """The newest v2 session whose fleet name is `name`, whether or not any pane runs it. This is
        what lets a restart, or `up` after `down` or a reboot, keep the conversation."""
        done = self.wrapper_run("api", "GET", "/api/session", "--param", "limit=200")
        try:
            body = json.loads(done.stdout)
        except ValueError:
            return None
        sessions = body.get("data", body) if isinstance(body, dict) else body
        mine = [s for s in sessions or []
                if isinstance(s, dict) and ((s.get("metadata") or {}).get("fleet") or {}).get("name") == name]
        mine.sort(key=lambda s: (s.get("time") or {}).get("created") or 0)
        return mine[-1]["id"] if mine else None

    def resume(self, workspace, name, session):
        return json.loads(self.run_fleet("launch", name, "--resume", session, "--workspace", workspace).stdout)

    def close_pane(self, pane, workspace):
        """Close one agent pane, only if herdr says it is in the trial's workspace."""
        info = self.proof.herdr("pane", "get", pane)
        found = (info.get("pane") or info).get("workspace_id")
        if found != workspace:
            raise TrialError("refusing to close %s: it is in workspace %r, not the trial's %r" % (pane, found, workspace))
        self.proof.herdr("pane", "close", pane)

    def ensure_agent(self, name, workspace, directory, repo, charter, fresh=False):
        """Make sure `name` has a pane. A running one is left alone; one with a session but no pane is
        resumed on that session (unless `fresh`); only an agent that never existed is created."""
        if self.observation(name):
            return "already running"
        session = None if fresh else self.latest_session(name)
        if session:
            return "resumed session %s, pane %s" % (session, self.resume(workspace, name, session)["pane"])
        agent, role, extra, brief = agent_spec(name, repo, charter)
        return "created, pane %s" % self.launch(workspace, name, agent, role, directory, extra, brief)["pane"]

    def launch(self, workspace, name, agent, role, directory, extra=(), brief=None):
        args = ["launch", name, "--agent", agent, "--dir", str(directory), "--workspace", workspace, "--role", role]
        args += list(extra)
        if brief:
            path = self.root / ("brief-%s.md" % name)
            path.write_text(brief)
            args += ["--brief-file", str(path)]
        return json.loads(self.run_fleet(*args).stdout)


# The trial's wrapper: v2 confined to the trial profile. It differs from the Lab's in two
# ways: no model is scripted, and the agents are given the `gh` token (as GH_TOKEN) because
# they work on GitHub. The OpenRouter key and every other credential-shaped variable is removed.
WRAPPER = """#!/bin/sh
# Switchboard trial: OpenCode v2 confined to the trial profile.
# Written by `switchboard-trial init`. Never put this on the live PATH.
# The agents work on GitHub, and their shell runs in the pane's process (not the service), so
# every start of v2 asks gh for the token itself, from the user's real gh config, and
# before HOME is replaced below: on macOS gh finds its token in the login keychain via HOME. Nothing is
# stored: not in a file, not in launch_env, which lands in config.json.
GH_FOR_AGENTS=$(GH_CONFIG_DIR="{gh_config}" "{gh}" auth token {gh_user_flag} 2>/dev/null)
LAB="{root}"
export FLEET_SWITCHBOARD_TRIAL=1
export XDG_CONFIG_HOME="$LAB/profile/config" XDG_DATA_HOME="$LAB/profile/data"
export XDG_STATE_HOME="$LAB/profile/state" XDG_CACHE_HOME="$LAB/profile/cache"
export TMPDIR="$LAB/profile/tmp"
# XDG alone leaves `home` live: v2 would load the live fleet's skills.
export HOME="$LAB/profile/home"
export FLEET_SWITCHBOARD_BIN="{fleet_bin}"
# The Decisions TUI plugin reads decisions.json from here (the daemon runs with the same XDG_STATE_HOME).
export FLEET_SWITCHBOARD_STATE="$LAB/profile/state/fleet-switchboard"
# The fleet-hooks plugin puts this first on PATH of every agent shell: a gh that signs what agents say.
export FLEET_SWITCHBOARD_SHIMS="{kit_shims}"
# Agents run `fleet-switchboard send`; their shell finds it here.
export PATH="{kit_bin}:$PATH"
for name in $(env | sed -n 's/^\\([A-Za-z_][A-Za-z0-9_]*\\)=.*/\\1/p' \\
    | grep -E '{key_pattern}|^(GH|GITHUB|COPILOT)_'); do
  unset "$name"
done
[ -n "$GH_FOR_AGENTS" ] && export GH_TOKEN="$GH_FOR_AGENTS"
if [ "$FLEET_SWITCHBOARD_LAB_PANE" != "1" ]; then
  unset HERDR_ENV HERDR_PANE_ID HERDR_SOCKET_PATH HERDR_TAB_ID HERDR_WORKSPACE_ID
fi
exec "$LAB/v2/node_modules/@opencode/cli/bin/opencode.exe" "$@"
"""


# -- commands

CHIEF_BRIEF = None  # you talk to the Chief of Staff; it needs no opening brief
AGENT_ORDER = ("cos", "platform")

ORCHESTRATOR_BRIEF = """You are the orchestrator `platform`. Your charter is issue #{charter} in {repo}.
Read it with `gh issue view {charter} --repo {repo}`, then wait. The Chief of Staff (`cos`) will hand you asks
as sub-issues of your charter; messages from the switchboard carry each ask's Intent and Done when.
Report to `cos` with `fleet-switchboard send cos --issue <ask> "<text>"`. Do not type into panes.
"""


def agent_spec(name, repo, charter):
    """(opencode agent, role, extra launch args, opening brief) for a trial agent."""
    if name == "cos":
        return "chief-of-staff", "chief-of-staff", [], CHIEF_BRIEF
    if name == "platform":
        return ("orchestrator", "orchestrator",
                ["--reports-to", "cos", "--issue", str(charter), "--charter", str(charter)],
                ORCHESTRATOR_BRIEF.format(repo=repo, charter=charter))
    raise TrialError("unknown trial agent %r (they are: %s)" % (name, ", ".join(AGENT_ORDER)))


def cmd_init(trial, args):
    for name, value in (("--charter", args.charter),):
        if value < 1:
            raise TrialError("%s must be an issue number" % name)
    report = trial.init(args.repo, args.charter, args.model, args.gh_user)
    for key, value in report.items():
        print("%-22s %s" % (key, value))
    print("\nNext: switchboard-trial login")
    return EXIT_OK


def cmd_login(trial, args):
    trial.require_init()
    print("Starting the trial's own OpenCode login. Choose GitHub Copilot and follow the device-code steps.\n"
          "This stores the credential under %s only.\n" % trial.profile)
    subprocess.run([str(trial.wrapper), "service", "start"], env=trial.clean_env(), capture_output=True)
    code = trial.wrapper_run("auth", "login", "github-copilot", tty=True).returncode
    if code:
        print("\nIf that did not offer GitHub Copilot, run `%s auth login` and pick it by hand." % trial.wrapper)
        return code
    print("\nLogged in." if trial.logged_in() else "\nLogin finished, but Copilot is not listed; run `%s auth list`." % trial.wrapper)
    return EXIT_OK


def cmd_up(trial, args):
    settings = trial.require_init()
    if not trial.logged_in():
        raise TrialError("no GitHub Copilot login yet: run `switchboard-trial login`")
    if not os.environ.get("OPENROUTER_API_KEY"):
        print("warning: OPENROUTER_API_KEY is not set here, so the classifier and the judge will answer "
              "'unreachable' and change nothing. Export it in this shell and run `up` again to turn them on.")
    repo = settings["repo"]
    charter = settings["charter"]
    problem = trial.model_problem(settings["model"])
    if problem:
        raise TrialError(problem + " (change it with `init --model ...`)")
    print("%-22s %s" % ("v2 service", trial.ensure_service()))
    print("%-22s %s (a TUI picks the plugin up when it is restarted: `switchboard-trial restart`)"
          % ("decisions plugin", trial.install_decisions_plugin()))
    print("%-22s %s" % ("daemon", trial.start_daemon()))
    workspace = trial.workspace_id(create=True)
    directory = trial.checkout(repo)
    print("%-22s %s (%s)" % ("workspace", WORKSPACE_LABEL, workspace))
    for name in AGENT_ORDER:
        print("%-22s %s" % (name, trial.ensure_agent(name, workspace, directory, repo, charter, fresh=args.fresh)))
    trial.close_spare_pane()
    print("\nReady. Open the %r workspace in herdr and talk to `cos`. See docs/switchboard-trial.md." % WORKSPACE_LABEL)
    return EXIT_OK


def cmd_restart(trial, args):
    """Reopen agents on their EXISTING sessions: the conversation is kept, and the new process gets
    the wrapper's current environment (a refreshed token, new role files)."""
    trial.require_init()
    names = args.names or list(AGENT_ORDER)
    for name in names:
        agent_spec(name, "", 0)  # refuses an unknown name before anything is touched
    workspace = trial.workspace_id()
    if not workspace:
        raise TrialError("no %r workspace: run `switchboard-trial up`" % WORKSPACE_LABEL)
    print("%-22s %s" % ("v2 service", trial.ensure_service()))
    for name in names:
        seen = trial.observation(name)
        session = (seen or {}).get("session") or trial.latest_session(name)
        if not session:
            raise TrialError("%s has no session to restart: run `switchboard-trial up`" % name)
        if seen:
            trial.close_pane(seen["pane"], workspace)
        done = trial.resume(workspace, name, session)
        print("%-22s session %s, pane %s" % (name, session, done["pane"]))
    return EXIT_OK


def cmd_status(trial, args):
    settings = trial.settings()
    print("%-22s %s" % ("trial dir", trial.root))
    print("%-22s %s" % ("repo / charter", "%s #%s" % (settings.get("repo"), settings.get("charter"))))
    if trial.wrapper.exists():
        print("%-22s %s" % ("copilot login", "yes" if trial.logged_in() else "no"))
    print("%-22s %s" % ("daemon", "pid %s" % trial.daemon_pid() if trial.daemon_pid() else "not running"))
    print("%-22s %s" % ("decisions plugin", trial.decisions_plugin_status()))
    print("%-22s %s" % ("workspace", trial.workspace_id() or "none"))
    done = trial.run_fleet("status", check=False)
    print(done.stdout.rstrip() or done.stderr.rstrip())
    return EXIT_OK


def cmd_down(trial, args):
    pid = trial.stop_daemon()
    print("daemon: %s" % ("stopped" if pid else "was not running"))
    if trial.wrapper.exists():
        trial.wrapper_run("service", "stop")
        print("v2 service: stopped")
    print("The herdr workspace %r is left for you to close." % WORKSPACE_LABEL)
    return EXIT_OK


def build_parser():
    parser = argparse.ArgumentParser(prog="switchboard-trial", description=__doc__.split("\n\n")[0])
    sub = parser.add_subparsers(dest="action", required=True)
    init = sub.add_parser("init", help="Create the trial profile (once)")
    init.add_argument("--repo", required=True, help="OWNER/REPO holding the charter and asks")
    init.add_argument("--charter", type=int, required=True, help="The orchestrator's charter issue number")
    init.add_argument("--gh-user", dest="gh_user",
                      help="The gh account the agents and the daemon run as (default: the active one now)")
    init.add_argument("--model", default=DEFAULT_MODEL, help="provider/model for every agent (default %(default)s)")
    sub.add_parser("login", help="Log the trial's OpenCode into GitHub Copilot (interactive)")
    up = sub.add_parser("up", help="Start the service and daemon; launch or resume the Chief of Staff and the orchestrator")
    up.add_argument("--fresh", action="store_true", help="Create new sessions instead of resuming the existing ones")
    restart = sub.add_parser("restart", help="Reopen agents on their existing sessions (default: all)")
    restart.add_argument("names", nargs="*", help="Agent names: %s" % ", ".join(AGENT_ORDER))
    sub.add_parser("status", help="What is running")
    sub.add_parser("down", help="Stop the daemon and the v2 service")
    return parser


COMMANDS = {"init": cmd_init, "login": cmd_login, "up": cmd_up, "restart": cmd_restart, "status": cmd_status, "down": cmd_down}


def main(argv=None):
    args = build_parser().parse_args(argv)
    try:
        return COMMANDS[args.action](Trial(), args)
    except TrialError as err:
        sys.stderr.write("switchboard-trial: %s\n" % err)
        return EXIT_ERROR
    except KeyboardInterrupt:
        return EXIT_ERROR


if __name__ == "__main__":
    sys.exit(main())
