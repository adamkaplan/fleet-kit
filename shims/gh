def app_config():
    """(module, Config) when the owner maps any repository to the App, else None (the feature is off and nothing here runs). A config that names the App but cannot
    be trusted, or a module that cannot be loaded, refuses (AppMintRefused): never the stored login."""
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    try:
        with open(os.path.join(base, "fleet-switchboard", "config.json")) as handle:
            named = "app_installations" in handle.read()
    except FileNotFoundError:
        return None
    except Exception:
        named = True   # a config that cannot be read is not known to name no App mapping
    if not named:
        return None
    module = load_app()
    if module is None:
        raise AppMintRefused("gh: refused: the GitHub App module could not be loaded, so no call is made with the stored login")
    try:
        config = module.read_config()
    except module.ConfigError as err:
        raise AppMintRefused("gh: refused: the GitHub App configuration cannot be used (%s)" % _clean_reason(str(err)))
    return (module, config) if config is not None else None


def app_terminated(number, frame):
    for child in APP_CHILD:
        try:
            child.terminate()
        except OSError:
            pass
    sys.exit(128 + number)


def app_cleanup():
    while APP_DIRS:
        shutil.rmtree(APP_DIRS.pop(), ignore_errors=True)


def app_env(app, repo):
    """The environment for the real gh when `repo` is mapped to the App: the installation token as a private hosts.yml in GH_CONFIG_DIR (neither argv nor an
    environment value), every token variable removed. None when `repo` is not mapped. AppMintRefused when it is and no acceptable token can be had."""
    module, config = app
    if config.entry(repo) is None:
        return None
    try:
        token = module.token_for(config, repo)
        directory = module.write_hosts_dir(token)
    except (module.MintRefused, OSError) as err:
        raise AppMintRefused("gh: refused: no GitHub App token for %s (%s); the stored login is not used" % (_clean_reason(str(repo)), _clean_reason(str(err))))
    APP_DIRS.append(directory)
    for number in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(number, app_terminated)   # a killed shim still removes its token file (the finally in main)
    return module.child_env(directory)


def account_env(gh, lookup=None, strict=False, credential=False, args=None, read_repo=None):
    """The environment for the real gh with GH_TOKEN of the account that `gh_users` maps to the repo of the caller's RESOLVED
    identity (`fleet-switchboard whoami --json`: its session, never an inherited variable), the same map and the same
    `gh auth token --user` the daemon uses; so an inherited token never decides who an agent acts as. None leaves the
    environment as it is: no mapping, no switchboard (or one too old to answer), no repo, no token, the lookup deadline
    spent, any trouble. The token is only put in the child's environment: never printed, logged or put in argv."""
    app = None
    try:
        if read_repo:
            return read_account_env(gh, lookup, read_repo)
        users = config_users()
        words = command_words(args or [])
        app = app_config() if (credential or not words or words[0] not in APP_SKIP_GROUPS) and not (args and not words) else None   # `gh --version` makes no call
        if not users and app is None:
            return None   # no per-repository accounts are configured: nothing to bind to, whatever the caller is
        if not switchboard_binary():
            if credential:
                raise NoAccountMapped("this shell (no switchboard to say which repository it is)")
            if app is not None:
                raise AppMintRefused("gh: refused: the App is configured and no switchboard can say which repository this is, so the stored login is not used")
            return None
        lookup = lookup or Lookup()
        ident = lookup.identity()
        repo = ident.get("repo")
        if credential and ident.get("own") is False and not lookup.failed:
            # the caller has no repository of its own (`own` false: the repo is only the config's default). Nothing a git push names says which account it is for, and
            # the default repository's account is a guess that pushes as the wrong account: refuse. Nothing here reads a directory's remote.
            raise NoOwnRepository("this worker")
        if (not repo or ident.get("own") is False) and not lookup.failed:
            # a caller with no repo of its own (the Chief of Staff: whoami gives only the default `intent_repo`, own false) acts as the account of the
            # repo the command names; with nothing named it keeps the default repo's account as before
            repo = explicit_repo(args or []) or repo
        if not repo:
            if strict and lookup.failed:
                raise AccountLookupFailed("identity")
            if credential:
                raise NoAccountMapped("this shell (it has no repository identity)")
            if app is not None:
                raise AppMintRefused("gh: refused: the App is configured and this shell has no repository identity, so the stored login is not used")
            return None
        matcher = load_matcher()
        if matcher is None or matcher.normal_repo(repo) is None:
            if credential or strict:
                raise NoAccountMapped("repository %s" % _clean_reason(str(repo)))   # a repository that cannot be read is unmatched and refused, never defaulted
            return None
        if app is not None:
            if ident.get("own") is False and ident.get("role") != "chief-of-staff" and app[1].entry(repo) is not None:
                # no repository of its own AND not the Chief of Staff (by the RECORDED role; a missing role counts as not): the repository above is the default or the one the
                # command names, and neither is this caller's to write in
                raise AppMintRefused("gh: refused: only the Chief of Staff, by its recorded role, may act for a repository it does not own: %s is mapped to the App and this caller has no repository of its own" % _clean_reason(str(repo)))
            if ident.get("own") is not False:   # a caller WITH its own repository never gets another mapped repository's token by naming it (-R, a URL): refused, naming both
                named = explicit_repo(args or [])
                if named and matcher.normal_repo(named) is not None and matcher.normal_repo(named) != matcher.normal_repo(repo) and app[1].entry(named) is not None:
                    raise AppMintRefused("gh: refused: this worker's repository is %s and the command names %s, which is mapped to the App: a worker acts only for its own repository" % (_clean_reason(str(repo)), _clean_reason(str(named))))
            target = repo   # a caller with no repository of its own already has `repo` = the repository the command names (above)
            got_env = app_env(app, target)   # a repository mapped to the App uses its installation token and nothing else
            if got_env is not None:
                COUNT_ACCOUNT[0] = "app"
                return got_env
        account = matcher.account_for(users, repo)
        if not isinstance(account, str) or not account:
            if credential and users:
                raise NoAccountMapped("repository %s" % repo)
            return None
        COUNT_ACCOUNT[0] = account   # for the call counter: the account's NAME only
        clean = {k: v for k, v in os.environ.items() if k not in TOKEN_ENV_NAMES}
        got = lookup.run([gh, "auth", "token", "--user", account], stdin=subprocess.DEVNULL, env=clean)
        token = got.stdout.strip() if got is not None and got.returncode == 0 else ""
        if not token and strict:
            raise AccountLookupFailed("token")
        return dict(os.environ, GH_TOKEN=token) if token else None
    except (AccountLookupFailed, NoAccountMapped, AppMintRefused):
        raise
    except Exception as err:
        if read_repo:
            raise AppMintRefused("gh: refused: the account for reading %s could not be worked out (%s), so the fleet shim will not run it with the inherited or stored token" % (_clean_reason(str(read_repo)), type(err).__name__))   # #618: a read-only extra repository never falls through to any other token
        if credential:
            raise NoAccountMapped("this shell (its account could not be worked out)")   # the credential route never guesses: any trouble refuses
        if app is not None:
            raise AppMintRefused("gh: refused: the App is configured and the account could not be worked out, so the stored login is not used")
        return None


def _clean_reason(text):
    return "".join(c if 32 <= ord(c) < 127 else " " for c in text)[:120]


def my_name(lookup=None):
    """The calling agent's fleet name, or "agent": the name only says who, the signature is what matters."""
    try:
        return (lookup or Lookup()).identity().get("name") or "agent"
    except Exception:
        return "agent"


def sign(body, name):
    return body if SIGNED_RE.search(body) else body.rstrip("\n") + "\n\n" + MARK % name + "\n"


def body_flag(args):
    """(index, kind, inline) of the LAST body flag among args[2:]: kind "body" or "file"; inline is the
    value when it is part of the same argument (`--body=x`, `-bx`), else None (the value is args[index+1])."""
    found = None
    i = 2
    while i < len(args):
        arg = args[i]
        if arg == "--":
            break
        for names, kind in ((("--body", "-b"), "body"), (("--body-file", "-F"), "file")):
            for name in names:
                if arg == name:
                    found = (i, kind, None)
                elif arg.startswith(name + "=") or (not name.startswith("--") and arg.startswith(name) and len(arg) > 2
                                                    and not arg.startswith("--")):
                    found = (i, kind, arg[len(name) + 1:] if arg[len(name):len(name) + 1] == "=" else arg[len(name):])
        i += 1
    return found


def signed_call(args, name):
    """(new argv, stdin text or None, temp file to remove or None), or None when there is nothing to sign."""
    if len(args) < 3 or (args[0], args[1]) not in SIGNED_COMMANDS:
        return None
    flag = body_flag(args)
    if flag is None:
        return None
    index, kind, inline = flag
    value_at = index if inline is not None else index + 1
    value = inline if inline is not None else (args[index + 1] if index + 1 < len(args) else None)
    if value is None:
        return None
    new = list(args)
    if kind == "body":
        signed = sign(value, name)
        if inline is not None:
            new[index] = args[index].replace(value, signed, 1) if args[index].startswith("--") else args[index][:2] + signed
        else:
            new[value_at] = signed
        return new, None, None
    if value == "-":
        return new, sign(sys.stdin.read(), name), None
    try:
        with open(value, "r") as handle:
            text = handle.read()
    except OSError:
        return None
    handle, temp = tempfile.mkstemp(prefix="fleet-gh-", suffix=".md")
    with os.fdopen(handle, "w") as out:
        out.write(sign(text, name))
    if inline is not None:
        new[index] = args[index][:len(args[index]) - len(value)] + temp
    else:
        new[value_at] = temp
    return new, None, temp


# ---- the gate probe (plan-driven development: enforcing in a repo whose mode is enforce). docs/plan-gate-engine-design.md, E1 and E3.
#
# Before `gh pr ready` or `gh pr merge` of a PR the shim asks `fleet-switchboard gates-check <repo#N> --for ready|merge`, with
# its own time bound. Exit 10 (a refusal that applies in the repo's mode) stops the command: the one-line reason goes to stderr and
# the real gh does not run. Everything else (fail-open, timeout, a missing switchboard, a shape not understood, the kill switches,
# a valid waiver, a shadow repo) runs the real gh. In an enforcing repo a merge is bound to the checked head and --auto is refused.
# `gh pr create` has no PR number before it runs, so it is not probed here. The probe is skipped altogether for a repo that is
# not listed under `plan_gates` in the switchboard config, and for the switchboard's own gh calls (no recursion).
GATE_SECONDS = 3.0
GATE_SPOOL = "gate-failopen.jsonl"
GATE_SPOOL_LIMIT = 262144
BOOL_SHORT = {"pr merge": {"d": "--delete-branch", "m": "--merge", "r": "--rebase", "s": "--squash"}, "pr ready": {}}
BOOL_LONG = {"pr merge": {"--delete-branch", "--admin", "--auto", "--disable-auto", "--merge", "--rebase", "--squash"},
             "pr ready": set()}
VALUE_SHORT = {"R": "--repo", "b": "--body", "F": "--body-file", "A": "--author-email", "t": "--subject"}
VALUE_LONG = {"--repo", "--body", "--body-file", "--author-email", "--subject", "--match-head-commit"}
PR_URL_RE = re.compile(r"^https://github\.com/([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)/pull/([0-9]+)(?:/[^?#]*)?(?:[?#].*)?$")
MATCH_FLAG = "--match-head-commit"


def gate_seconds():
    try:
        return min(10.0, max(0.2, float(os.environ.get("FLEET_SHIM_GATE_SECONDS", GATE_SECONDS))))
    except ValueError:
        return GATE_SECONDS


def gate_parse(args):
    """Parse a `pr ready` or `pr merge` command line the way gh (cobra) does: `--flag value`, `--flag=value`, `-R value`,
    `-Rvalue`, combined short booleans (`-sd`), `--bool=false`. Returns None for a shape not understood (an unknown flag,
    `ready --undo`, `--`, more than one positional), else {"check", "repo", "ref", "auto", "match": [(start, stop, value)]}
    where `ref` is the positional argument or None, and each `match` span is the args slice of one --match-head-commit."""
    if len(args) < 2 or args[0] != "pr" or args[1] not in ("ready", "merge"):
        return None
    verb = "pr " + args[1]
    out = {"check": args[1], "repo": None, "ref": None, "auto": False, "match": []}
    positional, i = [], 2
    while i < len(args):
        arg = args[i]
        start = i
        if arg == "--" or arg == "-":
            return None
        value, name = None, None
        if arg.startswith("--"):
            name, eq, inline = arg.partition("=")
            if name in VALUE_LONG:
                if eq:
                    value, i = inline, i + 1
                else:
                    value, i = (args[i + 1] if i + 1 < len(args) else None), i + 2
            elif name in BOOL_LONG[verb]:
                if eq and inline.lower() not in ("true", "false", "1", "0", "t", "f"):
                    return None
                if name == "--auto":
                    out["auto"] = (not eq) or inline.lower() in ("true", "1", "t")
                i += 1
                continue
            else:
                return None
        elif arg.startswith("-"):
            letters, j = arg[1:], 0
            while j < len(letters):
                letter = letters[j]
                if letter in BOOL_SHORT[verb]:
                    j += 1
                    continue
                if letter in VALUE_SHORT:
                    name = VALUE_SHORT[letter]
                    rest = letters[j + 1:]
                    if rest:
                        value, i = rest[1:] if rest.startswith("=") else rest, i + 1
                    else:
                        value, i = (args[i + 1] if i + 1 < len(args) else None), i + 2
                    break
                return None
            else:
                i += 1
                continue
        else:
            positional.append(arg)
            i += 1
            continue
        if name == "--repo":
            if not value or not REPO_RE.match(value):
                return None
            out["repo"] = value
        elif name == MATCH_FLAG:
            out["match"].append((start, min(i, len(args)), value))
    if len(positional) > 1:
        return None
    out["ref"] = positional[0] if positional else None
    return out


def gate_run_gh(gh, argv, deadline, env):
    try:
        done = subprocess.run([gh] + argv, capture_output=True, text=True, timeout=max(0.05, deadline - time.time()),
                              stdin=subprocess.DEVNULL, env=env)
    except (subprocess.SubprocessError, OSError):
        return None
    return done.stdout.strip() if done.returncode == 0 else None


def gate_resolve(parsed, gh, env, deadline):
    """(repo, number) of the PR the real gh would act on, or (None, why). Never guesses: a repo comes from the PR URL, -R, GH_REPO,
    or the real gh's own answer for the current directory; a PR with no number (no argument, a branch name) is asked of the real gh."""
    ref = parsed["ref"]
    if ref is not None:
        url = PR_URL_RE.match(ref)
        if url:
            return url.group(1), int(url.group(2))
        if ref.isdigit() and int(ref) >= 1:
            repo = parsed["repo"] or os.environ.get("GH_REPO")
            if repo and not REPO_RE.match(repo):
                return None, "GH_REPO is not owner/repo"
            if not repo:
                if gh is None:
                    return None, "no real gh to ask which repo this directory is"
                repo = gate_run_gh(gh, ["repo", "view", "--json", "nameWithOwner", "-q", ".nameWithOwner"], deadline, env)
                if not repo or not REPO_RE.match(repo):
                    return None, "could not resolve the repo of this directory"
            return repo, int(ref)
    if gh is None:
        return None, "no real gh to ask"
    argv = ["pr", "view"] + ([ref] if ref is not None else [])
    repo = parsed["repo"] or os.environ.get("GH_REPO")
    if repo:
        if not REPO_RE.match(repo):
            return None, "GH_REPO is not owner/repo"
        argv += ["-R", repo]
    found = gate_run_gh(gh, argv + ["--json", "url", "-q", ".url"], deadline, env)
    url = PR_URL_RE.match(found or "")
    if not url:
        return None, "could not resolve the PR (%s)" % (ref or "the current branch")
    return url.group(1), int(url.group(2))


def gate_clean(text):
    """One printable line: control characters (terminal escapes) removed."""
    return "".join(ch for ch in str(text) if ch.isprintable()).strip()


def gate_repos():
    """The lower-cased repos listed under `plan_gates.repos` in the switchboard config; {} when none (then nothing is probed)."""
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    try:
        with open(os.path.join(base, "fleet-switchboard", "config.json")) as handle:
            repos = (json.load(handle).get("plan_gates") or {}).get("repos")
    except (OSError, ValueError, AttributeError):
        return set()
    return {str(name).lower() for name in repos} if isinstance(repos, dict) else set()


def gate_spool(event, repo, number, check, detail):
    """One line for the daemon to read later (best effort, never fails the command). The file is writable by any local
    process, so the daemon treats it as untrusted text: clipped, data only."""
    state = os.environ.get("FLEET_SWITCHBOARD_STATE") or os.path.join(
        os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state"), "fleet-switchboard")
    path = os.path.join(state, GATE_SPOOL)
    try:
        if os.path.isdir(state) and (not os.path.exists(path) or os.path.getsize(path) < GATE_SPOOL_LIMIT):
            line = json.dumps({"ts": int(time.time()), "event": event, "pr": "%s#%d" % (repo or "unknown", number or 0), "for": check,
                               "detail": str(detail)[:200]}, sort_keys=True)
            fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
            with os.fdopen(fd, "a") as out:
                out.write(line + "\n")
            return True   # written
    except OSError:
        pass
    return False


OVER_REVIEW_FLAG = "--over-review"


def take_over_review(args):
    """(args without --over-review, found, reason): `--over-review <reason>` or `--over-review=<reason>` on `pr merge` is the shim's own flag: it is
    stripped before the real gh sees it (gh would reject it)."""
    if len(args) < 2 or args[0] != "pr" or args[1] != "merge":
        return args, False, ""
    out, found, reason, i = [], False, "", 0
    while i < len(args):
        arg = args[i]
        if arg == OVER_REVIEW_FLAG:
            found = True
            nxt = args[i + 1] if i + 1 < len(args) else ""
            # the next word is the reason, unless it is a flag, a bare PR number or a PR URL (then it is the PR and the reason is missing)
            if nxt and not nxt.startswith("-") and not nxt.isdigit() and not PR_URL_RE.match(nxt):
                reason, i = nxt, i + 2
            else:
                i += 1
            continue
        if arg.startswith(OVER_REVIEW_FLAG + "="):
            found, reason, i = True, arg.split("=", 1)[1], i + 1
            continue
        out.append(arg)
        i += 1
    return out, found, " ".join(reason.split())


REVIEW_TAG_RE = re.compile(r"^\s*Review of ([0-9a-fA-F]{7,40})\s*[:\-]\s*(CHANGES[ _]REQUESTED|REQUEST[ _]CHANGES|APPROVED?)\b", re.I)
REVIEW_FROM_RE = re.compile(r"fleet-switchboard:from=([A-Za-z0-9_-]{1,32})")


def tagged_blockers(reviews, head):
    """Independent reviews in this fleet are posted as COMMENTED reviews (one shared account cannot request changes on its own PRs), so the real
    signal is the body's first line: `Review of <head sha>: CHANGES REQUESTED` or `APPROVE`. For each reviewer (login plus the `from=` tag a signed body
    carries) the LATEST tagged review AT THE PR'S CURRENT HEAD decides: CHANGES REQUESTED blocks until a later one at that head says APPROVE. A tag for
    another head, and any untagged comment, never blocks. Returns ["login/tag: CHANGES REQUESTED (Review of <sha>)"]."""
    if not isinstance(head, str) or len(head) < 7:
        return []
    latest = {}
    for review in reviews if isinstance(reviews, list) else []:
        if not isinstance(review, dict):
            continue
        body = review.get("body") if isinstance(review.get("body"), str) else ""
        first = body.strip().splitlines()[0] if body.strip() else ""
        found = REVIEW_TAG_RE.match(first)
        if not found:
            continue
        sha = found.group(1).lower()
        if not head.lower().startswith(sha):
            continue                                   # a verdict on another head says nothing about this one
        author = ((review.get("author") or {}).get("login")) if isinstance(review.get("author"), dict) else None
        tag = REVIEW_FROM_RE.search(body)
        key = "%s%s" % (author or "?", "/" + tag.group(1) if tag else "")
        word = found.group(2).upper().replace("_", " ")
        latest[key] = ("CHANGES REQUESTED", sha) if word.startswith(("CHANGES", "REQUEST")) else ("APPROVE", sha)
    return sorted("%s: CHANGES REQUESTED (Review of %s)" % (k, v[1][:8]) for k, v in latest.items() if v[0] == "CHANGES REQUESTED")


def review_blockers(reviews, head="", decision=""):
    """The reviewers whose latest decisive review (APPROVED, CHANGES_REQUESTED or DISMISSED; a plain comment is not decisive) is CHANGES_REQUESTED AND
    still blocks this head: it is at the PR's current head (its commit oid equals `head`), or its commit or the head is not known, or GitHub's
    `decision` (reviewDecision) is CHANGES_REQUESTED. A changes-requested review at an OLDER head is superseded by that reviewer's newer review of any
    kind (a comment included; this rule only) unless GitHub's decision still says CHANGES_REQUESTED; one at the CURRENT head is cleared only by that
    reviewer's later approval or dismissal, never by a comment, because several agents can share one login. Where GitHub gives no decision (no required
    reviews) an old-head review does not block: this is a guardrail, GitHub's branch protection is the boundary. `tagged_blockers` is separate."""
    latest = {}
    for review in reviews if isinstance(reviews, list) else []:
        if not isinstance(review, dict):
            continue
        author = ((review.get("author") or {}).get("login")) if isinstance(review.get("author"), dict) else None
        state = str(review.get("state") or "").upper()
        if author and state in ("APPROVED", "CHANGES_REQUESTED", "DISMISSED"):
            commit = review.get("commit") if isinstance(review.get("commit"), dict) else {}
            latest[author] = (state, commit.get("oid") if isinstance(commit.get("oid"), str) else "")
    blocked = str(decision or "").upper() == "CHANGES_REQUESTED"
    return sorted(who for who, (state, oid) in latest.items()
                  if state == "CHANGES_REQUESTED" and (blocked or not oid or not head or oid.lower() == head.lower()))


def review_probe(args, found, reason, lookup, gh):
    """For `gh pr merge` in ANY repo (`--admin` too): refuse while a reviewer's latest decisive review is CHANGES_REQUESTED (not dismissed, not
    superseded by that reviewer's later approval) or the switchboard holds a blocking `review record` at the PR's CURRENT head, naming them.
    `--over-review <reason>` (at least 10 characters) goes ahead on purpose and is spooled for the audit (who, PR, head, reason). FAIL MODE: a read
    that cannot be made (reviews API, switchboard) lets the merge through with one visible warning line: a flake never blocks, and is never silent.
    A GUARDRAIL against accidents, not a boundary: the real gh, an unrecognised flag shape (fail open) or `--over-review` with any reason bypasses it;
    the boundary is GitHub's branch protection / required reviews. The check reads the PR's head and the merge then runs unbound, so a push in
    between can land an unchecked head (a short, documented window; the enforcing gates bind `--match-head-commit` themselves). Returns the refusal text, or None."""
    try:
        if len(args) < 2 or args[0] != "pr" or args[1] != "merge":
            return None
        parsed = gate_parse(args)
        if parsed is None:
            sys.stderr.write("gh: review check skipped (the merge command shape was not understood)\n")
            return None
        deadline = time.time() + gate_seconds()
        env = None
        try:
            env = account_env(gh, lookup)
        except AppMintRefused as err:
            return str(err)   # mapped to the App and no token: refused, the stored login is never used for the read
        except Exception:
            env = None
        repo, number = gate_resolve(parsed, gh, env, deadline)
        if repo is None:
            sys.stderr.write("gh: review check skipped (%s)\n" % gate_clean(str(number)))
            return None
        raw = gate_run_gh(gh, ["pr", "view", str(number), "-R", repo, "--json", "reviews,headRefOid,reviewDecision"], deadline, env)
        try:
            data = json.loads(raw) if raw else None
        except ValueError:
            data = None
        if not isinstance(data, dict):
            sys.stderr.write("gh: review check skipped (the reviews of %s#%d could not be read): not checked\n" % (repo, number))
            return None
        head = data.get("headRefOid") if isinstance(data.get("headRefOid"), str) else ""
        blockers = ["%s: CHANGES_REQUESTED" % who for who in review_blockers(data.get("reviews"), head, data.get("reviewDecision"))]
        blockers += [gate_clean(b) for b in tagged_blockers(data.get("reviews"), head)]
        binary = switchboard_binary()
        if binary and head:
            done = lookup.run(sb_argv(binary, "review", "blockers", "%s#%d" % (repo, number), "--head", head), env=sb_env())
            if done is not None and done.returncode == 0:
                blockers += [gate_clean(line.strip()) for line in done.stdout.splitlines() if line.strip()][:5]
            else:
                sys.stderr.write("gh: review check: the switchboard's recorded verdicts could not be read: only GitHub's reviews were checked\n")
        elif not binary or not head:
            sys.stderr.write("gh: review check: the switchboard's recorded verdicts could not be read (no switchboard or no head): only GitHub's reviews were checked\n")
        if not blockers:
            return None
        names = "; ".join(blockers[:5])
        if found and len(reason) >= 10:
            who = lookup.identity().get("name") or "agent"
            shown = gate_clean(reason)[:100]   # the reason alone is clipped, so the head and the overridden reviews always fit the logged line
            logged = gate_spool("over_review", repo, number, "merge", "by %s at %s | over: %s | reason: %s" % (who, head[:12], names[:60], shown))
            if not logged:   # an override nobody can audit is not made
                return "gh: merge of %s#%d refused: blocking review(s): %s. The --over-review could not be logged (no writable switchboard state), so it was not made" % (
                    repo, number, names)
            sys.stderr.write("gh: merging %s#%d over a blocking review on purpose (%s); logged\n" % (repo, number, names))
            return None
        why = ("--over-review needs a reason of at least 10 characters" if found else
               "resolve them, or pass --over-review '<reason of at least 10 characters>' (it is logged)")
        return "gh: merge of %s#%d refused: blocking review(s): %s. %s" % (repo, number, names, why)
    except Exception:
        sys.stderr.write("gh: review check skipped (an unexpected error): not checked\n")
        return None


def gate_probe(args, lookup, gh=None):
    """Ask the switchboard whether this ready or merge is allowed. Returns None (run the real gh as given), ("refuse", line)
    (print the line, exit non-zero, do not run gh) or ("args", new_args) (run gh with these). Never raises: every doubt is a
    fail-open, recorded in the spool when the shim could not tell which PR it was. `gates-check` exits 10 only for a refusal that
    applies in the repo's mode, and the shim also requires the reply to say `enforce`, so a shadow repo never refuses here."""
    try:
        if len(args) < 2 or args[0] != "pr" or args[1] not in ("ready", "merge"):
            return None
        listed = gate_repos()
        if not listed:
            return None   # no plan_gates: nothing is probed and nothing is asked
        check = args[1]
        parsed = gate_parse(args)
        if parsed is None:
            gate_spool("fail_open", None, None, check, "shape not understood: not checked")
            return None
        binary = switchboard_binary()
        deadline = time.time() + gate_seconds()
        env = None
        if gh is not None:
            try:
                env = account_env(gh, lookup)
            except AppMintRefused as err:
                return ("refuse", str(err))
            except Exception:
                env = None
        repo, number = gate_resolve(parsed, gh, env, deadline)
        if repo is None:
            gate_spool("fail_open", None, None, check, number)   # `number` carries the reason here
            return None
        if repo.lower() not in listed:
            return None
        if not binary:
            gate_spool("fail_open", repo, number, check, "no switchboard to ask")
            return None
        try:
            done = subprocess.run(sb_argv(binary, "gates-check", "%s#%d" % (repo, number), "--for", check, "--json"),
                                  capture_output=True, text=True, timeout=gate_seconds(), stdin=subprocess.DEVNULL,
                                  env=sb_env())
        except subprocess.TimeoutExpired:
            gate_spool("fail_open", repo, number, check, "no answer within %gs" % gate_seconds())
            return None
        except (OSError, subprocess.SubprocessError) as err:
            gate_spool("fail_open", repo, number, check, "could not run gates-check: %s" % err)
            return None
        try:
            payload = json.loads(done.stdout)
            if not isinstance(payload, dict):
                payload = {}
        except ValueError:
            payload = {}
        if done.returncode not in (0, 10):
            gate_spool("fail_open", repo, number, check, "gates-check exited %d" % done.returncode)
            return None
        if payload.get("mode") != "enforce":
            if done.returncode == 10:
                gate_spool("fail_open", repo, number, check, "exit 10 without an enforce reply: not refused")
            return None
        if done.returncode == 10:
            message = gate_clean(str(payload.get("message") or "").splitlines()[0] if payload.get("message") else "")
            if not message:
                message = "fleet-switchboard: %s of %s#%d refused by the plan gates (no detail given)." % (check, repo, number)
            gate_spool("refused", repo, number, check, message)
            return ("refuse", message[:600])
        if check == "merge":
            return gate_bind_merge(args, parsed, repo, number, payload)
        return None
    except Exception:
        return None   # a probe must never stop a command


def gate_bind_merge(args, parsed, repo, number, payload):
    """In an enforcing repo the merge is bound to the head that was checked (a push between the check and the merge makes the
    real merge fail), and `--auto` is refused: it merges later, at a head nobody checked. Every --match-head-commit the caller
    gave (any spelling, repeated, empty or without a value) is dropped and replaced by one with the checked head; a caller value
    that names another head is refused."""
    ref = "%s#%d" % (repo, number)
    if parsed["auto"]:
        return ("refuse", "fleet-switchboard: merge of %s refused: --auto merges later at a head nobody checked while this repo enforces "
                          "the plan gates. Way out: merge when ready, with --match-head-commit <sha>." % ref)
    head = payload.get("head")
    if not isinstance(head, str) or not re.fullmatch(r"[0-9a-f]{40}", head):
        gate_spool("fail_open", repo, number, "merge", "no head to bind the merge to")
        return None
    for _, _, given in parsed["match"]:
        if given and given.strip().lower() != head:
            return ("refuse", "fleet-switchboard: merge of %s refused: --match-head-commit %s is not the head the gates were checked at (%s). "
                              "Way out: re-run with the current head." % (ref, gate_clean(given)[:40], head))
    new = list(args)
    for start, stop, _ in sorted(parsed["match"], reverse=True):
        del new[start:stop]
    return ("args", new + [MATCH_FLAG, head])


# ---- the merge gate (#962): the fleet's own merge queue. Before `gh pr merge` into a GATED branch of a repository listed under `merge_gate.repos` in the
# switchboard config, the shim asks `fleet-switchboard merge-gate <repo#N> --check --json`. That command decides everything (the owner's own terminal and a
# logged waiver of the chief of staff pass; any other caller needs a gate pass for the exact head and branch tip and the merge lock) and exits 10 to refuse.
# FAIL CLOSED for a listed repository: no switchboard, no answer in time or any exit but 0 and 10 refuses with one line. Nothing is asked for a repository that
# is not listed. A merge that goes through is bound to the checked head (`--match-head-commit`), `--auto` is refused, and the lock is released when the merge returns.
MERGE_GATE_SECONDS = 30.0
MG_HOME = None     # a test hook: a module attribute, never read from the environment (a worker's environment must not move the gate)
MG_BINARY = None   # the same, for the switchboard program asked


def merge_gate_seconds():
    try:
        return min(120.0, max(1.0, float(os.environ.get("FLEET_SHIM_MERGE_GATE_SECONDS", MERGE_GATE_SECONDS))))
    except ValueError:
        return MERGE_GATE_SECONDS


def mg_home():
    """The account's real home (the password database), not $HOME or $XDG_CONFIG_HOME: a worker cannot point the gate at an empty configuration."""
    if MG_HOME:
        return MG_HOME
    try:
        import pwd
        return pwd.getpwuid(os.getuid()).pw_dir
    except Exception:
        return None


def mg_binary():
    """The switchboard program the install linked, under the real home: never FLEET_SWITCHBOARD_BIN or anything else from the environment."""
    if MG_BINARY:
        return MG_BINARY
    home = mg_home()
    if not home:
        return None
    binary = os.path.realpath(os.path.join(home, ".local", "bin", "fleet-switchboard"))
    return binary if os.path.isfile(binary) and os.access(binary, os.X_OK) else None


ENV_ALLOW = ("LANG", "LC_ALL", "LC_CTYPE", "TMPDIR", "TERM", "HERDR_SOCKET_PATH",
             "HERDR_PANE_ID", "HERDR_TAB_ID", "HERDR_WORKSPACE_ID", "OPENCODE_SESSION_ID", "FLEET_SWITCHBOARD_ROLE", "FLEET_SWITCHBOARD_REPO")   # who the caller says it is: the switchboard verifies it against the session
ENV_PATH = "/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin:/opt/homebrew/bin"   # a fixed PATH: the caller's cannot choose the `python3` a switchboard script starts with


def sb_env():
    """The FIXED environment every switchboard the shim starts runs in, built from an ALLOW LIST and never by filtering the caller's: a fixed PATH, HOME as the
    account's real home, the locale and temp names, and the identity names the switchboard verifies against the session. Everything else the caller set
    (`PYTHON*`, `LD_*`, `DYLD_*`, `XDG_*`, `FLEET_SWITCHBOARD_*`, a made-up name) never reaches it, so a worker cannot hand the switchboard a library, a state
    directory or a configuration of its own. No marker is ever added (#1216)."""
    env = {"PATH": ENV_PATH}
    for name in ENV_ALLOW:
        if name in os.environ:
            env[name] = os.environ[name]
    home = mg_home()
    if home:
        env["HOME"] = home
    return env


def sb_argv(binary, *rest):
    """The command that starts the switchboard: when the program is a Python script (its first line names python) it is started as `<fixed python> -I <program>`
    (isolated: no `PYTHON*` variable and no user site are read), the python found on the FIXED path, never on the caller's; any other program is started as it is."""
    try:
        with open(binary, "rb") as handle:
            first = handle.readline(200)
        python = shutil.which("python3", path=ENV_PATH) if first.startswith(b"#!") and b"python" in first else None
    except OSError:
        python = None
    return ([python, "-I", binary] if python else [binary]) + list(rest)


def merge_gate_repos():
    """The lower-cased repos listed under `merge_gate.repos` in the config of the account's real home; empty when none (then nothing is asked)."""
    home = mg_home()
    if not home:
        return None   # no home: not known, the caller treats it as "cannot tell" and fails closed
    try:
        with open(os.path.join(home, ".config", "fleet-switchboard", "config.json")) as handle:
            section = json.load(handle).get("merge_gate")
    except FileNotFoundError:
        return set()
    except (OSError, ValueError, AttributeError):
        return None
    if section is None:
        return set()
    repos = section.get("repos", {}) if isinstance(section, dict) else None
    return {str(name).lower() for name in repos} if isinstance(repos, dict) else None   # a section that is there and malformed is not "nothing listed"


API_MERGE_RE = re.compile(r"^repos/([^/]+/[^/]+)/pulls/([0-9]+)/merge$", re.I)
API_WRITE_FLAGS = ("-f", "-F", "--field", "--raw-field", "--input")
GRAPHQL_MERGE_WORDS = ("mergePullRequest", "enablePullRequestAutoMerge")


VALUE_FLAGS = {"-R", "--repo", "--hostname", "-b", "--body", "-F", "--body-file", "-t", "--title", "--subject", "-A", "--author-email", "--match-head-commit",
               "-B", "--base", "-H", "--head", "--header", "--assignee", "--label", "--milestone", "--project", "--reviewer",
               "-q", "--jq", "--json", "-X", "--method", "-f", "--field", "--raw-field", "--input", "--cache", "--preview", "--state", "-S", "--search",
               "-L", "--limit", "--template"}
PR_VERBS = {"checkout", "checks", "close", "comment", "create", "diff", "edit", "list", "lock", "ready", "reopen", "review", "status", "unlock",
            "update-branch", "view", "revert", "merge", "help"}


def command_word_positions(args):
    """[(index, word)] of the command words: the arguments that are not flags and not the value of a flag that takes one. A flag may stand anywhere between the
    words (gh accepts `-R repo` and `--repo=repo` before the group, between the group and the verb, or after), so the verb is not at a fixed position."""
    out, i = [], 0
    while i < len(args):
        arg = args[i]
        if arg == "--":
            break
        if arg.startswith("-") and len(arg) > 1:
            i += 2 if arg in VALUE_FLAGS else 1
            continue
        out.append((i, arg))
        i += 1
    return out


def canonical_pr_merge(args):
    """`gh pr merge` written with a flag between its words (`pr -R repo merge N`, `-R repo pr merge N`) is the same call as `pr merge -R repo N`: it is
    returned in that one canonical form, which every check reads. A `pr` command whose second word is not a known verb but which has `merge` among its words
    (an unknown flag's value was taken for the verb) is also read as a merge: the shim would rather refuse than miss one. Anything else comes back unchanged."""
    words = command_word_positions(args)
    if len(words) < 2 or words[0][1] != "pr":
        return args
    merge = next((w for w in words[1:2] if w[1] == "merge"), None)
    if merge is None and words[1][1] not in PR_VERBS:
        merge = next((w for w in words[2:] if w[1] == "merge"), None)
    if merge is None:
        return args
    return ["pr", "merge"] + [a for i, a in enumerate(args) if i not in (words[0][0], merge[0])]


def resolve_dots(parts):
    """(segments, climbed): `.` dropped and `..` taking the segment before it away, as GitHub resolves a path; `climbed` is True when a `..` would go above the first
    segment (`repos`): such a path is never tied to a repository."""
    out, climbed = [], False
    for part in parts:
        if part == ".":
            continue
        if part == "..":
            if len(out) <= 1:
                climbed = True
            else:
                out.pop()
            continue
        out.append(part)
    return out, climbed


def api_path_parts(arg):
    """THE one normaliser of a `gh api` path, as GitHub reads it: percent-decoded (until stable), cut at a query string or fragment, repeated slashes collapsed, no leading
    or trailing slash, `.` and `..` segments resolved. Returns (path, climbed). Case is folded by the matchers (re.I), never here, so a repository keeps its spelling."""
    path = arg
    for _ in range(3):
        decoded = urllib.parse.unquote(path)
        if decoded == path:
            break
        path = decoded
    path = re.sub(r"/{2,}", "/", re.split(r"[?#]", path.replace("\\", "/"), 1)[0]).strip("/")
    parts, climbed = resolve_dots(path.split("/"))
    return "/".join(parts), climbed


def api_path(arg):
    return api_path_parts(arg)[0]


def merge_route(args):
    """Which merge route a command is, so the gate covers the class and not one spelling: ("pr", None) for `pr merge` (any shape), ("api", (repo, n)) for a
    write to `repos/R/pulls/N/merge`, ("api-unknown", why) for a merge-looking `gh api` whose pull request cannot be told (a placeholder, a variable,
    a query read from a file), ("graphql", None) for a GraphQL merge mutation, else None. Pure string analysis; nothing is run."""
    args = canonical_pr_merge(args)
    if len(args) >= 2 and args[0] == "pr" and args[1] == "merge":
        return ("pr", None)
    words = command_word_positions(args)
    if not words or words[0][1] != "api":
        return None
    rest = [a for i, a in enumerate(args) if i != words[0][0]]
    method, write, i = "GET", False, 0
    while i < len(rest):
        arg = rest[i]
        name, eq, inline = arg.partition("=")
        if arg in ("-X", "--method") or (eq and name == "--method"):
            method = (inline if eq else (rest[i + 1] if i + 1 < len(rest) else "")).upper()
        elif arg.startswith("-X") and len(arg) > 2:
            method = arg[2:].upper()
        elif name in API_WRITE_FLAGS or arg.startswith(("-f", "-F")):
            write = True
        i += 1
    text = " ".join(rest)
    if any(a == "graphql" for a in rest if not a.startswith("-")):
        if any(word in text for word in GRAPHQL_MERGE_WORDS) or "--input" in rest or "@" in text:
            return ("graphql", None)
        return None
    if method == "GET" and not write:
        return None
    for arg in rest:
        if arg.startswith("-"):
            continue
        path, climbed = api_path_parts(arg)
        if climbed and re.search(r"pulls/[^/]*/merge", urllib.parse.unquote(arg), re.I):
            return ("api-unknown", "the path of that merge call climbs above its repository")
        found = API_MERGE_RE.match(path)
        if found and not re.search(r"[{}$<>:]", found.group(1)):
            return ("api", (found.group(1), int(found.group(2))))
        if found or re.search(r"(^|/)pulls/[^/]*/merge", path, re.I):
            return ("api-unknown", "the pull request of that merge call cannot be told")
    return None


def mg_refuse(why):
    return ("refuse", "gh: %s (the merge gate fails closed; the owner's own terminal or a logged waiver of the chief of staff goes around it)" % why)


def merge_gate_probe(args, lookup, gh):
    """None (run as given), ("refuse", one line) or ("go", args, release_ref): the merge may run with these args; `release_ref` is the pull request whose lock is
    released when the merge returns (None when no lock was used). No environment variable lifts this check (the retired FLEET_SWITCHBOARD_OWN_GH is read nowhere
    in this file): the switchboard's own gh calls run the real gh by path and never reach this shim. Routes covered: `pr merge` in any shape (one the shim cannot parse is refused), `gh api` writes to
    `pulls/N/merge`, GraphQL merge mutations. Not covered, and said in the docs: an alias the shim cannot see, the web UI, a push to the branch."""
    try:
        args = canonical_pr_merge(args)
        route = merge_route(args)
        if route is None:
            return None
        listed = merge_gate_repos()
        if listed is not None and not listed:
            return None
        if listed is None:
            return mg_refuse("merge refused: the merge gate's configuration could not be read")
        kind = route[0]
        parsed, repo, number = None, None, None
        if kind == "graphql":
            return mg_refuse("a GraphQL merge mutation cannot be tied to a pull request while a repository is gated: use `gh pr merge`")
        if kind == "api-unknown":
            return mg_refuse("merge refused: %s" % route[1])
        deadline = time.time() + merge_gate_seconds()
        env = None
        if gh is not None:
            try:
                env = account_env(gh, lookup)
            except AppMintRefused as err:
                return ("refuse", str(err))
            except Exception:
                env = None
        if kind == "pr":
            parsed = gate_parse(args)
            if parsed is None:   # a shape the shim cannot parse: refused, unless it names a repository that is not gated
                named = next((args[i + 1] for i, a in enumerate(args[:-1]) if a in ("-R", "--repo") and REPO_RE.match(args[i + 1])), None)
                if named and named.lower() not in listed:
                    return None
                return mg_refuse("merge refused: the shape of this `pr merge` command was not understood")
            repo, number = gate_resolve(parsed, gh, env, deadline)
            if repo is None:
                return mg_refuse("merge refused: the pull request could not be resolved (%s)" % gate_clean(str(number)))
        else:
            repo, number = route[1]
        if repo.lower() not in listed:
            return None
        ref = "%s#%d" % (repo, number)
        binary = mg_binary()
        if not binary:
            return mg_refuse("merge of %s refused: the merge gate cannot be asked (no switchboard)" % ref)
        try:
            done = subprocess.run(sb_argv(binary, "merge-gate", ref, "--check", "--json"), capture_output=True, text=True, timeout=merge_gate_seconds(),
                                  stdin=subprocess.DEVNULL, env=sb_env())
        except (subprocess.SubprocessError, OSError):
            return mg_refuse("merge of %s refused: the merge gate did not answer in time; retry, or ask the chief of staff for a logged waiver" % ref)
        try:
            payload = json.loads(done.stdout.strip().splitlines()[-1]) if done.stdout.strip() else {}
        except ValueError:
            payload = {}
        if not isinstance(payload, dict):
            payload = {}
        if done.returncode == 10:
            reason = (payload.get("reason") or done.stderr or "").strip().splitlines()
            line = gate_clean(reason[0] if reason else "")
            if line and not line.startswith("merge of"):
                line = "merge of %s refused: %s" % (ref, line)
            return ("refuse", "gh: " + (line or "merge of %s refused by the merge gate" % ref)[:400])
        if done.returncode != 0 or payload.get("allowed") is not True:
            return mg_refuse("merge of %s refused: the merge gate could not decide (exit %d)" % (ref, done.returncode))
        head = payload.get("head")
        if not isinstance(head, str) or not re.fullmatch(r"[0-9a-f]{40}", head):
            return mg_refuse("merge of %s refused: the merge gate gave no head to bind the merge to" % ref)
        release = ref if payload.get("locked") is True else None
        if kind == "api":
            return ("go", args, release)
        bound = gate_bind_merge(args, parsed, repo, number, {"head": head})
        if bound is None or bound[0] == "refuse":
            return ("refuse", bound[1] if bound else "gh: merge of %s refused: the merge could not be bound to the checked head" % ref)
        return ("go", bound[1], release)
    except Exception:
        return mg_refuse("merge refused: the merge gate hit an unexpected error")


def merge_gate_release(ref):
    """Release the merge lock of `ref` (best effort: a lock that is not released is recovered by its lease)."""
    try:
        binary = mg_binary()
        if binary:
            subprocess.run(sb_argv(binary, "merge-gate", ref, "--release"), capture_output=True, text=True, timeout=merge_gate_seconds(),
                           stdin=subprocess.DEVNULL, env=sb_env())
    except Exception:
        pass


HOLD_MODULE = [None, False]   # (module, tried): gh_hold.py beside this file, loaded by path (a plain `import` would need a package)


def load_hold():
    """The hold-label and audit module, or None when it cannot be loaded."""
    if not HOLD_MODULE[1]:
        HOLD_MODULE[1] = True
        try:
            path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "gh_hold.py")
            spec = importlib.util.spec_from_file_location("gh_hold", path)
            module = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(module)
            HOLD_MODULE[0] = module
        except Exception:
            HOLD_MODULE[0] = None
    return HOLD_MODULE[0]


RETRY_HOLD = "gh: hold-label check failed, retry (the fleet shim hit an unexpected error and refuses this write rather than let it through)"


def hold_probe(args, lookup, gh, write):
    """(refusal text or None, repo or None, number or None): see gh_hold.py. A missing or broken module refuses a WRITE while the config names a hold
    (fail closed) and is otherwise silent; that fallback re-reads the config text itself (a missing file means nothing is configured, any other read
    error counts as naming a hold). Any other unexpected error in the probe refuses a write and lets a read run. The label read uses the account the write would use."""
    try:
        module = load_hold()
        if module is None:
            try:
                with open(os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config"),
                                       "fleet-switchboard", "config.json")) as handle:
                    named = "hold_labels" in handle.read()
            except FileNotFoundError:
                named = False
            except Exception:
                named = True                      # a config that cannot be read is not known to name no hold: a write is refused
            return ("gh: the hold-label check could not be loaded, retry (the fleet shim refuses this write rather than let it through)"
                    if named and write else None), None, None
        env = None
        try:
            env = account_env(gh, lookup, args=args)
        except AppMintRefused as err:
            return str(err), None, None
        except Exception:
            env = None
        got = module.check(args, module.Ctx(gh, env, lambda: lookup.identity().get("name"), write))
        return got.refusal, got.repo, got.number
    except Exception:
        # an unexpected error in this glue (the check itself never raises): a WRITE is refused, a read runs
        return (RETRY_HOLD if write else None), None, None


def audit_write(args, lookup, outcome, write, repo=None, number=None):
    """One audit line for a gh write (never a command line); best effort, never changes the command."""
    try:
        if not write or is_git_credential(args):
            return
        module = load_hold()
        if module is not None:
            module.write_audit(args, my_name(lookup), outcome, repo, number)
    except Exception:
        pass


def refusal_text(err):
    """The one line a refused credential request says. A worker with no repository of its own gets the fix by name; any other refusal names the repository."""
    if isinstance(err, NoOwnRepository):
        return ("gh: this worker has no repository of its own (it was launched without --repo and its working directory had no usable origin), so git cannot "
                "authenticate as a guess: the default repository's account is never used. Relaunch it with `fleet-switchboard launch ... --repo OWNER/NAME`\n")
    return "gh: no GitHub account is mapped for %s: git cannot authenticate as a guess (add the repository or its owner to gh_users)\n" % _clean_reason(str(err))


SHARED_TEMP_DIRS = ("/tmp", "/private/tmp")


def shared_body_file(args, env=None):
    """The --body-file / -F path (absolute) whose PARENT directory is a shared temp directory, else None. String analysis only: the path is
    never opened, stat'ed or read, and '..' is folded lexically. The shared directories are /tmp, /private/tmp and the parent of this
    agent's own TMPDIR (the profile's shared temp root, which the launch exports as FLEET_AGENT_TMPDIR). Fails open: any error is None."""
    try:
        env = os.environ if env is None else env
        if not args or args[0] == "api":   # `gh api -F key=value` is a field, not a file
            return None
        shared = {posixpath.normpath(d) for d in SHARED_TEMP_DIRS}
        own = env.get("FLEET_AGENT_TMPDIR") or ""
        if own.startswith("/") and posixpath.normpath(own) != "/":
            shared.add(posixpath.dirname(posixpath.normpath(own)))
        i = 0
        while i < len(args):
            arg = args[i]
            if arg == "--":
                return None
            value = None
            if arg in ("--body-file", "-F"):
                value = args[i + 1] if i + 1 < len(args) else None
            elif arg.startswith("--body-file="):
                value = arg[len("--body-file="):]
            elif arg.startswith("-F") and not arg.startswith("--"):
                value = arg[2:].lstrip("=") if arg[2:3] == "=" else arg[2:]
            if value is not None and value.startswith("/"):
                if posixpath.dirname(posixpath.normpath(value)) in shared:
                    return value
            i += 1
    except Exception:
        return None
    return None


def warn_shared_body_file(args):
    """One stderr line when a body file sits directly in a shared temp directory (#767). Never refuses, never changes anything."""
    try:
        path = shared_body_file(args)
        if path:
            sys.stderr.write("gh: warning: %s is directly in a shared temp directory, where another agent can write the same name: put it under $TMPDIR "
                             "(for example $TMPDIR/body.md, or a directory from `mktemp -d`)\n" % re.sub(r"[^\x20-\x7e]", "?", path)[:200])
    except Exception:
        pass


def main(args):
    try:
        return run(args)
    finally:
        app_cleanup()   # a token file made for this call never outlives it


def run(args):
    gh = real_gh()
    if gh is None:
        sys.stderr.write("gh: not found on PATH (the fleet shim found no real gh behind it)\n")
        return 127
    plan = None
    warn_shared_body_file(args)
    args = canonical_pr_merge(args)   # THE one parse of the call shape: every probe below (hold, review, plan gate, merge gate) reads the same canonical `pr merge` (#962)
    args, over_found, over_reason = take_over_review(args)   # the shim's own flag never reaches gh or the signing
    write = is_write(args)
    lookup = Lookup(write=write)   # one identity lookup, one deadline, for the name and the account together
    scope = read_scope(args, lookup, write)   # a worker with a read-only extra repository (#618): refused here, or told which repository to read as
    if scope is not None and scope[0] == "refuse":
        sys.stderr.write(scope[1].strip() + "\n")
        audit_write(args, lookup, "refused", write)
        return 1
    held, hold_repo, hold_number = hold_probe(args, lookup, gh, write)   # a hold label refuses before anything else is asked (#376)
    if held:
        sys.stderr.write(held.strip() + "\n")
        audit_write(args, lookup, "refused", write, hold_repo, hold_number)
        return 1
    try:
        plan = signed_call(args, my_name(lookup)) if len(args) >= 3 and (args[0], args[1]) in SIGNED_COMMANDS else None
    except Exception:
        plan = None  # never let signing stop the command
    refusal = review_probe(args, over_found, over_reason, lookup, gh)
    if refusal is not None:
        sys.stderr.write(refusal + "\n")
        audit_write(args, lookup, "refused", write, hold_repo, hold_number)
        return 10
    verdict = gate_probe(args, lookup, gh)
    if verdict is not None and verdict[0] == "refuse":
        sys.stderr.write(gate_clean(verdict[1]) + "\n")
        audit_write(args, lookup, "refused", write, hold_repo, hold_number)
        return 10
    if verdict is not None:
        args = verdict[1]
    merged = merge_gate_probe(args, lookup, gh)
    release_ref = None
    if merged is not None and merged[0] == "refuse":
        sys.stderr.write(gate_clean(merged[1]) + "\n")
        audit_write(args, lookup, "refused", write, hold_repo, hold_number)
        return 10
    if merged is not None:
        args, release_ref = merged[1], merged[2]
    credential = is_git_credential(args)
    extra = {"credential": True} if credential else {}   # only the git credential route passes the keyword: every other call is exactly as it was
    if scope is not None:
        extra["read_repo"] = scope[1]
    try:
        env = account_env(gh, lookup, strict=is_write(args), args=args, **extra)
    except NoAccountMapped as err:
        sys.stderr.write(refusal_text(err))
        return 1
    except AppMintRefused as err:
        sys.stderr.write(str(err) + "\n")
        audit_write(args, lookup, "refused", write, hold_repo, hold_number)
        return 1
    except AccountLookupFailed:
        try:
            env = account_env(gh, Lookup(write=True), strict=True, args=args, **extra)   # retry the lookup ONCE with a fresh deadline
        except NoAccountMapped as err:
            sys.stderr.write(refusal_text(err))
            return 1
        except AppMintRefused as err:
            sys.stderr.write(str(err) + "\n")
            return 1
        except AccountLookupFailed:
            sys.stderr.write("gh: account lookup failed, retry (the fleet shim could not find which GitHub account this write is for, and will not "
                             "fall back to the inherited token)\n")
            audit_write(args, lookup, "refused", write, hold_repo, hold_number)
            return 1
    audit_write(args, lookup, "passed", write, hold_repo, hold_number)
    warn_text(args)
    served = None
    agent = None
    try:
        words = command_words(args)
        if words and words[0] not in NO_NETWORK_GROUPS:
            ident = lookup.identity() if (write or cacheable_read(args)) else {}
            agent = ident.get("name")
            if write:
                cache_drop(agent)   # a write by this agent: its cached answers go before the write runs
            account = COUNT_ACCOUNT[0] or "default"
            low = budget_low(account)
            if low is not None:
                warn_low(account, low)
            if not write and plan is None and not APP_DIRS:
                served = cached_read(gh, env, args, agent, account, low)
    except Exception:
        served = None   # the cache never fails the command
    if served is not None:
        return served
    if not write and command_words(args) and command_words(args)[0] not in NO_NETWORK_GROUPS:
        low_budget_read(agent)   # only a READ that reaches GitHub (not a write, not a cached answer): the top spender's message, and its bounded wait
    count_call(args)
    if plan is None and release_ref:   # a merge under the lock: the lock is released when the merge returns, whatever it returned
        try:
            return subprocess.run([gh] + args, env=env).returncode
        finally:
            merge_gate_release(release_ref)
    if plan is None:
        if APP_DIRS:   # a token file has to be removed after the call: gh runs as a child, not in place of this process
            child = subprocess.Popen([gh] + args, env=env)
            APP_CHILD.append(child)
            return child.wait()
        if env is not None:
            os.execve(gh, [gh] + args, env)
        os.execv(gh, [gh] + args)
    argv, stdin_text, temp = plan
    try:
        done = subprocess.run([gh] + argv, input=stdin_text, text=True if stdin_text is not None else None, env=env)
        if write:
            cache_mark(lookup.identity().get("name"))   # the write has ended (an exec'd write cannot say so: the grace window covers it)
        return done.returncode
    finally:
        if temp:
            try:
                os.unlink(temp)
            except OSError:
                pass


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
