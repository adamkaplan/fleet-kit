#!/usr/bin/env python3
"""gh, signing what an agent says on GitHub.

The agents share one GitHub account, so an event's author cannot say who wrote a
comment, and each comment an agent posted came back to it as a wake. The
switchboard drops anything signed with an HTML comment (`<!-- fleet-switchboard:
from=NAME -->`, invisible when GitHub renders it). This shim is put first on an
agent's PATH by the `fleet-hooks` plugin's shell hook, so an agent keeps typing
plain `gh issue comment ...` and the signature is added without its help.

It signs the body of `gh issue comment`, `gh pr comment`, `gh pr review`,
`gh issue create` and `gh pr create` when the body comes from --body/-b,
--body-file/-F (a file, or - for stdin). Everything else, and anything it does
not understand, runs the real gh unchanged: this must never block a command.
"""
import importlib.util
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time

MARK = "<!-- fleet-switchboard:from=%s -->"
SIGNED_RE = re.compile(r"<!--\s*fleet-switchboard:from=[A-Za-z0-9_-]{1,64}\s*-->")
NAME_RE = re.compile(r"^[a-z0-9][a-z0-9_-]{0,63}$")
SIGNED_COMMANDS = {("issue", "comment"), ("pr", "comment"), ("pr", "review"), ("issue", "create"), ("pr", "create")}
LOOKUP_SECONDS = 3.0
WRITE_LOOKUP_SECONDS = 10.0   # a WRITE waits longer for the account lookup: a slow answer must not make it run as the wrong account
REPO_RE = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")
TOKEN_ENV_NAMES = ("GH_TOKEN", "GITHUB_TOKEN", "GH_ENTERPRISE_TOKEN", "GITHUB_ENTERPRISE_TOKEN")


COUNT_ACCOUNT = [None]
COUNT_LANE = [None]   # the caller's fleet name (else its role), set when the identity lookup ran for the call: nothing is looked up for the counter
LANE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$")
CALLS_SPOOL = "agent-calls.jsonl"
CALLS_LIMIT = 262144
CALLS_ON = "agent-calls-hours.json"   # the daemon makes this file: counting is on only while a daemon folds the spool
NO_NETWORK_GROUPS = ("auth", "config", "alias", "completion", "extension", "help", "version")

APP_SKIP_GROUPS = ("config", "completion", "help", "version")   # only the groups that provably make no call skip the App path: `extension` and `alias` can run programs that call out, `auth` handles tokens


# the endpoint class: an ALLOW-LIST, never a filter of what is there (#867). Only the words below can appear in it: a name (repository, owner, user,
# team, branch, file) is not on any list, so it cannot be recorded. The same code is in shims/gh (`reduce_endpoint`) and bin/agent_calls.py: a test runs both.
GROUPS = frozenset("api pr issue repo browse release run workflow gist search auth label ruleset status project cache codespace secret variable ssh-key "
                   "gpg-key org extension alias config completion help version attestation agent-task copilot preview skill".split())
VERBS = frozenset("view list create edit close reopen merge comment review checks diff status checkout ready delete download watch clone fork sync rerun "
                  "cancel enable disable get set remove lock unlock transfer pin unpin develop archive unarchive rename upload verify trusted-root login logout "
                  "refresh token setup-git switch import export".split())
API_TOP = frozenset("orgs users user teams search gists notifications rate_limit graphql installation app repositories enterprises marketplace_listing "
                    "emojis meta licenses gitignore codes_of_conduct events feeds octocat zen versions applications authorizations assignments classrooms".split())
API_SUB = frozenset("issues pulls comments commits contents git refs trees blobs tags branches releases assets labels milestones events actions runs jobs "
                    "workflows artifacts check-runs check-suites statuses status reviews files requested_reviewers timeline parent sub_issues reactions collaborators "
                    "hooks deployments environments rulesets protection merge compare readme languages contributors forks stargazers subscribers pages dependabot "
                    "code-scanning secret-scanning teams topics traffic license rate_limit logs attempts rerun cancel dispatches installation subscription "
                    "assignees invitations keys comments pending_deployments approvals dependencies blocked_by blocking copilot".split())


def reduce_endpoint(text):
    """`api issues/#` for a call whatever its form (a URL with a host, a leading slash, a query, a repository path, a name anywhere): only allow-listed words
    survive. `api <top word>` for orgs, users, teams, search and the like (the name after it is dropped); a repository path keeps its own words after
    `repos/<owner>/<name>/`, numbers as `#`, and stops at the first word not on the list. A command that is not `api` keeps its first word and a second one only when
    that is a known verb. Anything unknown is the first word alone, or `other`. Idempotent."""
    words = str(text).split()
    if not words:
        return "other"
    first = re.sub(r"[^a-z0-9_-]", "", words[0].lower())
    if first not in GROUPS:
        return "other"
    if first != "api":
        second = re.sub(r"[^a-z0-9_-]", "", words[1].lower()) if len(words) > 1 else ""
        return first + (" " + second if second in VERBS else "")
    if len(words) < 2:
        return "api"
    path = re.sub(r"^[a-zA-Z][a-zA-Z0-9+.-]*://[^/]*", "", words[1].split("?")[0].split("#")[0] if "://" in words[1] else words[1].split("?")[0])
    segs = [s for s in path.split("/") if s]
    if not segs:
        return "api repo"
    if segs[0] == "repos":
        segs = segs[3:]
    elif segs[0] in API_TOP:
        return "api " + segs[0]
    kept = []
    for seg in segs[:12]:
        if re.fullmatch(r"[0-9]+|#", seg):
            kept.append("#")
        elif seg in API_SUB:
            kept.append(seg)
        else:
            break
    return "api " + ("/".join(kept) or "repo")


def call_endpoint(args):
    """The class of a gh call for the counter, reduced to allow-listed words only (`api issues/#`, `pr view`): never a value, a repository, an owner or a name."""
    words = command_words(args)
    if not words:
        return None
    return reduce_endpoint(" ".join(words[:2]))


def call_lane():
    """The lane of this call: the fleet name (else the role) from the SAME identity answer the shim already fetched, else `unknown`. The caller's environment is never
    read for it (a caller could name any lane). A name or a role only: never a value of an argument."""
    candidate = COUNT_LANE[0]
    return candidate if isinstance(candidate, str) and LANE_RE.match(candidate) else "unknown"


def count_call(args):
    """Best effort, never fails or delays the command: one line (time, account name, endpoint class) for the daemon's hourly count. The switchboard's
    own calls are counted by the daemon, not here. Nothing else is recorded: no token, no argument, no body, no repo."""
    try:
        if os.environ.get("FLEET_SWITCHBOARD_OWN_GH") == "1":
            return
        words = command_words(args)
        if not words or words[0] in NO_NETWORK_GROUPS:
            return
        endpoint = call_endpoint(args)
        state = os.environ.get("FLEET_SWITCHBOARD_STATE") or os.path.join(
            os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state"), "fleet-switchboard")
        path = os.path.join(state, CALLS_SPOOL)
        if endpoint and os.path.exists(os.path.join(state, CALLS_ON)) and (not os.path.exists(path) or os.path.getsize(path) < CALLS_LIMIT):
            line = json.dumps({"ts": int(time.time()), "account": COUNT_ACCOUNT[0] or "default", "endpoint": endpoint, "lane": call_lane()}, sort_keys=True)
            fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
            with os.fdopen(fd, "a") as out:
                out.write(line + "\n")
    except Exception:
        pass


# ---- the read cache and the low-budget warning (#867, clauses 3 and 4)
# A repeated identical `gh api <path>` read of one agent on one account is answered from a short cache (at most CACHE_FRESH seconds), then revalidated with the
# entity tag (a 304 does not count against GitHub's budget). The key is account + path + agent; any write by that agent drops its entries first. Every error in
# here falls through to the real call. Only the exact shape `gh api <path>` (a GET with no flag) with stdout not a terminal is cached: anything else runs as before.
CACHE_DIR = "gh-read-cache"
CACHE_FRESH = 30          # seconds a cached answer is served without asking GitHub
CACHE_STALE_MAX = 600     # seconds: the oldest answer served while the account is nearly out of budget, and the longest any entry is kept
CACHE_BODY_MAX = 1048576
CACHE_FILES_MAX = 200
LOW_FRACTION = 0.15       # below this share of the hourly budget the shim says so, and serves a cached read instead of spending
USAGE_FILE = "github-usage.json"   # the daemon's once-a-minute reading of the account's real usage (bin/agent_calls.py)
USAGE_FRESH = 600
WARN_EVERY = 60


def state_directory():
    return os.environ.get("FLEET_SWITCHBOARD_STATE") or os.path.join(
        os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state"), "fleet-switchboard")


def cacheable_read(args):
    """The path of a call that is exactly `gh api <path>` (nothing else: no flag, no method, no field), else None."""
    if len(args) == 2 and args[0] == "api" and args[1] and not args[1].startswith("-") and "\n" not in args[1] and len(args[1]) <= 2000:
        return args[1]
    return None


def cache_directory(create=False):
    """The cache directory (0700, owned by this user, not a link), or None. Only while a daemon has switched counting on (the fleet is in use)."""
    state = state_directory()
    if os.environ.get("FLEET_SHIM_CACHE") == "off" or not os.path.exists(os.path.join(state, CALLS_ON)):
        return None
    path = os.path.join(state, CACHE_DIR)
    try:
        if create and not os.path.lexists(path):
            os.makedirs(path, mode=0o700, exist_ok=True)
        info = os.lstat(path)
    except OSError:
        return None
    import stat
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
        return None
    if stat.S_IMODE(info.st_mode) != 0o700:
        try:
            os.chmod(path, 0o700)
        except OSError:
            return None
    return path


def _digest(*parts):
    import hashlib
    return hashlib.sha256("\0".join(parts).encode("utf-8", "replace")).hexdigest()


def cache_file(directory, agent, account, path):
    return os.path.join(directory, "%s-%s.json" % (_digest(agent)[:16], _digest(account, agent, path)[:40]))


def cache_load(file, now):
    """(age, etag, body) of a stored answer, or None (missing, unreadable, malformed, or older than CACHE_STALE_MAX)."""
    try:
        with open(file) as handle:
            entry = json.loads(handle.read(CACHE_BODY_MAX + 4096))
        ts, etag, body = entry["ts"], entry.get("etag"), entry["body"]
        if not isinstance(ts, (int, float)) or isinstance(ts, bool) or not isinstance(body, str) or not (etag is None or isinstance(etag, str)):
            return None
        age = now - ts
        return (age, etag, body) if -5 <= age <= CACHE_STALE_MAX else None
    except (OSError, ValueError, KeyError, TypeError):
        return None


def cache_store(directory, file, etag, body, now):
    """Write one entry (0600, a temp file renamed into place), then keep the directory bounded in count and age. Never raises."""
    tmp = None
    try:
        fd, tmp = tempfile.mkstemp(dir=directory, prefix=".tmp-")
        with os.fdopen(fd, "w") as out:
            out.write(json.dumps({"ts": now, "etag": etag, "body": body}))
        os.chmod(tmp, 0o600)
        os.replace(tmp, file)
        tmp = None
        names = [n for n in os.listdir(directory) if n.endswith(".json")]
        dated = []
        for name in names:
            try:
                dated.append((os.stat(os.path.join(directory, name)).st_mtime, name))
            except OSError:
                pass
        dated.sort()
        for mtime, name in dated[:max(0, len(dated) - CACHE_FILES_MAX)] + [d for d in dated if now - d[0] > CACHE_STALE_MAX]:
            try:
                os.unlink(os.path.join(directory, name))
            except OSError:
                pass
    except Exception:
        pass
    finally:
        if tmp:
            try:
                os.unlink(tmp)
            except OSError:
                pass


def cache_drop(agent):
    """A write by `agent`: every cached answer of that agent is dropped (never another agent's). Never raises."""
    try:
        directory = cache_directory()
        if directory is None or not agent:
            return
        prefix = _digest(agent)[:16] + "-"
        for name in os.listdir(directory):
            if name.startswith(prefix):
                try:
                    os.unlink(os.path.join(directory, name))
                except OSError:
                    pass
    except Exception:
        pass


def budget_low(account):
    """(remaining, limit) when the daemon's fresh reading says this account is below LOW_FRACTION of its budget, else None."""
    try:
        with open(os.path.join(state_directory(), USAGE_FILE)) as handle:
            body = json.loads(handle.read(200001))
        row = body["accounts"][account]
        remaining, limit, at = row["remaining"], row["limit"], body["at"]
        numbers = (remaining, limit, at)
        if not all(isinstance(n, (int, float)) and not isinstance(n, bool) for n in numbers) or limit <= 0 or time.time() - at > USAGE_FRESH:
            return None
        return (int(remaining), int(limit)) if remaining < LOW_FRACTION * limit else None
    except Exception:
        return None


def warn_low(account, low):
    """One line on stderr before a call that would spend, at most once a minute per account. Never raises."""
    try:
        directory = os.path.join(state_directory(), "gh-low-warned")
        stamp = os.path.join(directory, _digest(account)[:16])
        try:
            if time.time() - os.stat(stamp).st_mtime < WARN_EVERY:
                return
        except OSError:
            pass
        os.makedirs(directory, mode=0o700, exist_ok=True)
        with open(stamp, "w"):
            pass
        sys.stderr.write("gh: warning: the GitHub account %s has %d of %d requests left this hour (under %d%%); repeated reads are answered from a short cache\n"
                         % (account, low[0], low[1], int(LOW_FRACTION * 100)))
    except Exception:
        pass


def split_response(raw):
    """(status, headers, body bytes) of `gh api -i` output, or None when it is not that shape."""
    cut = raw.find(b"\r\n\r\n")
    sep = 4
    if cut < 0:
        cut, sep = raw.find(b"\n\n"), 2
    if cut < 0:
        return None
    head = raw[:cut].decode("latin-1").splitlines()
    first = head[0].split() if head else []
    if len(first) < 2 or not first[0].startswith("HTTP/") or not first[1].isdigit():
        return None
    headers = {}
    for line in head[1:]:
        key, colon, value = line.partition(":")
        if colon:
            headers[key.strip().lower()] = value.strip()
    return int(first[1]), headers, raw[cut + sep:]


def cached_read(gh, env, args, agent, account, low):
    """Serve `gh api <path>` from the cache or through one conditional request. Returns an exit status, or None when the normal call should run (nothing was spent)."""
    path = cacheable_read(args)
    if path and ("{" in path or os.environ.get("GH_HOST") or os.environ.get("GH_REPO")):
        path = None   # gh fills `{owner}`, `{repo}` and `{branch}` from the working directory, and these variables change the target: the key could not tell
    directory = cache_directory(create=True) if path and agent else None
    if directory is None or sys.stdout.isatty():
        return None
    now = time.time()
    file = cache_file(directory, agent, account, path)
    entry = cache_load(file, now)
    if entry is not None and (entry[0] <= CACHE_FRESH or low is not None):
        sys.stdout.buffer.write(entry[2].encode("utf-8"))   # fresh, or the account is nearly out of budget: no request at all
        sys.stdout.buffer.flush()
        return 0
    argv = [gh, "api", "-i"] + (["-H", "If-None-Match: " + entry[1]] if entry is not None and entry[1] else []) + [path]
    done = subprocess.run(argv, capture_output=True, env=env)   # the one request (the real gh does not time out either)
    # from here a request is SPENT: whatever happens below, this returns its status and never lets the caller run a second request
    count_now = True
    try:
        parsed = split_response(done.stdout)
        if parsed is None:   # not an answer this can interpret: say what gh said
            sys.stdout.buffer.write(done.stdout)
            sys.stderr.buffer.write(done.stderr)
            return done.returncode
        status, headers, body = parsed
        if status == 304 and entry is not None:
            count_now = False   # a 304 costs nothing, so it is not counted
            cache_store(directory, file, entry[1], entry[2], now)
            sys.stdout.buffer.write(entry[2].encode("utf-8"))
            sys.stdout.buffer.flush()
            return 0
        if 200 <= status < 300 and len(body) <= CACHE_BODY_MAX:
            try:
                cache_store(directory, file, headers.get("etag"), body.decode("utf-8"), now)
            except Exception:
                pass
        sys.stdout.buffer.write(body)
        sys.stdout.buffer.flush()
        sys.stderr.buffer.write(done.stderr)
        return done.returncode
    except Exception:
        return done.returncode
    finally:
        try:
            if count_now:
                count_call(args)
        except Exception:
            pass


def real_gh():
    """The first executable named gh on PATH that is not this shim's own directory."""
    own = os.path.realpath(os.path.dirname(os.path.abspath(__file__)))
    override = os.environ.get("FLEET_REAL_GH")
    if override and os.access(override, os.X_OK):
        return override
    for entry in os.environ.get("PATH", "").split(os.pathsep):
        if not entry or os.path.realpath(entry) == own:
            continue
        candidate = os.path.join(entry, "gh")
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    return None


def switchboard_binary():
    """The switchboard executable, or None. FLEET_SWITCHBOARD_BIN when set (a value that is SET wins, even a bad one), else
    the one `install` linked, as the fleet-hooks plugin does: resolved, an executable file, nothing looked up on PATH."""
    binary = os.environ.get("FLEET_SWITCHBOARD_BIN")
    if not binary:
        try:
            binary = os.path.realpath(os.path.join(os.path.expanduser("~"), ".local", "bin", "fleet-switchboard"))
        except (OSError, ValueError):
            return None
        if not (os.path.isfile(binary) and os.access(binary, os.X_OK)):
            return None
    return binary if os.path.isabs(binary) else None


def config_users():
    """`gh_users` of the switchboard's config (repo or `owner/*` -> gh account), {} when there is none or it cannot be read."""
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    try:
        with open(os.path.join(base, "fleet-switchboard", "config.json")) as handle:
            users = json.load(handle).get("gh_users")
    except (OSError, ValueError, AttributeError):
        return {}
    return users if isinstance(users, dict) else {}


def lookup_seconds(write=False):
    """The whole identity lookup of one gh call (who am I, which account, its token) shares ONE deadline of this many seconds
    (default 3 for a read and 10 for a write, FLEET_SHIM_LOOKUP_SECONDS sets both, kept between 0.2 and 10): a wedged daemon or v2 adds at most
    that, then a read runs as it is and a write is refused (never run as the inherited account)."""
    default = WRITE_LOOKUP_SECONDS if write else LOOKUP_SECONDS
    try:
        return min(10.0, max(0.2, float(os.environ.get("FLEET_SHIM_LOOKUP_SECONDS", default))))
    except ValueError:
        return default


class Lookup:
    """One identity lookup per gh call: a single `whoami --json` (name and repo together; an older switchboard that does not
    know the flag is asked for the plain name, within the same deadline), under a shared deadline."""

    def __init__(self, write=False):
        self.deadline = time.monotonic() + lookup_seconds(write)
        self._ident = None
        self.failed = False   # a lookup that should have answered did not (timed out, could not run, exited non-zero)

    def left(self):
        return max(0.0, self.deadline - time.monotonic())

    def run(self, argv, **kwargs):
        """The command's result, or None when the deadline is spent, it timed out or could not run."""
        if self.left() <= 0:
            self.failed = True
            return None
        try:
            return subprocess.run(argv, capture_output=True, text=True, timeout=self.left(), **kwargs)
        except (OSError, subprocess.SubprocessError):
            self.failed = True
            return None

    def identity(self):
        """{"name", "repo"}: either may be missing. {} with no switchboard."""
        if self._ident is not None:
            return self._ident
        self._ident = {}
        binary = switchboard_binary()
        if not binary:
            return self._ident
        done = self.run([binary, "whoami", "--json"])
        try:
            data = json.loads(done.stdout) if done is not None and done.returncode == 0 else None
        except ValueError:
            data = None
        if isinstance(data, dict):
            name, repo = data.get("name"), data.get("repo")
            COUNT_LANE[0] = name if isinstance(name, str) and NAME_RE.match(name) else (data.get("role") if isinstance(data.get("role"), str) else None)
            self._ident = {"name": name if isinstance(name, str) and NAME_RE.match(name) else None,
                           "repo": repo if isinstance(repo, str) and REPO_RE.match(repo) else None,
                           "own": data.get("own") is not False,
                           "role": data.get("role") if isinstance(data.get("role"), str) else None}   # False: the repo is only the default (`intent_repo`), the caller has none of its own
            return self._ident
        plain = self.run([binary, "whoami"])   # an older switchboard: the name only
        if plain is not None and plain.returncode != 0:
            self.failed = True                 # neither form answered: a failure, not an old switchboard
        name = plain.stdout.strip() if plain is not None and plain.returncode == 0 else ""
        self._ident = {"name": name if NAME_RE.match(name) else None, "repo": None}
        COUNT_LANE[0] = self._ident["name"]
        return self._ident


class NoAccountMapped(Exception):
    """git's credential helper was asked, `gh_users` is set, and this caller has no repository or no account mapped for it: git must not authenticate as a guess."""


class NoOwnRepository(NoAccountMapped):
    """The credential route for a caller with no repository of its own: only the configured DEFAULT repository is known for it, and the default repository's account
    is never a guess git may use (#473). The launcher records a worker's repository from its working directory; a worker with none is refused here."""


class AppMintRefused(Exception):
    """A repository is mapped to the GitHub App (`app_installations`) and its installation token could not be had, or the App configuration cannot be trusted:
    the call is refused, and the stored login is never used instead (shims/app_mint.py)."""


class AccountLookupFailed(Exception):
    """The account lookup failed where an account WAS expected (a mapping exists): a write must not fall back to the inherited token."""


READ_SUBCOMMANDS = {"view", "list", "status", "diff", "checks", "download", "watch", "get", "clone", "ls", "show", "tree", "search", "contents"}
READ_GROUPS = {"search", "status", "browse", "completion", "help", "version", "auth", "config", "alias", "extension", "ext", "attestation"}


def command_words(args):
    """The positional words of a gh command, skipping flags and the value of `-R`/`--repo` (a flag before the verb, as in `gh pr -R o/r merge 5`, must
    not hide the verb)."""
    words, skip = [], False
    for a in args:
        if skip:
            skip = False
        elif a in ("-R", "--repo"):
            skip = True
        elif not a.startswith("-"):
            words.append(a)
    return words


def is_write(args):
    """True unless the gh command is KNOWN to only read: a read group (auth, config, search, status, ...), a read sub-command (view, list, status, diff,
    checks, download, watch, ...), or `gh api` with no method other than GET and no fields. Anything else, including a verb this does not list
    (`workflow run`, `run rerun`, `secret set`, `gist`, `pr checkout`, an alias), counts as a WRITE: the shim fails closed on what it cannot tell."""
    try:
        words = command_words(args)
        if not words:
            return False   # `gh --version`, `gh --help`
        if words[0] == "api":
            method = None
            for i, a in enumerate(args):
                if a in ("-X", "--method") and i + 1 < len(args):
                    method = args[i + 1].upper()
                elif a.startswith("--method="):
                    method = a.split("=", 1)[1].upper()
                elif a.startswith("-X") and len(a) > 2:
                    method = a[2:].upper()
            if method is not None:
                return method != "GET"
            return any(a in ("-f", "-F", "--field", "--raw-field", "--input") or a.startswith(("--field=", "--raw-field=", "--input=", "-f", "-F"))
                       for a in args[1:] if a.startswith("-") and not a.startswith("--jq") and not a.startswith("--paginate") and not a.startswith("--slurp"))
        if words[:2] == ["auth", "git-credential"]:
            return True   # git's credential helper (the `git` shim routes push and fetch to it): bound to the repo's account, and a failed lookup refuses, never the stored login
        if words[0] in READ_GROUPS:
            return False
        return not (len(words) >= 2 and words[1] in READ_SUBCOMMANDS)
    except Exception:
        return True   # cannot tell: treat as a write, the safe side


def is_git_credential(args):
    try:
        return command_words(args)[:2] == ["auth", "git-credential"]
    except Exception:
        return False


EXPLICIT_REPO_GROUPS = {"issue", "pr"}
URL_REPO_RE = re.compile(r"^https://github\.com/([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)/(?:issues|pull)/[0-9]+(?:[/?#].*)?$")


VALUE_FLAGS = {"-b", "--body", "-F", "--body-file", "-t", "--title", "-l", "--label", "-a", "--assignee", "-m", "--milestone", "-p", "--project",
               "-r", "--reviewer", "-B", "--base", "-H", "--head", "-q", "--jq", "--json", "--template", "-s", "--state",
               "-S", "--search", "-L", "--limit", "--author", "--app", "--add-label", "--remove-label", "--add-assignee", "--remove-assignee",
               "--add-reviewer", "--remove-reviewer", "--add-project", "--remove-project", "--reason"}
TARGET_VERBS = {"view", "comment", "edit", "close", "reopen", "ready", "checks", "diff", "lock", "unlock", "status"}


def explicit_repo(args):
    """The repo a `gh issue ...` or `gh pr ...` command NAMES, or None: from the real `-R`/`--repo` flag (never from the value of another flag such as
    `--body` or `--title`) or from an issue or pull request URL that is the target argument right after the verb. Never for `merge`: a merge keeps
    the caller's own rule. Only `issue` and `pr` commands: nothing else (`repo`, `secret`, `workflow`, `run`, `api`) picks an account by what it names.
    Two different repos named, or anything it cannot tell, give None (the command then runs as it always did)."""
    try:
        words = command_words(args)
        if len(words) < 2 or words[0] not in EXPLICIT_REPO_GROUPS or words[1] == "merge":
            return None
        found, skip = set(), False
        for i, a in enumerate(args):
            if skip:
                skip = False
            elif a in ("-R", "--repo") and i + 1 < len(args):
                found.add(args[i + 1])
                skip = True
            elif a.startswith("--repo="):
                found.add(a.split("=", 1)[1])
            elif a.startswith("-R") and len(a) > 2 and not a.startswith("--"):
                found.add(a[2:].lstrip("="))
            elif a in VALUE_FLAGS:
                skip = True      # the next argument is that flag's value (a body or title may hold anything): never read it as a repo
        if not found and words[1] in TARGET_VERBS:
            verb_at = args.index(words[1]) if words[1] in args else -1
            if verb_at >= 0 and verb_at + 1 < len(args):
                m = URL_REPO_RE.match(args[verb_at + 1])
                if m:
                    found.add(m.group(1))
        found = {f for f in found if isinstance(f, str)}
        if len(found) != 1:
            return None
        repo = found.pop()
        return repo if REPO_RE.match(repo) else None
    except Exception:
        return None


MATCHER = [None, False]   # (module, tried): repo_match.py beside this file, loaded by path


def load_matcher():
    """The shared repository matcher (the launch guard's rules), or None when it cannot be loaded (callers then refuse a write: fail closed)."""
    if not MATCHER[1]:
        MATCHER[1] = True
        try:
            path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "repo_match.py")
            spec = importlib.util.spec_from_file_location("repo_match", path)
            module = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(module)
            MATCHER[0] = module
        except Exception:
            MATCHER[0] = None
    return MATCHER[0]


def warn_text(args):
    """Warn on stderr when a body or comment reads badly (shims/body_warn.py beside this file). Only a warning: any doubt or trouble prints nothing."""
    try:
        if not any(a[:2] == "-b" or a == "--body" or a.startswith("--body=") for a in args[2:]):
            return   # no inline text flag: nothing is loaded; a --body-file or stdin is never opened or read
        spec = importlib.util.spec_from_file_location("body_warn", os.path.join(os.path.dirname(os.path.realpath(__file__)), "body_warn.py"))
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        line = module.warning(args)
        if line:
            sys.stderr.write(line)
    except Exception:
        pass


APP_MODULE = [None, False]   # (module, tried): app_mint.py beside this file, loaded by path
APP_CHILD = []                # the real gh child while a token file exists: a killed shim stops it too
APP_DIRS = []                 # private directories holding a token for the real gh (hosts.yml); removed when the call ends


def load_app():
    if not APP_MODULE[1]:
        APP_MODULE[1] = True
        try:
            path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "app_mint.py")
            spec = importlib.util.spec_from_file_location("app_mint", path)
            module = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(module)
            APP_MODULE[0] = module
        except Exception:
            APP_MODULE[0] = None
    return APP_MODULE[0]


def app_config():
    """(module, Config) when the owner maps any repository to the App, else None (the feature is off and nothing here runs). A config that names the App but cannot
    be trusted, or a module that cannot be loaded, refuses (AppMintRefused): never the stored login."""
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    try:
        with open(os.path.join(base, "fleet-switchboard", "config.json")) as handle:
            named = "app_installations" in handle.read()
    except FileNotFoundError:
        return None
    except Exception:
        named = True   # a config that cannot be read is not known to name no App mapping
    if not named:
        return None
    module = load_app()
    if module is None:
        raise AppMintRefused("gh: refused: the GitHub App module could not be loaded, so no call is made with the stored login")
    try:
        config = module.read_config()
    except module.ConfigError as err:
        raise AppMintRefused("gh: refused: the GitHub App configuration cannot be used (%s)" % _clean_reason(str(err)))
    return (module, config) if config is not None else None


def app_terminated(number, frame):
    for child in APP_CHILD:
        try:
            child.terminate()
        except OSError:
            pass
    sys.exit(128 + number)


def app_cleanup():
    while APP_DIRS:
        shutil.rmtree(APP_DIRS.pop(), ignore_errors=True)


def app_env(app, repo):
    """The environment for the real gh when `repo` is mapped to the App: the installation token as a private hosts.yml in GH_CONFIG_DIR (neither argv nor an
    environment value), every token variable removed. None when `repo` is not mapped. AppMintRefused when it is and no acceptable token can be had."""
    module, config = app
    if config.entry(repo) is None:
        return None
    try:
        token = module.token_for(config, repo)
        directory = module.write_hosts_dir(token)
    except (module.MintRefused, OSError) as err:
        raise AppMintRefused("gh: refused: no GitHub App token for %s (%s); the stored login is not used" % (_clean_reason(str(repo)), _clean_reason(str(err))))
    APP_DIRS.append(directory)
    for number in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(number, app_terminated)   # a killed shim still removes its token file (the finally in main)
    return module.child_env(directory)


def account_env(gh, lookup=None, strict=False, credential=False, args=None):
    """The environment for the real gh with GH_TOKEN of the account that `gh_users` maps to the repo of the caller's RESOLVED
    identity (`fleet-switchboard whoami --json`: its session, never an inherited variable), the same map and the same
    `gh auth token --user` the daemon uses; so an inherited token never decides who an agent acts as. None leaves the
    environment as it is: no mapping, no switchboard (or one too old to answer), no repo, no token, the lookup deadline
    spent, any trouble. The token is only put in the child's environment: never printed, logged or put in argv."""
    app = None
    try:
        if os.environ.get("FLEET_SWITCHBOARD_OWN_GH") == "1":
            return None   # the switchboard's own call (the daemon's, or a command's): it named its account; never re-identified
        users = config_users()
        words = command_words(args or [])
        app = app_config() if (credential or not words or words[0] not in APP_SKIP_GROUPS) and not (args and not words) else None   # `gh --version` makes no call
        if not users and app is None:
            return None   # no per-repository accounts are configured: nothing to bind to, whatever the caller is
        if not switchboard_binary():
            if credential:
                raise NoAccountMapped("this shell (no switchboard to say which repository it is)")
            if app is not None:
                raise AppMintRefused("gh: refused: the App is configured and no switchboard can say which repository this is, so the stored login is not used")
            return None
        lookup = lookup or Lookup()
        ident = lookup.identity()
        repo = ident.get("repo")
        if credential and ident.get("own") is False and not lookup.failed:
            # the caller has no repository of its own (`own` false: the repo is only the config's default). Nothing a git push names says which account it is for, and
            # the default repository's account is a guess that pushes as the wrong account: refuse. Nothing here reads a directory's remote.
            raise NoOwnRepository("this worker")
        if (not repo or ident.get("own") is False) and not lookup.failed:
            # a caller with no repo of its own (the Chief of Staff: whoami gives only the default `intent_repo`, own false) acts as the account of the
            # repo the command names; with nothing named it keeps the default repo's account as before
            repo = explicit_repo(args or []) or repo
        if not repo:
            if strict and lookup.failed:
                raise AccountLookupFailed("identity")
            if credential:
                raise NoAccountMapped("this shell (it has no repository identity)")
            if app is not None:
                raise AppMintRefused("gh: refused: the App is configured and this shell has no repository identity, so the stored login is not used")
            return None
        matcher = load_matcher()
        if matcher is None or matcher.normal_repo(repo) is None:
            if credential or strict:
                raise NoAccountMapped("repository %s" % _clean_reason(str(repo)))   # a repository that cannot be read is unmatched and refused, never defaulted
            return None
        if app is not None:
            if ident.get("own") is False and ident.get("role") != "chief-of-staff" and app[1].entry(repo) is not None:
                # no repository of its own AND not the Chief of Staff (by the RECORDED role; a missing role counts as not): the repository above is the default or the one the
                # command names, and neither is this caller's to write in
                raise AppMintRefused("gh: refused: only the Chief of Staff, by its recorded role, may act for a repository it does not own: %s is mapped to the App and this caller has no repository of its own" % _clean_reason(str(repo)))
            if ident.get("own") is not False:   # a caller WITH its own repository never gets another mapped repository's token by naming it (-R, a URL): refused, naming both
                named = explicit_repo(args or [])
                if named and matcher.normal_repo(named) is not None and matcher.normal_repo(named) != matcher.normal_repo(repo) and app[1].entry(named) is not None:
                    raise AppMintRefused("gh: refused: this worker's repository is %s and the command names %s, which is mapped to the App: a worker acts only for its own repository" % (_clean_reason(str(repo)), _clean_reason(str(named))))
            target = repo   # a caller with no repository of its own already has `repo` = the repository the command names (above)
            got_env = app_env(app, target)   # a repository mapped to the App uses its installation token and nothing else
            if got_env is not None:
                COUNT_ACCOUNT[0] = "app"
                return got_env
        account = matcher.account_for(users, repo)
        if not isinstance(account, str) or not account:
            if credential and users:
                raise NoAccountMapped("repository %s" % repo)
            return None
        COUNT_ACCOUNT[0] = account   # for the call counter: the account's NAME only
        clean = {k: v for k, v in os.environ.items() if k not in TOKEN_ENV_NAMES}
        got = lookup.run([gh, "auth", "token", "--user", account], stdin=subprocess.DEVNULL, env=clean)
        token = got.stdout.strip() if got is not None and got.returncode == 0 else ""
        if not token and strict:
            raise AccountLookupFailed("token")
        return dict(os.environ, GH_TOKEN=token) if token else None
    except (AccountLookupFailed, NoAccountMapped, AppMintRefused):
        raise
    except Exception:
        if credential:
            raise NoAccountMapped("this shell (its account could not be worked out)")   # the credential route never guesses: any trouble refuses
        if app is not None:
            raise AppMintRefused("gh: refused: the App is configured and the account could not be worked out, so the stored login is not used")
        return None


def _clean_reason(text):
    return "".join(c if 32 <= ord(c) < 127 else " " for c in text)[:120]


def my_name(lookup=None):
    """The calling agent's fleet name, or "agent": the name only says who, the signature is what matters."""
    try:
        return (lookup or Lookup()).identity().get("name") or "agent"
    except Exception:
        return "agent"


def sign(body, name):
    return body if SIGNED_RE.search(body) else body.rstrip("\n") + "\n\n" + MARK % name + "\n"


def body_flag(args):
    """(index, kind, inline) of the LAST body flag among args[2:]: kind "body" or "file"; inline is the
    value when it is part of the same argument (`--body=x`, `-bx`), else None (the value is args[index+1])."""
    found = None
    i = 2
    while i < len(args):
        arg = args[i]
        if arg == "--":
            break
        for names, kind in ((("--body", "-b"), "body"), (("--body-file", "-F"), "file")):
            for name in names:
                if arg == name:
                    found = (i, kind, None)
                elif arg.startswith(name + "=") or (not name.startswith("--") and arg.startswith(name) and len(arg) > 2
                                                    and not arg.startswith("--")):
                    found = (i, kind, arg[len(name) + 1:] if arg[len(name):len(name) + 1] == "=" else arg[len(name):])
        i += 1
    return found


def signed_call(args, name):
    """(new argv, stdin text or None, temp file to remove or None), or None when there is nothing to sign."""
    if len(args) < 3 or (args[0], args[1]) not in SIGNED_COMMANDS:
        return None
    flag = body_flag(args)
    if flag is None:
        return None
    index, kind, inline = flag
    value_at = index if inline is not None else index + 1
    value = inline if inline is not None else (args[index + 1] if index + 1 < len(args) else None)
    if value is None:
        return None
    new = list(args)
    if kind == "body":
        signed = sign(value, name)
        if inline is not None:
            new[index] = args[index].replace(value, signed, 1) if args[index].startswith("--") else args[index][:2] + signed
        else:
            new[value_at] = signed
        return new, None, None
    if value == "-":
        return new, sign(sys.stdin.read(), name), None
    try:
        with open(value, "r") as handle:
            text = handle.read()
    except OSError:
        return None
    handle, temp = tempfile.mkstemp(prefix="fleet-gh-", suffix=".md")
    with os.fdopen(handle, "w") as out:
        out.write(sign(text, name))
    if inline is not None:
        new[index] = args[index][:len(args[index]) - len(value)] + temp
    else:
        new[value_at] = temp
    return new, None, temp


# ---- the gate probe (plan-driven development: enforcing in a repo whose mode is enforce). docs/plan-gate-engine-design.md, E1 and E3.
#
# Before `gh pr ready` or `gh pr merge` of a PR the shim asks `fleet-switchboard gates-check <repo#N> --for ready|merge`, with
# its own time bound. Exit 10 (a refusal that applies in the repo's mode) stops the command: the one-line reason goes to stderr and
# the real gh does not run. Everything else (fail-open, timeout, a missing switchboard, a shape not understood, the kill switches,
# a valid waiver, a shadow repo) runs the real gh. In an enforcing repo a merge is bound to the checked head and --auto is refused.
# `gh pr create` has no PR number before it runs, so it is not probed here. The probe is skipped altogether for a repo that is
# not listed under `plan_gates` in the switchboard config, and for the switchboard's own gh calls (no recursion).
GATE_SECONDS = 3.0
GATE_SPOOL = "gate-failopen.jsonl"
GATE_SPOOL_LIMIT = 262144
BOOL_SHORT = {"pr merge": {"d": "--delete-branch", "m": "--merge", "r": "--rebase", "s": "--squash"}, "pr ready": {}}
BOOL_LONG = {"pr merge": {"--delete-branch", "--admin", "--auto", "--disable-auto", "--merge", "--rebase", "--squash"},
             "pr ready": set()}
VALUE_SHORT = {"R": "--repo", "b": "--body", "F": "--body-file", "A": "--author-email", "t": "--subject"}
VALUE_LONG = {"--repo", "--body", "--body-file", "--author-email", "--subject", "--match-head-commit"}
PR_URL_RE = re.compile(r"^https://github\.com/([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)/pull/([0-9]+)(?:/[^?#]*)?(?:[?#].*)?$")
MATCH_FLAG = "--match-head-commit"


def gate_seconds():
    try:
        return min(10.0, max(0.2, float(os.environ.get("FLEET_SHIM_GATE_SECONDS", GATE_SECONDS))))
    except ValueError:
        return GATE_SECONDS


def gate_parse(args):
    """Parse a `pr ready` or `pr merge` command line the way gh (cobra) does: `--flag value`, `--flag=value`, `-R value`,
    `-Rvalue`, combined short booleans (`-sd`), `--bool=false`. Returns None for a shape not understood (an unknown flag,
    `ready --undo`, `--`, more than one positional), else {"check", "repo", "ref", "auto", "match": [(start, stop, value)]}
    where `ref` is the positional argument or None, and each `match` span is the args slice of one --match-head-commit."""
    if len(args) < 2 or args[0] != "pr" or args[1] not in ("ready", "merge"):
        return None
    verb = "pr " + args[1]
    out = {"check": args[1], "repo": None, "ref": None, "auto": False, "match": []}
    positional, i = [], 2
    while i < len(args):
        arg = args[i]
        start = i
        if arg == "--" or arg == "-":
            return None
        value, name = None, None
        if arg.startswith("--"):
            name, eq, inline = arg.partition("=")
            if name in VALUE_LONG:
                if eq:
                    value, i = inline, i + 1
                else:
                    value, i = (args[i + 1] if i + 1 < len(args) else None), i + 2
            elif name in BOOL_LONG[verb]:
                if eq and inline.lower() not in ("true", "false", "1", "0", "t", "f"):
                    return None
                if name == "--auto":
                    out["auto"] = (not eq) or inline.lower() in ("true", "1", "t")
                i += 1
                continue
            else:
                return None
        elif arg.startswith("-"):
            letters, j = arg[1:], 0
            while j < len(letters):
                letter = letters[j]
                if letter in BOOL_SHORT[verb]:
                    j += 1
                    continue
                if letter in VALUE_SHORT:
                    name = VALUE_SHORT[letter]
                    rest = letters[j + 1:]
                    if rest:
                        value, i = rest[1:] if rest.startswith("=") else rest, i + 1
                    else:
                        value, i = (args[i + 1] if i + 1 < len(args) else None), i + 2
                    break
                return None
            else:
                i += 1
                continue
        else:
            positional.append(arg)
            i += 1
            continue
        if name == "--repo":
            if not value or not REPO_RE.match(value):
                return None
            out["repo"] = value
        elif name == MATCH_FLAG:
            out["match"].append((start, min(i, len(args)), value))
    if len(positional) > 1:
        return None
    out["ref"] = positional[0] if positional else None
    return out


def gate_run_gh(gh, argv, deadline, env):
    try:
        done = subprocess.run([gh] + argv, capture_output=True, text=True, timeout=max(0.05, deadline - time.time()),
                              stdin=subprocess.DEVNULL, env=env)
    except (subprocess.SubprocessError, OSError):
        return None
    return done.stdout.strip() if done.returncode == 0 else None


def gate_resolve(parsed, gh, env, deadline):
    """(repo, number) of the PR the real gh would act on, or (None, why). Never guesses: a repo comes from the PR URL, -R, GH_REPO,
    or the real gh's own answer for the current directory; a PR with no number (no argument, a branch name) is asked of the real gh."""
    ref = parsed["ref"]
    if ref is not None:
        url = PR_URL_RE.match(ref)
        if url:
            return url.group(1), int(url.group(2))
        if ref.isdigit() and int(ref) >= 1:
            repo = parsed["repo"] or os.environ.get("GH_REPO")
            if repo and not REPO_RE.match(repo):
                return None, "GH_REPO is not owner/repo"
            if not repo:
                if gh is None:
                    return None, "no real gh to ask which repo this directory is"
                repo = gate_run_gh(gh, ["repo", "view", "--json", "nameWithOwner", "-q", ".nameWithOwner"], deadline, env)
                if not repo or not REPO_RE.match(repo):
                    return None, "could not resolve the repo of this directory"
            return repo, int(ref)
    if gh is None:
        return None, "no real gh to ask"
    argv = ["pr", "view"] + ([ref] if ref is not None else [])
    repo = parsed["repo"] or os.environ.get("GH_REPO")
    if repo:
        if not REPO_RE.match(repo):
            return None, "GH_REPO is not owner/repo"
        argv += ["-R", repo]
    found = gate_run_gh(gh, argv + ["--json", "url", "-q", ".url"], deadline, env)
    url = PR_URL_RE.match(found or "")
    if not url:
        return None, "could not resolve the PR (%s)" % (ref or "the current branch")
    return url.group(1), int(url.group(2))


def gate_clean(text):
    """One printable line: control characters (terminal escapes) removed."""
    return "".join(ch for ch in str(text) if ch.isprintable()).strip()


def gate_repos():
    """The lower-cased repos listed under `plan_gates.repos` in the switchboard config; {} when none (then nothing is probed)."""
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    try:
        with open(os.path.join(base, "fleet-switchboard", "config.json")) as handle:
            repos = (json.load(handle).get("plan_gates") or {}).get("repos")
    except (OSError, ValueError, AttributeError):
        return set()
    return {str(name).lower() for name in repos} if isinstance(repos, dict) else set()


def gate_spool(event, repo, number, check, detail):
    """One line for the daemon to read later (best effort, never fails the command). The file is writable by any local
    process, so the daemon treats it as untrusted text: clipped, data only."""
    state = os.environ.get("FLEET_SWITCHBOARD_STATE") or os.path.join(
        os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state"), "fleet-switchboard")
    path = os.path.join(state, GATE_SPOOL)
    try:
        if os.path.isdir(state) and (not os.path.exists(path) or os.path.getsize(path) < GATE_SPOOL_LIMIT):
            line = json.dumps({"ts": int(time.time()), "event": event, "pr": "%s#%d" % (repo or "unknown", number or 0), "for": check,
                               "detail": str(detail)[:200]}, sort_keys=True)
            fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
            with os.fdopen(fd, "a") as out:
                out.write(line + "\n")
            return True   # written
    except OSError:
        pass
    return False


OVER_REVIEW_FLAG = "--over-review"


def take_over_review(args):
    """(args without --over-review, found, reason): `--over-review <reason>` or `--over-review=<reason>` on `pr merge` is the shim's own flag: it is
    stripped before the real gh sees it (gh would reject it)."""
    if len(args) < 2 or args[0] != "pr" or args[1] != "merge":
        return args, False, ""
    out, found, reason, i = [], False, "", 0
    while i < len(args):
        arg = args[i]
        if arg == OVER_REVIEW_FLAG:
            found = True
            nxt = args[i + 1] if i + 1 < len(args) else ""
            # the next word is the reason, unless it is a flag, a bare PR number or a PR URL (then it is the PR and the reason is missing)
            if nxt and not nxt.startswith("-") and not nxt.isdigit() and not PR_URL_RE.match(nxt):
                reason, i = nxt, i + 2
            else:
                i += 1
            continue
        if arg.startswith(OVER_REVIEW_FLAG + "="):
            found, reason, i = True, arg.split("=", 1)[1], i + 1
            continue
        out.append(arg)
        i += 1
    return out, found, " ".join(reason.split())


REVIEW_TAG_RE = re.compile(r"^\s*Review of ([0-9a-fA-F]{7,40})\s*[:\-]\s*(CHANGES[ _]REQUESTED|REQUEST[ _]CHANGES|APPROVED?)\b", re.I)
REVIEW_FROM_RE = re.compile(r"fleet-switchboard:from=([A-Za-z0-9_-]{1,32})")


def tagged_blockers(reviews, head):
    """Independent reviews in this fleet are posted as COMMENTED reviews (one shared account cannot request changes on its own PRs), so the real
    signal is the body's first line: `Review of <head sha>: CHANGES REQUESTED` or `APPROVE`. For each reviewer (login plus the `from=` tag a signed body
    carries) the LATEST tagged review AT THE PR'S CURRENT HEAD decides: CHANGES REQUESTED blocks until a later one at that head says APPROVE. A tag for
    another head, and any untagged comment, never blocks. Returns ["login/tag: CHANGES REQUESTED (Review of <sha>)"]."""
    if not isinstance(head, str) or len(head) < 7:
        return []
    latest = {}
    for review in reviews if isinstance(reviews, list) else []:
        if not isinstance(review, dict):
            continue
        body = review.get("body") if isinstance(review.get("body"), str) else ""
        first = body.strip().splitlines()[0] if body.strip() else ""
        found = REVIEW_TAG_RE.match(first)
        if not found:
            continue
        sha = found.group(1).lower()
        if not head.lower().startswith(sha):
            continue                                   # a verdict on another head says nothing about this one
        author = ((review.get("author") or {}).get("login")) if isinstance(review.get("author"), dict) else None
        tag = REVIEW_FROM_RE.search(body)
        key = "%s%s" % (author or "?", "/" + tag.group(1) if tag else "")
        word = found.group(2).upper().replace("_", " ")
        latest[key] = ("CHANGES REQUESTED", sha) if word.startswith(("CHANGES", "REQUEST")) else ("APPROVE", sha)
    return sorted("%s: CHANGES REQUESTED (Review of %s)" % (k, v[1][:8]) for k, v in latest.items() if v[0] == "CHANGES REQUESTED")


def review_blockers(reviews, head="", decision=""):
    """The reviewers whose latest decisive review (APPROVED, CHANGES_REQUESTED or DISMISSED; a plain comment is not decisive) is CHANGES_REQUESTED AND
    still blocks this head: it is at the PR's current head (its commit oid equals `head`), or its commit or the head is not known, or GitHub's
    `decision` (reviewDecision) is CHANGES_REQUESTED. A changes-requested review at an OLDER head is superseded by that reviewer's newer review of any
    kind (a comment included; this rule only) unless GitHub's decision still says CHANGES_REQUESTED; one at the CURRENT head is cleared only by that
    reviewer's later approval or dismissal, never by a comment, because several agents can share one login. Where GitHub gives no decision (no required
    reviews) an old-head review does not block: this is a guardrail, GitHub's branch protection is the boundary. `tagged_blockers` is separate."""
    latest = {}
    for review in reviews if isinstance(reviews, list) else []:
        if not isinstance(review, dict):
            continue
        author = ((review.get("author") or {}).get("login")) if isinstance(review.get("author"), dict) else None
        state = str(review.get("state") or "").upper()
        if author and state in ("APPROVED", "CHANGES_REQUESTED", "DISMISSED"):
            commit = review.get("commit") if isinstance(review.get("commit"), dict) else {}
            latest[author] = (state, commit.get("oid") if isinstance(commit.get("oid"), str) else "")
    blocked = str(decision or "").upper() == "CHANGES_REQUESTED"
    return sorted(who for who, (state, oid) in latest.items()
                  if state == "CHANGES_REQUESTED" and (blocked or not oid or not head or oid.lower() == head.lower()))


def review_probe(args, found, reason, lookup, gh):
    """For `gh pr merge` in ANY repo (`--admin` too): refuse while a reviewer's latest decisive review is CHANGES_REQUESTED (not dismissed, not
    superseded by that reviewer's later approval) or the switchboard holds a blocking `review record` at the PR's CURRENT head, naming them.
    `--over-review <reason>` (at least 10 characters) goes ahead on purpose and is spooled for the audit (who, PR, head, reason). FAIL MODE: a read
    that cannot be made (reviews API, switchboard) lets the merge through with one visible warning line: a flake never blocks, and is never silent.
    A GUARDRAIL against accidents, not a boundary: the real gh, an unrecognised flag shape (fail open) or `--over-review` with any reason bypasses it;
    the boundary is GitHub's branch protection / required reviews. The check reads the PR's head and the merge then runs unbound, so a push in
    between can land an unchecked head (a short, documented window; the enforcing gates bind `--match-head-commit` themselves). Returns the refusal text, or None."""
    try:
        if os.environ.get("FLEET_SWITCHBOARD_OWN_GH") == "1" or len(args) < 2 or args[0] != "pr" or args[1] != "merge":
            return None
        parsed = gate_parse(args)
        if parsed is None:
            sys.stderr.write("gh: review check skipped (the merge command shape was not understood)\n")
            return None
        deadline = time.time() + gate_seconds()
        env = None
        try:
            env = account_env(gh, lookup)
        except AppMintRefused as err:
            return str(err)   # mapped to the App and no token: refused, the stored login is never used for the read
        except Exception:
            env = None
        repo, number = gate_resolve(parsed, gh, env, deadline)
        if repo is None:
            sys.stderr.write("gh: review check skipped (%s)\n" % gate_clean(str(number)))
            return None
        raw = gate_run_gh(gh, ["pr", "view", str(number), "-R", repo, "--json", "reviews,headRefOid,reviewDecision"], deadline, env)
        try:
            data = json.loads(raw) if raw else None
        except ValueError:
            data = None
        if not isinstance(data, dict):
            sys.stderr.write("gh: review check skipped (the reviews of %s#%d could not be read): not checked\n" % (repo, number))
            return None
        head = data.get("headRefOid") if isinstance(data.get("headRefOid"), str) else ""
        blockers = ["%s: CHANGES_REQUESTED" % who for who in review_blockers(data.get("reviews"), head, data.get("reviewDecision"))]
        blockers += [gate_clean(b) for b in tagged_blockers(data.get("reviews"), head)]
        binary = switchboard_binary()
        if binary and head:
            done = lookup.run([binary, "review", "blockers", "%s#%d" % (repo, number), "--head", head])
            if done is not None and done.returncode == 0:
                blockers += [gate_clean(line.strip()) for line in done.stdout.splitlines() if line.strip()][:5]
            else:
                sys.stderr.write("gh: review check: the switchboard's recorded verdicts could not be read: only GitHub's reviews were checked\n")
        elif not binary or not head:
            sys.stderr.write("gh: review check: the switchboard's recorded verdicts could not be read (no switchboard or no head): only GitHub's reviews were checked\n")
        if not blockers:
            return None
        names = "; ".join(blockers[:5])
        if found and len(reason) >= 10:
            who = lookup.identity().get("name") or "agent"
            shown = gate_clean(reason)[:100]   # the reason alone is clipped, so the head and the overridden reviews always fit the logged line
            logged = gate_spool("over_review", repo, number, "merge", "by %s at %s | over: %s | reason: %s" % (who, head[:12], names[:60], shown))
            if not logged:   # an override nobody can audit is not made
                return "gh: merge of %s#%d refused: blocking review(s): %s. The --over-review could not be logged (no writable switchboard state), so it was not made" % (
                    repo, number, names)
            sys.stderr.write("gh: merging %s#%d over a blocking review on purpose (%s); logged\n" % (repo, number, names))
            return None
        why = ("--over-review needs a reason of at least 10 characters" if found else
               "resolve them, or pass --over-review '<reason of at least 10 characters>' (it is logged)")
        return "gh: merge of %s#%d refused: blocking review(s): %s. %s" % (repo, number, names, why)
    except Exception:
        sys.stderr.write("gh: review check skipped (an unexpected error): not checked\n")
        return None


def gate_probe(args, lookup, gh=None):
    """Ask the switchboard whether this ready or merge is allowed. Returns None (run the real gh as given), ("refuse", line)
    (print the line, exit non-zero, do not run gh) or ("args", new_args) (run gh with these). Never raises: every doubt is a
    fail-open, recorded in the spool when the shim could not tell which PR it was. `gates-check` exits 10 only for a refusal that
    applies in the repo's mode, and the shim also requires the reply to say `enforce`, so a shadow repo never refuses here."""
    try:
        if os.environ.get("FLEET_SWITCHBOARD_OWN_GH") == "1":
            return None
        if len(args) < 2 or args[0] != "pr" or args[1] not in ("ready", "merge"):
            return None
        listed = gate_repos()
        if not listed:
            return None   # no plan_gates: nothing is probed and nothing is asked
        check = args[1]
        parsed = gate_parse(args)
        if parsed is None:
            gate_spool("fail_open", None, None, check, "shape not understood: not checked")
            return None
        binary = switchboard_binary()
        deadline = time.time() + gate_seconds()
        env = None
        if gh is not None:
            try:
                env = account_env(gh, lookup)
            except AppMintRefused as err:
                return ("refuse", str(err))
            except Exception:
                env = None
        repo, number = gate_resolve(parsed, gh, env, deadline)
        if repo is None:
            gate_spool("fail_open", None, None, check, number)   # `number` carries the reason here
            return None
        if repo.lower() not in listed:
            return None
        if not binary:
            gate_spool("fail_open", repo, number, check, "no switchboard to ask")
            return None
        try:
            done = subprocess.run([binary, "gates-check", "%s#%d" % (repo, number), "--for", check, "--json"],
                                  capture_output=True, text=True, timeout=gate_seconds(), stdin=subprocess.DEVNULL,
                                  env=dict(os.environ, FLEET_SWITCHBOARD_OWN_GH="1"))
        except subprocess.TimeoutExpired:
            gate_spool("fail_open", repo, number, check, "no answer within %gs" % gate_seconds())
            return None
        except (OSError, subprocess.SubprocessError) as err:
            gate_spool("fail_open", repo, number, check, "could not run gates-check: %s" % err)
            return None
        try:
            payload = json.loads(done.stdout)
            if not isinstance(payload, dict):
                payload = {}
        except ValueError:
            payload = {}
        if done.returncode not in (0, 10):
            gate_spool("fail_open", repo, number, check, "gates-check exited %d" % done.returncode)
            return None
        if payload.get("mode") != "enforce":
            if done.returncode == 10:
                gate_spool("fail_open", repo, number, check, "exit 10 without an enforce reply: not refused")
            return None
        if done.returncode == 10:
            message = gate_clean(str(payload.get("message") or "").splitlines()[0] if payload.get("message") else "")
            if not message:
                message = "fleet-switchboard: %s of %s#%d refused by the plan gates (no detail given)." % (check, repo, number)
            gate_spool("refused", repo, number, check, message)
            return ("refuse", message[:600])
        if check == "merge":
            return gate_bind_merge(args, parsed, repo, number, payload)
        return None
    except Exception:
        return None   # a probe must never stop a command


def gate_bind_merge(args, parsed, repo, number, payload):
    """In an enforcing repo the merge is bound to the head that was checked (a push between the check and the merge makes the
    real merge fail), and `--auto` is refused: it merges later, at a head nobody checked. Every --match-head-commit the caller
    gave (any spelling, repeated, empty or without a value) is dropped and replaced by one with the checked head; a caller value
    that names another head is refused."""
    ref = "%s#%d" % (repo, number)
    if parsed["auto"]:
        return ("refuse", "fleet-switchboard: merge of %s refused: --auto merges later at a head nobody checked while this repo enforces "
                          "the plan gates. Way out: merge when ready, with --match-head-commit <sha>." % ref)
    head = payload.get("head")
    if not isinstance(head, str) or not re.fullmatch(r"[0-9a-f]{40}", head):
        gate_spool("fail_open", repo, number, "merge", "no head to bind the merge to")
        return None
    for _, _, given in parsed["match"]:
        if given and given.strip().lower() != head:
            return ("refuse", "fleet-switchboard: merge of %s refused: --match-head-commit %s is not the head the gates were checked at (%s). "
                              "Way out: re-run with the current head." % (ref, gate_clean(given)[:40], head))
    new = list(args)
    for start, stop, _ in sorted(parsed["match"], reverse=True):
        del new[start:stop]
    return ("args", new + [MATCH_FLAG, head])


HOLD_MODULE = [None, False]   # (module, tried): gh_hold.py beside this file, loaded by path (a plain `import` would need a package)


def load_hold():
    """The hold-label and audit module, or None when it cannot be loaded."""
    if not HOLD_MODULE[1]:
        HOLD_MODULE[1] = True
        try:
            path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "gh_hold.py")
            spec = importlib.util.spec_from_file_location("gh_hold", path)
            module = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(module)
            HOLD_MODULE[0] = module
        except Exception:
            HOLD_MODULE[0] = None
    return HOLD_MODULE[0]


RETRY_HOLD = "gh: hold-label check failed, retry (the fleet shim hit an unexpected error and refuses this write rather than let it through)"


def hold_probe(args, lookup, gh, write):
    """(refusal text or None, repo or None, number or None): see gh_hold.py. A missing or broken module refuses a WRITE while the config names a hold
    (fail closed) and is otherwise silent; that fallback re-reads the config text itself (a missing file means nothing is configured, any other read
    error counts as naming a hold). Any other unexpected error in the probe refuses a write and lets a read run. The label read uses the account the write would use."""
    try:
        module = load_hold()
        if module is None:
            try:
                with open(os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config"),
                                       "fleet-switchboard", "config.json")) as handle:
                    named = "hold_labels" in handle.read()
            except FileNotFoundError:
                named = False
            except Exception:
                named = True                      # a config that cannot be read is not known to name no hold: a write is refused
            return ("gh: the hold-label check could not be loaded, retry (the fleet shim refuses this write rather than let it through)"
                    if named and write else None), None, None
        env = None
        try:
            env = account_env(gh, lookup, args=args)
        except AppMintRefused as err:
            return str(err), None, None
        except Exception:
            env = None
        got = module.check(args, module.Ctx(gh, env, lambda: lookup.identity().get("name"), write))
        return got.refusal, got.repo, got.number
    except Exception:
        # an unexpected error in this glue (the check itself never raises): a WRITE is refused, a read runs
        return (RETRY_HOLD if write else None), None, None


def audit_write(args, lookup, outcome, write, repo=None, number=None):
    """One audit line for a gh write (never a command line); best effort, never changes the command."""
    try:
        if not write or os.environ.get("FLEET_SWITCHBOARD_OWN_GH") == "1" or is_git_credential(args):
            return
        module = load_hold()
        if module is not None:
            module.write_audit(args, my_name(lookup), outcome, repo, number)
    except Exception:
        pass


def refusal_text(err):
    """The one line a refused credential request says. A worker with no repository of its own gets the fix by name; any other refusal names the repository."""
    if isinstance(err, NoOwnRepository):
        return ("gh: this worker has no repository of its own (it was launched without --repo and its working directory had no usable origin), so git cannot "
                "authenticate as a guess: the default repository's account is never used. Relaunch it with `fleet-switchboard launch ... --repo OWNER/NAME`\n")
    return "gh: no GitHub account is mapped for %s: git cannot authenticate as a guess (add the repository or its owner to gh_users)\n" % _clean_reason(str(err))


def main(args):
    try:
        return run(args)
    finally:
        app_cleanup()   # a token file made for this call never outlives it


def run(args):
    gh = real_gh()
    if gh is None:
        sys.stderr.write("gh: not found on PATH (the fleet shim found no real gh behind it)\n")
        return 127
    plan = None
    args, over_found, over_reason = take_over_review(args)   # the shim's own flag never reaches gh or the signing
    write = is_write(args)
    lookup = Lookup(write=write)   # one identity lookup, one deadline, for the name and the account together
    held, hold_repo, hold_number = hold_probe(args, lookup, gh, write)   # a hold label refuses before anything else is asked (#376)
    if held:
        sys.stderr.write(held.strip() + "\n")
        audit_write(args, lookup, "refused", write, hold_repo, hold_number)
        return 1
    try:
        plan = signed_call(args, my_name(lookup)) if len(args) >= 3 and (args[0], args[1]) in SIGNED_COMMANDS else None
    except Exception:
        plan = None  # never let signing stop the command
    refusal = review_probe(args, over_found, over_reason, lookup, gh)
    if refusal is not None:
        sys.stderr.write(refusal + "\n")
        audit_write(args, lookup, "refused", write, hold_repo, hold_number)
        return 10
    verdict = gate_probe(args, lookup, gh)
    if verdict is not None and verdict[0] == "refuse":
        sys.stderr.write(gate_clean(verdict[1]) + "\n")
        audit_write(args, lookup, "refused", write, hold_repo, hold_number)
        return 10
    if verdict is not None:
        args = verdict[1]
    credential = is_git_credential(args)
    extra = {"credential": True} if credential else {}   # only the git credential route passes the keyword: every other call is exactly as it was
    try:
        env = account_env(gh, lookup, strict=is_write(args), args=args, **extra)
    except NoAccountMapped as err:
        sys.stderr.write(refusal_text(err))
        return 1
    except AppMintRefused as err:
        sys.stderr.write(str(err) + "\n")
        audit_write(args, lookup, "refused", write, hold_repo, hold_number)
        return 1
    except AccountLookupFailed:
        try:
            env = account_env(gh, Lookup(write=True), strict=True, args=args, **extra)   # retry the lookup ONCE with a fresh deadline
        except NoAccountMapped as err:
            sys.stderr.write(refusal_text(err))
            return 1
        except AppMintRefused as err:
            sys.stderr.write(str(err) + "\n")
            return 1
        except AccountLookupFailed:
            sys.stderr.write("gh: account lookup failed, retry (the fleet shim could not find which GitHub account this write is for, and will not "
                             "fall back to the inherited token)\n")
            audit_write(args, lookup, "refused", write, hold_repo, hold_number)
            return 1
    audit_write(args, lookup, "passed", write, hold_repo, hold_number)
    warn_text(args)
    served = None
    try:
        own = os.environ.get("FLEET_SWITCHBOARD_OWN_GH") == "1"
        words = command_words(args)
        if not own and words and words[0] not in NO_NETWORK_GROUPS:
            ident = lookup.identity() if (write or cacheable_read(args)) else {}
            agent = ident.get("name")
            if write:
                cache_drop(agent)   # a write by this agent: its cached answers go before the write runs
            account = COUNT_ACCOUNT[0] or "default"
            low = budget_low(account)
            if low is not None:
                warn_low(account, low)
            if not write and plan is None and not APP_DIRS:
                served = cached_read(gh, env, args, agent, account, low)
    except Exception:
        served = None   # the cache never fails the command
    if served is not None:
        return served
    count_call(args)
    if plan is None:
        if APP_DIRS:   # a token file has to be removed after the call: gh runs as a child, not in place of this process
            child = subprocess.Popen([gh] + args, env=env)
            APP_CHILD.append(child)
            return child.wait()
        if env is not None:
            os.execve(gh, [gh] + args, env)
        os.execv(gh, [gh] + args)
    argv, stdin_text, temp = plan
    try:
        done = subprocess.run([gh] + argv, input=stdin_text, text=True if stdin_text is not None else None, env=env)
        return done.returncode
    finally:
        if temp:
            try:
                os.unlink(temp)
            except OSError:
                pass


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
