#!/usr/bin/env python3
"""git, with the network verbs' credentials routed through the fleet's gh shim.

Git's global credential helper is whatever the machine set (often one stored github.com login), so `git push` from an agent's shell went out as that
login and GitHub answered 403 for a repository another account owns. The fleet's `gh` shim already picks the right GitHub account for the caller's
repository, from its session (the `gh_users` map). This shim is put first on an agent's PATH by the `fleet-hooks` plugin's shell hook, next to `gh`, so an agent
keeps typing plain `git push` and the credential comes from `gh auth git-credential` (the shim: which fails closed when the account lookup fails or no account is mapped for the caller's repository).

When `gh_users` is configured (and FLEET_GIT_SHIM is not `off`), for the NETWORK verbs only (push, fetch, pull, clone, ls-remote, `remote update|show|prune`) it puts, BEFORE the verb and after any global options,
    -c credential.https://github.com.helper=                          (empty: reset the helper list for this host)
    -c 'credential.https://github.com.helper=!gh auth git-credential'  (the fleet's gh)
A stack-changing `git stash` (everything but `stash list` and `stash show`) is refused with exit status 1, a message to commit to a scratch branch and nothing created
(shims/stash_guard.py: aliases, global options and the like are resolved first).
Everything else, and anything it does not understand, runs the real git with the arguments, standard input and exit status unchanged: this must
never block a command. A caller that passes its own `-c credential.*` (or `--config-env=credential.*`) is left alone. No token is read, printed or
put in an argument here: the helper does that, in git's own process. The real git is found by skipping this shim's own directory (never itself).
"""
import json
import os
import re
import subprocess
import sys

NETWORK_VERBS = {"push", "fetch", "pull", "clone", "ls-remote"}
VALUE_OPTIONS = {"-C", "-c", "--git-dir", "--work-tree", "--namespace", "--super-prefix", "--config-env", "--attr-source"}
RESET_HELPER = "credential.https://github.com.helper="
FLEET_HELPER = "credential.https://github.com.helper=!gh auth git-credential"


def routing_wanted():
    """Route only when per-repository accounts are in use (`gh_users` of the switchboard's config is not empty) and FLEET_GIT_SHIM is not `off`: a fleet with one
    account, or none, keeps git's own credentials exactly as they were."""
    if os.environ.get("FLEET_GIT_SHIM", "").strip().lower() == "off":
        return False
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    try:
        with open(os.path.join(base, "fleet-switchboard", "config.json")) as handle:
            users = json.load(handle).get("gh_users")
    except (OSError, ValueError, AttributeError):
        return False
    return isinstance(users, dict) and bool(users)


def real_git():
    """FLEET_REAL_GIT when set and executable, else the first executable named git on PATH that is not this shim (by directory and by file)."""
    own_file = os.path.realpath(os.path.abspath(__file__))
    own_dir = os.path.dirname(own_file)
    override = os.environ.get("FLEET_REAL_GIT")
    if override and os.path.isabs(override) and os.access(override, os.X_OK) and os.path.realpath(override) != own_file:
        return override
    for entry in os.environ.get("PATH", "").split(os.pathsep):
        if not entry or os.path.realpath(entry) == own_dir:
            continue
        candidate = os.path.join(entry, "git")
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK) and os.path.realpath(candidate) != own_file:
            return candidate
    return None


def parse(args):
    """(index of the verb or None, the global `-c`/`--config-env` settings given before it). Only git's own global options are skipped; an
    option this does not know ends the search with no verb (the command then runs unchanged)."""
    settings, i = [], 0
    while i < len(args):
        a = args[i]
        if a in VALUE_OPTIONS:
            if i + 1 >= len(args):
                return None, settings
            if a in ("-c", "--config-env"):
                settings.append(args[i + 1])
            i += 2
        elif a.startswith("--config-env="):
            settings.append(a.split("=", 1)[1])
            i += 1
        elif a.startswith("--") and "=" in a:
            i += 1   # --git-dir=x, --exec-path=x, --work-tree=x ...
        elif a.startswith("-"):
            i += 1   # a global flag without a value (-p, -P, --no-pager, --bare, --paginate, ...)
        else:
            return i, settings
    return None, settings


def is_network(args, verb_at):
    verb = args[verb_at]
    if verb in NETWORK_VERBS:
        return True
    if verb == "remote":
        rest = [a for a in args[verb_at + 1:] if not a.startswith("-")]
        return bool(rest) and rest[0] in ("update", "show", "prune")
    return False


def routed(args):
    """The arguments to give the real git."""
    try:
        verb_at, settings = parse(args)
        if verb_at is None or not is_network(args, verb_at) or not routing_wanted():
            return args
        if any(s.split("=", 1)[0].strip().lower().startswith("credential.") for s in settings):
            return args   # the caller chose its own credential configuration (any credential.* key opts out, for any host)
        return args[:verb_at] + ["-c", RESET_HELPER, "-c", FLEET_HELPER] + args[verb_at:]
    except Exception:
        return args   # never let the routing stop a command


def stash_refusal(args, git):
    """The refusal text for a stack-changing `git stash` (the logic is in stash_guard.py beside this file), else None. If that module cannot be loaded, any argument
    that mentions stash is refused and the rest runs."""
    try:
        sys.dont_write_bytecode = True
        sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
        import stash_guard
        return stash_guard.refusal(args, git)
    except Exception:
        if any("stash" in a.lower() for a in args):
            return "git: refused: the stash guard could not be loaded, so `git stash` is not run. Commit to a scratch branch instead.\n"
        return None


def switchboard_answer():
    """`whoami --json` of the switchboard as a dict, or None (no switchboard, it failed, or it did not answer within 5 seconds)."""
    binary = os.environ.get("FLEET_SWITCHBOARD_BIN") or os.path.realpath(os.path.join(os.path.expanduser("~"), ".local", "bin", "fleet-switchboard"))
    if not (os.path.isabs(binary) and os.path.isfile(binary) and os.access(binary, os.X_OK)):
        return None
    try:
        done = subprocess.run([binary, "whoami", "--json"], capture_output=True, text=True, timeout=5, stdin=subprocess.DEVNULL)
        data = json.loads(done.stdout) if done.returncode == 0 else None
    except (OSError, subprocess.SubprocessError, ValueError):
        return None
    return data if isinstance(data, dict) else None


def push_refusal(args, git):
    """The refusal text for a `git push` by a worker launched with a read-only extra repository (`--read-repo`, #618) whose target is that repository (or cannot be
    read as a GitHub `owner/name` at all: fail closed), else None. A shim guard, not a GitHub guard: it judges an explicit url only (a named remote is not resolved). A worker with no
    such grant, no `gh_users`, or no answer from the switchboard is never touched (the gh shim's credential route fails closed on its own)."""
    try:
        verb_at, _ = parse(args)
        if verb_at is None or args[verb_at] != "push" or not routing_wanted():
            return None
        data = switchboard_answer()
        if data is None or "read_repo" not in data:
            return None
        extra = data["read_repo"]
        if not (isinstance(extra, str) and re.fullmatch(r"[a-z0-9_.-]+/[a-z0-9_.-]+", extra)):
            return "git: refused: this worker's read-only repository record cannot be read, so the fleet shim refuses every push rather than run with no restriction\n"
        for arg in args[verb_at + 1:]:   # EVERY argument is judged (an option's value, `--repo=URL`, a url anywhere): which one is the target is never guessed
            text = arg.split("=", 1)[1] if arg.startswith("--") and "=" in arg else arg
            if "github.com" not in text.lower() and "://" not in text and not text.startswith("git@"):
                continue   # a branch, a refspec or a remote name: a named remote is not resolved (no shim reads a directory's remote settings, #473)
            m = re.fullmatch(r"(?:https://github\.com/|git@github\.com:)([A-Za-z0-9_.-]+)/([A-Za-z0-9_.-]+?)(?:\.git)?/?", text)
            if not m:
                return "git: refused: this worker has a read-only repository, so a push naming a url that cannot be read as a GitHub owner/name is refused\n"
            if ("%s/%s" % (m.group(1), m.group(2))).lower() == extra:
                return "git: refused: %s is read only for this worker (a shim guard): it may fetch there, never push\n" % extra
        return None
    except Exception:
        return "git: refused: the read-only repository check failed, so this push is not run (the fleet shim fails closed)\n"


def main(args):
    git = real_git()
    if git is None:
        sys.stderr.write("git: not found on PATH (the fleet shim found no real git behind it)\n")
        return 127
    refused = stash_refusal(args, git)
    if refused:
        sys.stderr.write(refused)
        return 1
    refused = push_refusal(args, git)
    if refused:
        sys.stderr.write(refused)
        return 1
    try:
        os.execv(git, [git] + routed(args))
    except OSError as err:
        sys.stderr.write("git: cannot run %s (%s)\n" % (git, err.strerror or err))
        return 126


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
