+  # The cloud launcher suite (bin/test-cloud-launcher.chain) in 4 shards, beside `test-cloud` (needs only `plan`) (ask #2500). One step of the whole chain outgrew its
+  # 20-minute limit on 12 November 2026 (about 90 of 187 entries done at the limit). `CLOUD_LAUNCHER_SHARD=K/N` (`--shard K/N`) takes every N-th entry of the chain file, so the chain stays the
+  # one list of files; bin/check-launcher-shards fails when a file is in no job or in two. Check names: `<cloud name> launcher K/4`.
+  # timeout-minutes 45 (was 20 on the whole-suite step): the stop-gap value, at least 1.5 times a shard's estimated duration on either system (see the pull request); tighten it once the split run is read.
+  test-cloud-launcher:
+    needs: plan
+    name: ${{ matrix.cloud }} launcher ${{ matrix.shard }}/4
+    strategy:
+      fail-fast: false
+      matrix:
+        shard: [1, 2, 3, 4]
+        include: ${{ fromJSON(needs.plan.outputs.matrix) }}
+    runs-on: ${{ matrix.os }}
+    defaults:
+      run:
+        shell: bash
+    steps:
+      - uses: actions/checkout@v5
+        with:
+          # Full history: test-fleet-doctor-heartbeat compares against a baseline commit.
+          fetch-depth: 0
+          # Empty for every run but the nightly: the event's own ref. The nightly checks out its leg's branch.
+          ref: ${{ matrix.ref }}
+
+      - run: python3 --version
+
+      - name: bin/check-launcher-shards
+        run: bin/check-launcher-shards
+
+      - name: bin/test-cloud-launcher
+        timeout-minutes: 45
+        env:
+          CLOUD_LAUNCHER_SHARD: ${{ matrix.shard }}/4
+        run: |
+          bin/test-cloud-launcher 2>&1 | tee "$RUNNER_TEMP/out.txt"
+          grep -qx 'RESULT: PASS' "$RUNNER_TEMP/out.txt"
+
   # The cloud suites run beside the job above, not after it (both need only `plan`): the macOS check ends at the slower of the two. Check names:
   # `test-cloud (<os>)` for the two operating systems (`nightly-cloud <ref> (<os>)` in the nightly). Same matrix, runner and shell as `test`.
   test-cloud:
