#!/usr/bin/env python3
"""test-shards: split the test classes of bin/test-switchboard into balanced shards.

    tools/test-shards [--n N]                 print each shard's class list and its table seconds
    tools/test-shards --refresh LOG           update tests/switchboard/class_times.json from a log of lines `CLASS <name> <seconds>`

bin/test-switchboard --shard I/N uses shard_of() below: classes go longest-first (table seconds) to the lightest shard;
a class missing from the table is placed by a stable hash of its name. Standard library only.
"""
import hashlib
import importlib.machinery
import importlib.util
import json
import sys
import unittest
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]
TABLE = REPO / "tests" / "switchboard" / "class_times.json"


def load_table(path=TABLE):
    return json.loads(Path(path).read_text())


def partition(classes, times, n):
    """Return n lists of class names; every class lands in exactly one."""
    shards = [[] for _ in range(n)]
    load = [0.0] * n
    known = sorted((c for c in set(classes) if c in times), key=lambda c: (-times[c], c))
    for c in known:
        i = min(range(n), key=lambda k: (load[k], k))
        shards[i].append(c)
        load[i] += times[c]
    for c in sorted(c for c in set(classes) if c not in times):
        shards[int(hashlib.sha256(c.encode()).hexdigest(), 16) % n].append(c)
    return shards


def check(shards, classes):
    """Problems (strings) of a split: each class must be in exactly one shard."""
    problems = []
    for c in sorted(set(classes)):
        where = [k + 1 for k, shard in enumerate(shards) if c in shard]
        if not where:
            problems.append("class %s is in no shard" % c)
        elif len(where) > 1:
            problems.append("class %s is in %d shards (%s)" % (c, len(where), ", ".join(map(str, where))))
    return problems


def parse_shard(text):
    i, _, n = text.partition("/")
    i, n = int(i), int(n)
    if not 1 <= i <= n:
        raise ValueError("--shard I/N needs 1 <= I <= N, got %r" % text)
    return i, n


def class_of(case):
    return case.__class__.__name__


def cases_of(suite):
    for item in suite:
        if isinstance(item, unittest.TestSuite):
            yield from cases_of(item)
        else:
            yield item


def select(suite, i, n, times=None):
    """Keep the cases of shard i of n (1-based) from a loaded suite."""
    cases = list(cases_of(suite))
    names = [class_of(c) for c in cases]
    mine = set(partition(names, load_table() if times is None else times, n)[i - 1])
    keep = unittest.TestSuite()
    for group in suite:   # the two-level shape main() walks: a suite of per-class suites
        members = [c for c in cases_of(group)] if isinstance(group, unittest.TestSuite) else [group]
        picked = [c for c in members if class_of(c) in mine]
        if picked:
            keep.addTest(unittest.TestSuite(picked))
    return keep


def refresh(log, path=TABLE):
    times = load_table(path) if Path(path).exists() else {}
    for line in Path(log).read_text().splitlines():
        parts = line.split()
        if len(parts) == 3 and parts[0] == "CLASS":
            times[parts[1]] = round(float(parts[2]), 1)
    Path(path).write_text(json.dumps(times, indent=0, sort_keys=True) + "\n")
    return times


def main(argv):
    n = 6
    if "--n" in argv:
        n = int(argv[argv.index("--n") + 1])
    if "--refresh" in argv:
        refresh(argv[argv.index("--refresh") + 1])
        return 0
    loader = importlib.machinery.SourceFileLoader("test_switchboard_main", str(REPO / "bin" / "test-switchboard"))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    sys.modules[loader.name] = mod
    loader.exec_module(mod)
    suite = unittest.TestLoader().loadTestsFromModule(mod)
    names = sorted({class_of(c) for c in cases_of(suite)})
    times = load_table()
    for k, shard in enumerate(partition(names, times, n), 1):
        print("shard %d/%d: %.1fs, %d classes" % (k, n, sum(times.get(c, 0) for c in shard), len(shard)))
        for c in sorted(shard):
            print("  " + c)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
