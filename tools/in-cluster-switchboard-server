def _load_account_repos():
    """Map each GitHub account to its repos, from config.json plus SWITCHBOARD_EXTRA_REPOS."""
    out = {}
    try:
        cfg_path = CONFIG_DIR / "config.json"
        cfg = json.loads(cfg_path.read_text()) if cfg_path.exists() else {}
        gh_users = cfg.get("gh_users") or {}
        repos = list(cfg.get("github_repos") or [])
        extra = [r.strip() for r in (os.environ.get("SWITCHBOARD_EXTRA_REPOS") or "").split(",") if r.strip()]
        for r in repos + extra:
            acct = gh_users.get(r) or gh_users.get(r.split("/")[0] + "/*")
            if acct and r not in out.setdefault(acct, []):
                out[acct].append(r)
    except (OSError, ValueError, AttributeError) as err:
        print(json.dumps({"ts": iso_now(), "event": "account_repos_error", "error": str(err)[:160],
                          "hint": "fix config.json; no tokens will be minted"}), flush=True)
    return out


