def _manifest_mode(app_root=APP_ROOT):
    try:
        import re
        text = (Path(app_root) / "cloud" / "k8s" / "switchboard.yaml").read_text(encoding="utf-8")
        m = re.search(r'"name":\s*"SWITCHBOARD_MODE",\s*"value":\s*"([^"]*)"', text)
        return (m.group(1) if m else "").strip()
    except OSError:
        return ""


