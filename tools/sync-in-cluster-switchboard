#!/usr/bin/env python3
"""Sync a clean git archive of HEAD into the running fleet-switchboard pod, verify CODE_SHA, restart it."""
import argparse
import hashlib
import json
import pathlib
import re
import importlib.util
import os
import subprocess
import sys

NAMESPACE = "cw"
APP = "/run/home/app"
PATHS = ["agents", "bin", "cloud/k8s", "cloud/launcher", "docs", "plugins", "shims", "skills", "templates", "tools"]


def run(cmd, **kw):
    return subprocess.run(cmd, check=True, **kw)


def head_sha():
    return subprocess.check_output(["git", "rev-parse", "HEAD"], text=True).strip()


_KUBE_BASE = None


def kubectl_base():
    global _KUBE_BASE
    if _KUBE_BASE is not None:
        return list(_KUBE_BASE)
    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    azure_dir = os.path.expanduser("~/.azure-fleetkit")
    if not os.environ.get("AZURE_CONFIG_DIR") and os.path.isdir(azure_dir):
        os.environ["AZURE_CONFIG_DIR"] = azure_dir
    spec = importlib.util.spec_from_file_location("cw_lib", os.path.join(root, "cloud", "launcher", "cloud_worker.py"))
    lib = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(lib)
    lib.apply_settings()
    base = ["kubectl"]
    for flag, name in (("--server", "CW_CLOUD_SERVER"), ("--certificate-authority", "CW_CLOUD_CA_FILE")):
        if os.environ.get(name):
            base += [flag, os.environ[name]]
    if os.environ.get("CW_CLOUD_SERVER"):
        base += ["--token", lib.cluster_token(os.environ, duration="30m")]
    _KUBE_BASE = base + ["-n", NAMESPACE]
    return list(_KUBE_BASE)


def kubectl_out(args):
    return subprocess.check_output(kubectl_base() + args, text=True).strip()


def find_pod():
    out = kubectl_out(["get", "pods", "-o", "name"])
    pods = [l.split("/", 1)[-1] for l in out.splitlines() if "fleet-switchboard" in l]
    if not pods:
        raise SystemExit("no fleet-switchboard pod found in namespace %s" % NAMESPACE)
    return pods[0]


def pod_exec(pod, script, stdin=None):
    return subprocess.run(kubectl_base() + ["exec", "-i", pod, "--", "sh", "-c", script],
                          input=stdin, check=True, stdout=subprocess.PIPE).stdout


def check_shas(head, pod_sha, pinned=""):
    """Return an error string, or '' when consistent."""
    if len(head) != 40:
        return "HEAD is not a 40-char SHA: %r" % head
    if pod_sha != head:
        return "pod CODE_SHA %r != HEAD %s" % (pod_sha, head)
    if pinned and (pinned == "UNPINNED" or pinned != head):
        return "SWITCHBOARD_PINNED_SHA %s != HEAD %s" % (pinned, head)
    return ""


CODE_TREE_PATHS = ("bin", "tools", "shims", "docs")


def compute_code_tree_hash(root="."):
    root_p = pathlib.Path(root)
    h = hashlib.sha256()
    for top in CODE_TREE_PATHS:
        base = root_p / top
        if not base.exists():
            continue
        for p in sorted(base.rglob("*")):
            if p.is_file() and "__pycache__" not in p.parts:
                h.update((p.relative_to(root_p).as_posix() + "\0").encode("utf-8"))
                h.update(p.read_bytes())
                h.update(b"\0")
    return h.hexdigest()[:40]


def _manifest_value(name, root="."):
    try:
        text = (pathlib.Path(root) / "cloud" / "k8s" / "switchboard.yaml").read_text(encoding="utf-8")
    except OSError:
        return ""
    m = re.search(r'"name":\s*"%s",\s*"value":\s*"([^"]*)"' % name, text)
    return m.group(1).strip() if m else ""


def manifest_pinned_sha(root="."):
    return _manifest_value("SWITCHBOARD_PINNED_SHA", root)


def manifest_mode(root="."):
    return _manifest_value("SWITCHBOARD_MODE", root) or "shadow"


def pod_pinned(pod):
    script = (
        "import os, pathlib, re; "
        "p = pathlib.Path('/run/home/app/cloud/k8s/switchboard.yaml'); "
        "m = re.search(r'\"SWITCHBOARD_PINNED_SHA\",\\s*\"value\":\\s*\"([^\"]*)\"', p.read_text()) if p.exists() else None; "
        "v = os.environ.get('SWITCHBOARD_PINNED_SHA', '').strip(); "
        "print((m.group(1) if m else '') or v, end='')"
    )
    return kubectl_out(["exec", pod, "--", "python3", "-c", script])


def pod_tree_hash(pod):
    script = (
        "import importlib.machinery, importlib.util; "
        "l = importlib.machinery.SourceFileLoader('s', '/run/home/app/tools/in-cluster-switchboard-server'); "
        "sp = importlib.util.spec_from_loader('s', l); m = importlib.util.module_from_spec(sp); l.exec_module(m); "
        "print(m.compute_code_tree_hash('/run/home/app'), end='')"
    )
    return kubectl_out(["exec", pod, "--", "python3", "-c", script])


def cluster_config_bytes(path=None):
    p = pathlib.Path(path) if path else pathlib.Path.home() / ".config" / "fleet-switchboard" / "config.json"
    if not p.exists():
        return b""
    cfg = dict(json.loads(p.read_text(encoding="utf-8")))
    cfg["herdr"] = "/bin/true"
    cfg["opencode"] = "/bin/true"
    cfg.pop("external_decisions", None)
    if path is None:
        import getpass
        user = getpass.getuser()
        cfg.setdefault("awaiting_label", "%s:awaiting-user" % user)
        cfg.setdefault("awaiting_cos_label", "%s:awaiting-cos" % user)
    return (json.dumps(cfg, indent=2, sort_keys=True) + "\n").encode("utf-8")


def compute_config_hash(path=None):
    data = cluster_config_bytes(path)
    return hashlib.sha256(data).hexdigest()[:40] if data else ""


def pod_config_hash(pod):
    script = ("import hashlib, pathlib; p = pathlib.Path('/run/home/.config/fleet-switchboard/config.json'); "
              "print(hashlib.sha256(p.read_bytes()).hexdigest()[:40] if p.exists() else '', end='')")
    return kubectl_out(["exec", pod, "--", "python3", "-c", script])


def standing_orders_bytes(path=None):
    p = pathlib.Path(path) if path else pathlib.Path.home() / ".config" / "fleet-switchboard" / "standing-orders.md"
    return p.read_bytes() if p.exists() else b""


def compute_standing_orders_hash(path=None):
    data = standing_orders_bytes(path)
    return hashlib.sha256(data).hexdigest()[:40] if data else ""


def pod_standing_orders_hash(pod):
    script = ("import hashlib, pathlib; p = pathlib.Path('/run/home/.config/fleet-switchboard/standing-orders.md'); "
              "print(hashlib.sha256(p.read_bytes()).hexdigest()[:40] if p.exists() else '', end='')")
    return kubectl_out(["exec", pod, "--", "python3", "-c", script])


def watched_repos_from_snapshot(snap, cfg):
    """Sorted list of repos watched by live agents in `snap` that match a `gh_users` entry in `cfg`."""
    gh_users = (cfg or {}).get("gh_users") or {}
    watched = set()
    active_sessions = set()
    for a in (snap or {}).get("agents") or []:
        if isinstance(a, dict):
            s = a.get("agent_session")
            sid = s.get("value") if isinstance(s, dict) else s
            if isinstance(sid, str) and sid:
                active_sessions.add(sid)
    if (snap or {}).get("agents") and not active_sessions:
        return []  # agents present but none names a session: watch nothing, never widen to all
    for sid, sdata in ((snap or {}).get("sessions") or {}).items():
        if active_sessions and sid not in active_sessions:
            continue
        repo = (((sdata or {}).get("metadata") or {}).get("fleet") or {}).get("repo")
        if isinstance(repo, str) and "/" in repo:
            acct = gh_users.get(repo) or gh_users.get(repo.split("/", 1)[0] + "/*")
            if acct:
                watched.add(repo)
    return sorted(watched)


def check_watched_repos_readable(pod):
    """Return an error string when a live agent's repo is missing from github_repos or unreadable on the pod."""
    import inspect
    script = (
        "import importlib.machinery, importlib.util, json, os, pathlib\n"
        + inspect.getsource(watched_repos_from_snapshot)
        + "def load(p):\n"
        "    try:\n        return json.loads(pathlib.Path(p).read_text())\n"
        "    except (OSError, ValueError):\n        return {}\n"
        "cfg = load('/run/home/.config/fleet-switchboard/config.json')\n"
        "snap = load('/run/home/fleet_agents_snapshot.json')\n"
        "l = importlib.machinery.SourceFileLoader('s', '/run/home/app/tools/in-cluster-switchboard-server')\n"
        "sp = importlib.util.spec_from_loader('s', l); m = importlib.util.module_from_spec(sp); l.exec_module(m)\n"
        "errs = []\n"
        "gh_users = cfg.get('gh_users') or {}\n"
        "listed = cfg.get('github_repos') or []\n"
        "for r in watched_repos_from_snapshot(snap, cfg):\n"
        "    if r not in listed:\n        errs.append('%s watched by a live agent but not in github_repos' % r)\n"
        "    acct = gh_users.get(r) or gh_users.get(r.split('/', 1)[0] + '/*')\n"
        "    tf = pathlib.Path('/run/home/tokens') / str(acct)\n"
        "    if not tf.exists():\n        errs.append('%s has no token for account %s' % (r, acct)); continue\n"
        "    tok = tf.read_text().strip()\n"
        "    for ep in ('', '/issues?state=open&per_page=1', '/pulls?state=closed&per_page=1'):\n"
        "        cp = m.inprocess_gh_api(['gh', 'api', 'repos/%s%s' % (r, ep)], {'GH_TOKEN': tok})\n"
        "        if cp is None or cp.returncode != 0:\n            errs.append('%s unreadable: %s' % (r, ep))\n"
        "print('; '.join(errs), end='')\n"
    )
    return kubectl_out(["exec", pod, "--", "python3", "-c", script])


MODE_FILE = "/run/home/.local/state/fleet-switchboard/switchboard-mode.json"


def rollback(pod):
    import signal
    state = pathlib.Path.home() / ".local" / "state" / "fleet-switchboard"
    relay = state / "switchboard-relay.json"
    try:
        data = json.loads(relay.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        data = {}
    data["authority"] = "shadow"
    state.mkdir(parents=True, exist_ok=True)
    relay.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
    resumed = False
    for name in ("daemon.json", "run.lock"):
        try:
            raw = (state / name).read_text(encoding="utf-8").strip()
            try:
                pid = int(json.loads(raw).get("pid"))
            except (ValueError, AttributeError, TypeError):
                pid = int(raw.split()[0])
            os.kill(pid, signal.SIGCONT)
            resumed = True
            break
        except (OSError, ValueError, IndexError):
            continue
    if not resumed:
        raise SystemExit("error: could not SIGCONT the Mac switchboard (no live pid in daemon.json or run.lock); pod unchanged")
    pod_exec(pod, "mkdir -p $(dirname %s) && printf '%%s' '{\"mode\": \"shadow\"}' > %s && "
                  "sed -i '/\"SWITCHBOARD_MODE\"/{n;s/\"value\": \"[^\"]*\"/\"value\": \"shadow\"/}' "
                  "%s/cloud/k8s/switchboard.yaml" % (MODE_FILE, MODE_FILE, APP))
    run(kubectl_base() + ["delete", "pod", pod, "--wait=false"])
    print("rolled back to Mac switchboard (cluster=shadow, mac=active)")
    return 0


def swap_script(tree, mode, app=APP, mode_file=MODE_FILE, server_copy="/run/home/in_cluster_switchboard_server.py"):
    """Shell that finalises the staged tree and swaps it into place; restores the old tree if the swap fails."""
    stage, old = app + ".stage", app + ".old"
    return ("printf %%s %s > %s/CODE_SHA && mkdir -p $(dirname %s) && printf '%%s' '{\"mode\": \"%s\"}' > %s && "
            "cp %s/tools/in-cluster-switchboard-server %s && "
            "if [ -d %s ]; then mv %s %s; fi && "
            "{ mv %s %s || { [ -d %s ] && mv %s %s; exit 1; }; } && rm -rf %s"
            % (tree, stage, mode_file, mode, mode_file, stage, server_copy,
               app, app, old, stage, app, old, old, app, old))


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--pinned-sha", default="")
    ap.add_argument("--verify-only", action="store_true", help="check live tree hash only; no sync or restart")
    ap.add_argument("--cutover", action="store_true", help="required to sync a manifest whose SWITCHBOARD_MODE is active")
    ap.add_argument("--rollback", action="store_true", help="return authority to the Mac switchboard (cluster=shadow)")
    a = ap.parse_args(argv)
    if a.rollback:
        return rollback(find_pod())
    head = head_sha()
    tree = compute_code_tree_hash(".")
    pod = find_pod()
    if not a.verify_only:
        archive = subprocess.check_output(["git", "archive", "--format=tar", "HEAD"] + PATHS)
        mode = manifest_mode(".")
        if mode == "active" and not a.cutover:
            print("error: manifest mode is active; pass --cutover to sync it", file=sys.stderr)
            return 1
        stage = APP + ".stage"
        old = APP + ".old"
        pod_exec(pod, "rm -rf %s %s && mkdir -p %s && tar -xf - -C %s" % (stage, old, stage, stage), archive)
        pod_exec(pod, swap_script(tree, mode))
    cfg_bytes = cluster_config_bytes()
    if not a.verify_only and cfg_bytes:
        pod_exec(pod, "mkdir -p /run/home/.config/fleet-switchboard && cat > /run/home/.config/fleet-switchboard/config.json", cfg_bytes)
    cfg_hash = compute_config_hash()
    if cfg_hash:
        pod_cfg = pod_config_hash(pod)
        if pod_cfg != cfg_hash:
            print("error: pod config.json hash %s != Mac config.json hash %s" % (pod_cfg, cfg_hash), file=sys.stderr)
            return 1
    so_bytes = standing_orders_bytes()
    if not a.verify_only and so_bytes:
        pod_exec(pod, "mkdir -p /run/home/.config/fleet-switchboard && cat > /run/home/.config/fleet-switchboard/standing-orders.md", so_bytes)
    so_hash = compute_standing_orders_hash()
    if so_hash and pod_standing_orders_hash(pod) != so_hash:
        print("error: pod standing-orders.md hash != Mac standing-orders.md hash %s" % so_hash, file=sys.stderr)
        return 1
    live_tree = pod_tree_hash(pod)
    pinned = a.pinned_sha or pod_pinned(pod)
    err = check_shas(tree, live_tree, pinned)
    if err:
        print("error: " + err, file=sys.stderr)
        return 1
    if not a.verify_only:
        err = check_watched_repos_readable(pod)
        if err:
            print("error: " + err, file=sys.stderr)
            return 1
        run(kubectl_base() + ["delete", "pod", pod, "--wait=false"])
    print("ok head=%s tree=%s" % (head, tree) + (" config=%s" % cfg_hash[:12] if cfg_hash else ""))
    return 0


if __name__ == "__main__":
    sys.exit(main())
