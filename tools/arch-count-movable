#!/usr/bin/env python3
"""arch-count-movable [TREE]: how many top-level classes of TREE/bin/test-switchboard can move whole (the fixpoint of the one-plan dry run of arch-test-move).

Reads only; writes one temporary plan file. Prints `classes N movable (fixpoint) M blocked K rounds R`."""
import ast
import json
import os
import re
import subprocess
import sys
import tempfile


def main():
    tree = os.path.abspath(sys.argv[1] if len(sys.argv) > 1 else ".")
    mover = os.path.join(os.path.dirname(os.path.abspath(__file__)), "arch-test-move")
    classes = [n.name for n in ast.parse(open(os.path.join(tree, "bin", "test-switchboard"), encoding="utf-8").read()).body if isinstance(n, ast.ClassDef)]
    left, rounds = list(classes), 0
    with tempfile.TemporaryDirectory() as scratch:
        plan = os.path.join(scratch, "plan.json")
        while True:
            rounds += 1
            json.dump({"all": left}, open(plan, "w"))
            run = subprocess.run([sys.executable, mover, "--source", "bin/test-switchboard", "--plan", plan, "--out-dir", "tests/switchboard"], cwd=tree, capture_output=True, text=True)
            blocked = {m.group(1) for m in re.finditer(r"^(\S+) uses \S+, which stays", run.stdout, re.M)}
            if not blocked & set(left):
                break
            left = [c for c in left if c not in blocked]
    print("classes %d movable (fixpoint) %d blocked %d rounds %d" % (len(classes), len(left), len(classes) - len(left), rounds))
    return 0


if __name__ == "__main__":
    sys.exit(main())
