#!/usr/bin/env python3
"""Host-only submitter and observer for `.spire/tool/bin/spire land` (#2570, #34).

Reads `CW_SECRET_DIR` (`cw-app-id`, `cw-app-key`, `cw-minter-kubeconfig`, and optional
`cw-stack-model-key`) and `CW_COUNCIL_URL` from `~/.config/fleet-switchboard/cloud.env` via
`pwd.getpwuid(os.getuid()).pw_dir` (never trusting `$HOME`). Refuses (exit 64) to run `check`
locally on the Mac host (`sys.platform == "darwin"`), and for `land` on the Mac host submits
and observes the landing on a cloud heavy-executor pod (`shape L`) so no test or check suite
runs on the host. Fails closed (exit 70) before running anything if the App ID, private key,
or present model key file is missing or unreadable.
"""
import base64
import datetime as dt
import json
import os
import pwd
import re
import shlex
import shutil
import stat
import subprocess
import sys
import tempfile
import time

NOT_CONFIGURED = 70
REFUSED_LOCAL = 64
MAX_ENV_BYTES = 65536
MAX_KEY_BYTES = 65536
DEFAULT_COUNCIL_URL = "https://openrouter.ai/api/v1"
SECRET_DIR = None
HOME_DIR = None


def _cloud_env_map():
    out = {}
    try:
        home = HOME_DIR or pwd.getpwuid(os.getuid()).pw_dir
        path = os.path.join(home, ".config", "fleet-switchboard", "cloud.env")
        with open(path, encoding="utf-8") as handle:
            text = handle.read(MAX_ENV_BYTES + 1)
        if len(text) <= MAX_ENV_BYTES:
            for line in text.splitlines():
                if "=" in line and not line.lstrip().startswith("#"):
                    k, v = line.split("=", 1)
                    out[k.strip()] = v.strip().strip("\"'")
    except (OSError, KeyError, UnicodeError):
        pass
    return out


def secret_dir():
    if SECRET_DIR:
        return SECRET_DIR
    return _cloud_env_map().get("CW_SECRET_DIR")


def _read_secret_file(path):
    st = os.lstat(path)
    if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or (st.st_mode & 0o077):
        raise ValueError("secret file is not a regular 0600 file owned by the current user")
    with open(path, encoding="utf-8") as handle:
        data = handle.read(MAX_KEY_BYTES + 1)
    if len(data) > MAX_KEY_BYTES or not data.strip():
        raise ValueError("secret file is empty or oversize")
    return data


def load_app_credentials():
    directory = secret_dir()
    if not directory or not os.path.isdir(directory):
        raise ValueError("CW_SECRET_DIR is not configured or not a directory")
    app_id = _read_secret_file(os.path.join(directory, "cw-app-id")).strip()
    app_key = _read_secret_file(os.path.join(directory, "cw-app-key"))
    if not app_id.isdigit():
        raise ValueError("cw-app-id is not a numeric GitHub App ID")
    return app_id, app_key


def load_council_model_key():
    directory = secret_dir()
    if not directory or not os.path.isdir(directory):
        return None
    key_path = os.path.join(directory, "cw-stack-model-key")
    if not os.path.lexists(key_path):
        return None
    return _read_secret_file(key_path).strip()


def _ensure_host_bash_shim():
    shim_dir = os.path.join(tempfile.gettempdir(), "spire-land-host-bin-%d" % os.getuid())
    os.makedirs(shim_dir, mode=0o700, exist_ok=True)
    for exe in ("bash", "flock"):
        src = os.path.join("/opt/homebrew/bin", exe)
        dst = os.path.join(shim_dir, exe)
        if os.access(src, os.X_OK) and not os.path.lexists(dst):
            os.symlink(src, dst)
    return shim_dir


def _origin_repo(root):
    done = subprocess.run(["git", "-C", root, "remote", "get-url", "origin"], capture_output=True, text=True, timeout=15)
    m = re.search(r"github\.com[:/]([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+?)(?:\.git)?/?$", (done.stdout or "").strip())
    if not m:
        raise ValueError("origin remote is not a github.com repository")
    return m.group(1)


def _release_floor_heavy_lease(proof, env, cfg, ns, ctrl, lease_sid):
    if not ctrl or not lease_sid:
        return
    proof.kube_run(
        ["kubectl", "-n", ns, "exec", ctrl, "--", "python3", "-c",
         "import sys; sys.path.insert(0, '/opt/floor'); import floor_controller as fc; "
         "fc._pg_run(\"DELETE FROM floor_live_sessions WHERE session_id=%s;\" % fc._sql_str(sys.argv[1]))",
         lease_sid],
        env, config=cfg,
    )


def _find_floor_heavy_pod(proof, env, cfg, ns, repo):
    pod = (env.get("CW_LAND_EXECUTOR_POD") or "").strip()
    if pod:
        return pod, "", ""
    res = proof.kube_run(["kubectl", "-n", ns, "get", "pods", "-o", "jsonpath={.items[*].metadata.name}"], env, config=cfg)
    names = (res.stdout or "").split() if res.returncode == 0 else []
    ctrl = next((n for n in names if n.startswith("floor-controller-")), "")
    lease_sid = "ses_host_heavy_%d" % os.getpid() if ctrl else ""
    if ctrl:
        ins = proof.kube_run(
            ["kubectl", "-n", ns, "exec", ctrl, "--", "python3", "-c",
             "import sys; sys.path.insert(0, '/opt/floor'); import floor_controller as fc; "
             "fc._pg_run(\"INSERT INTO floor_live_sessions(session_id, state, repo, branch, round, updated_at) "
             "VALUES (%s, 'landing', %s, 'main', 1, NOW()) ON CONFLICT (session_id) DO UPDATE SET state='landing', updated_at=NOW();\" "
             "% (fc._sql_str(sys.argv[1]), fc._sql_str(sys.argv[2]))); fc.set_fhex_scale(1)",
             lease_sid, repo],
            env, config=cfg,
        )
        if ins.returncode != 0:
            lease_sid = ""
    try:
        for _ in range(30):
            r = proof.kube_run(
                ["kubectl", "-n", ns, "get", "pods", "-o",
                 "jsonpath={range .items[*]}{.metadata.name}:{.status.phase}:{range .status.conditions[?(@.type=='Ready')]}{.status}{end}{\"\\n\"}{end}"],
                env, config=cfg,
            )
            for line in (r.stdout or "").splitlines():
                parts = line.strip().split(":")
                if len(parts) >= 3 and parts[0].startswith("fhex-") and parts[1] == "Running" and parts[2] == "True":
                    return parts[0], ctrl, lease_sid
            time.sleep(2)
    except BaseException:
        _release_floor_heavy_lease(proof, env, cfg, ns, ctrl, lease_sid)
        raise
    _release_floor_heavy_lease(proof, env, cfg, ns, ctrl, lease_sid)
    raise RuntimeError("no Running Ready Floor heavy-executor pod (fhex-*) found in namespace %s" % ns)


def submit_cloud_land(root, subcmd, app_id, app_key):
    sys.path.insert(0, os.path.join(root, "bin"))
    import cloud_image_proof as proof
    cenv = _cloud_env_map()
    env = dict(os.environ, CW_SECRET_DIR=secret_dir() or "", CW_PROOF_KUBECTL_TIMEOUT="900")
    cfg = proof.mint_token(env)
    ns = env.get("CW_CLOUD_NAMESPACE") or cenv.get("CW_CLOUD_NAMESPACE") or "cw"
    council_url = env.get("CW_COUNCIL_URL") or cenv.get("CW_COUNCIL_URL") or "http://copilot-bridge.%s.svc:8080" % ns
    repo = _origin_repo(root)
    head_sha = subprocess.check_output(["git", "-C", root, "rev-parse", "HEAD"], text=True, timeout=15).strip()
    tmp_dir = tempfile.mkdtemp(prefix="spire-land-bundle-")
    ctrl = lease_sid = ""
    try:
        pod, ctrl, lease_sid = _find_floor_heavy_pod(proof, env, cfg, ns, repo)
        bundle_path = os.path.join(tmp_dir, "cand.bundle")
        subprocess.run(["git", "-C", root, "bundle", "create", bundle_path, "HEAD"], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=60)
        with open(bundle_path, "rb") as bf:
            b64_bundle = base64.b64encode(bf.read()).decode("ascii")
        prep = (
            "base64 -d > /tmp/cand.bundle && rm -rf /home/worker/land-ws && "
            "if [ -d /work/repo/.git ]; then git clone -q /work/repo /home/worker/land-ws; else git init -q /home/worker/land-ws; fi && "
            "chmod 755 /home/worker/land-ws && "
            "git -C /home/worker/land-ws remote set-url origin https://github.com/%s.git && "
            "git -C /home/worker/land-ws fetch -q origin main && "
            "git -C /home/worker/land-ws fetch -q /tmp/cand.bundle HEAD && "
            "git -C /home/worker/land-ws checkout -q -B land-cand FETCH_HEAD && rm -f /tmp/cand.bundle" % repo
        )
        up = proof.kube_run(["kubectl", "-n", ns, "exec", "-i", pod, "--", "sh", "-c", prep], env, stdin=b64_bundle, config=cfg)
        if up.returncode != 0:
            sys.stderr.write((up.stdout or "") + (up.stderr or ""))
            return up.returncode or 1
        cmd_str = " ".join(shlex.quote(a) for a in ([".spire/tool/bin/spire"] + subcmd))
        run_sh = (
            "export PATH=\"/run/cw-tmp/bin:$PATH\" FLEET_APP_ID=%s FLEET_LAND_STATUSES=required "
            "COUNCIL_MODEL_URL=%s COUNCIL_MODEL_KEY=copilot-bridge; "
            "FLEET_APP_PRIVATE_KEY=\"$(cat)\" && export FLEET_APP_PRIVATE_KEY && "
            "cd /home/worker/land-ws && %s" % (shlex.quote(app_id), shlex.quote(council_url), cmd_str)
        )
        done = proof.kube_run(["kubectl", "-n", ns, "exec", "-i", pod, "--", "bash", "-c", run_sh], env, stdin=app_key, config=cfg)
        if done.stdout:
            sys.stdout.write(done.stdout)
        if done.stderr:
            sys.stderr.write(done.stderr)
        return int(done.returncode)
    finally:
        shutil.rmtree(tmp_dir, ignore_errors=True)
        _release_floor_heavy_lease(proof, env, cfg, ns, ctrl, lease_sid)


NIGHTLY_SUITES = (
    "bin/test-switchboard --shard 1/6",
    "bin/test-switchboard --shard 2/6",
    "bin/test-switchboard --shard 3/6",
    "bin/test-switchboard --shard 4/6",
    "bin/test-switchboard --shard 5/6",
    "bin/test-switchboard --shard 6/6",
    "bin/test-gh-hold",
    "bin/test-path-suites",
    "bin/test-cloud-neutral-names",
    "bin/test-cloud-worker",
    "env KUBECONFIG=/dev/null CLOUD_TEST_SKIP_DOCKER=1 cloud/tests/test-cloud",
)


def run_floor_nightly(root):
    sys.path.insert(0, os.path.join(root, "bin"))
    import cloud_image_proof as proof
    cenv = _cloud_env_map()
    env = dict(os.environ, CW_SECRET_DIR=secret_dir() or "", CW_PROOF_KUBECTL_TIMEOUT="1800")
    cfg = proof.mint_token(env)
    ns = env.get("CW_CLOUD_NAMESPACE") or cenv.get("CW_CLOUD_NAMESPACE") or "cw"
    repo = _origin_repo(root)
    pod, ctrl, lease_sid = _find_floor_heavy_pod(proof, env, cfg, ns, repo)
    try:
        prep = (
            "rm -rf /home/worker/nightly-ws && "
            "if [ -d /work/repo/.git ]; then git clone -q /work/repo /home/worker/nightly-ws; "
            "else git clone -q https://github.com/%s.git /home/worker/nightly-ws; fi && "
            "git -C /home/worker/nightly-ws remote set-url origin https://github.com/%s.git && "
            "git -C /home/worker/nightly-ws fetch -q origin main && "
            "git -C /home/worker/nightly-ws checkout -q -f origin/main" % (repo, repo)
        )
        up = proof.kube_run(["kubectl", "-n", ns, "exec", pod, "--", "sh", "-c", prep], env, config=cfg)
        if up.returncode != 0:
            sys.stderr.write((up.stdout or "") + (up.stderr or ""))
            return up.returncode or 1
        results = []
        failed = 0
        for suite in NIGHTLY_SUITES:
            t0 = time.monotonic()
            cmd = "export FLEET_HEAVY=off PATH=\"/run/cw-tmp/bin:/usr/local/bin:/usr/bin:/bin:$PATH\"; cd /home/worker/nightly-ws && %s" % suite
            r = proof.kube_run(["kubectl", "-n", ns, "exec", pod, "--", "bash", "-c", cmd], env, config=cfg)
            elapsed = round(time.monotonic() - t0, 1)
            ok = r.returncode == 0
            if not ok:
                failed += 1
            results.append({"suite": suite, "rc": r.returncode, "seconds": elapsed, "ok": ok})
        print(json.dumps({"pod": pod, "repo": repo, "failed": failed, "results": results}))
        return 1 if failed else 0
    finally:
        _release_floor_heavy_lease(proof, env, cfg, ns, ctrl, lease_sid)


def main(argv=None, workdir=None, runner=subprocess.run, platform=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    plat = sys.platform if platform is None else platform
    try:
        app_id, app_key = load_app_credentials()
        council_key = load_council_model_key()
    except (OSError, ValueError) as err:
        sys.stderr.write("spire-land-host: app not configured (%s): nothing was checked or pushed\n" % err)
        return NOT_CONFIGURED
    root = workdir or os.getcwd()
    if "--nightly" in argv:
        return run_floor_nightly(root)
    spire_bin = os.path.join(root, ".spire", "tool", "bin", "spire")
    if not os.access(spire_bin, os.X_OK):
        sys.stderr.write("spire-land-host: %s is not executable: nothing was checked or pushed\n" % spire_bin)
        return 2
    subcmd = argv if argv and argv[0] in ("land", "push", "check", "council", "attest", "doctor") else ["land"] + argv
    if plat == "darwin" and subcmd[0] == "check":
        sys.stderr.write("spire-land-host: refused: checks do not run on the Mac host (use cloud heavy executor)\n")
        return REFUSED_LOCAL
    if plat == "darwin" and subcmd[0] == "land" and "--dry-run" not in subcmd:
        try:
            return submit_cloud_land(root, subcmd, app_id, app_key)
        except Exception as err:
            sys.stderr.write("spire-land-host: cloud land failed (%s): nothing was pushed\n" % err)
            return 1
    child_env = dict(os.environ)
    if os.path.isdir("/opt/homebrew/bin"):
        shim_dir = _ensure_host_bash_shim()
        rest = [p for p in child_env.get("PATH", "").split(":") if p and p != shim_dir]
        child_env["PATH"] = shim_dir + ":" + ":".join(rest)
    child_env["FLEET_APP_ID"] = app_id
    child_env["FLEET_APP_PRIVATE_KEY"] = app_key
    child_env["FLEET_LAND_STATUSES"] = "required"
    if not child_env.get("COUNCIL_MODEL_URL", "").strip():
        model_key = child_env.get("COUNCIL_MODEL_KEY", "").strip() or (council_key or "")
        if model_key:
            child_env["COUNCIL_MODEL_URL"] = DEFAULT_COUNCIL_URL
            child_env["COUNCIL_MODEL_KEY"] = model_key
    done = runner([spire_bin] + subcmd, cwd=root, env=child_env)
    return int(done.returncode)


if __name__ == "__main__":
    sys.exit(main())
