#!/usr/bin/env python3
"""arch-split-check: prove that a move of switchboard code is text only.

    arch-split-check --before FILE... --after FILE... [--no-surface]
    arch-split-check --write-surface SNAPSHOT --after FILE...
    arch-split-check --check-surface SNAPSHOT --after FILE...

The files of a side are taken in the order given and are one program (the parts of a
split, or the one file before it). Two things must hold:

  1. the multiset of top-level statements (their `ast.dump`, positions left out) is the
     same before and after: a statement moved to another file or another place passes, a
     statement edited, added or dropped fails and is named;
  2. `dir()` of the module loaded from each side is equal: no name added or removed.

The parts of a side are joined into ONE module to read `dir()`, so a part that lacks an import it needs still passes: that
is proved by the suites, and once a split makes real modules, by loading each part. When a side includes the daemon's entry
(a file named `fleet-switchboard` with a `fleet-switchboard.parts` beside it), that entry is loaded as it runs and assembles its
own parts from the manifest, in the manifest's order and namespace (the files listed are then used for the statement comparison only; a file listed that is not in that manifest is refused by name, because it would not reach the surface). A side that cannot be loaded gives a NAMED failure (the side, the part, the cause), after the statement differences, which usually name the part, are printed. The `dir(sb)` snapshot
(`tests/golden/surface-dir-sb.txt`) is refreshed by hand, with `--write-surface`, in a move PR; CI does not compare it,
so a PR that adds a function does not fail.
Loading the modules runs their code: use `--no-surface` (statements only, nothing runs) on files you do not trust.
Exit 0 when both hold, 1 when not (every difference is printed), 2 for a usage error.
The snapshot modes write or compare `dir()` of the module, one name per line, so a change
to the surface of the daemon module is a reviewable difference.
"""
import argparse
import ast
import collections
import importlib.machinery
import importlib.util
import os
import sys
import tempfile
import traceback


def statements(paths):
    """A Counter of the dump of every top-level statement, and a label for each dump."""
    counts = collections.Counter()
    labels = {}
    for path in paths:
        with open(path, encoding="utf-8") as handle:
            source = handle.read()
        tree = ast.parse(source, filename=path)
        for node in tree.body:
            dump = ast.dump(node, include_attributes=False)
            counts[dump] += 1
            labels.setdefault(dump, describe(node, path))
    return counts, labels


def describe(node, path):
    name = getattr(node, "name", None)
    if name is None and isinstance(node, (ast.Assign, ast.AnnAssign, ast.AugAssign)):
        targets = node.targets if isinstance(node, ast.Assign) else [node.target]
        name = ", ".join(ast.unparse(t) for t in targets)
    if name is None:
        name = ast.unparse(node).splitlines()[0][:60]
    return "%s:%d %s %s" % (os.path.basename(path), node.lineno, type(node).__name__, name)


def statement_differences(before, after):
    b_counts, b_labels = statements(before)
    a_counts, a_labels = statements(after)
    out = []
    for dump in sorted(set(b_counts) | set(a_counts), key=lambda d: (b_labels.get(d) or a_labels.get(d))):
        delta = a_counts[dump] - b_counts[dump]
        if delta < 0:
            out.append("statement removed or changed (before): %s%s" % (b_labels[dump], "" if delta == -1 else " x%d" % -delta))
        elif delta > 0:
            out.append("statement added or changed (after): %s%s" % (a_labels[dump], "" if delta == 1 else " x%d" % delta))
    return out


class LoadError(Exception):
    """The program a side makes could not be loaded: the message names the side, the part and the cause."""


def _manifest_files(entry):
    """The real paths of the files the entry's own manifest lists, or None when no manifest sits beside it."""
    try:
        with open(entry + ".parts", encoding="utf-8") as handle:
            names = [n.strip() for n in handle.read().splitlines() if n.strip() and not n.lstrip().startswith("#")]
    except OSError:
        return None
    return {os.path.realpath(os.path.join(os.path.dirname(entry), n)) for n in names}


def _where(err, known, ranges):
    """`file:line` of the innermost frame of the failure that sits in one of the files of the program, or an empty string."""
    here = ""
    for frame in traceback.extract_tb(err.__traceback__):
        name = os.path.realpath(frame.filename) if frame.filename else ""
        if name in known:
            here = "%s:%d" % (os.path.basename(name), frame.lineno)
        elif ranges and os.path.basename(frame.filename or "").startswith("arch_split_join_"):
            for part, start, end in ranges:
                if start <= frame.lineno <= end:
                    here = "%s:%d" % (os.path.basename(part), frame.lineno - start + 1)
    return here


def load_names(paths, side="after"):
    """dir() of the program the files make: the files, in order, run as one module. A side that includes the daemon's entry (a file named
    `fleet-switchboard` with its `fleet-switchboard.parts` beside it) is loaded as it runs: the entry assembles its parts from the manifest.
    A failure to load is a LoadError that names the side and the part."""
    entry = next((p for p in paths if os.path.basename(p) == "fleet-switchboard" and os.path.exists(p + ".parts")), None)
    ranges, cleanup, hint = None, None, ""
    if entry is not None:
        listed = _manifest_files(entry) or set()
        extra = [p for p in paths if os.path.realpath(p) not in listed and os.path.realpath(p) != os.path.realpath(entry)]
        if extra:
            raise LoadError("%s: %s is not in %s.parts: the entry is loaded in place and reads its parts from that manifest, so a file given but not listed "
                            "would not reach the surface (list it, or leave it out)" % (side, ", ".join(os.path.basename(p) for p in extra), entry))
        path, known = entry, listed | {os.path.realpath(entry)}
    elif len(paths) == 1:
        path, known = paths[0], {os.path.realpath(paths[0])}
    else:
        handle = tempfile.NamedTemporaryFile("w", prefix="arch_split_join_", suffix=".py", delete=False, encoding="utf-8")
        ranges, line = [], 1
        for part in paths:
            with open(part, encoding="utf-8") as src:
                text = src.read().rstrip("\n") + "\n\n"
            handle.write(text)
            ranges.append((part, line, line + text.count("\n") - 1))
            line += text.count("\n")
        handle.close()
        path = cleanup = handle.name
        known = {os.path.realpath(p) for p in paths}
    if any(os.path.basename(p) == "fleet-switchboard" for p in paths) and entry is None:
        hint = " (fleet-switchboard has no fleet-switchboard.parts beside it, so the files were joined as one text: put the entry, its manifest and its parts in one directory, for example `git archive REV bin | tar -x`)"
    try:
        loader = importlib.machinery.SourceFileLoader("arch_split_subject", path)
        spec = importlib.util.spec_from_loader(loader.name, loader)
        module = importlib.util.module_from_spec(spec)
        loader.exec_module(module)
        return sorted(dir(module))
    except SystemExit as err:
        raise LoadError("%s: the program stopped while it loaded: %s%s" % (side, err, hint))
    except Exception as err:
        here = _where(err, known, ranges)
        raise LoadError("%s: cannot load the program%s: %s: %s%s" % (side, " (in %s)" % here if here else "", type(err).__name__, err, hint))
    finally:
        if cleanup:
            os.unlink(cleanup)


def name_differences(before, after, left="before", right="after"):
    return (["name only %s: %s" % (left, n) for n in sorted(set(before) - set(after))]
            + ["name only %s: %s" % (right, n) for n in sorted(set(after) - set(before))])


def main(argv=None):
    parser = argparse.ArgumentParser(prog="arch-split-check", description=__doc__.split("\n\n")[0])
    parser.add_argument("--before", nargs="+", metavar="FILE")
    parser.add_argument("--after", nargs="+", metavar="FILE", required=True)
    parser.add_argument("--no-surface", action="store_true", help="compare statements only, never load the code")
    parser.add_argument("--write-surface", metavar="SNAPSHOT")
    parser.add_argument("--check-surface", metavar="SNAPSHOT")
    args = parser.parse_args(argv)
    if args.write_surface:
        try:
            names = load_names(args.after, "after")
        except LoadError as err:
            print("RESULT: FAIL (%s)" % err)
            return 1
        with open(args.write_surface, "w", encoding="utf-8") as handle:
            handle.write("".join(n + "\n" for n in names))
        print("wrote %d names to %s" % (len(names), args.write_surface))
        return 0
    if args.check_surface:
        with open(args.check_surface, encoding="utf-8") as handle:
            recorded = handle.read().split()
        try:
            diffs = name_differences(recorded, load_names(args.after, "after"), "in the snapshot", "in the code")
        except LoadError as err:
            print("RESULT: FAIL (%s)" % err)
            return 1
        for line in diffs:
            print(line)
        print("RESULT: %s (%d names in the snapshot)" % ("FAIL" if diffs else "PASS", len(recorded)))
        return 1 if diffs else 0
    if not args.before:
        parser.error("--before is needed to compare")
    diffs = statement_differences(args.before, args.after)
    failed = None
    if not args.no_surface:
        try:
            diffs += name_differences(load_names(args.before, "before"), load_names(args.after, "after"))
        except LoadError as err:
            failed = err   # the statement differences, which usually name the part, are printed first
    for line in diffs:
        print(line)
    total = sum(statements(args.before)[0].values())
    if failed is not None:
        print("the surface could not be read: %s" % failed)
    print("RESULT: %s (%d top-level statements compared, %d differences%s)" % ("FAIL" if diffs or failed else "PASS", total, len(diffs), ", surface not read" if failed else ""))
    return 1 if diffs or failed else 0


if __name__ == "__main__":
    sys.exit(main())
