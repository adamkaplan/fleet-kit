#!/usr/bin/env python3
"""golden-cli: record, and compare, what the switchboard CLI prints.

    golden-cli compare --base REV [--repo DIR]
    golden-cli record  [--entry bin/fleet-switchboard] [--dir DIR]

`compare` is for a pull request that moves code and must change no output (S3 of the plan
#1092). It extracts `bin/` of the git revision REV (a branch, a tag, a sha: `origin/main`),
runs every command of the list against that entry and against the working tree's
`bin/fleet-switchboard`, and prints a difference, naming the command, for every stdout,
stderr or exit status that is not byte-identical, and for a command one side lacks. Exit 0
when there is none, 1 when there is one. Nothing is committed: both recordings are made now,
on the same Python, in the same synthetic world.

`compare` and `record` run the repository's own code (the base revision's and the working tree's):
use them only on trees you trust.

`record` writes the outputs of one entry to a directory (a local baseline to look at).

The list is every verb's `--help`, every nested subcommand's `--help` (found by walking the
help text) and the offline read-only commands in OFFLINE below. The world is synthetic: an
empty state, config and home directory under one temporary root, no `gh`, no `herdr`, a clock
fixed at one instant, a fixed terminal width. Paths of the temporary root print as `<ROOT>`.
"""
import argparse
import concurrent.futures
import io
import json
import os
import re
import subprocess
import sys
import tarfile
import tempfile

FIXED_NOW = 1700000000.0
HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)

# Offline, read-only commands: no network, no daemon, no write outside the synthetic state.
# `status` is left out on purpose: it prints the machine's own disk, load and memory.
OFFLINE = [
    ["version"],
    ["policy-report"],
    ["whoami"],
    ["orders"],
    ["agents"],
    ["plan"],
    ["plan", "template"],
    ["review-laws"],
    ["skills"],
    ["impact"],
    ["reds"],
    ["pending"],
    ["intent"],
    ["send"],
    ["report"],
]

RUNNER = r"""
import os, runpy, sys, time
_now = float(os.environ["GOLDEN_NOW"])
time.time = lambda: _now
entry = sys.argv[1]
sys.argv = [entry] + sys.argv[2:]
runpy.run_path(entry, run_name="__main__")
"""


def world(root):
    for name in ("home", "state", "config", "cache"):
        os.makedirs(os.path.join(root, name), exist_ok=True)
    return {
        "PATH": "/usr/bin:/bin",
        "HOME": os.path.join(root, "home"),
        "XDG_STATE_HOME": os.path.join(root, "state"),
        "XDG_CONFIG_HOME": os.path.join(root, "config"),
        "XDG_CACHE_HOME": os.path.join(root, "cache"),
        "TMPDIR": os.path.join(root, "home"),
        "COLUMNS": "80", "LINES": "24", "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8", "TZ": "UTC",
        "PYTHONHASHSEED": "0", "PYTHONDONTWRITEBYTECODE": "1", "NO_COLOR": "1",
        "GOLDEN_NOW": repr(FIXED_NOW),
        "FLEET_SWITCHBOARD_UNDER_TEST": "1",
    }


def run(entry, argv, root, env):
    proc = subprocess.run([sys.executable, "-c", RUNNER, entry] + argv, cwd=os.path.join(root, "home"), env=env,
                          capture_output=True, stdin=subprocess.DEVNULL, timeout=60)
    clean = lambda raw: raw.decode("utf-8", "replace").replace(os.path.realpath(root), "<ROOT>").replace(root, "<ROOT>")
    return {"argv": argv, "status": proc.returncode, "stdout": clean(proc.stdout), "stderr": clean(proc.stderr)}


def choices(text):
    """The subcommand names of a help text: the `{a,b,c} ...` of its usage line (a value list has no `...`)."""
    match = re.search(r"\{([^}\s]+)\} \.\.\.", " ".join(text.split("positional arguments:")[0].split()))
    return match.group(1).split(",") if match else []


def pool_map(fn, items):
    with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:
        return list(pool.map(fn, items))


def command_list(entry, root, env):
    """Every `--help` of the tree, then the offline commands."""
    out = []
    top = run(entry, ["--help"], root, env)
    out.append(["--help"])
    level = [[name] for name in choices(top["stdout"])]
    while level:
        out.extend(argv + ["--help"] for argv in level)
        helps = pool_map(lambda argv: run(entry, argv + ["--help"], root, env), level)
        level = [argv + [name] for argv, text in zip(level, helps) for name in choices(text["stdout"])]
    return out + OFFLINE


GROUPS = ("a-c", "d-g", "h-l", "m-p", "q-s", "t-z")


def group_of(argv):
    """The file a command's output is kept in: by the first letter of its verb (`--help` alone is `root`)."""
    words = [w for w in argv if not w.startswith("-")]
    if not words:
        return "root"
    letter = words[0][0].lower()
    for group in GROUPS:
        if group[0] <= letter <= group[2]:
            return group
    return "t-z"


def record_all(entry, root, env):
    """{argv tuple: result} of every command of the list, run against `entry`."""
    commands = command_list(entry, root, env)
    results = pool_map(lambda command: run(entry, command, root, env), commands)
    return {tuple(command): result for command, result in zip(commands, results)}


def differences(base, work):
    """One line per command that differs: a missing command, or a field that is not identical."""
    out = []
    for argv in sorted(set(base) | set(work)):
        label = " ".join(argv)
        if argv not in work:
            out.append("DIFF %s: the command is gone from the working tree" % label)
        elif argv not in base:
            out.append("DIFF %s: the command is new in the working tree" % label)
        else:
            out.extend("DIFF %s: %s differs" % (label, field) for field in ("status", "stdout", "stderr")
                       if base[argv][field] != work[argv][field])
    return out


def extract_bin(repo, rev, target):
    """`bin/` of the revision, into target; the revision's own entry and its helper modules."""
    proc = subprocess.run(["git", "-C", repo, "archive", rev, "bin"], capture_output=True)
    if proc.returncode != 0:
        raise SystemExit("golden-cli: cannot read %s from git: %s" % (rev, proc.stderr.decode().strip()))
    with tarfile.open(fileobj=io.BytesIO(proc.stdout)) as tar:
        tar.extractall(target, **({"filter": "data"} if hasattr(tarfile, "data_filter") else {}))


def main(argv=None):
    parser = argparse.ArgumentParser(prog="golden-cli", description=__doc__.split("\n\n")[0])
    parser.add_argument("mode", choices=("compare", "record"))
    parser.add_argument("--base", help="compare: the git revision to compare the working tree with")
    parser.add_argument("--repo", default=ROOT, help="compare: the repository (default: this one)")
    parser.add_argument("--entry", default=None, help="record: the entry (default: bin/fleet-switchboard of the repository)")
    parser.add_argument("--dir", default=None, help="record: where to write the outputs")
    args = parser.parse_args(argv)
    repo = os.path.abspath(args.repo)
    with tempfile.TemporaryDirectory() as tmp:
        root = os.path.realpath(tmp)
        env = world(root)
        if args.mode == "record":
            if not args.dir:
                parser.error("record needs --dir")
            results = record_all(os.path.abspath(args.entry or os.path.join(repo, "bin", "fleet-switchboard")), root, env)
            os.makedirs(args.dir, exist_ok=True)
            groups = {}
            for command, result in results.items():
                groups.setdefault(group_of(list(command)), []).append(result)
            for group, items in groups.items():
                with open(os.path.join(args.dir, group + ".json"), "w", encoding="utf-8") as handle:
                    json.dump(items, handle, indent=1, sort_keys=True)
                    handle.write("\n")
            print("recorded %d outputs in %s" % (len(results), args.dir))
            return 0
        if not args.base:
            parser.error("compare needs --base")
        old = os.path.join(root, "base")
        os.makedirs(old)
        extract_bin(repo, args.base, old)
        base = record_all(os.path.join(old, "bin", "fleet-switchboard"), root, env)
        work = record_all(os.path.join(repo, "bin", "fleet-switchboard"), root, env)
        diffs = differences(base, work)
        for line in diffs:
            print(line)
        print("compared %d outputs of %s with the working tree: %d differences" % (len(base), args.base, len(diffs)))
        print("RESULT: %s" % ("FAIL" if diffs else "PASS"))
        return 1 if diffs else 0


if __name__ == "__main__":
    sys.exit(main())
