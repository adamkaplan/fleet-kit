#!/usr/bin/env python3
"""new-test-checks: what a read of a NEW tests/switchboard/test_*.py file shows before the whole-file run does (#1967).

    tools/new-test-checks [--base REF] [FILE ...]
    tools/new-test-checks --preflight

With no FILE: every file `tests/switchboard/test_*.py` that the diff of HEAD against the merge base with --base (default origin/integration, else
integration) adds or changes. `--preflight` is the form `preflight-pr` runs: the base is the repository's default branch (origin/HEAD, origin/main,
main), it prints nothing when the head touches no such file and `files: N` first when it does.
One line `path:line: rule: what to do` per finding; the rules (the whole-file run found each of them 45 minutes after the push):
  moved-name                    a module-level binding of a name that tests/switchboard/support/ defines or imports. The rule is NOT copied: the functions
                                `moved_names` and `rebindings` of class TestSupportRebinding are read from the source of bin/test-switchboard and applied.
  import-time-read              read_text, read_bytes or open at import time on a path under REPO, ROOT or BIN.parent outside bin/, tests/ and docs/
                                (the three directories that the copy tree of tests/test_brief_integration.py holds).
  part-module-through-import    `import M` of a module the entry bin/fleet-switchboard binds at module level, then patched or caught through: use sb.M.
Then, never a finding and never a change of the exit status: `table:` lines (a class that lists bin/, by the patterns READS and READS_MORE read from
tests/switchboard/test_bin_set_table.py; a path that a glob of tools/path-suites.json holds whose row does not name the file) and `run first:` lines.
Exit 1 when a finding was printed, 0 when none, 2 for a usage error or a rule that cannot run (said plainly, never a silent pass).
Reads files and runs only `git diff --name-only`; writes nothing. Only the syntax tree is read: text in a comment or a string is never a finding.
Standard library only."""
import ast
import fnmatch
import functools
import json
import os
import re
import subprocess
import sys
import textwrap
from pathlib import Path

HERE = Path(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
READ_DIRS = ("bin", "tests", "docs")   # the three directories the copy tree of tests/test_brief_integration.py holds
TEST_DIR = "tests/switchboard"
TABLE_CLASS = "TestTheBinSetClassesAreAllInTheTable"
BIN_GUARD_CMD = "python3 bin/test-switchboard " + TABLE_CLASS
PATH_SUITES_CMD = "python3 bin/path_suites.py --check"


class CannotRun(Exception):
    pass


def tree_of(path):
    """The tree a file is in: the nearest parent that holds tests/switchboard/support; this repository when none does."""
    for parent in Path(path).resolve().parents:
        if (parent / TEST_DIR / "support").is_dir():
            return parent
    return HERE


def parse(path):
    try:
        return ast.parse(Path(path).read_text(), str(path))
    except (OSError, SyntaxError, ValueError) as err:
        raise CannotRun("%s: cannot be read as Python (%s)" % (path, err))


def class_node(tree, name):
    return next((n for n in ast.walk(tree) if isinstance(n, ast.ClassDef) and n.name == name), None)


@functools.lru_cache(maxsize=None)
def moved_rule(root):
    """(moved_names, rebindings) taken from the SOURCE of class TestSupportRebinding in root/bin/test-switchboard; REPO there is the tree."""
    path = root / "bin" / "test-switchboard"
    try:
        source = path.read_text()
    except OSError as err:
        raise CannotRun("moved-name: the rule of the moved names cannot run: %s cannot be read (%s)" % (path, err))
    cls = class_node(ast.parse(source), "TestSupportRebinding")
    fns = {n.name: n for n in (cls.body if cls else []) if isinstance(n, ast.FunctionDef)}
    if "moved_names" not in fns or "rebindings" not in fns:
        raise CannotRun("moved-name: the rule of the moved names was not found (class TestSupportRebinding with moved_names and rebindings) in %s" % path)
    space = {"ast": ast, "REPO": root}
    for name in ("moved_names", "rebindings"):
        exec(textwrap.dedent(ast.get_source_segment(source, fns[name])), space)
    return space["moved_names"], space["rebindings"]


@functools.lru_cache(maxsize=None)
def moved_set(root):
    return moved_rule(root)[0]()


def check_moved(source, root):
    moved_names, rebindings = moved_rule(root)
    moved = moved_set(root)
    return [(line, "moved-name", "%s: it is also defined in tests/switchboard/support/, so rebind it there too (`rebound`) or give it another name" % what)
            for line, what in rebindings(source, moved)]


def walk_import_time(node):
    """Every node that runs when the module is imported: module level and class bodies, never the body of a function or a lambda."""
    for child in ast.iter_child_nodes(node):
        if isinstance(child, (ast.FunctionDef, ast.AsyncFunctionDef, ast.Lambda)):
            continue
        yield child
        yield from walk_import_time(child)


def path_parts(expr):
    """The parts of `a / "b" / "c"`, left to right: a Name or Attribute node, or the string."""
    if isinstance(expr, ast.BinOp) and isinstance(expr.op, ast.Div):
        return path_parts(expr.left) + path_parts(expr.right)
    if isinstance(expr, ast.Constant) and isinstance(expr.value, str):
        return [expr.value]
    return [expr]


def outside_dir(expr):
    parts = path_parts(expr)
    for i, part in enumerate(parts):
        is_root = (isinstance(part, ast.Name) and part.id in ("REPO", "ROOT")) or (
            isinstance(part, ast.Attribute) and part.attr == "parent" and isinstance(part.value, ast.Name) and part.value.id == "BIN")
        if is_root:
            for nxt in parts[i + 1:]:
                if isinstance(nxt, str):
                    first = nxt.strip("/").split("/")[0]
                    return first if first and first not in READ_DIRS else None
                break
    return None


def check_reads(tree):
    found = []
    for node in walk_import_time(tree):
        if not isinstance(node, ast.Call):
            continue
        func, target = node.func, None
        if isinstance(func, ast.Attribute) and func.attr in ("read_text", "read_bytes", "open"):
            target = func.value
        elif isinstance(func, ast.Name) and func.id == "open" and node.args:
            target = node.args[0]
        outside = outside_dir(target) if target is not None else None
        if outside:
            found.append((node.lineno, "import-time-read", "a file under %s/ is read when the module is imported, and the copy tree of tests/test_brief_integration.py "
                          "holds only %s: read it inside the test that needs it" % (outside, ", ".join(d + "/" for d in READ_DIRS))))
    return found


@functools.lru_cache(maxsize=None)
def entry_modules(root):
    """The names bin/fleet-switchboard binds at module level (an import or an assignment target) that are files under bin/ or bin/switchboard/."""
    path = root / "bin" / "fleet-switchboard"
    try:
        body = ast.parse(path.read_text()).body
    except (OSError, SyntaxError) as err:
        raise CannotRun("part-module-through-import: the entry %s cannot be read (%s)" % (path, err))
    names = set()
    for node in body:
        if isinstance(node, ast.Import):
            names |= {(a.asname or a.name).split(".")[0] for a in node.names}
        elif isinstance(node, ast.ImportFrom):
            names |= {a.asname or a.name for a in node.names}
        elif isinstance(node, (ast.Assign, ast.AnnAssign, ast.AugAssign)):
            for target in (node.targets if isinstance(node, ast.Assign) else [node.target]):
                names |= {n.id for n in ast.walk(target) if isinstance(n, ast.Name)}
    return {n for n in names if (root / "bin" / (n + ".py")).is_file() or (root / "bin" / "switchboard" / (n + ".py")).is_file()}


def mentions(node, name):
    return any(isinstance(n, ast.Name) and n.id == name for n in ast.walk(node))


def check_parts(tree, root):
    bound = entry_modules(root)
    imported = {a.name for n in tree.body if isinstance(n, ast.Import) for a in n.names if a.asname is None and a.name in bound}
    found = []
    for node in ast.walk(tree):
        used = []
        if isinstance(node, ast.Call) and node.args:
            name = ast.unparse(node.func)
            first = node.args[0]
            if name.split(".")[-1] == "patch" or name.endswith("patch.object") or name.endswith("patch.multiple"):
                used = [first.id] if isinstance(first, ast.Name) else []
            elif name.split(".")[-1] in ("assertRaises", "assertRaisesRegex"):
                used = [m for m in imported if mentions(first, m)]
        elif isinstance(node, ast.ExceptHandler) and node.type is not None:
            used = [m for m in imported if mentions(node.type, m)]
        for module in used:
            if module in imported:
                found.append((node.lineno, "part-module-through-import", "`import %s` is not the module the entry binds (a lazy proxy in the whole run): reach it as sb.%s" % (module, module)))
    return found


@functools.lru_cache(maxsize=None)
def read_patterns(root):
    """READS and READS_MORE read from the class of tests/switchboard/test_bin_set_table.py (never copied here)."""
    path = root / TEST_DIR / "test_bin_set_table.py"
    try:
        cls = class_node(ast.parse(path.read_text()), TABLE_CLASS)
    except (OSError, SyntaxError) as err:
        raise CannotRun("table: the patterns READS and READS_MORE cannot run: %s cannot be read (%s)" % (path, err))
    found = []
    for stmt in (cls.body if cls else []):
        if isinstance(stmt, ast.Assign) and any(isinstance(t, ast.Name) and t.id in ("READS", "READS_MORE") for t in stmt.targets):
            call = stmt.value
            if isinstance(call, ast.Call) and ast.unparse(call.func) == "re.compile" and call.args:
                found.append(re.compile(ast.literal_eval(call.args[0])))
    if len(found) != 2:
        raise CannotRun("table: the patterns READS and READS_MORE were not found in %s" % path)
    return found


def doc_strings(tree):
    ids = set()
    for node in ast.walk(tree):
        if isinstance(node, (ast.Module, ast.ClassDef, ast.FunctionDef, ast.AsyncFunctionDef)) and node.body:
            first = node.body[0]
            if isinstance(first, ast.Expr) and isinstance(first.value, ast.Constant):
                ids.add(id(first.value))
    return ids


def table_lines(source, tree, root, rel):
    patterns = read_patterns(root)
    lines, first = [], []
    for node in ast.walk(tree):
        if isinstance(node, ast.ClassDef) and any(p.search(ast.get_source_segment(source, node) or "") for p in patterns):
            lines.append((node.lineno, "table: class %s lists bin/: it is a row of NEW_BIN_GUARDS or exempt in tests/switchboard/test_bin_set_table.py" % node.name))
            first.append(BIN_GUARD_CMD)
    try:
        rows = json.loads((root / "tools" / "path-suites.json").read_text())["rows"]
    except (OSError, ValueError, KeyError):
        rows = []
    docs, seen = doc_strings(tree), set()
    for node in ast.walk(tree):
        if isinstance(node, ast.Constant) and isinstance(node.value, str) and id(node) not in docs and len(node.value) < 200:
            for row in rows:
                glob = row.get("glob", "")
                if glob in seen or rel in row.get("suites", []):
                    continue
                if fnmatch.fnmatchcase(node.value, glob) or ("/" not in node.value and node.value.endswith(".py") and fnmatch.fnmatchcase("bin/" + node.value, glob)):
                    seen.add(glob)
                    lines.append((node.lineno, "table: tools/path-suites.json row %s does not name this file" % glob))
                    first.append(PATH_SUITES_CMD)
    return lines, first


def changed(base_candidates, cwd):
    """The files the diff of HEAD against the merge base adds or changes under tests/switchboard/ named test_*.py: ([...], True) or (None, False) when no base is found."""
    for base in base_candidates:
        done = subprocess.run(["git", "diff", "--name-only", "--no-renames", "--diff-filter=AM", base + "...HEAD", "--", TEST_DIR + "/"], cwd=cwd, capture_output=True, text=True)
        if done.returncode == 0:
            return sorted(p for p in done.stdout.split() if p.startswith(TEST_DIR + "/") and p.count("/") == 2 and os.path.basename(p).startswith("test_") and p.endswith(".py")), True
    return None, False


def main(argv):
    base, files, preflight, args = None, [], False, list(argv)
    while args:
        arg = args.pop(0)
        if arg == "--base" and args:
            base = args.pop(0)
        elif arg == "--preflight":
            preflight = True
        elif arg.startswith("-"):
            print("usage: new-test-checks [--base REF] [FILE ...] | --preflight")
            return 2
        else:
            files.append(arg)
    cwd = Path.cwd()
    if not files:
        candidates = [base] if base else (["origin/HEAD", "origin/main", "main"] if preflight else ["origin/integration", "integration"])
        files, found = changed(candidates, cwd)
        if not found:
            if preflight:
                return 0
            print("new-test-checks: no base to diff against (%s): name one with --base REF or give the files" % ", ".join(candidates))
            return 2
        top = subprocess.run(["git", "rev-parse", "--show-toplevel"], cwd=cwd, capture_output=True, text=True)
        files = [str(Path(top.stdout.strip()) / f) for f in files]
        if preflight and files:
            print("files: %d" % len(files))
    findings, extra = [], []
    try:
        for name in files:
            path = Path(name).resolve()
            root = tree_of(path)
            rel = os.path.relpath(path, root)
            source = path.read_text()
            tree = parse(path)
            shown = os.path.relpath(path, cwd) if str(path).startswith(str(cwd)) else str(path)
            for line, rule, advice in sorted(check_moved(source, root) + check_reads(tree) + check_parts(tree, root)):
                findings.append("%s:%d: %s: %s" % (shown, line, rule, advice))
            lines, first = table_lines(source, tree, root, rel)
            extra += [text for _line, text in lines]
            extra += ["run first: " + c for c in dict.fromkeys(first) if "run first: " + c not in extra]
    except CannotRun as err:
        print("new-test-checks: " + str(err))
        return 2
    except OSError as err:
        print("new-test-checks: cannot read %s" % err)
        return 2
    for line in findings + extra:
        print(line)
    return 1 if findings else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
