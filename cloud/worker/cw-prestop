#!/bin/sh
# cw-prestop <budget seconds>: the container's preStop hook. Pushes unpushed work to <worker>/wip with the pod's own
# credential helper (plain git, via ~/.gitconfig). Never forces, never prints a token, always exits 0.
budget="${1:-45}"
GIT_TERMINAL_PROMPT=0
GCM_INTERACTIVE=never
export GIT_TERMINAL_PROMPT GCM_INTERACTIVE
out=$(timeout -k 2 "$budget" cw-end-hook --prestop 2>&1)
rc=$?
if [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ]; then
  out="cw-prestop: not pushed (timed out); work left in ${CW_WORKDIR:-/work/repo}"
fi
if [ -n "$out" ]; then
  line=$(printf '%s\n' "$out" | tail -n 1)
  { printf '%s\n' "$line" > "${CW_PRESTOP_OUT:-/proc/1/fd/2}"; } 2>/dev/null || printf '%s\n' "$line" >&2
fi
exit 0
