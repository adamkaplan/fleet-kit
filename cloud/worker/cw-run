#!/usr/bin/env python3
"""cw-run: run a long command detached, then poll it with bounded waits (a foreground call that outlives the tool's time limit strands the turn).

  cw-run start [--name NAME] -- COMMAND...   start detached; returns at once
  cw-run wait NAME [SECONDS]                 wait at most min(SECONDS, 240) (default 120); prints running <n>s or exited <code>, then the last 20 log lines
  cw-run tail NAME [LINES]                   the last LINES (default 20) log lines
  cw-run list                                every run and its state

A run lives in /work/runs (NAME.log, NAME.exit, NAME.pid). While it lives one line goes to /work/progress.txt every 5 minutes, and one when it ends.
"""
import os, re, shlex, stat, subprocess, sys, time
import base64, json, urllib.error, urllib.request

RUNS = os.environ.get("CW_RUNS_DIR") or "/work/runs"
PROGRESS = os.environ.get("CW_PROGRESS_FILE") or "/work/progress.txt"
try:
    TICK = float(os.environ.get("CW_RUN_TICK") or 300)
except ValueError:
    TICK = 300.0
try:
    WAKE_GAP = float(os.environ.get("CW_RUN_WAKE_GAP") or 10)
    WAKE_LIMIT = float(os.environ.get("CW_RUN_WAKE_LIMIT") or 300)
except ValueError:
    WAKE_GAP, WAKE_LIMIT = 10.0, 300.0
WAKE_SERVER = os.environ.get("CW_RUN_SERVER") or "http://127.0.0.1:4096"
if not re.match(r"http://(127\.0\.0\.1|localhost|\[::1\])(:[0-9]+)?$", WAKE_SERVER):
    WAKE_SERVER = "http://127.0.0.1:4096"   # the password goes to the local server only
WAKE_PASSWORD_FILE = os.environ.get("CW_RUN_SERVER_PASSWORD_FILE") or "/run/cw/server-password"
WAKE_CLIENT = (os.environ.get("CW_RUN_CLIENT") if os.environ.get("CW_RUN_TEST") == "1" else None) or "cw-cloud"   # the override is for tests only
WAKE_MAX = 3000
MAX_WAIT = 240
NAME_OK = re.compile(r"[A-Za-z0-9._-]+")


def die(msg, code=2):
    sys.stderr.write("cw-run: %s\n" % msg)
    sys.exit(code)


def path(name, ext):
    return os.path.join(RUNS, name + "." + ext)


def check_name(name):
    if not NAME_OK.fullmatch(name or "") or name.startswith(".") or len(name) > 64:
        die("a name is 1 to 64 letters, digits, dot, dash or underscore (not starting with a dot)")
    return name


def read(p):
    try:
        with open(p) as f:
            return f.read().strip()
    except OSError:
        return None


def alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    try:  # a zombie is not alive
        with open("/proc/%d/stat" % pid) as f:
            return f.read().rsplit(")", 1)[1].split()[0] != "Z"
    except (OSError, IndexError):
        return True


def state(name):
    """('none',) | ('running', elapsed) | ('exited', code)"""
    pid = read(path(name, "pid"))
    if pid is None:
        return ("none",)
    code = read(path(name, "exit"))
    if code is not None:
        return ("exited", code)
    try:
        started = os.stat(path(name, "pid")).st_mtime
    except OSError:
        return ("none",)
    if pid.isdigit() and alive(int(pid)):
        return ("running", int(time.time() - started))
    return ("exited", "255")   # the supervisor is gone without an exit record


def progress(line):
    try:
        with open(PROGRESS, "a") as f:
            f.write(line + "\n")
    except OSError:
        pass


def last_lines(name, n):
    try:
        with open(path(name, "log"), "rb") as f:
            data = f.read()
    except OSError:
        return ""
    lines = data.decode("utf-8", "replace").splitlines()
    return "\n".join(lines[-n:] if n > 0 else [])


def ensure_dir():
    if not os.path.isdir(RUNS):
        os.makedirs(RUNS, mode=0o700, exist_ok=True)

SECRET = re.compile(r"(?i)(gh[pousr]_[A-Za-z0-9_]{8,}|github_pat_[A-Za-z0-9_]{8,}|sk-[A-Za-z0-9_-]{8,}|xox[a-z]-[A-Za-z0-9-]{8,}"
                    r"|AKIA[0-9A-Z]{12,}|eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}(\.[A-Za-z0-9_-]*)?"
                    r"|(bearer|basic)\s+[A-Za-z0-9._~+/=-]{8,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|://[^/\s:@]+:[^@\s]+@|--(password|token|secret)[= ]\S+"
                    r"|[A-Za-z0-9_]*(token|secret|password|passwd|api[_-]?key)[A-Za-z0-9_]*[\"']?\s*[=:]\s*(\"[^\"]*\"|'[^']*'|\S+)"
                    r"|[A-Za-z0-9+/_-]{40,}={0,2})")


def redact(text):
    return SECRET.sub("[redacted]", text)


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *a, **k):
        return None


def wake_http(method, url, body=None, timeout=15):
    """(status, parsed json or None); status 0 when the server does not answer."""
    pw = read(WAKE_PASSWORD_FILE) or ""
    cred = base64.b64encode(("opencode:" + pw).encode()).decode()
    req = urllib.request.Request(url, method=method, data=None if body is None else json.dumps(body).encode(),
                                 headers={"Authorization": "Basic " + cred, "Content-Type": "application/json"})
    try:
        with urllib.request.build_opener(_NoRedirect).open(req, timeout=timeout) as a:
            status, raw = a.status, a.read(1 << 20)
    except urllib.error.HTTPError as e:
        status, raw = e.code, b""
    except Exception:
        return 0, None
    try:
        return status, json.loads(raw.decode() or "null")
    except ValueError:
        return status, None


def wake_session():
    status, d = wake_http("GET", WAKE_SERVER + "/api/session")
    items = d.get("data") if isinstance(d, dict) else d
    if status != 200 or not isinstance(items, list):
        return None
    best = None
    for it in items:
        try:
            u = it["time"]["updated"]
            if it["id"] and (best is None or u > best[0]):
                best = (u, it["id"])
        except (KeyError, TypeError):
            pass
    return best[1] if best else None


def wake_send_session(text):
    """True when the server accepted the message; retries while it is busy or refuses, up to WAKE_LIMIT."""
    end = time.time() + WAKE_LIMIT
    while True:
        sid = wake_session()
        if sid:
            status, _ = wake_http("POST", "%s/api/session/%s/prompt" % (WAKE_SERVER, sid), {"text": text})
            if 200 <= status < 300:
                return True
        if time.time() + WAKE_GAP > end:
            return False
        time.sleep(WAKE_GAP)


def wake(name, code, secs):
    """After the exit file: at most once per run (marker NAME.woke), tell the agent's session, the progress file and the boss. One failing never blocks the others."""
    if not os.path.exists(WAKE_PASSWORD_FILE):
        return   # not a pod with a local server: nothing to wake
    try:
        fd = os.open(path(name, "woke"), os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
        os.close(fd)
    except OSError:
        return
    first = "run %s exited %d after %ds; last 20 lines:" % (name, code, secs)
    try:
        body = redact(first + "\n" + last_lines(name, 20))
        if len(body) > WAKE_MAX:
            body = body[:WAKE_MAX - 3] + "..."
        if not wake_send_session(body):
            raise RuntimeError("not delivered")
    except Exception:
        progress("wake not delivered")
        try:
            with open(path(name, "log"), "ab") as f:
                f.write(b"wake not delivered\n")
        except OSError:
            pass
    progress(first)
    try:
        boss = os.environ.get("FLEET_BOSS") or ""
        if not boss or boss.startswith("-"):
            return
        text = redact(first + "\n" + last_lines(name, 5))[:2000]
        subprocess.run(shlex.split(WAKE_CLIENT) + ["send", boss, text], stdin=subprocess.DEVNULL,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=60)
    except Exception:
        pass


def supervise(name, cmd):
    start = time.time()
    log = open(path(name, "log"), "ab", buffering=0)
    code = 127
    try:
        try:
            p = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT)
        except OSError as e:
            log.write(("cw-run: cannot start: %s\n" % e).encode())
            p = None
        while p is not None:
            try:
                rc = p.wait(timeout=TICK)
                code = rc if rc >= 0 else 128 - rc
                break
            except subprocess.TimeoutExpired:
                progress("cw-run %s still running (%ds)" % (name, int(time.time() - start)))
    finally:
        tmp = path(name, "exit.tmp")
        with open(tmp, "w") as f:
            f.write("%d\n" % code)
        os.rename(tmp, path(name, "exit"))
        progress("cw-run %s exited %d after %ds" % (name, code, int(time.time() - start)))
        try:
            wake(name, code, int(time.time() - start))
        except Exception:
            pass


# Ask #2517: the land gate. A START (and so a RESTART: every start of a name runs again) of a land (`spire land`) in a repository on the land list is refused unless the pod
# holds the live land token. The question is the hook's: CW_LAND_GATE_CMD (default `fleet-switchboard land-gate check`) with `<owner/repo> --name <FLEET_AGENT_NAME>`:
# exit 0 allowed, exit 3 refused (its line says why, who holds it and the queue length); anything else is UNREACHABLE: the land starts and ONE audit line goes to
# CW_LAND_GATE_AUDIT (default /work/.land-gate-audit.log); CW_LAND_GATE=enforce refuses it instead. A command that is not a land is not asked.
LAND_WORDS = re.compile(r"(?:^|[\s/'\";&|(`{])spire\s+land(?=$|[\s'\";&|)])")
GATE_AUDIT = os.environ.get("CW_LAND_GATE_AUDIT") or "/work/.land-gate-audit.log"


def is_land(cmd):
    return bool(LAND_WORDS.search(" ".join(cmd)))   # no flag exempts a command: a dry run costs a refusal, a stray flag must never switch the gate off


def origin_repo():
    try:
        url = subprocess.run(["git", "remote", "get-url", "origin"], capture_output=True, text=True, timeout=10, stdin=subprocess.DEVNULL).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return None
    m = re.match(r"^(?:[a-z+]+://(?:[^/@]*@)?[^/]+/|[^/@:]*@?[^/:]+:)([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+?)(?:\.git)?/?$", url)
    return m.group(1) if m else None


def land_gate(cmd):
    if not is_land(cmd):
        return
    repo = origin_repo()
    name = os.environ.get("FLEET_AGENT_NAME") or ""
    code, out = None, ""
    if repo is not None and NAME_OK.fullmatch(name):   # no repository or no name: the gate cannot be asked: unreachable below (audited, refused under enforce)
        try:
            r = subprocess.run(shlex.split(os.environ.get("CW_LAND_GATE_CMD") or "fleet-switchboard land-gate check") + [repo, "--name", name],
                               capture_output=True, text=True, timeout=20, stdin=subprocess.DEVNULL)
            code, out = r.returncode, r.stdout
        except (OSError, subprocess.SubprocessError, ValueError):
            code = None
    if code == 0:
        return
    if code == 3:
        die(redact(re.sub(r"[^\x20-\x7e]", "?", (out.splitlines() or ["refused: the land gate"])[0]))[:300] + " (the land was not started)", 3)
    if os.environ.get("CW_LAND_GATE") == "enforce":
        die("refused: the land gate could not be checked (the switchboard is unreachable) and CW_LAND_GATE=enforce; the land was not started", 3)
    try:   # a link or a FIFO at the path is left alone (nothing is recorded)
        fd = os.open(GATE_AUDIT, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600)
        try:
            if stat.S_ISREG(os.fstat(fd).st_mode):
                os.write(fd, ("%s land-gate-unchecked %s start\n" % (time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), re.sub(r"[^A-Za-z0-9._/-]", "?", repo or "-")[:100])).encode())
        finally:
            os.close(fd)
    except OSError:
        pass


def cmd_start(args):
    name = None
    if args[:1] == ["--name"]:
        if len(args) < 2:
            die("--name needs a value")
        name, args = args[1], args[2:]
    if args[:1] != ["--"] or len(args) < 2:
        die("usage: cw-run start [--name NAME] -- COMMAND...")
    cmd = args[1:]
    if name is None:
        name = "run-%d" % int(time.time())
    check_name(name)
    # the allow row for `cw-run start*` comes after the rows of the template, so the command is held against the template list here (the rows of the file, without the operator's patterns)
    checker = os.environ.get("CW_SHELL_CHECK") or os.path.join(os.path.dirname(os.path.abspath(__file__)), "cw-shell-check")
    if not os.path.exists(checker):
        checker = "/usr/local/bin/cw-shell-check"
    rules = os.environ.get("CW_BASE_RULES") or "/usr/local/share/cw/opencode-worker.json"
    if os.path.exists(checker) and os.path.exists(rules):
        r = subprocess.run([sys.executable, checker, "--list", rules, shlex.join(cmd)], capture_output=True, text=True)
        if r.returncode == 1:
            die("the pod's shell rules refuse that command; it was not started")
    land_gate(cmd)
    ensure_dir()
    if state(name)[0] == "running":
        die("a run named %s is still running" % name)
    for ext in ("exit", "log", "pid"):
        try:
            os.unlink(path(name, ext))
        except OSError:
            pass
    sup = subprocess.Popen([sys.executable, os.path.abspath(__file__), "_supervise", name, "--"] + cmd,
                           stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                           start_new_session=True, close_fds=True)
    with open(path(name, "pid"), "w") as f:
        f.write("%d\n" % sup.pid)
    print("started %s (pid %d); log %s" % (name, sup.pid, path(name, "log")))
    print("poll: cw-run wait %s 120   (repeat until it prints exited; at most 240 seconds per wait)" % name)
    print("then: cw-run tail %s 50" % name)


def cmd_wait(args):
    if not 1 <= len(args) <= 2:
        die("usage: cw-run wait NAME [SECONDS]")
    name = check_name(args[0])
    secs = 120
    if len(args) == 2:
        if not re.fullmatch(r"[0-9]{1,9}", args[1]):
            die("SECONDS is a whole number")
        secs = int(args[1])
    secs = min(secs, MAX_WAIT)
    if state(name)[0] == "none":
        die("no run named %s" % name)
    end = time.time() + secs
    while state(name)[0] == "running" and time.time() < end:
        time.sleep(min(0.2, max(0.0, end - time.time())))
    st = state(name)
    print("running %ds" % st[1] if st[0] == "running" else "exited %s" % st[1])
    out = last_lines(name, 20)
    if out:
        print(out)


def cmd_tail(args):
    if not 1 <= len(args) <= 2:
        die("usage: cw-run tail NAME [LINES]")
    name = check_name(args[0])
    n = 20
    if len(args) == 2:
        if not re.fullmatch(r"[0-9]{1,6}", args[1]):
            die("LINES is a whole number")
        n = int(args[1])
    if state(name)[0] == "none":
        die("no run named %s" % name)
    out = last_lines(name, n)
    if out:
        print(out)


def cmd_list(args):
    if args:
        die("usage: cw-run list")
    try:
        names = sorted(f[:-4] for f in os.listdir(RUNS) if f.endswith(".pid"))
    except OSError:
        names = []
    for n in names:
        st = state(n)
        print("%s %s" % (n, "running %ds" % st[1] if st[0] == "running" else "exited %s" % st[1] if st[0] == "exited" else "gone"))


def main(argv):
    if argv[:1] == ["_supervise"]:
        sep = argv.index("--")
        return supervise(argv[1], argv[sep + 1:])
    cmds = {"start": cmd_start, "wait": cmd_wait, "tail": cmd_tail, "list": cmd_list}
    if not argv or argv[0] not in cmds:
        die("usage: cw-run start [--name NAME] -- COMMAND... | wait NAME [SECONDS] | tail NAME [LINES] | list")
    cmds[argv[0]](argv[1:])


if __name__ == "__main__":
    main(sys.argv[1:])
