#!/usr/bin/env python3
"""cw-shell-check [--list FILE] COMMAND | -

Applies the pod's shell permission rules to a command text, the way the agent runtime does: the command is split into
its parts at `;`, `&`, `&&`, `||`, `|`, a newline, a subshell `( ... )`, a command substitution `$( ... )` or in backticks (also inside double quotes);
the shell keywords `if then else elif while until do { } ! fi done esac in`, `for x in`, and a case pattern are not part of a command; every part
is matched against the rows of the worker agent's `permission.bash` block in order (fnmatch, case-sensitive) and the LAST
matching row decides. If one part is denied the runtime refuses the WHOLE command with `Permission denied: shell`.
Prints per part `allow|deny <deciding row> : <part>`. Exit 0 all allowed, 1 any denied, 2 usage error, 3 a construct it does not parse (an unterminated quote, an unmatched
bracket or backtick, a here-document, `((`, `function`): prints `unsure : <reason>`, never a plain allow.
A pure read of the permission list; writes nothing.
"""
import fnmatch
import json
import os
import re
import shlex
import sys

DEFAULT_LIST = "/usr/local/share/cw/opencode-worker.json"


KEYWORDS = ("if", "then", "else", "elif", "while", "until", "do", "{", "!")
BARE = ("}", "fi", "done", "esac", "in", ";;")
CASE_PATTERN = re.compile(r"^\(?[^\s'\"()]+(\|[^\s'\"()]+)*\)\s*")
FOR_HEAD = re.compile(r"^(for|select)\s+\S+(\s+in\b.*)?$")
CASE_HEAD = re.compile(r"^case\s+.*?\s+in\b\s*")


def clean(part, unsure):
    """Drop the shell keywords and case patterns the runtime does not count as part of a command."""
    while True:
        old = part
        for kw in KEYWORDS:
            if part == kw:
                part = ""
            elif part.startswith(kw) and part[len(kw)].isspace():
                part = part[len(kw):].strip()
        m = CASE_HEAD.match(part)
        if m:
            part = part[m.end():]
        m = CASE_PATTERN.match(part)
        if m:
            part = part[m.end():]
        if FOR_HEAD.match(part) or part in BARE:
            part = ""
        if part == old:
            break
    if part.startswith("function ") or part.startswith("coproc "):
        unsure.append("a construct not measured: %s" % part.split()[0])
    return part


def split_parts(text, unsure=None):
    """Returns the parts; the reasons for which the text is not fully parsed are appended to `unsure`."""
    parts = []
    if unsure is None:
        unsure = []

    def close_of(s, j, opener):
        # index just after the closer matching an opener whose body starts at j, or -1
        if opener == "`":
            k = j
            while k < len(s):
                if s[k] == "\\":
                    k += 2
                    continue
                if s[k] == "`":
                    return k + 1
                k += 1
            return -1
        depth, k, q = 1, j, None
        while k < len(s) and depth:
            d = s[k]
            if q:
                if d == "\\" and q == '"':
                    k += 1
                elif d == q:
                    q = None
            elif d == "\\":
                k += 1
            elif d in "'\"":
                q = d
            elif d == "(":
                depth += 1
            elif d == ")":
                depth -= 1
            k += 1
        return k if depth == 0 else -1

    def substitution(s, i):
        """If a substitution or subshell opens at i return (body start, end), else None; -1 end = unterminated."""
        c = s[i]
        if c == "`":
            j, opener = i + 1, "`"
        elif c == "$" and s[i + 1:i + 2] == "(":
            j, opener = i + 2, "("
        elif c == "(":
            j, opener = i + 1, "("
        else:
            return None
        return j, close_of(s, j, opener)

    def walk(s):
        cur = []
        i, n, quote = 0, len(s), None

        def flush():
            p = clean("".join(cur).strip(), unsure)
            del cur[:]
            if p:
                parts.append(p)
        while i < n:
            c = s[i]
            if quote:
                if quote == '"' and c in "`$":
                    sub = substitution(s, i)
                    if sub:
                        j, end = sub
                        if end < 0:
                            unsure.append("an unterminated substitution")
                            walk(s[j:])
                            return flush()
                        walk(s[j:end - 1] if s[end - 1] in ")`" else s[j:end])
                        i = end
                        continue
                cur.append(c)
                if c == "\\" and quote == '"' and i + 1 < n:
                    cur.append(s[i + 1]); i += 1
                elif c == quote:
                    quote = None
            elif c == "\\" and s[i + 1:i + 2] == "\n" and not "".join(cur).strip():
                i += 1  # measured: a continuation at the start of a part is skipped by the runtime; inside a part it stays
            elif c == "\\" and i + 1 < n:
                cur.append(c); cur.append(s[i + 1]); i += 1
            elif c in "'\"":
                quote = c; cur.append(c)
            elif c in "`(" or (c == "$" and s[i + 1:i + 2] == "("):
                if s[i:i + 2] == "((" or s[i:i + 3] == "$((":
                    unsure.append("an arithmetic construct (( ))")
                j, end = substitution(s, i)
                flush()
                if end < 0:
                    unsure.append("an unmatched bracket or backtick")
                    walk(s[j:])
                    return
                walk(s[j:end - 1])
                i = end
                continue
            elif c == "<" and s[i + 1:i + 2] == "<" and s[i + 2:i + 3] != "<":
                unsure.append("a here-document")
                cur.append(c)
            elif c == "&" and (s[i - 1:i] in (">", "<") or s[i + 1:i + 2] == ">") and i > 0:
                cur.append(c)  # a redirection (`2>&1`, `&>f`), not a separator
            elif c == "|" and s[i - 1:i] == ">":
                cur.append(c)  # the clobber redirect `>|`, not a pipe
            elif c in ";\n|&":
                flush()
            else:
                cur.append(c)
            i += 1
        if quote:
            unsure.append("an unterminated quote")
        flush()

    walk(text)
    return parts


def decide(rows, part):
    row = None
    verdict = "allow"
    for pattern, action in rows:
        if fnmatch.fnmatchcase(part, pattern):
            row, verdict = pattern, action
    return verdict, row

# The path rule: a command that writes outside /work and /tmp is refused (the ask #2205 rule).
WRITE_ROOTS = ("/work", "/tmp")
# The paths the image itself writes at run, allowed by name: the tmpfs the entrypoint uses (CW_TMP_DIR, /run/cw-tmp: the
# OpenCode data and config dirs), the worker user's tool caches in the home (/home/worker/.cache for pip and the like,
# /home/worker/.npm for npm), the git identity file (git config user.name/user.email writes /home/worker/.gitconfig), and the null device and std streams.
IMAGE_WRITES = ("/run/cw-tmp", "/home/worker/.cache", "/home/worker/.npm", "/home/worker/.gitconfig",
                "/dev/null", "/dev/stdout", "/dev/stderr", "/dev/tty")
REDIRECT = re.compile(r"^(?:\d*|&)(>>|>\|?)(.*)$")
REDIR_OP = re.compile(r"^(?:&>>?|>>|>\||>&|>)$")
SHELLS = ("bash", "sh", "zsh", "dash", "ksh")
INLINE = {"python": ("-c",), "python3": ("-c",), "node": ("-e", "--eval", "-p"), "perl": ("-e", "-E"), "ruby": ("-e",)}
NAMED_PATH = re.compile(r"""(?:(?<=[\s'"=(,;:<>])|^)(~?/[^\s'"`;|&)<>,]*)""")
WRAPPERS = ("env", "xargs", "nohup", "timeout", "time", "command", "exec")
WRAP_ARG = {"xargs": ("-I", "-n", "-P", "-L", "-d", "-E", "-s", "-a"), "env": ("-u", "-C", "-S"), "timeout": ("-s", "-k")}
OUT_FLAGS = {"curl": ("-o", "--output", "--output-dir"), "wget": ("-O", "-o", "-P", "--output-document", "--directory-prefix", "--output-file"),
             "tar": ("-C", "--directory"), "unzip": ("-d",), "cp": ("-t", "--target-directory"), "rsync": ("--target-directory",)}


def lex(part):
    """The words of a part with every redirect operator a word of its own (`x>/etc/a` -> x > /etc/a)."""
    lx = shlex.shlex(part, posix=True, punctuation_chars="<>|&")
    lx.whitespace_split = True
    toks = list(lx)
    out = []
    for t in toks:
        if out and REDIR_OP.match(t) and out[-1].isdigit():
            out.pop()
        out.append(t)
    return out


def named_paths(text, cwd):
    """The paths a literal inline script names (as resolved) that lie outside the allowed roots."""
    found = []
    for m in NAMED_PATH.finditer(text):
        raw = m.group(1)
        if raw in ("/", "~"):
            continue
        full = resolve(raw, cwd)
        if full is None or not allowed_path(full):
            found.append(full or raw)
    return found


def inline_text(cmd, args):
    """(text, index) of the -c/-e text of a shell or interpreter, or (None, -1)."""
    for k, a in enumerate(args[:-1]):
        if cmd in SHELLS and re.match(r"^-[a-zA-Z]*c$", a) or a in INLINE.get(cmd, ()) or (cmd == "perl" and re.match(r"^-[a-zA-Z]*[eE]$", a)):
            return args[k + 1], k + 1
    return None, -1


def unwrap(words):
    """Drop one wrapper (env, xargs, nohup, timeout, time, command, exec) and its options."""
    w, rest = os.path.basename(words[0]), words[1:]
    skip, first = WRAP_ARG.get(w, ()), True
    while rest:
        a = rest[0]
        if a in skip and len(rest) > 1:
            rest = rest[2:]
        elif a.startswith("-") and a != "-" or (w == "env" and re.match(r"^\w+=", a)):
            rest = rest[1:]
        elif w == "timeout" and first:
            rest, first = rest[1:], False
        else:
            break
    return rest


def resolve(path, cwd):
    """The absolute normal form of a path (~, $HOME, .., relative to cwd); None if it holds another variable."""
    home = os.environ.get("HOME") or "/home/worker"
    if path == "~" or path.startswith("~/"):
        path = home + path[1:]
    path = path.replace("${HOME}", home).replace("$HOME", home)
    if "$" in path or "`" in path:
        return None
    return os.path.normpath(os.path.join(cwd, path))


def allowed_path(path):
    return any(path == r or path.startswith(r + "/") for r in WRITE_ROOTS + IMAGE_WRITES)


def write_targets(part, cwd):
    """(targets, new cwd) of one part: the paths the part writes to, as written."""
    try:
        toks = lex(part)
    except ValueError:
        return [], cwd
    targets, words, i = [], [], 0
    while i < len(toks):
        m = REDIRECT.match(toks[i])
        if REDIR_OP.match(toks[i]):
            nxt = toks[i + 1] if i + 1 < len(toks) else ""
            if toks[i] == ">&" and (nxt.isdigit() or nxt == "-"):
                pass  # a descriptor copy (`2>&1`), not a file
            elif nxt:
                targets.append(nxt)
            i += 1
        elif m and not m.group(2).startswith("&"):
            if m.group(2):
                targets.append(m.group(2))
            elif i + 1 < len(toks):
                i += 1
                targets.append(toks[i])
        else:
            words.append(toks[i])
        i += 1
    while words and re.match(r"^\w+=", words[0]):
        words.pop(0)
    if words and words[0] == "sudo":
        words.pop(0)
    while words and os.path.basename(words[0]) in WRAPPERS:
        words = unwrap(words)
        while words and re.match(r"^\w+=", words[0]):
            words.pop(0)
    if not words:
        return targets, cwd
    cmd, args = os.path.basename(words[0]), words[1:]
    plain = [a for a in args if not a.startswith("-")]
    text, ti = inline_text(cmd, args)
    if text is not None:
        targets += named_paths(text, cwd)
        if cmd in SHELLS:
            for sub in split_parts(text, []):
                more, cwd = write_targets(sub, cwd)
                targets += more
        if cmd == "perl" and any(re.match(r"^-[a-zA-Z]*i", a) for a in args):
            targets += [a for k, a in enumerate(args) if not a.startswith("-") and k != ti]
        return targets, cwd
    flags = OUT_FLAGS.get(cmd, ())
    for k, a in enumerate(args):
        if a in flags and k + 1 < len(args):
            targets.append(args[k + 1])
        elif a.split("=")[0] in flags and "=" in a:
            targets.append(a.split("=", 1)[1])
        elif cmd in ("curl", "wget", "tar", "unzip", "cp") and re.match(r"^-[oOCdtP].+", a) and a[:2] in flags and not a.startswith("--"):
            targets.append(a[2:])
    if cmd == "rsync":
        targets += plain[-1:]
    if cmd == "pushd" and plain:
        dest = resolve(plain[0], cwd)
        return targets, dest or cwd
    if cmd == "cd":
        dest = resolve(plain[0], cwd) if plain else resolve("~", cwd)
        return targets, dest or cwd
    if cmd in ("tee", "touch", "mkdir", "rm", "rmdir", "truncate", "unlink", "shred"):
        targets += plain
    elif cmd in ("cp", "mv", "install", "ln"):
        tdir = [args[k + 1] for k, a in enumerate(args[:-1]) if a in ("-t", "--target-directory")]
        targets += tdir or plain[-1:]
        if cmd == "mv":
            targets += plain[:-1]
    elif cmd == "sed" and any(re.match(r"^-[a-zA-Z]*i|^--in-place", a) for a in args):
        script = any(a in ("-e", "-f") or a.startswith("--expression") for a in args)
        targets += plain if script else plain[1:]
    elif cmd == "dd":
        targets += [a[3:] for a in args if a.startswith("of=")]
    return targets, cwd


def outside_write(text_parts):
    """The first path the parts write to outside the allowed roots, or None."""
    cwd = "/work/repo"
    for part in text_parts:
        targets, cwd = write_targets(part, cwd)
        for t in targets:
            full = resolve(t, cwd)
            if full is None or not allowed_path(full):
                return full or t
    return None


def main(argv):
    args = argv[1:]
    path = DEFAULT_LIST
    if len(args) >= 2 and args[0] == "--list":
        path, args = args[1], args[2:]
    if len(args) != 1:
        sys.stderr.write("usage: cw-shell-check [--list FILE] COMMAND | -\n")
        return 2
    text = sys.stdin.read() if args[0] == "-" else args[0]
    try:
        with open(path) as fh:
            rows = list(json.load(fh)["agent"]["worker"]["permission"]["bash"].items())
    except (OSError, ValueError, KeyError) as exc:
        sys.stderr.write("cw-shell-check: cannot read the permission list: %s\n" % type(exc).__name__)
        return 2
    denied = False
    unsure = []
    for part in split_parts(text, unsure):
        verdict, row = decide(rows, part)
        denied = denied or verdict == "deny"
        print("%s %s : %s" % (verdict, row if row is not None else "(no row)", part))
    reasons = sorted(set(unsure))
    for reason in reasons:
        print("unsure : %s" % reason)
    outside = outside_write(split_parts(text, []))
    if outside is not None:
        sys.stderr.write("cw-shell-check: refused, writes outside /work and /tmp: %s\n" % outside)
        return 1
    if denied:
        return 1
    return 3 if reasons else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
