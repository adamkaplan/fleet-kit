#!/usr/bin/env python3
"""cw-plan-check --file PATH --done-when TEXT [--json] [--explain]

Checks a plan file the way the switchboard's `plan check --file` does, inside a worker pod. A pure read: it opens the
one file it is given, writes nothing, opens no socket. Exit 0 pass, 1 fail, 2 unreadable or a usage error.
The checking logic is plan_check.py next to this file (a byte-identical copy of bin/plan_check.py; a CI test pins it).
"""
import argparse
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import plan_check  # noqa: E402


class _Parser(argparse.ArgumentParser):
    def error(self, message):
        sys.stderr.write("cw-plan-check: %s\nusage: cw-plan-check --file PATH --done-when TEXT [--json] [--explain]\n" % message)
        sys.exit(2)


def main(argv):
    parser = _Parser(prog="cw-plan-check", add_help=False)
    parser.add_argument("--file", required=True)
    parser.add_argument("--done-when", dest="done_when", required=True)
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--explain", action="store_true")
    args = parser.parse_args(argv)
    limit = plan_check.MAX_BYTES * 4
    try:
        with open(args.file, "r", encoding="utf-8") as handle:
            text = handle.read(limit + 1)
    except (OSError, UnicodeDecodeError) as err:
        message = "cannot read %s: %s" % (args.file, getattr(err, "strerror", None) or err)
        return _fail(args, message)
    if len(text) > limit:
        return _fail(args, "%s is larger than %d bytes" % (args.file, limit))
    try:
        result = plan_check.check(text, args.done_when, None)
    except ValueError as err:
        return _fail(args, " ".join(str(err).split())[:300])
    source = "file %s" % args.file
    result["source"] = source
    if args.json:
        print(json.dumps(result, sort_keys=True))
    else:
        print("\n".join(plan_check.render(result, source, explaining=args.explain)))
    return 0 if result["result"] == "pass" else 1


def _fail(args, message):
    if args.json:
        print(json.dumps({"result": "error", "error": message}, sort_keys=True))
    else:
        sys.stderr.write("cw-plan-check: plan check: %s\n" % message)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
