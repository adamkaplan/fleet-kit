#!/usr/bin/env python3
"""cw-plan-check --file PATH --done-when TEXT [--json] [--explain]

Checks a plan file the way the switchboard's `plan check --file` does, inside a worker pod. A pure read: it opens the
one file it is given, writes nothing, opens no socket. Exit 0 pass, 1 fail, 2 unreadable or a usage error.
The checking logic is plan_check.py next to this file (a byte-identical copy of bin/plan_check.py; a CI test pins it).
"""
import argparse
import json
import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import plan_check  # noqa: E402


_HEADING = re.compile(r"^\s{0,3}#{1,6}\s+(.*?)\s*#*\s*$")
_DONE_WHEN = re.compile(r"^(?:[-*]\s+)?\**done when\**\s*:\s*\**\s*(.*?)\**\s*$", re.IGNORECASE)


def parse_intent(body):
    """(intent, done_when) from the `## Intent` section of an issue body.

    The first line of the section is the Intent; a line starting `Done when:`
    is the Done-when. Either may be missing (None). Fenced code is ignored,
    the section ends at the next heading, and CRLF bodies are fine.
    """
    intent = done_when = None
    inside = fenced = False
    for line in (body or "").splitlines():
        if line.lstrip().startswith(("```", "~~~")):
            fenced = not fenced
            continue
        if fenced:
            continue
        heading = _HEADING.match(line)
        if heading:
            if inside:
                break
            inside = heading.group(1).strip().lower() == "intent"
            continue
        text = line.strip()
        if not inside or not text:
            continue
        match = _DONE_WHEN.match(text)
        if match:
            done_when = done_when or match.group(1).strip() or None
        elif intent is None:
            intent = text
    return intent, done_when


def plan_own_done_when(text, done_when):
    """The plan's own Done-when when it differs from --done-when, else None (as load_plan in the switchboard does)."""
    own = parse_intent(text)[1]
    return own if own and own != done_when else None


class _Parser(argparse.ArgumentParser):
    def error(self, message):
        sys.stderr.write("cw-plan-check: %s\nusage: cw-plan-check --file PATH --done-when TEXT [--json] [--explain]\n" % message)
        sys.exit(2)


def main(argv):
    parser = _Parser(prog="cw-plan-check", add_help=False)
    parser.add_argument("--file", required=True)
    parser.add_argument("--done-when", dest="done_when", required=True)
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--explain", action="store_true")
    args = parser.parse_args(argv)
    limit = plan_check.MAX_BYTES * 4
    try:
        with open(args.file, "r", encoding="utf-8") as handle:
            text = handle.read(limit + 1)
    except (OSError, UnicodeDecodeError) as err:
        message = "cannot read %s: %s" % (args.file, getattr(err, "strerror", None) or err)
        return _fail(args, message)
    if len(text) > limit:
        return _fail(args, "%s is larger than %d bytes" % (args.file, limit))
    try:
        result = plan_check.check(text, args.done_when, plan_own_done_when(text, args.done_when))
    except ValueError as err:
        return _fail(args, " ".join(str(err).split())[:300])
    source = "file %s" % args.file
    result["source"] = source
    if args.json:
        print(json.dumps(result, sort_keys=True))
    else:
        print("\n".join(plan_check.render(result, source, explaining=args.explain)))
    return 0 if result["result"] == "pass" else 1


def _fail(args, message):
    if args.json:
        print(json.dumps({"result": "error", "error": message}, sort_keys=True))
    else:
        sys.stderr.write("cw-plan-check: plan check: %s\n" % message)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
