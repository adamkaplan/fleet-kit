#!/usr/bin/env python3
"""cw-pod-inspect: read-only; prints ONE JSON line about this pod (agent server + git in /work/repo); never raises, exits 0.

Fields: in_flight, last_calls, last_text, idle_seconds, branch, unpushed, dirty, last_push, missing (fields it could not read).
Reads the agent server as activity.py does: CW_ACTIVITY_PORT (4096), CW_ACTIVITY_PASSWORD_FILE (/run/cw/server-password).
Env (tests only): CW_INSPECT_REPO (/work/repo)."""
import base64
import json
import os
import subprocess
import sys
import time
import urllib.request

AGENT_FIELDS = ("in_flight", "last_calls", "last_text", "idle_seconds")
GIT_FIELDS = ("branch", "unpushed", "dirty", "last_push")


def env():
    return (os.environ.get("CW_ACTIVITY_PORT", "4096"), os.environ.get("CW_ACTIVITY_PASSWORD_FILE", "/run/cw/server-password"),
            os.environ.get("CW_INSPECT_REPO", "/work/repo"))


def get(path, auth):
    req = urllib.request.Request("http://127.0.0.1:%s%s" % (env()[0], path), headers={"Authorization": auth})
    with urllib.request.urlopen(req, timeout=10) as r:
        return json.loads(r.read().decode()).get("data")


def git(*a):
    return subprocess.run(["git", "-C", env()[2]] + list(a), capture_output=True, text=True, timeout=30, check=True).stdout


def secs(ms, now):
    if not isinstance(ms, (int, float)):
        return None
    return max(0, int(now - (ms / 1000.0 if ms > 1e11 else ms)))


def agent():
    with open(env()[1]) as f:
        pw = f.read().strip()
    auth = "Basic " + base64.b64encode(("opencode:" + pw).encode()).decode()
    sessions = get("/api/session", auth)
    if isinstance(sessions, dict):
        sessions = list(sessions.values())
    cur = max(sessions, key=lambda s: ((s.get("time") or {}).get("updated") or 0))
    now = time.time()
    msgs = get("/api/session/%s/message" % cur["id"], auth) or []
    calls, text, flight = [], "", None
    for m in msgs:
        role = ((m.get("info") or {}).get("role")) or m.get("role")
        for p in (m.get("parts") or []):
            if p.get("type") == "tool":
                st = p.get("state") or {}
                t = st.get("time") or {}
                status = st.get("status")
                start = t.get("start")
                if status in ("running", "pending"):
                    flight = {"tool": p.get("tool"), "seconds": secs(start, now)}
                else:
                    calls.append({"tool": p.get("tool"), "status": status, "seconds_ago": secs(t.get("end", start), now)})
            elif p.get("type") == "text" and role == "assistant":
                text = p.get("text") or ""
    return {"in_flight": flight, "last_calls": calls[-10:], "last_text": text[:300],
            "idle_seconds": secs((cur.get("time") or {}).get("updated"), now)}


def gitpart():
    shas = [x[:9] for x in git("log", "--format=%H", "HEAD", "--not", "--remotes").split()]
    return {"branch": git("rev-parse", "--abbrev-ref", "HEAD").strip(),
            "unpushed": {"count": len(shas), "shas": shas},
            "dirty": len(git("status", "--porcelain").splitlines())}


def lastpush():
    remotes = [r + "/" for r in git("remote").split()]
    best = None
    for line in git("reflog", "--date=iso-strict", "--format=%gd", "--all").splitlines():
        ref, _, rest = line.partition("@{")
        if any(ref.startswith(r) for r in remotes) and rest.endswith("}"):
            best = max(best or "", rest[:-1])
    return {"last_push": best}


def main():
    out, missing = {}, []
    for fn, names in ((agent, AGENT_FIELDS), (gitpart, GIT_FIELDS[:3]), (lastpush, GIT_FIELDS[3:])):
        try:
            out.update(fn())
        except BaseException:
            missing.extend(names)
    for n in AGENT_FIELDS + GIT_FIELDS:
        out.setdefault(n, None)
    out["missing"] = missing
    print(json.dumps(out))
    return 0


if __name__ == "__main__":
    try:
        rc = main()
    except BaseException:
        print(json.dumps({"missing": list(AGENT_FIELDS + GIT_FIELDS)}))
        rc = 0
    sys.exit(rc)
