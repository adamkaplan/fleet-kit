out=$(SCAN_TRIPLES=1 SCAN_ALLOWLIST="$al/list-wrong" "$S" --archive "$al/arch.tar" 2>&1)
echo "$out" | grep -q "^TRIPLE.*/lib/f $h1 github-token$" && ! echo "$out" | grep -q "$ltok" && ok "SCAN_TRIPLES=1 prints the triple of a hit, never the value" || bad "triple output"

# 3h. publish-image.sh: scan, then publish BY DIGEST, or publish nothing (stub crane/skopeo on a private dir; docker-free)
pb="$tmp/pub"; mkdir -p "$pb/bin"; PUB="$here/worker/publish-image.sh"
D1="sha256:$(printf '1%.0s' $(seq 64))"; D2="sha256:$(printf '2%.0s' $(seq 64))"
cat > "$pb/bin/crane" <<'S'
#!/usr/bin/env bash
echo "crane $*" >> "$STUB_LOG"
case $1 in
  manifest) if [ "$STUB_INDEX" = 1 ]; then echo '{"mediaType":"application/vnd.oci.image.index.v1+json","manifests":[{}]}'; else echo '{"mediaType":"application/vnd.oci.image.manifest.v1+json","layers":[]}'; fi ;;
  digest) n=$(cat "$STUB_STATE/n" 2>/dev/null || echo 0); echo $((n+1)) > "$STUB_STATE/n"
          [ "$STUB_FAIL" = digest ] && exit 1
          if [ "$STUB_MOVE" = 1 ] && [ "$n" -ge 1 ]; then echo "$STUB_D2"; else echo "$STUB_D1"; fi ;;
  pull) [ "$STUB_FAIL" = pull ] && exit 1; for a; do dir=$a; done; mkdir -p "$dir"; tar -xf "$STUB_ARCHIVE" -C "$dir" ;;
  copy) [ "$STUB_FAIL" = copy ] && exit 1; exit 0 ;;
esac
S
cat > "$pb/bin/skopeo" <<'S'
#!/usr/bin/env bash
echo "skopeo $*" >> "$STUB_LOG"
case $1 in
  inspect) case $* in *@sha256:*) if [ "$STUB_INDEX" = 1 ]; then echo '{"manifests":[{}]}'; else echo '{"mediaType":"application/vnd.oci.image.manifest.v1+json","layers":[]}'; fi; exit 0 ;; esac
           n=$(cat "$STUB_STATE/n" 2>/dev/null || echo 0); echo $((n+1)) > "$STUB_STATE/n"
           if [ "$STUB_MOVE" = 1 ] && [ "$n" -ge 1 ]; then printf 'manifest-two'; else printf 'manifest-one'; fi ;;
  copy) case $* in *oci-archive:*) for a; do o=$a; done; cp "$STUB_ARCHIVE" "${o#oci-archive:}" ;;
          *) [ "$STUB_FAIL" = copy ] && exit 1; exit 0 ;; esac ;;
esac
S
chmod +x "$pb/bin/crane" "$pb/bin/skopeo"
mdig() { printf '%s' "$1" | python3 -c 'import hashlib,sys; print("sha256:"+hashlib.sha256(sys.stdin.buffer.read()).hexdigest())'; }
# pub <tool> <archive> [move] [fail]: runs the script; sets prc, pout, and the stub call log in $plog
pub() {
  plog="$pb/calls"; : > "$plog"; rm -rf "$pb/state"; mkdir -p "$pb/state"
  pout=$(env STUB_LOG="$plog" STUB_STATE="$pb/state" STUB_ARCHIVE="$ad/$2.tar" STUB_MOVE="${3:-0}" STUB_FAIL="${4:-none}" STUB_INDEX="${5:-0}" STUB_D1="$D1" STUB_D2="$D2" \
    "$PUB" --tool "$1" --tool-dir "$pb/bin" --staging acme-registry.example/cw/worker-candidate:abc --release acme-registry.example/cw/worker:v1 2>&1); prc=$?
  ncopy=$(grep -cE '^(crane copy|skopeo copy .*docker://acme-registry.example/cw/worker:v1)' "$plog")
}
for t in crane skopeo; do
  pub $t oci-clean
  want=$D1; [ $t = skopeo ] && want=$(mdig manifest-one)
  [ "$prc" = 0 ] && [ "$ncopy" = 1 ] && grep -q "worker-candidate@$want" <(grep -E 'copy .*worker:v1' "$plog") && ! grep -E 'copy .*worker:v1' "$plog" | grep -q 'candidate:abc' \
    && echo "$pout" | grep -q 'all 3 layers scanned' && ok "publish ($t): a clean image is published once, BY the scanned digest" || bad "publish clean $t rc=$prc copies=$ncopy"
  pub $t oci-utf16; [ "$prc" = 1 ] && [ "$ncopy" = 0 ] && ok "publish ($t): a token in a layer publishes nothing (exit 1)" || bad "publish planted $t rc=$prc copies=$ncopy"
  pub $t oci-deleted; [ "$prc" = 1 ] && [ "$ncopy" = 0 ] && ok "publish ($t): a token deleted in a later layer publishes nothing" || bad "publish deleted $t rc=$prc copies=$ncopy"
  pub $t oci-badlayer; [ "$prc" = 2 ] && [ "$ncopy" = 0 ] && ok "publish ($t): an unreadable layer is exit 2, nothing published" || bad "publish unreadable $t rc=$prc copies=$ncopy"
  pub $t oci-clean 1; [ "$prc" = 3 ] && [ "$ncopy" = 0 ] && echo "$pout" | grep -q 'moved' && ok "publish ($t): the staging tag moved after the scan: refused, nothing published" || bad "publish moved $t rc=$prc copies=$ncopy"
  pub $t oci-clean 0 none 1; [ "$prc" = 3 ] && [ "$ncopy" = 0 ] && ! grep -qE 'pull|oci-archive' "$plog" && echo "$pout" | grep -q 'not a single-image manifest' \
    && ok "publish ($t): a multi-platform index is refused (exit 3) before any export or copy" || bad "publish index $t rc=$prc copies=$ncopy"
  pub $t oci-clean 0 copy; [ "$prc" = 3 ] && grep -qE 'copy .*worker:v1' "$plog" && ok "publish ($t): a tool failure on the publish step is non-zero" || bad "publish copy fail $t"
done
for f in digest pull; do pub crane oci-clean 0 $f; [ "$prc" = 3 ] && [ "$ncopy" = 0 ] && ok "publish: a tool failure ($f) is exit 3, nothing published" || bad "publish fail $f rc=$prc"; done
! echo "$pout $(pub crane oci-utf16; echo "$pout")" | grep -q "$ltok" && ok "publish: no value is printed" || bad "publish printed a value"
"$PUB" --tool docker --tool-dir "$pb/bin" --staging a.example/x:y --release a.example/x:z >/dev/null 2>&1; r1=$?
"$PUB" --tool crane --tool-dir "$pb/bin" --staging a.example/x:y --release a.example/x:y >/dev/null 2>&1; r2=$?
"$PUB" --tool crane --tool-dir "$pb/bin" --staging 'a.example/x@sha256:1' --release a.example/x:z >/dev/null 2>&1; r3=$?
PATH="$pb/bin:$PATH" "$PUB" --tool crane --staging a.example/x:y --release a.example/x:z >/dev/null 2>&1; r4=$?
[ "$r1$r2$r3" = 333 ] && [ "$r4" != 0 ] && ok "publish: a tool outside the list, equal tags, a digest ref and a PATH-only tool are refused" || bad "publish arguments $r1$r2$r3 $r4"

# 4. image scan, only when docker is up
# 4a. no BuildKit-only syntax in the worker Dockerfile (the registry build, ACR Tasks, uses the legacy builder). Docker-free.
# tests/check-dockerfile-legacy is a small parser (continuations joined, comments dropped, directives read, flags allow-listed).
bkc="$here/tests/check-dockerfile-legacy"
bk_suite() { # <checker>: 0 when every planted case gets the right answer
  local c="$1" m
  printf 'FROM a AS w\nRUN echo hi\n' > "$tmp/bk.ok"; "$c" "$tmp/bk.ok" >/dev/null 2>&1 || return 1
  printf 'FROM a AS w\nCOPY --from=w --chown=1:1 a /b\nADD --chown=1:1 a /b\nRUN echo --mount\n' > "$tmp/bk.ok"; "$c" "$tmp/bk.ok" >/dev/null 2>&1 || return 1
  while IFS= read -r m; do
    printf "FROM a AS w\n$m\n" > "$tmp/bk.bad"; "$c" "$tmp/bk.bad" >/dev/null 2>&1; [ $? = 1 ] || return 1
  done <<'BAD'
RUN --mount=type=bind,from=scan,source=/scan-ok,target=/tmp/scan-ok true
RUN \\\n --mount=type=cache,target=/c true
RUN --MOUNT=type=cache,target=/c true
RUN --network=none true
RUN --security=insecure true
RUN cat <<EOF
RUN <<EOF
COPY <<EOF /x
ADD <<EOF /x
COPY --link a b
COPY --chmod=755 a b
COPY --exclude=x a b
COPY --parents a b
ADD --checksum=sha256:00 http://x/y /z
ADD --keep-git-dir=true http://x/y.git /z
COPY --Link a b
BAD
  for d in '# syntax=docker/dockerfile:1' '# SYNTAX=docker/dockerfile:1' '#Syntax = x' '# check=skip=all'; do
    printf '%s\nFROM a AS w\n' "$d" > "$tmp/bk.bad"; "$c" "$tmp/bk.bad" >/dev/null 2>&1; [ $? = 1 ] || return 1
  done
  return 0
}
bk_suite "$bkc" && ok "Dockerfile check: clean cases pass, each of 20 BuildKit-only forms fails" || bad "check-dockerfile-legacy fails its own cases"
"$bkc" "$here/worker/Dockerfile" >/dev/null 2>&1 && ok "Dockerfile: no BuildKit-only syntax" || bad "worker/Dockerfile uses BuildKit-only syntax"
# mutants of the checker: each must be caught by the cases above
for mut in 's/if "<<" in ins:/if False:/' 's/if name not in ALLOWED\[op\]:/if False:/' 's/m.group(1).lower() in/m.group(1) in/'; do
  sed "$mut" "$bkc" > "$tmp/mut.py"; chmod +x "$tmp/mut.py"; cmp -s "$bkc" "$tmp/mut.py" && bad "mutation did not apply: $mut"
  bk_suite "$tmp/mut.py" && bad "Dockerfile check: mutant survived: $mut" || ok "Dockerfile check: mutant caught ($mut)"
done
if [ "${CLOUD_TEST_SKIP_DOCKER:-0}" = 1 ]; then skip docker-build-cases "CLOUD_TEST_SKIP_DOCKER=1 (needs a base-image pull from the network)"
elif docker info >/dev/null 2>&1; then
  printf 'FROM busybox\nRUN echo "GITHUB_TOKEN=ghp_%s" > /t\n' "$(printf 'b%.0s' $(seq 36))" > "$tmp/Dockerfile"
  printf 'FROM busybox\nRUN echo hi > /t\n' > "$tmp/Dockerfile.clean"
  # a secret written in one layer and deleted in the next must still be found
  printf 'FROM busybox\nRUN echo "GITHUB_TOKEN=ghp_%s" > /t\nRUN rm /t\n' "$(printf 'c%.0s' $(seq 36))" > "$tmp/Dockerfile.deleted"
  # a secret in the image env
  printf 'FROM busybox\nENV GH_TOKEN=ghp_%s\n' "$(printf 'd%.0s' $(seq 36))" > "$tmp/Dockerfile.env"
  # build every image; a failed build is a test failure, never a pass
  cp "$tmp/Dockerfile" "$tmp/Dockerfile.baked"
  built=1
  for v in baked deleted env clean; do
    docker build -q -t "cw-scan-$v" -f "$tmp/Dockerfile.$v" "$tmp" >/dev/null 2>&1 || { bad "image build failed: $v"; built=0; }
  done
  if [ $built = 1 ]; then
    # secret images: exit exactly 1 and the report names the pattern
    for v in baked deleted env; do
      out=$("$here/worker/scan-secrets.sh" "cw-scan-$v" 2>&1); rc=$?
      [ "$rc" = 1 ] && echo "$out" | grep -q 'github-token\|generic-token-assignment' \
        && ok "image with secret ($v): exit 1 and pattern named" || bad "image with secret ($v) rc=$rc"
    done
    "$here/worker/scan-secrets.sh" cw-scan-clean >/dev/null 2>&1 && ok "clean image: 0 hits" || bad "clean image"
    out=$("$here/worker/scan-secrets.sh" cw-scan-deleted 2>&1)
    echo "$out" | grep -q '^layer [0-9]*: /t: github-token$' && ok "image with the token deleted in a later layer: found in its own layer" || bad "deleted-token image: not found per layer"
  fi
  # route 1 (README): a registry-free OCI export that holds the amd64 layers, scanned by --archive
  if docker buildx build -q --platform linux/amd64 --output "type=oci,dest=$tmp/deleted-oci.tar" -f "$tmp/Dockerfile.deleted" "$tmp" >/dev/null 2>&1; then
    out=$("$here/worker/scan-secrets.sh" --archive "$tmp/deleted-oci.tar" 2>&1); rc=$?
    [ "$rc" = 1 ] && echo "$out" | grep -q '^layer [0-9]*: /t: github-token$' && ! echo "$out" | grep -q "ghp_" \
      && ok "buildx OCI export (amd64): the deleted token is found per layer" || bad "buildx oci export scan rc=$rc"
  else bad "buildx OCI export failed"; fi
  docker rmi cw-scan-baked cw-scan-deleted cw-scan-env cw-scan-clean >/dev/null 2>&1
  # 4b. the BUILD scan: the real Dockerfile's scan and final stages (from "FROM worker AS scan") on top of a small
  # stand-in `worker` stage, built for linux/amd64 like the remote build. The token is written now, in the context.
  base=$(sed -n 's/^\(FROM ubuntu:[^ ]*\) AS worker$/\1/p' "$here/worker/Dockerfile")
  tail=$(sed -n '/^FROM worker AS scan$/,$p' "$here/worker/Dockerfile")
  bctx="$tmp/bctx"; mkdir -p "$bctx/worker"; cp "$here/worker/scan-secrets.sh" "$here/worker/scan-files.py" "$here/worker/scan-allowlist.txt" "$bctx/worker/"
  ptok="ghp_$(printf 'f%.0s' $(seq 36))"; printf '%s\n' "$ptok" > "$bctx/plant.txt"
  bbuild() { # <variant body for the worker stage> [scan-user]: prints the log, returns docker's status
    { echo "$base AS worker"; echo "RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends python3 && rm -rf /var/lib/apt/lists/*"; printf '%b\n' "$1"; echo "$tail"; } > "$bctx/Dockerfile.$2"
    [ -z "${3:-}" ] || sed -i.bak "s/^USER root$/USER $3/" "$bctx/Dockerfile.$2"
    docker build --platform linux/amd64 --progress=plain --no-cache -t "cw-bscan-$2" -f "$bctx/Dockerfile.$2" "$bctx" 2>&1
  }
  grep -q '^FROM worker AS scan$' "$here/worker/Dockerfile" && [ -n "$base" ] || bad "Dockerfile stages not found for the build-scan cases"
  out=$(bbuild 'COPY plant.txt /opt/plant.txt' planted); rc=$?
  hits=$(echo "$out" | grep -v 'allowlisted: ' | grep -oE '[^ ]+: [a-z-]+$' | sort -u | wc -l | tr -d ' ')   # docker prints a step's output twice
  [ "$rc" = 1 ] && [ "$hits" = 1 ] && echo "$out" | grep -q 'opt/plant.txt: github-token$' && ! echo "$out" | grep -q "$ptok" \
    && ok "build scan: planted token fails the build (exit 1), 1 path 1 pattern, no value" || bad "build scan planted rc=$rc hits=$hits"
  docker image inspect cw-bscan-planted >/dev/null 2>&1 && bad "build scan: an image was produced despite a hit" || ok "build scan: no image after a hit"
  out=$(bbuild 'RUN mkdir /opt/locked && echo x > /opt/locked/f && chmod 000 /opt/locked' unreadable nobody); rc=$?
  [ "$rc" != 0 ] && echo "$out" | grep -q 'could not read some files' \
    && ok "build scan: an unreadable directory fails the build (never a pass)" || bad "build scan unreadable rc=$rc"
  out=$(bbuild 'RUN echo hi > /opt/clean.txt' clean); rc=$?
  [ "$rc" = 0 ] && ok "build scan: the clean image builds" || { bad "build scan clean rc=$rc"; echo "$out" | tail -15; }
  docker run --rm --platform linux/amd64 --entrypoint sh cw-bscan-clean -c 'test "$(cat /usr/local/share/cw/scan-ok)" = ok && test ! -e /scan-ok && test ! -e /scan-secrets.sh && test ! -e /scan-allowlist.txt' \
    && ok "build scan: the shipped image carries only the 3-byte marker and no scan files" || bad "marker missing or scan script in the shipped image"
  docker rmi cw-bscan-clean >/dev/null 2>&1
else
  [ "${CLOUD_TEST_SKIP_DOCKER:-0}" = 1 ] && skip docker-not-running "CLOUD_TEST_SKIP_DOCKER=1" || bad "docker is required for the image-scan cases (set CLOUD_TEST_SKIP_DOCKER=1 to skip)"
fi
# 5. the CI skip is pinned: cloud/tests/ci-skips.txt names the cases CI cannot run. The check itself is tested first.
pins="$here/tests/ci-skips.txt"
printf 'a\nb\n' > "$tmp/pin"
printf 'a\nb\n' > "$tmp/s1"; printf 'a\nb\nextra\n' > "$tmp/s2"; printf 'a\n' > "$tmp/s3"
pin_check "$tmp/pin" "$tmp/s1" && ! pin_check "$tmp/pin" "$tmp/s2" && ! pin_check "$tmp/pin" "$tmp/s3" \
  && ! PIN_OS=Linux pin_check "$here/tests/ci-skips.txt" "$tmp/s3" && PIN_OS=Darwin pin_check "$here/tests/ci-skips.txt" <(printf 'docker-build-cases\nkubectl-manifests\n') && ! PIN_OS=Darwin pin_check "$here/tests/ci-skips.txt" <(printf 'docker-build-cases\nother\n') \
  && ok "skip pin: exact list passes; a planted extra or a missing skip fails" || bad "skip pin check is broken"
if [ "${CLOUD_TEST_SKIP_DOCKER:-0}" = 1 ]; then
  pin_check "$pins" "$skiplog" && ok "skip pin: skipped cases are exactly ci-skips.txt" || bad "skipped cases differ from ci-skips.txt: $(tr '\n' ' ' < "$skiplog")"
fi
# 5. the parity table: the real one passes; each planted fault exits 1
chk="$here/tests/check-parity-table"; tbl="$here/../docs/cloud-guard-parity.md"
"$chk" "$tbl" >/dev/null 2>&1 && ok "parity table: shape ok" || bad "parity table shape"
planted() { # name, sed expression applied to the first data row
  sed "$2" "$tbl" > "$tmp/p.md"; "$chk" "$tmp/p.md" >/dev/null 2>&1; rc=$?
  [ "$rc" = 1 ] && ok "parity table: $1 exits 1" || bad "parity table: $1 rc=$rc"; }
row=$(grep -n '^| Token scope' "$tbl" | cut -d: -f1)
planted "a blank cell" "${row}s/| covered |\$/|  |/"
planted "a row with no status" "${row}s/| covered |\$/| done |/"
planted "a GAP with no owner" "${row}s/| covered |\$/| GAP (item: #1) |/"
planted "an unknown law id" "${row}s/FK-LAW-1,/FK-LAW-99,/"
planted "'covered, mostly'" "${row}s/| covered |\$/| covered, mostly |/"
planted "a GAP whose item is -" "${row}s/| covered |\$/| GAP (owner: x; item: -) |/"
planted "a law id not in the list" "${row}s/FK-LAW-1,/FK-LAW-9,/"
# the item lists (kept by hand in cloud/tests/parity-items.txt): one mutant per member of each list
items="$here/tests/parity-items.txt"
for n in $(sed -n 's/^closed \([0-9]*\)$/\1/p' "$items"); do   # every closed item, cited as the GAP's only item or beside an open one, fails
  planted "a GAP citing closed item #$n" "${row}s/| covered |\$/| GAP (owner: x; item: #$n) |/"
  planted "a GAP citing closed #$n next to an open item" "${row}s/| covered |\$/| GAP (owner: x; item: #543 and #$n) |/"
done
for n in $(sed -n 's/^open \([0-9]*\)$/\1/p' "$items"); do   # every open item is accepted
  sed "${row}s/| covered |\$/| GAP (owner: x; item: #$n (open)) |/" "$tbl" > "$tmp/p.md"
  "$chk" "$tmp/p.md" >/dev/null 2>&1 && ok "parity table: a GAP naming open item #$n passes" || bad "parity table: open item #$n refused"
done
planted "a GAP naming no open item" "${row}s/| covered |\$/| GAP (owner: x; item: a follow-up) |/"
planted "a GAP naming an item in neither list" "${row}s/| covered |\$/| GAP (owner: x; item: #99999) |/"
printf 'open 543\nopen 2\nclosed 2\n' > "$tmp/bad-items.txt"; "$chk" "$tbl" "$here/../docs/cloud-guard-law-ids.md" "$tmp/bad-items.txt" >/dev/null 2>&1; [ $? = 1 ] && ok "parity table: a number in both lists fails" || bad "parity table: a number in both lists"
printf '# empty\n' > "$tmp/e.md"; "$chk" "$tmp/e.md" >/dev/null 2>&1; [ $? = 1 ] && ok "parity table: no rows exits 1" || bad "parity table: no rows"
[ $fail = 0 ] && echo "RESULT: PASS" || { echo "RESULT: FAIL"; exit 1; }
