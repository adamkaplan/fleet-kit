#!/usr/bin/env bash
# Tests for cloud/: manifests parse and dry-run, the containerd fix rewrites the legacy
# stanza (and is idempotent), and the secret scan finds a planted secret and passes clean.
set -u
here=$(cd "$(dirname "$0")/.." && pwd); fail=0
ok() { echo "ok   $1"; }; bad() { echo "FAIL $1"; fail=1; }
# Every skip goes through skip(): it prints "skip <case>: <reason>" and records the case, so the CI skip can be pinned (below).
skiplog=$(mktemp); skip() { echo "skip $1: $2"; echo "$1" >> "$skiplog"; }
# pin_check <list> <skiplog>: the skipped cases must be EXACTLY the ones in <list> (one case per line; # comments and blanks ignored).
# Line forms: `case`; `case <uname -s>` (that OS only); `case <uname -s> optional` (that OS only, and the case may also run).
# $PIN_OS overrides uname for the test.
pin_check() {
  local os=${PIN_OS:-$(uname -s)} want opt got
  want=$(grep -v '^[[:space:]]*\(#\|$\)' "$1" | awk -v os="$os" '(NF==1||$2==os)&&$3!="optional"{print $1}' | sort)
  opt=$(grep -v '^[[:space:]]*\(#\|$\)' "$1" | awk -v os="$os" '$2==os&&$3=="optional"{print $1}')
  # the skipped cases, less the optional ones that skipped, must equal the required list
  got=$(sort "$2" | awk -v opt="$opt" 'BEGIN{n=split(opt,a,"\n");for(k=1;k<=n;k++)o[a[k]]=1} !($1 in o)')
  [ "$want" = "$got" ]
}

# 1. manifests
if command -v kubectl >/dev/null; then
  # `apply --dry-run=client` needs a reachable API server for discovery; with none, fall back to an
  # offline parse (`label --local`) so the check still runs with no cluster.
  for f in "$here"/k8s/*.yaml; do
    if kubectl apply --dry-run=client --validate=false -f "$f" -o name >/dev/null 2>&1; then ok "apply --dry-run=client $(basename "$f")"
    elif KUBECONFIG=/dev/null kubectl label --local --dry-run=client -f "$f" x=y -o name >/dev/null 2>&1; then ok "offline parse $(basename "$f")"
    else bad "manifest $(basename "$f")"; fi
  done
else skip kubectl-manifests "kubectl not installed"; fi

# 2. the fix script's rewrite, on a legacy-keyed config
tmp=$(mktemp -d); trap 'rm -rf "$tmp" "$skiplog"' EXIT
cat > "$tmp/config.toml" <<'T'
version = 3
[plugins.'io.containerd.cri.v1.runtime'.containerd.runtimes.runc]
  runtime_type = 'io.containerd.runc.v2'
[plugins."io.containerd.grpc.v1.cri".containerd.runtimes.sysbox-runc]
  runtime_type = "io.containerd.runc.v2"
[plugins."io.containerd.grpc.v1.cri".containerd.runtimes.sysbox-runc.options]
  BinaryName = "/usr/bin/sysbox-runc"
T
# run the manifest's own fix.sh against a temp config, with stubbed host and label commands
sed -n '/^  fix.sh: |$/,/^---$/p' "$here/k8s/containerd-fix.yaml" | sed '1d;$d' | sed 's/^    //' > "$tmp/fix.sh"
cat > "$tmp/host" <<'H'
#!/bin/sh
echo "$@" >> "$TMP_LOG"
case "$1 $2" in
  "containerd config") [ "${DUMP_OK:-1}" = 1 ] || exit 1; cat "$CFG" ;;
  "systemctl restart")
    n=$(grep -c 'systemctl restart containerd' "$TMP_LOG")
    for k in ${RESTART_FAIL_ON:-}; do [ "$k" = "$n" ] && exit 1; done
    [ "${KILL_BAK:-0}" = 1 ] && [ "$n" = 1 ] && rm -f "$CFG.sysbox-fix.bak"
    exit 0 ;;
  "timeout 10")
    [ "${CTR_DOWN:-0}" = 1 ] && exit 1
    [ "${SLOW_PROBE:-0}" -gt 0 ] && [ "$(grep -c 'systemctl restart containerd' "$TMP_LOG")" = 1 ] && { sleep "$SLOW_PROBE"; exit 1; }
    # ctr version: fails while DOWN_UNTIL probes have not yet been made after a restart (DOWN_UNTIL=999: never answers)
    if [ "$(grep -c 'systemctl restart containerd' "$TMP_LOG")" = 1 ]; then
      [ "$(grep -c 'ctr version' "$TMP_LOG")" -le "${DOWN_UNTIL:-0}" ] && exit 1
    fi
    exit 0 ;;
esac
H
printf '#!/bin/sh
echo label >> "$TMP_LOG"
' > "$tmp/label"; chmod +x "$tmp/host" "$tmp/label"
printf '#!/bin/sh\nexit 0\n' > "$tmp/ready"; chmod +x "$tmp/ready"
runfix() { : > "$tmp/log"; READY_CMD="${READY_CMD:-$tmp/ready}" TMP_LOG="$tmp/log" CFG="$tmp/config.toml" HOST="$tmp/host" LABEL_CMD="$tmp/label" ONCE=1 sh "$tmp/fix.sh" >/dev/null 2>&1; }
restarts() { grep -c 'systemctl restart containerd' "$tmp/log" || true; }

runfix; rc=$?
[ $rc = 0 ] && ! grep -q "grpc.v1.cri" "$tmp/config.toml" && [ "$(restarts)" = 1 ] && grep -q label "$tmp/log" \
  && ok "fix: legacy stanza moved, containerd restarted once, node labelled" || bad "fix: legacy stanza (rc=$rc)"
cp "$tmp/config.toml" "$tmp/after1"
runfix; rc=$?
[ $rc = 0 ] && cmp -s "$tmp/after1" "$tmp/config.toml" && [ "$(restarts)" = 0 ] \
  && ok "fix: already right is a no-op, no restart" || bad "fix: not idempotent (rc=$rc)"
# invalid config: backup restored, exit non-zero
cat > "$tmp/config.toml" <<'T'
version = 3
[plugins."io.containerd.grpc.v1.cri".containerd.runtimes.sysbox-runc]
  runtime_type = "x"
T
cp "$tmp/config.toml" "$tmp/orig"
DUMP_OK=0 runfix; rc=$?
[ $rc = 1 ] && cmp -s "$tmp/orig" "$tmp/config.toml" && [ "$(restarts)" = 0 ] \
  && ok "fix: invalid config restored, no restart, exit 1" || bad "fix: invalid path (rc=$rc)"
# installer stanza absent: waits (exit 3 under ONCE)
printf 'version = 3\n' > "$tmp/config.toml"
runfix; rc=$?
[ $rc = 3 ] && [ "$(restarts)" = 0 ] && ok "fix: waits when sysbox-runc is not registered" || bad "fix: absent stanza (rc=$rc)"

# the installer's real form on a managed node: indented headers, the sysbox tables under the legacy
# key beside the real runtimes under the new key, empty legacy parents
fx="$here/tests/fixtures/containerd-aks-installer-form.toml"
keep() { grep -E 'runtimes\.(runc|untrusted)|cri\.v1\.images|^\[metrics\]|0\.0\.0\.0|pause|certs\.d|azure/aks|runc"|SystemdCgroup|BinaryName = "/usr/bin/runc"' "$1" | grep -v sysbox; }
cp "$fx" "$tmp/config.toml"; keep "$tmp/config.toml" > "$tmp/keep.before"
runfix; rc=$?
nh() { grep -E '^[[:space:]]*\[' "$tmp/config.toml" | sort | uniq -d | wc -l | tr -d ' '; }
[ $rc = 0 ] && ! grep -q 'grpc.v1.cri' "$tmp/config.toml" \
  && grep -q '^        \[plugins."io.containerd.cri.v1.runtime".containerd.runtimes.sysbox-runc\]' "$tmp/config.toml" \
  && grep -q 'runtimes.sysbox-runc.options\]' "$tmp/config.toml" && [ "$(nh)" = 0 ] \
  && [ "$(tail -c1 "$tmp/config.toml" | od -An -c | tr -d ' ')" = '\n' ] && [ ! -e "$tmp/config.toml.tmp" ] \
  && [ "$(restarts)" = 1 ] && ok "fix: installer form: sysbox-runc moved, legacy parents gone, no duplicate header" || bad "fix: installer form (rc=$rc)"
keep "$tmp/config.toml" | cmp -s - "$tmp/keep.before" && ok "fix: installer form: runc/untrusted/images/metrics lines unchanged" || bad "fix: other stanzas changed"
cp "$tmp/config.toml" "$tmp/after2"; runfix; rc=$?
[ $rc = 0 ] && cmp -s "$tmp/after2" "$tmp/config.toml" && [ "$(restarts)" = 0 ] && ok "fix: installer form: second run changes nothing" || bad "fix: installer form second run"
# a legacy parent that still holds another table or a key is kept
cat > "$tmp/config.toml" <<'T'
version = 3
  [plugins."io.containerd.grpc.v1.cri"]
    x = 1
  [plugins."io.containerd.grpc.v1.cri".containerd.runtimes.sysbox-runc]
    runtime_type = "io.containerd.runc.v2"
  [plugins."io.containerd.grpc.v1.cri".other]
    y = 2
T
runfix; rc=$?
grep -q '^  \[plugins."io.containerd.grpc.v1.cri"\]' "$tmp/config.toml" && grep -q 'grpc.v1.cri".other' "$tmp/config.toml" \
  && grep -q 'cri.v1.runtime".containerd.runtimes.sysbox-runc\]' "$tmp/config.toml" && [ $rc = 0 ] \
  && ok "fix: legacy header with other content is kept" || bad "fix: kept legacy header (rc=$rc)"
# installer form that stays invalid: backup restored
cp "$fx" "$tmp/config.toml"; cp "$fx" "$tmp/orig"
DUMP_OK=0 runfix; rc=$?
[ $rc = 1 ] && cmp -s "$tmp/orig" "$tmp/config.toml" && [ "$(restarts)" = 0 ] && [ ! -e "$tmp/config.toml.tmp" ] \
  && ok "fix: installer form, invalid result: backup restored" || bad "fix: installer form invalid (rc=$rc)"
# the earlier col-0 form, single quotes on the new key
cat > "$tmp/config.toml" <<'T'
version = 3
[plugins.'io.containerd.cri.v1.runtime'.containerd.runtimes.runc]
runtime_type = 'io.containerd.runc.v2'
[plugins.'io.containerd.grpc.v1.cri'.containerd.runtimes.sysbox-runc]
runtime_type = 'io.containerd.runc.v2'
T
runfix; rc=$?
[ $rc = 0 ] && ! grep -q 'grpc.v1.cri' "$tmp/config.toml" && grep -q "^\[plugins.'io.containerd.cri.v1.runtime'.containerd.runtimes.sysbox-runc\]" "$tmp/config.toml" \
  && ok "fix: column-0 legacy form still handled" || bad "fix: col-0 form (rc=$rc)"

# a pre-existing duplicate header makes the rewrite refuse: exit 1, config untouched, no restart
cat > "$tmp/config.toml" <<'T'
version = 3
[plugins."io.containerd.grpc.v1.cri".containerd.runtimes.sysbox-runc]
  runtime_type = "x"
[dup]
[dup]
T
cp "$tmp/config.toml" "$tmp/orig"; runfix; rc=$?
[ $rc = 1 ] && cmp -s "$tmp/orig" "$tmp/config.toml" && [ "$(restarts)" = 0 ] && [ ! -e "$tmp/config.toml.tmp" ] \
  && ok "fix: duplicate header refused, config unchanged" || bad "fix: duplicate header (rc=$rc)"
# sysbox-runc registered in a form the fix does not move: exit 1, config untouched, no restart
cat > "$tmp/config.toml" <<'T'
version = 3
[plugins."other.key".containerd.runtimes.sysbox-runc]
  runtime_type = "x"
T
cp "$tmp/config.toml" "$tmp/orig"; runfix; rc=$?
[ $rc = 1 ] && cmp -s "$tmp/orig" "$tmp/config.toml" && [ "$(restarts)" = 0 ] \
  && ok "fix: unmovable form refused, config unchanged" || bad "fix: unmovable form (rc=$rc)"
# after the restart containerd does not answer: backup restored byte for byte, restarted again, exit 1, no label
cp "$fx" "$tmp/config.toml"; cp "$fx" "$tmp/orig"
DOWN_UNTIL=999 WAIT=2 POLL=1 runfix; rc=$?
[ $rc = 1 ] && cmp -s "$tmp/orig" "$tmp/config.toml" && [ "$(restarts)" = 2 ] && ! grep -q label "$tmp/log" \
  && ok "fix: containerd down after restart: backup restored, restarted again, exit 1" || bad "fix: rollback after restart (rc=$rc)"
mk="$tmp/config.toml.sysbox-fix.failed"
[ "$(sed -n 's/^count=//p' "$mk")" = 1 ] && ok "fix: first failure writes the marker with count 1" || bad "fix: marker count 1"
# second failure: count 2
DOWN_UNTIL=999 WAIT=2 POLL=1 runfix; rc=$?
[ $rc = 1 ] && [ "$(sed -n 's/^count=//p' "$mk")" = 2 ] && cmp -s "$tmp/orig" "$tmp/config.toml" && ok "fix: second failure: count 2, backup restored" || bad "fix: marker count 2 (rc=$rc)"
# third start: nothing touched, exits (ONCE) with 4, no restart, no label
runfix; rc=$?
[ $rc = 4 ] && cmp -s "$tmp/orig" "$tmp/config.toml" && [ "$(restarts)" = 0 ] && ! grep -q label "$tmp/log" \
  && ok "fix: at the cap: no edit, no restart, no label, idles" || bad "fix: cap (rc=$rc)"
# a corrupt marker counts as the cap
echo garbage > "$mk"; runfix; rc=$?
[ $rc = 4 ] && [ "$(restarts)" = 0 ] && cmp -s "$tmp/orig" "$tmp/config.toml" && ok "fix: corrupt marker fails closed" || bad "fix: corrupt marker (rc=$rc)"
# below the cap, a healthy restart succeeds and removes the marker
printf 'count=1\ntime=x\n' > "$mk"; runfix; rc=$?
[ $rc = 0 ] && [ ! -e "$mk" ] && [ "$(restarts)" = 1 ] && ok "fix: success removes the marker" || bad "fix: marker removal (rc=$rc)"
rm -f "$mk"; cp "$fx" "$tmp/config.toml"
# containerd answers but the node is not Ready: same rollback
printf '#!/bin/sh\nexit 1\n' > "$tmp/notready"; chmod +x "$tmp/notready"
cp "$fx" "$tmp/config.toml"
READY_CMD="$tmp/notready" WAIT=2 POLL=1 runfix; rc=$?
[ $rc = 1 ] && cmp -s "$tmp/orig" "$tmp/config.toml" && [ "$(restarts)" = 2 ] && ! grep -q label "$tmp/log" \
  && ok "fix: node not Ready after restart: backup restored, exit 1" || bad "fix: not-Ready rollback (rc=$rc)"
rm -f "$mk"
# already-correct config but containerd dead, or the node not Ready: not labelled, no restart, config unchanged, exit 1
cp "$fx" "$tmp/config.toml"; runfix >/dev/null 2>&1; rm -f "$mk"; cp "$tmp/config.toml" "$tmp/after_ok"
CTR_DOWN=1 WAIT=2 POLL=1 runfix; rc=$?
[ $rc = 1 ] && cmp -s "$tmp/after_ok" "$tmp/config.toml" && ! grep -q '^label' "$tmp/log" && [ "$(restarts)" = 0 ] \
  && ok "fix: already right but containerd not answering: not labelled, exit 1" || bad "fix: no-op, containerd dead (rc=$rc)"
READY_CMD="$tmp/notready" WAIT=2 POLL=1 runfix; rc=$?
[ $rc = 1 ] && cmp -s "$tmp/after_ok" "$tmp/config.toml" && ! grep -q '^label' "$tmp/log" && [ "$(restarts)" = 0 ] \
  && ok "fix: already right but node not Ready: not labelled, exit 1" || bad "fix: no-op, node not Ready (rc=$rc)"
# (a) the restart itself returns non-zero: rollback runs, backup restored byte for byte, marker, exit 1, no label
cp "$fx" "$tmp/config.toml"; rm -f "$mk"
RESTART_FAIL_ON=1 WAIT=2 POLL=1 runfix; rc=$?
[ $rc = 1 ] && cmp -s "$tmp/orig" "$tmp/config.toml" && [ "$(sed -n 's/^count=//p' "$mk")" = 1 ] && ! grep -q label "$tmp/log" && [ "$(restarts)" = 2 ] \
  && ok "fix: restart returns non-zero: rolled back, marker count 1, no label" || bad "fix: failed restart (rc=$rc)"
# (c) containerd answers late (after 2 polls, within WAIT): passes, labelled once, no marker
cp "$fx" "$tmp/config.toml"; rm -f "$mk"
DOWN_UNTIL=2 WAIT=10 POLL=1 runfix; rc=$?
[ $rc = 0 ] && [ "$(grep -c '^label' "$tmp/log")" = 1 ] && [ "$(restarts)" = 1 ] && [ ! -e "$mk" ] && ! grep -q 'grpc.v1.cri' "$tmp/config.toml" \
  && ok "fix: containerd answers late within WAIT: kept, labelled once" || bad "fix: late answer (rc=$rc)"
# M2: the saved copy is gone, so the restore fails: loud last line, exit 1, no label, no 'restored'
cp "$fx" "$tmp/config.toml"; rm -f "$mk"
: > "$tmp/log"
TMP_LOG="$tmp/log" CFG="$tmp/config.toml" HOST="$tmp/host" LABEL_CMD="$tmp/label" READY_CMD="$tmp/ready" ONCE=1 KILL_BAK=1 DOWN_UNTIL=999 WAIT=2 POLL=1 sh "$tmp/fix.sh" >"$tmp/out" 2>"$tmp/err"; rc=$?
[ $rc = 1 ] && tail -n 1 "$tmp/err" | grep -q '^config restore FAILED: node needs manual repair' && ! grep -qi 'restored,' "$tmp/err" && ! grep -q label "$tmp/log" \
  && ok "fix: restore fails (no saved copy): loud last line, exit 1, no label" || bad "fix: failed restore (rc=$rc)"
# the restored file differs from the saved copy (a truncating cp): detected, same outcome
mkdir -p "$tmp/cpshim"; printf '#!/bin/sh\nfor a; do last=$a; done\ncase "$last" in *.restore.tmp) head -c 10 "$1" > "$last" ;; *) exec /bin/cp "$@" ;; esac\n' > "$tmp/cpshim/cp"; chmod +x "$tmp/cpshim/cp"
: > "$tmp/log"; cp "$fx" "$tmp/config.toml"; rm -f "$mk" "$tmp/config.toml.sysbox-fix.bak"
PATH="$tmp/cpshim:$PATH" TMP_LOG="$tmp/log" CFG="$tmp/config.toml" HOST="$tmp/host" LABEL_CMD="$tmp/label" READY_CMD="$tmp/ready" ONCE=1 DOWN_UNTIL=999 WAIT=2 POLL=1 sh "$tmp/fix.sh" >"$tmp/out" 2>"$tmp/err"; rc=$?
[ $rc = 1 ] && tail -n 1 "$tmp/err" | grep -q '^config restore FAILED: node needs manual repair' && ! grep -q label "$tmp/log" \
  && ok "fix: restored file differs from the saved copy: loud last line, exit 1, no label" || bad "fix: restore mismatch (rc=$rc)"
# the restart after a good restore also fails: loud last line, exit 1, config byte-identical to the original
cp "$fx" "$tmp/config.toml"; rm -f "$mk" "$tmp/config.toml.sysbox-fix.inprogress"  # (a failed restore leaves the flag, by design)
: > "$tmp/log"
TMP_LOG="$tmp/log" CFG="$tmp/config.toml" HOST="$tmp/host" LABEL_CMD="$tmp/label" READY_CMD="$tmp/ready" ONCE=1 RESTART_FAIL_ON="1 2" WAIT=2 POLL=1 sh "$tmp/fix.sh" >"$tmp/out" 2>"$tmp/err"; rc=$?
[ $rc = 1 ] && cmp -s "$tmp/orig" "$tmp/config.toml" && tail -n 1 "$tmp/err" | grep -q 'NOT healthy after the second restart: node needs manual repair' && ! grep -q label "$tmp/log" \
  && ok "fix: restart after the restore fails: loud last line, config restored, exit 1" || bad "fix: second restart fails (rc=$rc)"
rm -f "$mk"; cp "$fx" "$tmp/config.toml"
# --- a killed or stopped run (the in-progress flag, the trap, the recovery at start) ---
ip="$tmp/config.toml.sysbox-fix.inprogress"
# (d) normal success: flag removed, no rollback, one restart
cp "$fx" "$tmp/config.toml"; rm -f "$mk" "$ip"; : > "$tmp/log"
TMP_LOG="$tmp/log" CFG="$tmp/config.toml" HOST="$tmp/host" LABEL_CMD="$tmp/label" READY_CMD="$tmp/ready" ONCE=1 WAIT=2 POLL=1 sh "$tmp/fix.sh" >"$tmp/out" 2>"$tmp/err"; rc=$?
[ $rc = 0 ] && [ ! -e "$ip" ] && [ "$(restarts)" = 1 ] && ! grep -q 'rolling back' "$tmp/err" && grep -q label "$tmp/log" \
  && ok "fix: success removes the in-progress flag, fires no rollback" || bad "fix: success flag (rc=$rc)"
# (e) a normal rollback is not repeated by the exit trap: exactly two restarts, one rollback message, flag gone
cp "$fx" "$tmp/config.toml"; rm -f "$mk" "$ip"; : > "$tmp/log"
TMP_LOG="$tmp/log" CFG="$tmp/config.toml" HOST="$tmp/host" LABEL_CMD="$tmp/label" READY_CMD="$tmp/ready" ONCE=1 DOWN_UNTIL=999 WAIT=2 POLL=1 sh "$tmp/fix.sh" >"$tmp/out" 2>"$tmp/err"; rc=$?
[ $rc = 1 ] && [ "$(restarts)" = 2 ] && [ "$(grep -c 'rolling back' "$tmp/err")" = 1 ] && [ ! -e "$ip" ] && cmp -s "$tmp/orig" "$tmp/config.toml" \
  && ok "fix: normal rollback is not repeated by the trap (2 restarts, 1 rollback)" || bad "fix: double rollback (rc=$rc restarts=$(restarts))"
# (a, b) SIGTERM / SIGINT during the first wait: the trap restores byte for byte, restarts, checks, exits non-zero, no label
for sig in TERM INT; do
  cp "$fx" "$tmp/config.toml"; rm -f "$mk" "$ip"; : > "$tmp/log"
  # a non-interactive shell starts background jobs with INT ignored: re-enable it, as a pod's PID 1 has it
  TMP_LOG="$tmp/log" CFG="$tmp/config.toml" HOST="$tmp/host" LABEL_CMD="$tmp/label" READY_CMD="$tmp/ready" ONCE=1 DOWN_UNTIL=999 WAIT=30 POLL=1 \
    sh -c 'trap - INT; exec sh "$0"' "$tmp/fix.sh" >"$tmp/out" 2>"$tmp/err" &
  pid=$!; i=0
  while ! grep -q 'ctr version' "$tmp/log" && [ $i -lt 200 ]; do sleep 0.1; i=$((i + 1)); done
  [ $i -lt 200 ] || { bad "fix: SIG$sig test: the first probe never started"; kill -9 $pid; }
  kill -$sig $pid; wait $pid; rc=$?
  [ $rc != 0 ] && cmp -s "$tmp/orig" "$tmp/config.toml" && [ "$(restarts)" = 2 ] && ! grep -q label "$tmp/log" && [ ! -e "$ip" ] \
    && [ "$(sed -n 's/^count=//p' "$mk")" = 1 ] && grep -q 'rolling back' "$tmp/err" && [ "$(grep -c 'ctr version' "$tmp/log")" -ge 2 ] \
    && ok "fix: SIG$sig in the first wait: trap restores byte for byte, restarts, health check, non-zero, no label" || bad "fix: SIG$sig trap (rc=$rc restarts=$(restarts))"
done
# a failing label command after a healthy restart: no rollback, config stays new, exit non-zero, flag gone, loud line
printf '#!/bin/sh\necho label >> "$TMP_LOG"\nexit 1\n' > "$tmp/labelfail"; chmod +x "$tmp/labelfail"
cp "$fx" "$tmp/config.toml"; rm -f "$mk" "$ip"; : > "$tmp/log"
TMP_LOG="$tmp/log" CFG="$tmp/config.toml" HOST="$tmp/host" LABEL_CMD="$tmp/labelfail" READY_CMD="$tmp/ready" ONCE=1 WAIT=2 POLL=1 sh "$tmp/fix.sh" >"$tmp/out" 2>"$tmp/err"; rc=$?
[ $rc = 1 ] && ! grep -q 'grpc.v1.cri' "$tmp/config.toml" && [ "$(restarts)" = 1 ] && [ ! -e "$ip" ] && ! grep -q 'rolling back' "$tmp/err" && grep -q 'runtime healthy but the label could not be set' "$tmp/err" \
  && ok "fix: label fails: no rollback, config stays new, exit non-zero, loud line" || bad "fix: label failure (rc=$rc restarts=$(restarts))"
# SIGTERM during the label command: the healthy runtime and the new config are kept, no second restart
printf '#!/bin/sh\necho label >> "$TMP_LOG"\nsleep 3\n' > "$tmp/labelslow"; chmod +x "$tmp/labelslow"
cp "$fx" "$tmp/config.toml"; rm -f "$mk" "$ip"; : > "$tmp/log"
TMP_LOG="$tmp/log" CFG="$tmp/config.toml" HOST="$tmp/host" LABEL_CMD="$tmp/labelslow" READY_CMD="$tmp/ready" ONCE=1 WAIT=2 POLL=1 sh "$tmp/fix.sh" >"$tmp/out" 2>"$tmp/err" &
pid=$!; i=0
while ! grep -q '^label' "$tmp/log" && [ $i -lt 200 ]; do sleep 0.1; i=$((i + 1)); done
[ $i -lt 200 ] || { bad "fix: label-window test: the label never started"; kill -9 $pid; }
kill -TERM $pid; wait $pid; rc=$?
[ $rc != 0 ] && ! grep -q 'grpc.v1.cri' "$tmp/config.toml" && [ "$(restarts)" = 1 ] && [ ! -e "$ip" ] && ! grep -q 'rolling back' "$tmp/err" \
  && ok "fix: SIGTERM during labelling: healthy runtime and new config kept, no rollback" || bad "fix: TERM in the label window (rc=$rc restarts=$(restarts))"
rm -f "$mk" "$ip"
# a rollback that cannot restore health sets the cap at once, keeps the flag, exits once; the next start touches nothing
cp "$fx" "$tmp/config.toml"; rm -f "$mk" "$ip"
RESTART_FAIL_ON="1 2" WAIT=2 POLL=1 runfix; rc=$?
[ $rc = 1 ] && [ "$(sed -n 's/^count=//p' "$mk")" = 2 ] && [ -e "$ip" ] \
  && ok "fix: rollback cannot restore health: marker set to the cap, flag kept, exit 1" || bad "fix: unhealthy after rollback (rc=$rc)"
runfix; rc=$?
[ $rc = 4 ] && [ "$(restarts)" = 0 ] && [ -e "$ip" ] && ! grep -q label "$tmp/log" && [ "$(sed -n 's/^count=//p' "$mk")" = 2 ] \
  && ok "fix: next start at the cap: no recovery, no restart, flag kept, idles" || bad "fix: next start after unrecoverable (rc=$rc restarts=$(restarts))"
# the same with a failed restore (no saved copy)
cp "$fx" "$tmp/config.toml"; rm -f "$mk" "$ip"
KILL_BAK=1 DOWN_UNTIL=999 WAIT=2 POLL=1 runfix; rc=$?
[ $rc = 1 ] && [ "$(sed -n 's/^count=//p' "$mk")" = 2 ] && [ -e "$ip" ] && ok "fix: failed restore: marker set to the cap, flag kept" || bad "fix: failed restore cap (rc=$rc)"
runfix; rc=$?
