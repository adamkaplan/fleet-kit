#!/usr/bin/env bash
# Tests for cloud/: manifests parse and dry-run, the containerd fix rewrites the legacy
# stanza (and is idempotent), and the secret scan finds a planted secret and passes clean.
set -u
here=$(cd "$(dirname "$0")/.." && pwd); fail=0
ok() { echo "ok   $1"; }; bad() { echo "FAIL $1"; fail=1; }

# 1. manifests
if command -v kubectl >/dev/null; then
  # `apply --dry-run=client` needs a reachable API server for discovery; with none, fall back to an
  # offline parse (`label --local`) so the check still runs with no cluster.
  for f in "$here"/k8s/*.yaml; do
    if kubectl apply --dry-run=client --validate=false -f "$f" -o name >/dev/null 2>&1; then ok "apply --dry-run=client $(basename "$f")"
    elif KUBECONFIG=/dev/null kubectl label --local --dry-run=client -f "$f" x=y -o name >/dev/null 2>&1; then ok "offline parse $(basename "$f")"
    else bad "manifest $(basename "$f")"; fi
  done
else echo "skip kubectl not installed"; fi

# 2. the fix script's rewrite, on a legacy-keyed config
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
cat > "$tmp/config.toml" <<'T'
version = 3
[plugins.'io.containerd.cri.v1.runtime'.containerd.runtimes.runc]
  runtime_type = 'io.containerd.runc.v2'
[plugins."io.containerd.grpc.v1.cri".containerd.runtimes.sysbox-runc]
  runtime_type = "io.containerd.runc.v2"
[plugins."io.containerd.grpc.v1.cri".containerd.runtimes.sysbox-runc.options]
  BinaryName = "/usr/bin/sysbox-runc"
T
# run the manifest's own fix.sh against a temp config, with stubbed host and label commands
sed -n '/^  fix.sh: |$/,/^---$/p' "$here/k8s/containerd-fix.yaml" | sed '1d;$d' | sed 's/^    //' > "$tmp/fix.sh"
cat > "$tmp/host" <<'H'
#!/bin/sh
echo "$@" >> "$TMP_LOG"
case "$1 $2" in
  "containerd config") [ "${DUMP_OK:-1}" = 1 ] && cat "$CFG" || exit 1 ;;
esac
H
printf '#!/bin/sh
echo label >> "$TMP_LOG"
' > "$tmp/label"; chmod +x "$tmp/host" "$tmp/label"
runfix() { : > "$tmp/log"; TMP_LOG="$tmp/log" CFG="$tmp/config.toml" HOST="$tmp/host" LABEL_CMD="$tmp/label" ONCE=1 sh "$tmp/fix.sh" >/dev/null 2>&1; }
restarts() { grep -c 'systemctl restart containerd' "$tmp/log" || true; }

runfix; rc=$?
[ $rc = 0 ] && ! grep -q "grpc.v1.cri" "$tmp/config.toml" && [ "$(restarts)" = 1 ] && grep -q label "$tmp/log" \
  && ok "fix: legacy stanza moved, containerd restarted once, node labelled" || bad "fix: legacy stanza (rc=$rc)"
cp "$tmp/config.toml" "$tmp/after1"
runfix; rc=$?
[ $rc = 0 ] && cmp -s "$tmp/after1" "$tmp/config.toml" && [ "$(restarts)" = 0 ] \
  && ok "fix: already right is a no-op, no restart" || bad "fix: not idempotent (rc=$rc)"
# invalid config: backup restored, exit non-zero
cat > "$tmp/config.toml" <<'T'
[plugins."io.containerd.grpc.v1.cri".containerd.runtimes.sysbox-runc]
  runtime_type = "x"
T
cp "$tmp/config.toml" "$tmp/orig"
DUMP_OK=0 runfix; rc=$?
[ $rc = 1 ] && cmp -s "$tmp/orig" "$tmp/config.toml" && [ "$(restarts)" = 0 ] \
  && ok "fix: invalid config restored, no restart, exit 1" || bad "fix: invalid path (rc=$rc)"
# installer stanza absent: waits (exit 3 under ONCE)
printf 'version = 3\n' > "$tmp/config.toml"
runfix; rc=$?
[ $rc = 3 ] && [ "$(restarts)" = 0 ] && ok "fix: waits when sysbox-runc is not registered" || bad "fix: absent stanza (rc=$rc)"

# the installer's real form on a managed node: indented headers, the sysbox tables under the legacy
# key beside the real runtimes under the new key, empty legacy parents
fx="$here/tests/fixtures/containerd-aks-installer-form.toml"
keep() { grep -E 'runtimes\.(runc|untrusted)|cri\.v1\.images|^\[metrics\]|0\.0\.0\.0|pause|certs\.d|azure/aks|runc"|SystemdCgroup|BinaryName = "/usr/bin/runc"' "$1" | grep -v sysbox; }
cp "$fx" "$tmp/config.toml"; keep "$tmp/config.toml" > "$tmp/keep.before"
runfix; rc=$?
nh() { grep -E '^[[:space:]]*\[' "$tmp/config.toml" | sort | uniq -d | wc -l | tr -d ' '; }
[ $rc = 0 ] && ! grep -q 'grpc.v1.cri' "$tmp/config.toml" \
  && grep -q '^        \[plugins."io.containerd.cri.v1.runtime".containerd.runtimes.sysbox-runc\]' "$tmp/config.toml" \
  && grep -q 'runtimes.sysbox-runc.options\]' "$tmp/config.toml" && [ "$(nh)" = 0 ] \
  && [ "$(tail -c1 "$tmp/config.toml" | od -An -c | tr -d ' ')" = '\n' ] && [ ! -e "$tmp/config.toml.tmp" ] \
  && [ "$(restarts)" = 1 ] && ok "fix: installer form: sysbox-runc moved, legacy parents gone, no duplicate header" || bad "fix: installer form (rc=$rc)"
keep "$tmp/config.toml" | cmp -s - "$tmp/keep.before" && ok "fix: installer form: runc/untrusted/images/metrics lines unchanged" || bad "fix: other stanzas changed"
cp "$tmp/config.toml" "$tmp/after2"; runfix; rc=$?
[ $rc = 0 ] && cmp -s "$tmp/after2" "$tmp/config.toml" && [ "$(restarts)" = 0 ] && ok "fix: installer form: second run changes nothing" || bad "fix: installer form second run"
# a legacy parent that still holds another table or a key is kept
cat > "$tmp/config.toml" <<'T'
  [plugins."io.containerd.grpc.v1.cri"]
    x = 1
  [plugins."io.containerd.grpc.v1.cri".containerd.runtimes.sysbox-runc]
    runtime_type = "io.containerd.runc.v2"
  [plugins."io.containerd.grpc.v1.cri".other]
    y = 2
T
runfix; rc=$?
grep -q '^  \[plugins."io.containerd.grpc.v1.cri"\]' "$tmp/config.toml" && grep -q 'grpc.v1.cri".other' "$tmp/config.toml" \
  && grep -q 'cri.v1.runtime".containerd.runtimes.sysbox-runc\]' "$tmp/config.toml" && [ $rc = 0 ] \
  && ok "fix: legacy header with other content is kept" || bad "fix: kept legacy header (rc=$rc)"
# installer form that stays invalid: backup restored
cp "$fx" "$tmp/config.toml"; cp "$fx" "$tmp/orig"
DUMP_OK=0 runfix; rc=$?
[ $rc = 1 ] && cmp -s "$tmp/orig" "$tmp/config.toml" && [ "$(restarts)" = 0 ] && [ ! -e "$tmp/config.toml.tmp" ] \
  && ok "fix: installer form, invalid result: backup restored" || bad "fix: installer form invalid (rc=$rc)"
# the earlier col-0 form, single quotes on the new key
cat > "$tmp/config.toml" <<'T'
[plugins.'io.containerd.cri.v1.runtime'.containerd.runtimes.runc]
runtime_type = 'io.containerd.runc.v2'
[plugins.'io.containerd.grpc.v1.cri'.containerd.runtimes.sysbox-runc]
runtime_type = 'io.containerd.runc.v2'
T
runfix; rc=$?
[ $rc = 0 ] && ! grep -q 'grpc.v1.cri' "$tmp/config.toml" && grep -q "^\[plugins.'io.containerd.cri.v1.runtime'.containerd.runtimes.sysbox-runc\]" "$tmp/config.toml" \
  && ok "fix: column-0 legacy form still handled" || bad "fix: col-0 form (rc=$rc)"

# a pre-existing duplicate header makes the rewrite refuse: exit 1, config untouched, no restart
cat > "$tmp/config.toml" <<'T'
[plugins."io.containerd.grpc.v1.cri".containerd.runtimes.sysbox-runc]
  runtime_type = "x"
[dup]
[dup]
T
cp "$tmp/config.toml" "$tmp/orig"; runfix; rc=$?
[ $rc = 1 ] && cmp -s "$tmp/orig" "$tmp/config.toml" && [ "$(restarts)" = 0 ] && [ ! -e "$tmp/config.toml.tmp" ] \
  && ok "fix: duplicate header refused, config unchanged" || bad "fix: duplicate header (rc=$rc)"
# sysbox-runc registered in a form the fix does not move: exit 1, config untouched, no restart
cat > "$tmp/config.toml" <<'T'
[plugins."other.key".containerd.runtimes.sysbox-runc]
  runtime_type = "x"
T
cp "$tmp/config.toml" "$tmp/orig"; runfix; rc=$?
[ $rc = 1 ] && cmp -s "$tmp/orig" "$tmp/config.toml" && [ "$(restarts)" = 0 ] \
  && ok "fix: unmovable form refused, config unchanged" || bad "fix: unmovable form (rc=$rc)"
# the worker's activity reader (stub server, no network)
nice python3 -m unittest discover -s "$here/worker/tests" -p 'test_*.py' >"$tmp/ut" 2>&1 \
  && ok "worker activity reader tests" || { bad "worker activity reader tests"; tail -20 "$tmp/ut"; }

# 3. secret scan on a directory
mkdir "$tmp/clean" "$tmp/dirty"; echo "hello" > "$tmp/clean/a.txt"
printf 'GH_TOKEN=%s\n' "ghp_$(printf 'a%.0s' $(seq 36))" > "$tmp/dirty/env"
"$here/worker/scan-secrets.sh" --dir "$tmp/clean" >/dev/null 2>&1 && ok "clean dir: 0 hits" || bad "clean dir"
out=$("$here/worker/scan-secrets.sh" --dir "$tmp/dirty" 2>&1); rc=$?
[ "$rc" = 1 ] && ok "planted token: fails" || bad "planted token rc=$rc"
mkdir "$tmp/key"; printf -- '-----BEGIN OPENSSH PRIVATE KEY-----\nabc\n' > "$tmp/key/k"
"$here/worker/scan-secrets.sh" --dir "$tmp/key" >/dev/null 2>&1 && bad "private key passed" || ok "private key fails"
echo "$out" | grep -q 'ghp_' && bad "scan printed the value" || ok "scan never prints the value"

# 3b. a layer that cannot be extracted is an error (exit 2), never a pass
mkdir "$tmp/stub" "$tmp/fake"; echo '[{"Layers":["l/layer.tar"]}]' > "$tmp/fake/manifest.json"
mkdir "$tmp/fake/l"; echo "not a tar" > "$tmp/fake/l/layer.tar"
(cd "$tmp/fake" && tar -cf "$tmp/fake.tar" manifest.json l)
printf '#!/bin/sh\ncp "%s" "$4"\n' "$tmp/fake.tar" > "$tmp/stub/docker"; chmod +x "$tmp/stub/docker"
PATH="$tmp/stub:$PATH" "$here/worker/scan-secrets.sh" any:image >/dev/null 2>&1; rc=$?
[ "$rc" = 2 ] && ok "unreadable layer: exit 2, not a pass" || bad "unreadable layer rc=$rc"

# 4. image scan, only when docker is up
if docker info >/dev/null 2>&1; then
  printf 'FROM busybox\nRUN echo "GITHUB_TOKEN=ghp_%s" > /t\n' "$(printf 'b%.0s' $(seq 36))" > "$tmp/Dockerfile"
  printf 'FROM busybox\nRUN echo hi > /t\n' > "$tmp/Dockerfile.clean"
  # a secret written in one layer and deleted in the next must still be found
  printf 'FROM busybox\nRUN echo "GITHUB_TOKEN=ghp_%s" > /t\nRUN rm /t\n' "$(printf 'c%.0s' $(seq 36))" > "$tmp/Dockerfile.deleted"
  # a secret in the image env
  printf 'FROM busybox\nENV GH_TOKEN=ghp_%s\n' "$(printf 'd%.0s' $(seq 36))" > "$tmp/Dockerfile.env"
  # build every image; a failed build is a test failure, never a pass
  cp "$tmp/Dockerfile" "$tmp/Dockerfile.baked"
  built=1
  for v in baked deleted env clean; do
    docker build -q -t "cw-scan-$v" -f "$tmp/Dockerfile.$v" "$tmp" >/dev/null 2>&1 || { bad "image build failed: $v"; built=0; }
  done
  if [ $built = 1 ]; then
    # secret images: exit exactly 1 and the report names the pattern
    for v in baked deleted env; do
      out=$("$here/worker/scan-secrets.sh" "cw-scan-$v" 2>&1); rc=$?
      [ "$rc" = 1 ] && echo "$out" | grep -q 'github-token\|generic-token-assignment' \
        && ok "image with secret ($v): exit 1 and pattern named" || bad "image with secret ($v) rc=$rc"
    done
    "$here/worker/scan-secrets.sh" cw-scan-clean >/dev/null 2>&1 && ok "clean image: 0 hits" || bad "clean image"
  fi
  docker rmi cw-scan-baked cw-scan-deleted cw-scan-env cw-scan-clean >/dev/null 2>&1
else
  [ "${CLOUD_TEST_SKIP_DOCKER:-0}" = 1 ] && echo "skip docker not running (CLOUD_TEST_SKIP_DOCKER=1)" || bad "docker is required for the image-scan cases (set CLOUD_TEST_SKIP_DOCKER=1 to skip)"
fi
[ $fail = 0 ] && echo "RESULT: PASS" || { echo "RESULT: FAIL"; exit 1; }
