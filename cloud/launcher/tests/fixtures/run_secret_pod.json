{
 "apiVersion": "v1",
 "kind": "Pod",
 "metadata": {
  "annotations": {
   "cw/hard-deadline": "2026-10-14T15:00:00Z",
   "cw/idle-seconds": "600",
   "cw/max-hard": "2026-10-14T20:00:00Z",
   "cw/run-id": "0123456789abcdef",
   "cw/shape": "S",
   "cw/started": "2026-10-14T12:00:00Z",
   "cw/worker": "coder7"
  },
  "labels": {
   "app": "cw-worker",
   "azure.workload.identity/use": "true",
   "cw/worker": "coder7"
  },
  "name": "coder7-ffda"
 },
 "spec": {
  "activeDeadlineSeconds": 29100,
  "automountServiceAccountToken": false,
  "containers": [
   {
    "env": [
     {
      "name": "CW_WORKER",
      "value": "coder7"
     },
     {
      "name": "CW_REPO",
      "value": "acme-org/widget-service"
     },
     {
      "name": "CW_BRANCH",
      "value": "main"
     },
     {
      "name": "CW_IDLE_SECONDS",
      "value": "600"
     },
     {
      "name": "CW_HARD_DEADLINE",
      "value": "2026-10-14T15:00:00Z"
     },
     {
      "name": "CW_AUDIT_RUNTIME_ID",
      "value": "pod/coder7-ffda"
     }
    ],
    "image": "registry.example.internal/worker:1",
    "name": "worker",
    "readinessProbe": {
     "tcpSocket": {
      "port": 4096
     }
    },
    "resources": {
     "limits": {
      "cpu": "2",
      "memory": "4Gi"
     }
    },
    "securityContext": {
     "allowPrivilegeEscalation": false,
     "capabilities": {
      "drop": [
       "ALL"
      ]
     }
    },
    "volumeMounts": [
     {
      "mountPath": "/run/cw",
      "name": "pw",
      "readOnly": true
     },
     {
      "mountPath": "/run/cw-tmp",
      "name": "tokens"
     },
     {
      "mountPath": "/work",
      "name": "scratch"
     }
    ]
   }
  ],
  "restartPolicy": "Never",
  "securityContext": {
   "fsGroup": 1000,
   "runAsGroup": 1000,
   "runAsNonRoot": true,
   "runAsUser": 1000,
   "seccompProfile": {
    "type": "RuntimeDefault"
   }
  },
  "serviceAccountName": "cw-worker",
  "volumes": [
   {
    "name": "pw",
    "projected": {
     "defaultMode": 384,
     "sources": [
      {
       "secret": {
        "items": [
         {
          "key": "password",
          "mode": 384,
          "path": "server-password"
         }
        ],
        "name": "coder7-ffda-pw"
       }
      },
      {
       "secret": {
        "items": [
         {
          "key": "git-token",
          "mode": 256,
          "path": "git-token"
         },
         {
          "key": "model-auth",
          "mode": 256,
          "path": "model-auth"
         }
        ],
        "name": "coder7-ffda-run"
       }
      }
     ]
    }
   },
   {
    "emptyDir": {
     "medium": "Memory"
    },
    "name": "tokens"
   },
   {
    "emptyDir": {},
    "name": "scratch"
   }
  ]
 }
}
