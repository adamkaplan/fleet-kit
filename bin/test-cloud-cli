#!/usr/bin/env python3
"""test-cloud-cli: tests for bin/cloud_cli.py against a fake HTTP server on 127.0.0.1; one mutant per rule.

    bin/test-cloud-cli
"""
import contextlib
import http.server
import io
import json
import os
import subprocess
import sys
import tempfile
import threading
import types
import unittest
from pathlib import Path

BIN = Path(__file__).resolve().parent
SOURCE = (BIN / "cloud_cli.py").read_text()
SECRET = "tok-SECRET.abc123"


class Handler(http.server.BaseHTTPRequestHandler):
    def do_POST(self):
        n = int(self.headers.get("Content-Length", 0))
        self.server.seen.append({"auth": self.headers.get("Authorization"), "body": json.loads(self.rfile.read(n))})
        code = self.server.code
        data = getattr(self.server, "raw", None) or json.dumps({"error": "nope" if code != 200 else ""}).encode()
        self.send_response(code)
        if 300 <= code < 400:
            self.send_header("Location", self.server.location)
        if getattr(self.server, "truncate", False):
            self.send_header("Transfer-Encoding", "chunked")
            self.end_headers()
            self.wfile.write(b"zz\r\n" + data)
            self.wfile.flush()
            self.close_connection = True
            return
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        self.server.seen.append({"auth": self.headers.get("Authorization"), "body": None})
        self.send_response(200)
        self.send_header("Content-Length", "2")
        self.end_headers()
        self.wfile.write(b"{}")

    def log_message(self, *a):
        pass


class Base(unittest.TestCase):
    def setUp(self):
        self.srv = http.server.HTTPServer(("127.0.0.1", 0), Handler)
        self.srv.seen, self.srv.code = [], 200
        threading.Thread(target=self.srv.serve_forever, daemon=True).start()
        self.addCleanup(self.srv.server_close)
        self.addCleanup(self.srv.shutdown)
        self.tmp = tempfile.TemporaryDirectory()
        self.addCleanup(self.tmp.cleanup)
        self.tok = Path(self.tmp.name) / "token"
        self.tok.write_text(SECRET + "\n")
        self.url = "http://127.0.0.1:%d/send" % self.srv.server_address[1]

    def run_cli(self, args, source=None, **env_over):
        script = Path(self.tmp.name) / "cloud_cli.py"
        script.write_text(source or SOURCE)
        (Path(self.tmp.name) / "cloud_client.py").write_text(getattr(self, "client_source", None) or (BIN / "cloud_client.py").read_text())
        env = {"PATH": os.environ.get("PATH", ""), "FLEET_AGENT_NAME": "worker-a", "FLEET_BOSS": "boss-a",
               "FLEET_CLOUD_CHANNEL_URL": self.url, "FLEET_CLOUD_TOKEN_FILE": str(self.tok)}
        env.update(env_over)
        env = {k: v for k, v in env.items() if v is not None}
        p = subprocess.run([sys.executable, str(script)] + args, env=env, capture_output=True, text=True, timeout=60)
        return p.returncode, p.stdout, p.stderr

    def mutate(self, old, new):
        assert SOURCE.count(old) == 1, old
        return SOURCE.replace(old, new)


class TestCli(Base):
    def test_send_delivers(self):
        code, out, err = self.run_cli(["send", "peer-b", "hello", "there"])
        self.assertEqual((code, out, err), (0, "sent to peer-b\n", ""))
        s = self.srv.seen[0]
        self.assertEqual(s["auth"], "Bearer " + SECRET)
        self.assertEqual(s["body"]["sender"], "worker-a")
        self.assertEqual(s["body"]["recipient"], "peer-b")
        self.assertEqual(s["body"]["text"], "hello there")

    def test_report_goes_to_boss(self):
        code, out, _ = self.run_cli(["report", "done", "all", "green"])
        self.assertEqual((code, out), (0, "reported done to boss-a\n"))
        self.assertEqual(self.srv.seen[0]["body"]["recipient"], "boss-a")
        self.assertEqual(self.srv.seen[0]["body"]["text"], "report: done: all green")

    def test_refusal_exits_1_without_token(self):
        self.srv.code = 403
        code, out, err = self.run_cli(["send", "peer-b", "x"])
        self.assertEqual(code, 1)
        self.assertEqual(len(out.splitlines()), 1)
        self.assertNotIn(SECRET, out + err)
        self.assertNotIn("Traceback", err)

    def test_bad_usage_and_environment_exit_2(self):
        cases = [(["send", "peer-b"], {}), (["bogus", "a", "b"], {}), ([], {}),
                 (["report", "weird", "x"], {}), (["report", "done", "x" * 301], {}),
                 (["send", "p", "x"], {"FLEET_AGENT_NAME": None}),
                 (["report", "done", "x"], {"FLEET_BOSS": None}),
                 (["send", "p", "x"], {"FLEET_CLOUD_CHANNEL_URL": None}),
                 (["send", "p", "x"], {"FLEET_CLOUD_CHANNEL_URL": "ftp://x"})]
        for args, env in cases:
            code, out, err = self.run_cli(args, **env)
            self.assertEqual(code, 2, (args, env, out, err))
            self.assertEqual(len(out.splitlines()), 1)
            self.assertNotIn("Traceback", err)
        self.assertEqual(self.srv.seen, [])

    def test_report_limit_is_300_and_kinds(self):
        self.assertEqual(self.run_cli(["report", "done", "x" * 300])[0], 0)
        for kind in ("failed", "blocked", "question", "working", "paused", "withdrawn"):
            self.assertEqual(self.run_cli(["report", kind, "ok"])[0], 0, kind)

    def test_missing_token_is_one_line(self):
        code, out, err = self.run_cli(["send", "p", "x"], FLEET_CLOUD_TOKEN_FILE="/nonexistent/t")
        self.assertEqual(code, 1)
        self.assertEqual(len(out.splitlines()), 1)
        self.assertNotIn("Traceback", err)


class TestRefusals(Base):
    def one_line_exit_1(self, args=("send", "p", "x"), **env):
        code, out, err = self.run_cli(list(args), **env)
        self.assertEqual(code, 1, (out, err))
        self.assertEqual(len(out.splitlines()), 1)
        self.assertNotIn("Traceback", err)
        self.assertNotIn(SECRET, out + err)

    def test_redirect_is_refused(self):
        other = http.server.HTTPServer(("127.0.0.1", 0), Handler)
        other.seen, other.code = [], 200
        threading.Thread(target=other.serve_forever, daemon=True).start()
        self.addCleanup(other.server_close)
        self.addCleanup(other.shutdown)
        self.srv.code = 302
        self.srv.location = "http://127.0.0.1:%d/steal" % other.server_address[1]
        self.one_line_exit_1()
        self.assertEqual(other.seen, [])

    def test_500_is_one_line(self):
        self.srv.code = 500
        self.one_line_exit_1()

    def test_closed_port(self):
        s = http.server.HTTPServer(("127.0.0.1", 0), Handler)
        port = s.server_address[1]
        s.server_close()
        self.one_line_exit_1(FLEET_CLOUD_CHANNEL_URL="http://127.0.0.1:%d/send" % port)

    def test_non_json_reply(self):
        self.srv.raw = b"<html>oops"
        self.srv.code = 400
        self.one_line_exit_1()

    def test_userinfo_url_is_usage_error(self):
        code, out, _ = self.run_cli(["send", "p", "x"], FLEET_CLOUD_CHANNEL_URL="http://u:p@127.0.0.1:1/send")
        self.assertEqual((code, len(out.splitlines())), (2, 1))
        self.assertEqual(self.srv.seen, [])

    def test_send_text_cap_and_whitespace(self):
        self.assertEqual(self.run_cli(["send", "p", "x" * 2001])[0], 2)
        self.assertEqual(self.run_cli(["send", "p", "x" * 2000])[0], 0)
        self.assertEqual(self.run_cli(["send", "p", "  ", "\t"])[0], 2)
        self.assertEqual(self.run_cli(["report", "done", "   "])[0], 2)

    def test_empty_boss(self):
        self.assertEqual(self.run_cli(["report", "done", "x"], FLEET_BOSS="")[0], 2)
        self.assertEqual(len(self.srv.seen), 0)

    def test_default_token_path_unset(self):
        (Path(self.tmp.name) / "missing").write_text("")
        (Path(self.tmp.name) / "missing").unlink()
        client = (BIN / "cloud_client.py").read_text()
        self.assertEqual(client.count("TOKEN_PATH ="), 1)
        import re
        patched = re.sub(r"^TOKEN_PATH = .*$", "TOKEN_PATH = %r" % str(Path(self.tmp.name) / "missing"), client, flags=re.M)
        self.assertNotEqual(patched, client)
        self.client_source = patched
        self.one_line_exit_1(FLEET_CLOUD_TOKEN_FILE=None)

    def test_malformed_url_is_usage_error(self):
        code, out, err = self.run_cli(["send", "p", "x"], FLEET_CLOUD_CHANNEL_URL="http://[")
        self.assertEqual((code, len(out.splitlines())), (2, 1))
        self.assertNotIn("http://[", out + err)
        self.assertNotIn("Traceback", err)

    def test_error_body_cut_mid_read(self):
        self.srv.code = 500
        self.srv.truncate = True
        self.one_line_exit_1()
        self.assertIn("500", self.run_cli(["send", "p", "x"])[1])


class TestMutants(Base):
    def test_mutant_urlparse_unguarded(self):
        src = self.mutate('''    try:
        parts = urllib.parse.urlparse(url)
    except ValueError:
        return _usage("cloud_cli: FLEET_CLOUD_CHANNEL_URL must be set to an http or https URL")
''', '    parts = urllib.parse.urlparse(url)\n')
        code, _, err = self.run_cli(["send", "p", "x"], source=src, FLEET_CLOUD_CHANNEL_URL="http://[")
        self.assertIn("Traceback", err)

    def test_mutant_error_read_unguarded(self):
        src = self.mutate('''            try:
                raw = err.read(65536)
            except Exception:
                raw = b""
''', '            raw = err.read(65536)\n')
        self.srv.code = 500
        self.srv.truncate = True
        _, out, _ = self.run_cli(["send", "p", "x"], source=src)
        self.assertNotIn("500", out)

    def test_mutant_follows_redirects(self):
        other = http.server.HTTPServer(("127.0.0.1", 0), Handler)
        other.seen, other.code = [], 200
        threading.Thread(target=other.serve_forever, daemon=True).start()
        self.addCleanup(other.server_close)
        self.addCleanup(other.shutdown)
        self.srv.code = 302
        self.srv.location = "http://127.0.0.1:%d/steal" % other.server_address[1]
        src = self.mutate("        return None  # refuse", "        return super().redirect_request(req, fp, code, msg, headers, newurl)  # refuse")
        self.run_cli(["send", "p", "x"], source=src)
        self.assertEqual(len(other.seen), 1)

    def test_mutant_prints_token(self):
        src = self.mutate('        print(done)\n', '        print(done, open(token_path).read())\n')
        _, out, _ = self.run_cli(["send", "p", "x"], source=src)
        self.assertIn(SECRET, out)

    def test_mutant_exit_0_on_refusal(self):
        self.srv.code = 403
        src = self.mutate('    return 1\n', '    return 0\n')
        self.assertEqual(self.run_cli(["send", "p", "x"], source=src)[0], 0)

    def test_mutant_ignores_environment_url(self):
        other = http.server.HTTPServer(("127.0.0.1", 0), Handler)
        other.seen, other.code = [], 200
        threading.Thread(target=other.serve_forever, daemon=True).start()
        self.addCleanup(other.server_close)
        self.addCleanup(other.shutdown)
        src = self.mutate('post or make_post(url)', 'post or make_post("http://127.0.0.1:%d/send")' % other.server_address[1])
        self.run_cli(["send", "p", "x"], source=src)
        self.assertEqual(self.srv.seen, [])
        self.assertEqual(len(other.seen), 1)

    def test_mutant_sender_from_command_line(self):
        src = self.mutate('cmd, first, text = args[0], args[1], " ".join(args[2:]).strip()',
                          'cmd, first, text = args[0], args[1], " ".join(args[2:]).strip()\n    env = dict(env, FLEET_AGENT_NAME=first)')
        self.run_cli(["send", "imposter", "x"], source=src)
        self.assertEqual(self.srv.seen[0]["body"]["sender"], "imposter")
        self.assertNotEqual(self.srv.seen[0]["body"]["sender"], "worker-a")


def hmutate(old, new, source=SOURCE):
    assert source.count(old) == 1, old
    out = source.replace(old, new)
    assert out != source
    return out


def load(source=SOURCE):
    module = types.ModuleType("cloud_cli_under_test")
    module.__file__ = str(BIN / "cloud_cli.py")
    exec(compile(source, "cloud_cli.py", "exec"), module.__dict__)
    return module


class Plain(Base):
    def refused_before_any_request(self, source=None, **env):
        code, out, err = self.run_cli(["send", "p", "x"], source=source, FLEET_CLOUD_CHANNEL_URL="http://hub.invalid:9/send", **env)
        return code, out, err

    def test_plain_http_to_a_non_loopback_host_is_refused(self):
        code, out, err = self.refused_before_any_request()
        self.assertEqual(code, 2)
        self.assertEqual(len(out.splitlines()), 1)
        self.assertIn("plain http", out)
        self.assertNotIn(SECRET, out + err)
        self.assertEqual(self.srv.seen, [])

    def test_mutant_plain_http_allowed_is_caught(self):
        source = hmutate('parts.scheme == "http" and not _http_allowed(parts, env)', "False")
        code, out, _ = self.refused_before_any_request(source=source)
        self.assertNotEqual(code, 2)          # the real command stops at 2 with the named line; the mutant tries the host

    def test_named_host_flag_allows_it(self):
        code, out, _ = self.refused_before_any_request(FLEET_CLOUD_ALLOW_HTTP_HOST="hub.invalid")
        self.assertEqual(code, 1)             # allowed: the request is attempted (the name does not resolve), not refused as usage
        self.assertNotIn("plain http", out)
        code, out, _ = self.refused_before_any_request(FLEET_CLOUD_ALLOW_HTTP_HOST="other.invalid")
        self.assertEqual(code, 2)

    def test_mutant_flag_ignored_is_caught(self):
        source = hmutate('env.get("FLEET_CLOUD_ALLOW_HTTP_HOST", "")', '""')
        code, _, _ = self.refused_before_any_request(source=source, FLEET_CLOUD_ALLOW_HTTP_HOST="hub.invalid")
        self.assertEqual(code, 2)             # the mutant refuses a named host

    def test_https_and_loopback_pass_the_rule(self):
        module = load()
        for url, ok in (("http://127.0.0.1:1/x", True), ("http://[::1]:1/x", True), ("http://localhost/x", True),
                        ("http://a.ns.svc/x", True), ("http://a.ns.svc.cluster.local/x", True), ("http://a.svc.evil.com/x", False), ("http://169.254.169.254/x", False), ("http://2852039166/x", False), ("http://example.com/x", False)):
            self.assertEqual(module._http_allowed(module.urllib.parse.urlparse(url), {}), ok, url)

    def test_empty_netloc_keeps_its_own_message(self):
        code, out, _ = self.run_cli(["send", "p", "x"], FLEET_CLOUD_CHANNEL_URL="http:///x")
        self.assertEqual(code, 2)
        self.assertIn("http or https URL", out)
        source = hmutate(" or not parts.netloc", "")
        code, out, _ = self.run_cli(["send", "p", "x"], source=source, FLEET_CLOUD_CHANNEL_URL="http:///x")
        self.assertNotIn("http or https URL", out)


class Pins(unittest.TestCase):
    def run_main(self, source=SOURCE, argv=("send", "p", "x"), env=None, send=None, post=None):
        module = load(source)
        sent = []

        def fake_send(sender, recipient, text, post_fn, token_path=None, **kw):
            sent.append((sender, token_path))
            return send(sender) if send else (True, "")
        module.cloud_client = types.SimpleNamespace(send=fake_send, report=fake_send, TOKEN_PATH=module.cloud_client.TOKEN_PATH)
        env = dict({"FLEET_AGENT_NAME": "worker-a", "FLEET_CLOUD_CHANNEL_URL": "http://127.0.0.1:1/send"}, **(env or {}))
        buf = io.StringIO()
        with contextlib.redirect_stdout(buf):
            code = module.main(list(argv), env, post=lambda r: {})
        return code, buf.getvalue(), sent

    def test_one_line_output(self):
        code, out, _ = self.run_main(send=lambda s: (False, "first\nsecond"))
        self.assertEqual((code, out), (1, "first\n"))
        code, out, _ = self.run_main(source=hmutate('.splitlines()[0]', ""), send=lambda s: (False, "first\nsecond"))
        self.assertNotEqual(out, "first\n")

    def test_sender_is_stripped(self):
        code, out, sent = self.run_main(env={"FLEET_AGENT_NAME": "  "})
        self.assertEqual((code, sent), (2, []))
        code, out, sent = self.run_main(env={"FLEET_AGENT_NAME": " worker-a "})
        self.assertEqual(sent[0][0], "worker-a")
        source = hmutate('env.get("FLEET_AGENT_NAME", "").strip()', 'env.get("FLEET_AGENT_NAME", "")')
        self.assertNotEqual(self.run_main(source=source, env={"FLEET_AGENT_NAME": " worker-a "})[2][0][0], "worker-a")

    def test_default_token_path_is_pinned(self):
        self.assertEqual(load().cloud_client.TOKEN_PATH, "/var/run/secrets/tokens/fleet-switchboard")
        self.assertEqual(self.run_main()[2][0][1], "/var/run/secrets/tokens/fleet-switchboard")
        source = hmutate("env.get(\"FLEET_CLOUD_TOKEN_FILE\") or cloud_client.TOKEN_PATH", "env.get(\"FLEET_CLOUD_TOKEN_FILE\") or '/elsewhere'")
        self.assertNotEqual(self.run_main(source=source)[2][0][1], "/var/run/secrets/tokens/fleet-switchboard")

    def test_timeout_is_ten_seconds(self):
        self.assertEqual(load().TIMEOUT, 10)


class Wire(unittest.TestCase):
    """The real post function against a loopback server."""

    def serve(self, handler):
        srv = http.server.HTTPServer(("127.0.0.1", 0), handler)
        srv.seen = []
        threading.Thread(target=srv.serve_forever, daemon=True).start()
        self.addCleanup(srv.server_close)
        self.addCleanup(srv.shutdown)
        return srv, "http://127.0.0.1:%d/send" % srv.server_address[1]

    def request(self):
        return {"authorization": "Bearer " + SECRET, "body": {"sender": "a", "recipient": "b", "key": "k", "text": "t"}}

    def test_content_type_is_json(self):
        class H(http.server.BaseHTTPRequestHandler):
            def do_POST(self):
                self.server.seen.append(self.headers.get("Content-Type"))
                self.rfile.read(int(self.headers["Content-Length"]))
                self.send_response(200)
                self.send_header("Content-Length", "2")
                self.end_headers()
                self.wfile.write(b"{}")

            def log_message(self, *a):
                pass
        for source, expected in ((SOURCE, "application/json"), (hmutate(', "Content-Type": "application/json"', ""), None)):
            srv, url = self.serve(H)
            load(source).make_post(url)(self.request())
            self.assertEqual(srv.seen == ["application/json"], expected is not None)

    def test_success_body_is_capped(self):
        pad = json.dumps({"delivered": True, "pad": "x" * 200000}).encode()

        class H(http.server.BaseHTTPRequestHandler):
            def do_POST(self):
                self.rfile.read(int(self.headers["Content-Length"]))
                self.send_response(200)
                self.send_header("Content-Length", str(len(pad)))
                self.end_headers()
                self.wfile.write(pad)

            def log_message(self, *a):
                pass
        _, url = self.serve(H)
        self.assertNotIn("pad", load().make_post(url)(self.request()))    # cut at 64 KiB: not valid JSON, so nothing is read from it
        self.assertIn("pad", load(hmutate("answer.read(65536)\n        except urllib.error", "answer.read()\n        except urllib.error"))
                      .make_post(url)(self.request()))

    def test_refusal_shows_the_server_reason(self):
        class H(http.server.BaseHTTPRequestHandler):
            def do_POST(self):
                self.rfile.read(int(self.headers["Content-Length"]))
                data = json.dumps({"reason": "quota used"}).encode()
                self.send_response(403)
                self.send_header("Content-Length", str(len(data)))
                self.end_headers()
                self.wfile.write(data)

            def log_message(self, *a):
                pass
        _, url = self.serve(H)
        self.assertEqual(load().make_post(url)(self.request())["error"], "quota used")
        self.assertNotIn("error", load(hmutate("if status != 200:", "if False:")).make_post(url)(self.request()))

    def test_stalled_server_is_cut_by_the_timeout(self):
        release = threading.Event()
        self.addCleanup(release.set)

        class H(http.server.BaseHTTPRequestHandler):
            def do_POST(self):
                release.wait(30)

            def log_message(self, *a):
                pass
        _, url = self.serve(H)
        tmp = tempfile.TemporaryDirectory()
        self.addCleanup(tmp.cleanup)
        script = Path(tmp.name) / "run.py"

        def run(source):
            (Path(tmp.name) / "cloud_cli.py").write_text(source)
            (Path(tmp.name) / "cloud_client.py").write_text((BIN / "cloud_client.py").read_text())
            script.write_text("import sys; sys.path.insert(0, %r)\nimport cloud_cli\nprint(cloud_cli.make_post(%r)(%r)['status'])\n"
                              % (tmp.name, url, self.request()))
            return subprocess.run([sys.executable, str(script)], capture_output=True, text=True, timeout=6).stdout.strip()
        fast = SOURCE.replace("TIMEOUT = 10\n", "TIMEOUT = 1\n")
        self.assertNotEqual(fast, SOURCE)
        self.assertEqual(run(fast), "0")
        with self.assertRaises(subprocess.TimeoutExpired):
            run(hmutate("timeout=TIMEOUT", "timeout=None", fast))


if __name__ == "__main__":
    result = unittest.main(exit=False).result
    print("RESULT: PASS" if result.wasSuccessful() else "RESULT: FAIL")
    sys.exit(0 if result.wasSuccessful() else 1)
