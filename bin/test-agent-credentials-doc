#!/usr/bin/env python3
"""test-agent-credentials-doc: scans docs/agent-credentials.md (#568, S1, S2, S3, S5, U1). Offline; reads one file.

    bin/test-agent-credentials-doc
"""
import os
import re
import sys
import unittest

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DOC_PATH = os.path.join(ROOT, "docs", "agent-credentials.md")
TOKEN_PATTERNS = [
    r"gh[pousr]_[A-Za-z0-9]{20,}", r"github_pat_[A-Za-z0-9_]{20,}", r"-----BEGIN [A-Z ]*PRIVATE KEY-----",
    r"\bAKIA[0-9A-Z]{16}\b", r"\bxox[baprs]-[A-Za-z0-9-]{10,}", r"\beyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}",
    r"(?i)\b(token|secret|password)\s*[:=]\s*[\"']?[A-Za-z0-9+/_-]{24,}",
]
CRITERIA = ("Cost", "What breaks", "Rotation", "Who merges")


def sections(text):
    """{heading: body} for every `## ` section."""
    parts = re.split(r"(?m)^## (.+)$", text)
    return {parts[i].strip(): parts[i + 1] for i in range(1, len(parts) - 1, 2)}


class DocTest(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        with open(DOC_PATH, encoding="utf-8") as handle:
            cls.text = handle.read()
        cls.sections = sections(cls.text)

    def test_inventory_has_at_least_four_paths_with_scope_and_admin(self):
        body = self.sections["Inventory of credential paths"]
        rows = [r for r in body.splitlines() if re.match(r"\|\s*\d+\s*\|", r)]
        self.assertGreaterEqual(len(rows), 4)
        for row in rows:
            self.assertEqual(len(row.strip().strip("|").split("|")), 5, row[:60])
        low = body.lower()
        for word in ("gh_users", "git", "keyring", "mint"):
            self.assertIn(word, low)

    def test_three_options_on_four_criteria(self):
        body = self.sections["Design: three options"]
        options = re.findall(r"(?m)^### (Option [A-C]):", body)
        self.assertEqual(options, ["Option A", "Option B", "Option C"])
        for chunk in re.split(r"(?m)^### ", body)[1:]:
            rows = [r.split("|")[1].strip() for r in chunk.splitlines() if r.startswith("| ") and not r.startswith("| Criterion")]
            self.assertEqual([r for r in rows if r in CRITERIA], list(CRITERIA), chunk[:30])

    def test_exactly_one_recommendation(self):
        self.assertEqual(len([h for h in self.sections if h.startswith("Recommendation")]), 1)
        self.assertEqual(len(re.findall(r"(?m)^Recommended option:", self.text)), 1)

    def test_migration_rollback_owner_sections(self):
        for name in ("Migration", "Rollback", "The owner's own steps"):
            self.assertIn(name, self.sections)
            self.assertRegex(self.sections[name], r"(?m)^\d+\. ", name)

    def test_agents_create_no_credential(self):
        low = self.text.lower()
        self.assertIn("agents run none of them", low)
        for cmd in ("gh auth login --with-token", "gh auth token <", "gh api -x post", "-x patch"):
            self.assertNotIn(cmd, low)

    def test_no_token_like_string(self):
        for pattern in TOKEN_PATTERNS:
            self.assertIsNone(re.search(pattern, self.text), "token-like text matched pattern #%d" % TOKEN_PATTERNS.index(pattern))

    def test_scanner_discriminates(self):
        planted = "ghp_" + "a" * 36
        self.assertTrue(any(re.search(p, planted) for p in TOKEN_PATTERNS))


if __name__ == "__main__":
    result = unittest.main(exit=False, verbosity=1).result
    ok = result.wasSuccessful()
    print("RESULT: PASS" if ok else "RESULT: FAIL")
    sys.exit(0 if ok else 1)
