#!/usr/bin/env python3
"""cloud-prepush <base>: the last step before every push of a cloud pod. ADVICE ONLY, never the gate.

Why: workers push, then continuous integration finds a failure the worker could have found itself (a test that reads an
edited file, a repository-wide scan of added lines). A pod cannot run the whole suite in reasonable time; this command
replaces the hand-written rule of which tests to pick.

It lists the files changed since the merge base with <base>, selects every test file whose text names a changed file
(basename match) plus the scan tests of SCAN_TESTS, runs each on the branch and on a clean worktree of the base (under the
temporary directory, removed at the end, never forced), and prints only the differences.
An EMPTY change exits 0 before the preflight runs. Exit: 0 no difference; 1 a difference, a test that could not run, or no test selected for a non-empty change; 2 refused input; 3 the quick budget was spent (NOT RUN (budget): not a failing test; see CLOUD_PREFLIGHT_QUICK_TOTAL).
Background: cloud-prepush --background <base> starts the same run detached (per file 300 s, total 7200 s unless
CLOUD_PREPUSH_TIMEOUT / CLOUD_PREPUSH_TOTAL say otherwise), prints the result file and log paths and exits 0 at once;
CLOUD_PREPUSH_RESULT names the result directory. cloud-prepush --read FILE|DIR prints the lines of the foreground run
from result.json: exit 0 finished without a difference, 1 a difference, 4 still running, 2 unreadable.
Continuous integration stays the gate; its result is the only evidence. Uses git and python3 only, local.
"""
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time

# Repository-wide scan tests (one list). Entries that do not exist in a repository are skipped there; --check-list
# verifies that every entry exists in this one.
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
try:
    import cloud_quick  # noqa: E402  (the shared list and selection, bin/cloud_quick.py)
    SCAN_TESTS = cloud_quick.SCAN_TESTS  # (file, selector) pairs; one list for both commands
except ImportError:  # a copy of this script placed alone (an offline test): the whole-file scan of before
    cloud_quick = None
    SCAN_TESTS = [("bin/test-switchboard", None)]
PREFLIGHT_MODE = ["quick"]  # set from CLOUD_PREPUSH_PREFLIGHT (quick by default, or full)
SCAN_SELECTOR = {}  # file -> selector, set by select() for a scan picked only as a scan
# Bounds: CLOUD_PREPUSH_TIMEOUT seconds per test and side (default 120); CLOUD_PREPUSH_TOTAL seconds overall (default 1500).
# A timeout, or a test not reached when the overall deadline expires, counts as "could not run". Invalid value: exit 2.
# The two sides run one after the other, one test at a time (a pod has a hard memory limit): no parallelism.
TIMEOUT = 120
TOTAL = 1500
# The preflight step has its own bound, CLOUD_PREPUSH_PREFLIGHT_TIMEOUT (default 900 s), counted inside the total; the
# per-test bound does not apply to it. It runs serially and prints a progress line at start and every 60 s.
PREFLIGHT_TIMEOUT = 900
# Upper bound of every CLOUD_PREPUSH_* number, in seconds (one day); above it: exit 2.
MAX_SECONDS = 86400
# Memory-heavy tests: never run here (a pod has a hard memory limit); reported as "skipped: memory-heavy" and counted as
# "could not run" (exit 1). Continuous integration runs them. Repository-relative paths, one literal tuple.
HEAVY = ("cloud/worker/tests/test_root_scanner.py",)  # fallback of a lone copy; with the helper, cloud_quick.HEAVY rules
if cloud_quick is not None:
    HEAVY = cloud_quick.HEAVY
BUDGET_STATUS = 3  # the preflight's status for a spent quick budget (see bin/cloud-pr-preflight)
BUDGET_SPENT = [False]
PREFLIGHT = "cloud-pr-preflight"  # found next to this file by path, never through PATH


def positive(name, default):
    raw = os.environ.get(name)
    if raw is None:
        return default
    if not re.fullmatch(r"[0-9]+", raw) or not 1 <= int(raw) <= MAX_SECONDS:
        raise ValueError(name)
    return int(raw)


# Child environment: an allow-list, then a drop of sensitive-looking names. Words built from parts.
_DROP_WORDS = ("TOK" + "EN", "K" + "EY", "SEC" + "RET", "PASS" + "WORD", "CR" + "ED")
_DROP_PREFIX = ("GH_", "GITHUB_", "FLEET_", "CW_", "OPENCODE_", "AZURE_", "AWS_")
_ALLOW = ("PATH", "LANG", "TERM", "PYTHONHASHSEED")


def child_env(tmp):
    env = {}
    for k, v in os.environ.items():
        up = k.upper()
        if any(w in up for w in _DROP_WORDS) or up.startswith(_DROP_PREFIX):
            continue
        if k in _ALLOW or k.startswith("LC_") or k.startswith("CLOUD_PREPUSH_"):
            env[k] = v
    env["HOME"] = tmp
    env["TMPDIR"] = tmp
    env["PYTHONDONTWRITEBYTECODE"] = "1"
    return env


def _term(signum, frame):
    raise KeyboardInterrupt


def kill_group(proc):
    """Kill the whole process group of a child started with start_new_session, then wait."""
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError):
        pass
    try:
        proc.wait()
    except Exception:
        pass


def run_group(cmd, cwd, env, limit, tick=None):
    """Run cmd in its own session; returns (returncode, output, timed_out). The whole group is killed at the end."""
    t0 = time.monotonic()
    with tempfile.TemporaryFile("w+", errors="replace") as outf:
        proc = subprocess.Popen(cmd, cwd=cwd, stdout=outf, stderr=subprocess.STDOUT, env=env, start_new_session=True)
        timed_out = False
        try:
            while proc.poll() is None:
                el = time.monotonic() - t0
                if el >= limit:
                    timed_out = True
                    break
                if tick:
                    tick(el)
                time.sleep(min(0.1, max(0.01, limit - el)))
        finally:
            kill_group(proc)
        outf.seek(0)
        return proc.returncode, outf.read(), timed_out


def git(args, cwd, check=False):
    p = subprocess.run(["git"] + args, cwd=cwd, capture_output=True, text=True)
    if check and p.returncode:
        raise RuntimeError(p.stderr.strip())
    return p


READERS = [0]  # number of reader tests of the last select()
READ_LIST = []  # the reader tests of the last select(), all of them


def _is_test(rel):  # only a fallback of a lone copy without the helper
    base = os.path.basename(rel)
    return rel.startswith("bin/test-") or (base.startswith("test_") and base.endswith(".py") and "tests" in rel.split("/")[:-1])


def select(root, changed):
    tracked = git(["ls-files"], root).stdout.split("\n")
    if cloud_quick is not None:
        reads = cloud_quick.readers(root, tracked, set(changed))
    else:
        reads = cloud_quick_lone_readers(root, tracked, changed)
    READERS[0] = len(reads)
    READ_LIST[:] = reads
    picked = list(reads)
    SCAN_SELECTOR.clear()
    for rel, sel in SCAN_TESTS:
        if os.path.isfile(os.path.join(root, rel)) and rel not in picked:
            picked.append(rel)
            SCAN_SELECTOR[rel] = sel
    return sorted(picked)


def cloud_quick_lone_readers(root, tracked, changed):
    names = {os.path.basename(c) for c in changed}
    out = []
    for rel in tracked:
        if not rel or not _is_test(rel) or not os.path.isfile(os.path.join(root, rel)):
            continue
        try:
            text = open(os.path.join(root, rel), errors="replace").read()
        except OSError:
            continue
        if rel in changed or any(n in text for n in names):
            out.append(rel)
    return out


def run_one(root, rel, tmp, limit):
    path = os.path.join(root, rel)
    if not os.path.isfile(path):
        return ("absent", None)
    cmd = [sys.executable, path] if rel.endswith(".py") else [path]
    if SCAN_SELECTOR.get(rel):
        cmd.append(SCAN_SELECTOR[rel])  # a scan runs one class or method, never the whole suite
    env = child_env(tmp)
    try:
        rc, text, timed_out = run_group(cmd, root, env, limit)
    except OSError as e:
        return ("noRun", str(e))
    if timed_out:
        return ("noRun", "timed out after %ds" % limit)
    if rc in (126, 127):
        return ("noRun", "exit %d" % rc)
    out = text.replace(root, "<root>")
    out = re.sub(r"/tmp/\S+|\b\d+\.\d+s\b|0x[0-9a-f]+", "<x>", out)
    return ("ran", (rc, out[-4000:]))


def preflight(root, base, scratch, limit):
    """Run the neighbouring preflight first. Returns (ok, lines). Cannot run = not ok."""
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), PREFLIGHT)
    if not os.path.isfile(path):
        return False, ["could not run the preflight: " + path + " is missing"]
    env = child_env(scratch)
    env["CLOUD_PREFLIGHT_BASE"] = base  # the preflight takes its base from this variable, never from an option
    if PREFLIGHT_MODE[0] == "quick":
        env["CLOUD_PREFLIGHT_MODE"] = "quick"  # the preflight reads the quick mode from this variable (same as --quick)
    state = {"next": 0}

    def tick(el):
        if el >= state["next"]:
            print("preflight running (%d s of %d)" % (el, limit), file=sys.stderr, flush=True)
            state["next"] += 60

    try:
        rc, text, timed_out = run_group([sys.executable, path], root, env, limit, tick)
    except OSError as e:
        return False, ["could not run the preflight: %s" % e]
    if timed_out:
        return False, ["could not run the preflight: timed out after %ds" % limit]
    lines = text.splitlines()
    if rc == BUDGET_STATUS:
        BUDGET_SPENT[0] = True  # a spent quick budget (not a failing test): the same status 3 is passed on
    if rc != 0:
        return False, lines or ["the preflight exited %d with no output" % rc]
    return True, lines


# ---- the background run: a result file (result.json) written atomically after the start and after every file ----
BACKGROUND_TIMEOUT = 300  # per file, when the run is detached (CLOUD_PREPUSH_TIMEOUT overrides)
BACKGROUND_TOTAL = 7200  # overall, when the run is detached (CLOUD_PREPUSH_TOTAL overrides)
RESULT_VERSION = 1
IN_PROGRESS = "running"  # the result of a side that has started and not ended
REC = [None]


class Recorder:
    def __init__(self, directory, pid=None):
        self.path = os.path.join(directory, "result.json")
        self.doc = {"version": RESULT_VERSION, "pid": pid if pid is not None else os.getpid(), "started": time.time(), "finished": None, "selection": [],
                    "status": "running", "files": [], "notes": [], "exit": None}
        self.write()

    def write(self):
        tmpf = self.path + ".tmp%d" % os.getpid()
        with open(tmpf, "w") as fh:
            json.dump(self.doc, fh)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmpf, self.path)

    def entry(self, rel):
        for f in self.doc["files"]:
            if f["file"] == rel:
                return f
        return None

    def select(self, picked):
        self.doc["selection"] = list(picked)
        self.doc["files"] = [{"file": r, "branch": "not started", "base": "not started", "branch_seconds": None,
                              "base_seconds": None, "kind": None, "text": ""} for r in picked]
        self.write()

    def set(self, rel, **kw):
        e = self.entry(rel)
        if e is not None:
            e.update(kw)
            self.write()

    def note(self, line):
        self.doc["notes"].append(line)

    def finish(self, rc):
        self.doc["exit"] = rc
        self.doc["status"] = "finished"
        self.doc["finished"] = time.time()
        self.write()


def note(line):
    print(line)
    if REC[0]:
        REC[0].note(line)


def side_result(r):
    if r[0] == "noRun":
        return "could not run"
    if r[0] == "absent":
        return "absent"
    return "pass" if r[1][0] == 0 else "fail"


def read_result(arg):
    """--read FILE: print the lines the foreground run prints; 0 finished clean, 1 difference, 4 running, 2 unreadable."""
    path = os.path.join(arg, "result.json") if os.path.isdir(arg) else arg
    try:
        with open(path) as fh:
            doc = json.load(fh)
        files = doc["files"]
        status = doc["status"]
        assert isinstance(files, list) and status in ("running", "finished")
    except (OSError, ValueError, KeyError, AssertionError, TypeError):
        print("cloud-prepush: cannot read the result file " + arg, file=sys.stderr)
        return 2
    for l in doc.get("notes", []):
        print(l)
    for f in files:
        if f.get("kind") in ("diff", "noRun") and f.get("text"):
            print(f["text"])
    for f in files:
        if f.get("kind") == "both_fail":
            print("FAILS ON BOTH SIDES with the same tail (a new failure inside it would hide): " + f["file"])
    if status == "running":
        done = 0
        for f in files:
            if f.get("kind"):
                done += 1
            elif "running" in (f.get("branch"), f.get("base")):
                print("RUNNING %s (%s)" % (f["file"], "branch" if f.get("branch") == "running" else "base"))
        print("cloud-prepush: still running: %d of %d files done" % (done, len(files)))
        return 4
    if files:
        kinds = [f.get("kind") for f in files]
        run = sum(1 for k in kinds if k in ("identical", "both_fail", "diff"))
        same = sum(1 for k in kinds if k in ("identical", "both_fail"))
        print("cloud-prepush: run %d, identical: %d (of which failing on both sides: %d), could not run %d"
              % (run, same, kinds.count("both_fail"), kinds.count("noRun")))
        print("cloud-prepush: advice only; continuous integration stays the gate and its result is the only evidence")
    rc = doc.get("exit")
    return rc if isinstance(rc, int) and rc else 0


def start_background(argv):
    """Start the same run detached: its own session, no stdin, output in run.log beside result.json. Returns at once."""
    directory = os.environ.get("CLOUD_PREPUSH_RESULT")
    if directory:
        os.makedirs(directory, mode=0o700, exist_ok=True)
    else:
        directory = tempfile.mkdtemp(prefix="cloud-prepush-result-")
    directory = os.path.abspath(directory)
    log = os.path.join(directory, "run.log")
    Recorder(directory, pid=0)  # the result file exists when this command returns; the run takes it over at once
    env = dict(os.environ)
    env["CLOUD_PREPUSH_RESULT"] = directory
    with open(os.devnull) as nul, open(log, "ab") as out:
        subprocess.Popen([sys.executable, os.path.abspath(__file__), "--detached"] + argv, cwd=os.getcwd(), env=env,
                         stdin=nul, stdout=out, stderr=out, start_new_session=True, close_fds=True)
    print("result file: " + os.path.join(directory, "result.json"))
    print("log file: " + log)
    return 0


def refuse(msg):
    print("cloud-prepush: refused: " + msg, file=sys.stderr)
    if REC[0]:
        REC[0].note("cloud-prepush: refused: " + msg)
    return 2


def _sibling_needs_helper():
    """True when the preflight next to this script is the real one (it imports cloud_quick)."""
    try:
        with open(os.path.join(os.path.dirname(os.path.abspath(__file__)), "cloud-pr-preflight")) as fh:
            return "cloud_quick" in fh.read()
    except OSError:
        return False


def main(argv):
    if len(argv) == 2 and argv[0] == "--read":
        return read_result(argv[1])
    if len(argv) == 2 and argv[0] == "--background":
        return start_background(argv[1:])
    if len(argv) == 2 and argv[0] == "--detached":  # internal: the detached run itself
        REC[0] = Recorder(os.environ["CLOUD_PREPUSH_RESULT"])
        rc = 2
        try:
            rc = main2(argv[1:], BACKGROUND_TIMEOUT, BACKGROUND_TOTAL)
        finally:
            REC[0].finish(rc)
        return rc
    return main2(argv, TIMEOUT, TOTAL)


def main2(argv, TIMEOUT, TOTAL):
    if cloud_quick is None and _sibling_needs_helper():  # a real install lost its helper (a lone copy or a stub sibling does not)
        print("cloud_quick helper missing", file=sys.stderr)
        return 2
    if argv and argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    if len(argv) == 1 and argv[0] == "--check-list":
        root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
        bad = [s for s, _ in SCAN_TESTS if not os.path.isfile(os.path.join(root, s))]
        for s in bad:
            print("listed scan test missing: " + s)
        return 1 if bad else 0
    if len(argv) != 1:
        return refuse("usage: cloud-prepush <base>")
    base = argv[0]
    if base.startswith("-"):
        return refuse("the base must not start with a dash")
    try:
        TIMEOUT_S = positive("CLOUD_PREPUSH_TIMEOUT", TIMEOUT)
        TOTAL_S = positive("CLOUD_PREPUSH_TOTAL", TOTAL)
        PF_S = positive("CLOUD_PREPUSH_PREFLIGHT_TIMEOUT", PREFLIGHT_TIMEOUT)
        MODE = os.environ.get("CLOUD_PREPUSH_PREFLIGHT", "quick")
        if MODE not in ("quick", "full"):
            return refuse("CLOUD_PREPUSH_PREFLIGHT must be quick or full")
    except ValueError as e:
        return refuse("%s must be a whole number of seconds (1 or more)" % e)
    started = time.monotonic()
    top = git(["rev-parse", "--show-toplevel"], os.getcwd())
    if top.returncode:
        return refuse("not inside a git repository")
    root = top.stdout.strip()
    if git(["rev-parse", "--verify", "--quiet", base + "^{commit}"], root).returncode:
        return refuse("unknown base: " + base)
    mb = git(["merge-base", base, "HEAD"], root)
    if mb.returncode or not mb.stdout.strip():
        return refuse("no merge base with " + base + " (missing history, shallow clone?)")
    if git(["status", "--porcelain", "--untracked-files=all"], root).stdout.strip():
        return refuse("the tree is dirty; it would have to write to it. Commit or remove the changes first")
    mbase = mb.stdout.strip()
    changed = [c for c in git(["diff", "--name-only", mbase, "HEAD"], root).stdout.split("\n") if c]
    if not changed:
        note("cloud-prepush: no changed files since the merge base; nothing to run (advice only)")
        return 0
    tmp = tempfile.mkdtemp(prefix="cloud-prepush-")
    scratch = os.path.join(tmp, "t")  # branch side; the base side has its own, tmp/tb
    os.mkdir(scratch)
    os.mkdir(os.path.join(tmp, "tb"))
    signal.signal(signal.SIGTERM, _term)
    try:
        return stage(root, base, mbase, changed, tmp, scratch, TIMEOUT_S, TOTAL_S, started, PF_S, MODE)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def stage(root, base, mbase, changed, tmp, scratch, TIMEOUT_S, TOTAL_S, started, PF_S, MODE="quick"):
    # Step 1: the preflight of the pod, before any test.
    PREFLIGHT_MODE[0] = MODE
    print("cloud-prepush: preflight mode: " + MODE, file=sys.stderr, flush=True)
    reason = None
    if MODE == "quick" and changed:  # decide "no reader" at once with the preflight's own rule: nothing is started
        select(root, changed)
        if cloud_quick is not None:
            reason = cloud_quick.not_run_reason(READ_LIST, changed)
        elif not READERS[0]:
            reason = "no check reads " + ", ".join(sorted(changed))
    if reason:
        ok, plines = True, []
    else:
        ok, plines = preflight(root, base, scratch, max(1, min(PF_S, int(TOTAL_S - (time.monotonic() - started)))))
    if not ok:
        for l in plines:
            note(l)
        if BUDGET_SPENT[0]:
            note("cloud-prepush: the quick budget was spent (NOT RUN (budget), not a failing test); no test was run (advice only)")
            return BUDGET_STATUS
        note("cloud-prepush: the preflight did not pass; no test was run (advice only)")
        return 1
    if not reason:
        print("cloud-prepush: preflight passed", file=sys.stderr)
    picked = select(root, changed)
    if MODE == "full" and changed and not READERS[0]:
        reason = "no check reads " + ", ".join(sorted(changed))  # full mode: only an empty reader set is a verdict
    if reason:
        note("NOT RUN: " + reason)
        if cloud_quick is not None:
            for line in cloud_quick.cannot_lines(READ_LIST):
                note(line)
    if cloud_quick is not None:
        print("cloud-prepush: %s" % cloud_quick.mode_line(READERS[0], len(changed)), file=sys.stderr)
    if not picked or reason:
        note("cloud-prepush: %d changed file(s) but NO test was selected; this is not a clean result (advice only)" % len(changed))
        return 1
    wt = os.path.join(tmp, "base")
    if git(["worktree", "add", "--detach", wt, mbase], root).returncode:
        return refuse("cannot create the base worktree")
    rec = REC[0]
    if rec:
        rec.select(picked)
    run = same = noRun = 0
    both_fail = []
    diffs = []
    try:
        for i, rel in enumerate(picked, 1):
            if MODE == "quick" and cloud_quick is not None and cloud_quick.cannot_run_quick(rel) and rel in READ_LIST:
                noRun += 1
                diffs.append("NOT RUN: %s cannot run in quick" % rel)
                if rec:
                    rec.set(rel, branch="could not run", base="could not run", kind="noRun", text=diffs[-1])
                continue
            if rel in HEAVY:
                noRun += 1
                diffs.append("skipped: memory-heavy " + rel)
                if rec:
                    rec.set(rel, branch="could not run", base="could not run", kind="noRun", text=diffs[-1])
                continue
            left = TOTAL_S - (time.monotonic() - started)
            if left <= 0:
                noRun += 1
                diffs.append("COULD NOT RUN %s: the overall deadline of %ds expired" % (rel, TOTAL_S))
                if rec:
                    rec.set(rel, branch="could not run", base="could not run", kind="noRun", text=diffs[-1])
                continue
            print("[%d/%d] %s branch" % (i, len(picked), rel), file=sys.stderr, flush=True)
            if rec:
                rec.set(rel, branch=IN_PROGRESS)
            t1 = time.monotonic()
            b = run_one(root, rel, scratch, min(TIMEOUT_S, max(1, int(left))))
            t2 = time.monotonic()
            if rec:
                rec.set(rel, branch=side_result(b), branch_seconds=round(t2 - t1, 1), base=IN_PROGRESS)
            print("[%d/%d] %s base" % (i, len(picked), rel), file=sys.stderr, flush=True)
            left = TOTAL_S - (time.monotonic() - started)
            a = run_one(wt, rel, os.path.join(tmp, "tb"), min(TIMEOUT_S, max(1, int(left)))) if left > 0 else ("noRun", "the overall deadline expired")
            if rec:
                rec.set(rel, base=side_result(a), base_seconds=round(time.monotonic() - t2, 1))
            n0 = len(diffs)
            kind = "identical"
            if b[0] == "noRun" or a[0] == "noRun":
                noRun += 1
                diffs.append("COULD NOT RUN %s: %s" % (rel, b[1] if b[0] == "noRun" else a[1]))
                if rec:
                    rec.set(rel, kind="noRun", text=diffs[-1])
                continue
            run += 1
            if b[0] == "absent":
                same += 1
                if rec:
                    rec.set(rel, kind="identical")
                continue
            if a[0] == "absent":  # new test: only the branch side exists
                if b[1][0] == 0:
                    same += 1
                else:
                    diffs.append("FAILS on the branch (new test, no base side): %s" % rel)
                    kind = "diff"
                if rec:
                    rec.set(rel, kind=kind, text=diffs[-1] if kind == "diff" else "")
                continue
            if b[1] == a[1]:
                same += 1
                if b[1][0] != 0:
                    both_fail.append(rel)
                    kind = "both_fail"
                if rec:
                    rec.set(rel, kind=kind)
                continue
            if b[1][0] != 0 and a[1][0] == 0:
                diffs.append("FAILS on the branch, passes on the base: %s\n%s" % (rel, b[1][1][-600:]))
            else:
                diffs.append("DIFFERS (exit %d branch, %d base): %s\n%s" % (b[1][0], a[1][0], rel, b[1][1][-600:]))
            if rec:
                rec.set(rel, kind="diff", text=diffs[-1])
    finally:
        # never forced: git's own option is not used. If the plain removal is refused, the script's own temporary tree is
        # deleted and the metadata pruned.
        r = git(["worktree", "remove", wt], root)
        if r.returncode:
            shutil.rmtree(wt, ignore_errors=True)
        git(["worktree", "prune"], root)
    for d in diffs:
        print(d)
    for rel in both_fail:
        print("FAILS ON BOTH SIDES with the same tail (a new failure inside it would hide): " + rel)
    print("cloud-prepush: run %d, identical: %d (of which failing on both sides: %d), could not run %d"
          % (run, same, len(both_fail), noRun))
    print("cloud-prepush: advice only; continuous integration stays the gate and its result is the only evidence")
    return 1 if diffs else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
