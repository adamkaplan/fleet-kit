#!/usr/bin/env python3
"""cloud-pr-preflight: check a cloud pull request the way CI will, before the push (ask #1195).

Run at the repository root:  bin/cloud-pr-preflight [--quick]
--quick (ask #1299): section 2 runs only the test files that read a changed file plus the named scans of bin/cloud_quick.py
(each a file and one selector), on the branch and on the clean base; same three sections and exit codes. Default: every file. CLOUD_PREFLIGHT_MODE=quick is the same as --quick (bin/cloud-prepush sets it).
A quick run that selects nothing for a non-empty change fails (never clean).
Offline. Prints three sections; exits 0 when 1 and 2 pass (and no --expect stray file); section 3 only lists edits to justify.
  1. completeness scan of bin/test-cloud-launcher
  2. every test file of cloud/launcher/tests and cloud/worker/tests, one at a time, on the branch and on a clean
     copy of the default branch (made under the system temp dir, removed on every exit path; no git stash, no network,
     nothing written into the repository)
  3. existing test files this branch changes against the default branch (listed for you to justify; it does not change the exit status)
Environment: CLOUD_PREFLIGHT_TIMEOUT (seconds per file, default 120), CLOUD_PREFLIGHT_BASE (default branch ref).
Quick budget: the whole quick run has CLOUD_PREFLIGHT_QUICK_TOTAL seconds (default 240); a spent budget ends with exit status 3 and a final line "NOT RUN (budget): ..." naming each file not run.
"""
import glob, os, shutil, signal, subprocess, sys, tarfile, tempfile, io, time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
try:
    import cloud_quick  # noqa: E402  (the shared quick-mode selection, bin/cloud_quick.py)
except ImportError:  # a lone copy: the full mode works; quick mode fails loudly (never degrades silently)
    cloud_quick = None

TEST_DIRS = ("cloud/launcher/tests", "cloud/worker/tests")
CHAIN = "bin/test-cloud-launcher"
CHAIN_LIST = "bin/test-cloud-launcher.chain"  # the list of chained tests, one entry per line
# files allowed to time out, with the reason (a timeout on any other file fails the command)
TIMEOUT_ALLOW = {
    "test_cloud_pod_deadline.py": "slow (about 26s) and not chained",
    "test_cloud_stop_nonce.py": "slow (about 57s) and not chained",
    "test_reaper_record_family.py": "did not finish in 120s and not chained",
}


def git(*a, cwd=None, raw=False):
    p = subprocess.run(("git",) + a, cwd=cwd, capture_output=True)
    return p.returncode, (p.stdout if raw else p.stdout.decode("utf-8", "replace").strip())


def tests_in(root):
    out = []
    for d in TEST_DIRS:
        out += sorted(glob.glob(os.path.join(root, d, "test_*.py")))
    return [os.path.relpath(p, root) for p in out]


def exceptions_of(text):
    for line in text.splitlines():
        if line.startswith("EXCEPTIONS="):
            val = line.split("=", 1)[1].strip().strip('"').strip("'")
            return {w.split(":", 1)[0] for w in val.split()}
    return set()


CHILD = []


def kill_children():
    for p in CHILD:
        try:
            os.killpg(p.pid, signal.SIGKILL)
        except (OSError, ProcessLookupError):
            pass
    del CHILD[:]


QUICK_TOTAL_DEFAULT = 240  # seconds for the whole quick run (the pre-push command's own tests still fit in a 300 s pod)


def quick_total():
    """CLOUD_PREFLIGHT_QUICK_TOTAL: a positive whole number of seconds; read only by a quick run. ValueError when invalid."""
    raw = os.environ.get("CLOUD_PREFLIGHT_QUICK_TOTAL")
    if raw is None:
        return QUICK_TOTAL_DEFAULT
    if not raw.isascii() or not raw.isdigit() or int(raw) < 1:
        raise ValueError(raw)
    return int(raw)


QUICK_TOTAL = QUICK_TOTAL_DEFAULT


def run_one(root, rel, timeout, selector=None):
    env = dict(os.environ, PYTHONDONTWRITEBYTECODE="1")
    try:
        cmd = [sys.executable, rel]
        try:
            with open(os.path.join(root, rel), "rb") as fh:
                first = fh.readline()
            if first.startswith(b"#!") and b"python" not in first:
                cmd = ["sh", rel]  # a shell script (a shebang that is not python) is run by sh
        except OSError:
            pass
        p = subprocess.Popen(cmd + ([selector] if selector else []), cwd=root, env=env, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        return 127
    CHILD.append(p)
    try:
        return p.wait(timeout=timeout)
    except subprocess.TimeoutExpired:
        kill_children(); p.wait()
        return "timeout"
    finally:
        kill_children()


BUDGET_STATUS = 3  # a spent quick budget: not 1 (a failing test or a difference) and not 2 (refused input)


def run_files(names, sel_of, root, basedir, timeout, quick, clock=None, run=None, out=print):
    """Run each selected file on the branch; the clean copy only for a file that did not pass on the branch (quick).
    Prints one line per file with its seconds. Returns (verdicts, failed, not_run): not_run lists the files left when the
    quick budget was spent (a spent budget is not a failure of a test)."""
    import types
    time = types.SimpleNamespace(monotonic=clock or globals()["time"].monotonic)  # the fake clock of the tests
    clock = time.monotonic
    run = run or run_one
    verdicts, not_run, failed = [], [], False
    t_start = clock()
    for i, rel in enumerate(names):
        path, sel = sel_of.get(rel, (rel, None))
        remaining = QUICK_TOTAL - (clock() - t_start)
        if quick and remaining <= 0:
            not_run = list(names[i:])
            break
        if quick and path in cloud_quick.HEAVY:
            out("%-52s %-9s %-9s %s" % (rel, "-", "-", "skipped: memory-heavy " + path))
            verdicts.append((rel, "-", "-", "skipped")); failed = True
            continue
        tmo = min(timeout, max(1, int(remaining))) if quick else timeout  # clamp to the time left
        t0 = clock()
        b = run(root, path, tmo, sel) if os.path.exists(os.path.join(root, path)) else "absent"
        tb = clock() - t0
        td = 0.0
        if quick and b == "timeout" and tmo < timeout and path.rsplit("/", 1)[-1] not in TIMEOUT_ALLOW:
            not_run = list(names[i:])  # cut short by the spent budget, not by the file's own bound
            break
        if quick and b == 0:
            d = "-"  # a passing file needs no comparison with the clean copy
        else:
            if quick:
                tmo = min(timeout, max(1, int(QUICK_TOTAL - (clock() - t_start))))
            t0 = clock()
            d = run(basedir, path, tmo, sel) if os.path.exists(os.path.join(basedir, path)) else "absent"
            td = clock() - t0
            if quick and d == "timeout" and tmo < timeout and path.rsplit("/", 1)[-1] not in TIMEOUT_ALLOW:
                not_run = list(names[i:])
                break
        n = os.path.basename(path)
        if "timeout" in (b, d):
            if n in TIMEOUT_ALLOW:
                v = "not run (allowed: %s)" % TIMEOUT_ALLOW[n]
            else:
                v = "NOT RUN: timed out"; failed = True
        elif b == "absent":
            v = "removed on branch"
        elif b == 0:
            v = "ok" if d in (0, "absent", "-") else "ok (fixed on branch)"
        elif d == b:
            v = "environment-only (fails the same on both; may hide a real failure)"
        else:
            v = "FAIL: branch exit %s, default exit %s" % (b, d); failed = True
        out("%-52s %-9s %-9s %s  [branch %.1fs, default %.1fs]" % (rel, b, d, v, tb, td))
        verdicts.append((rel, b, d, v))
    return verdicts, failed, not_run


def _on_signal(signum, frame):
    raise SystemExit(128 + signum)


def main():
    for sg in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sg, _on_signal)
    expect = []
    quick = os.environ.get("CLOUD_PREFLIGHT_MODE") == "quick"
    args = sys.argv[1:]
    if cloud_quick is None and (quick or "--quick" in args):
        print("cloud_quick helper missing", file=sys.stderr); return 2
    while args:
        a = args.pop(0)
        if a == "--expect" and args:
            expect.append(args.pop(0))
        elif a == "--quick":
            quick = True
        elif a.startswith("--expect="):
            expect.append(a.split("=", 1)[1])
        else:
            print("usage: cloud-pr-preflight [--quick] [--expect PATH-PREFIX]..."); return 2
    rc, root = git("rev-parse", "--show-toplevel")
    if rc:
        print("cloud-pr-preflight: not in a git repository"); return 2
    global QUICK_TOTAL
    if quick:
        try:
            QUICK_TOTAL = quick_total()
        except ValueError:
            print("cloud-pr-preflight: CLOUD_PREFLIGHT_QUICK_TOTAL must be a whole number of seconds (1 or more)"); return 2
    try:
        timeout = int(os.environ.get("CLOUD_PREFLIGHT_TIMEOUT", "120"))
        if timeout < 1:
            raise ValueError
    except ValueError:
        print("cloud-pr-preflight: CLOUD_PREFLIGHT_TIMEOUT must be a whole number of seconds (1 or more)"); return 2
    base = os.environ.get("CLOUD_PREFLIGHT_BASE")
    if not base:
        rc, ref = git("symbolic-ref", "--short", "refs/remotes/origin/HEAD", cwd=root)
        base = ref if rc == 0 and ref else None
    if not base:
        for cand in ("origin/main", "origin/master", "main", "master"):
            if git("rev-parse", "--verify", "-q", cand + "^{commit}", cwd=root)[0] == 0:
                base = cand; break
    if base and base.startswith("-"):
        print("cloud-pr-preflight: the default branch name must not start with a dash"); return 2
    if not base:
        print("cloud-pr-preflight: cannot find the default branch (origin/main or main)"); return 2
    rc, mb = git("merge-base", base, "HEAD", cwd=root)
    if rc:
        mb = base
    failed = False
    tmp = tempfile.mkdtemp(prefix="cloud-preflight-")
    try:
        # clean copy of the default branch: archive extracted under the temp dir (no worktree metadata in the repo)
        rc, data = git("archive", "--format=tar", base, cwd=root, raw=True)
        if rc:
            print("cloud-pr-preflight: cannot read the default branch " + base); return 2
        basedir = os.path.join(tmp, "base")
        os.mkdir(basedir)
        with tarfile.open(fileobj=io.BytesIO(data)) as t:
            t.extractall(basedir, filter="data") if sys.version_info >= (3, 12) else t.extractall(basedir)
        base_tests = set(tests_in(basedir))

        print("== 1. completeness scan (%s) ==" % CHAIN)
        try:
            chain = open(os.path.join(root, CHAIN)).read()
            try:
                chain += "\n" + open(os.path.join(root, CHAIN_LIST)).read()
            except OSError:
                pass  # an old-form script names its tests inside itself
        except OSError:
            chain = ""
            print("NOT RUN: %s is missing" % CHAIN); failed = True
        exc = exceptions_of(chain)
        bad = []
        for rel in tests_in(root):
            n = os.path.basename(rel)
            if ("tests/" + n) in chain or n in exc:
                continue
            if rel in base_tests:
                print("note: %s is not chained on the default branch either (not new)" % rel)
            else:
                bad.append(rel)
        for rel in bad:
            print("NOT RUN: %s is neither chained in %s nor in EXCEPTIONS" % (rel, CHAIN))
        failed |= bool(bad)
        print("scan: " + ("FAIL" if bad else "ok"))

        sel_of = {}
        if quick:
            rc, out = git("diff", "--name-only", "--no-renames", mb, cwd=root)
            changed_files = {x for x in out.splitlines() if x}
            rc, out = git("ls-files", "--others", "--exclude-standard", cwd=root)
            changed_files |= {x for x in out.splitlines() if x}
            tracked = git("ls-files", cwd=root)[1].split("\n")
            every = cloud_quick.readers(root, tracked, changed_files)  # the same reader rule as bin/cloud-prepush
            reads, cannot = cloud_quick.split_readers(every)  # reads: the readers a quick run can start
            reason = cloud_quick.not_run_reason(every, changed_files) if changed_files else None
            picks = cloud_quick.add_scans(root, [(r, None) for r in reads], cloud_quick.SCAN_TESTS)
            names = []
            for r, s in picks:
                key = r if s is None else r + "::" + s
                sel_of[key] = (r, s)
                names.append(key)
            names = sorted(names)
            print("\n== 2. quick mode: %s, plus the named scans (timeout %ds each) =="
                  % (cloud_quick.mode_line(len(every), len(changed_files)), timeout))
            if changed_files and not names:
                print("NOT RUN: quick mode selected no check for a non-empty change; this is not a clean result")
            if reason:
                print("NOT RUN: " + reason)
            for line in cloud_quick.cannot_lines(every):
                print(line)
            failed |= bool(cannot)
            if changed_files and not reads:
                print("\nRESULT: FAIL")
                return 1  # decided from the reader picks alone: no scan is started
        else:
            print("\n== 2. every test file, one at a time (timeout %ds each) ==" % timeout)
            names = sorted(set(tests_in(root)) | base_tests)
        print("%-52s %-9s %-9s %s" % ("file", "branch", "default", "verdict"))
        verdicts, loop_failed, not_run = run_files(names, sel_of, root, basedir, timeout, quick)
        failed |= loop_failed
        print("differ: " + (", ".join(r for r, b, d, v in verdicts if b != d and d != "-") or "none"))

        print("\n== 3. existing test files this branch changes against %s ==" % base)
        rc, out = git("diff", "--numstat", "--no-renames", mb, "--", *[d + "/" for d in TEST_DIRS], cwd=root)
        changed = []
        for line in out.splitlines():
            a, dl, path = (line.split("\t") + ["", "", ""])[:3]
            if path in base_tests:
                changed.append((path, a, dl))
        if changed:
            print("existing test files edited (justify each in the pull request comment):")
        for path, a, dl in changed:
            print("%s  +%s -%s" % (path, a, dl))
        if not changed:
            print("none")
        rc, out = git("diff", "--name-only", "--diff-filter=A", "--no-renames", mb, cwd=root)
        added = [x for x in out.splitlines() if x]
        rc, out = git("ls-files", "--others", "--exclude-standard", cwd=root)
        added += [x for x in out.splitlines() if x]
        print("\nadded files:")
        for x in added:
            print("  " + x)
        if not added:
            print("  none")
        if expect:
            stray = [x for x in added if not any(x.startswith(e) for e in expect)]
            print("unexpected additions (outside %s):" % ", ".join(expect))
            for x in stray:
                print("  " + x)
            if not stray:
                print("  none")
            failed |= bool(stray)
        if not_run:
            print("NOT RUN (budget): quick run exceeded %d s (selected %d files, ran %d); not run: %s"
                  % (QUICK_TOTAL, len(names), len(verdicts), ", ".join(not_run)))
        if failed:
            print("\nRESULT: FAIL")
            return 1
        if not_run:
            print("\nRESULT: NOT RUN (budget)")
            return BUDGET_STATUS
        print("\nRESULT: PASS")
        return 0
    finally:
        kill_children()
        shutil.rmtree(tmp, ignore_errors=True)


if __name__ == "__main__":
    sys.exit(main())
