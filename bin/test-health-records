#!/usr/bin/env python3
"""test-health-records: offline tests for bin/health_records.py and its hooks in fleet-switchboard (#357). No network, no OpenCode.

    bin/test-health-records

The last line printed is `RESULT: PASS` or `RESULT: FAIL`."""
import importlib.machinery
import importlib.util
import json
import os
import sys
import tempfile
import time
import unittest

HERE = os.path.dirname(os.path.realpath(__file__))
spec = importlib.util.spec_from_file_location("health_records", os.path.join(HERE, "health_records.py"))
hr = importlib.util.module_from_spec(spec)
sys.modules["health_records"] = hr
spec.loader.exec_module(hr)

NOW = 1_800_000_000.0


def msg(mid, tokens, cost, created=None, model=None):
    out = {"id": mid, "type": "assistant", "agent": "coder", "cost": cost,
           "tokens": {"input": tokens, "output": 0, "reasoning": 0, "cache": {"read": 0, "write": 0}},
           "time": {"created": int((created or NOW) * 1000)}, "model": model or {"id": "m", "providerID": "p"}}
    return out


class ToolCalls(unittest.TestCase):
    def test_series_per_minute(self):
        end = int(NOW // 60)
        body = {"written_at": NOW - 5, "sessions": {"ses_a": {str(end): 2, str(end - 1): 7}}}
        got = hr.tool_series(body, NOW)["ses_a"]
        self.assertEqual(got[-2:], [7, 2])
        self.assertEqual(len(got), 15)

    def test_stale_or_missing_is_not_recorded(self):
        self.assertEqual(hr.tool_series(None, NOW), {})
        self.assertEqual(hr.tool_series({"written_at": NOW - 181, "sessions": {"s": {}}}, NOW), {})
        self.assertEqual(hr.tool_series({"sessions": {"s": {}}}, NOW), {})
        body = hr.Recorder(lambda: NOW).body(None)
        self.assertEqual(body["tool_calls"], {})

    def test_old_minutes_fall_out_of_the_window(self):
        end = int(NOW // 60)
        got = hr.tool_series({"written_at": NOW, "sessions": {"s": {str(end - 15): 9, str(end - 14): 1}}}, NOW)["s"]
        self.assertEqual(got[0], 1)
        self.assertEqual(sum(got), 1)


class Usage(unittest.TestCase):
    def test_dedupe_sum_and_context(self):
        rec = hr.Recorder(lambda: NOW)
        self.assertTrue(rec.ingest_message("ses_a", msg("m1", 1000, 0.02, NOW + 10)))
        self.assertTrue(rec.ingest_message("ses_a", msg("m2", 3000, 0.06, NOW + 20)))
        self.assertFalse(rec.ingest_message("ses_a", msg("m1", 1000, 0.02, NOW + 10)))
        u = rec.body()["usage"]["ses_a"]
        hour = u["hours"][str(hr._hour(NOW))]
        self.assertEqual((hour["tokens"], hour["cost"], hour["messages"]), (4000, 0.08, 2))
        self.assertEqual(u["context"]["tokens"], 3000)
        self.assertTrue(u["partial"])

    def test_no_limit_means_no_percent(self):
        rec = hr.Recorder(lambda: NOW)
        rec.ingest_message("ses_a", msg("m1", 1000, 0.01))
        ctx = rec.body()["usage"]["ses_a"]["context"]
        self.assertEqual(ctx["tokens"], 1000)
        self.assertNotIn("percent", ctx)
        self.assertNotIn("limit", ctx)

    def test_limit_from_model_info(self):
        rec = hr.Recorder(lambda: NOW)
        rec.ingest_message("ses_a", msg("m1", 50000, 0.01, model={"id": "m", "providerID": "p", "limit": {"context": 200000}}))
        self.assertEqual(rec.body()["usage"]["ses_a"]["context"]["percent"], 25.0)

    def test_no_cost_is_not_zero_cost(self):
        rec = hr.Recorder(lambda: NOW)
        m = msg("m1", 10, None)
        del m["cost"]
        rec.ingest_message("ses_a", m)
        self.assertNotIn("cost", rec.body()["usage"]["ses_a"]["hours"][str(hr._hour(NOW))])

    def test_message_without_numbers_is_ignored(self):
        rec = hr.Recorder(lambda: NOW)
        self.assertFalse(rec.ingest_message("ses_a", {"id": "m9", "type": "assistant"}))
        self.assertEqual(rec.body()["usage"], {})


class Pushes(unittest.TestCase):
    def test_changed_head_counts_first_sighting_does_not(self):
        rec = hr.Recorder(lambda: NOW)
        rec.ingest_prs({"acme/api#1": {"head": "a"}, "acme/api#2": {"head": "x"}})
        rec.ingest_prs({"acme/api#1": {"head": "b"}, "acme/api#2": {"head": "x"}})
        rec.ingest_prs({"acme/api#1": {"head": "c"}, "acme/api#2": {"head": "x"}})
        self.assertEqual(rec.body()["pushes"], {"acme/api": {str(hr._hour(NOW)): 2}})

    def test_no_pushes_is_absent_not_zero(self):
        self.assertEqual(hr.Recorder(lambda: NOW).body()["pushes"], {})


class Bounds(unittest.TestCase):
    def test_long_run_stays_bounded(self):
        clock = [NOW]
        rec = hr.Recorder(lambda: clock[0])
        n = 0
        for hour in range(72):
            clock[0] = NOW + hour * 3600
            for agent in range(600):
                n += 1
                rec.ingest_message("ses_%d" % agent, msg("m%d" % n, 100, 0.001, clock[0]))
        body = rec.body()
        self.assertLessEqual(len(json.dumps(body)), hr.FILE_CAP)
        self.assertLessEqual(len(body["usage"]), hr.MAX_AGENTS)
        oldest = min(int(h) for u in body["usage"].values() for h in u["hours"])
        self.assertGreaterEqual(oldest, hr._hour(clock[0]) - 47 * 3600)
        self.assertLessEqual(len(rec.seen), hr.MAX_SEEN)

    def test_file_is_private_and_atomic(self):
        with tempfile.TemporaryDirectory() as d:
            rec = hr.Recorder(lambda: time.time())
            rec.ingest_message("ses_a", msg("m1", 5, 0.1, time.time()))
            self.assertTrue(hr.write(d, rec.body()))
            self.assertEqual(os.stat(os.path.join(d, hr.FILE)).st_mode & 0o777, 0o600)
            self.assertEqual(os.listdir(d), [hr.FILE])
            self.assertIsNotNone(hr.read(d, time.time()))
            self.assertIsNone(hr.read(d, time.time() + 10000))

    def test_only_names_and_numbers(self):
        rec = hr.Recorder(lambda: NOW)
        rec.ingest_message("ses_a", dict(msg("m1", 5, 0.1), content=[{"type": "text", "text": "secret prompt"}]))
        self.assertNotIn("secret", json.dumps(rec.body()))


class Hooks(unittest.TestCase):
    """The daemon's hooks make no request of their own."""

    @classmethod
    def setUpClass(cls):
        loader = importlib.machinery.SourceFileLoader("sb_under_test", os.path.join(HERE, "fleet-switchboard"))
        sp = importlib.util.spec_from_loader("sb_under_test", loader)
        cls.sb = importlib.util.module_from_spec(sp)
        sys.modules["sb_under_test"] = cls.sb
        loader.exec_module(cls.sb)

    def test_ingest_and_write_without_any_client(self):
        class Engine:
            state_dir = None
            v2 = None   # any use of it raises: a recorder that reads would fail the test

        class State:
            pr_state = {"acme/api#1": {"head": "a"}}

        with tempfile.TemporaryDirectory() as d:
            engine = Engine()
            engine.state_dir = d
            self.sb.health_ingest_messages(engine, "ses_a", [msg("m1", 10, 0.5, time.time())])
            self.sb.health_write(engine, State, time.time())
            State.pr_state = {"acme/api#1": {"head": "b"}}
            self.sb.health_write(engine, State, time.time())
            with open(os.path.join(d, hr.FILE)) as fh:
                body = json.load(fh)
            self.assertEqual(body["usage"]["ses_a"]["context"]["tokens"], 10)
            self.assertEqual(sum(list(body["pushes"]["acme/api"].values())), 1)
            self.assertEqual(body["tool_calls"], {})   # no plugin file: not recorded

    def test_a_fault_never_raises(self):
        class Engine:
            state_dir = "/nonexistent-dir-for-test"
        self.sb.health_ingest_messages(Engine(), "ses_a", "not a list")
        self.sb.health_write(Engine(), type("S", (), {"pr_state": None}), time.time())


if __name__ == "__main__":
    result = unittest.main(exit=False, verbosity=1).result
    ok = result.wasSuccessful()
    print("RESULT: PASS" if ok else "RESULT: FAIL")
    sys.exit(0 if ok else 1)
