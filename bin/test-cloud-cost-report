#!/usr/bin/env python3
"""test-cloud-cost-report: offline tests for bin/cloud_cost_report.py, on fixture audit files.

Each rule has a mutant: the module source is changed in one place and the same case must then fail.

    bin/test-cloud-cost-report
"""
import io
import json
import sys
import tempfile
import types
import unittest
from pathlib import Path

BIN = Path(__file__).resolve().parent
SOURCE = (BIN / "cloud_cost_report.py").read_text()
DAY = "2026-10-14"


def load(source=SOURCE):
    module = types.ModuleType("cloud_cost_report_under_test")
    exec(compile(source, "cloud_cost_report.py", "exec"), module.__dict__)
    return module


def mutant(old, new):
    assert SOURCE.count(old) == 1, old
    return SOURCE.replace(old, new)


REAL = load()


def line(ts, rid, action, cost, ok=True, worker="widget-service"):
    return {"ts": ts, "worker": worker, "runtime_id": rid, "action": action, "cost_estimate_usd": cost, "ok": ok}


def write(tmp, name, lines, raw=None):
    path = Path(tmp) / name
    path.write_text(raw if raw is not None else "".join(json.dumps(l) + "\n" for l in lines))
    return str(path)


def run(module, path, day=DAY, extra=("--node-price", "0.5", "--node-vcpu", "4", "--node-hours", "20")):
    out = io.StringIO()
    code = module.main([day, path, *extra], out)
    return code, out.getvalue()


STOPPED = [
    line("2026-10-14T01:00:00Z", "pod/cb-example-1", "create", 0),
    line("2026-10-14T03:00:00Z", "pod/cb-example-1", "stop", 0.25),
]


class TestReport(unittest.TestCase):
    def check(self, module, lines, **kw):
        with tempfile.TemporaryDirectory() as tmp:
            return run(module, write(tmp, "audit.jsonl", lines), **kw)

    def test_a_stopped_pod_costs_its_stop_line_plus_nodes(self):
        code, text = self.check(REAL, STOPPED)
        self.assertEqual(code, 0)
        self.assertIn("USD 10.00 per day", text)
        self.assertIn("launcher estimate 0.25; vCPU share of node price (shape S) 0.50", text)
        self.assertIn("pods: 1, pod-hours 2.00", text)
        self.assertIn("node-hours 20.00", text)

    def test_a_pod_without_stop_is_costed_to_the_end_of_the_day_and_says_so(self):
        code, text = self.check(REAL, [line("2026-10-14T20:00:00Z", "pod/cb-example-2", "create", 0)],
                                extra=("--node-price", "0", "--node-vcpu", "4", "--node-hours", "0", "--pod-rate", "0.1"))
        self.assertEqual(code, 0)
        self.assertIn("costed to the end of the day", text)
        self.assertIn("launcher estimate 0.40", text)

    def test_ok_false_lines_are_listed_not_costed(self):
        bad = line("2026-10-14T04:00:00Z", "pod/cb-example-3", "stop", 9.0, ok=False)
        code, text = self.check(REAL, STOPPED + [bad])
        self.assertEqual(code, 0)
        self.assertIn("not costed (ok false) line 3", text)
        self.assertIn("launcher estimate 0.25", text)

    def test_a_day_with_no_lines_prints_0_with_the_reason(self):
        code, text = self.check(REAL, STOPPED, day="2026-10-15")
        self.assertEqual(code, 0)
        self.assertIn("USD 0 (no audit lines on this day)", text)

    def test_a_stop_twice_for_one_pod_counts_once(self):
        code, text = self.check(REAL, STOPPED + [line("2026-10-14T05:00:00Z", "pod/cb-example-1", "stop", 0.5)])
        self.assertIn("pods: 1,", text)
        self.assertIn("launcher estimate 0.50", text)

    def test_malformed_input_exits_2_in_one_line(self):
        with tempfile.TemporaryDirectory() as tmp:
            for raw in ("not json\n", '{"ts": "x"}\n', json.dumps(dict(STOPPED[0], ts="yesterday")) + "\n",
                        json.dumps(dict(STOPPED[0], action="reboot")) + "\n"):
                out = io.StringIO()
                err = io.StringIO()
                old, sys.stderr = sys.stderr, err
                try:
                    code = REAL.main([DAY, write(tmp, "bad.jsonl", None, raw), "--node-price", "1", "--node-vcpu", "4", "--node-hours", "1"], out)
                finally:
                    sys.stderr = old
                self.assertEqual(code, 2, raw)
                self.assertEqual(len(err.getvalue().splitlines()), 1)
                self.assertNotIn("Traceback", err.getvalue())
            self.assertEqual(REAL.main([DAY, str(Path(tmp) / "missing"), "--node-price", "1", "--node-vcpu", "4", "--node-hours", "1"], io.StringIO()), 2)
            self.assertEqual(REAL.main(["14-10-2026", "x"], io.StringIO()), 2)


class TestInputs(unittest.TestCase):
    def refused(self, module, flag, value):
        base = {"--node-price": "0.5", "--node-vcpu": "4", "--node-hours": "20", "--pod-rate": "0"}
        base[flag] = value
        extra = ["%s=%s" % kv for kv in base.items()]
        err = io.StringIO()
        old, sys.stderr = sys.stderr, err
        try:
            with tempfile.TemporaryDirectory() as tmp:
                code, text = run(module, write(tmp, "a.jsonl", STOPPED), extra=extra)
        finally:
            sys.stderr = old
        return code, text, err.getvalue()

    def test_nan_and_inf_are_refused_for_every_float_argument(self):
        for flag in ("--node-price", "--node-vcpu", "--node-hours", "--pod-rate"):
            for value in ("nan", "inf", "-inf"):
                code, text, err = self.refused(REAL, flag, value)
                self.assertEqual(code, 2, (flag, value))
                self.assertEqual(text, "")
                self.assertEqual(len(err.splitlines()), 1)

    def test_a_pod_name_with_unicode_is_read(self):
        lines = [line("2026-10-14T01:00:00Z", "pod/cb-\u00e9t\u00e9-1", "create", 0),
                 line("2026-10-14T03:00:00Z", "pod/cb-\u00e9t\u00e9-1", "stop", 0.25, worker="w\u00fcrker")]
        with tempfile.TemporaryDirectory() as tmp:
            path = Path(tmp) / "u.jsonl"
            path.write_text("".join(json.dumps(l, ensure_ascii=False) + "\n" for l in lines), encoding="utf-8")
            code, text = run(REAL, str(path))
        self.assertEqual(code, 0, text)
        self.assertIn("pods: 1,", text)

    def test_the_shape_table_matches_the_launcher_and_prices_exactly(self):
        # launcher shapes: S 2 vCPU, M 4 vCPU. Node 8 vCPU at 0.8 USD/h, one pod for 2 h.
        self.assertEqual(REAL.SHAPE_VCPU["S"], 2)
        self.assertEqual(REAL.SHAPE_VCPU["M"], 4)
        for shape, usd in (("S", "0.40"), ("M", "0.80")):
            with tempfile.TemporaryDirectory() as tmp:
                code, text = run(REAL, write(tmp, "a.jsonl", STOPPED),
                                 extra=("--node-price", "0.8", "--node-vcpu", "8", "--node-hours", "0", "--shape", shape))
            self.assertIn("(shape %s) %s" % (shape, usd), text)

    def test_a_vcpu_share_of_one_eighth_is_exact(self):
        # an 8 vCPU node share of 1/8 (1 vCPU) for 2 h at 0.8 USD/h = 0.20
        with tempfile.TemporaryDirectory() as tmp:
            module = load(SOURCE.replace('SHAPE_VCPU = {', 'SHAPE_VCPU = {"XS": 1, '))
            code, text = run(module, write(tmp, "a.jsonl", STOPPED),
                             extra=("--node-price", "0.8", "--node-vcpu", "8", "--node-hours", "0", "--shape", "XS"))
        self.assertIn("(shape XS) 0.20", text)

    def test_an_oversize_audit_file_is_refused_in_one_line(self):
        module = load(SOURCE.replace("MAX_AUDIT_BYTES = 64 * 1024 * 1024", "MAX_AUDIT_BYTES = 1000"))
        with tempfile.TemporaryDirectory() as tmp:
            path = write(tmp, "big.jsonl", None, "x" * 5000)
            err = io.StringIO()
            old, sys.stderr = sys.stderr, err
            try:
                code, _ = run(module, path)
            finally:
                sys.stderr = old
        self.assertEqual(code, 2)
        self.assertEqual(len(err.getvalue().splitlines()), 1)
        self.assertIn("over", err.getvalue())

    def test_the_real_cap_is_64_mb(self):
        self.assertEqual(REAL.MAX_AUDIT_BYTES, 64 * 1024 * 1024)


def real_audit():
    """A small real-shaped audit: the writer's keys (with actor and reason) and the action names of a real day."""
    def rec(ts, rid, action, cost, ok=True, reason="", worker="widget-service"):
        return dict(line(ts, rid, action, cost, ok, worker), actor="cb-example", reason=reason)
    return [
        rec("2026-10-14T01:00:00Z", "pod/cb-example-1", "create-attempt", 0.0, True, "attempt 1: ready"),
        rec("2026-10-14T01:00:01Z", "pod/cb-example-1", "create", 0.0),
        rec("2026-10-14T02:00:00Z", "pod/cb-example-2", "create-attempt", 0.0, False, "attempt 1: no capacity"),
        rec("2026-10-14T02:00:30Z", "pod/cb-example-2", "create.interrupted", 0.0, False, "interrupted"),
        rec("2026-10-14T02:30:00Z", "pod/cb-example-1", "renew-git-token", 0.05, True),
        rec("2026-10-14T03:00:01Z", "pod/cb-example-1", "stop", 0.2, True, "done"),
        rec("2026-10-14T04:00:00Z", "pod/cb-example-3", "stop", 9.0, False, "gone"),
        rec("2026-10-14T05:00:00Z", "pod/cb-example-1", "delete", 0.0, True),
    ]


class TestRealAudit(unittest.TestCase):
    def go(self, module, lines=None, extra=None, day=DAY):
        with tempfile.TemporaryDirectory() as tmp:
            return run(module, write(tmp, "audit.jsonl", lines or real_audit()), day=day, **({"extra": extra} if extra else {}))

    def test_the_real_action_names_are_read_and_the_skipped_are_counted(self):
        code, text = self.go(REAL)
        self.assertEqual(code, 0, text)
        self.assertIn("skipped lines: 4", text)
        self.assertIn("pods: 1,", text)

    def test_an_unknown_action_still_fails(self):
        bad = real_audit() + [line("2026-10-14T06:00:00Z", "pod/cb-example-4", "reboot", 0)]
        self.assertEqual(self.go(REAL, bad)[0], 2)

    def test_the_vcpu_share_is_priced_next_to_the_launcher_estimate(self):
        # M = 4 of 8 vCPU: half of 0.6 USD/h for about 2 h
        code, text = self.go(REAL, extra=("--node-price", "0.6", "--node-vcpu", "8", "--node-hours", "5", "--shape", "M"))
        self.assertIn("launcher estimate 0.20; vCPU share of node price (shape M) 0.60", text)
        self.assertIn("USD 3.00 per day", text)

    def test_the_node_hours_file_gives_the_node_hours(self):
        with tempfile.TemporaryDirectory() as tmp:
            hours = Path(tmp) / "hours"
            hours.write_text("2026-10-14T01 2\n2026-10-14T02:00:00Z 3\n")
            code, text = run(REAL, write(tmp, "a.jsonl", real_audit()),
                             extra=("--node-price", "2", "--node-vcpu", "4", "--node-hours-file", str(hours)))
            self.assertEqual(code, 0, text)
            self.assertIn("node-hours 5.00", text)
            self.assertIn("USD 10.00 per day", text)
            hours.write_text("2026-10-15T01 2\n")
            code, _ = run(REAL, write(tmp, "b.jsonl", real_audit()),
                          extra=("--node-price", "2", "--node-vcpu", "4", "--node-hours-file", str(hours)))
            self.assertEqual(code, 2)

    def test_an_empty_day_prints_0_with_the_reason(self):
        code, text = self.go(REAL, day="2026-10-20")
        self.assertIn("USD 0 (no audit lines on this day)", text)


class TestMutants(unittest.TestCase):
    def real_case(self, module):
        code, text = TestRealAudit().go(module)
        assert code == 0 and "skipped lines: 4" in text, (code, text)

    def test_failing_on_a_skipped_action_is_caught(self):
        src = mutant('and line["action"] not in SKIPPED:', ':')
        self.assertTrue(self.fails(src, self.real_case))

    def test_not_failing_on_an_unknown_action_is_caught(self):
        src = mutant('if line["action"] not in ACTIONS and line["action"] not in SKIPPED:', 'if False:')
        def case(module):
            bad = real_audit() + [line("2026-10-14T06:00:00Z", "pod/cb-example-4", "reboot", 0)]
            code, _ = TestRealAudit().go(module, bad)
            assert code == 2
        self.assertTrue(self.fails(src, case))

    def test_ignoring_the_vcpu_share_is_caught(self):
        src = mutant("SHAPE_VCPU[shape] / node_vcpu", "1 / node_vcpu")
        def case(module):
            code, text = TestRealAudit().go(module, extra=("--node-price", "0.6", "--node-vcpu", "8", "--node-hours", "5", "--shape", "M"))
            assert "(shape M) 0.60" in text, text
        self.assertTrue(self.fails(src, case))

    def test_node_usd_from_anything_but_node_hours_is_caught(self):
        src = mutant("node_usd = node_price * node_hours", "node_usd = node_price * pod_hours")
        self.assertTrue(self.fails(src, self.stopped_case))

    def test_an_empty_day_costing_nodes_is_caught(self):
        src = mutant('if r["n"] == 0:', 'if False:')
        def case(module):
            code, text = TestRealAudit().go(module, day="2026-10-20")
            assert "USD 0 (no audit lines on this day)" in text, text
        self.assertTrue(self.fails(src, case))

    def test_a_check_without_isfinite_is_caught(self):
        src = mutant("if not math.isfinite(value):", "if False:")
        for flag in ("--node-price", "--node-vcpu", "--node-hours", "--pod-rate"):
            for value in ("nan", "inf"):
                def case(module, flag=flag, value=value):
                    code, _, _ = TestInputs().refused(module, flag, value)
                    assert code == 2
                self.assertTrue(self.fails(src, case), (flag, value))

    def fails(self, source, case):
        try:
            case(load(source))
        except AssertionError:
            return True
        return False

    def stopped_case(self, module):
        with tempfile.TemporaryDirectory() as tmp:
            code, text = run(module, write(tmp, "a.jsonl", STOPPED))
        assert "launcher estimate 0.25;" in text and "USD 10.00 per day" in text, text

    def test_ignoring_stop_lines_is_caught(self):
        self.assertTrue(self.fails(mutant('if l["action"] == "stop":', 'if False:'), self.stopped_case))

    def test_double_counting_a_stopped_pod_is_caught(self):
        src = mutant('if l["action"] == "create" and l["runtime_id"] not in stopped:', 'if l["action"] == "create":')
        def case(module):
            with tempfile.TemporaryDirectory() as tmp:
                code, text = run(module, write(tmp, "a.jsonl", STOPPED), extra=("--node-price", "0", "--node-vcpu", "4", "--node-hours", "0", "--pod-rate", "1"))
            assert "pods: 1," in text, text
        self.assertTrue(self.fails(src, case))

    def test_costing_a_failed_line_is_caught(self):
        src = mutant('good = [l for l in today if l["ok"]]', 'good = list(today)')
        def case(module):
            bad = line("2026-10-14T04:00:00Z", "pod/cb-example-3", "stop", 9.0, ok=False)
            with tempfile.TemporaryDirectory() as tmp:
                code, text = run(module, write(tmp, "a.jsonl", STOPPED + [bad]))
            assert "launcher estimate 0.25;" in text, text
        self.assertTrue(self.fails(src, case))

    def test_reading_another_file_is_caught(self):
        src = mutant("def read_lines(path):\n    try:\n        with open(path,", "def read_lines(path):\n    try:\n        with open(path + '.other',")
        def case(module):
            with tempfile.TemporaryDirectory() as tmp:
                path = write(tmp, "a.jsonl", STOPPED)
                write(tmp, "a.jsonl.other", [line("2026-10-14T03:00:00Z", "pod/cb-example-9", "stop", 7.0)])
                code, text = run(module, path)
            assert code == 0 and "launcher estimate 0.25;" in text, text
        self.assertTrue(self.fails(src, case))


import ast
import importlib.util

LAUNCHER_PATH = BIN.parent / "cloud" / "launcher" / "cloud_worker.py"
LAUNCHER_TEXT = LAUNCHER_PATH.read_text()


def derive_launcher_names(text):
    """Every audit action name the launcher source can write: the literal action of each audit(...) call, the action of each
    record dict given to write_audit(...), and every module constant whose name ends in _ACTION."""
    tree = ast.parse(text)
    consts = {}
    for node in tree.body:
        if isinstance(node, ast.Assign) and isinstance(node.value, ast.Constant) and isinstance(node.value.value, str):
            for target in node.targets:
                if isinstance(target, ast.Name):
                    consts[target.id] = node.value.value

    def strings(node):
        if isinstance(node, ast.Constant) and isinstance(node.value, str):
            return {node.value}
        if isinstance(node, ast.Name) and node.id in consts:
            return {consts[node.id]}
        if isinstance(node, ast.IfExp):
            return strings(node.body) | strings(node.orelse)
        return set()

    names = {value for name, value in consts.items() if name.endswith("_ACTION")}
    for node in ast.walk(tree):
        if not isinstance(node, ast.Call):
            continue
        func = node.func.attr if isinstance(node.func, ast.Attribute) else getattr(node.func, "id", "")
        if func == "audit" and len(node.args) >= 3:   # audit(worker, runtime_id, action, cost, ok, reason)
            names |= strings(node.args[2])
        if func == "_audited" and len(node.args) >= 2:   # _audited(worker, action, fn, ...) writes the audit line
            names |= strings(node.args[1])
        if func == "write_audit":
            for arg in node.args:
                if isinstance(arg, ast.Dict):
                    for key, value in zip(arg.keys, arg.values):
                        if isinstance(key, ast.Constant) and key.value == "action":
                            names |= strings(value)
    return names


# A call whose action is neither a literal nor a *_ACTION constant is a FINDING, unless its enclosing function is listed here.
ALLOWED_VARIABLE_ACTIONS = {
    "_audited": "forwards its own action parameter; every _audited(...) caller is derived from its literal",
    "audit": "writes the action parameter it was given; every audit(...) caller is derived from its action argument",
}


def variable_action_sites(text):
    """(function, line, source) of each audit/_audited/write_audit action that is not a literal or a *_ACTION constant."""
    tree = ast.parse(text)
    consts = {t.id for n in tree.body if isinstance(n, ast.Assign) and isinstance(n.value, ast.Constant)
              for t in n.targets if isinstance(t, ast.Name)}

    def resolved(node):
        if isinstance(node, ast.Constant) and isinstance(node.value, str):
            return True
        if isinstance(node, ast.Name) and node.id in consts:
            return True
        return isinstance(node, ast.IfExp) and resolved(node.body) and resolved(node.orelse)

    sites = []

    def visit(node, func):
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            func = node.name
        if isinstance(node, ast.Call):
            name = node.func.attr if isinstance(node.func, ast.Attribute) else getattr(node.func, "id", "")
            exprs = []
            if name == "audit" and len(node.args) >= 3:
                exprs.append(node.args[2])
            if name == "_audited" and len(node.args) >= 2:
                exprs.append(node.args[1])
            if name == "write_audit":
                for arg in node.args:
                    if isinstance(arg, ast.Dict):
                        exprs += [v for k, v in zip(arg.keys, arg.values) if isinstance(k, ast.Constant) and k.value == "action"]
            for expr in exprs:
                if not resolved(expr):
                    sites.append((func, node.lineno, ast.unparse(expr)))
        for child in ast.iter_child_nodes(node):
            visit(child, func)

    visit(tree, "")
    return sites


def unallowed_variable_sites(text):
    return [s for s in variable_action_sites(text) if s[0] not in ALLOWED_VARIABLE_ACTIONS]


def stale_names(module, names):
    """Names the report costs or skips that the launcher no longer writes."""
    return sorted(n for n in set(module.ACTIONS) | set(module.SKIPPED) if n not in names)


def uncovered_names(text, module):
    return sorted(n for n in derive_launcher_names(text) if n not in module.ACTIONS and n not in module.SKIPPED)


NOT_COSTED = ("create-attempt", "create.failed", "create.interrupted", "renew-git-token", "refresh-cluster-token", "ignored-setting-notice", "report")
EVERY_LAUNCHER_ACTION = [
    line("2026-10-14T01:00:00Z", "pod/cb-example-1", "create", 0),
    line("2026-10-14T01:01:00Z", "pod/cb-example-1", "create-attempt", 0, ok=False),
    line("2026-10-14T01:02:00Z", "pod/cb-example-1", "create-attempt", 0, ok=True),
    line("2026-10-14T01:03:00Z", "pod/cb-example-2", "create.failed", 0, ok=False),
    line("2026-10-14T01:04:00Z", "pod/cb-example-3", "create.interrupted", 0, ok=False),
    line("2026-10-14T02:00:00Z", "pod/cb-example-1", "renew-git-token", 0),
    line("2026-10-14T02:30:00Z", "reaper", "refresh-cluster-token", 0, ok=False, worker=""),
    line("2026-10-14T02:31:00Z", "reaper", "ignored-setting-notice", 0, worker=""),
    line("2026-10-14T02:40:00Z", "pod/cb-example-1", "report", 0),
    line("2026-10-14T03:00:00Z", "pod/cb-example-1", "extend", 0),
    line("2026-10-14T04:00:00Z", "pod/cb-example-1", "stop", 0.25),
    line("2026-10-14T05:00:00Z", "pod/cb-example-4", "delete", 0, ok=False),
]


def load_launcher():
    spec = importlib.util.spec_from_file_location("launcher_under_test_for_names", LAUNCHER_PATH)
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


class TestLauncherNamesAreKnown(unittest.TestCase):
    """Both directions: every action the launcher can write is costed or skipped by the report, and every name the report
    costs or skips is still written by the launcher. A pull request that adds an audit action name fails this test until
    the name is costed or skipped in the report."""

    def test_a_stale_report_name_and_a_variable_action_are_caught(self):
        self.assertEqual(stale_names(REAL, derive_launcher_names(LAUNCHER_TEXT) - {"report"}), ["report"])
        scratch = LAUNCHER_TEXT.replace('self._audited(worker, "stop", go, audit_reason)', 'self._audited(worker, f"s{a}", go, audit_reason)')
        self.assertNotEqual(scratch, LAUNCHER_TEXT)
        self.assertEqual(len(unallowed_variable_sites(scratch)), 1)

    def test_every_action_name_the_launcher_writes_is_costed_or_skipped(self):
        names = sorted(derive_launcher_names(LAUNCHER_TEXT))
        print("launcher audit action names (%d): %s" % (len(names), ", ".join(names)))
        self.assertGreaterEqual(len(names), 10)
        self.assertEqual(uncovered_names(LAUNCHER_TEXT, REAL), [])
        self.assertEqual(stale_names(REAL, set(names)), [], "STALE: the report names an action the launcher no longer writes")
        sites = variable_action_sites(LAUNCHER_TEXT)
        for site in sites:
            print("variable action: %s line %d: %s%s" % (site[0], site[1], site[2],
                  " (allowed: %s)" % ALLOWED_VARIABLE_ACTIONS[site[0]] if site[0] in ALLOWED_VARIABLE_ACTIONS else ""))
        self.assertEqual(unallowed_variable_sites(LAUNCHER_TEXT), [], "a variable audit action at this call site")
    def test_a_new_launcher_action_is_named_by_the_derivation_test(self):
        old = '"create-attempt", 0.0, True, "attempt %d: ready"'
        self.assertEqual(LAUNCHER_TEXT.count(old), 1)
        scratch = LAUNCHER_TEXT.replace(old, '"a-new-action", 0.0, True, "attempt %d: ready"')
        self.assertNotEqual(scratch, LAUNCHER_TEXT)
        self.assertEqual(uncovered_names(scratch, REAL), ["a-new-action"])

    def test_a_fixture_audit_of_the_real_shape_gives_a_report_and_counts_the_skipped_lines(self):
        with tempfile.TemporaryDirectory() as tmp:
            code, text = run(REAL, write(tmp, "audit.jsonl", EVERY_LAUNCHER_ACTION))
        self.assertEqual(code, 0, text)
        self.assertIn("cloud cost %s:" % DAY, text)
        self.assertEqual({l["action"] for l in EVERY_LAUNCHER_ACTION if l["action"] in NOT_COSTED}, set(NOT_COSTED))
        self.assertIn("skipped lines: %d\n" % len([l for l in EVERY_LAUNCHER_ACTION if l["action"] in NOT_COSTED]), text)

    def test_an_unknown_action_fails_in_one_line_naming_it(self):
        bad = EVERY_LAUNCHER_ACTION + [line("2026-10-14T06:00:00Z", "pod/cb-example-4", "reboot", 0)]
        err = io.StringIO()
        with tempfile.TemporaryDirectory() as tmp, mock_stderr(err):
            code, _ = run(REAL, write(tmp, "audit.jsonl", bad))
        self.assertEqual(code, 2)
        self.assertEqual(len(err.getvalue().splitlines()), 1)
        self.assertIn("reboot", err.getvalue())

    def test_the_launcher_tail_reader_neither_raises_nor_takes_an_unknown_action_for_a_stop(self):
        launcher = load_launcher()
        with tempfile.TemporaryDirectory() as tmp:
            path = write(tmp, "audit.jsonl", [line("2026-10-14T06:00:00Z", "pod/cb-example-4", "a-new-action", 0, ok=False)],
                         raw=json.dumps(line("2026-10-14T06:00:00Z", "pod/cb-example-4", "a-new-action", 0, ok=False)) + "\nnot json\n")
            self.assertIsNone(launcher.last_audit_line(path, "stop"))
            self.assertIsNone(launcher.last_audit_line(path, "refresh-cluster-token", "reaper"))
            self.assertEqual(launcher.last_audit_line(path, "a-new-action"), (False, None))


ROOT = BIN.parent
WRITER_FILE = "cloud/launcher/cloud_worker.py"
FORWARDING = ("audit", "_audited")   # the two functions that forward their own action parameter
ACTION_CALLS = {"audit": 2, "_audited": 1, "write_audit": None}   # name -> index of the action argument (None: a record dict)
WRITE_MODES = ("a", "w", "x", "ab", "wb", "a+", "w+", "r+")


CLOUD_AUDIT_MARKS = ("CW_CLOUD_AUDIT", "write_audit", "audit_path(", "cw-cloud")   # how a source names the launcher's audit file


def audit_scan_files():
    """The files that can name the launcher's audit file: cloud/launcher/*.py, bin/*.py and bin/ scripts without extension that hold one of
    CLOUD_AUDIT_MARKS (a narrowing of git grep -l audit: the switchboard's own audit log and other tools' audit(...) are other files).
    Test scripts (bin/test-*) are left out: they write fixture files, not the launcher's."""
    found = []
    for path in sorted(list((ROOT / "cloud" / "launcher").glob("*.py")) + list(BIN.glob("*.py")) + [p for p in BIN.iterdir() if p.is_file() and not p.suffix and not p.name.startswith("test-")]):
        try:
            text = path.read_text()
        except (UnicodeDecodeError, OSError):
            continue
        if any(m in text for m in CLOUD_AUDIT_MARKS):
            found.append((str(path.relative_to(ROOT)), text))
    return found


def audit_writes(text):
    """(line, what) of each write_audit(...) call and each write-mode open / os.open / write_text / append whose path holds the audit path."""
    try:
        tree = ast.parse(text)
    except SyntaxError:
        return []
    tainted = set()
    for node in ast.walk(tree):
        if isinstance(node, ast.Assign) and any(m in ast.unparse(node.value) for m in CLOUD_AUDIT_MARKS):
            tainted |= {ast.unparse(t) for t in node.targets}

    def holds(expr):
        source = ast.unparse(expr)
        return any(m in source for m in CLOUD_AUDIT_MARKS) or any(t in source for t in tainted)

    def write_flag(call, index):
        modes = [a for a in call.args[index:index + 1] + [k.value for k in call.keywords if k.arg == "mode"]]
        return any(isinstance(m, ast.Constant) and isinstance(m.value, str) and any(c in m.value for c in "awx+") for m in modes)

    hits = []
    for node in ast.walk(tree):
        if not isinstance(node, ast.Call):
            continue
        name = node.func.attr if isinstance(node.func, ast.Attribute) else getattr(node.func, "id", "")
        dotted = ast.unparse(node.func)
        if name == "write_audit":
            hits.append((node.lineno, "write_audit"))
        elif dotted == "open" and node.args and holds(node.args[0]) and write_flag(node, 1):
            hits.append((node.lineno, "open for writing"))
        elif dotted == "os.open" and node.args and holds(node.args[0]) and "O_" in ast.unparse(node.args[1:2]) and any(
                f in ast.unparse(node.args[1]) for f in ("WRONLY", "RDWR", "APPEND", "CREAT")):
            hits.append((node.lineno, "os.open with a write flag"))
        elif name in ("write_text", "write_bytes") and isinstance(node.func, ast.Attribute) and holds(node.func.value):
            hits.append((node.lineno, name))
        elif name == "open" and isinstance(node.func, ast.Attribute) and holds(node.func.value) and write_flag(node, 0):
            hits.append((node.lineno, "Path.open for writing"))
    return hits


def other_writer_files(files):
    return sorted(rel for rel, text in files if rel != WRITER_FILE and audit_writes(text))


def action_call_findings(text):
    """(line, call, source) of each audit(...) / _audited(...) / write_audit(...) call whose action is not a literal string, a literal
    ternary (both branches literal) or a *_ACTION constant. Inside audit() and _audited() themselves only their own action parameter passes."""
    tree = ast.parse(text)
    consts = {t.id for n in tree.body if isinstance(n, ast.Assign) for t in n.targets if isinstance(t, ast.Name) and t.id.endswith("_ACTION")}
    seen = []

    def literal(node, params):
        if isinstance(node, ast.Constant) and isinstance(node.value, str):
            return True
        if isinstance(node, ast.Name):
            return node.id in consts or node.id in params
        return isinstance(node, ast.IfExp) and literal(node.body, params) and literal(node.orelse, params)

    def visit(node, params):
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            params = {a.arg for a in node.args.args if a.arg == "action"} if node.name in FORWARDING and "action" in {a.arg for a in node.args.args} else set()
        if isinstance(node, ast.Call):
            name = node.func.attr if isinstance(node.func, ast.Attribute) else getattr(node.func, "id", "")
            if name in ACTION_CALLS:
                exprs = []
                index = ACTION_CALLS[name]
                if index is not None:
                    keyword = [k.value for k in node.keywords if k.arg == "action"]
                    if keyword:
                        exprs = keyword
                    elif len(node.args) > index:
                        exprs = [node.args[index]]
                    elif name != "audit" or len(node.args) >= 3:
                        exprs = [None]
                else:
                    for arg in node.args:
                        if isinstance(arg, ast.Dict):
                            exprs += [v for k, v in zip(arg.keys, arg.values) if isinstance(k, ast.Constant) and k.value == "action"]
                    if not exprs:
                        exprs = [None]
                for expr in exprs:
                    seen.append((node.lineno, name, "<missing>" if expr is None else ast.unparse(expr), expr is not None and literal(expr, params)))
        for child in ast.iter_child_nodes(node):
            visit(child, params)

    visit(tree, set())
    return seen


# Callers that may pass something else than a literal, with the reason. It stays empty.
ALLOWED_CALL_FINDINGS = {}


def call_findings(files):
    """The calls of cloud_worker.py and of every other file that writes the audit file (by audit_writes)."""
    out = []
    for rel, text in files:
        if rel != WRITER_FILE and not audit_writes(text):
            continue
        for lineno, name, source, ok_ in action_call_findings(text):
            if not ok_ and (rel, lineno) not in ALLOWED_CALL_FINDINGS:
                out.append("%s line %d: %s(... %s ...)" % (rel, lineno, name, source))
    return out


class TestOtherWritersAndCallers(unittest.TestCase):
    """The names walk reads cloud_worker.py. This guards the rest: no other file writes the audit file, and every call of the
    forwarding functions passes its action as a literal."""

    @classmethod
    def setUpClass(cls):
        cls.files = audit_scan_files()
        cls.worker_text = dict(cls.files)[WRITER_FILE]

    def test_no_other_file_writes_the_audit_file(self):
        writers = sorted(rel for rel, text in self.files if audit_writes(text))
        print("files that name the audit file (%d): %s" % (len(self.files), ", ".join(rel for rel, _ in self.files)))
        print("files that write it: %s" % ", ".join(writers))
        self.assertEqual(writers, [WRITER_FILE])
        self.assertEqual(other_writer_files(self.files), [], "another file writes the audit file")

    def test_a_write_in_another_file_is_caught(self):
        run_record_text = (ROOT / "cloud" / "launcher" / "run_record.py").read_text()
        scratch = run_record_text + "\n\ndef scratch_write(path):\n    write_audit(path, {'action': 'stop'})\n"
        self.assertNotEqual(scratch, run_record_text)
        files = [(rel, scratch if rel == "cloud/launcher/run_record.py" else text) for rel, text in self.files]
        self.assertEqual(other_writer_files(files), ["cloud/launcher/run_record.py"])
        opened = run_record_text + "\n\ndef scratch_open(env):\n    audit = env['CW_CLOUD_AUDIT']\n    return open(audit, 'a')\n"
        self.assertEqual(other_writer_files([("cloud/launcher/run_record.py", opened)]), ["cloud/launcher/run_record.py"])

    def test_every_call_passes_its_action_as_a_literal(self):
        for rel, text in self.files:
            if rel != WRITER_FILE and not audit_writes(text):
                continue
            for lineno, name, source, ok_ in action_call_findings(text):
                print("%s line %d: %s action %s%s" % (rel, lineno, name, source, "" if ok_ else "  FINDING"))
        self.assertEqual(call_findings(self.files), [], "an audit action that is not a literal")
        self.assertEqual(ALLOWED_CALL_FINDINGS, {})
        self.assertGreaterEqual(len(action_call_findings(self.worker_text)), 15)

    def test_a_call_with_a_variable_action_is_caught(self):
        old = 'return self._audited(worker, "stop", go, audit_reason)'
        self.assertEqual(self.worker_text.count(old), 1)
        scratch = self.worker_text.replace(old, 'action = "stop"\n        return self._audited(worker, action, go, audit_reason)')
        self.assertNotEqual(scratch, self.worker_text)
        found = call_findings([(WRITER_FILE, scratch)])
        self.assertEqual(len(found), 1, found)
        self.assertIn("%s line " % WRITER_FILE, found[0])
        self.assertIn("_audited(... action ...)", found[0])
        print("mutant finding: %s" % found[0])
        for variant in ('f"s{a}"', "a if x else b", "name"):
            again = self.worker_text.replace(old, "return self._audited(worker, %s, go, audit_reason)" % variant)
            self.assertEqual(len(call_findings([(WRITER_FILE, again)])), 1, variant)


def mock_stderr(stream):
    import contextlib
    return contextlib.redirect_stderr(stream)


if __name__ == "__main__":
    result = unittest.main(exit=False, verbosity=1).result
    ok_ = result.wasSuccessful()
    print("RESULT: %s" % ("PASS" if ok_ else "FAIL"))
    sys.exit(0 if ok_ else 1)
