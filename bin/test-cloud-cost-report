#!/usr/bin/env python3
"""test-cloud-cost-report: offline tests for bin/cloud_cost_report.py, on fixture audit files.

Each rule has a mutant: the module source is changed in one place and the same case must then fail.

    bin/test-cloud-cost-report
"""
import io
import json
import sys
import tempfile
import types
import unittest
from pathlib import Path

BIN = Path(__file__).resolve().parent
SOURCE = (BIN / "cloud_cost_report.py").read_text()
DAY = "2026-10-14"


def load(source=SOURCE):
    module = types.ModuleType("cloud_cost_report_under_test")
    exec(compile(source, "cloud_cost_report.py", "exec"), module.__dict__)
    return module


def mutant(old, new):
    assert SOURCE.count(old) == 1, old
    return SOURCE.replace(old, new)


REAL = load()


def line(ts, rid, action, cost, ok=True, worker="widget-service"):
    return {"ts": ts, "worker": worker, "runtime_id": rid, "action": action, "cost_estimate_usd": cost, "ok": ok}


def write(tmp, name, lines, raw=None):
    path = Path(tmp) / name
    path.write_text(raw if raw is not None else "".join(json.dumps(l) + "\n" for l in lines))
    return str(path)


def run(module, path, day=DAY, extra=("--node-price", "0.5", "--node-count", "2", "--node-hours", "10")):
    out = io.StringIO()
    code = module.main([day, path, *extra], out)
    return code, out.getvalue()


STOPPED = [
    line("2026-10-14T01:00:00Z", "pod/cb-example-1", "create", 0),
    line("2026-10-14T03:00:00Z", "pod/cb-example-1", "stop", 0.25),
]


class TestReport(unittest.TestCase):
    def check(self, module, lines, **kw):
        with tempfile.TemporaryDirectory() as tmp:
            return run(module, write(tmp, "audit.jsonl", lines), **kw)

    def test_a_stopped_pod_costs_its_stop_line_plus_nodes(self):
        code, text = self.check(REAL, STOPPED)
        self.assertEqual(code, 0)
        self.assertIn("USD 10.25 per day", text)
        self.assertIn("pods: 1, pod-hours 2.00", text)
        self.assertIn("node-hours 20.00", text)

    def test_a_pod_without_stop_is_costed_to_the_end_of_the_day_and_says_so(self):
        code, text = self.check(REAL, [line("2026-10-14T20:00:00Z", "pod/cb-example-2", "create", 0)],
                                extra=("--node-price", "0", "--node-count", "0", "--node-hours", "0", "--pod-rate", "0.1"))
        self.assertEqual(code, 0)
        self.assertIn("costed to the end of the day", text)
        self.assertIn("USD 0.40 per day", text)

    def test_ok_false_lines_are_listed_not_costed(self):
        bad = line("2026-10-14T04:00:00Z", "pod/cb-example-3", "stop", 9.0, ok=False)
        code, text = self.check(REAL, STOPPED + [bad])
        self.assertEqual(code, 0)
        self.assertIn("not costed (ok false) line 3", text)
        self.assertIn("USD 10.25 per day", text)

    def test_a_day_with_no_lines_prints_0_with_the_reason(self):
        code, text = self.check(REAL, STOPPED, day="2026-10-15")
        self.assertEqual(code, 0)
        self.assertIn("USD 0 (no audit lines on this day)", text)

    def test_a_stop_twice_for_one_pod_counts_once(self):
        code, text = self.check(REAL, STOPPED + [line("2026-10-14T05:00:00Z", "pod/cb-example-1", "stop", 0.5)])
        self.assertIn("pods: 1,", text)
        self.assertIn("USD 10.50 per day", text)

    def test_malformed_input_exits_2_in_one_line(self):
        with tempfile.TemporaryDirectory() as tmp:
            for raw in ("not json\n", '{"ts": "x"}\n', json.dumps(dict(STOPPED[0], ts="yesterday")) + "\n",
                        json.dumps(dict(STOPPED[0], action="reboot")) + "\n"):
                out = io.StringIO()
                err = io.StringIO()
                old, sys.stderr = sys.stderr, err
                try:
                    code = REAL.main([DAY, write(tmp, "bad.jsonl", None, raw), "--node-price", "1", "--node-count", "1", "--node-hours", "1"], out)
                finally:
                    sys.stderr = old
                self.assertEqual(code, 2, raw)
                self.assertEqual(len(err.getvalue().splitlines()), 1)
                self.assertNotIn("Traceback", err.getvalue())
            self.assertEqual(REAL.main([DAY, str(Path(tmp) / "missing"), "--node-price", "1", "--node-count", "1", "--node-hours", "1"], io.StringIO()), 2)
            self.assertEqual(REAL.main(["14-10-2026", "x"], io.StringIO()), 2)


class TestMutants(unittest.TestCase):
    def fails(self, source, case):
        try:
            case(load(source))
        except AssertionError:
            return True
        return False

    def stopped_case(self, module):
        with tempfile.TemporaryDirectory() as tmp:
            code, text = run(module, write(tmp, "a.jsonl", STOPPED))
        assert "USD 10.25 per day" in text, text

    def test_ignoring_stop_lines_is_caught(self):
        self.assertTrue(self.fails(mutant('if l["action"] == "stop":', 'if False:'), self.stopped_case))

    def test_double_counting_a_stopped_pod_is_caught(self):
        src = mutant('if l["action"] == "create" and l["runtime_id"] not in stopped:', 'if l["action"] == "create":')
        def case(module):
            with tempfile.TemporaryDirectory() as tmp:
                code, text = run(module, write(tmp, "a.jsonl", STOPPED), extra=("--node-price", "0", "--node-count", "0", "--node-hours", "0", "--pod-rate", "1"))
            assert "pods: 1," in text, text
        self.assertTrue(self.fails(src, case))

    def test_costing_a_failed_line_is_caught(self):
        src = mutant('good = [l for l in today if l["ok"]]', 'good = list(today)')
        def case(module):
            bad = line("2026-10-14T04:00:00Z", "pod/cb-example-3", "stop", 9.0, ok=False)
            with tempfile.TemporaryDirectory() as tmp:
                code, text = run(module, write(tmp, "a.jsonl", STOPPED + [bad]))
            assert "USD 10.25 per day" in text, text
        self.assertTrue(self.fails(src, case))

    def test_reading_another_file_is_caught(self):
        src = mutant("open(path, encoding=\"utf-8\")", "open(path + '.other', encoding=\"utf-8\")")
        def case(module):
            with tempfile.TemporaryDirectory() as tmp:
                path = write(tmp, "a.jsonl", STOPPED)
                write(tmp, "a.jsonl.other", [line("2026-10-14T03:00:00Z", "pod/cb-example-9", "stop", 7.0)])
                code, text = run(module, path)
            assert code == 0 and "USD 10.25 per day" in text, text
        self.assertTrue(self.fails(src, case))


if __name__ == "__main__":
    result = unittest.main(exit=False, verbosity=1).result
    ok_ = result.wasSuccessful()
    print("RESULT: %s" % ("PASS" if ok_ else "FAIL"))
    sys.exit(0 if ok_ else 1)
