#!/usr/bin/env python3
"""test-cloud-way-back: offline tests for bin/cloud_way_back_check.py (slice 6a of the plan on #1059, scenario S6).

The real check is driven with fixture directories. Each rule has a case that asserts the specific MISSING line, and a mutant:
the module's source is changed in one place and the same case must then fail (a case that passes on the mutant proves nothing).

    bin/test-cloud-way-back
"""
import hashlib
import io
import json
import sys
import tempfile
import types
import unittest
from pathlib import Path

BIN = Path(__file__).resolve().parent
SOURCE = (BIN / "cloud_way_back_check.py").read_text()
SENTINEL = "SENTINEL-sk-live-0123456789"


def load(source=SOURCE):
    module = types.ModuleType("cloud_way_back_check_under_test")
    exec(compile(source, "cloud_way_back_check.py", "exec"), module.__dict__)
    return module


def mutant(old, new):
    assert SOURCE.count(old) == 1, old
    return load(SOURCE.replace(old, new))


def tree_hash(root):
    return sorted((str(p.relative_to(root)), hashlib.sha256(p.read_bytes()).hexdigest()) for p in root.rglob("*") if p.is_file())


def write_fixture(root, **change):
    """A complete fixture. Phase after-start by default; in phase done the tarball and the export are deleted (unless keep=True)."""
    keep = change.pop("keep", False)
    phase = change.get("phase", "after-start")
    if phase != "done" or keep:
        (root / "snap.tar").write_bytes(b"state")
        (root / "orch.json").write_text("{}")
    state = {"phase": phase, "cloud_daemon": {"running": False}, "local_daemon": {"running": True},
             "snapshot": {"file": "snap.tar", "sha256": hashlib.sha256(b"state").hexdigest(), "removed": phase == "done"},
             "cloud_agents": ["a", "b"], "local_agents": ["a", "b", "c"],
             "orchestrators": [{"name": "o", "export": "orch.json"}],
             "import": {"dir": "/tmp/wayback-import", "agent_dirs": ["/work/x"], "copies_remaining": []},
             "note": SENTINEL}
    state.update(change)
    (root / "way-back.json").write_text(json.dumps(state))
    return root


def run(module, raw=None, **change):
    """(exit code, output, files unchanged by the check). The fixture lives in tmp/fx; tmp/outside.json is a real file beside it."""
    with tempfile.TemporaryDirectory() as tmp:
        root = Path(tmp) / "fx"
        root.mkdir()
        (Path(tmp) / "outside.json").write_text("{}")
        write_fixture(root, **change)
        if raw is not None:
            (root / "way-back.json").write_text(raw)
        before = tree_hash(root)
        out = io.StringIO()
        code = module.main([str(root)], out)
        return code, out.getvalue(), before == tree_hash(root)


def verdict(module, **change):
    """(code, text), or (None, error) when the module raised or wrote: a crash is never a pass."""
    try:
        code, text, same = run(module, **change)
        return (code if same else None), text
    except Exception as err:  # a mutant may crash; that counts as caught
        return None, repr(err)


def fails_with(module, line, **change):
    code, text = verdict(module, **change)
    return code == 1 and any(l.startswith(line) for l in text.splitlines())


def passes(module, **change):
    code, text = verdict(module, **change)
    return code == 0 and "WAY BACK READY" in text


REAL = load()


def IMPORT(**kw):
    return {"import": dict({"dir": "/tmp/wayback-import", "agent_dirs": ["/work/x"], "copies_remaining": []}, **kw)}


SAME = ("MISSING import_dir_dedicated: shared with 1 live agent directories",)
# name: (expected line start, fixture change, [mutants (old, new)])
CASES = {
    "cloud_running": ("MISSING cloud_daemon_stopped: cloud daemon running", dict(cloud_daemon={"running": True}),
                      [('add("cloud_daemon_stopped", cloud is False,', 'add("cloud_daemon_stopped", True,')]),
    "cloud_none": ("MISSING cloud_daemon_stopped: cloud daemon state unknown", dict(cloud_daemon=None),
                   [('add("cloud_daemon_stopped", cloud is False,', 'add("cloud_daemon_stopped", not cloud,')]),
    "local_not_running_after_start": ("MISSING only_the_local_daemon: cloud False, local False", dict(local_daemon={"running": False}),
                                      [("local is True and cloud is False", "True")]),
    "both_alive_before_start": ("MISSING no_daemon_alive: cloud True, local True",
                                dict(phase="before-start", cloud_daemon={"running": True}, local_daemon={"running": True}),
                                [("local is False and cloud is False", "True")]),
    "local_alive_before_start": ("MISSING no_daemon_alive: cloud False, local True", dict(phase="before-start"),
                                 [("local is False and cloud is False", "not (cloud and local)")]),
    "phase_unknown": ("MISSING phase_known: phase unknown", dict(phase="bogus"), [('phase in PHASES, "phase', 'True, "phase')]),
    "snapshot_file_missing": ("MISSING snapshot_matches: snapshot file missing", dict(snapshot={"file": "nope.tar", "sha256": "0" * 64}),
                              [("if path is None or not path.is_file():", "if False:")]),
    "snapshot_wrong_checksum": ("MISSING snapshot_matches: checksum differs", dict(snapshot={"file": "snap.tar", "sha256": "0" * 64}),
                                [('digest == snap.get("sha256"), "checksum', 'True, "checksum')]),
    "agents_lost": ("MISSING agents_restored: 1 of 2 agents missing locally: b", dict(local_agents=["a"]),
                    [("bool(cloud_agents) and not lost", "bool(cloud_agents)")]),
    "no_cloud_agents": ("MISSING agents_restored: 0 of 0", dict(cloud_agents=[], local_agents=[]),
                        [("bool(cloud_agents) and not lost", "not lost")]),
    "export_missing": ("MISSING orchestrator_exports: exports missing for: o", dict(orchestrators=[{"name": "o", "export": "nope.json"}]),
                       [('add("orchestrator_exports", not absent,', 'add("orchestrator_exports", True,')]),
    "export_escapes_to_a_real_file": ("MISSING orchestrator_exports: exports missing for: o", dict(orchestrators=[{"name": "o", "export": "../outside.json"}]),
                                      [("    try:\n        path.relative_to(root.resolve())\n    except ValueError:\n        return None\n", "")]),
    "fallback_value_unknown": ("MISSING orchestrator_exports: exports missing for: o", dict(orchestrators=[{"name": "o", "export_fallback": "other"}]),
                               [('item.get("export_fallback") != "resume_brief"', 'item.get("export_fallback") is None')]),
    "import_same_dir": (SAME[0], IMPORT(dir="/work/x"),
                        [('    if a == d:\n        return "same"', '    if False:\n        return "same"')]),
    "import_same_dir_spelled_with_dotdot": (SAME[0], IMPORT(dir="/work/y/../x"),
                                            [("return Path(os.path.normcase(str(Path(path).resolve())))", "return Path(os.path.normcase(str(Path(path))))")]),
    "agent_dir_inside_import_dir": (SAME[0], IMPORT(dir="/work", agent_dirs=["/work/x/sub"]),
                                    [("    if d in a.parents:", "    if False:")]),
    "import_dir_inside_agent_dir": (SAME[0], IMPORT(dir="/work/x/sub"),
                                    [("    if a in d.parents:", "    if False:")]),
    "no_import_dir": ("MISSING import_dir_dedicated: no import directory named", {"import": {"agent_dirs": []}},
                      [("bool(directory) and not shared", "not shared")]),
    "copy_remains": ("MISSING import_copy_deleted: 1 imported copies remain", dict(phase="done", **IMPORT(copies_remaining=["ses_1"])),
                     [('add("import_copy_deleted", not left,', 'add("import_copy_deleted", True,')]),
    "snapshot_not_marked_removed": ("MISSING snapshot_removed", dict(phase="done", snapshot={"file": "snap.tar", "sha256": "0", "removed": False}),
                                    [('add("snapshot_removed", snap.get("removed") is True and not present,', 'add("snapshot_removed", True,')]),
    "snapshot_still_on_disk": ("MISSING snapshot_removed", dict(phase="done", keep=True),
                               [('add("snapshot_removed", snap.get("removed") is True and not present,', 'add("snapshot_removed", snap.get("removed") is True,')]),
}


class TestWayBack(unittest.TestCase):
    def test_a_complete_fixture_passes_in_each_phase_and_the_check_writes_nothing(self):
        for phase, extra in (("after-start", {}), ("done", {}), ("before-start", dict(local_daemon={"running": False}))):
            code, text, unchanged = run(REAL, phase=phase, **extra)
            self.assertEqual(code, 0, text)
            self.assertIn("WAY BACK READY", text)
            self.assertTrue(unchanged)

    def test_each_missing_thing_is_named_by_its_line_and_exits_1(self):
        for name, (line, change, _) in CASES.items():
            self.assertTrue(fails_with(REAL, line, **change), name)

    def test_every_case_is_caught_by_its_mutants(self):
        for name, (line, change, mutants) in CASES.items():
            self.assertTrue(mutants, name)
            for old, new in mutants:
                self.assertFalse(fails_with(mutant(old, new), line, **change), "%s survives %r" % (name, old))

    def test_a_sibling_directory_with_a_common_prefix_is_dedicated(self):
        self.assertTrue(passes(REAL, **IMPORT(dir="/work/x", agent_dirs=["/work/xy"])))

    def test_the_resume_brief_fallback_replaces_a_missing_export(self):
        change = dict(orchestrators=[{"name": "o", "export_fallback": "resume_brief"}])
        self.assertTrue(passes(REAL, **change))
        self.assertFalse(passes(mutant('item.get("export_fallback") != "resume_brief"', "True"), **change))

    def test_the_escape_target_really_exists(self):
        with tempfile.TemporaryDirectory() as tmp:
            root = Path(tmp) / "fx"
            root.mkdir()
            (Path(tmp) / "outside.json").write_text("{}")
            write_fixture(root, orchestrators=[{"name": "o", "export": "../outside.json"}])
            self.assertTrue((root / ".." / "outside.json").is_file())
            self.assertIsNone(REAL._inside(root, "../outside.json"))

    def test_the_fixture_files_are_unchanged_and_a_writing_mutant_is_caught(self):
        self.assertTrue(run(REAL)[2])
        writer = mutant("results = check(state, root)", 'results = check(state, root); (root / "way-back.json").write_text("{}")')
        self.assertFalse(run(writer)[2])

    def test_control_characters_and_long_names_are_not_printed(self):
        change = dict(cloud_agents=["evil\x1b[31mred\u202e", "x" * 200], local_agents=[])
        code, text, _ = run(REAL, **change)
        self.assertNotIn("\x1b", text)
        self.assertNotIn("\u202e", text)
        self.assertNotIn("x" * 61, text)
        self.assertIn("MISSING agents_restored", text)
        for old, new in (('c if c.isprintable() else "?"', "c"), ("return text[:MAX_SHOWN]", "return text")):
            _, text, _ = run(mutant(old, new), **change)
            self.assertTrue("\x1b" in text or "x" * 61 in text, old)

    def test_an_orchestrator_name_is_cleaned_too(self):
        _, text, _ = run(REAL, orchestrators=[{"name": "o\x1b[2J", "export": "nope"}])
        self.assertNotIn("\x1b", text)
        self.assertIn("o?[2J", text)

    def test_a_secret_planted_in_the_fixture_is_never_printed(self):
        change = dict(orchestrators=[{"name": "o", "export": "nope", "token": SENTINEL}], cloud_daemon={"running": True})
        code, text, _ = run(REAL, **change)
        self.assertEqual(code, 1)
        self.assertNotIn(SENTINEL, text)
        echo = mutant("results = check(state, root)", "results = check(state, root); out.write(repr(state))")
        self.assertIn(SENTINEL, run(echo, **change)[1])

    def test_malformed_fixtures_exit_2_with_one_line(self):
        bad = {
            "invalid json": ("{not json", ("except (OSError, ValueError, RecursionError)", "except OSError")),
            "root is a list": ("[]", ('_need(isinstance(state, dict), "(root)")', '_need(True, "(root)")')),
            "orchestrator entry is a string": (json.dumps({"orchestrators": ["x"]}), ('_need(isinstance(item, dict), "orchestrators[]")', '_need(True, "orchestrators[]")')),
            "agents is a string": (json.dumps({"cloud_agents": "ab"}), ("_need(isinstance(value, list) and all(isinstance(v, str) for v in value), field)", "_need(True, field)")),
            "running is a string": (json.dumps({"cloud_daemon": {"running": "yes"}}), ('_need(running is None or isinstance(running, bool), key + ".running")', '_need(True, key + ".running")')),
            "import is a list": (json.dumps({"import": []}), ('for key in ("cloud_daemon", "local_daemon", "snapshot", "import"):', "for key in ():")),
        }
        for name, (raw, (old, new)) in bad.items():
            code, text, _ = run(REAL, raw=raw)
            self.assertEqual(code, 2, name)
            self.assertEqual(len(text.splitlines()), 1, name)
            self.assertTrue(text.startswith("cannot read way-back.json"), name)
            self.assertNotIn("Traceback", text)
            try:
                code, _, _ = run(mutant(old, new), raw=raw)
            except Exception:
                code = None
            self.assertNotEqual(code, 2, "%s survives %r" % (name, old))

    def test_an_unreadable_fixture_and_a_bad_command_line_exit_2(self):
        with tempfile.TemporaryDirectory() as tmp:
            self.assertEqual(REAL.main([tmp], io.StringIO()), 2)
        self.assertEqual(REAL.main([], io.StringIO()), 2)

    def test_the_exit_code_is_1_when_anything_is_missing(self):
        self.assertFalse(fails_with(mutant("return 1 if missing else 0", "return 0"), "MISSING cloud_daemon_stopped", cloud_daemon={"running": True}))


if __name__ == "__main__":
    result = unittest.main(exit=False, verbosity=1).result
    ok_ = result.wasSuccessful()
    print("RESULT: %s" % ("PASS" if ok_ else "FAIL"))
    sys.exit(0 if ok_ else 1)
