#!/usr/bin/env python3
"""proof-switchboard: the Switchboard Lab and its scripted model.

The Lab is an isolated OpenCode v2 install that the live fleet (OpenCode v1)
never sees. Everything v2 writes stays under one directory:

    $LAB = ${XDG_DATA_HOME:-~/.local/share}/fleet-switchboard-lab
      v2/       pinned OpenCode v2 (npm --prefix, never -g, never on PATH)
      bin/      `opencode` wrapper that always sets the Lab env, then execs v2
      profile/  scratch XDG dirs: config, data, state, cache, tmp, home
      repo/     scratch git repo, local identity only
      backup/   snapshots of the live dirs taken before risky experiments
      runs/     pidfiles, logs, evidence

Subcommands:

    lab env                     print `export` lines for the Lab env (no secrets)
    lab init [--port N]         idempotent setup: dirs, v2 install, wrapper,
                                scratch repo, provider config, agent copies
    lab status                  what is installed and running, and whether the
                                live dirs carry any v2 state
    scripted-model --port N --log FILE
                                local OpenAI-compatible model driven by
                                `@script` lines in the last user message
    session create|synthetic|wait-idle|transcript
                                Lab v2 session helpers (`opencode api`)
    model-requests --since T [--marker M]
                                what the scripted model was asked since T
    spike s3|s4|s5              note, wake and reading-back spikes (API side)
    spike s6 --pane P --agent A --session S
                                draft safety, herdr status and the unread
                                token, in a "Switchboard Lab" pane already
                                running the Lab TUI on S as herdr agent A

Script directives (one line in the last user message):

    @script reply=PONG
    @script sleep=20 reply=DONE
    @script tool=bash cmd="echo hi" reply=DONE
    @script tool=write arg.filePath=notes.txt arg.content=hello reply=WROTE
    @script error=500

Tokens are read in order. `tool=` starts a step; `cmd=`, `args=<json>` and
`arg.<name>=` fill that step's arguments; `sleep=` delays the step that
follows it. Each request answers the first step not yet taken, counted by the
assistant tool calls after the last user message; when every tool step is
done it replies with `reply=`.

Python 3.9 standard library only.
"""

import argparse
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import threading
import time
import uuid
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

V2_VERSION = "2.0.22"
V2_PACKAGE = "@opencode/cli"
DEFAULT_PORT = 47810
SCRIPTED_PROVIDER = "scripted"
SCRIPTED_MODEL = "lab"
KIT_AGENTS = ("orchestrator", "coder", "chief-of-staff")
REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

# Live OpenCode / herdr locations. The Lab only ever reads these.
LIVE_DIRS = (
    "~/.config/opencode",
    "~/.local/share/opencode",
    "~/.local/state/opencode",
    "~/.cache/opencode",
    "~/.config/herdr",
    "~/.local/state/herdr",
)


# --------------------------------------------------------------------------
# Lab layout and environment


def lab_root():
    # Inside the Lab env XDG_DATA_HOME points into the profile; keep the root.
    marker = os.environ.get("FLEET_SWITCHBOARD_LAB_DIR")
    if marker:
        return marker
    base = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    return os.path.join(base, "fleet-switchboard-lab")


# Ambient credentials the Lab's v2 must never inherit. v2 activates a provider
# from its env var alone (OPENROUTER_API_KEY showed 300+ OpenRouter models).
CREDENTIAL_PATTERN = re.compile(
    r"(_API_KEY|_TOKEN|_SECRET|_PASSWORD|_ACCESS_KEY|_ACCESS_KEY_ID)$|^(GH|GITHUB|COPILOT)_"
)


def credential_names(env):
    return sorted(name for name in env if CREDENTIAL_PATTERN.search(name))


# herdr sets these in every pane. The runner's own calls (and any v2 service
# they start) must not carry a live pane's identity into the Lab.
HERDR_PANE_VARS = ("HERDR_ENV", "HERDR_PANE_ID", "HERDR_SOCKET_PATH", "HERDR_TAB_ID",
                   "HERDR_WORKSPACE_ID")


def herdr_names(env):
    return [name for name in HERDR_PANE_VARS if name in env]


class Lab:
    def __init__(self, root=None):
        self.root = root or lab_root()
        self.v2_dir = os.path.join(self.root, "v2")
        self.v2_bin = os.path.join(
            self.v2_dir, "node_modules", "@opencode", "cli", "bin", "opencode.exe"
        )
        self.bin_dir = os.path.join(self.root, "bin")
        self.wrapper = os.path.join(self.bin_dir, "opencode")
        self.profile = os.path.join(self.root, "profile")
        self.repo = os.path.join(self.root, "repo")
        self.backup = os.path.join(self.root, "backup")
        self.runs = os.path.join(self.root, "runs")
        self.opencode_config = os.path.join(self.profile, "config", "opencode")
        self.state_file = os.path.join(self.root, "lab.json")

    def env(self):
        """The variables that confine v2 to the Lab. No secrets."""
        p = self.profile
        return {
            "FLEET_SWITCHBOARD_LAB": "1",
            "FLEET_SWITCHBOARD_LAB_DIR": self.root,
            "XDG_CONFIG_HOME": os.path.join(p, "config"),
            "XDG_DATA_HOME": os.path.join(p, "data"),
            "XDG_STATE_HOME": os.path.join(p, "state"),
            "XDG_CACHE_HOME": os.path.join(p, "cache"),
            "TMPDIR": os.path.join(p, "tmp"),
        }

    def full_env(self):
        """The Lab env for this process's children: no ambient credentials, no
        live herdr pane identity, the Lab's bin first on PATH."""
        env = dict(os.environ)
        for name in credential_names(env) + herdr_names(env):
            del env[name]
        env.update(self.env())
        env["PATH"] = self.bin_dir + os.pathsep + env.get("PATH", "")
        return env

    def v2_env(self):
        """full_env plus HOME: with XDG alone v2 still resolves `home` to the
        real one and loads ~/.claude/skills, ~/.agents/skills (the live fleet's
        skills). Only v2 processes get the Lab HOME; shells keep theirs."""
        env = self.full_env()
        env["HOME"] = os.path.join(self.profile, "home")
        return env

    def settings(self):
        try:
            with open(self.state_file) as f:
                return json.load(f)
        except (OSError, ValueError):
            return {}

    def save_settings(self, data):
        with open(self.state_file, "w") as f:
            json.dump(data, f, indent=2, sort_keys=True)
            f.write("\n")

    def port(self):
        return int(self.settings().get("scripted_port", DEFAULT_PORT))

    def v2(self, *args, timeout=60, data=None):
        """Run v2 through the Lab env. Returns CompletedProcess."""
        return subprocess.run(
            [self.v2_bin] + list(args),
            env=self.v2_env(),
            input=data,
            capture_output=True,
            text=True,
            timeout=timeout,
        )


WRAPPER = """#!/bin/sh
# Switchboard Lab: OpenCode v2 confined to the Lab profile.
# Written by `proof-switchboard lab init`. Never put this on the live PATH.
LAB="{root}"
export FLEET_SWITCHBOARD_LAB=1 FLEET_SWITCHBOARD_LAB_DIR="$LAB"
export XDG_CONFIG_HOME="$LAB/profile/config" XDG_DATA_HOME="$LAB/profile/data"
export XDG_STATE_HOME="$LAB/profile/state" XDG_CACHE_HOME="$LAB/profile/cache"
export TMPDIR="$LAB/profile/tmp"
# XDG alone leaves `home` live: v2 would load ~/.claude/skills, ~/.agents/skills.
export HOME="$LAB/profile/home"
# Never hand ambient credentials to the Lab's v2.
for name in $(env | sed -n 's/^\\([A-Za-z_][A-Za-z0-9_]*\\)=.*/\\1/p' \\
    | grep -E '(_API_KEY|_TOKEN|_SECRET|_PASSWORD|_ACCESS_KEY|_ACCESS_KEY_ID)$|^(GH|GITHUB|COPILOT)_'); do
  unset "$name"
done
# herdr's pane identity belongs to Lab panes only. Called from any other pane
# (a live agent's shell), drop it, so neither a TUI plugin nor a service
# started from here can report into that live pane.
if [ "$FLEET_SWITCHBOARD_LAB_PANE" != "1" ]; then
  unset HERDR_ENV HERDR_PANE_ID HERDR_SOCKET_PATH HERDR_TAB_ID HERDR_WORKSPACE_ID
fi
exec "$LAB/v2/node_modules/@opencode/cli/bin/opencode.exe" "$@"
"""


def shell_quote(value):
    return shlex.quote(value)


def cmd_lab_env(lab, _args):
    names = credential_names(os.environ)
    if names:
        print("unset %s" % " ".join(names))
    for key, value in lab.env().items():
        print("export %s=%s" % (key, shell_quote(value)))
    print("export PATH=%s:\"$PATH\"" % shell_quote(lab.bin_dir))
    print("export OPENCODE_V2=%s" % shell_quote(lab.v2_bin))
    return 0


# --------------------------------------------------------------------------
# lab init


def provider_config(port):
    return {
        "$schema": "https://opencode.ai/config.json",
        "update": "disable",
        "share": "disabled",
        "model": "%s/%s" % (SCRIPTED_PROVIDER, SCRIPTED_MODEL),
        # Only the scripted model may be used, whatever credentials leak in.
        "experimental": {
            "policies": [
                {"action": "provider.use", "resource": "*", "effect": "deny"},
                {"action": "provider.use", "resource": SCRIPTED_PROVIDER, "effect": "allow"},
            ]
        },
        "providers": {
            SCRIPTED_PROVIDER: {
                "name": "Lab scripted model",
                "package": "@opencode/ai/providers/openai-compatible",
                "settings": {
                    "baseURL": "http://127.0.0.1:%d/v1" % port,
                    "apiKey": "lab-scripted-no-secret",
                },
                "models": {
                    SCRIPTED_MODEL: {
                        "name": "Lab scripted",
                        "limit": {"context": 200000, "output": 8192},
                    }
                },
            }
        },
    }


def agent_copy(text, model):
    """Kit agent file -> Lab agent file: only the model placeholder changes.

    v2 2.0.22 reads the kit's v1 `permission:` frontmatter itself (bash ->
    shell, edit, read, ...), checked with `opencode api agent.list` (S1).
    """
    return text.replace("__PROVIDER__/__MODEL_ID__", model)


def ensure_v2(lab):
    if os.path.exists(lab.v2_bin) and v2_version(lab) == V2_VERSION:
        return "present"
    os.makedirs(lab.v2_dir, exist_ok=True)
    # --ignore-scripts: the postinstall runs `opencode --version`, which would
    # log into the live data dir. Run it ourselves inside the Lab env.
    subprocess.run(
        ["npm", "install", "--prefix", lab.v2_dir, "--no-audit", "--no-fund",
         "--ignore-scripts", "%s@%s" % (V2_PACKAGE, V2_VERSION)],
        check=True,
    )
    pkg = os.path.join(lab.v2_dir, "node_modules", "@opencode", "cli")
    subprocess.run(["node", "./postinstall.mjs"], cwd=pkg, env=lab.v2_env(), check=True)
    return "installed"


def v2_version(lab):
    if not os.path.exists(lab.v2_bin):
        return None
    try:
        out = lab.v2("--version", timeout=30).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return None
    return out.split("v")[-1] if out else None


def ensure_repo(lab):
    if os.path.isdir(os.path.join(lab.repo, ".git")):
        return "present"
    os.makedirs(lab.repo, exist_ok=True)

    def git(*a):
        subprocess.run(["git", "-C", lab.repo] + list(a), check=True,
                       capture_output=True, text=True)

    git("init", "-q", "-b", "main")
    git("config", "user.name", "Switchboard Lab")
    git("config", "user.email", "lab@switchboard.invalid")
    git("config", "commit.gpgsign", "false")
    with open(os.path.join(lab.repo, "README.md"), "w") as f:
        f.write("# Switchboard Lab scratch repo\n\nWork here is disposable.\n")
    git("add", "README.md")
    git("-c", "core.hooksPath=/dev/null", "commit", "-q", "-m", "Lab: initial commit")
    return "created"


def write_if_changed(path, content):
    try:
        with open(path) as f:
            if f.read() == content:
                return False
    except OSError:
        pass
    with open(path, "w") as f:
        f.write(content)
    return True


def cmd_lab_init(lab, args):
    settings = lab.settings()
    port = args.port or settings.get("scripted_port") or DEFAULT_PORT
    report = {}
    for d in (lab.v2_dir, lab.bin_dir, lab.backup, lab.runs, lab.opencode_config,
              os.path.join(lab.opencode_config, "agents")):
        os.makedirs(d, exist_ok=True)
    for name in ("config", "data", "state", "cache", "tmp", "home"):
        os.makedirs(os.path.join(lab.profile, name), exist_ok=True)
    report["v2"] = ensure_v2(lab)
    if write_if_changed(lab.wrapper, WRAPPER.format(root=lab.root)):
        os.chmod(lab.wrapper, 0o755)
        report["wrapper"] = "written"
    report["repo"] = ensure_repo(lab)
    cfg = json.dumps(provider_config(port), indent=2) + "\n"
    report["config"] = "written" if write_if_changed(
        os.path.join(lab.opencode_config, "opencode.json"), cfg) else "unchanged"
    model = "%s/%s" % (SCRIPTED_PROVIDER, SCRIPTED_MODEL)
    for name in KIT_AGENTS:
        src = os.path.join(REPO_ROOT, "agents", "opencode", name + ".md")
        with open(src) as f:
            text = agent_copy(f.read(), model)
        dst = os.path.join(lab.opencode_config, "agents", name + ".md")
        report["agent " + name] = "written" if write_if_changed(dst, text) else "unchanged"
    settings.update({"scripted_port": port, "v2_version": V2_VERSION})
    lab.save_settings(settings)
    report["herdr home link"] = ensure_home_link(lab)
    if args.herdr:
        report["herdr integration"] = ensure_herdr_integration(lab)
    for key, value in report.items():
        print("%-26s %s" % (key, value))
    return 0


def ensure_home_link(lab):
    """herdr installs its OpenCode integration into $HOME/.config/opencode and
    ignores XDG_CONFIG_HOME. Under the Lab's HOME that path is a link to the
    Lab's v2 config dir, so the install lands where v2 reads it."""
    link = os.path.join(lab.profile, "home", ".config", "opencode")
    os.makedirs(os.path.dirname(link), exist_ok=True)
    if os.path.islink(link) and os.readlink(link) == lab.opencode_config:
        return "present"
    if os.path.lexists(link):
        return "BLOCKED: %s exists and is not the Lab link" % link
    os.symlink(lab.opencode_config, link)
    return "created"


def herdr_lab_env(lab):
    return lab.v2_env()


def herdr_integration_status(lab):
    out = subprocess.run(["herdr", "integration", "status"], env=herdr_lab_env(lab),
                         capture_output=True, text=True, timeout=30).stdout
    return next((l for l in out.splitlines() if l.startswith("opencode:")), "")


def ensure_herdr_integration(lab):
    status = herdr_integration_status(lab)
    lab_home = os.path.join(lab.profile, "home") + os.sep
    # Refuse unless herdr resolves the target inside the Lab: never the live dir.
    if lab_home not in status:
        return "REFUSED: herdr would install outside the Lab: %s" % status
    if "current" in status:
        return "present"
    p = subprocess.run(["herdr", "integration", "install", "opencode"], env=herdr_lab_env(lab),
                       capture_output=True, text=True, timeout=60)
    lines = (p.stdout + p.stderr).strip().splitlines()
    if p.returncode or any("installed" in l and lab_home not in l for l in lines):
        return "FAILED: %s" % " | ".join(lines)
    return "installed (%s)" % herdr_integration_status(lab)


# --------------------------------------------------------------------------
# lab status


def pid_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except (OSError, TypeError):
        return False


def read_pid(path):
    try:
        with open(path) as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return None


def cmd_lab_status(lab, _args):
    ok = True
    print("lab        %s" % lab.root)
    version = v2_version(lab)
    print("v2         %s (%s)" % (version or "missing", lab.v2_bin))
    ok &= version == V2_VERSION
    if version:
        paths = lab.v2("debug", "paths").stdout
        outside = []
        for line in paths.splitlines():
            parts = line.split(None, 1)
            if len(parts) == 2 and not parts[1].startswith(lab.root):
                outside.append(line)
        print("paths      %s" % ("all under the Lab" if not outside else "OUTSIDE: %s" % outside))
        ok &= not outside
    service = os.path.join(lab.profile, "state", "opencode", "service.json")
    if os.path.exists(service):
        try:
            with open(service) as f:
                info = json.load(f)
            pid = info.get("pid")
            print("service    %s pid=%s alive=%s keys=%s" % (
                info.get("url"), pid, pid_alive(pid), sorted(info)))
        except (OSError, ValueError) as e:
            print("service    unreadable: %s" % e)
    else:
        print("service    not registered")
    pid = read_pid(os.path.join(lab.runs, "scripted-model.pid"))
    print("scripted   port=%d pid=%s alive=%s" % (lab.port(), pid, pid_alive(pid)))
    if shutil.which("herdr"):
        print("herdr      %s" % (herdr_integration_status(lab) or "unknown"))
    live_service = os.path.expanduser("~/.local/state/opencode/service.json")
    leaked = os.path.exists(live_service)
    print("live       service.json %s" % ("PRESENT (v2 state in the live dir!)" if leaked else "absent"))
    ok &= not leaked
    v1 = shutil.which("opencode")
    if v1:
        out = subprocess.run([v1, "--version"], capture_output=True, text=True).stdout.strip()
        print("v1         %s (%s)" % (out, v1))
    return 0 if ok else 1


# --------------------------------------------------------------------------
# Scripted model


def message_text(message):
    content = message.get("content")
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts = []
        for part in content:
            if isinstance(part, dict) and isinstance(part.get("text"), str):
                parts.append(part["text"])
            elif isinstance(part, str):
                parts.append(part)
        return "\n".join(parts)
    return ""


def parse_script(text):
    """Return the steps of the last `@script` line in text, or None."""
    line = None
    for candidate in text.splitlines():
        stripped = candidate.strip()
        if stripped.startswith("@script"):
            line = stripped[len("@script"):]
    if line is None:
        return None
    try:
        tokens = shlex.split(line)
    except ValueError:
        tokens = line.split()
    steps, current, sleep = [], None, 0.0
    script = {"steps": steps, "reply": None, "reply_sleep": 0.0, "error": None}
    for token in tokens:
        key, _, value = token.partition("=")
        if key == "sleep":
            try:
                sleep = float(value)
            except ValueError:
                pass
        elif key == "tool":
            current = {"tool": value, "args": {}, "cmd": None, "sleep": sleep}
            sleep = 0.0
            steps.append(current)
        elif key == "cmd" and current is not None:
            current["cmd"] = value
        elif key == "args" and current is not None:
            try:
                current["args"].update(json.loads(value))
            except ValueError:
                pass
        elif key.startswith("arg.") and current is not None:
            current["args"][key[4:]] = value
        elif key == "reply":
            script["reply"] = value
            script["reply_sleep"] = sleep
            sleep = 0.0
        elif key == "error":
            script["error"] = value
    if script["reply"] is None and sleep:
        script["reply_sleep"] = sleep
    return script


TOOL_ALIASES = {"bash": ("bash", "shell"), "shell": ("shell", "bash")}


def find_tool(tools, wanted):
    by_name = {}
    for tool in tools or []:
        fn = tool.get("function") if isinstance(tool, dict) else None
        if isinstance(fn, dict) and fn.get("name"):
            by_name[fn["name"]] = fn
    for name in TOOL_ALIASES.get(wanted, (wanted,)):
        if name in by_name:
            return name, by_name[name]
    return wanted, {}


def tool_arguments(step, schema):
    params = (schema or {}).get("parameters") or {}
    props = params.get("properties") or {}
    args = dict(step["args"])
    if step["cmd"] is not None:
        key = next((k for k in ("command", "cmd") if k in props), "command")
        args.setdefault(key, step["cmd"])
    for name in params.get("required") or []:
        if name not in args and (props.get(name) or {}).get("type") == "string":
            args[name] = "lab scripted step"
    return args


def plan_response(body):
    """Decide what the model says. Returns a dict describing the response."""
    messages = body.get("messages") if isinstance(body.get("messages"), list) else []
    tools = body.get("tools") if isinstance(body.get("tools"), list) else []
    last_user, after = None, []
    for i, message in enumerate(messages):
        if isinstance(message, dict) and message.get("role") == "user":
            last_user, after = message, messages[i + 1:]
    user_text = message_text(last_user) if last_user else ""
    system_text = "\n".join(
        message_text(m) for m in messages if isinstance(m, dict) and m.get("role") == "system"
    )
    if not tools:
        low = system_text.lower()
        if "title" in low:
            return {"kind": "title", "text": "lab"}
        if "summar" in low or "compact" in low:
            return {"kind": "summary", "text": "lab summary"}
    script = parse_script(user_text)
    if script is None:
        if not tools and len(system_text) < 4000:
            return {"kind": "maintenance", "text": "lab"}
        snippet = user_text.strip()[:60]
        return {"kind": "default", "text": "ACK: " + snippet}
    if script["error"]:
        return {"kind": "error", "status": script["error"]}
    done = sum(
        1 for m in after
        if isinstance(m, dict) and m.get("role") == "assistant" and m.get("tool_calls")
    )
    if done < len(script["steps"]) and tools:
        step = script["steps"][done]
        name, schema = find_tool(tools, step["tool"])
        return {
            "kind": "tool",
            "sleep": step["sleep"],
            "tool": name,
            "arguments": json.dumps(tool_arguments(step, schema)),
            "call_id": "call_" + uuid.uuid4().hex[:24],
        }
    return {"kind": "reply", "sleep": script["reply_sleep"],
            "text": script["reply"] if script["reply"] is not None else "DONE"}


class ScriptedModel(BaseHTTPRequestHandler):
    server_version = "LabScriptedModel/1"
    protocol_version = "HTTP/1.1"
    log_lock = threading.Lock()

    def log_message(self, fmt, *args):  # quiet stderr
        pass

    def record(self, entry):
        path = getattr(self.server, "log_path", None)
        if not path:
            return
        entry["time"] = time.time()
        with self.log_lock, open(path, "a") as f:
            f.write(json.dumps(entry) + "\n")

    def record_tools(self, tools):
        """Keep the latest full tool schemas beside the log (`<log>.tools.json`),
        so a script author can see each tool's argument names."""
        path = getattr(self.server, "log_path", None)
        if not path or not isinstance(tools, list) or not tools:
            return
        with self.log_lock, open(path + ".tools.json", "w") as f:
            json.dump(tools, f, indent=1)

    def send_json(self, status, payload):
        data = json.dumps(payload).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path.rstrip("/").endswith("/models"):
            self.send_json(200, {"object": "list", "data": [
                {"id": SCRIPTED_MODEL, "object": "model", "created": 0, "owned_by": "lab"}]})
        elif self.path.rstrip("/") in ("", "/health", "/v1"):
            self.send_json(200, {"ok": True})
        else:
            self.send_json(404, {"error": {"message": "not found", "type": "invalid_request_error"}})

    def do_POST(self):
        length = int(self.headers.get("Content-Length") or 0)
        raw = self.rfile.read(length) if length else b""
        try:
            body = json.loads(raw or b"{}")
            if not isinstance(body, dict):
                body = {}
        except ValueError:
            body = {}
        if not self.path.rstrip("/").endswith("/chat/completions"):
            self.record({"path": self.path, "unhandled": True})
            self.send_json(404, {"error": {"message": "only chat/completions", "type": "invalid_request_error"}})
            return
        try:
            plan = plan_response(body)
        except Exception as exc:  # never crash: answer plainly
            plan = {"kind": "fallback", "text": "lab", "exception": repr(exc)}
        logged = {k: v for k, v in body.items() if k != "tools"}
        logged["tools"] = [
            (t.get("function") or {}).get("name") for t in body.get("tools") or []
            if isinstance(t, dict)
        ]
        self.record_tools(body.get("tools"))
        self.record({"path": self.path, "request": logged, "plan": plan})
        if plan["kind"] == "error":
            try:
                status = int(plan["status"])
            except ValueError:
                status = 500
            self.send_json(status, {"error": {"message": "scripted error", "type": "server_error"}})
            return
        try:
            if body.get("stream"):
                self.stream(body, plan)
            else:
                self.complete(body, plan)
        except (BrokenPipeError, ConnectionResetError):
            self.record({"path": self.path, "client_gone": True, "plan_kind": plan["kind"]})

    def envelope(self, body):
        return {
            "id": "chatcmpl-" + uuid.uuid4().hex[:20],
            "created": int(time.time()),
            "model": body.get("model") or SCRIPTED_MODEL,
        }

    def complete(self, body, plan):
        time.sleep(plan.get("sleep") or 0)
        message = {"role": "assistant", "content": None}
        if plan["kind"] == "tool":
            message["tool_calls"] = [{
                "id": plan["call_id"], "type": "function",
                "function": {"name": plan["tool"], "arguments": plan["arguments"]}}]
            finish = "tool_calls"
        else:
            message["content"] = plan["text"]
            finish = "stop"
        payload = self.envelope(body)
        payload.update({
            "object": "chat.completion",
            "choices": [{"index": 0, "message": message, "finish_reason": finish}],
            "usage": {"prompt_tokens": 10, "completion_tokens": 5, "total_tokens": 15},
        })
        self.send_json(200, payload)

    def stream(self, body, plan):
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-cache")
        self.send_header("Connection", "close")
        self.end_headers()
        self.close_connection = True
        base = self.envelope(body)
        base["object"] = "chat.completion.chunk"

        def chunk(delta, finish=None):
            payload = dict(base)
            payload["choices"] = [{"index": 0, "delta": delta, "finish_reason": finish}]
            self.wfile.write(b"data: " + json.dumps(payload).encode() + b"\n\n")
            self.wfile.flush()

        chunk({"role": "assistant", "content": ""})
        # A long step keeps the stream open, so the turn reads as working.
        deadline = time.time() + float(plan.get("sleep") or 0)
        while time.time() < deadline:
            time.sleep(min(1.0, max(0.0, deadline - time.time())))
        if plan["kind"] == "tool":
            chunk({"tool_calls": [{"index": 0, "id": plan["call_id"], "type": "function",
                                   "function": {"name": plan["tool"], "arguments": ""}}]})
            args = plan["arguments"]
            for i in range(0, len(args), 16):
                chunk({"tool_calls": [{"index": 0, "function": {"arguments": args[i:i + 16]}}]})
            chunk({}, "tool_calls")
        else:
            text = plan["text"]
            for i in range(0, len(text), 8) or [0]:
                chunk({"content": text[i:i + 8]})
            chunk({}, "stop")
        if (body.get("stream_options") or {}).get("include_usage"):
            payload = dict(base)
            payload["choices"] = []
            payload["usage"] = {"prompt_tokens": 10, "completion_tokens": 5, "total_tokens": 15}
            self.wfile.write(b"data: " + json.dumps(payload).encode() + b"\n\n")
        self.wfile.write(b"data: [DONE]\n\n")
        self.wfile.flush()


def cmd_scripted_model(_lab, args):
    server = ThreadingHTTPServer((args.host, args.port), ScriptedModel)
    server.daemon_threads = True
    server.log_path = args.log
    if args.pidfile:
        with open(args.pidfile, "w") as f:
            f.write(str(os.getpid()))
    print("scripted model on http://%s:%d/v1 log=%s" % (args.host, args.port, args.log),
          flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


# --------------------------------------------------------------------------


def message_id(recipient, keys):
    """Deterministic v2 message id for a delivery: msg_ + sha256 hex prefix."""
    digest = hashlib.sha256(("%s\n%s" % (recipient, "\n".join(sorted(keys)))).encode())
    return "msg_" + digest.hexdigest()[:26]


# --------------------------------------------------------------------------
# v2 client (through the Lab wrapper's env), scripted-model log, herdr


class V2Error(RuntimeError):
    pass


class V2:
    """`opencode api <op>` in the Lab env. Every call returns the `data` field."""

    def __init__(self, lab):
        self.lab = lab

    def api(self, op, params=None, body=None, timeout=60):
        args = ["api", op]
        for key, value in (params or {}).items():
            args += ["--param", "%s=%s" % (key, value)]
        if body is not None:
            args += ["-d", json.dumps(body)]
        p = self.lab.v2(*args, timeout=timeout)
        if p.returncode:
            raise V2Error("%s: %s %s" % (op, p.stdout.strip()[:400], p.stderr.strip()[:200]))
        out = json.loads(p.stdout) if p.stdout.strip() else {}
        return out.get("data", out) if isinstance(out, dict) else out

    def create_session(self, title, agent="coder", fleet=None, permissions=None):
        body = {"agent": agent, "title": title, "location": {"directory": self.lab.repo}}
        if fleet is not None:
            body["metadata"] = {"fleet": fleet}
        if permissions:
            body["permissions"] = permissions
        return self.api("session.create", body=body)

    def get(self, ses):
        return self.api("session.get", {"sessionID": ses})

    def running(self, ses):
        return ses in (self.api("session.active") or {})

    def messages(self, ses, limit=None, order=None, type_=None):
        params = {"sessionID": ses}
        if limit:
            params["limit"] = limit
        if order:
            params["order"] = order
        if type_:
            params["type"] = type_
        return self.api("session.message.list", params)

    def inbox(self, ses):
        return self.api("session.inbox.list", {"sessionID": ses})

    def synthetic(self, ses, text, resume, delivery, keys, msg_id=None, description=None):
        body = {"id": msg_id or message_id(ses, keys), "text": text, "resume": resume,
                "delivery": delivery, "metadata": {"fleet": {"keys": list(keys)}}}
        if description:
            body["description"] = description
        return self.api("session.synthetic", {"sessionID": ses}, body)

    def prompt(self, ses, text, metadata=None, **extra):
        body = dict(extra, text=text)
        if metadata is not None:
            body["metadata"] = metadata
        return self.api("session.prompt", {"sessionID": ses}, body)

    def inbox_update(self, ses, inbox_id, delivery):
        return self.api("session.inbox.update", {"sessionID": ses, "inboxID": inbox_id},
                        {"delivery": delivery})

    def permissions(self, ses):
        return self.api("session.permission.list", {"sessionID": ses})

    def permission_reply(self, ses, request_id, decision="once"):
        return self.api("session.permission.reply", {"sessionID": ses, "requestID": request_id},
                        {"decision": decision})

    def wait(self, predicate, timeout=60, interval=0.25):
        """Poll predicate() until truthy; returns (value, seconds) or (None, seconds)."""
        start = time.time()
        while True:
            value = predicate()
            if value or time.time() - start > timeout:
                return value, round(time.time() - start, 2)
            time.sleep(interval)

    def wait_running(self, ses, timeout=15):
        return self.wait(lambda: self.running(ses), timeout)

    def wait_idle(self, ses, timeout=90):
        return self.wait(lambda: not self.running(ses), timeout)


def model_log_path(lab):
    return os.path.join(lab.runs, "scripted-model.jsonl")


def model_requests(lab, since, marker=None):
    """Scripted-model requests logged at or after `since` (epoch seconds),
    optionally only those whose messages mention `marker`."""
    found = []
    try:
        with open(model_log_path(lab)) as f:
            for line in f:
                try:
                    entry = json.loads(line)
                except ValueError:
                    continue
                if entry.get("time", 0) < since or "request" not in entry:
                    continue
                if marker and marker not in json.dumps(entry["request"].get("messages")):
                    continue
                found.append(entry)
    except OSError:
        pass
    return found


def request_outline(entry, width=70):
    """[(index, role, snippet)] for one logged model request."""
    outline = []
    for i, message in enumerate(entry["request"].get("messages") or []):
        if not isinstance(message, dict):
            continue
        text = message_text(message).replace("\n", " | ")
        if message.get("tool_calls"):
            text = "tool_calls " + ",".join(
                (c.get("function") or {}).get("name", "?") for c in message["tool_calls"])
        outline.append((i, message.get("role"), text[:width]))
    return outline


def message_outline(message, width=70):
    """One line per v2 transcript message: type, id, time, text, metadata."""
    text = message.get("text")
    if text is None:
        text = " ".join(p.get("text", "") for p in message.get("content") or []
                        if isinstance(p, dict) and p.get("type") == "text")
    keys = sorted(k for k in message if k not in ("id", "type", "time", "text", "content",
                                                  "snapshot", "tokens", "cost", "model"))
    return {"type": message.get("type"), "id": message.get("id"),
            "created": (message.get("time") or {}).get("created"),
            "text": (text or "").replace("\n", " | ")[:width],
            "metadata": message.get("metadata"), "other_keys": keys}


def herdr(*args, timeout=30):
    """herdr CLI with JSON output; returns the `result` field."""
    p = subprocess.run(["herdr"] + list(args), capture_output=True, text=True, timeout=timeout)
    out = p.stdout.strip()
    try:
        data = json.loads(out)
    except ValueError:
        return {"rc": p.returncode, "stdout": out, "stderr": p.stderr.strip()}
    return data.get("result", data) if isinstance(data, dict) else data


LAB_WORKSPACE_LABEL = "Switchboard Lab"


def lab_workspace():
    """The one herdr workspace the Lab may type into, or None."""
    for ws in (herdr("workspace", "list").get("workspaces") or []):
        if ws.get("label") == LAB_WORKSPACE_LABEL:
            return ws
    return None


def lab_pane_guard(pane):
    """Refuse any pane outside the Lab workspace: the runner types only there."""
    ws = lab_workspace()
    info = herdr("pane", "get", pane)
    pane_ws = (info.get("pane") or info).get("workspace_id")
    if not ws or pane_ws != ws["workspace_id"]:
        raise SystemExit("refused: pane %s is not in the %r workspace" % (pane, LAB_WORKSPACE_LABEL))
    return pane


def pane_text(pane, source="visible"):
    p = subprocess.run(["herdr", "pane", "read", pane, "--source", source],
                       capture_output=True, text=True, timeout=30)
    out = p.stdout
    try:
        data = json.loads(out)
        res = data.get("result", data)
        return res.get("text") or res.get("content") or json.dumps(res)
    except ValueError:
        return out


def agent_status(name):
    info = herdr("agent", "get", name)
    return info.get("agent") or info


def lab_tui_guard(lab, pane):
    """The pane's foreground process must be the Lab's v2. A Lab pane's shell
    re-runs the user's zsh startup files, which put /opt/homebrew/bin (v1)
    ahead of the workspace's PATH, so `opencode` there is v1 unless fixed."""
    info = herdr("pane", "process-info", "--pane", pane).get("process_info") or {}
    cmdlines = [p.get("cmdline", "") for p in info.get("foreground_processes") or []]
    if not any(c.startswith(lab.v2_bin) for c in cmdlines):
        raise SystemExit("refused: pane %s does not run the Lab v2: %s" % (pane, cmdlines))
    return pane


class StatusWatch(threading.Thread):
    """Sample `herdr agent get <name>` and keep (seconds, agent_status) changes."""

    def __init__(self, name, interval=0.4):
        super().__init__(daemon=True)
        self.name, self.interval = name, interval
        self.start_time = time.time()
        self.changes, self.stop_flag = [], threading.Event()

    def run(self):
        last = None
        while not self.stop_flag.is_set():
            status = agent_status(self.name).get("agent_status")
            if status != last:
                self.changes.append((round(time.time() - self.start_time, 1), status))
                last = status
            time.sleep(self.interval)

    def stop(self):
        self.stop_flag.set()
        self.join(5)
        return self.changes


# --------------------------------------------------------------------------
# Spikes S3-S5 (API side). Each prints its evidence as JSON lines.


def emit(label, value):
    print(json.dumps({"step": label, "value": value}, default=str), flush=True)


def tag():
    return uuid.uuid4().hex[:6]


def spike_session(v2, title, permissions=None):
    fleet = {"name": "lab-" + title.lower().replace(" ", "-"), "role": "coder",
             "reports_to": "platform", "issue": 1}
    ses = v2.create_session(title, fleet=fleet, permissions=permissions)
    # One finished turn first, so the session is a normal idle one.
    v2.prompt(ses["id"], "warm up\n@script reply=WARM")
    v2.wait_running(ses["id"], 5)
    v2.wait_idle(ses["id"])
    return ses


def requests_since(lab, since, marker):
    return [{"t": round(e["time"] - since, 2), "plan": e["plan"].get("kind"),
             "messages": request_outline(e)} for e in model_requests(lab, since, marker)]


def spike_s3(lab, args):
    v2 = V2(lab)
    out = {}
    # (a) idle: a note with each delivery waits, starts no turn, rides the next prompt.
    for delivery in ("queue", "steer"):
        ses = spike_session(v2, "S3a %s" % delivery)["id"]
        mark = "NOTE-%s-%s" % (delivery, tag())
        t0 = time.time()
        rec = v2.synthetic(ses, "fleet note %s" % mark, False, delivery, [mark])
        time.sleep(4)
        result = {"session": ses, "synthetic": rec, "running_after_4s": v2.running(ses),
                  "model_requests_4s": len(model_requests(lab, t0, mark)),
                  "inbox": [(i.get("id"), i.get("delivery"), i.get("resume"))
                            for i in v2.inbox(ses)]}
        human = "human question %s\n@script reply=SAW" % tag()
        v2.prompt(ses, human)
        v2.wait_running(ses, 5)
        v2.wait_idle(ses)
        result["after_prompt_requests"] = requests_since(lab, t0, mark)
        result["inbox_after"] = v2.inbox(ses)
        result["transcript"] = [message_outline(m) for m in reversed(v2.messages(ses, limit=6))]
        out["a_" + delivery] = result
        emit("S3a " + delivery, result)
    # (b) busy: notes sent while a sleep=20 turn runs.
    for delivery in ("queue", "steer"):
        for shape, script in (("one-step", "@script sleep=20 reply=DONE"),
                              ("two-step", '@script sleep=8 tool=bash cmd="echo a" sleep=8 reply=DONE')):
            ses = spike_session(v2, "S3b %s %s" % (delivery, shape))["id"]
            mark = "NOTE-%s-%s" % (delivery, tag())
            t0 = time.time()
            v2.prompt(ses, "long task %s\n%s" % (tag(), script))
            v2.wait_running(ses, 5)
            time.sleep(3)
            v2.synthetic(ses, "fleet note %s" % mark, False, delivery, [mark])
            inbox_mid = [(i.get("id"), i.get("delivery")) for i in v2.inbox(ses)]
            _, took = v2.wait_idle(ses, 60)
            time.sleep(2)
            result = {"session": ses, "inbox_mid": inbox_mid, "turn_s": took,
                      "inbox_after_turn": [(i.get("id"), i.get("delivery")) for i in v2.inbox(ses)],
                      "requests_with_note": requests_since(lab, t0, mark),
                      "running_after": v2.running(ses),
                      "transcript": [message_outline(m) for m in
                                     reversed(v2.messages(ses, limit=8))]}
            out["b_%s_%s" % (delivery, shape)] = result
            emit("S3b %s %s" % (delivery, shape), result)
    # (c) a waiting queue note switched to steer on an idle session.
    ses = spike_session(v2, "S3c")["id"]
    mark = "NOTE-c-%s" % tag()
    rec = v2.synthetic(ses, "fleet note %s\n@script reply=STEERED" % mark, False, "queue", [mark])
    time.sleep(3)
    before = {"running": v2.running(ses), "inbox": len(v2.inbox(ses))}
    t0 = time.time()
    upd = v2.inbox_update(ses, rec["id"], "steer")
    started, took = v2.wait_running(ses, 10)
    v2.wait_idle(ses)
    result = {"session": ses, "before": before, "update": upd, "turn_started": bool(started),
              "start_after_s": took, "requests": requests_since(lab, t0, mark),
              "inbox_after": v2.inbox(ses),
              "transcript": [message_outline(m) for m in reversed(v2.messages(ses, limit=4))]}
    out["c"] = result
    emit("S3c", result)
    return 0


def spike_s4(lab, args):
    v2 = V2(lab)
    # (a) idle wake.
    ses = spike_session(v2, "S4a")["id"]
    mark = "WAKE-a-%s" % tag()
    t0 = time.time()
    rec = v2.synthetic(ses, "fleet wake %s\n@script reply=WOKE" % mark, True, "queue", [mark])
    started, took = v2.wait_running(ses, 10)
    v2.wait_idle(ses)
    emit("S4a", {"session": ses, "synthetic": rec, "turn_started": bool(started),
                 "start_after_s": took, "requests": requests_since(lab, t0, mark),
                 "transcript": [message_outline(m) for m in reversed(v2.messages(ses, limit=4))]})
    # (b) busy wake: queued behind a running turn.
    for shape, script in (("one-step", "@script sleep=20 reply=DONE"),
                          ("two-step", '@script sleep=8 tool=bash cmd="echo a" sleep=8 reply=DONE')):
        ses = spike_session(v2, "S4b %s" % shape)["id"]
        mark = "WAKE-b-%s" % tag()
        t0 = time.time()
        v2.prompt(ses, "long task %s\n%s" % (tag(), script))
        v2.wait_running(ses, 5)
        time.sleep(3)
        v2.synthetic(ses, "fleet wake %s\n@script reply=WOKE" % mark, True, "queue", [mark])
        inbox_mid = [(i.get("id"), i.get("delivery"), i.get("resume")) for i in v2.inbox(ses)]
        v2.wait(lambda: not v2.running(ses) and not v2.inbox(ses), 90)
        time.sleep(2)
        msgs = list(reversed(v2.messages(ses, limit=12)))
        emit("S4b " + shape, {
            "session": ses, "inbox_mid": inbox_mid, "requests": requests_since(lab, t0, "long task"),
            "wake_requests": requests_since(lab, t0, mark),
            "transcript": [message_outline(m) for m in msgs]})
    return 0


def spike_s5(lab, args):
    v2 = V2(lab)
    fleet = {"name": "lab-s5", "role": "coder", "reports_to": "platform", "issue": 5,
             "nested": {"list": [1, "two"], "flag": True}}
    ses = v2.create_session("S5", fleet=fleet)
    sid = ses["id"]
    got = v2.get(sid)
    emit("S5 metadata", {"sent": fleet, "got": got.get("metadata"),
                         "exact": (got.get("metadata") or {}).get("fleet") == fleet,
                         "time": got.get("time"), "outcome": got.get("outcome")})
    v2.prompt(sid, "fleet brief\n@script reply=BRIEFED",
              metadata={"fleet": {"from": "switchboard", "keys": ["brief:lab-s5"]}})
    v2.wait_running(sid, 5)
    v2.wait_idle(sid)
    first = v2.get(sid)
    mark = "NOTE-s5-%s" % tag()
    v2.synthetic(sid, "fleet note %s" % mark, False, "queue", [mark, "issue:5"])
    emit("S5 inbox", v2.inbox(sid))
    v2.prompt(sid, "plain human prompt\n@script reply=HUMAN")
    v2.wait_running(sid, 5)
    v2.wait_idle(sid)
    second = v2.get(sid)
    emit("S5 idle/outcome", {"after_turn1": [first.get("time"), first.get("outcome")],
                             "after_turn2": [second.get("time"), second.get("outcome")]})
    page = v2.messages(sid, limit=2)
    emit("S5 newest-first limit=2", [message_outline(m) for m in page])
    # Stop early: walk newest first until the first user message without fleet metadata.
    seen, found = 0, None
    for m in v2.messages(sid, limit=50):
        seen += 1
        if m.get("type") == "user" and not (m.get("metadata") or {}).get("fleet"):
            found = message_outline(m)
            break
    emit("S5 last human prompt", {"read": seen, "found": found})
    emit("S5 full transcript", [message_outline(m, 50) for m in
                                reversed(v2.messages(sid, limit=50))])
    emit("S5 raw user/synthetic", [m for m in v2.messages(sid, limit=50)
                                   if m.get("type") in ("user", "synthetic")])
    return 0


def spike_s6(lab, args):
    """TUI side, in a Lab pane already running `opencode -s <session>` as herdr
    agent `args.agent`: draft safety under wakes (S4c), status transitions and
    blocked (S6), the unread token (S6). Types only into the Lab pane."""
    v2, pane, ses = V2(lab), lab_tui_guard(lab, lab_pane_guard(args.pane)), args.session
    watch = StatusWatch(args.agent)
    watch.start()

    def draft_check(label, draft, t0, mark):
        screen = pane_text(pane)
        users = [m for m in v2.messages(ses, limit=40) if m.get("type") == "user"]
        emit(label, {"draft_on_screen": draft in screen,
                     "draft_in_transcript": any(draft in (m.get("text") or "") for m in users),
                     "screen_tail": [l.rstrip() for l in screen.splitlines() if l.strip()][-14:],
                     "wake_requests": requests_since(lab, t0, mark),
                     "status_changes": list(watch.changes)})

    # S4c idle: a draft sits in the input box, then a wake arrives.
    draft = "half typed draft %s" % tag()
    subprocess.run(["herdr", "pane", "send-text", pane, draft], check=True, capture_output=True)
    time.sleep(1)
    mark = "WAKE-tui-idle-%s" % tag()
    t0 = time.time()
    v2.synthetic(ses, "fleet wake %s\n@script sleep=12 reply=WOKE" % mark, True, "queue", [mark])
    v2.wait_running(ses, 10)
    time.sleep(4)
    emit("S4c idle mid-turn screen", [l.rstrip() for l in pane_text(pane).splitlines()
                                      if l.strip()][-14:])
    v2.wait_idle(ses, 60)
    time.sleep(2)
    draft_check("S4c idle wake", draft, t0, mark)
    # S4c busy: a fleet prompt runs, the draft grows, a wake is queued behind it.
    t0 = time.time()
    v2.prompt(ses, "fleet task %s\n@script sleep=12 reply=DONE" % tag(),
              metadata={"fleet": {"from": "switchboard", "keys": ["task:%s" % tag()]}})
    v2.wait_running(ses, 10)
    time.sleep(2)
    more = " and more %s" % tag()
    subprocess.run(["herdr", "pane", "send-text", pane, more], check=True, capture_output=True)
    mark = "WAKE-tui-busy-%s" % tag()
    v2.synthetic(ses, "fleet wake %s\n@script reply=WOKE2" % mark, True, "queue", [mark])
    v2.wait(lambda: not v2.running(ses) and not v2.inbox(ses), 90)
    time.sleep(2)
    draft_check("S4c busy wake", draft + more, t0, mark)
    # S6 blocked: a shell permission ask (the session asks for shell).
    t0 = time.time()
    v2.prompt(ses, "fleet task needing shell\n@script tool=bash cmd=\"echo hi\" reply=SHELLED",
              metadata={"fleet": {"from": "switchboard", "keys": ["ask:%s" % tag()]}})
    asks, took = v2.wait(lambda: v2.permissions(ses), 20)
    time.sleep(4)
    blocked = {"asks": asks, "ask_after_s": took, "agent": agent_status(args.agent),
               "location_requests": v2.api("permission.request.list",
                                           {"location[directory]": lab.repo})}
    if asks:
        blocked["reply"] = v2.permission_reply(ses, asks[0]["id"], "once")
    v2.wait_idle(ses, 30)
    time.sleep(2)
    blocked["after"] = agent_status(args.agent).get("agent_status")
    emit("S6 blocked", blocked)
    # S6 unread token: display-only metadata.
    rep = herdr("pane", "report-metadata", pane, "--source", "fleet-switchboard",
                "--token", "unread=2")
    time.sleep(1)
    emit("S6 report-metadata", {"report": rep, "pane_get": herdr("pane", "get", pane),
                                "agent_get": herdr("agent", "get", args.agent)})
    emit("S6 status changes (s since start, agent_status)", watch.stop())
    return 0


def cmd_spike(lab, args):
    if args.which == "s6" and not (args.pane and args.agent and args.session):
        raise SystemExit("spike s6 needs --pane, --agent and --session")
    return {"s3": spike_s3, "s4": spike_s4, "s5": spike_s5, "s6": spike_s6}[args.which](lab, args)


def cmd_session(lab, args):
    v2 = V2(lab)
    if args.session_command == "create":
        ses = v2.create_session(args.title, agent=args.agent,
                                fleet=json.loads(args.fleet) if args.fleet else None,
                                permissions=json.loads(args.permissions) if args.permissions else None)
        print(ses["id"])
    elif args.session_command == "synthetic":
        keys = args.keys.split(",") if args.keys else ["manual:%s" % tag()]
        print(json.dumps(v2.synthetic(args.session, args.text, args.resume, args.delivery, keys,
                                      msg_id=args.id)))
    elif args.session_command == "wait-idle":
        value, took = v2.wait_idle(args.session, args.timeout)
        print(json.dumps({"idle": bool(value), "seconds": took}))
        return 0 if value else 1
    elif args.session_command == "transcript":
        for m in reversed(v2.messages(args.session, limit=args.limit)):
            print(json.dumps(message_outline(m)))
    return 0


def cmd_model_requests(lab, args):
    for entry in model_requests(lab, args.since, args.marker):
        print(json.dumps({"t": entry["time"], "plan": entry["plan"].get("kind"),
                          "messages": request_outline(entry)}))
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(prog="proof-switchboard", description=__doc__.split("\n")[0])
    sub = parser.add_subparsers(dest="command")
    lab_p = sub.add_parser("lab", help="the isolated Lab")
    lab_sub = lab_p.add_subparsers(dest="lab_command")
    lab_sub.add_parser("env", help="print export lines for the Lab env")
    init_p = lab_sub.add_parser("init", help="create or refresh the Lab")
    init_p.add_argument("--port", type=int, help="scripted model port")
    init_p.add_argument("--herdr", action="store_true",
                        help="also install herdr's OpenCode integration into the Lab config")
    lab_sub.add_parser("status", help="show the Lab's state")
    sm = sub.add_parser("scripted-model", help="run the local scripted model")
    sm.add_argument("--port", type=int, default=None)
    sm.add_argument("--host", default="127.0.0.1")
    sm.add_argument("--log", default=None)
    sm.add_argument("--pidfile", default=None)
    sp = sub.add_parser("spike", help="run a spike's API side and print its evidence")
    sp.add_argument("which", choices=("s3", "s4", "s5", "s6"))
    sp.add_argument("--pane", help="s6: Lab pane running the TUI")
    sp.add_argument("--agent", help="s6: herdr agent name of that pane")
    sp.add_argument("--session", help="s6: the session the TUI shows")
    ses_p = sub.add_parser("session", help="Lab v2 session helpers")
    ses_sub = ses_p.add_subparsers(dest="session_command")
    c = ses_sub.add_parser("create")
    c.add_argument("--title", required=True)
    c.add_argument("--agent", default="coder")
    c.add_argument("--fleet", help="metadata.fleet as JSON")
    c.add_argument("--permissions", help="session permissions as a JSON list")
    s = ses_sub.add_parser("synthetic")
    s.add_argument("session")
    s.add_argument("--text", required=True)
    s.add_argument("--resume", action="store_true")
    s.add_argument("--delivery", choices=("queue", "steer"), default="queue")
    s.add_argument("--keys", help="comma-separated metadata.fleet.keys")
    s.add_argument("--id", help="message id (default: derived from session and keys)")
    w = ses_sub.add_parser("wait-idle")
    w.add_argument("session")
    w.add_argument("--timeout", type=float, default=90)
    t = ses_sub.add_parser("transcript")
    t.add_argument("session")
    t.add_argument("--limit", type=int, default=20)
    mr = sub.add_parser("model-requests", help="scripted-model requests since a time")
    mr.add_argument("--since", type=float, default=0)
    mr.add_argument("--marker")
    args = parser.parse_args(argv)
    lab = Lab()
    if args.command == "spike":
        return cmd_spike(lab, args)
    if args.command == "session":
        return cmd_session(lab, args)
    if args.command == "model-requests":
        return cmd_model_requests(lab, args)
    if args.command == "lab":
        handler = {"env": cmd_lab_env, "init": cmd_lab_init, "status": cmd_lab_status}.get(
            args.lab_command)
        if not handler:
            lab_p.print_help()
            return 2
        return handler(lab, args)
    if args.command == "scripted-model":
        if args.port is None:
            args.port = lab.port()
        return cmd_scripted_model(lab, args)
    parser.print_help()
    return 2


if __name__ == "__main__":
    sys.exit(main())
