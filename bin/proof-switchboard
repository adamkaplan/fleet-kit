#!/usr/bin/env python3
"""proof-switchboard: the Switchboard Lab and its scripted model.

The Lab is an isolated OpenCode v2 install that the live fleet (OpenCode v1)
never sees. Everything v2 writes stays under one directory:

    $LAB = ${XDG_DATA_HOME:-~/.local/share}/fleet-switchboard-lab
      v2/       pinned OpenCode v2 (npm --prefix, never -g, never on PATH)
      bin/      `opencode` wrapper that always sets the Lab env, then execs v2
      profile/  scratch XDG dirs: config, data, state, cache, tmp, home
      repo/     scratch git repo, local identity only
      backup/   snapshots of the live dirs taken before risky experiments
      runs/     pidfiles, logs, evidence

Subcommands:

    lab env                     print `export` lines for the Lab env (no secrets)
    lab init [--port N]         idempotent setup: dirs, v2 install, wrapper,
                                scratch repo, provider config, agent copies
    lab status                  what is installed and running, and whether the
                                live dirs carry any v2 state
    scripted-model --port N --log FILE
                                local OpenAI-compatible model driven by
                                `@script` lines in the last user message
    session create|synthetic|wait-idle|transcript
                                Lab v2 session helpers (`opencode api`)
    model-requests --since T [--marker M]
                                what the scripted model was asked since T
    spike s3|s4|s5              note, wake and reading-back spikes (API side)
    spike s6 --pane P --agent A --session S
                                draft safety, herdr status and the unread
                                token, in a "Switchboard Lab" pane already
                                running the Lab TUI on S as herdr agent A
    run [paths...] [--tier lab-scripted] [--control-only|--no-control] [--pane P]
                                play scenario files (default: every one in
                                scenarios/switchboard) in the Lab and play each
                                control; evidence in scenario-runs/<UTC>/<id>/
                                (see "Scenario runner" below)

Script directives (one line in the last user message):

    @script reply=PONG
    @script sleep=20 reply=DONE
    @script tool=bash cmd="echo hi" reply=DONE
    @script tool=write arg.filePath=notes.txt arg.content=hello reply=WROTE
    @script error=500

Tokens are read in order. `tool=` starts a step; `cmd=`, `args=<json>` and
`arg.<name>=` fill that step's arguments; `sleep=` delays the step that
follows it. Each request answers the first step not yet taken, counted by the
assistant tool calls after the last user message; when every tool step is
done it replies with `reply=`. A one-line prompt typed into the TUI carries
its directive inline: `what is new? @script reply=SAW`.

Python 3.9 standard library only.
"""

import argparse
import copy
import fnmatch
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import threading
import time
import urllib.request
import uuid
from datetime import datetime, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

V2_VERSION = "2.0.22"
V2_PACKAGE = "@opencode/cli"
DEFAULT_PORT = 47810
SCRIPTED_PROVIDER = "scripted"
SCRIPTED_MODEL = "lab"
KIT_AGENTS = ("orchestrator", "coder", "chief-of-staff")
REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

# Live OpenCode / herdr locations. The Lab only ever reads these.
LIVE_DIRS = (
    "~/.config/opencode",
    "~/.local/share/opencode",
    "~/.local/state/opencode",
    "~/.cache/opencode",
    "~/.config/herdr",
    "~/.local/state/herdr",
)


# --------------------------------------------------------------------------
# Lab layout and environment


def lab_root():
    # Inside the Lab env XDG_DATA_HOME points into the profile; keep the root.
    marker = os.environ.get("FLEET_SWITCHBOARD_LAB_DIR")
    if marker:
        return marker
    base = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    return os.path.join(base, "fleet-switchboard-lab")


# Ambient credentials the Lab's v2 must never inherit. v2 activates a provider
# from its env var alone (OPENROUTER_API_KEY showed 300+ OpenRouter models).
CREDENTIAL_PATTERN = re.compile(
    r"(_API_KEY|_TOKEN|_SECRET|_PASSWORD|_ACCESS_KEY|_ACCESS_KEY_ID)$|^(GH|GITHUB|COPILOT)_"
)


def credential_names(env):
    return sorted(name for name in env if CREDENTIAL_PATTERN.search(name))


# herdr sets these in every pane. The runner's own calls (and any v2 service
# they start) must not carry a live pane's identity into the Lab.
HERDR_PANE_VARS = ("HERDR_ENV", "HERDR_PANE_ID", "HERDR_SOCKET_PATH", "HERDR_TAB_ID",
                   "HERDR_WORKSPACE_ID")


def herdr_names(env):
    return [name for name in HERDR_PANE_VARS if name in env]


class Lab:
    def __init__(self, root=None):
        self.root = root or lab_root()
        self.v2_dir = os.path.join(self.root, "v2")
        self.v2_bin = os.path.join(
            self.v2_dir, "node_modules", "@opencode", "cli", "bin", "opencode.exe"
        )
        self.bin_dir = os.path.join(self.root, "bin")
        self.wrapper = os.path.join(self.bin_dir, "opencode")
        self.profile = os.path.join(self.root, "profile")
        self.repo = os.path.join(self.root, "repo")
        self.backup = os.path.join(self.root, "backup")
        self.runs = os.path.join(self.root, "runs")
        self.opencode_config = os.path.join(self.profile, "config", "opencode")
        self.state_file = os.path.join(self.root, "lab.json")

    def env(self):
        """The variables that confine v2 to the Lab. No secrets."""
        p = self.profile
        return {
            "FLEET_SWITCHBOARD_LAB": "1",
            "FLEET_SWITCHBOARD_LAB_DIR": self.root,
            "XDG_CONFIG_HOME": os.path.join(p, "config"),
            "XDG_DATA_HOME": os.path.join(p, "data"),
            "XDG_STATE_HOME": os.path.join(p, "state"),
            "XDG_CACHE_HOME": os.path.join(p, "cache"),
            "TMPDIR": os.path.join(p, "tmp"),
        }

    def full_env(self):
        """The Lab env for this process's children: no ambient credentials, no
        live herdr pane identity, the Lab's bin first on PATH."""
        env = dict(os.environ)
        for name in credential_names(env) + herdr_names(env):
            del env[name]
        env.update(self.env())
        env["PATH"] = self.bin_dir + os.pathsep + env.get("PATH", "")
        return env

    def v2_env(self):
        """full_env plus HOME: with XDG alone v2 still resolves `home` to the
        real one and loads ~/.claude/skills, ~/.agents/skills (the live fleet's
        skills). Only v2 processes get the Lab HOME; shells keep theirs."""
        env = self.full_env()
        env["HOME"] = os.path.join(self.profile, "home")
        return env

    def settings(self):
        try:
            with open(self.state_file) as f:
                return json.load(f)
        except (OSError, ValueError):
            return {}

    def save_settings(self, data):
        with open(self.state_file, "w") as f:
            json.dump(data, f, indent=2, sort_keys=True)
            f.write("\n")

    def port(self):
        return int(self.settings().get("scripted_port", DEFAULT_PORT))

    def v2(self, *args, timeout=60, data=None):
        """Run v2 through the Lab env. Returns CompletedProcess."""
        return subprocess.run(
            [self.v2_bin] + list(args),
            env=self.v2_env(),
            input=data,
            capture_output=True,
            text=True,
            timeout=timeout,
        )


WRAPPER = """#!/bin/sh
# Switchboard Lab: OpenCode v2 confined to the Lab profile.
# Written by `proof-switchboard lab init`. Never put this on the live PATH.
LAB="{root}"
export FLEET_SWITCHBOARD_LAB=1 FLEET_SWITCHBOARD_LAB_DIR="$LAB"
export XDG_CONFIG_HOME="$LAB/profile/config" XDG_DATA_HOME="$LAB/profile/data"
export XDG_STATE_HOME="$LAB/profile/state" XDG_CACHE_HOME="$LAB/profile/cache"
export TMPDIR="$LAB/profile/tmp"
# XDG alone leaves `home` live: v2 would load ~/.claude/skills, ~/.agents/skills.
export HOME="$LAB/profile/home"
# Never hand ambient credentials to the Lab's v2.
for name in $(env | sed -n 's/^\\([A-Za-z_][A-Za-z0-9_]*\\)=.*/\\1/p' \\
    | grep -E '(_API_KEY|_TOKEN|_SECRET|_PASSWORD|_ACCESS_KEY|_ACCESS_KEY_ID)$|^(GH|GITHUB|COPILOT)_'); do
  unset "$name"
done
# herdr's pane identity belongs to Lab panes only. Called from any other pane
# (a live agent's shell), drop it, so neither a TUI plugin nor a service
# started from here can report into that live pane.
if [ "$FLEET_SWITCHBOARD_LAB_PANE" != "1" ]; then
  unset HERDR_ENV HERDR_PANE_ID HERDR_SOCKET_PATH HERDR_TAB_ID HERDR_WORKSPACE_ID
fi
exec "$LAB/v2/node_modules/@opencode/cli/bin/opencode.exe" "$@"
"""


def shell_quote(value):
    return shlex.quote(value)


def cmd_lab_env(lab, _args):
    names = credential_names(os.environ)
    if names:
        print("unset %s" % " ".join(names))
    for key, value in lab.env().items():
        print("export %s=%s" % (key, shell_quote(value)))
    print("export PATH=%s:\"$PATH\"" % shell_quote(lab.bin_dir))
    print("export OPENCODE_V2=%s" % shell_quote(lab.v2_bin))
    return 0


# --------------------------------------------------------------------------
# lab init


def provider_config(port):
    return {
        "$schema": "https://opencode.ai/config.json",
        "update": "disable",
        "share": "disabled",
        "model": "%s/%s" % (SCRIPTED_PROVIDER, SCRIPTED_MODEL),
        # Only the scripted model may be used, whatever credentials leak in.
        "experimental": {
            "policies": [
                {"action": "provider.use", "resource": "*", "effect": "deny"},
                {"action": "provider.use", "resource": SCRIPTED_PROVIDER, "effect": "allow"},
            ]
        },
        "providers": {
            SCRIPTED_PROVIDER: {
                "name": "Lab scripted model",
                "package": "@opencode/ai/providers/openai-compatible",
                "settings": {
                    "baseURL": "http://127.0.0.1:%d/v1" % port,
                    "apiKey": "lab-scripted-no-secret",
                },
                "models": {
                    SCRIPTED_MODEL: {
                        "name": "Lab scripted",
                        "limit": {"context": 200000, "output": 8192},
                    }
                },
            }
        },
    }


def agent_copy(text, model):
    """Kit agent file -> Lab agent file: only the model placeholder changes.

    v2 2.0.22 reads the kit's v1 `permission:` frontmatter itself (bash ->
    shell, edit, read, ...), checked with `opencode api agent.list` (S1).
    """
    return text.replace("__PROVIDER__/__MODEL_ID__", model)


def ensure_v2(lab):
    if os.path.exists(lab.v2_bin) and v2_version(lab) == V2_VERSION:
        return "present"
    os.makedirs(lab.v2_dir, exist_ok=True)
    # --ignore-scripts: the postinstall runs `opencode --version`, which would
    # log into the live data dir. Run it ourselves inside the Lab env.
    subprocess.run(
        ["npm", "install", "--prefix", lab.v2_dir, "--no-audit", "--no-fund",
         "--ignore-scripts", "%s@%s" % (V2_PACKAGE, V2_VERSION)],
        check=True,
    )
    pkg = os.path.join(lab.v2_dir, "node_modules", "@opencode", "cli")
    subprocess.run(["node", "./postinstall.mjs"], cwd=pkg, env=lab.v2_env(), check=True)
    return "installed"


def v2_version(lab):
    if not os.path.exists(lab.v2_bin):
        return None
    try:
        out = lab.v2("--version", timeout=30).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return None
    return out.split("v")[-1] if out else None


def ensure_repo(lab):
    if os.path.isdir(os.path.join(lab.repo, ".git")):
        return "present"
    os.makedirs(lab.repo, exist_ok=True)

    def git(*a):
        subprocess.run(["git", "-C", lab.repo] + list(a), check=True,
                       capture_output=True, text=True)

    git("init", "-q", "-b", "main")
    git("config", "user.name", "Switchboard Lab")
    git("config", "user.email", "lab@switchboard.invalid")
    git("config", "commit.gpgsign", "false")
    with open(os.path.join(lab.repo, "README.md"), "w") as f:
        f.write("# Switchboard Lab scratch repo\n\nWork here is disposable.\n")
    git("add", "README.md")
    git("-c", "core.hooksPath=/dev/null", "commit", "-q", "-m", "Lab: initial commit")
    return "created"


def write_if_changed(path, content):
    try:
        with open(path) as f:
            if f.read() == content:
                return False
    except OSError:
        pass
    with open(path, "w") as f:
        f.write(content)
    return True


def cmd_lab_init(lab, args):
    settings = lab.settings()
    port = args.port or settings.get("scripted_port") or DEFAULT_PORT
    report = {}
    for d in (lab.v2_dir, lab.bin_dir, lab.backup, lab.runs, lab.opencode_config,
              os.path.join(lab.opencode_config, "agents")):
        os.makedirs(d, exist_ok=True)
    for name in ("config", "data", "state", "cache", "tmp", "home"):
        os.makedirs(os.path.join(lab.profile, name), exist_ok=True)
    report["v2"] = ensure_v2(lab)
    if write_if_changed(lab.wrapper, WRAPPER.format(root=lab.root)):
        os.chmod(lab.wrapper, 0o755)
        report["wrapper"] = "written"
    report["repo"] = ensure_repo(lab)
    cfg = json.dumps(provider_config(port), indent=2) + "\n"
    report["config"] = "written" if write_if_changed(
        os.path.join(lab.opencode_config, "opencode.json"), cfg) else "unchanged"
    model = "%s/%s" % (SCRIPTED_PROVIDER, SCRIPTED_MODEL)
    for name in KIT_AGENTS:
        src = os.path.join(REPO_ROOT, "agents", "opencode", name + ".md")
        with open(src) as f:
            text = agent_copy(f.read(), model)
        dst = os.path.join(lab.opencode_config, "agents", name + ".md")
        report["agent " + name] = "written" if write_if_changed(dst, text) else "unchanged"
    settings.update({"scripted_port": port, "v2_version": V2_VERSION})
    lab.save_settings(settings)
    report["herdr home link"] = ensure_home_link(lab)
    if args.herdr:
        report["herdr integration"] = ensure_herdr_integration(lab)
    for key, value in report.items():
        print("%-26s %s" % (key, value))
    return 0


def ensure_home_link(lab):
    """herdr installs its OpenCode integration into $HOME/.config/opencode and
    ignores XDG_CONFIG_HOME. Under the Lab's HOME that path is a link to the
    Lab's v2 config dir, so the install lands where v2 reads it."""
    link = os.path.join(lab.profile, "home", ".config", "opencode")
    os.makedirs(os.path.dirname(link), exist_ok=True)
    if os.path.islink(link) and os.readlink(link) == lab.opencode_config:
        return "present"
    if os.path.lexists(link):
        return "BLOCKED: %s exists and is not the Lab link" % link
    os.symlink(lab.opencode_config, link)
    return "created"


def herdr_lab_env(lab):
    return lab.v2_env()


def herdr_integration_status(lab):
    out = subprocess.run(["herdr", "integration", "status"], env=herdr_lab_env(lab),
                         capture_output=True, text=True, timeout=30).stdout
    return next((l for l in out.splitlines() if l.startswith("opencode:")), "")


def ensure_herdr_integration(lab):
    status = herdr_integration_status(lab)
    lab_home = os.path.join(lab.profile, "home") + os.sep
    # Refuse unless herdr resolves the target inside the Lab: never the live dir.
    if lab_home not in status:
        return "REFUSED: herdr would install outside the Lab: %s" % status
    if "current" in status:
        return "present"
    p = subprocess.run(["herdr", "integration", "install", "opencode"], env=herdr_lab_env(lab),
                       capture_output=True, text=True, timeout=60)
    lines = (p.stdout + p.stderr).strip().splitlines()
    if p.returncode or any("installed" in l and lab_home not in l for l in lines):
        return "FAILED: %s" % " | ".join(lines)
    return "installed (%s)" % herdr_integration_status(lab)


# --------------------------------------------------------------------------
# lab status


def pid_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except (OSError, TypeError):
        return False


def read_pid(path):
    try:
        with open(path) as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return None


def cmd_lab_status(lab, _args):
    ok = True
    print("lab        %s" % lab.root)
    version = v2_version(lab)
    print("v2         %s (%s)" % (version or "missing", lab.v2_bin))
    ok &= version == V2_VERSION
    if version:
        paths = lab.v2("debug", "paths").stdout
        outside = []
        for line in paths.splitlines():
            parts = line.split(None, 1)
            if len(parts) == 2 and not parts[1].startswith(lab.root):
                outside.append(line)
        print("paths      %s" % ("all under the Lab" if not outside else "OUTSIDE: %s" % outside))
        ok &= not outside
    service = os.path.join(lab.profile, "state", "opencode", "service.json")
    if os.path.exists(service):
        try:
            with open(service) as f:
                info = json.load(f)
            pid = info.get("pid")
            print("service    %s pid=%s alive=%s keys=%s" % (
                info.get("url"), pid, pid_alive(pid), sorted(info)))
        except (OSError, ValueError) as e:
            print("service    unreadable: %s" % e)
    else:
        print("service    not registered")
    pid = read_pid(os.path.join(lab.runs, "scripted-model.pid"))
    print("scripted   port=%d pid=%s alive=%s" % (lab.port(), pid, pid_alive(pid)))
    if shutil.which("herdr"):
        print("herdr      %s" % (herdr_integration_status(lab) or "unknown"))
    live_service = os.path.expanduser("~/.local/state/opencode/service.json")
    leaked = os.path.exists(live_service)
    print("live       service.json %s" % ("PRESENT (v2 state in the live dir!)" if leaked else "absent"))
    ok &= not leaked
    v1 = shutil.which("opencode")
    if v1:
        out = subprocess.run([v1, "--version"], capture_output=True, text=True).stdout.strip()
        print("v1         %s (%s)" % (out, v1))
    return 0 if ok else 1


# --------------------------------------------------------------------------
# Scripted model


def message_text(message):
    content = message.get("content")
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts = []
        for part in content:
            if isinstance(part, dict) and isinstance(part.get("text"), str):
                parts.append(part["text"])
            elif isinstance(part, str):
                parts.append(part)
        return "\n".join(parts)
    return ""


def parse_script(text):
    """Return the steps of the last `@script` line in text, or None."""
    line = None
    for candidate in text.splitlines():
        stripped = candidate.strip()
        if stripped.startswith("@script"):
            line = stripped[len("@script"):]
    if line is None:
        # A prompt typed into the TUI is one line: "what is new? @script reply=X".
        inline = text.rfind(" @script ")
        if inline < 0:
            return None
        line = text[inline + len(" @script"):].splitlines()[0]
    try:
        tokens = shlex.split(line)
    except ValueError:
        tokens = line.split()
    steps, current, sleep = [], None, 0.0
    script = {"steps": steps, "reply": None, "reply_sleep": 0.0, "error": None}
    for token in tokens:
        key, _, value = token.partition("=")
        if key == "sleep":
            try:
                sleep = float(value)
            except ValueError:
                pass
        elif key == "tool":
            current = {"tool": value, "args": {}, "cmd": None, "sleep": sleep}
            sleep = 0.0
            steps.append(current)
        elif key == "cmd" and current is not None:
            current["cmd"] = value
        elif key == "args" and current is not None:
            try:
                current["args"].update(json.loads(value))
            except ValueError:
                pass
        elif key.startswith("arg.") and current is not None:
            current["args"][key[4:]] = value
        elif key == "reply":
            script["reply"] = value
            script["reply_sleep"] = sleep
            sleep = 0.0
        elif key == "error":
            script["error"] = value
    if script["reply"] is None and sleep:
        script["reply_sleep"] = sleep
    return script


TOOL_ALIASES = {"bash": ("bash", "shell"), "shell": ("shell", "bash")}


def find_tool(tools, wanted):
    by_name = {}
    for tool in tools or []:
        fn = tool.get("function") if isinstance(tool, dict) else None
        if isinstance(fn, dict) and fn.get("name"):
            by_name[fn["name"]] = fn
    for name in TOOL_ALIASES.get(wanted, (wanted,)):
        if name in by_name:
            return name, by_name[name]
    return wanted, {}


def tool_arguments(step, schema):
    params = (schema or {}).get("parameters") or {}
    props = params.get("properties") or {}
    args = dict(step["args"])
    if step["cmd"] is not None:
        key = next((k for k in ("command", "cmd") if k in props), "command")
        args.setdefault(key, step["cmd"])
    for name in params.get("required") or []:
        if name not in args and (props.get(name) or {}).get("type") == "string":
            args[name] = "lab scripted step"
    return args


def plan_response(body):
    """Decide what the model says. Returns a dict describing the response."""
    messages = body.get("messages") if isinstance(body.get("messages"), list) else []
    tools = body.get("tools") if isinstance(body.get("tools"), list) else []
    last_user, after = None, []
    for i, message in enumerate(messages):
        if isinstance(message, dict) and message.get("role") == "user":
            last_user, after = message, messages[i + 1:]
    user_text = message_text(last_user) if last_user else ""
    system_text = "\n".join(
        message_text(m) for m in messages if isinstance(m, dict) and m.get("role") == "system"
    )
    if not tools:
        low = system_text.lower()
        if "title" in low:
            return {"kind": "title", "text": "lab"}
        if "summar" in low or "compact" in low:
            return {"kind": "summary", "text": "lab summary"}
    script = parse_script(user_text)
    if script is None:
        if not tools and len(system_text) < 4000:
            return {"kind": "maintenance", "text": "lab"}
        snippet = user_text.strip()[:60]
        return {"kind": "default", "text": "ACK: " + snippet}
    if script["error"]:
        return {"kind": "error", "status": script["error"]}
    done = sum(
        1 for m in after
        if isinstance(m, dict) and m.get("role") == "assistant" and m.get("tool_calls")
    )
    if done < len(script["steps"]) and tools:
        step = script["steps"][done]
        name, schema = find_tool(tools, step["tool"])
        return {
            "kind": "tool",
            "sleep": step["sleep"],
            "tool": name,
            "arguments": json.dumps(tool_arguments(step, schema)),
            "call_id": "call_" + uuid.uuid4().hex[:24],
        }
    return {"kind": "reply", "sleep": script["reply_sleep"],
            "text": script["reply"] if script["reply"] is not None else "DONE"}


class ScriptedModel(BaseHTTPRequestHandler):
    server_version = "LabScriptedModel/1"
    protocol_version = "HTTP/1.1"
    log_lock = threading.Lock()

    def log_message(self, fmt, *args):  # quiet stderr
        pass

    def record(self, entry):
        path = getattr(self.server, "log_path", None)
        if not path:
            return
        entry["time"] = time.time()
        with self.log_lock, open(path, "a") as f:
            f.write(json.dumps(entry) + "\n")

    def record_tools(self, tools):
        """Keep the latest full tool schemas beside the log (`<log>.tools.json`),
        so a script author can see each tool's argument names."""
        path = getattr(self.server, "log_path", None)
        if not path or not isinstance(tools, list) or not tools:
            return
        with self.log_lock, open(path + ".tools.json", "w") as f:
            json.dump(tools, f, indent=1)

    def send_json(self, status, payload):
        data = json.dumps(payload).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path.rstrip("/").endswith("/models"):
            self.send_json(200, {"object": "list", "data": [
                {"id": SCRIPTED_MODEL, "object": "model", "created": 0, "owned_by": "lab"}]})
        elif self.path.rstrip("/") in ("", "/health", "/v1"):
            self.send_json(200, {"ok": True})
        else:
            self.send_json(404, {"error": {"message": "not found", "type": "invalid_request_error"}})

    def do_POST(self):
        length = int(self.headers.get("Content-Length") or 0)
        raw = self.rfile.read(length) if length else b""
        try:
            body = json.loads(raw or b"{}")
            if not isinstance(body, dict):
                body = {}
        except ValueError:
            body = {}
        if not self.path.rstrip("/").endswith("/chat/completions"):
            self.record({"path": self.path, "unhandled": True})
            self.send_json(404, {"error": {"message": "only chat/completions", "type": "invalid_request_error"}})
            return
        try:
            plan = plan_response(body)
        except Exception as exc:  # never crash: answer plainly
            plan = {"kind": "fallback", "text": "lab", "exception": repr(exc)}
        logged = {k: v for k, v in body.items() if k != "tools"}
        logged["tools"] = [
            (t.get("function") or {}).get("name") for t in body.get("tools") or []
            if isinstance(t, dict)
        ]
        self.record_tools(body.get("tools"))
        self.record({"path": self.path, "request": logged, "plan": plan})
        if plan["kind"] == "error":
            try:
                status = int(plan["status"])
            except ValueError:
                status = 500
            self.send_json(status, {"error": {"message": "scripted error", "type": "server_error"}})
            return
        try:
            if body.get("stream"):
                self.stream(body, plan)
            else:
                self.complete(body, plan)
        except (BrokenPipeError, ConnectionResetError):
            self.record({"path": self.path, "client_gone": True, "plan_kind": plan["kind"]})

    def envelope(self, body):
        return {
            "id": "chatcmpl-" + uuid.uuid4().hex[:20],
            "created": int(time.time()),
            "model": body.get("model") or SCRIPTED_MODEL,
        }

    def complete(self, body, plan):
        time.sleep(plan.get("sleep") or 0)
        message = {"role": "assistant", "content": None}
        if plan["kind"] == "tool":
            message["tool_calls"] = [{
                "id": plan["call_id"], "type": "function",
                "function": {"name": plan["tool"], "arguments": plan["arguments"]}}]
            finish = "tool_calls"
        else:
            message["content"] = plan["text"]
            finish = "stop"
        payload = self.envelope(body)
        payload.update({
            "object": "chat.completion",
            "choices": [{"index": 0, "message": message, "finish_reason": finish}],
            "usage": {"prompt_tokens": 10, "completion_tokens": 5, "total_tokens": 15},
        })
        self.send_json(200, payload)

    def stream(self, body, plan):
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-cache")
        self.send_header("Connection", "close")
        self.end_headers()
        self.close_connection = True
        base = self.envelope(body)
        base["object"] = "chat.completion.chunk"

        def chunk(delta, finish=None):
            payload = dict(base)
            payload["choices"] = [{"index": 0, "delta": delta, "finish_reason": finish}]
            self.wfile.write(b"data: " + json.dumps(payload).encode() + b"\n\n")
            self.wfile.flush()

        chunk({"role": "assistant", "content": ""})
        # A long step keeps the stream open, so the turn reads as working.
        deadline = time.time() + float(plan.get("sleep") or 0)
        while time.time() < deadline:
            time.sleep(min(1.0, max(0.0, deadline - time.time())))
        if plan["kind"] == "tool":
            chunk({"tool_calls": [{"index": 0, "id": plan["call_id"], "type": "function",
                                   "function": {"name": plan["tool"], "arguments": ""}}]})
            args = plan["arguments"]
            for i in range(0, len(args), 16):
                chunk({"tool_calls": [{"index": 0, "function": {"arguments": args[i:i + 16]}}]})
            chunk({}, "tool_calls")
        else:
            text = plan["text"]
            for i in range(0, len(text), 8) or [0]:
                chunk({"content": text[i:i + 8]})
            chunk({}, "stop")
        if (body.get("stream_options") or {}).get("include_usage"):
            payload = dict(base)
            payload["choices"] = []
            payload["usage"] = {"prompt_tokens": 10, "completion_tokens": 5, "total_tokens": 15}
            self.wfile.write(b"data: " + json.dumps(payload).encode() + b"\n\n")
        self.wfile.write(b"data: [DONE]\n\n")
        self.wfile.flush()


def cmd_scripted_model(_lab, args):
    server = ThreadingHTTPServer((args.host, args.port), ScriptedModel)
    server.daemon_threads = True
    server.log_path = args.log
    if args.pidfile:
        with open(args.pidfile, "w") as f:
            f.write(str(os.getpid()))
    print("scripted model on http://%s:%d/v1 log=%s" % (args.host, args.port, args.log),
          flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


# --------------------------------------------------------------------------


def message_id(recipient, keys):
    """Deterministic v2 message id for a delivery: msg_ + sha256 hex prefix."""
    digest = hashlib.sha256(("%s\n%s" % (recipient, "\n".join(sorted(keys)))).encode())
    return "msg_" + digest.hexdigest()[:26]


# --------------------------------------------------------------------------
# v2 client (through the Lab wrapper's env), scripted-model log, herdr


class V2Error(RuntimeError):
    pass


class V2:
    """`opencode api <op>` in the Lab env. Every call returns the `data` field."""

    def __init__(self, lab):
        self.lab = lab

    def api(self, op, params=None, body=None, timeout=60):
        args = ["api", op]
        for key, value in (params or {}).items():
            args += ["--param", "%s=%s" % (key, value)]
        if body is not None:
            args += ["-d", json.dumps(body)]
        p = self.lab.v2(*args, timeout=timeout)
        if p.returncode:
            raise V2Error("%s: %s %s" % (op, p.stdout.strip()[:400], p.stderr.strip()[:200]))
        out = json.loads(p.stdout) if p.stdout.strip() else {}
        return out.get("data", out) if isinstance(out, dict) else out

    def create_session(self, title, agent="coder", fleet=None, permissions=None):
        body = {"agent": agent, "title": title, "location": {"directory": self.lab.repo}}
        if fleet is not None:
            body["metadata"] = {"fleet": fleet}
        if permissions:
            body["permissions"] = permissions
        return self.api("session.create", body=body)

    def get(self, ses):
        return self.api("session.get", {"sessionID": ses})

    def running(self, ses):
        return ses in (self.api("session.active") or {})

    def messages(self, ses, limit=None, order=None, type_=None):
        params = {"sessionID": ses}
        if limit:
            params["limit"] = limit
        if order:
            params["order"] = order
        if type_:
            params["type"] = type_
        return self.api("session.message.list", params)

    def inbox(self, ses):
        return self.api("session.inbox.list", {"sessionID": ses})

    def synthetic(self, ses, text, resume, delivery, keys, msg_id=None, description=None):
        body = {"id": msg_id or message_id(ses, keys), "text": text, "resume": resume,
                "delivery": delivery, "metadata": {"fleet": {"keys": list(keys)}}}
        if description:
            body["description"] = description
        return self.api("session.synthetic", {"sessionID": ses}, body)

    def prompt(self, ses, text, metadata=None, **extra):
        body = dict(extra, text=text)
        if metadata is not None:
            body["metadata"] = metadata
        return self.api("session.prompt", {"sessionID": ses}, body)

    def inbox_update(self, ses, inbox_id, delivery):
        return self.api("session.inbox.update", {"sessionID": ses, "inboxID": inbox_id},
                        {"delivery": delivery})

    def permissions(self, ses):
        return self.api("session.permission.list", {"sessionID": ses})

    def permission_reply(self, ses, request_id, decision="once"):
        return self.api("session.permission.reply", {"sessionID": ses, "requestID": request_id},
                        {"decision": decision})

    def wait(self, predicate, timeout=60, interval=0.25):
        """Poll predicate() until truthy; returns (value, seconds) or (None, seconds)."""
        start = time.time()
        while True:
            value = predicate()
            if value or time.time() - start > timeout:
                return value, round(time.time() - start, 2)
            time.sleep(interval)

    def wait_running(self, ses, timeout=15):
        return self.wait(lambda: self.running(ses), timeout)

    def wait_idle(self, ses, timeout=90):
        return self.wait(lambda: not self.running(ses), timeout)


def model_log_path(lab):
    return os.path.join(lab.runs, "scripted-model.jsonl")


def model_requests(lab, since, marker=None):
    """Scripted-model requests logged at or after `since` (epoch seconds),
    optionally only those whose messages mention `marker`."""
    found = []
    try:
        with open(model_log_path(lab)) as f:
            for line in f:
                try:
                    entry = json.loads(line)
                except ValueError:
                    continue
                if entry.get("time", 0) < since or "request" not in entry:
                    continue
                if marker and marker not in json.dumps(entry["request"].get("messages")):
                    continue
                found.append(entry)
    except OSError:
        pass
    return found


def request_outline(entry, width=70):
    """[(index, role, snippet)] for one logged model request."""
    outline = []
    for i, message in enumerate(entry["request"].get("messages") or []):
        if not isinstance(message, dict):
            continue
        text = message_text(message).replace("\n", " | ")
        if message.get("tool_calls"):
            text = "tool_calls " + ",".join(
                (c.get("function") or {}).get("name", "?") for c in message["tool_calls"])
        outline.append((i, message.get("role"), text[:width]))
    return outline


def message_outline(message, width=70):
    """One line per v2 transcript message: type, id, time, text, metadata."""
    text = message.get("text")
    if text is None:
        text = " ".join(p.get("text", "") for p in message.get("content") or []
                        if isinstance(p, dict) and p.get("type") == "text")
    keys = sorted(k for k in message if k not in ("id", "type", "time", "text", "content",
                                                  "snapshot", "tokens", "cost", "model"))
    return {"type": message.get("type"), "id": message.get("id"),
            "created": (message.get("time") or {}).get("created"),
            "text": (text or "").replace("\n", " | ")[:width],
            "metadata": message.get("metadata"), "other_keys": keys}


def herdr(*args, timeout=30):
    """herdr CLI with JSON output; returns the `result` field."""
    p = subprocess.run(["herdr"] + list(args), capture_output=True, text=True, timeout=timeout)
    out = p.stdout.strip()
    try:
        data = json.loads(out)
    except ValueError:
        return {"rc": p.returncode, "stdout": out, "stderr": p.stderr.strip()}
    return data.get("result", data) if isinstance(data, dict) else data


LAB_WORKSPACE_LABEL = "Switchboard Lab"


def lab_workspace():
    """The one herdr workspace the Lab may type into, or None."""
    for ws in (herdr("workspace", "list").get("workspaces") or []):
        if ws.get("label") == LAB_WORKSPACE_LABEL:
            return ws
    return None


def lab_pane_guard(pane):
    """Refuse any pane outside the Lab workspace: the runner types only there."""
    ws = lab_workspace()
    info = herdr("pane", "get", pane)
    pane_ws = (info.get("pane") or info).get("workspace_id")
    if not ws or pane_ws != ws["workspace_id"]:
        raise SystemExit("refused: pane %s is not in the %r workspace" % (pane, LAB_WORKSPACE_LABEL))
    return pane


def pane_text(pane, source="visible"):
    p = subprocess.run(["herdr", "pane", "read", pane, "--source", source],
                       capture_output=True, text=True, timeout=30)
    out = p.stdout
    try:
        data = json.loads(out)
        res = data.get("result", data)
        return res.get("text") or res.get("content") or json.dumps(res)
    except ValueError:
        return out


def agent_status(name):
    info = herdr("agent", "get", name)
    return info.get("agent") or info


def iso_epoch(text):
    """`2026-10-02T17:00:00.123Z` -> epoch seconds; None when it is not one."""
    try:
        return datetime.strptime(text, "%Y-%m-%dT%H:%M:%S.%fZ").replace(tzinfo=timezone.utc).timestamp()
    except (TypeError, ValueError):
        return None


def fleet_session(agent):
    """The session id in a herdr agent's `agent_session` (an object in herdr 0.9)."""
    value = (agent or {}).get("agent_session")
    return value.get("value") if isinstance(value, dict) else value


def lab_tui_guard(lab, pane):
    """The pane's foreground process must be the Lab's v2. A Lab pane's shell
    re-runs the user's zsh startup files, which put /opt/homebrew/bin (v1)
    ahead of the workspace's PATH, so `opencode` there is v1 unless fixed."""
    info = herdr("pane", "process-info", "--pane", pane).get("process_info") or {}
    cmdlines = [p.get("cmdline", "") for p in info.get("foreground_processes") or []]
    if not any(c.startswith(lab.v2_bin) for c in cmdlines):
        raise SystemExit("refused: pane %s does not run the Lab v2: %s" % (pane, cmdlines))
    return pane


class StatusWatch(threading.Thread):
    """Sample `herdr agent get <name>` and keep (seconds, agent_status) changes."""

    def __init__(self, name, interval=0.4):
        super().__init__(daemon=True)
        self.name, self.interval = name, interval
        self.start_time = time.time()
        self.changes, self.stop_flag = [], threading.Event()

    def run(self):
        last = None
        while not self.stop_flag.is_set():
            status = agent_status(self.name).get("agent_status")
            if status != last:
                self.changes.append((round(time.time() - self.start_time, 1), status))
                last = status
            time.sleep(self.interval)

    def stop(self):
        self.stop_flag.set()
        self.join(5)
        return self.changes


# --------------------------------------------------------------------------
# Spikes S3-S5 (API side). Each prints its evidence as JSON lines.


def emit(label, value):
    print(json.dumps({"step": label, "value": value}, default=str), flush=True)


def tag():
    return uuid.uuid4().hex[:6]


def spike_session(v2, title, permissions=None):
    fleet = {"name": "lab-" + title.lower().replace(" ", "-"), "role": "coder",
             "reports_to": "platform", "issue": 1}
    ses = v2.create_session(title, fleet=fleet, permissions=permissions)
    # One finished turn first, so the session is a normal idle one.
    v2.prompt(ses["id"], "warm up\n@script reply=WARM")
    v2.wait_running(ses["id"], 5)
    v2.wait_idle(ses["id"])
    return ses


def requests_since(lab, since, marker):
    return [{"t": round(e["time"] - since, 2), "plan": e["plan"].get("kind"),
             "messages": request_outline(e)} for e in model_requests(lab, since, marker)]


def spike_s3(lab, args):
    v2 = V2(lab)
    out = {}
    # (a) idle: a note with each delivery waits, starts no turn, rides the next prompt.
    for delivery in ("queue", "steer"):
        ses = spike_session(v2, "S3a %s" % delivery)["id"]
        mark = "NOTE-%s-%s" % (delivery, tag())
        t0 = time.time()
        rec = v2.synthetic(ses, "fleet note %s" % mark, False, delivery, [mark])
        time.sleep(4)
        result = {"session": ses, "synthetic": rec, "running_after_4s": v2.running(ses),
                  "model_requests_4s": len(model_requests(lab, t0, mark)),
                  "inbox": [(i.get("id"), i.get("delivery"), i.get("resume"))
                            for i in v2.inbox(ses)]}
        human = "human question %s\n@script reply=SAW" % tag()
        v2.prompt(ses, human)
        v2.wait_running(ses, 5)
        v2.wait_idle(ses)
        result["after_prompt_requests"] = requests_since(lab, t0, mark)
        result["inbox_after"] = v2.inbox(ses)
        result["transcript"] = [message_outline(m) for m in reversed(v2.messages(ses, limit=6))]
        out["a_" + delivery] = result
        emit("S3a " + delivery, result)
    # (b) busy: notes sent while a sleep=20 turn runs.
    for delivery in ("queue", "steer"):
        for shape, script in (("one-step", "@script sleep=20 reply=DONE"),
                              ("two-step", '@script sleep=8 tool=bash cmd="echo a" sleep=8 reply=DONE')):
            ses = spike_session(v2, "S3b %s %s" % (delivery, shape))["id"]
            mark = "NOTE-%s-%s" % (delivery, tag())
            t0 = time.time()
            v2.prompt(ses, "long task %s\n%s" % (tag(), script))
            v2.wait_running(ses, 5)
            time.sleep(3)
            v2.synthetic(ses, "fleet note %s" % mark, False, delivery, [mark])
            inbox_mid = [(i.get("id"), i.get("delivery")) for i in v2.inbox(ses)]
            _, took = v2.wait_idle(ses, 60)
            time.sleep(2)
            result = {"session": ses, "inbox_mid": inbox_mid, "turn_s": took,
                      "inbox_after_turn": [(i.get("id"), i.get("delivery")) for i in v2.inbox(ses)],
                      "requests_with_note": requests_since(lab, t0, mark),
                      "running_after": v2.running(ses),
                      "transcript": [message_outline(m) for m in
                                     reversed(v2.messages(ses, limit=8))]}
            out["b_%s_%s" % (delivery, shape)] = result
            emit("S3b %s %s" % (delivery, shape), result)
    # (c) a waiting queue note switched to steer on an idle session.
    ses = spike_session(v2, "S3c")["id"]
    mark = "NOTE-c-%s" % tag()
    rec = v2.synthetic(ses, "fleet note %s\n@script reply=STEERED" % mark, False, "queue", [mark])
    time.sleep(3)
    before = {"running": v2.running(ses), "inbox": len(v2.inbox(ses))}
    t0 = time.time()
    upd = v2.inbox_update(ses, rec["id"], "steer")
    started, took = v2.wait_running(ses, 10)
    v2.wait_idle(ses)
    result = {"session": ses, "before": before, "update": upd, "turn_started": bool(started),
              "start_after_s": took, "requests": requests_since(lab, t0, mark),
              "inbox_after": v2.inbox(ses),
              "transcript": [message_outline(m) for m in reversed(v2.messages(ses, limit=4))]}
    out["c"] = result
    emit("S3c", result)
    return 0


def spike_s4(lab, args):
    v2 = V2(lab)
    # (a) idle wake.
    ses = spike_session(v2, "S4a")["id"]
    mark = "WAKE-a-%s" % tag()
    t0 = time.time()
    rec = v2.synthetic(ses, "fleet wake %s\n@script reply=WOKE" % mark, True, "queue", [mark])
    started, took = v2.wait_running(ses, 10)
    v2.wait_idle(ses)
    emit("S4a", {"session": ses, "synthetic": rec, "turn_started": bool(started),
                 "start_after_s": took, "requests": requests_since(lab, t0, mark),
                 "transcript": [message_outline(m) for m in reversed(v2.messages(ses, limit=4))]})
    # (b) busy wake: queued behind a running turn.
    for shape, script in (("one-step", "@script sleep=20 reply=DONE"),
                          ("two-step", '@script sleep=8 tool=bash cmd="echo a" sleep=8 reply=DONE')):
        ses = spike_session(v2, "S4b %s" % shape)["id"]
        mark = "WAKE-b-%s" % tag()
        t0 = time.time()
        v2.prompt(ses, "long task %s\n%s" % (tag(), script))
        v2.wait_running(ses, 5)
        time.sleep(3)
        v2.synthetic(ses, "fleet wake %s\n@script reply=WOKE" % mark, True, "queue", [mark])
        inbox_mid = [(i.get("id"), i.get("delivery"), i.get("resume")) for i in v2.inbox(ses)]
        v2.wait(lambda: not v2.running(ses) and not v2.inbox(ses), 90)
        time.sleep(2)
        msgs = list(reversed(v2.messages(ses, limit=12)))
        emit("S4b " + shape, {
            "session": ses, "inbox_mid": inbox_mid, "requests": requests_since(lab, t0, "long task"),
            "wake_requests": requests_since(lab, t0, mark),
            "transcript": [message_outline(m) for m in msgs]})
    return 0


def spike_s5(lab, args):
    v2 = V2(lab)
    fleet = {"name": "lab-s5", "role": "coder", "reports_to": "platform", "issue": 5,
             "nested": {"list": [1, "two"], "flag": True}}
    ses = v2.create_session("S5", fleet=fleet)
    sid = ses["id"]
    got = v2.get(sid)
    emit("S5 metadata", {"sent": fleet, "got": got.get("metadata"),
                         "exact": (got.get("metadata") or {}).get("fleet") == fleet,
                         "time": got.get("time"), "outcome": got.get("outcome")})
    v2.prompt(sid, "fleet brief\n@script reply=BRIEFED",
              metadata={"fleet": {"from": "switchboard", "keys": ["brief:lab-s5"]}})
    v2.wait_running(sid, 5)
    v2.wait_idle(sid)
    first = v2.get(sid)
    mark = "NOTE-s5-%s" % tag()
    v2.synthetic(sid, "fleet note %s" % mark, False, "queue", [mark, "issue:5"])
    emit("S5 inbox", v2.inbox(sid))
    v2.prompt(sid, "plain human prompt\n@script reply=HUMAN")
    v2.wait_running(sid, 5)
    v2.wait_idle(sid)
    second = v2.get(sid)
    emit("S5 idle/outcome", {"after_turn1": [first.get("time"), first.get("outcome")],
                             "after_turn2": [second.get("time"), second.get("outcome")]})
    page = v2.messages(sid, limit=2)
    emit("S5 newest-first limit=2", [message_outline(m) for m in page])
    # Stop early: walk newest first until the first user message without fleet metadata.
    seen, found = 0, None
    for m in v2.messages(sid, limit=50):
        seen += 1
        if m.get("type") == "user" and not (m.get("metadata") or {}).get("fleet"):
            found = message_outline(m)
            break
    emit("S5 last human prompt", {"read": seen, "found": found})
    emit("S5 full transcript", [message_outline(m, 50) for m in
                                reversed(v2.messages(sid, limit=50))])
    emit("S5 raw user/synthetic", [m for m in v2.messages(sid, limit=50)
                                   if m.get("type") in ("user", "synthetic")])
    return 0


def spike_s6(lab, args):
    """TUI side, in a Lab pane already running `opencode -s <session>` as herdr
    agent `args.agent`: draft safety under wakes (S4c), status transitions and
    blocked (S6), the unread token (S6). Types only into the Lab pane."""
    v2, pane, ses = V2(lab), lab_tui_guard(lab, lab_pane_guard(args.pane)), args.session
    watch = StatusWatch(args.agent)
    watch.start()

    def draft_check(label, draft, t0, mark):
        screen = pane_text(pane)
        users = [m for m in v2.messages(ses, limit=40) if m.get("type") == "user"]
        emit(label, {"draft_on_screen": draft in screen,
                     "draft_in_transcript": any(draft in (m.get("text") or "") for m in users),
                     "screen_tail": [l.rstrip() for l in screen.splitlines() if l.strip()][-14:],
                     "wake_requests": requests_since(lab, t0, mark),
                     "status_changes": list(watch.changes)})

    # S4c idle: a draft sits in the input box, then a wake arrives.
    draft = "half typed draft %s" % tag()
    subprocess.run(["herdr", "pane", "send-text", pane, draft], check=True, capture_output=True)
    time.sleep(1)
    mark = "WAKE-tui-idle-%s" % tag()
    t0 = time.time()
    v2.synthetic(ses, "fleet wake %s\n@script sleep=12 reply=WOKE" % mark, True, "queue", [mark])
    v2.wait_running(ses, 10)
    time.sleep(4)
    emit("S4c idle mid-turn screen", [l.rstrip() for l in pane_text(pane).splitlines()
                                      if l.strip()][-14:])
    v2.wait_idle(ses, 60)
    time.sleep(2)
    draft_check("S4c idle wake", draft, t0, mark)
    # S4c busy: a fleet prompt runs, the draft grows, a wake is queued behind it.
    t0 = time.time()
    v2.prompt(ses, "fleet task %s\n@script sleep=12 reply=DONE" % tag(),
              metadata={"fleet": {"from": "switchboard", "keys": ["task:%s" % tag()]}})
    v2.wait_running(ses, 10)
    time.sleep(2)
    more = " and more %s" % tag()
    subprocess.run(["herdr", "pane", "send-text", pane, more], check=True, capture_output=True)
    mark = "WAKE-tui-busy-%s" % tag()
    v2.synthetic(ses, "fleet wake %s\n@script reply=WOKE2" % mark, True, "queue", [mark])
    v2.wait(lambda: not v2.running(ses) and not v2.inbox(ses), 90)
    time.sleep(2)
    draft_check("S4c busy wake", draft + more, t0, mark)
    # S6 blocked: a shell permission ask (the session asks for shell).
    t0 = time.time()
    v2.prompt(ses, "fleet task needing shell\n@script tool=bash cmd=\"echo hi\" reply=SHELLED",
              metadata={"fleet": {"from": "switchboard", "keys": ["ask:%s" % tag()]}})
    asks, took = v2.wait(lambda: v2.permissions(ses), 20)
    time.sleep(4)
    blocked = {"asks": asks, "ask_after_s": took, "agent": agent_status(args.agent),
               "location_requests": v2.api("permission.request.list",
                                           {"location[directory]": lab.repo})}
    if asks:
        blocked["reply"] = v2.permission_reply(ses, asks[0]["id"], "once")
    v2.wait_idle(ses, 30)
    time.sleep(2)
    blocked["after"] = agent_status(args.agent).get("agent_status")
    emit("S6 blocked", blocked)
    # S6 unread token: display-only metadata.
    rep = herdr("pane", "report-metadata", pane, "--source", "fleet-switchboard",
                "--token", "unread=2")
    time.sleep(1)
    emit("S6 report-metadata", {"report": rep, "pane_get": herdr("pane", "get", pane),
                                "agent_get": herdr("agent", "get", args.agent)})
    emit("S6 status changes (s since start, agent_status)", watch.stop())
    return 0


def cmd_spike(lab, args):
    if args.which == "s6" and not (args.pane and args.agent and args.session):
        raise SystemExit("spike s6 needs --pane, --agent and --session")
    return {"s3": spike_s3, "s4": spike_s4, "s5": spike_s5, "s6": spike_s6}[args.which](lab, args)


# --------------------------------------------------------------------------
# Scenario runner: the lab-scripted tier
#
# `run` plays scenario files (docs/switchboard.md, "Scenario testing") in the
# Lab. Each cast member is a fresh Lab v2 session carrying metadata.fleet. The
# one member whose screen the scenario needs (a draft, herdr status) is shown
# by the Lab pane's TUI. Steps run in real time. Expectations are checked
# against the systems that own the facts: v2's transcript, inbox and session
# record, the scripted model's request log, herdr's agent status and pane
# reads. What the runner or the engine did is evidence, never an oracle. Then
# the control plays on fresh sessions and must break every expectation it
# names.
#
# The vocabulary (every action, expectation and control, with its fields) is
# bin/fleet-scenario's, and scenarios/switchboard/README.md explains it. How
# this tier plays each one:
#   turn        (a cast member) one fleet prompt whose script takes `lasts`,
#               split over `steps` model steps (steps-1 shell calls, then DONE)
#   permission  (a cast member) asks to run a shell command; its session is
#               created with shell set to ask. (you) answers the pending ask
#   message     (you) through the TUI when `to` is the member on screen, else
#               session.prompt without metadata.fleet
#   draft       (you) herdr pane send-text, no Enter
#   synthetic | note | wake  session.synthetic; note = resume false + steer,
#               wake = resume true + queue, synthetic = resume false + steer.
#               `id` is a name: the same name in one play is the same derived
#               v2 message id; without it the id derives from session and key
#   fact        a line in the engine's Lab fact source, $STATE/lab-facts.jsonl,
#               created at the step's scheduled time. In the `fleet-heartbeat`
#               baseline the runner instead types the wake into the agent's
#               pane with `herdr agent prompt`, as the old heartbeat did; it
#               is the only code allowed to type, and only in a Lab pane
#   launch      `fleet-switchboard launch` for a cast member, into the Lab
#               workspace; the member has no session until it runs. The runner
#               closes the pane it opened when the play ends
#   pass        one `fleet-switchboard run --once`, with the step's faults
#   kill-daemon, restart-daemon  stop, and start again, the engine's daemon
#   wait, away  only mark time here
# A scenario with a fact, pass or daemon step runs the real engine
# (bin/fleet-switchboard) on a private config and state under $LAB/runs/engine,
# as a daemon polling every ENGINE_POLL seconds from t0 until the last step.
# Every cast member then runs the Lab TUI in its own "Switchboard Lab" pane,
# so the engine discovers it as herdr does in the fleet. A `fault` control
# plays the scenario again with that fault on every engine process.
# The runner writes the scripted model's `@script` line itself; a scenario
# never carries one. The warm-up and every `turn` are the fleet's prompts
# (metadata.fleet), so only `message` counts as you prompting.

SCENARIO_DIR = os.path.join(REPO_ROOT, "scenarios", "switchboard")
RUNS_DIR = os.path.join(REPO_ROOT, "scenario-runs")
RUN_TIERS = ("lab-scripted",)
LAB_TUI_AGENT = "lab-tui"
ENGINE = os.path.join(REPO_ROOT, "bin", "fleet-switchboard")
ENGINE_POLL = 5  # seconds between the Lab daemon's passes, as the offline runner's
ENGINE_ACTIONS = ("fact", "pass", "kill-daemon", "restart-daemon")
# What this tier plays and checks.
RUN_ACTIONS = ("turn", "message", "draft", "away", "permission", "synthetic", "note", "wake",
               "wait", "launch") + ENGINE_ACTIONS
RUN_EXPECTATIONS = ("no_machine_turn", "within", "draft_intact", "tool_outcome", "delivered",
                    "message_count", "model_saw", "status_is", "metadata_roundtrip", "pane_runs_v2",
                    "no_typing")
RUN_BASELINES = ("fleet-heartbeat",)
SYNTHETIC_DEFAULTS = {"note": (False, "steer"), "wake": (True, "queue"),
                      "synthetic": (False, "steer")}
ROLE_AGENTS = {"orchestrator": "orchestrator", "coder": "coder",
               "chief-of-staff": "chief-of-staff", "cos-subagent": "coder"}
# Requests v2 makes on its own (titles, summaries) are nobody's turn.
UPKEEP_PLANS = ("title", "summary", "maintenance")
ASK_SHELL = [{"action": "shell", "resource": "*", "effect": "ask"}]
# The fleet's own prompts (the warm-up brief, an agent's turn) carry this, so
# neither the engine nor an oracle takes them for yours.
RUNNER_FLEET = {"from": "lab-runner"}


class RunError(RuntimeError):
    pass


def fleet_scenario():
    """bin/fleet-scenario: the one validator and duration parser."""
    path = os.path.join(REPO_ROOT, "bin", "fleet-scenario")
    loader = importlib.machinery.SourceFileLoader("proof_fleet_scenario", path)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def scenario_paths(paths):
    files = []
    for raw in paths:
        if os.path.isdir(raw):
            files.extend(sorted(os.path.join(raw, n) for n in os.listdir(raw) if n.endswith(".json")))
        else:
            files.append(raw)
    return files


def fleet_metadata(name, member):
    fleet = {"name": name, "role": member["role"]}
    for key in ("reports_to", "issue", "charter"):
        if key in member:
            fleet[key] = member[key]
    return fleet


def tui_members(scenario):
    """Cast members whose screen the scenario needs: draft targets, herdr status."""
    names = [s.get("to") for s in scenario["steps"] if s.get("do") == "draft"]
    names += [e.get("agent") for e in scenario["expect"]
              if e.get("that") in ("status_is", "draft_intact")]
    return sorted(set(n for n in names if n))


def uses_engine(scenario):
    """True when a step needs the switchboard engine: a fact, a pass, the daemon, a launch."""
    return any(step["do"] in ENGINE_ACTIONS or step["do"] == "launch" for step in scenario["steps"])


def runs_daemon(scenario):
    """True when the engine's daemon runs through the play, watching a TUI per cast member."""
    return any(step["do"] in ENGINE_ACTIONS for step in scenario["steps"])


def launched_members(scenario):
    """Cast members `launch` creates: they have no session until it runs."""
    return sorted({step["agent"] for step in scenario["steps"] if step["do"] == "launch"})


def unsupported(scenario, fs):
    """Why this tier cannot play the scenario yet (empty when it can). The
    fields themselves are checked by fleet-scenario when the file loads."""
    reasons = []
    for i, step in enumerate(scenario["steps"]):
        if step["do"] not in RUN_ACTIONS:
            reasons.append("step %d `%s` is not built in this tier yet" % (i, step["do"]))
    for i, item in enumerate(scenario["expect"]):
        if item["that"] not in RUN_EXPECTATIONS:
            reasons.append("expect %s `%s`: not supported in this tier yet"
                           % (item.get("name", i), item["that"]))
    control = scenario["control"]
    if "baseline" in control:
        if control["baseline"] not in RUN_BASELINES:
            reasons.append("control baseline %r is not built in this tier yet" % control["baseline"])
        elif not tui_members(scenario) or not any(step["do"] == "fact" for step in scenario["steps"]):
            reasons.append("baseline %r types into a pane: it needs a fact step and a cast member on screen"
                           % control["baseline"])
    elif "fault" in control and not uses_engine(scenario):
        reasons.append("control fault %r needs the switchboard engine, and no step runs it"
                       % control["fault"])
    if len(tui_members(scenario)) > 1:
        reasons.append("more than one agent's screen is checked; the runner watches one")
    return reasons


def herdr_run(*args, timeout=30):
    return subprocess.run(["herdr"] + list(args), capture_output=True, text=True, timeout=timeout)


def default_lab_pane():
    ws = lab_workspace()
    if not ws:
        return None
    panes = herdr("pane", "list", "--workspace", ws["workspace_id"]).get("panes") or []
    return panes[0]["pane_id"] if panes else None


def lab_shell_ready(lab, pane):
    """Bring the Lab pane to its shell prompt with the Lab's v2 first on PATH.
    A Lab TUI there is quit with ctrl+c; the first one clears its input box."""
    lab_pane_guard(pane)
    for _ in range(4):
        info = herdr("pane", "process-info", "--pane", pane).get("process_info") or {}
        cmdlines = [p.get("cmdline", "") for p in info.get("foreground_processes") or []]
        if not any(c.startswith(lab.v2_bin) for c in cmdlines):
            break
        herdr_run("pane", "send-keys", pane, "ctrl+c")
        time.sleep(1.0)
    info = herdr("pane", "process-info", "--pane", pane).get("process_info") or {}
    if not info.get("shell_pid") or info.get("foreground_process_group_id") != info.get("shell_pid"):
        raise SystemExit("refused: pane %s is not at its shell prompt" % pane)
    # The user's zsh startup files put v1 ahead of the workspace PATH (S6):
    # put the Lab first again and prove `opencode` is the Lab wrapper. The
    # marker lets the wrapper keep this pane's herdr identity, so the TUI
    # plugin reports its status (a split pane may not have the workspace env).
    nonce = "LABPATH-" + tag()
    herdr_run("pane", "run", pane, 'export FLEET_SWITCHBOARD_LAB_PANE=1 PATH=%s:"$PATH"; hash -r; '
              'echo %s=$(command -v opencode)' % (shlex.quote(lab.bin_dir), nonce))
    found = herdr_run("pane", "wait-output", "--match", "%s=%s" % (nonce, lab.wrapper),
                      "--source", "recent-unwrapped", "--timeout", "8000", pane, timeout=20)
    if found.returncode:
        raise SystemExit("refused: in pane %s `opencode` is not the Lab wrapper" % pane)


def lab_tui_attach(lab, pane, agent, ses):
    """Show session `ses` in the Lab pane's TUI, as herdr agent `agent`."""
    lab_shell_ready(lab, pane)
    p = herdr_run("agent", "start", agent, "--kind", "opencode", "--pane", pane,
                  "--timeout", "30000", "--", "-s", ses, timeout=45)
    lab_tui_guard(lab, pane)
    if p.returncode:
        raise RunError("herdr agent start: %s" % (p.stdout + p.stderr).strip()[:300])
    info = herdr("pane", "process-info", "--pane", pane).get("process_info") or {}
    if not any(ses in p.get("cmdline", "") for p in info.get("foreground_processes") or []):
        raise RunError("the Lab TUI in %s is not on %s" % (pane, ses))


def lab_panes():
    """Every pane of the Lab workspace, p1 first."""
    ws = lab_workspace()
    if not ws:
        return []
    panes = herdr("pane", "list", "--workspace", ws["workspace_id"]).get("panes") or []
    ids = [p["pane_id"] for p in panes if p.get("workspace_id") == ws["workspace_id"]]
    return sorted(ids, key=lambda p: (len(p), p))


def new_lab_pane(lab, beside):
    """One more pane in the Lab workspace, split from `beside`, without focus."""
    lab_pane_guard(beside)
    p = herdr_run("pane", "split", beside, "--direction", "down", "--no-focus", "--cwd", lab.repo)
    try:
        pane = json.loads(p.stdout)["result"]["pane"]["pane_id"]
    except (ValueError, KeyError, TypeError):
        raise RunError("herdr pane split: %s" % (p.stdout + p.stderr).strip()[:300])
    lab_pane_guard(pane)
    for _ in range(40):  # the new shell runs the user's startup files first
        info = herdr("pane", "process-info", "--pane", pane).get("process_info") or {}
        if info.get("shell_pid") and info.get("foreground_process_group_id") == info.get("shell_pid"):
            break
        time.sleep(0.25)
    return pane


def herdr_socket():
    """The herdr server's socket, so the engine's herdr calls reach it while its
    XDG_CONFIG_HOME points at a scratch dir (herdr finds its socket there)."""
    if os.environ.get("HERDR_SOCKET_PATH"):
        return os.environ["HERDR_SOCKET_PATH"]
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(base, "herdr", "herdr.sock")


class LabEngine:
    """bin/fleet-switchboard on a private config and state for one play.

    XDG_CONFIG_HOME and XDG_STATE_HOME point under $LAB/runs/engine/<play>, so
    the user's own switchboard config and state are never read or written;
    the config names the Lab's v2 wrapper by absolute path; FLEET_SWITCHBOARD_LAB=1
    turns the Lab fact source and faults on. The engine never types into a
    pane: its herdr client cannot. Its output and audit log are evidence only.
    """

    def __init__(self, lab, name, faults, note):
        self.lab, self.faults, self.note = lab, sorted(faults), note
        self.root = os.path.join(lab.runs, "engine", name)
        self.config_home = os.path.join(self.root, "config")
        self.state_home = os.path.join(self.root, "state")
        self.state = os.path.join(self.state_home, "fleet-switchboard")
        for path in (self.config_home, self.state_home):
            real = os.path.realpath(path)
            if not real.startswith(os.path.realpath(lab.root) + os.sep):
                raise RunError("refused: engine dir %s is outside the Lab" % path)
        os.makedirs(os.path.join(self.config_home, "fleet-switchboard"), exist_ok=True)
        os.makedirs(self.state, mode=0o700, exist_ok=True)
        os.chmod(self.state, 0o700)
        # The wrapper execs the real v2, so a pane runs lab.v2_bin; `launch` starts the TUI with the
        # marker the wrapper needs to keep the pane's herdr identity (its plugin reports status).
        self.config = {"opencode": lab.wrapper, "opencode_executable": lab.v2_bin,
                       "launch_env": {"FLEET_SWITCHBOARD_LAB_PANE": "1"},
                       "herdr": shutil.which("herdr") or "herdr"}
        with open(os.path.join(self.config_home, "fleet-switchboard", "config.json"), "w") as f:
            json.dump(self.config, f, indent=2, sort_keys=True)
        self.log_path = os.path.join(self.root, "daemon.log")
        self.proc, self.on, self.starts, self.exits = None, True, 0, []

    def env(self, faults=()):
        env = self.lab.full_env()  # no credentials, no live pane identity, Lab bin first
        env.pop("FLEET_SWITCHBOARD_LAB_PANE", None)
        env.update({"XDG_CONFIG_HOME": self.config_home, "XDG_STATE_HOME": self.state_home,
                    "FLEET_SWITCHBOARD_LAB": "1", "HERDR_SOCKET_PATH": herdr_socket(),
                    "FLEET_SWITCHBOARD_FAULT": ",".join(sorted(set(self.faults) | set(faults)))})
        return env

    def fact(self, step, created):
        line = {"key": step["key"], "recipient": step["to"], "kind": step.get("kind", "lab.fact"),
                "summary": step["summary"], "created": created, "issue": step.get("issue"),
                "batch": step.get("batch", True), "from": step.get("from", "world")}
        with open(os.path.join(self.state, "lab-facts.jsonl"), "a") as f:
            f.write(json.dumps(line, sort_keys=True) + "\n")
        return line

    def run_pass(self, faults=()):
        """One `run --once`. A daemon running now is stopped first (they share a lock)."""
        if self.running():
            self.stop("a pass step")
        p = subprocess.run([sys.executable, ENGINE, "run", "--once", "--json"], env=self.env(faults),
                           capture_output=True, text=True, timeout=180)
        try:
            report = json.loads(p.stdout)
        except ValueError:
            report = None
        return {"rc": p.returncode, "faults": sorted(set(self.faults) | set(faults)), "report": report,
                "stderr": short(p.stderr, 300)}

    def launch(self, args, timeout=120):
        """`fleet-switchboard launch ...` on this engine's config and state."""
        return subprocess.run([sys.executable, ENGINE, "launch"] + list(args), env=self.env(),
                              capture_output=True, text=True, timeout=timeout)

    def running(self):
        return self.proc is not None and self.proc.poll() is None

    def ensure(self):
        """The daemon runs while it is on; one that exited (a crash fault) is restarted."""
        if not self.on or self.running():
            return
        if self.proc is not None:
            self.exits.append(self.proc.returncode)
            self.note("daemon", event="exited", rc=self.proc.returncode)
        log = open(self.log_path, "a")
        self.proc = subprocess.Popen([sys.executable, ENGINE, "run", "--poll", str(ENGINE_POLL)],
                                     env=self.env(), stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                                     start_new_session=True)
        log.close()
        self.starts += 1
        self.note("daemon", event="started", pid=self.proc.pid, faults=self.faults)

    def stop(self, why):
        if not self.running():
            return
        self.proc.terminate()
        try:
            self.proc.wait(10)
        except subprocess.TimeoutExpired:
            self.proc.kill()
            self.proc.wait(5)
        self.note("daemon", event="stopped", why=why, rc=self.proc.returncode)
        self.proc = None

    def audit(self):
        try:
            with open(os.path.join(self.state, "audit.jsonl")) as f:
                return [json.loads(line) for line in f if line.strip()]
        except (OSError, ValueError):
            return []


def input_box(screen):
    """The TUI's input box from a pane read: the `┃` lines above the `╹`
    footer. The last of them names the agent and model; the rest are the
    text waiting to be sent."""
    lines = screen.splitlines()
    ends = [i for i, line in enumerate(lines) if line.strip().startswith("\u2579")]
    if not ends:
        return None
    box, i = [], ends[-1] - 1
    while i >= 0 and lines[i].strip().startswith("\u2503"):
        box.insert(0, lines[i].strip()[1:].strip())
        i -= 1
    return {"text": " ".join(l for l in box[:-1] if l), "status_line": box[-1] if box else ""}


def squash(text):
    return " ".join((text or "").split())


def transcript_text(message):
    text = message.get("text")
    if text is None:
        text = " ".join(p.get("text", "") for p in message.get("content") or []
                        if isinstance(p, dict) and p.get("type") == "text")
    return text or ""


def fleet_of(message):
    meta = message.get("metadata") or (message.get("payload") or {}).get("metadata") or {}
    return meta.get("fleet") if isinstance(meta, dict) else None


def request_messages(entry):
    """[(role, text)] of one logged model request; tool calls as `tool_calls <names>`."""
    out = []
    for message in entry["request"].get("messages") or []:
        if not isinstance(message, dict):
            continue
        text = message_text(message)
        if message.get("tool_calls"):
            text = (text + " tool_calls " + ",".join(
                (c.get("function") or {}).get("name", "?") for c in message["tool_calls"])).strip()
        out.append((message.get("role"), text))
    return out


def last_user(entry):
    users = [text for role, text in request_messages(entry) if role == "user"]
    return users[-1] if users else ""


def short(text, width=90):
    text = squash(text)
    return text if len(text) <= width else text[:width - 1] + "\u2026"


class ScenarioRun:
    """One play of a scenario, the run or its control, on fresh sessions."""

    def __init__(self, lab, scenario, label, pane, seconds, faults=(), baseline=None):
        self.lab, self.v2 = lab, V2(lab)
        self.scenario, self.label, self.pane = scenario, label, pane
        self.seconds, self.faults, self.baseline = seconds, sorted(faults), baseline
        self.launched_panes = []  # panes `launch` opened: the runner closes them
        self.tag = tag()
        self.cast, self.facts = {}, {}
        self.tui = (tui_members(scenario) or [None])[0]
        self.tui_ready = False
        self.engine, self.screens = None, {}  # screens: cast name -> (pane, herdr agent)
        self.timeline, self.step_times, self.step_errors = [], {}, []
        self.t_setup = time.time()
        self.t0, self.watch, self.status_changes, self.screen = None, None, [], None
        self.error = None

    def note(self, kind, when=None, **fields):
        entry = {"wall": when or time.time(), "run": self.label, "kind": kind}
        entry.update(fields)
        self.timeline.append(entry)

    def session(self, name):
        return self.cast[name]["session"]

    # ---- setup, steps, settle

    def setup(self):
        sid = self.scenario["id"]
        askers = {s["actor"] for s in self.scenario["steps"]
                  if s["do"] == "permission" and s["actor"] != "you"}
        for name, member in self.scenario["cast"].items():
            if name in launched_members(self.scenario):
                continue  # `launch` creates this one
            fleet = fleet_metadata(name, member)
            ses = self.v2.create_session(
                "%s %s %s %s" % (sid, self.label, name, self.tag),
                agent=ROLE_AGENTS.get(member["role"], "coder"), fleet=fleet,
                permissions=ASK_SHELL if name in askers else None)["id"]
            marker = "lab-cast-%s-%s" % (self.tag, name)
            self.cast[name] = {"session": ses, "fleet": fleet, "marker": marker}
            # One finished turn first, so the agent is a normal idle one. Every
            # later model request repeats this marker, which ties it to the agent.
            # It is the fleet's brief, not your prompt.
            self.v2.prompt(ses, "%s: you are %s in scenario %s\n@script reply=READY"
                           % (marker, name, sid), metadata={"fleet": dict(RUNNER_FLEET, brief=True),
                                                             "lab": {"scenario": sid, "setup": name}})
            self.note("setup", agent=name, session=ses, fleet=fleet, shell_asks=name in askers)
        for name, member in self.cast.items():
            ses = member["session"]
            done, _ = self.v2.wait(lambda: (self.v2.get(ses).get("time") or {}).get("idle")
                                   and not self.v2.running(ses), 60)
            if not done:
                raise RunError("%s: the warm-up turn did not finish" % name)
        if uses_engine(self.scenario):
            if runs_daemon(self.scenario):
                self.attach_cast()
            name = "%s-%s-%s-%s" % (time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()), sid, self.label, self.tag)
            self.engine = LabEngine(self.lab, name, self.faults, self.note)
            # The heartbeat baseline is today's system: no switchboard daemon runs in it.
            self.engine.on = runs_daemon(self.scenario) and not self.baseline
            self.note("engine", dir=self.engine.root, config=self.engine.config, faults=self.faults,
                      baseline=self.baseline)
        elif self.tui:
            if not self.pane:
                raise RunError("no %r workspace pane for the TUI" % LAB_WORKSPACE_LABEL)
            lab_tui_attach(self.lab, self.pane, LAB_TUI_AGENT, self.session(self.tui))
            self.screens[self.tui] = (self.pane, LAB_TUI_AGENT)
            self.tui_ready = True
            time.sleep(1.5)
            self.note("tui", agent=self.tui, pane=self.pane, herdr_agent=LAB_TUI_AGENT,
                      session=self.session(self.tui),
                      status=agent_status(LAB_TUI_AGENT).get("agent_status"))

    def attach_cast(self):
        """Every cast member in the Lab TUI, each in its own Lab pane, so the
        engine discovers it as in the fleet: herdr agent -> agent_session ->
        metadata.fleet.name. The member on screen gets the runner's pane; more
        panes are split inside the Lab workspace without focus. Every Lab pane
        is brought back to its shell first, so no earlier play's session
        stays discoverable under the same name."""
        if not self.pane:
            raise RunError("no %r workspace pane for the cast" % LAB_WORKSPACE_LABEL)
        panes = [self.pane] + [p for p in lab_panes() if p != self.pane]
        for pane in panes:
            lab_shell_ready(self.lab, pane)
        names = ([self.tui] if self.tui else []) + sorted(n for n in self.cast if n != self.tui)
        for index, name in enumerate(names):
            if index >= len(panes):
                panes.append(new_lab_pane(self.lab, panes[-1]))
                self.note("pane", created=panes[-1])
            pane = panes[index]
            agent = LAB_TUI_AGENT if index == 0 else "%s-%d" % (LAB_TUI_AGENT, index + 1)
            lab_tui_attach(self.lab, pane, agent, self.session(name))  # checks the Lab v2 by path
            self.screens[name] = (pane, agent)
        self.tui_ready = bool(self.tui)
        deadline = time.time() + 20
        while True:  # herdr must name each session before the engine looks
            found = {n: agent_status(a) for n, (_, a) in self.screens.items()}
            named = all(fleet_session(found[n]) == self.session(n) for n in found)
            if named or time.time() > deadline:
                break
            time.sleep(0.5)
        for name, (pane, agent) in self.screens.items():
            self.note("tui", agent=name, pane=pane, herdr_agent=agent, session=self.session(name),
                      herdr_session=fleet_session(found[name]), status=found[name].get("agent_status"))
        if not named:
            raise RunError("herdr does not name every cast session: %s" % {
                n: fleet_session(found[n]) for n in found})

    def tui_guard(self):
        lab_tui_guard(self.lab, lab_pane_guard(self.pane))
        info = agent_status(LAB_TUI_AGENT)
        if info.get("pane_id") != self.pane:
            raise SystemExit("refused: herdr agent %s is not in pane %s" % (LAB_TUI_AGENT, self.pane))

    def play(self):
        steps, expect = self.scenario["steps"], self.scenario["expect"]
        self.t0 = time.time()
        if self.tui:
            self.watch = StatusWatch(LAB_TUI_AGENT)
            self.watch.start_time = self.t0
            self.watch.start()
        for index, step in enumerate(steps):
            due = self.t0 + self.seconds(step["at"])
            if due > time.time():
                self.idle_until(due)
            when = time.time()
            self.step_times[index] = when
            try:
                result = self.do(index, step)
            except (V2Error, RunError, subprocess.SubprocessError, KeyError) as err:
                result = {"error": str(err)[:400]}
                self.step_errors.append("step %d %s: %s" % (index, step["do"], result["error"]))
            self.note("step", when, index=index, step=step, result=result)
        end = max([self.seconds(s["at"]) for s in steps]
                  + [self.seconds(e["at"]) for e in expect if e.get("at")] + [0])
        due = self.t0 + end + 1
        if due > time.time():
            self.idle_until(due)
        if self.engine:
            self.engine.on = False
            self.engine.stop("the last step's time has passed")
        self.settle()

    def idle_until(self, due):
        """Sleep until `due`; meanwhile the engine's daemon runs, if it is on
        (the offline runner's pass every POLL seconds, in real time)."""
        while time.time() < due:
            if self.engine:
                self.engine.ensure()
            time.sleep(min(1.0, max(0.0, due - time.time())))

    def do(self, index, step):
        do, sid = step["do"], self.scenario["id"]
        if do in ("turn", "permission") and step["actor"] != "you":
            if do == "turn":
                steps = int(step.get("steps", 1))
                each = self.seconds(step.get("lasts", "0s")) / float(steps)
                script = " ".join(["sleep=%g tool=bash cmd=%s" % (
                    each, shlex.quote("echo %s turn %d step %d" % (sid, index, k)))
                    for k in range(1, steps)] + ["sleep=%g reply=DONE" % each])
            else:
                script = "tool=bash cmd=%s reply=DONE" % shlex.quote("echo %s ask %d" % (sid, index))
            text = "%s by %s, step %d" % (do, step["actor"], index)
            # Work the fleet gave the agent: not your prompt, and no switchboard key.
            rec = self.v2.prompt(self.session(step["actor"]), "%s\n@script %s" % (text, script),
                                 metadata={"fleet": dict(RUNNER_FLEET), "lab": {"scenario": sid, "step": index}})
            return {"via": "session.prompt", "script": script, "id": rec.get("id")}
        if do == "permission":
            ses = self.session(step["to"])
            asks, took = self.v2.wait(lambda: self.v2.permissions(ses), 10)
            if not asks:
                raise RunError("no permission ask pending for %s" % step["to"])
            decision = step.get("decision", "once")
            self.v2.permission_reply(ses, asks[0]["id"], decision)
            return {"answered": asks[0]["id"], "action": asks[0].get("action"),
                    "resources": asks[0].get("resources"), "decision": decision}
        if do == "message":
            script = ("sleep=%d reply=OK" % self.seconds(step["lasts"])) if step.get("lasts") else None
            if step["to"] == self.tui:
                self.tui_guard()
                line = step["text"] + (" @script " + script if script else "")
                p = herdr_run("agent", "prompt", LAB_TUI_AGENT, line)
                if p.returncode:
                    raise RunError("herdr agent prompt: %s" % (p.stdout + p.stderr).strip()[:300])
                return {"via": "herdr agent prompt", "agent": LAB_TUI_AGENT}
            text = step["text"] + ("\n@script " + script if script else "")
            rec = self.v2.prompt(self.session(step["to"]), text)  # yours: no metadata
            return {"via": "session.prompt", "id": rec.get("id")}
        if do == "draft":
            if step["to"] != self.tui:
                raise RunError("draft to %s, whose TUI is not open" % step["to"])
            if "\n" in step["text"]:
                raise RunError("a draft is one line; a newline would send it")
            self.tui_guard()
            herdr_run("pane", "send-text", self.pane, step["text"]).check_returncode()
            time.sleep(0.5)
            self.note("pane", input_box=input_box(pane_text(self.pane)))
            return {"via": "herdr pane send-text", "pane": self.pane}
        if do in SYNTHETIC_DEFAULTS:
            ses = self.session(step["to"])
            resume, delivery = SYNTHETIC_DEFAULTS[do]
            resume, delivery = step.get("resume", resume), step.get("delivery", delivery)
            keys = [step["key"]]
            msg_id = message_id(ses, ["lab-id:%s" % step["id"]] if step.get("id") else keys)
            rec = self.v2.synthetic(ses, step["text"], resume, delivery, keys, msg_id=msg_id)
            return {"via": "session.synthetic", "id": msg_id, "resume": resume,
                    "delivery": delivery, "keys": keys, "returned": rec.get("id")}
        if do == "launch":
            return self.launch(step)
        if do == "fact" and self.baseline:
            return self.type_wake(step)
        if do == "fact":
            # Created at the step's scheduled time, as the offline runner's clock does.
            return {"via": "lab-facts.jsonl", "fact": self.engine.fact(step, self.t0 + self.seconds(step["at"]))}
        if do == "pass":
            result = self.engine.run_pass(step.get("faults", ()))
            report = result.get("report") or {}
            result["sent"] = [{"recipient": s.get("recipient"), "action": s.get("action"),
                               "message_id": s.get("message_id"), "keys": s.get("keys")}
                              for s in report.get("sent") or []]
            result.pop("report", None)
            return dict(result, via="fleet-switchboard run --once")
        if do == "kill-daemon":
            self.engine.on = False
            self.engine.stop("kill-daemon")
            return {"daemon": "off"}
        if do == "restart-daemon":
            self.engine.on = True
            self.engine.ensure()
            return {"daemon": "on", "pid": self.engine.proc.pid if self.engine.proc else None}
        if do in ("wait", "away"):
            return {do: True}
        raise RunError("cannot play %r" % do)

    def type_wake(self, step):
        """The `fleet-heartbeat` baseline: deliver the wake as the old heartbeat
        did, typed with `herdr agent prompt` into the agent's pane. The runner is
        the only code allowed to type, and only into a pane of the Lab workspace."""
        pane, agent = self.screens[step["to"]]
        lab_tui_guard(self.lab, lab_pane_guard(pane))
        line = "[heartbeat] %s @script reply=ACK" % step["summary"]
        p = herdr_run("agent", "prompt", agent, line)
        if p.returncode:
            raise RunError("herdr agent prompt: %s" % (p.stdout + p.stderr).strip()[:300])
        return {"via": "herdr agent prompt", "agent": agent, "pane": pane, "text": line}

    def launch(self, step):
        """`fleet-switchboard launch` for a cast member, into the Lab workspace."""
        name = step["agent"]
        member = self.scenario["cast"][name]
        ws = lab_workspace()
        if not ws:
            raise RunError("no %r workspace to launch into" % LAB_WORKSPACE_LABEL)
        marker = "lab-cast-%s-%s" % (self.tag, name)
        brief = os.path.join(self.engine.root, "brief-%s.md" % name)
        with open(brief, "w") as f:  # the runner writes the scripted model's @script line, never the scenario
            f.write("%s: %s\n@script reply=BRIEFED\n" % (marker, step.get("brief", "begin")))
        args = [name, "--agent", ROLE_AGENTS.get(member["role"], "coder"), "--dir", self.lab.repo,
                "--workspace", ws["workspace_id"], "--role", member["role"], "--brief-file", brief]
        for flag, key in (("--reports-to", "reports_to"), ("--issue", "issue")):
            if key in member:
                args += [flag, str(member[key])]
        p = self.engine.launch(args)
        try:
            done = json.loads(p.stdout)
        except ValueError:
            raise RunError("launch: rc %s: %s" % (p.returncode, short(p.stderr or p.stdout, 300)))
        if p.returncode:
            raise RunError("launch: rc %s: %s" % (p.returncode, short(p.stderr, 300)))
        self.launched_panes.append(done["pane"])
        lab_pane_guard(done["pane"])  # whatever was opened must be inside the Lab workspace
        self.cast[name] = {"session": done["session"], "fleet": fleet_metadata(name, member), "marker": marker}
        self.screens[name] = (done["pane"], None)
        self.note("launch", agent=name, **done)
        return dict(done, via="fleet-switchboard launch")

    def settle(self, timeout=120):
        """Until no cast session runs, three reads in a row."""
        sessions = [m["session"] for m in self.cast.values()]
        start, calm = time.time(), 0
        while time.time() - start < timeout and calm < 3:
            active = self.v2.api("session.active") or {}
            calm = 0 if any(s in active for s in sessions) else calm + 1
            time.sleep(0.5)
        self.note("settled", seconds=round(time.time() - start, 1), quiet=calm >= 3)

    # ---- facts and checks

    def gather(self):
        log = model_requests(self.lab, self.t_setup)
        for name, member in self.cast.items():
            ses = member["session"]
            transcript = list(reversed(self.v2.messages(ses, limit=200)))
            requests = [e for e in log if e["time"] >= self.t0
                        and e.get("plan", {}).get("kind") not in UPKEEP_PLANS
                        and member["marker"] in json.dumps(e["request"].get("messages"))]
            self.facts[name] = {"session": ses, "record": self.v2.get(ses),
                                "transcript": transcript, "inbox": self.v2.inbox(ses),
                                "requests": requests}
            for m in transcript:
                created = (m.get("time") or {}).get("created")
                if created and created / 1000.0 >= self.t0 - 0.5:
                    self.note("transcript", created / 1000.0, agent=name,
                              message=message_outline(m, 120))
            for e in requests:
                self.note("model", e["time"], agent=name, plan=e.get("plan", {}).get("kind"),
                          messages=request_outline(e, 90)[-6:])
        if self.watch:
            self.status_changes = self.watch.stop()
            for t, status in self.status_changes:
                self.note("status", self.t0 + t, agent=self.tui, herdr_agent=LAB_TUI_AGENT,
                          agent_status=status)
        if self.tui_ready:
            self.screen = pane_text(self.pane)
            self.note("pane", input_box=input_box(self.screen),
                      screen_tail=[l.rstrip() for l in self.screen.splitlines() if l.strip()][-12:])
        if self.engine:
            # Evidence only: what the engine says it did. No oracle reads it.
            for entry in self.engine.audit():
                if entry.get("event") in ("v2.synthetic", "v2.inbox.update", "recheck", "hold", "error"):
                    self.note("audit", iso_epoch(entry.get("ts")), event=entry.get("event"), phase=entry.get("phase"),
                              subject=entry.get("subject"), detail=entry.get("detail"), error=entry.get("error"))

    def evaluate(self):
        results = []
        for index, item in enumerate(self.scenario["expect"]):
            label = item.get("name") or "%s#%d" % (item["that"], index)
            try:
                ok, detail = getattr(self, "check_" + item["that"])(item)
            except (KeyError, IndexError, TypeError, ValueError, V2Error, RunError) as err:
                ok, detail = False, "could not check: %r" % err
            results.append({"label": label, "that": item["that"], "name": item.get("name"),
                            "passed": bool(ok), "detail": detail})
            self.note("expect", label=label, passed=bool(ok), detail=detail)
        return results

    def agent_facts(self, item):
        name = item["agent"]
        if name not in self.facts:
            raise RunError("no cast member %r" % name)
        return self.facts[name]

    def at(self, entry_time):
        return round(entry_time - self.t0, 2)

    def check_no_machine_turn(self, item):
        """The scripted model's log: no model request whose triggering input
        (its last user message) is a fleet message from the transcript."""
        facts = self.agent_facts(item)
        fleet_texts = [squash(transcript_text(m)) for m in facts["transcript"]
                       if m.get("type") == "synthetic" or (m.get("type") == "user" and fleet_of(m))]
        fleet_texts = [t for t in fleet_texts if t]
        machine = []
        for e in facts["requests"]:
            trigger = squash(last_user(e))
            if any(t == trigger or t in trigger for t in fleet_texts):
                machine.append("t=%.2f answered %r" % (self.at(e["time"]), short(trigger, 60)))
        if machine:
            return False, "%d model request(s) triggered by a fleet message: %s" % (
                len(machine), "; ".join(machine[:3]))
        return True, "%d model request(s) since t0, none triggered by any of %d fleet message(s)" % (
            len(facts["requests"]), len(fleet_texts))

    def keyed(self, facts, key):
        """Transcript messages (delivered) with a metadata.fleet key matching
        the glob `key`."""
        return [m for m in facts["transcript"]
                if any(fnmatch.fnmatchcase(k, key) for k in (fleet_of(m) or {}).get("keys") or [])]

    def preceding(self, facts, message):
        """The transcript message before `message`, skipping other inputs
        delivered with it: what the agent was doing when it arrived."""
        before = None
        for m in facts["transcript"]:
            if m is message:
                return before
            if m.get("type") not in ("user", "synthetic"):
                before = m
        return before

    def model_calls(self, facts):
        """Each logged model request as a call: its new inputs (the user
        messages after the last reply or tool result, matched to transcript
        messages) and its phase. between_steps: right after a tool result;
        after_reply: right after a final reply, in the same busy span (no idle
        between them in the transcript); turn_start: the agent was idle."""
        by_text = {}
        for m in facts["transcript"]:
            if m.get("type") in ("user", "synthetic"):
                by_text.setdefault(squash(transcript_text(m)), m)
        calls = []
        for e in facts["requests"]:
            msgs = request_messages(e)
            i = len(msgs)
            while i and msgs[i - 1][0] == "user":
                i -= 1
            inputs = [by_text.get(squash(t)) for _, t in msgs[i:]]
            inputs = [m for m in inputs if m is not None]
            prev = msgs[i - 1][0] if i else None
            if prev == "tool":
                phase = "between_steps"
            elif inputs and (self.preceding(facts, inputs[0]) or {}).get("type") == "assistant":
                phase = "after_reply"
            else:
                phase = "turn_start"
            calls.append({"time": e["time"], "phase": phase, "inputs": inputs})
        return calls

    def check_model_saw(self, item):
        """The scripted model's log, keyed through the transcript: the model
        calls (of phase `when`, default any) whose new inputs include a
        message with a key matching `key`; `count` of them, or at least one."""
        facts, key, when = self.agent_facts(item), item["key"], item.get("when", "any")
        calls = [c for c in self.model_calls(facts) if when in ("any", c["phase"])
                 and any(any(fnmatch.fnmatchcase(k, key) for k in (fleet_of(m) or {}).get("keys") or [])
                         for m in c["inputs"])]
        ok = len(calls) == item["count"] if "count" in item else bool(calls)
        every = ["t=%.2f %s" % (self.at(c["time"]), c["phase"]) for c in self.model_calls(facts)
                 if any(m in self.keyed(facts, key) for m in c["inputs"])]
        return ok, "%d model call(s) (%s) carried %r; every call that did: %s" % (
            len(calls), when, key, ", ".join(every) or "none")

    def check_within(self, item):
        """Transcript and model log against step `step`'s time. With `key`:
        the message carrying it was delivered, and a model call answered it,
        within `seconds`. Without: the agent's first final reply after the
        step was complete within `seconds`."""
        facts = self.agent_facts(item)
        t_step = self.step_times.get(int(item["step"]))
        limit = float(item["seconds"])
        if t_step is None:
            return False, "step %s did not run" % item["step"]
        if item.get("key"):
            delivered = self.keyed(facts, item["key"])
            if not delivered:
                return False, "no message with key %r in the transcript" % item["key"]
            text = squash(transcript_text(delivered[0]))
            answered = [e for e in facts["requests"] if squash(last_user(e)) == text]
            if not answered:
                return False, "no model call answered the message with key %r" % item["key"]
            d = delivered[0]["time"]["created"] / 1000.0 - t_step
            a = answered[0]["time"] - t_step
            return a <= limit and d <= limit, "delivered %.2f s and answered %.2f s after step %s (limit %g s)" % (
                d, a, item["step"], limit)
        replies = [m for m in facts["transcript"] if m.get("type") == "assistant"
                   and m.get("finish") == "stop"
                   and (m.get("time") or {}).get("created", 0) / 1000.0 >= t_step - 0.05]
        if not replies:
            return False, "no final reply after step %s" % item["step"]
        done = (replies[0].get("time") or {}).get("completed") or replies[0]["time"]["created"]
        took = done / 1000.0 - t_step
        return took <= limit, "reply %r complete %.2f s after step %s (limit %g s)" % (
            short(transcript_text(replies[0]), 30), took, item["step"], limit)

    def mode_of(self, facts, message):
        """How a delivered message reached the model, read from the model log
        through the transcript: `wake` when it was the input that called the
        model (the last new input of a call that started a turn from idle, or
        ran after the turn's final reply); `note` when it rode along with
        another input (your next message), or was injected between steps.
        None when no model call carried it."""
        for call in self.model_calls(facts):
            if any(m is message for m in call["inputs"]):
                woke = call["inputs"][-1] is message and call["phase"] in ("turn_start", "after_reply")
                return ("wake" if woke else "note"), call
        return None, None

    def check_delivered(self, item):
        """The recipient's transcript: synthetic messages whose metadata.fleet.keys
        match the glob `key`. `count` is how many distinct messages, `keys` how
        many distinct matching keys, `mode` how each reached the model. Items
        still waiting in v2's inbox are not delivered; they are listed."""
        facts, key = self.agent_facts({"agent": item["to"]}), item["key"]
        found, seen = [], []
        for m in self.keyed(facts, key):
            if m.get("type") != "synthetic":
                continue
            mode, call = self.mode_of(facts, m)
            seen.append("%s %s%s" % (m.get("id"), mode or "unread",
                                     " (%s t=%.2f)" % (call["phase"], self.at(call["time"])) if call else ""))
            if item.get("mode") in (None, mode):
                found.append(m)
        keys = {k for m in found for k in (fleet_of(m) or {}).get("keys") or [] if fnmatch.fnmatchcase(k, key)}
        waiting = [i.get("id") for i in facts["inbox"]
                   if any(fnmatch.fnmatchcase(k, key) for k in (fleet_of(i) or {}).get("keys") or [])]
        ok = len(found) == item["count"] if "count" in item else bool(found)
        if "keys" in item:
            ok = ok and len(keys) == item["keys"]
        return ok, "%d message(s)%s carry %d matching key(s); every one: %s; waiting in the inbox: %s" % (
            len(found), " as %s" % item["mode"] if "mode" in item else "", len(keys),
            ", ".join(seen) or "none", ", ".join(waiting) or "none")

    def check_message_count(self, item):
        """The recipient's transcript and inbox: distinct messages the switchboard
        wrote (metadata.fleet.from == "switchboard")."""
        facts = self.agent_facts({"agent": item["to"]})
        ids = []
        for m in [m for m in facts["transcript"] if m.get("type") == "synthetic"] + list(facts["inbox"]):
            if (fleet_of(m) or {}).get("from") == "switchboard" and m.get("id") not in ids:
                ids.append(m.get("id"))
        return len(ids) == item["count"], "%d switchboard message(s) (want %d): %s" % (
            len(ids), item["count"], ", ".join(ids) or "none")

    def check_metadata_roundtrip(self, item):
        """session.get (of=session) or message.list (of=message, by key or text)
        returns metadata.fleet exactly; expected from the cast unless given."""
        facts = self.agent_facts(item)
        if item.get("of", "session") == "session":
            want = item["fleet"] if "fleet" in item else fleet_metadata(
                item["agent"], self.scenario["cast"][item["agent"]])
            got = (facts["record"].get("metadata") or {}).get("fleet")
            return got == want, "session.get metadata.fleet = %s; expected %s" % (
                json.dumps(got, sort_keys=True), json.dumps(want, sort_keys=True))
        if item.get("key"):
            found = self.keyed(facts, item["key"])
        else:
            found = [m for m in facts["transcript"] if m.get("type") in ("user", "synthetic")
                     and item["text"] in transcript_text(m)]
        if not found:
            return False, "no message with %r in the transcript" % (item.get("key") or item.get("text"))
        # A message found by key carries at least that key; by text, nothing
        # unless the scenario says so (your prompts carry no metadata.fleet).
        default = {"keys": [item["key"]]} if item.get("key") else None
        want, got = item.get("fleet", default), fleet_of(found[0])
        return got == want, "%s %s metadata.fleet = %s; expected %s" % (
            found[0].get("type"), found[0].get("id"), json.dumps(got, sort_keys=True),
            json.dumps(want, sort_keys=True))

    def check_status_is(self, item):
        """herdr `agent get` samples: the agent's status at time `at`."""
        if item["agent"] != self.tui:
            return False, "%s is not on screen, so herdr has no status for it" % item["agent"]
        t = self.seconds(item["at"])
        want = item["status"] if isinstance(item["status"], list) else [item["status"]]
        seen = [s for when, s in self.status_changes if when <= t]
        got = seen[-1] if seen else None
        changes = ", ".join("%.1fs %s" % c for c in self.status_changes)
        return got in want, "at %s herdr said %r (want %s); changes: %s" % (
            item["at"], got, "/".join(want), changes)

    def check_draft_intact(self, item):
        """herdr pane read of the input box holds the draft, and no user
        message in the transcript contains it."""
        if item["agent"] != self.tui or self.screen is None:
            return False, "%s is not on screen" % item["agent"]
        draft = squash(item["text"])
        box = input_box(self.screen) or {}
        in_box = draft in squash(box.get("text"))
        sent = [m.get("id") for m in self.agent_facts(item)["transcript"]
                if m.get("type") == "user" and draft in squash(transcript_text(m))]
        return in_box and not sent, "input box %r; sent in: %s" % (
            short(box.get("text") or "", 80), ", ".join(sent) or "no message")

    def pane_of_session(self, session):
        """The pane herdr says shows `session`, and its agent entry; found through `agent list`."""
        for entry in herdr("agent", "list").get("agents") or []:
            if fleet_session(entry) == session:
                return entry.get("pane_id"), entry
        return None, None

    def pane_programs(self, pane):
        info = herdr("pane", "process-info", "--pane", pane).get("process_info") or {}
        return info, [p for p in info.get("foreground_processes") or [] if isinstance(p, dict)]

    def check_pane_runs_v2(self, item):
        """herdr: the agent in the pane that shows the session is opencode, and
        the pane's process is the Lab's v2 binary on that session."""
        session = self.agent_facts(item)["session"]
        pane, entry = self.pane_of_session(session)
        if not pane:
            return False, "no herdr agent shows session %s" % session
        _, programs = self.pane_programs(pane)
        cmdlines = [p.get("cmdline", "") for p in programs]
        ok = entry.get("agent") == "opencode" and any(
            c.startswith(self.lab.v2_bin + " ") and ("-s %s" % session) in c for c in cmdlines)
        return ok, "pane %s: herdr agent %r on %s; processes %s" % (pane, entry.get("agent"), session, cmdlines)

    def check_no_typing(self, item):
        """herdr process-info: the pane's first process is the v2 itself. A pane
        that was typed into has a shell under it, and the shell's pid is not the v2's."""
        session = self.agent_facts(item)["session"]
        pane, _ = self.pane_of_session(session)
        if not pane:
            return False, "no herdr agent shows session %s" % session
        info, programs = self.pane_programs(pane)
        v2 = [p for p in programs if str(p.get("cmdline", "")).startswith(self.lab.v2_bin)]
        shells = [p.get("name") for p in programs if p.get("name") in ("zsh", "bash", "sh", "fish")]
        ok = bool(v2) and not shells and all(p.get("pid") == info.get("shell_pid") for p in v2)
        return ok, "pane %s: v2 pid %s, pane's first process pid %s, shells %s" % (
            pane, [p.get("pid") for p in v2], info.get("shell_pid"), shells or "none")

    def check_tool_outcome(self, item):
        """The transcript's record of the agent's last `tool` call (default
        shell): its final state must be `outcome` (completed, error), and a
        completed call's result must have gone back to the model (its log)."""
        facts, tool = self.agent_facts(item), item.get("tool", "shell")
        calls = [part for m in facts["transcript"] if m.get("type") == "assistant"
                 for part in m.get("content") or []
                 if isinstance(part, dict) and part.get("type") == "tool" and part.get("name") == tool]
        if not calls:
            return False, "no %s call in the transcript" % tool
        state = calls[-1].get("state") or {}
        output = " ".join(c.get("text", "") for c in state.get("content") or [] if isinstance(c, dict))
        returned = any(r == "tool" and squash(t) == squash(output) and squash(output)
                       for e in facts["requests"] for r, t in request_messages(e))
        want = item.get("outcome", "completed")
        ok = state.get("status") == want and (want != "completed" or returned)
        return ok, "%s %s: %s, output %r, %s the model" % (
            tool, json.dumps(state.get("input")), state.get("status"), short(output, 40),
            "returned to" if returned else "never returned to")

    def teardown(self):
        """Stop the engine; leave the Lab pane's input box empty for the next
        play. After an engine play every cast TUI is quit, so none of its
        sessions stays discoverable under a cast name."""
        if self.engine:
            self.engine.on = False
            self.engine.stop("teardown")
        if self.watch and self.watch.is_alive():
            self.watch.stop()
        for pane in self.launched_panes:  # the pane has no shell: closing it ends the TUI
            lab_pane_guard(pane)
            herdr_run("pane", "close", pane)
        if uses_engine(self.scenario):
            for name, (pane, _) in self.screens.items():
                if pane not in self.launched_panes:
                    lab_shell_ready(self.lab, pane)
            return
        if not self.tui_ready:
            return
        box = input_box(pane_text(self.pane)) or {}
        if box.get("text"):
            self.tui_guard()
            herdr_run("pane", "send-keys", self.pane, "ctrl+c")
            time.sleep(0.5)


def play_scenario(lab, scenario, label, pane, seconds, faults=(), baseline=None):
    run = ScenarioRun(lab, scenario, label, pane, seconds, faults, baseline)
    results = []
    try:
        run.setup()
        run.play()
        run.gather()
        results = run.evaluate()
    except (RunError, V2Error, subprocess.SubprocessError) as err:
        run.error = str(err)[:400]
        run.note("error", error=run.error)
    finally:
        run.teardown()
    return run, results


def control_verdict(control, results):
    """{entry: broke?} for each expectation the control names."""
    broke = {}
    for entry in control["fails"]:
        hits = [r for r in results if r["name"] == entry or r["that"] == entry]
        broke[entry] = bool(hits) and all(not r["passed"] for r in hits)
    return broke


def md_cell(text):
    return str(text).replace("|", "\\|").replace("\n", " ")


def write_scenario_evidence(out_dir, scenario, plays, verdict, stamp):
    os.makedirs(out_dir, exist_ok=True)
    lines = ["# %s: %s" % (scenario["id"], scenario["title"]), "",
             "- Verdict: **%s**" % verdict,
             "- Problem: %s; since PR %d; tiers %s; tags %s" % (
                 scenario["problem"] if scenario["problem"] is not None else "none",
                 scenario["since_pr"], ", ".join(scenario["tiers"]),
                 ", ".join(scenario.get("tags") or []) or "none"),
             "- Played %s (UTC) in the Lab, tier lab-scripted" % stamp, ""]
    control = scenario["control"]
    for label in ("run", "control"):
        if label not in plays:
            continue
        run, results = plays[label]
        lines.append("## %s" % ("Run" if label == "run" else "Control"))
        lines.append("")
        if label == "control":
            if "fault" in control:
                how = "Fault: `%s` on every engine process" % control["fault"]
            elif "baseline" in control:
                how = "Baseline: `%s`, the wake typed into the pane" % control["baseline"]
            else:
                how = "Variant: `%s`" % json.dumps(control["variant"], sort_keys=True)
            lines.append("%s. It must fail: %s." % (how, ", ".join(control["fails"])))
            lines.append("")
        lines.append("Sessions: %s" % ", ".join("%s `%s`" % (n, m["session"]) for n, m in run.cast.items()))
        if run.screens:
            lines.append("Lab TUI: %s" % ", ".join(
                "%s in pane `%s`%s" % (n, p, " (herdr agent `%s`)" % a if a else " (opened by launch)")
                for n, (p, a) in sorted(run.screens.items())))
        if run.engine:
            lines.append("Engine: `bin/fleet-switchboard`, config and state in `%s`; daemon started %d time(s)%s"
                         % (run.engine.root, run.engine.starts,
                            "; faults %s" % ", ".join(run.engine.faults) if run.engine.faults else ""))
        lines.append("")
        if run.error:
            lines += ["**Did not finish:** %s" % md_cell(run.error), ""]
        for err in run.step_errors:
            lines.append("- Step error: %s" % md_cell(err))
        must_fail = set(control["fails"]) if label == "control" else set()
        lines += ["| Expectation | Oracle | Result | Detail |", "|---|---|---|---|"]
        for r in results:
            flag = " (must fail)" if (r["name"] in must_fail or r["that"] in must_fail) else ""
            lines.append("| %s%s | %s | %s | %s |" % (md_cell(r["label"]), flag, r["that"],
                                                     "pass" if r["passed"] else "FAIL",
                                                     md_cell(r["detail"])))
        if label == "control":
            broke = control_verdict(control, results)
            lines += ["", "Control %s: %s" % (
                "failed as it must" if broke and all(broke.values()) and not run.error else "DID NOT FAIL",
                ", ".join("%s %s" % (k, "broke" if v else "still passed") for k, v in broke.items()))]
        lines.append("")
    with open(os.path.join(out_dir, "report.md"), "w") as f:
        f.write("\n".join(lines))
    entries = []
    for label, (run, _) in plays.items():
        for entry in run.timeline:
            entry = dict(entry)
            entry["t"] = round(entry["wall"] - run.t0, 2) if run.t0 else None
            entries.append(entry)
    entries.sort(key=lambda e: (e["run"] != "run", e["wall"]))
    with open(os.path.join(out_dir, "timeline.jsonl"), "w") as f:
        for entry in entries:
            f.write(json.dumps(entry, default=str, sort_keys=True) + "\n")


def scripted_model_up(lab):
    try:
        with urllib.request.urlopen("http://127.0.0.1:%d/health" % lab.port(), timeout=3) as r:
            return r.status == 200
    except OSError:
        return False


def cmd_run(lab, args):
    if args.tier not in RUN_TIERS:
        sys.stderr.write("proof-switchboard run: tier %s is not built yet (built: %s)\n"
                         % (args.tier, ", ".join(RUN_TIERS)))
        return 2
    if args.control_only and args.no_control:
        sys.stderr.write("proof-switchboard run: --control-only and --no-control exclude each other\n")
        return 2
    if not scripted_model_up(lab):
        sys.stderr.write("proof-switchboard run: the scripted model is not answering on port %d; "
                         "start it with `proof-switchboard scripted-model --log %s`\n"
                         % (lab.port(), model_log_path(lab)))
        return 2
    fs = fleet_scenario()
    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    root = os.path.join(RUNS_DIR, stamp)
    pane = args.pane or default_lab_pane()
    rows, failed = [], False
    for path in scenario_paths(args.paths or [SCENARIO_DIR]):
        name = os.path.basename(path)
        try:
            scenario = fs.load(path)
        except fs.ScenarioError as err:
            rows.append((name, "INVALID", "-", "-", str(err)))
            failed = True
            continue
        sid = scenario["id"]
        if args.tier not in scenario["tiers"]:
            rows.append((sid, "SKIP", "-", "-", "not in tier %s" % args.tier))
            continue
        reasons = unsupported(scenario, fs)
        if reasons:
            rows.append((sid, "SKIP", "-", "-", "; ".join(reasons)))
            print("%s SKIP: %s" % (sid, "; ".join(reasons)), flush=True)
            continue
        plays = {}
        if not args.control_only:
            print("%s run ..." % sid, flush=True)
            plays["run"] = play_scenario(lab, scenario, "run", pane, fs.duration_seconds)
        if not args.no_control:
            print("%s control ..." % sid, flush=True)
            control = scenario["control"]
            if "fault" in control:
                plays["control"] = play_scenario(lab, scenario, "control", pane, fs.duration_seconds,
                                                 [control["fault"]])
            elif "baseline" in control:
                plays["control"] = play_scenario(lab, scenario, "control", pane, fs.duration_seconds,
                                                 baseline=control["baseline"])
            else:
                variant = fs.apply_variant(scenario, control["variant"])
                plays["control"] = play_scenario(lab, variant, "control", pane, fs.duration_seconds)
        run_cell = control_cell = "-"
        ok = True
        if "run" in plays:
            run, results = plays["run"]
            passed = not run.error and not run.step_errors and results and all(r["passed"] for r in results)
            run_cell = "pass" if passed else "FAIL"
            ok &= bool(passed)
        if "control" in plays:
            run, results = plays["control"]
            broke = control_verdict(scenario["control"], results)
            control_failed = not run.error and bool(broke) and all(broke.values())
            control_cell = "fails" if control_failed else "PASSES"
            ok &= control_failed
        verdict = "PASS" if ok else "FAIL"
        failed |= not ok
        out_dir = os.path.join(root, sid)
        write_scenario_evidence(out_dir, scenario, plays, verdict, stamp)
        rows.append((sid, verdict, run_cell, control_cell, os.path.relpath(out_dir, REPO_ROOT)))
        print("%s %s (run %s, control %s) -> %s" % (sid, verdict, run_cell, control_cell,
                                                    os.path.relpath(out_dir, REPO_ROOT)), flush=True)
    table = ["| Scenario | Verdict | Run | Control | Evidence or reason |", "|---|---|---|---|---|"]
    table += ["| %s |" % " | ".join(md_cell(c) for c in row) for row in rows]
    if any(r[1] not in ("SKIP",) for r in rows):
        os.makedirs(root, exist_ok=True)
        with open(os.path.join(root, "summary.md"), "w") as f:
            f.write("# Scenario run %s (UTC), tier %s\n\n%s\n" % (stamp, args.tier, "\n".join(table)))
    print("\n".join(table))
    return 1 if failed else 0


def cmd_session(lab, args):
    v2 = V2(lab)
    if args.session_command == "create":
        ses = v2.create_session(args.title, agent=args.agent,
                                fleet=json.loads(args.fleet) if args.fleet else None,
                                permissions=json.loads(args.permissions) if args.permissions else None)
        print(ses["id"])
    elif args.session_command == "synthetic":
        keys = args.keys.split(",") if args.keys else ["manual:%s" % tag()]
        print(json.dumps(v2.synthetic(args.session, args.text, args.resume, args.delivery, keys,
                                      msg_id=args.id)))
    elif args.session_command == "wait-idle":
        value, took = v2.wait_idle(args.session, args.timeout)
        print(json.dumps({"idle": bool(value), "seconds": took}))
        return 0 if value else 1
    elif args.session_command == "transcript":
        for m in reversed(v2.messages(args.session, limit=args.limit)):
            print(json.dumps(message_outline(m)))
    return 0


def cmd_model_requests(lab, args):
    for entry in model_requests(lab, args.since, args.marker):
        print(json.dumps({"t": entry["time"], "plan": entry["plan"].get("kind"),
                          "messages": request_outline(entry)}))
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(prog="proof-switchboard", description=__doc__.split("\n")[0])
    sub = parser.add_subparsers(dest="command")
    lab_p = sub.add_parser("lab", help="the isolated Lab")
    lab_sub = lab_p.add_subparsers(dest="lab_command")
    lab_sub.add_parser("env", help="print export lines for the Lab env")
    init_p = lab_sub.add_parser("init", help="create or refresh the Lab")
    init_p.add_argument("--port", type=int, help="scripted model port")
    init_p.add_argument("--herdr", action="store_true",
                        help="also install herdr's OpenCode integration into the Lab config")
    lab_sub.add_parser("status", help="show the Lab's state")
    sm = sub.add_parser("scripted-model", help="run the local scripted model")
    sm.add_argument("--port", type=int, default=None)
    sm.add_argument("--host", default="127.0.0.1")
    sm.add_argument("--log", default=None)
    sm.add_argument("--pidfile", default=None)
    sp = sub.add_parser("spike", help="run a spike's API side and print its evidence")
    sp.add_argument("which", choices=("s3", "s4", "s5", "s6"))
    sp.add_argument("--pane", help="s6: Lab pane running the TUI")
    sp.add_argument("--agent", help="s6: herdr agent name of that pane")
    sp.add_argument("--session", help="s6: the session the TUI shows")
    ses_p = sub.add_parser("session", help="Lab v2 session helpers")
    ses_sub = ses_p.add_subparsers(dest="session_command")
    c = ses_sub.add_parser("create")
    c.add_argument("--title", required=True)
    c.add_argument("--agent", default="coder")
    c.add_argument("--fleet", help="metadata.fleet as JSON")
    c.add_argument("--permissions", help="session permissions as a JSON list")
    s = ses_sub.add_parser("synthetic")
    s.add_argument("session")
    s.add_argument("--text", required=True)
    s.add_argument("--resume", action="store_true")
    s.add_argument("--delivery", choices=("queue", "steer"), default="queue")
    s.add_argument("--keys", help="comma-separated metadata.fleet.keys")
    s.add_argument("--id", help="message id (default: derived from session and keys)")
    w = ses_sub.add_parser("wait-idle")
    w.add_argument("session")
    w.add_argument("--timeout", type=float, default=90)
    t = ses_sub.add_parser("transcript")
    t.add_argument("session")
    t.add_argument("--limit", type=int, default=20)
    run_p = sub.add_parser("run", help="play scenarios in the Lab (tier lab-scripted)")
    run_p.add_argument("paths", nargs="*", help="scenario files or directories "
                       "(default: scenarios/switchboard)")
    run_p.add_argument("--tier", default="lab-scripted")
    run_p.add_argument("--control-only", action="store_true", help="play only each control")
    run_p.add_argument("--no-control", action="store_true", help="play only each run")
    run_p.add_argument("--pane", help="Lab pane for the TUI (default: the first pane of the %r "
                       "workspace)" % LAB_WORKSPACE_LABEL)
    mr = sub.add_parser("model-requests", help="scripted-model requests since a time")
    mr.add_argument("--since", type=float, default=0)
    mr.add_argument("--marker")
    args = parser.parse_args(argv)
    lab = Lab()
    if args.command == "spike":
        return cmd_spike(lab, args)
    if args.command == "session":
        return cmd_session(lab, args)
    if args.command == "model-requests":
        return cmd_model_requests(lab, args)
    if args.command == "run":
        return cmd_run(lab, args)
    if args.command == "lab":
        handler = {"env": cmd_lab_env, "init": cmd_lab_init, "status": cmd_lab_status}.get(
            args.lab_command)
        if not handler:
            lab_p.print_help()
            return 2
        return handler(lab, args)
    if args.command == "scripted-model":
        if args.port is None:
            args.port = lab.port()
        return cmd_scripted_model(lab, args)
    parser.print_help()
    return 2


if __name__ == "__main__":
    sys.exit(main())
