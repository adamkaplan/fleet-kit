#!/usr/bin/env python3
"""test-cloud-channel-server: offline tests for bin/cloud_channel_server.py (slice 3 of the plan on #1059).

A real listener runs on loopback port 0 with a fake reviewer and inbox. Each rule has one mutant: the module's source is
changed in one place and the same check must then fail.

    bin/test-cloud-channel-server
"""
import http.client
import json
import socket
import sys
import threading
import time
import types
import unittest
from pathlib import Path

BIN = Path(__file__).resolve().parent
sys.path.insert(0, str(BIN))
SOURCE = (BIN / "cloud_channel_server.py").read_text()


def load(source=SOURCE):
    module = types.ModuleType("cloud_channel_server_under_test")
    exec(compile(source, "cloud_channel_server.py", "exec"), module.__dict__)
    return module


def mutant(old, new):
    assert SOURCE.count(old) == 1, old
    return load(SOURCE.replace(old, new))


class FakeInbox:
    def __init__(self):
        self.items = {}

    def put_if_absent(self, recipient, dedupe_key, item):
        if dedupe_key in self.items.setdefault(recipient, {}):
            return False
        self.items[recipient][dedupe_key] = item
        return True


def reviewer(token, audience):
    if token == "tok-a":
        return {"authenticated": True, "audiences": [audience],
                "user": {"username": "system:serviceaccount:fleet-agents:agent-a"}}
    if token == "tok-captain":
        return {"authenticated": True, "audiences": [audience],
                "user": {"username": "system:serviceaccount:fleet-agents:captain"}}
    return {"authenticated": False}


class Running:
    def __init__(self, module, timeout=0.5, max_handlers=None, host="127.0.0.1", deadline=None):
        module.REQUEST_TIMEOUT = timeout
        module.TOTAL_DEADLINE = deadline if deadline is not None else 10.0
        self.inbox, self.lines = FakeInbox(), []
        self.host = host
        self.server = module.make_server((host, 0), reviewer, self.inbox, self.lines.append, max_handlers)
        self.thread = threading.Thread(target=self.server.serve_forever, daemon=True)
        self.last_headers = ""

    def __enter__(self):
        self.thread.start()
        return self

    def __exit__(self, *exc):
        self.server.shutdown()
        self.server.server_close()

    def port(self):
        return self.server.server_address[1]

    def post(self, body, token="tok-a", path="/message", headers=None, method="POST"):
        conn = http.client.HTTPConnection("127.0.0.1", self.port(), timeout=5)
        h = dict(headers or {})
        if token is not None:
            h["Authorization"] = "Bearer " + token
        data = body if isinstance(body, bytes) else json.dumps(body).encode()
        try:
            conn.request(method, path, body=data, headers=h)
            try:
                r = conn.getresponse()
            except (http.client.HTTPException, OSError):
                return None, b""
            self.last_headers = str(r.getheaders())
            return r.status, r.read()
        finally:
            conn.close()

    def raw(self, data, wait=3.0):
        """Send raw bytes; (status, body) or (None, b"") when the connection was reset, closed or silent."""
        try:
            sock = socket.create_connection(("127.0.0.1", self.port()), timeout=wait)
        except OSError:
            return None, b""
        try:
            sock.sendall(data)
            buf = b""
            while b"\r\n\r\n" not in buf:
                chunk = sock.recv(4096)
                if not chunk:
                    break
                buf += chunk
            if not buf.startswith(b"HTTP/"):
                return None, b""
            return int(buf.split(b" ", 2)[1]), buf
        except OSError:
            return None, b""
        finally:
            sock.close()

    def everything(self, *extra):
        return " ".join([self.last_headers] + [e.decode() if isinstance(e, bytes) else str(e) for e in extra] + self.lines)


GOOD = {"sender": "agent-a", "recipient": "agent-b", "key": "k1", "text": "hi"}


def request_bytes(token, length, body=b"", extra=b""):
    head = b"POST /message HTTP/1.1\r\nHost: x\r\n"
    if token:
        head += b"Authorization: Bearer " + token.encode() + b"\r\n"
    if length is not None:
        head += b"Content-Length: " + str(length).encode() + b"\r\n"
    return head + extra + b"\r\n" + body


def check_no_token_401(module, test):
    with Running(module) as s:
        status, raw = s.post(GOOD, token=None)
        test.assertEqual(status, 401)
        test.assertEqual(s.inbox.items, {})
        status, raw = s.post(GOOD, token="tok-secret-zz")
        test.assertEqual(status, 401)
        test.assertNotIn("tok-secret-zz", s.everything(raw))


def check_auth_before_body(module, test):
    with Running(module, timeout=2) as s:
        # lying Content-Length, no body sent: the answer must come at once, from the header check alone
        status, _ = s.raw(request_bytes(None, 100), wait=1.0)
        test.assertEqual(status, 401)
        status, _ = s.raw(request_bytes(None, module.MAX_BODY * 10, b"{bad"), wait=1.0)
        test.assertEqual(status, 401)
        status, _ = s.raw(request_bytes(None, "abc"), wait=1.0)
        test.assertEqual(status, 401)
        test.assertEqual(s.inbox.items, {})


def check_big_body_413(module, test):
    with Running(module) as s:
        # headers only (the body is never sent), so the reply is read before any close or reset: exactly 413
        status, _ = s.raw(request_bytes("tok-a", module.MAX_BODY + 10), wait=2.0)
        test.assertEqual(status, 413)
        test.assertEqual(s.inbox.items, {})
        status, _ = s.raw(request_bytes("tok-a", module.MAX_BODY + 1), wait=2.0)
        test.assertEqual(status, 413)
        test.assertEqual(s.inbox.items, {})
        test.assertTrue(any("status=413" in line for line in s.lines))


def padded(size):
    base = dict(GOOD, pad="")
    extra = size - len(json.dumps(base).encode())
    return json.dumps(dict(base, pad="p" * extra)).encode()


def check_boundaries(module, test):
    with Running(module) as s:
        exact = padded(module.MAX_BODY)
        test.assertEqual(len(exact), module.MAX_BODY)
        test.assertEqual(s.post(exact)[0], 200)
        over = padded(module.MAX_BODY + 1)
        test.assertEqual(s.raw(request_bytes("tok-a", len(over)), wait=2.0)[0], 413)
        test.assertEqual(s.raw(request_bytes("tok-a", -5), wait=2.0)[0], 400)
        test.assertEqual(s.raw(request_bytes("tok-a", "abc"), wait=2.0)[0], 400)
        test.assertEqual(s.raw(request_bytes("tok-a", "1_0"), wait=2.0)[0], 400)
        # a body but no Content-Length: read as empty, so a 400 and nothing delivered
        before = dict(s.inbox.items)
        test.assertEqual(s.raw(request_bytes("tok-a", None, json.dumps(GOOD).encode()), wait=2.0)[0], 400)
        test.assertEqual(s.inbox.items, before)


def check_short_body_408(module, test):
    with Running(module, timeout=0.3) as s:
        status, _ = s.raw(request_bytes("tok-a", 100, b"{\"sen"), wait=3.0)
        test.assertEqual(status, 408)
        test.assertEqual(s.inbox.items, {})


def check_cap_503(module, test):
    with Running(module, timeout=3, max_handlers=2) as s:
        held = [socket.create_connection(("127.0.0.1", s.port())) for _ in range(2)]
        try:
            time.sleep(0.3)
            t0 = time.time()
            status, buf = s.raw(request_bytes("tok-a", 2, b"{}"), wait=1.0)
            # closed at once with no reply body: the accept thread does not wait on the client
            test.assertIsNone(status)
            test.assertLess(time.time() - t0, 0.9)
            test.assertTrue(any("status=503" in l and "cap of 2" in l for l in s.lines), s.lines)
        finally:
            for c in held:
                c.close()
        test.assertTrue(s.server.daemon_threads)


def check_transfer_encoding(module, test):
    with Running(module) as s:
        body = json.dumps(GOOD).encode()
        status, _ = s.raw(request_bytes("tok-a", len(body), body, b"Transfer-Encoding: chunked\r\n"), wait=2.0)
        test.assertEqual(status, 400)
        test.assertEqual(s.inbox.items, {})


def check_non_string_names(module, test):
    with Running(module) as s:
        for bad in (["captain"], {"a": 1}, 5, None):
            status, _ = s.post(dict(GOOD, sender=bad))
            test.assertEqual(status, 400)
            status, _ = s.post(dict(GOOD, recipient=bad))
            test.assertEqual(status, 400)
        test.assertEqual(s.inbox.items, {})
        test.assertTrue(any("status=400" in line and "not a string" in line for line in s.lines))


def check_reserved_403(module, test):
    with Running(module) as s:
        status, _ = s.post(dict(GOOD, sender="captain"), token="tok-captain")
        test.assertEqual(status, 403)
        status, _ = s.post(dict(GOOD, recipient="switchboard"))
        test.assertEqual(status, 403)
        status, _ = s.post(dict(GOOD, recipient=" Switchboard "))
        test.assertEqual(status, 403)
        status, _ = s.post(dict(GOOD, sender="CAPTAIN"), token="tok-captain")
        test.assertEqual(status, 403)
        test.assertEqual(s.inbox.items, {})


def check_unauthenticated_names_401(module, test):
    with Running(module) as s:
        for body in (dict(GOOD, sender="captain"), dict(GOOD, recipient="switchboard"), dict(GOOD, sender=["x"]),
                     dict(GOOD, recipient={"a": 1})):
            for token in ("tok-bad", "tok-secret-zz"):
                status, raw = s.post(body, token=token)
                test.assertEqual(status, 401, body)
                test.assertNotIn(token, s.everything(raw))
        test.assertFalse(any("reserved" in l or "not a string" in l or "status=403" in l or "status=400" in l
                             for l in s.lines), s.lines)
        test.assertEqual(s.inbox.items, {})


def check_token_not_in_audit(module, test):
    with Running(module) as s:
        s.post(GOOD, token="tok-a")
        s.post(dict(GOOD, sender="captain"), token="tok-a")
        s.post(dict(GOOD, sender=["x"]), token="tok-a")
        s.raw(request_bytes("tok-a", module.MAX_BODY + 5), wait=2.0)
        s.raw(request_bytes("tok-a", 3, b"{}x", b"Transfer-Encoding: chunked\r\n"), wait=2.0)
        s.raw(request_bytes("tok-a", "abc"), wait=2.0)
        s.raw(request_bytes("tok-a", 100, b"{"), wait=2.0)
        s.post(GOOD, token="tok-bad")
        test.assertGreaterEqual(len(s.lines), 6)
        test.assertFalse([l for l in s.lines if "tok-a" in l or "tok-bad" in l or "Bearer" in l], s.lines)


def check_total_deadline(module, test):
    with Running(module, timeout=2.0, deadline=0.6) as s:
        sock = socket.create_connection(("127.0.0.1", s.port()), timeout=5)
        try:
            sock.sendall(request_bytes("tok-a", 50))
            t0, buf = time.time(), b""
            try:
                while time.time() - t0 < 4 and b"\r\n\r\n" not in buf:
                    sock.sendall(b"{")   # one byte per read: never trips the per-read timeout
                    sock.settimeout(0.2)
                    try:
                        chunk = sock.recv(4096)
                        if not chunk:
                            break
                        buf += chunk
                    except socket.timeout:
                        pass
            except OSError:
                pass
        finally:
            sock.close()
        test.assertTrue(buf.split(b"\r\n")[0].endswith(b"408 Request Timeout"), buf)
        test.assertLess(time.time() - t0, 2.0)
        test.assertEqual(s.inbox.items, {})


def check_delivers(module, test):
    with Running(module) as s:
        status, raw = s.post(GOOD)
        test.assertEqual(status, 200)
        test.assertTrue(json.loads(raw)["delivered"])
        test.assertIn("agent-a/k1", s.inbox.items["agent-b"])
        test.assertNotIn("tok-a", s.everything(raw))
        status, raw = s.post(GOOD, token="tok-wrong")
        test.assertIn(status, (401, 403))
        test.assertNotIn("tok-wrong", s.everything(raw))
        status, raw = s.post(dict(GOOD, text="x" * (module.MAX_BODY + 10)), token="tok-leak")
        test.assertNotIn("tok-leak", s.everything(raw))


def check_bad_json_400(module, test):
    with Running(module) as s:
        test.assertEqual(s.post(b"not json")[0], 400)
        test.assertEqual(s.post(b"[1]")[0], 400)


def check_only_message_post(module, test):
    with Running(module) as s:
        test.assertEqual(s.post(GOOD, path="/other")[0], 404)
        test.assertEqual(s.post(GOOD, method="GET")[0], 405)


def check_bind(module, test):
    with Running(module) as s:
        test.assertEqual(s.server.server_address[0], "127.0.0.1")
    # a non-loopback host is allowed: a listener in a pod binds the pod address
    test.assertEqual(module.listen_address({module.LISTEN_ENV: "10.1.2.3:8443"}), ("10.1.2.3", 8443))


def check_configured_only(module, test):
    test.assertIsNone(module.listen_address({}))
    test.assertIsNone(module.listen_address({module.LISTEN_ENV: "nonsense"}))
    test.assertIsNone(module.listen_address({module.LISTEN_ENV: "0.0.0.0:99999"}))
    test.assertEqual(module.listen_address({module.LISTEN_ENV: "127.0.0.1:8443"}), ("127.0.0.1", 8443))
    try:
        module.make_server(None, reviewer, FakeInbox(), print)
    except ValueError:
        pass
    except Exception as exc:
        test.fail("make_server(None) must raise ValueError, got %r" % exc)
    else:
        test.fail("make_server(None) must raise ValueError")
    calls = []

    def fake_make_server(*args, **kwargs):
        calls.append(args)
        raise test.failureException("make_server must not be called when not configured")
    module.make_server = fake_make_server
    test.assertIs(module.serve({}, reviewer, FakeInbox(), print), False)
    test.assertIs(module.serve({module.LISTEN_ENV: "junk"}, reviewer, FakeInbox(), print), False)
    test.assertEqual(calls, [])


def check_bearer_reused(module, test):
    import cloud_channel
    test.assertIs(module.BEARER, cloud_channel.BEARER)
    test.assertEqual(module.BEARER, "Bearer ")


CHECKS = [
    ("no_token_401", check_no_token_401, "return self._refuse_early(401, \"no token\", \"no token\")", "return self._send(200, {\"status\": 200})"),
    ("no_token_echo", check_delivers, "data = json.dumps(payload).encode()", "data = json.dumps(dict(payload, echo=self.headers.get(\"Authorization\"))).encode()"),
    ("no_token_echo_401", check_no_token_401, "data = json.dumps(payload).encode()", "data = json.dumps(dict(payload, echo=self.headers.get(\"Authorization\"))).encode()"),
    ("auth_before_body", check_auth_before_body, "            header = self.headers.get(\"Authorization\")\n", "            header = self.headers.get(\"Authorization\")\n            self.rfile.read(int(self.headers.get(\"Content-Length\") or 0))\n"),
    ("big_body_413", check_big_body_413, "if declared > MAX_BODY:", "if declared > MAX_BODY * 1000:"),
    ("boundary_exact", check_boundaries, "if declared > MAX_BODY:", "if declared >= MAX_BODY:"),
    ("boundary_over", check_boundaries, "if declared > MAX_BODY:", "if declared > MAX_BODY + 1:"),
    ("boundary_nonnumeric", check_boundaries, "if not (length.isascii() and length.isdigit()):", "if False:"),
    ("boundary_missing_length", check_boundaries, ".get(\"Content-Length\", \"0\")", ".get(\"Content-Length\", \"1000\")"),
    ("short_body_408", check_short_body_408, "except (TimeoutError, socket.timeout):", "except ZeroDivisionError:"),
    ("short_body_timeout_unset", check_short_body_408, "        timeout = REQUEST_TIMEOUT\n", "        timeout = None\n"),
    ("cap_503", check_cap_503, "if not self._slots.acquire(blocking=False):", "if False:"),
    ("cap_daemon", check_cap_503, "    daemon_threads = True", "    daemon_threads = False"),
    ("transfer_encoding", check_transfer_encoding, "if self.headers.get(\"Transfer-Encoding\") is not None:", "if False:"),
    ("non_string_names", check_non_string_names, "if not all(isinstance(n, str) for n in names):", "if False:"),
    ("reserved_403", check_reserved_403, "if any(n.strip().casefold() in RESERVED for n in names):", "if False:"),
    ("reserved_normalised", check_reserved_403, "n.strip().casefold() in RESERVED", "n in RESERVED"),
    ("unauth_names_401", check_unauthenticated_names_401, "                if probe[\"status\"] in (401, 503):", "                if False:"),
    ("audit_token", check_token_not_in_audit, "audit(\"refused status=%d reason=%s\" % (status, reason))", "audit(\"refused status=%d reason=%s %s\" % (status, reason, self.headers.get(\"Authorization\")))"),
    ("audit_token_names", check_token_not_in_audit, "audit(\"refused status=%d reason=%s\" % (refusal[0], refusal[2]))", "audit(\"refused status=%d reason=%s %s\" % (refusal[0], refusal[2], header))"),
    ("total_deadline", check_total_deadline, "            timer = threading.Timer(self.deadline, self._expire)\n            timer.daemon = True\n            timer.start()", "            timer = threading.Timer(10 ** 6, self._expire)\n            timer.daemon = True\n            timer.start()"),
    ("cap_503_audit", check_cap_503, "self.audit(\"refused status=503", "(lambda line: None)(\"refused status=503"),
    ("delivers", check_delivers, "result = cloud_channel.handle({", "result = dict({"),
    ("bad_json_400", check_bad_json_400, "            if isinstance(body, dict):\n                names", "            if True:\n                names"),
    ("only_message_post", check_only_message_post, "if self.path != \"/message\":", "if False:"),
    ("bind", check_bind, "_Server(address, Handler,", "_Server((\"0.0.0.0\", address[1]), Handler,"),
    ("configured_only", check_configured_only, "if address is None:\n        raise", "if False:\n        raise"),
    ("configured_only_serve", check_configured_only, "    if address is None:\n        return False", "    if False:\n        return False"),
    ("bearer_reused", check_bearer_reused, "BEARER = cloud_channel.BEARER", "BEARER = \"Bearer  \""),
]


class TestCloudChannelServer(unittest.TestCase):
    pass


def _add(name, check, old, new):
    def real(self):
        check(load(), self)

    def killed(self):
        module = mutant(old, new)
        with self.assertRaises(AssertionError):
            check(module, self)
    setattr(TestCloudChannelServer, "test_" + name, real)
    setattr(TestCloudChannelServer, "test_mutant_" + name, killed)


for _c in CHECKS:
    _add(*_c)


class TestNoSecrets(unittest.TestCase):
    def test_source_holds_no_token(self):
        self.assertNotRegex(SOURCE, r"(?i)(ghp_|eyJ[A-Za-z0-9]{10}|secret\s*=)")


if __name__ == "__main__":
    result = unittest.main(exit=False, verbosity=1).result
    ok_ = result.wasSuccessful()
    print("RESULT: %s" % ("PASS" if ok_ else "FAIL"))
    sys.exit(0 if ok_ else 1)
