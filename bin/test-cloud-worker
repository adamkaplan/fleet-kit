#!/usr/bin/env python3
"""test-cloud-worker — offline tests for the switchboard's remote-worker support (bin/cloud_worker.py, #371).

No Azure, no network beyond loopback: a fake remote OpenCode server (a thread on 127.0.0.1) and a stub launcher script stand in for the cloud and
for slice B's `cloud-worker`. Scenarios S1-S3 of the plan on #371 (U1, local behaviour unchanged, is bin/test-switchboard passing with no edit).

    bin/test-cloud-worker
"""
import base64
import contextlib
import importlib.machinery
import importlib.util
import io
import json
import os
import stat
import signal
import subprocess
import sys
import time
import tempfile
import threading
import unittest
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from unittest import mock

os.environ.setdefault("FLEET_SWITCHBOARD_UNDER_TEST", "1")
BIN = Path(__file__).resolve().parent
loader = importlib.machinery.SourceFileLoader("cw_fleet_switchboard", str(BIN / "fleet-switchboard"))
spec = importlib.util.spec_from_loader("cw_fleet_switchboard", loader)
sb = importlib.util.module_from_spec(spec)
sys.modules["cw_fleet_switchboard"] = sb   # what the removed load_module() did before executing
loader.exec_module(sb)

PASSWORD = "pw-" + "x" * 20


class FakeRemote:
    """A fake remote OpenCode server: sessions, prompts, messages, Basic auth. It records every request and whether it carried the password."""

    def __init__(self, password):
        self.password = password
        self.requests = []     # (method, path, authorization or None)
        self.messages = []
        outer = self

        class Handler(BaseHTTPRequestHandler):
            def log_message(self, *args):
                pass

            def _answer(self, status, body):
                raw = json.dumps(body).encode()
                self.send_response(status)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(raw)))
                self.end_headers()
                self.wfile.write(raw)

            def _handle(self):
                length = int(self.headers.get("Content-Length") or 0)
                body = json.loads(self.rfile.read(length)) if length else None
                auth = self.headers.get("Authorization")
                outer.requests.append((self.command, self.path, auth))
                expected = "Basic " + base64.b64encode(("opencode:" + outer.password).encode()).decode()
                if auth != expected:
                    return self._answer(401, {"error": "unauthorized"})
                if self.command == "GET" and self.path == "/api/info":
                    return self._answer(200, {"data": {"version": "test"}})
                if self.command == "POST" and self.path == "/api/session":
                    return self._answer(200, {"data": {"id": "ses_remote1"}})
                if self.command == "POST" and self.path.endswith("/prompt"):
                    outer.messages.append({"type": "user", "text": body["text"], "metadata": body.get("metadata")})
                    outer.messages.append({"type": "assistant", "text": "ack: " + body["text"]})
                    return self._answer(200, {"data": {"id": "msg_%d" % len(outer.messages)}})
                if self.command == "GET" and "/message" in self.path:
                    return self._answer(200, {"data": list(reversed(outer.messages))})
                return self._answer(404, {"error": "no such route"})

            do_GET = do_POST = _handle

        self.server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
        self.thread = threading.Thread(target=self.server.serve_forever, daemon=True)
        self.thread.start()
        self.url = "http://127.0.0.1:%d" % self.server.server_address[1]

    def close(self):
        self.server.shutdown()
        self.server.server_close()


STUB = """#!%(python)s
import json, os, sys
argv = sys.argv[1:]
log = os.environ["STUB_DIR"] + "/calls.log"
open(log, "a").write(json.dumps(argv) + "\\n")
command, worker = argv[0], argv[1]
import hashlib
tf = os.environ.get("CW_CLOUD_TOKEN_FILE")
login = {"command": command, "argv": argv, "env": dict(os.environ), "token_ok": bool(tf) and hashlib.sha256(open(tf).read().encode()).hexdigest() == os.environ.get("STUB_TOKEN_SHA"),
         "token_mode": oct(os.stat(tf).st_mode & 0o777) if tf else None}
open(os.environ["STUB_DIR"] + "/login.log", "a").write(json.dumps(login) + "\\n")
if command == "create":
    for item in argv:
        if "=" in item and item.split("=")[0] in ("model-auth", "git-token"):
            fd = int(item.split("=")[1])
            open(os.environ["STUB_DIR"] + "/received-" + item.split("=")[0], "w").write(os.read(fd, 100000).decode())
    if os.environ.get("STUB_CREATE_FAIL"):
        every = [open(os.environ["STUB_DIR"] + "/received-" + n).read() for n in ("model-auth", "git-token")] + [open(tf).read()]
        sys.stderr.write(" | ".join(every) + "\\n")
        sys.exit(3)
if command == "create":
    fd = int(argv[argv.index("--password-fd") + 1])
    os.write(fd, (os.environ["STUB_PASSWORD"] + "\\n").encode())
    os.close(fd)
    print(json.dumps({"worker": worker, "url": os.environ["STUB_URL"], "auth_ref": "file:/etc/passwd", "runtime_id": "pod/%%s-7f9c" %% worker,
                      "idle_deadline": "2099-10-14T12:10:00Z", "hard_deadline": "2099-10-14T14:00:00Z"}))
elif command == "stop":
    code = int(os.environ.get("STUB_STOP_EXIT", "0"))
    if code:
        sys.stderr.write("push refused by the remote\\n")
        sys.exit(code)
    print(json.dumps({"worker": worker, "runtime_id": "pod/%%s-7f9c" %% worker, "pushed": True, "wip_branch": worker + "/wip"}))
elif command == "status":
    print(json.dumps({"worker": worker, "runtime_id": "pod/%%s-7f9c" %% worker, "phase": "running", "cost_estimate_usd": 0.07}))
"""


KUBECTL = """#!%(python)s
import hashlib, json, os, socket, sys, threading
args = sys.argv[1:]
d = os.environ["STUB_DIR"]
kc = args[args.index("--kubeconfig") + 1]
entry = {"args": args, "kubeconfig_is_dev_fd": kc.startswith("/dev/fd/")}
if "token" in args and "create" in args:
    entry["admin_ok"] = hashlib.sha256(open(kc).read().encode()).hexdigest() == os.environ["STUB_ADMIN_SHA"]
    entry["env_has_token"] = os.environ.get("KUBECONFIG")
    open(d + "/kubectl.log", "a").write(json.dumps(entry) + "\\n")
    sys.stdout.write(open(d + "/mint_token").read())
    sys.exit(0)
cfg = json.load(open(kc))
tf = cfg["users"][0]["user"]["tokenFile"]
entry["token_ok"] = hashlib.sha256(open(tf).read().encode()).hexdigest() == os.environ["STUB_TOKEN_SHA"]
entry["config_text_has_token"] = open(tf).read() in open(kc).read()
entry["env"] = dict(os.environ)
open(d + "/kubectl.log", "a").write(json.dumps(entry) + "\\n")
if "port-forward" in args:
    if os.path.exists(d + "/pf_die"):
        sys.stderr.write("error: " + open(tf).read() + " unauthorized\\n")
        sys.exit(1)
    open(d + "/pf.pid", "a").write(str(os.getpid()) + "\\n")
    if os.path.exists(d + "/pf_hang"):
        import time
        time.sleep(600)
    local = int(args[args.index("port-forward") + 2].split(":")[0])
    if os.path.exists(d + "/pf_squat"):
        import time
        time.sleep(600)
    target = int(os.environ["STUB_URL"].rsplit(":", 1)[1])
    srv = socket.socket(); srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    srv.bind(("127.0.0.1", local)); srv.listen(8)
    print("Forwarding from 127.0.0.1:" + str(local) + " -> 4096", flush=True)
    def pipe(a, b):
        try:
            while True:
                data = a.recv(65536)
                if not data:
                    break
                b.sendall(data)
        except OSError:
            pass
        finally:
            for x in (a, b):
                try:
                    x.shutdown(socket.SHUT_RDWR)
                except OSError:
                    pass
    while True:
        c, _ = srv.accept()
        u = socket.create_connection(("127.0.0.1", target))
        threading.Thread(target=pipe, args=(c, u), daemon=True).start()
        threading.Thread(target=pipe, args=(u, c), daemon=True).start()
"""

AZ = """#!/bin/sh
[ -e "$STUB_DIR/vault_down" ] && { echo "vault unreachable" >&2; exit 1; }
cat "$STUB_DIR/admin_kubeconfig"
"""


def make_jwt(lifetime, issued=None):
    import time as _t
    issued = int(_t.time()) if issued is None else issued
    part = lambda obj: base64.urlsafe_b64encode(json.dumps(obj).encode()).decode().rstrip("=")
    return part({"alg": "none"}) + "." + part({"iat": issued, "exp": issued + lifetime}) + "." + "c2lnbmF0dXJl" * 3


CLUSTER_TOKEN = make_jwt(1200)
ADMIN_KUBECONFIG = "apiVersion: v1\nclusters: []\nusers:\n- name: admin\n  user: {token: ADMINSECRET-q8w7e6r5t4y3}\n"
MODEL_ENTRY = {"type": "oauth", "refresh": "ghu_ModelRefreshSecret0123456789", "access": "gho_ModelAccessSecret9876543210", "expires": 0}
GIT_TOKEN = "ghs_GitInstallationTokenAbCdEf0123456789"


class Base(unittest.TestCase):
    def setUp(self):
        tmp = tempfile.TemporaryDirectory(dir=str(BIN.parent))   # under the worktree, never the shared /tmp
        self.addCleanup(tmp.cleanup)
        self.home = Path(tmp.name).resolve()
        self.stub_dir = self.home / "stub"
        self.stub_dir.mkdir()
        self.stub = self.stub_dir / "cloud-worker"
        self.stub.write_text(STUB % {"python": sys.executable})
        self.stub.chmod(0o755)
        fake_opencode = self.home / "opencode"
        fake_opencode.write_text("#!/bin/sh\nexit 1\n")
        fake_opencode.chmod(0o755)
        self.remote = FakeRemote(PASSWORD)
        self.addCleanup(self.remote.close)
        import hashlib
        for name, body in (("kubectl", KUBECTL % {"python": sys.executable}), ("az", AZ)):
            (self.stub_dir / name).write_text(body)
            (self.stub_dir / name).chmod(0o755)
        (self.stub_dir / "mint_token").write_text(CLUSTER_TOKEN)
        (self.stub_dir / "admin_kubeconfig").write_text(ADMIN_KUBECONFIG)
        (self.stub_dir / "git_token").write_text(GIT_TOKEN + "\n")
        (self.home / "auth.json").write_text(json.dumps({"github-copilot": MODEL_ENTRY, "other": {"key": "must-not-travel"}}))
        (self.home / "tmp").mkdir()
        self.root = self.home / "tmp" / ("cwtok-%d" % os.getuid())
        tmpdir = mock.patch.object(tempfile, "tempdir", str(self.home / "tmp"))
        tmpdir.start()
        self.addCleanup(tmpdir.stop)
        patcher = mock.patch.dict(os.environ, {
            "HOME": str(self.home), "XDG_CONFIG_HOME": str(self.home / "cfg"), "XDG_STATE_HOME": str(self.home / "state"),
            "PATH": "%s:/usr/bin:/bin" % self.stub_dir, "FLEET_CLOUD_WORKER_BIN": str(self.stub), "STUB_DIR": str(self.stub_dir),
            "STUB_PASSWORD": PASSWORD, "STUB_URL": self.remote.url, "STUB_STOP_EXIT": "0",
            "CW_ALLOWED_REPOS": "acme-org/widget-service", "CW_CLOUD_SERVER": "https://cluster.example.internal:6443",
            "CW_KUBECTL": str(self.stub_dir / "kubectl"), "CW_VAULT_SUBSCRIPTION": "sub-example", "CW_VAULT_NAME": "vault-example",
            "CW_GIT_TOKEN_CMD": "cat %s" % (self.stub_dir / "git_token"), "CW_MODEL_AUTH_FILE": str(self.home / "auth.json"),
            "STUB_TOKEN_SHA": hashlib.sha256(CLUSTER_TOKEN.encode()).hexdigest(),
            "STUB_ADMIN_SHA": hashlib.sha256(ADMIN_KUBECONFIG.encode()).hexdigest(), "TMPDIR": str(self.home / "tmp"),
            "CW_TUNNEL_TIMEOUT": "10"})
        patcher.start()
        self.addCleanup(patcher.stop)
        for name in ("HERDR_PANE_ID", "OPENCODE_SESSION_ID", "CW_KUBE_CONTEXT", "CW_TOOLING_REPO", "CW_CLUSTER_TOKEN_CMD"):
            os.environ.pop(name, None)
        config = self.home / "cfg" / "fleet-switchboard" / "config.json"
        config.parent.mkdir(parents=True)
        config.write_text(json.dumps({"opencode": str(fake_opencode), "herdr": str(self.home / "no-herdr")}))
        self.state = self.home / "state" / "fleet-switchboard"
        for target, value in ((sb, "ENSURE_ON_USE"),):
            patch = mock.patch.object(target, value, False)
            patch.start()
            self.addCleanup(patch.stop)
        person = mock.patch.object(sb, "gates_caller_kind", lambda runner, now: ("person", "a person at a shell"))
        person.start()
        self.addCleanup(person.stop)

    def main(self, *argv):
        out, err = io.StringIO(), io.StringIO()
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
            code = sb.main(list(argv), runner=subprocess.run)
        return code, out.getvalue(), err.getvalue()

    def stub_calls(self):
        log = self.stub_dir / "calls.log"
        return [json.loads(line) for line in log.read_text().splitlines()] if log.exists() else []

    def jsonl(self, name):
        path = self.stub_dir / name
        return [json.loads(line) for line in path.read_text().splitlines()] if path.exists() else []

    def leftovers(self):
        return sorted(str(p) for p in self.root.rglob("*")) if self.root.exists() else []

    def pf_alive(self):
        alive = []
        path = self.stub_dir / "pf.pid"
        for pid in (path.read_text().split() if path.exists() else []):
            try:
                os.kill(int(pid), 0)
                alive.append(pid)
            except ProcessLookupError:
                pass
        return alive

    def launch(self, name="coder7"):
        brief = self.home / "brief.txt"
        brief.write_text("Build the thing.\n")
        return self.main("launch", name, "--cloud", "--agent", "coder", "--repo", "acme-org/widget-service", "--branch", "main",
                         "--role", "coder", "--reports-to", "orch", "--brief-file", str(brief))

    def everything_written(self):
        """All text the switchboard left behind (state files, the audit log), to prove the password is in none of it but its own file."""
        found = {}
        for path in self.state.rglob("*"):
            if path.is_file() and path.suffix != ".password":
                found[str(path)] = path.read_text(errors="replace")
        return found


class TestCloudWorkerLifecycle(Base):
    def test_s1_launch_send_read_status_retire_use_the_same_commands(self):
        baseline = self.main("status")[0]
        code, out, err = self.launch()
        self.assertEqual(code, 0, err)
        self.assertEqual(json.loads(out)["session"], "ses_remote1")
        self.assertTrue((self.state / "cloud" / "coder7.json").exists())
        record = json.loads((self.state / "cloud" / "coder7.json").read_text())
        self.assertEqual(record["auth_ref"], "file:" + str(self.state / "cloud" / "coder7.password"))   # our own path, never the launcher's
        self.assertEqual(oct(stat.S_IMODE((self.state / "cloud" / "coder7.json").stat().st_mode)), "0o600")
        self.assertEqual(oct(stat.S_IMODE((self.state / "cloud" / "coder7.password").stat().st_mode)), "0o600")
        self.assertEqual(self.remote.messages[0]["text"], "Build the thing.\n")   # the brief reached the remote session

        code, out, err = self.main("send", "coder7", "please", "rebase")
        self.assertEqual(code, 0, err)
        self.assertEqual(out.strip(), "msg_4")
        code, out, err = self.main("read", "coder7")
        self.assertEqual(code, 0, err)
        self.assertIn("assistant: ack: please rebase", out)

        code, out, err = self.main("status")
        self.assertEqual(code, baseline, err)   # a cloud worker adds no failure of its own (the base status reflects the daemon and herdr: absent here)
        self.assertIn("cloud coder7: pod/coder7-7f9c, phase running, about $0.07 so far", out)

        code, out, err = self.main("retire", "coder7", "--reason", "done")
        self.assertEqual(code, 0, err)
        self.assertIn("coder7 is retired", out)
        self.assertEqual([c[0] for c in self.stub_calls() if c[0] == "stop"], ["stop"])   # the launcher's stop ran once
        self.assertFalse((self.state / "cloud" / "coder7.json").exists())
        self.assertFalse((self.state / "cloud" / "coder7.password").exists())
        for where, text in self.everything_written().items():
            self.assertNotIn(PASSWORD, text, where)
        for text in (out, err):
            self.assertNotIn(PASSWORD, text)

    def test_s1_a_failed_create_leaves_no_record(self):
        with mock.patch.dict(os.environ, {"STUB_URL": "http://worker.example.internal:4096"}):   # plain http to a non-loopback host
            code, out, err = self.launch()
        self.assertEqual(code, 1)
        self.assertIn("refused", err)
        self.assertFalse((self.state / "cloud" / "coder7.json").exists())
        self.assertIn("stop", [c[0] for c in self.stub_calls()])   # the pod it made is stopped, not left running
        self.assertEqual(self.remote.requests, [])

    def test_s3_a_stop_that_cannot_push_keeps_the_pod_and_the_record(self):
        self.assertEqual(self.launch()[0], 0)
        with mock.patch.dict(os.environ, {"STUB_STOP_EXIT": "1"}):
            code, out, err = self.main("retire", "coder7")
        self.assertEqual(code, 1)
        self.assertIn("pod kept", out)
        self.assertIn("push refused", err)
        self.assertTrue((self.state / "cloud" / "coder7.json").exists())
        code, out, err = self.main("retire", "coder7")   # once the push can succeed, the same command finishes it
        self.assertEqual(code, 0, err)
        self.assertFalse((self.state / "cloud" / "coder7.json").exists())


class TestCloudWorkerEndpoint(Base):
    def test_s2_the_password_goes_only_to_the_host_the_record_names(self):
        other = FakeRemote(PASSWORD)
        self.addCleanup(other.close)
        self.assertEqual(self.launch()[0], 0)
        record = sb.load_module("cloud_worker").bind(vars(sb)).load_record(self.state, "coder7")
        v2 = sb.load_module("cloud_worker").bind(vars(sb)).remote_v2(self.state, record)
        v2.message_list("ses_remote1", limit=1)
        named = [r for r in self.remote.requests if r[1].startswith("/api/session/ses_remote1/message")]
        self.assertEqual(len(named), 1)
        self.assertTrue(named[0][2].startswith("Basic "))   # 1 of 1 to the named host carries the Authorization header
        http = v2.http
        for target in (other.url + "/api/session", "//127.0.0.1:%s/x" % other.url.rsplit(":", 1)[1], "http://" + other.url[7:]):
            with self.assertRaises(sb.V2Error) as caught:
                http.request("GET", target)
            self.assertEqual(caught.exception.reason, "refused")
        self.assertEqual(other.requests, [])                # 0 of 1 to another host carries it: not one request reaches it

    def test_the_remote_client_never_falls_back_to_the_local_cli(self):
        record = {"worker": "coder7", "url": "http://127.0.0.1:9", "runtime_id": "pod/x"}   # nothing listens there
        (self.state).mkdir(parents=True, exist_ok=True)
        os.chmod(str(self.state), 0o700)
        sb.load_module("cloud_worker").bind(vars(sb))._write_private(sb.load_module("cloud_worker").bind(vars(sb)).password_path(self.state, "coder7"), PASSWORD + "\n")
        v2 = sb.load_module("cloud_worker").bind(vars(sb)).remote_v2(self.state, record, timeout=2)
        with self.assertRaises(sb.V2Error) as caught:
            v2.session_get("ses_x")
        self.assertEqual(caught.exception.reason, "unavailable")
        self.assertIn("no local fallback", str(caught.exception))

    def test_a_pods_escape_sequences_are_not_printed(self):
        line = sb.load_module("cloud_worker").bind(vars(sb)).message_line({"type": "as\x1b[31m", "text": "a\x9b2Jb\x07"})
        self.assertNotRegex(line, r"[\x00-\x08\x0b-\x1f\x7f-\x9f]")

    def test_retire_by_an_agent_that_is_not_the_boss_is_refused(self):
        self.assertEqual(self.launch()[0], 0)
        stops = len([c for c in self.stub_calls() if c[0] == "stop"])
        with mock.patch.object(sb, "gates_caller_kind", lambda runner, now: ("agent", "stranger", "coder")):
            code, out, err = self.main("retire", "coder7")
        self.assertEqual(code, 1)
        self.assertIn("refused", err)
        self.assertEqual(len([c for c in self.stub_calls() if c[0] == "stop"]), stops)
        self.assertTrue((self.state / "cloud" / "coder7.json").exists())
        with mock.patch.object(sb, "gates_caller_kind", lambda runner, now: ("agent", "orch", "orchestrator")):   # its own boss may
            self.assertEqual(self.main("retire", "coder7")[0], 0)

    def test_a_record_that_is_unusable_fails_closed(self):
        self.assertEqual(self.launch()[0], 0)
        (self.state / "cloud" / "coder7.json").write_text("{not json")
        os.chmod(str(self.state / "cloud" / "coder7.json"), 0o600)
        before = len(self.remote.requests)
        code, out, err = self.main("send", "coder7", "hi")
        self.assertEqual(code, 1)
        self.assertEqual(len(self.remote.requests), before)

    def test_a_launcher_that_fails_creates_nothing(self):
        with mock.patch.dict(os.environ, {"FLEET_CLOUD_WORKER_BIN": "/bin/false"}):
            code, out, err = self.launch()
        self.assertEqual(code, 1)
        self.assertFalse((self.state / "cloud" / "coder7.json").exists())

    def test_cloud_with_headless_is_refused_with_no_side_effect(self):
        before = len(self.remote.requests)
        code, out, err = self.main("launch", "coder7", "--cloud", "--headless", "--agent", "coder", "--repo", "acme-org/widget-service", "--branch", "main")
        self.assertEqual(code, 1)
        self.assertIn("--cloud and --headless do not combine", err)
        self.assertEqual(len(err.strip().splitlines()), 1)
        self.assertFalse((self.state / "cloud" / "coder7.json").exists())
        self.assertEqual(len(self.remote.requests), before)

    def test_with_no_cloud_workers_status_has_no_cloud_key(self):
        code, out, err = self.main("status", "--json")
        self.assertNotIn("cloud", json.loads(out))

    def test_endpoint_rules(self):
        problem = sb.load_module("cloud_worker").bind(vars(sb)).endpoint_problem
        self.assertIsNone(problem("https://worker-coder7.example.internal:4096"))
        self.assertIsNone(problem("http://127.0.0.1:4096"))
        for bad in ("http://worker.example.internal:4096", "https://user:pw@host.example:1", "https://host.example/path",
                    "ftp://host.example", "https://", "", "https://host.example?x=1"):
            self.assertIsNotNone(problem(bad), bad)

    def test_a_password_file_open_to_others_is_not_used(self):
        self.assertEqual(self.launch()[0], 0)
        os.chmod(str(self.state / "cloud" / "coder7.password"), 0o644)
        before = len(self.remote.requests)
        code, out, err = self.main("send", "coder7", "hello")
        self.assertEqual(code, 1)
        self.assertEqual(len(self.remote.requests), before)   # nothing was sent: the password file was not trusted
        self.assertNotIn(PASSWORD, err)


class TestWiring(Base):
    """#640: per-run secrets by descriptor, a cluster token per use, a tunnel per command, the allow-list, and nothing kept."""

    PLANTED = [GIT_TOKEN, CLUSTER_TOKEN, PASSWORD, MODEL_ENTRY["refresh"], MODEL_ENTRY["access"], "ADMINSECRET-q8w7e6r5t4y3"]

    def forms(self):
        out = []
        for value in self.PLANTED:
            out += [value, base64.b64encode(value.encode()).decode(), value.encode().hex(), value[: len(value) // 2], value[8:20]]
        return out

    def assertNoSecret(self, *texts, where=""):
        for text in texts:
            for value in self.forms():
                if len(value) >= 8:
                    self.assertNotIn(value, text, where)

    def assertNothingKept(self):
        self.assertEqual(self.leftovers(), [])
        self.assertEqual(self.pf_alive(), [])

    def test_s1_launch_passes_both_secrets_by_descriptor_and_nowhere_else(self):
        code, out, err = self.launch()
        self.assertEqual(code, 0, err)
        self.assertEqual(json.loads((self.stub_dir / "received-model-auth").read_text()), {"github-copilot": MODEL_ENTRY})   # only that entry travels
        self.assertEqual((self.stub_dir / "received-git-token").read_text().strip(), GIT_TOKEN)
        for entry in self.jsonl("login.log"):
            self.assertTrue(entry["token_ok"], entry["command"])
            self.assertEqual(entry["token_mode"], "0o600")
            env = {k: v for k, v in entry["env"].items() if k != "STUB_PASSWORD"}   # the stub's own configuration, not a value the switchboard passed
            self.assertNoSecret(json.dumps(entry["argv"]), json.dumps(env))           # no argument, no environment of the launcher
        for entry in self.jsonl("kubectl.log"):
            env = {k: v for k, v in entry.get("env", {}).items() if k != "STUB_PASSWORD"}
            self.assertNoSecret(json.dumps(entry["args"]), json.dumps(env))
            self.assertFalse(entry.get("config_text_has_token"))                          # the kubeconfig holds a path only
        self.assertEqual(len(list((self.state / "cloud").glob("*.json"))), 1)
        self.assertNoSecret(out, err)
        for where, text in self.everything_written().items():
            self.assertNoSecret(text, where=where)
        self.assertNothingKept()
        self.assertIn("create", [c[0] for c in self.stub_calls()])
        self.assertTrue(any("model-auth=" in a for a in self.stub_calls()[0]))

    def test_s2_send_read_and_status_each_open_and_close_their_own_tunnel(self):
        baseline = self.main("status")[0]   # the base status reflects the daemon and herdr (absent here); a cloud worker adds no failure of its own
        self.assertEqual(self.launch()[0], 0)
        for argv in (("send", "coder7", "hi"), ("read", "coder7"), ("status",)):
            before = len([e for e in self.jsonl("kubectl.log") if "port-forward" in e["args"]])
            code, out, err = self.main(*argv)
            self.assertEqual(code, baseline if argv[0] == "status" else 0, err)
            after = [e for e in self.jsonl("kubectl.log") if "port-forward" in e["args"]]
            self.assertEqual(len(after), before + 1, argv)
            self.assertEqual(self.pf_alive(), [], argv)
            self.assertNothingKept()
        self.assertIn("answers", self.main("status")[1])

    def test_s3_retire_normal_and_a_failing_end_hook(self):
        self.assertEqual(self.launch()[0], 0)
        with mock.patch.dict(os.environ, {"STUB_STOP_EXIT": "1"}):
            code, out, err = self.main("retire", "coder7")
        self.assertEqual(code, 1)
        self.assertIn("pod kept", out)
        self.assertTrue((self.state / "cloud" / "coder7.json").exists())
        self.assertNothingKept()
        code, out, err = self.main("retire", "coder7")
        self.assertEqual(code, 0, err)
        self.assertEqual([p.name for p in (self.state / "cloud").iterdir()], [])
        self.assertNothingKept()
        self.assertNoSecret(out, err)

    def test_s4_each_operation_mints_its_own_token_and_keeps_none(self):
        self.assertEqual(self.launch()[0], 0)
        self.assertEqual(self.main("read", "coder7")[0], 0)
        self.assertEqual(self.main("retire", "coder7")[0], 0)
        mints = [e for e in self.jsonl("kubectl.log") if "token" in e["args"]]
        self.assertEqual(len(mints), 3)
        for entry in mints:
            self.assertTrue(entry["admin_ok"])
            self.assertTrue(entry["kubeconfig_is_dev_fd"])      # the administrator credential reached kubectl on a pipe, not a file
            self.assertIn("--duration=20m", entry["args"])
        self.assertNothingKept()

    def test_s4_a_token_that_lives_over_an_hour_is_refused(self):
        (self.stub_dir / "mint_token").write_text(make_jwt(7200))
        code, out, err = self.launch()
        self.assertEqual(code, 2)
        self.assertEqual(self.stub_calls(), [])
        self.assertEqual([e for e in self.jsonl("kubectl.log") if "port-forward" in e["args"]], [])
        self.assertNothingKept()
        with mock.patch.dict(os.environ, {"CW_CLUSTER_TOKEN_DURATION": "2h"}):
            self.assertEqual(self.launch()[0], 2)

    def test_s4_a_custom_token_command_is_used_and_a_plain_token_is_trusted(self):
        with mock.patch.dict(os.environ, {"CW_CLUSTER_TOKEN_CMD": "cat %s" % (self.stub_dir / "mint_token")}):
            self.assertEqual(self.launch()[0], 0)
        self.assertEqual([e for e in self.jsonl("kubectl.log") if "token" in e["args"]], [])   # no mint: the command answered

    def test_s5_an_unreachable_vault_is_a_refusal_with_no_cluster_call_and_no_fallback(self):
        (self.stub_dir / "vault_down").write_text("")
        for extra in ({}, {"CW_KUBE_CONTEXT": "some-context"}):
            with mock.patch.dict(os.environ, extra):
                code, out, err = self.launch()
            self.assertEqual(code, 2)
            self.assertIn("vault pre-check", err)
            self.assertEqual(self.stub_calls(), [])
            self.assertEqual(self.jsonl("kubectl.log"), [])
        (self.stub_dir / "vault_down").unlink()
        with mock.patch.dict(os.environ, {"CW_VAULT_NAME": ""}):
            code, out, err = self.launch()
        self.assertEqual(code, 2)
        self.assertIn("vault pre-check", err)
        self.assertEqual(self.jsonl("kubectl.log"), [])
        self.assertNothingKept()

    def test_s5_retire_and_read_with_the_vault_down_make_no_call_and_keep_the_record(self):
        self.assertEqual(self.launch()[0], 0)
        calls, kube = len(self.stub_calls()), len(self.jsonl("kubectl.log"))
        (self.stub_dir / "vault_down").write_text("")
        for argv in (("retire", "coder7"), ("read", "coder7"), ("send", "coder7", "x")):
            code, out, err = self.main(*argv)
            self.assertEqual(code, 2, argv)
            self.assertIn("vault pre-check", err)
        self.assertEqual((len(self.stub_calls()), len(self.jsonl("kubectl.log"))), (calls, kube))
        self.assertTrue((self.state / "cloud" / "coder7.json").exists())

    def test_s6_only_a_listed_repository_and_never_the_tooling_one(self):
        for env in ({"CW_ALLOWED_REPOS": "acme-org/other"}, {"CW_ALLOWED_REPOS": ""}, {"CW_ALLOWED_REPOS": "acme-org/widget-service", "CW_TOOLING_REPO": "acme-org/widget-service"},
                    {"CW_ALLOWED_REPOS": "acme-org/*"}):
            with mock.patch.dict(os.environ, env):
                code, out, err = self.launch()
            self.assertEqual(code, 2, env)
            self.assertEqual(self.stub_calls(), [])
            self.assertEqual(self.jsonl("kubectl.log"), [])
            self.assertFalse((self.stub_dir / "received-git-token").exists())
        self.assertEqual(self.leftovers(), [])

    def test_u2_failures_never_echo_a_planted_secret(self):
        with mock.patch.dict(os.environ, {"STUB_CREATE_FAIL": "1"}):
            code, out, err = self.launch()
        self.assertEqual(code, 1)
        self.assertIn("not created", err)
        self.assertNoSecret(out, err)
        for where, text in self.everything_written().items():
            self.assertNoSecret(text, where=where)
        self.assertEqual(self.launch()[0], 0)
        (self.stub_dir / "pf_die").write_text("")
        for argv in (("send", "coder7", "hi"), ("read", "coder7")):
            code, out, err = self.main(*argv)
            self.assertNotEqual(code, 0)
            self.assertIn("did not open", err)
            self.assertNoSecret(out, err)
        self.assertNothingKept()

    def test_u2_a_launch_that_dies_at_the_tunnel_stops_the_pod_and_says_nothing_secret(self):
        (self.stub_dir / "pf_die").write_text("")
        code, out, err = self.launch()
        self.assertEqual(code, 1)
        self.assertIn("stop", [c[0] for c in self.stub_calls()])
        self.assertFalse((self.state / "cloud" / "coder7.json").exists())
        self.assertNoSecret(out, err)
        self.assertNothingKept()

    def test_u3_the_token_directory_is_gone_after_every_ending(self):
        self.assertEqual(self.launch()[0], 0)
        with mock.patch.object(sb, "gates_caller_kind", side_effect=KeyboardInterrupt):
            with self.assertRaises(KeyboardInterrupt):
                self.main("send", "coder7", "hi")
        self.assertNothingKept()
        with mock.patch.dict(os.environ, {"STUB_STOP_EXIT": "1"}):
            self.main("retire", "coder7")
        self.assertNothingKept()

    def _signalled(self, signum):
        self.assertEqual(self.launch()[0], 0)
        (self.stub_dir / "pf_hang").write_text("")
        before = len((self.stub_dir / "pf.pid").read_text().split())
        env = dict(os.environ, FLEET_SWITCHBOARD_UNDER_TEST="1")
        child = subprocess.Popen([sys.executable, str(BIN / "fleet-switchboard"), "read", "coder7"], env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        deadline = time.time() + 60
        while time.time() < deadline and len((self.stub_dir / "pf.pid").read_text().split()) == before and child.poll() is None:
            time.sleep(0.1)
        self.assertTrue(self.root.exists() and any(self.root.iterdir()), "the command is not yet at its tunnel")
        child.send_signal(signum)
        out, err = child.communicate(timeout=60)
        self.assertNotEqual(child.returncode, 0)
        self.assertEqual(self.leftovers(), [])
        self.assertEqual(self.pf_alive(), [])
        self.assertNoSecret(out, err)

    def test_u3_sigint_ends_clean(self):
        self._signalled(signal.SIGINT)

    def test_u3_sigterm_ends_clean(self):
        self._signalled(signal.SIGTERM)

    def test_u3_a_killed_command_leaves_a_directory_that_the_next_command_sweeps(self):
        self.assertEqual(self.launch()[0], 0)
        self.root.mkdir(mode=0o700, exist_ok=True)
        dead = subprocess.Popen([sys.executable, "-c", "pass"])
        dead.wait()
        stale = self.root / ("cmd-%d-abcd1234" % dead.pid)
        stale.mkdir(mode=0o700)
        (stale / "token").write_text(CLUSTER_TOKEN)
        alive = self.root / ("cmd-%d-live0001" % os.getpid())   # a running command's own directory stays
        alive.mkdir(mode=0o700)
        other = self.root / "not-ours"
        other.mkdir(mode=0o700)
        code, out, err = self.main("read", "coder7")
        self.assertEqual(code, 0, err)
        self.assertFalse(stale.exists())
        self.assertTrue(alive.exists() and other.exists())
        self.assertEqual(err.count("leftover cluster-token directory"), 1)
        self.assertNoSecret(out, err)

    def test_u3_an_old_directory_of_a_reused_pid_is_swept_by_age(self):
        self.root.mkdir(mode=0o700, exist_ok=True)
        old = self.root / ("cmd-%d-oldone01" % os.getpid())
        old.mkdir(mode=0o700)
        ancient = time.time() - 7200
        os.utime(str(old), (ancient, ancient))
        self.assertEqual(self.launch()[0], 0)
        self.assertFalse(old.exists())

    def test_g_a_link_a_wrong_mode_or_an_existing_file_is_refused(self):
        elsewhere = self.home / "elsewhere"
        elsewhere.mkdir()
        os.symlink(str(elsewhere), str(self.root))
        code, out, err = self.launch()
        self.assertEqual(code, 2)
        self.assertEqual(list(elsewhere.iterdir()), [])
        self.assertEqual(self.stub_calls(), [])
        os.unlink(str(self.root))
        self.root.mkdir(mode=0o700)
        os.chmod(str(self.root), 0o755)
        code, out, err = self.launch()
        self.assertEqual(code, 2)
        self.assertEqual(self.stub_calls(), [])
        os.chmod(str(self.root), 0o700)
        real_open = os.open
        def exists(path, flags, *args, **kwargs):
            if str(path).endswith("/token"):
                raise FileExistsError(17, "File exists")
            return real_open(path, flags, *args, **kwargs)
        with mock.patch("os.open", exists):
            code, out, err = self.launch()
        self.assertEqual(code, 2)
        self.assertEqual(self.leftovers(), [])
        self.assertEqual(self.stub_calls(), [])

    def test_g_a_full_disk_leaves_no_partial_token(self):
        with mock.patch("os.fdopen", side_effect=OSError(28, "No space left on device")):
            code, out, err = self.launch()
        self.assertEqual(code, 2)
        self.assertEqual(self.leftovers(), [])
        self.assertEqual(self.stub_calls(), [])

    def test_g_a_port_taken_by_another_process_is_never_trusted(self):
        """The readiness is kubectl's own word that it forwards on THIS port; a stranger that answers there gets nothing (no password)."""
        self.assertEqual(self.launch()[0], 0)
        stranger = FakeRemote("someone-else")
        self.addCleanup(stranger.close)
        (self.stub_dir / "pf_squat").write_text("")   # kubectl never says it forwards
        with mock.patch.dict(os.environ, {"CW_TUNNEL_TIMEOUT": "2"}):
            before = len(self.remote.requests)
            code, out, err = self.main("read", "coder7")
        self.assertEqual(code, 1)
        self.assertIn("did not open", err)
        self.assertEqual(len(self.remote.requests), before)
        self.assertNothingKept()

    def test_g_two_commands_at_once_have_their_own_directories(self):
        module = sb.load_module("cloud_worker").bind(vars(sb))
        with module.Cluster() as first, module.Cluster() as second:
            self.assertNotEqual(first.dir, second.dir)
            self.assertTrue(os.path.exists(first.token_file) and os.path.exists(second.token_file))
            self.assertEqual(oct(os.stat(first.dir).st_mode & 0o777), "0o700")
        self.assertEqual(self.leftovers(), [])

    def test_g_kubectl_that_exits_at_start_is_an_error_not_a_hang(self):
        self.assertEqual(self.launch()[0], 0)
        (self.stub_dir / "pf_die").write_text("")
        code, out, err = self.main("read", "coder7")
        self.assertEqual(code, 1)
        self.assertNothingKept()

    def test_the_old_driver_environment_is_not_inherited_by_the_launcher(self):
        with mock.patch.dict(os.environ, {"CW_KUBE_CONTEXT": "x", "CW_KUBECONFIG": "/nonexistent", "CW_CLUSTER_TOKEN_CMD": ""}):
            self.assertEqual(self.launch()[0], 0)
        for entry in self.jsonl("login.log"):
            self.assertNotIn("CW_KUBE_CONTEXT", entry["env"])
            self.assertNotIn("CW_KUBECONFIG", entry["env"])


class TestSignalsAndOrphans(Base):
    """#640 review M1: every signal that ends a command leaves no token directory and no tunnel; a SIGKILL leftover is cleaned by the next command."""
    assertNothingKept = TestWiring.assertNothingKept
    assertNoSecret = TestWiring.assertNoSecret
    forms = TestWiring.forms
    PLANTED = TestWiring.PLANTED
    _signalled = TestWiring._signalled

    def test_signal_table_leaves_no_directory_and_no_tunnel(self):
        for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP, signal.SIGQUIT):
            with self.subTest(signal=signal.Signals(signum).name):
                (self.stub_dir / "pf_hang").unlink(missing_ok=True)
                for leftover in (self.state / "cloud").glob("coder7.*"):
                    leftover.unlink()
                self._signalled(signum)

    def _killed_command(self, launch=True):
        if launch:
            self.assertEqual(self.launch()[0], 0)
        (self.stub_dir / "pf_hang").write_text("")
        before = len((self.stub_dir / "pf.pid").read_text().split())
        env = dict(os.environ, FLEET_SWITCHBOARD_UNDER_TEST="1")
        child = subprocess.Popen([sys.executable, str(BIN / "fleet-switchboard"), "read", "coder7"], env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        deadline = time.time() + 60
        while time.time() < deadline and len((self.stub_dir / "pf.pid").read_text().split()) == before:
            time.sleep(0.1)
        notes = []
        while time.time() < deadline and not notes:
            notes = list(self.root.glob("cmd-*/tunnel-*.pid"))
            time.sleep(0.1)
        self.assertTrue(notes, "the tunnel was not recorded")
        child.kill()
        child.communicate(timeout=60)
        (self.stub_dir / "pf_hang").unlink()
        return notes[0]

    def test_a_sigkilled_command_leaves_a_tunnel_that_the_next_command_stops(self):
        self._killed_command()
        self.addCleanup(lambda: [os.kill(int(p), signal.SIGKILL) for p in self.pf_alive()])
        self.assertEqual(len(self.pf_alive()), 1)   # the orphan
        self.assertEqual(len(list(self.root.glob("cmd-*"))), 1)
        code, out, err = self.main("read", "coder7")
        self.assertEqual(code, 0, err)
        self.assertIn("stopped 1 tunnel", err)
        self.assertEqual(self.pf_alive(), [])
        self.assertEqual(self.leftovers(), [])

    def test_a_recorded_pid_that_was_reused_is_not_signalled(self):
        other = subprocess.Popen(["sleep", "300"])
        self.addCleanup(other.kill)
        started = sb.load_module("cloud_worker")._ps(other.pid, "lstart")
        self.assertEqual(self.launch()[0], 0)
        for text in ("%d %s" % (other.pid, started), "%d Thu Jan  1 00:00:00 1970" % other.pid):   # not a port-forward / not that start time
            note = self._killed_command(launch=False)
            note.write_text(text)
            os.chmod(str(note), 0o600)
            code, out, err = self.main("read", "coder7")
            self.assertEqual(code, 0, err)
            self.assertIsNone(other.poll(), "a reused pid was signalled")
            self.assertEqual(self.leftovers(), [])
            for orphan in self.pf_alive():   # the real orphan's record was replaced, so it is not ours to find: clean it up here
                os.kill(int(orphan), signal.SIGKILL)


LAUNCHER_REFERENCE = r'''_OWNER_RE = re.compile(r"^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$")
_NAME_RE = re.compile(r"^[A-Za-z0-9_.-]{1,100}$")


def _repo_key(text):
    """OWNER/NAME lower-cased, or None when it is not exactly that shape (no wildcard, space, newline, dot segment, trailing .git or extra slash). It compares spellings: a renamed or transferred repository is not matched."""
    owner, sep, name = (text or "").partition("/")
    if not sep or not _OWNER_RE.fullmatch(owner) or not _NAME_RE.fullmatch(name) or set(name) == {"."} or name.lower().endswith(".git"):
        return None
    return (owner + "/" + name).lower()


def check_repo_allowed(repo, env):
    """The one allow-list check (the launcher's create and the driver both call it). Raises CloudError(EXIT_USAGE) before anything is
    made. CW_ALLOWED_REPOS: comma-separated OWNER/NAME, exact and case-insensitive; unset, empty or any malformed entry refuses.
    CW_TOOLING_REPO: the tooling's own repository, refused even when listed; unset adds no check, malformed refuses."""
    raw = (env.get("CW_ALLOWED_REPOS") or "").strip()
    if not raw:
        raise CloudError("refused: %s is not on the cloud allow-list (CW_ALLOWED_REPOS is unset or empty)" % scrub(repo, (), 120), EXIT_USAGE)
    allowed = [_repo_key(x.strip()) for x in raw.split(",")]
    if None in allowed:
        raise CloudError("refused: CW_ALLOWED_REPOS has an entry that is not OWNER/NAME; nothing was created", EXIT_USAGE)
    tooling = (env.get("CW_TOOLING_REPO") or "").strip()
    tkey = _repo_key(tooling) if tooling else None
    if tooling and tkey is None:
        raise CloudError("refused: CW_TOOLING_REPO is not OWNER/NAME; nothing was created", EXIT_USAGE)
    key = _repo_key(repo)
    if key is None or key not in allowed or key == tkey:
        raise CloudError("refused: %s is not on the cloud allow-list" % scrub(repo, (), 120), EXIT_USAGE)
'''


class TestSameAllowList(unittest.TestCase):
    """#640 review M2: this program's check and the launcher's `check_repo_allowed` give the SAME answer for the same inputs."""

    @staticmethod
    def references():
        """The launcher's check, as modules: the copy kept below (a verbatim copy of #659's functions, so this test never depends on git state or on
        whether #659 is in the base yet), and the launcher in the tree once it has `check_repo_allowed` (then a drift of the tree fails here too)."""
        found = []
        scaffold = ("import re\nEXIT_USAGE = 2\nclass CloudError(Exception):\n    def __init__(self, message, code=1):\n        super().__init__(message)\n"
                    "def scrub(text, known, limit):\n    return str(text)[:limit]\n")
        module = importlib.util.module_from_spec(importlib.util.spec_from_loader("cw_launcher_ref", loader=None))
        exec(compile(scaffold + LAUNCHER_REFERENCE, "launcher-reference", "exec"), module.__dict__)
        found.append(module)
        path = BIN.parent / "cloud" / "launcher" / "cloud_worker.py"
        if path.exists() and "def check_repo_allowed" in path.read_text():
            spec = importlib.util.spec_from_file_location("cw_launcher_tree", str(path))
            tree = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(tree)
            found.append(tree)
        return found

    CASES = [
        ("acme-org/widget-service", "acme-org/widget-service", None), ("acme-org/Widget-Service", "acme-org/widget-service", None),
        ("ACME-ORG/WIDGET-SERVICE", "acme-org/widget-service", None), ("acme-org/widget-service", "ACME-ORG/Widget-Service", None),
        ("acme-org/widget-service", "", None), ("acme-org/widget-service", None, None), ("acme-org/widget-service", "   ", None),
        ("acme-org/widget-service", "acme-org/widget-service,acme-org/other", None), ("acme-org/other", "acme-org/widget-service, acme-org/other", None),
        ("acme-org/other", "acme-org/widget-service acme-org/other", None), ("acme-org/other", "acme-org/widget-service,\tacme-org/other", None),
        ("acme-org/widget-service", "acme-org/widget-service,", None), ("acme-org/widget-service", ",acme-org/widget-service", None),
        ("acme-org/widget-service", "acme-org/widget-service,,acme-org/other", None), ("acme-org/widget-service", "acme-org/widget-service,bogus", None),
        ("acme-org/widget-service", "acme-org/*", None), ("acme-org/widget-service", "*", None), ("acme-org/widget-service", "acme-org/", None),
        ("acme-org/widget-service", "/widget-service", None), ("acme-org/widget-service", "acme-org/widget-service/extra", None),
        ("acme-org/widget-service\n", "acme-org/widget-service", None), ("acme-org/widget-service", "acme-org/widget-service\n", None),
        ("acme-org/widget-service", "acme-org/widget-service\nacme-org/other", None), ("acme-org/..", "acme-org/..", None),
        ("acme-org/.", "acme-org/.", None), ("acme-org/.hidden", "acme-org/.hidden", None), ("-acme/widget", "-acme/widget", None),
        ("acme_org/widget", "acme_org/widget", None), ("acme/w", "acme/w", None), ("acme-org/widget-service", "acme-org/widget-service", "acme-org/widget-service"),
        ("acme-org/widget-service", "acme-org/widget-service", "ACME-ORG/Widget-Service"), ("acme-org/widget-service", "acme-org/widget-service", "acme-org/tooling"),
        ("acme-org/tooling", "acme-org/widget-service,acme-org/tooling", "acme-org/tooling"), ("acme-org/widget-service", "acme-org/widget-service", "not a repo"),
        ("acme-org/widget-service", "acme-org/widget-service", "   "), ("acme-org/widget-service", "acme-org/widget-service", ""),
        ("acme-org/widget-service", "acme-org/widget-service", "acme-org/tooling\n"), ("", "acme-org/widget-service", None), (None, "acme-org/widget-service", None),
        ("acme-org/wid\u212aget", "acme-org/wid\u212aget", None), ("ac\u212ae/widget", "ac\u212ae/widget", None),
        ("a" * 40 + "/widget", "a" * 40 + "/widget", None), ("a" * 39 + "/widget", "a" * 39 + "/widget", None), ("acme-org/" + "w" * 101, "acme-org/" + "w" * 101, None),
        ("acme-org/" + "w" * 100, "acme-org/" + "w" * 100, None),
    ]

    def test_both_functions_answer_alike_over_the_same_inputs(self):
        mine = sb.load_module("cloud_worker").bind(sb.__dict__)
        self.assertGreaterEqual(len(self.CASES), 40)
        for ref in self.references():
            for repo, allowed, tooling in self.CASES:
                with self.subTest(repo=repo, allowed=allowed, tooling=tooling):
                    env = {k: v for k, v in (("CW_ALLOWED_REPOS", allowed), ("CW_TOOLING_REPO", tooling)) if v is not None}
                    answers = []
                    for function in (lambda: ref.check_repo_allowed(repo, env), lambda: mine.check_allowed(repo, env)):
                        try:
                            function()
                            answers.append("allowed")
                        except (ref.CloudError, mine.CloudError):
                            answers.append("refused")
                    self.assertEqual(answers[0], answers[1], "drift: launcher %s, here %s" % (answers[0], answers[1]))


class TestNameCollision(Base):
    """#640 review M3: one name never means both a local agent and a cloud worker, so send, read and retire cannot reach the wrong one."""

    def test_a_cloud_launch_of_a_name_that_a_local_agent_has_is_refused(self):
        seen = mock.Mock(session_id="ses_example")
        with mock.patch.object(sb.Switchboard, "discover", return_value=mock.Mock(agents={"coder7": seen}, problems=[])):
            code, out, err = self.launch()
        self.assertEqual(code, 1)
        self.assertIn("a local fleet agent named coder7 exists", err)
        self.assertEqual(self.stub_calls(), [])   # nothing was created, nothing minted
        self.assertFalse((self.state / "cloud" / "coder7.json").exists())

    def test_a_local_launch_of_a_name_that_has_a_cloud_record_is_refused(self):
        self.assertEqual(self.launch()[0], 0)
        brief = self.home / "b.txt"
        brief.write_text("x\n")
        with mock.patch.object(sb, "build_engine", side_effect=AssertionError("the refusal comes first")):
            code, out, err = self.main("launch", "coder7", "--agent", "coder", "--dir", str(self.home), "--workspace", "w1", "--brief-file", str(brief))
        self.assertEqual(code, 1)
        self.assertIn("a cloud worker named coder7 exists", err)

    def test_the_cloud_record_is_the_only_route_so_the_other_kind_cannot_be_made(self):
        self.assertEqual(self.launch()[0], 0)
        self.assertEqual(sb.load_module("cloud_worker").bind(sb.__dict__).route("coder7")["worker"], "coder7")
        code, out, err = self.launch()   # and a second cloud worker of that name is refused too
        self.assertEqual(code, 1)
        self.assertIn("already exists", err)


class TestStopAndStatus(Base):
    """#640 review Lows: a launch's stop carries the run id; status mints no token for a worker that has ended."""

    def test_a_cut_launch_stops_with_the_run_id_of_its_own_create(self):
        (self.stub_dir / "pf_die").write_text("")
        self.assertEqual(self.launch()[0], 1)
        calls = [c for c in self.stub_calls() if c[0] in ("create", "stop")]
        create, stop = calls[0], calls[-1]
        self.assertEqual(stop[0], "stop")
        run_id = create[create.index("--run-id") + 1]
        self.assertRegex(run_id, r"^[0-9a-f]{32}$")
        self.assertEqual(stop[stop.index("--run-id") + 1], run_id)
        logs = [p for p in self.state.rglob("*") if p.is_file() and p.suffix != ".password"]
        audit = [l for p in logs for l in p.read_text(errors="replace").splitlines() if "cloud.stopped" in l]
        self.assertTrue(audit, "no cloud.stopped audit line")
        self.assertTrue(all(run_id not in l and "run-id" in l for l in audit))   # the line names a short id, not the nonce itself

    def test_a_launcher_whose_stop_takes_no_run_id_is_stopped_by_name_and_the_audit_says_so(self):
        text = self.stub.read_text().replace('elif command == "stop":', 'elif command == "stop":\n    if "--run-id" in argv:\n        sys.stderr.write("error: unrecognized arguments: --run-id\\n")\n        sys.exit(2)')
        self.stub.write_text(text)
        (self.stub_dir / "pf_die").write_text("")
        self.assertEqual(self.launch()[0], 1)
        stops = [c for c in self.stub_calls() if c[0] == "stop"]
        self.assertEqual(len(stops), 2)
        self.assertNotIn("--run-id", stops[1])
        logs = [p for p in self.state.rglob("*") if p.is_file() and p.suffix != ".password"]
        self.assertTrue(any("stopped_by" in l and "name" in l for p in logs for l in p.read_text(errors="replace").splitlines() if "cloud.stopped" in l))

    def test_a_second_launch_of_a_name_that_is_being_launched_is_refused(self):
        cloud = self.state / "cloud"
        self.main("status")   # makes the private state directory
        os.makedirs(str(cloud), mode=0o700, exist_ok=True)
        import fcntl
        held = open(str(cloud / "coder7.launching"), "w")   # another live command of this user is launching that name right now: it holds the lock
        self.addCleanup(held.close)
        fcntl.flock(held, fcntl.LOCK_EX)
        code, out, err = self.launch()
        self.assertEqual(code, 1)
        self.assertIn("being launched", err)
        self.assertEqual(self.stub_calls(), [])
        brief = self.home / "b.txt"
        brief.write_text("x\n")
        code, out, err = self.main("launch", "coder7", "--agent", "coder", "--dir", str(self.home), "--workspace", "w1", "--brief-file", str(brief))
        self.assertEqual(code, 1)
        self.assertIn("being launched", err)

    def test_a_leftover_reservation_file_that_nobody_holds_does_not_hold_the_name(self):
        self.main("status")   # makes the private state directory
        cloud = self.state / "cloud"
        os.makedirs(str(cloud), mode=0o700, exist_ok=True)
        (cloud / "coder7.launching").write_text("")   # empty, or from a killed command: nothing holds its lock
        self.assertEqual(self.launch()[0], 0)
        self.assertEqual(self.launch()[0], 1)   # the second is refused for the record, and the reservation was released
        self.assertFalse(sb.load_module("cloud_worker").bind(sb.__dict__)._reserved("coder7"))

    def test_status_mints_no_token_for_a_worker_past_its_hard_deadline(self):
        self.assertEqual(self.launch()[0], 0)
        path = self.state / "cloud" / "coder7.json"
        record = json.loads(path.read_text())
        record["hard_deadline"] = "2000-01-01T00:00:00Z"
        path.write_text(json.dumps(record))
        os.chmod(str(path), 0o600)
        mints = lambda: len([c for c in self.jsonl("kubectl.log") if "token" in c["args"] and "create" in c["args"]])
        before = mints()
        code, out, err = self.main("status")
        self.assertIn("past its hard deadline", out + err)
        self.assertEqual(mints(), before)


if __name__ == "__main__":
    result = unittest.main(exit=False, verbosity=1).result
    print("RESULT: %s" % ("PASS" if result.wasSuccessful() else "FAIL"))
    sys.exit(0 if result.wasSuccessful() else 1)
