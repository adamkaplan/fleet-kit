                code, out, err = self.launch()
            self.assertEqual(code, 2)
            self.assertIn("vault pre-check", err)
            self.assertEqual(self.stub_calls(), [])
            self.assertEqual(self.jsonl("kubectl.log"), [])
        (self.stub_dir / "vault_down").unlink()
        with mock.patch.dict(os.environ, {"CW_VAULT_NAME": ""}):
            code, out, err = self.launch()
        self.assertEqual(code, 2)
        self.assertIn("vault pre-check", err)
        self.assertEqual(self.jsonl("kubectl.log"), [])
        self.assertNothingKept()

    def test_s5_retire_and_read_with_the_vault_down_make_no_call_and_keep_the_record(self):
        self.assertEqual(self.launch()[0], 0)
        calls, kube = len(self.stub_calls()), len(self.jsonl("kubectl.log"))
        (self.stub_dir / "vault_down").write_text("")
        for argv in (("retire", "coder7"), ("read", "coder7"), ("send", "coder7", "x")):
            code, out, err = self.main(*argv)
            self.assertEqual(code, 2, argv)
            self.assertIn("vault pre-check", err)
        self.assertEqual((len(self.stub_calls()), len(self.jsonl("kubectl.log"))), (calls, kube))
        self.assertTrue((self.state / "cloud" / "coder7.json").exists())

    def test_s6_only_a_listed_repository_and_never_the_tooling_one(self):
        for env in ({"CW_ALLOWED_REPOS": "acme-org/other"}, {"CW_ALLOWED_REPOS": ""}, {"CW_ALLOWED_REPOS": "acme-org/widget-service", "CW_TOOLING_REPO": "acme-org/widget-service"},
                    {"CW_ALLOWED_REPOS": "acme-org/*"}):
            with mock.patch.dict(os.environ, env):
                code, out, err = self.launch()
            self.assertEqual(code, 2, env)
            self.assertEqual(self.stub_calls(), [])
            self.assertEqual(self.jsonl("kubectl.log"), [])
            self.assertFalse((self.stub_dir / "received-git-token").exists())
        self.assertEqual(self.leftovers(), [])

    def test_u2_failures_never_echo_a_planted_secret(self):
        with mock.patch.dict(os.environ, {"STUB_CREATE_FAIL": "1"}):
            code, out, err = self.launch()
        self.assertEqual(code, 1)
        self.assertIn("not created", err)
        self.assertNoSecret(out, err)
        for where, text in self.everything_written().items():
            self.assertNoSecret(text, where=where)
        self.assertEqual(self.launch()[0], 0)
        (self.stub_dir / "pf_die").write_text("")
        for argv in (("send", "coder7", "hi"), ("read", "coder7")):
            code, out, err = self.main(*argv)
            self.assertNotEqual(code, 0)
            self.assertIn("did not open", err)
            self.assertNoSecret(out, err)
        self.assertNothingKept()

    def test_u2_a_launch_that_dies_at_the_tunnel_stops_the_pod_and_says_nothing_secret(self):
        (self.stub_dir / "pf_die").write_text("")
        code, out, err = self.launch()
        self.assertEqual(code, 1)
        self.assertIn("stop", [c[0] for c in self.stub_calls()])
        self.assertFalse((self.state / "cloud" / "coder7.json").exists())
        self.assertNoSecret(out, err)
        self.assertNothingKept()

    def test_u3_the_token_directory_is_gone_after_every_ending(self):
        self.assertEqual(self.launch()[0], 0)
        with mock.patch.object(sb, "gates_caller_kind", side_effect=KeyboardInterrupt):
            with self.assertRaises(KeyboardInterrupt):
                self.main("send", "coder7", "hi")
        self.assertNothingKept()
        with mock.patch.dict(os.environ, {"STUB_STOP_EXIT": "1"}):
            self.main("retire", "coder7")
        self.assertNothingKept()

    def test_u3_a_signal_right_after_the_tunnel_spawn_still_stops_the_tunnel(self):
        """Deterministic: the signal is raised the moment the real spawn returns, before the tunnel could be registered."""
        self.assertEqual(self.launch()[0], 0)
        (self.stub_dir / "pf_hang").write_text("")
        spawned, in_spawn, real = [], [], subprocess.Popen

        def spawn_then_signal(*args, **kwargs):
            child = real(*args, **kwargs)
            if "port-forward" in args[0]:
                spawned.append(child)
                try:
                    signal.pthread_kill(threading.get_ident(), signal.SIGINT)   # at this thread: a process-wide signal may land on another one
                    time.sleep(0.2)   # a handler that may run now runs now
                except KeyboardInterrupt:
                    in_spawn.append(True)   # delivered before the tunnel was registered: the handler could not stop it
                    raise
            return child
        with mock.patch.object(subprocess, "Popen", spawn_then_signal):
            with self.assertRaises(KeyboardInterrupt):
                self.main("read", "coder7")
        self.assertEqual(in_spawn, [], "the signal was delivered between the spawn and the registration of the tunnel")
        self.assertEqual(len(spawned), 1)
        deadline = time.time() + 20
        while spawned[0].poll() is None and time.time() < deadline:
            time.sleep(0.05)
        self.assertIsNotNone(spawned[0].poll(), "the tunnel was left running")
        spawned[0].poll()
        self.assertEqual(self.leftovers(), [])

    def _signalled(self, signum):
        self.assertEqual(self.launch()[0], 0)
        (self.stub_dir / "pf_hang").write_text("")
        before = len((self.stub_dir / "pf.pid").read_text().split())
        env = dict(os.environ, FLEET_SWITCHBOARD_UNDER_TEST="1")
        child = stub_support.start(self, [sys.executable, str(BIN / "fleet-switchboard"), "read", "coder7"], env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        deadline = time.time() + 60
        while time.time() < deadline and len((self.stub_dir / "pf.pid").read_text().split()) == before and child.poll() is None:
            time.sleep(0.1)
        self.assertTrue(self.root.exists() and any(self.root.iterdir()), "the command is not yet at its tunnel")
        child.send_signal(signum)
        out, err = child.communicate(timeout=60)
        self.assertNotEqual(child.returncode, 0)
        self.assertEqual(self.leftovers(), [])
        self.assertEqual(self.pf_alive(), [])
        self.assertNoSecret(out, err)

    def test_u3_sigint_ends_clean(self):
        self._signalled(signal.SIGINT)

    def test_u3_sigterm_ends_clean(self):
        self._signalled(signal.SIGTERM)

    def test_u3_a_killed_command_leaves_a_directory_that_the_next_command_sweeps(self):
        self.assertEqual(self.launch()[0], 0)
        self.root.mkdir(mode=0o700, exist_ok=True)
        dead = stub_support.start(self, [sys.executable, "-c", "pass"])
        dead.wait()
        stale = self.root / ("cmd-%d-abcd1234" % dead.pid)
        stale.mkdir(mode=0o700)
        (stale / "token").write_text(CLUSTER_TOKEN)
        alive = self.root / ("cmd-%d-live0001" % os.getpid())   # a running command's own directory stays
        alive.mkdir(mode=0o700)
        other = self.root / "not-ours"
        other.mkdir(mode=0o700)
        code, out, err = self.main("read", "coder7")
        self.assertEqual(code, 0, err)
        self.assertFalse(stale.exists())
        self.assertTrue(alive.exists() and other.exists())
        self.assertEqual(err.count("leftover cluster-token directory"), 1)
        self.assertNoSecret(out, err)

    def test_u3_an_old_directory_of_a_reused_pid_is_swept_by_age(self):
        self.root.mkdir(mode=0o700, exist_ok=True)
        old = self.root / ("cmd-%d-oldone01" % os.getpid())
        old.mkdir(mode=0o700)
        ancient = time.time() - 7200
        os.utime(str(old), (ancient, ancient))
        self.assertEqual(self.launch()[0], 0)
        self.assertFalse(old.exists())

    def test_g_a_link_a_wrong_mode_or_an_existing_file_is_refused(self):
        elsewhere = self.home / "elsewhere"
        elsewhere.mkdir()
        os.symlink(str(elsewhere), str(self.root))
        code, out, err = self.launch()
        self.assertEqual(code, 2)
        self.assertEqual(list(elsewhere.iterdir()), [])
        self.assertEqual(self.stub_calls(), [])
        os.unlink(str(self.root))
        self.root.mkdir(mode=0o700)
        os.chmod(str(self.root), 0o755)
        code, out, err = self.launch()
        self.assertEqual(code, 2)
        self.assertEqual(self.stub_calls(), [])
        os.chmod(str(self.root), 0o700)
        real_open = os.open
        def exists(path, flags, *args, **kwargs):
            if str(path).endswith("/token"):
                raise FileExistsError(17, "File exists")
            return real_open(path, flags, *args, **kwargs)
        with mock.patch("os.open", exists):
            code, out, err = self.launch()
        self.assertEqual(code, 2)
        self.assertEqual(self.leftovers(), [])
        self.assertEqual(self.stub_calls(), [])

    def test_g_a_full_disk_leaves_no_partial_token(self):
        with mock.patch("os.fdopen", side_effect=OSError(28, "No space left on device")):
            code, out, err = self.launch()
        self.assertEqual(code, 2)
        self.assertEqual(self.leftovers(), [])
        self.assertEqual(self.stub_calls(), [])

    def test_g_a_port_taken_by_another_process_is_never_trusted(self):
        """The readiness is kubectl's own word that it forwards on THIS port; a stranger that answers there gets nothing (no password)."""
        self.assertEqual(self.launch()[0], 0)
        stranger = FakeRemote("someone-else")
        self.addCleanup(stranger.close)
        (self.stub_dir / "pf_squat").write_text("")   # kubectl never says it forwards
        with mock.patch.dict(os.environ, {"CW_TUNNEL_TIMEOUT": "2"}):
            before = len(self.remote.requests)
            code, out, err = self.main("read", "coder7")
        self.assertEqual(code, 1)
        self.assertIn("did not open", err)
        self.assertEqual(len(self.remote.requests), before)
        self.assertNothingKept()

    def test_g_two_commands_at_once_have_their_own_directories(self):
        module = sb.load_module("cloud_worker").bind(vars(sb))
        with module.Cluster() as first, module.Cluster() as second:
            self.assertNotEqual(first.dir, second.dir)
            self.assertTrue(os.path.exists(first.token_file) and os.path.exists(second.token_file))
            self.assertEqual(oct(os.stat(first.dir).st_mode & 0o777), "0o700")
        self.assertEqual(self.leftovers(), [])

    def test_g_kubectl_that_exits_at_start_is_an_error_not_a_hang(self):
        self.assertEqual(self.launch()[0], 0)
        (self.stub_dir / "pf_die").write_text("")
        code, out, err = self.main("read", "coder7")
        self.assertEqual(code, 1)
        self.assertNothingKept()

    def test_the_old_driver_environment_is_not_inherited_by_the_launcher(self):
        with mock.patch.dict(os.environ, {"CW_KUBE_CONTEXT": "x", "CW_KUBECONFIG": "/nonexistent", "CW_CLUSTER_TOKEN_CMD": ""}):
            self.assertEqual(self.launch()[0], 0)
        for entry in self.jsonl("login.log"):
            self.assertNotIn("CW_KUBE_CONTEXT", entry["env"])
            self.assertNotIn("CW_KUBECONFIG", entry["env"])


class TestSignalsAndOrphans(Base):
    """#640 review M1: every signal that ends a command leaves no token directory and no tunnel; a SIGKILL leftover is cleaned by the next command."""
    assertNothingKept = TestWiring.assertNothingKept
    assertNoSecret = TestWiring.assertNoSecret
    forms = TestWiring.forms
    PLANTED = TestWiring.PLANTED
    _signalled = TestWiring._signalled

    def test_the_cleanup_stop_ignores_all_four_signals(self):
        ignored = []
        module = sb.load_module("cloud_worker").bind(sb.__dict__)
        old = module._ignore_signals()
        try:
            for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP, signal.SIGQUIT):
                ignored.append(signal.getsignal(sig) == signal.SIG_IGN)
        finally:
            module._restore_signals(old)
        self.assertEqual(ignored, [True] * 4)

    def test_signal_table_leaves_no_directory_and_no_tunnel(self):
        for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP, signal.SIGQUIT):
            with self.subTest(signal=signal.Signals(signum).name):
                (self.stub_dir / "pf_hang").unlink(missing_ok=True)
                for leftover in (self.state / "cloud").glob("coder7.*"):
                    leftover.unlink()
                self._signalled(signum)

    def _killed_command(self, launch=True):
        if launch:
            self.assertEqual(self.launch()[0], 0)
        (self.stub_dir / "pf_hang").write_text("")
        before = len((self.stub_dir / "pf.pid").read_text().split())
        env = dict(os.environ, FLEET_SWITCHBOARD_UNDER_TEST="1")
        child = stub_support.start(self, [sys.executable, str(BIN / "fleet-switchboard"), "read", "coder7"], env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        deadline = time.time() + 60
        while time.time() < deadline and len((self.stub_dir / "pf.pid").read_text().split()) == before:
            time.sleep(0.1)
        notes = []
        deadline = time.time() + 60
        while time.time() < deadline and not notes:
            notes = list(self.root.glob("cmd-*/tunnel-*.pid"))
            time.sleep(0.1)
        self.assertTrue(notes, "the tunnel was not recorded")
        child.kill()
        child.communicate(timeout=60)
        (self.stub_dir / "pf_hang").unlink()
        return notes[0]

    def test_a_sigkilled_command_leaves_a_tunnel_that_the_next_command_stops(self):
        self._killed_command()
        self.addCleanup(lambda: [os.kill(int(p), signal.SIGKILL) for p in self.pf_alive()])
        self.assertEqual(len(self.pf_alive()), 1)   # the orphan
        self.assertEqual(len(list(self.root.glob("cmd-*"))), 1)
        code, out, err = self.main("read", "coder7")
        self.assertEqual(code, 0, err)
        self.assertIn("stopped 1 tunnel", err)
        self.assertEqual(self.pf_alive(), [])
        self.assertEqual(self.leftovers(), [])

    def test_a_recorded_pid_that_was_reused_is_not_signalled(self):
        other = subprocess.Popen(["sleep", "300"])
        self.addCleanup(other.kill)
        started = sb.load_module("cloud_worker")._ps(other.pid, "lstart")
        self.assertEqual(self.launch()[0], 0)
        for text in ("%d %s" % (other.pid, started), "%d Thu Jan  1 00:00:00 1970" % other.pid):   # not a port-forward / not that start time
            note = self._killed_command(launch=False)
            note.write_text(text)
            os.chmod(str(note), 0o600)
            code, out, err = self.main("read", "coder7")
            self.assertEqual(code, 0, err)
            self.assertIsNone(other.poll(), "a reused pid was signalled")
            self.assertEqual(self.leftovers(), [])
            for orphan in self.pf_alive():   # the real orphan's record was replaced, so it is not ours to find: clean it up here
                os.kill(int(orphan), signal.SIGKILL)


LAUNCHER_REFERENCE = r'''_OWNER_RE = re.compile(r"^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$")
_NAME_RE = re.compile(r"^[A-Za-z0-9_.-]{1,100}$")


def _repo_key(text):
    """OWNER/NAME lower-cased, or None when it is not exactly that shape (no wildcard, space, newline, dot segment, trailing .git or extra slash). It compares spellings: a renamed or transferred repository is not matched."""
    owner, sep, name = (text or "").partition("/")
    if not sep or not _OWNER_RE.fullmatch(owner) or not _NAME_RE.fullmatch(name) or set(name) == {"."} or name.lower().endswith(".git"):
        return None
    return (owner + "/" + name).lower()


def check_repo_allowed(repo, env):
    """The one allow-list check (the launcher's create and the driver both call it). Raises CloudError(EXIT_USAGE) before anything is
    made. CW_ALLOWED_REPOS: comma-separated OWNER/NAME, exact and case-insensitive; unset, empty or any malformed entry refuses.
    CW_TOOLING_REPO: the tooling's own repository, refused even when listed; unset adds no check, malformed refuses."""
    raw = (env.get("CW_ALLOWED_REPOS") or "").strip()
    if not raw:
        raise CloudError("refused: %s is not on the cloud allow-list (CW_ALLOWED_REPOS is unset or empty)" % scrub(repo, (), 120), EXIT_USAGE)
    allowed = [_repo_key(x.strip()) for x in raw.split(",")]
    if None in allowed:
        raise CloudError("refused: CW_ALLOWED_REPOS has an entry that is not OWNER/NAME; nothing was created", EXIT_USAGE)
    tooling = (env.get("CW_TOOLING_REPO") or "").strip()
    tkey = _repo_key(tooling) if tooling else None
    if tooling and tkey is None:
        raise CloudError("refused: CW_TOOLING_REPO is not OWNER/NAME; nothing was created", EXIT_USAGE)
    key = _repo_key(repo)
    if key is None or key not in allowed or key == tkey:
        raise CloudError("refused: %s is not on the cloud allow-list" % scrub(repo, (), 120), EXIT_USAGE)
'''


class TestSameAllowList(unittest.TestCase):
    """#640 review M2: this program's check and the launcher's `check_repo_allowed` give the SAME answer for the same inputs."""

    @staticmethod
    def references():
        """The launcher's check, as modules: the copy kept below (a verbatim copy of #659's functions, so this test never depends on git state or on
        whether #659 is in the base yet), and the launcher in the tree once it has `check_repo_allowed` (then a drift of the tree fails here too)."""
        found = []
        scaffold = ("import re\nEXIT_USAGE = 2\nclass CloudError(Exception):\n    def __init__(self, message, code=1):\n        super().__init__(message)\n"
                    "def scrub(text, known, limit):\n    return str(text)[:limit]\n")
        module = importlib.util.module_from_spec(importlib.util.spec_from_loader("cw_launcher_ref", loader=None))
        exec(compile(scaffold + LAUNCHER_REFERENCE, "launcher-reference", "exec"), module.__dict__)
        found.append(module)
        path = BIN.parent / "cloud" / "launcher" / "cloud_worker.py"
        if path.exists() and "def check_repo_allowed" in path.read_text():
            spec = importlib.util.spec_from_file_location("cw_launcher_tree", str(path))
            tree = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(tree)
            found.append(tree)
        return found

    CASES = [
        ("acme-org/widget-service", "acme-org/widget-service", None), ("acme-org/Widget-Service", "acme-org/widget-service", None),
        ("ACME-ORG/WIDGET-SERVICE", "acme-org/widget-service", None), ("acme-org/widget-service", "ACME-ORG/Widget-Service", None),
        ("acme-org/widget-service", "", None), ("acme-org/widget-service", None, None), ("acme-org/widget-service", "   ", None),
        ("acme-org/widget-service", "acme-org/widget-service,acme-org/other", None), ("acme-org/other", "acme-org/widget-service, acme-org/other", None),
        ("acme-org/other", "acme-org/widget-service acme-org/other", None), ("acme-org/other", "acme-org/widget-service,\tacme-org/other", None),
        ("acme-org/widget-service", "acme-org/widget-service,", None), ("acme-org/widget-service", ",acme-org/widget-service", None),
        ("acme-org/widget-service", "acme-org/widget-service,,acme-org/other", None), ("acme-org/widget-service", "acme-org/widget-service,bogus", None),
        ("acme-org/widget-service", "acme-org/*", None), ("acme-org/widget-service", "*", None), ("acme-org/widget-service", "acme-org/", None),
        ("acme-org/widget-service", "/widget-service", None), ("acme-org/widget-service", "acme-org/widget-service/extra", None),
        ("acme-org/widget-service\n", "acme-org/widget-service", None), ("acme-org/widget-service", "acme-org/widget-service\n", None),
        ("acme-org/widget-service", "acme-org/widget-service\nacme-org/other", None), ("acme-org/..", "acme-org/..", None),
        ("acme-org/.", "acme-org/.", None), ("acme-org/.hidden", "acme-org/.hidden", None), ("-acme/widget", "-acme/widget", None),
        ("acme_org/widget", "acme_org/widget", None), ("acme/w", "acme/w", None), ("acme-org/widget-service", "acme-org/widget-service", "acme-org/widget-service"),
        ("acme-org/widget-service", "acme-org/widget-service", "ACME-ORG/Widget-Service"), ("acme-org/widget-service", "acme-org/widget-service", "acme-org/tooling"),
        ("acme-org/tooling", "acme-org/widget-service,acme-org/tooling", "acme-org/tooling"), ("acme-org/widget-service", "acme-org/widget-service", "not a repo"),
        ("acme-org/widget-service", "acme-org/widget-service", "   "), ("acme-org/widget-service", "acme-org/widget-service", ""),
        ("acme-org/widget-service", "acme-org/widget-service", "acme-org/tooling\n"), ("", "acme-org/widget-service", None), (None, "acme-org/widget-service", None),
        ("acme-org/wid\u212aget", "acme-org/wid\u212aget", None), ("ac\u212ae/widget", "ac\u212ae/widget", None),
        ("a" * 40 + "/widget", "a" * 40 + "/widget", None), ("a" * 39 + "/widget", "a" * 39 + "/widget", None), ("acme-org/" + "w" * 101, "acme-org/" + "w" * 101, None),
        ("acme-org/" + "w" * 100, "acme-org/" + "w" * 100, None),
        ("acme-org/widget.git", "acme-org/widget.git", None), ("acme-org/widget.GIT", "acme-org/widget.GIT", None), ("acme-org/widget.git", "acme-org/widget", None),
        ("acme-org/widget", "acme-org/widget,acme-org/other.git", None), ("acme-org/widget", "acme-org/widget", "acme-org/tool.git"),
        ("acme-org/widget.gitx", "acme-org/widget.gitx", None),
    ]

    def test_both_functions_answer_alike_over_the_same_inputs(self):
        mine = sb.load_module("cloud_worker").bind(sb.__dict__)
        self.assertGreaterEqual(len(self.CASES), 40)
        for ref in self.references():
            for repo, allowed, tooling in self.CASES:
                with self.subTest(repo=repo, allowed=allowed, tooling=tooling):
                    env = {k: v for k, v in (("CW_ALLOWED_REPOS", allowed), ("CW_TOOLING_REPO", tooling)) if v is not None}
                    answers = []
                    for function in (lambda: ref.check_repo_allowed(repo, env), lambda: mine.check_allowed(repo, env)):
                        try:
                            function()
                            answers.append("allowed")
                        except (ref.CloudError, mine.CloudError):
                            answers.append("refused")
                    self.assertEqual(answers[0], answers[1], "drift: launcher %s, here %s" % (answers[0], answers[1]))


class TestNameCollision(Base):
    """#640 review M3: one name never means both a local agent and a cloud worker, so send, read and retire cannot reach the wrong one."""

    def test_a_cloud_launch_of_a_name_that_a_local_agent_has_is_refused(self):
        seen = mock.Mock(session_id="ses_example")
        with mock.patch.object(sb.Switchboard, "discover", return_value=mock.Mock(agents={"coder7": seen}, problems=[])):
            code, out, err = self.launch()
        self.assertEqual(code, 1)
        self.assertIn("a local fleet agent named coder7 exists", err)
        self.assertEqual(self.stub_calls(), [])   # nothing was created, nothing minted
        self.assertFalse((self.state / "cloud" / "coder7.json").exists())

    def test_a_local_launch_of_a_name_that_has_a_cloud_record_is_refused(self):
        self.assertEqual(self.launch()[0], 0)
        brief = self.home / "b.txt"
        brief.write_text("x\n")
        with mock.patch.object(sb, "build_engine", side_effect=AssertionError("the refusal comes first")):
            code, out, err = self.main("launch", "coder7", "--agent", "coder", "--dir", str(self.home), "--workspace", "w1", "--brief-file", str(brief))
        self.assertEqual(code, 1)
        self.assertIn("a cloud worker named coder7 exists", err)

    def test_the_cloud_record_is_the_only_route_so_the_other_kind_cannot_be_made(self):
        self.assertEqual(self.launch()[0], 0)
        self.assertEqual(sb.load_module("cloud_worker").bind(sb.__dict__).route("coder7")["worker"], "coder7")
        code, out, err = self.launch()   # and a second cloud worker of that name is refused too
        self.assertEqual(code, 1)
        self.assertIn("already exists", err)


class TestLocalLaunchIsNeverBrokenByTheCloudModule(Base):
    """#640 U1: the hook in every local launch refuses only a name with a cloud record; a missing, broken or unreadable cloud side lets the launch go on."""

    def test_no_cloud_directory_means_no_refusal(self):
        self.assertIsNone(sb.refuse_cloud_name("coder7"))

    def test_a_name_with_a_record_is_refused(self):
        self.assertEqual(self.launch()[0], 0)
        with self.assertRaises(sb.LaunchError):
            sb.refuse_cloud_name("coder7")

    def test_a_missing_or_raising_cloud_module_is_fail_open(self):
        for failure in (ImportError("no module"), FileNotFoundError("gone"), RuntimeError("broken"), OSError(13, "unreadable record store")):
            with self.subTest(failure=type(failure).__name__):
                err = io.StringIO()
                with mock.patch.object(sb, "load_module", side_effect=failure), contextlib.redirect_stderr(err):
                    self.assertIsNone(sb.refuse_cloud_name("coder7"))
                self.assertIn("cloud-name check could not run (%s)" % type(failure).__name__, err.getvalue())
                self.assertNotIn("unreadable record store", err.getvalue())   # the class only, never the text

    def test_an_unreadable_record_store_is_fail_open(self):
        module = sb.load_module("cloud_worker").bind(sb.__dict__)
        err = io.StringIO()
        with mock.patch.object(module, "_reserved", side_effect=OSError(13, "unreadable")), contextlib.redirect_stderr(err):
            self.assertIsNone(sb.refuse_cloud_name("coder7"))
        self.assertIn("cloud-name check could not run (PermissionError)", err.getvalue())

    def test_a_corrupt_record_file_still_holds_its_name(self):
        """A record FILE that exists (even a corrupt one) still refuses: only a cloud side that cannot answer at all is fail-open."""
        self.assertEqual(self.launch()[0], 0)
        (self.state / "cloud" / "coder7.json").write_text("{not json")
        with self.assertRaises(sb.LaunchError):
            sb.refuse_cloud_name("coder7")


class TestStopAndStatus(Base):
    """#640 review Lows: a launch's stop carries the run id; status mints no token for a worker that has ended."""

    def test_a_cut_launch_stops_with_the_run_id_of_its_own_create(self):
        (self.stub_dir / "pf_die").write_text("")
        self.assertEqual(self.launch()[0], 1)
        calls = [c for c in self.stub_calls() if c[0] in ("create", "stop")]
        create, stop = calls[0], calls[-1]
        self.assertEqual(stop[0], "stop")
        run_id = create[create.index("--run-id") + 1]
        self.assertRegex(run_id, r"^[0-9a-f]{32}$")
        self.assertEqual(stop[stop.index("--run-id") + 1], run_id)
        logs = [p for p in self.state.rglob("*") if p.is_file() and p.suffix != ".password"]
        audit = [l for p in logs for l in p.read_text(errors="replace").splitlines() if "cloud.stopped" in l]
        self.assertTrue(audit, "no cloud.stopped audit line")
        self.assertTrue(all(run_id not in l and "run-id" in l for l in audit))   # the line names a short id, not the nonce itself

    def _second_discovery(self, second):
        first = mock.Mock(agents={}, problems=[])
        with mock.patch.object(sb.Switchboard, "discover", side_effect=[first, second]):
            return self.launch()

    def test_a_local_agent_that_appears_while_the_pod_is_made_stops_the_pod_and_keeps_no_record(self):
        code, out, err = self._second_discovery(mock.Mock(agents={"coder7": mock.Mock(session_id="ses_example")}, problems=[]))
        self.assertEqual(code, 1)
        self.assertIn("appeared while the pod was being made", err)
        self.assertIn("stop", [c[0] for c in self.stub_calls()])
        self.assertFalse((self.state / "cloud" / "coder7.json").exists())

    def test_a_second_discovery_that_raises_stops_the_pod_and_names_the_worker(self):
        code, out, err = self._second_discovery(RuntimeError("herdr exploded: secret-looking text"))
        self.assertEqual(code, 1)
        self.assertIn("coder7", err)
        self.assertIn("it was stopped", err)
        self.assertNotIn("secret-looking text", err)   # the class only
        self.assertIn("stop", [c[0] for c in self.stub_calls()])
        self.assertFalse((self.state / "cloud" / "coder7.json").exists())

    def test_a_second_discovery_that_raises_and_a_stop_that_fails_keeps_the_record_with_a_retire_hint(self):
        with mock.patch.dict(os.environ, {"STUB_STOP_EXIT": "1"}):
            code, out, err = self._second_discovery(RuntimeError("boom"))
        self.assertEqual(code, 1)
        self.assertIn("coder7", err)
        self.assertIn("retire coder7", err)
        self.assertTrue((self.state / "cloud" / "coder7.json").exists())

    def test_a_launcher_whose_stop_takes_no_run_id_is_stopped_by_name_and_the_audit_says_so(self):
        text = self.stub.read_text().replace('elif command == "stop":', 'elif command == "stop":\n    if "--run-id" in argv:\n        sys.stderr.write("error: unrecognized arguments: --run-id\\n")\n        sys.exit(2)')
        self.stub.write_text(text)
        (self.stub_dir / "pf_die").write_text("")
        self.assertEqual(self.launch()[0], 1)
        stops = [c for c in self.stub_calls() if c[0] == "stop"]
        self.assertEqual(len(stops), 2)
        self.assertNotIn("--run-id", stops[1])
        logs = [p for p in self.state.rglob("*") if p.is_file() and p.suffix != ".password"]
        self.assertTrue(any("stopped_by" in l and "name" in l for p in logs for l in p.read_text(errors="replace").splitlines() if "cloud.stopped" in l))

    def test_a_second_launch_of_a_name_that_is_being_launched_is_refused(self):
        cloud = self.state / "cloud"
        self.main("status")   # makes the private state directory
        os.makedirs(str(cloud), mode=0o700, exist_ok=True)
        import fcntl
        held = open(str(cloud / "coder7.launching"), "w")   # another live command of this user is launching that name right now: it holds the lock
        self.addCleanup(held.close)
        fcntl.flock(held, fcntl.LOCK_EX)
        code, out, err = self.launch()
        self.assertEqual(code, 1)
        self.assertIn("being launched", err)
        self.assertEqual(self.stub_calls(), [])
        brief = self.home / "b.txt"
        brief.write_text("x\n")
        code, out, err = self.main("launch", "coder7", "--agent", "coder", "--dir", str(self.home), "--workspace", "w1", "--brief-file", str(brief))
        self.assertEqual(code, 1)
        self.assertIn("being launched", err)

    def test_a_leftover_reservation_file_that_nobody_holds_does_not_hold_the_name(self):
        self.main("status")   # makes the private state directory
        cloud = self.state / "cloud"
        os.makedirs(str(cloud), mode=0o700, exist_ok=True)
        (cloud / "coder7.launching").write_text("")   # empty, or from a killed command: nothing holds its lock
        self.assertEqual(self.launch()[0], 0)
        self.assertEqual(self.launch()[0], 1)   # the second is refused for the record, and the reservation was released
        self.assertFalse(sb.load_module("cloud_worker").bind(sb.__dict__)._reserved("coder7"))

    def test_status_mints_no_token_for_a_worker_past_its_hard_deadline(self):
        self.assertEqual(self.launch()[0], 0)
        path = self.state / "cloud" / "coder7.json"
        record = json.loads(path.read_text())
        record["hard_deadline"] = "2000-01-01T00:00:00Z"
        path.write_text(json.dumps(record))
        os.chmod(str(path), 0o600)
        mints = lambda: len([c for c in self.jsonl("kubectl.log") if "token" in c["args"] and "create" in c["args"]])
        before = mints()
        code, out, err = self.main("status")
        self.assertIn("past its hard deadline", out + err)
        self.assertEqual(mints(), before)


class TestLaunchRunsThePreflight(Base):
    """#665: `launch --cloud` runs the repository preflight after the allow-list and before any token is minted (S1, S3, U1; S2 is every other launch test)."""
    @classmethod
    def setUpClass(cls):
        sys.path.insert(0, str(BIN.parent / "cloud" / "launcher" / "tests"))
        import test_preflight as tp
        cls.tp = tp
        tp.Preflight.setUpClass.__func__(cls)

    @classmethod
    def tearDownClass(cls):
        cls.tp.Preflight.tearDownClass.__func__(cls)

    def setUp(self):
        super().setUp()
        tp = self.tp
        tp.Stub.rules, tp.Stub.protected, tp.Stub.fail, tp.Stub.methods, tp.Stub.redirect = list(tp.FULL), False, None, [], None
        tp.Stub.review_count, tp.Stub.enforcement, tp.Stub.include, tp.Stub.conditions = 1, "active", ["~DEFAULT_BRANCH"], "ok"
        tp.Stub.exclude, tp.Stub.target, tp.Stub.default, tp.Stub.rule_ids, tp.Stub.extra, tp.Stub.org, tp.Stub.no_id = [], "branch", "main", {}, {}, False, False
        tp.Stub.org_code, tp.Stub.org_types, tp.Stub.fail_code, tp.Stub.org_extra, tp.Stub.org_hint = None, [], 500, [], None
        self.lib = sb.load_module("cloud_worker").bind(sb.__dict__)._lib()
        self.mint = self.home / "mint-ran"
        script = self.home / "git-token-cmd"
        script.write_text("#!/bin/sh\ntouch %s\necho ghs_synthetic\n" % self.mint)
        script.chmod(0o700)
        env = mock.patch.dict(os.environ, {"CW_GIT_TOKEN_CMD": str(script), })
        env.start()
        self.addCleanup(env.stop)

    def real_program(self):
        """The real preflight, pointed at the loopback stub through the library's test hook (never through the environment)."""
        for name, value in (("PREFLIGHT_ARGV", None), ("PREFLIGHT_TEST_ENV", {"CW_GITHUB_API_BASE": self.base, "CW_PREFLIGHT_TOKEN_CMD": "echo " + self.tp.TOKEN})):
            p = mock.patch.object(self.lib, name, value)
            p.start()
            self.addCleanup(p.stop)

    def test_a_loopback_api_base_and_token_command_in_the_callers_environment_are_ignored(self):
        self.tp.Stub.rules = list(self.tp.FULL)   # the stub would ACCEPT: it must never be asked
        with mock.patch.object(self.lib, "PREFLIGHT_ARGV", None), mock.patch.object(self.lib, "PREFLIGHT_TEST_ENV", {}), \
                mock.patch.dict(os.environ, {"CW_GITHUB_API_BASE": self.base, "CW_PREFLIGHT_TOKEN_CMD": "echo " + self.tp.TOKEN}):
            for name in ("CW_VAULT_SUBSCRIPTION", "CW_VAULT_NAME", "CW_APP_ID_CMD", "CW_APP_INSTALLATION_CMD", "CW_APP_KEY_CMD"):
                os.environ.pop(name, None)
            code, out, err = self.launch()
        self.assertEqual(code, 2, err)
        self.assertIn("did not pass", err)
        self.assertNotIn("preflight ok", out + err)
        self.assertEqual(self.tp.Stub.methods, [], "the stub was contacted")
        self.nothing_made()

    def nothing_made(self):
        self.assertFalse(self.mint.exists(), "a mint ran")
        self.assertEqual(self.stub_calls(), [], "the launcher or the cluster was called")

    def test_s1_three_of_three_refusal_kinds_mint_nothing_create_nothing_and_show_the_message(self):
        self.real_program()
        tp = self.tp
        for kind, rules, fail, message in (("protection missing", ["pull_request"], None, "missing a non_fast_forward rule"),
                                           ("unreadable answer", list(tp.FULL), "badjson", "cannot read"),
                                           ("repository not found", list(tp.FULL), "/repos/acme-org/widget-service", "cannot read")):
            with self.subTest(kind):
                tp.Stub.rules, tp.Stub.fail = rules, fail
                code, out, err = self.launch()
                self.assertEqual(code, 2, err)
                self.assertIn("did not pass", err)
                self.assertIn(message, err)
                self.assertNotIn("preflight ok", out + err)
                self.nothing_made()

    def test_s2_a_passing_preflight_prints_one_result_line(self):
        self.real_program()
        code, out, err = self.launch()
        self.assertEqual(code, 0, err)
        self.assertEqual(err.count("preflight: preflight ok"), 1, err)
        self.assertTrue(self.mint.exists())

    def test_s3_a_missing_killed_or_silent_program_refuses_with_exit_2_and_no_mint(self):
        for kind, argv in (("missing", ["/nonexistent/preflight"]), ("killed", ["sh", "-c", "kill -9 $$"]), ("empty output", ["true"]),
                           ("timed out", ["sleep", "5"]), ("non-zero, no message", ["sh", "-c", "exit 3"])):
            with self.subTest(kind), mock.patch.object(self.lib, "PREFLIGHT_ARGV", argv), mock.patch.object(self.lib, "PREFLIGHT_SECONDS", 1):
                code, out, err = self.launch()
                self.assertEqual(code, 2, err)
                self.assertIn("refused", err)
                self.nothing_made()

    def test_u1_an_off_list_repository_is_refused_before_the_preflight_is_called(self):
        mark = self.home / "pf-ran"
        os.environ["CW_ALLOWED_REPOS"] = "acme-org/other"
        with mock.patch.object(self.lib, "PREFLIGHT_ARGV", ["sh", "-c", "touch %s" % mark]):
            code, out, err = self.launch()
        self.assertEqual(code, 2, err)
        self.assertFalse(mark.exists(), "the preflight was called")
        self.nothing_made()


class TestSettingsFile(Base):
    """#876 slice 1: `launch --cloud` and the other cloud commands read ONE private settings file when it exists (S1-S5, U1, U2)."""

    DIGEST = "registry.example.internal/acme/worker@sha256:" + "cd34" * 16
    TABLE_KEYS = None

    def setUp(self):
        super().setUp()
        self.cfg = self.home / "settings"
        self.cfg.mkdir(mode=0o700)
        self.file = self.cfg / "cloud.env"
        hook = mock.patch.object(self.lib, "SETTINGS_PATH", str(self.file))
        hook.start()
        self.addCleanup(hook.stop)
        for key in self.table_keys():
            os.environ.pop(key, None)   # an EMPTY environment: every setting comes from the file
        self.values = {"CW_ALLOWED_REPOS": "acme-org/widget-service", "CW_CLOUD_IMAGE": self.DIGEST, "CW_CLOUD_SERVER": "https://cluster.example.internal:6443",
                       "CW_VAULT_SUBSCRIPTION": "00000000-0000-0000-0000-000000000000", "CW_VAULT_NAME": "vault-example", "CW_CLOUD_NAMESPACE": "cw",
                       "CW_KUBECTL": str(self.stub_dir / "kubectl"), "CW_GIT_TOKEN_CMD": "cat %s" % (self.stub_dir / "git_token"),
                       "CW_OPENCODE_BIN": FAKE_EXPORT}

    @property
    def lib(self):
        return sb.load_module("cloud_worker").bind(sb.__dict__)._lib()

    def table_keys(self):
        return [name for name, _, _ in self.lib.SETTINGS]

    def write(self, values=None, mode=0o600, text=None):
        values = self.values if values is None else values
        self.file.write_text(text if text is not None else "# settings\n" + "".join("%s=%s\n" % kv for kv in values.items()))
        self.file.chmod(mode)

    def nothing_was_called(self):
        self.assertEqual(self.stub_calls(), [])
        self.assertEqual(self.jsonl("kubectl.log"), [])
        self.assertEqual(self.jsonl("login.log"), [])

    def test_s1_a_file_with_every_setting_and_an_empty_environment_launches(self):
        self.write()
        code, out, err = self.launch()
        self.assertEqual(code, 0, err)
        create = [e for e in self.jsonl("login.log") if e["command"] == "create"][0]
        self.assertEqual(create["env"]["CW_CLOUD_IMAGE"], self.DIGEST)   # the launcher's own environment carries the file's values
        self.assertEqual(create["env"]["CW_CLOUD_NAMESPACE"], "cw")
        self.assertEqual(err.count("cloud settings from"), 1)
        self.assertIn("cloud settings from %s" % self.file, err)

    def test_s1_the_other_commands_log_in_from_the_file_too(self):
        self.write()
        self.assertEqual(self.launch()[0], 0)
        for argv in (("send", "coder7", "hi"), ("read", "coder7"), ("retire", "coder7")):
            code, out, err = self.main(*argv)
            self.assertEqual(code, 0, (argv, err))
            self.assertNotIn("cloud settings from", err)   # said once, by launch

    def test_u1_no_file_launches_as_before_and_says_environment_once(self):
        os.environ.update({"CW_ALLOWED_REPOS": "acme-org/widget-service", "CW_CLOUD_SERVER": "https://cluster.example.internal:6443",
                           "CW_KUBECTL": str(self.stub_dir / "kubectl"), "CW_VAULT_SUBSCRIPTION": "00000000-0000-0000-0000-000000000000", "CW_VAULT_NAME": "vault-example",
                           "CW_GIT_TOKEN_CMD": "cat %s" % (self.stub_dir / "git_token"), "CW_OPENCODE_BIN": FAKE_EXPORT})
        self.assertFalse(self.file.exists())
        code, out, err = self.launch()
        self.assertEqual(code, 0, err)
        self.assertEqual(err.count("cloud settings from environment"), 1)
        argv = [a for a in self.stub_calls()[0]]
        shaped = self.shaped(argv)
        expected = json.loads((BIN.parent / "cloud" / "tests" / "fixtures" / "launch-create-argv.json").read_text())
        self.assertEqual(shaped, expected)

    def test_environment_alone_needs_no_new_setting(self):
        for key in ("CW_CLOUD_IMAGE", "CW_CLOUD_NAMESPACE"):
            self.assertNotIn(key, os.environ)   # the environment route never required the image or the namespace for launch
        os.environ.update({"CW_ALLOWED_REPOS": "acme-org/widget-service", "CW_CLOUD_SERVER": "https://cluster.example.internal:6443",
                           "CW_KUBECTL": str(self.stub_dir / "kubectl"), "CW_VAULT_SUBSCRIPTION": "00000000-0000-0000-0000-000000000000", "CW_VAULT_NAME": "vault-example",
                           "CW_GIT_TOKEN_CMD": "cat %s" % (self.stub_dir / "git_token"), "CW_OPENCODE_BIN": FAKE_EXPORT})
        self.assertEqual(self.launch()[0], 0)

    def test_the_test_hook_is_not_an_environment_variable(self):
        self.write()
        with mock.patch.object(self.lib, "SETTINGS_PATH", None), mock.patch.dict(os.environ, {"FLEET_CLOUD_SETTINGS": str(self.file), "CW_CLOUD_SETTINGS": str(self.file)}):
            code, out, err = self.launch()
        self.assertIn("cloud settings from environment", err)   # the variable moved nothing
        self.assertNotEqual(code, 0)

    def test_s2_a_file_others_can_read_or_write_is_refused_before_any_call(self):
        for mode in (0o640, 0o604, 0o666, 0o644, 0o660):
            with self.subTest(mode=oct(mode)):
                self.write(mode=mode)
                code, out, err = self.launch()
                self.assertEqual(code, 2)
                self.assertIn(str(self.file), err)
                self.assertIn("%04o" % mode, err)
                self.nothing_was_called()

    def test_s2_a_symlink_a_writable_directory_and_another_owner_are_refused_before_any_call(self):
        real = self.cfg / "real.env"
        real.write_text("x\n")
        real.chmod(0o600)
        self.file.symlink_to(real)
        self.assertIn("symlink", self.launch()[2])
        self.nothing_was_called()
        self.file.unlink()
        self.write()
        self.cfg.chmod(0o770)
        try:
            self.assertIn("writable", self.launch()[2])
        finally:
            self.cfg.chmod(0o700)
        with mock.patch.object(self.lib.os, "geteuid", return_value=os.geteuid() + 1):
            self.assertIn("another user", self.launch()[2])
        self.nothing_was_called()

    def test_s3_a_secret_shaped_value_is_refused_for_every_shape_and_never_printed(self):
        lib = self.lib
        samples = {"a JWT": "eyJ" + "hbGciOiJIUzI1" + "." + "eyJ" + "zdWIiOiJ4eHh4", "a PEM header": "-----BEGIN " + "PRIVATE KEY-----",
                   "a URL with a password": "https://user:" + "hunter2" + "pass@host.example/x", "a 40-character hex string": "x " + "0123456789abcdef" * 2 + "01234567"}
        samples.update({"token prefix " + p.strip(): "x " + p + "A1b2C3d4E5f6G7h8" for p in lib._PREFIXES})
        self.assertEqual(set(samples), {name for name, _, _ in lib.SECRET_SHAPES})   # every member of the family has a case
        for shape, value in samples.items():
            with self.subTest(shape):
                self.write(dict(self.values, CW_GIT_TOKEN_CMD=value))
                code, out, err = self.launch()
                self.assertEqual(code, 2)
                self.assertIn("CW_GIT_TOKEN_CMD", err)
                for text in (out, err):
                    self.assertNotIn(value, text)
                    self.assertNotIn(value.split()[-1], text)
                self.nothing_was_called()

    def test_s4_each_required_key_missing_is_named_and_only_it(self):
        required = [name for name, needed, _ in self.lib.SETTINGS if needed]
        self.assertTrue(required)
        for key in required:
            with self.subTest(key):
                self.write({k: v for k, v in self.values.items() if k != key})
                code, out, err = self.launch()
                self.assertEqual(code, 2)
                self.assertIn(key, err)
                for other in required:
                    if other != key:
                        self.assertNotIn(other, err)
                self.nothing_was_called()

    def test_s4_all_missing_ones_are_listed(self):
        self.write({k: v for k, v in self.values.items() if k not in ("CW_VAULT_NAME", "CW_CLOUD_NAMESPACE")})
        err = self.launch()[2]
        self.assertIn("CW_VAULT_NAME", err)
        self.assertIn("CW_CLOUD_NAMESPACE", err)

    def test_a_hostile_value_is_refused_by_launch_before_any_call_naming_the_key_and_not_the_value(self):
        for key, value in (("CW_CLOUD_SERVER", "http://169.254.169.254"), ("CW_CLOUD_NAMESPACE", "kube-system"), ("CW_VAULT_NAME", "a;touch SENT"),
                           ("CW_ALLOWED_REPOS", "acme-org/*"), ("CW_VAULT_SUBSCRIPTION", "sub-example"), ("CW_CLOUD_IMAGE", "x:tag@sha256:" + "cd34" * 16)):
            with self.subTest(key):
                self.write(dict(self.values, **{key: value}))
                code, out, err = self.launch()
                self.assertEqual(code, 2)
                self.assertIn(key, err)
                self.assertNotIn(value, err)
                self.nothing_was_called()

    def test_s5_a_tag_is_refused_and_a_digest_launches(self):
        self.write(dict(self.values, CW_CLOUD_IMAGE="registry.example.internal/acme/worker:1.2"))
        code, out, err = self.launch()
        self.assertEqual(code, 2)
        self.assertIn("CW_CLOUD_IMAGE", err)
        self.nothing_was_called()
        self.write()
        self.assertEqual(self.launch()[0], 0)

    def test_a_clash_between_the_file_and_the_environment_is_refused_naming_both_and_no_value(self):
        self.write()
        os.environ["CW_CLOUD_NAMESPACE"] = "other-ns-zz"
        code, out, err = self.launch()
        self.assertEqual(code, 2)
        self.assertIn("CW_CLOUD_NAMESPACE", err)
        self.assertIn(str(self.file), err)
        self.assertIn("environment", err)
        self.assertNotIn("other-ns-zz", err)
        self.nothing_was_called()

    def test_with_a_file_the_environment_is_not_read(self):
        self.write()
        os.environ["CW_TOOLING_REPO"] = "acme-org/widget-service"   # a table key the file does not set: it would refuse this repository
        self.assertEqual(self.launch()[0], 0)

    def test_u2_no_value_from_the_file_or_the_token_mint_shows_in_any_output_state_or_argument(self):
        marker = "vault-marker-zz9"
        self.write(dict(self.values, CW_VAULT_NAME=marker))
        code, out, err = self.launch()
        self.assertEqual(code, 0, err)
        planted = [GIT_TOKEN, CLUSTER_TOKEN, PASSWORD, marker]
        captures = [out, err] + list(self.everything_written().values())
        for entry in self.jsonl("login.log"):
            captures.append(json.dumps(entry["argv"]))
        for entry in self.jsonl("kubectl.log"):
            captures.append(json.dumps(entry["args"]))
        for text in captures:
            for value in planted:
                self.assertNotIn(value, text)


class TestLaunchStack(Base):
    """#910 (S9, S10): `launch --cloud --stack [--shape S|M]` hands the launcher's create the stack option, and only then."""

    FIXTURES = BIN.parent / "cloud" / "tests" / "fixtures"
    SHAPES = (None, "S", "M")
    BAD_SHAPES = ("L", "m", "s", "XL", "2", "SM", "S M", "S\n", "--privileged", "S --stack", "/etc/passwd", "S=1")

    def create_argv(self):
        calls = [c for c in self.stub_calls() if c[0] == "create"]
        self.assertEqual(len(calls), 1)
        return self.shaped(calls[0])

    def nothing_was_called(self):
        self.assertEqual(self.stub_calls(), [])           # the fake launcher
        self.assertEqual(self.jsonl("kubectl.log"), [])   # the fake token command (the vault and the cluster)
        self.assertEqual(self.jsonl("login.log"), [])

    def test_s9_a_launch_without_stack_hands_the_stored_fixture_exactly(self):
        code, out, err = self.launch_with("--cloud")
        self.assertEqual(code, 0, err)
        self.assertEqual(self.create_argv(), json.loads((self.FIXTURES / "launch-create-argv.json").read_text()))   # taken from the base before this change

    def test_s9_a_stack_launch_hands_the_stack_option_and_the_shape(self):
        for shape in self.SHAPES:
            with self.subTest(shape=shape):
                self.state_clean()
                extra = ("--shape", shape) if shape else ()
                code, out, err = self.launch_with("--cloud", "--stack", *extra)
                self.assertEqual(code, 0, err)
                base = json.loads((self.FIXTURES / "launch-create-argv.json").read_text())
                at = base.index("<run-id>") + 1
                expected = base[:at] + list(extra) + ["--stack"] + base[at:]
                self.assertEqual(self.create_argv(), expected)
                self.assertEqual(self.create_argv().count("--stack"), 1)

    def state_clean(self):
        """Between two launches of one test: the fakes' call logs and the worker records start empty."""
        for name in ("calls.log", "kubectl.log", "login.log"):
            self.stub_dir.joinpath(name).unlink(missing_ok=True)
        for path in list((self.state / "cloud").glob("*")) if (self.state / "cloud").exists() else []:
            path.unlink()

    def test_s9_shape_without_stack_is_handed_as_before(self):
        code, out, err = self.launch_with("--cloud", "--shape", "M")
        self.assertEqual(code, 0, err)
        self.assertNotIn("--stack", self.create_argv())
        self.assertEqual(self.create_argv()[self.create_argv().index("--shape") + 1], "M")

    def test_s9_the_fake_launcher_refuses_an_option_it_does_not_know(self):
        text = self.stub.read_text().replace('"--stack", ', "")
        self.stub.write_text(text)
        code, out, err = self.launch_with("--cloud", "--stack")
        self.assertEqual(code, 1)   # the create failed: a wrong option name fails the test, it is not swallowed
        self.assertIn("unrecognized arguments", err + out)

    def test_s10_stack_without_cloud_is_refused_before_any_call(self):
        for extra in ((), ("--headless",), ("--terminal",), ("--shape", "M"), ("--shape", "L"), ("--idle", "5m"), ("--hard", "1h")):
            with self.subTest(extra=extra):
                self.state_clean()
                code, out, err = self.launch_with("--stack", *extra)
                self.assertEqual(code, 2, err)
                self.assertIn("--stack", err)
                self.assertIn("--cloud", err)
                self.nothing_was_called()

    def test_s10_a_repository_off_the_allow_list_is_refused_before_any_call(self):
        for shape in self.SHAPES:
            with self.subTest(shape=shape):
                self.state_clean()
                code, out, err = self.launch_with("--cloud", "--stack", *(("--shape", shape) if shape else ()), repo="acme-org/other-service")
                self.assertEqual(code, 2, err)
                self.assertIn("acme-org/other-service", err)
                self.nothing_was_called()

    def test_s10_an_unknown_shape_is_refused_before_any_call(self):
        for shape in self.BAD_SHAPES:
            with self.subTest(shape=shape):
                self.state_clean()
                code, out, err = self.launch_with("--cloud", "--stack", "--shape=" + shape)
                self.assertEqual(code, 2, err)
                self.assertIn("--shape", err)
                self.assertIn(repr(shape), err)
                self.nothing_was_called()

    def test_s10_off_list_with_a_bad_shape_reports_the_allow_list(self):
        code, out, err = self.launch_with("--cloud", "--stack", "--shape", "SM", repo="acme-org/other-service")
        self.assertEqual(code, 2, err)
        self.assertIn("allow-list", err)
        self.assertNotIn("pod shape", err)
        self.nothing_was_called()

    def test_s10_a_bad_shape_is_handed_on_without_stack_as_before(self):
        code, out, err = self.launch_with("--cloud", "--shape", "L")
        self.assertNotEqual(code, 0)   # the launcher (here its fake) refuses it: the switchboard does not validate it without --stack
        self.assertEqual(self.create_argv()[self.create_argv().index("--shape") + 1], "L")

    def test_family_every_flag_combination_with_stack(self):
        """The table of flag combinations is the product of the launch flags the code reads (cloud, mode, timing, shape); the oracle is stated once."""
        import itertools
        for cloud, mode, timing, shape in itertools.product((True, False), (None, "--headless", "--terminal"), (None, "--idle", "--hard"), self.SHAPES + self.BAD_SHAPES[:1]):
            with self.subTest(cloud=cloud, mode=mode, timing=timing, shape=shape):
                self.state_clean()
                extra = (["--cloud"] if cloud else []) + (["--stack"]) + ([mode] if mode else []) + ([timing, "5m" if timing == "--idle" else "1h"] if timing else []) + (["--shape", shape] if shape else [])
                code, out, err = self.launch_with(*extra)
                if not cloud:
                    self.assertEqual(code, 2, err)
                    self.assertEqual(self.stub_calls(), [])
                elif mode == "--headless":
                    self.assertEqual(code, 1, err)   # unchanged: a cloud worker is never headless, and that check comes first
                    self.assertEqual(self.stub_calls(), [])
                elif shape in self.BAD_SHAPES[:1]:
                    self.assertEqual(code, 2, err)
                    self.assertEqual(self.nothing_was_called(), None)
                else:
                    self.assertEqual(code, 0, err)
                    argv = self.create_argv()
                    self.assertEqual(argv.count("--stack"), 1)
                    self.assertEqual(argv.count("--shape"), 1 if shape else 0)
                    if timing:
                        self.assertEqual(argv[argv.index(timing) + 1], "5m" if timing == "--idle" else "1h")
                    self.cleanup_worker()

    def cleanup_worker(self):
        self.assertEqual(self.main("retire", "coder7")[0], 0)


