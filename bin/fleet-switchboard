    "stale-as-fresh",
    "decision-resolves-never",
    "static-repos",         # PR 15: the watched repos are read once, from the config
    "bare-issue-number",    # PR 15: an `owner/repo#N` qualifier is ignored
    "one-account",          # PR 15: every repo uses the default token
    "repo-create-allowed",  # PR 15: the judge's deterministic rule on `gh repo create` is off
    "key-missing-silent",   # PR 16: `status` does not say that no decision-model key is configured
    "no-ensure-on-use",     # PR 16: a command that needs the daemon does not start it
    "shared-profile-default",  # PR 16: `install` writes into the directory the ordinary OpenCode reads, by default
    "key-env-only-unseen",  # PR 16: `status` does not warn that the key is in the shell's environment only
    "config-read-once",     # PR 16: the daemon ignores an edit to its config file until it is restarted
    "catch-up-blocks-pass",  # PR 16: GitHub reads have no time budget or cap, so a big catch-up holds the pass
    "catch-up-on-fresh-start",  # PR 16: a repo with no read marker reads the whole look-back window
    "full-window-every-time",   # PR 16: a forwarder repo reads the whole look-back window on every catch-up
    "orders-start-only",
    "orders-wake",
    "anyone-can-order",
    "orders-never-judged",
    "tier-flat",               # PR 18: every decision is shown to you, whatever its tier
    "cos-orders-unfed",        # PR 18: the judge ignores the Chief of Staff's orders file
    "anyone-edits-cos-orders",  # PR 18: no agent is stopped from writing the Chief of Staff's orders file
    "answer-unjudged",         # PR 18: `decisions answer` and `decisions resolve` skip the judge
)

LAB_ENV = "FLEET_SWITCHBOARD_LAB"
FAULT_ENV = "FLEET_SWITCHBOARD_FAULT"


class FaultError(Exception):
    """A fault name nobody defined. A typo here would make a control prove nothing."""


def active_faults():
    """The fault names requested in the environment, checked, as a sorted list."""
    raw = os.environ.get(FAULT_ENV, "")
    names = sorted({part.strip() for part in raw.split(",") if part.strip()})
    unknown = [name for name in names if name not in KNOWN_FAULTS]
    if unknown:
        raise FaultError("%s names unknown fault(s): %s (known: %s)"
                         % (FAULT_ENV, ", ".join(unknown), ", ".join(KNOWN_FAULTS)))
    return names


def fault(name):
    """True only in the Lab, and only for a fault named in the environment."""
    if name not in KNOWN_FAULTS:
        raise FaultError("unknown fault: %r" % name)
    requested = active_faults()
    return os.environ.get(LAB_ENV) == "1" and name in requested


class SimulatedCrash(BaseException):
    """The `crash-after-send` fault: the process stops here, as if killed.

    A BaseException, so no per-agent `except Exception` in the pass catches
    it, and AuditLog.external lets it through without writing a result: a
    crashed process writes nothing after the crash. Scenario R2 is built on it.
    """


# ------------------------------------------------------------- the message id

def derive_message_id(recipient, keys):
    """The v2 message id for a delivery: the recipient plus the keys it covers.

    A retry after a crash derives the same id, and v2 admits a repeated id
    once, so a message is delivered at most once (invariant 3). Order and
    duplicates in `keys` do not change the id.
    """
    if not isinstance(recipient, str) or not recipient:
        raise ValueError("recipient must be a non-empty string")
    keys = list(keys)
    if not keys or not all(isinstance(key, str) and key for key in keys):
        raise ValueError("keys must be a non-empty list of non-empty strings")
    canonical = json.dumps([recipient, sorted(set(keys))], separators=(",", ":"), ensure_ascii=False)
    return "msg_" + hashlib.sha256(canonical.encode("utf-8")).hexdigest()[:26]


# ----------------------------------------------------------------- the audit

SENSITIVE = ("token", "key", "password", "secret", "authorization")
REDACTED = "[redacted]"


def _sensitive(name):
    lowered = str(name).lower()
    # `keys` is the list of fact names a message covers (docs/switchboard.md
    # §Data), such as `worker.idle:<session>:<time>`. It is the one thing the
    # audit must show about a delivery, and it never holds a credential.
    if lowered == "keys":
        return False
    return any(word in lowered for word in SENSITIVE)


def redact(value):
    """A copy of `value` with every credential-like key's value replaced."""
    if isinstance(value, dict):
        return {k: (REDACTED if _sensitive(k) else redact(v)) for k, v in value.items()}
    if isinstance(value, (list, tuple)):
        return [redact(v) for v in value]
    return value


def utc_now():
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


AUDIT_ROTATE_BYTES = 20 << 20    # the active audit file is rotated when an append finds it larger than this
AUDIT_KEEP_SECONDS = 86400       # ... keeping the last day in the active file (and never more than three quarters of AUDIT_ROTATE_BYTES)
AUDIT_ARCHIVE_DAYS = 14          # archives (audit-<UTC date>.jsonl.gz) older than this are deleted
AUDIT_SYNC_SECONDS = 1.0         # fsync of a non-intent append at most this often (an `intent` is always synced: it must be on disk before the write it announces)
_AUDIT_TS = re.compile(rb'"ts": "([^"]+)"')


class AuditLog:
    """Append-only JSON lines. Never read by a decision; written before and after.

    Appenders open the file per write (O_APPEND) under a shared lock; a rotation archives the old part to
    `audit-<UTC date>.jsonl.gz` (0600, written to a temp file and renamed), then takes the lock exclusively for the swap only, carries what was
    appended meanwhile into the new active file and replaces the old one: no appended line is lost. An `intent` entry is fsynced before the write it announces; the
    others at most once a second (a process crash loses nothing either way: the data is in the OS by `write`)."""

    _synced = {}   # path -> monotonic time of the last fsync, shared by every AuditLog of the process
    _failed = {}   # path -> (error text, monotonic time) of the last rotation failure said

    def __init__(self, path):
        self.path = Path(path)

    def append(self, actor, event, subject=None, detail=None, **extra):
        entry = {"ts": utc_now(), "actor": actor, "event": event,
                 "subject": subject, "detail": redact(detail)}
        entry.update(redact(extra))
        line = json.dumps(entry, sort_keys=True, default=str) + "\n"
        size = 0
        with self._append_lock(fcntl.LOCK_SH):   # a rotation holds this exclusively for its swap only: no line is written to a file that is being replaced
            fd = os.open(str(self.path), os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
            with os.fdopen(fd, "a") as handle:
                handle.write(line)
                handle.flush()
                size = os.fstat(handle.fileno()).st_size
                key, clock = str(self.path), time.monotonic()
                if extra.get("phase") == "intent" or clock - AuditLog._synced.get(key, -1e9) >= AUDIT_SYNC_SECONDS:
                    os.fsync(handle.fileno())
                    AuditLog._synced[key] = clock
        if size > AUDIT_ROTATE_BYTES:
            try:
                self.rotate()
            except Exception as err:   # a rotation that fails is tried again at a later append and never fails this one; said once per change of error
                self._say_rotation_failed(err)
        return entry

    @contextmanager
    def _append_lock(self, mode):
        """A flock on `audit.jsonl.append.lock` (shared for an append, exclusive for the swap). If the lock file cannot be had the write goes ahead without it."""
        try:
            fd = os.open(str(self.path.with_name(self.path.name + ".append.lock")), os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW, 0o600)
        except OSError:
            yield
            return
        with os.fdopen(fd, "w") as guard:
            try:
                fcntl.flock(guard, mode)
            except OSError:
                pass
            yield

    def _say_rotation_failed(self, err):
        text = "%s: %s" % (type(err).__name__, _one_line(str(err), 120))
        key, clock = str(self.path), time.monotonic()
        said = AuditLog._failed.get(key)
        if said is not None and said[0] == text and clock - said[1] < 3600:
            return
        AuditLog._failed[key] = (text, clock)
        sys.stderr.write("%s: the audit log could not be rotated (%s); it keeps growing until it can\n" % (PROG, text))
        try:
            self.append(PROG, "audit.rotate_failed", None, {"error": text})
        except Exception:
            pass

    def rotate(self, now=None):
        """Archive the old part of the active file and keep the recent part. One rotator at a time (a lock file); another process that finds it
        held skips. Returns the archive path, or None when there was nothing to do."""
        now = time.time() if now is None else now
        lock_path = self.path.with_name(self.path.name + ".rotate.lock")
        fd = os.open(str(lock_path), os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, "w") as guard:
            try:
                fcntl.flock(guard, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except OSError:
                return None
            archive = self._rotate_locked(now)
            pruned = self._prune_archives(now)
            if archive is not None or pruned:
                self.append(PROG, "audit.rotated", None, {"archive": archive.name if archive else None, "pruned": pruned})
            return archive

    def _rotate_locked(self, now):
        cutoff = datetime.fromtimestamp(now - AUDIT_KEEP_SECONDS, timezone.utc).strftime("%Y-%m-%dT%H:%M:%S")
        try:
            seen = self.path.stat().st_size
        except OSError:
            return None
        if seen <= AUDIT_ROTATE_BYTES:
            return None   # another process rotated first
        floor = max(0, seen - AUDIT_ROTATE_BYTES * 3 // 4)   # never keep more than three quarters of the threshold (room to grow before the next rotation), whatever the clock says
        stamp = datetime.fromtimestamp(now, timezone.utc)
        archive = self.path.with_name("audit-%s.jsonl.gz" % stamp.strftime("%Y-%m-%d"))
        if archive.exists():
            archive = self.path.with_name("audit-%s.jsonl.gz" % stamp.strftime("%Y-%m-%dT%H%M%S"))
        keep_temp = self.path.with_name("%s.%d.keep.tmp" % (self.path.name, os.getpid()))
        placed = False
        gz_temp = archive.with_name("%s.%d.tmp" % (archive.name, os.getpid()))
        try:
            offset, archived = 0, 0
            with open(str(self.path), "rb") as source:
                with os.fdopen(os.open(str(gz_temp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600), "wb") as raw, \
                        gzip.GzipFile(fileobj=raw, mode="wb", filename="") as packed, \
                        os.fdopen(os.open(str(keep_temp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600), "wb") as kept:
                    keeping = False
                    for line in source:
                        if offset >= seen:
                            break
                        if not keeping:
                            found = _AUDIT_TS.search(line)
                            stamp_text = found.group(1).decode("ascii", "replace")[:19] if found else ""
                            keeping = offset >= floor and (stamp_text >= cutoff or not found)
                        offset += len(line)
                        if keeping:
                            kept.write(line)
                        else:
                            packed.write(line)
                            archived += 1
                    raw.flush()
                    os.fsync(raw.fileno())
                    kept.flush()
                    os.fsync(kept.fileno())
            if not archived:
                os.unlink(str(gz_temp))
                os.unlink(str(keep_temp))
                return None
            os.rename(str(gz_temp), str(archive))
            placed = True
            self._swap(keep_temp, offset)
            return archive
        except BaseException:
            for temp in (gz_temp, keep_temp, archive if placed else None):   # a swap that failed leaves the log whole: its archive would be a duplicate of it
                try:
                    if temp is not None:
                        os.unlink(str(temp))
                except OSError:
                    pass
            raise

    def _swap(self, keep_temp, offset):
        """Carry what was appended after `offset` into the kept part, then put it in place of the active file."""
        with self._append_lock(fcntl.LOCK_EX):   # no appender is mid-write while the tail is copied and the file replaced
            with open(str(self.path), "rb") as source, open(str(keep_temp), "ab") as kept:
                source.seek(offset)
                while True:
                    chunk = source.read(1 << 20)
                    if not chunk:
                        break
                    kept.write(chunk)
                kept.flush()
                os.fsync(kept.fileno())
            os.replace(str(keep_temp), str(self.path))

    def _prune_archives(self, now):
        """Delete the archives older than AUDIT_ARCHIVE_DAYS; the names of the ones deleted."""
        horizon = now - AUDIT_ARCHIVE_DAYS * 86400
        gone = []
        for path in sorted(self.path.parent.glob("audit-*.jsonl.gz")):
            try:
                if path.stat().st_mtime < horizon:
                    path.unlink()
                    gone.append(path.name)
            except OSError:
                pass
        return gone

    @contextmanager
    def external(self, actor, event, subject=None, detail=None):
        """Audit one write to another system: `intent` before, `result` after.

        Yields a dict the caller may fill with what came back; it becomes the
        result entry's detail. An exception is recorded, then re-raised. A
        SimulatedCrash is re-raised with nothing recorded, as a real crash.
        """
        call = uuid.uuid4().hex[:12]
        self.append(actor, event, subject, detail, phase="intent", call=call)
        outcome = {}
        try:
            yield outcome
        except SimulatedCrash:
            raise
        except BaseException as err:
            self.append(actor, event, subject, outcome or None, phase="result", call=call,
                        ok=False, error="%s: %s" % (type(err).__name__, err))
            raise
        self.append(actor, event, subject, outcome or None, phase="result", call=call, ok=True)


# ------------------------------------------------------------- OpenCode v2

class V2Error(Exception):
    """A v2 call that did not return usable JSON.

    reason: "http" (v2 answered with an HTTP error), "exit" (non-zero exit, no
    HTTP status), "timeout", "bad_json", "unavailable" (could not run), "too_large" (a reply over the cap), "refused" (a real run under the test suite) or "backoff" (an optional
    read skipped while the service is slow).
    """

    def __init__(self, reason, status=None, detail=None):
        self.reason = reason
        self.status = status
        self.detail = detail
        text = reason if status is None else "%s %s" % (reason, status)
        super().__init__("%s: %s" % (text, detail) if detail else text)


def _one_line(text, limit=300):
    return decision_core.one_line(text, limit)


STATE_HEARTBEAT_SECONDS = 60   # a status file whose own timestamp is its liveness signal is rewritten at least this often, changed or not (`status` calls v2-calls stale past 120 s: a pass of 30 s fits twice)
HEARTBEAT_HEALTH = STATE_HEARTBEAT_SECONDS * 8   # pane-health.json: 8 minutes (nothing reads its times as liveness)
HEARTBEAT_SWEEP = STATE_HEARTBEAT_SECONDS * 4    # sweep.json and triage.json: 4 minutes (their `at` is shown as an absolute "as of")
HEARTBEAT_PR_STATE = 300                         # pr-state.json: 5 minutes
_STATE_LAST = {}               # path -> (stable text, monotonic time written): what this process last wrote


def state_write(path, text, stable=None, heartbeat=None, fsync=False, nofollow=False):
    """Write `text` to `path` (a private file: a temp file, mode 0600, renamed into place) ONLY WHEN IT CHANGED. Returns True when it wrote.

    `stable` is the text to compare: the content without its volatile fields (a timestamp that moves every pass), default `text` itself.
    The comparison is with what is on the DISK: the file's size and modification time are checked against what this process wrote (one stat), and
    a file that changed meanwhile (an outside writer, `retire --undo`) is read and compared with what was written, so an external rewrite is
    repaired at the next call, not at the heartbeat; a mere touch is not. A file that is missing is written. `heartbeat` (seconds) keeps a status
    whose own timestamp is read as liveness fresh: it is rewritten when its last write is older than that. A write nobody needs costs the disk
    a write, an fsync and a rename that every file watcher sees: about twenty files used to be rewritten every pass."""
    path = Path(path)
    key, clock = str(path), time.monotonic()
    stable = text if stable is None else stable
    last = _STATE_LAST.get(key)
    try:
        info = path.stat()
        if last is not None and last[0] == stable and (heartbeat is None or clock - last[1] < heartbeat):
            if (info.st_mtime_ns, info.st_size) == (last[3], last[4]):
                return False
            if path.read_text() == last[2]:   # touched, not rewritten: the content is what this process wrote
                _STATE_LAST[key] = (last[0], last[1], last[2], info.st_mtime_ns, info.st_size)
                return False
            # the file is not what was written: an outside writer changed it; fall through and write it again
        if last is None and heartbeat is None and info.st_size == len(text.encode("utf-8")) and path.read_text() == text:   # a file of another size is not even read
            _STATE_LAST[key] = (stable, clock, text, info.st_mtime_ns, info.st_size)
            return False
    except OSError:
        pass
    temp = path.with_name("%s.%d.tmp" % (path.name, os.getpid()))
    try:
        fd = os.open(str(temp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC | (os.O_NOFOLLOW if nofollow else 0), 0o600)
        with os.fdopen(fd, "w") as handle:
            handle.write(text)
            if fsync:
                handle.flush()
                os.fsync(handle.fileno())
        os.replace(str(temp), str(path))
    except BaseException:
        try:
            os.unlink(str(temp))
        except OSError:
            pass
        raise
    try:
        info = path.stat()
        _STATE_LAST[key] = (stable, clock, text, info.st_mtime_ns, info.st_size)
    except OSError:
        _STATE_LAST.pop(key, None)
    return True


def _without(body, *names):
    """`body` (a dict) as sorted JSON without the top-level `names`: the stable part of a status."""
    return json.dumps({k: v for k, v in body.items() if k not in names}, sort_keys=True)


CURSOR_LIMIT = 2000  # characters of one v2 cursor token we will pass back on an argv
MAX_READ_PAGES = 12   # pages of SYNTHETIC_PAGE messages `delivered_keys` reads before it holds (600 messages, newest first, stopping at the first old enough)
SYNTHETIC_PAGE = 50   # messages of one such read: a long history never answers a big page
DESCRIPTION_MAX = 200  # characters of the one line v2's TUI shows for a synthetic message (PR 13)


def valid_description(text):
    return isinstance(text, str) and bool(text.strip()) and len(text) <= DESCRIPTION_MAX \
        and "\n" not in text and "\r" not in text


V2_CALLS_KEEP_SECONDS = 600   # how long a call is remembered, for the calls-per-minute figures
V2_CALLS_KEEP_MAX = 50000     # and how many at most (a runaway cannot grow the list without bound)
UNDER_TEST_ENV = "FLEET_SWITCHBOARD_UNDER_TEST"   # set by the test suite: the real opencode is then never run
ALLOW_REAL_V2_ENV = "FLEET_SWITCHBOARD_ALLOW_REAL_V2"   # =1: a test that really means to talk to a service says so


def refuse_real_opencode_under_test(runner, binary):
    """Under the test suite, a call that would really run `opencode` (the real `subprocess.run`) is refused: a test that reached the live
    service once helped take it down (tens of thousands of spawns). A fake runner is unaffected, and so is a test that says
    FLEET_SWITCHBOARD_ALLOW_REAL_V2=1."""
    if os.environ.get(UNDER_TEST_ENV) == "1" and os.environ.get(ALLOW_REAL_V2_ENV) != "1" and runner is subprocess.run:
        raise V2Error("refused", None, "refusing to run the real %s under the test suite (set %s=1 to allow it in a test that means to)"
                      % (binary, ALLOW_REAL_V2_ENV))


# ---------------------------------------------------------------- the v2 transport: HTTP to the background service, and backpressure
#
# `opencode api <op>` starts a whole process per call (0.13 to 1.5 s measured, against 5 to 17 ms for the same call over HTTP, with identical
# JSON). The background service writes its address and password to `<state>/opencode/service.json` (mode 0600); the daemon talks to it directly
# over loopback, keeps one connection alive for reads, and falls back to the CLI on ANY trouble with the HTTP route (the CLI also starts a
# stopped service, so the fallback is also the recovery). Writes use a fresh connection and are never replayed after they may have been
# received. The password is sent only to a loopback address and is never logged, audited, printed or put in an error.
# The operation table was read from the service's own /openapi.json (OpenCode 2.0.24); an operation not in it, or a path parameter it does not
# know, goes through the CLI. FLEET_SWITCHBOARD_V2_CLI=1 turns the HTTP route off.
#
# Backpressure: V2Breaker watches the latency of every call. When calls are slow (p95 over V2_SLOW_SECONDS) or time out in a row it opens for an
# exponentially growing time (V2_BACKOFF_BASE .. V2_BACKOFF_MAX): OPTIONAL reads are skipped (V2Error "backoff": the callers already hold on a
# V2Error) while writes and the reads a delivery or a blocked worker needs go on; it resumes gradually (one probe at a time, V2_RECOVER_OK good
# probes to close). Fail mode: OPEN for essential calls on purpose (a wake must not be lost to a slow service), closed for optional reads.

V2_HTTP_OPERATIONS = {   # operation -> (method, path template, path parameters, query parameters)
    "server.info": ("GET", "/api/info", (), ()),
    "session.active": ("GET", "/api/session/active", (), ()),
    "session.create": ("POST", "/api/session", (), ()),
    "session.get": ("GET", "/api/session/{sessionID}", ("sessionID",), ()),
    "session.remove": ("DELETE", "/api/session/{sessionID}", ("sessionID",), ()),
    "session.list": ("GET", "/api/session", (), ("limit", "order", "search", "parentID", "directory", "project", "subpath", "cursor")),
    "session.message.list": ("GET", "/api/session/{sessionID}/message", ("sessionID",), ("limit", "order", "cursor", "type")),
    "session.inbox.list": ("GET", "/api/session/{sessionID}/inbox", ("sessionID",), ()),
    "session.inbox.update": ("PATCH", "/api/session/{sessionID}/inbox/{inboxID}", ("sessionID", "inboxID"), ()),
    "session.interrupt": ("POST", "/api/session/{sessionID}/interrupt", ("sessionID",), ("resume",)),
    "session.permission.list": ("GET", "/api/session/{sessionID}/permission", ("sessionID",), ()),
    "session.permission.reply": ("POST", "/api/session/{sessionID}/permission/{requestID}/reply", ("sessionID", "requestID"), ()),
    "session.form.list": ("GET", "/api/session/{sessionID}/form", ("sessionID",), ()),
    "session.form.reply": ("POST", "/api/session/{sessionID}/form/{formID}/reply", ("sessionID", "formID"), ()),
    "session.prompt": ("POST", "/api/session/{sessionID}/prompt", ("sessionID",), ()),
    "session.synthetic": ("POST", "/api/session/{sessionID}/synthetic", ("sessionID",), ()),
    "experimental.session.import": ("POST", "/api/experimental/session/import", (), ()),
}
V2_ESSENTIAL_READS = ("session.get", "session.inbox.list", "session.permission.list", "session.form.list")   # discovery and the re-check before a write (session.get), a delivery and a blocked worker need these
V2_SERVICE_FILE_MAX = 4096        # bytes of service.json read
V2_HTTP_MAX_BODY = 16 * 1024 * 1024   # a reply larger than this is refused, not buffered (a transcript is read in bounded pages anyway)
V2_READ_LIMIT_MAX = 500           # messages per page, whatever a caller asks
V2_STREAM_LINE_MAX = 1024 * 1024  # one event line of the stream; a larger one is refused
V2_STREAM_IDLE_SECONDS = 1800     # a stream that said nothing for this long is dropped and opened again (the service sends no keep-alive); that reopen is NOT a gap
STREAM_OPENED = object()          # what stream_lines yields once the service answered
STREAM_IDLE = object()            # what it yields when it ends because the stream was quiet for the whole idle time (the next open is not a gap)
V2_SLOW_SECONDS = 8.0             # p95 of the recent calls above this opens the breaker
V2_SLOW_MIN_SAMPLES = 8
V2_SLOW_WINDOW = 20
V2_TIMEOUT_STREAK = 3             # timeouts in a row that open it
V2_BACKOFF_BASE = 10.0
V2_BACKOFF_MAX = 300.0
V2_RECOVER_OK = 3                 # good probes in a row that close it
V2_LINK_STATUS_FILE = "v2-link.json"
V2_LINK_WRITE_SECONDS = 60


class V2Unreachable(Exception):
    """The HTTP route cannot serve this call (no service file, a stale one, refused, a bad password twice): the caller uses the CLI."""


def v2_service_file(env):
    base = env.get("XDG_STATE_HOME") or os.path.join(env.get("HOME") or os.path.expanduser("~"), ".local", "state")
    return Path(base) / "opencode" / "service.json"


class V2Http:
    """One keep-alive connection for reads to the OpenCode service; see the section comment."""

    def __init__(self, service_file, timeout, alive=None, connect=None):
        self.file = Path(service_file)
        self.timeout = timeout
        self.alive = alive or self._pid_alive
        self.connect = connect or http.client.HTTPConnection   # (host, port, timeout=) -> a connection; a test passes an in-memory one
        self._info = None        # (host, port, authorization) once read; never logged
        self._conn = None
        self._lock = threading.Lock()

    @staticmethod
    def _pid_alive(pid):
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            return False
        except OSError:
            return True   # not ours to signal, so it exists
        return True

    def base_url(self):
        """`http://host:port` of the service (never the password), or None when the service file cannot be read."""
        with self._lock:
            try:
                if self._info is None:
                    self._load()
                host, port, _ = self._info
                return "http://%s:%d" % (host if ":" not in host else "[%s]" % host, port)
            except Exception:
                return None

    def _read_file(self):
        """(host, port, password, pid) of the service file, read with every safety check. Raises V2Unreachable."""
        try:
            parent = os.lstat(str(self.file.parent))
            if parent.st_uid != os.getuid() or parent.st_mode & 0o022 or stat.S_ISLNK(parent.st_mode):
                raise ValueError("the directory is not the user's own and closed to others")   # whoever can write the directory can swap the file
            fd = os.open(str(self.file), os.O_RDONLY | os.O_NOFOLLOW)   # a symlink is refused, not followed
            with os.fdopen(fd, "rb") as handle:
                found = os.fstat(handle.fileno())
                if not stat.S_ISREG(found.st_mode) or found.st_uid != os.getuid() or found.st_mode & 0o077:
                    raise ValueError("not private to this user")   # the password in it is only trusted from a file only this user could write
                raw = handle.read(V2_SERVICE_FILE_MAX + 1)
            if len(raw) > V2_SERVICE_FILE_MAX:
                raise ValueError("too large")
            found = json.loads(raw.decode("utf-8"))
            url = urllib.parse.urlsplit(found["url"])
            password, pid = found["password"], found.get("pid")
            if url.scheme != "http" or url.hostname not in ("127.0.0.1", "::1") or not url.port:
                raise ValueError("not a loopback http address")   # the password goes nowhere else
            if not isinstance(password, str) or not 0 < len(password) <= 512 or re.search(r"[\x00-\x1f\x7f]", password):
                raise ValueError("no usable password")
            host, port = url.hostname, url.port
        except (OSError, ValueError, KeyError, TypeError, AttributeError):
            raise V2Unreachable("no usable service file") from None
        return host, port, password, pid

    def service_identity(self):
        """The service's process id from a FRESH read of its private service file (a restart changes it), or None when the file cannot be read or names a
        process that is gone. Nothing is cached and the password is never returned."""
        try:
            pid = self._read_file()[3]
        except V2Unreachable:
            return None
        return pid if isinstance(pid, int) and not isinstance(pid, bool) and self.alive(pid) else None

    def _load(self):
        host, port, password, pid = self._read_file()
        if isinstance(pid, int) and not self.alive(pid):
            raise V2Unreachable("the service file names a process that is gone")
        token = base64.b64encode(("opencode:" + password).encode("utf-8")).decode("ascii")
        self._info = (host, port, "Basic " + token)

    def stream_lines(self, path, idle_seconds=V2_STREAM_IDLE_SECONDS):
        """STREAM_OPENED once the service answered 200, then the lines of one SSE response (decoded, newline stripped), read on its OWN connection (never
        under the request lock). A quiet stretch of `idle_seconds` (the service sends no keep-alive) ends the generator like a closed stream. Raises V2Unreachable
        (no service, a refused connection, a password refused: use the old reads) or V2Error (any other status)."""
        with self._lock:
            if self._info is None:
                self._load()
            host, port, auth = self._info
        conn = self.connect(host if ":" not in host else "[%s]" % host, port, timeout=idle_seconds)
        try:
            try:
                conn.connect()
                conn.request("GET", path, headers={"Authorization": auth, "Accept": "text/event-stream"})
                response = conn.getresponse()
            except (OSError, http.client.HTTPException):
                with self._lock:
                    self._info = None   # it may have moved (a restart on a new port): read the file again at the next connect, as `request` does
                raise V2Unreachable("the service does not answer") from None
            if response.status == 401:
                with self._lock:
                    self._info = None   # the password changed: read the file again at the next connect
                raise V2Unreachable("the service refused the password")
            if response.status != 200:
                raise V2Error("http", response.status, "the event stream answered HTTP %d" % response.status)
            yield STREAM_OPENED   # the service answered 200: only now is this a connection
            while True:
                try:
                    raw = response.readline(V2_STREAM_LINE_MAX + 1)
                except socket.timeout:
                    yield STREAM_IDLE   # quiet for the whole idle time: ours to end, not the service's; the caller may reopen without marking a gap
                    return
                except (OSError, http.client.HTTPException):
                    return   # a read timeout included: a response is not read on after a timeout (the socket refuses), so it ends and the caller reconnects
                if not raw:
                    return
                if len(raw) > V2_STREAM_LINE_MAX:
                    raise V2Error("too_large", None, "an event line over %d bytes was refused" % V2_STREAM_LINE_MAX)
                yield raw.decode("utf-8", "replace").rstrip("\r\n")
        finally:
            try:
                conn.close()
            except OSError:
                pass

    def close(self):
        conn, self._conn = self._conn, None
        if conn is not None:
            try:
                conn.close()
            except OSError:
                pass

    def request(self, method, target, body=None):
        """(status, text). Raises V2Unreachable (use the CLI) or V2Error (timeout, too large, or a write whose fate is unknown)."""
        with self._lock:
            for attempt in (0, 1):
                if self._info is None:
                    self._load()
                try:
                    return self._once(method, target, body)
                except _V2Unauthorized:
                    self._info = None   # the service restarted with a new password: read the file again, once
                    self.close()
                    if attempt:
                        raise V2Unreachable("the service refused the password twice") from None
                except V2Error:
                    raise
                except (OSError, http.client.HTTPException) as err:
                    self.close()
                    if isinstance(err, socket.timeout):
                        raise V2Error("timeout", None, "no answer within %ss" % self.timeout) from None
                    if method != "GET" and getattr(err, "sent", True):
                        raise V2Error("unavailable", None, "the service dropped a %s (it may or may not have been received)" % method) from None
                    self._info = None   # it may have moved: read the file again, once
                    if attempt:
                        raise V2Unreachable("the service does not answer") from None
        raise V2Unreachable("the service does not answer")

    @staticmethod
    def _budget(conn, deadline):
        """Give the socket only the time the call has left (connect, send, status line, headers and body all share ONE deadline); none left is a timeout."""
        left = deadline - time.monotonic()
        if left <= 0:
            raise socket.timeout("the call did not finish within its total time")
        sock = getattr(conn, "sock", None)
        if sock is not None and hasattr(sock, "settimeout"):
            sock.settimeout(left)

    @staticmethod
    def _read_body(response, conn, deadline):
        """The whole reply body, at most V2_HTTP_MAX_BODY + 1 bytes, within a TOTAL deadline: each socket operation has its own timeout, so a service
        that answers a byte at a time could otherwise hold the one client far longer than `timeout`."""
        chunks, size = [], 0
        while size <= V2_HTTP_MAX_BODY:
            V2Http._budget(conn, deadline)
            chunk = response.read(min(65536, V2_HTTP_MAX_BODY + 1 - size))
            if not chunk:
                break
            chunks.append(chunk)
            size += len(chunk)
        return b"".join(chunks)

    def _once(self, method, target, body):
        deadline = time.monotonic() + self.timeout
        host, port, auth = self._info
        reuse = method == "GET" and self._conn is not None
        conn = self._conn if reuse else self.connect(host if ":" not in host else "[%s]" % host, port, timeout=self.timeout)
        headers = {"Authorization": auth, "Accept": "application/json"}
        data = None
        if body is not None:
            data = json.dumps(body, separators=(",", ":"), sort_keys=True).encode("utf-8")
            headers["Content-Type"] = "application/json"
        sent = False
        try:
            if conn.sock is None:
                conn.connect()
            sent = True   # from here on a write may have reached the service
            self._budget(conn, deadline)
            conn.request(method, target, body=data, headers=headers)
            self._budget(conn, deadline)
            response = conn.getresponse()
            raw = self._read_body(response, conn, deadline)
        except (OSError, http.client.HTTPException) as err:
            try:
                conn.close()
            except OSError:
                pass
            if conn is self._conn:
                self._conn = None
            err.sent = sent
            raise
        if len(raw) > V2_HTTP_MAX_BODY:
            conn.close()
            self._conn = None
            raise V2Error("too_large", None, "a reply over %d bytes was refused" % V2_HTTP_MAX_BODY)
        if response.status == 401:
            conn.close()
            self._conn = None
            raise _V2Unauthorized()
        if method == "GET" and not response.will_close:
            self._conn = conn
        else:
            conn.close()
            if conn is self._conn:
                self._conn = None
        return response.status, raw.decode("utf-8", "replace")


class _V2Unauthorized(Exception):
    pass


class V2Breaker:
    """Latency-driven backoff for the calls to the service (see the section comment). `allows(essential)` returns False (skip the call), True, or
    "probe" (go, and tell `record` or `abandon` it was the probe); `record(seconds, timed_out, probe)` returns an event or None:
    {"event": "v2.backoff", "episode", "reason", "seconds"} when it opens, {"event": "v2.resume", "episode"} when it closes. One lock guards all
    of it: the daemon has threads and one client."""

    def __init__(self, clock=time.monotonic):
        self.clock = clock
        self.lock = threading.Lock()
        self.samples = []
        self.timeouts = 0
        self.state = "closed"      # closed | open (waiting) | probing
        self.until = 0.0
        self.level = 0
        self.good = 0
        self.episode = 0
        self.skipped = 0
        self.probe_out = False

    def p95(self):
        with self.lock:
            return self._p95()

    def _p95(self):
        if not self.samples:
            return None
        ordered = sorted(self.samples)
        return ordered[min(len(ordered) - 1, int(math.ceil(0.95 * len(ordered))) - 1)]

    def allows(self, essential):
        """Whether this call may go now. Essential calls always may; an optional one waits out the backoff, then one probe at a time."""
        with self.lock:
            if self.state == "closed":
                return True
            if essential:
                return True
            if self.state == "open" and self.clock() >= self.until and not self.probe_out:
                self.state, self.probe_out = "probing", True
                return "probe"
            if self.state == "probing" and not self.probe_out:
                self.probe_out = True
                return "probe"
            self.skipped += 1
            return False

    def abandon(self):
        """The probe call ended in something that is not an answer or a timeout (a bug, an interrupt): free the probe slot, learn nothing."""
        with self.lock:
            self.probe_out = False

    def record(self, seconds, timed_out, probe=False):
        with self.lock:
            return self._record(seconds, timed_out, probe)

    def _record(self, seconds, timed_out, probe):
        slow = timed_out or seconds > V2_SLOW_SECONDS
        if probe and self.state == "probing":
            self.probe_out = False
            if slow:
                self.level += 1
                self.state, self.good, self.until = "open", 0, self.clock() + self._wait()
                return {"event": "v2.backoff", "episode": self.episode, "reason": "a probe was slow or timed out", "seconds": int(self._wait())}
            self.good += 1
            if self.good >= V2_RECOVER_OK:
                self.state, self.level, self.good, self.samples, self.timeouts = "closed", 0, 0, [], 0
                return {"event": "v2.resume", "episode": self.episode}
            return None
        self.samples = (self.samples + [seconds])[-V2_SLOW_WINDOW:]
        self.timeouts = self.timeouts + 1 if timed_out else 0
        if self.state != "closed":
            return None   # an essential call during a backoff: it is recorded, it changes nothing (and is never mistaken for the probe)
        reason = None
        if self.timeouts >= V2_TIMEOUT_STREAK:
            reason = "%d calls in a row timed out" % self.timeouts
        elif len(self.samples) >= V2_SLOW_MIN_SAMPLES and self._p95() > V2_SLOW_SECONDS:
            reason = "p95 latency %.1f s is over %g s" % (self._p95(), V2_SLOW_SECONDS)
        if reason is None:
            return None
        self.episode += 1
        self.level, self.good, self.state = 0, 0, "open"
        self.until = self.clock() + self._wait()
        return {"event": "v2.backoff", "episode": self.episode, "reason": reason, "seconds": int(self._wait())}

    def _wait(self):
        return min(V2_BACKOFF_MAX, V2_BACKOFF_BASE * (2 ** self.level))


class V2Client:
    """The one client for OpenCode v2. A call goes over HTTP to the background service when it can (see the transport section above), else
    through `<binary> api <operation>`; every call is counted (one record, with its transport) and timed by the breaker."""

    DELIVERIES = ("queue", "steer")
    ORDERS = ("desc", "asc")

    def __init__(self, binary, env=None, runner=subprocess.run, timeout=20, clock=time.time, http=None, monotonic=time.monotonic, transport="auto"):
        self.binary = binary
        self.env = dict(env or {})
        self.runner = runner
        self.timeout = timeout
        self.clock = clock
        self.monotonic = monotonic   # durations of calls, for the breaker: never the wall clock
        self.breaker = V2Breaker(monotonic)
        self.on_event = None      # callable(name, detail): the engine's audit of `v2.backoff` and `v2.resume`
        self.state_dir = None     # set for the daemon: where `v2-link.json` (what `status` shows) is written
        self.calls = collections.deque(maxlen=V2_CALLS_KEEP_MAX)   # (time, operation, transport) of the last V2_CALLS_KEEP_SECONDS (and at most V2_CALLS_KEEP_MAX): the calls-per-minute figures
        self.calls_lock = threading.Lock()   # the daemon has threads (the judge socket, the forwarders): one list, one lock
        self.count_errors = 0   # accounting that failed; a call never fails for it
        self._link_written = 0.0
        self._link_lock = threading.Lock()
        if http is None and transport == "auto" and runner is subprocess.run and os.environ.get("FLEET_SWITCHBOARD_V2_CLI") != "1" and os.access(str(binary), os.X_OK):
            merged = dict(os.environ)
            merged.update(self.env)
            http = V2Http(v2_service_file(merged), timeout)   # a real run only: a fake runner stands for the CLI
        self.http = http

    def count_call(self, operation, transport="cli"):
        """Remember one call and the way it travelled ("http", "cli", or "cli-fallback": the CLI after the HTTP route could not serve it).
        NEVER raises: accounting is evidence, a v2 call must not fail because of it."""
        try:
            now = self.clock()
            with self.calls_lock:
                self.calls.append((now, operation, transport))
                while self.calls and self.calls[0][0] < now - V2_CALLS_KEEP_SECONDS:
                    self.calls.popleft()
        except Exception:
            self.count_errors += 1

    def _recent(self, window, now):
        now = self.clock() if now is None else now
        with self.calls_lock:
            remembered = list(self.calls)
        return [call for call in remembered if call[0] >= now - window]

    def calls_by_operation(self, window=60.0, now=None):
        """{operation: calls} over the last `window` seconds (this process's own calls, whatever the transport)."""
        return dict(collections.Counter(call[1] for call in self._recent(window, now)))

    def calls_by_transport(self, window=60.0, now=None):
        """{transport: calls} over the last `window` seconds: how many went over HTTP, through the CLI, or through the CLI after a fallback."""
        return dict(collections.Counter(call[2] for call in self._recent(window, now)))

    def _call(self, operation, params=None, data=None, envelope=False):
        refuse_real_opencode_under_test(self.runner, self.binary)
        ticket = self.breaker.allows(self._is_essential(operation, params))
        if not ticket:
            raise V2Error("backoff", None, "%s skipped: the service is slow, optional reads wait (v2.backoff)" % operation)
        started = self.monotonic()
        try:
            text = self._transport(operation, params, data)
        except V2Error as err:
            self._record(self.monotonic() - started, err.reason == "timeout", ticket == "probe")
            raise
        except BaseException:
            if ticket == "probe":
                self.breaker.abandon()   # not an answer: free the probe slot, or optional reads would wait for ever
            raise
        self._record(self.monotonic() - started, False, ticket == "probe")
        return self._decode(operation, text, envelope)

    def _is_essential(self, operation, params=None):
        spec = V2_HTTP_OPERATIONS.get(operation)
        if spec is None or spec[0] != "GET" or operation in V2_ESSENTIAL_READS:
            return True
        return operation == "session.message.list" and (params or {}).get("type") in ("synthetic", "user")   # the delivery rule's key read, and the person-is-typing read every observation (so every re-check before a write) makes

    def _record(self, seconds, timed_out, probe=False):
        event = self.breaker.record(seconds, timed_out, probe)
        if event is not None and self.on_event is not None:
            try:
                self.on_event(event["event"], {k: v for k, v in event.items() if k != "event"})
            except Exception:   # an audit trouble never fails a call, but it is counted
                self.count_errors += 1
        self._write_link(event is not None)

    def _write_link(self, forced=False):
        """What `status` shows of the link, written by the daemon only, at most once a minute unless the breaker changed."""
        if self.state_dir is None:
            return
        with self._link_lock:   # the daemon has threads: one writer at a time, and the once-a-minute check is part of it
            self._write_link_locked(forced)

    def _write_link_locked(self, forced):
        moment = self.clock()
        if not forced and moment - self._link_written < V2_LINK_WRITE_SECONDS:
            return
        self._link_written = moment
        by = self.calls_by_transport(V2_CALLS_KEEP_SECONDS)
        body = {"at": int(moment), "transport": "http" if self.http is not None else "cli",
                "fallbacks": by.get("cli-fallback", 0), "skipped": self.breaker.skipped,
                "breaker": self.breaker.state, "episodes": self.breaker.episode,
                "p95_ms": None if self.breaker.p95() is None else int(self.breaker.p95() * 1000)}
        try:
            state_write(Path(self.state_dir) / V2_LINK_STATUS_FILE, json.dumps(body, sort_keys=True), _without(body, "at"), STATE_HEARTBEAT_SECONDS)
        except OSError:
            self.count_errors += 1   # a status line is best effort; the failure is counted, and the line shows its own age

    def _transport(self, operation, params, data):
        """The reply text of one call: over HTTP when the service answers, else through the CLI (which also starts a stopped service)."""
        spec = V2_HTTP_OPERATIONS.get(operation)
        if self.http is not None and spec is not None:
            target = self._target(spec, params)
            if target is not None:
                try:
                    status, text = self.http.request(spec[0], target, data)
                except V2Unreachable:
                    self.count_call(operation, "cli-fallback")   # the HTTP route reached nothing: the CLI call is the one that counts
                    return self._cli(operation, params, data)
                except V2Error:
                    self.count_call(operation, "http")           # it reached the service (a timeout, a refused size, a dropped write)
                    raise
                self.count_call(operation, "http")
                if status >= 400:
                    raise V2Error("http", status, _one_line(text) or "HTTP %d" % status)
                return text
        self.count_call(operation, "cli")
        return self._cli(operation, params, data)

    @staticmethod
    def _target(spec, params):
        """The request path and query of one call, or None when a parameter is one the table does not know (then the CLI decides)."""
        method, template, path_names, query_names = spec
        given = {name: value for name, value in (params or {}).items() if value is not None}
        if set(given) - set(path_names) - set(query_names) or any(name not in given for name in path_names):
            return None
        path = template
        for name in path_names:
            path = path.replace("{%s}" % name, urllib.parse.quote(str(given[name]), safe=""))
        query = [(name, str(given[name])) for name in query_names if name in given]
        return path + ("?" + urllib.parse.urlencode(query) if query else "")

    def _cli(self, operation, params, data):
        argv = [self.binary, "api", operation]
        for name, value in (params or {}).items():
            if value is not None:
                argv += ["--param", "%s=%s" % (name, value)]
        if data is not None:
            argv += ["-d", json.dumps(data, separators=(",", ":"), sort_keys=True)]
        env = dict(os.environ)
        env.update(self.env)
        env.update(NO_CREDENTIAL_DIALOG_ENV)   # #1050: the service and a headless worker's tools never open a credential dialog
        # OpenCode v2's `api` command loses the end of a large reply when it writes to a pipe and exits
        # (a real 500 KB transcript arrived cut at 293 KB, inside a string, and every read failed with
        # bad_json). Into a file the reply is whole, so the reply goes to a file and is read back.
        with tempfile.TemporaryFile(mode="w+", encoding="utf-8") as sink:
            try:
                result = self.runner(argv, stdout=sink, stderr=subprocess.PIPE, text=True, timeout=self.timeout,
                                     env=env, stdin=subprocess.DEVNULL)
            except subprocess.TimeoutExpired:
                raise V2Error("timeout", None, "%s did not answer within %ss" % (operation, self.timeout)) from None
            except OSError as err:
                raise V2Error("unavailable", None, "cannot run %s: %s" % (self.binary, err.strerror or err)) from None
            stdout = result.stdout
            if stdout is None:  # a real run wrote to the file
                sink.seek(0)
                stdout = sink.read()
        stdout = stdout or ""
        stderr = result.stderr or ""
        if result.returncode != 0:
            match = re.search(r"\bHTTP (\d{3})\b", stderr)
            if match:
                # v2 put the error body on stdout and `HTTP <code> <reason>` on stderr.
                raise V2Error("http", int(match.group(1)), _one_line(stdout) or _one_line(stderr))
            raise V2Error("exit", None, _one_line(stderr) or _one_line(stdout) or "exit %d" % result.returncode)
        return stdout

    @staticmethod
    def _decode(operation, stdout, envelope):
        if not (stdout or "").strip():
            return None
        try:
            body = json.loads(stdout)
        except ValueError:
            raise V2Error("bad_json", None, "%s returned non-JSON: %s" % (operation, _one_line(stdout, 120))) from None
        if isinstance(body, dict) and "data" in body:
            return body if envelope else body["data"]  # PR 8: paging needs the cursor beside the data
        return body

    @staticmethod
    def _limit(limit):
        """A page of a transcript is never larger than V2_READ_LIMIT_MAX messages, whatever a caller asks."""
        return min(limit, V2_READ_LIMIT_MAX) if isinstance(limit, int) and not isinstance(limit, bool) else limit

    def service_identity(self):
        """The service's process id (changes when it restarts), or None (the CLI transport, no readable service file, or the process is gone)."""
        return self.http.service_identity() if self.http is not None and hasattr(self.http, "service_identity") else None

    def service_url(self):
        """Where the service is, `http://127.0.0.1:<port>`, or None (the CLI transport, or no readable service file)."""
        return self.http.base_url() if self.http is not None and hasattr(self.http, "base_url") else None

    def server_info(self):
        return self._call("server.info")

    def session_create(self, agent, title, directory, metadata, permissions=None):
        if not os.path.isabs(directory):
            raise ValueError("directory must be absolute: %r" % directory)
        data = {"agent": agent, "title": title, "location": {"directory": directory},
                "metadata": metadata}
        if permissions is not None:
            data["permissions"] = permissions
        return self._call("session.create", data=data)

    def session_get(self, session_id):
        return self._call("session.get", {"sessionID": session_id})

    def session_active(self):
        return self._call("session.active")

    def session_remove(self, session_id):
        """`session.remove`: delete a session (DELETE /api/session/{sessionID}, an empty answer; 404 SessionNotFoundError when it is gone).
        Used only to undo a launch that failed after it created its session."""
        return self._call("session.remove", {"sessionID": session_id})

    def message_list(self, session_id, limit=None, order=None, type=None, cursor=None):
        if order is not None and order not in self.ORDERS:
            raise ValueError("order must be one of %s" % ", ".join(self.ORDERS))
        return self._call("session.message.list", {
            "sessionID": session_id, "limit": self._limit(limit), "order": order, "type": type, "cursor": cursor})

    def message_page(self, session_id, limit=None, type=None, cursor=None):
        """PR 8: one page of `session.message.list` with its cursor: (messages, cursor).

        `cursor` is v2's `{"previous": .., "next": ..}` object, or None when the
        answer carries none. A cursor argument is v2's opaque token and fixes the
        order, so no `order` is taken here (v2: do not combine them).
        """
        if cursor is not None and (not isinstance(cursor, str) or not cursor or len(cursor) > CURSOR_LIMIT):
            raise ValueError("cursor must be v2's opaque token (a non-empty string), got %r" % (cursor,))
        body = self._call("session.message.list", {
            "sessionID": session_id, "limit": self._limit(limit), "type": type, "cursor": cursor}, envelope=True)
        if isinstance(body, dict):
            found = body.get("cursor")
            return (body["data"] if isinstance(body.get("data"), list) else []), \
                (found if isinstance(found, dict) else None)
        return (body if isinstance(body, list) else []), None

    def message_pages(self, session_id, limit, type=None, max_pages=1):
        """PR 8: the pages of one listing, newest first, following `cursor.next`.

        UNVERIFIED: that `next` moves to older messages in a newest-first
        listing; the Lab's paging spike must show it. Yields (messages, more):
        `more` is True while v2 names a next cursor, False when it says there is
        none, None when the answer carries no cursor at all. The walk ends after
        a False or None, or after `max_pages`. A continuation that is empty or
        repeats a message already seen means the cursor does not walk the
        listing as assumed: that raises, and the caller holds.
        """
        cursor, seen = None, set()
        for number in range(max_pages):
            page, found = self.message_page(session_id, limit, type, cursor)
            ids = [m.get("id") for m in page if isinstance(m, dict)]
            if number and not page:
                # v2 names a `next` cursor even when the page it just gave held the whole listing (measured:
                # 104 messages at limit 200); following it answers an empty page. That is the end, not a
                # cursor that fails to walk older.
                yield [], False
                return
            if number and any(i in seen for i in ids):
                raise V2Error("bad_json", None, "session.message.list: the next page repeated "
                                                "a message; the cursor does not walk older as assumed")
            seen.update(ids)
            cursor = found.get("next") if found else None
            more = None if found is None else bool(cursor)
            yield page, more
            if not more:
                return

    def synthetic(self, session_id, text, metadata, resume, delivery, message_id, description=None):
        """`description` is the one human line the TUI shows for this message (`session.synthetic` takes it,
        measured in PR 13): at most DESCRIPTION_MAX characters, one line. Every message the switchboard writes
        carries one."""
        if description is not None and not valid_description(description):
            raise ValueError("description must be one non-empty line of at most %d characters: %r"
                             % (DESCRIPTION_MAX, description))
        if not isinstance(resume, bool):
            raise ValueError("resume must be true or false")
        if delivery not in self.DELIVERIES:
            raise ValueError("delivery must be one of %s" % ", ".join(self.DELIVERIES))
        if not isinstance(message_id, str) or not message_id.startswith("msg_"):
            raise ValueError("message id must start with msg_: %r" % message_id)
        body = {"id": message_id, "text": text, "metadata": metadata, "resume": resume, "delivery": delivery}
        if description is not None:
            body["description"] = description
        return self._call("session.synthetic", {"sessionID": session_id}, body)

    def interrupt(self, session_id, resume=False):
        """`session.interrupt`: abort the active execution (the Escape key). VERIFIED in a throwaway v2 2.0.24:
        the in-flight tool call is cut (state error, aborted), the answer is {"interrupted": true} (false when
        idle), and with `resume` false nothing runs after it: a steering input waiting stays in the inbox."""
        return self._call("session.interrupt", {"sessionID": session_id, "resume": "true" if resume else "false"})

    def prompt(self, session_id, text, metadata=None, delivery=None, resume=None):
        if delivery is not None and delivery not in self.DELIVERIES:
            raise ValueError("delivery must be one of %s" % ", ".join(self.DELIVERIES))
        data = {"text": text}
        for name, value in (("metadata", metadata), ("delivery", delivery), ("resume", resume)):
            if value is not None:
                data[name] = value
        return self._call("session.prompt", {"sessionID": session_id}, data)

    def inbox_list(self, session_id):
        return self._call("session.inbox.list", {"sessionID": session_id})

    def permission_list(self, session_id):
        """The session's pending permission requests (S2: `session.permission.list`
        works with the session id alone; `permission.request.list` needs a location)."""
        return self._call("session.permission.list", {"sessionID": session_id})

    def form_list(self, session_id):
        """The session's pending forms (questions): `session.form.list`, an array of {id, sessionID, title,
        fields: [{key, type, title, ...}]} (VERIFIED in a throwaway v2 2.0.24, PR 18)."""
        return self._call("session.form.list", {"sessionID": session_id})

    def permission_reply(self, session_id, request_id, decision, message=None):
        """PR 18: answer a pending permission request: `decision` is `once`, `always` or `reject`, `message` a
        reason (VERIFIED in a throwaway v2 2.0.24: POST /api/session/{sessionID}/permission/{requestID}/reply,
        body {"decision", "message"}; an empty answer; 404 PermissionNotFoundError once answered)."""
        if decision not in ("once", "always", "reject"):
            raise ValueError("decision must be once, always or reject")
        data = {"decision": decision}
        if message:
            data["message"] = message
        return self._call("session.permission.reply", {"sessionID": session_id, "requestID": request_id}, data)

    def form_reply(self, session_id, form_id, answer):
        """PR 18: answer a pending form (a question): `answer` maps each field's key to its value (VERIFIED in a
        throwaway v2 2.0.24: POST /api/session/{sessionID}/form/{formID}/reply, body {"answer": {key: value}};
        an empty answer; the form then reads `state.status` answered)."""
        return self._call("session.form.reply", {"sessionID": session_id, "formID": form_id}, {"answer": dict(answer)})

    def inbox_update(self, session_id, inbox_id, delivery):
        if delivery not in self.DELIVERIES:
            raise ValueError("delivery must be one of %s" % ", ".join(self.DELIVERIES))
        return self._call("session.inbox.update", {"sessionID": session_id, "inboxID": inbox_id},
                          {"delivery": delivery})


# ------------------------------------------------------------------- herdr

class HerdrError(Exception):
    """A herdr call that did not return usable JSON."""

    def __init__(self, reason, detail=None):
        self.reason = reason
        self.detail = detail
        super().__init__("%s: %s" % (reason, detail) if detail else reason)


def herdr_socket_path(environ=None):
    """Where herdr listens: $HERDR_SOCKET_PATH, else herdr.sock in its config directory."""
    environ = os.environ if environ is None else environ
    if environ.get("HERDR_SOCKET_PATH"):
        return environ["HERDR_SOCKET_PATH"]
    base = environ.get("XDG_CONFIG_HOME")
    root = Path(base) if base and os.path.isabs(base) else Path.home() / ".config"
    return str(root / "herdr" / "herdr.sock")


def unix_socket_call(path, method, params, timeout=HERDR_CALL_TIMEOUT):
    """One request to herdr's socket API: a JSON line out, a JSON line back."""
    request = json.dumps({"id": "%s:%s" % (PROG, method), "method": method, "params": params},
                         separators=(",", ":")) + "\n"
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as conn:
            conn.settimeout(timeout)
            conn.connect(path)
            conn.sendall(request.encode("utf-8"))
            reply = b""
            while not reply.endswith(b"\n"):
                chunk = conn.recv(65536)
                if not chunk:
                    break
                reply += chunk
    except socket.timeout:
        raise HerdrError("timeout", "herdr's socket did not answer within %ss" % timeout) from None
    except OSError as err:
        raise HerdrError("unavailable", "cannot reach herdr's socket %s: %s" % (path, err.strerror or err)) from None
    try:
        return json.loads(reply.decode("utf-8"))
    except ValueError:
        raise HerdrError("bad_json", "herdr's socket returned non-JSON: %s" % _one_line(reply.decode("utf-8", "replace"), 120)) from None


TOKEN_NAME = re.compile(r"^[A-Za-z0-9_-]{1,32}$")
TOKEN_VALUE_MAX = 80
TITLE_MAX, BODY_MAX = 80, 240  # herdr's own caps on a toast


class HerdrClient:
    """Reads agents and panes, sets a badge, shows a toast, opens a tab that
    runs a program directly, and closes a pane `launch` itself opened.

    herdr is never a delivery channel (docs/switchboard.md, the herdr table's
    "never" row). This class deliberately has no method that types into a pane
    or moves focus, and no general way to run an arbitrary herdr command. Its
    one socket method, `layout.apply`, execs a program with argv in a new pane:
    there is no shell, so nothing is typed, and no focus key is ever sent.
    """

    SOURCE = PROG
    SOCKET_METHODS = ("layout.apply",)

    def __init__(self, binary, runner=subprocess.run, timeout=HERDR_CALL_TIMEOUT, socket_call=None,
                 socket_path=None):
        self.binary = binary
        self.runner = runner
        self.timeout = timeout
        self.socket_call = socket_call or unix_socket_call
        self.socket_path = socket_path

    def _call(self, *args):
        argv = [self.binary, *args]
        try:
            result = self.runner(argv, capture_output=True, text=True, timeout=self.timeout,
                                 stdin=subprocess.DEVNULL)
        except subprocess.TimeoutExpired:
            raise HerdrError("timeout", "herdr did not answer within %ss" % self.timeout) from None
        except OSError as err:
            raise HerdrError("unavailable", "cannot run %s: %s" % (self.binary, err.strerror or err)) from None
        if result.returncode != 0:
            raise HerdrError("exit", _one_line(result.stderr) or _one_line(result.stdout)
                             or "exit %d" % result.returncode)
        if not (result.stdout or "").strip():
            return None
        try:
            return json.loads(result.stdout)
        except ValueError:
            raise HerdrError("bad_json", "herdr returned non-JSON: %s" % _one_line(result.stdout, 120)) from None

    def _socket(self, method, params):
        if method not in self.SOCKET_METHODS:
            raise ValueError("herdr socket method not allowed: %r" % method)
        reply = self.socket_call(self.socket_path or herdr_socket_path(), method, params, self.timeout)
        if isinstance(reply, dict) and reply.get("error"):
            raise HerdrError("exit", _one_line(json.dumps(reply["error"], sort_keys=True)))
        return reply

    @staticmethod
    def _result(body, field, kind):
        value = (body or {}).get("result", {}).get(field) if isinstance(body, dict) else None
        if not isinstance(value, kind):
            raise HerdrError("bad_shape", "expected result.%s in herdr's reply" % field)
        return value

    def agent_list(self):
        return self._result(self._call("agent", "list"), "agents", list)

    def tab_list(self):
        return self._result(self._call("tab", "list"), "tabs", list)

    def agent_get(self, target):
        return self._result(self._call("agent", "get", target), "agent", dict)

    def pane_process_info(self, pane):
        """The foreground processes of a pane: [{"cmdline": ..., "name": ...}, ...]."""
        info = self._result(self._call("pane", "process-info", "--pane", pane), "process_info", dict)
        processes = info.get("foreground_processes")
        if not isinstance(processes, list):
            raise HerdrError("bad_shape", "expected foreground_processes in herdr's reply")
        return [p for p in processes if isinstance(p, dict)]

    def pane_report_metadata_token(self, pane, name, value, ttl_ms=None):
        if not TOKEN_NAME.match(str(name)):
            raise ValueError("token name must match %s: %r" % (TOKEN_NAME.pattern, name))
        value = str(value)
        if not value.strip() or len(value) > TOKEN_VALUE_MAX:
            raise ValueError("token value must be 1-%d characters" % TOKEN_VALUE_MAX)
        args = ["pane", "report-metadata", pane, "--source", self.SOURCE, "--token", "%s=%s" % (name, value)]
        if ttl_ms is not None:
            args += ["--ttl-ms", str(int(ttl_ms))]
        return self._call(*args)

    def pane_clear_token(self, pane, name):
        if not TOKEN_NAME.match(str(name)):
            raise ValueError("token name must match %s: %r" % (TOKEN_NAME.pattern, name))
        return self._call("pane", "report-metadata", pane, "--source", self.SOURCE, "--clear-token", name)

    def notification_show(self, title, body=None):
        """Show a toast. Returns {"shown": bool, "reason": ...}: herdr answers
        even when it shows nothing (rate_limited, busy, no_foreground_client, disabled)."""
        args = ["notification", "show", str(title)[:TITLE_MAX]]
        if body:
            args += ["--body", str(body)[:BODY_MAX]]
        body = self._call(*args)
        shown = self._result(body, "shown", bool)
        reason = body["result"].get("reason")
        return {"shown": shown, "reason": reason if isinstance(reason, str) else None}

    def pane_close(self, pane):
        return self._call("pane", "close", pane)

    def pane_list(self):
        """Every pane herdr has, agent or plain terminal: [{"pane_id", "cwd", "foreground_cwd", ...}] (one read)."""
        return self._result(self._call("pane", "list"), "panes", list)

    def pane_get(self, pane):
        """One pane as herdr shows it: {"pane_id", "workspace_id", "tab_id", "cwd", "terminal_title_stripped", "agent_status", ...}."""
        return self._result(self._call("pane", "get", pane), "pane", dict)

    def pane_read_visible(self, pane, lines=12):
        """The last `lines` rows of what the pane shows on screen, as text. Reads only: nothing is typed and no key is sent."""
        argv = [self.binary, "pane", "read", pane, "--source", "visible", "--lines", str(int(lines))]
        try:
            result = self.runner(argv, capture_output=True, text=True, timeout=self.timeout, stdin=subprocess.DEVNULL)
        except subprocess.TimeoutExpired:
            raise HerdrError("timeout", "herdr did not answer within %ss" % self.timeout) from None
        except OSError as err:
            raise HerdrError("unavailable", "cannot run %s: %s" % (self.binary, err.strerror or err)) from None
        if result.returncode != 0:
            raise HerdrError("exit", _one_line(result.stderr) or _one_line(result.stdout) or "exit %d" % result.returncode)
        return (result.stdout or "")[:PANE_READ_MAX]

    def tab_get(self, tab):
        """One tab as herdr shows it: {"tab_id", "pane_count", ...}."""
        return self._result(self._call("tab", "get", tab), "tab", dict)

    def tab_close(self, tab):
        """Close a tab (herdr closes its panes): only ever one the switchboard has proved is a stale, session-less screen."""
        return self._call("tab", "close", tab)

    def workspace_list(self):
        """PR 16: every workspace, as herdr lists them: [{"workspace_id", "label", ...}]."""
        return self._result(self._call("workspace", "list"), "workspaces", list)

    def workspace_create(self, cwd, label, focus=True):
        """PR 16: a new workspace, focused: `bootstrap` opens the Chief of Staff where the person is looking.
        The only call here that can take focus, and only a person's own command makes it (`focus=False` asks
        for `--no-focus`, for scripts and trials). Returns {"workspace_id", "root_pane"}: the empty shell pane
        herdr opens with it (None when it names none)."""
        body = self._call("workspace", "create", "--cwd", cwd, "--label", label, "--focus" if focus else "--no-focus")
        workspace = self._result(body, "workspace", dict)
        if not isinstance(workspace.get("workspace_id"), str):
            raise HerdrError("bad_shape", "expected result.workspace.workspace_id in herdr's reply")
        root = (body["result"].get("root_pane") or {}).get("pane_id")
        return {"workspace_id": workspace["workspace_id"], "root_pane": root if isinstance(root, str) else None}

    def open_tab_running(self, workspace, label, cwd, argv, env):
        """A new tab in `workspace` whose one pane execs `argv` directly. Never
        types, never takes focus. Returns {"tab_id", "pane_id"}."""
        # A pane is an AGENT's: the marker a switchboard process carries for its own gh calls must not reach it (the gh shim would then skip
        # the per-repo account), so it is named here with an empty value, which the shim does not read as set; an inherited one is overridden.
        pane_env = dict(env, **{OWN_GH_ENV: ""})
        reply = self._socket("layout.apply", {
            "workspace_id": workspace, "tab_label": label,
            "root": {"type": "pane", "label": label, "cwd": cwd, "command": list(argv), "env": pane_env}})
        layout = (reply or {}).get("result", {}).get("layout") if isinstance(reply, dict) else None
        root = layout.get("root") if isinstance(layout, dict) else None
        pane, tab = (root or {}).get("pane_id"), layout.get("tab_id") if isinstance(layout, dict) else None
        if not isinstance(pane, str) or not isinstance(tab, str):
            raise HerdrError("bad_shape", "expected layout.tab_id and layout.root.pane_id in herdr's reply")
        return {"tab_id": tab, "pane_id": pane}


# ------------------------------------------------------------------ the facts

class FactError(ValueError):
    """A fact that cannot be used: a missing field, or a value of the wrong type."""


DISK_GUARD_DEFAULTS = {"min_free_gb": 50, "hard_free_gb": 10}
DISK_REARM_PERCENT = 110                # an episode ends when the free space is back at the threshold plus 10% (integer arithmetic: 50 * 1.1 is 55.00000000000001)
DISK_GUARD_FILE = "disk-guard.json"     # {"low": bool, "episode": <epoch the episode began>, "hard": bool}: so a restart does not start a second episode


def validate_disk_guard(raw, source):
    """`disk_guard`: absent or null = the defaults; false = off; else {"min_free_gb", "hard_free_gb"} (numbers, hard at most min)."""
    if raw is None or raw is False:
        return
    if not isinstance(raw, dict):
        raise ConfigError("%s: 'disk_guard' must be false, null or an object, got %r" % (source, raw))
    unknown = sorted(set(raw) - set(DISK_GUARD_DEFAULTS))
    if unknown:
        raise ConfigError("%s: 'disk_guard' has unknown key(s) %s (it takes %s)" % (source, ", ".join(unknown), ", ".join(DISK_GUARD_DEFAULTS)))
    for key, value in raw.items():
        if not _is_number(value) or value < 0:
            raise ConfigError("%s: 'disk_guard.%s' must be a number of gigabytes of at least 0, got %r" % (source, key, value))
    merged = dict(DISK_GUARD_DEFAULTS, **raw)
    if merged["hard_free_gb"] > merged["min_free_gb"]:
        raise ConfigError("%s: 'disk_guard.hard_free_gb' (%r) must not be more than 'min_free_gb' (%r)" % (source, merged["hard_free_gb"], merged["min_free_gb"]))


def disk_guard_settings(config):
    """{"min_free_gb", "hard_free_gb"}, or None when the guard is off."""
    raw = config.get("disk_guard")
    if raw is False:
        return None
    return dict(DISK_GUARD_DEFAULTS, **(raw or {}))


def disk_free(path):
    """(free bytes, total bytes) of the volume holding `path`: ONE stat, no walk; None when it cannot be read."""
    try:
        usage = shutil.disk_usage(str(path))
    except OSError:
        return None
    return usage.free, usage.total


def disk_status_line(config, state_dir):
    """`238 GB free (24%)`, with LOW and the thresholds when below the guard; None when the volume cannot be read."""
    found = disk_free(state_dir)
    if found is None:
        return None
    free, total = found
    gb = free / 1e9
    line = "%d GB free (%d%%)" % (gb, round(100.0 * free / total)) if total else "%d GB free" % gb
    guard = disk_guard_settings(config)
    if guard is not None and gb < guard["min_free_gb"]:
        line += ": %s (below %g GB; hard line %g GB)" % ("VERY LOW" if gb < guard["hard_free_gb"] else "LOW", guard["min_free_gb"], guard["hard_free_gb"])
    return line


class DiskFacts:
    """The disk guard: ONE `disk_usage` of the state directory's volume per pass. Below `disk_guard.min_free_gb` the Chief of Staff is told ONCE for
    the episode (`disk.low:<episode>`, the fact stays pending until delivered and the key is stable, so it is not told again), `disk.low` is
    audited, and the episode ends (`disk.recovered`) when the free space is back above the threshold plus 10%. The episode is kept in `disk-guard.json`
    so a restart does not begin a second one. Reads nothing else: no `du`, no walk."""

    __name__ = "disk_facts"

    def __init__(self):
        self.engine = None
        self.episode = None   # (episode epoch, hard flag) while low, from the file or this process

    def bind(self, engine):
        self.engine = engine

    def _load(self, state_dir):
        try:
            with open(str(Path(state_dir) / DISK_GUARD_FILE)) as handle:
                raw = json.loads(handle.read(4096))   # a few bytes are all it ever holds
            if raw.get("low") and _is_number(raw.get("episode")):
                return float(raw["episode"]), bool(raw.get("hard"))
        except (OSError, ValueError, AttributeError, TypeError):
            pass
        return None

    def _save(self, engine, low, episode, hard):
        try:
            path = Path(engine.state_dir) / DISK_GUARD_FILE   # written only on a change of episode: a handful of times a year
            temp = path.with_name("%s.%d.tmp" % (DISK_GUARD_FILE, os.getpid()))
            fd = os.open(str(temp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
            with os.fdopen(fd, "w") as handle:
                handle.write(json.dumps({"low": bool(low), "episode": episode, "hard": bool(hard)}, sort_keys=True))
                handle.flush()
                os.fsync(handle.fileno())
            os.replace(str(temp), str(path))
        except OSError as err:
            try:
                temp.unlink()
            except (OSError, UnboundLocalError):
                pass
            engine._note("disk.guard_file", None, {"error": _plain("%s: %s" % (type(err).__name__, err), 160)})   # said once per change: after a restart a second episode could begin

    def __call__(self):
        engine = self.engine
        guard = disk_guard_settings(engine.config) if engine is not None else None
        if guard is None or engine.state_dir is None:
            return []
        found = disk_free(engine.state_dir)
        if found is None:   # FAIL OPEN, on purpose: a guard that cannot read the volume says so once (audit) and wakes nobody: a false alarm helps no one
            engine._note("disk.unreadable", None, {"path": str(engine.state_dir)})
            return []
        free_gb, now = found[0] / 1e9, engine.now()
        if self.episode is None:
            self.episode = self._load(engine.state_dir)
        if self.episode is not None and free_gb >= guard["min_free_gb"] * DISK_REARM_PERCENT / 100:
            if engine.audit is not None:   # appended, not `_note`d: a second episode that recovers at the same figure is still news
                engine.audit.append(engine.actor, "disk.recovered", None, {"free_gb": int(free_gb), "min_free_gb": guard["min_free_gb"], "episode": int(self.episode[0])})
            self.episode = None
            self._save(engine, False, None, False)
        discovery = getattr(engine, "discovery", None)
        chiefs = sorted(n for n, o in discovery.agents.items() if (o.fleet or {}).get("role") == "chief-of-staff") if discovery is not None and not discovery.problems else []
        if self.episode is None and free_gb < guard["min_free_gb"] and chiefs:   # an episode begins when there is someone to tell: with no Chief of Staff running, the next pass tries again
            self.episode = (now, free_gb < guard["hard_free_gb"])
            if engine.audit is not None:
                engine.audit.append(engine.actor, "disk.low", None, {"free_gb": int(free_gb), "min_free_gb": guard["min_free_gb"],
                                                                      "hard_free_gb": guard["hard_free_gb"], "hard": self.episode[1]})
            self._save(engine, True, now, self.episode[1])
        if self.episode is None:
            return []
        episode, hard = self.episode
        if free_gb < guard["hard_free_gb"] and not hard:   # it got worse inside the episode: said in the status line and the audit, not a second wake
            self.episode = (episode, True)
            if engine.audit is not None:
                engine.audit.append(engine.actor, "disk.hard", None, {"free_gb": int(free_gb), "hard_free_gb": guard["hard_free_gb"], "episode": int(episode)})
            self._save(engine, True, episode, True)
        if not chiefs:
            return []
        text = "disk low: %d GB free on the volume holding the state directory (the guard is %g GB, hard line %g GB). `%s disk prune --dry-run` shows what would be " \
               "pruned (docker build cache and images older than a week, never volumes; it measures the state directory's volume, so check where docker keeps its data)" % (free_gb, guard["min_free_gb"], guard["hard_free_gb"], PROG)
        return [Fact("disk.low:%d" % int(episode), name, "disk", text, episode, sender="switchboard") for name in chiefs]


class SpotlightFacts:
    """The Spotlight guard's fact source (bin/spotlight_guard.py, ask #438). Once an hour a BACKGROUND thread asks `mdfind` (5 s per folder) whether the index holds
    anything under each guarded folder; a pass only collects what the thread has finished, so it starts no process and a slow tool never delays it. A folder
    indexed on two checks in a row begins an episode: ONE wake to the Chief of Staff (`spotlight.lost:<folder>:<episode>`, audited `spotlight.lost`); a zero count
    ends it (`spotlight.recovered`). Writes only `spotlight-guard.json`, and only when an answer changed. Changes no setting."""

    __name__ = "spotlight_facts"

    def __init__(self):
        self.engine = None
        self.tracker = None
        self.thread = None
        self.done = None             # results the thread has finished, not yet stepped
        self.lock = threading.Lock()  # the hand-off of `done`: a result stored while the pass takes the last one is never lost
        self.started = None          # the engine's clock when the last check began
        self.saved = None            # the stable content the file holds
        self.counts = {}             # the last count seen per folder (the wake text names it)

    def bind(self, engine):
        self.engine = engine

    def _start(self, engine, sg, cfg):
        runner = getattr(engine, "spotlight_runner", None)
        folders = list(cfg["folders"])
        self.started = engine.now()

        def work():
            results = sg.check_all(folders, runner)
            with self.lock:
                if self.thread is threading.current_thread():
                    self.done = results
        self.thread = threading.Thread(target=work, name="spotlight-check", daemon=True)
        self.thread.start()

    def _chiefs(self, engine):
        discovery = getattr(engine, "discovery", None)
        return sorted(n for n, o in discovery.agents.items() if (o.fleet or {}).get("role") == "chief-of-staff") if discovery is not None and not discovery.problems else []

    def __call__(self):
        engine = self.engine
        if engine is None or engine.state_dir is None:
            return []
        sg = load_module("spotlight_guard")
        cfg = sg.settings(engine.config.get("spotlight_guard"))
        if cfg is None:
            return []
        if self.tracker is None:
            saved = sg.load(engine.state_dir)
            self.tracker = sg.Tracker((saved or {}).get("folders"))
            self.saved = sg.stable(saved) if saved else None
            self.counts = {f: sg.clean_count(e.get("count")) for f, e in ((saved or {}).get("folders") or {}).items() if isinstance(e, dict)}
        with self.lock:
            results, self.done = self.done, None
        if results:
            self._apply(engine, sg, results)
        facts = self._open(engine, sg, cfg["folders"])   # EVERY pass while an episode is open: the delivery layer batches (a fact must still be pending when the batch is ripe) and dedups by the stable key
        alive = self.thread is not None and self.thread.is_alive()
        if not alive and (self.started is None or engine.now() - self.started >= sg.CHECK_SECONDS):
            self._start(engine, sg, cfg)
        return facts

    def _open(self, engine, sg, folders):
        """The wake of each open episode, one fact per Chief of Staff, the same key and `created` on every pass."""
        chiefs = self._chiefs(engine)
        facts = []
        for folder, episode in sorted(self.tracker.episode.items()):
            if episode is None or not chiefs or folder not in folders:   # a folder no longer guarded wakes nobody
                continue
            text = sg.wake_text(folder, self.counts.get(folder), PROG)
            key = "spotlight.lost:%s:%d" % (hashlib.sha256(folder.encode()).hexdigest()[:10], int(episode))
            facts.extend(Fact(key, name, "spotlight", " ".join(text.split()), episode, sender="switchboard") for name in chiefs)
        return facts

    def _apply(self, engine, sg, results):
        now = engine.now()
        for folder, (state, count) in sorted(results.items()):
            event = self.tracker.step(folder, state, now)
            if count is not None:
                self.counts[folder] = count
            if event == "begin" and engine.audit is not None:
                engine.audit.append(engine.actor, "spotlight.lost", None, {"folder": folder, "count": count})
            elif event == "end" and engine.audit is not None:
                engine.audit.append(engine.actor, "spotlight.recovered", None, {"folder": folder})
        content = sg.body(results, self.tracker, now)
        if self.saved != sg.stable(content):
            try:
                sg.save(engine.state_dir, content)
                self.saved = sg.stable(content)
            except OSError as err:
                engine._note("spotlight.guard_file", None, {"error": _plain("%s: %s" % (type(err).__name__, err), 160)})


class CpuFacts:
    """The CPU and memory guard's fact source (bin/cpu_guard.py): ONE `os.getloadavg()` and the kernel's memory counters per pass, no process. When the load over
    the cores stays above the guard for the configured minutes the Chief of Staff is told ONCE for the episode (`cpu.high:<episode>`: the key is stable, so it is
    delivered once), `cpu.high` is audited, and the wake NAMES THE TOP CONSUMERS by program and by lane (the agent or worktree the process runs in), from ONE
    bounded `ps` and ONE bounded `lsof` run on a thread when the episode begins (never on another pass). The wake is held until they answer or `WAKE_GRACE_SECONDS`
    pass; an answer that comes after the wake went out is sent as ONE follow-up note (`cpu.top:<episode>`), and a `ps` that never answers is said once in the
    wake. The episode ends (`cpu.recovered`) below two thirds of the guard and is kept in `cpu-guard.json`, so a restart does not begin a second one. The same
    pattern guards memory: swap above `swap_percent` for `swap_minutes` wakes once per episode (`mem.high:<episode>`, `mem-guard.json`)."""

    __name__ = "cpu_facts"

    def __init__(self):
        self.engine = None
        self.tracker = None
        self.mem_tracker = None
        self.detail = ""
        self.thread = None
        self.begin_at = None          # the engine's clock when this process began the episode (None: it was loaded from the file)
        self.waked_without = False    # the wake went out while the consumers were still being read
        self.saved_episode = None     # the episode the file holds (None: closed)
        self.saved_mem = None

    def bind(self, engine):
        self.engine = engine

    def _registry(self, engine):
        try:
            return {path: entry.get("agent") for path, entry in read_worktrees(engine.state_dir).items() if isinstance(entry, dict)}
        except Exception:
            return {}

    def _start_ps(self, engine, cg):
        """ONE bounded `ps`, then ONE bounded `lsof` of the top ten processes for their lanes, on a thread: a starved machine must never hang the daemon's pass.
        The result lands in `self.detail` when it is done, and only while this is still the current thread (a slow one of an earlier episode writes nothing)."""
        runner = getattr(engine, "cpu_ps_runner", None) or subprocess.run
        registry = self._registry(engine)

        def work():
            text = ""
            try:
                done = runner(cg.PS_ARGV, capture_output=True, text=True, timeout=cg.PS_SECONDS, stdin=subprocess.DEVNULL)
                if done.returncode == 0:
                    lanes = {}
                    pids = cg.top_pids(cg.process_rows(done.stdout))
                    if pids:
                        try:
                            looked = runner(cg.lsof_argv(pids), capture_output=True, text=True, timeout=cg.LSOF_SECONDS, stdin=subprocess.DEVNULL)
                            if looked.returncode in (0, 1):
                                lanes = {pid: cg.lane_of(cwd, registry) for pid, cwd in cg.parse_lsof(looked.stdout).items()}
                        except Exception:
                            lanes = {}
                    text = cg.detail(cg.consumers(done.stdout, lanes))
            except Exception:
                text = ""
            if self.thread is threading.current_thread():
                self.detail = text
        self.thread = threading.Thread(target=work, name="cpu-ps", daemon=True)
        self.thread.start()

    def _chiefs(self, engine):
        discovery = getattr(engine, "discovery", None)
        return sorted(n for n, o in discovery.agents.items() if (o.fleet or {}).get("role") == "chief-of-staff") if discovery is not None and not discovery.problems else []

    def __call__(self):
        engine = self.engine
        if engine is None or engine.state_dir is None:
            return []
        cg = load_cpu_guard()
        raw = engine.config.get("cpu_guard")
        cfg = cg.settings(raw)
        if cfg is None:
            return []
        chiefs = self._chiefs(engine)
        facts = self._cpu(engine, cg, cfg, chiefs)
        facts.extend(self._mem(engine, cg, cg.mem_settings(raw), chiefs))
        return facts

    def _cpu(self, engine, cg, cfg, chiefs):
        read = cg.reading()
        if not read.ratio_known:   # FAIL OPEN: a load or a core count that cannot be read tells nobody (the status line says so), and never counts as one core
            return []
        if self.tracker is None:
            self.tracker = cg.Episode(cg.load_episode(engine.state_dir))
            self.saved_episode = self.tracker.episode
        load1, load5, cores = read.load1, read.load5, read.cores
        ratio = load5 / cores   # the five-minute average decides: a one-minute spike never wakes the Chief of Staff
        now = engine.now()
        event = self.tracker.step(ratio, now, cfg, can_begin=bool(chiefs))
        if event == "begin":
            self.detail, self.begin_at, self.waked_without = "", now, False
            self._start_ps(engine, cg)
            if engine.audit is not None:
                engine.audit.append(engine.actor, "cpu.high", None, {"load1": round(load1, 1), "load5": round(load5, 1), "cores": cores, "ratio5": round(ratio, 2),
                                                                      "high_ratio": cfg["high_ratio"], "minutes": cfg["minutes"]})
            self._save(engine, cg, self.tracker.episode)
        elif event == "end":
            if engine.audit is not None:
                engine.audit.append(engine.actor, "cpu.recovered", None, {"load1": round(load1, 1), "load5": round(load5, 1), "cores": cores, "ratio5": round(ratio, 2)})
            self.detail, self.thread, self.begin_at = "", None, None
            self._save(engine, cg, None)
        episode = self.tracker.episode
        if self.saved_episode != episode:   # a save that failed is tried again on the next pass
            self._save(engine, cg, episode)
        if episode is None or not chiefs:
            return []
        alive = self.thread is not None and self.thread.is_alive()
        if alive and self.begin_at is not None and now - self.begin_at < cg.WAKE_GRACE_SECONDS:
            return []   # the consumers are being read: the wake waits a few seconds for them
        if self.detail:
            consumers = self.detail + "."
        elif alive:
            consumers = "Consumers not read within %d s (ps is slow; one follow-up note carries them if it answers)." % cg.WAKE_GRACE_SECONDS
        elif self.begin_at is not None:
            consumers = "Consumers could not be read."
        else:
            consumers = ""
        if alive and not self.detail:
            self.waked_without = True
        text = "cpu high: load %d on %d cores (%.1fx over five minutes; the guard is %gx for %g minutes). %s `%s status` shows the line; heavy work should wait for a slot." % (
            round(load5), cores, ratio, cfg["high_ratio"], cfg["minutes"], consumers, PROG)
        facts = [Fact("cpu.high:%d" % int(episode), name, "cpu", " ".join(text.split()), episode, sender="switchboard") for name in chiefs]
        if self.waked_without and self.detail:   # the answer came after the wake: ONE follow-up note (the same key on every pass, so it is delivered once)
            note = "cpu consumers (the answer came after the cpu high note): %s." % self.detail
            facts.extend(Fact("cpu.top:%d" % int(episode), name, "cpu-top", note, episode, sender="switchboard") for name in chiefs)
        return facts

    def _mem(self, engine, cg, mem_cfg, chiefs):
        """Swap above the guard for the minutes: ONE wake per episode with the biggest holders (the kernel's counters, no process)."""
        mem = cg.memory_reading()
        percent = mem.swap_percent
        if percent is None:   # FAIL OPEN: unreadable memory tells nobody (the status line says so)
            return []
        if self.mem_tracker is None:
            self.mem_tracker = cg.Episode(cg.load_episode(engine.state_dir, cg.MEM_STATE_FILE))
            self.saved_mem = self.mem_tracker.episode
        event = self.mem_tracker.step(percent, engine.now(), mem_cfg, can_begin=bool(chiefs))
        holders = []
        if event == "begin":
            holders = cg.biggest_holders(cg.process_table())
            self.mem_holders = holders
            if engine.audit is not None:
                engine.audit.append(engine.actor, "mem.high", None, {"swap_percent": round(percent, 1), "swap_used_mb": int(mem.swap_used / 1e6), "swap_total_mb": int(mem.swap_total / 1e6),
                                                                      "high_percent": mem_cfg["high_ratio"], "minutes": mem_cfg["minutes"]})
            self._save_mem(engine, cg, self.mem_tracker.episode)
        elif event == "end":
            self.mem_holders = []
            if engine.audit is not None:
                engine.audit.append(engine.actor, "mem.recovered", None, {"swap_percent": round(percent, 1)})
            self._save_mem(engine, cg, None)
        episode = self.mem_tracker.episode
        if self.saved_mem != episode:
            self._save_mem(engine, cg, episode)
        if episode is None or not chiefs:
            return []
        text = cg.mem_wake_text(mem, getattr(self, "mem_holders", []), mem_cfg, PROG)
        return [Fact("mem.high:%d" % int(episode), name, "mem", " ".join(text.split()), episode, sender="switchboard") for name in chiefs]

    def _save(self, engine, cg, episode):
        try:
            cg.save_episode(engine.state_dir, episode)
            self.saved_episode = episode
        except OSError as err:
            engine._note("cpu.guard_file", None, {"error": _plain("%s: %s" % (type(err).__name__, err), 160)})

    def _save_mem(self, engine, cg, episode):
        try:
            cg.save_episode(engine.state_dir, episode, cg.MEM_STATE_FILE)
            self.saved_mem = episode
        except OSError as err:
            engine._note("mem.guard_file", None, {"error": _plain("%s: %s" % (type(err).__name__, err), 160)})


# ---------------------------------------------------------------- the docker reaper (ask #321)
#
# A test stack or a compose project that an agent starts carries two labels: `fleet.owner=<agent>` and `fleet.expires=<epoch seconds>`. The reaper removes
# ONLY objects that carry BOTH and whose expiry has passed: containers (`docker rm -f <id>`, never `-v`: an anonymous volume is not ours), then networks
# (`docker network rm <id>`), then volumes (`docker volume rm <name>`, never one a running container mounts). An unlabelled object, a live one and a
# label that is not an epoch are never touched; docker itself and the daemon's own files are not reachable from here. No `system prune`, no sudo.
# A dry run is the default for the command (`--apply` removes); the daemon applies once a day while `docker_reaper` is not false.
DOCKER_LABEL_OWNER = "fleet.owner"
DOCKER_LABEL_EXPIRES = "fleet.expires"
DOCKER_REAP_TIMEOUT = 60
DOCKER_REAP_FILE = "docker-reap.json"
DOCKER_REAP_INTERVAL = 86400
DOCKER_REAP_RETRY = 3600
_DOCKER_LIST_IDS = {   # the ids only (never a label in a line: a label value may hold a newline), then `inspect` says the truth
    "container": ("ps", "-a", "-q", "--no-trunc", "--filter", "label=" + DOCKER_LABEL_EXPIRES),
    "network": ("network", "ls", "-q", "--no-trunc", "--filter", "label=" + DOCKER_LABEL_EXPIRES),
    "volume": ("volume", "ls", "-q", "--filter", "label=" + DOCKER_LABEL_EXPIRES),
}
_DOCKER_RUNNING_IDS = ("ps", "-q", "--no-trunc", "--filter", "status=running")
_DOCKER_REMOVE = {"container": ("rm", "-f", "--"), "network": ("network", "rm", "--"), "volume": ("volume", "rm", "--")}
_DOCKER_ID = {"container": re.compile(r"[0-9a-f]{64}"), "network": re.compile(r"[0-9a-f]{64}"), "volume": re.compile(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,254}")}
DOCKER_EPOCH_MIN = 10 ** 9      # an expiry before the year 2001 is not a plan, it is a way to get an object removed at once
DOCKER_INSPECT_CHUNK = 100


def _docker_run(docker, runner, argv):
    done = runner([docker] + list(argv), capture_output=True, text=True, timeout=DOCKER_REAP_TIMEOUT, stdin=subprocess.DEVNULL)
    if done.returncode != 0:
        raise OSError("docker %s: exit %s: %s" % (" ".join(argv[:2]), done.returncode, _plain(done.stderr or done.stdout, 160)))
    return done.stdout or ""


def _docker_inspect(docker, runner, kind, ids):
    """The inspect records of `ids` (a list of dicts): the labels as docker says they are NOW."""
    found = []
    for start in range(0, len(ids), DOCKER_INSPECT_CHUNK):
        try:
            records = json.loads(_docker_run(docker, runner, ("inspect", "--type", kind) + ("--",) + tuple(ids[start:start + DOCKER_INSPECT_CHUNK])) or "[]")
        except ValueError:
            raise OSError("docker inspect: not JSON")
        found.extend(r for r in records if isinstance(r, dict))
    return found


def _docker_labelled(kind, record):
    """(id, owner, expires) when the record carries BOTH labels with an owner and an epoch expiry, else None. The id is checked against the strict shape for its kind."""
    labels = ((record.get("Config") or {}).get("Labels") if kind == "container" else record.get("Labels")) or {}
    ident = record.get("Id") if kind != "volume" else record.get("Name")
    owner, expires = labels.get(DOCKER_LABEL_OWNER), labels.get(DOCKER_LABEL_EXPIRES)
    if not (isinstance(ident, str) and _DOCKER_ID[kind].fullmatch(ident) and isinstance(owner, str) and owner.strip()
            and isinstance(expires, str) and re.fullmatch(r"\d{1,12}", expires) and int(expires) >= DOCKER_EPOCH_MIN):
        return None
    return ident, owner.strip(), int(expires)


def docker_reap(docker, runner, now, apply, audit=None, actor="daemon"):
    """Remove (apply) or list (dry run) the EXPIRED labelled docker objects. Returns {"removed": [...], "kept": [...], "errors": [...]}; each entry is
    (kind, id, owner, expires[, reason]). What is listed is only ids; each object's labels are read from `docker inspect` (not from a text line a label
    could forge), and an id must have docker's own shape. A listing that fails ends the run before anything is removed. The listing and the removal are
    two steps: a volume a container starts to use in between is refused by docker itself, which is the backstop."""
    result = {"removed": [], "kept": [], "errors": []}
    expired = {}
    try:
        for kind, argv in _DOCKER_LIST_IDS.items():
            ids = [line.strip() for line in _docker_run(docker, runner, argv).splitlines() if _DOCKER_ID[kind].fullmatch(line.strip())]
            expired[kind] = []
            for record in _docker_inspect(docker, runner, kind, ids) if ids else []:
                labelled = _docker_labelled(kind, record)
                if labelled is None:
                    continue
                if labelled[2] <= now:
                    expired[kind].append(labelled)
                else:
                    result["kept"].append((kind,) + labelled + ("not expired",))
    except (OSError, subprocess.SubprocessError) as err:
        result["errors"].append(_plain(str(err), 200))
        return result

    def remove(kind, ident, owner, expires):
        if apply:
            try:
                _docker_run(docker, runner, _DOCKER_REMOVE[kind] + (ident,))
            except (OSError, subprocess.SubprocessError) as err:
                result["errors"].append(_plain("%s %s: %s" % (kind, ident, err), 200))
                return
            result["removed"].append((kind, ident, owner, expires))
            try:
                if audit is not None:
                    audit.append(actor, "docker.reaped", ident, {"kind": kind, "owner": owner, "expires": expires})
            except Exception as err:   # the object is already gone: say the audit failed and go on with the rest
                result["errors"].append(_plain("audit of %s %s failed: %s" % (kind, ident, err), 200))
            return
        result["removed"].append((kind, ident, owner, expires))

    for labelled in expired["container"]:
        remove("container", *labelled)
    for labelled in expired["network"]:
        remove("network", *labelled)
    if expired["volume"]:
        try:
            running = [line.strip() for line in _docker_run(docker, runner, _DOCKER_RUNNING_IDS).splitlines() if _DOCKER_ID["container"].fullmatch(line.strip())]
            in_use = {m.get("Name") for r in (_docker_inspect(docker, runner, "container", running) if running else []) for m in (r.get("Mounts") or [])
                      if isinstance(m, dict) and m.get("Type") == "volume"}   # after the containers went: what a still-running one holds
        except (OSError, subprocess.SubprocessError) as err:
            result["errors"].append(_plain(str(err), 200))
            return result
        for ident, owner, expires in expired["volume"]:
            if ident in in_use:
                result["kept"].append(("volume", ident, owner, expires, "a running container mounts it"))
            else:
                remove("volume", ident, owner, expires)
    return result


def _docker_problem(name):
    """(path, None) for a docker binary the disk tools may run, else (None, one line saying why not). The tools take `--docker` from a person, so the
    value is NOT trusted to be a docker: its basename must be exactly `docker` and so must the basename of a symlink's target (or Docker Desktop's
    `com.docker.cli`); it must be a regular executable file owned by this user or root; neither it nor any directory above it may be writable by group
    or other (a sticky directory such as /tmp excepted); a bare name is resolved from PATH. The path RETURNED is the vetted real path, so the file run is
    the file checked. Anything else is refused."""
    if not isinstance(name, str) or not name or "\x00" in name or name.startswith("-"):
        return None, "is not a usable executable name"
    path = name if os.sep in name else shutil.which(name)
    if path is None or not os.path.exists(path):
        return None, "not installed or not on PATH"
    if not os.path.isabs(path):
        return None, "must be an absolute path (or a bare name on PATH)"
    real = os.path.realpath(path)
    if os.path.basename(path) != "docker" or os.path.basename(real) not in ("docker", "com.docker.cli"):
        return None, "is not a docker binary: its name (and the name a link points to) must be exactly `docker`"
    try:
        info = os.stat(real)
        if not stat.S_ISREG(info.st_mode) or not os.access(real, os.X_OK):
            return None, "is not an executable file"
        if info.st_uid not in (0, os.getuid()):
            return None, "belongs to another user: not trusted"
        if info.st_mode & 0o022:
            return None, "is writable by group or other: not trusted"
        here, first = os.path.dirname(real), True
        while True:
            at = os.stat(here)
            mode = at.st_mode
            if at.st_uid not in (0, os.getuid()):
                return None, "sits in a directory (%s) that others can change (another user owns it): not trusted; pass the absolute path of a docker kept in a directory only you or root can write" % _plain(here, 80)
            if not mode & 0o1000:   # a sticky directory (/tmp) lets nobody replace another's file
                # the file's own directory must be closed to group and other; an ancestor only to OTHER, or to a group when it is not root's (a root-owned
                # group-writable /Applications or /usr/local, where a standard Docker install lives, is the operating system's own)
                if (first and mode & 0o022) or mode & 0o002 or (mode & 0o020 and at.st_uid not in (0,)):
                    return None, "sits in a directory (%s) that others can change: not trusted; pass the absolute path of a docker kept in a directory only you or root can write" % _plain(here, 80)
            first = False
            parent = os.path.dirname(here)
            if parent == here:
                break
            here = parent
    except OSError:
        return None, "cannot be read"
    return real, None


def _docker_executable(name):
    return _docker_problem(name)[0]


def _docker_message(name):
    """The one refusal line for a `--docker` value that is not a usable docker."""
    why = _docker_problem(name)[1] or "not usable"
    if why.startswith("not installed"):
        return "docker is not installed or not on PATH (%s)" % _plain(name, 160)
    return "refused: %s %s" % (_plain(name, 120), why)


class DockerReapFacts:
    """The daily reap: once `DOCKER_REAP_INTERVAL` has passed since the last run (kept in `docker-reap.json`, so a restart does not run it again), the
    daemon starts the reaper on a background thread (docker may be slow: a pass never waits for it). Only a daemon that set `docker_reap_runner` runs
    it (a test engine does not), and never while `docker_reaper` is false. Returns no facts."""

    __name__ = "docker_reap_facts"

    def __init__(self):
        self.engine, self.thread = None, None

    def bind(self, engine):
        self.engine = engine

    def _last(self, state_dir):
        try:
            return float(json.loads((Path(state_dir) / DOCKER_REAP_FILE).read_text()[:1024])["at"])
        except (OSError, ValueError, KeyError, TypeError):
            return None

    def __call__(self):
        engine = self.engine
        runner = getattr(engine, "docker_reap_runner", None) if engine is not None else None
        if runner is None or engine.state_dir is None or not engine.config.get("docker_reaper", True):
            return []
        if self.thread is not None and self.thread.is_alive():
            return []
        now = engine.now()
        last = self._last(engine.state_dir)
        if last is not None and now - last < DOCKER_REAP_INTERVAL:
            return []
        self.thread = threading.Thread(target=self._run, args=(engine, runner, now), name="docker-reap", daemon=True)
        self.thread.start()
        return []

    def _run(self, engine, runner, now):
        stamp = now   # a failed run (no docker, a docker that would not answer) is tried again in an hour, not tomorrow
        try:
            docker = _docker_executable("docker")
            if docker is None:
                engine._note("docker.reap_unavailable", None, {})
                stamp = now - DOCKER_REAP_INTERVAL + DOCKER_REAP_RETRY
            else:
                result = docker_reap(docker, runner, now, True, engine.audit, engine.actor)
                engine._note("docker.reap", None, {"removed": len(result["removed"]), "errors": result["errors"][:3]})
                if result["errors"]:
                    stamp = now - DOCKER_REAP_INTERVAL + DOCKER_REAP_RETRY
            path = Path(engine.state_dir) / DOCKER_REAP_FILE
            temp = path.with_name("%s.%d.tmp" % (DOCKER_REAP_FILE, os.getpid()))
            with open(str(temp), "w") as handle:
                handle.write(json.dumps({"at": stamp}))
                handle.flush()
                os.fsync(handle.fileno())
            os.replace(str(temp), str(path))
        except Exception as err:   # a reaper never stops the daemon
            engine._note("docker.reap_error", None, {"error": _plain("%s: %s" % (type(err).__name__, err), 160)})


TEMP_JANITOR_FILE = "temp-janitor-daemon.json"
TEMP_JANITOR_INTERVAL = 6 * 86400   # the weekly gate: never twice within 6 days
TEMP_JANITOR_NAMES = 200            # names carried by one audit line (the count says the rest)
TEMP_JANITOR_GATE_FILE = "temp-janitor-gate.json"   # {"rule", "preview", "sent", "count"}: the rule the last preview was made under (hashes and a count, never a name)
TEMP_JANITOR_ACK_FILE = "temp-janitor-ack.json"     # {"rule", "preview", "by", "at"}: the recorded yes, written by `disk janitor-ack <preview>` only
TEMP_JANITOR_PREVIEW_NAMES = 25     # names listed in the preview message (the count says the rest)


def read_janitor_record(state_dir, name):
    """(ok, dict): a missing file is (True, {}); one that cannot be read in full or is not an object of text and numbers is (False, {}): the doubt applies nothing."""
    try:
        with open(str(Path(state_dir) / name), "rb") as handle:
            raw = json.loads(handle.read(4097).decode("utf-8"))
    except FileNotFoundError:
        return True, {}
    except (OSError, ValueError, UnicodeError):
        return False, {}
    if not isinstance(raw, dict) or not all(isinstance(v, (str, int, float, bool)) for v in raw.values()):
        return False, {}
    return True, raw


def janitor_apply_allowed(state_dir, rule):
    """(allowed, state): True only when the last preview was SENT under THIS rule and a yes is recorded for that very preview. state is one of
    `acked`, `no_preview` (none sent under this rule), `awaiting_ack` or `unreadable`. Every doubt is False."""
    gate_ok, gate = read_janitor_record(state_dir, TEMP_JANITOR_GATE_FILE)
    ack_ok, ack = read_janitor_record(state_dir, TEMP_JANITOR_ACK_FILE)
    if not gate_ok or not ack_ok:
        return False, "unreadable"
    if gate.get("rule") != rule or gate.get("sent") is not True or not gate.get("preview"):
        return False, "no_preview"
    if ack.get("rule") == rule and ack.get("preview") == gate["preview"] and gate.get("nonce") and ack.get("nonce") == gate["nonce"]:   # the nonce is new for every preview: a yes given to an earlier one (the rule may have come back) never counts
        return True, "acked"
    return False, "awaiting_ack"


class TempJanitorFacts:
    """The weekly temp janitor, run by the daemon itself (ask #762), the way `DockerReapFacts` runs the Docker reaper. The call is told apart from an agent's
    by the PATH it takes, never by anything a caller passes: this class runs only in the daemon's own process, only when that process set
    `engine.temp_janitor_runner` (a test engine and every command-line process has none), and it calls `disk_janitor.run` directly, never `cmd_disk_janitor`
    (whose refusal of an agent stays). It reads `temp_janitor.daemon_apply` (default false: a dry run, audited as `janitor.would_remove`); the command line never reads it.
    The selection rule is the janitor's own, unchanged. Once `TEMP_JANITOR_INTERVAL` has passed since the last run (kept in `temp-janitor-daemon.json`, written BEFORE
    the run, so a crash or a restart does not repeat it); an unreadable stamp means do not run. A background thread; returns no facts."""

    __name__ = "temp_janitor_facts"

    def __init__(self):
        self.engine, self.thread, self.noted = None, None, False
        self.outbox = None   # (preview fingerprint, text) made by the thread, handed to the Chief of Staff by the next main-thread pass

    def bind(self, engine):
        self.engine = engine

    def _hand_over(self, engine):
        """The preview the thread made: ONE message to each Chief of Staff, keyed by the preview (so a repeat is never a second message); the gate is marked
        `sent` only now, once there is someone to tell. With no Chief of Staff running it waits for the next pass."""
        box = self.outbox
        discovery = getattr(engine, "discovery", None)
        chiefs = sorted(n for n, o in discovery.agents.items() if (o.fleet or {}).get("role") == "chief-of-staff") if discovery is not None and not discovery.problems else []
        if box is None or not chiefs:
            return []
        preview, rule, text = box
        ok, gate = read_janitor_record(engine.state_dir, TEMP_JANITOR_GATE_FILE)
        if not ok or gate.get("preview") != preview:
            self.outbox = None   # the gate moved on or cannot be read: nothing is marked, and the next run makes a new preview
            return []
        try:
            _write_small(engine.state_dir, TEMP_JANITOR_GATE_FILE, dict(gate, sent=True))
        except OSError:
            return []   # not marked sent: the next pass tries again (the same key is never delivered twice)
        self.outbox = None
        if engine.audit is not None:
            engine.audit.append(engine.actor, "janitor.preview", "temp", {"rule": rule, "preview": preview, "count": gate.get("count"), "to": chiefs})
        return [Fact("janitor.preview:%s" % preview, name, "janitor", text, engine.now(), sender="switchboard") for name in chiefs]

    def _last(self, state_dir):
        """(ok, time or None): a missing file is (True, None); a file that cannot be read in full is (False, None): the doubt keeps everything."""
        try:
            with open(str(Path(state_dir) / TEMP_JANITOR_FILE)) as handle:
                text = handle.read(1024)
        except FileNotFoundError:
            return True, None
        except OSError:
            return False, None
        try:
            return True, float(json.loads(text)["at"])
        except (ValueError, KeyError, TypeError):
            return False, None

    def __call__(self):
        engine = self.engine
        runner = getattr(engine, "temp_janitor_runner", None) if engine is not None else None
        if runner is None or engine.state_dir is None:
            return []
        cfg = engine.config.get("temp_janitor") or {}
        if cfg.get("enabled", True) is False:
            return []
        if self.thread is not None and self.thread.is_alive():
            return []
        handed = self._hand_over(engine) if self.outbox is not None else []
        if handed:
            return handed
        ok, last = self._last(engine.state_dir)
        if not ok:
            if not self.noted:
                self.noted = True
                engine._note("janitor.state_unreadable", None, {"file": TEMP_JANITOR_FILE, "kept": "nothing was run this pass"})
            return []
        now = engine.now()
        if last is not None and not (now - last >= TEMP_JANITOR_INTERVAL):
            return []
        try:   # the stamp first: a run that dies half way is not repeated until the gate opens again
            path = Path(engine.state_dir) / TEMP_JANITOR_FILE
            temp = path.with_name("%s.%d.tmp" % (TEMP_JANITOR_FILE, os.getpid()))
            with open(str(temp), "w") as handle:
                handle.write(json.dumps({"at": now}))
                handle.flush()
                os.fsync(handle.fileno())
            os.replace(str(temp), str(path))
        except OSError:
            try:
                os.unlink(str(temp))
            except (OSError, UnboundLocalError):
                pass
            return []
        self.thread = threading.Thread(target=self._run, args=(engine, runner, now), name="temp-janitor", daemon=True)
        self.thread.start()
        return []

    def _run(self, engine, runner, now):
        try:
            janitor = load_disk_janitor()
            cfg = janitor.settings(engine.config.get("temp_janitor"))
            rule = janitor.rule_fingerprint(cfg)
            allowed, gate_state = janitor_apply_allowed(engine.state_dir, rule)   # a changed rule, a missing yes or a record in doubt: nothing is applied
            apply = cfg["daemon_apply"] is True and allowed
            temp = Path(cfg["dir"]) if cfg.get("dir") else janitor.default_dir()
            outcome = []
            started = time.monotonic()

            def fresh_busy(path):   # the re-check right before a removal reads the session index and the processes again, never the run's early copy
                engine._wt_session_index = None
                return janitor_busy_function(engine, runner, janitor)(path)
            with worktree_sweep(engine):   # this thread's own sweep state (it is per thread): the main thread's auto-retire reclaim never shares it
                lines, removed, kept = janitor.run(
                    temp, engine.state_dir, now, cfg, apply,
                    lambda name, detail: engine.audit.append(engine.actor, "temp.removed", _plain(name, 120), detail),
                    busy=janitor_busy_function(engine, runner, janitor), weekly=True, outcome=outcome, recheck_busy=fresh_busy)
            used = round(time.monotonic() - started, 1)
            notes = [_plain(l, 200) for l in lines if not l.startswith(("removed ", "would remove "))][:20]
            detail = {"count": len(outcome), "bytes": sum(o["bytes"] for o in outcome), "names": [_plain(o["name"], 120) for o in outcome[:TEMP_JANITOR_NAMES]],
                      "budget_seconds": cfg["weekly_scan_seconds"], "used_seconds": used, "kept": kept, "notes": notes}
            if not apply:
                detail["gate"] = gate_state if cfg["daemon_apply"] is True else "dry_run"
            engine.audit.append(engine.actor, "janitor.summary" if apply else "janitor.would_remove", "temp", detail)
            if not apply and gate_state == "no_preview":
                self._make_preview(engine, janitor, rule, outcome, cfg)
        except Exception as err:   # a janitor never stops the daemon
            engine._note("janitor.error", None, {"error": _plain("%s: %s" % (type(err).__name__, err), 160)})

    def _make_preview(self, engine, janitor, rule, outcome, cfg):
        """The selection rule changed (or was never previewed): record the preview's fingerprint in the gate, and queue ONE message to the Chief of Staff. The
        names go in that message only (and in the private `janitor.would_remove` audit line above); the gate file and the `janitor.preview` audit line hold hashes and a count."""
        names = [o["name"] for o in outcome]
        preview = janitor.preview_fingerprint(rule, names)
        try:   # a new preview ends every earlier yes
            os.unlink(str(Path(engine.state_dir) / TEMP_JANITOR_ACK_FILE))
        except FileNotFoundError:
            pass
        _write_small(engine.state_dir, TEMP_JANITOR_GATE_FILE, {"rule": rule, "preview": preview, "sent": False, "count": len(names), "nonce": uuid.uuid4().hex})
        shown = ", ".join(_plain(n, 60) for n in names[:TEMP_JANITOR_PREVIEW_NAMES])
        text = ("temp janitor: its selection rule changed, so nothing is applied until you say yes to this preview. It WOULD remove %d entr%s (%d bytes): %s%s. "
                "To say yes to this preview: `%s disk janitor-ack %s`. The yes covers the RULE this preview was made under: later weekly runs under the same rule remove "
                "whatever qualifies then, not only the names listed; a change of the rule makes a new preview and needs a new yes. The daemon removes anything only while "
                "`temp_janitor.daemon_apply` is true. If this message is lost no apply happens until the rule changes again." % (
                    len(names), "y" if len(names) == 1 else "ies", sum(o["bytes"] for o in outcome), shown or "nothing",
                    " and %d more" % (len(names) - TEMP_JANITOR_PREVIEW_NAMES) if len(names) > TEMP_JANITOR_PREVIEW_NAMES else "", PROG, preview))
        self.outbox = (preview, rule, text)


HEAVY_ORPHAN_INTERVAL = 60   # seconds between the daemon's looks for a run whose wrapper is gone


class HeavyOrphanFacts:
    """The daemon's look for orphaned heavy runs (ask #930): a run that keeps a slot after its wrapper (and so its watchdog) died is stopped past its ceiling, counted from
    the slot's own start time, and audited like a wrapper's stop (`bin/heavy_slots.py check_orphans`). Once per `HEAVY_ORPHAN_INTERVAL`, on a thread (lsof and the grace
    may take seconds: a pass never waits); returns no facts. `bin/heavy_slots.py` is loaded once by the daemon (a restart installs a change for this look); every `heavy` run loads it afresh."""

    __name__ = "heavy_orphan_facts"

    def __init__(self):
        self.engine, self.thread, self.last = None, None, None

    def bind(self, engine):
        self.engine = engine

    def __call__(self):
        engine = self.engine
        if engine is None or engine.state_dir is None or getattr(engine, "temp_janitor_runner", None) is None:   # only the real daemon: a test engine and a command line have none
            return []
        if self.thread is not None and self.thread.is_alive():
            return []
        now = engine.now()
        if self.last is not None and now - self.last < HEAVY_ORPHAN_INTERVAL:
            return []
        self.last = now
        self.thread = threading.Thread(target=self._run, args=(engine,), name="heavy-orphans", daemon=True)
        self.thread.start()
        return []

    def _run(self, engine):
        try:
            import io
            module = load_heavy_slots()
            config = engine.config.get("heavy")
            reporter = heavy_stop_reporter(module, config, lambda: engine, engine.actor)
            module.check_orphans(engine.state_dir, module.settings(config), config, time.time, reporter, io.StringIO())
        except Exception as err:   # a look never stops the daemon
            engine._note("heavy.orphan_check_error", None, {"error": _plain("%s: %s" % (type(err).__name__, err), 160)})


class Fact:
    """Something one fleet agent should be told.

    `key` names the source fact, such as `send:<from>:<id>` or `lab.fact:<id>`.
    It is what makes delivery idempotent: every message lists the keys it
    covers, and a key found in the recipient's transcript or inbox is never
    delivered again. `created` is epoch seconds. `batch` false skips the batch
    window, as `send` does.
    """

    FIELDS = ("key", "recipient", "kind", "summary", "created", "issue", "batch", "sender", "rider", "repo",
              "orders")

    def __init__(self, key, recipient, kind, summary, created, issue=None, batch=True, sender=None, rider=False,
                 repo=None, orders=False):
        for name, value in (("key", key), ("recipient", recipient), ("kind", kind)):
            if not isinstance(value, str) or not value.strip():
                raise FactError("fact %s must be a non-empty string, got %r" % (name, value))
        if not isinstance(summary, str):
            raise FactError("fact summary must be a string, got %r" % (summary,))
        if not _is_number(created):
            raise FactError("fact created must be epoch seconds, got %r" % (created,))
        if issue is not None and not (isinstance(issue, int) and not isinstance(issue, bool) and issue >= 1):
            raise FactError("fact issue must be an issue number, got %r" % (issue,))
        if not isinstance(batch, bool):
            raise FactError("fact batch must be true or false, got %r" % (batch,))
        if sender is not None and not isinstance(sender, str):
            raise FactError("fact from must be a string, got %r" % (sender,))
        if not isinstance(rider, bool):
            raise FactError("fact rider must be true or false, got %r" % (rider,))
        if not isinstance(orders, bool):
            raise FactError("fact orders must be true or false, got %r" % (orders,))
        self.key, self.recipient, self.kind, self.summary = key, recipient, kind, summary
        self.created, self.issue, self.batch, self.sender = float(created), issue, batch, sender
        self.rider = rider  # PR 13: carried in the next message, never the reason for one
        if repo is not None and not (isinstance(repo, str) and REPO_RE.match(repo)):
            raise FactError("fact repo must be OWNER/REPO, got %r" % (repo,))
        self.repo = repo  # PR 15: the repo `issue` is in; None means the recipient's own
        self.orders = orders  # PR 17: the charter's standing orders: a note on its own, at once, never a wake
        self.supersedes = ()  # #583: the creation times of this sender's earlier messages on this issue that the recipient has not seen yet (set by `send`; never stored)

    @classmethod
    def from_json(cls, obj):
        if not isinstance(obj, dict):
            raise FactError("a fact must be a JSON object")
        unknown = sorted(set(obj) - {"key", "recipient", "kind", "summary", "created", "issue", "batch", "from", "rider",
                                  "repo", "orders"})
        if unknown:
            raise FactError("fact has unknown field(s): %s" % ", ".join(unknown))
        missing = [name for name in ("key", "recipient", "kind", "summary", "created") if name not in obj]
        if missing:
            raise FactError("fact is missing: %s" % ", ".join(missing))
        return cls(obj["key"], obj["recipient"], obj["kind"], obj["summary"], obj["created"],
                   obj.get("issue"), obj.get("batch", True), obj.get("from"), obj.get("rider", False),
                   obj.get("repo"), obj.get("orders", False))

    def to_json(self):
        body = {"key": self.key, "recipient": self.recipient, "kind": self.kind, "summary": self.summary,
                "created": self.created, "issue": self.issue, "batch": self.batch, "from": self.sender,
                "rider": self.rider, "orders": self.orders}
        if self.repo is not None:  # one repo: the shape is what it always was
            body["repo"] = self.repo
        return body

    def __repr__(self):
        return "Fact(%r -> %r)" % (self.key, self.recipient)


LAB_FACTS = "lab-facts.jsonl"


def lab_fact_source(state_dir):
    """The Lab's test seam: facts a scenario runner appends to $STATE/lab-facts.jsonl.

    One JSON object per line, in Fact.to_json's shape. Read only when
    FLEET_SWITCHBOARD_LAB=1; anywhere else it yields nothing, so a stray file
    can never cause a delivery. A bad line fails the whole source, loudly: in
    the Lab a typo must not quietly drop a fact.
    """
    path = Path(state_dir) / LAB_FACTS

    def lab_facts():
        if os.environ.get(LAB_ENV) != "1":
            return []
        try:
            text = path.read_text()
        except FileNotFoundError:
            return []
        facts = []
        for number, line in enumerate(text.splitlines(), 1):
            if not line.strip():
                continue
            try:
                facts.append(Fact.from_json(json.loads(line)))
            except ValueError as err:
                raise FactError("%s:%d: %s" % (path, number, err)) from None
        return facts

    return lab_facts


def fact_sources(state_dir):
    """Every fact source, in order: callables that each return a list of Facts.

    The one registration point. Worker facts (PR 4), GitHub facts (PR 5) and
    reminders join this list. `send` is not a source: it delivers directly, by
    the same rule, and stores nothing.
    """
    return [lab_fact_source(state_dir), WorkerFacts(), ReminderFacts(state_dir), ReportRiderFacts(state_dir),
            ForegroundFacts(), OrdersFacts(), SweepFacts(), TriageFacts(), PlanWakeFacts(), AlertWakeFacts(), JobFacts(), PaneFacts(), PaneExitFacts(), HeadlessRestartFacts(), DiskFacts(), CpuFacts(), SpotlightFacts(), DockerReapFacts(), TempJanitorFacts(), HeavyOrphanFacts()]


# --------------------------------------------------------- observing the fleet

# herdr's agent_status -> the switchboard's. `done` is idle that you have not
# looked at yet; anything not listed is unknown, and unknown holds.
STATUS = {"working": "working", "idle": "idle", "done": "idle", "blocked": "blocked"}

READ_LIMIT = 200    # transcript messages per read, newest first
SINCE_SLACK = 60    # seconds read back beyond the oldest fact, for clock skew
MESSAGE_CAP = 4000  # characters in one delivered message
HELD_TOAST_AFTER = 15 * 60  # seconds an item is held before you get a toast


def agent_session(entry):
    """The v2 session id a herdr agent entry names, or None.

    herdr 0.9 reports `agent_session` as an object, `{"kind": "id", "value":
    "ses_..."}` (S6); a plain string is accepted too.
    """
    value = entry.get("agent_session") if isinstance(entry, dict) else None
    if isinstance(value, dict):
        value = value.get("value") if value.get("kind", "id") == "id" else None
    return value if isinstance(value, str) and value else None


PROGRAM_VERSION_SECONDS = 3
_VERSIONS = {}   # (realpath, mtime) -> the first line of `<program> --version`, or None; so a pass spawns nothing twice


def program_version(path):
    """The first line `<path> --version` prints, or None (it could not run, took over PROGRAM_VERSION_SECONDS, or said
    nothing). Remembered per file and modification time: the daemon asks on every pass."""
    try:
        key = (path, os.stat(path).st_mtime)
    except OSError:
        return None
    if key in _VERSIONS:
        return _VERSIONS[key]
    version = None
    try:
        done = subprocess.run([path, "--version"], capture_output=True, text=True, stdin=subprocess.DEVNULL,
                              timeout=PROGRAM_VERSION_SECONDS)
        lines = (done.stdout or "").strip().splitlines() if done.returncode == 0 else []
        version = lines[0].strip() if lines else None
    except (OSError, subprocess.SubprocessError, ValueError):
        version = None
    if len(_VERSIONS) > 64:
        _VERSIONS.clear()
    _VERSIONS[key] = version
    return version


def resolve_program(name):
    """The real path of a program the pane's command line names by a BARE name (`opencode`): the daemon's PATH lookup, then
    realpath. None when it is not a bare name or is not found (a relative path means nothing without the pane's directory)."""
    if not isinstance(name, str) or not name or "/" in name:
        return None
    found = shutil.which(name)
    return os.path.realpath(found) if found else None


def runs_program(cmdline, executable):
    """True when a process command line is `executable`, alone or with arguments.

    The program and the configured path are compared by realpath, both sides: a pane runs the resolved
    path of a binary the config names by its stable link (a package upgrade moves the target, not the link).
    A pane started with the bare command (`opencode -s ses_...`, which the shell resolved on ITS path) is the same program when
    the bare name resolves, on the daemon's PATH, to the same real file; when it resolves to a different file the two are still the
    same program if both answer `--version` with the same line (a copy). Anything that cannot be decided is NOT the program: a
    shell, an unknown name, a different binary or version is held.
    """
    if not isinstance(cmdline, str) or not executable:
        return False
    if cmdline == executable or cmdline.startswith(executable + " "):
        return True
    first = cmdline.split(" ", 1)[0]
    wanted = os.path.realpath(executable) if os.path.isabs(executable) else None
    if wanted is not None and not os.path.isabs(first):
        found = resolve_program(first)
        if found is not None:
            if found == wanted:
                return True
            if os.path.basename(found) not in (os.path.basename(executable), os.path.basename(wanted)):
                return False   # a program of another name (a shell, node) is never asked for its version
            seen, configured = program_version(found), program_version(wanted)
            return bool(seen) and seen == configured
        return False
    if not os.path.isabs(cmdline) or not os.path.isabs(executable):
        return False
    ends = [at for at, char in enumerate(cmdline) if char == " "] + [len(cmdline)]
    return any(os.path.realpath(cmdline[:end]) == wanted for end in ends[:16])


def _seconds(value):
    """v2 time (epoch milliseconds, or seconds) -> epoch seconds; None if absent."""
    if not _is_number(value):
        return None
    return value / 1000.0 if value > 1e11 else float(value)


def _fleet_meta(record):
    """`metadata.fleet` of a v2 record: a message has `metadata` at the top;
    an inbox item (session.inbox.list, 2.0.22) has it under `payload`."""
    if not isinstance(record, dict):
        return None
    meta = record.get("metadata")
    if meta is None and isinstance(record.get("payload"), dict):
        meta = record["payload"].get("metadata")
    fleet = meta.get("fleet") if isinstance(meta, dict) else None
    return fleet if isinstance(fleet, dict) else None


def _fleet_keys(record):
    keys = (_fleet_meta(record) or {}).get("keys")
    return [key for key in keys if isinstance(key, str)] if isinstance(keys, list) else []


def _is_orders_note(record):
    """PR 17: a record whose every key is a standing-orders key (`orders:...`)."""
    keys = _fleet_keys(record)
    return bool(keys) and all(key.startswith("orders:") for key in keys)


def _created(record):
    times = record.get("time") if isinstance(record, dict) else None
    return _seconds(times.get("created")) if isinstance(times, dict) else None


def iso(epoch):
    return decision_core.iso(epoch)


class Observation:
    """One fleet agent as observed now: herdr's status, v2's session.

    `last_human_prompt` is the time of your newest prompt within the
    engagement window, or None when there is none in it. `problem` is set
    when something needed for a decision could not be read; it holds.
    """

    def __init__(self, name, session_id, pane, status, fleet, idle_at=None, outcome=None,
                 last_human_prompt=None, problem=None):
        self.name, self.session_id, self.pane, self.status = name, session_id, pane, status
        self.fleet, self.idle_at, self.outcome = fleet, idle_at, outcome
        self.last_human_prompt, self.problem = last_human_prompt, problem
        self.created = None  # PR 17: when v2 says the session began (epoch seconds)
        self.wrong_program = False  # the pane runs something other than the configured v2
        self.headless = False  # #433: a worker with no terminal: what it does is read from the OpenCode service, never from herdr
        self.conflict = []  # other sessions that claim the same name

    def engaged(self, now, window):
        """You prompted this agent within `window` seconds. Off under `no-engagement-gate`."""
        if fault("no-engagement-gate"):
            return False
        return self.last_human_prompt is not None and now - self.last_human_prompt < window

    def to_json(self):
        out = {"name": self.name, "session": self.session_id, "pane": self.pane, "status": self.status,
               "fleet": self.fleet, "idle_at": iso(self.idle_at), "outcome": self.outcome,
               "last_human_prompt": iso(self.last_human_prompt), "problem": self.problem,
               "wrong_program": self.wrong_program, "conflict": self.conflict}
        if self.headless:   # present only for a headless worker: a terminal-only fleet's output is what it always was
            out["headless"] = True
        return out


class Discovery:
    """Every fleet agent found in one look, by name, and what got in the way."""

    def __init__(self):
        self.agents = {}
        self.problems = []
        self.entries = []  # herdr's agent list as read, so render can compare tokens
        self.headless_records = None   # the headless records THIS look scanned (None: it did not look): the fact sources judge only against these

    def add(self, observation):
        known = self.agents.get(observation.name)
        if known is None:
            self.agents[observation.name] = observation
        elif known.session_id != observation.session_id and observation.session_id not in known.conflict:
            known.conflict.append(observation.session_id)

    def missing(self, name):
        """Why `name` has no observation: not running, or something unreadable."""
        if self.problems:
            return "%s not found; %s" % (name, "; ".join(self.problems))
        return "%s not found: no herdr pane shows a v2 session named %s" % (name, name)


# ------------------------------------------------------------ the decision

class MessageTooLong(Exception):
    """A message that would be cut at the delivery cap: refused to the sender, nothing delivered."""


class InterruptRefused(Exception):
    """`send --interrupt` from anyone but the recipient's boss."""


class Plan:
    """What the delivery rule says for one recipient now.

    action: "wait" (batching), "hold" (reason says why), "note" or "wake".
    """

    def __init__(self, recipient, action, reason, pending, observation=None, ready_at=None):
        self.recipient, self.action, self.reason = recipient, action, reason
        self.pending, self.observation, self.ready_at = pending, observation, ready_at
        self.folded = False   # #352: a report folded into the sender's earlier send: a note, never a second wake

    def to_json(self):
        return {"recipient": self.recipient, "action": self.action, "reason": self.reason,
                "ready_at": iso(self.ready_at), "pending": [fact.to_json() for fact in self.pending]}


def hold_reason(observation, missing=None):
    """Why nothing may be written to this agent now, or None."""
    if observation is None:
        return missing or "not found"
    if observation.conflict:
        return "%s is claimed by more than one session (%s); fix the fleet metadata" % (
            observation.name, ", ".join([observation.session_id] + observation.conflict))
    if observation.problem:
        return observation.problem
    if observation.status == "blocked":
        return "%s is blocked on a permission request or a question" % observation.name
    if observation.status not in ("idle", "working"):
        return "%s has status %s in herdr" % (observation.name, observation.status)
    return None


def decide(recipient, pending, observation, now, batch_seconds, engaged_seconds, missing=None):
    """The delivery rule for one recipient's pending facts. Reads nothing; writes nothing.

    Batch: wait until the oldest pending fact is `batch_seconds` old, unless a
    pending fact skips batching (`send`), or under `no-batch`. Then hold if
    the agent is gone, blocked, unknown or unreadable; else a note if you are
    engaged with it, else a wake.
    """
    pending = sorted(pending, key=lambda fact: (fact.created, fact.key))
    # PR 17: standing orders go first and alone, at once, as a note (a wake only under `orders-wake`)
    standing = [fact for fact in pending if fact.orders]
    if standing:
        reason = hold_reason(observation, missing)
        if not reason:
            return Plan(recipient, "wake" if fault("orders-wake") else "note",
                        "standing orders are noted at once, and never wake anyone", standing, observation)
        pending = [fact for fact in pending if not fact.orders]
        if not pending:
            return Plan(recipient, "hold", reason, standing, observation)
    # PR 13: riders are carried, never the reason for a message. Only the others choose the action
    # and start the batch clock; when there is any other, every rider goes with it.
    chosen = pending if fault("no-rider") else [fact for fact in pending if not fact.rider]
    if not chosen:
        return None
    if not fault("no-batch") and all(fact.batch for fact in chosen):
        ready_at = chosen[0].created + batch_seconds
        if now < ready_at:
            return Plan(recipient, "wait", "batching until %s" % iso(ready_at), pending, observation, ready_at)
    reason = hold_reason(observation, missing)
    if reason:
        return Plan(recipient, "hold", reason, pending, observation)
    if observation.engaged(now, engaged_seconds):
        return Plan(recipient, "note", "you prompted %s at %s" % (recipient, iso(observation.last_human_prompt)),
                    pending, observation)
    return Plan(recipient, "wake", "no prompt from you in the engagement window", pending, observation)


def steers_into_turn(config, observation, carried, discovery=None):
    """A wake to an agent that is working goes in as `steer` (with `resume`, so one that outlives its turn starts
    the next at once): the running turn takes it at its next safe point instead of after the turn. Only a
    message that carries a `send` from the agent's own boss; `send_to_working` "queue" turns it off. Measured in
    a throwaway v2 2.0.24: a steer lands after the in-flight tool call, before the next model request."""
    return (config.get("send_to_working", "steer") == "steer" and observation.status == "working"
            and any(fact.kind == "send" and fact.sender and fact.sender == boss_name(discovery, observation) for fact in carried))


def clock_utc(epoch):
    """HH:MMZ (UTC) of an epoch: the time a message was sent or delivered, as the header shows it."""
    try:
        return time.strftime("%H:%MZ", time.gmtime(epoch))
    except (OverflowError, ValueError, OSError, TypeError):
        return "??:??Z"   # a time that is not a time never stops a message


def superseded_by(facts):
    """{key of an older undelivered `send`: the newer `send` that replaces it}: the same sender, about the same issue (repo and number), to the same
    recipient. Never across senders or issues, and a send with no issue is never superseded. The older text is KEPT (the caller marks it, never drops it)."""
    newest = {}
    for fact in facts:
        if fact.kind == "send" and fact.sender and fact.issue:
            group = (fact.recipient, fact.sender, fact.repo, fact.issue)
            if group not in newest or (fact.created, fact.key) > (newest[group].created, newest[group].key):
                newest[group] = fact
    found = {}
    for fact in facts:
        if fact.kind == "send" and fact.sender and fact.issue:
            top = newest[(fact.recipient, fact.sender, fact.repo, fact.issue)]
            if top is not fact:
                found[fact.key] = top
    return found


def compose(recipient, facts, cap=MESSAGE_CAP, section=None, repos=None, delivered=None):
    """One message for `facts`, oldest first. Returns (text, the facts it carries). With `delivered` (epoch) the header says when the
    message was sent (the carried facts' creation) and when it is delivered; a send that a NEWER one from the same sender about the
    same issue replaces (`superseded_by`) stays in the message, marked, so no key is left out of what is acknowledged.

    The first line names the count and the first item; each item follows in
    full. Items that do not fit under `cap` stay pending: the message ends with
    how many, and they go in the next message. A single item longer than the
    cap is cut, and says so. With `section` (PR 6, see sectioned_lines) every
    item that names an issue sits under its ask's Intent lines.
    """
    facts = sorted(facts, key=lambda fact: (fact.created, fact.key))
    if not facts:
        raise ValueError("nothing to compose")
    if facts[0].orders:  # PR 17: the orders note, whole: every order
        return orders_note(recipient, facts[0], repos), facts[:1]

    replaced = {}

    def item(fact):
        where = " (issue %s)" % issue_tag(fact.repo, fact.issue, repos) if fact.issue else ""
        body = fact.summary.strip().replace("\n", "\n  ")
        mark = ""
        if fact.key in replaced:
            mark = " [superseded by the newer message from %s sent %s]" % (fact.sender, clock_utc(replaced[fact.key].created))
        return "- %s from %s%s%s: %s" % (fact.kind, fact.sender or "the fleet", where, mark, body)

    def render(count):
        lead = next((fact for fact in facts if not fact.rider), facts[0])
        taken = facts[:count]
        replaced.clear()
        replaced.update(superseded_by(taken))
        when = ""
        if delivered is not None:
            first, last = clock_utc(min(f.created for f in taken)), clock_utc(max(f.created for f in taken))
            when = " (sent %s, delivered %s)" % (first if first == last else "%s-%s" % (first, last), clock_utc(delivered))
        waiting = sorted({t for f in taken for t in f.supersedes})
        if waiting:   # the earlier messages stay where they are, unchanged: this says only that the newer one replaces them
            names = sorted({f.sender for f in taken if f.supersedes and f.sender})
            when = (when[:-1] + "; " if when else " (") + "supersedes %d earlier message%s from %s on this issue, still waiting: sent %s)" % (
                len(waiting), "" if len(waiting) == 1 else "s", ", ".join(names) or "the same sender", ", ".join(clock_utc(t) for t in waiting[:5]))
        head = "[switchboard] %d for %s%s: %s" % (count, recipient, when, _one_line(lead.summary, 200))
        idle = [fact for fact in taken if fact.kind == WORKER_IDLE and fact.rider and getattr(fact, "clean", False)]
        shown = [fact for fact in taken if fact not in idle] if len(idle) < len(taken) else taken
        if shown is taken:
            idle = []  # nothing but idle riders: there is no news to fold them under
        lines = [head] + (sectioned_lines(shown, section, item) if section else [item(fact) for fact in shown])
        if idle:  # no-change worker lines are ONE quiet line next to real news (the keys are still carried)
            names = sorted({fact.sender or "a worker" for fact in idle})
            lines.append("- quiet: %d worker finish%s with no change (%s)" % (
                len(idle), "" if len(idle) == 1 else "es", ", ".join(names[:5]) + (", ..." if len(names) > 5 else "")))
        rest = len(facts) - count
        if rest:
            lines.append("\u2026 and %d more: run fleet-switchboard pending %s" % (rest, recipient))
        return "\n".join(lines)

    for count in range(len(facts), 0, -1):
        text = render(count)
        if len(text) <= cap:
            return text, facts[:count]
    marker = "\n[cut at %d characters]" % cap
    return text[:cap - len(marker)] + marker, facts[:1]


ORDERS_CLOSING = ("These are the owner's standing instructions for this charter. Act on them without asking "
                  "again, within their words. They cover nothing they do not name.")
COS_ORDERS_CLOSING = ("These are the owner's standing orders to you. Answer for the owner only within their words; "
                      "anything they do not name goes to the owner.")


def orders_note(recipient, fact, repos=None):
    """The standing-orders note: each order on its own line, then the closing line. Never cut. PR 18: the Chief of
    Staff's own orders (key `orders:cos:...`) are the file's text as the owner wrote it."""
    if fact.key.startswith("%s:cos:" % ORDERS_KIND):
        return "\n".join(["[switchboard] standing orders for %s (the owner's, to you):" % recipient,
                          fact.summary.strip(), COS_ORDERS_CLOSING])
    lines = ["[switchboard] standing orders for %s (charter %s):" % (recipient, issue_tag(fact.repo, fact.issue, repos))]
    lines.extend("- %s" % order for order in fact.summary.splitlines() if order.strip())
    lines.append(ORDERS_CLOSING)
    return "\n".join(lines)


def is_withdrawal(summary):
    """A `withdrawn` report rider never ages out: only a message carrying it (or its worker going) drops it."""
    return (summary or "").startswith("withdrawn: ")


def collapse_riders(facts, now, max_age):
    """PR 13: riders cut to what is still worth carrying. A rider older than `max_age` seconds is
    dropped, and only the newest `worker.idle` of each sender stays. Facts that are not riders pass."""
    newest = {}
    for fact in facts:
        if fact.rider and fact.kind == WORKER_IDLE:
            known = newest.get(fact.sender)
            if known is None or (fact.created, fact.key) > (known.created, known.key):
                newest[fact.sender] = fact
    kept = []
    for fact in facts:
        if not fact.rider:
            kept.append(fact)
        elif now - fact.created > max_age and not is_withdrawal(fact.summary):
            continue
        elif fact.kind == WORKER_IDLE and newest.get(fact.sender) is not fact:
            continue
        else:
            kept.append(fact)
    return kept


DESCRIBED_AS = {"send": "message", "report": "report", "worker.idle": "finished", "worker.stopped": "stopped",
                "worker.blocked": "blocked", "nudge": "nudge", "sweep": "sweep", "triage": "triage", "plan": "plan posted", "alert": "alert issue", "disk": "disk guard", "janitor": "janitor preview"}


def _line_of(text, limit):
    """`text` as one line of at most `limit` characters, with anything shaped like a bearer
    credential or a provider key taken out."""
    return decision_core.line_of(text, limit)


def describe_items(recipient, facts, repos=None):
    """The one human line v2's TUI shows for a message (PR 13): `switchboard: <sender> <what> on #<issue>:
    <first 100 characters>` for one item, `switchboard: <n> items for <recipient>: <first item, 80 characters>`
    for several. At most DESCRIPTION_MAX characters, never a newline."""
    facts = sorted(facts, key=lambda fact: (fact.created, fact.key))
    if all(fact.orders for fact in facts):
        return "switchboard: standing orders for %s" % recipient
    lead = next((fact for fact in facts if not fact.rider), facts[0])
    if len(facts) == 1:
        where = " on %s" % issue_tag(lead.repo, lead.issue, repos) if lead.issue else ""
        line = "switchboard: %s %s%s: %s" % (lead.sender or "the fleet", DESCRIBED_AS.get(lead.kind, lead.kind),
                                             where, _line_of(lead.summary, 100))
    else:
        line = "switchboard: %d items for %s: %s" % (len(facts), recipient, _line_of(lead.summary, 80))
    return _one_line(line, DESCRIPTION_MAX)


# ---------------------------------------------------------------- the engine

class LockError(Exception):
    """Another `run` holds the single-instance lock."""


@contextmanager
def single_instance(state_dir):
    """Hold $STATE/run.lock for the life of the block, or raise LockError at once."""
    path = Path(state_dir) / "run.lock"
    fd = adopt_inherited_lock(path)
    if fd is None:
        fd = os.open(str(path), os.O_RDWR | os.O_CREAT, 0o600)
    _HELD_LOCK["fd"] = fd
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            holder = os.read(fd, 32).decode("ascii", "replace").strip() or "unknown"
            raise LockError("another %s run holds %s (pid %s)" % (PROG, path, holder)) from None
        os.ftruncate(fd, 0)
        os.lseek(fd, 0, os.SEEK_SET)  # an adopted descriptor is not at the start
        os.write(fd, ("%d\n" % os.getpid()).encode("ascii"))
        yield path
    finally:
        _HELD_LOCK["fd"] = None
        os.close(fd)  # closing the descriptor releases the lock


LOCK_FD_ENV = "FLEET_SWITCHBOARD_LOCK_FD"  # set across a re-exec: the descriptor that still holds run.lock
_HELD_LOCK = {"fd": None}


def adopt_inherited_lock(path):
    """The descriptor a daemon passed across `exec` to itself, when it is the lock file of `path`; else None.
    The flock belongs to the open file description, so it was never released: there was no gap."""
    raw = os.environ.pop(LOCK_FD_ENV, None)
    try:
        fd = int(raw) if raw else None
        if fd is None:
            return None
        held, here = os.fstat(fd), os.stat(str(path))
        if (held.st_dev, held.st_ino) != (here.st_dev, here.st_ino):
            os.close(fd)
            return None
        os.set_inheritable(fd, False)
        return fd
    except (OSError, ValueError):
        return None


V2_LIGHT_OFF = ("the person's last prompt as a background read (the read before a write is still made)", "compactions (orders after one)", "inbox unread badge and lapsed-note conversion",
                "stopped/finished summary and stop classification", "landed-checks that page messages (a sent-key ledger answers instead)",
                "report-answered checks", "brief scan")
SENT_KEYS_FILE = "sent-keys.json"
SENT_PER_SESSION, SENT_SESSIONS = 400, 200   # the ledger's bounds
SENT_FILE_MAX = 4 * 1024 * 1024   # a ledger of that many keys is under 2 MB; a bigger file is not one


class SentLedger:
    """v2_light: the keys the daemon itself delivered, per session, kept in `sent-keys.json` (0600, renamed into place, bounded) so a restart
    keeps them. Two writers (the daemon and a CLI `send`) share it: every change is a locked read-modify-write (flock), every read
    sees the file as it is now.

    At most once: a send is `reserve`d BEFORE the write and `confirm`ed after it. A crash between the two leaves the key
    UNKNOWN (`unknown` in the file): it counts as delivered, is never sent again by itself, and `status` says how many there are. A
    send that FAILED (a V2Error) is `release`d: nothing was admitted, or v2 refuses a repeat (the message id is derived from the keys)."""

    def __init__(self, state_dir):
        self.path = Path(state_dir) / SENT_KEYS_FILE if state_dir is not None else None
        self.lock = self.path.with_name(SENT_KEYS_FILE + ".lock") if self.path is not None else None

    def load(self):
        """(sent, unknown). A MISSING file is an empty ledger; a file that is there and cannot be read or parsed is not: the ledger
        fails CLOSED (a V2Error, so the callers hold the send and say why), never forgetting what was delivered."""
        if self.path is None:
            return {}, {}
        try:
            with open(str(self.path)) as handle:
                text = handle.read(SENT_FILE_MAX + 1)   # never more than the cap: the file can grow between a stat and a read
            if len(text) > SENT_FILE_MAX:
                raise V2Error("ledger_corrupt", None, "sent-keys.json is larger than any ledger the daemon writes: nothing is sent until it is moved aside")
        except FileNotFoundError:
            return {}, {}
        except OSError as err:
            raise V2Error("ledger_unreadable", None, "sent-keys.json cannot be read (%s): nothing is sent until it can be" % err)
        try:
            body = json.loads(text)
            tables = []
            for name in ("sessions", "unknown"):
                table = {}
                for sid, entries in (body.get(name) or {}).items():
                    if not all(isinstance(v, (int, float)) and not isinstance(v, bool) for v in entries.values()):
                        raise ValueError("a key without a time")
                    table[sid] = {str(k): v for k, v in entries.items()}
                tables.append(table)
            sessions, unknown = tables
        except (ValueError, AttributeError, TypeError):
            raise V2Error("ledger_corrupt", None, "sent-keys.json is not a ledger: nothing is sent until it is moved aside (it is never read as empty)")
        return sessions, unknown

    @property
    def keys(self):
        return self.load()[0]

    def update(self, change):
        """Apply `change(sessions, unknown)` under the lock to what is on disk now, then write it back atomically. A ledger that cannot be
        locked, read or written raises (V2Error): the caller does not send. With no state directory there is nowhere to keep it: that fails closed too."""
        if self.path is None:
            raise V2Error("ledger_unwritable", None, "v2_light needs a state directory for sent-keys.json: nothing is sent without one")
        try:
            fd = os.open(str(self.lock), os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW, 0o600)
            with os.fdopen(fd, "a") as guard:
                fcntl.flock(guard, fcntl.LOCK_EX)
                sessions, unknown = self.load()
                change(sessions, unknown)
                # Only `sessions` is trimmed: an unknown-fate reservation is what says "do not send again", so it stays (bounded by SENT_FILE_MAX)
                for mine in sessions.values():
                    if len(mine) > SENT_PER_SESSION:
                        for key, _ in sorted(mine.items(), key=lambda kv: kv[1])[:len(mine) - SENT_PER_SESSION]:
                            del mine[key]
                for sid in [sid for sid, mine in sessions.items() if not mine]:
                    del sessions[sid]
                if len(sessions) > SENT_SESSIONS:
                    keep = sorted(sessions.items(), key=lambda kv: max(kv[1].values() or [0]), reverse=True)[:SENT_SESSIONS]
                    sessions.clear()
                    sessions.update(keep)
                self.save(sessions, unknown)
        except OSError as err:
            raise V2Error("ledger_unwritable", None, "sent-keys.json cannot be written (%s): nothing is sent until it can be" % err)

    def reserve(self, session_id, keys, created):
        """Reserve `keys` unless one is already in the ledger (sent or of unknown fate): True when reserved, False when another sender
        (the daemon, a CLI `send`) already has it. One locked step, so two senders never both write the same key."""
        taken = []

        def change(sessions, unknown):
            have = set(sessions.get(session_id, {})) | set(unknown.get(session_id, {}))
            if have & set(keys):
                taken.append(True)
                return
            unknown.setdefault(session_id, {}).update({key: created for key in keys})
        self.update(change)
        return not taken

    def confirm(self, session_id, keys, created):
        def change(sessions, unknown):
            sessions.setdefault(session_id, {}).update({key: created for key in keys})
            for key in keys:
                unknown.get(session_id, {}).pop(key, None)
        self.update(change)

    def release(self, session_id, keys):
        def change(sessions, unknown):
            for key in keys:
                unknown.get(session_id, {}).pop(key, None)
        self.update(change)

    def known(self, session_id, since):
        sessions, unknown = self.load()
        found = KeyTimes()
        for table in (sessions, unknown):   # an unknown-fate send counts as delivered: at most once
            for key, created in table.get(session_id, {}).items():
                if created >= since:
                    found.add_all([key], created)
        return found

    def unknown_count(self):
        return sum(len(mine) for mine in self.load()[1].values())

    def save(self, sessions, unknown):
        temp = None
        try:
            temp = self.path.with_name("%s.%d.tmp" % (self.path.name, os.getpid()))
            fd = os.open(str(temp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
            with os.fdopen(fd, "w") as handle:
                handle.write(json.dumps({"sessions": sessions, "unknown": unknown}, sort_keys=True) + "\n")
                handle.flush()
                os.fsync(handle.fileno())
            os.rename(str(temp), str(self.path))
            dir_fd = os.open(str(self.path.parent), os.O_RDONLY)   # the rename itself must survive a power loss
            try:
                os.fsync(dir_fd)
            finally:
                os.close(dir_fd)
        except Exception as err:
            if temp is not None:
                try:
                    temp.unlink()
                except OSError:
                    pass
            raise OSError("sent-keys.json could not be written: %s" % err)


class KeyTimes(set):
    """The keys `delivered_keys` found, a plain set, with `at[key]`: when the message that carries it was
    created (the oldest, when several do; None when v2 gave no time). PR 13 reads when a report arrived."""

    def __init__(self):
        super().__init__()
        self.at = {}

    def add_all(self, keys, created):
        for key in keys:
            self.add(key)
            known = self.at.get(key)
            if key not in self.at or (created is not None and (known is None or created < known)):
                self.at[key] = created


STATUS_REREAD_GAP = 5   # seconds: an agent whose state flaps is read again at most this often
COMPACTION_TTL_MAX = 30   # seconds a compaction list is remembered (an orders fact for a compacted agent waits at most this long)


# ---------------------------------------------------------------- the event feed (#290 slice 2)
#
# The daemon used to learn what happened in a session by READING its history on a timer. The service pushes the news: `GET /api/event` is ONE global
# server-sent stream (a turn ended: `session.execution.succeeded`; a step ended; a permission or a form asked for). By contract it is VOLATILE (a
# slow consumer overflows, events while disconnected are missed), so the feed is a HINT, never a ledger and never a source of TEXT (an event's text
# can be partial or stale: a summary still comes from a fresh limit-1 read). It remembers per session which assistant message the events announced
# and when a turn last ended; a (re)connect marks a gap and the next passes make ONE bounded read per session (`event.resync`); a periodic
# reconciliation (at most one bounded read per session per FEED_RECONCILE_SECONDS) finds what an event did not announce (`event.missed`). The reader
# thread does only: read a line, filter, remember. It makes no v2 call and writes nothing; the pass thread does the bounded reads. The stream is
# OPTIONAL: with `v2_events: "off"`, no service file, a stale one or a stopped service the daemon works on its reads as before.

FEED_TYPES = frozenset(("session.execution.started", "session.execution.succeeded", "session.execution.failed", "session.execution.interrupted",
                        "session.text.ended", "session.step.ended", "session.error", "permission.asked", "form.created",
                        "session.inbox.enqueued", "session.inbox.delivered"))
FEED_RECONCILE_SECONDS = 600     # at most one bounded read per session in this time, in the absence of any event
FEED_PAGE = 1                    # messages in a resync or reconcile read (the newest assistant message: bounded, far below 10)
FEED_RECONCILES_PER_PASS = 2     # sessions reconciled in one pass: the work is spread, never a burst
FEED_RESYNC_PER_PASS = 4         # sessions re-synced in one pass after a (re)connect: spread over passes, never a burst
FEED_RESYNC_MIN_SECONDS = 120    # a session read this recently is not read again by a re-sync (a flapping stream cannot cause a read storm)
FEED_PUSHED_PER_PASS = 4         # sessions the plugin named, read in one pass: one bounded read each, never a burst
FEED_SESSIONS_MAX = 500
FEED_BACKOFF_MAX = 60
FEED_STABLE_SECONDS = 30         # a connection that lasted this long starts the reconnect wait over
FEED_ID_MAX = 128                # an id longer than this is not kept (ids are short; a line may be 1 MB)


class EventFeed:
    """One subscription to the service's event stream, and what it has learned per session: {"assistant": id of the newest assistant message
    announced, "idle_ms": when the last turn ended, "read": when the daemon last read it, "event_at": when an event last named it}."""

    def __init__(self, stream, audit=None, now=time.time, sleep=time.sleep, actor="daemon"):
        self.stream, self.audit, self.now, self.sleep, self.actor = stream, audit, now, sleep, actor
        self.lock = threading.Lock()
        self.stop_event = threading.Event()
        self.thread = None
        self.seen = {}                # session id -> what the events said
        self.connected = False
        self.needs_resync = True      # a fresh feed has seen nothing: the first open re-syncs once
        self.consumers = set()        # who needs the feed's reads: with none, the feed only OBSERVES (it costs a connection and no v2 call)
        self.quiet_end = False        # the last connection ended because the stream was quiet: the next open is not a gap
        self.counts = {"events": 0, "connects": 0, "resyncs": 0, "missed": 0, "errors": 0, "read_errors": 0}
        self.down_reason = None
        self.on_usage = None          # #530: called with (session, step) for a step's token and cost figures; the event already carries them, nothing is read

    # -- the reader thread (reads, filters, remembers; no v2 call, no write)

    def start(self):
        if self.thread is None and self.stream is not None:
            self.thread = threading.Thread(target=self.run, name="v2-event-feed", daemon=True)
            self.thread.start()

    def stop(self):
        self.stop_event.set()

    def run(self):
        backoff = 1
        while not self.stop_event.is_set():
            started = self.now()
            try:
                self.consume(self.stream.stream_lines("/api/event"))
                if self.now() - started >= FEED_STABLE_SECONDS:
                    backoff = 1   # it lived: a long connection that ended is not a flapping one
            except Exception as err:   # anything at all: one bad connection is a counted error, never a dead reader thread
                with self.lock:
                    self.quiet_end = False   # a failed open: events may have been missed meanwhile, so the next open is a gap whatever ended the last connection
                    self.connected = False
                    self.down_reason = type(err).__name__
                    self.counts["errors"] += 1
            if self.stop_event.is_set():
                break
            self.sleep(min(backoff, FEED_BACKOFF_MAX))
            backoff = min(backoff * 2, FEED_BACKOFF_MAX)

    def consume(self, lines):
        """Read every line of one connection. The gap is marked when the service ANSWERED (STREAM_OPENED), never before: a service that is down
        opens nothing and costs nothing; and never after our own idle reopen (STREAM_IDLE: nothing was lost to a drop, only a quiet stream was
        reopened). A connection that ended for any other reason is a gap: the next open re-syncs."""
        try:
            for line in lines:
                if self.stop_event.is_set():
                    break
                if line is STREAM_OPENED:
                    with self.lock:
                        self.connected, self.down_reason = True, None
                        self.counts["connects"] += 1
                        if not self.quiet_end:
                            self.needs_resync = True   # events between two connections are missed by contract
                        self.quiet_end = False
                elif line is STREAM_IDLE:
                    with self.lock:
                        self.quiet_end = True
                else:
                    self.handle(line)
        finally:
            with self.lock:
                self.connected = False
            close = getattr(lines, "close", None)
            if close is not None:
                close()   # a generator stopped early is closed now, not when it is collected: its connection goes with it

    def handle(self, line):
        if not line.startswith("data:"):
            return
        try:
            event = json.loads(line[5:].strip())
        except ValueError:
            return
        kind = event.get("type") if isinstance(event, dict) else None
        if kind not in FEED_TYPES:
            return
        data = event.get("data") if isinstance(event.get("data"), dict) else {}
        session = data.get("sessionID") if isinstance(data.get("sessionID"), str) and len(data["sessionID"]) <= FEED_ID_MAX else None
        with self.lock:
            self.counts["events"] += 1
            if session is None:
                return
            entry = self._entry(session)
            entry["event_at"] = self.now()
            message = data.get("assistantMessageID") if isinstance(data.get("assistantMessageID"), str) and len(data["assistantMessageID"]) <= FEED_ID_MAX else None
            usage = (data.get("tokens") if isinstance(data.get("tokens"), dict) else data.get("usage")) if kind == "session.step.ended" else None
            step_id = event.get("id") if isinstance(event.get("id"), str) else ("%s:%s" % (message, event.get("created")) if message else None)
            if self.on_usage is not None and isinstance(usage, dict) and step_id:
                step = {"id": step_id, "tokens": usage, "cost": data.get("cost"), "time": {"created": event.get("created")}}
                try:
                    self.on_usage(session, step)   # a step's usage from the event itself: it works with v2_light on, which only stops READS of history
                except Exception:
                    self.counts["errors"] += 1     # said in the feed's own counters; the recorder's faults are already said by health_ingest_messages
            if message and kind in ("session.text.ended", "session.step.ended"):
                entry["assistant"] = message   # the id only: an event's text is never kept
            elif kind in ("session.execution.succeeded", "session.execution.failed", "session.execution.interrupted"):
                created = event.get("created")
                finite = isinstance(created, (int, float)) and not isinstance(created, bool) and math.isfinite(created)   # NaN and Infinity are valid JSON to Python: int() of them raises
                entry["idle_ms"] = int(created) if finite else int(self.now() * 1000)

    # -- what the pass thread asks

    def _entry(self, session):
        """The remembered state of a session, made if new (at most FEED_SESSIONS_MAX are kept: the oldest goes). Call with the lock held."""
        entry = self.seen.get(session)
        if entry is None:
            if len(self.seen) >= FEED_SESSIONS_MAX:
                self.seen.pop(next(iter(self.seen)))
            entry = self.seen[session] = {"assistant": None, "idle_ms": None, "read": None, "event_at": None}
        return entry

    def need(self, name):
        """A reader that wants the feed's help registers here; until one does the feed reads nothing (it only observes)."""
        with self.lock:
            self.consumers.add(name)

    def touched_since_read(self, session_id):
        """True when an event named this session after the daemon last read it (or it was never read): a reader that wants only what is new may read."""
        with self.lock:
            entry = self.seen.get(session_id)
            return entry is None or entry["read"] is None or (entry["event_at"] is not None and entry["event_at"] > entry["read"])

    def touch(self, session_id, now=None):
        """#290 slice 6: the plugin said something happened in this session. Only MARKS it: the pass thread makes the one bounded read (see `tick`)."""
        with self.lock:
            entry = self._entry(session_id)
            moment = self.now() if now is None else now
            entry["event_at"] = moment
            entry["pushed"] = moment
            self.counts["pushed"] = self.counts.get("pushed", 0) + 1

    def status(self):
        with self.lock:
            return {"pushed": self.counts.get("pushed", 0), "connected": self.connected, "events": self.counts["events"], "connects": self.counts["connects"], "resyncs": self.counts["resyncs"],
                    "missed": self.counts["missed"], "errors": self.counts["errors"], "read_errors": self.counts["read_errors"], "sessions": len(self.seen), "down": self.down_reason}

    def tick(self, engine, sessions):
        """The pass thread's part, after a pass: ONE bounded read per session after a (re)connect (`event.resync`; at most FEED_RESYNC_PER_PASS per
        pass, none read within FEED_RESYNC_MIN_SECONDS), and at most FEED_RECONCILES_PER_PASS sessions per pass whose last read is older than
        FEED_RECONCILE_SECONDS (`event.missed` when an assistant message landed that no event announced). A read that fails (the breaker is open, the
        service is slow) is simply tried again at the next pass. While the stream is down nothing is read here: the old reads are all there is."""
        now = self.now()
        with self.lock:   # #290 slice 6: a session the plugin named since the last read: ONE bounded read each, at most FEED_PUSHED_PER_PASS a pass (a real event, so it needs no consumer and no stream)
            pushed = sorted((s for s in sessions if self.seen.get(s) is not None and self.seen[s].get("pushed") is not None
                             and (self.seen[s]["read"] is None or self.seen[s]["pushed"] > self.seen[s]["read"])), key=lambda s: self.seen[s]["pushed"])
        for session in pushed[:FEED_PUSHED_PER_PASS]:
            self._read(engine, session, now, announced=False)   # the push is itself the news: it is not a missed-event check
        with self.lock:
            if not self.connected or not self.consumers:
                return   # down, or nobody uses what a read would find: no read
            if self.needs_resync:
                pending = [s for s in sessions if self.seen.get(s) is None or self.seen[s]["read"] is None or now - self.seen[s]["read"] >= FEED_RESYNC_MIN_SECONDS]
                pending.sort(key=lambda s: -1.0 if self.seen.get(s) is None else max(self.seen[s]["read"] or -1.0, self.seen[s].get("tried") or -1.0))   # the longest unread first: a failing few cannot starve the rest
                chosen = pending[:FEED_RESYNC_PER_PASS]
                if len(pending) <= FEED_RESYNC_PER_PASS:
                    self.needs_resync = False
                more, resync = self.needs_resync, True
            else:
                resync = False
        if resync:
            done = sum(1 for session in chosen if self._read(engine, session, now, announced=False))
            with self.lock:
                if not more:
                    self.counts["resyncs"] += 1
            self._audit("event.resync", {"sessions": done, "more": more, "reason": "start or reconnect: events while disconnected are missed by contract"})
        with self.lock:
            backlog = self.needs_resync   # a resync backlog reads the never-read ones itself, in its own order and cap
            due = [s for s in sessions if (not backlog and (self.seen.get(s) is None or self.seen[s]["read"] is None))
                   or (self.seen.get(s) is not None and self.seen[s]["read"] is not None and now - self.seen[s]["read"] >= FEED_RECONCILE_SECONDS)]
        for session in due[:FEED_RECONCILES_PER_PASS]:
            self._read(engine, session, now, announced=True)

    def _read(self, engine, session, now, announced):
        """One bounded read of the session's newest assistant message. True when it was made."""
        try:
            page = engine.v2.message_list(session, limit=FEED_PAGE, type="assistant")
        except V2Error:
            with self.lock:
                self.counts["read_errors"] += 1
                entry = self._entry(session)
                entry["tried"] = now   # every failed attempt: a persistently failing few go to the back, whatever their last good read
            return False
        newest = page[0].get("id") if isinstance(page, list) and page and isinstance(page[0], dict) else None
        health_ingest_messages(engine, session, page)
        with self.lock:
            entry = self._entry(session)
            known, entry["read"] = entry["assistant"], now
            missed = announced and known is not None and isinstance(newest, str) and known != newest   # a session no event ever named has nothing to have missed
            if isinstance(newest, str) and known != newest:
                entry["assistant"] = newest   # what the events did not say is learned here
            if missed:
                self.counts["missed"] += 1
        if missed:
            self._audit("event.missed", {"session": session, "last_seen": known, "found": newest})
        return True

    def _audit(self, name, detail):
        if self.audit is not None:
            try:
                self.audit.append(self.actor, name, "v2", detail)
            except OSError:
                pass


def start_event_feed(engine, config, now):
    """#290: the service's pushed news, where the HTTP route exists and `v2_events` is "auto". Returns the feed, or None (the old reads only)."""
    if config["v2_events"] != "auto" or getattr(engine.v2, "http", None) is None:
        return None
    engine.feed = EventFeed(engine.v2.http, engine.audit, now)
    if config.get("v2_light"):   # only then: without it the history reads feed the same usage (under another id), which would count a step twice
        engine.feed.on_usage = lambda session, step: health_ingest_messages(engine, session, [step])
    engine.feed.start()
    return engine.feed


def feed_tick(engine):
    """After a pass: the feed's bounded reads. Never raises; a pass never fails for the feed."""
    feed = getattr(engine, "feed", None)
    if feed is None or getattr(engine, "light", False):
        return   # v2_light: no optional read of session history, and the feed's resync and reconcile reads are such reads
    try:
        discovery = getattr(engine, "discovery", None)
        sessions = sorted({o.session_id for o in discovery.agents.values() if getattr(o, "session_id", None)}) if discovery else []
        feed.tick(engine, sessions)
    except Exception as err:
        engine._note("event.feed.error", None, {"error": _one_line("%s: %s" % (type(err).__name__, err), 200)})


class V2Reads:
    """What the daemon remembers of its reads of v2, and how much it may read.

    Every v2 read is an `opencode api` process, and a session's record, its inbox and its transcript almost never change between two passes (a
    pass every few seconds), so a pass that read each agent afresh cost tens of calls and, with many agents, took the service down. Now:

      - a session's record (`session.get`) is remembered for `v2_cache_seconds`, and re-read at once when herdr says the agent's state changed;
      - the newest human prompt is read as ONE small `message.list` (type user, PROMPT_READ messages), and only when the session's `time.updated`
        moved, never a 200-message page;
      - a session's inbox, and its compaction list, are remembered for `v2_cache_seconds` and 5 times that;
      - background reads (cache fills) are capped per pass and per minute: past the cap what is remembered is kept (a read nobody has made yet is
        still made), and the stalest agent is read first the next pass (`stale_first`), so every agent is refreshed in turn.

    A read just BEFORE A WRITE is never served from here (`fresh=True`): invariant 4 holds. `v2_cache_seconds` 0 remembers nothing."""

    LIST_PAGE = 100   # one `session.list` page: the records of up to this many sessions in ONE call
    PROMPT_READ = 10
    PROMPT_READ_WIDE = 50   # when the newest PROMPT_READ user messages are all the fleet's: one wider read, then stop

    def human_prompts_newest(self, session_id, fresh=False):
        """The person's prompts (user messages without `metadata.fleet`), newest first, from at most two small reads: the newest PROMPT_READ user
        messages, and only if they are ALL the fleet's (a person's prompt may sit behind them) the newest PROMPT_READ_WIDE. A prompt buried
        under more fleet messages than that is not seen: the person is then not counted as engaged by this read, and a write is re-checked anyway."""
        if self.engine.light and not fresh:
            return []   # v2_light: no background read. The read just before a write (fresh) is still made: the engagement gate keeps its facts
        for limit in (self.PROMPT_READ, self.PROMPT_READ_WIDE):
            page = self.engine.v2.message_list(session_id, limit=limit, type="user")
            page = page if isinstance(page, list) else []
            found = [m for m in page if isinstance(m, dict) and _fleet_meta(m) is None]
            if found or len(page) < limit:
                return found
        return []

    def __init__(self, engine):
        self.engine = engine
        self.sessions, self.prompts, self.inboxes, self.compactions = {}, {}, {}, {}   # session id -> remembered answer; memory only
        self.pass_fills, self.deferred, self.minute = 0, 0, collections.deque()
        self.listing, self.listed_at, self.pass_lists = {}, None, 0   # the last `session.list` page: session id -> record, and when it was read

    def begin_pass(self):
        self.pass_fills, self.deferred, self.pass_lists = 0, 0, 0

    def _list_due(self, now):
        """True when this pass may still read the shared list: its one call is not spent and the last page is half a cache lifetime old."""
        return (not self.engine.light and self.ttl() > 0 and self.pass_lists == 0
                and (self.listed_at is None or now - self.listed_at >= self.ttl() / 2.0))

    def listed(self, session_id, now):
        """The record of a session from ONE shared `session.list` call, or None (then the caller reads that session alone). The list is read at most
        once per pass and once per half of `v2_cache_seconds`, and counts as one background read however many sessions it refreshes: a fleet of N
        agents costs one call where it cost N `session.get`. A failed list is not retried before that half is up. Sessions past the page, or a
        session the list does not hold, are read one by one as before."""
        ttl = self.ttl()
        if self.engine.light or ttl <= 0:
            return None
        if (self.listed_at is None or now - self.listed_at >= ttl / 2.0) and self.pass_lists == 0 and self.may_fill(now):
            self.pass_lists += 1
            self.listed_at = now
            try:
                page, _ = self.engine.v2.session_list_page(None, None, self.LIST_PAGE)
                self.listing = {row["id"]: row for row in page if isinstance(row, dict) and isinstance(row.get("id"), str)}
                self.filled(now)
            except V2Error:
                self.listing = {}
        found = self.listing.get(session_id)
        return found if self.listed_at is not None and found is not None else None

    def ttl(self):
        return self.engine.config["v2_cache_seconds"]

    def may_fill(self, now):
        """True while this pass and this minute have background reads left."""
        while self.minute and self.minute[0] < now - 60:
            self.minute.popleft()
        return (self.pass_fills < self.engine.config["v2_reads_per_pass"]
                and len(self.minute) < self.engine.config["v2_reads_per_minute"])

    def filled(self, now):
        self.pass_fills += 1
        self.minute.append(now)

    def stale_first(self, session_id):
        """Sort key: the agent whose record is oldest (or never read) comes first."""
        entry = self.sessions.get(session_id)
        return entry[1] if entry else float("-inf")

    def forget(self, session_id):
        """A write to this session (a note, a wake, a conversion, a brief) changed what is remembered about it. The delivered-keys memory is kept
        ON PURPOSE: delivered_keys probes the newest synthetic message before it trusts what it remembers, so a write shows there."""
        self.sessions.pop(session_id, None)
        self.inboxes.pop(session_id, None)
        self.prompts.pop(session_id, None)
        self.compactions.pop(session_id, None)

    def session_info(self, session_id, status, now, fresh=False):
        """`session.get`, remembered. `status` is what herdr says the agent is doing now: a change reads again at once."""
        entry, ttl = self.sessions.get(session_id), self.ttl()
        changed = False
        if entry is not None and not fresh and ttl > 0:
            info, at, was = entry
            changed = was != status
            if was == status:
                if now - at < ttl:
                    return info
                if not self.may_fill(now) and not self._list_due(now):
                    self.deferred += 1
                    return info
            elif now - at < STATUS_REREAD_GAP or (not self.may_fill(now) and not self._list_due(now)):
                # herdr says the state changed, but this agent was read a moment ago (a flapping agent is read at most once per gap) or the
                # budget is spent: keep what is remembered and try again at the next pass; a read before a write is fresh whatever this says
                self.deferred += 1
                return info
        if not fresh:
            row = self.listed(session_id, now)
            # a row no newer than what is remembered says nothing new, and a row read before herdr's state change cannot show it: those are read alone
            if row is not None and (entry is None or (self.listed_at or 0) > entry[1]) and (not changed or self.listed_at == now):
                self.sessions[session_id] = (row, self.listed_at, status)   # aged from when the list was read, so a record never outlives `v2_cache_seconds`
                return row
            if entry is not None and not self.may_fill(now):
                self.deferred += 1
                return entry[0]
        info = self.engine.v2.session_get(session_id) or {}
        if ttl > 0:
            self.sessions[session_id] = (info, now, status)
            if not fresh:
                self.filled(now)
        return info

    def human_prompt(self, session_id, info, now, fresh=False):
        """When the newest prompt a PERSON typed was created (a user message without `metadata.fleet`), or None. Read again only when the session's
        `time.updated` moved."""
        times = info.get("time") if isinstance(info.get("time"), dict) else {}
        updated, entry = times.get("updated"), self.prompts.get(session_id)
        if entry is not None and not fresh and updated is not None and entry[0] == updated:
            return entry[1]
        if entry is not None and not fresh and not self.may_fill(now):
            self.deferred += 1
            return entry[1]
        if self.engine.light and not fresh:
            return None
        newest = self.human_prompts_newest(session_id, fresh)
        found = _created(newest[0]) if newest else None
        if self.ttl() > 0 and updated is not None:
            self.prompts[session_id] = (updated, found)
            if not fresh:
                self.filled(now)
        return found

    def inbox(self, session_id, now, fresh=False):
        """`session.inbox.list`, remembered (and read again when the daemon itself wrote to the session)."""
        if self.engine.light:
            return []
        entry, ttl = self.inboxes.get(session_id), self.ttl()
        if entry is not None and not fresh and ttl > 0:
            if now - entry[1] < ttl:
                return entry[0]
            if not self.may_fill(now):
                self.deferred += 1
                return entry[0]
        inbox = self.engine.v2.inbox_list(session_id)
        if ttl > 0:
            self.inboxes[session_id] = (inbox, now)
            if not fresh:
                self.filled(now)
        return inbox

    def compaction_page(self, session_id, limit, now):
        """The newest compactions of a session, remembered for `v2_cache_seconds` but at most COMPACTION_TTL_MAX: a fresh compaction is seen within
        that, so an orders fact is delivered at most that late, never wrongly. A write to the session forgets it."""
        if self.engine.light:
            return []
        entry, ttl = self.compactions.get(session_id), min(self.ttl(), COMPACTION_TTL_MAX)
        if entry is not None and ttl > 0 and now - entry[1] < ttl:
            return entry[0]
        page = self.engine.v2.message_list(session_id, limit, type="compaction")
        if ttl > 0:
            self.compactions[session_id] = (page, now)
        return page


class Switchboard:
    """observe -> derive -> decide -> deliver, for every fleet agent.

    Holds no delivery state. `now` is injected so tests run a simulated clock.
    `audit` None makes it read-only: `pending` and `status` use it that way,
    and any write then raises instead of happening unaudited.
    """

    # The sweep cache of the worktree in-use checks (`worktree_sweep`) is PER THREAD: the daemon's janitor thread and its main thread (auto-retire reclaim)
    # each hold their own, so one can never read, seed or clear the other's session index (#762).
    def _wt_state(self):
        local = self.__dict__.get("_wt_local")
        if local is None:
            local = self.__dict__.setdefault("_wt_local", threading.local())
        return local

    @property
    def _wt_sweep(self):
        return getattr(self._wt_state(), "sweep", False)

    @_wt_sweep.setter
    def _wt_sweep(self, value):
        self._wt_state().sweep = value

    @property
    def _wt_session_index(self):
        return getattr(self._wt_state(), "index", None)

    @_wt_session_index.setter
    def _wt_session_index(self, value):
        self._wt_state().index = value


    def __init__(self, config, v2, herdr, audit, sources=(), now=time.time, actor="daemon", intents=None,
                 state_dir=None):
        self.config, self.v2, self.herdr, self.audit = config, v2, herdr, audit
        self.state_dir = Path(state_dir) if state_dir is not None else None  # PR 14: where decisions.json goes
        self.headless_state = None   # #433: a READ-ONLY state directory for the headless records, for a caller (`status`) that must not get a state_dir (which writes)
        if getattr(v2, "on_event", False) is None:   # a real client: its breaker's `v2.backoff` / `v2.resume` go to the audit, once per episode
            v2.on_event = lambda name, detail: self._note(name, "v2", detail)
        self.hub = None  # the GitHub hub, when this process has one (PR 14: its awaiting-user issues)
        self.feed = None  # the event feed (#290), when this process has one
        self.decision_seeds = {}        # the last derivation's display id -> source seed (memory only; the sync engine's keys)
        self.decision_seen = {}         # PR 14: (session, request id) -> when first seen, for a request with no time of its own
        self.decisions_generation = 0   # PR 14: the generation last written to decisions.json by this process
        self._early_facts = {}          # #467: {id(source): facts} the early decisions step read this pass, handed to collect_facts
        self.request_keys = None        # PR 18: "<session>:<request id>" of every request pending at the last derivation
        self.gh_runner = None           # PR notices: the runner for `gh pr view` (None: subprocess.run)
        self.stopped_news_errors = set()  # reasons already audited: one line per distinct failure
        self.stopped_news = {}          # #96: worker.stopped key -> judged clearly no news (decided once per note)
        self.awaiting_held_links = True        # #796: cleared by the first load tick whose held-PR links were all whole (it lapses after HELD_LINKS_WAIT_SECONDS)
        self.awaiting_first_full_pass = True   # #796: set False once a pass has published a non-provisional decisions file; the load tick judges nothing before
        self.notice_facts = {}          # PR notices: "owner/repo#N" -> {at, facts, stale, error}; memory only
        self.notice_effects = {"drop": set(), "unreadable": {}}  # what the last derivation asks the daemon to record
        self.synthetic_cache = {}       # PR 14: session -> (newest synthetic id, since, lines), a cache for the decisions
        self.intents = intents  # an IntentReader (PR 6), or None when no ask repo is configured
        self.sources, self.now, self.actor = list(sources), now, actor
        self.batch_seconds = config["batch_seconds"]
        self.engaged_seconds = config["engaged_minutes"] * 60
        self.executable = config["opencode_executable"] or config["opencode"]
        self.toasted = {}  # agent -> the reason last toasted for it, so a steady reason toasts once
        self.pass_toasts = {}  # agent -> (reason, title, body) the pass itself found worth a toast (PR 4)
        self.reads = V2Reads(self)
        self.light = bool(config.get("v2_light"))   # v2_light: no optional read of session history
        self.sent = SentLedger(self.state_dir) if self.light else None
        self._delivered = {}   # session id -> (newest synthetic id, since, keys): what delivered_keys last found; memory only
        self._last = {}  # (event, subject) -> detail last audited, so a steady hold is audited once
        self.discovery = None  # the newest discover(), for sources that read the fleet (PR 4)
        self.judge_warm, self._warm_due = None, 0.0  # the daemon's policy-context warmer, if the judge is on
        self._not_fleet = {}  # session id -> until when it is believed to be no fleet agent (in memory only)
        for source in self.sources:
            bind = getattr(source, "bind", None)
            if bind:
                bind(self)
        self.jev, self._classified = build_jev(config), set()  # PR 7: the decision model; messages classified

    # -- the audit

    def _external(self, event, subject, detail):
        if self.audit is None:
            raise RuntimeError("read-only switchboard asked to write: %s %s" % (event, subject))
        return self.audit.external(self.actor, event, subject, detail)

    def _note(self, event, subject, detail):
        """Audit a non-write event once per change, not once per pass."""
        if self.audit is None or self._last.get((event, subject)) == detail:
            return
        self._last[(event, subject)] = detail
        self.audit.append(self.actor, event, subject, detail)

    # -- observe

    def _messages(self, session_id):
        page = self.v2.message_list(session_id, limit=READ_LIMIT)  # newest first (S5)
        return page if isinstance(page, list) else []

    def last_human_prompt(self, session_id, now, inbox=False, info=None, fresh=False):
        """Your newest prompt in the engagement window: type `user` without `metadata.fleet`.
        `inbox` (a Chief of Staff, PR 8) also counts one still waiting in v2's inbox. The transcript is not paged: the newest human prompt is one
        small read, made again only when the session changed (V2Reads.human_prompt)."""
        start = now - self.engaged_seconds
        if inbox:
            waiting = inbox_human_prompts(self, session_id, fresh)
            if waiting and (_created(waiting[0]) or 0) >= start:
                return _created(waiting[0])
        created = self.reads.human_prompt(session_id, info or {}, now, fresh)
        return created if created is not None and created >= start else None

    NOT_FLEET_SECONDS = 120  # how long "this session is no fleet agent" is believed

    def _observe_entry(self, entry, now, fresh=False):
        """An Observation for one herdr agent, or None when it is not a fleet agent. `fresh` reads v2 again whatever is remembered (before a write)."""
        session_id = agent_session(entry)
        if session_id is None:
            return None
        if self._not_fleet.get(session_id, 0) > now:
            return None  # asked recently and it was not one: herdr lists every pane of every workspace
        try:
            info = self.reads.session_info(session_id, entry.get("agent_status"), now, fresh)
        except V2Error as err:
            if err.reason == "http" and err.status == 404:
                self._not_fleet[session_id] = now + self.NOT_FLEET_SECONDS  # a pane of someone else's OpenCode
            raise
        fleet = _fleet_meta(info)
        if not fleet or not isinstance(fleet.get("name"), str) or not fleet["name"]:
            self._not_fleet[session_id] = now + self.NOT_FLEET_SECONDS
            return None
        self._not_fleet.pop(session_id, None)
        fleet = load_module("reassign").overlay(self.state_dir, fleet, session_id)   # a reassigned worker's boss (bin/reassign.py): bound to this session
        times = info.get("time") if isinstance(info.get("time"), dict) else {}
        observation = Observation(fleet["name"], session_id, entry.get("pane_id"),
                                  STATUS.get(entry.get("agent_status"), "unknown"), fleet,
                                  _seconds(times.get("idle")), info.get("outcome"))
        observation.created = _seconds(times.get("created"))
        self.check_program(observation)
        if observation.problem:
            return observation
        try:
            observation.last_human_prompt = self.last_human_prompt(
                session_id, now, inbox=fleet.get("role") == "chief-of-staff", info=info, fresh=fresh)
        except V2Error as err:
            observation.problem = "cannot read %s's transcript: %s" % (observation.name, err)
        return observation

    def check_program(self, observation):
        """The restart hazard: after a herdr restart a pane may be a shell, and
        herdr resumes the agent by typing `opencode` into it, which can start
        another OpenCode. A pane whose process is not the configured v2 is held,
        and nothing is delivered to it. A pane that cannot be read is held too."""
        if not observation.pane:
            observation.problem = "%s has no herdr pane to check" % observation.name
            return
        try:
            programs = [p.get("cmdline") for p in self.herdr.pane_process_info(observation.pane)]
        except HerdrError as err:
            observation.problem = "cannot read what pane %s of %s runs: %s" % (observation.pane, observation.name, err)
            return
        if not any(runs_program(cmdline, self.executable) for cmdline in programs):
            observation.wrong_program = True
            observation.problem = "pane %s of %s runs a different opencode than the configured v2 (%s): %s" % (
                observation.pane, observation.name, self.executable,
                _one_line("; ".join(str(c) for c in programs), 120) or "nothing")

    def discover(self, now, entries=None):
        """Every fleet agent: a herdr agent whose v2 session carries `metadata.fleet.name`. Also marks the `agents` input (#805): not whole when
        it starts, whole only when it finished with no problem, so a discovery that raised or was partial leaves it not whole."""
        read_mark(self, "agents", False, "the discovery did not finish", now)
        found = self._discover(now, entries)
        problems = list(found.problems or ())
        read_mark(self, "agents", not problems, "the fleet could not be read whole: %s" % _one_line(problems[0], 80) if problems else "", now)
        return found

    def _discover(self, now, entries=None):
        found = Discovery()
        self.discovery = found
        if entries is None and (getattr(self, "config", None) or {}).get("no_multiplexer") is True:   # records only: no terminal multiplexer is asked, so its absence is no standing problem
            self._discover_headless(found, now)
            return found
        if entries is None:
            try:
                entries = self.herdr.agent_list()
            except HerdrError as err:
                found.problems.append("herdr unreachable: %s" % err)
                self._discover_headless(found, now)   # a worker with no terminal does not depend on herdr
                return found
        found.entries = [entry for entry in entries if isinstance(entry, dict)]
        for entry in sorted(found.entries, key=lambda e: self.reads.stale_first(agent_session(e) or "")):   # the stalest first: the read budget is shared out in turn
            try:
                observation = self._observe_entry(entry, now)
            except V2Error as err:
                if err.reason == "http" and err.status == 404:
                    continue  # the pane names a session v2 no longer has
                found.problems.append("v2 unreachable: %s" % err)
                continue
            if observation is not None:
                found.add(observation)
        self._discover_headless(found, now)   # AFTER the terminals: a terminal that runs the same session wins (`watch`), and another session claiming a terminal agent's name is a conflict (held)
        return found

    def _discover_headless(self, found, now):
        """#433: the workers with no terminal. The index is the private records in state-dir/headless/; PRESENCE is proved by the service (the session
        exists, answers and carries the worker's name in its metadata), never by a record alone. `session.active` is read ONCE for all of them; a
        service that does not answer makes each one `unknown` with a problem (a delivery is held, never dropped), not dead and not working."""
        root = self.state_dir if self.state_dir is not None else self.headless_state
        if root is None:
            return
        try:
            ap = load_agent_presence()
            records, bad = ap.scan_records(root)
        except Exception as err:   # never silent: headless workers would vanish from discovery without a word
            found.problems.append("headless workers could not be read: %s" % _one_line(str(err), 100))
            return
        found.problems.extend(bad)   # a record that is there and cannot be used is said, one line each, never a silent loss
        found.headless_records = records   # what this look saw: a launch that lands after it is judged by the NEXT look, never called lost by this one
        if not records:
            return
        active, down = None, None
        try:
            active = self.v2.session_active()
            if not isinstance(active, dict):   # a list, a string or null cannot be read: unknown, never idle
                active, down = None, "session.active answered something unreadable"
        except V2Error as err:
            down = _one_line(str(err), 100)
        for record in records:
            try:
                observation = self._observe_headless(record, now, active, down)
            except V2Error as err:
                observation = self._unknown_headless(record, "the service did not answer: %s" % _one_line(str(err), 100))
            if observation is not None:
                found.add(observation)

    def _unknown_headless(self, record, why):
        name = record["worker"]
        observation = Observation(name, record["session"], None, "unknown", {"name": name, "headless": True})
        observation.headless = True
        observation.problem = "%s: %s" % (name, why)
        return observation

    def _observe_headless(self, record, now, active, down=None, fresh=False):
        """An Observation for one headless worker, or None when its session is gone or is not the worker's. State per bin/agent_presence.py."""
        ap = load_agent_presence()
        session_id = record["session"]
        if down is not None:
            return self._unknown_headless(record, "the service did not answer (%s)" % down)
        state, why = ap.read_state(self.v2, session_id, active)
        if state == "missing":
            return None
        if state == ap.UNKNOWN:
            return self._unknown_headless(record, why)
        try:
            info = self.reads.session_info(session_id, state, now, fresh)
        except V2Error as err:
            if err.reason == "http" and err.status == 404:
                return None
            raise
        fleet = _fleet_meta(info)
        if not fleet or fleet.get("name") != record["worker"]:
            return None   # the session does not carry the worker's name: the record is not proof of presence
        fleet = load_module("reassign").overlay(self.state_dir if self.state_dir is not None else self.headless_state, fleet, session_id)   # a reassigned worker's boss (bin/reassign.py): bound to this session
        times = info.get("time") if isinstance(info.get("time"), dict) else {}
        observation = Observation(fleet["name"], session_id, None, STATUS.get(state, "unknown"), fleet, _seconds(times.get("idle")), info.get("outcome"))
        observation.created = _seconds(times.get("created"))
        observation.headless = True
        try:
            observation.last_human_prompt = self.last_human_prompt(
                session_id, now, inbox=fleet.get("role") == "chief-of-staff", info=info, fresh=fresh)
        except V2Error as err:
            observation.problem = "cannot read %s's transcript: %s" % (observation.name, err)
        return observation

    def reobserve(self, previous, now):
        """The same agent, read again just before a write (invariant 4). (Observation, why-not)."""
        if previous.headless:
            try:
                record = load_agent_presence().load_record(self.state_dir, previous.name) if self.state_dir is not None else None
                if record is None or record["session"] != previous.session_id:
                    return None, "%s has no headless record for session %s any more" % (previous.name, previous.session_id)
                active = self.v2.session_active() or {}
                fresh = self._observe_headless(record, now, active, None, fresh=True)   # a read before a write is never from memory
            except V2Error as err:
                return None, "v2 unreachable: %s" % err
            if fresh is None or fresh.name != previous.name:
                return None, "session %s is no longer the fleet agent %s" % (previous.session_id, previous.name)
            if fresh.problem:
                return None, fresh.problem
            fresh.conflict = list(previous.conflict)
            return fresh, None
        if not previous.pane:
            return None, "%s has no herdr pane to read again" % previous.name
        try:
            entry = self.herdr.agent_get(previous.pane)
        except HerdrError as err:
            return None, "pane %s of %s cannot be read: %s" % (previous.pane, previous.name, err)
        if agent_session(entry) != previous.session_id:
            return None, "pane %s no longer shows %s's session" % (previous.pane, previous.name)
        entry = dict(entry, pane_id=entry.get("pane_id") or previous.pane)
        try:
            fresh = self._observe_entry(entry, now, fresh=True)   # a read before a write is never from memory (invariant 4)
        except V2Error as err:
            return None, "v2 unreachable: %s" % err
        if fresh is None or fresh.name != previous.name:
            return None, "session %s is no longer the fleet agent %s" % (previous.session_id, previous.name)
        fresh.conflict = list(previous.conflict)
        return fresh, None

    def _acknowledge(self, keys):
        """Tell the fact sources that hold items in memory (GitHub, PR 5) which keys are delivered."""
        for source in self.sources:
            acknowledge = getattr(source, "acknowledge", None)
            if acknowledge is not None:
                acknowledge(keys)

    def charter_repo(self, observation):
        """PR 17: the repo an agent's charter is in: its own `repo`, else the intent repo."""
        repo = (observation.fleet or {}).get("repo")
        return repo if isinstance(repo, str) and repo else (self.intents.repo if self.intents is not None else None)

    def charter_orders(self, observation, charter):
        """PR 17: the standing orders of `charter` for one agent: the judge's warmed, cached read of the charter
        when it holds one (the same file the judge reads, so no new `gh` call), else the reader's own cached read."""
        reader = self.intents
        if reader is None:
            return []
        fleet = observation.fleet or {}
        repo = self.charter_repo(observation)
        ttl = (self.config.get("policy") or {}).get("cache_seconds") or 0
        if self.state_dir is not None and ttl:
            cache = BoundedFileCache(self.state_dir / POLICY_CONTEXT_FILE, self.now, ttl, 1)
            known = _valid_context(cache.get("ask:%s:%s:%s" % (repo, fleet.get("issue"), fleet.get("charter"))))
            if known is not None and known["charter"] == charter:
                return known["orders"]
        return reader.charter_orders(charter, repo)

    # -- derive

    def collect_facts(self):
        """Every fact from every source, first key wins for each recipient. A failing source is audited and skipped."""
        facts, seen, problems = [], set(), []
        early, self._early_facts = getattr(self, "_early_facts", {}), {}   # #467: a source the early decisions step already read this pass is not read twice
        for source in self.sources:
            name = getattr(source, "__name__", "source")
            try:
                found = early[id(source)] if id(source) in early else source()
            except Exception as err:  # one bad source must not stop the others
                problems.append("%s: %s" % (name, _one_line(str(err))))
                self._note("source.error", name, {"error": _one_line(str(err))})
                continue
            for fact in found:
                # PR 17: first key wins per recipient (the orders key is the charter's, the same for every agent of it)
                if (fact.recipient, fact.key) not in seen:
                    seen.add((fact.recipient, fact.key))
                    facts.append(fact)
        return facts, problems

    def delivered_keys(self, session_id, since):
        """Keys already in the session: its messages since `since`, read newest
        first, plus its v2 inbox. Returns (keys, complete); not complete means
        the read ended before reaching `since`, so a key could be missed."""
        if self.light:
            return self.sent.known(session_id, since), True   # what the daemon delivered, from its ledger: no read
        keys, complete = KeyTimes(), False
        # A recipient with something pending is asked about every pass: ONE small read (its newest synthetic message) says whether anything it
        # carries changed; if not, the keys found last time (which reached back to `since`) still hold, and the pages are not read again.
        remembered = self._delivered.get(session_id) if self.config["v2_cache_seconds"] > 0 else None
        newest = self.v2.message_list(session_id, limit=1, type="synthetic") if self.config["v2_cache_seconds"] > 0 else None   # BEFORE the pages: a message that lands during the read changes it
        newest_id = newest[0].get("id") if isinstance(newest, list) and newest and isinstance(newest[0], dict) else None
        if remembered is not None and remembered[0] == newest_id and remembered[1] <= since:
            keys, complete = KeyTimes(), True
            keys.update(remembered[2])
            keys.at = dict(remembered[2].at)
            inbox = self.v2.inbox_list(session_id)   # never from memory: a note another process wrote counts as delivered
            for item in inbox if isinstance(inbox, list) else []:
                keys.add_all(_fleet_keys(item), _created(item))
            return keys, complete
        # Only synthetic messages carry keys; asking for just those keeps the read
        # short on a chatty recipient, which a 24 h worker look-back needs (PR 4).
        # PR 8: more than READ_LIMIT of them are read page by page, up to MAX_READ_PAGES.
        for page, more in self.v2.message_pages(session_id, SYNTHETIC_PAGE, "synthetic", MAX_READ_PAGES):
            reached = False
            for message in page:
                created = _created(message)
                if created is not None and created < since:
                    reached = True
                    break
                keys.add_all(_fleet_keys(message), created)
            if reached or len(page) < SYNTHETIC_PAGE or more is False:
                complete = True
            if complete:
                break
        if complete and self.config["v2_cache_seconds"] > 0:
            if len(self._delivered) > 200:
                self._delivered.pop(next(iter(self._delivered)))   # the oldest goes (dicts keep insertion order), not every recipient at once
            remembered_keys = KeyTimes()
            remembered_keys.update(keys)
            remembered_keys.at = dict(keys.at)
            self._delivered[session_id] = (newest_id, since, remembered_keys)   # memory only: the messages' keys, before the inbox's are added
        inbox = self.v2.inbox_list(session_id)
        for item in inbox if isinstance(inbox, list) else []:
            keys.add_all(_fleet_keys(item), _created(item))
        return keys, complete

    def plan(self, recipient, facts, discovery, now):
        """Pending = facts minus delivered keys, then the rule. None if nothing is pending."""
        return self.plan_with_riders(recipient, facts, discovery, now)[0]

    def plan_with_riders(self, recipient, facts, discovery, now):
        """(plan, riders): the plan `plan` returns, and the riders that wait for a message to ride in
        when the plan is None because only riders are pending (PR 13; `pending` and `status` show them)."""
        facts = collapse_riders(facts, now, self.config["rider_max_age_seconds"])
        if not facts:
            return None, []
        plan = self._plan_pending(recipient, facts, discovery, now)
        if plan is not None:
            return plan, []
        return None, self._undelivered(recipient, facts, discovery)

    def _undelivered(self, recipient, facts, discovery):
        """`facts` whose keys the recipient does not have yet; all of them when that cannot be read."""
        observation = discovery.agents.get(recipient)
        if observation is None or fault("no-dedupe"):
            return list(facts)
        try:
            since = min(fact.created - getattr(fact, "look_back", 0) for fact in facts) - SINCE_SLACK
            delivered, _ = self.delivered_keys(observation.session_id, since)
        except V2Error:
            return list(facts)
        return [fact for fact in facts if fact.key not in delivered]

    def _plan_pending(self, recipient, facts, discovery, now):
        observation = discovery.agents.get(recipient)
        if observation is None:
            return decide(recipient, facts, None, now, self.batch_seconds, self.engaged_seconds,
                          discovery.missing(recipient))
        pending = facts
        if not fault("no-dedupe"):
            since = min(fact.created - getattr(fact, "look_back", 0) for fact in facts) - SINCE_SLACK
            try:
                delivered, complete = self.delivered_keys(observation.session_id, since)
            except V2Error as err:
                return decide(recipient, facts, None, now, self.batch_seconds, self.engaged_seconds,
                              "cannot read what %s already has: %s" % (recipient, err))
            pending = [fact for fact in facts if fact.key not in delivered]
            self._acknowledge(delivered)
            if pending and not complete:
                return decide(recipient, pending, None, now, self.batch_seconds, self.engaged_seconds,
                              "the last %d messages of %s reach back less than to %s, so what it "
                              "already has is unknown" % (READ_LIMIT, recipient, iso(since)))
        plan = decide(recipient, pending, observation, now, self.batch_seconds, self.engaged_seconds)
        if self.light and plan is not None and plan.action in ("note", "wake"):
            # v2_light: nothing reads a person's prompt in the background. A delivery is about to happen (the batch is ripe and nothing
            # holds it): only now does the engagement gate get its one small read, so a note is still a note and a wake still a wake.
            # A plan that waits or holds reads nothing.
            try:
                observation.last_human_prompt = self.last_human_prompt(
                    observation.session_id, now, inbox=(observation.fleet or {}).get("role") == "chief-of-staff", info={}, fresh=True)
            except V2Error as err:
                return decide(recipient, pending, None, now, self.batch_seconds, self.engaged_seconds,
                              "cannot read %s's transcript: %s" % (recipient, err))
            plan = decide(recipient, pending, observation, now, self.batch_seconds, self.engaged_seconds)
        return plan

    # -- deliver

    def deliver(self, plan, interrupt=False):
        """Write one note or wake for `plan`, after observing the agent again.

        Returns {"sent": bool, ...}. When the fresh look no longer supports the
        plan, nothing is sent; the next pass decides again. `interrupt` (`send --interrupt`, only
        from a boss to its own worker) first aborts the agent's running turn and then sends the message
        as a wake, whatever the plan said (a note to an engaged agent included).
        """
        if plan.action not in ("note", "wake"):
            raise ValueError("nothing to deliver for action %r" % plan.action)
        observation = plan.observation
        if not fault("no-recheck"):
            fresh, why = self.reobserve(observation, self.now())
            again = decide(plan.recipient, plan.pending, fresh, self.now(), self.batch_seconds,
                           self.engaged_seconds, why)
            if plan.folded and again.action == "wake":
                again.action = "note"   # #352: a folded report stays a note
            if again.action != plan.action and not (interrupt and again.action in ("note", "wake")):
                detail = {"was": plan.action, "now": again.action, "reason": again.reason,
                          "keys": [fact.key for fact in plan.pending]}
                if self.audit is not None:
                    self.audit.append(self.actor, "recheck", plan.recipient, detail)
                note_unreachable(self, plan.recipient, fresh, why)
                return {"sent": False, "action": again.action, "reason": again.reason}
            observation = fresh
        repos = self.repos_in_play()
        text, carried = compose(plan.recipient, plan.pending, section=section_resolver(self, observation),
                                repos=repos, delivered=self.now())
        sent = next((fact for fact in carried if fact.kind == "send"), None)
        if sent is not None and "\n[cut at %d characters]" % MESSAGE_CAP in text[-40:]:  # never cut silently
            whole, _ = compose(plan.recipient, plan.pending[:1], cap=10 ** 9, section=section_resolver(self, observation),
                               repos=repos, delivered=self.now())
            allowed = max(0, len(sent.summary) - (len(whole) - MESSAGE_CAP))
            raise MessageTooLong("message is %d characters and would be cut at the delivery cap of %d once its header and "
                                 "ask sections are added; the allowed text for this message is %d characters: nothing was "
                                 "sent. Write it to a file in the opencode temp dir and send the path"
                                 % (len(sent.summary), MESSAGE_CAP, allowed))
        keys = [fact.key for fact in carried]
        # The id lives in v2's namespace, so it is derived from the session the
        # recipient runs now: a relaunched agent is a new recipient for v2.
        message_id = derive_message_id(observation.session_id, keys)
        resume = plan.action == "wake" or interrupt
        delivery = "queue" if resume and not fault("steer-not-queue") else "steer"
        busy = resume and not interrupt and steers_into_turn(self.config, observation, carried, getattr(self, "discovery", None))
        if busy:
            delivery = "steer"
        detail = {"mode": plan.action, "session": observation.session_id, "message_id": message_id,
                  "keys": keys, "resume": resume, "delivery": delivery, "left": len(plan.pending) - len(keys)}
        if busy:
            detail["busy"] = True
        description = None if fault("no-description") else describe_items(plan.recipient, carried, repos)
        detail["description"] = description
        if interrupt:
            # resume false: nothing else runs; the wake below is what the agent acts on (and it carries any
            # steering input the interrupt left waiting)
            with self._external("v2.interrupt", plan.recipient, {
                    "session": observation.session_id, "resume": False, "keys": keys, "was": observation.status}) as result:
                reply = self.v2.interrupt(observation.session_id, False)
                result["interrupted"] = reply.get("interrupted") if isinstance(reply, dict) else None
            detail["interrupted"] = True
        if self.light and not self.sent.reserve(observation.session_id, keys, self.now()):   # before the write: a crash after it leaves the fate unknown, never "not sent"
            return {"sent": False, "action": "delivered", "reason": "another sender already holds these keys in the sent-keys ledger"}
        try:
            with self._external("v2.synthetic", plan.recipient, detail) as result:
                record = self.v2.synthetic(observation.session_id, text,
                                           {"fleet": dict({"keys": keys, "from": "switchboard"}, **self._send_meta(carried))},
                                           resume, delivery, message_id, description)
                if fault("crash-after-send"):
                    raise SimulatedCrash("crash-after-send: %s was admitted; stopping before the audit result"
                                         % message_id)
                result["id"] = record.get("id") if isinstance(record, dict) else None
        except V2Error as err:
            if not self.light:
                raise
            if err.reason == "http" and err.status == 409:
                pass   # v2 already holds this message (its id is derived from the keys): it IS delivered
            elif (err.reason == "http" and isinstance(err.status, int) and 400 <= err.status < 500 and err.status != 408) \
                    or err.reason in ("unavailable", "refused"):
                self.sent.release(observation.session_id, keys)   # a definite refusal (a 4xx other than 408/409: not admitted), or the call never ran: the write did not land
                raise
            else:
                raise   # a 5xx, 408, timeout, bad_json, a dropped call: the fate is unknown, so the reservation STAYS (counts as delivered; status says how many)
        self.reads.forget(observation.session_id)   # we wrote to it: its inbox and times are not what was remembered
        if self.light:
            self.sent.confirm(observation.session_id, keys, self.now())
        self._acknowledge(keys)
        return {"sent": True, "action": plan.action, "message_id": message_id, "keys": keys,
                "left": len(plan.pending) - len(keys)}

    @staticmethod
    def _send_meta(carried):
        """#583: the ask a delivered `send` is about, in the message's metadata, so a LATER send can tell which waiting messages are about the same issue."""
        sends = [f for f in carried if f.kind == "send"]
        one = sends[0] if sends else None
        if one is None or not one.sender or not one.issue:
            return {}
        if any((f.sender, f.repo, f.issue) != (one.sender, one.repo, one.issue) for f in carried):
            return {}   # a message that also carries another issue's (or sender's) facts is about none of them alone: a later send never names it
        return {"sender": one.sender, "issue": one.issue, "repo": one.repo} if one.repo else {"sender": one.sender, "issue": one.issue}

    def waiting_earlier(self, discovery, recipient, sender, repo, issue, now):
        """#583: when the recipient has not yet taken earlier messages from `sender` on this issue (they wait in its v2 inbox), their times. Read only: nothing is
        cancelled or changed. Where the inbox cannot be read (v2_light, a failed read, an older message that did not say its issue) it is (): sent as before."""
        try:
            target = discovery.agents.get(recipient)
            if self.light or target is None or not target.session_id or not sender or not issue:
                return ()
            found = []
            for item in self.reads.inbox(target.session_id, now, fresh=True) or []:
                meta = _fleet_meta(item) or {}
                if meta.get("from") == "switchboard" and meta.get("sender") == sender and meta.get("issue") == issue \
                        and meta.get("repo") == (repo or None) and all(key.startswith("send:") for key in _fleet_keys(item)):
                    when = _created(item)
                    if when is not None and 946684800 <= when <= now + 86400:   # an inbox item's time is untrusted: only a plausible one (2000 to tomorrow) is shown
                        found.append(when)
            return tuple(sorted(found))
        except Exception:
            return ()   # fail toward showing everything: no marking

    def convert_lapsed_notes(self, observation, now):
        """A note still in v2's inbox once you have not prompted for the
        engagement window becomes a wake: `inbox.update` to queue, then to
        steer (v2 refuses steer to steer). Only on an idle agent. Returns the
        converted inbox ids."""
        if self.light or fault("no-note-conversion") or hold_reason(observation) or observation.status != "idle":
            return []
        if observation.engaged(now, self.engaged_seconds):
            return []
        def lapsed(inbox):
            return [item for item in (inbox if isinstance(inbox, list) else [])
                    if isinstance(item, dict) and (_fleet_meta(item) or {}).get("from") == "switchboard"
                    and item.get("delivery") == "steer" and item.get("resume") is not True
                    and not _is_orders_note(item)]  # PR 17: an unread orders note never becomes a wake
        notes = lapsed(self.reads.inbox(observation.session_id, now))
        if notes:   # what is remembered says a note waits: read it afresh before acting on it (a write follows)
            notes = lapsed(self.reads.inbox(observation.session_id, now, fresh=True))
        converted = []
        for item in notes:
            if not fault("no-recheck"):
                fresh, why = self.reobserve(observation, self.now())
                if fresh is None or hold_reason(fresh) or fresh.status != "idle" \
                        or fresh.engaged(self.now(), self.engaged_seconds):
                    if self.audit is not None:
                        self.audit.append(self.actor, "recheck", observation.name, {
                            "was": "convert", "now": "keep", "inbox_id": item.get("id"),
                            "reason": why or hold_reason(fresh) or "%s is %s or engaged" % (
                                observation.name, fresh.status)})
                    break
            for delivery in ("queue", "steer"):
                with self._external("v2.inbox.update", observation.name, {
                        "session": observation.session_id, "inbox_id": item.get("id"),
                        "delivery": delivery, "keys": _fleet_keys(item), "why": "note outlived engagement"}) as result:
                    record = self.v2.inbox_update(observation.session_id, item.get("id"), delivery)
                    result["delivery"] = record.get("delivery") if isinstance(record, dict) else None
            self.reads.forget(observation.session_id)
            converted.append(item.get("id"))
        return converted

    # -- the pass

    def _failed(self, subject, step, err, report):
        line = "%s: %s" % (type(err).__name__, _one_line(str(err)))
        report["errors"].append({"subject": subject, "step": step, "error": line})
        if self.audit is not None:
            self.audit.append(self.actor, "error", subject, {"step": step, "error": line})

    def run_pass(self):
        """One pass. One agent's failure is audited and never stops the others."""
        now = self.now()
        report = {"at": iso(now), "sent": [], "held": [], "waiting": [], "converted": [], "errors": [],
                  "badges": [], "toasts": []}
        self.pass_toasts = {}
        self._early_facts = {}   # #467: facts the early decisions step reads for this pass only; never carried over from an earlier one
        self.reads.begin_pass()
        discovery = self.discover(now)
        early_decisions(self, discovery)   # #467: the decisions file is written as soon as its own sources are read, BEFORE the heavy fact sources
        for problem in discovery.problems:
            self._note("observe.problem", None, {"problem": problem})
        for observation in list(discovery.agents.values()):
            if observation.wrong_program:
                self._note("program.guard", observation.name, {"pane": observation.pane, "reason": observation.problem})
            try:
                report["converted"].extend(self.convert_lapsed_notes(observation, now))
            except Exception as err:
                self._failed(observation.name, "convert", err, report)
        run_shadow_classifier(self, discovery, now)  # PR 7: logs, acts on nothing
        facts, _ = self.collect_facts()
        try:
            facts = filter_stopped_news(self, facts, discovery)
        except Exception as err:  # fail open: a broken judge never stops a delivery, the facts wake as today
            reason = _one_line("%s: %s" % (type(err).__name__, err), 200)
            if reason not in self.stopped_news_errors:
                if len(self.stopped_news_errors) > 50:
                    self.stopped_news_errors.clear()
                self.stopped_news_errors.add(reason)
                self._note("stopped_news.error", None, {"reason": reason})
        by_recipient = {}
        for fact in facts:
            by_recipient.setdefault(fact.recipient, []).append(fact)
        held = {}
        for recipient in sorted(by_recipient):
            try:
                plan = self.plan(recipient, by_recipient[recipient], discovery, now)
                if plan is None:
                    continue
                if plan.action == "wait":
                    report["waiting"].append(recipient)
                elif plan.action == "hold":
                    held[recipient] = plan
                    report["held"].append({"recipient": recipient, "reason": plan.reason})
                    self._note("hold", recipient, {"reason": plan.reason,
                                                   "keys": [fact.key for fact in plan.pending]})
                else:
                    outcome = self.deliver(plan)
                    if outcome["sent"]:
                        report["sent"].append(dict(outcome, recipient=recipient))
            except Exception as err:
                self._failed(recipient, "deliver", err, report)
        self.render(discovery, held, now, report)
        try:
            blocked_tick(self, discovery, held)
        except Exception as err:
            self._failed("blocked-alert", "blocked-alert", err, report)
        finish_pass(self, discovery, report)
        if self.reads.deferred:   # the budget kept what was remembered for this many reads this pass: said, once per change of the count
            self._note("v2_reads.deferred", None, {"reads": self.reads.deferred})
        feed_tick(self)   # #290: the event feed's bounded re-sync and reconciliation reads (never raises)
        record_v2_calls(self)
        record_github_calls(self)
        return report

    # -- render: the sidebar badge and the toast

    def unread_count(self, observation, held):
        """The unread badge for one agent, derived on every pass, never stored:
        the facts in switchboard notes that wait in v2's inbox for a turn to
        carry them, plus the facts held for the agent. A note a turn has
        carried is read; a wake starts its own turn, so it is never unread."""
        # An agent with something pending (a held plan) is never served from memory: a send or a note for it is noticed at the next pass.
        inbox = [] if self.light else self.reads.inbox(observation.session_id, self.now(), fresh=observation.name in held)
        waiting = [item for item in (inbox if isinstance(inbox, list) else [])
                   if isinstance(item, dict) and (_fleet_meta(item) or {}).get("from") == "switchboard"
                   and item.get("delivery") == "steer" and item.get("resume") is not True]
        count = sum(max(1, len(_fleet_keys(item))) for item in waiting)
        plan = held.get(observation.name)
        return count + (len(plan.pending) if plan else 0)

    def render_badges(self, discovery, held, report):
        """Write `unread` where it differs from what herdr's agent list shows."""
        shown = {entry.get("pane_id"): (entry.get("tokens") or {}).get("unread") for entry in discovery.entries}
        for name, observation in sorted(discovery.agents.items()):
            if not observation.pane or (getattr(self, "config", None) or {}).get("no_multiplexer") is True:   # no pane, or no multiplexer to write to: no badge, no error
                continue
            try:
                count = self.unread_count(observation, held)
                current = shown.get(observation.pane)
                if count == 0 and current is None or count and current == str(count):
                    continue
                detail = {"pane": observation.pane, "badge": "unread", "count": count, "was": current}
                with self._external("herdr.badge", name, detail):
                    if count:
                        self.herdr.pane_report_metadata_token(observation.pane, "unread", count)
                    else:
                        self.herdr.pane_clear_token(observation.pane, "unread")
                report["badges"].append({"agent": name, "count": count})
            except Exception as err:
                self._failed(name, "badge", err, report)

    def source_toasts(self):
        return collect_source_toasts(self)

    def toast_candidates(self, discovery, held, now):
        """[(agent, reason, title, body)], one per agent, most urgent reason first:
        a pane on another program, a blocked agent, items held past the limit."""
        wanted = {}
        for name, plan in held.items():
            if now - min(fact.created for fact in plan.pending) >= HELD_TOAST_AFTER:
                wanted[name] = ("held: %s" % plan.reason, "%s: %d item(s) held" % (name, len(plan.pending)),
                                plan.reason)
        for name, observation in discovery.agents.items():
            if observation.wrong_program:
                wanted[name] = ("different opencode", "%s: pane runs a different opencode" % name,
                                observation.problem)
            elif observation.status == "blocked":
                wanted[name] = ("blocked", "%s is blocked" % name,
                                "%s is waiting on a permission request or a question" % name)
        for name, found in self.source_toasts().items():  # says what is asked, so it wins over the generic one
            if wanted.get(name, ("",))[0] != "different opencode":
                wanted[name] = found
        return [(name,) + wanted[name] for name in sorted(wanted)]

    def render_toast(self, discovery, held, now, report):
        """At most one toast per pass (herdr allows one a second, and queues none),
        for the first agent whose reason has not been toasted yet. A reason
        that has cleared is forgotten, so it toasts again if it comes back."""
        if (getattr(self, "config", None) or {}).get("no_multiplexer") is True:   # a toast is a multiplexer call and goes to no pane here: none is tried, none fails
            return
        candidates = self.toast_candidates(discovery, held, now)
        self.toasted = {name: reason for name, reason in self.toasted.items()
                        if any(c[0] == name and c[1] == reason for c in candidates)}
        for name, reason, title, body in candidates:
            if self.toasted.get(name) == reason:
                continue
            with self._external("herdr.notification", name, {"reason": reason, "title": title}) as result:
                reply = self.herdr.notification_show(title, body)
                result["reply"] = reply
            if reply["shown"] or reply["reason"] == "disabled":
                self.toasted[name] = reason  # shown, or herdr has toasts off for good
            report["toasts"].append({"agent": name, "reason": reason, "shown": reply["shown"],
                                     "why": reply["reason"]})
            return  # rate_limited, busy, no_foreground_client: owed, tried again next pass

    def render(self, discovery, held, now, report):
        """Step 5: update herdr. A failure here is audited and never stops the pass."""
        if self.audit is None:
            return
        steps = (("badge", lambda: self.render_badges(discovery, held, report)),
                 ("toast", lambda: self.render_toast(discovery, held, now, report)))
        for step, call in steps:
            try:
                call()
            except Exception as err:
                self._failed(None, step, err, report)

    # -- the CLI's entry points

    def send(self, sender, recipient, text, issue=None, repo=None, interrupt=False):
        """Deliver `text` to `recipient` now, by the rule, without batching. Stores nothing. `interrupt`: only a
        boss to its own worker; raises InterruptRefused otherwise."""
        now = self.now()
        discovery = self.discover(now)
        recipient = resolve_boss(discovery, recipient)   # `chief-of-staff` is the role: it reaches the one agent with that role (#80), as a report does
        if interrupt:
            target = discovery.agents.get(recipient)
            if target is None or boss_name(discovery, target) != sender:
                reason = ("%s is not an agent of this fleet that reports to you" % recipient if target is None
                          else "only a boss may interrupt, and %s does not report to %s" % (recipient, sender))
                if self.audit is not None:
                    self.audit.append(self.actor, "interrupt.refused", recipient, {"from": sender, "reason": reason})
                raise InterruptRefused(reason)
        fact = Fact("send:%s:%s" % (sender, uuid.uuid4().hex[:16]), recipient, "send", text, now,
                    issue=None if issue is None else int(issue), batch=False, sender=sender,
                    repo=repo or issue_repo(issue))
        fact.supersedes = self.waiting_earlier(discovery, recipient, sender, fact.repo, fact.issue, now)
        outcome = self.send_fact(fact, discovery, now, interrupt=interrupt)
        if outcome.get("sent") and sender != recipient and sender in discovery.agents and self.state_dir is not None:
            # Beside `report`'s record: both count as being in touch with that boss. #352: only a send that woke the boss is one a report folds
            # into, and under v2_light nothing folds, so no issue is kept there.
            record_last_send(self.state_dir, sender, recipient, now, repo=repo or issue_repo(issue),
                             issue=issue if outcome.get("action") == "wake" and not self.light else None)
        return outcome

    def repos_in_play(self):
        """The repos messages may be about: every watched repo. With one, a message names `#2`; with
        several, `api#2` (PR 15)."""
        discovery = getattr(self, "discovery", None)
        return watched_repos(self.config, discovered_fleets(discovery))

    def send_fact(self, fact, discovery, now, carried=(), interrupt=False, folded=False):
        """The one delivery path of `send` and `report`: `fact` (and any `carried` riders) now, by the rule. `folded` (#352): a report that
        follows the sender's own earlier send is delivered as a note: it never wakes the boss a second time."""
        recipient = fact.recipient
        plan = self.plan(recipient, [fact] + list(carried), discovery, now)
        if folded and plan is not None and plan.action == "wake":
            plan.action, plan.reason, plan.folded = "note", "folded into the sender's earlier message: no second wake", True
        if plan.action == "hold":
            if self.audit is not None:
                self.audit.append(self.actor, "hold", recipient, {"reason": plan.reason, "keys": [fact.key]})
            note_held_send(self.state_dir, recipient, fact.sender, now, plan.observation)
            return {"sent": False, "action": "hold", "reason": plan.reason}
        return self.deliver(plan, interrupt=interrupt)

    def report(self, sender, state, text, issue=None, everything=False):
        """PR 13: `sender` tells the one it reports to what happened. An attention report (done, failed, blocked,
        question) is delivered now, by `send`'s own path, with the progress reports waiting for that boss. A
        progress report (working, paused, withdrawn) is a rider: recorded, and carried by the next message. Raises
        ReportError when it cannot be a report."""
        if state not in REPORT_STATES:
            raise ReportError("state must be one of %s, got %r" % (", ".join(REPORT_STATES), state))
        text = " ".join((text or "").split())
        if not text:
            raise ReportError("a report needs one line saying what happened")
        if len(text) > REPORT_MAX:
            raise ReportError("a report is one line of at most %d characters (this one is %d): put the detail on "
                              "GitHub and report its link" % (REPORT_MAX, len(text)))
        if everything and state != "withdrawn":
            raise ReportError("--all only goes with `withdrawn`")
        if state == "withdrawn":
            if everything:
                text = WITHDRAW_ALL + text
            elif text.startswith(WITHDRAW_ALL.strip()):
                text = "- " + text  # a plain withdrawal never reads as --all
        now = self.now()
        discovery = self.discover(now)
        me = discovery.agents.get(sender)
        if me is None:
            raise ReportError(discovery.missing(sender))
        boss = boss_name(discovery, me)  # the role name chief-of-staff resolves to the registered cos agent (#102)
        if boss is None:
            raise ReportError("%s reports to nobody: its fleet metadata has no reports_to, so there is no one to "
                              "tell (use `%s send <name> ...` for a message)" % (sender, PROG))
        repo, number = resolve_issue(self.config, issue, me.fleet, watched_repos(self.config, discovered_fleets(discovery)))
        if number is not None and issue is not None:
            self.check_issue_exists(repo, number, own_repo=(me.fleet or {}).get("repo"))
        if number is None:
            number, repo = _issue_of(me.fleet), _fleet_repo(me.fleet, self.config) if _issue_of(me.fleet) else None
        fact = Fact("%s:%s:%s" % (REPORT, sender, uuid.uuid4().hex[:16]), boss, REPORT, "%s: %s" % (state, text),
                    now, issue=number, batch=False, sender=sender, repo=repo,
                    rider=state in REPORT_PROGRESS and not fault("no-rider"))
        if fact.rider:
            if self.state_dir is not None and not record_last_report(self.state_dir, sender, state, now, text):
                self._note("fleetpane.error", sender, {"error": "last-reports.json not written: %s's final report will not retire it automatically" % sender})
            record_report_rider(self, fact)
            return {"sent": False, "action": "rider", "reason": "a progress report is a rider: it rides in the "
                    "next message to %s and never wakes it" % boss, "key": fact.key, "recipient": boss}
        waiting = [f for f in report_rider_facts(self) if f.recipient == boss]
        earlier = None
        if self.state_dir is not None and not self.light:   # #352: read BEFORE this report is recorded. Never under v2_light: an unread note is not converted to a wake there, so a folded question could sit unread
            earlier = load_report_fold().follows(_read_small(self.state_dir, LAST_REPORT_FILE).get(sender), boss, repo, number, now)
        if earlier is not None:
            fact.summary = load_report_fold().marked(fact.summary, earlier, now)
        if self.state_dir is not None and not record_last_report(self.state_dir, sender, state, now, text):
            self._note("fleetpane.error", sender, {"error": "last-reports.json not written: %s's final report will not retire it automatically" % sender})
        outcome = self.send_fact(fact, discovery, now, waiting, folded=earlier is not None)
        if state == "done" and outcome.get("sent") and self.state_dir is not None and worktree_config(self.config)["on_done"]:
            try:   # a final done report reclaims the worker's registered worktrees: removed when clean and pushed, else kept with the reason
                lines = reclaim_for_agent(self, subprocess.run, sender, False, "done report")   # a dry run: a worker often goes on in the same worktree, so only `retire` or `disk reclaim-worktrees --apply` removes
                lines = [l.replace(": would remove (", ": reclaimable: clean and pushed, `retire` or `disk reclaim-worktrees --apply` removes it (") for l in lines]
                if lines:
                    outcome = dict(outcome, worktrees=lines)
            except Exception as err:
                self._note("worktree.error", sender, {"error": _one_line(str(err), 120)})
        return outcome

    def check_issue_exists(self, repo, number, wait=None, own_repo=None):
        """#89: refuse a report tagged to an issue GitHub says does not exist (a report to a ghost can only be
        cleared by a send on the same ghost). Best effort: no reader, an unreadable or slow lookup, or any answer
        but a clear "not found" accepts the report. The reader's cache serves a known issue without a read."""
        reader = self.intents
        if reader is None:
            return
        if repo not in (None, reader.repo, own_repo):
            return  # a repo this report was only guessed into: not worth refusing a report over
        wait = REPORT_LOOKUP_WAIT if wait is None else wait
        box = {}

        def look():
            try:
                reader.issue(number, repo)
            except IntentError as err:
                box["error"] = err
            except Exception:
                pass  # unreadable: accepted

        thread = threading.Thread(target=look, daemon=True)
        thread.start()
        thread.join(wait)
        err = box.get("error")
        if err is not None and err.reason == "not_found":
            raise ReportError("issue %s#%d does not exist, so a report cannot be tagged to it: check the number "
                              "(or leave --issue out to use your own ask)" % (repo or reader.repo, number))

    def pending(self, name, discovery=None, facts=None):
        """Read-only: what is pending for `name`, and what the rule says about it."""
        now = self.now()
        discovery = discovery or self.discover(now)
        problems = []
        if facts is None:
            facts, problems = self.collect_facts()
        mine = [fact for fact in facts if fact.recipient == name]
        plan, riders = self.plan_with_riders(name, mine, discovery, now) if mine else (None, [])
        observation = discovery.agents.get(name)
        return {"name": name, "observation": observation.to_json() if observation else None,
                "missing": None if observation else discovery.missing(name),
                "plan": plan.to_json() if plan else None, "source_problems": problems,
                "riders": [fact.to_json() for fact in riders]}


# ============================================================================
# PR 7: the decision model, the classifier and the policy judge's questions
#
# One section, so the stack rebases cleanly. docs/switchboard.md, "Classify: a
# decision model" and "The judge". Registered in four places: the config check
# (`validate_jev_config`), `Switchboard.__init__` (`build_jev`), `run_pass`
# (`run_shadow_classifier`) and the unknown-key list (`PR7_CONFIG_KEYS`).
# ============================================================================
import socket
import urllib.error
import urllib.request

JEV_MODEL = "typesafe/jev-1.13"
JEV_URL = "https://openrouter.ai/api/v1/systemone"
JEV_KEY_ENV = "OPENROUTER_API_KEY"
JEV_DEFAULTS = {
    "model": JEV_MODEL,
    "url": JEV_URL,
    "key_env": JEV_KEY_ENV,       # the NAME of the variable that holds the key, never the key
    "key_file": None,             # PR 16: a private file that holds the key; None means jev.key beside config.json
    "timeout_seconds": 20,
    "min_confidence": 0.7,        # the classifier's threshold; SF2 will choose the real one
    "record_file": None,          # append every real call here as a request/response pair
    "replay": None,               # answer from this file instead of calling Jev
}
PR7_CONFIG_KEYS = ("jev", "shadow_judges")
JEV_HTTP_REASONS = {400: "invalid", 401: "unauthorized", 402: "no_credit", 403: "unauthorized",
                    413: "too_large", 422: "invalid", 429: "rate_limited"}
JEV_REASONS = ("invalid", "unauthorized", "no_credit", "too_large", "rate_limited",
               "timeout", "unreachable", "bad_response")
JEV_TEXT_LIMIT = 1000   # characters of any one message or intent sent to Jev
JEV_DETAIL_LIMIT = 160  # characters of a provider's text kept in an error


def validate_jev_config(config, raw, source="config"):
    """Check and complete `jev` and `shadow_judges`. Silent when `raw` has neither."""
    if not any(name in raw for name in PR7_CONFIG_KEYS):
        return
    jev = raw.get("jev")
    if jev is not None:
        config["jev"] = _checked_jev_settings(jev, source)
    shadow = raw.get("shadow_judges")
    if shadow is not None and not isinstance(shadow, bool):
        raise ConfigError("%s: 'shadow_judges' must be true or false, got %r" % (source, shadow))
    if shadow and jev is None:
        raise ConfigError("%s: 'shadow_judges' needs a 'jev' object: there is no decision model to ask" % source)
    config["shadow_judges"] = (jev is not None) if shadow is None else shadow


def _checked_jev_settings(jev, source):
    if not isinstance(jev, dict):
        raise ConfigError("%s: 'jev' must be an object, got %r" % (source, type(jev).__name__))
    unknown = sorted(set(jev) - set(JEV_DEFAULTS))
    if unknown:
        warn_unknown_config("%s: 'jev' contains key(s) this tool does not read: %s (known: %s)"
                          % (source, ", ".join(unknown), ", ".join(JEV_DEFAULTS)), 'jev', unknown, list(JEV_DEFAULTS))
    settings = dict(JEV_DEFAULTS, **jev)
    for name in ("model", "url", "key_env"):
        if not isinstance(settings[name], str) or not settings[name].strip():
            raise ConfigError("%s: 'jev.%s' must be a non-empty string, got %r" % (source, name, settings[name]))
    if not re.match(r"^[A-Za-z_][A-Za-z0-9_]*$", settings["key_env"]):
        raise ConfigError("%s: 'jev.key_env' is the NAME of an environment variable, got %r "
                          "(never put the key itself in this file)" % (source, settings["key_env"]))
    if not re.match(r"^(https://|http://(localhost|127\.0\.0\.1)[:/])", settings["url"]):
        raise ConfigError("%s: 'jev.url' must be https (the key travels with it), got %r" % (source, settings["url"]))
    if not _is_number(settings["timeout_seconds"]) or settings["timeout_seconds"] <= 0:
        raise ConfigError("%s: 'jev.timeout_seconds' must be a positive number, got %r"
                          % (source, settings["timeout_seconds"]))
    if not _is_number(settings["min_confidence"]) or not 0 < settings["min_confidence"] <= 1:
        raise ConfigError("%s: 'jev.min_confidence' must be a number above 0 and at most 1, got %r"
                          % (source, settings["min_confidence"]))
    for name in ("record_file", "replay", "key_file"):
        value = settings[name]
        if value is not None and (not isinstance(value, str) or not os.path.isabs(value)):
            raise ConfigError("%s: 'jev.%s' must be an absolute path, got %r" % (source, name, value))
    if settings["record_file"] and settings["replay"]:
        raise ConfigError("%s: 'jev' cannot both record real calls and replay recorded ones" % source)
    return settings


# ------------------------------------------------------------------ the client

class JevError(Exception):
    """A Jev call with no usable answer. `reason` is one of JEV_REASONS."""

    def __init__(self, reason, detail=None, latency_ms=None):
        self.reason, self.detail, self.latency_ms = reason, detail, latency_ms
        super().__init__("%s: %s" % (reason, detail) if detail else reason)


def _canonical(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":"))


def _scrub_provider_text(text, key=None):
    """One short line of a provider's text with the key (and any bearer value) removed."""
    text = str(text if text is not None else "")
    if key:
        text = text.replace(key, "[key]")
    text = re.sub(r"(?i)bearer\s+\S+", "Bearer [key]", text)
    return _one_line(text, JEV_DETAIL_LIMIT)


def _is_probability(value):
    return _is_number(value) and 0 <= value <= 1


def check_answers(questions, answers):
    """`answers` (a dict by question id, or a list in question order) as a dict, or JevError.

    A missing answer, an out-of-range probability or an option nobody offered
    is a bad answer, never a reading.
    """
    if isinstance(answers, list):
        if len(answers) != len(questions):
            raise JevError("bad_response", "%d answer(s) for %d question(s)" % (len(answers), len(questions)))
        answers = dict(zip(questions, answers))
    if not isinstance(answers, dict):
        raise JevError("bad_response", "no answers")
    for name, question in questions.items():
        answer = answers.get(name)
        if not isinstance(answer, dict):
            raise JevError("bad_response", "question %s is not answered" % name)
        if question.get("type") == "noul":
            if not _is_probability(answer.get("noul")):
                raise JevError("bad_response", "question %s: noul is not a probability" % name)
            continue
        if answer.get("choice") not in question.get("criteria", {}):
            raise JevError("bad_response", "question %s: choice is not one of the options" % name)
        probabilities = answer.get("probabilities")
        if probabilities is not None:
            values = list(probabilities.values()) if isinstance(probabilities, dict) else [None]
            if not all(_is_probability(v) for v in values) or abs(sum(values) - 1) > 0.01:
                raise JevError("bad_response", "question %s: probabilities do not sum to 1" % name)
            if set(probabilities) - set(question["criteria"]):
                raise JevError("bad_response", "question %s: probabilities name an option nobody offered" % name)
    return answers


class KeyFileError(Exception):
    """The key file exists and may not be used. Names the path and the rule, never the key."""


def jev_key_file(settings):
    """Where the decision-model key file is: `jev.key_file`, else jev.key beside config.json."""
    given = (settings or {}).get("key_file")
    return Path(given) if given else config_path().parent / "jev.key"


def locate_jev_key(settings, environ=None):
    """(key, source): the key and where it came from, `environment`, `file`, or (None, `none`).

    The variable named by `key_env` wins. Otherwise the key file, which must be a regular file (not a
    link) that you own and nobody else can read or write, and must not be empty: a file the group or
    the world can read is refused with the reason, and the key is never part of that reason.
    Raises KeyFileError.
    """
    environ = os.environ if environ is None else environ
    name = (settings or {}).get("key_env") or JEV_KEY_ENV
    value = environ.get(name)
    if value:
        return value, "environment"
    path = jev_key_file(settings)
    try:
        info = os.lstat(str(path))
    except FileNotFoundError:
        return None, "none"
    except OSError as err:
        raise KeyFileError("cannot read the key file %s: %s" % (path, err.strerror or err)) from None
    if not stat.S_ISREG(info.st_mode):
        raise KeyFileError("the key file %s must be a regular file, not a link or a directory" % path)
    if info.st_uid != os.getuid():
        raise KeyFileError("the key file %s must be owned by you" % path)
    if info.st_mode & 0o077:
        raise KeyFileError("the key file %s can be read by others: run `chmod 0600 %s`, or save the key again "
                           "with `%s key set` (mode 0600, owned by you)" % (path, path, PROG))
    try:
        text = path.read_text().strip()
    except OSError as err:
        raise KeyFileError("cannot read the key file %s: %s" % (path, err.strerror or err)) from None
    if not text:
        raise KeyFileError("the key file %s is empty" % path)
    return text, "file"


def jev_secrets(config, environ=None):
    """The decision-model key as a list (empty when there is none or the file is refused): what redaction hides."""
    if not config.get("jev"):
        return []
    try:
        key, _ = locate_jev_key(config["jev"], environ)
    except KeyFileError:
        return []
    return [key] if key else []


def _usage_of(usage):
    """The numbers of a usage block under names the audit does not redact."""
    usage = usage if isinstance(usage, dict) else {}
    pairs = (("in", "input_tokens"), ("out", "output_tokens"), ("cost", "cost"))
    return {short: usage[name] for short, name in pairs if _is_number(usage.get(name))}


class JevClient:
    """The decision model over HTTPS (OpenRouter's System One endpoint).

    The key is read from the environment variable named in the config at the
    moment of each call. It is never stored on the client, written to a file,
    put in an argument list, or kept in an error. `opener` has urlopen's shape
    so tests inject a fake and never reach a network.
    """

    def __init__(self, settings, environ=None, opener=None, clock=time.monotonic):
        self.settings = settings
        self.environ = os.environ if environ is None else environ
        self.opener = opener or urllib.request.urlopen
        self.clock = clock

    def decide(self, state, questions):
        """{"model", "answers", "usage", "latency_ms"}. Raises JevError, with the latency."""
        started = self.clock()
        try:
            try:
                key, _ = locate_jev_key(self.settings, self.environ)
            except KeyFileError as err:
                raise JevError("unauthorized", str(err)) from None
            if not key:
                raise JevError("unauthorized", "no key in $%s or the key file" % self.settings["key_env"])
            body = {"model": self.settings["model"], "state": state, "questions": questions}
            out = self._post(body, key)
            answers = check_answers(questions, out.get("answers"))
        except JevError as err:
            err.latency_ms = int((self.clock() - started) * 1000)
            raise
        result = {"model": _scrub_provider_text(out.get("model") or self.settings["model"], key), "answers": answers,
                  "usage": _usage_of(out.get("usage")), "latency_ms": int((self.clock() - started) * 1000)}
        self._record(body, out)
        return result

    def _post(self, body, key):
        request = urllib.request.Request(
            self.settings["url"], data=json.dumps(body).encode("utf-8"), method="POST",
            headers={"Authorization": "Bearer " + key, "Content-Type": "application/json",
                     "Accept": "application/json"})
        response = None
        try:
            response = self.opener(request, timeout=self.settings["timeout_seconds"])
            raw = response.read()
        except urllib.error.HTTPError as err:
            reason = JEV_HTTP_REASONS.get(err.code, "unreachable")
            raise JevError(reason, "HTTP %s %s" % (err.code, _scrub_provider_text(self._body_of(err), key)))
        except (socket.timeout, TimeoutError):
            raise JevError("timeout", "no answer in %ss" % self.settings["timeout_seconds"])
        except urllib.error.URLError as err:
            if isinstance(err.reason, (socket.timeout, TimeoutError)):
                raise JevError("timeout", "no answer in %ss" % self.settings["timeout_seconds"])
            raise JevError("unreachable", _scrub_provider_text(err.reason, key))
        except OSError as err:
            raise JevError("unreachable", _scrub_provider_text(err, key))
        finally:
            if response is not None and hasattr(response, "close"):
                response.close()
        try:
            out = json.loads(raw)
        except (TypeError, ValueError):
            raise JevError("bad_response", "the answer is not JSON")
        if not isinstance(out, dict):
            raise JevError("bad_response", "the answer is not an object")
        return out

    @staticmethod
    def _body_of(err):
        try:
            return err.read().decode("utf-8", "replace")
        except Exception:
            return ""

    def _record(self, body, out):
        path = self.settings.get("record_file")
        if not path:
            return
        line = json.dumps({"request": body, "response": out}, sort_keys=True) + "\n"
        fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
        with os.fdopen(fd, "a") as handle:
            handle.write(line)


class ReplayJev:
    """Answers from a hand-written or recorded file, never from the network.

    The file is a JSON object {"pairs": [...], "rules": [...]} or JSON lines of
    pairs (what `jev.record_file` writes). A pair is {"request": {state,
    questions[, model]}, "response": {answers[, model, usage]}} and matches an
    identical request. A rule is {"contains": text, "choice": {option: p},
    "noul": {question: p}, "error": reason} and matches a request whose
    "message" contains the text (a rule without "contains" matches anything);
    the first match wins. A question nobody answered is an error, loudly.
    """

    def __init__(self, path, model=JEV_MODEL):
        self.path, self.model = path, model
        self._pairs = self._rules = None

    def _load(self):
        if self._pairs is not None:
            return
        try:
            text = Path(self.path).read_text()
            try:
                data = json.loads(text)
            except ValueError:
                data = {"pairs": [json.loads(line) for line in text.splitlines() if line.strip()]}
            if "request" in data:  # a record file holding exactly one line parses as that pair
                data = {"pairs": [data]}
            pairs, rules = list(data.get("pairs") or []), list(data.get("rules") or [])
        except (OSError, ValueError, AttributeError) as err:
            raise JevError("bad_response", "cannot read the replay file: %s" % _scrub_provider_text(err))
        self._pairs = {_canonical({"model": p["request"].get("model", self.model),
                                   "state": p["request"].get("state"),
                                   "questions": p["request"].get("questions")}): p["response"] for p in pairs}
        self._rules = rules

    def decide(self, state, questions):
        self._load()
        response = self._pairs.get(_canonical({"model": self.model, "state": state, "questions": questions}))
        if response is None:
            response = self._by_rule(state, questions)
        answers = check_answers(questions, response.get("answers"))
        return {"model": str(response.get("model") or self.model), "answers": answers,
                "usage": _usage_of(response.get("usage")), "latency_ms": int(response.get("latency_ms") or 0)}

    def _by_rule(self, state, questions):
        message = state.get("message") if isinstance(state, dict) else None
        subject = message if isinstance(message, str) else _canonical(state)
        for rule in self._rules:
            if rule.get("contains", "") in subject:
                if rule.get("error") in JEV_REASONS:
                    raise JevError(rule["error"], "replayed")
                return {"answers": self._answers_of(rule, questions), "model": rule.get("model")}
        raise JevError("bad_response", "nothing recorded for this question")

    @staticmethod
    def _answers_of(rule, questions):
        answers = {}
        for name, question in questions.items():
            if question.get("type") == "noul":
                answers[name] = {"type": "noul", "noul": (rule.get("noul") or {}).get(name, 0.0)}
                continue
            options = list(question.get("criteria", {}))
            given = rule.get("choice") or {}
            probabilities = {option: given.get(option, 0.0) for option in options}
            total = sum(p for p in probabilities.values() if _is_number(p))
            if total > 0:  # a rule may name options this question lacks: scale what is left to 1
                probabilities = {option: p / total for option, p in probabilities.items()}
            top = max(options, key=lambda option: (probabilities[option], option == "current"))
            answers[name] = {"type": "choice", "choice": top, "probabilities": probabilities}
        return answers


def build_jev(config):
    """The decision model the config asks for, or None when `jev` is not configured."""
    settings = config.get("jev")
    if not settings:
        return None
    if settings.get("replay"):
        return ReplayJev(settings["replay"], settings["model"])
    return JevClient(settings)


# ----------------------------------------------------------------- the classifier

CLASSIFY_ID = "about"
CLASSIFY_INSTRUCTIONS = (
    "The Chief of Staff is an AI assistant working for one person, who has just sent a new message. "
    "Which of the following is the new message about: the work in progress, an ask somebody else is "
    "already working on, or something new?")


def _clip(text, limit=JEV_TEXT_LIMIT):
    text = "" if text is None else str(text)
    return text if len(text) <= limit else text[:limit - 1] + "\u2026"


def _ask_line(ask):
    ask = ask or {}
    line = _clip(ask.get("intent") or "no stated intent", 300)
    if ask.get("done_when"):
        line += " (done when: %s)" % _clip(ask["done_when"], 200)
    return line


def classify_options(current_ask, open_asks):
    """Option name -> its criterion: `current`, one per open ask by issue number, `new`."""
    options = {"current": "The message is about the work in progress now: %s." % _ask_line(current_ask)}
    own = str((current_ask or {}).get("issue"))
    for ask in open_asks or []:
        name = str(ask["issue"])
        if name == own:
            continue  # the current ask is `current`, not a second option
        options[name] = "The message is about ask %s (%s), which %s already owns." % (
            name, _clip(ask.get("intent") or "no stated intent", 300), ask.get("owner") or "someone")
    options["new"] = "The message is about something else: new work unrelated to the work in progress and to every open ask."
    return options


def classify_request(message, previous_message, current_ask, open_asks):
    """(state, questions) for one classification."""
    state = {"message": _clip(message), "previous_message": _clip(previous_message) if previous_message else None,
             "current_ask": {"issue": (current_ask or {}).get("issue"), "intent": _ask_line(current_ask)},
             "open_asks": [{"issue": str(a["issue"]), "intent": _clip(a.get("intent") or "", 300),
                            "owner": a.get("owner")} for a in open_asks or []]}
    question = {"type": "choice", "instructions": CLASSIFY_INSTRUCTIONS,
                "criteria": classify_options(current_ask, open_asks)}
    return state, {CLASSIFY_ID: question}


def _default_current(reason, extra=None):
    out = {"choice": "current", "probabilities": None, "confident": False, "reason": reason,
           "jev_choice": None, "model": None, "usage": {}, "latency_ms": None}
    out.update(extra or {})
    return out


def classify(jev, message, previous_message, current_ask, open_asks, min_confidence=0.7):
    """One Jev call: {choice, probabilities, confident, reason, ...}. Never raises on Jev's account.

    `confident` is true when the top probability reaches `min_confidence`. When
    Jev is unreachable, errs, or is unsure, the choice is `current`: the safe
    default changes nothing. `jev_choice` keeps what Jev said, for the audit.
    """
    state, questions = classify_request(message, previous_message, current_ask, open_asks)
    try:
        result = jev.decide(state, questions)
    except JevError as err:
        return _default_current("jev %s" % err.reason, {"latency_ms": err.latency_ms})
    answer = result["answers"][CLASSIFY_ID]
    probabilities = answer.get("probabilities")
    out = {"probabilities": probabilities, "jev_choice": answer["choice"], "model": result["model"],
           "usage": result["usage"], "latency_ms": result["latency_ms"]}
    if not probabilities:
        return dict(_default_current("jev gave no probabilities"), **out, choice="current")
    top = probabilities.get(answer["choice"], 0.0)
    if top < min_confidence:
        return dict(out, choice="current", confident=False,
                    reason="unsure: %s at %.2f is below %.2f" % (answer["choice"], top, min_confidence))
    return dict(out, choice=answer["choice"], confident=True, reason="confident: %s at %.2f" % (answer["choice"], top))


# ---------------------------------------------------------- the policy judge's questions

POLICY_THRESHOLD = 0.5
# Issue 87: in a labelled sample of 100 shadow verdicts the model's probabilities were poorly calibrated: every
# `outside_intent` that fired (0.50 to 0.87) and nearly every `speaks_for_you` and `outside_scope` below 0.9 was wrong, while
# the right ones sat at 0.97. So these three fire at 0.9; `hard_to_reverse` keeps 0.5 (a missed destructive call costs more).
# A configured `policy.thresholds` entry still wins, per question.
POLICY_DEFAULT_THRESHOLDS = {"outside_intent": 0.9, "speaks_for_you": 0.9, "outside_scope": 0.9, "hard_to_reverse": POLICY_THRESHOLD}
POLICY_OUTCOMES = ("allow", "ask", "deny", "hard-deny")  # least to most strict
POLICY_QUESTIONS = {
    "outside_intent": ("Is this action beyond the ask's Intent and Done-when?",
                       "The action goes beyond what the Intent and Done-when ask for.",
                       "The action is part of doing what the Intent and Done-when ask for."),
    "hard_to_reverse": ("Is this action destructive, irreversible or security-sensitive?",
                        "It destroys data, cannot be undone, or weakens security.",
                        "It is easy to undo and touches nothing sensitive."),
    "speaks_for_you": ("Is this action a merge, deploy, publish, message to other people, or spend that "
                       "the charter's standing authority does not cover?",
                       "It merges, deploys, publishes, messages others or spends, and nothing in the "
                       "standing authority covers it.",
                       "It does none of those, or the standing authority covers it."),
    "outside_scope": ("Does this action touch a repository, environment, account or credential outside "
                      "this agent's assignment?",
                      "It touches something outside what this agent was assigned.",
                      "It stays inside what this agent was assigned."),
}
POLICY_ASK_FOR = ("hard_to_reverse", "speaks_for_you", "outside_scope")


def policy_questions():
    """The four yes/no questions, by id."""
    return {name: {"type": "noul", "instructions": text, "criteria": {"true": yes, "false": no}}
            for name, (text, yes, no) in POLICY_QUESTIONS.items()}


def policy_state(role, intent, done_when, authority, tool, arguments):
    return {"role": role, "intent": _clip(intent, 600), "done_when": _clip(done_when, 400),
            "standing_authority": authority, "tool": tool,
            "arguments": _clip(_canonical(arguments) if not isinstance(arguments, str) else arguments, 1500)}


def _stricter(first, second):
    return max((first, second), key=POLICY_OUTCOMES.index)


def combine_policy(answers, thresholds=None, configured="allow"):
    """The outcome of the four answers, never looser than `configured` (invariant 9).

    `answers` maps question id to a probability, or None when unanswered.
    outside_intent at its threshold is a hard deny; any of the other three is
    an ask; an unanswered or malformed answer counts for nothing, so the
    configured outcome stands. Returns {outcome, configured, fired, reason}.
    """
    if configured not in POLICY_OUTCOMES:
        raise ValueError("unknown configured outcome: %r" % (configured,))
    limits = dict.fromkeys(POLICY_QUESTIONS, POLICY_THRESHOLD)
    limits.update(thresholds or {})
    answers = answers or {}
    fired = [name for name in POLICY_QUESTIONS
             if _is_probability(answers.get(name)) and answers[name] >= limits[name]]
    judged = "allow"
    if "outside_intent" in fired:
        judged = "hard-deny"
    elif any(name in fired for name in POLICY_ASK_FOR):
        judged = "ask"
    if fault("judge-loosens"):
        outcome = judged  # the fault: the judge's word replaces the configured outcome
    else:
        outcome = _stricter(configured, judged)
    reason = "judge: %s" % ", ".join(fired) if fired else "judge: nothing at its threshold"
    return {"outcome": outcome, "configured": configured, "fired": fired, "reason": reason}


def judge_tool_call(jev, configured, state, thresholds=None):
    """Ask the four questions about one tool call and combine them. Never raises, never loosens.

    No answer (slow, unreachable, an error) leaves the configured outcome.
    """
    questions = policy_questions()
    try:
        result = jev.decide(state, questions)
    except JevError as err:
        combined = combine_policy(None, thresholds, configured)
        combined.update(reason="judge unavailable (%s): configured outcome stands" % err.reason,
                        latency_ms=err.latency_ms, usage={})
        return combined
    answers = {name: result["answers"][name]["noul"] for name in questions}
    combined = combine_policy(answers, thresholds, configured)
    combined.update(answers=answers, latency_ms=result["latency_ms"], usage=result["usage"], model=result["model"])
    return combined


# ------------------------------------------------------- shadow mode in the engine

def _message_text(message):
    text = message.get("text")
    if isinstance(text, str):
        return text
    parts = message.get("content")
    if isinstance(parts, list):
        return "\n".join(p.get("text", "") for p in parts if isinstance(p, dict) and isinstance(p.get("text"), str))
    return ""


def human_prompts(messages):
    """Your prompts in a transcript read newest first: type `user` without `metadata.fleet`."""
    return [m for m in messages if isinstance(m, dict) and m.get("type") == "user" and _fleet_meta(m) is None]


def _ask_of(fleet, owner=None):
    issue = fleet.get("issue")
    if issue is None:
        return None
    return {"issue": issue, "intent": fleet.get("intent") or "", "owner": owner, "repo": fleet.get("repo")}


def open_asks_of(discovery, cos_name):
    """The asks others hold: a fleet agent with an issue, other than the Chief of Staff.

    Intent text arrives with `fleet-switchboard intents` (PR 6); until then an
    ask has its issue number and owner only.
    """
    asks, seen = [], set()
    for name, other in sorted(discovery.agents.items()):
        ask = _ask_of(other.fleet, name)
        if name != cos_name and ask and (ask["repo"], ask["issue"]) not in seen:
            seen.add((ask["repo"], ask["issue"]))
            asks.append(ask)
    return asks


def _classify_audit(engine, observation, message, previous, request, answer, shadow=True):
    state, questions = request
    detail = {"agent": observation.name, "session": observation.session_id, "message_id": message.get("id"),
              "status": observation.status, "shadow": shadow,
              "question": {"state": state, "options": list(questions[CLASSIFY_ID]["criteria"])},
              "answer": {"choice": answer["choice"], "confident": answer["confident"],
                         "reason": answer["reason"], "jev_choice": answer["jev_choice"],
                         "probabilities": answer["probabilities"]},
              "model": answer["model"], "usage": answer["usage"], "latency_ms": answer["latency_ms"]}
    engine.audit.append(engine.actor, "classify", "classify:%s:%s" % (observation.session_id, message.get("id")), detail)


def shadow_classify(engine, observation, discovery, now):
    """Classify your newest prompt to a Chief of Staff once, and write what Jev said. Acts on nothing."""
    prompts = newest_prompts(engine, observation.session_id)
    if not prompts:
        return False
    message = prompts[0]
    created = _created(message)
    key = "classify:%s:%s" % (observation.session_id, message.get("id"))
    if message.get("id") is None or key in engine._classified:
        return False
    if created is None or now - created > engine.engaged_seconds:
        return False
    engine._classified.add(key)  # one attempt per message, whatever the answer
    asks = ask_intents(engine, open_asks_of(discovery, observation.name))  # PR 8: with their Intent
    if observation.status != "working" and not asks:
        return False  # nothing to choose between: it simply becomes the foreground work
    previous = _message_text(prompts[1]) if len(prompts) > 1 else None
    current = ask_intent(engine, _ask_of(observation.fleet, observation.name))
    request = classify_request(_message_text(message), previous, current, asks)
    answer = classify(engine.jev, _message_text(message), previous, current, asks,
                      engine.config["jev"]["min_confidence"])
    _classify_audit(engine, observation, message, previous, request, answer, shadow=not acting(engine))
    if acting(engine):  # PR 8
        note_decision(engine, observation, message, current, asks, answer)
    return True


def run_shadow_classifier(engine, discovery, now):
    """Each Chief of Staff, once per new prompt. A failure is audited and never stops the pass."""
    if engine.jev is None or engine.audit is None or not (engine.config.get("shadow_judges") or acting(engine)):
        return
    if fault("no-classify"):
        return
    for observation in list(discovery.agents.values()):
        if observation.fleet.get("role") != "chief-of-staff" or observation.problem:
            continue
        try:
            shadow_classify(engine, observation, discovery, now)
        except Exception as err:
            engine.audit.append(engine.actor, "error", observation.name,
                                {"step": "classify", "error": "%s: %s" % (type(err).__name__, _one_line(str(err)))})


# ------------------------------------------------- the poke socket and the daemon

POKE_SOCKET = "poke.sock"
ENSURE_PATIENCE = 3.0  # seconds `ensure` waits for the daemon to take its lock
POKE_ALARM = 2         # seconds before a stuck `poke` ends itself


@contextmanager
def in_directory(path):
    """Work from `path` for the block. A unix socket path is limited to about
    100 bytes, so the poke socket is always named relative to the state dir."""
    before = os.getcwd()
    os.chdir(str(path))
    try:
        yield
    finally:
        os.chdir(before)


def open_poke_socket(state_dir):
    """The daemon's end: a datagram socket at $STATE/poke.sock, a stale one replaced."""
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    try:
        with in_directory(state_dir):
            try:
                os.unlink(POKE_SOCKET)
            except FileNotFoundError:
                pass
            sock.bind(POKE_SOCKET)
            os.chmod(POKE_SOCKET, 0o600)
        sock.setblocking(False)
    except BaseException:
        sock.close()
        raise
    return sock


def send_poke(state_dir):
    """Ask the daemon for a pass. One non-blocking datagram; True when it was sent.

    Never blocks and never raises: a daemon that is down, or too busy to take
    one more datagram, has not lost anything, because the next pass derives
    everything again.
    """
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    try:
        sock.setblocking(False)
        with in_directory(state_dir):
            sock.sendto(b"poke", POKE_SOCKET)
        return True
    except OSError:
        return False
    finally:
        sock.close()


def drain_pokes(sock):
    """Read every datagram waiting. Returns how many."""
    count = 0
    while sock is not None:
        try:
            sock.recv(64)
        except (BlockingIOError, InterruptedError):
            break
        count += 1
    return count


def wait_for_poke(sock, timeout):
    """Wait up to `timeout` seconds for a poke. True when one came."""
    if sock is None:
        time.sleep(timeout)
        return False
    ready, _, _ = select.select([sock], [], [], timeout)
    return bool(ready)


DAEMON_RECORD = "daemon.json"  # what the running daemon says about itself: its pid, and where its key came from


def run_daemon(engine, state_dir, poll, wait=None, passes=None, record=None, watch=None, on_reload=None):
    """`run`: a pass on every poke, and at least every `poll` seconds, under the
    single-instance lock.

    The daemon waits on its poke socket with select, and drains every datagram
    before each pass, so a burst of events is one pass. A pass that raises is
    audited and the loop goes on; only a SimulatedCrash (or a signal) ends it.
    `wait(sock, timeout)` and `passes` are for tests and `--once`. `record` is written to daemon.json
    once the lock is held, with this pid: `status` reads it to say what the DAEMON has, not what the shell
    that runs `status` has.
    """
    wait = wait or wait_for_poke
    with single_instance(state_dir):
        if record is not None:
            _write_private(Path(state_dir) / DAEMON_RECORD,
                           json.dumps(dict(record, pid=os.getpid(), started_at=iso(engine.now())), sort_keys=True) + "\n")
        try:
            sock = open_poke_socket(state_dir)
        except OSError as err:  # no pokes then; the poll interval still passes
            sock = None
            engine._note("poke.unavailable", None, {"error": _one_line(str(err))})
        try:
            done = 0
            while True:
                drain_pokes(sock)
                if watch is not None and on_reload is not None and watch.check() == "reload":
                    on_reload(watch)  # does not return when the daemon re-executes itself
                try:
                    engine.run_pass()
                except Exception as err:
                    engine._failed(None, "pass", err, {"errors": []})
                done += 1
                if passes is not None and done >= passes:
                    return done
                timeout = next_poll(engine, poll)
                wait(sock, min(timeout, CONFIG_STABLE_SECONDS) if watch is not None and watch.pending else timeout)
        finally:
            if sock is not None:
                sock.close()


def run_lock_held(state_dir):
    """True when a daemon holds run.lock. Takes and drops the lock to find out."""
    fd = os.open(str(Path(state_dir) / "run.lock"), os.O_RDWR | os.O_CREAT, 0o600)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return True
        return False
    finally:
        os.close(fd)


# What names a CALLER (an agent's pane, its session, its role and repo): the daemon is nobody's agent, so it never carries them,
# whichever shell started it, and neither do the processes it starts.
CALLER_ENV_NAMES = ("HERDR_PANE_ID", "HERDR_TAB_ID", "HERDR_WORKSPACE_ID", "OPENCODE_SESSION_ID",
                    "FLEET_SWITCHBOARD_ROLE", "FLEET_SWITCHBOARD_REPO")
OWN_GH_ENV = "FLEET_SWITCHBOARD_OWN_GH"   # set in every switchboard process: its gh calls name their own account (GhAccounts);
                                          # the gh shim leaves such a call's token alone and never re-identifies it


def daemon_environment(environ):
    """The environment for a daemon started from a hook: herdr's server env minus the hook's own pane (whatever pane you
    had focused) and every other name of a caller (session, role, repo): started from an agent's shell, it would otherwise
    BE that agent to the gh shim, which would swap the token of each of the daemon's own gh calls."""
    return {name: value for name, value in environ.items()
            if not name.startswith("HERDR_PLUGIN_") and name not in CALLER_ENV_NAMES}


def spawn_daemon(state_dir, spawn=subprocess.Popen):
    """Start `run` in a session of its own, with none of the caller's pipes.

    herdr waits for EOF on a hook's stdout and stderr, and counts the hook as
    running until then; a daemon that kept them would hold a plugin slot for
    ever. Its output goes to $STATE/daemon.log, and setsid keeps it alive
    when herdr's hook runner is cleaned up.
    """
    log = os.open(str(Path(state_dir) / "daemon.log"), os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
    try:
        return spawn([sys.executable, os.path.realpath(__file__), "run"], stdin=subprocess.DEVNULL,
                     stdout=log, stderr=log, close_fds=True, start_new_session=True,
                     cwd=str(state_dir), env=daemon_environment(os.environ))
    finally:
        os.close(log)


@contextmanager
def ensure_lock(state_dir, patience, sleep=time.sleep):
    """Serialise concurrent `ensure` runs: a startup hook and a person at once."""
    fd = os.open(str(Path(state_dir) / "ensure.lock"), os.O_RDWR | os.O_CREAT, 0o600)
    try:
        waited = 0.0
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError:
                if waited >= patience:
                    raise LockError("another ensure is still starting the daemon") from None
                sleep(0.05)
                waited += 0.05
        yield
    finally:
        os.close(fd)


def ensure_daemon(state_dir, spawn=subprocess.Popen, patience=ENSURE_PATIENCE, sleep=time.sleep):
    """Make sure a daemon runs. Returns "running" or "started"; raises LockError
    when a started daemon did not take its lock within `patience` seconds."""
    with ensure_lock(state_dir, patience, sleep):
        if run_lock_held(state_dir):
            return "running"
        spawn_daemon(state_dir, spawn)
        waited = 0.0
        while not run_lock_held(state_dir):
            if waited >= patience:
                raise LockError("the daemon did not start within %gs; see %s" % (
                    patience, Path(state_dir) / "daemon.log"))
            sleep(0.05)
            waited += 0.05
        return "started"


# ----------------------------------------------------------------- launching

LAUNCH_PATIENCE = 30  # seconds for the new pane to show the v2 on the new session
NAME_RE = re.compile(r"^[a-z][a-z0-9_-]{0,31}$")  # herdr's own pattern for an agent name


class LaunchError(Exception):
    """A launch that did not finish, and what it left behind."""


class HeadlessRefused(LaunchError):
    """The headless ROUTE was refused for this launch (the account route, the service, the record), as opposed to a bad name or an existing worker (#433).
    A plain `launch` that took headless from its default falls back to a terminal on this; an explicit `--headless` shows it as the refusal it is."""


RESERVED_AGENT_NAMES = ("fleet-switchboard", "switchboard", "plan-review", "owner")   # names the switchboard itself acts under: no agent may take one
LANE_NAME_PREFIX = "planrev-"   # the plan review engine names its reviewer lanes: only it launches them


def launch_agent_problem(config, runner, agent):
    """Why `agent` cannot be launched: the OpenCode service does not know it (an agent with no installed definition starts as the default Build
    agent with the brief unsent), or knows it only as a subagent (a pane runs a primary agent). None when it is a registered primary agent, or when
    the service cannot be asked (v2 then refuses it itself)."""
    state, found = agents_found(runner, config.get("opencode") or "opencode", AGENTS_VERIFY_TIMEOUT)
    if state != "up":
        return None
    known = ", ".join(sorted(n for n, (mode, _) in found.items() if mode == "primary")) or "none"
    if agent in found:
        if found[agent][0] in ("primary", "all"):   # `all` can run as a pane's agent too (OpenCode modes: primary, subagent, all)
            return None
        return ("--agent %r is registered as a %s, not a primary agent: a launched pane runs a primary agent, and a subagent is run by another agent's Task tool "
                "(primary agents registered: %s)" % (agent, found[agent][0], known))
    return ("--agent %r is not registered with the OpenCode service, so it would start as the default agent and the brief would not be sent "
            "(primary agents registered: %s). Install its definition, restart the service, and check it with `fleet-switchboard agents verify`" % (agent, known))


def launch_problems(name, agent, directory, workspace, issue, charter=None, headless=False):
    """Why these launch arguments cannot be used (empty when they can). A headless worker has no terminal, so it needs no workspace."""
    problems = []
    if not NAME_RE.match(name or ""):
        problems.append("name must match %s (lower case, digits, - and _), got %r" % (NAME_RE.pattern, name))
    if (name or "").lower() in RESERVED_AGENT_NAMES:
        problems.append("the name %r is reserved: the switchboard acts under it, so no agent may carry it" % name)
    if not agent:
        problems.append("--agent is required")
    if not directory or not os.path.isabs(directory) or not os.path.isdir(directory):
        problems.append("--dir must be an absolute path of an existing directory, got %r" % directory)
    if not workspace and not headless:
        problems.append("no target workspace: pass --workspace or run from a herdr pane")
    if issue is not None and not (isinstance(issue, int) and not isinstance(issue, bool) and issue >= 1):
        problems.append("--issue must be an issue number, got %r" % (issue,))
    if charter is not None and not (isinstance(charter, int) and not isinstance(charter, bool) and charter >= 1):
        problems.append("--charter must be an issue number, got %r" % (charter,))
    return problems


def fleet_record(name, role, reports_to, issue, charter=None, repo=None, launched_by=None, read_repo=None):
    fleet = {"name": name, "role": role, "reports_to": reports_to, "issue": None if issue is None else int(issue),
             "charter": charter, "repo": repo, "launched_by": launched_by, "read_repo": read_repo}   # launched_by (#372): the agent that ran `launch`, as its pane identified it; None from a plain shell
    return {key: value for key, value in fleet.items() if value is not None}


def pane_problem(engine, pane, session_id):
    """None when `pane` shows the v2 TUI on `session_id`, else the first thing wrong.

    Positive evidence only: herdr names the agent and the session, and the
    pane's own process is the configured v2 executable. Anything unread or
    unclear is a problem, never a pass.
    """
    try:
        entry = engine.herdr.agent_get(pane)
        programs = [p.get("cmdline") for p in engine.herdr.pane_process_info(pane)]
    except HerdrError as err:
        return "herdr cannot say what pane %s shows yet: %s" % (pane, err)
    if entry.get("agent") != "opencode":
        return "herdr sees agent %r in pane %s, not opencode" % (entry.get("agent"), pane)
    if agent_session(entry) != session_id:
        return "pane %s shows session %s, not %s" % (pane, agent_session(entry), session_id)
    if not any(runs_program(cmdline, engine.executable) for cmdline in programs):
        return "pane %s runs %s, not the configured v2 %s" % (
            pane, _one_line("; ".join(str(c) for c in programs), 120) or "nothing", engine.executable)
    return None


def wait_until_verified(engine, pane, session_id, patience, sleep):
    deadline, problem = engine.now() + patience, None
    while True:
        problem = pane_problem(engine, pane, session_id)
        if problem is None:
            return
        if engine.now() >= deadline:
            raise LaunchError("could not verify the new pane: %s" % problem)
        sleep(1)


def close_own_pane(engine, name, pane, why):
    """Close the one pane this launch opened. Never anything else."""
    try:
        with engine._external("herdr.pane.close", name, {"pane": pane, "why": why}):
            engine.herdr.pane_close(pane)
        return "closed pane %s" % pane
    except Exception as err:  # the original failure matters more than this one
        return "could not close pane %s: %s" % (pane, _one_line(str(err)))


def send_brief(engine, name, session_id, brief):
    """The one place a brief is sent: a prompt whose metadata says it is the brief (`fleet.brief`), which is how a
    later run finds out it was sent."""
    with engine._external("v2.session.prompt", name, {"session": session_id, "brief_chars": len(brief)}):
        engine.v2.prompt(session_id, brief, {"fleet": {"from": "switchboard", "brief": True}})
    engine.reads.forget(session_id)   # a write: what was remembered of this session is old


BRIEF_SCAN_USER = 10  # the oldest user messages read for the brief; a session with more than that many is not one that never got its brief


def brief_in_transcript(engine, session_id):
    """Whether the session's transcript holds a message whose metadata says it is the brief. A listing too long to
    read to its end is taken to hold one: a duplicate brief in a long conversation does more harm than none."""
    if getattr(engine, "light", False):
        return True   # v2_light: no scan; a brief is never sent twice for want of looking
    page = engine.v2.message_list(session_id, limit=BRIEF_SCAN_USER, order="asc", type="user")   # the brief is among a session's first prompts: one small read
    page = page if isinstance(page, list) else []
    return any((_fleet_meta(message) or {}).get("brief") for message in page) or len(page) >= BRIEF_SCAN_USER


VIEW_ROLE_ENV = "FLEET_SWITCHBOARD_ROLE"  # PR 18: what the pane's TUI reads to pick its Decisions view
VIEW_REPO_ENV = "FLEET_SWITCHBOARD_REPO"


NO_CREDENTIAL_DIALOG_ENV = {"GIT_TERMINAL_PROMPT": "0", "GCM_INTERACTIVE": "never"}   # #1050: no git call of the fleet may open a credential dialog (shims/git sets them too)


def launch_base_env(config):
    """The environment of a terminal launch or reattach: the configured opencode_env and launch_env, plus the two variables that stop a credential dialog (#1050). They go last: a config cannot turn them off."""
    env = dict(config["opencode_env"])
    env.update(config["launch_env"])
    env.update(NO_CREDENTIAL_DIALOG_ENV)
    return env


def view_env(role, repo):
    """The pane's environment that tells its TUI who it is (not secrets): the Decisions panel shows every tier and
    repo to the Chief of Staff, one repo to a pane that names it, the human tier to any other."""
    env = {}
    if isinstance(role, str) and role:
        env[VIEW_ROLE_ENV] = role
    if isinstance(repo, str) and repo:
        env[VIEW_REPO_ENV] = repo
    return env


AGENT_TMP_ENV = "FLEET_AGENT_TMPDIR"   # read by the private wrapper only: it becomes the agent's TMPDIR (#767)


def headless_tmp_root():
    """The temp root the fleet-hooks plugin makes a headless worker's private directory under (#846): the same path the pane wrapper's profile uses.
    The plugin has no config to read, so unlike a pane's, it does not depend on the wrapper."""
    return _xdg("XDG_DATA_HOME", ".local/share") / PROG / "profile" / "tmp"


def agent_tmp_root(config):
    """The profile's shared temp root when panes run through the private wrapper (the one that exports TMPDIR), else None (a shared profile or a test
    has no wrapper, so there is nothing to override)."""
    try:
        data = _xdg("XDG_DATA_HOME", ".local/share") / PROG
        if str(config.get("opencode") or "") != str(data / "bin" / WRAPPER_NAME):
            return None
        return data / "profile" / "tmp"
    except Exception:
        return None


def agent_tmp_shared_name(name):
    """The Chief of Staff and the plan review lanes keep the shared temp directory (unchanged by #767)."""
    return name == "cos" or (name or "").startswith(LANE_NAME_PREFIX)


def agent_tmp_env(engine, name):
    """{FLEET_AGENT_TMPDIR: dir} for a pane: a private directory (0700) named from the agent, made now under the profile's temp root. {} when panes
    have no wrapper. A directory that cannot be made fails the launch (LaunchError): the agent is never started on the shared directory."""
    root = agent_tmp_root(engine.config)
    if root is None or agent_tmp_shared_name(name):
        return {}
    if not NAME_RE.fullmatch(name or ""):
        raise LaunchError("no private temp directory for %r: not a valid agent name" % (name,))
    path = root / name
    try:
        root.mkdir(parents=True, exist_ok=True)
        try:
            path.mkdir(mode=0o700)
        except FileExistsError:
            pass   # a resume or a second launch of the name: the same directory, checked below
        info = os.lstat(str(path))
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
            raise OSError("exists and is not a directory of ours")
        fd = os.open(str(path), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)   # no symlink swapped in after the check
        try:
            os.fchmod(fd, 0o700)
        finally:
            os.close(fd)
    except OSError as err:
        raise LaunchError("cannot make the private temp directory %s (%s): %s was not started (it never runs on the shared temp directory)" % (path, err.strerror or err, name)) from None
    return {AGENT_TMP_ENV: str(path)}


def reclaim_agent_tmp(engine, name, headless=False):
    """At retire: the agent's private TMPDIR is removed when it is EMPTY, else kept and the reason said. Never forced, never recursive. Returns lines.
    A headless worker's directory (#846, made by the plugin) is under the same root and goes by the same rule."""
    root = agent_tmp_root(engine.config) or (headless_tmp_root() if headless else None)
    if root is None or not NAME_RE.fullmatch(name or "") or agent_tmp_shared_name(name):
        return []
    path = root / name
    if not os.path.lexists(str(path)):
        return []
    try:
        if path.is_symlink() or not path.is_dir():
            return ["%s: kept (not a plain directory)" % path]
        left = len(os.listdir(str(path)))
        if left:
            return ["%s: kept (%d file(s) still in it; remove them by hand)" % (path, left)]
        os.rmdir(str(path))
        return ["%s: removed (empty)" % path]
    except OSError as err:
        return ["%s: kept (%s)" % (path, err.strerror or err)]


def record_launch_charter(engine, name, session_id, fleet, pane=None):
    """#969: a launch is the first sight of an orchestrator: its registry row takes the launch's `--charter` at once (the observation pass would only fill it later, after an adoption or a lane lookup may already
    have looked). Only an orchestrator launched with a charter; a failure is left to the pass (never raises)."""
    try:
        if engine.state_dir is not None and (fleet or {}).get("role") == "orchestrator" and isinstance(fleet.get("charter"), int) and not isinstance(fleet.get("charter"), bool):
            load_module("registry").upsert(engine.state_dir, name, {"session": session_id, "pane": pane, "role": "orchestrator", "charter": fleet["charter"], "repo": fleet.get("repo")}, now=engine.now())
    except Exception:
        pass


def launch_agent(engine, name, agent, directory, workspace, role=None, reports_to=None, issue=None,
                 brief=None, patience=LAUNCH_PATIENCE, sleep=time.sleep, charter=None, repo=None, launched_by=None, read_repo=None):
    """Create a fleet agent: a v2 session, its own herdr tab, the brief.

    Nothing is typed. The tab's program is started by argv through herdr's
    socket, so no shell and no PATH decide which OpenCode runs. The brief is
    sent only after the pane is proved to run the configured v2 on the new
    session. A failure after the pane opened closes that pane, and no other.
    Returns {"name", "session", "pane", "tab"}.
    """
    problems = launch_problems(name, agent, directory, workspace, issue, charter)
    if problems:
        raise LaunchError("; ".join(problems))
    taken = engine.discover(engine.now()).agents.get(name)
    if taken is not None:
        raise LaunchError("a fleet agent named %s already runs in pane %s" % (name, taken.pane))
    fleet = fleet_record(name, role, reports_to, issue, charter, repo, launched_by, read_repo)
    env = launch_base_env(engine.config)
    env.update(view_env(role, repo or (engine.config.get("intent_repo") if charter else None)))  # PR 18
    env.update(agent_tmp_env(engine, name))   # #767: before the session exists, so a failure leaves nothing started
    accounts = getattr(engine, "accounts", None)
    if repo and accounts is not None:  # PR 15: the agent works as its repo's gh account, and as nobody else
        problem = launch_account_problem(engine.config, accounts, repo)
        if problem:
            raise LaunchError(problem)
        try:
            env.update(accounts.token_env(repo))
        except AccountError as err:
            raise LaunchError(str(err)) from None
    with engine._external("v2.session.create", name, {"agent": agent, "directory": directory,
                                                      "fleet": fleet}) as result:
        session_id = engine.v2.session_create(agent, name, directory, {"fleet": fleet})["id"]
        result["session"] = session_id
        record_launch_charter(engine, name, session_id, fleet)
    argv = [engine.config["opencode"], "-s", session_id]
    pane = None
    try:
        with engine._external("herdr.layout.apply", name, {
                "workspace": workspace, "label": name, "cwd": directory, "argv": argv,
                "env_names": sorted(env), "session": session_id}) as result:
            opened = engine.herdr.open_tab_running(workspace, name, directory, argv, env)
            pane = result["pane"] = opened["pane_id"]
            result["tab"] = opened["tab_id"]
        wait_until_verified(engine, pane, session_id, patience, sleep)
        if brief:
            send_brief(engine, name, session_id, brief)
    except Exception as err:
        left = close_own_pane(engine, name, pane, "launch failed: %s" % _one_line(str(err), 120)) if pane \
            else "no pane was opened"
        raise LaunchError("%s (session %s was created; %s)" % (_one_line(str(err)), session_id, left)) from err
    register_launch_worktree(engine, name, directory, repo)
    return {"name": name, "session": session_id, "pane": pane, "tab": opened["tab_id"]}


def register_launch_worktree(engine, name, directory, repo):
    """A launch into a linked worktree records it, so retire and a done report can reclaim it later. Never raises."""
    if engine.state_dir is None:
        return
    try:
        found = worktree_of_directory(subprocess.run, directory)
        if found is not None:
            done = register_worktree(engine.state_dir, found[0], name, repo, found[1], engine.now())
            if isinstance(done, str):   # already claimed by another agent: never taken over
                engine._note("worktree.error", name, {"error": "the worktree %s is already registered to %s: %s does not claim it and will not reclaim it" % (found[0], done, name)})
            elif done is True:
                if engine.audit is not None:
                    engine.audit.append(engine.actor, "worktree.registered", name, {"path": found[0], "branch": found[1], "repo": repo, "by": "launch"})
            else:   # it will not be reclaimed later: say so now
                engine._note("worktree.error", name, {"error": "the worktree %s could not be recorded in the registry: it will not be reclaimed automatically" % found[0]})
    except Exception as err:
        engine._note("worktree.error", name, {"error": _one_line(str(err), 120)})


def launch_headless(engine, name, agent, directory, role=None, reports_to=None, issue=None, brief=None, charter=None, repo=None, launched_by=None):
    """Create a fleet agent with NO terminal (#433): a v2 session in the OpenCode service, a private record (state-dir/headless/<name>.json) and the
    brief through the API. Nothing is opened in herdr. Presence is proved by the service: the new session must answer and carry the worker's name
    before the brief is sent. Returns {"name", "session", "pane": None, "tab": None, "headless": True}.

    What differs from a terminal worker, and is said in the docs: its tools run in the SERVICE's environment, not in a pane's. There is no
    per-worker environment (no GH_TOKEN of its repo's account, no view variables); it is identified by the OPENCODE_SESSION_ID the service sets for
    its tools, and the gh shim picks its account from the session's stored repo. Only `cmd_launch` calls this, after the lane-name guard, the agent
    check and the gate probe."""
    problems = launch_problems(name, agent, directory, None, issue, charter, headless=True)
    if problems:
        raise LaunchError("; ".join(problems))
    if engine.state_dir is None:
        raise LaunchError("no state directory: a headless worker needs its record")
    try:
        with agent_lock(engine.state_dir, name):   # the name check, the session create and the record write are ONE step: two launches of one name cannot both pass
            taken = engine.discover(engine.now()).agents.get(name)
            if taken is not None:
                raise LaunchError("a fleet agent named %s already exists (%s)" % (name, "headless" if taken.headless else "in pane %s" % taken.pane))
            ap = load_agent_presence()
            if ap.read_record(engine.state_dir, name)[0] is not None:
                raise LaunchError("a headless record for %s already exists: `%s retire %s` first, or pick another name" % (name, PROG, name))
            identity = headless_identity(engine, repo)   # a repo that maps to a named gh account is refused unless the route can be proved (below, once the session exists)
            account = engine.accounts.account_for(repo) if repo and getattr(engine, "accounts", None) is not None else None
            fleet = fleet_record(name, role, reports_to, issue, charter, repo, launched_by)
            fleet["headless"] = True
            try:
                with engine._external("v2.session.create", name, {"agent": agent, "directory": directory, "fleet": fleet, "headless": True}) as result:
                    session_id = engine.v2.session_create(agent, name, directory, {"fleet": fleet})["id"]
                    result["session"] = session_id
            except LaunchError:
                raise
            except Exception as err:   # the service did not answer or refused: a route problem, not a mistake in the arguments
                raise HeadlessRefused("the OpenCode service could not create the session (%s)" % _one_line(str(err), 120)) from err
            brief_started = False
            try:
                record_launch_charter(engine, name, session_id, fleet)
                ap.save_record(engine.state_dir, name, session_id, engine.v2.service_url(), now=engine.now())
                info = engine.v2.session_get(session_id) or {}
                if ((_fleet_meta(info) or {}).get("name")) != name:
                    raise LaunchError("the service does not show the new session as %s: nothing was sent" % name)
                if account:
                    identity = prove_headless_route(engine, session_id, name, repo, account)   # before the brief: nothing runs as a wrong account
                if brief:
                    brief_started = True   # from here a failure may have delivered the brief: it is never a reason to start the worker a second time
                    send_brief(engine, name, session_id, brief)
                if engine.audit is not None:
                    engine.audit.append(engine.actor, "headless.launched", name, {"session": session_id, "agent": agent, "directory": _one_line(directory, 160), "brief_chars": len(brief or ""), "account": account or None, "repo": repo, "route": "shims+record" if account else None})
            except Exception as err:
                remains = []
                cleaned = undo_headless_launch(engine, ap, name, session_id, remains)
                # only a route problem found BEFORE the brief, with nothing left behind, may be answered by a terminal (#433): else a second worker would start beside the first
                refused = (isinstance(err, HeadlessRefused) or not isinstance(err, LaunchError)) and not brief_started and not remains
                raise (HeadlessRefused if refused else LaunchError)("%s (%s)" % (_one_line(str(err)), cleaned)) from err
    except ImpactStateBusy:
        raise LaunchError("another launch or reattach of %s is running: wait for it" % name) from None
    register_launch_worktree(engine, name, directory, repo)
    return {"name": name, "session": session_id, "pane": None, "tab": None, "headless": True, "identity": identity}


def headless_identity(engine, repo):
    """The identity a headless worker will have, as one line; refuses (LaunchError) when it would be the WRONG one.

    A terminal worker is pinned to its repo's gh account by its pane's environment (GH_TOKEN). A headless worker's tools run in the OpenCode service,
    where nothing per session is durable (`PUT /api/session/{id}/environment` is lost on a service restart). What IS durable is the per-command route:
    the fleet-hooks plugin puts the `gh` and `git` shims first on PATH of every shell command, and the shim asks `whoami --json` (the command's
    OPENCODE_SESSION_ID and the repo in the session's metadata) which account to use, for that one command. So a repo that `gh_users` maps to a named
    account is accepted only when `engine.route_check` exists and `prove_headless_route` proves that route for the new session; with no route check
    it is refused, as before. Any other worker acts as the account of the service's environment, and says so."""
    accounts = getattr(engine, "accounts", None)
    if repo and accounts is None:   # fail closed: with no account map nothing says which account this repo uses
        raise HeadlessRefused("cannot tell which gh account %s uses (no account map): a headless worker is refused" % repo)
    if repo:
        account = accounts.account_for(repo)
        if account:
            if getattr(engine, "route_check", None) is None:
                raise HeadlessRefused("a headless worker cannot work as the gh account %s that gh_users maps %s to: its tools run in the OpenCode service's environment, "
                                  "which cannot be pinned to an account (a service restart drops any per-session setting), so it would act as the service's own "
                                  "default account. Use a terminal launch (omit --headless)" % (account, repo))
            problem = engine.route_check()   # the shims the service puts first on PATH exist: a text, or None
            if problem:
                raise HeadlessRefused("a headless worker cannot work as the gh account %s that gh_users maps %s to: its tools run in the OpenCode service's environment, "
                                  "which cannot be pinned to an account, and the per-command route that would choose it cannot be proved (%s). "
                                  "Use a terminal launch (omit --headless)" % (account, repo, problem))
            return "this headless worker is set up to act as the gh account %s for %s (the gh and git shims choose it per command; the service side is not checked yet)" % (account, repo)
        problem = launch_account_problem(engine.config, accounts, repo)
        if problem:
            raise HeadlessRefused(problem)
        return "this headless worker acts as the OpenCode service environment's own gh account (gh_users has no entry for %s)" % repo
    return "this headless worker acts as the OpenCode service environment's own gh account (it has no repo)"


def shim_route_problem(environ=None, home=None, config_dir=None, kit_root=None):
    """None when what the OpenCode service loads would put this checkout's `gh` and `git` shims first on a shell's PATH, else the reason. Two things are read
    (files only, nothing written): (1) the shims: FLEET_SWITCHBOARD_SHIMS, or else the `shims` directory beside the checkout that ~/.local/bin/fleet-switchboard
    links to, each of `gh` and `git` executable; (2) the install state of the plugin: `plugins/fleet-hooks.js` in the OpenCode profile's config directory
    (`opencode_config_dir` of the caller, else $XDG_CONFIG_HOME/opencode) is present and byte-equal to this checkout's plugin. It cannot see the service's own
    environment: a mistake-guard, not a proof."""
    environ = os.environ if environ is None else environ
    given = environ.get("FLEET_SWITCHBOARD_SHIMS")
    try:
        if given:
            shims = Path(given)
            if not shims.is_absolute():
                return "FLEET_SWITCHBOARD_SHIMS is not an absolute path, so the plugin's shell hook is off"
        else:
            shims = Path(os.path.realpath(Path(home or Path.home()) / ".local" / "bin" / "fleet-switchboard")).parent.parent / "shims"
        for tool in ("gh", "git"):
            if not os.access(shims / tool, os.X_OK):
                return "the %s shim is not in place, so the plugin's shell hook has nothing to put first on PATH" % tool
        config = Path(config_dir) if config_dir else _xdg("XDG_CONFIG_HOME", ".config") / "opencode"
        installed = config / "plugins" / HOOKS_PLUGIN_FILE
        wanted = (Path(kit_root or KIT_ROOT) / "plugins" / "fleet-hooks" / "index.js").read_bytes()
        try:
            have = installed.read_bytes()
        except FileNotFoundError:
            return "the plugin file %s is not installed in the OpenCode profile (%s), so the service has no shell hook" % (HOOKS_PLUGIN_FILE, config)
        if hashlib.sha256(have).digest() != hashlib.sha256(wanted).digest():
            return "the installed plugin file %s (%s) differs from this checkout's: run `%s install`" % (HOOKS_PLUGIN_FILE, config, PROG)
    except OSError as err:
        return "the shims or the plugin file cannot be read (%s)" % _one_line(str(err))
    return None


def prove_headless_route(engine, session_id, name, repo, account):
    """A best-effort check, NOT a proof of the service side: the same lookup the gh shim makes from a command of the new session (`whoami --json`: its OPENCODE_SESSION_ID, then the repo in the service's
    own record of that session) must name this worker and this repo, and the map must give the repo's account. Names only, never a token. Raises
    LaunchError (the caller deletes the session) when it does not."""
    try:
        fleet = session_identity(engine.herdr, engine.v2, {SESSION_ENV: session_id})
    except (V2Error, CallerError, IdentityUncertain) as err:
        raise HeadlessRefused("a headless worker cannot be proved to act as the gh account %s for %s: the session lookup failed (%s)" % (account, repo, _one_line(str(err)))) from err
    seen = (fleet or {}).get("repo")
    if (fleet or {}).get("name") != name or seen != repo or engine.accounts.account_for(seen) != account:
        raise HeadlessRefused("a headless worker cannot be proved to act as the gh account %s for %s: the service's record of the session names %s as its repo" % (account, repo, seen or "none"))
    return ("this headless worker is set up to act as the gh account %s for %s: the shims and the installed plugin file are in place on the launcher's side and the session record resolves to that repo. "
            "NOT checked: that the OpenCode service runs the plugin it was started with (the installed plugin file is checked, not the running service; it cannot be probed "
            "without a model turn). This is a mistake-guard, not a boundary: a command can name another session, and a tool that reads a token from its own environment "
            "bypasses the shims. A terminal launch pins the account in the pane's environment" % (account, repo))


def undo_headless_launch(engine, ap, name, session_id, remains=None):
    """Best effort after a headless launch failed past `session.create`: stop whatever the brief started, delete the session, then remove the record.
    Returns one sentence saying exactly what was cleaned and what remains. The record is removed only when the session is gone: a session that is
    still there keeps its record, so `status` shows it and it is not invisible."""
    done, left = [], []
    interrupted = True
    try:
        engine.v2.interrupt(session_id)
    except Exception:
        interrupted = False   # best effort: the session is about to be deleted; said below if it could not be
    try:
        engine.v2.session_remove(session_id)
        done.append("session %s was deleted" % session_id)
        gone = True
    except V2Error as err:
        gone = err.reason == "http" and err.status == 404   # already gone is as good as deleted
        (done if gone else left).append("session %s was already gone" % session_id if gone else
                                         "session %s could NOT be deleted (%s): delete it in the OpenCode service" % (session_id, _one_line(str(err), 80)))
    except Exception as err:
        gone = False
        left.append("session %s could NOT be deleted (%s): delete it in the OpenCode service" % (session_id, _one_line(str(err), 80)))
    if gone:
        try:
            if ap.remove_record(engine.state_dir, name):
                done.append("its record was removed")
        except Exception as err:
            left.append("its record could NOT be removed (%s): `%s retire %s` clears it" % (_one_line(str(err), 80), PROG, name))
    if not gone and not interrupted:
        left.append("it could not be interrupted, so what the brief started may still be running")
    if not gone:
        try:
            has_record = ap.read_record(engine.state_dir, name)[0] is not None
        except Exception:
            has_record = False
        left.append("its record was kept so `%s status` shows it: `%s retire %s` stops watching it" % (PROG, PROG, name) if has_record
                    else "it has no record, so nothing shows it")
    try:
        if engine.audit is not None:
            engine.audit.append(engine.actor, "headless.launch_undone", name, {"session": session_id, "cleaned": done, "remains": left})
    except Exception:
        pass   # the sentence below is the report; a failing audit sink must not hide it
    if remains is not None:
        remains.extend(left)   # the caller learns whether anything was left behind without reading the sentence
    return "launch failed; " + "; ".join(done + left if (done or left) else ["nothing was created"])


def resume_agent(engine, name, session_id, workspace, patience=LAUNCH_PATIENCE, sleep=time.sleep, replace=False):
    """Open a new tab on a fleet agent's EXISTING session: a restart that keeps its conversation.

    The session must carry metadata.fleet.name == `name` (so a wrong id cannot start someone
    else's session under this name), and no pane may already run `name`. Nothing is created in
    v2 and no brief is sent; the pane is proved to run this session before this returns. A
    failure after the pane opened closes that pane and no other.
    """
    if not NAME_RE.match(name or "") or not workspace:
        raise LaunchError("resume needs a valid name and a target workspace (got name %r, workspace %r)"
                          % (name, workspace))
    session = engine.v2.session_get(session_id)
    fleet = (session.get("metadata") or {}).get("fleet") or {}
    directory = ((session.get("location") or {}).get("directory")) or session.get("directory")
    if fleet.get("name") != name:
        raise LaunchError("session %s belongs to %r, not %r: refusing to start it under this name"
                          % (session_id, fleet.get("name"), name))
    if not directory or not os.path.isabs(directory):
        raise LaunchError("session %s has no working directory to open the tab in" % session_id)
    env = launch_base_env(engine.config)
    # Everything about who the agent is comes from the session's STORED fleet metadata, never from the caller: a reattached agent keeps its
    # repo, role, charter and gh account (a caller-given --repo that differs was refused by the command).
    repo = fleet.get("repo") or (engine.config.get("intent_repo") if fleet.get("charter") else None)
    env.update(view_env(fleet.get("role"), repo))  # PR 18
    env.update(agent_tmp_env(engine, name))   # #767
    accounts = getattr(engine, "accounts", None)
    if fleet.get("repo") and accounts is not None:
        try:
            env.update(accounts.token_env(fleet["repo"]))   # fetched BEFORE anything is closed: a failed lookup must not leave the agent with no pane
        except AccountError as err:
            raise LaunchError(str(err)) from None
    taken = engine.discover(engine.now()).agents.get(name)
    released = []
    if taken is not None and not taken.headless:   # a headless worker has no pane to release (#433: `watch` opens the first terminal on it)
        released = release_stale_binding(engine, name, taken, session_id, replace=replace)   # refuses (LaunchError) a pane that is really running it
    argv = [engine.config["opencode"], "-s", session_id]
    pane = None
    try:
        with engine._external("herdr.layout.apply", name, {
                "workspace": workspace, "label": name, "cwd": directory, "argv": argv,
                "env_names": sorted(env), "session": session_id, "resume": True, "repo": fleet.get("repo")}) as result:
            opened = engine.herdr.open_tab_running(workspace, name, directory, argv, env)
            pane = result["pane"] = opened["pane_id"]
            result["tab"] = opened["tab_id"]
        wait_until_verified(engine, pane, session_id, patience, sleep)
    except Exception as err:
        left = close_own_pane(engine, name, pane, "resume failed: %s" % _one_line(str(err), 120)) if pane \
            else "no pane was opened"
        raise LaunchError("%s (session %s is untouched; %s)" % (_one_line(str(err)), session_id, left)) from err
    done = {"name": name, "session": session_id, "pane": pane, "tab": opened["tab_id"]}
    if released:
        done["released"] = released
    return done


# ======================================================================
# The control plane (cos repairs a detached or dead pane through the switchboard, never by typing into one)
#
# A pane is ATTACHED when what it shows names the agent: its terminal title or the visible screen holds the agent's name or its session id.
# herdr's own `agent_session` value is NOT trusted alone (it kept naming the old session while the pane showed a fresh Build screen). A pane
# that shows something else is DETACHED; a pane herdr no longer has is DEAD. Both wake the Chief of Staff, which can `reattach`.
# ======================================================================

PANE_SETTLE_SECONDS = 5      # the two looks before a close are this far apart: a pane that is still active between them is never closed
PANE_READ_MAX = 8000         # characters of a pane's screen kept
PANE_FORGET_SECONDS = 3 * 86400   # a dead agent nobody repaired is forgotten (and stops waking cos) after this
RETIRED_FILE = "retired.json"            # {name: {"at", "by", "reason", "session", "auto"}}: finished workers, skipped by detection and reattach
LAST_REPORT_FILE = "last-reports.json"   # {sender: {"state", "at", "send_to": {recipient: epoch}}}: the last report each worker made and the last send to each recipient (written by `report` and `send`, read by the daemon); an entry may hold only `send_to`
RETIRED_SHOW_DAYS = 7                    # a retired agent is listed once in `status` as retired, then dropped after this many days
PANE_HEALTH_FILE = "pane-health.json"
PANE_CHECK_SECONDS = 60      # a pane is looked at again after this
PANE_CHECKS_PER_PASS = 20    # `herdr pane get` + `pane read` pairs one pass may make
PANE_MISSING_PASSES = 3      # a known agent absent from the herdr list this many passes in a row is DEAD (herdr restarts blink)
PANE_ATTACHED, PANE_DETACHED, PANE_DEAD, PANE_UNKNOWN = "attached", "detached", "dead", "unknown"


def _names_agent(text, name, session_id):
    """True when `text` holds the agent's session id, or its name as a whole word (so `cos` is not found inside `across`)."""
    lowered = (text or "").lower()
    if session_id and session_id.lower() in lowered:
        return True
    return bool(name) and re.search(r"(?<![a-z0-9_-])%s(?![a-z0-9_-])" % re.escape(name.lower()), lowered) is not None


def _shown_text(title, visible):
    return ("%s\n%s" % (title or "", visible or "")).lower()


def runs_session(processes, session_id):
    """True when a foreground process of the pane is `opencode ... -s <session_id>` (or --session): POSITIVE evidence the pane IS that session."""
    if not session_id:
        return False
    pattern = re.compile(r"(?:^|\s)(?:-s|--session)(?:\s+|=)%s(?:\s|$)" % re.escape(session_id))
    return any(pattern.search(str(p.get("cmdline") or "")) for p in processes)


def pane_state(engine, name, session_id, pane, known_names=(), known_sessions=()):
    """(state, why, info): `attached` when the pane's title or visible screen names the agent or its session; `detached` when it shows
    something else; `dead` when herdr has no such pane; `unknown` when herdr cannot be read (never a verdict). `info` carries the pane's
    workspace, tab, cwd and whether the screen shows ANOTHER fleet agent (then the pane is somebody's, not a stale screen)."""
    try:
        got = engine.herdr.pane_get(pane)
    except HerdrError as err:
        text = str(err).lower()
        if "not found" in text or "no such" in text or "unknown pane" in text:
            return PANE_DEAD, "herdr has no pane %s" % pane, {}
        return PANE_UNKNOWN, "herdr cannot say what pane %s shows: %s" % (pane, _one_line(str(err), 100)), {}
    title = got.get("terminal_title_stripped") or got.get("terminal_title") or ""
    # POSITIVE attach evidence first: the pane's foreground process is opencode on THIS session. Whatever its title says, it is live and attached.
    # A process list that cannot be read is unknown (a close needs proof, and no proof is not stale).
    try:
        processes = engine.herdr.pane_process_info(pane)
    except HerdrError as err:
        return PANE_UNKNOWN, "herdr cannot say what pane %s runs: %s" % (pane, _one_line(str(err), 80)), {}
    info = {"workspace": got.get("workspace_id"), "tab": got.get("tab_id"), "cwd": got.get("cwd"), "status": got.get("agent_status"),
            "title": _one_line(re.sub(r"[\x00-\x1f\x7f-\x9f]", " ", title), 80)}
    if runs_session(processes, session_id):
        info["live_session"] = True
        return PANE_ATTACHED, "the pane runs opencode on %s's session %s" % (name, session_id), info
    if _names_agent(title, name, session_id):
        return PANE_ATTACHED, "the pane's title names %s" % name, info
    # FAIL MODE: a screen that cannot be read is UNKNOWN, never "nothing is shown": the verdict `detached` leads to a closed tab, so it needs
    # positive evidence (a title that does not name the agent AND a screen that was read and does not either).
    try:
        visible = engine.herdr.pane_read_visible(pane)
    except HerdrError as err:
        return PANE_UNKNOWN, "the title of pane %s does not name %s and its screen could not be read: %s" % (pane, name, _one_line(str(err), 80)), info
    text = _shown_text(title, visible)
    if _names_agent(visible, name, session_id):
        return PANE_ATTACHED, "the pane shows %s" % name, info
    others = [n for n in known_names if n and n != name and _names_agent(text, n, None)] + [x for x in known_sessions if x and x != session_id and x.lower() in text]
    info["shows_another"] = others[:3]
    return PANE_DETACHED, "pane %s shows %r, not %s's session %s" % (pane, info["title"][:60], name, session_id), info


def pane_screen(engine, pane):
    """A hash of the pane's visible screen, or None when it cannot be read (then there is no proof of quiet)."""
    try:
        return hashlib.sha256(engine.herdr.pane_read_visible(pane).encode("utf-8", "replace")).hexdigest()
    except Exception:   # any failure to read is "no proof it is idle": nothing is closed
        return None


def release_stale_binding(engine, name, taken, session_id, replace=False):
    """`taken` is the Observation herdr still lists under `name`. Returns what was released (lines), or raises LaunchError. A pane whose screen
    names the agent is LIVE: refused, no double attach. A pane herdr no longer has, or one that shows a fresh screen with no session of any fleet
    agent, is stale: its tab is closed (the only close this makes) and the binding is gone. Anything else (the pane shows another agent) is refused."""
    discovery = getattr(engine, "discovery", None)
    names = list(discovery.agents) if discovery is not None else []
    sessions = [o.session_id for o in discovery.agents.values()] if discovery is not None else []
    state, why, info = pane_state(engine, name, session_id, taken.pane, names, sessions)
    if state == PANE_ATTACHED and info.get("live_session"):
        raise LaunchError("a fleet agent named %s already runs in pane %s: it runs its own live session (%s), so it is attached and is never closed, "
                          "with or without --replace; a wrong account is fixed by restarting that agent, not by closing its pane here" % (name, taken.pane, why))
    if state == PANE_ATTACHED and not replace:
        raise LaunchError("a fleet agent named %s already runs in pane %s (%s): close it first (or `reattach --replace` when it runs with the wrong "
                          "account or repo)" % (name, taken.pane, why))
    if state == PANE_UNKNOWN:
        raise LaunchError("a fleet agent named %s is bound to pane %s and herdr cannot say what it shows: %s" % (name, taken.pane, why))
    if state == PANE_DEAD:
        return ["pane %s is gone: its binding is released" % taken.pane]
    if info.get("shows_another") and state != PANE_ATTACHED:
        raise LaunchError("pane %s (bound to %s) shows another fleet agent (%s): not a stale screen, nothing was closed" % (
            taken.pane, name, ", ".join(info["shows_another"])))
    tab = info.get("tab")
    if not tab:
        raise LaunchError("pane %s is detached but herdr names no tab for it: nothing was closed" % taken.pane)
    # The close ends EVERY pane of the tab and rests on a read made a moment ago: so the tab must hold only this pane, it must not be working,
    # and the pane is judged AGAIN just before the close (a concurrent reattach or a person's typing changes it).
    if str(info.get("status") or "").lower() in ("working", "blocked"):
        raise LaunchError("pane %s is %s: it is not a stale screen, nothing was closed" % (taken.pane, str(info.get("status")).lower()))
    try:
        count = engine.herdr.tab_get(tab).get("pane_count")
    except HerdrError as err:
        raise LaunchError("herdr cannot say what tab %s holds (%s): nothing was closed" % (tab, _one_line(str(err), 80))) from None
    if count != 1:
        raise LaunchError("tab %s holds %s panes, not only the stale one: nothing was closed" % (tab, count))
    # PROOF BEFORE A CLOSE: two looks PANE_SETTLE_SECONDS apart must agree (same verdict, same tab, idle status, an UNCHANGED screen). One look is
    # never enough, and `--replace` needs the same proof: a pane that is typing, drawing or working between the looks is alive and is not closed.
    before = pane_screen(engine, taken.pane)
    time.sleep(PANE_SETTLE_SECONDS)
    again, why_again, again_info = pane_state(engine, name, session_id, taken.pane, names, sessions)
    after = pane_screen(engine, taken.pane)
    if again_info.get("live_session"):
        raise LaunchError("pane %s now runs %s's own live session: nothing was closed" % (taken.pane, name))
    if again != (PANE_ATTACHED if replace and state == PANE_ATTACHED else PANE_DETACHED) or again_info.get("shows_another") or again_info.get("tab") != tab:
        raise LaunchError("pane %s changed while it was being judged (%s): nothing was closed" % (taken.pane, why_again))
    if str(again_info.get("status") or "").lower() in ("working", "blocked"):
        raise LaunchError("pane %s became %s between the two looks: nothing was closed" % (taken.pane, str(again_info.get("status")).lower()))
    if before is None or after is None or before != after:
        raise LaunchError("pane %s showed activity (or could not be read) between the two looks: no proof it is idle, nothing was closed" % taken.pane)
    with engine._external("herdr.tab.close", name, {"pane": taken.pane, "tab": tab, "why": "stale binding: %s" % why}):
        engine.herdr.tab_close(tab)
    return ["pane %s was a detached screen with no session of its own (%s): tab %s closed" % (taken.pane, why, tab)]


def _read_small(state_dir, name):
    try:
        with open(str(Path(state_dir) / name), "rb") as handle:
            raw = json.loads(handle.read(1000001).decode("utf-8"))
    except (OSError, ValueError, UnicodeError):
        return {}
    return {k: v for k, v in raw.items() if isinstance(v, dict)} if isinstance(raw, dict) else {}


def _write_small(state_dir, name, data):
    path = Path(state_dir) / name
    temp = path.with_name("%s.%d.tmp" % (name, os.getpid()))
    fd = os.open(str(temp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        with os.fdopen(fd, "w") as handle:
            handle.write(json.dumps(data, indent=1, sort_keys=True) + "\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.rename(str(temp), str(path))
    except OSError:
        try:
            os.unlink(str(temp))
        except OSError:
            pass
        raise


def prune_retired(retired, now):
    """Entries long past the status window are dropped: the one bound, used by every writer of retired.json."""
    for old in [n for n, v in retired.items() if now - (v.get("at") or 0) > 4 * RETIRED_SHOW_DAYS * 86400]:
        retired.pop(old, None)
    return retired


def retired_agent(retired, name, session):
    """True when `name` is retired for THIS session (a retirement with no session covers any); a relaunch under the same name is not."""
    entry = retired.get(name)
    return isinstance(entry, dict) and entry.get("session") is not None and entry.get("session") == session   # no session on the record: it covers nothing


def registry_route(state_dir, name):
    """Where a message to `name` would go by the registry (#1074; used by send, #1131): its pane when it has one (as before), else its registry endpoint; None on a half read or an unknown agent."""
    registry = load_module("registry")
    reg = registry.read(state_dir)
    row = reg["agents"].get(name) if reg["whole"] else None
    return registry.route_for(row)


RETIRED_RECORD_FIELDS = tuple(f for f in load_module("registry").RECORD_FIELDS if f not in load_module("registry").OPTIONAL_FIELDS)   # derived from the registry's one tuple; an endpoint is never in a pane record (no pane is bound to an endpoint row). What the pane record holds besides the session (and `seen`, which nothing reads)


def pane_record_of(row):
    """What a retirement keeps of a pane record (`record` in retired.json), so the prune loses nothing a reader needs."""
    return {k: row[k] for k in RETIRED_RECORD_FIELDS if isinstance(row, dict) and row.get(k) is not None}


def known_agent(state_dir, name, known=None):
    """The pane record of a fleet agent: the live one, else (a retired agent is pruned from the pane record) the one kept in retired.json with its session.
    {} when neither exists. The one lookup every reader of a possibly pruned agent uses."""
    if known:
        return known
    reg = load_module("registry").read(state_dir)   # the one registry (#903): the live row, else the retired record (#870: no session covers nothing)
    row = reg["agents"].get(name)
    if isinstance(row, dict) and row.get("session"):
        return dict(row)
    entry = reg["retired"].get(name)
    if not isinstance(entry, dict) or entry.get("headless") or not entry.get("session"):
        return {}
    return dict(entry["record"] if isinstance(entry.get("record"), dict) else {}, session=entry["session"])


def known_session(state_dir, name, known):
    """The session of a fleet agent: the pane record's, else the retired record's."""
    found = known_agent(state_dir, name, known).get("session")
    return found or (registry_retired(state_dir).get(name) or {}).get("session")


def read_retired(state_dir):
    """The retired map from the registry, the name `reassign.py` loads (display only: a registry that is not whole reads as empty). The same read as `registry_retired`."""
    return registry_retired(state_dir)


class RetiredUnreadable(Exception):
    """The registry cannot be read whole (#372): for the tester gate that is NOT the same as an empty list of retired agents."""


def registry_read(state_dir):
    """THE read of the agent list: `registry.read` (docs/agent-registry.md, sec. 1), the one source every view uses. Never raises: a registry that cannot
    be loaded or read is a read that is not whole ({"whole": False, "agents": {}, "retired": {}, "problem": ...}); a caller that ACTS on the list acts
    only when `whole` is true (#805). `retired` is {name: record} (an additive field of the read)."""
    try:
        got = load_module("registry").read(str(state_dir))
    except Exception as err:   # the module is missing or broken: nothing is read, and the problem is said
        return {"whole": False, "version": 0, "agents": {}, "retired": {}, "problem": "the agent registry cannot be read: %s" % _one_line(str(err), 120)}
    got = got if isinstance(got, dict) else {}
    return {"whole": got.get("whole") is True, "version": got.get("version") or 0,
            "agents": {n: a for n, a in (got.get("agents") or {}).items() if isinstance(a, dict)},
            "retired": {n: r for n, r in (got.get("retired") or {}).items() if isinstance(r, dict)},
            "problem": got.get("problem")}


def registry_retired(state_dir):
    """{name: retired record} from the registry: a display's read (a read that is not whole lists nobody)."""
    return registry_read(state_dir)["retired"]


def read_retired_strict(state_dir):
    """The name the adoption and close code loads: the same strict read as `registry_retired_strict`."""
    return registry_retired_strict(state_dir)


def registry_retired_strict(state_dir):
    """As `registry_retired`, but a read that is not whole raises RetiredUnreadable: the verdict authority fails closed (#372)."""
    got = registry_read(state_dir)
    if not got["whole"]:
        raise RetiredUnreadable(got["problem"] or "the agent registry is not whole")
    return got["retired"]


def _prune_last_reports(data):
    """Bounded: the 500 entries with the oldest last sign of life go."""
    if len(data) > 500:
        stamp = lambda k: max([data[k].get("at", 0)] + list((data[k].get("send_to") or {}).values()))
        for old in sorted(data, key=stamp)[:len(data) - 500]:
            data.pop(old, None)


def record_last_send(state_dir, sender, recipient, now, repo=None, issue=None):
    """Remember that `sender` last SENT something to `recipient` (`send_to: {recipient: epoch}`, beside the last report's `state` and `at`, which it never
    changes; at most 8 recipients kept): a worker that messages its boss is in touch, which the overdue-checkpoint check counts as reporting to THAT boss
    even where no transcript is read (v2_light). Best effort, under a lock; never raises into `send`."""
    try:
        with agent_lock(state_dir, "files", seconds=2):
            data = _read_small(state_dir, LAST_REPORT_FILE)
            entry = dict(data.get(sender) or {})
            sends = {k: v for k, v in (entry.get("send_to") or {}).items() if isinstance(k, str) and _is_number(v)}
            sends[recipient] = int(now)
            for old in sorted(sends, key=sends.get)[:max(0, len(sends) - 8)]:
                sends.pop(old, None)
            entry["send_to"] = sends
            entry = load_report_fold().record(entry, recipient, repo, issue, now)   # #352: what a later report on this issue folds into
            data[sender] = entry
            _prune_last_reports(data)
            _write_small(state_dir, LAST_REPORT_FILE, data)
        return True
    except Exception:
        return False


def record_last_report(state_dir, sender, state, now, text=None):
    """Remember the last report `sender` made (state and time): what lets the daemon tell a worker its boss closed on purpose after its final `done`
    from one that died. Best effort, under a lock, never raises into `report`. Returns whether it was written: a failure is the SAFE direction (the
    worker then still shows DEAD and is never wrongly retired), and the caller notes it."""
    try:
        with agent_lock(state_dir, "files", seconds=2):
            data = _read_small(state_dir, LAST_REPORT_FILE)
            entry = {"state": state, "at": int(now)}
            before = data.get(sender) or {}
            if state == "working":   # #811: the run of consecutive `working` reports; any other kind ends it
                run = before.get("state") == "working" and _is_number(before.get("work_since")) and isinstance(before.get("work_n"), int)
                entry["work_n"] = before["work_n"] + 1 if run else 1
                entry["work_since"] = before["work_since"] if run else int(now)
            if isinstance(text, str) and text:
                entry["text"] = _one_line(redact_command_text(text), REPORT_MAX)   # untrusted text: redacted before it is stored (#773)   # the one line, for the idle-at-a-seam wake (#773)
            if isinstance((data.get(sender) or {}).get("send_to"), dict):
                entry["send_to"] = data[sender]["send_to"]   # a report does not forget the last sends
            if isinstance((data.get(sender) or {}).get("send_on"), dict):
                entry["send_on"] = data[sender]["send_on"]   # nor what a later report folds into (#352)
            data[sender] = entry
            _prune_last_reports(data)
            _write_small(state_dir, LAST_REPORT_FILE, data)
        return True
    except Exception:
        if state in ("working", "paused", "blocked", "question", "withdrawn"):   # a progress report must not leave an older `done` standing
            try:
                with agent_lock(state_dir, "files", seconds=1):
                    data = _read_small(state_dir, LAST_REPORT_FILE)
                    stale = data.get(sender)
                    if stale is not None:   # the stale `done` goes; the record of sends stays
                        sends = stale.get("send_to")
                        if isinstance(sends, dict) and sends:
                            data[sender] = {"send_to": sends}
                        else:
                            data.pop(sender, None)
                        _write_small(state_dir, LAST_REPORT_FILE, data)
            except Exception:
                pass
        return False


def read_pane_health(state_dir):
    """{"agents": {name: {...}}, "states": {name: {...}}, "missing": {name: n}}; an unreadable file is an empty one."""
    try:
        with open(str(Path(state_dir) / PANE_HEALTH_FILE), "rb") as handle:
            raw = json.loads(handle.read(1000001).decode("utf-8")) if True else {}
        if isinstance(raw, dict) and len(json.dumps(raw)) > 1000000:
            raw = {}
    except (OSError, ValueError, UnicodeError):
        raw = {}
    raw = raw if isinstance(raw, dict) else {}
    return {k: raw[k] if isinstance(raw.get(k), dict) else {} for k in ("agents", "states", "missing")}


def write_pane_health(state_dir, data):
    """pane-health.json, only when it changed (its `at`, each agent's `seen` and a live pane's `at` do not count), and at least every HEARTBEAT_HEALTH seconds (8 minutes)."""
    stable = {k: v for k, v in data.items() if k != "at"}
    stable["agents"] = {name: {k: v for k, v in (row if isinstance(row, dict) else {}).items() if k != "seen"} for name, row in (data.get("agents") or {}).items()}   # `seen` moves every pass and nothing reads it
    stable["states"] = {name: {k: v for k, v in (row if isinstance(row, dict) else {}).items() if k != "at" or (row or {}).get("state") == PANE_DEAD}
                        for name, row in (data.get("states") or {}).items()}   # a live pane's `at` is when it was last checked; only a dead one's is read (when to forget it)
    state_write(Path(state_dir) / PANE_HEALTH_FILE, json.dumps(data, indent=1, sort_keys=True) + "\n", json.dumps(stable, sort_keys=True), HEARTBEAT_HEALTH, fsync=True)


def watch_terminal_closed(engine, name, session_id):
    """True when `name` has a headless record for THIS session (it is a worker that runs with no terminal), so a pane that vanished was a `watch`
    terminal. A record for another session, no record, or an unreadable one is False: a real terminal worker's gone pane is still dead (the fail mode
    is chosen: when in doubt the alert goes out, never silence)."""
    try:
        record = load_agent_presence().load_record(engine.state_dir, name)
    except Exception:
        return False
    return record is not None and record.get("session") == session_id


def registry_charter(registered, name, session_charter):
    """(the charter the registry row of `name` takes, the session's charter when it DISAGREES with a kept row, else None) (#969). The registry is the one record of an orchestrator's charter: a row that
    exists keeps its charter (None included: that is a recorded answer), whatever the live session's metadata says; only an agent with NO row yet (first seen) takes the session's launch value.
    The metadata is written once at launch and cannot be corrected, so it is never a second source."""
    row = registered.get(name)
    if not isinstance(row, dict):
        return (session_charter if isinstance(session_charter, int) and not isinstance(session_charter, bool) else None), None
    kept = row.get("charter")
    differs = session_charter if (isinstance(session_charter, int) and not isinstance(session_charter, bool) and session_charter != kept) else None
    return kept, differs


CHARTER_DISAGREE_FILE = "charter-disagreements.json"   # {name: {session charter: 1}}: the disagreement is said ONCE per (agent, value)


def charter_disagreement_once(engine, name, value):
    """Audit `charter.disagree` the first time a live session's metadata charter disagrees with its registry row, then never again for that (agent, value). Never raises."""
    try:
        if engine.state_dir is None:
            return
        seen = _read_small(engine.state_dir, CHARTER_DISAGREE_FILE)   # {name: {"<value>": 1}} (a small file keeps only objects)
        values = seen.get(name) if isinstance(seen.get(name), dict) else {}
        if str(value) in values:
            return
        seen[name] = dict(list(values.items())[-4:], **{str(value): 1})
        _write_small(engine.state_dir, CHARTER_DISAGREE_FILE, seen)
        engine._note("charter.disagree", name, {"session_charter": value, "why": "the live session's metadata names a charter the registry row does not: the registry is the record, the session's value is ignored"})
    except Exception:
        pass


BELL_GLYPH = "\U0001f514"   # the heartbeat's old opt-in glyph in a tab label: read ONCE by the migration below, never again


def bell_migration(engine, registry, now):
    """#973, once: write the heartbeat's `bell` field for every recorded agent from the live tab labels (the opt-in the heartbeat used to read each pass),
    on a whole read only (agent list and tab list both answered); audited per agent; a marker file stops it from running, or reading herdr, again."""
    if registry.bell_migrated(engine.state_dir):
        return
    if (getattr(engine, "config", None) or {}).get("no_multiplexer") is True:   # no terminal multiplexer is asked: the migration stays pending
        return
    try:
        agents, tabs = engine.herdr.agent_list(), engine.herdr.tab_list()
    except HerdrError as err:
        engine._note("fleetpane.error", None, {"error": "bell migration waits: %s" % _one_line(str(err), 100)})
        return
    if not agents:   # a whole but EMPTY live list (herdr just restarted) is no evidence of anyone's label: with recorded agents to migrate it stays pending, no marker
        recorded = [r for r in registry.read(engine.state_dir)["agents"].values() if isinstance(r, dict) and r.get("pane") and not isinstance(r.get("bell"), bool)]
        if recorded:
            engine._note("fleetpane.error", None, {"error": "bell migration pending: herdr listed no agents but the registry records %d" % len(recorded)})
            return
    labels = {t.get("tab_id"): str(t.get("label") or "") for t in tabs if isinstance(t, dict)}
    belled = {a.get("pane_id") for a in agents if isinstance(a, dict) and BELL_GLYPH in labels.get(a.get("tab_id"), "")}
    got = registry.migrate_bell(engine.state_dir, belled, True, now=now)
    if got["problem"]:
        engine._note("fleetpane.error", None, {"error": "bell migration: %s" % _one_line(got["problem"], 100)})
    elif got["ran"] and got["changed"] and engine.audit is not None:
        engine.audit.append(engine.actor, "registry.bell_migrated", None, {"agents": got["changed"]})


def pane_health_pass(engine, now):
    """The daemon's look at every fleet agent's pane (after discovery). Records `pane-health.json` (what `status` shows and `reattach` reads),
    audits each change of state (`pane.detached`, `pane.dead`, `pane.recovered`) and leaves `engine.pane_alerts` for the cos fact. Reads only; bounded
    by PANE_CHECKS_PER_PASS and PANE_CHECK_SECONDS. Never raises."""
    discovery = getattr(engine, "discovery", None)
    if discovery is None or discovery.problems or engine.state_dir is None:
        return
    registry = load_module("registry")
    reg = registry.read(engine.state_dir)
    if not reg["whole"]:   # a half-read registry acts on nothing (#805): no upsert, no retire, no removal
        engine._note("fleetpane.error", None, {"error": "pass skipped: %s" % _one_line(reg["problem"] or "registry not read", 100)})
        return
    bell_migration(engine, registry, now)
    reg = registry.read(engine.state_dir)
    if not reg["whole"]:
        return
    data = read_pane_health(engine.state_dir)
    states, missing = data["states"], data["missing"]
    agents = {n: {k: v for k, v in row.items() if k in registry.AGENT_FIELDS} for n, row in reg["agents"].items()
              if isinstance(row, dict) and (row.get("kind") or "local") == "local"}   # the agent list is the registry's; a cloud worker has no pane to judge
    registered = {n: row for n, row in reg["agents"].items() if isinstance(row, dict)}
    retired = reg["retired"]
    retired_whole = True
    names = list(discovery.agents)
    sessions = [o.session_id for o in discovery.agents.values()]
    budget = PANE_CHECKS_PER_PASS
    for name, obs in sorted(discovery.agents.items()):
        if obs.headless:   # no terminal now (#433): a pane verdict it was given while a `watch` terminal was open is stale, and is dropped with its alert (also while the service is unreadable: `unknown` carries no pane verdict)
            for table in (agents, states, missing):
                table.pop(name, None)
            continue
        if not obs.pane or not obs.session_id:
            continue
        missing.pop(name, None)
        if name in retired and retired[name].get("session") == obs.session_id:
            states.pop(name, None)       # a retired agent is not judged; it stays listed under its own heading
            continue
        prev = states.get(name) or {}
        # The schedule is the LAST CHECK, which the file no longer records every pass (its `at` is written only on a change): this process remembers it.
        checked = max(prev.get("at") or 0, engine.__dict__.setdefault("pane_checked", {}).get(name, 0))
        due = prev.get("session") != obs.session_id or prev.get("pane") != obs.pane or now - checked >= PANE_CHECK_SECONDS
        if due and budget > 0:
            budget -= 1
            state, why, info = pane_state(engine, name, obs.session_id, obs.pane, names, sessions)
            if state == PANE_DEAD and watch_terminal_closed(engine, name, obs.session_id):
                for table in (agents, states, missing):   # the person closed a `watch` terminal: the worker still runs headless, nothing is dead
                    table.pop(name, None)
                engine.pane_checked[name] = int(now)   # a check was made: this pane does not take a slot of every pass until discovery shows the worker headless
                continue
            if state != PANE_UNKNOWN:   # an unreadable look is not a check: it is repeated, as before
                engine.pane_checked[name] = int(now)
                if state != prev.get("state") and engine.audit is not None:
                    event = {PANE_DETACHED: "fleetpane.detached", PANE_DEAD: "fleetpane.dead"}.get(state, "fleetpane.recovered" if prev.get("state") in (PANE_DETACHED, PANE_DEAD) else None)
                    if event:
                        engine.audit.append(engine.actor, event, name, {"pane": obs.pane, "session": obs.session_id, "why": why})
                states[name] = {"state": state, "why": why, "pane": obs.pane, "session": obs.session_id, "at": int(now),
                                "workspace": info.get("workspace"), "cwd": info.get("cwd")}
        elif name not in states:
            states[name] = {"state": PANE_UNKNOWN, "why": "not checked yet", "pane": obs.pane, "session": obs.session_id, "at": int(now)}
        known = states.get(name) or {}
        charter, differs = registry_charter(registered, name, (obs.fleet or {}).get("charter"))
        if differs:
            charter_disagreement_once(engine, name, differs)
        agents[name] = {"session": obs.session_id, "pane": obs.pane, "role": (obs.fleet or {}).get("role"), "charter": charter,
                        "repo": (obs.fleet or {}).get("repo"), "workspace": known.get("workspace") or (agents.get(name) or {}).get("workspace"),
                        "cwd": known.get("cwd") or (agents.get(name) or {}).get("cwd"), "seen": int(now)}
    for name in list(agents):
        if name in discovery.agents:
            continue
        if (states.get(name) or {}).get("state") == PANE_DEAD and now - ((states.get(name) or {}).get("at") or now) > PANE_FORGET_SECONDS:
            for table in (agents, states, missing):   # nobody repaired it in days: it stops waking cos
                table.pop(name, None)
            continue
        if name in retired and retired[name].get("session") in (None, agents[name].get("session")):   # the name AND its session, as in the live branch
            states.pop(name, None)
            continue
        missing[name] = int(missing.get(name, 0)) + 1
        if missing[name] >= PANE_MISSING_PASSES and (states.get(name) or {}).get("state") != PANE_DEAD:
            last = _read_small(engine.state_dir, LAST_REPORT_FILE).get(name) or {}
            lookback = engine.config.get("worker_lookback_hours", 24) * 3600
            if last.get("state") in ("done", "failed") and 0 <= now - (last.get("at") or 0) <= lookback:
                # its boss closed the tab AFTER the worker's final `done`/`failed` report: finished on purpose, not dead
                entry = {"at": int(now), "by": "the switchboard", "reason": "its pane closed after its final %s report" % last["state"],
                         "session": agents[name].get("session"), "auto": True, "record": pane_record_of(agents[name])}
                try:
                    with agent_lock(engine.state_dir, "files", seconds=2):
                        got = registry.retire(engine.state_dir, name, entry["by"], entry["reason"], auto=True, session=entry["session"], record=entry["record"], now=now)
                        if got["problem"]:
                            raise OSError(got["problem"])
                    retired[name] = entry
                    states.pop(name, None)
                    missing.pop(name, None)
                    if engine.audit is not None:
                        engine.audit.append(engine.actor, "fleetpane.retired", name, {"auto": True, "reason": entry["reason"], "session": entry["session"]})
                    try:
                        reclaim_for_agent(engine, subprocess.run, name, True, "auto-retired")
                    except Exception as err:
                        engine._note("worktree.error", name, {"error": _one_line(str(err), 120)})
                    continue
                except Exception as err:
                    engine._note("fleetpane.error", None, {"error": "auto-retire not written: %s" % _one_line(str(err), 100)})
            states[name] = {"state": PANE_DEAD, "why": "herdr no longer lists %s (its pane %s is gone)" % (name, agents[name].get("pane")),
                            "pane": agents[name].get("pane"), "session": agents[name].get("session"), "at": int(now)}
            if engine.audit is not None:
                engine.audit.append(engine.actor, "fleetpane.dead", name, {"pane": agents[name].get("pane"), "session": agents[name].get("session")})
    for table in (states, missing):   # a state or a missing count for a name the registry does not list (retired, retired-and-removed) and discovery does not show is an orphan: it goes
        for name in [n for n in table if n not in agents and n not in discovery.agents]:
            table.pop(name, None)
    engine.pane_alerts = {n: v for n, v in states.items() if v.get("state") in (PANE_DETACHED, PANE_DEAD) and n in agents and n not in retired}
    if retired_whole:   # a retired agent (name AND session) leaves the record the pane draws from; its session stays in retired.json for reattach and --undo
        for name in [n for n in agents if retired_agent(retired, n, agents[n].get("session"))]:
            for table in (agents, states, missing):
                table.pop(name, None)
    for name, row in sorted(agents.items()):   # the registry takes what the pass saw (no churn: only a changed row is written)
        state_now = (states.get(name) or {}).get("state")
        obs = discovery.agents.get(name)
        live = state_now if state_now in (PANE_DETACHED, PANE_DEAD) else ((obs.status if obs is not None and obs.status in registry.STATES else None) or "idle")
        new = dict(row, state=live)
        old = registered.get(name)
        if old is not None and all(old.get(k) == new.get(k) for k in registry.CHANGE_FIELDS):
            continue
        got = registry.upsert(engine.state_dir, name, new, now=now)
        if got["problem"] and not got["problem"].endswith("is retired for this session"):
            engine._note("fleetpane.error", name, {"error": "registry not updated: %s" % _one_line(got["problem"], 100)})
    # No removal from the registry here: a dead agent leaves it only when a view reads it (reconcile_on_read, #919), never on a pass.
    try:
        write_pane_health(engine.state_dir, {"agents": agents, "states": states, "missing": missing, "at": int(now)})
    except OSError as err:
        engine._note("fleetpane.error", None, {"error": "pane-health.json not written: %s" % _one_line(str(err), 100)})


PANE_EXIT_FILE = "pane-exit.json"          # {"seen": {key: epoch}, "log": {"size", "ino"}}: the exits already written, and the log as last read
PANE_EXIT_TAIL_BYTES = 262144              # herdr's log is read from its last 256 KiB only (about 10 minutes of a busy window): memory stays trivial
PANE_EXIT_MAX_AGE = 3600                   # an exit older than this at the first look is marked seen and not written (a restart does not replay history)
PANE_EXIT_BURST_SECONDS = 5                # exits this close together are one event
PANE_EXIT_BURST_MIN = 3                    # this many panes in one burst make the summary line
PANE_EXIT_ASKED_BEFORE = 300               # a fleet close this long before the exit is the cause...
PANE_EXIT_ASKED_AFTER = 30                 # ...or this long after it (the audit line of a close can land just after herdr logs the exit)
PANE_EXIT_SIGNAL_SECONDS = 10              # the `pane session terminated` line of the same pane within this long after an exit names its signal
PANE_EXIT_SEEN_KEEP = 86400                # a seen key is forgotten after this
PANE_EXIT_MAX_PER_PASS = 20               # exit lines written per pass: 256 KiB of herdr log holds about 1100 exit lines at most (~230 bytes each); the rest are written by the next passes
PANE_EXIT_MAX_JOBS = 200                   # job records read at most per look (a `ps` for each ALIVE one): a real fleet holds a few dozen
PANE_EXIT_NAMES = 12                       # active heavy runs and jobs listed at most
HERDR_LOG_DEFAULT = "~/.config/herdr/herdr-server.log"
_PANE_EXIT_LINE = re.compile(r'^(\S+Z)\s.*pane child exited event="pane\.exit".*?pane_id=(\d+) status="ExitStatus \{ code: (-?\d+), signal: (None|Some\((?:"?)(\w*)(?:"?)\)) \}"')
_PANE_TERMINATED_LINE = re.compile(r'^(\S+Z)\s.*pane session terminated pane=(\d+) .*?signal=(\w+)')


def _herdr_epoch(text):
    try:
        return datetime.fromisoformat(text.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def pane_exit_events(text):
    """The `pane.exit` lines of herdr's log, each with the signal herdr named: [{"pane", "code", "signal", "time", "at"}], oldest first. The signal is the one
    in the exit status, else the one of the `pane session terminated` line of the same pane within 10 s after it. A line that does not parse is skipped."""
    exits, ended = [], []
    for line in text.splitlines():
        found = _PANE_EXIT_LINE.match(line)
        if found:
            at = _herdr_epoch(found.group(1))
            if at is not None:
                exits.append({"pane": found.group(2), "code": int(found.group(3)), "signal": found.group(5) if found.group(4) != "None" and found.group(5) else None,
                              "time": found.group(1), "at": at})
            continue
        found = _PANE_TERMINATED_LINE.match(line)
        if found:
            at = _herdr_epoch(found.group(1))
            if at is not None:
                ended.append((found.group(2), at, found.group(3)))
    for event in exits:
        if event["signal"] is None:
            event["signal"] = next((sig for pane, at, sig in ended if pane == event["pane"] and 0 <= at - event["at"] <= PANE_EXIT_SIGNAL_SECONDS), None)
    return sorted(exits, key=lambda e: e["at"])


def pane_exit_read_log(path):
    """(text, size, inode, problem): the last PANE_EXIT_TAIL_BYTES of herdr's log. Read-only (opened for reading, never written, truncated or locked); a
    missing or unreadable log gives its problem and no text. Never raises."""
    try:
        with open(str(path), "rb") as handle:
            info = os.fstat(handle.fileno())
            start = max(0, info.st_size - PANE_EXIT_TAIL_BYTES)
            handle.seek(start)
            data = handle.read(PANE_EXIT_TAIL_BYTES)
    except OSError as err:
        return "", None, None, "herdr log not read: %s" % _one_line(err.strerror or str(err), 100)
    text = data.decode("utf-8", "replace")
    if start:
        text = text.split("\n", 1)[1] if "\n" in text else ""   # the first line is cut in the middle
    return text, info.st_size, info.st_ino, None


def _pane_matches(recorded, pane):
    """Does a pane id of the fleet's records (`w1:p3` or a plain number) name the number herdr's log calls `pane_id`?"""
    recorded = str(recorded or "")
    return bool(recorded) and (recorded == pane or recorded.endswith(":p" + pane))


def pane_exit_audit_tail(state_dir):
    """The parsed `fleetpane.closed` entries of the last PANE_EXIT_TAIL_BYTES of the audit, read ONCE per pass: [(epoch, pane, by)]. Never raises."""
    path = Path(state_dir) / "audit.jsonl"
    try:
        with open(str(path), "rb") as handle:
            size = handle.seek(0, os.SEEK_END)
            handle.seek(max(0, size - PANE_EXIT_TAIL_BYTES))
            lines = handle.read(PANE_EXIT_TAIL_BYTES).decode("utf-8", "replace").splitlines()[1 if size > PANE_EXIT_TAIL_BYTES else 0:]
    except OSError:
        return []
    out = []
    for line in lines:
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        detail = entry.get("detail") if isinstance(entry, dict) else None
        if isinstance(detail, dict) and entry.get("event") == "fleetpane.closed":
            at = _audit_epoch(entry)
            if at is not None:
                out.append((at, detail.get("pane"), _one_line(str(detail.get("by") or "unknown"), 60)))
    return out


def _pane_exit_asked(closed, event):
    """(by, True) when a fleet command closed this pane near its exit (`fleetpane.closed` of `close-pane` or `retire --close`), else (None, False). `closed` is `pane_exit_audit_tail`."""
    for at, pane, by in reversed(closed):
        if _pane_matches(pane, event["pane"]) and -PANE_EXIT_ASKED_AFTER <= event["at"] - at <= PANE_EXIT_ASKED_BEFORE:
            return by, True
    return None, False


def pane_exit_runs(engine):
    """What can be told of the heavy runs and jobs, read ONCE per pass: ({"heavy": [(name, since)], "jobs": [(name, started, ended or None)], "problems": [..]}).
    A slot record holds the run's start only (`since`) and exists only while the run holds the slot: a run that has ENDED left no end time. A job record holds
    its start, and the mtime of its `exit` file is its end. Read-only; a record that cannot be read is skipped and said in `problems`."""
    out = {"heavy": [], "jobs": [], "problems": []}
    try:
        for info in load_heavy_slots()._held_records(engine.state_dir):
            since = info.get("since")
            if isinstance(since, (int, float)) and not isinstance(since, bool):
                out["heavy"].append((_one_line(str(info.get("name") or "?"), 60), since))
    except Exception:
        out["problems"].append("heavy slot records not read")
    try:
        root = jobs_dir()
        for entry in sorted(os.listdir(str(root)))[:PANE_EXIT_MAX_JOBS]:
            record = job_read(entry, root)
            started = record.get("started") if record else None
            if not isinstance(started, (int, float)) or isinstance(started, bool):
                continue
            state = job_state(record, root)[0]
            ended = None
            if state == "finished":
                try:
                    ended = os.stat(str(job_paths(entry, root)["exit"])).st_mtime
                except OSError:
                    ended = None
            if state == "alive" or (state == "finished" and ended is not None):
                out["jobs"].append((_one_line(entry, 60), started, ended))
    except OSError:
        out["problems"].append("job records not read")
    return out


def pane_exit_active(runs, at):
    """The heavy runs and jobs active at second `at`, [{"kind", "name", "age"}] (age in seconds at `at`). A job is active when it started at or before `at` and had
    not ended then (alive now, or its exit file is newer than `at`). A heavy run is listed when it started at or before `at` and still holds its slot when the line is
    written: a run that held a slot at `at` and has ended since left no end time, so it cannot be listed (the doc says so)."""
    out = [{"kind": "heavy", "name": name, "age": int(at - since)} for name, since in runs["heavy"] if since <= at]
    out += [{"kind": "job", "name": name, "age": int(at - started)} for name, started, ended in runs["jobs"] if started <= at and (ended is None or ended > at)]
    return out[:PANE_EXIT_NAMES]


def pane_exit_pass(engine, now):
    """When herdr's log says a pane's child exited, write ONE `fleetpane.exit` audit line (pane, agent name when the registry knows it, code, signal, herdr's time,
    whether a fleet command asked for it, and what heavy runs and jobs were active); three or more exits within a few seconds also write one `fleetpane.exit_burst`
    line and leave it in `engine.pane_exit_bursts` for the Chief of Staff's fact. Reads herdr's log read-only and bounded; a log that is missing, unreadable or
    rotated gives one `fleetpane.exit_note` and the pass goes on. Never raises."""
    if engine.audit is None or engine.state_dir is None:
        return
    path = os.path.expanduser(str(engine.config.get("herdr_log") or HERDR_LOG_DEFAULT))
    text, size, inode, problem = pane_exit_read_log(path)
    stored = _read_small(engine.state_dir, PANE_EXIT_FILE)
    seen = {k: v for k, v in (stored.get("seen") or {}).items() if isinstance(v, (int, float)) and now - v < PANE_EXIT_SEEN_KEEP}
    last = engine.__dict__.get("pane_exit_log") or stored.get("log") or {}   # the size last read stays in memory: the file keeps it only when it matters
    if problem:
        engine._note("fleetpane.exit_note", None, {"note": problem})
        return
    rotated = (isinstance(last.get("size"), int) and size < last["size"]) or (last.get("ino") is not None and last.get("ino") != inode)
    if rotated:
        engine._note("fleetpane.exit_note", None, {"note": "herdr log was rotated or truncated: read again from its end"})
    else:
        engine._last.pop(("fleetpane.exit_note", None), None)
    names = {}
    try:
        reg = load_module("registry").read(engine.state_dir)
        names = {row.get("pane"): n for n, row in reg["agents"].items() if isinstance(row, dict) and row.get("pane")}
    except Exception:
        pass
    events = pane_exit_events(text)
    closed, runs, written = None, None, 0   # the audit tail, the slot and job records and their `ps` are read only when an exit is to be written: a quiet pass costs the log tail and the seen set
    seen.update(engine.__dict__.get("pane_exit_seen", {}))   # what a failed write of pane-exit.json could not keep
    stored_log = stored.get("log") or {}
    log_state = {"size": stored_log.get("size"), "ino": stored_log.get("ino")}   # what the file holds: moved to the current log only on a rotation or with a real change of "seen"
    on_disk = [{"seen": stored.get("seen") or {}, "log": stored.get("log") or {}}]   # what the file holds now: an unchanged state is not written again

    def save():
        """Audit first, then this: called right after EACH audit line, so a later append that raises never makes an earlier line be written again (a line twice
        reads as two exits, so a gap that the next pass fills is better than a duplicate; a crash between the two writes repeats at most that one line)."""
        engine.pane_exit_seen = {k: v for k, v in seen.items() if now - v < PANE_EXIT_SEEN_KEEP}
        payload = {"seen": dict(seen), "log": dict(log_state)}
        if payload == on_disk[0]:
            return
        try:
            _write_small(engine.state_dir, PANE_EXIT_FILE, payload)
            on_disk[0] = payload
        except OSError as err:
            engine._note("fleetpane.error", None, {"error": "pane-exit.json not written: %s" % _one_line(str(err), 100)})
    window = float(engine.config.get("pane_exit_burst_seconds", PANE_EXIT_BURST_SECONDS))
    for event in events:
        key = "%s:%s" % (event["time"], event["pane"])
        if key in seen:
            continue
        if now - event["at"] > PANE_EXIT_MAX_AGE:
            seen[key] = event["at"]
            continue
        if written >= PANE_EXIT_MAX_PER_PASS:
            continue   # not marked seen: the next pass writes it
        if runs is None:
            closed, runs = pane_exit_audit_tail(engine.state_dir), pane_exit_runs(engine)
        by, asked = _pane_exit_asked(closed, event)
        name = next((n for p, n in names.items() if _pane_matches(p, event["pane"])), None)
        detail = {"pane": event["pane"], "agent": name, "code": event["code"], "signal": event["signal"], "herdr_time": event["time"], "asked": asked, "by": by,
                  "active": pane_exit_active(runs, event["at"]), "active_basis": "heavy: still holding its slot when written; jobs: by start and end time"}
        if runs["problems"]:
            detail["active_problem"] = "; ".join(runs["problems"])
        engine.audit.append(engine.actor, "fleetpane.exit", name or "pane:%s" % event["pane"], detail)
        seen[key] = event["at"]   # only after the line is written
        written += 1
        save()
    bursts, group = {}, []
    for event in events + [None]:
        if event is not None and (not group or event["at"] - group[-1]["at"] <= window):
            group.append(event)
            continue
        if len(group) >= int(engine.config.get("pane_exit_burst_min", PANE_EXIT_BURST_MIN)) and now - group[0]["at"] <= PANE_EXIT_MAX_AGE:
            key = "burst:%s:%s" % (group[0]["time"], group[0]["pane"])
            panes = [e["pane"] for e in group]
            bursts[key] = {"panes": panes, "agents": [next((n for p, n in names.items() if _pane_matches(p, e["pane"])), None) for e in group], "from": group[0]["time"],
                           "to": group[-1]["time"], "codes": sorted({e["code"] for e in group}), "at": group[0]["at"]}
            if key not in seen:
                engine.audit.append(engine.actor, "fleetpane.exit_burst", "panes:%s" % ",".join(panes), {k: v for k, v in bursts[key].items() if k != "at"})
                seen[key] = group[0]["at"]
                save()
        group = [event] if event is not None else []
    engine.pane_exit_bursts = bursts
    engine.pane_exit_log = {"size": size, "ino": inode}
    if rotated or not stored_log or {k: v for k, v in seen.items() if now - v < PANE_EXIT_SEEN_KEEP} != (stored.get("seen") or {}):
        log_state.update(size=size, ino=inode)   # growth alone never rewrites the file: herdr's log grows on every event, not only exits
    save()   # the aged-out marks and the log as read


class PaneExitFacts:
    """The Chief of Staff is told ONCE when several panes ended within a few seconds (one fact per burst, keyed by its first exit), never once per pane."""

    __name__ = "pane_exit_facts"

    def __init__(self):
        self.engine = None

    def bind(self, engine):
        self.engine = engine

    def __call__(self):
        engine = self.engine
        bursts = getattr(engine, "pane_exit_bursts", None) if engine else None
        discovery = getattr(engine, "discovery", None) if engine else None
        if not bursts or discovery is None or discovery.problems:
            return []
        chiefs = sorted(n for n, o in discovery.agents.items() if (o.fleet or {}).get("role") == "chief-of-staff")
        out = []
        for key, burst in sorted(bursts.items()):
            who = ", ".join(a or "pane %s" % p for a, p in zip(burst["agents"], burst["panes"]))
            summary = ("%d panes ended within a few seconds (%s to %s, exit codes %s): %s. Why: `%s` in the audit and herdr's own log (docs/switchboard.md, \"Why a pane ended\")."
                       % (len(burst["panes"]), burst["from"], burst["to"], ",".join(str(c) for c in burst["codes"]), who, "fleetpane.exit"))
            out.extend(Fact(key, chief, "pane", summary, float(burst["at"]), sender="switchboard") for chief in chiefs)
        return out


class PaneFacts:
    """The control plane's wake: one fact per detached or dead agent for each Chief of Staff, keyed by agent, state and session so it is delivered
    once per change. The text names the agent, its pane and session and says what to run (`reattach`)."""

    __name__ = "pane_facts"

    def __init__(self):
        self.engine = None

    def bind(self, engine):
        self.engine = engine

    def __call__(self):
        engine = self.engine
        alerts = getattr(engine, "pane_alerts", None) if engine else None
        discovery = getattr(engine, "discovery", None) if engine else None
        if not alerts or discovery is None or discovery.problems:
            return []
        chiefs = sorted(n for n, o in discovery.agents.items() if (o.fleet or {}).get("role") == "chief-of-staff")
        out = []
        for name, info in sorted(alerts.items()):
            word = "DETACHED" if info["state"] == PANE_DETACHED else "DEAD"
            summary = ("%s is %s: pane %s, session %s (%s). Repair it with `%s reattach %s`; if the session is gone, `relaunch` is the next step."
                       % (name, word, info.get("pane"), info.get("session"), _one_line(info.get("why"), 120), PROG, name))
            if info["state"] == PANE_DEAD:   # #379: what is known of it, and what to do (best effort: the hint is read-only, bounded and total on any file content)
                summary += " " + dead_hint.hint(name, _read_small(engine.state_dir, LAST_REPORT_FILE).get(name), engine.now(),
                                                boss_name(discovery, discovery.agents.get(name)) if name in discovery.agents else None) + "."
            for chief in chiefs:
                if chief != name:
                    out.append(Fact("pane:%s:%s:%s" % (name, info["state"], info.get("session")), chief, "pane", summary,
                                    float(info.get("at") or 0), sender="switchboard"))
        return out


HEADLESS_ROUTE_FILE = "headless-route.json"   # {"workers": {worker: {"problem", "repo"}}}: headless workers whose account route is not in place (#669)
HEADLESS_SERVICE_FILE = "headless-service.json"   # {"service": {"pid", "from", "at"}, "bosses": {worker: boss}}: what the restart notice remembers


class HeadlessRestartFacts:
    """#433 slice 4: a worker with no terminal is never silently lost. (1) When the OpenCode service restarts (its process id, read fresh from the
    private service file, differs from the one seen before) each headless worker's boss is told once, naming the worker: the service has resumed
    the session itself, so nothing needs relaunching, but a boss that waited on it should know. The key holds the new process id, so a restart
    is delivered once and a pass is the same pass again. A service that does not answer is NOT a restart (the id is only compared when it is read),
    and the first id ever seen is recorded without a notice. (2) A headless worker whose session no longer exists is reported to the boss it
    last had (remembered here), or to every Chief of Staff when none is known. Terminal workers are not touched."""

    __name__ = "headless_restart_facts"

    def __init__(self):
        self.engine = None

    def bind(self, engine):
        self.engine = engine

    def __call__(self):
        engine = self.engine
        discovery = getattr(engine, "discovery", None) if engine else None
        if engine is None or discovery is None or engine.state_dir is None:
            return []
        state = engine.state_dir
        records = discovery.headless_records   # the records this pass's discovery scanned, never a second scan: a launch that landed after discovery is not "lost"
        unread = discovery.problems   # every problem of the look (records, the service, herdr), not only unreadable records: on any of them a remembered boss is kept, never pruned
        if records is None:
            return []
        remembered = _read_small(state, HEADLESS_SERVICE_FILE)
        service, bosses = dict(remembered.get("service") or {}), dict(remembered.get("bosses") or {})
        pid = engine.v2.service_identity()
        changed = False
        if pid is not None and service.get("pid") != pid:
            service = {"pid": pid, "from": service.get("pid"), "at": engine.now()}
            changed = True
        headless = {o.name: o for o in discovery.agents.values() if o.headless}
        created = {r["worker"]: r.get("created") or 0 for r in records}
        for name, observation in headless.items():
            boss = boss_name(discovery, observation)
            if boss is not None and bosses.get(name) != boss:
                bosses[name] = boss
                changed = True
        for gone in [n for n in bosses if n not in created] if not unread else []:   # a worker with no record any more (retired) is forgotten: the file does not grow for ever
            del bosses[gone]
            changed = True
        if changed:
            try:
                _write_small(state, HEADLESS_SERVICE_FILE, {"service": service, "bosses": bosses})
            except OSError as err:
                engine._note("source.error", "headless_restart_facts", {"error": _one_line(str(err))})
        facts = []
        if service.get("from") is not None and isinstance(service.get("pid"), int):
            for name, observation in sorted(headless.items()):
                boss = boss_name(discovery, observation)
                if boss is None or observation.conflict or created.get(name, 0) > (service.get("at") or 0):   # a worker launched after the restart was not hit by it
                    continue
                facts.append(Fact("headless.restarted:%s:%s" % (service["pid"], observation.session_id), boss, "headless.restarted",
                                  "The OpenCode service restarted (process %s replaced %s), seen at %s. %s has no terminal: if it was working, its turn may have been interrupted "
                                  "and the session may need a poke: check it with `%s status`." % (
                                      service["pid"], service["from"], iso(service.get("at") or engine.now()), name, PROG),
                                  float(service.get("at") or engine.now()), issue=_issue_of(observation.fleet), sender="switchboard"))
        facts.extend(self.route_facts(engine, state, discovery, headless))
        if discovery.problems:   # the service (or herdr) did not answer cleanly: a missing worker may only be unread, so nothing is called lost
            return facts
        chiefs = sorted(n for n, o in discovery.agents.items() if (o.fleet or {}).get("role") == "chief-of-staff")
        for record in records:
            name = record["worker"]
            if name in headless or name in discovery.agents:
                continue
            to = [bosses[name]] if bosses.get(name) in discovery.agents else chiefs
            for recipient in to:
                facts.append(Fact("headless.lost:%s" % record["session"], recipient, "headless.lost",
                                  "%s has no terminal and its session %s no longer exists in the OpenCode service (or is not the worker's). Its record is still here: "
                                  "`%s retire %s` if it is finished, otherwise relaunch it." % (name, record["session"], PROG, name),
                                  float(record.get("created") or engine.now()), sender="switchboard"))
        return facts


    def route_facts(self, engine, state, discovery, headless):
        """#669: every pass, each headless worker whose repo `gh_users` maps to a named account is checked again with the launch's own route check (files
        only). While it fails the boss gets ONE wake per problem and `status` prints a line; when it holds again the line goes. Nothing is written but
        this small state file."""
        check, accounts = getattr(engine, "route_check", None), getattr(engine, "accounts", None)
        if check is None or accounts is None:
            return []
        bad, facts = {}, []
        try:
            problem = check()
            for name, observation in sorted(headless.items()):
                repo = (observation.fleet or {}).get("repo")
                if problem and isinstance(repo, str) and accounts.account_for(repo):
                    bad[name] = {"problem": _one_line(problem, 240), "repo": repo}
        except Exception as err:   # a check that cannot run is no finding
            engine._note("source.error", "headless_route_facts", {"error": _one_line(str(err))})
            return []
        for name, found in bad.items():
            boss = boss_name(discovery, headless[name])
            if boss is not None:
                key = "headless.route:%s:%s:%s" % (name, headless[name].session_id, hashlib.sha256(found["problem"].encode()).hexdigest()[:12])
                facts.append(Fact(key, boss, "headless.route",
                                  "%s has no terminal and works on %s, which maps to a named gh account, but the route that picks that account is no longer in place: %s. "
                                  "Until it is, its gh and git commands may run as the service's default account. Fix the install, or relaunch it with a terminal." % (
                                      name, found["repo"], found["problem"]), float(engine.now()), issue=_issue_of(headless[name].fleet), sender="switchboard"))
        if _read_small(state, HEADLESS_ROUTE_FILE).get("workers", {}) != bad:
            try:
                _write_small(state, HEADLESS_ROUTE_FILE, {"workers": bad})
            except OSError as err:
                engine._note("source.error", "headless_route_facts", {"error": _one_line(str(err))})
        return facts


def headless_route_status_lines(state_dir):
    """The `status` lines for headless workers whose account route stopped being true (nothing when all hold)."""
    if state_dir is None:
        return []
    workers = _read_small(state_dir, HEADLESS_ROUTE_FILE).get("workers") or {}
    return ["      route      %s: gh account route for %s is NOT in place: %s" % (_one_line(n, 60), _one_line(str(v.get("repo")), 80), _one_line(str(v.get("problem")), 200))
            for n, v in sorted(workers.items()) if isinstance(v, dict)]


def pane_health_status_lines(state_dir, now=None):
    """The `status` lines for detached or dead agents (nothing when every pane is attached or unknown)."""
    if state_dir is None:
        return []
    seen = registry_read(state_dir)
    if not seen["whole"]:
        return ["      panes      the agent registry could not be read (%s): no pane state shown" % _one_line(str(seen["problem"]), 120)]
    retired = seen["retired"]
    # A dead agent is never drawn (#919, S10): the reconcile on read (run by `collect_status` first) removes the provably dead one, and one it could not remove is
    # still not drawn as dead. The view reads only the registry: an agent it does not hold has no row, and a read that is not whole says so above.
    bad = [(n, v) for n, v in sorted(seen["agents"].items()) if v.get("state") == PANE_DETACHED and n not in retired]
    clock = time.time() if now is None else now
    last = _read_small(state_dir, LAST_REPORT_FILE)
    gone = [n for n, v in sorted(retired.items()) if clock - (v.get("at") or 0) <= RETIRED_SHOW_DAYS * 86400]
    tail = (["      retired    %d finished worker(s), not watched: %s (`%s retire --undo <name>` reverses)" % (len(gone), ", ".join(gone[:8]), PROG)] if gone else [])
    if not bad:
        return tail
    return ["      panes      %d agent(s) need repair: %s" % (len(bad), "; ".join("%s %s (pane %s)" % (n, v["state"].upper(), v.get("pane")) for n, v in bad[:6]))
            ] + ["        run `%s reattach <name>`" % PROG] + [
        "        %s: %s" % (_one_line(n, 60), dead_hint.hint(n, last.get(n), clock)) for n, v in bad[:6] if v.get("state") == PANE_DEAD] + tail


def herdr_live_check(herdr):
    """A `live_check` for agent_reconcile: asks herdr right now. {"pane": bool|None, "process": bool|None}; None means herdr could not say.
    Evidence of death is a SUCCESSFUL, WHOLE `pane list` that does not hold this pane id (exact equality on the parsed `pane_id` field). Error text
    is never read: any error, timeout, bad JSON, missing binary or socket, or a list of an unexpected shape is None (no evidence)."""
    def check(name, agent):
        pane = agent.get("pane")
        if not pane:
            return {"pane": False, "process": False}
        try:
            panes = herdr.pane_list()
        except Exception:
            return {"pane": None, "process": None}
        if not isinstance(panes, list) or not all(isinstance(p, dict) and isinstance(p.get("pane_id"), str) for p in panes):
            return {"pane": None, "process": None}
        if not any(p["pane_id"] == pane for p in panes):
            return {"pane": False, "process": False}
        try:
            return {"pane": True, "process": bool(herdr.pane_process_info(pane))}
        except Exception:
            return {"pane": True, "process": None}
    return check


def reconcile_agents_on_read(state_dir, herdr):
    """A view's reconcile on read (#919): read the registry, and remove through `registry.reconcile_remove` each agent herdr shows no pane and no
    process for, right now. Only a whole read acts. No registry module or file: nothing to do. Returns the names removed; never raises."""
    try:
        reg = load_module("registry")
        agent_reconcile = load_module("agent_reconcile")
        return agent_reconcile.reconcile_on_read(state_dir, reg.read(state_dir), herdr_live_check(herdr), reg)
    except Exception:
        return []


def charter_pane_update(engine, runner, fleet, new_pane):
    """Best effort: set the `pane:` line of the agent's charter issue to `new_pane`. Returns a note ('' when there was nothing to do)."""
    charter, repo = fleet.get("charter"), fleet.get("repo") or (engine.config.get("intent_repo") if fleet.get("charter") else None)
    if not isinstance(charter, int) or isinstance(charter, bool) or not repo:
        return ""
    try:
        got = _gh_write(engine, runner, repo, "repos/%s/issues/%d" % (repo, charter), "GET")
        body = (json.loads(got.stdout or "{}") or {}).get("body") or ""
        line = re.compile(r"^(pane:[ \t]*)\S.*$", re.M)
        if not line.search(body):
            return "charter #%d has no `pane:` line to update" % charter
        updated = line.sub(lambda m: m.group(1) + new_pane, body, count=1)
        if updated == body:
            return ""
        with engine._external("github.charter.pane", "%s#%d" % (repo, charter), {"pane": new_pane}):
            _gh_write(engine, runner, repo, "repos/%s/issues/%d" % (repo, charter), "PATCH", {"body": updated})
        return "charter %s#%d now says pane: %s" % (repo, charter, new_pane)
    except (IntentError, ValueError) as err:
        return "charter pane not updated: %s" % _one_line(str(err), 120)


def cmd_reattach(args, runner, now, socket_call=None):
    """`reattach <name> [--session ses_...] [--workspace W]`: put an agent back in a pane on its EXISTING session. Releases a stale binding first
    (a pane herdr no longer has, or a detached fresh screen: its tab is closed), refuses when the old pane really runs the agent or the session is
    gone (then `relaunch` is the proposal), sends no prompt, updates the charter's `pane:` line and audits."""
    if getattr(args, "all_detached", False):
        return cmd_reattach_all(args, runner, now, socket_call)
    engine, state, _ = build_engine(runner, now, "cli", socket_call=socket_call)
    name = args.name
    discovery = engine.discover(engine.now())
    reg = load_module("registry").read(state)
    if not reg["whole"]:   # acts on the registry: fails closed on a half read
        raise LaunchError("the agent registry cannot be read (%s): nothing was changed" % _one_line(reg["problem"] or "unknown", 120))
    if name in reg["retired"]:
        raise LaunchError("%s is retired (a finished worker): run `%s retire --undo %s` first if it should come back" % (name, PROG, name))
    who = reattach_caller_problem(engine, runner, now, discovery, name, getattr(args, "session", None))
    if who:
        if engine.audit is not None:
            engine.audit.append(engine.actor, "fleetpane.reattach_refused", name, {"why": _one_line(who, 160)})
        raise LaunchError("refused: %s" % who)
    try:
        with agent_lock(state, name):
            return _reattach_locked(args, runner, now, engine, state, name, discovery)
    except ImpactStateBusy:
        raise LaunchError("another reattach of %s is running: wait for it, then run `%s status`" % (name, PROG)) from None


def lost_headless_boss(state_dir, name):
    """The remembered boss of a headless worker that has a record on file but is not discovered (its session is gone), or None. Reads only."""
    if state_dir is None or headless_record_to_free(state_dir, name) is None:
        return None
    boss = (_read_small(state_dir, HEADLESS_SERVICE_FILE).get("bosses") or {}).get(name)
    return boss if isinstance(boss, str) and boss else None


def reattach_caller_problem(engine, runner, now, discovery, name, session=None, lost_headless=False):
    """None when the caller may reattach `name`: the operator at their own terminal, the Chief of Staff, or the agent's own boss. Else why not."""
    kind = gates_caller_kind(runner, now)
    if kind[0] == "person":
        return None
    if kind[0] != "agent":
        return "%s: only the operator, the Chief of Staff or the agent's own boss may reattach" % kind[1]
    if len(kind) > 2 and kind[2] == "chief-of-staff":
        return None
    target = discovery.agents.get(name)
    if target is not None and boss_name(discovery, target) == kind[1]:
        return None
    if target is None:   # a dead agent is not discovered: its boss is in the session's STORED metadata
        try:
            known = known_agent(engine.state_dir, name)
            known_sid = session or known.get("session")
            stored = _fleet_meta(engine.v2.session_get(known_sid)) or {} if known_sid else {}
            stored = load_module("reassign").overlay(engine.state_dir, stored, known_sid) if stored else stored   # a reassigned worker's new boss, not the one it was launched with
            boss = resolve_boss(discovery, stored.get("reports_to")) if stored.get("reports_to") else None
        except Exception:
            boss = None
        if boss is not None and boss == kind[1]:
            return None
        if lost_headless and kind[1] == lost_headless_boss(engine.state_dir, name):   # `retire` only: a lost headless worker's boss is the one the daemon remembered
            return None
    return "%s may not reattach %s: only the operator, the Chief of Staff, or %s's own boss may" % (kind[1], name, name)


def _reattach_locked(args, runner, now, engine, state, name, discovery):
    known = known_agent(state, name)
    seen = discovery.agents.get(name)
    session_id = args.session or (seen.session_id if seen else None) or known.get("session")
    if not session_id:
        raise LaunchError("no session is known for %s: pass --session ses_... (the id of its OpenCode session)" % name)
    workspace = args.workspace or known.get("workspace") or os.environ.get("HERDR_WORKSPACE_ID")
    if not workspace and seen is not None and seen.pane:
        try:
            workspace = engine.herdr.pane_get(seen.pane).get("workspace_id")
        except HerdrError:
            workspace = None
    if not workspace:
        raise LaunchError("no workspace is known for %s: pass --workspace" % name)
    try:
        info = engine.v2.session_get(session_id)
    except V2Error as err:
        if err.reason == "http" and err.status == 404:
            raise LaunchError("session %s no longer exists: nothing to reattach. A fresh agent is `%s relaunch %s --charter <owner/repo#N>`, "
                              "which is a proposal to the Chief of Staff for an orchestrator" % (session_id, PROG, name)) from None
        raise
    fleet = _fleet_meta(info) or {}
    if getattr(args, "repo", None) and fleet.get("repo") and args.repo != fleet["repo"]:
        raise LaunchError("--repo %s differs from the session's stored repo %s: a reattach keeps what the session says, never the caller's" % (args.repo, fleet["repo"]))
    try:
        done = resume_agent(engine, name, session_id, workspace, replace=getattr(args, "replace", False))
    except LaunchError as err:
        raise LaunchError("%s (if the stale tab was already closed, run `%s reattach %s` again: nothing else was changed)" % (err, PROG, name)) from err
    note = charter_pane_update(engine, runner, fleet, done["pane"])
    if engine.audit is not None:
        engine.audit.append(engine.actor, "fleetpane.reattached", name, {"session": session_id, "pane": done["pane"], "tab": done.get("tab"),
                                                                     "released": done.get("released") or [], "charter": note})
    data = read_pane_health(state)
    data["states"].pop(name, None)
    data["missing"].pop(name, None)
    try:
        write_pane_health(state, data)
    except OSError as err:   # the reattach itself succeeded (exit 0): the next daemon pass rewrites the file; say so
        sys.stderr.write("%s: reattached, but pane-health.json was not updated (%s): the next daemon pass will\n" % (PROG, _one_line(str(err), 100)))
        if engine.audit is not None:
            engine.audit.append(engine.actor, "fleetpane.error", name, {"error": "pane-health.json not written: %s" % _one_line(str(err), 100)})
    done = dict(done, charter=note or None)
    problem = verify_account(engine, runner, fleet)
    if problem:
        done["account_warning"] = problem
        sys.stderr.write("%s: WARNING: %s\n" % (PROG, problem))
    print(json.dumps(done, sort_keys=True))
    return EXIT_OK


def verify_account(engine, runner, fleet):
    """None when `gh api user` with the token the pane was given names the account `gh_users` maps to the agent's repo (or there is no mapping),
    else a one-line problem. Reads only; the token is only in the child's environment."""
    repo, accounts = fleet.get("repo"), getattr(engine, "accounts", None)
    if not repo or accounts is None:
        return None
    try:
        want = accounts.account_for(repo)
        if want is None:
            return None
        env = accounts.env_for(repo)
        got = runner([engine.config["gh"], "api", "user", "--jq", ".login"], capture_output=True, text=True,
                     timeout=engine.config["call_timeout_seconds"], **({"env": env} if env is not None else {}))
    except Exception as err:
        return "the gh account for %s could not be verified (the lookup failed)" % repo
    login = (got.stdout or "").strip()
    if got.returncode != 0 or not login:
        return "the gh account for %s could not be verified (gh api user failed)" % repo
    return None if login.lower() == str(want).lower() else "the pane's gh account is %s but %s maps to %s" % (login, repo, want)


def cmd_reattach_all(args, runner, now, socket_call=None):
    """`reattach --all-detached`: every agent the daemon found detached or dead, one by one; each failure is said and the rest continue."""
    engine, state, _ = build_engine(runner, now, "cli", socket_call=socket_call)
    listed = registry_read(state)   # the same list `status` shows: the registry's agents that are detached or dead (never pane-health.json); a read that is not whole acts on nothing
    if not listed["whole"]:
        sys.stderr.write("%s: the agent registry could not be read (%s): nothing reattached\n" % (PROG, _one_line(str(listed["problem"]), 120)))
        return EXIT_ERROR
    names = sorted(n for n, v in listed["agents"].items() if v.get("state") in (PANE_DETACHED, PANE_DEAD) and n not in listed["retired"])
    if not names:
        print("no agent is detached or dead")
        return EXIT_OK
    failed = 0
    for name in names:
        one = types.SimpleNamespace(name=name, session=None, workspace=args.workspace, repo=None, replace=False, all_detached=False)
        try:
            code = cmd_reattach(one, runner, now, socket_call)
        except (LaunchError, V2Error, HerdrError) as err:
            sys.stderr.write("%s: %s: %s\n" % (PROG, name, _one_line(str(err), 200)))
            code = EXIT_ERROR
        failed += code != EXIT_OK
    return EXIT_ERROR if failed else EXIT_OK


def _idle_span_text(seconds):
    """'27 min', '3 h' or '1 d 3 h' for the evidence line."""
    minutes = int(seconds // 60)
    if minutes < 60:
        return "%d min" % minutes
    hours = minutes // 60
    return "%d h" % hours if hours < 24 else "%d d %d h" % (hours // 24, hours % 24)


def retire_idle_evidence(engine, now, name, seen, herdr_status):
    """The evidence line when the session's OWN state shows a pane herdr reads as `working` is idle, else None (fail toward keeping).
    Idle means: herdr says working (a blocked pane is never idle), `session.active` (ONE read per judgment: a retire judges twice, so a closed agent costs 2, one refused at the first costs at most 1) has no entry for the session (no turn, so no pending permission or question), and
    the last turn's end (`time.idle` of the discovery's own session record) is at least `retire_idle_minutes` ago. Anything unreadable,
    missing or in the future is None."""
    if herdr_status != "working" or seen is None or not seen.session_id or seen.idle_at is None:
        return None
    try:
        active = engine.v2.session_active()   # read at every judgment: the final one before the close must see a turn that began since the first
    except Exception:
        return None
    if not isinstance(active, dict) or seen.session_id in active:   # `session.active` lists only sessions with a turn: an entry of ANY shape ({}, null) is not proof of idleness
        return None
    window = engine.config.get("retire_idle_minutes")
    if not retire_idle_window_ok(window) or not _is_number(seen.idle_at) or not math.isfinite(seen.idle_at):
        return None   # a window or a last-turn time that cannot be read means unknown, never idle
    idle_for = now() - seen.idle_at
    if idle_for < window * 60:
        return None
    return "herdr says working; the session has been idle %s and has no turn: treated as idle" % _idle_span_text(idle_for)


# ---------------------------------------------------------------- no orphan workers (#838)
#
# A worker always has a boss that is a live agent. ONE step writes every boss change this ask makes (`write_boss_records`): the daemon pass,
# the retire of an orchestrator, the launch of one (relaunch, replace), the move of an ask (split) and the close of a retired worker's pane
# call it, so they cannot differ. The boss is written in the per-worker boss record of `bin/reassign.py` (bound to the worker's session), which
# discovery applies, so every boss lookup follows it.

ADOPT_ROLES = ("coder", "tester")   # the workers (the roles `WorkerFacts` reads); reviewers and orchestrators are not adopted
ADOPT_PATHS = ("pass", "retire", "relaunch", "replace", "move", "close")   # the one table of the paths that change a boss; a test loops over it
ADOPT_BY_DAEMON = "the switchboard"

# Every function that reads a worker's boss from the raw `reports_to` text, and why it may. Anything else must go through `boss_name` (the lookup that
# resolves the role alias and the boss record). A test scans this file for `reports_to` readers and fails when one is not in this table.
BOSS_READ_SITES = {
    "bin/fleet-switchboard:_boss_of": "the literal text; `boss_name` is built on it",
    "bin/fleet-switchboard:notice_boss": "resolves the text through `resolve_boss`, over a discovery that already applies the boss record",
    "bin/fleet-switchboard:reattach_caller_problem": "a dead agent is not discovered: its STORED metadata, overlaid with the boss record",
    "bin/fleet-switchboard:adoption_orphans": "reads the old boss text only for the audit row and the `bosses` filter; presence is judged by `boss_name`",
    "bin/fleet-switchboard:write_boss_records": "reads the launch-time boss text for the record's `original`",
    "bin/reassign.py:run_reassign": "reads the launch-time boss text for the record's `original`",
    "bin/work_sync.py:assignments": "reads the rows `WorkRows.agents` built with `_boss_of` over the discovery",
    "bin/fleet_health.py:reconstruct_day": "history: the boss named in a past `v2.session.create` audit row",
    "bin/item_verdicts.py:excluded": "reads the fleets the discovery built (the boss record already applied); it only EXCLUDES writers, so a worker adopted by a registered orchestrator is excluded too",
    "bin/launch_testers.py:launched": "history: the boss named in a launch record, not a live lookup",
    "bin/cloud_worker.py:cmd_retire": "a cloud worker's own endpoint record (not a discovered agent: out of scope of the boss record)",
}


class RecordUnreadable(Exception):
    """A record an adoption or a close reads strictly cannot be read in full (#838): nothing is changed."""


def _strict_retired(state):
    try:
        return read_retired_strict(state)
    except RetiredUnreadable as err:
        raise RecordUnreadable(str(err)) from None


def _strict_overrides(state):
    module = load_module("reassign")
    try:
        return module.read_overrides_strict(state)
    except module.OverridesUnreadable as err:
        raise RecordUnreadable(str(err)) from None


# The records every boss change reads STRICTLY, in one table the code loops over (a test has one case and one mutant per member): (file, reader).
ADOPT_STRICT_RECORDS = ((RETIRED_FILE, _strict_retired), ("boss-overrides.json", _strict_overrides))


def _read_strict_records(state):
    """{file: record} of every strict record, or RecordUnreadable naming the first that cannot be read in full."""
    return {file: reader(state) for file, reader in ADOPT_STRICT_RECORDS}


def _retired_entry_applies(retired, name, obs):
    """True only when a retirement of `name` names THIS agent's session. A record with no session covers NOTHING (a live agent is never taken for a retired one on a
    record that does not say which session was retired); the same rule as #870's, to be replaced by its one helper once that is on main."""
    entry = retired.get(name)
    return isinstance(entry, dict) and isinstance(entry.get("session"), str) and bool(entry["session"]) and entry["session"] == obs.session_id


def boss_is_present(discovery, retired, boss):
    """True when `boss` is a discovered agent that is not retired. A boss that is only hard to read still counts: no worker is taken from a boss on a doubt."""
    obs = discovery.agents.get(boss) if isinstance(boss, str) else None
    return obs is not None and not _retired_entry_applies(retired, boss, obs)


def _heir_ok(discovery, retired, name, obs):
    return not obs.problem and not _retired_entry_applies(retired, name, obs)


def registry_owners(engine):
    """{orchestrator name: charter} from the agent REGISTRY, the one record of an orchestrator's charter (#969), or {} when the registry cannot be read whole (then nobody is taken for a charter's owner: never a guess).
    The live session's metadata is never read for it."""
    try:
        registry = load_module("registry")
        reg = registry.read(engine.state_dir) if engine.state_dir is not None else None
        return registry.orchestrator_charters(reg["agents"]) if reg and reg["whole"] else {}
    except Exception:
        return {}


def registry_retired_owners(engine):
    """{orchestrator name: charter} the REGISTRY kept for a RETIRED orchestrator (its retirement record holds the row it had): a worker's boss's charter when the boss has just been retired (#969). {} when unreadable."""
    try:
        registry = load_module("registry")
        reg = registry.read(engine.state_dir) if engine.state_dir is not None else None
        out = {}
        for name, entry in ((reg or {}).get("retired") or {}).items():
            record = entry.get("record") if isinstance(entry, dict) and isinstance(entry.get("record"), dict) else {}
            if reg["whole"] and record.get("role") == "orchestrator" and registry.is_charter(record.get("charter")):
                out[name] = record["charter"]
        return out
    except Exception:
        return {}


def charter_or_first_seen(engine, name, fleet):
    """The charter of the agent `name`: its REGISTRY row's (None included) when the registry has a row for it, else its launch value (an agent the pass has not yet seen: the first-seen fill the pass makes anyway) (#969)."""
    try:
        registry = load_module("registry")
        reg = registry.read(engine.state_dir) if engine.state_dir is not None else None
        row = reg["agents"].get(name) if reg and reg["whole"] else None
    except Exception:
        row = None
    if isinstance(row, dict):
        return row.get("charter") if registry.is_charter(row.get("charter")) else None
    value = (fleet or {}).get("charter")
    return value if _is_issue_number(value) else None


def registry_charter_view(engine):
    """{agent name: the registry row's charter or None} for every agent that HAS a registry row, or {} when the registry cannot be read whole (#969). Used where a function sees many agents: an orchestrator
    with a row owns its row's charter only; one with no row yet owns its launch `charter` only. The metadata `issue` of an orchestrator (the ask it was launched for) is never a claim on a charter."""
    try:
        registry = load_module("registry")
        reg = registry.read(engine.state_dir) if engine is not None and getattr(engine, "state_dir", None) is not None else None
        return {n: (row.get("charter") if registry.is_charter(row.get("charter")) else None) for n, row in reg["agents"].items() if isinstance(row, dict)} if reg and reg["whole"] else {}
    except Exception:
        return {}


def owned_numbers(name, fleet, view):
    """The issue numbers the agent `name` (live metadata `fleet`) owns: an ORCHESTRATOR owns its charter (the registry row's when it has one, else its launch `charter`) and nothing else; any other role owns its own `issue`
    and `charter` (its own assignment). #969."""
    def number(value):
        if isinstance(value, int) and not isinstance(value, bool):
            return value
        if isinstance(value, str) and value.strip().lstrip("#").isdigit():
            return int(value.strip().lstrip("#"))
        return None
    if fleet.get("role") == "orchestrator":
        found = view[name] if name in view else number(fleet.get("charter"))
        return {found} if found is not None else set()
    return {n for n in (number(fleet.get("issue")), number(fleet.get("charter"))) if n is not None}


def worker_charter(discovery, worker, owners=None):
    """The charter a worker belongs to: its own `charter` (its own launch context), else the REGISTRY's charter of the orchestrator it reported to (`owners`, #969; still discovered, even if retired), else None."""
    fleet = worker.fleet or {}
    if _is_issue_number(fleet.get("charter")):
        return fleet["charter"], fleet
    old = discovery.agents.get(boss_name(discovery, worker) or "")
    if old is not None and (old.fleet or {}).get("role") == "orchestrator" and _is_issue_number((owners or {}).get(old.name)):
        return owners[old.name], old.fleet
    return None, fleet


def adoption_heir(engine, discovery, retired, worker):
    """(heir, why) for an orphan: the ONE live orchestrator of the worker's charter, else the ONE live Chief of Staff, else (None, None)."""
    owners = registry_owners(engine)   # #969: the registry's charter, never the session metadata
    charter, fleet = worker_charter(discovery, worker, dict(registry_retired_owners(engine), **owners))   # the old boss may have just been retired: its record keeps its charter
    if charter is not None:
        repo = _fleet_repo(fleet, engine.config)
        mine = sorted(n for n, o in discovery.agents.items()
                      if (o.fleet or {}).get("role") == "orchestrator" and owners.get(n) == charter and n != worker.name
                      and _fleet_repo(o.fleet, engine.config) == repo and _heir_ok(discovery, retired, n, o))
        if len(mine) == 1:
            return mine[0], "the charter's orchestrator"
    chiefs = sorted(n for n, o in discovery.agents.items() if (o.fleet or {}).get("role") == "chief-of-staff" and n != worker.name and _heir_ok(discovery, retired, n, o))
    if len(chiefs) == 1:
        return chiefs[0], "the Chief of Staff"
    return None, None


def adoption_orphans(engine, discovery, retired, names=None, bosses=None, charter=None):
    """[(worker, old boss text or None, heir or None, heir's role)] for every worker whose boss is not a present agent. `names` limits the workers, `bosses`
    the old boss (an orchestrator that was just retired or launched)."""
    found = []
    for name, obs in sorted(discovery.agents.items()):
        if (obs.fleet or {}).get("role") not in ADOPT_ROLES or not obs.session_id or (names is not None and name not in names):
            continue
        boss = boss_name(discovery, obs)
        if boss is not None and boss_is_present(discovery, retired, boss):
            continue
        if charter is not None and worker_charter(discovery, obs)[0] != charter:
            continue
        was = (obs.fleet or {}).get("reports_to")
        if bosses is not None and was not in bosses and boss not in bosses:
            continue
        heir, why = adoption_heir(engine, discovery, retired, obs)
        found.append((obs, was if isinstance(was, str) else None, heir, why))
    return found


def _retarget_overdue(engine, worker, was, heir):
    """The worker's overdue-checkpoint reminder follows its boss (the same as `reassign`). Says nothing; a problem is only noted."""
    if not was:
        return
    try:
        namespace = types.SimpleNamespace(engine=engine, read_reminders=read_reminders, write_reminders=write_reminders, reminders_lock=reminders_lock)
        load_module("reassign").retarget_reminders(namespace, worker, was, heir)
    except Exception as err:
        engine._note("boss.reminder_error", worker, {"error": _one_line(str(err), 100)})


def write_boss_records(engine, discovery, assignments, path, by):
    """THE ONE writer of a boss change of this ask. `assignments` is [(worker observation, old boss or None, heir name, why)]. Every record is read strictly: the
    agent list (no problem), the retired record, the boss record: one that cannot be read in full means NOTHING is written. Written under the boss
    record's lock in one atomic write, then audited, one row per worker. Returns ([(worker, heir)], problem or None)."""
    state = engine.state_dir
    if path not in ADOPT_PATHS:
        raise ValueError("unknown adoption path %r" % (path,))
    if not assignments:
        return [], None
    if state is None:
        return [], "there is no state directory: no boss was changed"
    if discovery is None or discovery.problems:
        return [], "the agent list cannot be read in full: no boss was changed"
    reassign = load_module("reassign")
    try:
        with reassign.locked(state):
            records = _read_strict_records(state)
            retired = records[RETIRED_FILE]
            overrides, problem = reassign.read_overrides(state)
            if problem:
                return [], "the boss record cannot be read in full (%s): no boss was changed" % _one_line(problem, 100)
            now = engine.now()
            before = set(overrides)
            reassign.prune(overrides, retired, now)
            pruned = before - set(overrides)
            done = []
            fresh = engine.discover(engine.now())   # judged again under the lock, from a fresh look: the heir must still be a live agent, the worker's boss still gone
            if fresh.problems:
                return [], "the agent list cannot be read in full: no boss was changed"
            kept = []
            for obs, was, heir, why in assignments:
                now_obs, now_heir = fresh.agents.get(obs.name), fresh.agents.get(heir)
                if now_obs is None or now_obs.session_id != obs.session_id or now_heir is None or not _heir_ok(fresh, retired, heir, now_heir):
                    continue
                if path != "move" and boss_name(fresh, now_obs) is not None and boss_is_present(fresh, retired, boss_name(fresh, now_obs)) and boss_name(fresh, now_obs) != heir:
                    continue   # its boss is back (relaunched) since the plan: nothing to fill
                held = reassign.matching(overrides, obs.name, obs.session_id)
                if held is not None and held["boss"] != (was or "") and held["boss"] != heir:
                    continue   # judged again under the lock: someone gave it another boss since the plan was made (a reassign, a move): never overwritten
                kept.append((obs, was, heir, why))
                original = (held or {}).get("original") or (obs.fleet or {}).get("reports_to") or ""
                overrides[obs.name] = {"boss": heir, "was": str(was or ""), "original": original, "session": obs.session_id, "by": by, "at": float(now),
                                       "adopted": True}
                done.append((obs.name, heir))
            assignments = kept
            if not kept:
                return [], None
            with engine._external("boss.adopt", "agents", {"path": path, "workers": [n for n, _ in done], "by": by}):
                written = {k: v for k, v in records["boss-overrides.json"].items() if k not in pruned}   # the strict table is the base: an entry `_clean` would drop is never lost silently
                written.update({name: overrides[name] for name, _ in done})
                reassign.write_overrides(state, written)
    except RecordUnreadable as err:
        return [], "%s: no boss was changed" % _one_line(str(err), 100)
    except (OSError, ValueError) as err:
        return [], "the boss record could not be written (%s): no boss was changed" % _one_line(str(err), 100)
    for obs, was, heir, why in assignments:
        if engine.audit is not None:
            engine.audit.append(engine.actor, "boss.adopted", "agent:%s" % obs.name, {"worker": obs.name, "was": was, "heir": heir, "why": why, "path": path, "by": by})
        _retarget_overdue(engine, obs.name, was, heir)
    return done, None


def adopt_workers(engine, path, by, discovery=None, names=None, bosses=None, charter=None):
    """Adopt every orphan (see `adoption_orphans`) by its heir. A worker with no heir changes nothing and is audited once. ([(worker, heir)], problem or None)."""
    state = engine.state_dir
    if state is None:
        return [], None
    try:
        discovery = discovery if discovery is not None else engine.discover(engine.now())
        if discovery.problems:
            return [], "the agent list cannot be read in full: nothing was adopted"
        retired = _read_strict_records(state)[RETIRED_FILE]
    except RecordUnreadable as err:
        return [], "%s: nothing was adopted" % _one_line(str(err), 100)
    plan, noted = [], engine.__dict__.setdefault("adopt_no_heir", set())
    for obs, was, heir, why in adoption_orphans(engine, discovery, retired, names, bosses, charter):
        if heir is None:
            if (obs.name, obs.session_id) not in noted and engine.audit is not None:
                noted.add((obs.name, obs.session_id))
                engine.audit.append(engine.actor, "boss.no_heir", "agent:%s" % obs.name, {"worker": obs.name, "was": was, "path": path, "why": "no heir: no live orchestrator of its charter and no Chief of Staff"})
            continue
        plan.append((obs, was, heir, "boss gone: %s" % why))
    done, problem = write_boss_records(engine, discovery, plan, path, by)
    return done, problem


def adoption_pass(engine, now):
    """The daemon pass: every worker whose boss is gone is adopted. Never raises; a problem is noted once per pass."""
    discovery = getattr(engine, "discovery", None)
    if discovery is None or discovery.problems or engine.state_dir is None:
        return
    done, problem = adopt_workers(engine, "pass", ADOPT_BY_DAEMON, discovery)
    if problem:
        engine._note("boss.adoption_error", None, {"error": _one_line(problem, 160)})


def repoint_workers(engine, names, heir, path, by):
    """Point the named workers at `heir` (a live orchestrator): the split of an ask. Judged on a fresh discovery. ([(worker, heir)], problem or None)."""
    try:
        discovery = engine.discover(engine.now())
        retired = _read_strict_records(engine.state_dir)[RETIRED_FILE] if engine.state_dir is not None else {}
    except RecordUnreadable as err:
        return [], "%s: no worker was re-pointed" % _one_line(str(err), 100)
    target = discovery.agents.get(heir)
    if target is None or not _heir_ok(discovery, retired, heir, target) or (target.fleet or {}).get("role") != "orchestrator":
        return [], "%s is not a live orchestrator: no worker was re-pointed" % heir
    plan = []
    for name in names:
        obs = discovery.agents.get(name)
        if obs is None or not obs.session_id or (obs.fleet or {}).get("role") not in ADOPT_ROLES or name == heir or boss_name(discovery, obs) == heir:
            continue
        plan.append((obs, boss_name(discovery, obs), heir, "its ask moved to the charter of %s" % heir))
    return write_boss_records(engine, discovery, plan, path, by)


def adopt_before_close(engine, runner, now, name):
    """`retire <name> --close` by the agent that WOULD be the boss: a retired worker whose boss is gone is adopted first (one worker, the same heir rule), so the
    close is judged by the ordinary boss rule. Only for an already retired worker and only when the caller is its heir; anything else changes nothing."""
    kind = gates_caller_kind(runner, now)
    if kind[0] != "agent" or engine.state_dir is None:
        return
    try:
        discovery = engine.discover(engine.now())
        retired = _read_strict_records(engine.state_dir)[RETIRED_FILE]
    except Exception:
        return   # fails closed: nothing is adopted, so the ordinary boss rule refuses the close (and says why)
    seen = discovery.agents.get(name)
    if seen is None or discovery.problems or not _retired_entry_applies(retired, name, seen):
        return
    for obs, was, heir, why in adoption_orphans(engine, discovery, retired, names={name}):
        if heir == kind[1]:
            done, _ = adopt_workers(engine, "close", kind[1], discovery, names={name})
            if done:
                engine.__dict__.setdefault("retire_close_route", {})[name] = "boss gone, adopted by %s (%s): its boss rule applies" % (heir, why)


def retire_close_problem(engine, runner, now, discovery, name, seen, force):
    """(pane, None) when `retire --close` may close `name`'s pane now, else (None, why not). Judged BEFORE the retirement, so a refusal changes nothing.
    Who: the operator at their own terminal (any agent), the agent's recorded boss, or the Chief of Staff for an agent that reports to it DIRECTLY;
    never the caller's own pane or session. What: the pane the switchboard has for the agent, read again live, must still hold THAT agent's session
    (a stored pane id can name another terminal after a herdr restart). A pane herdr reads as working needs --force unless the session's own state shows it idle (`retire_idle_evidence`); --force is refused while a registered worktree of
    the agent holds uncommitted or unpushed work."""
    reg = load_module("registry").read(engine.state_dir)
    if not reg["whole"]:   # fails CLOSED: a pane is never closed on a half read of the registry
        return None, "the agent registry cannot be read (%s): nothing was closed" % _one_line(reg["problem"] or "unknown", 100)
    kind = gates_caller_kind(runner, now)
    if kind[0] == "person":
        who = "the operator"
    elif kind[0] == "agent":
        who = kind[1]
        if who == name:
            return None, "an agent cannot close its own pane"
        if seen is None or boss_name(discovery, seen) != who:
            return None, "%s may not close %s's pane: only the operator, or the agent's own boss (the Chief of Staff for a direct report), may" % (who, name)
    else:
        return None, "%s: only the operator or the agent's own boss may close a pane" % kind[1]
    if seen is None or not seen.pane or not seen.session_id:
        return None, "%s has no pane and session the switchboard can see: nothing to close" % name
    pane = seen.pane
    if os.environ.get("HERDR_PANE_ID") == pane:
        return None, "pane %s is the one you are in: never closed by you" % pane
    try:
        live = engine.herdr.agent_get(pane)
    except HerdrError as err:
        return None, "pane %s cannot be read now (%s): nothing was closed" % (pane, _one_line(str(err), 80))
    if agent_session(live) != seen.session_id:
        return None, "pane %s no longer holds %s's session: nothing was closed" % (pane, name)
    busy = live.get("agent_status") in ("working", "blocked")
    idle_evidence = None
    if busy and not force:
        idle_evidence = retire_idle_evidence(engine, now, name, seen, live.get("agent_status"))
        if idle_evidence is None:
            unknown = " (session state unknown or not idle: nothing confirms it is idle)" if live.get("agent_status") == "working" else ""
            return None, "%s is %s: pass --force to close it anyway%s" % (name, live.get("agent_status"), unknown)
        engine.__dict__.setdefault("retire_idle_seen", {})[name] = idle_evidence
    if busy and (force or idle_evidence) and engine.state_dir is not None:
        for path, entry in sorted(read_worktrees(engine.state_dir).items()):
            if isinstance(entry, dict) and entry.get("agent") == name:
                facts = worktree_facts(runner, path)
                if facts["exists"] and (facts["why"] or facts["dirty"] or facts["pushed"] is False):
                    return None, "--force refused: %s holds uncommitted or unpushed work in %s" % (name, path)
    return pane, None


def retire_close_pane(engine, runner, now, name, pane, caller, force):
    """Close `pane` after judging EVERYTHING again from a fresh discovery (the first judgment was before the retirement lock and the worktree reclaim):
    who may, which pane, its session, its status and the worktree guard. Audited whether it closes or not. (status line, ok)"""
    detail = {"pane": pane, "by": caller}
    engine.__dict__.setdefault("retire_idle_seen", {}).pop(name, None)
    route = engine.__dict__.get("retire_close_route", {}).get(name)
    if route:
        detail["boss_rule"] = route   # #838: why the boss rule did not stop it: the worker was adopted by its heir first
    try:
        fresh = engine.discover(engine.now())
        again, why = retire_close_problem(engine, runner, now, fresh, name, fresh.agents.get(name), force)
        if why:
            raise HerdrError("refused", why)
        if again != pane:
            raise HerdrError("moved", "the agent's pane is now %s, not %s" % (again, pane))
        with engine._external("herdr.pane.close", name, {"pane": pane, "why": "retire --close"}):
            engine.herdr.pane_close(pane)
    except Exception as err:
        if engine.audit is not None:
            engine.audit.append(engine.actor, "fleetpane.close_failed", name, dict(detail, why=_one_line(str(err), 120)))
        return "pane %s was not closed (%s): the agent is retired" % (pane, _one_line(str(err), 100)), False
    evidence = engine.__dict__.get("retire_idle_seen", {}).get(name)
    if evidence:
        detail["evidence"] = evidence
    if engine.audit is not None:
        engine.audit.append(engine.actor, "fleetpane.closed", name, detail)
    return "closed pane %s (the agent's terminal: its memory is released%s)" % (pane, "; " + evidence if evidence else ""), True


def headless_record_to_free(state, name):
    """What `retire` keeps of a headless worker's record ({"session", "url", "created"}), or None when it has none. Reads only."""
    try:
        record = load_agent_presence().read_record(state, name)[0]
    except Exception:
        return None
    if record is None:
        return None
    return {"session": record["session"], "url": record.get("url"), "created": record.get("created")}


def free_headless_record(engine, state, name):
    """Remove the record of a retired headless worker so the NAME is free to launch again (its details are kept in the retirement for `retire --undo`).
    One line. The session itself keeps running in the service: only the switchboard stops watching it."""
    try:
        with agent_lock(state, name):   # the same per-name lock a launch holds for its check and its record write
            load_agent_presence().remove_record(state, name)
    except Exception as err:
        return "%s: its headless record could NOT be removed (%s): the name stays taken until it is" % (name, _one_line(str(err), 100))
    if engine.audit is not None:
        engine.audit.append(engine.actor, "headless.record_freed", name, {"why": "retired"})
    return "%s: its headless record was removed, so the name is free (`%s retire --undo %s` puts it back)" % (name, PROG, name)


def restore_headless_record(engine, state, name, entry):
    """`retire --undo` of a headless worker: put its record back when the name is still free. (line or None, ok): ok is False only when the record
    could not be put back (busy, or a write error): the retirement then stays so the undo can be tried again. A name that is taken again is not an
    error: the old record is simply not restored, and the line says so."""
    kept = entry.get("headless") if isinstance(entry, dict) else None
    if not isinstance(kept, dict) or not isinstance(kept.get("session"), str):
        return None, True
    ap = load_agent_presence()
    try:
        with agent_lock(state, name):   # the per-name lock of a launch: the check and the write are ONE step, judged on a fresh discovery
            if ap.read_record(state, name)[0] is not None or name in engine.discover(engine.now()).agents:
                return "%s: a worker named %s exists again, so its old headless record was NOT restored" % (name, name), True
            ap.save_record(state, name, kept["session"], kept.get("url"), now=kept.get("created"))
    except ImpactStateBusy:
        return "%s: a launch of %s is running, so its old headless record was NOT restored" % (name, name), False
    except Exception as err:
        return "%s: its headless record could NOT be restored (%s)" % (name, _one_line(str(err), 100)), False
    if engine.audit is not None:
        engine.audit.append(engine.actor, "headless.record_restored", name, {"session": kept["session"]})
    return "%s: its headless record was restored: it is watched again" % name, True


def cmd_retire(args, runner, now):
    """`retire <name> [--reason TEXT]` / `retire --undo <name>`: a finished worker is RETIRED: the daemon stops reporting it DEAD or DETACHED, `reattach
    --all-detached` skips it, and it is shown once in `status` as retired (dropped after RETIRED_SHOW_DAYS). Nothing is deleted and no tab is closed, unless
    `--close` is given: then the agent's terminal PANE is closed too (see `retire_close_problem`). The caller rule is `reattach`'s: the operator, the
    Chief of Staff or the agent's own boss; others are refused and audited."""
    remote = run_cloud("route", args.name)   # a cloud worker has an endpoint record (#371)
    if remote is not None:
        return run_cloud("cmd_retire", args, runner, now, remote)
    engine, state, _ = build_engine(runner, now, "cli")
    name = args.name
    if not NAME_RE.match(name or ""):
        raise LaunchError("name the agent: `%s retire <name>`" % PROG)
    discovery = engine.discover(engine.now())
    hint = ((registry_retired(state).get(name) or {}).get("session") if args.undo else None)   # a retired headless worker is not discovered: its boss is found from its stored session
    who = reattach_caller_problem(engine, runner, now, discovery, name, hint, lost_headless=not args.undo)
    if who:
        if engine.audit is not None:
            engine.audit.append(engine.actor, "fleetpane.retire_refused", name, {"why": _one_line(who, 160)})
        raise LaunchError("refused: %s" % who)
    reason = " ".join(re.sub(r"[\x00-\x1f\x7f-\x9f]", " ", args.reason or "").split())[:200]
    seen = discovery.agents.get(name)
    known = known_agent(state, name)   # a pruned retired agent is still known
    close_pane, close_by, close_note, headless_kept = None, None, None, None
    if getattr(args, "close", False) and not args.undo and seen is not None and seen.headless:
        close_note = "headless: it has no terminal, so there is nothing to close"
    elif getattr(args, "close", False) and not args.undo:
        if seen is not None:
            adopt_before_close(engine, runner, now, name)   # #838: a retired worker with no live boss is adopted by its heir first, so the ordinary boss rule judges the close
            discovery = engine.discover(engine.now())
            seen = discovery.agents.get(name)
        close_pane, why = retire_close_problem(engine, runner, now, discovery, name, seen, getattr(args, "force", False))
        close_by = identify_who(engine, runner, now)
        if why:
            if engine.audit is not None:
                engine.audit.append(engine.actor, "fleetpane.close_refused", name, {"pane": seen.pane if seen is not None else None, "by": close_by, "why": _one_line(why, 160)})
            raise LaunchError("refused: %s (nothing was retired or closed)" % why)
    with agent_lock(state, "files"):
        who = reattach_caller_problem(engine, runner, now, discovery, name, hint, lost_headless=not args.undo)   # judged again inside the lock: check and write are one step
        if who:
            raise LaunchError("refused: %s" % who)
        reg = load_module("registry").read(state)
        if not reg["whole"]:   # acts on the registry: fails closed on a half read
            raise LaunchError("the agent registry cannot be read (%s): nothing was changed" % _one_line(reg["problem"] or "unknown", 120))
        retired = reg["retired"]
        if args.undo:
            entry = retired.get(name)
            if entry is None:
                print("%s is not retired" % name)
                return EXIT_OK
            restored, restore_ok = restore_headless_record(engine, state, name, entry)   # FIRST: a record that cannot be put back leaves the retirement as it is, to try again
            if not restore_ok:
                raise LaunchError("%s: nothing was changed, the retirement stays (try `%s retire --undo %s` again)" % (restored, PROG, name))
            got = load_module("registry").unretire(state, name)
            if got["problem"]:
                raise LaunchError("the agent registry could not be updated (%s): nothing changed, try `%s retire --undo %s` again" % (_one_line(got["problem"], 100), PROG, name))
            data = read_pane_health(state)
            data["states"].pop(name, None)
            data["missing"].pop(name, None)
            if entry.get("session") and not entry.get("headless") and name not in data["agents"]:
                data["agents"][name] = dict(entry["record"] if isinstance(entry.get("record"), dict) else {}, session=entry["session"])   # the retire pruned its row: put back all of it
            try:
                write_pane_health(state, data)
            except OSError:
                pass
            if engine.audit is not None:
                engine.audit.append(engine.actor, "fleetpane.unretired", name, {})
            print("%s is no longer retired: detection watches it again" % name)
            if restored:
                print(restored)
            return EXIT_OK
        headless_kept = headless_record_to_free(state, name)
        headless_lost = seen is None and not known and headless_kept is not None   # a headless record with no session: the worker is lost, not unknown
        if seen is None and not known and not headless_lost:
            raise LaunchError("%s is not a fleet agent this switchboard has seen (see `%s status`)" % (name, PROG))
        retired = {name: {"by": identify_who(engine, runner, now), "reason": reason or "finished"}}
        session_of = (seen.session_id if seen else None) or known.get("session")
        if headless_lost:
            session_of = headless_kept["session"]
        retire_fn = load_module("registry").close if close_pane is not None else load_module("registry").retire
        got = retire_fn(state, name, retired[name]["by"], retired[name]["reason"], session=session_of,
                        record=pane_record_of(known) if known else None,   # the pane record is pruned: keep what reattach and --undo read
                        extra={"headless": headless_kept} if headless_kept is not None else None, now=int(now()))   # kept so `retire --undo` can put the record back
        if got["problem"]:
            raise LaunchError("the agent registry could not be written (%s): %s was not retired, try again" % (_one_line(got["problem"], 100), name))
    data = read_pane_health(state)
    data["states"].pop(name, None)
    data["agents"].pop(name, None)   # pruned in the same step as the retire: the session is in retired.json
    data["missing"].pop(name, None)
    try:
        write_pane_health(state, data)
    except OSError:
        pass
    if engine.audit is not None:
        engine.audit.append(engine.actor, "fleetpane.retired", name, {"auto": False, "reason": retired[name]["reason"], "by": retired[name]["by"]})
    if headless_kept is not None:
        print(free_headless_record(engine, state, name))
    if close_note is not None:
        print("%s is retired: not watched, not reattached by --all-detached; %s. Its session keeps running in the service until it finishes or is interrupted (`%s retire --undo %s` reverses the retirement)" % (name, close_note, PROG, name))
    elif close_pane is not None:
        line, _ = retire_close_pane(engine, runner, now, name, close_pane, close_by, getattr(args, "force", False))
        print("%s is retired: not watched, not reattached by --all-detached; %s (`%s retire --undo %s` reverses the retirement)" % (name, line, PROG, name))
    else:
        print("%s is retired: not watched, not reattached by --all-detached; nothing was deleted or closed (`%s retire --undo %s` reverses)" % (name, PROG, name))
    if seen is not None and (seen.fleet or {}).get("role") == "orchestrator":
        adopted, problem = adopt_workers(engine, "retire", identify_who(engine, runner, now), bosses={name})   # #838: its workers are inherited in the same step
        for worker, heir in adopted:
            print("adopted: %s now reports to %s" % (worker, heir))
        if problem:
            sys.stderr.write("%s: %s is retired, but its workers were not re-pointed (%s): the next daemon pass retries\n" % (PROG, name, _one_line(problem, 160)))
    try:
        for line in reclaim_for_agent(engine, runner, name, True, "retired"):   # its registered worktrees: removed when clean and pushed, else kept with the reason
            print("worktree: " + line)
    except Exception as err:   # the retirement above is already written: a reclaim problem is said, never a traceback
        sys.stderr.write("%s: worktree reclaim failed (%s): the agent is retired; run `%s disk reclaim-worktrees --apply` to retry\n" % (PROG, _one_line(str(err), 100), PROG))
    try:
        for line in reclaim_agent_tmp(engine, name, headless=headless_kept is not None):   # its private TMPDIR (#767): removed when empty, else kept with the reason
            print("tmpdir: " + line)
    except Exception as err:   # the retirement is already written: said, never a traceback
        sys.stderr.write("%s: private temp directory not handled (%s): the agent is retired; remove it by hand\n" % (PROG, _one_line(str(err), 100)))
    return EXIT_OK


# ---------------------------------------------------------------- worktree lifecycle (#321 slices S2, S3, S10)
#
# `launch` records a linked worktree it is pointed at ONLY when no other agent holds it (it does not run `git worktree add`, so it cannot prove it
# created it: the owner is inferred, which the docs say; an existing owner is never overwritten). `retire`, an automatic retire and
# `disk reclaim-worktrees --apply` remove a REGISTERED worktree only when `git status` is clean AND its HEAD is on a remote branch (pushed or
# merged); otherwise they keep it and say why in one line. A `done` report only says a worktree is reclaimable. Never an unregistered worktree,
# never a main checkout, never `--force`, never a branch. The kill switch is `worktree_reclaim.enabled: false` (and `on_done: false` for the done note).

WORKTREES_FILE = "worktrees.json"
WORKTREE_GIT_SECONDS = 20
WORKTREE_RECLAIM_MAX = 20     # worktrees looked at per call: a pass or a command never does unbounded git work
# Ignored files that are regenerable build output: deleting them with the worktree loses nothing. ANY OTHER ignored file (.env, local config, data)
# is unrecoverable local state, so its worktree is kept.
IGNORED_SAFE = ("node_modules", "__pycache__", ".pytest_cache", ".mypy_cache", ".ruff_cache", "dist", "build", ".venv", "venv", ".DS_Store", ".tox")


def worktree_config(config):
    section = (config or {}).get("worktree_reclaim") or {}
    return {"enabled": section.get("enabled", True) is not False, "on_done": section.get("on_done", True) is not False}


def validate_worktree_config(config, source):
    raw = config.get("worktree_reclaim")
    if raw is None:
        return
    if not isinstance(raw, dict) or set(raw) - {"enabled", "on_done"} or any(not isinstance(v, bool) for v in raw.values()):
        raise ConfigError("%s: 'worktree_reclaim' must be {\"enabled\": true|false, \"on_done\": true|false}, got %r" % (source, raw))


def _git(runner, path, *args):
    """git always runs for real (the `runner` the CLI passes may be a fleet fake that refuses other binaries): argv list, no shell, a timeout."""
    try:
        return subprocess.run(["git", "-C", str(path)] + list(args), capture_output=True, text=True, timeout=WORKTREE_GIT_SECONDS, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError) as err:
        return subprocess.CompletedProcess(args, 255, "", str(err))


def worktree_facts(runner, path):
    """{"exists", "linked", "main", "branch", "dirty", "pushed", "why"}: what git says about `path`. `linked` is True only for a LINKED worktree
    (its git dir differs from the common one); a main checkout is never linked. `pushed` is True when HEAD is on some remote branch (pushed or
    merged). Anything git cannot answer leaves `why` set and is treated as not safe to remove."""
    facts = {"exists": os.path.isdir(path), "linked": False, "main": None, "branch": None, "dirty": None, "pushed": None, "why": None}
    if not facts["exists"]:
        return facts
    gd = _git(runner, path, "rev-parse", "--path-format=absolute", "--git-dir")
    cd = _git(runner, path, "rev-parse", "--path-format=absolute", "--git-common-dir")
    if gd.returncode != 0 or cd.returncode != 0:
        facts["why"] = "git cannot read it (%s)" % _one_line(gd.stderr or cd.stderr, 80)
        return facts
    git_dir, common = os.path.realpath(gd.stdout.strip()), os.path.realpath(cd.stdout.strip())
    facts["linked"] = git_dir != common
    facts["main"] = os.path.dirname(common) if os.path.basename(common) == ".git" else common
    head = _git(runner, path, "rev-parse", "--abbrev-ref", "HEAD")
    facts["branch"] = head.stdout.strip() if head.returncode == 0 else None
    status = _git(runner, path, "status", "--porcelain", "--untracked-files=all")
    if status.returncode != 0:
        facts["why"] = "git status failed (%s)" % _one_line(status.stderr, 80)
        return facts
    facts["dirty"] = [l for l in status.stdout.splitlines() if l.strip()]
    ignored = _git(runner, path, "status", "--porcelain", "--ignored", "--untracked-files=all")
    if ignored.returncode != 0:
        facts["why"] = "git could not list the ignored files (%s)" % _one_line(ignored.stderr, 80)
        return facts
    facts["ignored"] = [l[3:] for l in ignored.stdout.splitlines() if l.startswith("!! ")
                        and not any(part in IGNORED_SAFE or part.endswith(".pyc") for part in l[3:].strip("/").split("/"))]
    contains = _git(runner, path, "branch", "-r", "--contains", "HEAD")
    if contains.returncode != 0:
        facts["why"] = "git could not say whether HEAD is pushed (%s)" % _one_line(contains.stderr, 80)
        return facts
    facts["pushed"] = any(l.strip() and "->" not in l for l in contains.stdout.splitlines())
    return facts


def read_worktrees(state_dir):
    return _read_small(state_dir, WORKTREES_FILE)


def register_worktree(state_dir, path, agent, repo, branch, now):
    """Record one worktree (atomic, 0600, under the state lock). Returns True when written, False when it could not be, and the OWNER's name (a str)
    when another agent already holds it: an existing entry's owner is never overwritten."""
    try:
        with agent_lock(state_dir, "files", seconds=2):
            data = read_worktrees(state_dir)
            held = data.get(str(path))
            if isinstance(held, dict) and held.get("agent") not in (None, agent):
                return held.get("agent")   # a second claim never takes the owner over: the caller says so
            data[str(path)] = {"agent": agent, "repo": repo, "branch": branch, "created": int(now)}
            _write_small(state_dir, WORKTREES_FILE, data)
        return True
    except Exception:
        return False


def _unregister_worktree(state_dir, path):
    """Drop a registry entry. Returns whether it is gone (False: the registry could not be written; the caller says so)."""
    try:
        with agent_lock(state_dir, "files", seconds=2):
            data = read_worktrees(state_dir)
            if data.pop(str(path), None) is not None:
                _write_small(state_dir, WORKTREES_FILE, data)
        return True
    except Exception:
        return False


def worktree_in_use(engine, path):
    """None when no herdr pane (an agent's OR a plain terminal) has its working directory, or its foreground process's, inside `path`; else why it is
    kept. ONE `herdr pane list`, no row cap. Anything herdr cannot say keeps the worktree (no proof, no removal)."""
    herdr = getattr(engine, "herdr", None)
    if herdr is None:
        return None
    try:
        panes = herdr.pane_list()
    except HerdrError as err:
        return "herdr cannot say whether a pane works in it (%s)" % _one_line(str(err), 80)
    root = os.path.realpath(path).rstrip("/") + "/"
    for pane in panes:
        if not isinstance(pane, dict):
            return "herdr listed a pane this cannot read: it cannot say none works in it"
        for key in ("cwd", "foreground_cwd"):
            where = pane.get(key)
            if isinstance(where, str) and where and (os.path.realpath(where) + "/").startswith(root):
                return "herdr pane %s is working in it (%s): close it or leave that directory first" % (pane.get("pane_id"), key)
    return worktree_session_in_use(engine, root)


@contextmanager
def worktree_sweep(engine):
    """One session.list serves every in-use check inside the block; the cache is dropped on the way out, whatever happens."""
    before = (getattr(engine, "_wt_sweep", False), getattr(engine, "_wt_session_index", None))
    engine._wt_sweep, engine._wt_session_index = True, None
    try:
        yield
    finally:
        engine._wt_sweep, engine._wt_session_index = before


WORKTREE_SESSION_PAGES = 20    # pages of session.list read once per sweep; a list longer than this is incomplete


def worktree_session_index(engine):
    """({session id: directory}, complete) from ONE paged `session.list`, cached on the engine for the duration of a sweep (`engine._wt_sweep`);
    a call outside a sweep reads fresh. V2Error propagates (the caller keeps the worktree)."""
    cached = getattr(engine, "_wt_session_index", None)
    if cached is not None and getattr(engine, "_wt_sweep", False):
        return cached
    index, cursor, complete = {}, None, False
    for _ in range(WORKTREE_SESSION_PAGES):
        page, cursor = engine.v2.session_list_page(None, cursor)
        for item in page:
            if isinstance(item, dict) and isinstance(item.get("id"), str):
                index[item["id"]] = (item.get("location") or {}).get("directory") or item.get("directory")
        if cursor is None:
            complete = True
            break
    result = (index, complete)
    if getattr(engine, "_wt_sweep", False):
        engine._wt_session_index = result
    return result


def worktree_session_in_use(engine, root):
    """None when no NON-RETIRED agent's OpenCode session runs with its directory inside `root` (realpath, trailing "/"), else why it is kept. A session
    can run in a worktree while its pane sits elsewhere. The agents are those the switchboard knows (the pane-health registry and the last discovery);
    their sessions are looked up in ONE `session.list` per sweep. A list that cannot be read keeps the worktree, and so does a known session missing
    from an incomplete (too long) list; a session missing from a complete list is gone and is no one's directory."""
    if engine.state_dir is None:
        return None
    seen = registry_read(engine.state_dir)
    if not seen["whole"]:
        return "cannot read the agent registry (%s): cannot say no session runs in it" % _one_line(str(seen["problem"]), 80)
    retired = seen["retired"]
    known = {}
    for name, info in seen["agents"].items():   # the registry's local agents (a cloud worker's session is not in the local service)
        if isinstance(info.get("session"), str) and (info.get("kind") or "local") == "local":
            known[name] = info["session"]
    for name, obs in (getattr(getattr(engine, "discovery", None), "agents", None) or {}).items():
        if getattr(obs, "session_id", None):
            known[name] = obs.session_id
    todo = sorted((name, sid) for name, sid in known.items() if name not in retired)
    if not todo:
        return None
    try:
        index, complete = worktree_session_index(engine)
    except V2Error as err:
        return "cannot read the session list (%s): cannot say no session runs in it" % _one_line(str(err), 80)
    for name, sid in todo:
        if sid not in index:
            if not complete:
                return "the session of %s is not in the first %d pages of the session list: cannot say it does not run in it" % (name, WORKTREE_SESSION_PAGES)
            try:   # a list may hide a session `session.get` can read: ask for the one that is missing before calling it gone
                got = engine.v2.session_get(sid)
            except V2Error as err:
                if err.reason == "http" and err.status == 404:
                    continue
                return "cannot read the session of %s (%s): cannot say it does not run in it" % (name, _one_line(str(err), 80))
            index = dict(index, **{sid: ((got.get("location") or {}).get("directory") or got.get("directory")) if isinstance(got, dict) else None})
        where = index[sid]
        if isinstance(where, str) and where and (os.path.realpath(where) + "/").startswith(root):
            return "the session of %s (%s) runs in it: retire it first" % (name, sid)
    return None


def reclaim_worktree(engine, runner, path, entry, apply=True):
    """(status, line) for ONE registered worktree: `removed`, `would-remove`, `kept` (with the reason), `gone` (the directory is already gone: the entry is
    dropped) or `refused` (not a linked worktree: never touched). Never forces, never removes a branch."""
    if not isinstance(entry, dict) or not isinstance(path, str) or not os.path.isabs(path) or path.startswith("-"):
        return "refused", "%s: refused: not a usable registry entry" % _one_line(str(path), 60)
    agent = entry.get("agent")
    facts = worktree_facts(runner, path)
    if not facts["exists"]:
        dropped = apply and _unregister_worktree(engine.state_dir, path)
        return "gone", "%s: already gone%s" % (path, "; dropped from the registry" if dropped else ("; the registry entry could not be dropped" if apply else ""))
    if facts["why"]:
        return "kept", "%s: kept: %s" % (path, facts["why"])
    if not facts["linked"]:
        return "refused", "%s: refused: it is a main checkout, never touched" % path
    if facts["dirty"]:
        return "kept", "%s: kept: uncommitted changes (%d file(s), e.g. %s)" % (path, len(facts["dirty"]), _one_line(facts["dirty"][0], 60))
    if facts.get("ignored"):
        return "kept", "%s: kept: ignored local file(s) that are not known build output would be lost (%d, e.g. %s)" % (path, len(facts["ignored"]), _one_line(facts["ignored"][0], 60))
    if not facts["pushed"]:
        return "kept", "%s: kept: unpushed (HEAD %s is on no remote branch)" % (path, facts["branch"] or "detached")
    busy = worktree_in_use(engine, path)
    if busy:
        return "kept", "%s: kept: %s" % (path, busy)
    if not apply:
        return "would-remove", "%s: would remove (clean, pushed; branch %s)" % (path, facts["branch"])
    again = _git(runner, path, "status", "--porcelain", "--untracked-files=all")   # the window between the check and the remove is as short as it can be
    if again.returncode != 0 or again.stdout.strip():
        return "kept", "%s: kept: it changed while it was being checked" % path
    done = _git(runner, facts["main"], "worktree", "remove", "--", str(path))
    if done.returncode != 0:
        return "kept", "%s: kept: git refused to remove it (%s)" % (path, _one_line(done.stderr, 100))
    stale = "" if _unregister_worktree(engine.state_dir, path) else "; the registry entry could not be dropped (it is harmless: the directory is gone)"
    if engine.audit is not None:
        engine.audit.append(engine.actor, "worktree.removed", agent or path, {"path": str(path), "branch": facts["branch"], "repo": entry.get("repo")})
    return "removed", ("%s: removed (clean, pushed; branch %s kept). The session of %s cannot be resumed from that directory: it is gone; "
                       "the way back is a fresh launch under a new name%s") % (path, facts["branch"], _one_line(str(agent or "its worker"), 40), stale)


def reclaim_for_agent(engine, runner, name, apply=True, why="retired"):
    """Reclaim every REGISTERED worktree of agent `name`. Returns the one-line results (empty when it has none). Off with worktree_reclaim.enabled false."""
    if engine.state_dir is None:
        return []
    mine = {p: e for p, e in read_worktrees(engine.state_dir).items() if isinstance(e, dict) and e.get("agent") == name}
    if not mine:
        return []
    if not worktree_config(engine.config)["enabled"]:
        return ["worktree reclaim is switched off (worktree_reclaim.enabled is false): %d worktree(s) of %s kept" % (len(mine), name)]
    lines = []
    with worktree_sweep(engine):   # one session.list for the whole sweep
        results = [(path,) + reclaim_worktree(engine, runner, path, entry, apply) for path, entry in sorted(mine.items())[:WORKTREE_RECLAIM_MAX]]
    for path, status, line in results:
        lines.append(line)
        if status == "kept" and engine.audit is not None:
            engine.audit.append(engine.actor, "worktree.kept", name, {"path": path, "reason": _one_line(line, 160), "after": why})
    if len(mine) > WORKTREE_RECLAIM_MAX:
        lines.append("%d of %d worktree(s) handled (cap %d); `disk reclaim-worktrees` does the rest" % (WORKTREE_RECLAIM_MAX, len(mine), WORKTREE_RECLAIM_MAX))
    return lines


def worktree_of_directory(runner, directory):
    """(path, branch) when `directory` is a LINKED worktree root, else None."""
    facts = worktree_facts(runner, directory)
    if not facts["exists"] or not facts["linked"]:
        return None
    top = _git(runner, directory, "rev-parse", "--path-format=absolute", "--show-toplevel")
    path = top.stdout.strip() if top.returncode == 0 else directory
    return path, facts["branch"]


def cmd_disk_reclaim_worktrees(args, runner, now):
    """`disk reclaim-worktrees [--apply]`: the registered worktrees of RETIRED agents. A dry run by default; `--apply` is the operator's or the Chief of
    Staff's. Never an unregistered worktree, never a main checkout."""
    engine, state, config = build_engine(runner, now, "cli", writable=bool(args.apply))
    if args.apply:
        kind = gates_caller_kind(runner, now)
        if not (kind[0] == "person" or (kind[0] == "agent" and len(kind) > 2 and kind[2] == "chief-of-staff")):
            raise LaunchError("refused: only the operator or the Chief of Staff may --apply a worktree reclaim (%s is %s)" % (kind[1], "an agent" if kind[0] == "agent" else "not known"))
        if not worktree_config(config)["enabled"]:
            raise LaunchError("worktree reclaim is switched off (worktree_reclaim.enabled is false)")
    retired = registry_retired(state)
    registry = read_worktrees(state)
    todo = {p: e for p, e in registry.items() if isinstance(e, dict) and e.get("agent") in retired}
    removed = kept = 0
    with worktree_sweep(engine):   # one session.list for the whole sweep
        results = [reclaim_worktree(engine, runner, path, entry, bool(args.apply)) for path, entry in sorted(todo.items())[:WORKTREE_RECLAIM_MAX]]
    for status, line in results:
        print(line)
        removed += status in ("removed", "would-remove", "gone")
        kept += status in ("kept", "refused")
    if len(todo) > WORKTREE_RECLAIM_MAX:
        print("%s: only %d of %d worktree(s) handled (cap %d): run it again for the rest" % (PROG, WORKTREE_RECLAIM_MAX, len(todo), WORKTREE_RECLAIM_MAX))
    print("%s: %d registered worktree(s) of retired agents: %d %s, %d kept%s; %d registered in all, %d of agents not retired are left alone" % (
        PROG, len(todo), removed, "removed" if args.apply else "would be removed", kept, "" if args.apply else " (a dry run: add --apply)",
        len(registry), len(registry) - len(todo)))
    return EXIT_OK


def cmd_disk_register_worktree(args, runner, now):
    """`disk register-worktree <path> --agent NAME`: record a worktree launch did not create. Same caller rule as `reattach` (operator, Chief of Staff or the agent's boss)."""
    engine, state, _ = build_engine(runner, now, "cli")
    who = reattach_caller_problem(engine, runner, now, engine.discover(engine.now()), args.agent)
    if who:
        raise LaunchError("refused: %s" % who)
    path = os.path.realpath(args.path)
    found = worktree_of_directory(runner, path)
    if found is None:
        raise LaunchError("%s is not a linked git worktree (a main checkout or a plain directory is never registered)" % path)
    done = register_worktree(state, found[0], args.agent, args.repo, found[1], now())
    if isinstance(done, str):
        raise LaunchError("refused: %s is already registered to %s; a second claim never takes it over" % (found[0], done))
    if done is not True:
        raise LaunchError("the registry could not be written: nothing changed")
    if engine.audit is not None:
        engine.audit.append(engine.actor, "worktree.registered", args.agent, {"path": found[0], "branch": found[1], "by": "register-worktree"})
    print("registered %s (branch %s) for %s" % (found[0], found[1], args.agent))
    return EXIT_OK


# ---------------------------------------------------------------- the orphan reaper (#321 slice S7)
#
# A process whose parent is launchd (pid 1) and whose command matches an EXACT allow-list, that this user owns and that has run longer than the grace
# (`orphan_reaper.grace_hours`, default 6), is an orphan of a finished test or agent: it is listed by `status` and by `disk reap-orphans`, and
# `disk reap-orphans --apply` sends it SIGTERM, then SIGKILL after a few seconds, each audited. A dry run is the default; the kill switch is
# `orphan_reaper.enabled: false`. Never pid 1, this process or its parent, never another user's process, never a process whose parent is not 1,
# never anything that names opencode, herdr, the switchboard or docker, never a command outside the allow-list. The process is read again and must
# be the same (pid, parent, owner, command) just before each signal, so a pid that was reused is not signalled.
ORPHAN_GRACE_HOURS = 6
ORPHAN_MAX_PER_RUN = 20
ORPHAN_TERM_WAIT_SECONDS = 5
ORPHAN_NEVER = ("opencode", "herdr", "fleet-switchboard", "docker", "launchd", "ssh", "gpg-agent", "tmux")
_PS_ROW = re.compile(r"^\s*(\d+)\s+(\d+)\s+(\d+)\s+(\S+)\s+(.*\S)\s*$")


def orphan_config(config):
    section = (config or {}).get("orphan_reaper") or {}
    grace = section.get("grace_hours", ORPHAN_GRACE_HOURS)
    return {"enabled": section.get("enabled", True) is not False, "grace_seconds": int(grace * 3600)}


def validate_orphan_config(config, source):
    raw = config.get("orphan_reaper")
    if raw is None:
        return
    ok = isinstance(raw, dict) and not set(raw) - {"enabled", "grace_hours"} and isinstance(raw.get("enabled", True), bool)
    grace = raw.get("grace_hours", ORPHAN_GRACE_HOURS) if isinstance(raw, dict) else None
    if not ok or isinstance(grace, bool) or not isinstance(grace, (int, float)) or not 0.5 <= grace <= 24 * 30:
        raise ConfigError("%s: 'orphan_reaper' must be {\"enabled\": true|false, \"grace_hours\": 0.5 to 720}, got %r" % (source, raw))


def _etime_seconds(text):
    """ps etime `[[dd-]hh:]mm:ss` in seconds, or None."""
    m = re.match(r"^(?:(\d+)-)?(?:(\d+):)?(\d+):(\d+)$", text or "")
    if not m:
        return None
    days, hours, minutes, seconds = (int(g or 0) for g in m.groups())
    return ((days * 24 + hours) * 60 + minutes) * 60 + seconds


def ps_table():
    """[(pid, ppid, uid, age seconds, command)] from one `ps`; [] when it cannot be run (nothing is then a candidate)."""
    try:
        done = subprocess.run(["ps", "-axo", "pid=,ppid=,uid=,etime=,command="], capture_output=True, text=True, timeout=20, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        return []
    rows = []
    for line in (done.stdout or "").splitlines():
        m = _PS_ROW.match(line)
        age = _etime_seconds(m.group(4)) if m else None
        if m and age is not None:
            rows.append((int(m.group(1)), int(m.group(2)), int(m.group(3)), age, m.group(5)))
    return rows


def _under(path, roots):
    real = os.path.realpath(path) + "/"
    return any(real.startswith(root) for root in roots)


def orphan_roots():
    """(temp roots, worktree roots): this user's own temp directory (`tempfile.gettempdir()`, not all of /tmp or /var/folders) and the fleet's worktrees."""
    temps = {os.path.realpath(tempfile.gettempdir()) + "/"}
    worktrees = {os.path.realpath(os.path.expanduser("~/Code/fleet-kit.wt")) + "/"}
    return temps, worktrees


def orphan_kind(command, roots=None):
    """The allow-list: `fake-agent` (a test double under a temp host-mctx directory), `node-test` (a `node --test` runner) or `python-helper` (a python
    script that lives in a worktree of the fleet or in a temp directory); None for anything else."""
    temps, worktrees = roots or orphan_roots()
    parts = command.split()
    if not parts or any(word in command.lower() for word in ORPHAN_NEVER):
        return None
    exe = os.path.basename(parts[0])
    args = parts[1:]
    if exe == "node":   # a test runner whose command line names a path in a fleet worktree or a temp directory (a bare `node --test` is not matched)
        paths = [a for a in args if os.path.isabs(a) and ".." not in a.split("/")]
        return "node-test" if "--test" in args and any(_under(a, worktrees | temps) for a in paths) else None
    if re.fullmatch(r"[Pp]ython[0-9.]*", exe):
        script = next((a for a in args if not a.startswith("-")), None)
        if script is None or not script.endswith(".py") or not os.path.isabs(script) or ".." in script.split("/"):
            return None
        if os.path.basename(script) == "fake-agent.py" and "host-mctx" in script and _under(script, temps):
            return "fake-agent"
        if _under(script, worktrees | temps):
            return "python-helper"
    return None


def orphan_reap_candidates(table=None, config=None, roots=None, me=None):
    """([(pid, kind, age, command)] past the grace, [same] still within it): processes of this user whose parent is pid 1 and that match the allow-list."""
    grace = orphan_config(config)["grace_seconds"]
    uid, mine = os.getuid(), me or {1, os.getpid(), os.getppid()}
    due, young = [], []
    for pid, ppid, owner, age, command in (table() if table else ps_table()):
        if pid in mine or ppid != 1 or owner != uid:
            continue
        kind = orphan_kind(command, roots)
        if kind is not None:
            (due if age >= grace else young).append((pid, kind, age, command))
    return due, young


def orphan_status_line(config, table=None):
    """`orphans 2: node-test 4242 (9 h), ...`, or None when there is none or the reaper is off."""
    if not orphan_config(config)["enabled"]:
        return None
    due, young = orphan_reap_candidates(table, config)
    if not due:
        return None
    shown = ", ".join("%s %d (%d h)" % (kind, pid, age // 3600) for pid, kind, age, _ in due[:5])
    return "%d: %s%s (past %d h: `disk reap-orphans --apply`)" % (len(due), shown, ", ..." if len(due) > 5 else "", orphan_config(config)["grace_seconds"] // 3600)


def reap_orphans(engine, apply, table=None, kill=None, sleep=None, roots=None, by=None):
    """Plan or do the reap: a dict with `due`, `young` and, applied, `results` [(pid, kind, outcome)]. Each signal is audited."""
    config = engine.config
    kill, sleep = kill or os.kill, sleep or time.sleep   # looked up at call time, so a test can replace them
    due, young = orphan_reap_candidates(table, config, roots)
    out = {"due": due, "young": young, "results": []}
    if not apply:
        return out
    if engine.audit is None:
        raise LaunchError("no audit log is open: nothing was signalled (every signal is audited first)")

    def same(pid, command, age):   # the pid still names the process judged: same parent, owner and command, and no younger (a reused pid restarts at 0)
        for row in (table() if table else ps_table()):
            if row[0] == pid:
                return row[1] == 1 and row[2] == os.getuid() and row[4] == command and row[3] >= age
        return False

    for pid, kind, age, command in due[:ORPHAN_MAX_PER_RUN]:
        detail = {"by": by, "pid": pid, "kind": kind, "age_hours": age // 3600, "command": _one_line(command, 160)}
        if not same(pid, command, age):
            out["results"].append((pid, kind, "changed: not signalled"))
            continue
        try:
            if engine.audit is not None:
                engine.audit.append(engine.actor, "orphan.term", str(pid), detail)
            kill(pid, signal.SIGTERM)
            for _ in range(ORPHAN_TERM_WAIT_SECONDS):
                sleep(1)
                if not same(pid, command, age):
                    break
            if same(pid, command, age):
                if engine.audit is not None:
                    engine.audit.append(engine.actor, "orphan.kill", str(pid), detail)
                kill(pid, signal.SIGKILL)
                out["results"].append((pid, kind, "killed"))
            else:
                out["results"].append((pid, kind, "terminated"))
        except ProcessLookupError:
            out["results"].append((pid, kind, "already gone"))
        except OSError as err:
            out["results"].append((pid, kind, "failed: %s" % _one_line(str(err), 80)))
    if len(due) > ORPHAN_MAX_PER_RUN:
        out["results"].append((0, "-", "%d of %d handled (cap %d): run it again" % (ORPHAN_MAX_PER_RUN, len(due), ORPHAN_MAX_PER_RUN)))
    return out


def cmd_disk_reap_orphans(args, runner, now):
    """`disk reap-orphans [--apply]`: list (the default) or signal the orphans past the grace. `--apply` is the operator's or the Chief of Staff's."""
    engine, state, config = build_engine(runner, now, "cli", writable=bool(args.apply))
    settings = orphan_config(config)
    if args.apply:
        kind = gates_caller_kind(runner, now)
        if not (kind[0] == "person" or (kind[0] == "agent" and len(kind) > 2 and kind[2] == "chief-of-staff")):
            raise LaunchError("refused: only the operator or the Chief of Staff may --apply an orphan reap (%s is %s)" % (kind[1], "an agent" if kind[0] == "agent" else "not known"))
        if not settings["enabled"]:
            raise LaunchError("the orphan reaper is switched off (orphan_reaper.enabled is false): nothing was signalled")
    result = reap_orphans(engine, bool(args.apply), by=identify_who(engine, runner, now) if args.apply else None)
    for pid, kind, age, command in result["due"]:
        print("  %s %d  %d h old  %s" % (kind, pid, age // 3600, _one_line(command, 100)))
    for pid, kind, outcome in result["results"]:
        print("  %s: %s" % (pid or "-", outcome) if kind == "-" else "  %d %s: %s" % (pid, kind, outcome))
    print("%s: %d orphan(s) past %d h%s; %d younger left alone%s" % (PROG, len(result["due"]), settings["grace_seconds"] // 3600,
          "" if args.apply else " (a dry run: add --apply)", len(result["young"]), "" if settings["enabled"] else "; the reaper is switched off"))
    return EXIT_ERROR if any(o.startswith(("failed", "changed")) for _, _, o in result["results"]) else EXIT_OK


def identify_who(engine, runner, now):
    kind = gates_caller_kind(runner, now)
    return "the operator" if kind[0] == "person" else str(kind[1])


BARE_SHELLS = ("sh", "bash", "zsh", "fish", "dash", "ksh", "tcsh", "csh")   # foreground processes of a pane that holds only a shell
BARE_PANES_FILE = "bare-panes.json"   # {pane: {"revision", "since"}}: when herdr's revision of a pane was first seen as it is now (a pane that shows nothing new is idle)
BARE_IDLE_DEFAULT_MINUTES = 10


def _within_any(path, roots):
    try:
        real = os.path.realpath(path)
    except (OSError, ValueError, TypeError):
        return False
    return any(real == r or real.startswith(r.rstrip("/") + "/") for r in roots)


def bare_pane_guards():
    """THE table of the guards `close-pane` applies, in order: (id, function(ctx) -> why not or None). The command loops over it and the tests are parametrised over it."""
    return BARE_PANE_GUARDS


def _guard_own_pane(ctx):
    return "pane %s is the one you are in: never closed by you" % ctx["pane"] if os.environ.get("HERDR_PANE_ID") == ctx["pane"] else None


def _guard_listed(ctx):
    return None if ctx["entry"] is not None else "pane %s is not listed by herdr: nothing to close" % ctx["pane"]


def _guard_unnamed(ctx):
    pane = ctx["pane"]
    if ctx["held"] or any(o.pane == pane for o in ctx["discovery"].agents.values()) \
            or any(isinstance(v, dict) and v.get("pane") == pane for v in ctx["health"]["agents"].values()):
        return "pane %s is named by an agent record: use `%s retire <name> --close` for its worker" % (pane, PROG)
    return None


def _guard_bare_shell(ctx):
    names = [str(p.get("name") or "").lstrip("-") for p in ctx["processes"]]
    if not names or any(n not in BARE_SHELLS for n in names):   # default deny: a pane that reports NO foreground process is not known to be a shell
        return "pane %s has a foreground job (%s), not a bare shell: nothing was closed" % (ctx["pane"], _one_line(", ".join(n or "?" for n in names), 60))
    return None


def _guard_worktree(ctx):
    entry = ctx["entry"] or {}
    cwds = [c for c in (entry.get("cwd"), entry.get("foreground_cwd")) if isinstance(c, str) and c]
    if not cwds or not all(_within_any(c, ctx["worktrees"]) for c in cwds):
        return "pane %s is not inside a fleet worktree (%s): never an owner's own shell" % (ctx["pane"], _one_line(", ".join(cwds) or "no cwd", 80))
    return None


def _guard_idle(ctx):
    seen, entry = ctx["seen"], ctx["entry"] or {}
    if seen is None or seen.get("revision") != entry.get("revision") or entry.get("revision") is None \
            or ctx["now"] - seen.get("since", ctx["now"]) < ctx["window"] * 60:
        return "pane %s has not been seen idle for %d minutes (its revision is noted%s; run it again after that long without activity): nothing was closed" % (
            ctx["pane"], ctx["window"], "" if not ctx.get("note_error") else ", BUT NOT WRITTEN: " + ctx["note_error"])
    return None


BARE_PANE_GUARDS = (("own-pane", _guard_own_pane), ("listed", _guard_listed), ("unnamed", _guard_unnamed), ("bare-shell", _guard_bare_shell),
                    ("worktree", _guard_worktree), ("idle", _guard_idle))


def bare_pane_context(engine, discovery, pane, now):
    """What the guards read, from fresh reads. HerdrError for a read that fails (the command refuses: unreadable means no close)."""
    entry = next((p for p in engine.herdr.pane_list() if isinstance(p, dict) and p.get("pane_id") == pane), None)
    held = [a for a in engine.herdr.agent_list() if isinstance(a, dict) and a.get("pane_id") == pane]
    processes = engine.herdr.pane_process_info(pane) if entry is not None else []
    health = registry_agents_strict(engine.state_dir)   # the registry, never pane-health.json: a pane an agent holds is its pane
    worktrees = {os.path.realpath(p) for p in read_worktrees(engine.state_dir)}   # the REGISTERED worktrees only: an agent's own cwd is often the repo root the owner works in too
    window = engine.config.get("retire_idle_minutes")
    window = window if retire_idle_window_ok(window) else BARE_IDLE_DEFAULT_MINUTES
    return {"pane": pane, "entry": entry, "held": held, "processes": processes, "discovery": discovery, "health": health, "worktrees": worktrees,
            "window": window, "now": now, "seen": (_read_small(engine.state_dir, BARE_PANES_FILE).get(pane) or None)}


def registry_agents_strict(state_dir):
    """The registry's agents for the close-pane guards: a read that is not whole raises HerdrError (refuse); a missing registry is no agents."""
    got = registry_read(state_dir)
    if not got["whole"]:
        raise HerdrError("unreadable", "the agent registry cannot be read: %s" % _one_line(str(got["problem"]), 120))
    return {"agents": got["agents"]}


def bare_pane_problem(engine, discovery, pane, now):
    """None when every guard of the table passes, else the first why not. Reads, except that the idle guard first notes the pane's revision in `bare-panes.json`
    (`note_bare_pane`); when that cannot be written the refusal says so."""
    try:
        ctx = bare_pane_context(engine, discovery, pane, now)
    except (HerdrError, OSError, ValueError) as err:
        return "pane %s cannot be read now (%s): nothing was closed" % (pane, _one_line(str(err), 100))
    for guard_id, guard in bare_pane_guards():
        if guard_id == "idle":   # only a pane that passed every other guard is remembered: a pane's idle time is how long herdr's revision of it stayed the same
            ctx["note_error"] = note_bare_pane(engine, pane)
            ctx["seen"] = _read_small(engine.state_dir, BARE_PANES_FILE).get(pane) or None
        why = guard(ctx)
        if why:
            return why
    return None


def note_bare_pane(engine, pane):
    """Remember the revision a pane shows and since when (kept while it does not change). None when noted, else a short reason it was not (the pane then
    stays 'not yet seen idle': the close is never made on a note that was not written)."""
    try:
        entry = next((p for p in engine.herdr.pane_list() if isinstance(p, dict) and p.get("pane_id") == pane), None)
        if entry is None or entry.get("revision") is None:
            return "herdr gives no revision for it"
        with agent_lock(engine.state_dir, "files"):
            data = _read_small(engine.state_dir, BARE_PANES_FILE)
            data = {k: v for k, v in data.items() if k == pane or k in {p.get("pane_id") for p in engine.herdr.pane_list() if isinstance(p, dict)}}
            if (data.get(pane) or {}).get("revision") != entry["revision"]:
                data[pane] = {"revision": entry["revision"], "since": int(engine.now())}
            _write_small(engine.state_dir, BARE_PANES_FILE, data)
        return None
    except Exception as err:
        return _one_line(str(err), 80)


def cmd_close_pane(args, runner, now):
    """`close-pane <pane-id>`: close a pane no record names (a bare shell). The Chief of Staff alone (its ROLE, from the fleet identity). The pane is judged
    again from a fresh read just before the close. Audited whether it closes or not."""
    engine, state, _ = build_engine(runner, now, "cli")
    pane = args.pane
    if not re.match(r"^[A-Za-z0-9:._-]{1,40}$", pane or ""):
        raise LaunchError("name the pane: `%s close-pane <pane-id>`" % PROG)
    kind = gates_caller_kind(runner, now)
    who = "the operator" if kind[0] == "person" else str(kind[1])
    if kind[0] != "agent" or len(kind) < 3 or kind[2] != "chief-of-staff":
        if engine.audit is not None:
            engine.audit.append(engine.actor, "fleetpane.close_refused", "pane:%s" % pane, {"pane": pane, "by": who, "cwd": None, "why": "only the Chief of Staff closes a pane no record names"})
        raise LaunchError("refused: only the Chief of Staff may close a pane no record names (%s)" % who)
    cwd = None
    try:
        cwd = next((p.get("cwd") for p in engine.herdr.pane_list() if isinstance(p, dict) and p.get("pane_id") == pane), None)
    except Exception:
        pass
    discovery = engine.discover(engine.now())
    problem = "the agent list cannot be read in full: nothing was closed" if discovery.problems else bare_pane_problem(engine, discovery, pane, engine.now())
    try:
        if problem is None:
            # The point of effect: under one lock (two close-panes cannot both act), the caller's role and EVERY guard are read again, then the close. Only
            # the instant between that last look and herdr's close remains (herdr has no close-if-unchanged), as for `retire --close`.
            with agent_lock(state, "close-pane"):
                again = gates_caller_kind(runner, now)
                if again[0] != "agent" or len(again) < 3 or again[2] != "chief-of-staff":
                    problem = "the caller is no longer established as the Chief of Staff"
                else:
                    fresh = engine.discover(engine.now())
                    problem = "the agent list cannot be read in full: nothing was closed" if fresh.problems else bare_pane_problem(engine, fresh, pane, engine.now())
                if problem is None:
                    with engine._external("herdr.pane.close", "pane:%s" % pane, {"pane": pane, "why": "close-pane"}):
                        engine.herdr.pane_close(pane)
    except Exception as err:
        if engine.audit is not None:
            engine.audit.append(engine.actor, "fleetpane.close_failed", "pane:%s" % pane, {"pane": pane, "by": who, "cwd": cwd, "why": _one_line(str(err), 120)})
        raise LaunchError("pane %s was not closed (%s)" % (pane, _one_line(str(err), 100))) from None
    if problem is not None:
        if engine.audit is not None:
            engine.audit.append(engine.actor, "fleetpane.close_refused", "pane:%s" % pane, {"pane": pane, "by": who, "cwd": cwd, "why": _one_line(problem, 160)})
        raise LaunchError("refused: %s" % problem)
    if engine.audit is not None:
        engine.audit.append(engine.actor, "fleetpane.closed", "pane:%s" % pane, {"pane": pane, "by": who, "cwd": cwd, "why": "no record names this pane (a bare shell in a fleet worktree, idle)"})
    print("closed pane %s (a bare shell no record names: its memory is released)" % pane)
    return EXIT_OK


def add_close_pane_parsers(sub):
    close = sub.add_parser("close-pane", help="Close a pane no record names (a bare shell, no agent): the Chief of Staff only; judged again just before the close")
    close.add_argument("pane", help="The herdr pane id")


def add_retire_parsers(sub):
    retire = sub.add_parser("retire", help="Mark a finished worker RETIRED (not watched, not reattached); `--undo` reverses. Nothing is deleted or closed")
    retire.add_argument("name", help="The agent's fleet name")
    retire.add_argument("--reason", help="Why (one line)")
    retire.add_argument("--undo", action="store_true", help="Watch it again")
    retire.add_argument("--close", action="store_true", help="Also close the agent's terminal pane (frees its memory): only its boss, the Chief of Staff for a direct report, or the operator; "
                                                             "the pane is read again and must still hold the agent's own session; never your own pane")
    retire.add_argument("--force", action="store_true", help="With --close: close a pane that is still working (refused for a worker with unpushed or uncommitted work in a registered worktree)")


def add_read_parsers(sub):
    read = sub.add_parser("read", help="The newest messages of an agent's session, oldest first (a cloud worker is read on its own endpoint)")
    read.add_argument("name", help="The agent's fleet name")
    read.add_argument("--limit", type=int, default=20, help="How many messages (default 20, at most 200)")


def cmd_read(args, runner, now):
    return run_cloud("cmd_read", args, runner, now)


def watch_problem(engine, state, name, discovery):
    """None when `watch` may open a terminal on `name`, else one line: the worker is unknown or retired, or a terminal already runs it (named)."""
    if name in registry_retired(state):
        return "%s is retired (a finished worker): nothing to watch" % name
    seen = discovery.agents.get(name)
    if seen is None:
        return "no fleet agent named %s is known: `%s status` lists the workers" % (name, PROG)
    if not seen.headless:
        return "%s already has a terminal (pane %s): switch to it, or `%s retire %s --close` first" % (name, seen.pane, PROG, name)
    return None


def cmd_watch(args, runner, now, socket_call=None):
    """`watch <name> [--workspace W]` (#433): open a terminal on a headless worker's EXISTING session. It creates no session and sends no prompt, so
    closing the terminal leaves the worker running. Refused (exit 1, nothing opened) for a worker that has a terminal, is unknown or is retired.
    The caller rule is `reattach`'s: the operator, the Chief of Staff or the worker's own boss."""
    engine, state, _ = build_engine(runner, now, "cli", socket_call=socket_call)
    name = args.name
    if not NAME_RE.match(name or ""):
        raise LaunchError("name the worker: `%s watch <name>`" % PROG)
    discovery = engine.discover(engine.now())
    if name in registry_retired(state):   # said first: a retired worker is not discovered, so the caller rule could only say "not your worker"
        raise LaunchError("refused: %s is retired (a finished worker): nothing to watch" % name)
    who = reattach_caller_problem(engine, runner, now, discovery, name)
    if who:
        if engine.audit is not None:
            engine.audit.append(engine.actor, "headless.watch_refused", name, {"why": _one_line(who, 160)})
        raise LaunchError("refused: %s" % who)
    try:
        with agent_lock(state, name):
            discovery = engine.discover(engine.now())   # read again under the lock: a terminal opened a moment ago is seen
            who = reattach_caller_problem(engine, runner, now, discovery, name)   # and the caller rule with it: check and act are one step
            if who:
                raise LaunchError("refused: %s" % who)
            why = watch_problem(engine, state, name, discovery)
            if why:
                if engine.audit is not None:
                    engine.audit.append(engine.actor, "headless.watch_refused", name, {"why": _one_line(why, 160)})
                raise LaunchError("refused: %s" % why)
            seen = discovery.agents[name]
            workspace = args.workspace or os.environ.get("HERDR_WORKSPACE_ID")
            if not workspace:
                raise LaunchError("no workspace to open the terminal in: pass --workspace (or run it from a herdr pane)")
            done = resume_agent(engine, name, seen.session_id, workspace)
            if engine.audit is not None:
                engine.audit.append(engine.actor, "headless.watched", name, {"session": seen.session_id, "pane": done["pane"], "tab": done.get("tab")})
    except ImpactStateBusy:
        raise LaunchError("another watch or reattach of %s is running: wait for it" % name) from None
    print(json.dumps(done, sort_keys=True))
    return EXIT_OK


def add_watch_parsers(sub):
    watch = sub.add_parser("watch", help="Open a terminal on a headless worker's existing session; closing it leaves the worker running")
    watch.add_argument("name", help="The headless worker's fleet name")
    watch.add_argument("--workspace", help="The herdr workspace for the new tab (default: this pane's)")


def add_reattach_parsers(sub):
    reattach = sub.add_parser("reattach", help="Put a detached or dead agent back in a pane on its existing session (no prompt is sent)")
    reattach.add_argument("name", nargs="?", help="The agent's fleet name")
    reattach.add_argument("--all-detached", action="store_true", dest="all_detached", help="Every agent the daemon found detached or dead")
    reattach.add_argument("--replace", action="store_true", help="Also replace a pane that runs the agent but with the wrong account or repo (same guards: not working, alone in its tab)")
    reattach.add_argument("--session", help="Its OpenCode session id (default: the one the switchboard last saw)")
    reattach.add_argument("--workspace", help="The herdr workspace for the new tab (default: where it last ran)")
    reattach.add_argument("--repo", help="Refused when it differs from the session's stored repo (a reattach keeps the stored identity)")


# ======================================================================
# PR 8: foreground and background
#
# One section, so the stack rebases cleanly. docs/switchboard.md,
# "Foreground and background". Registered in these places, one line each:
#   DEFAULTS            `classifier_mode` (below), checked by validate_foreground_config
#   validate_config     calls validate_foreground_config
#   fact_sources        adds ForegroundFacts
#   shadow_classify     enriches asks with their Intent (ask_intent) and hands
#                       an acting classification to note_decision
#   run_shadow_classifier  also runs when classifier_mode is "act"
#   build_parser, main  the `handoff` command
# The decoration is a fact like any other: it is delivered by the one delivery
# path, as a note, and the key in the transcript is what stops a repeat.
# ======================================================================

FOREGROUND_DEFAULTS = {
    # "shadow": the classifier only logs (PR 7). "act": it also decorates the
    # Chief of Staff's message, and tells it to hand off. SF1/SF2 decide when.
    "classifier_mode": "shadow",
    # Seconds between passes while a Chief of Staff is busy: your message is
    # consumed at its next step boundary (SF1), so the decoration must beat it.
    "busy_poll_seconds": 1,
}
DEFAULTS.update(FOREGROUND_DEFAULTS)
CLASSIFIER_MODES = ("shadow", "act")
DECORATION = "foreground.decoration"
COS_SUBAGENT = "cos-subagent"
SUBAGENT_AGENT = "cos-subagent"  # the OpenCode agent definition a background subagent runs
DECORATION_INTENT_LIMIT = 160    # characters of an Intent inside a decoration


def validate_foreground_config(config, source):
    mode = config["classifier_mode"]
    if mode not in CLASSIFIER_MODES:
        raise ConfigError("%s: 'classifier_mode' must be one of %s, got %r" % (source, ", ".join(CLASSIFIER_MODES), mode))
    busy = config["busy_poll_seconds"]
    if not _is_number(busy) or busy <= 0:
        raise ConfigError("%s: 'busy_poll_seconds' must be a positive number, got %r" % (source, busy))
    if mode == "act" and not config.get("jev"):
        raise ConfigError("%s: 'classifier_mode' \"act\" needs a 'jev' object: there is no decision model to ask" % source)


def chiefs_of_staff(discovery):
    """The names of the Chief of Staff agents in a discovery, by the fleet metadata role (never by a name in configuration); none when discovery has problems."""
    if discovery is None or discovery.problems:
        return []
    return sorted(n for n, o in discovery.agents.items() if (getattr(o, "fleet", None) or {}).get("role") == "chief-of-staff")


def chief_busy(engine):
    """True when the newest look found a chief-of-staff-role agent working: the daemon then polls fast."""
    found = getattr(engine, "discovery", None)
    return bool(found) and any(o.fleet.get("role") == "chief-of-staff" and o.status == "working"
                               for o in found.agents.values())


def next_poll(engine, poll):
    """Seconds to wait before the next pass: `busy_poll_seconds` while a Chief of Staff works (only
    when acting: shadow mode has no deadline), else `poll`."""
    if acting(engine) and chief_busy(engine):
        return min(poll, engine.config["busy_poll_seconds"])
    return poll


def inbox_human_prompts(engine, session_id, fresh=False):
    """Your steered prompts still waiting in v2's inbox (SF1: there within ~0.1 s, consumed at the
    next step boundary), as message-like records, newest first. Not yet seen by the model."""
    if getattr(engine, "light", False) and not fresh:
        return []   # v2_light: only the read just before a write (the engagement gate) is made
    inbox = engine.v2.inbox_list(session_id)
    found = []
    for item in inbox if isinstance(inbox, list) else []:
        payload = item.get("payload") if isinstance(item, dict) and isinstance(item.get("payload"), dict) else {}
        if isinstance(item, dict) and item.get("type") == "user" and _fleet_meta(item) is None \
                and isinstance(payload.get("text"), str):
            found.append({"id": item.get("id"), "type": "user", "text": payload["text"], "time": item.get("time"),
                          "pending": True})
    return sorted(found, key=lambda m: _created(m) or 0, reverse=True)


def newest_prompts(engine, session_id):
    """Your prompts to a Chief of Staff, newest first: the inbox's (not yet consumed), then the transcript's."""
    return inbox_human_prompts(engine, session_id) + engine.reads.human_prompts_newest(session_id)   # small reads of the newest user messages, not a 200-message page


def acting(engine):
    """True when the classifier's answers are acted on, not only logged."""
    return engine.config.get("classifier_mode") == "act" and engine.jev is not None


# ---- the asks, with their Intent

def ask_intent(engine, ask):
    """`ask` with its Intent and Done-when read from GitHub (IntentReader, cached).

    Unchanged when no reader is configured or GitHub cannot answer: a
    classification must not wait on, or fail for, an unreachable GitHub.
    """
    if not ask or engine.intents is None:
        return ask
    try:
        issue = engine.intents.issue(ask["issue"], ask.get("repo"))
    except IntentError:
        return ask
    return dict(ask, intent=issue.intent or ask.get("intent") or "", done_when=issue.done_when)


def ask_intents(engine, asks):
    return [ask_intent(engine, ask) for ask in asks]


# ---- the decoration's words (docs/switchboard.md, "Decorate" and "Hand off")

def owned_ask_text(ask):
    """The decoration for a message about an ask somebody else owns. The doc's own wording."""
    where = ""
    if ask.get("intent"):
        where = " (Intent: %s)" % _one_line(ask["intent"], DECORATION_INTENT_LIMIT)
    owner = ask.get("owner") or "its owner"
    return ("This is about ask %s%s. %s is working on it in the background. Send it anything relevant "
            "with: fleet-switchboard send %s --issue %s \"...\". Then continue with what you were doing."
            % (ask["issue"], where, owner, owner, ask["issue"]))


def handoff_text(current):
    """The decoration for something new while the Chief of Staff is busy."""
    ask = current or {}
    number = ask.get("issue") or "<the ask of your current work>"
    doing = ""
    if ask.get("intent"):
        doing = " (ask %s: %s)" % (ask["issue"], _one_line(ask["intent"], DECORATION_INTENT_LIMIT))
    return ("This is not about what you are working on%s, and you are busy with it. Hand it off first: write a short "
            "brief with Done so far, Next steps and Watch out for, and run: fleet-switchboard handoff --issue %s "
            "--brief-file -. A background subagent takes it over; then turn to this message."
            % (doing, number))


def decoration_for(choice, observation, current, asks):
    """(kind, ask, text) for the classification's answer, or None when nothing is added.

    current: nothing. An ask somebody owns: name it and its owner. Something
    new: hand off first when the Chief of Staff is busy, nothing when idle.
    """
    if choice == "current":
        return None
    if choice == "new":
        if observation.status != "working":
            return None
        return "handoff", current, handoff_text(current)
    ask = next((a for a in asks if str(a["issue"]) == choice), None)
    return ("owned", ask, owned_ask_text(ask)) if ask else None


# ---- the decoration as a fact

class ForegroundFacts:
    """`foreground.decoration:` facts for a Chief of Staff, derived on every call.

    The only memory is the classifier's answers, by message id, in this
    process; a restart classifies the newest message once more, and the key
    already in the transcript stops a second delivery (invariant 2). Nothing is
    stored on disk. A decoration holds only while it is true: the message is
    still your newest, still inside the engagement window, and (to hand off)
    the Chief of Staff is still busy.
    """

    __name__ = "foreground_facts"

    def __init__(self):
        self.engine = None
        self.decisions = {}  # session id -> the newest decision for it

    def bind(self, engine):
        self.engine = engine

    def record(self, observation, message, kind, ask, text):
        self.decisions[observation.session_id] = {
            "cos": observation.name, "session": observation.session_id, "message": message["id"],
            "created": _created(message), "kind": kind, "ask": ask, "text": text}

    def __call__(self):
        engine = self.engine
        discovery = getattr(engine, "discovery", None)
        if engine is None or discovery is None or not self.decisions:
            return []
        now, facts = engine.now(), []
        for session, decision in sorted(self.decisions.items()):
            if decision["created"] is None or now - decision["created"] > engine.engaged_seconds:
                del self.decisions[session]  # old news; a decoration is only for your newest message
                continue
            fact = self.fact(decision, discovery)
            if fact is not None:
                facts.append(fact)
        return facts

    def fact(self, decision, discovery):
        observation = discovery.agents.get(decision["cos"])
        if observation is None or observation.problem or observation.conflict \
                or observation.session_id != decision["session"]:
            return None
        if decision["kind"] == "handoff" and observation.status != "working":
            return None  # it has finished what it was doing: nothing left to hand off
        if not self.is_newest(decision):
            return None
        ask = decision["ask"] or {}
        issue = ask.get("issue") if decision["kind"] == "owned" else None
        return Fact("decoration:%s:%s" % (decision["session"], decision["message"]), decision["cos"], DECORATION,
                    decision["text"], decision["created"], issue=issue if _is_issue_number(issue) else None,
                    batch=False)

    def is_newest(self, decision):
        prompts = newest_prompts(self.engine, decision["session"])
        return bool(prompts) and prompts[0].get("id") == decision["message"]


def foreground_source(engine):
    return next((s for s in engine.sources if isinstance(s, ForegroundFacts)), None)


def note_decision(engine, observation, message, current, asks, answer):
    """An acting classification becomes a decoration, kept for the fact source. Audited either way."""
    found = decoration_for(answer["choice"], observation, current, asks)
    source = foreground_source(engine)
    detail = {"agent": observation.name, "message_id": message.get("id"), "choice": answer["choice"],
              "decoration": found[0] if found else None, "owner": (found[1] or {}).get("owner") if found else None}
    if found and source is None:
        detail["problem"] = "no foreground fact source is registered, so nothing can be delivered"
        found = None
    engine.audit.append(engine.actor, "foreground.decision", "decision:%s:%s" % (observation.session_id, message.get("id")),
                        detail)
    if found:
        source.record(observation, message, *found)
        if not message.get("pending"):  # the model already took your message: the decoration cannot ride with it
            engine.audit.append(engine.actor, "foreground.late", "decision:%s:%s" % (observation.session_id, message.get("id")),
                                {"agent": observation.name, "message_id": message.get("id"),
                                 "decoration": found[0], "age_seconds": round(engine.now() - (_created(message) or 0), 2)})


# ---- handoff: a brief, not a fork

class HandoffRefused(Exception):
    """A handoff that was refused before anything was written."""


BRIEF_LIMIT = 20000  # characters; a GitHub comment holds 65536
BRIEF_LABELS = ("goal", "done so far", "next steps", "watch out for")
_BRIEF_INLINE = re.compile(r"^\s{0,3}(?:#{1,6}\s+)?(?:[-*]\s+)?\**(%s)\**\s*:\**\s*(.*?)\s*$"
                           % "|".join(BRIEF_LABELS), re.IGNORECASE)
_BRIEF_HEADING = re.compile(r"^\s{0,3}#{1,6}\s+(%s)\s*#*\s*$" % "|".join(BRIEF_LABELS), re.IGNORECASE)
_BRIEF_TITLE = re.compile(r"^\s{0,3}#{1,6}\s+handoff\b", re.IGNORECASE)


def parse_brief(text):
    """{label: text} from a Chief of Staff's brief: sections named `Done so far:`, `Next steps:`,
    `Watch out for:` (and a `Goal:`, which the switchboard replaces). Anything else is refused,
    so no written word is silently dropped. Raises HandoffRefused."""
    if len(text) > BRIEF_LIMIT:
        raise HandoffRefused("the brief is %d characters; the limit is %d: say less, link more" % (len(text), BRIEF_LIMIT))
    sections, label, stray = {}, None, []
    for line in text.splitlines():
        found = _BRIEF_INLINE.match(line) or _BRIEF_HEADING.match(line)
        if found:
            label = found.group(1).lower()
            sections[label] = [found.group(2)] if found.lastindex == 2 and found.group(2) else []
        elif label is not None:
            sections[label].append(line)
        elif line.strip() and not _BRIEF_TITLE.match(line):
            stray.append(line.strip())
    if stray:
        raise HandoffRefused("the brief has text outside its sections (%s): put it under Done so far, Next steps "
                             "or Watch out for" % _one_line(stray[0], 80))
    parsed = {name: "\n".join(lines).strip() for name, lines in sections.items()}
    missing = [name.capitalize() for name in ("done so far", "next steps") if not parsed.get(name)]
    if missing:
        raise HandoffRefused("the brief has no %s: a subagent cannot continue from a brief without them"
                             % " and no ".join(missing))
    return parsed


def goal_line(issue):
    """Goal, from the ask's own Intent and Done-when: never retyped by the Chief of Staff."""
    line = issue.intent or NO_INTENT
    return "%s (Done when: %s)" % (line, issue.done_when) if issue.done_when else line


def handoff_markdown(issue, parsed):
    """The doc's handoff markdown for ask `issue` (an IssueIntent) and a parsed brief."""
    lines = ["## Handoff: ask %d" % issue.number, "Goal: %s" % goal_line(issue),
             "Done so far: %s" % parsed["done so far"], "Next steps: %s" % parsed["next steps"],
             "Watch out for: %s" % (parsed.get("watch out for") or "nothing noted")]
    return "\n".join(lines)


def post_ask_comment(engine, issue, body, author=None, repo=None):
    """Comment on the ask through the configured `gh`. The GitHub writes the switchboard makes: the handoff
    brief, so the record survives (docs: Hand off), and an agent's own comment (`comment`). Signed with
    the author's name when there is one, so it is never delivered back as an event. Audited before and after."""
    reader = engine.intents
    if author:
        body = body.rstrip("\n") + "\n\n" + fleet_mark(author)
    repo = repo or reader.repo
    path = "repos/%s/issues/%d/comments" % (repo, issue)
    subject = "issue:%d" % issue if repo == reader.repo else "issue:%s#%d" % (repo, issue)
    with engine._external("github.comment", subject, {"repo": repo, "issue": int(issue), "chars": len(body)}) as result:
        env = reader.env_for(repo)
        try:
            done = reader.runner([reader.gh, "api", path, "--method", "POST", "--input", "-"],
                                 input=json.dumps({"body": body}), capture_output=True, text=True,
                                 timeout=reader.timeout, **({"env": env} if env is not None else {}))
        except subprocess.TimeoutExpired:
            raise IntentError("unavailable", "gh did not answer within %ss" % reader.timeout) from None
        except OSError as err:
            raise IntentError("unavailable", "cannot run %s: %s" % (reader.gh, err.strerror or err)) from None
        if done.returncode != 0:
            detail = _one_line(done.stderr) or _one_line(done.stdout) or "exit %d" % done.returncode
            raise IntentError("gh", reader.accounts.scrub(detail) if reader.accounts else detail)
        try:
            posted = json.loads(done.stdout)
        except ValueError:
            posted = {}
        url = posted.get("html_url") if isinstance(posted, dict) else None
        result["url"] = url if isinstance(url, str) else None
    return result["url"]


def handoff_refusals(engine, issue, name, directory, workspace, agent, repo=None):
    """Why nothing may be written, found before anything is: the ask, the agent's name and place.
    Returns the ask (an IssueIntent)."""
    if engine.intents is None:
        raise HandoffRefused("'intent_repo' is not configured: a handoff fills Goal from the ask and posts "
                             "the brief on it")
    ask = engine.intents.issue(issue, repo)
    if ask.charter:
        raise HandoffRefused("#%d is a charter, not an ask: hand off an ask under it" % issue)
    if ask.state != "open":
        raise HandoffRefused("ask #%d is %s: there is nothing to hand off" % (issue, ask.state or "not open"))
    problems = launch_problems(name, agent, directory, workspace, issue)
    if problems:
        raise HandoffRefused("; ".join(problems))
    taken = engine.discover(engine.now()).agents.get(name)
    if taken is not None:
        raise HandoffRefused("a fleet agent named %s already runs in pane %s: send it what is new with "
                             "fleet-switchboard send %s --issue %d" % (name, taken.pane, name, issue))
    return ask


def subagent_prompt(caller, issue, markdown):
    return ("%s\n\nYou are a background subagent for %s. Report with: fleet-switchboard send %s --issue %d \"...\" "
            "when you reach the ask's Done when, or when you are stuck." % (markdown, caller, caller, issue))


def handoff_ask(engine, caller, issue, brief, name=None, directory=None, workspace=None, agent=SUBAGENT_AGENT,
                patience=LAUNCH_PATIENCE, sleep=time.sleep, repo=None):
    """The Chief of Staff's handoff: check, post the brief on the ask, launch the subagent. Returns a dict.

    Everything that can be refused is refused before the comment is posted.
    A launch that fails after the comment says so: the record stands.
    """
    explicit = issue_repo(issue)
    repo = repo or explicit
    issue = int(issue)
    # The subagent's own metadata names a repo only when the caller did, or when several repos are in play:
    # with one repo its metadata is what it always was.
    record = explicit or (repo if len(engine.repos_in_play()) > 1 else None)
    name = name or "cos-%d" % issue
    parsed = parse_brief(brief)
    ask = handoff_refusals(engine, issue, name, directory, workspace, agent, repo)
    markdown = handoff_markdown(ask, parsed)
    url = post_ask_comment(engine, issue, markdown, author=caller, repo=repo)
    try:
        done = launch_agent(engine, name, agent, directory, workspace, COS_SUBAGENT, caller, issue,
                            subagent_prompt(caller, issue, markdown), patience, sleep, repo=record)
    except LaunchError as err:
        raise LaunchError("the brief was posted on ask #%d, but the subagent did not start: %s" % (issue, err)) from err
    return dict(done, issue=issue, reports_to=caller, role=COS_SUBAGENT, comment=url,
                replaced_goal="goal" in parsed)


def cmd_handoff(args, runner, now, socket_call=None):
    brief = read_brief(args.brief_file, sys.stdin)
    engine, _, _ = build_engine(runner, now, "cli", socket_call=socket_call)
    workspace = caller_workspace(engine, args.workspace)
    caller = identify_caller(engine.herdr, engine.v2, os.environ)
    try:
        repo, number = resolve_for_sender(engine, engine.config, args.issue, caller)
        done = handoff_ask(engine, caller, RepoIssue(number, issue_repo(args.issue)), brief, args.name,
                           args.dir or os.getcwd(), workspace, repo=repo)
    except (HandoffRefused, IssueRefError) as err:
        sys.stderr.write("%s: handoff refused: %s\n" % (PROG, err))
        return EXIT_USAGE
    if done.pop("replaced_goal"):
        sys.stderr.write("%s: the Goal line in your brief was replaced by the ask's own Intent and Done when\n" % PROG)
    print(json.dumps(done, sort_keys=True))
    return EXIT_OK


cmd_handoff.ensure_on_use = True   # the daemon is alive when it runs


def cmd_comment(args, runner, now):
    """Post a comment as the calling agent, signed so the switchboard does not deliver it back."""
    engine, _, config = build_engine(runner, now, "cli")
    if engine.intents is None:
        raise ConfigError("'intent_repo' is not configured in %s: set it to OWNER/REPO" % config_path())
    body = read_brief(args.body_file, sys.stdin)
    if body is None:
        raise IntentError("usage", "--body-file is required (a file, or - for stdin)")
    caller = identify_caller(engine.herdr, engine.v2, os.environ)
    try:
        repo, number = resolve_for_sender(engine, config, args.issue, caller)
    except IssueRefError as err:
        sys.stderr.write("%s: %s\n" % (PROG, err))
        return EXIT_USAGE
    url = post_ask_comment(engine, number, body, author=caller, repo=repo)
    print(json.dumps({"issue": number, "author": caller, "comment": url}, sort_keys=True))
    return EXIT_OK


cmd_comment.ensure_on_use = True   # the daemon is alive when it runs


def cmd_whoami(args, runner, now):
    """The calling agent's fleet name: what the `gh` shim signs a comment with. Exit 1, silent on stdout,
    when the caller is not a fleet agent."""
    engine, _, config = build_engine(runner, now, "cli", writable=False)
    if getattr(args, "json", False):
        fleet = caller_fleet(engine.herdr, engine.v2, os.environ)
        repo = fleet.get("repo") if isinstance(fleet.get("repo"), str) else None
        own = repo or _fleet_repo(fleet, config)
        # `own` is false when the repo is only the config's `intent_repo` default: an agent with no repo of its own (the Chief of Staff) has no account of
        # its own to keep, so the gh shim may use the account of the repo a command names
        who = {"name": fleet["name"], "repo": own or config.get("intent_repo") or None, "own": bool(own), "role": fleet.get("role") if isinstance(fleet.get("role"), str) else None}   # the RECORDED role: the gh shim gives only the Chief of Staff the named repository's App token
        if "read_repo" in fleet:   # #618: only a worker launched with --read-repo has the key, so every other answer is as it was; one that cannot be read says so (the shim refuses)
            who["read_repo"] = fleet["read_repo"] if isinstance(fleet["read_repo"], str) and GhAccounts.normal_repo(fleet["read_repo"]) == fleet["read_repo"] \
                and re.fullmatch(r"[a-z0-9_.-]+/[a-z0-9_.-]+", fleet["read_repo"]) else False
        print(json.dumps(who, sort_keys=True))
        return EXIT_OK
    if getattr(args, "repo", False):
        fleet = caller_fleet(engine.herdr, engine.v2, os.environ)
        repo = fleet.get("repo") if isinstance(fleet.get("repo"), str) else None
        print(repo or _fleet_repo(fleet, config) or config.get("intent_repo") or "")
        return EXIT_OK
    print(identify_caller(engine.herdr, engine.v2, os.environ))
    return EXIT_OK


def add_foreground_parsers(sub):
    whoami = sub.add_parser("whoami", help="Print your fleet name (for scripts: the gh shim signs with it)")
    whoami.add_argument("--json", action="store_true", help="Print {\"name\", \"repo\"} on one line: the gh shim's single "
                        "lookup (name for the signature, repo for the account)")
    whoami.add_argument("--repo", action="store_true", help="Print the repo of your resolved identity "
                                       "(for the gh shim, which picks the account from it); empty when it has none")
    comment = sub.add_parser("comment", help="Comment on an issue as yourself, signed so it does not come back to "
                                             "you as an event")
    comment.add_argument("--issue", type=issue_arg, required=True, help="The issue to comment on")
    comment.add_argument("--body-file", dest="body_file", required=True, help="The comment: a file, or - for stdin")
    handoff = sub.add_parser("handoff", help="Hand your current work to a background subagent: post the brief on "
                                             "the ask and launch it, without typing")
    handoff.add_argument("--issue", type=issue_arg, required=True, help="The ask being handed off")
    handoff.add_argument("--brief-file", dest="brief_file", required=True,
                         help="The brief (Done so far, Next steps, Watch out for): a file, or - for stdin")
    handoff.add_argument("--name", help="The subagent's fleet name (default: cos-<issue>)")
    handoff.add_argument("--dir", help="The subagent's working directory (default: here)")
    handoff.add_argument("--workspace", help="The herdr workspace for its tab (default: the workspace of this session, else $HERDR_WORKSPACE_ID)")


# ======================================================================
# Worker events, reminders and toasts (PR 4)
#
# Two fact sources, registered in fact_sources(): WorkerFacts derives "a worker
# finished" and "a worker is blocked" from herdr and v2 on every pass, and
# ReminderFacts turns the reminders file into facts once they are due. Neither
# stores anything about delivery. The only new state is reminders.json.
# Hooks into the engine: Switchboard.__init__ binds each source that has a
# `bind`, discover() keeps the newest Discovery, deliver() calls
# note_unreachable, render's toast candidates include source_toasts(), and
# run_pass() ends with finish_pass.
# ======================================================================

WORKER_IDLE = "worker.idle"
WORKER_BLOCKED = "worker.blocked"
WORKER_STOPPED = "worker.stopped"  # PR 13: a worker stopped without reporting and the boss must know
NUDGE = "nudge"                    # PR 13: the one reminder to a worker that stopped without reporting
REPORT = "report"
REPORT_ATTENTION = ("done", "failed", "blocked", "question")  # wake the boss when it is not engaged
REPORT_PROGRESS = ("working", "paused", "withdrawn")          # riders: carried, never the reason for a message
REPORT_STATES = REPORT_ATTENTION + REPORT_PROGRESS
WITHDRAW_ALL = decision_core.WITHDRAW_ALL  # leads a `withdrawn` report made with --all: it clears every open question of the worker
STALLED_LIST_MAX_AGE = 1200   # #811: seconds; an open-PR list read longer ago than this is not judged (the pass re-reads it every few minutes)
STALLED_RUNNING_CHECKS = ("in_progress", "queued", "pending", "waiting", "requested", "expected")   # #811: a check word that is not finished


def _stalled_age(seconds):
    hours = seconds / 3600.0
    return "%dm" % (seconds // 60) if hours < 1 else "%.1fh" % hours


class _Unread(Exception):
    """A guard's input could not be read: the predicate answers "unread" and the caller says nothing."""


def _guard_last_report(w):
    if isinstance(w.last, dict) and w.last.get("state") in ("blocked", "question"):
        return ["its last report is %s" % w.last["state"]]
    return []


def _label_names(labels):
    return {(l.get("name") if isinstance(l, dict) else l) for l in (labels or [])}


def _guard_awaiting_issue(w):
    return ["an awaiting label on the issue" if r["number"] == w.issue else "an awaiting label on #%d" % r["number"]
            for r in w.issues if _label_names(r.get("labels")) & w.awaiting]


def _guard_awaiting_pr(w):
    return ["an awaiting label on pull request #%d" % r["number"] for r in w.mine
            if _label_names(r.get("labels")) & w.awaiting]


def _guard_ci(w):
    found = []
    for r in w.mine:
        number, head = r["number"], (r.get("head") or {}).get("sha") if isinstance(r.get("head"), dict) else None
        held = (getattr(w.state, "pr_state", None) or {}).get("%s#%d" % (w.key, number)) or {}
        if held.get("head") == head and held.get("examined_head") == head and any(
                isinstance(c, dict) and str(c.get("conclusion") or "").lower() in STALLED_RUNNING_CHECKS for c in (held.get("checks") or [])):
            found.append("CI is running at the head of #%d" % number)
    return found


def _guard_review_requested(w):
    return ["a review is requested on #%d" % r["number"] for r in w.mine if not r.get("draft") and (r.get("requested_reviewers") or r.get("requested_teams"))]


def _guard_review_window(w):
    found = []
    for r in w.mine:
        if r.get("draft") or r.get("requested_reviewers") or r.get("requested_teams"):
            continue   # a draft awaits no review; a requested one is the guard above
        created = parse_iso(r.get("created_at"))
        if created is None:
            raise _Unread()   # the age of the pull request cannot be told: fails toward saying nothing
        if w.now - created < w.window:
            found.append("#%d is younger than the review window" % r["number"])
    return found


def _guard_reminder(w):
    try:
        reminders = read_reminders(w.engine.state_dir)
    except ReminderError:
        raise _Unread() from None   # an unreadable file, or a reminder with no readable time (read_reminders refuses it): fails toward saying nothing
    for reminder in reminders:
        if (reminder.get("to") == w.observation.name and _is_issue_number(reminder.get("issue")) and reminder["issue"] in w.numbers and reminder["at"] > w.now
                and "while_running" not in (reminder.get("condition") or {})):   # the checkpoint `launch` sets is the boss's, not the worker waiting
            return ["it set a reminder for later"]
    return []


def _guard_decision(w):
    body = read_decisions_file(w.engine.state_dir / DECISIONS_FILE)
    if body is None:
        raise _Unread()
    refs = {(w.key, n) for n in w.numbers} | {(w.key, r["number"]) for r in w.mine}
    for d in body["decisions"]:
        if not isinstance(d, dict):
            continue
        ref = sweep_ref_of(d, w.repo)
        if d.get("tier", "human") == "human" and ref and (plan_ledger.normal_repo(ref[0]), ref[1]) in refs:
            return ["a decision waits on the owner"]
    return []


def _owned_issue(ctx):
    return [r for r in ctx.records if isinstance(r, dict) and r.get("number") == ctx.issue and "pull_request" not in r][:1]


def _owned_work_items(ctx):
    """The issues below the assignment through the parent links of the issue list: a visited set and a depth bound make a cycle end the walk."""
    plain = [r for r in ctx.records if isinstance(r, dict) and isinstance(r.get("number"), int) and "pull_request" not in r]
    found, seen, frontier = [], {ctx.issue}, {ctx.issue}
    for _ in range(TRIAGE_ANCESTOR_DEPTH):   # the one bound on parent links (defined with the triage walk below; read at call time)
        nxt = set()
        for r in plain:
            parent, url = parent_of(r), r.get("parent_issue_url")
            if r["number"] in seen or parent not in frontier or (isinstance(url, str) and not re.search(r"/repos/%s/issues/" % re.escape(ctx.key), url, re.I)):
                continue   # another repository's parent is not this assignment's
            found.append(r)
            seen.add(r["number"])
            nxt.add(r["number"])
        frontier = nxt
        if not frontier:
            break
    return found


def _owned_pulls(ctx):
    return [r for r in ctx.pulls if isinstance(r, dict) and isinstance(r.get("number"), int) and any(
        isinstance(ref, list) and ref[1] in ctx.numbers and plan_ledger.normal_repo(ref[0] or ctx.repo) == ctx.key for ref in pr_body_refs(r.get("body")))]


# #874: THE table of what a worker owns: kind -> (where the daemon already holds it, the builder). `worker_owned` LOOPS OVER it in this order (a
# later kind may read the numbers of the earlier ones), so a kind cannot exist in code and not here; the tests are parametrised over it.
OWNED_KINDS = {
    "issue": ("the assignment's issue, from the triage issue list", _owned_issue),
    "work item": ("its sub-issues at any depth (bounded, cycle-safe), from the same list's parent links", _owned_work_items),
    "pull request": ("every open pull request whose strict references (pr_body_refs) name the assignment or a work item, any base branch, from the open-pull-request list", _owned_pulls),
}


def worker_owned(records, pulls, issue, repo):
    """#874: THE one function that says what a worker owns, from lists the daemon already holds (no read): `issues` (the assignment first, then its
    work items), `pulls` (every open pull request naming any of them through a strict reference, whatever its base branch) and `numbers`. None when
    the assignment is not in the list (not judged). The caller has already checked that the lists were read whole."""
    ctx = types.SimpleNamespace(records=records, pulls=pulls, issue=issue, repo=repo, key=plan_ledger.normal_repo(repo), numbers=set())
    found = {}
    for kind, (_, build) in OWNED_KINDS.items():
        found[kind] = build(ctx)
        if kind != "pull request":
            ctx.numbers |= {r["number"] for r in found[kind]}
        if kind == "issue" and not found[kind]:
            return None
    return types.SimpleNamespace(issues=found["issue"] + found["work item"], numbers=ctx.numbers, pulls=found["pull request"])


def _readable_time(r):
    return parse_iso(r.get("updated_at")) is not None


def _readable_head(r):
    head = r.get("head")
    return isinstance(head, dict) and isinstance(head.get("sha"), str) and bool(head["sha"])


# #874: THE table of what must be readable on what a worker owns before a rule may judge it: member -> (which owned items, the check). `owned_readable`
# LOOPS OVER it, so a member cannot be checked in code and not here; the tests are parametrised over it, each member in each position of the list.
OWNED_READABLE = {
    "assignment time": (lambda owned: owned.issues[:1], _readable_time),
    "work item time": (lambda owned: owned.issues[1:], _readable_time),
    "pull request head": (lambda owned: owned.pulls, _readable_head),
    "pull request time": (lambda owned: owned.pulls, _readable_time),
}


def owned_readable(owned):
    """True when every member of OWNED_READABLE reads on every owned item it covers (default-deny: one bad item anywhere is not readable)."""
    return all(check(r) for select, check in OWNED_READABLE.values() for r in select(owned))


# #874: every consumer of `worker_owned` and what it takes from the set. The two rules and every row of WAITING_GUARDS; a completeness test fails when
# one is added to the code without a row here.
WORKER_OWNED_CONSUMERS = {
    "stalled-working": "the newest movement of every owned issue and pull request, and the head of each owned pull request",
    "idle-at-a-seam": "the waiting verdict only",
    "last-report": "nothing from the set (the report record only)",
    "awaiting-issue": "an awaiting label on any owned issue",
    "awaiting-pr": "an awaiting label on any owned pull request",
    "ci": "CI running at the head of any owned pull request",
    "review-requested": "a review requested on any owned pull request",
    "review-window": "any owned pull request younger than the review window",
    "reminder": "a reminder for the worker naming any owned issue",
    "decision": "a human decision on any owned issue or pull request",
}


# #816: THE table of waiting guards: name -> (needs the daemon's lists, check). The predicate LOOPS OVER it, so a guard cannot exist in code and
# not here, and the tests are parametrised over it (a new row fails the completeness test until its case is added).
WAITING_GUARDS = {
    "last-report": (False, _guard_last_report),
    "awaiting-issue": (True, _guard_awaiting_issue),
    "awaiting-pr": (True, _guard_awaiting_pr),
    "ci": (True, _guard_ci),
    "review-requested": (True, _guard_review_requested),
    "review-window": (True, _guard_review_window),
    "reminder": (True, _guard_reminder),
    "decision": (True, _guard_decision),
}


def legitimately_waiting(engine, observation, issue, repo, last):
    """#816: THE shared predicate of the idle-at-a-seam rule and the stalled-working rule. Reads only what the daemon already holds (the last
    report record, the issue list, the open-PR list and its cached check state, the reminders, the decision list), never GitHub.
    Returns a namespace: `state` is "unread" (an input was not read whole or not readable: the caller says nothing), "waiting" (`codes` names the
    guards from WAITING_GUARDS that hold, `reason` says why: the caller says nothing and the stretch is NOT consumed because nothing is stored)
    or "clear"; `issue_at`, `pr`, `number`, `head`, `pr_at` describe what it found for the caller's movement judgement. A review is pending when
    one is requested on a non-draft pull request, or such a pull request is younger than `review_window_minutes` (the list holds no reviews, so
    "no review yet" is the window). Without the daemon's whole lists (a repository outside `plan_gates` never gets its open-PR list read) the
    answer is "unread": both rules are silent there, by the read-whole rule."""
    out = types.SimpleNamespace(state="unread", reason="", codes=[], issue_at=None, pr=None, number=None, head=None, pr_at=None,
                                issues=[], pulls=[], heads={})
    now, key = engine.now(), plan_ledger.normal_repo(repo)
    w = types.SimpleNamespace(engine=engine, observation=observation, issue=issue, repo=repo, key=key, last=last, now=now, mine=[],
                              awaiting=set(), issues=[], numbers={issue}, state=getattr(engine, "ci_record_state", None), window=engine.config.get("review_window_minutes", 60) * 60)
    found = []
    def run(early):
        for name, (needs, check) in WAITING_GUARDS.items():
            if needs != (not early):
                continue
            for text in check(w):
                found.append((name, text))
    try:
        run(True)
        if found:
            out.state, out.codes, out.reason = "waiting", [n for n, _ in found], "; ".join(t for _, t in found)
            return out
        if any(not whole(engine, name)[0] for name in ("issues:" + repo, "decisions", "pulls:" + key)):
            return out
        listed_at = engine.read_whole["pulls:" + key].get("at")
        if not _is_number(listed_at) or now - listed_at > STALLED_LIST_MAX_AGE:
            return out   # an open-PR list that is not being re-read is no evidence
        units = getattr(getattr(engine, "triage", None), "units", None) or {}
        records = (units.get((repo, "issues")) or {}).get("data") or []
        pulls = ((getattr(w.state, "lists", None) or {}).get(key) or (0, []))[1]
        owned = worker_owned(records, pulls, issue, repo)
        if owned is None:
            return out
        w.issues, w.numbers, w.mine = owned.issues, owned.numbers, owned.pulls
        if not owned_readable(owned):
            return out   # an owned item whose time or head cannot be read is an input not read whole: not judged
        out.issue_at = max(parse_iso(r.get("updated_at")) for r in owned.issues)
        out.issues, out.pulls = owned.issues, owned.pulls
        stamps = [(parse_iso(r.get("updated_at")), r["number"], r["head"]["sha"]) for r in owned.pulls]
        if stamps:
            out.pr_at, out.number, out.head = max(stamps)   # the newest-moved one when several are owned
            out.pr = next(r for r in owned.pulls if r["number"] == out.number)
            out.heads = {n: h for _, n, h in stamps}
        w.awaiting = triage_awaiting_labels(engine)
        run(False)
    except _Unread:
        out.state = "unread"
        return out
    out.state, out.codes, out.reason = ("waiting", [n for n, _ in found], "; ".join(t for _, t in found)) if found else ("clear", [], "")
    return out


SEAM_IDLE_SECONDS = 1200   # #773: an idle worker whose last report was `working` is noticed after this long
REPORT_MAX = 300  # characters: a report is a sentence; detail goes on GitHub
SUMMARY_CAP = 600  # characters of a worker's last reply in its fact
LAB_WORKER_SINCE_ENV = "FLEET_SWITCHBOARD_LAB_WORKER_SINCE"
REMINDERS = "reminders.json"
REMINDER_LOCK = "reminders.lock"
REMINDER_UNITS = {"s": 1, "m": 60, "h": 3600, "d": 86400}


def worker_horizon(config, now):
    """The oldest `idle_at` that still counts: `worker_lookback_hours` back, so a
    restart does not resurface ancient completions. In the Lab, the environment
    may name a later start (LAB_WORKER_SINCE_ENV, epoch seconds), so the warm-up
    turns that precede a play are not news; it is ignored outside the Lab."""
    horizon = now - config["worker_lookback_hours"] * 3600
    raw = os.environ.get(LAB_WORKER_SINCE_ENV) if os.environ.get(LAB_ENV) == "1" else None
    if raw:
        try:
            horizon = max(horizon, float(raw))
        except ValueError:
            raise FactError("%s must be epoch seconds, got %r" % (LAB_WORKER_SINCE_ENV, raw)) from None
    return horizon


def reply_text(message):
    """The text of one v2 assistant message: `text`, or its text parts."""
    if not isinstance(message, dict):
        return ""
    text = message.get("text")
    if not isinstance(text, str):
        parts = message.get("content") if isinstance(message.get("content"), list) else []
        text = " ".join(part.get("text", "") for part in parts
                        if isinstance(part, dict) and isinstance(part.get("text"), str))
    return text


def _issue_of(fleet):
    issue = fleet.get("issue") if isinstance(fleet, dict) else None
    return issue if isinstance(issue, int) and not isinstance(issue, bool) and issue >= 1 else None


def _boss_of(observation):
    """Who a worker reports to, or None when it reports to nobody (or to itself)."""
    boss = observation.fleet.get("reports_to")
    return boss if isinstance(boss, str) and boss and boss != observation.name else None


class WorkerFacts:
    """Facts about workers (fleet agents that have a `reports_to`), derived on every call.

    `worker.idle:<session>:<idle_at ms>`: its turn ended (herdr says idle, v2's
    `time.idle` is set and within the look-back). For its `reports_to`.
    `worker.blocked:<session>:<request id>`: herdr says blocked, and v2 lists a
    pending permission request or form. For its `reports_to`; the human also
    gets a toast (see `toasts`).
    Nothing is stored: the same state gives the same facts (invariant 1).
    """

    __name__ = "worker_facts"

    def __init__(self):
        self.engine = None
        self._blocked = []       # toasts of the last call: (agent, reason, title, body)
        self.requests = []       # PR 14: the pending requests of every blocked agent in the last call (decisions)
        self._summaries = {}     # (session, idle ms) -> text; a cache, rebuilt after a restart
        self._stops = {}         # (session, idle ms) -> the facts of that stop (PR 13); a cache, rebuilt likewise
        self._heads = {}         # #811, #874: worker -> {owned pull request number: (the head last seen, when a change of it was seen)}; memory only
        self._no_forms = False   # v2 does not know the form operation (UNVERIFIED name)

    def bind(self, engine):
        self.engine = engine

    def toasts(self):
        return list(self._blocked)

    def __call__(self):
        self._blocked, self.requests = [], []
        engine = self.engine
        discovery = getattr(engine, "discovery", None)
        if engine is None or discovery is None or fault("no-worker-source"):
            if engine is not None:
                read_mark(engine, "requests", False, "no worker source was read", engine.now())   # #805: an earlier whole mark is not this pass's
            return []
        read_mark(engine, "requests", False, "the worker read did not finish", engine.now())   # #805: never inherited: whole only at the end of a read that completed
        horizon = worker_horizon(engine.config, engine.now())
        facts, skipped = [], []
        for observation in sorted(discovery.agents.values(), key=lambda o: o.name):
            boss = boss_name(discovery, observation)  # #102: the stop triage looks the boss up by its registered name
            if observation.conflict or observation.problem:
                skipped.append(observation.name)
                continue
            try:
                if boss is not None:
                    facts.extend(self.finished(observation, boss, horizon))
                    facts.extend(self.stalled_facts(observation, boss))
                facts.extend(self.blocked(observation, boss))
            except V2Error as err:  # one worker's trouble never hides the others
                skipped.append(observation.name)
                engine._note("source.error", "worker_facts:" + observation.name, {"error": _one_line(str(err))})
        # #805: the pending requests are whole only when every worker was read: an unread worker's requests are absent, not gone
        problems = list(getattr(discovery, "problems", None) or [])
        why = "the fleet could not be read whole" if problems else ("%d worker(s) not read: %s" % (len(skipped), ", ".join(skipped[:3])) if skipped else "")
        read_mark(engine, "requests", not problems and not skipped, why, engine.now())
        return facts

    def finished(self, observation, boss, horizon):
        """The facts of one worker's finished turn. PR 13: a bare idle is a rider; whether the boss must hear
        about the stop is `stop_facts`'s question."""
        if observation.status != "idle" or observation.idle_at is None or observation.idle_at < horizon:
            return []
        idle_ms = int(round(observation.idle_at * 1000))
        key = "%s:%s:%d" % (WORKER_IDLE, observation.session_id, idle_ms)
        head = "%s finished its turn (%s)" % (observation.name, observation.outcome or "no outcome recorded")
        reply = self.last_reply(observation.session_id, idle_ms)
        idle = Fact(key, boss, WORKER_IDLE, head + (": " + reply if reply else ""), observation.idle_at,
                    issue=_issue_of(observation.fleet), sender=observation.name, rider=not fault("idle-wakes"))
        idle.clean = observation.outcome in QUIET_OUTCOMES  # only a clean finish may be folded into a quiet line
        found = self.stop_facts(observation, boss, idle_ms, idle, reply)
        if len(found) == 1 and found[0].kind == WORKER_IDLE:   # nothing else is said about this stop: it may be an idle at a seam (#773)
            found = found + self.seam_facts(observation, boss, idle_ms)
        return found

    def seam_applies(self, observation, issue):
        """#793: the idle-at-a-seam rule is for a worker whose launch-record role is `coder` or `tester` and whose issue is not a charter.
        A charter is known from memory only (no new read): the issue is the `charter` of this worker's own record or of any discovered
        agent's. (A closed charter is already closed.) A role that cannot be read is not a coder or tester."""
        fleet = observation.fleet if isinstance(observation.fleet, dict) else {}
        if fleet.get("role") not in ("coder", "tester") or not isinstance(fleet.get("role"), str):
            return False
        engine = self.engine
        repo = _fleet_repo(fleet, engine.config) or engine.config.get("intent_repo")
        discovery = getattr(engine, "discovery", None)
        for agent in ([observation] + (list(discovery.agents.values()) if discovery is not None else [])):
            other = agent.fleet if isinstance(agent.fleet, dict) else {}
            if other.get("charter") == issue and not isinstance(other.get("charter"), bool):
                if agent is observation or _fleet_repo(other, engine.config) in (repo, None) or other.get("repo") == repo:
                    return False
        return True

    def seam_facts(self, observation, boss, idle_ms):
        """#773: idle SEAM_IDLE_SECONDS or more, an OPEN assignment, and a last report of `working`: ONE nudge for the worker and ONE wake
        for its boss, each keyed by this idle stretch (`idle_at`), so neither is sent twice. Reads nothing new: the observation, the
        last-reports.json record `report` wrote, the retired list, and the closed-issue events the hub already holds (no `gh` call)."""
        engine, state_dir = self.engine, self.engine.state_dir
        issue = _issue_of(observation.fleet)
        if state_dir is None or issue is None or engine.now() - observation.idle_at < SEAM_IDLE_SECONDS:
            return []
        if not self.seam_applies(observation, issue):
            return []   # #793: only a coder or tester on a work item or an ask; anything not readable fails toward not nudging
        kept = registry_retired(state_dir).get(observation.name)
        if kept is not None and kept.get("session") in (None, observation.session_id):
            return []   # retired on purpose
        last = _read_small(state_dir, LAST_REPORT_FILE).get(observation.name)
        if not isinstance(last, dict) or last.get("state") != "working":
            return []   # a closing report (or none) is the existing triage's business
        repo = _fleet_repo(observation.fleet, engine.config) or engine.config.get("intent_repo")
        hub = getattr(engine, "hub", None)
        # Fails OPEN on purpose: the hub keeps closed events in memory only, so after a restart a closed issue can get one nudge and one wake.
        closed = hub.closed_issue_snapshot() if hub is not None and hasattr(hub, "closed_issue_snapshot") else {}
        if repo and "%s#%d" % (plan_ledger.normal_repo(repo), issue) in closed:
            return []   # its assignment is closed
        if not repo or legitimately_waiting(engine, observation, issue, repo, last).state != "clear":
            return []   # #816: waiting legitimately (or an input not read whole): nothing is stored, so a later pass says it if it is still idle
        stretch = "%s:%s:%d" % ("seam", observation.session_id, int(round(observation.idle_at * 1000)))
        line = last.get("text") if isinstance(last.get("text"), str) else ""
        nudge = Fact("%s:%s" % (NUDGE, stretch), observation.name, NUDGE,
                     "you went idle after reporting working on #%d: report done, blocked or question, or continue" % issue,
                     observation.idle_at, issue=issue, batch=False, sender="switchboard", repo=repo)
        wake = Fact("%s:%s" % (WORKER_IDLE, stretch), boss, WORKER_IDLE,
                    "idle without a closing report: #%d (worker %s, last report: %s)" % (issue, observation.name, _one_line(redact_command_text(line), 160) or "none recorded"),
                    observation.idle_at, issue=issue, batch=False, sender=observation.name, repo=repo)
        return [nudge, wake]

    def stalled_facts(self, observation, boss):
        """#811: a coder or tester whose last reports were all `working` for `stalled_working_hours` while nothing it owns moved (the pull
        request's head and updated time, the issue's updated time) wakes its boss ONCE per stretch; the worker is never nagged. Reads only
        what the daemon holds (the report record, the lists, the check summaries, the reminders, the decision list), never GitHub, and
        judges only when each of them was read whole. Anything not readable fails toward no wake."""
        engine, state_dir = self.engine, self.engine.state_dir
        issue = _issue_of(observation.fleet)
        now, window = engine.now(), engine.config.get("stalled_working_hours", 2) * 3600
        if state_dir is None or issue is None or not self.seam_applies(observation, issue):
            return []
        if observation.status == "idle" and observation.idle_at is not None:
            return []   # an idle worker is the idle-at-a-seam rule's (one wake for it, not a second under another key)
        last = _read_small(state_dir, LAST_REPORT_FILE).get(observation.name)
        if not isinstance(last, dict) or last.get("state") != "working" or not _is_number(last.get("work_since")) or not isinstance(last.get("work_n"), int):
            return []   # a blocked, question or closing report (or none) is not this case
        kept = registry_retired(state_dir).get(observation.name)
        if kept is not None and kept.get("session") in (None, observation.session_id):
            return []
        repo = _fleet_repo(observation.fleet, engine.config) or engine.config.get("intent_repo")
        if not repo:
            return []
        key = plan_ledger.normal_repo(repo)
        hub = getattr(engine, "hub", None)
        closed = hub.closed_issue_snapshot() if hub is not None and hasattr(hub, "closed_issue_snapshot") else {}
        if "%s#%d" % (key, issue) in closed:
            return []
        ctx = legitimately_waiting(engine, observation, issue, repo, last)
        moved, head, number = ctx.issue_at, ctx.head, ctx.number
        if ctx.state == "unread":
            return []
        if ctx.pr is not None:
            moved = max(moved, ctx.pr_at)
            known = self._heads.get(observation.name)   # a head this process saw change on ANY owned pull request is movement now, whatever GitHub's clock says
            kept = {}
            for pr_number, pr_head in ctx.heads.items():   # recorded BEFORE the waiting verdict is used: a head that moved during a guard is still movement
                seen = (known or {}).get(pr_number)
                kept[pr_number] = seen if seen is not None and seen[0] == pr_head else (pr_head, now if known is not None and seen is not None else 0)
            self._heads[observation.name] = kept
            moved = max([moved] + [t for _, t in kept.values()])
        if ctx.state == "waiting":
            return []
        since = max(moved, last["work_since"])
        if now - since < window:
            return []
        ref = "%s#%d" % (repo, number or issue)
        line = last.get("text") if isinstance(last.get("text"), str) else ""
        stretch = "stalled:%s:%d:%s:%d" % (observation.session_id, issue, head or "-", int(moved))
        text = "no movement for %s on %s (worker %s, %d working reports; last: %s)" % (
            _stalled_age(now - since), ref, observation.name, last["work_n"], _one_line(redact_command_text(line), 160) or "none recorded")
        return [Fact("%s:%s" % (WORKER_IDLE, stretch), boss, WORKER_IDLE, text, now, issue=issue, batch=False, sender=observation.name, repo=repo)]

    def stop_facts(self, observation, boss, idle_ms, idle, reply):
        """The facts for one stop, worked out once (a stop is asked about once; the cache is rebuilt after a
        restart). The idle rider, plus a nudge for the worker, or instead a `worker.stopped` for the boss."""
        memo = (observation.session_id, idle_ms)
        engine = self.engine
        if memo in self._stops:
            return list(self._stops[memo])
        if engine.audit is None:
            return [idle]  # a read-only look never asks the decision model
        verdict = triage_stop(engine, self, observation, boss, idle_ms, reply)
        if verdict is None:
            found = [idle]   # reported, not worth asking, or not readable: only the rider
        elif verdict["outcome"] == "stopped":
            found = [Fact("%s:%s:%d" % (WORKER_STOPPED, observation.session_id, idle_ms), boss, WORKER_STOPPED,
                          "%s stopped without reporting (%s)%s" % (
                              observation.name, observation.outcome or "no outcome recorded",
                              ": " + reply if reply else ""), observation.idle_at,
                          issue=_issue_of(observation.fleet), sender=observation.name)]
            found[0].stop = {"reply": reply, "clean": observation.outcome in QUIET_OUTCOMES,
                             "role": (observation.fleet or {}).get("role"), "fleet": observation.fleet}
        elif verdict["outcome"] == "nudge":
            found = [idle, verdict["nudge"]]
        else:
            found = [idle]
        if len(self._stops) > 500:
            self._stops.clear()
        self._stops[memo] = list(found)
        return found

    def last_reply(self, session_id, idle_ms):
        """The worker's last assistant reply, cut to SUMMARY_CAP; read once per turn."""
        cached = self._summaries.get((session_id, idle_ms))
        if cached is not None:
            return cached
        if self.engine.light:
            return ""
        page = self.engine.v2.message_list(session_id, limit=1, type="assistant")
        text = _one_line(reply_text(page[0]) if isinstance(page, list) and page else "", SUMMARY_CAP)
        if len(self._summaries) > 500:
            self._summaries.clear()
        self._summaries[(session_id, idle_ms)] = text
        return text

    def blocked(self, observation, boss):
        """The facts for a blocked worker's pending requests. PR 14: every blocked agent's requests are read and
        kept in `requests` (a boss with no boss of its own waits on you too); only a worker has a fact."""
        if observation.status != "blocked":
            return []
        facts = []
        for kind, items in (("permission", self.engine.v2.permission_list(observation.session_id)),
                            ("question", self.pending_forms(observation))):
            for item in items if isinstance(items, list) else []:
                if isinstance(item, dict) and isinstance(item.get("id"), str) and item["id"]:
                    self.requests.append((observation, kind, item))
                    if boss is not None:
                        facts.append(self.blocked_fact(observation, boss, kind, item))
        return facts

    def pending_forms(self, observation):
        if self._no_forms:
            return []
        try:
            return self.engine.v2.form_list(observation.session_id)
        except V2Error as err:
            if err.reason == "http" and err.status == 404:
                self._no_forms = True  # this v2 has no such operation; stop asking
                return []
            raise

    def blocked_fact(self, observation, boss, kind, item):
        key = "%s:%s:%s" % (WORKER_BLOCKED, observation.session_id, item["id"])
        what = " ".join(str(part) for part in [item.get("action") or item.get("title") or kind]
                        + [r for r in item.get("resources") or [] if isinstance(r, str)])
        asked = _created(item)  # when v2 says it asked; without it the fact is urgent, not batched
        summary = "%s is blocked on a %s request and cannot go on until you answer it: %s" % (
            observation.name, kind, _one_line(what, 200))
        if isinstance(item.get("message"), str) and item["message"].strip():
            summary += " (reason given: %s)" % _one_line(item["message"], 200)
        issue = _issue_of(observation.fleet)
        repo = _fleet_repo(observation.fleet, self.engine.config) if issue else None  # PR 15: the issue's repo
        # A hook's message (PR 9: the policy judge's reason) is on the request as `message`: say it first.
        note = _one_line(item["message"], 120) if isinstance(item.get("message"), str) else ""
        shown = "%s (%s)" % (note, _one_line(what, 60)) if note else what
        self._blocked.append((observation.name, key, "Fleet: %s is blocked" % observation.name,
                              _one_line("%s is waiting for you: %s%s" % (
                                  observation.name, shown,
                                  " (issue %s)" % issue_tag(repo, issue, self.engine.repos_in_play()) if issue else ""), 200)))
        return Fact(key, boss, WORKER_BLOCKED, summary, asked if asked is not None else self.engine.now(),
                    issue=issue, batch=asked is not None, sender=observation.name, repo=repo)


# ---- PR 13: workers report, and a stop without a report is triaged
#
# docs/switchboard.md, "Workers report (PR 13)". A worker tells its boss with `fleet-switchboard report`. A
# worker whose turn ends without a report since its latest assigning input is an unreported stop: the decision
# model is asked `report_owed`, and the answer nudges the worker once, stays silent, or (a second stop, or no
# answer) wakes the boss with one `worker.stopped`. Everything here is derived from transcripts, nothing stored.

REPORT_OWED_ID = "report_owed"
REPORT_OWED_TEXT = ("Did this turn end with work done, blocked, failed or needing a decision that the boss has "
                    "not been told about?")
REPORT_TRIAGE_DEFAULTS = {
    "owed_threshold": 0.5,  # the probability at which the answer is "owed": the worker is nudged
    "budget_seconds": 3,    # the longest the decision model may take for one stop; no answer fails open
    "stopped_news": "off",  # #96: "off", "shadow" (judge and audit, drop nothing) or "on": judge a worker.stopped that
                            # would wake the Chief of Staff alone, and drop one that is clearly no news
    "news_threshold": 0.15, # the probability of news below which a stopped note is clearly no news
}
NUDGE_TEXT = ("You stopped without telling %s. If your work is done, failed, blocked or needs a decision, run: "
              "%s report <state> \"one line\". If nothing changed since your last report, say nothing. "
              "A run you started that takes more than a few minutes belongs in `%s job start <name> -- <command>`; `%s job status <name>` says whether it is "
              "alive, finished or dead.")


def validate_report_triage_config(config, source):
    raw = config.get("report_triage")
    if raw is None:
        config["report_triage"] = dict(REPORT_TRIAGE_DEFAULTS)
        return
    if not isinstance(raw, dict):
        raise ConfigError("%s: 'report_triage' must be an object, got %r" % (source, type(raw).__name__))
    unknown = sorted(set(raw) - set(REPORT_TRIAGE_DEFAULTS))
    if unknown:
        warn_unknown_config("%s: 'report_triage' contains key(s) this tool does not read: %s (known: %s)"
                          % (source, ", ".join(unknown), ", ".join(REPORT_TRIAGE_DEFAULTS)), 'report_triage', unknown, list(REPORT_TRIAGE_DEFAULTS))
    settings = dict(REPORT_TRIAGE_DEFAULTS, **raw)
    if not _is_number(settings["owed_threshold"]) or not 0 < settings["owed_threshold"] <= 1:
        raise ConfigError("%s: 'report_triage.owed_threshold' must be a number above 0 and at most 1, got %r"
                          % (source, settings["owed_threshold"]))
    if not _is_number(settings["budget_seconds"]) or settings["budget_seconds"] <= 0:
        raise ConfigError("%s: 'report_triage.budget_seconds' must be a positive number, got %r"
                          % (source, settings["budget_seconds"]))
    if settings["stopped_news"] not in ("off", "shadow", "on"):
        raise ConfigError("%s: 'report_triage.stopped_news' must be \"off\", \"shadow\" or \"on\", got %r"
                          % (source, settings["stopped_news"]))
    if not _is_number(settings["news_threshold"]) or not 0 < settings["news_threshold"] < 1:
        raise ConfigError("%s: 'report_triage.news_threshold' must be a number above 0 and below 1, got %r"
                          % (source, settings["news_threshold"]))
    config["report_triage"] = settings


REPORT_LOOKUP_WAIT = 3.0   # seconds a report waits to learn whether its issue exists; slower is accepted


class ReportError(Exception):
    """A report that cannot be made: an unknown state, no line, a line too long, a caller with no boss."""


def report_owed_questions():
    """The one question, by id: a yes/no `noul` like the policy judge's."""
    return {REPORT_OWED_ID: {"type": "noul", "instructions": REPORT_OWED_TEXT,
                             "criteria": {"true": "The turn ended with something the boss has not been told: "
                                                  "work done, blocked, failed, or a decision needed.",
                                          "false": "Nothing happened that the boss needs to hear, or it was "
                                                   "already reported."}}}


def report_owed_state(role, intent, done_when, last_reply, boss):
    return {"role": role or "unknown", "boss": boss, "intent": _clip(intent or "not stated: no ask is recorded", 600),
            "done_when": _clip(done_when or "not stated", 400), "last_reply": _clip(last_reply, 800)}


def assigning_input(engine, observation, boss):
    """(message id, created) of the newest message in the worker's transcript that assigned it work, or None.

    Assigning: a prompt (yours, the fleet's task, or the brief `launch` sent), or a message from its boss
    (`send`, a handoff). Not assigning: a GitHub notice, a decoration, a reminder, a nudge, a toast, a
    report from one of its own workers. Newest first, within READ_LIMIT messages."""
    # Two small typed reads instead of a 200-message page of everything: the newest user message, and the newest of the last few synthetic ones
    # that is a `send` from the boss. The newer of the two assigned it.
    users = engine.v2.message_list(observation.session_id, limit=1, type="user")
    synthetic = engine.v2.message_list(observation.session_id, limit=SYNTHETIC_PAGE, type="synthetic")
    candidates = [m for m in (users if isinstance(users, list) else []) if isinstance(m, dict)]
    candidates += [m for m in (synthetic if isinstance(synthetic, list) else []) if isinstance(m, dict)
                   and any(key.startswith("send:%s:" % boss) for key in _fleet_keys(m))][:1]
    candidates = [m for m in candidates if m.get("id") and _created(m) is not None]
    if not candidates:
        return None
    newest = max(candidates, key=_created)
    return newest.get("id"), _created(newest)


def report_jev(engine, settings):
    """The decision model for triage: the engine's, with a shorter timeout (its budget). None when none is set."""
    base = engine.config.get("jev")
    if not base:
        return None
    capped = dict(base, timeout_seconds=min(base["timeout_seconds"], settings["budget_seconds"]))
    return build_jev(dict(engine.config, jev=capped))


QUIET_OUTCOMES = ("succeeded", "success")  # a stop that ended cleanly: only its idle line may be folded


def triage_stop(engine, source, observation, boss, idle_ms, reply):
    """What an unreported stop calls for: None (reported, too old, or not readable: only the idle rider), or
    {"outcome": "nudge", "nudge": Fact} / {"outcome": "silent"} / {"outcome": "stopped"}. Audited once."""
    now = engine.now()
    if getattr(engine, "light", False):
        return None   # v2_light: no transcript read, so a stop is only its idle rider
    if now - observation.idle_at > engine.config["rider_max_age_seconds"]:
        return None  # a stop that old is not news, and a nudge would be late
    if engine.state_dir is not None:   # a RETIRED worker is finished on purpose: no nudge, no "stopped without reporting" to its boss (no state dir: triaged as before)
        kept = registry_retired(engine.state_dir).get(observation.name)
        if kept is not None and kept.get("session") in (None, observation.session_id):
            return None
    boss_view = engine.discovery.agents.get(boss) if engine.discovery else None
    if boss_view is None:  # the boss cannot be read, so nothing can be said to have been reported: tell it (held)
        verdict = {"outcome": "stopped", "reason": "the boss %s is not running, so its transcript cannot show a report" % boss}
        try:
            engine.audit.append(engine.actor, "report.triage", "stop:%s:%d" % (observation.session_id, idle_ms), {
                "worker": observation.name, "boss": boss, "session": observation.session_id, "idle_ms": idle_ms,
                "question": None, "answer": None, "latency_ms": 0, "outcome": "stopped", "reason": verdict["reason"]})
        except OSError:
            pass
        return verdict
    assigned = assigning_input(engine, observation, boss)
    if assigned is None:
        return None
    assigned_id, assigned_at = assigned
    keys, complete = engine.delivered_keys(boss_view.session_id, assigned_at - SINCE_SLACK)
    prefixes = ("%s:%s:" % (REPORT, observation.name), "send:%s:" % observation.name)   # a `send` to its boss tells it as much as a `report`
    if not fault("ignore-reports") and any(
            key.startswith(prefixes) and (keys.at.get(key) is None or keys.at[key] >= assigned_at) for key in keys):
        return None  # it reported or wrote to its boss since it was last given work: this stop is only a rider
    if not complete:
        return None  # the read did not reach back far enough to say it did not report
    nudge_key = "%s:%s:%s" % (NUDGE, observation.session_id, assigned_id)
    if fault("no-nudge-once"):
        nudge_key += ":%d" % idle_ms  # the fault: every stop is a first stop
    worker_keys, _ = engine.delivered_keys(observation.session_id, assigned_at - SINCE_SLACK)
    sent_at = worker_keys.at.get(nudge_key) if nudge_key in worker_keys else None
    audit = {"worker": observation.name, "boss": boss, "session": observation.session_id, "ask": _issue_of(observation.fleet),
             "assigned": assigned_id, "idle_ms": idle_ms, "question": None, "answer": None, "latency_ms": 0,
             "model": None, "usage": {}, "error": None}
    if nudge_key in worker_keys:
        if sent_at is not None and observation.idle_at < sent_at:
            return None  # this is the stop the nudge answered, not a second one
        verdict = {"outcome": "stopped", "reason": "nudged already for this assignment and stopped again "
                                                   "without reporting"}
    else:
        verdict = ask_report_owed(engine, observation, boss, reply, audit)
        if verdict["outcome"] == "nudge":
            verdict["nudge"] = Fact(
                nudge_key, observation.name, NUDGE, NUDGE_TEXT % (boss, PROG, PROG, PROG), observation.idle_at,
                issue=_issue_of(observation.fleet), batch=False, sender="switchboard")
    audit["outcome"], audit["reason"] = verdict["outcome"], verdict["reason"]
    try:
        engine.audit.append(engine.actor, "report.triage", "stop:%s:%d" % (observation.session_id, idle_ms), audit)
    except OSError:
        pass  # the audit is best effort here, as the judge's is: a full disk must not hide a stopped worker
    return verdict


def ask_report_owed(engine, observation, boss, reply, audit):
    """Ask `report_owed`. {"outcome": "nudge" | "silent" | "stopped", "reason"}; fails open to "stopped"."""
    settings = engine.config["report_triage"]
    questions = report_owed_questions()
    ask = ask_intent(engine, _ask_of(observation.fleet, observation.name)) or {}
    state = report_owed_state(observation.fleet.get("role"), ask.get("intent"), ask.get("done_when"), reply, boss)
    audit["question"] = {"state": state, "ids": list(questions)}
    failure = None
    try:
        jev = report_jev(engine, settings)
        if jev is None:
            failure = "no decision model is configured"
        else:
            result = jev.decide(state, questions)
            audit.update(latency_ms=result["latency_ms"], model=result["model"], usage=result["usage"])
            owed = result["answers"][REPORT_OWED_ID]["noul"]
            audit["answer"] = {REPORT_OWED_ID: owed}
    except JevError as err:
        failure = "decision model unavailable (%s)" % err.reason
        audit.update(latency_ms=err.latency_ms or 0, error=_one_line(str(err), 160))
    if failure:
        if fault("no-fail-open"):
            return {"outcome": "silent", "reason": failure + "; the fault keeps quiet"}
        return {"outcome": "stopped", "reason": failure + ": the boss is told"}
    if owed >= settings["owed_threshold"]:
        return {"outcome": "nudge", "reason": "owed at %.2f, threshold %.2f" % (owed, settings["owed_threshold"])}
    return {"outcome": "silent", "reason": "owed at %.2f, below %.2f" % (owed, settings["owed_threshold"])}


# ---- #96: a worker.stopped that would wake the Chief of Staff alone is judged for news

STOPPED_NEWS_ID = "stopped_news"
STOPPED_NEWS_TEXT = "Does this tell the person anything new?"


def stopped_news_questions():
    return {STOPPED_NEWS_ID: {"type": "noul", "instructions": STOPPED_NEWS_TEXT,
                              "criteria": {"true": "The reply says something new for the person: work finished, "
                                                   "a result, a failure, a block, a decision needed, or a change "
                                                   "since the last update.",
                                           "false": "The reply only says nothing changed, repeats what was already "
                                                    "reported, or acknowledges without a result."}}}


def judge_stopped_news(engine, fact):
    """(clear_no, audit detail) for one worker.stopped. clear_no is True only when the worker ended cleanly and the
    decision model answered, in time, a probability of news under `news_threshold`. Every other path is False: a
    note that cannot be judged is a note that wakes."""
    settings = engine.config["report_triage"]
    info = getattr(fact, "stop", None) or {}
    detail = {"worker": fact.sender, "key": fact.key, "mode": settings["stopped_news"], "threshold": settings["news_threshold"],
              "question": None, "answer": None, "latency_ms": 0, "model": None, "usage": {}, "error": None}
    if not info:
        detail["reason"] = "not a judged stop"
        return False, detail
    if not info.get("clean"):
        detail["reason"] = "the worker did not end cleanly: never dropped"
        return False, detail
    fleet = info.get("fleet") or {}
    ask = ask_intent(engine, _ask_of(fleet, fact.sender)) or {}
    state = report_owed_state(info.get("role"), ask.get("intent"), ask.get("done_when"), info.get("reply") or "",
                              fact.recipient)
    detail["question"] = {"state": state, "ids": [STOPPED_NEWS_ID]}
    try:
        jev = report_jev(engine, settings)
        if jev is None:
            detail["reason"] = "no decision model is configured: wakes"
            return False, detail
        result = jev.decide(state, stopped_news_questions())
        detail.update(latency_ms=result["latency_ms"], model=result["model"], usage=result["usage"])
        news = result["answers"][STOPPED_NEWS_ID]["noul"]
        if not _is_number(news):
            raise KeyError("no answer")
    except JevError as err:
        detail.update(latency_ms=err.latency_ms or 0, error=_one_line(str(err), 160),
                      reason="decision model unavailable (%s): wakes" % err.reason)
        return False, detail
    except (KeyError, TypeError, ValueError):
        detail["reason"] = "no usable answer: wakes"
        return False, detail
    detail["answer"] = {STOPPED_NEWS_ID: news}
    if news < settings["news_threshold"]:
        detail["reason"] = "news at %.2f, under %.2f: clearly nothing new" % (news, settings["news_threshold"])
        return True, detail
    detail["reason"] = "news at %.2f, not under %.2f: wakes" % (news, settings["news_threshold"])
    return False, detail


def filter_stopped_news(engine, facts, discovery):
    """The facts for the pass, minus the worker.stopped notes that are clearly no news. Applies only to the Chief of
    Staff's wakes, only when every non-rider fact waiting for it is a worker.stopped (it would be woken for nothing
    else), only with `report_triage.stopped_news` "on"; "shadow" judges and audits (`would_drop`) and drops nothing.
    One judgement per note (remembered); each is audited once with its question, answer, latency and model usage."""
    settings = engine.config["report_triage"]
    mode = settings["stopped_news"]
    if mode == "off" or engine.audit is None or discovery is None:
        return facts
    groups = {}
    for fact in facts:
        groups.setdefault(fact.recipient, []).append(fact)
    dropped = set()
    for recipient, group in groups.items():
        seen = discovery.agents.get(recipient)
        if seen is None or (seen.fleet or {}).get("role") != "chief-of-staff":
            continue  # an orchestrator's boss keeps its wakes
        news = [f for f in group if not f.rider]
        if not news or any(f.kind != WORKER_STOPPED for f in news):
            continue
        for fact in news:
            clear = engine.stopped_news.get(fact.key)
            if clear is None:
                clear, detail = judge_stopped_news(engine, fact)
                if len(engine.stopped_news) > 500:
                    engine.stopped_news.clear()
                engine.stopped_news[fact.key] = clear
                detail["outcome"] = ("dropped" if mode == "on" else "would_drop") if clear else "wakes"
                try:
                    engine.audit.append(engine.actor, "stopped.news", fact.sender, detail)
                except OSError:
                    pass
            if clear and mode == "on":
                dropped.add(fact.key)
    return [f for f in facts if f.key not in dropped]


def stopped_news_summary(state_dir, now, window=3600):
    """{judged, dropped, would_drop} of the last `window` seconds, read from the tail of the audit (a display only:
    nothing decides from it). None when there is none."""
    path = Path(state_dir) / "audit.jsonl"
    try:
        with open(str(path), "rb") as handle:
            handle.seek(0, os.SEEK_END)
            handle.seek(max(0, handle.tell() - 4000000))
            lines = handle.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return None
    counts = {"judged": 0, "dropped": 0, "would_drop": 0}
    for line in lines:
        if '"stopped.news"' not in line:
            continue
        try:
            row = json.loads(line)
        except ValueError:
            continue
        at = parse_iso(row.get("ts"))
        if row.get("event") != "stopped.news" or at is None or now - at > window:
            continue
        outcome = (row.get("detail") or {}).get("outcome")
        counts["judged"] += 1
        if outcome in ("dropped", "would_drop"):
            counts[outcome] += 1
    return counts if counts["judged"] else None


# ---- progress reports: riders that wait for a message to ride in

REPORT_RIDERS = "report-riders.json"
REPORT_RIDER_LOCK = "report-riders.lock"


@contextmanager
def report_riders_lock(state_dir):
    fd = os.open(str(Path(state_dir) / REPORT_RIDER_LOCK), os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)


def read_report_riders(state_dir):
    path = Path(state_dir) / REPORT_RIDERS
    try:
        raw = json.loads(path.read_text())
    except FileNotFoundError:
        return []
    except (OSError, ValueError) as err:
        raise ReminderError("cannot read %s: %s" % (path, err)) from None
    items = raw.get("riders") if isinstance(raw, dict) else None
    if not isinstance(items, list):
        raise ReminderError("%s must hold {\"riders\": [...]}" % path)
    for item in items:
        if not (isinstance(item, dict) and isinstance(item.get("key"), str) and isinstance(item.get("to"), str)
                and _is_number(item.get("created")) and isinstance(item.get("summary"), str)):
            raise ReminderError("%s has a rider without key, to, created and summary: %r" % (path, item))
    return items


def write_report_riders(state_dir, items):
    """Replace the file atomically, mode 0600 (the way reminders.json is written)."""
    path = Path(state_dir) / REPORT_RIDERS
    temp = path.with_name("%s.%d.tmp" % (REPORT_RIDERS, os.getpid()))
    fd = os.open(str(temp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        with os.fdopen(fd, "w") as handle:
            json.dump({"riders": items}, handle, indent=1, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(str(temp), str(path))
    except BaseException:
        try:
            os.unlink(str(temp))
        except OSError:
            pass
        raise


class ReportRiderFacts:
    """The progress reports (`working`, `paused`) that no message has carried yet, as rider facts.

    A progress report is the one thing `report` stores: it must wait for a message to ride in, and a CLI
    process cannot wait. It stays in report-riders.json until its key shows in the boss's transcript or inbox,
    or it is older than `rider_max_age_seconds` (prune_report_riders)."""

    __name__ = "report_rider_facts"

    def __init__(self, state_dir):
        self.state_dir, self.engine = Path(state_dir), None

    def bind(self, engine):
        self.engine = engine

    def entries(self):
        return read_report_riders(self.state_dir)

    def __call__(self):
        return [Fact(item["key"], item["to"], REPORT, item["summary"], item["created"], issue=item.get("issue"),
                     batch=False, sender=item.get("from"), rider=True, repo=item.get("repo")) for item in self.entries()]


def _report_rider_source(engine):
    return next((source for source in engine.sources if isinstance(source, ReportRiderFacts)), None)


def record_report_rider(engine, fact):
    source = _report_rider_source(engine)
    if source is None:
        raise ReportError("this engine has nowhere to keep a progress report")
    item = {"key": fact.key, "to": fact.recipient, "created": fact.created, "summary": fact.summary,
            "issue": fact.issue, "from": fact.sender}
    if fact.repo:
        item["repo"] = fact.repo
    with report_riders_lock(source.state_dir):
        write_report_riders(source.state_dir, read_report_riders(source.state_dir) + [item])
    if engine.audit is not None:
        engine.audit.append(engine.actor, "report.rider", fact.recipient, {"key": fact.key, "from": fact.sender})


def report_rider_facts(engine):
    source = _report_rider_source(engine)
    return source() if source is not None else []


def prune_report_riders(engine, discovery):
    """Forget the progress reports a message has carried, and those too old to be carried. Returns the keys."""
    source = _report_rider_source(engine)
    if source is None:
        return []
    items = source.entries()
    by_recipient = {}
    for item in items:
        by_recipient.setdefault(item["to"], []).append(item)
    gone = {item["key"] for item in items if engine.now() - item["created"] > engine.config["rider_max_age_seconds"]
            and not is_withdrawal(item["summary"])}
    for name, mine in sorted(by_recipient.items()):
        observation = discovery.agents.get(name)
        if observation is None:
            continue
        try:
            keys, _ = engine.delivered_keys(observation.session_id, min(i["created"] for i in mine) - SINCE_SLACK)
        except V2Error:
            continue
        gone.update(item["key"] for item in mine if item["key"] in keys)
    if gone:
        with report_riders_lock(source.state_dir):
            write_report_riders(source.state_dir, [i for i in read_report_riders(source.state_dir)
                                                   if i["key"] not in gone])
        if engine.audit is not None:
            engine.audit.append(engine.actor, "report.prune", None, {"keys": sorted(gone)})
    return sorted(gone)


# ======================================================================
# PR 14: Decisions, a read-only list of what waits on you
#
# docs/switchboard.md, "Decisions (PR 14)". The list is derived on every pass from facts that already
# exist and is never the source of truth (invariant 1): the issues that carry your awaiting-user label
# (the hub's picture, kept by webhook events and the catch-up read), the pending permission requests and
# questions of every fleet agent (WorkerFacts already reads them), and the `question` and `blocked`
# reports a boss has been sent and nobody has answered. The daemon writes it to $STATE/decisions.json
# when it changes, a disposable projection: deleting the file loses nothing and the next pass makes it
# again. `fleet-switchboard decisions` and the TUI plugin only read the file.
# ======================================================================

DECISIONS_FILE = "decisions.json"
DECISIONS_STALE_SECONDS = 180   # a file this old (by mtime, which every pass refreshes) is not current
DECISION_TITLE_MAX = decision_core.DECISION_TITLE_MAX
DECISION_REPORT_TITLE_MAX = decision_core.DECISION_REPORT_TITLE_MAX
DECISION_SOURCES = ("github", "v2", "reports")
REPORT_LINE = decision_core.REPORT_LINE   # the line shapes of a delivered report and send: the module's, with the rules that read them
SEND_LINE = decision_core.SEND_LINE


def repo_of_tag(tag, repos):
    return decision_core.repo_of_tag(tag, repos)


def validate_decisions_config(config, source):
    label = config["awaiting_label"]
    if label is not None and (not isinstance(label, str) or not label.strip() or "\n" in label or "," in label):
        raise ConfigError("%s: 'awaiting_label' must be a label name without a comma or a newline, or null (the "
                          "default, `<OS user>:awaiting-user`), got %r" % (source, label))
    hours = config["decisions_lookback_hours"]
    if not _is_number(hours) or hours <= 0:
        raise ConfigError("%s: 'decisions_lookback_hours' must be a positive number, got %r" % (source, hours))
    cos_label = config["awaiting_cos_label"]
    if cos_label is not None and (not isinstance(cos_label, str) or not cos_label.strip() or "\n" in cos_label
                                  or "," in cos_label):
        raise ConfigError("%s: 'awaiting_cos_label' must be a label name without a comma or a newline, or null (the "
                          "default, `<OS user>:awaiting-cos`), got %r" % (source, cos_label))
    if cos_label is not None and cos_label == label:
        raise ConfigError("%s: 'awaiting_cos_label' and 'awaiting_label' must differ, both are %r" % (source, label))
    grace = config["decisions_cos_grace_seconds"]
    if not _is_number(grace) or grace < 0:
        raise ConfigError("%s: 'decisions_cos_grace_seconds' must be a number of seconds, 0 or more, got %r"
                          % (source, grace))
    hold = config["pr_notice_hold_minutes"]
    if not _is_number(hold) or hold < 0:
        raise ConfigError("%s: 'pr_notice_hold_minutes' must be a number of minutes, 0 (no hold, the default) or "
                          "more, got %r" % (source, hold))
    orders = config["cos_orders_file"]
    if orders is not None and (not isinstance(orders, str) or not os.path.isabs(orders)):
        raise ConfigError("%s: 'cos_orders_file' must be an absolute path, or null (the default, standing-orders.md "
                          "beside config.json), got %r" % (source, orders))


def _decision_number(seed):
    return decision_core.decision_number(seed)


def assign_decision_ids(items, repos=None):
    """The id of each decision in `items`, in the same order (the rules are decision_core.assign_ids's). The Lab's
    `bare-issue-number` fault is read here, not by the module."""
    return decision_core.assign_ids(items, repos, bare_issue_number=fault("bare-issue-number"))


def decision_repos(engine):
    """Every repo being watched now (the derived set, as the hub's): the baseline, the repos of the live agents
    and of the charters they hold. Not the config's list alone, and not the intent repo alone."""
    return watched_repos(engine.config, discovered_fleets(engine.discovery))


# ---- a batch: related findings raised as ONE decision (one issue, one Markdown section per row in its body)

BATCH_FENCE = decision_core.BATCH_FENCE
