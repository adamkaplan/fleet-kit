#!/usr/bin/env python3
"""fleet-switchboard — routes facts to fleet agents as OpenCode v2 messages.

Configuration, the private state directory, the one client for OpenCode v2
(`opencode api`), the one client for herdr, the audit log, fault gating for
the Lab, the derived message id, and the delivery engine: each pass observes
the fleet, derives what is pending (facts minus the keys already in each
recipient's transcript or inbox), decides note, wake, wait or hold by the
delivery rule, and delivers. See docs/switchboard.md, "Delivery rule".

    fleet-switchboard run [--once]          the daemon, or one pass
    fleet-switchboard ensure                start the daemon if it is not running
    fleet-switchboard poke                  ask the daemon for a pass now
    fleet-switchboard launch <name> ...     a new fleet agent in its own herdr tab
    fleet-switchboard send <name> <text>    deliver to another agent now
    fleet-switchboard pending <name>        what is pending, and why it waits
    fleet-switchboard remind <name> <when> <text>   a message due later
    fleet-switchboard status                config, clients, fleet agents
    fleet-switchboard intent <issue>        the ask's Intent and Done-when (PR 6)
    fleet-switchboard intents               your open asks, one line each (PR 6)

Rules this file keeps from the start:

  1. herdr is never a delivery channel. HerdrClient reads agents and panes,
     sets a sidebar token, shows a toast, opens a tab that runs a program
     directly (no shell, nothing typed) and closes a pane `launch` itself
     opened. It has no way to type into a pane or to move focus, and a hygiene
     test scans this file to keep it that way.
  2. Every v2 call goes through one method, V2Client._call, which builds the
     argv and runs the configured binary with the configured environment. The
     v2 binary is reached only through a wrapper that isolates its data.
  3. Every write to another system is audited twice: the intent before the
     call and the result after it, including when the call raised.
  4. No secret is ever written to the audit log; values under credential-like
     key names are redacted before a line is written.
  5. Nothing about delivery is stored. Pending is derived on every pass, and
     a key found in the recipient's transcript or v2 inbox is never delivered
     again (docs/switchboard.md, Invariants 1 and 2).

Python 3.9+, standard library only.
"""
import argparse
from contextlib import contextmanager
from datetime import datetime, timezone
import fcntl
import hashlib
import hmac
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import json
import os
from pathlib import Path
import re
import secrets
import select
import signal
import socket
import subprocess
import sys
import threading
import time
import uuid

VERSION = "0.1.0"
PROG = "fleet-switchboard"

EXIT_OK = 0
EXIT_ERROR = 1
EXIT_USAGE = 2
EXIT_HELD = 3   # `send`: the delivery rule says hold; nothing was sent
EXIT_CRASH = 70  # the `crash-after-send` fault stopped the process, as a crash would

# ------------------------------------------------------------------ the config

DEFAULTS = {
    # No default: the v2 binary must be named by absolute path. A bare name is
    # resolved through PATH, and a shell's PATH can find the OpenCode v1 binary
    # instead; the Lab hit exactly that.
    "opencode": None,
    "opencode_env": {},
    # The program that actually runs in a pane, when `opencode` is a wrapper
    # that execs something else (the Lab). None: `opencode` itself.
    "opencode_executable": None,
    # Extra environment for the TUI `launch` starts, beside opencode_env.
    "launch_env": {},
    "herdr": "herdr",
    "batch_seconds": 90,
    "engaged_minutes": 10,
    "call_timeout_seconds": 20,
    "poll_seconds": 5,
    "worker_lookback_hours": 24,  # how far back a worker's finished turn still counts (PR 4)
    # GitHub events (PR 5)
    "github_repos": [],
    "gh": "gh",
    "github_lookback_hours": 24,
    "github_events": ["issues", "issue_comment", "sub_issues", "pull_request", "pull_request_review",
                      "check_suite", "workflow_run"],
    "github_port": None,
}

HERDR_CALL_TIMEOUT = 15  # seconds; herdr answers locally or not at all


class ConfigError(Exception):
    """The config, or the state directory, cannot be used as it is."""


def _xdg(variable, fallback):
    """An XDG base directory. A relative value is ignored, as the spec says."""
    value = os.environ.get(variable)
    if value and os.path.isabs(value):
        return Path(value)
    return Path.home() / fallback


def config_path():
    return _xdg("XDG_CONFIG_HOME", ".config") / PROG / "config.json"


def state_dir_path():
    return _xdg("XDG_STATE_HOME", ".local/state") / PROG


def _is_number(value):
    return isinstance(value, (int, float)) and not isinstance(value, bool)


def validate_config(raw, source="config"):
    """Defaults overlaid with `raw`, fully checked. Raises ConfigError."""
    if not isinstance(raw, dict):
        raise ConfigError("%s must be a JSON object" % source)
    unknown = sorted(set(raw) - set(DEFAULTS) - set(PR7_CONFIG_KEYS))
    if unknown:
        raise ConfigError(
            "%s contains key(s) this tool does not read: %s. "
            "A setting that is silently ignored is worse than a missing one."
            % (source, ", ".join(unknown)))
    config = dict(DEFAULTS)
    config["opencode_env"], config["launch_env"] = {}, {}
    config.update(raw)
    opencode = config["opencode"]
    if opencode is not None and (not isinstance(opencode, str) or not os.path.isabs(opencode)):
        raise ConfigError("%s: 'opencode' must be the absolute path of the OpenCode v2 binary, got %r"
                          % (source, opencode))
    if not isinstance(config["herdr"], str) or not config["herdr"].strip():
        raise ConfigError("%s: 'herdr' must be a non-empty string (a path or a command name), got %r"
                          % (source, config["herdr"]))
    executable = config["opencode_executable"]
    if executable is not None and (not isinstance(executable, str) or not os.path.isabs(executable)):
        raise ConfigError("%s: 'opencode_executable' must be an absolute path, got %r" % (source, executable))
    envs = {}
    for key in ("opencode_env", "launch_env"):
        env = config[key]
        if not isinstance(env, dict):
            raise ConfigError("%s: %r must be an object of NAME: value strings, got %r"
                              % (source, key, type(env).__name__))
        for name, value in env.items():
            if not re.match(r"^[A-Za-z_][A-Za-z0-9_]*$", name):
                raise ConfigError("%s: %r has an invalid variable name: %r" % (source, key, name))
            if not isinstance(value, str):
                raise ConfigError("%s: %r value for %s must be a string" % (source, key, name))
        envs[key] = dict(env)
    for key in ("batch_seconds", "engaged_minutes", "call_timeout_seconds", "poll_seconds",
                "worker_lookback_hours"):
        if not _is_number(config[key]) or config[key] <= 0:
            raise ConfigError("%s: %r must be a positive number, got %r" % (source, key, config[key]))
    validate_intent_config(config, source)
    _validate_github(config, source)
    config.update(envs)
    validate_jev_config(config, raw, source)
    validate_foreground_config(config, source)  # PR 8
    validate_policy_config(config, source)  # PR 9
    return config


def load_config(path=None):
    """Read config.json. A missing file means every default applies."""
    path = Path(path) if path else config_path()
    try:
        text = path.read_text()
    except FileNotFoundError:
        return validate_config({}, str(path))
    except OSError as err:
        raise ConfigError("cannot read %s: %s" % (path, err.strerror or err))
    try:
        raw = json.loads(text)
    except ValueError as err:
        raise ConfigError("%s is not valid JSON: %s" % (path, err))
    return validate_config(raw, str(path))


# ------------------------------------------------------------------- the state

def ensure_state_dir(path=None):
    """Create the state directory with mode 0700, or check the existing one.

    It holds the audit log, which records who was sent what. A directory that
    someone else owns, or that the group or world can read, is refused rather
    than repaired: something changed it, and that deserves a person's look.
    """
    path = Path(path) if path else state_dir_path()
    if not path.exists():
        path.mkdir(parents=True, mode=0o700)
        os.chmod(str(path), 0o700)  # mkdir's mode is filtered by the umask
    info = path.stat()
    if not path.is_dir():
        raise ConfigError("state path is not a directory: %s" % path)
    if info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise ConfigError("state directory must be private (mode 0700, owned by you): %s" % path)
    return path


# ------------------------------------------------------------------ the faults

# Each fault switches one safeguard off, so a scenario's control can prove the
# safeguard is what makes the scenario pass. They work only in the Lab.
KNOWN_FAULTS = (
    "no-engagement-gate",
    "no-recheck",
    "no-dedupe",
    "steer-not-queue",
    "no-batch",
    "no-intent-header",
    "no-classify",
    "crash-after-send",
    "no-policy-judge",
    "judge-loosens",
    "no-maxims",
    "no-worker-source",
    "no-note-conversion",
)

LAB_ENV = "FLEET_SWITCHBOARD_LAB"
FAULT_ENV = "FLEET_SWITCHBOARD_FAULT"


class FaultError(Exception):
    """A fault name nobody defined. A typo here would make a control prove nothing."""


def active_faults():
    """The fault names requested in the environment, checked, as a sorted list."""
    raw = os.environ.get(FAULT_ENV, "")
    names = sorted({part.strip() for part in raw.split(",") if part.strip()})
    unknown = [name for name in names if name not in KNOWN_FAULTS]
    if unknown:
        raise FaultError("%s names unknown fault(s): %s (known: %s)"
                         % (FAULT_ENV, ", ".join(unknown), ", ".join(KNOWN_FAULTS)))
    return names


def fault(name):
    """True only in the Lab, and only for a fault named in the environment."""
    if name not in KNOWN_FAULTS:
        raise FaultError("unknown fault: %r" % name)
    requested = active_faults()
    return os.environ.get(LAB_ENV) == "1" and name in requested


class SimulatedCrash(BaseException):
    """The `crash-after-send` fault: the process stops here, as if killed.

    A BaseException, so no per-agent `except Exception` in the pass catches
    it, and AuditLog.external lets it through without writing a result: a
    crashed process writes nothing after the crash. Scenario R2 is built on it.
    """


# ------------------------------------------------------------- the message id

def derive_message_id(recipient, keys):
    """The v2 message id for a delivery: the recipient plus the keys it covers.

    A retry after a crash derives the same id, and v2 admits a repeated id
    once, so a message is delivered at most once (invariant 3). Order and
    duplicates in `keys` do not change the id.
    """
    if not isinstance(recipient, str) or not recipient:
        raise ValueError("recipient must be a non-empty string")
    keys = list(keys)
    if not keys or not all(isinstance(key, str) and key for key in keys):
        raise ValueError("keys must be a non-empty list of non-empty strings")
    canonical = json.dumps([recipient, sorted(set(keys))], separators=(",", ":"), ensure_ascii=False)
    return "msg_" + hashlib.sha256(canonical.encode("utf-8")).hexdigest()[:26]


# ----------------------------------------------------------------- the audit

SENSITIVE = ("token", "key", "password", "secret", "authorization")
REDACTED = "[redacted]"


def _sensitive(name):
    lowered = str(name).lower()
    # `keys` is the list of fact names a message covers (docs/switchboard.md
    # §Data), such as `worker.idle:<session>:<time>`. It is the one thing the
    # audit must show about a delivery, and it never holds a credential.
    if lowered == "keys":
        return False
    return any(word in lowered for word in SENSITIVE)


def redact(value):
    """A copy of `value` with every credential-like key's value replaced."""
    if isinstance(value, dict):
        return {k: (REDACTED if _sensitive(k) else redact(v)) for k, v in value.items()}
    if isinstance(value, (list, tuple)):
        return [redact(v) for v in value]
    return value


def utc_now():
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


class AuditLog:
    """Append-only JSON lines. Never read by a decision; written before and after."""

    def __init__(self, path):
        self.path = Path(path)

    def append(self, actor, event, subject=None, detail=None, **extra):
        entry = {"ts": utc_now(), "actor": actor, "event": event,
                 "subject": subject, "detail": redact(detail)}
        entry.update(redact(extra))
        line = json.dumps(entry, sort_keys=True, default=str) + "\n"
        fd = os.open(str(self.path), os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
        with os.fdopen(fd, "a") as handle:
            handle.write(line)
            handle.flush()
            os.fsync(handle.fileno())
        return entry

    @contextmanager
    def external(self, actor, event, subject=None, detail=None):
        """Audit one write to another system: `intent` before, `result` after.

        Yields a dict the caller may fill with what came back; it becomes the
        result entry's detail. An exception is recorded, then re-raised. A
        SimulatedCrash is re-raised with nothing recorded, as a real crash.
        """
        call = uuid.uuid4().hex[:12]
        self.append(actor, event, subject, detail, phase="intent", call=call)
        outcome = {}
        try:
            yield outcome
        except SimulatedCrash:
            raise
        except BaseException as err:
            self.append(actor, event, subject, outcome or None, phase="result", call=call,
                        ok=False, error="%s: %s" % (type(err).__name__, err))
            raise
        self.append(actor, event, subject, outcome or None, phase="result", call=call, ok=True)


# ------------------------------------------------------------- OpenCode v2

class V2Error(Exception):
    """A v2 call that did not return usable JSON.

    reason: "http" (v2 answered with an HTTP error), "exit" (non-zero exit, no
    HTTP status), "timeout", "bad_json" or "unavailable" (could not run).
    """

    def __init__(self, reason, status=None, detail=None):
        self.reason = reason
        self.status = status
        self.detail = detail
        text = reason if status is None else "%s %s" % (reason, status)
        super().__init__("%s: %s" % (text, detail) if detail else text)


def _one_line(text, limit=300):
    text = " ".join((text or "").split())
    return text if len(text) <= limit else text[:limit - 1] + "\u2026"


CURSOR_LIMIT = 2000  # characters of one v2 cursor token we will pass back on an argv
MAX_READ_PAGES = 5   # pages of READ_LIMIT messages `delivered_keys` reads before it holds


class V2Client:
    """The one client for OpenCode v2. Every call is `<binary> api <operation>`."""

    DELIVERIES = ("queue", "steer")
    ORDERS = ("desc", "asc")

    def __init__(self, binary, env=None, runner=subprocess.run, timeout=20):
        self.binary = binary
        self.env = dict(env or {})
        self.runner = runner
        self.timeout = timeout

    def _call(self, operation, params=None, data=None, envelope=False):
        argv = [self.binary, "api", operation]
        for name, value in (params or {}).items():
            if value is not None:
                argv += ["--param", "%s=%s" % (name, value)]
        if data is not None:
            argv += ["-d", json.dumps(data, separators=(",", ":"), sort_keys=True)]
        env = dict(os.environ)
        env.update(self.env)
        try:
            result = self.runner(argv, capture_output=True, text=True, timeout=self.timeout,
                                 env=env, stdin=subprocess.DEVNULL)
        except subprocess.TimeoutExpired:
            raise V2Error("timeout", None, "%s did not answer within %ss" % (operation, self.timeout)) from None
        except OSError as err:
            raise V2Error("unavailable", None, "cannot run %s: %s" % (self.binary, err.strerror or err)) from None
        stdout = result.stdout or ""
        stderr = result.stderr or ""
        if result.returncode != 0:
            match = re.search(r"\bHTTP (\d{3})\b", stderr)
            if match:
                # v2 put the error body on stdout and `HTTP <code> <reason>` on stderr.
                raise V2Error("http", int(match.group(1)), _one_line(stdout) or _one_line(stderr))
            raise V2Error("exit", None, _one_line(stderr) or _one_line(stdout) or "exit %d" % result.returncode)
        if not stdout.strip():
            return None
        try:
            body = json.loads(stdout)
        except ValueError:
            raise V2Error("bad_json", None, "%s returned non-JSON: %s" % (operation, _one_line(stdout, 120))) from None
        if isinstance(body, dict) and "data" in body:
            return body if envelope else body["data"]  # PR 8: paging needs the cursor beside the data
        return body

    def server_info(self):
        return self._call("server.info")

    def session_create(self, agent, title, directory, metadata, permissions=None):
        if not os.path.isabs(directory):
            raise ValueError("directory must be absolute: %r" % directory)
        data = {"agent": agent, "title": title, "location": {"directory": directory},
                "metadata": metadata}
        if permissions is not None:
            data["permissions"] = permissions
        return self._call("session.create", data=data)

    def session_get(self, session_id):
        return self._call("session.get", {"sessionID": session_id})

    def session_active(self):
        return self._call("session.active")

    def message_list(self, session_id, limit=None, order=None, type=None, cursor=None):
        if order is not None and order not in self.ORDERS:
            raise ValueError("order must be one of %s" % ", ".join(self.ORDERS))
        return self._call("session.message.list", {
            "sessionID": session_id, "limit": limit, "order": order, "type": type, "cursor": cursor})

    def message_page(self, session_id, limit=None, type=None, cursor=None):
        """PR 8: one page of `session.message.list` with its cursor: (messages, cursor).

        `cursor` is v2's `{"previous": .., "next": ..}` object, or None when the
        answer carries none. A cursor argument is v2's opaque token and fixes the
        order, so no `order` is taken here (v2: do not combine them).
        """
        if cursor is not None and (not isinstance(cursor, str) or not cursor or len(cursor) > CURSOR_LIMIT):
            raise ValueError("cursor must be v2's opaque token (a non-empty string), got %r" % (cursor,))
        body = self._call("session.message.list", {
            "sessionID": session_id, "limit": limit, "type": type, "cursor": cursor}, envelope=True)
        if isinstance(body, dict):
            found = body.get("cursor")
            return (body["data"] if isinstance(body.get("data"), list) else []), \
                (found if isinstance(found, dict) else None)
        return (body if isinstance(body, list) else []), None

    def message_pages(self, session_id, limit, type=None, max_pages=1):
        """PR 8: the pages of one listing, newest first, following `cursor.next`.

        UNVERIFIED: that `next` moves to older messages in a newest-first
        listing; the Lab's paging spike must show it. Yields (messages, more):
        `more` is True while v2 names a next cursor, False when it says there is
        none, None when the answer carries no cursor at all. The walk ends after
        a False or None, or after `max_pages`. A continuation that is empty or
        repeats a message already seen means the cursor does not walk the
        listing as assumed: that raises, and the caller holds.
        """
        cursor, seen = None, set()
        for number in range(max_pages):
            page, found = self.message_page(session_id, limit, type, cursor)
            ids = [m.get("id") for m in page if isinstance(m, dict)]
            if number and (not page or any(i in seen for i in ids)):
                raise V2Error("bad_json", None, "session.message.list: the next page was empty or repeated "
                                                "a message; the cursor does not walk older as assumed")
            seen.update(ids)
            cursor = found.get("next") if found else None
            more = None if found is None else bool(cursor)
            yield page, more
            if not more:
                return

    def synthetic(self, session_id, text, metadata, resume, delivery, message_id):
        if not isinstance(resume, bool):
            raise ValueError("resume must be true or false")
        if delivery not in self.DELIVERIES:
            raise ValueError("delivery must be one of %s" % ", ".join(self.DELIVERIES))
        if not isinstance(message_id, str) or not message_id.startswith("msg_"):
            raise ValueError("message id must start with msg_: %r" % message_id)
        return self._call("session.synthetic", {"sessionID": session_id}, {
            "id": message_id, "text": text, "metadata": metadata,
            "resume": resume, "delivery": delivery})

    def prompt(self, session_id, text, metadata=None, delivery=None, resume=None):
        if delivery is not None and delivery not in self.DELIVERIES:
            raise ValueError("delivery must be one of %s" % ", ".join(self.DELIVERIES))
        data = {"text": text}
        for name, value in (("metadata", metadata), ("delivery", delivery), ("resume", resume)):
            if value is not None:
                data[name] = value
        return self._call("session.prompt", {"sessionID": session_id}, data)

    def inbox_list(self, session_id):
        return self._call("session.inbox.list", {"sessionID": session_id})

    def permission_list(self, session_id):
        """The session's pending permission requests (S2: `session.permission.list`
        works with the session id alone; `permission.request.list` needs a location)."""
        return self._call("session.permission.list", {"sessionID": session_id})

    def form_list(self, session_id):
        """The session's pending forms (questions). UNVERIFIED: the operation name is
        a guess from `form.list` in the design; no spike has run it."""
        return self._call("session.form.list", {"sessionID": session_id})

    def inbox_update(self, session_id, inbox_id, delivery):
        if delivery not in self.DELIVERIES:
            raise ValueError("delivery must be one of %s" % ", ".join(self.DELIVERIES))
        return self._call("session.inbox.update", {"sessionID": session_id, "inboxID": inbox_id},
                          {"delivery": delivery})


# ------------------------------------------------------------------- herdr

class HerdrError(Exception):
    """A herdr call that did not return usable JSON."""

    def __init__(self, reason, detail=None):
        self.reason = reason
        self.detail = detail
        super().__init__("%s: %s" % (reason, detail) if detail else reason)


def herdr_socket_path(environ=None):
    """Where herdr listens: $HERDR_SOCKET_PATH, else herdr.sock in its config directory."""
    environ = os.environ if environ is None else environ
    if environ.get("HERDR_SOCKET_PATH"):
        return environ["HERDR_SOCKET_PATH"]
    base = environ.get("XDG_CONFIG_HOME")
    root = Path(base) if base and os.path.isabs(base) else Path.home() / ".config"
    return str(root / "herdr" / "herdr.sock")


def unix_socket_call(path, method, params, timeout=HERDR_CALL_TIMEOUT):
    """One request to herdr's socket API: a JSON line out, a JSON line back."""
    request = json.dumps({"id": "%s:%s" % (PROG, method), "method": method, "params": params},
                         separators=(",", ":")) + "\n"
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as conn:
            conn.settimeout(timeout)
            conn.connect(path)
            conn.sendall(request.encode("utf-8"))
            reply = b""
            while not reply.endswith(b"\n"):
                chunk = conn.recv(65536)
                if not chunk:
                    break
                reply += chunk
    except socket.timeout:
        raise HerdrError("timeout", "herdr's socket did not answer within %ss" % timeout) from None
    except OSError as err:
        raise HerdrError("unavailable", "cannot reach herdr's socket %s: %s" % (path, err.strerror or err)) from None
    try:
        return json.loads(reply.decode("utf-8"))
    except ValueError:
        raise HerdrError("bad_json", "herdr's socket returned non-JSON: %s" % _one_line(reply.decode("utf-8", "replace"), 120)) from None


TOKEN_NAME = re.compile(r"^[A-Za-z0-9_-]{1,32}$")
TOKEN_VALUE_MAX = 80
TITLE_MAX, BODY_MAX = 80, 240  # herdr's own caps on a toast


class HerdrClient:
    """Reads agents and panes, sets a badge, shows a toast, opens a tab that
    runs a program directly, and closes a pane `launch` itself opened.

    herdr is never a delivery channel (docs/switchboard.md, the herdr table's
    "never" row). This class deliberately has no method that types into a pane
    or moves focus, and no general way to run an arbitrary herdr command. Its
    one socket method, `layout.apply`, execs a program with argv in a new pane:
    there is no shell, so nothing is typed, and no focus key is ever sent.
    """

    SOURCE = PROG
    SOCKET_METHODS = ("layout.apply",)

    def __init__(self, binary, runner=subprocess.run, timeout=HERDR_CALL_TIMEOUT, socket_call=None,
                 socket_path=None):
        self.binary = binary
        self.runner = runner
        self.timeout = timeout
        self.socket_call = socket_call or unix_socket_call
        self.socket_path = socket_path

    def _call(self, *args):
        argv = [self.binary, *args]
        try:
            result = self.runner(argv, capture_output=True, text=True, timeout=self.timeout,
                                 stdin=subprocess.DEVNULL)
        except subprocess.TimeoutExpired:
            raise HerdrError("timeout", "herdr did not answer within %ss" % self.timeout) from None
        except OSError as err:
            raise HerdrError("unavailable", "cannot run %s: %s" % (self.binary, err.strerror or err)) from None
        if result.returncode != 0:
            raise HerdrError("exit", _one_line(result.stderr) or _one_line(result.stdout)
                             or "exit %d" % result.returncode)
        if not (result.stdout or "").strip():
            return None
        try:
            return json.loads(result.stdout)
        except ValueError:
            raise HerdrError("bad_json", "herdr returned non-JSON: %s" % _one_line(result.stdout, 120)) from None

    def _socket(self, method, params):
        if method not in self.SOCKET_METHODS:
            raise ValueError("herdr socket method not allowed: %r" % method)
        reply = self.socket_call(self.socket_path or herdr_socket_path(), method, params, self.timeout)
        if isinstance(reply, dict) and reply.get("error"):
            raise HerdrError("exit", _one_line(json.dumps(reply["error"], sort_keys=True)))
        return reply

    @staticmethod
    def _result(body, field, kind):
        value = (body or {}).get("result", {}).get(field) if isinstance(body, dict) else None
        if not isinstance(value, kind):
            raise HerdrError("bad_shape", "expected result.%s in herdr's reply" % field)
        return value

    def agent_list(self):
        return self._result(self._call("agent", "list"), "agents", list)

    def agent_get(self, target):
        return self._result(self._call("agent", "get", target), "agent", dict)

    def pane_process_info(self, pane):
        """The foreground processes of a pane: [{"cmdline": ..., "name": ...}, ...]."""
        info = self._result(self._call("pane", "process-info", "--pane", pane), "process_info", dict)
        processes = info.get("foreground_processes")
        if not isinstance(processes, list):
            raise HerdrError("bad_shape", "expected foreground_processes in herdr's reply")
        return [p for p in processes if isinstance(p, dict)]

    def pane_report_metadata_token(self, pane, name, value, ttl_ms=None):
        if not TOKEN_NAME.match(str(name)):
            raise ValueError("token name must match %s: %r" % (TOKEN_NAME.pattern, name))
        value = str(value)
        if not value.strip() or len(value) > TOKEN_VALUE_MAX:
            raise ValueError("token value must be 1-%d characters" % TOKEN_VALUE_MAX)
        args = ["pane", "report-metadata", pane, "--source", self.SOURCE, "--token", "%s=%s" % (name, value)]
        if ttl_ms is not None:
            args += ["--ttl-ms", str(int(ttl_ms))]
        return self._call(*args)

    def pane_clear_token(self, pane, name):
        if not TOKEN_NAME.match(str(name)):
            raise ValueError("token name must match %s: %r" % (TOKEN_NAME.pattern, name))
        return self._call("pane", "report-metadata", pane, "--source", self.SOURCE, "--clear-token", name)

    def notification_show(self, title, body=None):
        """Show a toast. Returns {"shown": bool, "reason": ...}: herdr answers
        even when it shows nothing (rate_limited, busy, no_foreground_client, disabled)."""
        args = ["notification", "show", str(title)[:TITLE_MAX]]
        if body:
            args += ["--body", str(body)[:BODY_MAX]]
        body = self._call(*args)
        shown = self._result(body, "shown", bool)
        reason = body["result"].get("reason")
        return {"shown": shown, "reason": reason if isinstance(reason, str) else None}

    def pane_close(self, pane):
        return self._call("pane", "close", pane)

    def open_tab_running(self, workspace, label, cwd, argv, env):
        """A new tab in `workspace` whose one pane execs `argv` directly. Never
        types, never takes focus. Returns {"tab_id", "pane_id"}."""
        reply = self._socket("layout.apply", {
            "workspace_id": workspace, "tab_label": label,
            "root": {"type": "pane", "label": label, "cwd": cwd, "command": list(argv), "env": dict(env)}})
        layout = (reply or {}).get("result", {}).get("layout") if isinstance(reply, dict) else None
        root = layout.get("root") if isinstance(layout, dict) else None
        pane, tab = (root or {}).get("pane_id"), layout.get("tab_id") if isinstance(layout, dict) else None
        if not isinstance(pane, str) or not isinstance(tab, str):
            raise HerdrError("bad_shape", "expected layout.tab_id and layout.root.pane_id in herdr's reply")
        return {"tab_id": tab, "pane_id": pane}


# ------------------------------------------------------------------ the facts

class FactError(ValueError):
    """A fact that cannot be used: a missing field, or a value of the wrong type."""


class Fact:
    """Something one fleet agent should be told.

    `key` names the source fact, such as `send:<from>:<id>` or `lab.fact:<id>`.
    It is what makes delivery idempotent: every message lists the keys it
    covers, and a key found in the recipient's transcript or inbox is never
    delivered again. `created` is epoch seconds. `batch` false skips the batch
    window, as `send` does.
    """

    FIELDS = ("key", "recipient", "kind", "summary", "created", "issue", "batch", "sender")

    def __init__(self, key, recipient, kind, summary, created, issue=None, batch=True, sender=None):
        for name, value in (("key", key), ("recipient", recipient), ("kind", kind)):
            if not isinstance(value, str) or not value.strip():
                raise FactError("fact %s must be a non-empty string, got %r" % (name, value))
        if not isinstance(summary, str):
            raise FactError("fact summary must be a string, got %r" % (summary,))
        if not _is_number(created):
            raise FactError("fact created must be epoch seconds, got %r" % (created,))
        if issue is not None and not (isinstance(issue, int) and not isinstance(issue, bool) and issue >= 1):
            raise FactError("fact issue must be an issue number, got %r" % (issue,))
        if not isinstance(batch, bool):
            raise FactError("fact batch must be true or false, got %r" % (batch,))
        if sender is not None and not isinstance(sender, str):
            raise FactError("fact from must be a string, got %r" % (sender,))
        self.key, self.recipient, self.kind, self.summary = key, recipient, kind, summary
        self.created, self.issue, self.batch, self.sender = float(created), issue, batch, sender

    @classmethod
    def from_json(cls, obj):
        if not isinstance(obj, dict):
            raise FactError("a fact must be a JSON object")
        unknown = sorted(set(obj) - {"key", "recipient", "kind", "summary", "created", "issue", "batch", "from"})
        if unknown:
            raise FactError("fact has unknown field(s): %s" % ", ".join(unknown))
        missing = [name for name in ("key", "recipient", "kind", "summary", "created") if name not in obj]
        if missing:
            raise FactError("fact is missing: %s" % ", ".join(missing))
        return cls(obj["key"], obj["recipient"], obj["kind"], obj["summary"], obj["created"],
                   obj.get("issue"), obj.get("batch", True), obj.get("from"))

    def to_json(self):
        return {"key": self.key, "recipient": self.recipient, "kind": self.kind, "summary": self.summary,
                "created": self.created, "issue": self.issue, "batch": self.batch, "from": self.sender}

    def __repr__(self):
        return "Fact(%r -> %r)" % (self.key, self.recipient)


LAB_FACTS = "lab-facts.jsonl"


def lab_fact_source(state_dir):
    """The Lab's test seam: facts a scenario runner appends to $STATE/lab-facts.jsonl.

    One JSON object per line, in Fact.to_json's shape. Read only when
    FLEET_SWITCHBOARD_LAB=1; anywhere else it yields nothing, so a stray file
    can never cause a delivery. A bad line fails the whole source, loudly: in
    the Lab a typo must not quietly drop a fact.
    """
    path = Path(state_dir) / LAB_FACTS

    def lab_facts():
        if os.environ.get(LAB_ENV) != "1":
            return []
        try:
            text = path.read_text()
        except FileNotFoundError:
            return []
        facts = []
        for number, line in enumerate(text.splitlines(), 1):
            if not line.strip():
                continue
            try:
                facts.append(Fact.from_json(json.loads(line)))
            except ValueError as err:
                raise FactError("%s:%d: %s" % (path, number, err)) from None
        return facts

    return lab_facts


def fact_sources(state_dir):
    """Every fact source, in order: callables that each return a list of Facts.

    The one registration point. Worker facts (PR 4), GitHub facts (PR 5) and
    reminders join this list. `send` is not a source: it delivers directly, by
    the same rule, and stores nothing.
    """
    return [lab_fact_source(state_dir), WorkerFacts(), ReminderFacts(state_dir), ForegroundFacts()]


# --------------------------------------------------------- observing the fleet

# herdr's agent_status -> the switchboard's. `done` is idle that you have not
# looked at yet; anything not listed is unknown, and unknown holds.
STATUS = {"working": "working", "idle": "idle", "done": "idle", "blocked": "blocked"}

READ_LIMIT = 200    # transcript messages per read, newest first
SINCE_SLACK = 60    # seconds read back beyond the oldest fact, for clock skew
MESSAGE_CAP = 4000  # characters in one delivered message
HELD_TOAST_AFTER = 15 * 60  # seconds an item is held before you get a toast


def agent_session(entry):
    """The v2 session id a herdr agent entry names, or None.

    herdr 0.9 reports `agent_session` as an object, `{"kind": "id", "value":
    "ses_..."}` (S6); a plain string is accepted too.
    """
    value = entry.get("agent_session") if isinstance(entry, dict) else None
    if isinstance(value, dict):
        value = value.get("value") if value.get("kind", "id") == "id" else None
    return value if isinstance(value, str) and value else None


def runs_program(cmdline, executable):
    """True when a process command line is `executable`, alone or with arguments."""
    if not isinstance(cmdline, str) or not executable:
        return False
    return cmdline == executable or cmdline.startswith(executable + " ")


def _seconds(value):
    """v2 time (epoch milliseconds, or seconds) -> epoch seconds; None if absent."""
    if not _is_number(value):
        return None
    return value / 1000.0 if value > 1e11 else float(value)


def _fleet_meta(record):
    """`metadata.fleet` of a v2 record: a message has `metadata` at the top;
    an inbox item (session.inbox.list, 2.0.22) has it under `payload`."""
    if not isinstance(record, dict):
        return None
    meta = record.get("metadata")
    if meta is None and isinstance(record.get("payload"), dict):
        meta = record["payload"].get("metadata")
    fleet = meta.get("fleet") if isinstance(meta, dict) else None
    return fleet if isinstance(fleet, dict) else None


def _fleet_keys(record):
    keys = (_fleet_meta(record) or {}).get("keys")
    return [key for key in keys if isinstance(key, str)] if isinstance(keys, list) else []


def _created(record):
    times = record.get("time") if isinstance(record, dict) else None
    return _seconds(times.get("created")) if isinstance(times, dict) else None


def iso(epoch):
    if epoch is None:
        return None
    return datetime.fromtimestamp(epoch, timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


class Observation:
    """One fleet agent as observed now: herdr's status, v2's session.

    `last_human_prompt` is the time of your newest prompt within the
    engagement window, or None when there is none in it. `problem` is set
    when something needed for a decision could not be read; it holds.
    """

    def __init__(self, name, session_id, pane, status, fleet, idle_at=None, outcome=None,
                 last_human_prompt=None, problem=None):
        self.name, self.session_id, self.pane, self.status = name, session_id, pane, status
        self.fleet, self.idle_at, self.outcome = fleet, idle_at, outcome
        self.last_human_prompt, self.problem = last_human_prompt, problem
        self.wrong_program = False  # the pane runs something other than the configured v2
        self.conflict = []  # other sessions that claim the same name

    def engaged(self, now, window):
        """You prompted this agent within `window` seconds. Off under `no-engagement-gate`."""
        if fault("no-engagement-gate"):
            return False
        return self.last_human_prompt is not None and now - self.last_human_prompt < window

    def to_json(self):
        return {"name": self.name, "session": self.session_id, "pane": self.pane, "status": self.status,
                "fleet": self.fleet, "idle_at": iso(self.idle_at), "outcome": self.outcome,
                "last_human_prompt": iso(self.last_human_prompt), "problem": self.problem,
                "wrong_program": self.wrong_program, "conflict": self.conflict}


class Discovery:
    """Every fleet agent found in one look, by name, and what got in the way."""

    def __init__(self):
        self.agents = {}
        self.problems = []
        self.entries = []  # herdr's agent list as read, so render can compare tokens

    def add(self, observation):
        known = self.agents.get(observation.name)
        if known is None:
            self.agents[observation.name] = observation
        elif known.session_id != observation.session_id and observation.session_id not in known.conflict:
            known.conflict.append(observation.session_id)

    def missing(self, name):
        """Why `name` has no observation: not running, or something unreadable."""
        if self.problems:
            return "%s not found; %s" % (name, "; ".join(self.problems))
        return "%s not found: no herdr pane shows a v2 session named %s" % (name, name)


# ------------------------------------------------------------ the decision

class Plan:
    """What the delivery rule says for one recipient now.

    action: "wait" (batching), "hold" (reason says why), "note" or "wake".
    """

    def __init__(self, recipient, action, reason, pending, observation=None, ready_at=None):
        self.recipient, self.action, self.reason = recipient, action, reason
        self.pending, self.observation, self.ready_at = pending, observation, ready_at

    def to_json(self):
        return {"recipient": self.recipient, "action": self.action, "reason": self.reason,
                "ready_at": iso(self.ready_at), "pending": [fact.to_json() for fact in self.pending]}


def hold_reason(observation, missing=None):
    """Why nothing may be written to this agent now, or None."""
    if observation is None:
        return missing or "not found"
    if observation.conflict:
        return "%s is claimed by more than one session (%s); fix the fleet metadata" % (
            observation.name, ", ".join([observation.session_id] + observation.conflict))
    if observation.problem:
        return observation.problem
    if observation.status == "blocked":
        return "%s is blocked on a permission request or a question" % observation.name
    if observation.status not in ("idle", "working"):
        return "%s has status %s in herdr" % (observation.name, observation.status)
    return None


def decide(recipient, pending, observation, now, batch_seconds, engaged_seconds, missing=None):
    """The delivery rule for one recipient's pending facts. Reads nothing; writes nothing.

    Batch: wait until the oldest pending fact is `batch_seconds` old, unless a
    pending fact skips batching (`send`), or under `no-batch`. Then hold if
    the agent is gone, blocked, unknown or unreadable; else a note if you are
    engaged with it, else a wake.
    """
    pending = sorted(pending, key=lambda fact: (fact.created, fact.key))
    if not pending:
        return None
    if not fault("no-batch") and all(fact.batch for fact in pending):
        ready_at = pending[0].created + batch_seconds
        if now < ready_at:
            return Plan(recipient, "wait", "batching until %s" % iso(ready_at), pending, observation, ready_at)
    reason = hold_reason(observation, missing)
    if reason:
        return Plan(recipient, "hold", reason, pending, observation)
    if observation.engaged(now, engaged_seconds):
        return Plan(recipient, "note", "you prompted %s at %s" % (recipient, iso(observation.last_human_prompt)),
                    pending, observation)
    return Plan(recipient, "wake", "no prompt from you in the engagement window", pending, observation)


def compose(recipient, facts, cap=MESSAGE_CAP, section=None):
    """One message for `facts`, oldest first. Returns (text, the facts it carries).

    The first line names the count and the first item; each item follows in
    full. Items that do not fit under `cap` stay pending: the message ends with
    how many, and they go in the next message. A single item longer than the
    cap is cut, and says so. With `section` (PR 6, see sectioned_lines) every
    item that names an issue sits under its ask's Intent lines.
    """
    facts = sorted(facts, key=lambda fact: (fact.created, fact.key))
    if not facts:
        raise ValueError("nothing to compose")

    def item(fact):
        where = " (issue #%d)" % fact.issue if fact.issue else ""
        body = fact.summary.strip().replace("\n", "\n  ")
        return "- %s from %s%s: %s" % (fact.kind, fact.sender or "the fleet", where, body)

    def render(count):
        head = "[switchboard] %d for %s: %s" % (count, recipient, _one_line(facts[0].summary, 200))
        lines = [head] + (sectioned_lines(facts[:count], section, item) if section
                          else [item(fact) for fact in facts[:count]])
        rest = len(facts) - count
        if rest:
            lines.append("\u2026 and %d more: run fleet-switchboard pending %s" % (rest, recipient))
        return "\n".join(lines)

    for count in range(len(facts), 0, -1):
        text = render(count)
        if len(text) <= cap:
            return text, facts[:count]
    marker = "\n[cut at %d characters]" % cap
    return text[:cap - len(marker)] + marker, facts[:1]


# ---------------------------------------------------------------- the engine

class LockError(Exception):
    """Another `run` holds the single-instance lock."""


@contextmanager
def single_instance(state_dir):
    """Hold $STATE/run.lock for the life of the block, or raise LockError at once."""
    path = Path(state_dir) / "run.lock"
    fd = os.open(str(path), os.O_RDWR | os.O_CREAT, 0o600)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            holder = os.read(fd, 32).decode("ascii", "replace").strip() or "unknown"
            raise LockError("another %s run holds %s (pid %s)" % (PROG, path, holder)) from None
        os.ftruncate(fd, 0)
        os.write(fd, ("%d\n" % os.getpid()).encode("ascii"))
        yield path
    finally:
        os.close(fd)  # closing the descriptor releases the lock


class Switchboard:
    """observe -> derive -> decide -> deliver, for every fleet agent.

    Holds no delivery state. `now` is injected so tests run a simulated clock.
    `audit` None makes it read-only: `pending` and `status` use it that way,
    and any write then raises instead of happening unaudited.
    """

    def __init__(self, config, v2, herdr, audit, sources=(), now=time.time, actor="daemon", intents=None):
        self.config, self.v2, self.herdr, self.audit = config, v2, herdr, audit
        self.intents = intents  # an IntentReader (PR 6), or None when no ask repo is configured
        self.sources, self.now, self.actor = list(sources), now, actor
        self.batch_seconds = config["batch_seconds"]
        self.engaged_seconds = config["engaged_minutes"] * 60
        self.executable = config["opencode_executable"] or config["opencode"]
        self.toasted = {}  # agent -> the reason last toasted for it, so a steady reason toasts once
        self.pass_toasts = {}  # agent -> (reason, title, body) the pass itself found worth a toast (PR 4)
        self._last = {}  # (event, subject) -> detail last audited, so a steady hold is audited once
        self.discovery = None  # the newest discover(), for sources that read the fleet (PR 4)
        for source in self.sources:
            bind = getattr(source, "bind", None)
            if bind:
                bind(self)
        self.jev, self._classified = build_jev(config), set()  # PR 7: the decision model; messages classified

    # -- the audit

    def _external(self, event, subject, detail):
        if self.audit is None:
            raise RuntimeError("read-only switchboard asked to write: %s %s" % (event, subject))
        return self.audit.external(self.actor, event, subject, detail)

    def _note(self, event, subject, detail):
        """Audit a non-write event once per change, not once per pass."""
        if self.audit is None or self._last.get((event, subject)) == detail:
            return
        self._last[(event, subject)] = detail
        self.audit.append(self.actor, event, subject, detail)

    # -- observe

    def _messages(self, session_id):
        page = self.v2.message_list(session_id, limit=READ_LIMIT)  # newest first (S5)
        return page if isinstance(page, list) else []

    def last_human_prompt(self, session_id, now, inbox=False):
        """Your newest prompt in the engagement window: type `user` without `metadata.fleet`.
        `inbox` (a Chief of Staff, PR 8) also counts one still waiting in v2's inbox."""
        start = now - self.engaged_seconds
        if inbox:
            waiting = inbox_human_prompts(self, session_id)
            if waiting and (_created(waiting[0]) or 0) >= start:
                return _created(waiting[0])
        for message in self._messages(session_id):
            created = _created(message)
            if created is not None and created < start:
                break  # older than the window: stop reading
            if message.get("type") == "user" and _fleet_meta(message) is None:
                return created
        return None

    def _observe_entry(self, entry, now):
        """An Observation for one herdr agent, or None when it is not a fleet agent."""
        session_id = agent_session(entry)
        if session_id is None:
            return None
        info = self.v2.session_get(session_id) or {}
        fleet = _fleet_meta(info)
        if not fleet or not isinstance(fleet.get("name"), str) or not fleet["name"]:
            return None
        times = info.get("time") if isinstance(info.get("time"), dict) else {}
        observation = Observation(fleet["name"], session_id, entry.get("pane_id"),
                                  STATUS.get(entry.get("agent_status"), "unknown"), fleet,
                                  _seconds(times.get("idle")), info.get("outcome"))
        self.check_program(observation)
        if observation.problem:
            return observation
        try:
            observation.last_human_prompt = self.last_human_prompt(
                session_id, now, inbox=fleet.get("role") == "chief-of-staff")
        except V2Error as err:
            observation.problem = "cannot read %s's transcript: %s" % (observation.name, err)
        return observation

    def check_program(self, observation):
        """The restart hazard: after a herdr restart a pane may be a shell, and
        herdr resumes the agent by typing `opencode` into it, which can start
        another OpenCode. A pane whose process is not the configured v2 is held,
        and nothing is delivered to it. A pane that cannot be read is held too."""
        if not observation.pane:
            observation.problem = "%s has no herdr pane to check" % observation.name
            return
        try:
            programs = [p.get("cmdline") for p in self.herdr.pane_process_info(observation.pane)]
        except HerdrError as err:
            observation.problem = "cannot read what pane %s of %s runs: %s" % (observation.pane, observation.name, err)
            return
        if not any(runs_program(cmdline, self.executable) for cmdline in programs):
            observation.wrong_program = True
            observation.problem = "pane %s of %s runs a different opencode than the configured v2 (%s): %s" % (
                observation.pane, observation.name, self.executable,
                _one_line("; ".join(str(c) for c in programs), 120) or "nothing")

    def discover(self, now, entries=None):
        """Every fleet agent: a herdr agent whose v2 session carries `metadata.fleet.name`."""
        found = Discovery()
        self.discovery = found
        if entries is None:
            try:
                entries = self.herdr.agent_list()
            except HerdrError as err:
                found.problems.append("herdr unreachable: %s" % err)
                return found
        found.entries = [entry for entry in entries if isinstance(entry, dict)]
        for entry in entries:
            if not isinstance(entry, dict):
                continue
            try:
                observation = self._observe_entry(entry, now)
            except V2Error as err:
                if err.reason == "http" and err.status == 404:
                    continue  # the pane names a session v2 no longer has
                found.problems.append("v2 unreachable: %s" % err)
                continue
            if observation is not None:
                found.add(observation)
        return found

    def reobserve(self, previous, now):
        """The same agent, read again just before a write (invariant 4). (Observation, why-not)."""
        if not previous.pane:
            return None, "%s has no herdr pane to read again" % previous.name
        try:
            entry = self.herdr.agent_get(previous.pane)
        except HerdrError as err:
            return None, "pane %s of %s cannot be read: %s" % (previous.pane, previous.name, err)
        if agent_session(entry) != previous.session_id:
            return None, "pane %s no longer shows %s's session" % (previous.pane, previous.name)
        entry = dict(entry, pane_id=entry.get("pane_id") or previous.pane)
        try:
            fresh = self._observe_entry(entry, now)
        except V2Error as err:
            return None, "v2 unreachable: %s" % err
        if fresh is None or fresh.name != previous.name:
            return None, "session %s is no longer the fleet agent %s" % (previous.session_id, previous.name)
        fresh.conflict = list(previous.conflict)
        return fresh, None

    def _acknowledge(self, keys):
        """Tell the fact sources that hold items in memory (GitHub, PR 5) which keys are delivered."""
        for source in self.sources:
            acknowledge = getattr(source, "acknowledge", None)
            if acknowledge is not None:
                acknowledge(keys)

    # -- derive

    def collect_facts(self):
        """Every fact from every source, first key wins. A failing source is audited and skipped."""
        facts, seen, problems = [], set(), []
        for source in self.sources:
            name = getattr(source, "__name__", "source")
            try:
                found = source()
            except Exception as err:  # one bad source must not stop the others
                problems.append("%s: %s" % (name, _one_line(str(err))))
                self._note("source.error", name, {"error": _one_line(str(err))})
                continue
            for fact in found:
                if fact.key not in seen:
                    seen.add(fact.key)
                    facts.append(fact)
        return facts, problems

    def delivered_keys(self, session_id, since):
        """Keys already in the session: its messages since `since`, read newest
        first, plus its v2 inbox. Returns (keys, complete); not complete means
        the read ended before reaching `since`, so a key could be missed."""
        keys, complete = set(), False
        # Only synthetic messages carry keys; asking for just those keeps the read
        # short on a chatty recipient, which a 24 h worker look-back needs (PR 4).
        # PR 8: more than READ_LIMIT of them are read page by page, up to MAX_READ_PAGES.
        for page, more in self.v2.message_pages(session_id, READ_LIMIT, "synthetic", MAX_READ_PAGES):
            reached = False
            for message in page:
                created = _created(message)
                if created is not None and created < since:
                    reached = True
                    break
                keys.update(_fleet_keys(message))
            if reached or len(page) < READ_LIMIT or more is False:
                complete = True
            if complete:
                break
        inbox = self.v2.inbox_list(session_id)
        for item in inbox if isinstance(inbox, list) else []:
            keys.update(_fleet_keys(item))
        return keys, complete

    def plan(self, recipient, facts, discovery, now):
        """Pending = facts minus delivered keys, then the rule. None if nothing is pending."""
        observation = discovery.agents.get(recipient)
        if observation is None:
            return decide(recipient, facts, None, now, self.batch_seconds, self.engaged_seconds,
                          discovery.missing(recipient))
        pending = facts
        if not fault("no-dedupe"):
            since = min(fact.created - getattr(fact, "look_back", 0) for fact in facts) - SINCE_SLACK
            try:
                delivered, complete = self.delivered_keys(observation.session_id, since)
            except V2Error as err:
                return decide(recipient, facts, None, now, self.batch_seconds, self.engaged_seconds,
                              "cannot read what %s already has: %s" % (recipient, err))
            pending = [fact for fact in facts if fact.key not in delivered]
            self._acknowledge(delivered)
            if pending and not complete:
                return decide(recipient, pending, None, now, self.batch_seconds, self.engaged_seconds,
                              "the last %d messages of %s reach back less than to %s, so what it "
                              "already has is unknown" % (READ_LIMIT, recipient, iso(since)))
        return decide(recipient, pending, observation, now, self.batch_seconds, self.engaged_seconds)

    # -- deliver

    def deliver(self, plan):
        """Write one note or wake for `plan`, after observing the agent again.

        Returns {"sent": bool, ...}. When the fresh look no longer supports the
        plan, nothing is sent; the next pass decides again.
        """
        if plan.action not in ("note", "wake"):
            raise ValueError("nothing to deliver for action %r" % plan.action)
        observation = plan.observation
        if not fault("no-recheck"):
            fresh, why = self.reobserve(observation, self.now())
            again = decide(plan.recipient, plan.pending, fresh, self.now(), self.batch_seconds,
                           self.engaged_seconds, why)
            if again.action != plan.action:
                detail = {"was": plan.action, "now": again.action, "reason": again.reason,
                          "keys": [fact.key for fact in plan.pending]}
                if self.audit is not None:
                    self.audit.append(self.actor, "recheck", plan.recipient, detail)
                note_unreachable(self, plan.recipient, fresh, why)
                return {"sent": False, "action": again.action, "reason": again.reason}
            observation = fresh
        text, carried = compose(plan.recipient, plan.pending, section=section_resolver(self, observation))
        keys = [fact.key for fact in carried]
        # The id lives in v2's namespace, so it is derived from the session the
        # recipient runs now: a relaunched agent is a new recipient for v2.
        message_id = derive_message_id(observation.session_id, keys)
        resume = plan.action == "wake"
        delivery = "queue" if resume and not fault("steer-not-queue") else "steer"
        detail = {"mode": plan.action, "session": observation.session_id, "message_id": message_id,
                  "keys": keys, "resume": resume, "delivery": delivery, "left": len(plan.pending) - len(keys)}
        with self._external("v2.synthetic", plan.recipient, detail) as result:
            record = self.v2.synthetic(observation.session_id, text,
                                       {"fleet": {"keys": keys, "from": "switchboard"}},
                                       resume, delivery, message_id)
            if fault("crash-after-send"):
                raise SimulatedCrash("crash-after-send: %s was admitted; stopping before the audit result"
                                     % message_id)
            result["id"] = record.get("id") if isinstance(record, dict) else None
        self._acknowledge(keys)
        return {"sent": True, "action": plan.action, "message_id": message_id, "keys": keys,
                "left": len(plan.pending) - len(keys)}

    def convert_lapsed_notes(self, observation, now):
        """A note still in v2's inbox once you have not prompted for the
        engagement window becomes a wake: `inbox.update` to queue, then to
        steer (v2 refuses steer to steer). Only on an idle agent. Returns the
        converted inbox ids."""
        if fault("no-note-conversion") or hold_reason(observation) or observation.status != "idle":
            return []
        if observation.engaged(now, self.engaged_seconds):
            return []
        inbox = self.v2.inbox_list(observation.session_id)
        notes = [item for item in (inbox if isinstance(inbox, list) else [])
                 if isinstance(item, dict) and (_fleet_meta(item) or {}).get("from") == "switchboard"
                 and item.get("delivery") == "steer" and item.get("resume") is not True]
        converted = []
        for item in notes:
            if not fault("no-recheck"):
                fresh, why = self.reobserve(observation, self.now())
                if fresh is None or hold_reason(fresh) or fresh.status != "idle" \
                        or fresh.engaged(self.now(), self.engaged_seconds):
                    if self.audit is not None:
                        self.audit.append(self.actor, "recheck", observation.name, {
                            "was": "convert", "now": "keep", "inbox_id": item.get("id"),
                            "reason": why or hold_reason(fresh) or "%s is %s or engaged" % (
                                observation.name, fresh.status)})
                    break
            for delivery in ("queue", "steer"):
                with self._external("v2.inbox.update", observation.name, {
                        "session": observation.session_id, "inbox_id": item.get("id"),
                        "delivery": delivery, "keys": _fleet_keys(item), "why": "note outlived engagement"}) as result:
                    record = self.v2.inbox_update(observation.session_id, item.get("id"), delivery)
                    result["delivery"] = record.get("delivery") if isinstance(record, dict) else None
            converted.append(item.get("id"))
        return converted

    # -- the pass

    def _failed(self, subject, step, err, report):
        line = "%s: %s" % (type(err).__name__, _one_line(str(err)))
        report["errors"].append({"subject": subject, "step": step, "error": line})
        if self.audit is not None:
            self.audit.append(self.actor, "error", subject, {"step": step, "error": line})

    def run_pass(self):
        """One pass. One agent's failure is audited and never stops the others."""
        now = self.now()
        report = {"at": iso(now), "sent": [], "held": [], "waiting": [], "converted": [], "errors": [],
                  "badges": [], "toasts": []}
        self.pass_toasts = {}
        discovery = self.discover(now)
        for problem in discovery.problems:
            self._note("observe.problem", None, {"problem": problem})
        for observation in list(discovery.agents.values()):
            if observation.wrong_program:
                self._note("program.guard", observation.name, {"pane": observation.pane, "reason": observation.problem})
            try:
                report["converted"].extend(self.convert_lapsed_notes(observation, now))
            except Exception as err:
                self._failed(observation.name, "convert", err, report)
        run_shadow_classifier(self, discovery, now)  # PR 7: logs, acts on nothing
        facts, _ = self.collect_facts()
        by_recipient = {}
        for fact in facts:
            by_recipient.setdefault(fact.recipient, []).append(fact)
        held = {}
        for recipient in sorted(by_recipient):
            try:
                plan = self.plan(recipient, by_recipient[recipient], discovery, now)
                if plan is None:
                    continue
                if plan.action == "wait":
                    report["waiting"].append(recipient)
                elif plan.action == "hold":
                    held[recipient] = plan
                    report["held"].append({"recipient": recipient, "reason": plan.reason})
                    self._note("hold", recipient, {"reason": plan.reason,
                                                   "keys": [fact.key for fact in plan.pending]})
                else:
                    outcome = self.deliver(plan)
                    if outcome["sent"]:
                        report["sent"].append(dict(outcome, recipient=recipient))
            except Exception as err:
                self._failed(recipient, "deliver", err, report)
        self.render(discovery, held, now, report)
        finish_pass(self, discovery, report)
        return report

    # -- render: the sidebar badge and the toast

    def unread_count(self, observation, held):
        """The unread badge for one agent, derived on every pass, never stored:
        the facts in switchboard notes that wait in v2's inbox for a turn to
        carry them, plus the facts held for the agent. A note a turn has
        carried is read; a wake starts its own turn, so it is never unread."""
        inbox = self.v2.inbox_list(observation.session_id)
        waiting = [item for item in (inbox if isinstance(inbox, list) else [])
                   if isinstance(item, dict) and (_fleet_meta(item) or {}).get("from") == "switchboard"
                   and item.get("delivery") == "steer" and item.get("resume") is not True]
        count = sum(max(1, len(_fleet_keys(item))) for item in waiting)
        plan = held.get(observation.name)
        return count + (len(plan.pending) if plan else 0)

    def render_badges(self, discovery, held, report):
        """Write `unread` where it differs from what herdr's agent list shows."""
        shown = {entry.get("pane_id"): (entry.get("tokens") or {}).get("unread") for entry in discovery.entries}
        for name, observation in sorted(discovery.agents.items()):
            if not observation.pane:
                continue
            try:
                count = self.unread_count(observation, held)
                current = shown.get(observation.pane)
                if count == 0 and current is None or count and current == str(count):
                    continue
                detail = {"pane": observation.pane, "badge": "unread", "count": count, "was": current}
                with self._external("herdr.badge", name, detail):
                    if count:
                        self.herdr.pane_report_metadata_token(observation.pane, "unread", count)
                    else:
                        self.herdr.pane_clear_token(observation.pane, "unread")
                report["badges"].append({"agent": name, "count": count})
            except Exception as err:
                self._failed(name, "badge", err, report)

    def source_toasts(self):
        return collect_source_toasts(self)

    def toast_candidates(self, discovery, held, now):
        """[(agent, reason, title, body)], one per agent, most urgent reason first:
        a pane on another program, a blocked agent, items held past the limit."""
        wanted = {}
        for name, plan in held.items():
            if now - min(fact.created for fact in plan.pending) >= HELD_TOAST_AFTER:
                wanted[name] = ("held: %s" % plan.reason, "%s: %d item(s) held" % (name, len(plan.pending)),
                                plan.reason)
        for name, observation in discovery.agents.items():
            if observation.wrong_program:
                wanted[name] = ("different opencode", "%s: pane runs a different opencode" % name,
                                observation.problem)
            elif observation.status == "blocked":
                wanted[name] = ("blocked", "%s is blocked" % name,
                                "%s is waiting on a permission request or a question" % name)
        for name, found in self.source_toasts().items():  # says what is asked, so it wins over the generic one
            if wanted.get(name, ("",))[0] != "different opencode":
                wanted[name] = found
        return [(name,) + wanted[name] for name in sorted(wanted)]

    def render_toast(self, discovery, held, now, report):
        """At most one toast per pass (herdr allows one a second, and queues none),
        for the first agent whose reason has not been toasted yet. A reason
        that has cleared is forgotten, so it toasts again if it comes back."""
        candidates = self.toast_candidates(discovery, held, now)
        self.toasted = {name: reason for name, reason in self.toasted.items()
                        if any(c[0] == name and c[1] == reason for c in candidates)}
        for name, reason, title, body in candidates:
            if self.toasted.get(name) == reason:
                continue
            with self._external("herdr.notification", name, {"reason": reason, "title": title}) as result:
                reply = self.herdr.notification_show(title, body)
                result["reply"] = reply
            if reply["shown"] or reply["reason"] == "disabled":
                self.toasted[name] = reason  # shown, or herdr has toasts off for good
            report["toasts"].append({"agent": name, "reason": reason, "shown": reply["shown"],
                                     "why": reply["reason"]})
            return  # rate_limited, busy, no_foreground_client: owed, tried again next pass

    def render(self, discovery, held, now, report):
        """Step 5: update herdr. A failure here is audited and never stops the pass."""
        if self.audit is None:
            return
        steps = (("badge", lambda: self.render_badges(discovery, held, report)),
                 ("toast", lambda: self.render_toast(discovery, held, now, report)))
        for step, call in steps:
            try:
                call()
            except Exception as err:
                self._failed(None, step, err, report)

    # -- the CLI's entry points

    def send(self, sender, recipient, text, issue=None):
        """Deliver `text` to `recipient` now, by the rule, without batching. Stores nothing."""
        now = self.now()
        fact = Fact("send:%s:%s" % (sender, uuid.uuid4().hex[:16]), recipient, "send", text, now,
                    issue=issue, batch=False, sender=sender)
        plan = self.plan(recipient, [fact], self.discover(now), now)
        if plan.action == "hold":
            if self.audit is not None:
                self.audit.append(self.actor, "hold", recipient, {"reason": plan.reason, "keys": [fact.key]})
            return {"sent": False, "action": "hold", "reason": plan.reason}
        return self.deliver(plan)

    def pending(self, name, discovery=None, facts=None):
        """Read-only: what is pending for `name`, and what the rule says about it."""
        now = self.now()
        discovery = discovery or self.discover(now)
        problems = []
        if facts is None:
            facts, problems = self.collect_facts()
        mine = [fact for fact in facts if fact.recipient == name]
        plan = self.plan(name, mine, discovery, now) if mine else None
        observation = discovery.agents.get(name)
        return {"name": name, "observation": observation.to_json() if observation else None,
                "missing": None if observation else discovery.missing(name),
                "plan": plan.to_json() if plan else None, "source_problems": problems}


# ============================================================================
# PR 7: the decision model, the classifier and the policy judge's questions
#
# One section, so the stack rebases cleanly. docs/switchboard.md, "Classify: a
# decision model" and "The judge". Registered in four places: the config check
# (`validate_jev_config`), `Switchboard.__init__` (`build_jev`), `run_pass`
# (`run_shadow_classifier`) and the unknown-key list (`PR7_CONFIG_KEYS`).
# ============================================================================
import socket
import urllib.error
import urllib.request

JEV_MODEL = "typesafe/jev-1.13"
JEV_URL = "https://openrouter.ai/api/v1/systemone"
JEV_KEY_ENV = "OPENROUTER_API_KEY"
JEV_DEFAULTS = {
    "model": JEV_MODEL,
    "url": JEV_URL,
    "key_env": JEV_KEY_ENV,       # the NAME of the variable that holds the key, never the key
    "timeout_seconds": 20,
    "min_confidence": 0.7,        # the classifier's threshold; SF2 will choose the real one
    "record_file": None,          # append every real call here as a request/response pair
    "replay": None,               # answer from this file instead of calling Jev
}
PR7_CONFIG_KEYS = ("jev", "shadow_judges")
JEV_HTTP_REASONS = {400: "invalid", 401: "unauthorized", 402: "no_credit", 403: "unauthorized",
                    413: "too_large", 422: "invalid", 429: "rate_limited"}
JEV_REASONS = ("invalid", "unauthorized", "no_credit", "too_large", "rate_limited",
               "timeout", "unreachable", "bad_response")
JEV_TEXT_LIMIT = 1000   # characters of any one message or intent sent to Jev
JEV_DETAIL_LIMIT = 160  # characters of a provider's text kept in an error


def validate_jev_config(config, raw, source="config"):
    """Check and complete `jev` and `shadow_judges`. Silent when `raw` has neither."""
    if not any(name in raw for name in PR7_CONFIG_KEYS):
        return
    jev = raw.get("jev")
    if jev is not None:
        config["jev"] = _checked_jev_settings(jev, source)
    shadow = raw.get("shadow_judges")
    if shadow is not None and not isinstance(shadow, bool):
        raise ConfigError("%s: 'shadow_judges' must be true or false, got %r" % (source, shadow))
    if shadow and jev is None:
        raise ConfigError("%s: 'shadow_judges' needs a 'jev' object: there is no decision model to ask" % source)
    config["shadow_judges"] = (jev is not None) if shadow is None else shadow


def _checked_jev_settings(jev, source):
    if not isinstance(jev, dict):
        raise ConfigError("%s: 'jev' must be an object, got %r" % (source, type(jev).__name__))
    unknown = sorted(set(jev) - set(JEV_DEFAULTS))
    if unknown:
        raise ConfigError("%s: 'jev' contains key(s) this tool does not read: %s (known: %s)"
                          % (source, ", ".join(unknown), ", ".join(JEV_DEFAULTS)))
    settings = dict(JEV_DEFAULTS, **jev)
    for name in ("model", "url", "key_env"):
        if not isinstance(settings[name], str) or not settings[name].strip():
            raise ConfigError("%s: 'jev.%s' must be a non-empty string, got %r" % (source, name, settings[name]))
    if not re.match(r"^[A-Za-z_][A-Za-z0-9_]*$", settings["key_env"]):
        raise ConfigError("%s: 'jev.key_env' is the NAME of an environment variable, got %r "
                          "(never put the key itself in this file)" % (source, settings["key_env"]))
    if not re.match(r"^(https://|http://(localhost|127\.0\.0\.1)[:/])", settings["url"]):
        raise ConfigError("%s: 'jev.url' must be https (the key travels with it), got %r" % (source, settings["url"]))
    if not _is_number(settings["timeout_seconds"]) or settings["timeout_seconds"] <= 0:
        raise ConfigError("%s: 'jev.timeout_seconds' must be a positive number, got %r"
                          % (source, settings["timeout_seconds"]))
    if not _is_number(settings["min_confidence"]) or not 0 < settings["min_confidence"] <= 1:
        raise ConfigError("%s: 'jev.min_confidence' must be a number above 0 and at most 1, got %r"
                          % (source, settings["min_confidence"]))
    for name in ("record_file", "replay"):
        value = settings[name]
        if value is not None and (not isinstance(value, str) or not os.path.isabs(value)):
            raise ConfigError("%s: 'jev.%s' must be an absolute path, got %r" % (source, name, value))
    if settings["record_file"] and settings["replay"]:
        raise ConfigError("%s: 'jev' cannot both record real calls and replay recorded ones" % source)
    return settings


# ------------------------------------------------------------------ the client

class JevError(Exception):
    """A Jev call with no usable answer. `reason` is one of JEV_REASONS."""

    def __init__(self, reason, detail=None, latency_ms=None):
        self.reason, self.detail, self.latency_ms = reason, detail, latency_ms
        super().__init__("%s: %s" % (reason, detail) if detail else reason)


def _canonical(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":"))


def _scrub_provider_text(text, key=None):
    """One short line of a provider's text with the key (and any bearer value) removed."""
    text = str(text if text is not None else "")
    if key:
        text = text.replace(key, "[key]")
    text = re.sub(r"(?i)bearer\s+\S+", "Bearer [key]", text)
    return _one_line(text, JEV_DETAIL_LIMIT)


def _is_probability(value):
    return _is_number(value) and 0 <= value <= 1


def check_answers(questions, answers):
    """`answers` (a dict by question id, or a list in question order) as a dict, or JevError.

    A missing answer, an out-of-range probability or an option nobody offered
    is a bad answer, never a reading.
    """
    if isinstance(answers, list):
        if len(answers) != len(questions):
            raise JevError("bad_response", "%d answer(s) for %d question(s)" % (len(answers), len(questions)))
        answers = dict(zip(questions, answers))
    if not isinstance(answers, dict):
        raise JevError("bad_response", "no answers")
    for name, question in questions.items():
        answer = answers.get(name)
        if not isinstance(answer, dict):
            raise JevError("bad_response", "question %s is not answered" % name)
        if question.get("type") == "noul":
            if not _is_probability(answer.get("noul")):
                raise JevError("bad_response", "question %s: noul is not a probability" % name)
            continue
        if answer.get("choice") not in question.get("criteria", {}):
            raise JevError("bad_response", "question %s: choice is not one of the options" % name)
        probabilities = answer.get("probabilities")
        if probabilities is not None:
            values = list(probabilities.values()) if isinstance(probabilities, dict) else [None]
            if not all(_is_probability(v) for v in values) or abs(sum(values) - 1) > 0.01:
                raise JevError("bad_response", "question %s: probabilities do not sum to 1" % name)
            if set(probabilities) - set(question["criteria"]):
                raise JevError("bad_response", "question %s: probabilities name an option nobody offered" % name)
    return answers


def _usage_of(usage):
    """The numbers of a usage block under names the audit does not redact."""
    usage = usage if isinstance(usage, dict) else {}
    pairs = (("in", "input_tokens"), ("out", "output_tokens"), ("cost", "cost"))
    return {short: usage[name] for short, name in pairs if _is_number(usage.get(name))}


class JevClient:
    """The decision model over HTTPS (OpenRouter's System One endpoint).

    The key is read from the environment variable named in the config at the
    moment of each call. It is never stored on the client, written to a file,
    put in an argument list, or kept in an error. `opener` has urlopen's shape
    so tests inject a fake and never reach a network.
    """

    def __init__(self, settings, environ=None, opener=None, clock=time.monotonic):
        self.settings = settings
        self.environ = os.environ if environ is None else environ
        self.opener = opener or urllib.request.urlopen
        self.clock = clock

    def decide(self, state, questions):
        """{"model", "answers", "usage", "latency_ms"}. Raises JevError, with the latency."""
        key = self.environ.get(self.settings["key_env"])
        started = self.clock()
        try:
            if not key:
                raise JevError("unauthorized", "no key in $%s" % self.settings["key_env"])
            body = {"model": self.settings["model"], "state": state, "questions": questions}
            out = self._post(body, key)
            answers = check_answers(questions, out.get("answers"))
        except JevError as err:
            err.latency_ms = int((self.clock() - started) * 1000)
            raise
        result = {"model": _scrub_provider_text(out.get("model") or self.settings["model"], key), "answers": answers,
                  "usage": _usage_of(out.get("usage")), "latency_ms": int((self.clock() - started) * 1000)}
        self._record(body, out)
        return result

    def _post(self, body, key):
        request = urllib.request.Request(
            self.settings["url"], data=json.dumps(body).encode("utf-8"), method="POST",
            headers={"Authorization": "Bearer " + key, "Content-Type": "application/json",
                     "Accept": "application/json"})
        response = None
        try:
            response = self.opener(request, timeout=self.settings["timeout_seconds"])
            raw = response.read()
        except urllib.error.HTTPError as err:
            reason = JEV_HTTP_REASONS.get(err.code, "unreachable")
            raise JevError(reason, "HTTP %s %s" % (err.code, _scrub_provider_text(self._body_of(err), key)))
        except (socket.timeout, TimeoutError):
            raise JevError("timeout", "no answer in %ss" % self.settings["timeout_seconds"])
        except urllib.error.URLError as err:
            if isinstance(err.reason, (socket.timeout, TimeoutError)):
                raise JevError("timeout", "no answer in %ss" % self.settings["timeout_seconds"])
            raise JevError("unreachable", _scrub_provider_text(err.reason, key))
        except OSError as err:
            raise JevError("unreachable", _scrub_provider_text(err, key))
        finally:
            if response is not None and hasattr(response, "close"):
                response.close()
        try:
            out = json.loads(raw)
        except (TypeError, ValueError):
            raise JevError("bad_response", "the answer is not JSON")
        if not isinstance(out, dict):
            raise JevError("bad_response", "the answer is not an object")
        return out

    @staticmethod
    def _body_of(err):
        try:
            return err.read().decode("utf-8", "replace")
        except Exception:
            return ""

    def _record(self, body, out):
        path = self.settings.get("record_file")
        if not path:
            return
        line = json.dumps({"request": body, "response": out}, sort_keys=True) + "\n"
        fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
        with os.fdopen(fd, "a") as handle:
            handle.write(line)


class ReplayJev:
    """Answers from a hand-written or recorded file, never from the network.

    The file is a JSON object {"pairs": [...], "rules": [...]} or JSON lines of
    pairs (what `jev.record_file` writes). A pair is {"request": {state,
    questions[, model]}, "response": {answers[, model, usage]}} and matches an
    identical request. A rule is {"contains": text, "choice": {option: p},
    "noul": {question: p}, "error": reason} and matches a request whose
    "message" contains the text (a rule without "contains" matches anything);
    the first match wins. A question nobody answered is an error, loudly.
    """

    def __init__(self, path, model=JEV_MODEL):
        self.path, self.model = path, model
        self._pairs = self._rules = None

    def _load(self):
        if self._pairs is not None:
            return
        try:
            text = Path(self.path).read_text()
            try:
                data = json.loads(text)
            except ValueError:
                data = {"pairs": [json.loads(line) for line in text.splitlines() if line.strip()]}
            if "request" in data:  # a record file holding exactly one line parses as that pair
                data = {"pairs": [data]}
            pairs, rules = list(data.get("pairs") or []), list(data.get("rules") or [])
        except (OSError, ValueError, AttributeError) as err:
            raise JevError("bad_response", "cannot read the replay file: %s" % _scrub_provider_text(err))
        self._pairs = {_canonical({"model": p["request"].get("model", self.model),
                                   "state": p["request"].get("state"),
                                   "questions": p["request"].get("questions")}): p["response"] for p in pairs}
        self._rules = rules

    def decide(self, state, questions):
        self._load()
        response = self._pairs.get(_canonical({"model": self.model, "state": state, "questions": questions}))
        if response is None:
            response = self._by_rule(state, questions)
        answers = check_answers(questions, response.get("answers"))
        return {"model": str(response.get("model") or self.model), "answers": answers,
                "usage": _usage_of(response.get("usage")), "latency_ms": int(response.get("latency_ms") or 0)}

    def _by_rule(self, state, questions):
        message = state.get("message") if isinstance(state, dict) else None
        subject = message if isinstance(message, str) else _canonical(state)
        for rule in self._rules:
            if rule.get("contains", "") in subject:
                if rule.get("error") in JEV_REASONS:
                    raise JevError(rule["error"], "replayed")
                return {"answers": self._answers_of(rule, questions), "model": rule.get("model")}
        raise JevError("bad_response", "nothing recorded for this question")

    @staticmethod
    def _answers_of(rule, questions):
        answers = {}
        for name, question in questions.items():
            if question.get("type") == "noul":
                answers[name] = {"type": "noul", "noul": (rule.get("noul") or {}).get(name, 0.0)}
                continue
            options = list(question.get("criteria", {}))
            given = rule.get("choice") or {}
            probabilities = {option: given.get(option, 0.0) for option in options}
            total = sum(p for p in probabilities.values() if _is_number(p))
            if total > 0:  # a rule may name options this question lacks: scale what is left to 1
                probabilities = {option: p / total for option, p in probabilities.items()}
            top = max(options, key=lambda option: (probabilities[option], option == "current"))
            answers[name] = {"type": "choice", "choice": top, "probabilities": probabilities}
        return answers


def build_jev(config):
    """The decision model the config asks for, or None when `jev` is not configured."""
    settings = config.get("jev")
    if not settings:
        return None
    if settings.get("replay"):
        return ReplayJev(settings["replay"], settings["model"])
    return JevClient(settings)


# ----------------------------------------------------------------- the classifier

CLASSIFY_ID = "about"
CLASSIFY_INSTRUCTIONS = (
    "The Chief of Staff is an AI assistant working for one person, who has just sent a new message. "
    "Which of the following is the new message about: the work in progress, an ask somebody else is "
    "already working on, or something new?")


def _clip(text, limit=JEV_TEXT_LIMIT):
    text = "" if text is None else str(text)
    return text if len(text) <= limit else text[:limit - 1] + "\u2026"


def _ask_line(ask):
    ask = ask or {}
    line = _clip(ask.get("intent") or "no stated intent", 300)
    if ask.get("done_when"):
        line += " (done when: %s)" % _clip(ask["done_when"], 200)
    return line


def classify_options(current_ask, open_asks):
    """Option name -> its criterion: `current`, one per open ask by issue number, `new`."""
    options = {"current": "The message is about the work in progress now: %s." % _ask_line(current_ask)}
    own = str((current_ask or {}).get("issue"))
    for ask in open_asks or []:
        name = str(ask["issue"])
        if name == own:
            continue  # the current ask is `current`, not a second option
        options[name] = "The message is about ask %s (%s), which %s already owns." % (
            name, _clip(ask.get("intent") or "no stated intent", 300), ask.get("owner") or "someone")
    options["new"] = "The message is about something else: new work unrelated to the work in progress and to every open ask."
    return options


def classify_request(message, previous_message, current_ask, open_asks):
    """(state, questions) for one classification."""
    state = {"message": _clip(message), "previous_message": _clip(previous_message) if previous_message else None,
             "current_ask": {"issue": (current_ask or {}).get("issue"), "intent": _ask_line(current_ask)},
             "open_asks": [{"issue": str(a["issue"]), "intent": _clip(a.get("intent") or "", 300),
                            "owner": a.get("owner")} for a in open_asks or []]}
    question = {"type": "choice", "instructions": CLASSIFY_INSTRUCTIONS,
                "criteria": classify_options(current_ask, open_asks)}
    return state, {CLASSIFY_ID: question}


def _default_current(reason, extra=None):
    out = {"choice": "current", "probabilities": None, "confident": False, "reason": reason,
           "jev_choice": None, "model": None, "usage": {}, "latency_ms": None}
    out.update(extra or {})
    return out


def classify(jev, message, previous_message, current_ask, open_asks, min_confidence=0.7):
    """One Jev call: {choice, probabilities, confident, reason, ...}. Never raises on Jev's account.

    `confident` is true when the top probability reaches `min_confidence`. When
    Jev is unreachable, errs, or is unsure, the choice is `current`: the safe
    default changes nothing. `jev_choice` keeps what Jev said, for the audit.
    """
    state, questions = classify_request(message, previous_message, current_ask, open_asks)
    try:
        result = jev.decide(state, questions)
    except JevError as err:
        return _default_current("jev %s" % err.reason, {"latency_ms": err.latency_ms})
    answer = result["answers"][CLASSIFY_ID]
    probabilities = answer.get("probabilities")
    out = {"probabilities": probabilities, "jev_choice": answer["choice"], "model": result["model"],
           "usage": result["usage"], "latency_ms": result["latency_ms"]}
    if not probabilities:
        return dict(_default_current("jev gave no probabilities"), **out, choice="current")
    top = probabilities.get(answer["choice"], 0.0)
    if top < min_confidence:
        return dict(out, choice="current", confident=False,
                    reason="unsure: %s at %.2f is below %.2f" % (answer["choice"], top, min_confidence))
    return dict(out, choice=answer["choice"], confident=True, reason="confident: %s at %.2f" % (answer["choice"], top))


# ---------------------------------------------------------- the policy judge's questions

POLICY_THRESHOLD = 0.5
POLICY_OUTCOMES = ("allow", "ask", "deny", "hard-deny")  # least to most strict
POLICY_QUESTIONS = {
    "outside_intent": ("Is this action beyond the ask's Intent and Done-when?",
                       "The action goes beyond what the Intent and Done-when ask for.",
                       "The action is part of doing what the Intent and Done-when ask for."),
    "hard_to_reverse": ("Is this action destructive, irreversible or security-sensitive?",
                        "It destroys data, cannot be undone, or weakens security.",
                        "It is easy to undo and touches nothing sensitive."),
    "speaks_for_you": ("Is this action a merge, deploy, publish, message to other people, or spend that "
                       "the charter's standing authority does not cover?",
                       "It merges, deploys, publishes, messages others or spends, and nothing in the "
                       "standing authority covers it.",
                       "It does none of those, or the standing authority covers it."),
    "outside_scope": ("Does this action touch a repository, environment, account or credential outside "
                      "this agent's assignment?",
                      "It touches something outside what this agent was assigned.",
                      "It stays inside what this agent was assigned."),
}
POLICY_ASK_FOR = ("hard_to_reverse", "speaks_for_you", "outside_scope")


def policy_questions():
    """The four yes/no questions, by id."""
    return {name: {"type": "noul", "instructions": text, "criteria": {"true": yes, "false": no}}
            for name, (text, yes, no) in POLICY_QUESTIONS.items()}


def policy_state(role, intent, done_when, authority, tool, arguments):
    return {"role": role, "intent": _clip(intent, 600), "done_when": _clip(done_when, 400),
            "standing_authority": _clip(authority, 300), "tool": tool,
            "arguments": _clip(_canonical(arguments) if not isinstance(arguments, str) else arguments, 1500)}


def _stricter(first, second):
    return max((first, second), key=POLICY_OUTCOMES.index)


def combine_policy(answers, thresholds=None, configured="allow"):
    """The outcome of the four answers, never looser than `configured` (invariant 9).

    `answers` maps question id to a probability, or None when unanswered.
    outside_intent at its threshold is a hard deny; any of the other three is
    an ask; an unanswered or malformed answer counts for nothing, so the
    configured outcome stands. Returns {outcome, configured, fired, reason}.
    """
    if configured not in POLICY_OUTCOMES:
        raise ValueError("unknown configured outcome: %r" % (configured,))
    limits = dict.fromkeys(POLICY_QUESTIONS, POLICY_THRESHOLD)
    limits.update(thresholds or {})
    answers = answers or {}
    fired = [name for name in POLICY_QUESTIONS
             if _is_probability(answers.get(name)) and answers[name] >= limits[name]]
    judged = "allow"
    if "outside_intent" in fired:
        judged = "hard-deny"
    elif any(name in fired for name in POLICY_ASK_FOR):
        judged = "ask"
    if fault("judge-loosens"):
        outcome = judged  # the fault: the judge's word replaces the configured outcome
    else:
        outcome = _stricter(configured, judged)
    reason = "judge: %s" % ", ".join(fired) if fired else "judge: nothing at its threshold"
    return {"outcome": outcome, "configured": configured, "fired": fired, "reason": reason}


def judge_tool_call(jev, configured, state, thresholds=None):
    """Ask the four questions about one tool call and combine them. Never raises, never loosens.

    No answer (slow, unreachable, an error) leaves the configured outcome.
    """
    questions = policy_questions()
    try:
        result = jev.decide(state, questions)
    except JevError as err:
        combined = combine_policy(None, thresholds, configured)
        combined.update(reason="judge unavailable (%s): configured outcome stands" % err.reason,
                        latency_ms=err.latency_ms, usage={})
        return combined
    answers = {name: result["answers"][name]["noul"] for name in questions}
    combined = combine_policy(answers, thresholds, configured)
    combined.update(answers=answers, latency_ms=result["latency_ms"], usage=result["usage"], model=result["model"])
    return combined


# ------------------------------------------------------- shadow mode in the engine

def _message_text(message):
    text = message.get("text")
    if isinstance(text, str):
        return text
    parts = message.get("content")
    if isinstance(parts, list):
        return "\n".join(p.get("text", "") for p in parts if isinstance(p, dict) and isinstance(p.get("text"), str))
    return ""


def human_prompts(messages):
    """Your prompts in a transcript read newest first: type `user` without `metadata.fleet`."""
    return [m for m in messages if isinstance(m, dict) and m.get("type") == "user" and _fleet_meta(m) is None]


def _ask_of(fleet, owner=None):
    issue = fleet.get("issue")
    if issue is None:
        return None
    return {"issue": issue, "intent": fleet.get("intent") or "", "owner": owner}


def open_asks_of(discovery, cos_name):
    """The asks others hold: a fleet agent with an issue, other than the Chief of Staff.

    Intent text arrives with `fleet-switchboard intents` (PR 6); until then an
    ask has its issue number and owner only.
    """
    asks, seen = [], set()
    for name, other in sorted(discovery.agents.items()):
        ask = _ask_of(other.fleet, name)
        if name != cos_name and ask and ask["issue"] not in seen:
            seen.add(ask["issue"])
            asks.append(ask)
    return asks


def _classify_audit(engine, observation, message, previous, request, answer, shadow=True):
    state, questions = request
    detail = {"agent": observation.name, "session": observation.session_id, "message_id": message.get("id"),
              "status": observation.status, "shadow": shadow,
              "question": {"state": state, "options": list(questions[CLASSIFY_ID]["criteria"])},
              "answer": {"choice": answer["choice"], "confident": answer["confident"],
                         "reason": answer["reason"], "jev_choice": answer["jev_choice"],
                         "probabilities": answer["probabilities"]},
              "model": answer["model"], "usage": answer["usage"], "latency_ms": answer["latency_ms"]}
    engine.audit.append(engine.actor, "classify", "classify:%s:%s" % (observation.session_id, message.get("id")), detail)


def shadow_classify(engine, observation, discovery, now):
    """Classify your newest prompt to a Chief of Staff once, and write what Jev said. Acts on nothing."""
    prompts = newest_prompts(engine, observation.session_id)
    if not prompts:
        return False
    message = prompts[0]
    created = _created(message)
    key = "classify:%s:%s" % (observation.session_id, message.get("id"))
    if message.get("id") is None or key in engine._classified:
        return False
    if created is None or now - created > engine.engaged_seconds:
        return False
    engine._classified.add(key)  # one attempt per message, whatever the answer
    asks = ask_intents(engine, open_asks_of(discovery, observation.name))  # PR 8: with their Intent
    if observation.status != "working" and not asks:
        return False  # nothing to choose between: it simply becomes the foreground work
    previous = _message_text(prompts[1]) if len(prompts) > 1 else None
    current = ask_intent(engine, _ask_of(observation.fleet, observation.name))
    request = classify_request(_message_text(message), previous, current, asks)
    answer = classify(engine.jev, _message_text(message), previous, current, asks,
                      engine.config["jev"]["min_confidence"])
    _classify_audit(engine, observation, message, previous, request, answer, shadow=not acting(engine))
    if acting(engine):  # PR 8
        note_decision(engine, observation, message, current, asks, answer)
    return True


def run_shadow_classifier(engine, discovery, now):
    """Each Chief of Staff, once per new prompt. A failure is audited and never stops the pass."""
    if engine.jev is None or engine.audit is None or not (engine.config.get("shadow_judges") or acting(engine)):
        return
    if fault("no-classify"):
        return
    for observation in list(discovery.agents.values()):
        if observation.fleet.get("role") != "chief-of-staff" or observation.problem:
            continue
        try:
            shadow_classify(engine, observation, discovery, now)
        except Exception as err:
            engine.audit.append(engine.actor, "error", observation.name,
                                {"step": "classify", "error": "%s: %s" % (type(err).__name__, _one_line(str(err)))})


# ------------------------------------------------- the poke socket and the daemon

POKE_SOCKET = "poke.sock"
ENSURE_PATIENCE = 3.0  # seconds `ensure` waits for the daemon to take its lock
POKE_ALARM = 2         # seconds before a stuck `poke` ends itself


@contextmanager
def in_directory(path):
    """Work from `path` for the block. A unix socket path is limited to about
    100 bytes, so the poke socket is always named relative to the state dir."""
    before = os.getcwd()
    os.chdir(str(path))
    try:
        yield
    finally:
        os.chdir(before)


def open_poke_socket(state_dir):
    """The daemon's end: a datagram socket at $STATE/poke.sock, a stale one replaced."""
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    try:
        with in_directory(state_dir):
            try:
                os.unlink(POKE_SOCKET)
            except FileNotFoundError:
                pass
            sock.bind(POKE_SOCKET)
            os.chmod(POKE_SOCKET, 0o600)
        sock.setblocking(False)
    except BaseException:
        sock.close()
        raise
    return sock


def send_poke(state_dir):
    """Ask the daemon for a pass. One non-blocking datagram; True when it was sent.

    Never blocks and never raises: a daemon that is down, or too busy to take
    one more datagram, has not lost anything, because the next pass derives
    everything again.
    """
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    try:
        sock.setblocking(False)
        with in_directory(state_dir):
            sock.sendto(b"poke", POKE_SOCKET)
        return True
    except OSError:
        return False
    finally:
        sock.close()


def drain_pokes(sock):
    """Read every datagram waiting. Returns how many."""
    count = 0
    while sock is not None:
        try:
            sock.recv(64)
        except (BlockingIOError, InterruptedError):
            break
        count += 1
    return count


def wait_for_poke(sock, timeout):
    """Wait up to `timeout` seconds for a poke. True when one came."""
    if sock is None:
        time.sleep(timeout)
        return False
    ready, _, _ = select.select([sock], [], [], timeout)
    return bool(ready)


def run_daemon(engine, state_dir, poll, wait=None, passes=None):
    """`run`: a pass on every poke, and at least every `poll` seconds, under the
    single-instance lock.

    The daemon waits on its poke socket with select, and drains every datagram
    before each pass, so a burst of events is one pass. A pass that raises is
    audited and the loop goes on; only a SimulatedCrash (or a signal) ends it.
    `wait(sock, timeout)` and `passes` are for tests and `--once`.
    """
    wait = wait or wait_for_poke
    with single_instance(state_dir):
        try:
            sock = open_poke_socket(state_dir)
        except OSError as err:  # no pokes then; the poll interval still passes
            sock = None
            engine._note("poke.unavailable", None, {"error": _one_line(str(err))})
        try:
            done = 0
            while True:
                drain_pokes(sock)
                try:
                    engine.run_pass()
                except Exception as err:
                    engine._failed(None, "pass", err, {"errors": []})
                done += 1
                if passes is not None and done >= passes:
                    return done
                wait(sock, next_poll(engine, poll))
        finally:
            if sock is not None:
                sock.close()


def run_lock_held(state_dir):
    """True when a daemon holds run.lock. Takes and drops the lock to find out."""
    fd = os.open(str(Path(state_dir) / "run.lock"), os.O_RDWR | os.O_CREAT, 0o600)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return True
        return False
    finally:
        os.close(fd)


def daemon_environment(environ):
    """The environment for a daemon started from a hook: herdr's server env
    minus the hook's own pane, which is whatever pane you had focused."""
    return {name: value for name, value in environ.items()
            if not name.startswith("HERDR_PLUGIN_")
            and name not in ("HERDR_PANE_ID", "HERDR_TAB_ID", "HERDR_WORKSPACE_ID")}


def spawn_daemon(state_dir, spawn=subprocess.Popen):
    """Start `run` in a session of its own, with none of the caller's pipes.

    herdr waits for EOF on a hook's stdout and stderr, and counts the hook as
    running until then; a daemon that kept them would hold a plugin slot for
    ever. Its output goes to $STATE/daemon.log, and setsid keeps it alive
    when herdr's hook runner is cleaned up.
    """
    log = os.open(str(Path(state_dir) / "daemon.log"), os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
    try:
        return spawn([sys.executable, os.path.realpath(__file__), "run"], stdin=subprocess.DEVNULL,
                     stdout=log, stderr=log, close_fds=True, start_new_session=True,
                     cwd=str(state_dir), env=daemon_environment(os.environ))
    finally:
        os.close(log)


@contextmanager
def ensure_lock(state_dir, patience, sleep=time.sleep):
    """Serialise concurrent `ensure` runs: a startup hook and a person at once."""
    fd = os.open(str(Path(state_dir) / "ensure.lock"), os.O_RDWR | os.O_CREAT, 0o600)
    try:
        waited = 0.0
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError:
                if waited >= patience:
                    raise LockError("another ensure is still starting the daemon") from None
                sleep(0.05)
                waited += 0.05
        yield
    finally:
        os.close(fd)


def ensure_daemon(state_dir, spawn=subprocess.Popen, patience=ENSURE_PATIENCE, sleep=time.sleep):
    """Make sure a daemon runs. Returns "running" or "started"; raises LockError
    when a started daemon did not take its lock within `patience` seconds."""
    with ensure_lock(state_dir, patience, sleep):
        if run_lock_held(state_dir):
            return "running"
        spawn_daemon(state_dir, spawn)
        waited = 0.0
        while not run_lock_held(state_dir):
            if waited >= patience:
                raise LockError("the daemon did not start within %gs; see %s" % (
                    patience, Path(state_dir) / "daemon.log"))
            sleep(0.05)
            waited += 0.05
        return "started"


# ----------------------------------------------------------------- launching

LAUNCH_PATIENCE = 30  # seconds for the new pane to show the v2 on the new session
NAME_RE = re.compile(r"^[a-z][a-z0-9_-]{0,31}$")  # herdr's own pattern for an agent name


class LaunchError(Exception):
    """A launch that did not finish, and what it left behind."""


def launch_problems(name, agent, directory, workspace, issue):
    """Why these launch arguments cannot be used (empty when they can)."""
    problems = []
    if not NAME_RE.match(name or ""):
        problems.append("name must match %s (lower case, digits, - and _), got %r" % (NAME_RE.pattern, name))
    if not agent:
        problems.append("--agent is required")
    if not directory or not os.path.isabs(directory) or not os.path.isdir(directory):
        problems.append("--dir must be an absolute path of an existing directory, got %r" % directory)
    if not workspace:
        problems.append("no target workspace: pass --workspace or run from a herdr pane")
    if issue is not None and not (isinstance(issue, int) and not isinstance(issue, bool) and issue >= 1):
        problems.append("--issue must be an issue number, got %r" % (issue,))
    return problems


def fleet_record(name, role, reports_to, issue):
    fleet = {"name": name, "role": role, "reports_to": reports_to, "issue": issue}
    return {key: value for key, value in fleet.items() if value is not None}


def pane_problem(engine, pane, session_id):
    """None when `pane` shows the v2 TUI on `session_id`, else the first thing wrong.

    Positive evidence only: herdr names the agent and the session, and the
    pane's own process is the configured v2 executable. Anything unread or
    unclear is a problem, never a pass.
    """
    try:
        entry = engine.herdr.agent_get(pane)
        programs = [p.get("cmdline") for p in engine.herdr.pane_process_info(pane)]
    except HerdrError as err:
        return "herdr cannot say what pane %s shows yet: %s" % (pane, err)
    if entry.get("agent") != "opencode":
        return "herdr sees agent %r in pane %s, not opencode" % (entry.get("agent"), pane)
    if agent_session(entry) != session_id:
        return "pane %s shows session %s, not %s" % (pane, agent_session(entry), session_id)
    if not any(runs_program(cmdline, engine.executable) for cmdline in programs):
        return "pane %s runs %s, not the configured v2 %s" % (
            pane, _one_line("; ".join(str(c) for c in programs), 120) or "nothing", engine.executable)
    return None


def wait_until_verified(engine, pane, session_id, patience, sleep):
    deadline, problem = engine.now() + patience, None
    while True:
        problem = pane_problem(engine, pane, session_id)
        if problem is None:
            return
        if engine.now() >= deadline:
            raise LaunchError("could not verify the new pane: %s" % problem)
        sleep(1)


def close_own_pane(engine, name, pane, why):
    """Close the one pane this launch opened. Never anything else."""
    try:
        with engine._external("herdr.pane.close", name, {"pane": pane, "why": why}):
            engine.herdr.pane_close(pane)
        return "closed pane %s" % pane
    except Exception as err:  # the original failure matters more than this one
        return "could not close pane %s: %s" % (pane, _one_line(str(err)))


def launch_agent(engine, name, agent, directory, workspace, role=None, reports_to=None, issue=None,
                 brief=None, patience=LAUNCH_PATIENCE, sleep=time.sleep):
    """Create a fleet agent: a v2 session, its own herdr tab, the brief.

    Nothing is typed. The tab's program is started by argv through herdr's
    socket, so no shell and no PATH decide which OpenCode runs. The brief is
    sent only after the pane is proved to run the configured v2 on the new
    session. A failure after the pane opened closes that pane, and no other.
    Returns {"name", "session", "pane", "tab"}.
    """
    problems = launch_problems(name, agent, directory, workspace, issue)
    if problems:
        raise LaunchError("; ".join(problems))
    taken = engine.discover(engine.now()).agents.get(name)
    if taken is not None:
        raise LaunchError("a fleet agent named %s already runs in pane %s" % (name, taken.pane))
    fleet = fleet_record(name, role, reports_to, issue)
    with engine._external("v2.session.create", name, {"agent": agent, "directory": directory,
                                                      "fleet": fleet}) as result:
        session_id = engine.v2.session_create(agent, name, directory, {"fleet": fleet})["id"]
        result["session"] = session_id
    env = dict(engine.config["opencode_env"], **engine.config["launch_env"])
    argv = [engine.config["opencode"], "-s", session_id]
    pane = None
    try:
        with engine._external("herdr.layout.apply", name, {
                "workspace": workspace, "label": name, "cwd": directory, "argv": argv,
                "env_names": sorted(env), "session": session_id}) as result:
            opened = engine.herdr.open_tab_running(workspace, name, directory, argv, env)
            pane = result["pane"] = opened["pane_id"]
            result["tab"] = opened["tab_id"]
        wait_until_verified(engine, pane, session_id, patience, sleep)
        if brief:
            with engine._external("v2.session.prompt", name, {"session": session_id, "brief_chars": len(brief)}):
                engine.v2.prompt(session_id, brief, {"fleet": {"from": "switchboard", "brief": True}})
    except Exception as err:
        left = close_own_pane(engine, name, pane, "launch failed: %s" % _one_line(str(err), 120)) if pane \
            else "no pane was opened"
        raise LaunchError("%s (session %s was created; %s)" % (_one_line(str(err)), session_id, left)) from err
    return {"name": name, "session": session_id, "pane": pane, "tab": opened["tab_id"]}


# ======================================================================
# PR 8: foreground and background
#
# One section, so the stack rebases cleanly. docs/switchboard.md,
# "Foreground and background". Registered in these places, one line each:
#   DEFAULTS            `classifier_mode` (below), checked by validate_foreground_config
#   validate_config     calls validate_foreground_config
#   fact_sources        adds ForegroundFacts
#   shadow_classify     enriches asks with their Intent (ask_intent) and hands
#                       an acting classification to note_decision
#   run_shadow_classifier  also runs when classifier_mode is "act"
#   build_parser, main  the `handoff` command
# The decoration is a fact like any other: it is delivered by the one delivery
# path, as a note, and the key in the transcript is what stops a repeat.
# ======================================================================

FOREGROUND_DEFAULTS = {
    # "shadow": the classifier only logs (PR 7). "act": it also decorates the
    # Chief of Staff's message, and tells it to hand off. SF1/SF2 decide when.
    "classifier_mode": "shadow",
    # Seconds between passes while a Chief of Staff is busy: your message is
    # consumed at its next step boundary (SF1), so the decoration must beat it.
    "busy_poll_seconds": 1,
}
DEFAULTS.update(FOREGROUND_DEFAULTS)
CLASSIFIER_MODES = ("shadow", "act")
DECORATION = "foreground.decoration"
COS_SUBAGENT = "cos-subagent"
SUBAGENT_AGENT = "cos-subagent"  # the OpenCode agent definition a background subagent runs
DECORATION_INTENT_LIMIT = 160    # characters of an Intent inside a decoration


def validate_foreground_config(config, source):
    mode = config["classifier_mode"]
    if mode not in CLASSIFIER_MODES:
        raise ConfigError("%s: 'classifier_mode' must be one of %s, got %r" % (source, ", ".join(CLASSIFIER_MODES), mode))
    busy = config["busy_poll_seconds"]
    if not _is_number(busy) or busy <= 0:
        raise ConfigError("%s: 'busy_poll_seconds' must be a positive number, got %r" % (source, busy))
    if mode == "act" and not config.get("jev"):
        raise ConfigError("%s: 'classifier_mode' \"act\" needs a 'jev' object: there is no decision model to ask" % source)


def chief_busy(engine):
    """True when the newest look found a chief-of-staff-role agent working: the daemon then polls fast."""
    found = getattr(engine, "discovery", None)
    return bool(found) and any(o.fleet.get("role") == "chief-of-staff" and o.status == "working"
                               for o in found.agents.values())


def next_poll(engine, poll):
    """Seconds to wait before the next pass: `busy_poll_seconds` while a Chief of Staff works (only
    when acting: shadow mode has no deadline), else `poll`."""
    if acting(engine) and chief_busy(engine):
        return min(poll, engine.config["busy_poll_seconds"])
    return poll


def inbox_human_prompts(engine, session_id):
    """Your steered prompts still waiting in v2's inbox (SF1: there within ~0.1 s, consumed at the
    next step boundary), as message-like records, newest first. Not yet seen by the model."""
    inbox = engine.v2.inbox_list(session_id)
    found = []
    for item in inbox if isinstance(inbox, list) else []:
        payload = item.get("payload") if isinstance(item, dict) and isinstance(item.get("payload"), dict) else {}
        if isinstance(item, dict) and item.get("type") == "user" and _fleet_meta(item) is None \
                and isinstance(payload.get("text"), str):
            found.append({"id": item.get("id"), "type": "user", "text": payload["text"], "time": item.get("time"),
                          "pending": True})
    return sorted(found, key=lambda m: _created(m) or 0, reverse=True)


def newest_prompts(engine, session_id):
    """Your prompts to a Chief of Staff, newest first: the inbox's (not yet consumed), then the transcript's."""
    return inbox_human_prompts(engine, session_id) + human_prompts(engine._messages(session_id))


def acting(engine):
    """True when the classifier's answers are acted on, not only logged."""
    return engine.config.get("classifier_mode") == "act" and engine.jev is not None


# ---- the asks, with their Intent

def ask_intent(engine, ask):
    """`ask` with its Intent and Done-when read from GitHub (IntentReader, cached).

    Unchanged when no reader is configured or GitHub cannot answer: a
    classification must not wait on, or fail for, an unreachable GitHub.
    """
    if not ask or engine.intents is None:
        return ask
    try:
        issue = engine.intents.issue(ask["issue"])
    except IntentError:
        return ask
    return dict(ask, intent=issue.intent or ask.get("intent") or "", done_when=issue.done_when)


def ask_intents(engine, asks):
    return [ask_intent(engine, ask) for ask in asks]


# ---- the decoration's words (docs/switchboard.md, "Decorate" and "Hand off")

def owned_ask_text(ask):
    """The decoration for a message about an ask somebody else owns. The doc's own wording."""
    where = ""
    if ask.get("intent"):
        where = " (Intent: %s)" % _one_line(ask["intent"], DECORATION_INTENT_LIMIT)
    owner = ask.get("owner") or "its owner"
    return ("This is about ask %s%s. %s is working on it in the background. Send it anything relevant "
            "with: fleet-switchboard send %s --issue %s \"...\". Then continue with what you were doing."
            % (ask["issue"], where, owner, owner, ask["issue"]))


def handoff_text(current):
    """The decoration for something new while the Chief of Staff is busy."""
    ask = current or {}
    number = ask.get("issue") or "<the ask of your current work>"
    doing = ""
    if ask.get("intent"):
        doing = " (ask %s: %s)" % (ask["issue"], _one_line(ask["intent"], DECORATION_INTENT_LIMIT))
    return ("This is not about what you are working on%s, and you are busy with it. Hand it off first: write a short "
            "brief with Done so far, Next steps and Watch out for, and run: fleet-switchboard handoff --issue %s "
            "--brief-file -. A background subagent takes it over; then turn to this message."
            % (doing, number))


def decoration_for(choice, observation, current, asks):
    """(kind, ask, text) for the classification's answer, or None when nothing is added.

    current: nothing. An ask somebody owns: name it and its owner. Something
    new: hand off first when the Chief of Staff is busy, nothing when idle.
    """
    if choice == "current":
        return None
    if choice == "new":
        if observation.status != "working":
            return None
        return "handoff", current, handoff_text(current)
    ask = next((a for a in asks if str(a["issue"]) == choice), None)
    return ("owned", ask, owned_ask_text(ask)) if ask else None


# ---- the decoration as a fact

class ForegroundFacts:
    """`foreground.decoration:` facts for a Chief of Staff, derived on every call.

    The only memory is the classifier's answers, by message id, in this
    process; a restart classifies the newest message once more, and the key
    already in the transcript stops a second delivery (invariant 2). Nothing is
    stored on disk. A decoration holds only while it is true: the message is
    still your newest, still inside the engagement window, and (to hand off)
    the Chief of Staff is still busy.
    """

    __name__ = "foreground_facts"

    def __init__(self):
        self.engine = None
        self.decisions = {}  # session id -> the newest decision for it

    def bind(self, engine):
        self.engine = engine

    def record(self, observation, message, kind, ask, text):
        self.decisions[observation.session_id] = {
            "cos": observation.name, "session": observation.session_id, "message": message["id"],
            "created": _created(message), "kind": kind, "ask": ask, "text": text}

    def __call__(self):
        engine = self.engine
        discovery = getattr(engine, "discovery", None)
        if engine is None or discovery is None or not self.decisions:
            return []
        now, facts = engine.now(), []
        for session, decision in sorted(self.decisions.items()):
            if decision["created"] is None or now - decision["created"] > engine.engaged_seconds:
                del self.decisions[session]  # old news; a decoration is only for your newest message
                continue
            fact = self.fact(decision, discovery)
            if fact is not None:
                facts.append(fact)
        return facts

    def fact(self, decision, discovery):
        observation = discovery.agents.get(decision["cos"])
        if observation is None or observation.problem or observation.conflict \
                or observation.session_id != decision["session"]:
            return None
        if decision["kind"] == "handoff" and observation.status != "working":
            return None  # it has finished what it was doing: nothing left to hand off
        if not self.is_newest(decision):
            return None
        ask = decision["ask"] or {}
        issue = ask.get("issue") if decision["kind"] == "owned" else None
        return Fact("decoration:%s:%s" % (decision["session"], decision["message"]), decision["cos"], DECORATION,
                    decision["text"], decision["created"], issue=issue if _is_issue_number(issue) else None,
                    batch=False)

    def is_newest(self, decision):
        prompts = newest_prompts(self.engine, decision["session"])
        return bool(prompts) and prompts[0].get("id") == decision["message"]


def foreground_source(engine):
    return next((s for s in engine.sources if isinstance(s, ForegroundFacts)), None)


def note_decision(engine, observation, message, current, asks, answer):
    """An acting classification becomes a decoration, kept for the fact source. Audited either way."""
    found = decoration_for(answer["choice"], observation, current, asks)
    source = foreground_source(engine)
    detail = {"agent": observation.name, "message_id": message.get("id"), "choice": answer["choice"],
              "decoration": found[0] if found else None, "owner": (found[1] or {}).get("owner") if found else None}
    if found and source is None:
        detail["problem"] = "no foreground fact source is registered, so nothing can be delivered"
        found = None
    engine.audit.append(engine.actor, "foreground.decision", "decision:%s:%s" % (observation.session_id, message.get("id")),
                        detail)
    if found:
        source.record(observation, message, *found)
        if not message.get("pending"):  # the model already took your message: the decoration cannot ride with it
            engine.audit.append(engine.actor, "foreground.late", "decision:%s:%s" % (observation.session_id, message.get("id")),
                                {"agent": observation.name, "message_id": message.get("id"),
                                 "decoration": found[0], "age_seconds": round(engine.now() - (_created(message) or 0), 2)})


# ---- handoff: a brief, not a fork

class HandoffRefused(Exception):
    """A handoff that was refused before anything was written."""


BRIEF_LIMIT = 20000  # characters; a GitHub comment holds 65536
BRIEF_LABELS = ("goal", "done so far", "next steps", "watch out for")
_BRIEF_INLINE = re.compile(r"^\s{0,3}(?:#{1,6}\s+)?(?:[-*]\s+)?\**(%s)\**\s*:\**\s*(.*?)\s*$"
                           % "|".join(BRIEF_LABELS), re.IGNORECASE)
_BRIEF_HEADING = re.compile(r"^\s{0,3}#{1,6}\s+(%s)\s*#*\s*$" % "|".join(BRIEF_LABELS), re.IGNORECASE)
_BRIEF_TITLE = re.compile(r"^\s{0,3}#{1,6}\s+handoff\b", re.IGNORECASE)


def parse_brief(text):
    """{label: text} from a Chief of Staff's brief: sections named `Done so far:`, `Next steps:`,
    `Watch out for:` (and a `Goal:`, which the switchboard replaces). Anything else is refused,
    so no written word is silently dropped. Raises HandoffRefused."""
    if len(text) > BRIEF_LIMIT:
        raise HandoffRefused("the brief is %d characters; the limit is %d: say less, link more" % (len(text), BRIEF_LIMIT))
    sections, label, stray = {}, None, []
    for line in text.splitlines():
        found = _BRIEF_INLINE.match(line) or _BRIEF_HEADING.match(line)
        if found:
            label = found.group(1).lower()
            sections[label] = [found.group(2)] if found.lastindex == 2 and found.group(2) else []
        elif label is not None:
            sections[label].append(line)
        elif line.strip() and not _BRIEF_TITLE.match(line):
            stray.append(line.strip())
    if stray:
        raise HandoffRefused("the brief has text outside its sections (%s): put it under Done so far, Next steps "
                             "or Watch out for" % _one_line(stray[0], 80))
    parsed = {name: "\n".join(lines).strip() for name, lines in sections.items()}
    missing = [name.capitalize() for name in ("done so far", "next steps") if not parsed.get(name)]
    if missing:
        raise HandoffRefused("the brief has no %s: a subagent cannot continue from a brief without them"
                             % " and no ".join(missing))
    return parsed


def goal_line(issue):
    """Goal, from the ask's own Intent and Done-when: never retyped by the Chief of Staff."""
    line = issue.intent or NO_INTENT
    return "%s (Done when: %s)" % (line, issue.done_when) if issue.done_when else line


def handoff_markdown(issue, parsed):
    """The doc's handoff markdown for ask `issue` (an IssueIntent) and a parsed brief."""
    lines = ["## Handoff: ask %d" % issue.number, "Goal: %s" % goal_line(issue),
             "Done so far: %s" % parsed["done so far"], "Next steps: %s" % parsed["next steps"],
             "Watch out for: %s" % (parsed.get("watch out for") or "nothing noted")]
    return "\n".join(lines)


def post_ask_comment(engine, issue, body):
    """Comment on the ask through the configured `gh`. The one GitHub write the switchboard makes:
    the handoff brief, so the record survives (docs: Hand off). Audited before and after."""
    reader = engine.intents
    path = "repos/%s/issues/%d/comments" % (reader.repo, issue)
    with engine._external("github.comment", "issue:%d" % issue, {"repo": reader.repo, "issue": issue,
                                                                   "chars": len(body)}) as result:
        try:
            done = reader.runner([reader.gh, "api", path, "--method", "POST", "--input", "-"],
                                 input=json.dumps({"body": body}), capture_output=True, text=True,
                                 timeout=reader.timeout)
        except subprocess.TimeoutExpired:
            raise IntentError("unavailable", "gh did not answer within %ss" % reader.timeout) from None
        except OSError as err:
            raise IntentError("unavailable", "cannot run %s: %s" % (reader.gh, err.strerror or err)) from None
        if done.returncode != 0:
            raise IntentError("gh", _one_line(done.stderr) or _one_line(done.stdout) or "exit %d" % done.returncode)
        try:
            posted = json.loads(done.stdout)
        except ValueError:
            posted = {}
        url = posted.get("html_url") if isinstance(posted, dict) else None
        result["url"] = url if isinstance(url, str) else None
    return result["url"]


def handoff_refusals(engine, issue, name, directory, workspace, agent):
    """Why nothing may be written, found before anything is: the ask, the agent's name and place.
    Returns the ask (an IssueIntent)."""
    if engine.intents is None:
        raise HandoffRefused("'intent_repo' is not configured: a handoff fills Goal from the ask and posts "
                             "the brief on it")
    ask = engine.intents.issue(issue)
    if ask.charter:
        raise HandoffRefused("#%d is a charter, not an ask: hand off an ask under it" % issue)
    if ask.state != "open":
        raise HandoffRefused("ask #%d is %s: there is nothing to hand off" % (issue, ask.state or "not open"))
    problems = launch_problems(name, agent, directory, workspace, issue)
    if problems:
        raise HandoffRefused("; ".join(problems))
    taken = engine.discover(engine.now()).agents.get(name)
    if taken is not None:
        raise HandoffRefused("a fleet agent named %s already runs in pane %s: send it what is new with "
                             "fleet-switchboard send %s --issue %d" % (name, taken.pane, name, issue))
    return ask


def subagent_prompt(caller, issue, markdown):
    return ("%s\n\nYou are a background subagent for %s. Report with: fleet-switchboard send %s --issue %d \"...\" "
            "when you reach the ask's Done when, or when you are stuck." % (markdown, caller, caller, issue))


def handoff_ask(engine, caller, issue, brief, name=None, directory=None, workspace=None, agent=SUBAGENT_AGENT,
                patience=LAUNCH_PATIENCE, sleep=time.sleep):
    """The Chief of Staff's handoff: check, post the brief on the ask, launch the subagent. Returns a dict.

    Everything that can be refused is refused before the comment is posted.
    A launch that fails after the comment says so: the record stands.
    """
    name = name or "cos-%d" % issue
    parsed = parse_brief(brief)
    ask = handoff_refusals(engine, issue, name, directory, workspace, agent)
    markdown = handoff_markdown(ask, parsed)
    url = post_ask_comment(engine, issue, markdown)
    try:
        done = launch_agent(engine, name, agent, directory, workspace, COS_SUBAGENT, caller, issue,
                            subagent_prompt(caller, issue, markdown), patience, sleep)
    except LaunchError as err:
        raise LaunchError("the brief was posted on ask #%d, but the subagent did not start: %s" % (issue, err)) from err
    return dict(done, issue=issue, reports_to=caller, role=COS_SUBAGENT, comment=url,
                replaced_goal="goal" in parsed)


def cmd_handoff(args, runner, now, socket_call=None):
    workspace = args.workspace or os.environ.get("HERDR_WORKSPACE_ID")
    brief = read_brief(args.brief_file, sys.stdin)
    engine, _, _ = build_engine(runner, now, "cli", socket_call=socket_call)
    caller = identify_caller(engine.herdr, engine.v2, os.environ)
    try:
        done = handoff_ask(engine, caller, args.issue, brief, args.name, args.dir or os.getcwd(), workspace)
    except HandoffRefused as err:
        sys.stderr.write("%s: handoff refused: %s\n" % (PROG, err))
        return EXIT_USAGE
    if done.pop("replaced_goal"):
        sys.stderr.write("%s: the Goal line in your brief was replaced by the ask's own Intent and Done when\n" % PROG)
    print(json.dumps(done, sort_keys=True))
    return EXIT_OK


def add_foreground_parsers(sub):
    handoff = sub.add_parser("handoff", help="Hand your current work to a background subagent: post the brief on "
                                             "the ask and launch it, without typing")
    handoff.add_argument("--issue", type=int, required=True, help="The ask being handed off")
    handoff.add_argument("--brief-file", dest="brief_file", required=True,
                         help="The brief (Done so far, Next steps, Watch out for): a file, or - for stdin")
    handoff.add_argument("--name", help="The subagent's fleet name (default: cos-<issue>)")
    handoff.add_argument("--dir", help="The subagent's working directory (default: here)")
    handoff.add_argument("--workspace", help="The herdr workspace for its tab (default: $HERDR_WORKSPACE_ID)")


# ======================================================================
# Worker events, reminders and toasts (PR 4)
#
# Two fact sources, registered in fact_sources(): WorkerFacts derives "a worker
# finished" and "a worker is blocked" from herdr and v2 on every pass, and
# ReminderFacts turns the reminders file into facts once they are due. Neither
# stores anything about delivery. The only new state is reminders.json.
# Hooks into the engine: Switchboard.__init__ binds each source that has a
# `bind`, discover() keeps the newest Discovery, deliver() calls
# note_unreachable, render's toast candidates include source_toasts(), and
# run_pass() ends with finish_pass.
# ======================================================================

WORKER_IDLE = "worker.idle"
WORKER_BLOCKED = "worker.blocked"
SUMMARY_CAP = 600  # characters of a worker's last reply in its fact
LAB_WORKER_SINCE_ENV = "FLEET_SWITCHBOARD_LAB_WORKER_SINCE"
REMINDERS = "reminders.json"
REMINDER_LOCK = "reminders.lock"
REMINDER_UNITS = {"s": 1, "m": 60, "h": 3600, "d": 86400}


def worker_horizon(config, now):
    """The oldest `idle_at` that still counts: `worker_lookback_hours` back, so a
    restart does not resurface ancient completions. In the Lab, the environment
    may name a later start (LAB_WORKER_SINCE_ENV, epoch seconds), so the warm-up
    turns that precede a play are not news; it is ignored outside the Lab."""
    horizon = now - config["worker_lookback_hours"] * 3600
    raw = os.environ.get(LAB_WORKER_SINCE_ENV) if os.environ.get(LAB_ENV) == "1" else None
    if raw:
        try:
            horizon = max(horizon, float(raw))
        except ValueError:
            raise FactError("%s must be epoch seconds, got %r" % (LAB_WORKER_SINCE_ENV, raw)) from None
    return horizon


def reply_text(message):
    """The text of one v2 assistant message: `text`, or its text parts."""
    if not isinstance(message, dict):
        return ""
    text = message.get("text")
    if not isinstance(text, str):
        parts = message.get("content") if isinstance(message.get("content"), list) else []
        text = " ".join(part.get("text", "") for part in parts
                        if isinstance(part, dict) and isinstance(part.get("text"), str))
    return text


def _issue_of(fleet):
    issue = fleet.get("issue") if isinstance(fleet, dict) else None
    return issue if isinstance(issue, int) and not isinstance(issue, bool) and issue >= 1 else None


def _boss_of(observation):
    """Who a worker reports to, or None when it reports to nobody (or to itself)."""
    boss = observation.fleet.get("reports_to")
    return boss if isinstance(boss, str) and boss and boss != observation.name else None


class WorkerFacts:
    """Facts about workers (fleet agents that have a `reports_to`), derived on every call.

    `worker.idle:<session>:<idle_at ms>`: its turn ended (herdr says idle, v2's
    `time.idle` is set and within the look-back). For its `reports_to`.
    `worker.blocked:<session>:<request id>`: herdr says blocked, and v2 lists a
    pending permission request or form. For its `reports_to`; the human also
    gets a toast (see `toasts`).
    Nothing is stored: the same state gives the same facts (invariant 1).
    """

    __name__ = "worker_facts"

    def __init__(self):
        self.engine = None
        self._blocked = []       # toasts of the last call: (agent, reason, title, body)
        self._summaries = {}     # (session, idle ms) -> text; a cache, rebuilt after a restart
        self._no_forms = False   # v2 does not know the form operation (UNVERIFIED name)

    def bind(self, engine):
        self.engine = engine

    def toasts(self):
        return list(self._blocked)

    def __call__(self):
        self._blocked = []
        engine = self.engine
        discovery = getattr(engine, "discovery", None)
        if engine is None or discovery is None or fault("no-worker-source"):
            return []
        horizon = worker_horizon(engine.config, engine.now())
        facts = []
        for observation in sorted(discovery.agents.values(), key=lambda o: o.name):
            boss = _boss_of(observation)
            if boss is None or observation.conflict or observation.problem:
                continue
            try:
                facts.extend(self.finished(observation, boss, horizon))
                facts.extend(self.blocked(observation, boss))
            except V2Error as err:  # one worker's trouble never hides the others
                engine._note("source.error", "worker_facts:" + observation.name, {"error": _one_line(str(err))})
        return facts

    def finished(self, observation, boss, horizon):
        if observation.status != "idle" or observation.idle_at is None or observation.idle_at < horizon:
            return []
        idle_ms = int(round(observation.idle_at * 1000))
        key = "%s:%s:%d" % (WORKER_IDLE, observation.session_id, idle_ms)
        head = "%s finished its turn (%s)" % (observation.name, observation.outcome or "no outcome recorded")
        reply = self.last_reply(observation.session_id, idle_ms)
        return [Fact(key, boss, WORKER_IDLE, head + (": " + reply if reply else ""), observation.idle_at,
                     issue=_issue_of(observation.fleet), sender=observation.name)]

    def last_reply(self, session_id, idle_ms):
        """The worker's last assistant reply, cut to SUMMARY_CAP; read once per turn."""
        cached = self._summaries.get((session_id, idle_ms))
        if cached is not None:
            return cached
        page = self.engine.v2.message_list(session_id, limit=1, type="assistant")
        text = _one_line(reply_text(page[0]) if isinstance(page, list) and page else "", SUMMARY_CAP)
        if len(self._summaries) > 500:
            self._summaries.clear()
        self._summaries[(session_id, idle_ms)] = text
        return text

    def blocked(self, observation, boss):
        if observation.status != "blocked":
            return []
        facts = []
        for kind, items in (("permission", self.engine.v2.permission_list(observation.session_id)),
                            ("question", self.pending_forms(observation))):
            for item in items if isinstance(items, list) else []:
                if isinstance(item, dict) and isinstance(item.get("id"), str) and item["id"]:
                    facts.append(self.blocked_fact(observation, boss, kind, item))
        return facts

    def pending_forms(self, observation):
        if self._no_forms:
            return []
        try:
            return self.engine.v2.form_list(observation.session_id)
        except V2Error as err:
            if err.reason == "http" and err.status == 404:
                self._no_forms = True  # this v2 has no such operation; stop asking
                return []
            raise

    def blocked_fact(self, observation, boss, kind, item):
        key = "%s:%s:%s" % (WORKER_BLOCKED, observation.session_id, item["id"])
        what = " ".join(str(part) for part in [item.get("action") or item.get("title") or kind]
                        + [r for r in item.get("resources") or [] if isinstance(r, str)])
        asked = _created(item)  # when v2 says it asked; without it the fact is urgent, not batched
        summary = "%s is blocked on a %s request and cannot go on until you answer it: %s" % (
            observation.name, kind, _one_line(what, 200))
        if isinstance(item.get("message"), str) and item["message"].strip():
            summary += " (reason given: %s)" % _one_line(item["message"], 200)
        issue = _issue_of(observation.fleet)
        # A hook's message (PR 9: the policy judge's reason) is on the request as `message`: say it first.
        note = _one_line(item["message"], 120) if isinstance(item.get("message"), str) else ""
        shown = "%s (%s)" % (note, _one_line(what, 60)) if note else what
        self._blocked.append((observation.name, key, "Fleet: %s is blocked" % observation.name,
                              _one_line("%s is waiting for you: %s%s" % (
                                  observation.name, shown, " (issue #%d)" % issue if issue else ""), 200)))
        return Fact(key, boss, WORKER_BLOCKED, summary, asked if asked is not None else self.engine.now(),
                    issue=issue, batch=asked is not None, sender=observation.name)


# ---- toasts

def note_unreachable(engine, recipient, fresh, why):
    """The re-check could not read the recipient at all (pane closed, session gone):
    the pass's render step toasts it, once, like every other toast."""
    if fresh is None:
        engine.pass_toasts[recipient] = ("unreachable: " + why, "Fleet: %s cannot be reached" % recipient,
                                         _one_line("Held, nothing sent to %s: %s" % (recipient, why), 200))


def collect_source_toasts(engine):
    """What the fact sources and this pass's re-checks ask the human to be told."""
    found = {}
    for source in engine.sources:
        toasts = getattr(source, "toasts", None)
        for agent, reason, title, body in toasts() if toasts else []:
            found[agent] = (reason, title, body)
    found.update(engine.pass_toasts)
    return found


def finish_pass(engine, discovery, report):
    """The end of a pass: reminders that reached their recipient are pruned. A failure is
    audited and never stops the pass."""
    try:
        prune_delivered_reminders(engine, discovery)
    except Exception as err:
        engine._failed("reminders", "reminders", err, report)


# ---- reminders

def parse_when(text, now):
    """`30m`, `+2h`, `1d` (from now), or an ISO-8601 time with an offset or `Z`. Epoch seconds."""
    match = re.fullmatch(r"\+?([0-9]+)([smhd])", text.strip())
    if match:
        return now + int(match.group(1)) * REMINDER_UNITS[match.group(2)]
    try:
        moment = datetime.fromisoformat(text.strip().replace("Z", "+00:00"))
    except ValueError:
        raise ReminderError("when must be a delay such as 30m, 2h or 1d, or an ISO time with a zone "
                            "such as 2030-01-02T09:00:00Z, got %r" % text) from None
    if moment.tzinfo is None:
        raise ReminderError("when %r has no time zone; add Z or an offset" % text)
    return moment.timestamp()


class ReminderError(FactError):
    """reminders.json cannot be read or written, or a reminder cannot be made."""


@contextmanager
def reminders_lock(state_dir):
    """Serialises the CLI and the daemon around the read-modify-write of reminders.json."""
    fd = os.open(str(Path(state_dir) / REMINDER_LOCK), os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)


def read_reminders(state_dir):
    path = Path(state_dir) / REMINDERS
    try:
        raw = json.loads(path.read_text())
    except FileNotFoundError:
        return []
    except (OSError, ValueError) as err:
        raise ReminderError("cannot read %s: %s" % (path, err)) from None
    items = raw.get("reminders") if isinstance(raw, dict) else None
    if not isinstance(items, list):
        raise ReminderError("%s must hold {\"reminders\": [...]}" % path)
    for item in items:
        if not (isinstance(item, dict) and isinstance(item.get("id"), str) and isinstance(item.get("to"), str)
                and _is_number(item.get("at")) and isinstance(item.get("text"), str)):
            raise ReminderError("%s has a reminder without id, to, at and text: %r" % (path, item))
    return items


def write_reminders(state_dir, items):
    """Replace reminders.json atomically, mode 0600: a crash leaves the old file or the new one."""
    path = Path(state_dir) / REMINDERS
    temp = path.with_name("%s.%d.tmp" % (REMINDERS, os.getpid()))
    fd = os.open(str(temp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        with os.fdopen(fd, "w") as handle:
            json.dump({"reminders": items}, handle, indent=1, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(str(temp), str(path))
    except BaseException:
        try:
            os.unlink(str(temp))
        except OSError:
            pass
        raise


def add_reminder(state_dir, to, at, created, text, issue=None, sender=None):
    if not isinstance(to, str) or not to.strip():
        raise ReminderError("a reminder needs the name of the agent it is for")
    if not text.strip():
        raise ReminderError("a reminder needs text")
    item = {"id": uuid.uuid4().hex[:12], "to": to, "at": float(at), "created": float(created),
            "text": text, "issue": issue, "from": sender}
    with reminders_lock(state_dir):
        write_reminders(state_dir, read_reminders(state_dir) + [item])
    return item


def remove_reminders(state_dir, ids):
    """Drop these ids from reminders.json. Returns the ids that were there."""
    with reminders_lock(state_dir):
        items = read_reminders(state_dir)
        gone = [item["id"] for item in items if item["id"] in ids]
        if gone:
            write_reminders(state_dir, [item for item in items if item["id"] not in ids])
    return gone


class ReminderFacts:
    """`reminder:<id>` facts for reminders that are due. A reminder not yet due is no fact.

    A due reminder skips the batch window: it is one event at an exact time.
    It stays in the file until its key shows in the recipient's transcript or
    inbox (prune_delivered_reminders), so a crash before delivery loses nothing.
    """

    __name__ = "reminder_facts"

    def __init__(self, state_dir):
        self.state_dir, self.engine = Path(state_dir), None

    def bind(self, engine):
        self.engine = engine

    def due(self):
        now = self.engine.now() if self.engine else time.time()
        return [item for item in read_reminders(self.state_dir) if item["at"] <= now]

    def __call__(self):
        return [Fact("reminder:" + item["id"], item["to"], "reminder", item["text"], item["at"],
                     issue=item.get("issue"), batch=False, sender=item.get("from"))
                for item in self.due()]


def prune_delivered_reminders(engine, discovery):
    """Forget the due reminders whose key is already in their recipient's transcript or inbox."""
    source = next((s for s in engine.sources if isinstance(s, ReminderFacts)), None)
    if source is None:
        return []
    by_recipient = {}
    for item in source.due():
        by_recipient.setdefault(item["to"], []).append(item)
    delivered = []
    for name, items in sorted(by_recipient.items()):
        observation = discovery.agents.get(name)
        if observation is None:
            continue
        try:
            keys, _ = engine.delivered_keys(observation.session_id, min(i["at"] for i in items) - SINCE_SLACK)
        except V2Error:
            continue
        delivered += [item["id"] for item in items if "reminder:" + item["id"] in keys]
    gone = remove_reminders(source.state_dir, set(delivered)) if delivered else []
    if gone and engine.audit is not None:
        engine.audit.append(engine.actor, "reminder.prune", None, {"ids": gone})
    return gone


def cmd_remind(args, runner, now):
    engine, state, _ = build_engine(runner, now, "cli")
    if args.sender is not None:
        if os.environ.get(LAB_ENV) != "1":
            sys.stderr.write("%s: --from is only for the Lab (%s=1); an agent is identified by its pane\n"
                             % (PROG, LAB_ENV))
            return EXIT_USAGE
        sender = args.sender
    else:
        sender = identify_caller(engine.herdr, engine.v2, os.environ)
    moment = now()
    item = add_reminder(state, args.name, parse_when(args.when, moment), moment,
                        " ".join(args.text).strip(), args.issue, sender)
    engine.audit.append("cli", "reminder.add", args.name, {"id": item["id"], "at": iso(item["at"]),
                                                          "from": sender, "issue": args.issue})
    print(item["id"])
    sys.stderr.write("%s: reminder for %s at %s\n" % (PROG, args.name, iso(item["at"])))
    return EXIT_OK


# ======================================================= GitHub events (PR 5)
#
# One section, self-contained. The pieces, in the order they are built:
#
#   config      `_validate_github`, called from validate_config
#   verify      `signature_matches`: HMAC-SHA256 of the raw body, constant time
#   items       webhook payloads and catch-up reads -> GitHubItem, with keys
#               made from GitHub object ids (never delivery ids)
#   hub         `GitHubHub`: the localhost listener, one supervised
#               `gh webhook forward` child per watched repo, the in-memory
#               queue the fact source drains, the catch-up read, routing
#   status      `github_status` / `format_github`
#
# Facts are not stored. Webhook arrivals wait in memory until the engine
# reports them delivered (or found in the recipient's transcript); a daemon
# restart relies on the catch-up read. The webhook secret is made for every
# forwarder start and lives only in memory and in that forwarder's argv.

GITHUB_EVENTS = ["issues", "issue_comment", "sub_issues", "pull_request", "pull_request_review",
                 "check_suite", "workflow_run"]
GITHUB_REPO_RE = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")
GITHUB_EVENT_RE = re.compile(r"^[a-z_]+$")
GITHUB_BACKOFF_BASE = 5        # seconds before the first restart; doubles each failure
GITHUB_BACKOFF_MAX = 300
GITHUB_STABLE = 60             # a forwarder that ran this long starts the backoff over
GITHUB_CONFLICT_RETRY = 1800   # seconds between attempts, and catch-up reads, while someone else forwards
GITHUB_CATCHUP_DELAY = 10      # seconds after a start: the forwarder has connected, so no gap remains
GITHUB_LOOKUP_TTL = 600
GITHUB_LOOKUP_RETRY = 60
GITHUB_BODY_LIMIT = 5 * 1024 * 1024
GITHUB_QUEUE_LIMIT = 2000
GITHUB_REJECT_AUDITS = 20      # bad-signature audit lines per minute; the rest are only counted
CONFLICT_TEXT = "Hook already exists"
WATCH_FILE = "github-watch.json"
WATCH_STATES = ("starting", "running", "backoff", "conflict")


def _validate_github(config, source):
    """Check the github_* keys and `gh`; give `config` its own copies of the lists."""
    repos = config["github_repos"]
    if not isinstance(repos, list) or not all(isinstance(r, str) and GITHUB_REPO_RE.match(r) for r in repos):
        raise ConfigError("%s: 'github_repos' must be a list of \"owner/repo\" strings, got %r" % (source, repos))
    if len(set(repos)) != len(repos):
        raise ConfigError("%s: 'github_repos' names a repo twice: one forwarder per repo" % source)
    events = config["github_events"]
    if not isinstance(events, list) or not events or not all(
            isinstance(e, str) and GITHUB_EVENT_RE.match(e) for e in events):
        raise ConfigError("%s: 'github_events' must be a non-empty list of event names such as "
                          "\"issue_comment\", got %r" % (source, events))
    if not isinstance(config["gh"], str) or not config["gh"].strip():
        raise ConfigError("%s: 'gh' must be a non-empty string (a path or a command name), got %r"
                          % (source, config["gh"]))
    if not _is_number(config["github_lookback_hours"]) or config["github_lookback_hours"] <= 0:
        raise ConfigError("%s: 'github_lookback_hours' must be a positive number, got %r"
                          % (source, config["github_lookback_hours"]))
    port = config["github_port"]
    if port is not None and not (isinstance(port, int) and not isinstance(port, bool) and 1 <= port <= 65535):
        raise ConfigError("%s: 'github_port' must be null (any free port) or a port number, got %r" % (source, port))
    config["github_repos"], config["github_events"] = list(repos), list(events)


# ------------------------------------------------------------- verification

def sign_body(secret, body):
    """The `X-Hub-Signature-256` value for `body` under `secret`."""
    return "sha256=" + hmac.new(secret.encode("utf-8"), body, hashlib.sha256).hexdigest()


def signature_matches(secret, body, header):
    """True when `header` is the signature of the raw `body`. Constant time."""
    if not isinstance(header, str) or not secret:
        return False
    return hmac.compare_digest(sign_body(secret, body).encode("ascii"), header.encode("utf-8", "replace"))


def _scrub(text, *secrets_):
    """`text` with every secret in `secrets_` replaced; for anything read back from a child."""
    for secret in secrets_:
        if secret:
            text = text.replace(secret, REDACTED)
    return text


# -------------------------------------------------------------------- items

class GitHubItem:
    """One thing that happened on GitHub, keyed by object id, not yet routed.

    `issues`: issue numbers it is known to concern (the issue, its parents,
    the issues a PR closes), nearest first. `lookups`: `("issue", n)` or
    `("pr", n)` reads that can add more, made only when `issues` names no
    owner. `recipient` is set once an owner is found.
    """

    def __init__(self, key, kind, summary, repo, issues, lookups, sender, created):
        self.key, self.kind, self.summary, self.repo = key, kind, summary, repo
        self.issues, self.lookups, self.sender, self.created = list(issues), list(lookups), sender, created
        self.recipient = None

    @property
    def issue(self):
        return self.issues[0] if self.issues else None


CLOSES_RE = re.compile(r"\b(?:close[sd]?|fix(?:e[sd])?|resolve[sd]?)\b:?\s+(?:[\w.-]+/[\w.-]+)?#(\d+)", re.I)


def closing_numbers(text):
    """Issue numbers named by "closes #N", "fixes #N", "resolves #N" in a PR body."""
    found = []
    for match in CLOSES_RE.finditer(text if isinstance(text, str) else ""):
        if int(match.group(1)) not in found:
            found.append(int(match.group(1)))
    return found


def _id(obj):
    value = obj.get("id") if isinstance(obj, dict) else None
    return value if isinstance(value, int) and not isinstance(value, bool) else None


def _number(obj):
    value = obj.get("number") if isinstance(obj, dict) else None
    return value if isinstance(value, int) and not isinstance(value, bool) and value >= 1 else None


def _login(obj):
    user = obj.get("user") if isinstance(obj, dict) else None
    login = user.get("login") if isinstance(user, dict) else None
    return login if isinstance(login, str) and login else None


def _url_number(url):
    match = re.search(r"/(?:issues|pulls)/([0-9]+)$", url) if isinstance(url, str) else None
    return int(match.group(1)) if match else None


def parent_of(issue):
    """The parent issue number a payload or REST issue names, if it does."""
    if not isinstance(issue, dict):
        return None
    for field in ("parent", "parent_issue"):
        value = issue.get(field)
        found = value if isinstance(value, int) and not isinstance(value, bool) else _number(value)
        if found:
            return found
    return _url_number(issue.get("parent_issue_url"))


def _is_pr(issue):
    return isinstance(issue, dict) and bool(issue.get("pull_request"))


def _issue_refs(issue, number):
    """(known issue numbers, lookups) for something that lives on issue or PR `number`."""
    if _is_pr(issue):
        return closing_numbers(issue.get("body")), [("pr", number)]
    parent = parent_of(issue)
    if parent:
        return [number, parent], [("issue", parent)]
    return [number], [("issue", number)]


def _pr_refs(pr, number):
    """(known, lookups) for a PR object: the issues it closes, the ones the payload links."""
    known = closing_numbers(pr.get("body") if isinstance(pr, dict) else None)
    linked = pr.get("linked_issues") if isinstance(pr, dict) else None
    for entry in linked if isinstance(linked, list) else []:
        n = entry if isinstance(entry, int) and not isinstance(entry, bool) else _number(entry)
        if n and n not in known:
            known.append(n)
    return known, [("issue", n) for n in known] if known else [("pr", number)]


def _pr_numbers(obj):
    prs = obj.get("pull_requests") if isinstance(obj, dict) else None
    return [n for n in (_number(p) for p in (prs if isinstance(prs, list) else [])) if n]


def _comment_item(repo, comment, issue, now):
    cid = _id(comment)
    number = _number(issue) or _url_number(comment.get("issue_url"))
    if cid is None or number is None:
        return None
    known, lookups = _issue_refs(issue, number)
    summary = "@%s commented on #%d: %s" % (_login(comment) or "someone", number, _one_line(comment.get("body") or "", 400))
    return GitHubItem("github.comment:%d" % cid, "github.comment", summary, repo, known, lookups, _login(comment), now)


def _issue_item(repo, issue, now, what=None):
    iid, number, updated = _id(issue), _number(issue), issue.get("updated_at")
    if iid is None or number is None or not isinstance(updated, str):
        return None
    known, lookups = _issue_refs(issue, number)
    summary = "issue #%d %s: %s" % (number, what or "updated", _one_line(issue.get("title") or "", 200))
    return GitHubItem("github.issue:%d:%s" % (iid, updated), "github.issue", summary, repo, known, lookups,
                      _login(issue), now)


def _pr_state(pr):
    return "merged" if pr.get("merged") or pr.get("merged_at") else str(pr.get("state") or "open")


def _pr_item(repo, pr, now):
    pid, number = _id(pr), _number(pr)
    if pid is None or number is None:
        return None
    state = _pr_state(pr)
    known, lookups = _pr_refs(pr, number)
    summary = "PR #%d is %s: %s" % (number, state, _one_line(pr.get("title") or "", 200))
    return GitHubItem("github.pr:%d:%s" % (pid, state), "github.pr", summary, repo, known, lookups, _login(pr), now)


def _review_item(repo, review, pr, now):
    rid, number = _id(review), _number(pr)
    if rid is None or number is None:
        return None
    known, lookups = _pr_refs(pr, number)
    state = str(review.get("state") or "reviewed").lower()
    summary = "@%s reviewed PR #%d (%s): %s" % (_login(review) or "someone", number, state,
                                                _one_line(review.get("body") or "", 300))
    return GitHubItem("github.review:%d" % rid, "github.review", summary, repo, known, lookups, _login(review), now)


def _check_item(repo, obj, now, prefix, label):
    oid, conclusion = _id(obj), obj.get("conclusion")
    numbers = _pr_numbers(obj)
    if oid is None or not isinstance(conclusion, str) or not conclusion or not numbers:
        return None
    summary = "%s %s on PR %s" % (label, conclusion, ", ".join("#%d" % n for n in numbers))
    return GitHubItem("github.check:%s%d:%s" % (prefix, oid, conclusion), "github.check", summary, repo, [],
                      [("pr", n) for n in numbers], None, now)


def _wh_issues(repo, payload, now):
    action, issue = payload.get("action"), payload.get("issue")
    if action not in ("opened", "edited", "closed", "reopened", "labeled", "unlabeled"):
        return []
    what = action
    label = (payload.get("label") or {}).get("name") if isinstance(payload.get("label"), dict) else None
    if action in ("labeled", "unlabeled") and label:
        what = "label %s %s" % (label, "added" if action == "labeled" else "removed")
    item = _issue_item(repo, issue, now, what)
    return [item] if item else []


def _wh_issue_comment(repo, payload, now):
    if payload.get("action") != "created":
        return []
    item = _comment_item(repo, payload.get("comment") or {}, payload.get("issue"), now)
    return [item] if item else []


def _wh_pull_request(repo, payload, now):
    if payload.get("action") not in ("opened", "reopened", "closed", "ready_for_review"):
        return []
    item = _pr_item(repo, payload.get("pull_request") or {}, now)
    return [item] if item else []


def _wh_review(repo, payload, now):
    if payload.get("action") != "submitted":
        return []
    item = _review_item(repo, payload.get("review") or {}, payload.get("pull_request") or {}, now)
    return [item] if item else []


def _wh_check_suite(repo, payload, now):
    if payload.get("action") != "completed":
        return []
    item = _check_item(repo, payload.get("check_suite") or {}, now, "", "check suite")
    return [item] if item else []


def _wh_workflow_run(repo, payload, now):
    if payload.get("action") != "completed":
        return []
    run = payload.get("workflow_run") or {}
    item = _check_item(repo, run, now, "run-", "workflow %s" % (run.get("name") or "run"))
    return [item] if item else []


def _wh_sub_issues(repo, payload, now):
    parent, sub, action = payload.get("parent_issue"), payload.get("sub_issue"), payload.get("action")
    pid, sid, pn, sn = _id(parent), _id(sub), _number(parent), _number(sub)
    if None in (pid, sid, pn, sn) or not isinstance(action, str):
        return []
    summary = "sub-issue #%d: %s (parent #%d)" % (sn, action.replace("_", " "), pn)
    return [GitHubItem("github.subissue:%d:%d:%s" % (pid, sid, action), "github.subissue", summary, repo,
                       [pn, sn], [("issue", pn)], _login(payload.get("sender")), now)]


WEBHOOK_HANDLERS = {"issues": _wh_issues, "issue_comment": _wh_issue_comment, "pull_request": _wh_pull_request,
                    "pull_request_review": _wh_review, "check_suite": _wh_check_suite,
                    "workflow_run": _wh_workflow_run, "sub_issues": _wh_sub_issues}


def webhook_items(event, payload, now):
    """The items one webhook delivery holds. An event nobody handles holds none."""
    handler = WEBHOOK_HANDLERS.get(event)
    repo = (payload.get("repository") or {}).get("full_name") if isinstance(payload, dict) else None
    if handler is None or not isinstance(repo, str):
        return []
    return handler(repo, payload, now)


def decode_json_stream(text):
    """Every JSON value in `text`: `gh api --paginate` prints one document per page."""
    decoder, values, at = json.JSONDecoder(), [], 0
    while True:
        while at < len(text) and text[at].isspace():
            at += 1
        if at >= len(text):
            return values
        value, at = decoder.raw_decode(text, at)
        values.append(value)


def _records(values, key=None):
    """The records in pages: lists are flattened; with `key`, an object's list under it."""
    records = []
    for value in values:
        if isinstance(value, list):
            records.extend(value)
        elif isinstance(value, dict) and key and isinstance(value.get(key), list):
            records.extend(value[key])
    return [r for r in records if isinstance(r, dict)]


def _is_orchestrator(observation):
    return (observation.fleet or {}).get("role") == "orchestrator"


def pick_owner(agents, numbers, repo=None):
    """The fleet agent that owns the first of `numbers`, or None. One recipient per item.

    An agent owns the issues in its metadata.fleet `issue` and `charter`. An
    orchestrator beats any other role; then the nearest issue in `numbers`
    wins, then the name.
    """
    best = None
    for name in sorted(agents):
        fleet = agents[name].fleet or {}
        if repo and isinstance(fleet.get("repo"), str) and fleet["repo"] != repo:
            continue
        owned = set()
        for field in ("issue", "charter"):
            value = fleet.get(field)
            if isinstance(value, int) and not isinstance(value, bool):
                owned.add(value)
            elif isinstance(value, str) and value.strip().lstrip("#").isdigit():
                owned.add(int(value.strip().lstrip("#")))
        ranks = [numbers.index(n) for n in owned if n in numbers]
        if ranks:
            rank = (0 if fleet.get("role") == "orchestrator" else 1, min(ranks))
            if best is None or rank < best[0]:
                best = (rank, name)
    return best[1] if best else None


# ------------------------------------------------------------------- the hub

class GitHubUnavailable(Exception):
    """A `gh api` read that did not answer; the caller tries again later."""


class Watch:
    """One watched repo: its forwarder child and what is known about it. Memory only."""

    def __init__(self, repo):
        self.repo, self.state, self.proc, self.secret = repo, "backoff", None, None
        self.failures = self.starts = 0
        self.next_start = 0.0
        self.started = self.catchup_at = self.last_catch_up = None
        self.last_error = self.catch_up_error = None

    def to_json(self):
        """What `status` may show. Never the secret."""
        return {"repo": self.repo, "state": self.state, "starts": self.starts, "failures": self.failures,
                "forwarder_pid": getattr(self.proc, "pid", None), "started": iso(self.started),
                "next_start": iso(self.next_start) if self.proc is None else None,
                "last_catch_up": iso(self.last_catch_up), "last_error": self.last_error,
                "catch_up_error": self.catch_up_error}


def spawn_forwarder(argv, log_path):
    """Start the forwarder detached, its output in `log_path`. It never inherits our pipes."""
    fd = os.open(str(log_path), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        return subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=fd, stderr=fd,
                                start_new_session=True, close_fds=True)
    finally:
        os.close(fd)


def _terminate(proc):
    """Stop a forwarder and anything it started (it leads its own process group)."""
    try:
        if isinstance(proc, subprocess.Popen):
            os.killpg(proc.pid, signal.SIGTERM)
        else:
            proc.terminate()
    except (OSError, ProcessLookupError):
        pass


class GitHubHub:
    """The listener, the forwarder supervisor, the queue and the catch-up read.

    Everything shared between the listener thread, the supervisor thread and
    the engine's pass is behind `self.lock`. `now`, `runner` (for `gh api`) and
    `spawn` (for the forwarders) are injected, so tests run a simulated clock
    and a fake `gh` and never reach a real binary.
    """

    def __init__(self, config, state_dir, audit=None, runner=subprocess.run, spawn=spawn_forwarder,
                 now=time.time, actor="daemon"):
        self.config, self.state_dir, self.audit = config, Path(state_dir), audit
        self.runner, self.spawn, self.now, self.actor = runner, spawn, now, actor
        self.lock = threading.RLock()
        self.queue = {}        # key -> GitHubItem, until delivered
        self.watches = {repo: Watch(repo) for repo in config["github_repos"]}
        self.lookback = config["github_lookback_hours"] * 3600
        self.backoff_base, self.backoff_max = GITHUB_BACKOFF_BASE, GITHUB_BACKOFF_MAX
        self.conflict_retry, self.catchup_delay = GITHUB_CONFLICT_RETRY, GITHUB_CATCHUP_DELAY
        self.discover = lambda: None  # set by attach()
        self.autostart = True
        self.port, self.server, self.threads, self.stopping = config["github_port"] or 0, None, [], threading.Event()
        self._cache, self._retry, self._rejects, self._suppressed = {}, {}, [], 0
        self._unrouted, self._snapshot = set(), None

    # -- wiring

    def attach(self, engine):
        """Make this hub one of `engine`'s fact sources, reading the fleet through it."""
        self.discover = lambda: engine.discover(engine.now())
        engine.sources.append(self.fact_source())
        return engine

    def _audit(self, event, subject, detail):
        if self.audit is not None:
            self.audit.append(self.actor, event, subject, detail)

    # -- the listener

    def open_listener(self):
        """Bind 127.0.0.1 (never another address) and serve POST /github in a thread."""
        hub = self

        class Handler(BaseHTTPRequestHandler):
            server_version = "fleet-switchboard"
            timeout = 10  # a stalled sender must not hold a thread

            def _reply(self, status, text):
                data = (text + "\n").encode("utf-8")
                self.send_response(status)
                self.send_header("Content-Type", "text/plain; charset=utf-8")
                self.send_header("Content-Length", str(len(data)))
                self.end_headers()
                self.wfile.write(data)

            def do_POST(self):
                try:
                    size = int(self.headers.get("Content-Length", ""))
                except ValueError:
                    return self._reply(411, "length required")
                if size < 0 or size > GITHUB_BODY_LIMIT:
                    return self._reply(413, "too large")
                status, text = hub.receive(self.path.split("?")[0], self.headers, self.rfile.read(size))
                self._reply(status, text)

            def do_GET(self):
                self._reply(405, "POST only")

            def log_message(self, *args):  # the daemon's stderr is not a log
                pass

        server = ThreadingHTTPServer(("127.0.0.1", self.port), Handler)
        server.daemon_threads = True
        self.server, self.port = server, server.server_address[1]
        self._thread(server.serve_forever)
        return self.port

    def _thread(self, target):
        thread = threading.Thread(target=target, daemon=True)
        thread.start()
        self.threads.append(thread)

    def start(self):
        """Open the listener, then supervise the forwarders every second. Idempotent."""
        with self.lock:
            if self.server is not None:
                return
            self.stopping.clear()
            self.open_listener()
            self._thread(self._supervise)

    def _supervise(self):
        while not self.stopping.wait(1.0):
            try:
                self.tick()
            except Exception as err:  # the supervisor must outlive any one bad tick
                self._audit("github.error", None, {"error": _one_line(str(err))})

    def stop(self):
        """Stop the listener and every forwarder."""
        self.stopping.set()
        server, self.server = self.server, None
        if server is not None:
            server.shutdown()
            server.server_close()
        with self.lock:
            for watch in self.watches.values():
                if watch.proc is not None:
                    _terminate(watch.proc)
                    watch.proc, watch.secret, watch.state = None, None, "backoff"
            self._write_snapshot(self.now(), stopped=True)

    # -- receiving

    def _verified_repo(self, header, body):
        """The repo whose current secret signed `body`, or None. Checks every secret."""
        match = None
        with self.lock:
            for repo, watch in self.watches.items():
                if watch.secret and signature_matches(watch.secret, body, header):
                    match = repo
        return match

    def _reject(self, reason, body):
        now = self.now()
        with self.lock:
            self._rejects = [t for t in self._rejects if now - t < 60]
            if len(self._rejects) >= GITHUB_REJECT_AUDITS:
                self._suppressed += 1
                return
            self._rejects.append(now)
            suppressed, self._suppressed = self._suppressed, 0
        self._audit("github.rejected", None, {"reason": reason, "bytes": len(body), "also_rejected": suppressed})

    def receive(self, path, headers, body):
        """One POST. The signature is checked before the body is read as anything.

        Returns (HTTP status, one line). Nothing is ingested unless it passes.
        """
        if path != "/github":
            return 404, "not found"
        header = _header(headers, "X-Hub-Signature-256")
        repo = self._verified_repo(header, body)
        if repo is None:
            self._reject("signature missing" if not header else "signature does not match", body)
            return 401, "bad signature"
        try:
            payload = json.loads(body.decode("utf-8"))
            if not isinstance(payload, dict):
                raise ValueError("not an object")
        except ValueError:
            self._audit("github.rejected", repo, {"reason": "body is not a JSON object", "bytes": len(body)})
            return 400, "bad body"
        event = _header(headers, "X-GitHub-Event") or ""
        sent = (payload.get("repository") or {}).get("full_name")
        if sent not in (None, repo):
            self._audit("github.rejected", repo, {"reason": "payload names another repo", "event": event})
            return 202, "ignored"
        try:
            items = webhook_items(event, dict(payload, repository={"full_name": repo}), self.now())
        except Exception as err:
            self._audit("github.rejected", repo, {"reason": "unreadable %s: %s" % (event, _one_line(str(err)))})
            return 400, "bad payload"
        self.enqueue(items)
        self._audit("github.received", repo, {"event": event, "delivery": _header(headers, "X-GitHub-Delivery"),
                                              "keys": [item.key for item in items]})
        return 202, "accepted"

    def enqueue(self, items):
        with self.lock:
            for item in items:
                self.queue.setdefault(item.key, item)  # the same object seen twice is one item
            while len(self.queue) > GITHUB_QUEUE_LIMIT:
                self.queue.pop(next(iter(self.queue)))

    def acknowledge(self, keys):
        """The engine found these keys delivered: forget them. Not stored, so a later
        catch-up that reads them again queues them once more, and the transcript
        stops the repeat."""
        with self.lock:
            for key in keys:
                self.queue.pop(key, None)

    # -- the fact source

    def fact_source(self):
        def github_facts():
            if self.autostart:
                self.start()  # inside the daemon's lock: the first pass starts it
            return self.facts()
        github_facts.acknowledge = self.acknowledge
        return github_facts

    def facts(self):
        """Every queued item that has an owner now, as Facts. Expired items are dropped."""
        now = self.now()
        with self.lock:
            for key in [k for k, i in self.queue.items() if i.created < now - self.lookback]:
                del self.queue[key]
            waiting = [item for item in self.queue.values() if item.recipient is None]
        if waiting:
            discovery = self.discover()
            for item in waiting:
                self._route(item, discovery, now)
        with self.lock:
            found = [Fact(i.key, i.recipient, i.kind, i.summary, i.created, issue=i.issue, sender=i.sender)
                     for i in self.queue.values() if i.recipient]
        for fact in found:
            # An object seen again (a catch-up, a redelivery) was perhaps delivered long
            # ago: the engine's read of the transcript must reach back that far.
            fact.look_back = self.lookback
        return found

    def _route(self, item, discovery, now):
        if discovery is None or discovery.problems:
            return  # the fleet cannot be read: keep it, ask again next pass
        try:
            owner = self.owner_of(item, discovery.agents, now)
        except GitHubUnavailable:
            return
        with self.lock:
            if owner:
                item.recipient = owner
            elif item.key in self.queue:
                del self.queue[item.key]
                if item.key not in self._unrouted:
                    self._unrouted.add(item.key)
                    self._audit("github.unrouted", item.repo, {"keys": [item.key], "issues": item.issues})

    def owner_of(self, item, agents, now):
        """The owner of an item: known issues first, then reads that climb to parents
        and to the issues a PR closes. Raises GitHubUnavailable when a read fails."""
        known, pending, done = list(item.issues), list(item.lookups), set()
        while True:
            owner = pick_owner(agents, known, item.repo)
            if owner and _is_orchestrator(agents[owner]):
                return owner
            if not pending:
                return owner  # a worker that owns the issue, when no orchestrator above it does
            lookup = pending.pop(0)
            if lookup in done:
                continue
            done.add(lookup)
            more_known, more_lookups = self._expand(item.repo, lookup, now)
            known += [n for n in more_known if n not in known]
            pending += more_lookups

    def _expand(self, repo, lookup, now):
        kind, number = lookup
        data = self._read_one(repo, "%s/%d" % ("pulls" if kind == "pr" else "issues", number), now)
        if kind == "pr":
            return _pr_refs(data, number)[0], [("issue", n) for n in _pr_refs(data, number)[0]]
        if _is_pr(data):
            return closing_numbers(data.get("body")), [("pr", number)]
        parent = parent_of(data)
        return ([parent], [("issue", parent)]) if parent else ([], [])

    def _read_one(self, repo, path, now):
        key = (repo, path)
        with self.lock:
            cached = self._cache.get(key)
            if cached and now < cached[0]:
                return cached[1]
            if now < self._retry.get(key, 0):
                raise GitHubUnavailable("read of %s failed recently; trying again later" % path)
        try:
            pages = self.gh_api("repos/%s/%s" % (repo, path), paginate=False)
            data = pages[0] if pages and isinstance(pages[0], dict) else {}
        except GitHubUnavailable:
            with self.lock:
                self._retry[key] = now + GITHUB_LOOKUP_RETRY
            raise
        with self.lock:
            self._cache[key] = (now + GITHUB_LOOKUP_TTL, data)
        return data

    # -- gh api, and the catch-up read

    def gh_api(self, path, paginate=True):
        argv = [self.config["gh"], "api"] + (["--paginate"] if paginate else []) + [path]
        try:
            done = self.runner(argv, capture_output=True, text=True, timeout=self.config["call_timeout_seconds"])
        except (OSError, subprocess.SubprocessError) as err:
            raise GitHubUnavailable("gh api %s: %s" % (path.split("?")[0], _one_line(str(err)))) from None
        if done.returncode != 0:
            raise GitHubUnavailable("gh api %s failed: %s" % (path.split("?")[0], _one_line(done.stderr or "", 200)))
        try:
            return decode_json_stream(done.stdout or "")
        except ValueError:
            raise GitHubUnavailable("gh api %s answered something that is not JSON" % path.split("?")[0]) from None

    def catch_up_items(self, repo, now):
        """The items for everything that changed on `repo` since now - look-back,
        keyed exactly as the webhooks are. Returns (items, errors): one read
        failing does not stop the others."""
        since, items, errors, pulls = iso(now - self.lookback), [], [], []

        def read(name, path, key=None):
            try:
                return _records(self.gh_api(path), key)
            except GitHubUnavailable as err:
                errors.append("%s: %s" % (name, err))
                return []

        def fresh(record, field="updated_at"):
            return isinstance(record.get(field), str) and record[field] >= since

        base = "repos/%s/" % repo
        comments = [c for c in read("comments", base + "issues/comments?since=%s&per_page=100" % since) if fresh(c)]
        commented = {}
        for comment in comments:
            number = _url_number(comment.get("issue_url"))
            commented[number] = max(commented.get(number, ""), comment["updated_at"])
            items.append(_comment_item(repo, comment, None, now))
        for issue in read("issues", base + "issues?state=all&since=%s&per_page=100" % since):
            if _is_pr(issue) or not fresh(issue):
                continue
            if issue["updated_at"] <= commented.get(_number(issue), ""):
                continue  # a comment bumped it; the comment is the news
            items.append(_issue_item(repo, issue, now))
        for pr in read("pulls", base + "pulls?state=all&sort=updated&direction=desc&per_page=50"):
            if fresh(pr):
                pulls.append(pr)
                items.append(_pr_item(repo, pr, now))
        for pr in pulls:
            number = _number(pr)
            for review in read("reviews", base + "pulls/%d/reviews?per_page=100" % number):
                if fresh(review, "submitted_at"):
                    items.append(_review_item(repo, review, pr, now))
            sha = (pr.get("head") or {}).get("sha")
            for suite in read("check suites", base + "commits/%s/check-suites?per_page=100" % sha,
                              "check_suites") if sha else []:
                if fresh(suite):
                    items.append(_check_item(repo, dict(suite, pull_requests=suite.get("pull_requests") or [
                        {"number": number}]), now, "", "check suite"))
        for run in read("workflow runs", base + "actions/runs?per_page=50", "workflow_runs"):
            if fresh(run):
                items.append(_check_item(repo, run, now, "run-", "workflow %s" % (run.get("name") or "run")))
        return [item for item in items if item is not None], errors

    def catch_up(self, watch, now):
        items, errors = self.catch_up_items(watch.repo, now)
        self.enqueue(items)
        with self.lock:
            watch.last_catch_up = now
            watch.catch_up_error = "; ".join(errors) if errors else None
            watch.catchup_at = now + GITHUB_LOOKUP_RETRY if errors else None  # a failed read is read again
        self._audit("github.catch_up", watch.repo, {"keys": [item.key for item in items], "errors": errors})

    # -- the supervisor

    def tick(self):
        """One supervisor step for every watch: reap, restart with backoff, catch up."""
        now = self.now()
        for watch in list(self.watches.values()):
            try:
                self._tick_watch(watch, now)
            except Exception as err:
                with self.lock:
                    watch.last_error = _scrub(_one_line(str(err)), watch.secret)
                self._audit("github.error", watch.repo, {"error": watch.last_error})
        self._write_snapshot(now)

    def _tick_watch(self, watch, now):
        if watch.proc is not None:
            code = watch.proc.poll()
            if code is not None:
                self._exited(watch, code, now)
            elif watch.failures and now - watch.started >= GITHUB_STABLE:
                watch.failures = 0
        if watch.proc is None and now >= watch.next_start:
            self._start(watch, now)
        if watch.catchup_at is not None and now >= watch.catchup_at:
            self.catch_up(watch, now)

    def argv_for(self, watch):
        url = "http://127.0.0.1:%d/github" % self.port
        return [self.config["gh"], "webhook", "forward", "--repo=%s" % watch.repo,
                "--events=%s" % ",".join(self.config["github_events"]), "--url=%s" % url,
                "--secret=%s" % watch.secret]

    def log_path(self, watch):
        directory = self.state_dir / "logs"
        directory.mkdir(mode=0o700, exist_ok=True)
        return directory / ("forward-%s.log" % watch.repo.replace("/", "-"))

    def _start(self, watch, now):
        secret = secrets.token_hex(32)  # a new one for every start; memory and argv only
        with self.lock:
            watch.secret = secret
        try:
            proc = self.spawn(self.argv_for(watch), self.log_path(watch))
        except OSError as err:
            with self.lock:
                watch.secret = None
            self._failed(watch, now, "cannot start %s: %s" % (self.config["gh"], _one_line(str(err), 200)))
            return
        with self.lock:
            watch.proc, watch.started, watch.starts = proc, now, watch.starts + 1
            watch.state, watch.next_start = "running", now
            watch.catchup_at = now + self.catchup_delay
        self._audit("github.watch", watch.repo, {"state": "running", "starts": watch.starts})

    def _log_tail(self, watch):
        try:
            with open(str(self.log_path(watch)), "rb") as handle:
                handle.seek(0, os.SEEK_END)
                handle.seek(max(0, handle.tell() - 4096))
                return handle.read().decode("utf-8", "replace")
        except OSError:
            return ""

    def _exited(self, watch, code, now):
        tail = _scrub(self._log_tail(watch), watch.secret)
        with self.lock:
            watch.proc, watch.secret = None, None
        if CONFLICT_TEXT in tail:
            with self.lock:
                watch.state, watch.next_start = "conflict", now + self.conflict_retry
                watch.last_error = "someone else is already forwarding %s (%s); catch-up reads continue" % (
                    watch.repo, CONFLICT_TEXT)
            self._audit("github.watch", watch.repo, {"state": "conflict", "retry_in": self.conflict_retry})
            return
        lines = [line for line in tail.splitlines() if line.strip()]
        reason = "exited with code %s%s" % (code, ": " + _one_line(lines[-1], 200) if lines else "")
        if now - (watch.started or now) >= GITHUB_STABLE:
            watch.failures = 0
        self._failed(watch, now, reason)

    def _failed(self, watch, now, reason):
        with self.lock:
            watch.failures += 1
            delay = min(self.backoff_max, self.backoff_base * 2 ** (watch.failures - 1))
            watch.state, watch.next_start, watch.last_error = "backoff", now + delay, reason
        self._audit("github.watch", watch.repo, {"state": "backoff", "failures": watch.failures,
                                                 "retry_in": delay, "reason": reason})

    # -- status

    def describe(self):
        with self.lock:
            return {"port": self.port, "lookback_hours": self.lookback / 3600.0,
                    "watches": [w.to_json() for _, w in sorted(self.watches.items())]}

    def _write_snapshot(self, now, stopped=False):
        """A copy of `describe()` for `status`, which runs in another process. No secret,
        no events; deleting it loses nothing."""
        body = dict(self.describe(), pid=None if stopped else os.getpid())
        text = json.dumps(body, sort_keys=True)
        if text == self._snapshot:
            return
        self._snapshot = text
        path = self.state_dir / WATCH_FILE
        tmp = path.with_name(WATCH_FILE + ".tmp")
        fd = os.open(str(tmp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as handle:
            handle.write(json.dumps(dict(body, updated=iso(now)), sort_keys=True))
        os.replace(str(tmp), str(path))


def _header(headers, name):
    """A header from an http.server message or a plain dict, any case."""
    if hasattr(headers, "get") and not isinstance(headers, dict):
        return headers.get(name)
    lowered = name.lower()
    return next((v for k, v in headers.items() if k.lower() == lowered), None)


def attach_github(engine, config, state_dir, runner, now):
    """The daemon's hub, or None when no repo is watched. SIGTERM becomes a clean stop."""
    if not config["github_repos"]:
        return None
    hub = GitHubHub(config, state_dir, engine.audit, runner, spawn_forwarder, now, engine.actor)
    hub.attach(engine)

    def terminate(*_):
        raise KeyboardInterrupt
    signal.signal(signal.SIGTERM, terminate)
    return hub


def github_status(config, state_dir):
    """What `status` says about GitHub: the config, and the daemon's last snapshot of its watches."""
    report = {"repos": list(config["github_repos"]), "lookback_hours": config["github_lookback_hours"],
              "events": list(config["github_events"]), "daemon": False, "watches": [], "port": None}
    try:
        snapshot = json.loads((Path(state_dir) / WATCH_FILE).read_text())
    except (OSError, ValueError):
        return report
    pid = snapshot.get("pid")
    try:
        if isinstance(pid, int):
            os.kill(pid, 0)
            report["daemon"] = True
    except ProcessLookupError:
        pass
    except OSError:
        report["daemon"] = True  # alive, but not ours to signal
    report["port"] = snapshot.get("port")
    report["updated"] = snapshot.get("updated")
    report["watches"] = [w for w in snapshot.get("watches", []) if w.get("repo") in report["repos"]]
    return report


def format_github(report):
    """Status lines for GitHub; none when no repo is watched."""
    if not report["repos"]:
        return []
    lines = ["      github     watching %s; catch-up reads reach back %g h, older events are lost"
             % (", ".join(report["repos"]), report["lookback_hours"])]
    if not report["daemon"]:
        lines.append("        daemon not running: forwarder state is unknown")
    for watch in report["watches"] if report["daemon"] else []:
        line = "        %-24s %s" % (watch["repo"], watch["state"])
        if watch["state"] == "conflict":
            line += " (someone else is forwarding; catch-up reads only)"
        if watch["failures"]:
            line += ", %d failure(s)" % watch["failures"]
        if watch["last_error"]:
            line += ": " + watch["last_error"]
        lines.append(line)
    return lines


# --------------------------------------------------------------------- the CLI

def _check(probe):
    """Run one probe. Returns (ok, one line). Never raises, never a traceback."""
    try:
        return True, probe()
    except (V2Error, HerdrError, ConfigError, FaultError) as err:
        return False, _one_line(str(err))
    except Exception as err:  # status must always answer; say what broke in one line
        return False, _one_line("unexpected %s: %s" % (type(err).__name__, err))


def _v2_summary(info):
    version = info.get("version") if isinstance(info, dict) else None
    return "server.info answered%s" % (", version %s" % version if version else "")


def collect_status(runner=subprocess.run, now=time.time):
    report = {"version": VERSION}
    path = config_path()
    config_ok, config = _check(lambda: load_config(path))
    report["config"] = {"path": str(path), "exists": path.exists(), "ok": config_ok}
    if config_ok:
        report["config"].update({
            "opencode": config["opencode"],
            "opencode_env": sorted(config["opencode_env"]),  # names only, never values
            "opencode_executable": config["opencode_executable"],
            "launch_env": sorted(config["launch_env"]),
            "herdr": config["herdr"],
            "batch_seconds": config["batch_seconds"],
            "engaged_minutes": config["engaged_minutes"],
            "call_timeout_seconds": config["call_timeout_seconds"],
            "poll_seconds": config["poll_seconds"],
        })
    else:
        report["config"]["error"] = config

    state_ok, state = _check(lambda: str(ensure_state_dir()))
    report["state_dir"] = {"path": str(state_dir_path()), "ok": state_ok}
    if not state_ok:
        report["state_dir"]["error"] = state

    faults_ok, faults = _check(active_faults)
    report["lab"] = {"on": os.environ.get(LAB_ENV) == "1", "ok": faults_ok}
    if faults_ok:
        report["lab"]["faults"] = faults
    else:
        report["lab"]["error"] = faults

    agents = {"ok": False, "error": "not checked: v2 and herdr must both answer"}
    if config_ok:
        herdr = HerdrClient(config["herdr"], runner)
        v2 = None
        if config["opencode"] is None:
            v2_ok, v2_line = False, ("not configured: set 'opencode' in %s to the absolute path of "
                                     "the OpenCode v2 binary" % config_path())
        else:
            v2 = V2Client(config["opencode"], config["opencode_env"], runner, config["call_timeout_seconds"])
            v2_ok, v2_line = _check(lambda: _v2_summary(v2.server_info()))
        herdr_ok, entries = _check(herdr.agent_list)
        herdr_line = "%d agent(s)" % len(entries) if herdr_ok else entries
        if v2_ok and herdr_ok and state_ok and faults_ok:
            engine = Switchboard(config, v2, herdr, None, fact_sources(state), now,
                                 intents=intent_reader_for(config, runner, now))
            agents_ok, overview = _check(lambda: fleet_overview(engine, entries))
            agents = overview if agents_ok else {"ok": False, "error": overview}
    else:
        v2_ok, v2_line = False, "not checked: config unusable"
        herdr_ok, herdr_line = False, "not checked: config unusable"
    report["v2"] = {"ok": v2_ok, ("detail" if v2_ok else "error"): v2_line}
    report["herdr"] = {"ok": herdr_ok, ("detail" if herdr_ok else "error"): herdr_line}
    report["agents"] = agents  # informational: an agent's trouble is not the switchboard's
    if config_ok and state_ok:
        report["github"] = github_status(config, state)
    report["ok"] = all(report[part]["ok"] for part in ("config", "state_dir", "lab", "v2", "herdr"))
    return report


def fleet_overview(engine, entries):
    """Read-only: every fleet agent and every fact recipient, with the rule's answer for each."""
    discovery = engine.discover(engine.now(), entries)
    facts, problems = engine.collect_facts()
    names = sorted(set(discovery.agents) | {fact.recipient for fact in facts})
    overview = {"ok": True, "problems": discovery.problems + problems,
                "list": [engine.pending(name, discovery, facts) for name in names]}
    overview.update(intent_gap_report(engine, discovery, facts))
    return overview


def _plan_line(entry):
    plan = entry["plan"]
    if plan is None:
        return "nothing pending"
    return "%d pending: %s (%s)" % (len(plan["pending"]), plan["action"], plan["reason"])


def _agent_line(entry):
    seen = entry["observation"]
    if seen is None:
        return "%-14s (not found)  %s" % (entry["name"], _plan_line(entry))
    return "%-14s %-8s %s  pane %s  your last prompt %s  %s" % (
        seen["name"], seen["status"], seen["session"], seen["pane"] or "-",
        seen["last_human_prompt"] or "not in the window", _plan_line(entry))


def format_status(report):
    def mark(part):
        return "ok   " if part["ok"] else "ERROR"

    config = report["config"]
    lines = ["%s %s" % (PROG, report["version"])]
    if config["ok"]:
        lines.append("%s config     %s%s" % (mark(config), config["path"],
                                             "" if config["exists"] else " (not present; defaults)"))
        lines.append("      opencode   %s  env: %s" % (config["opencode"] or "(not configured)",
                                                       ", ".join(config["opencode_env"]) or "none"))
        if config["opencode_executable"]:
            lines.append("      process    %s (what a pane must run)" % config["opencode_executable"])
        lines.append("      herdr      %s" % config["herdr"])
        lines.append("      timing     batch %ss, engaged %s min, call timeout %ss, poll %ss"
                     % (config["batch_seconds"], config["engaged_minutes"], config["call_timeout_seconds"],
                        config["poll_seconds"]))
    else:
        lines.append("%s config     %s" % (mark(config), config["error"]))
    state = report["state_dir"]
    lines.append("%s state      %s" % (mark(state), state["path"] if state["ok"] else state["error"]))
    lab = report["lab"]
    if lab["ok"]:
        lab_line = "on" if lab["on"] else "off"
        if lab["faults"]:
            lab_line += ", faults requested: %s%s" % (", ".join(lab["faults"]), "" if lab["on"] else " (ignored outside the Lab)")
    else:
        lab_line = lab["error"]
    lines.append("%s lab        %s" % (mark(lab), lab_line))
    for name in ("v2", "herdr"):
        part = report[name]
        lines.append("%s %-10s %s" % (mark(part), name, part["detail"] if part["ok"] else part["error"]))
    agents = report["agents"]
    if agents["ok"]:
        listed = [entry for entry in agents["list"] if entry["observation"]]
        lines.append("      agents     %d fleet agent(s)" % len(listed))
        lines.extend("        " + _agent_line(entry) for entry in agents["list"])
        lines.extend("        problem: %s" % problem for problem in agents["problems"])
        lines.extend(intent_gap_lines(agents))
    else:
        lines.append("      agents     %s" % agents["error"])
    lines.extend(format_github(report["github"]) if "github" in report else [])
    return "\n".join(lines)


def cmd_status(args, runner=subprocess.run, now=time.time):
    report = collect_status(runner, now)
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print(format_status(report))
    return EXIT_OK if report["ok"] else EXIT_ERROR


class CallerError(Exception):
    """`send` cannot tell which fleet agent is calling."""


def identify_caller(herdr, v2, environ):
    """The caller's fleet name: HERDR_PANE_ID -> herdr agent -> v2 session -> metadata.fleet.name."""
    pane = environ.get("HERDR_PANE_ID")
    if not pane:
        raise CallerError("HERDR_PANE_ID is not set: run send from a fleet agent's herdr pane")
    session_id = agent_session(herdr.agent_get(pane))
    if not session_id:
        raise CallerError("herdr pane %s shows no agent session" % pane)
    name = (_fleet_meta(v2.session_get(session_id)) or {}).get("name")
    if not isinstance(name, str) or not name:
        raise CallerError("session %s in pane %s is not a fleet agent (no metadata.fleet.name)" % (session_id, pane))
    return name


def build_engine(runner, now, actor, writable=True, socket_call=None):
    """The engine over the configured clients. Refuses an unconfigured v2 or a bad fault name."""
    config = load_config()
    if config["opencode"] is None:
        raise ConfigError("'opencode' is not configured in %s: set it to the absolute path of the "
                          "OpenCode v2 binary" % config_path())
    active_faults()
    state = ensure_state_dir()
    v2 = V2Client(config["opencode"], config["opencode_env"], runner, config["call_timeout_seconds"])
    herdr = HerdrClient(config["herdr"], runner, socket_call=socket_call)
    audit = AuditLog(state / "audit.jsonl") if writable else None
    return Switchboard(config, v2, herdr, audit, fact_sources(state), now, actor,
                       intents=intent_reader_for(config, runner, now)), state, config


def cmd_run(args, runner, now, wait):
    engine, state, config = build_engine(runner, now, "daemon")
    if args.once:
        with single_instance(state):
            report = engine.run_pass()
        if args.json:
            print(json.dumps(report, indent=2, sort_keys=True))
        else:
            print("pass at %s: %d sent, %d held, %d waiting, %d converted, %d error(s)" % (
                report["at"], len(report["sent"]), len(report["held"]), len(report["waiting"]),
                len(report["converted"]), len(report["errors"])))
        return EXIT_OK if not report["errors"] else EXIT_ERROR
    hub = attach_github(engine, config, state, runner, now)
    judge_server = start_judge_server(config, state, runner, now)  # PR 9: the daemon holds the key, not v2
    try:
        run_daemon(engine, state, args.poll or config["poll_seconds"], wait)
    except KeyboardInterrupt:
        return EXIT_OK
    finally:
        if hub is not None:
            hub.stop()
        if judge_server is not None:
            judge_server.stop()
    return EXIT_OK


def cmd_ensure(args, spawn=subprocess.Popen):
    load_config()  # a daemon that cannot read its config would exit at once; say so here
    state = ensure_state_dir()
    outcome = ensure_daemon(state, spawn)
    print("daemon %s" % outcome)
    return EXIT_OK


def cmd_poke(args):
    """Ask the daemon for a pass. Silent, fast, and always exit 0: it runs inside
    herdr's hook runner, which has no timeout and a shared limit on commands."""
    signal.alarm(POKE_ALARM)
    try:
        send_poke(state_dir_path())
    except Exception:  # nothing a poke does may make a hook noisy or slow
        pass
    finally:
        signal.alarm(0)
    return EXIT_OK


def read_brief(path, stdin):
    """The brief for `launch`: a file, or `-` for standard input. None when not given."""
    if path is None:
        return None
    try:
        text = stdin.read() if path == "-" else Path(path).read_text()
    except OSError as err:
        raise LaunchError("cannot read the brief %s: %s" % (path, err.strerror or err)) from None
    if not text.strip():
        raise LaunchError("the brief %s is empty" % path)
    return text


def cmd_launch(args, runner, now, socket_call=None):
    workspace = args.workspace or os.environ.get("HERDR_WORKSPACE_ID")
    brief = read_brief(args.brief_file, sys.stdin)
    engine, _, _ = build_engine(runner, now, "cli", socket_call=socket_call)
    done = launch_agent(engine, args.name, args.agent, args.dir, workspace, args.role, args.reports_to,
                        args.issue, brief)
    print(json.dumps(done, sort_keys=True))
    return EXIT_OK


def cmd_send(args, runner, now):
    engine, _, config = build_engine(runner, now, "cli")
    refusal = intent_refusal(config, args.issue)
    if refusal:
        sys.stderr.write("%s: %s\n" % (PROG, refusal))
        return EXIT_USAGE
    if args.sender is not None:
        if os.environ.get(LAB_ENV) != "1":
            sys.stderr.write("%s: --from is only for the Lab (%s=1); an agent is identified by its pane\n"
                             % (PROG, LAB_ENV))
            return EXIT_USAGE
        sender = args.sender
    else:
        sender = identify_caller(engine.herdr, engine.v2, os.environ)
    text = " ".join(args.text).strip()
    if not text:
        sys.stderr.write("%s: nothing to send\n" % PROG)
        return EXIT_USAGE
    outcome = engine.send(sender, args.name, text, args.issue)
    if not outcome["sent"]:
        sys.stderr.write("%s: not sent to %s: %s (%s)\n" % (PROG, args.name, outcome["action"], outcome["reason"]))
        return EXIT_HELD
    print(outcome["message_id"])
    sys.stderr.write("%s: %s delivered to %s\n" % (PROG, outcome["action"], args.name))
    return EXIT_OK


def cmd_pending(args, runner, now):
    engine, _, _ = build_engine(runner, now, "cli", writable=False)
    entry = engine.pending(args.name)
    if args.json:
        print(json.dumps(entry, indent=2, sort_keys=True))
        return EXIT_OK
    print(_agent_line(entry))
    if entry["missing"]:
        print("  %s" % entry["missing"])
    for fact in (entry["plan"] or {}).get("pending", []):
        where = " issue #%d" % fact["issue"] if fact["issue"] else ""
        print("  - %s  %s from %s%s at %s: %s" % (fact["key"], fact["kind"], fact["from"] or "the fleet", where,
                                                 iso(fact["created"]), _one_line(fact["summary"], 200)))
    for problem in entry["source_problems"]:
        print("  problem: %s" % problem)
    return EXIT_OK


# ------------------------------------------------- intent lines (PR 6)
#
# Every message names its ask and carries the ask's Intent and Done-when
# (docs/switchboard.md, "Intent lines"). GitHub is the only copy: this section
# reads an issue's `## Intent` section through `gh api` (GET only, invariant 6)
# and never writes it. Three levels: a charter (never repeated), an ask under
# it (Intent + Done when, written by the Chief of Staff), and optionally a work
# item under the ask (its own Intent line, written by the orchestrator).

INTENT_DEFAULTS = {
    "intent_repo": None,     # OWNER/REPO holding charters, asks and work items; None = no ask machinery
    "intent_required": True,  # with intent_repo set, `send` needs --issue
}
DEFAULTS.update(INTENT_DEFAULTS)

NO_INTENT = "no intent recorded"
INTENT_TTL = 300        # seconds a cached issue is trusted; a webhook invalidates it sooner
INTENT_LINE_LIMIT = 240  # characters per header line
REPO_RE = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")


def validate_intent_config(config, source):
    repo = config["intent_repo"]
    if repo is not None and not (isinstance(repo, str) and REPO_RE.match(repo)):
        raise ConfigError("%s: 'intent_repo' must be OWNER/REPO or null, got %r" % (source, repo))
    if not isinstance(config["intent_required"], bool):
        raise ConfigError("%s: 'intent_required' must be true or false, got %r" % (source, config["intent_required"]))


_HEADING = re.compile(r"^\s{0,3}#{1,6}\s+(.*?)\s*#*\s*$")
_DONE_WHEN = re.compile(r"^(?:[-*]\s+)?\**done when\**\s*:\s*\**\s*(.*?)\**\s*$", re.IGNORECASE)
_CHARTER_BLOCK = re.compile(r"```ya?ml\s*\n\s*orchestrator\s*:", re.IGNORECASE)


def parse_intent(body):
    """(intent, done_when) from the `## Intent` section of an issue body.

    The first line of the section is the Intent; a line starting `Done when:`
    is the Done-when. Either may be missing (None). Fenced code is ignored,
    the section ends at the next heading, and CRLF bodies are fine.
    """
    intent = done_when = None
    inside = fenced = False
    for line in (body or "").splitlines():
        if line.lstrip().startswith(("```", "~~~")):
            fenced = not fenced
            continue
        if fenced:
            continue
        heading = _HEADING.match(line)
        if heading:
            if inside:
                break
            inside = heading.group(1).strip().lower() == "intent"
            continue
        text = line.strip()
        if not inside or not text:
            continue
        match = _DONE_WHEN.match(text)
        if match:
            done_when = done_when or match.group(1).strip() or None
        elif intent is None:
            intent = text
    return intent, done_when


class IntentError(Exception):
    """GitHub could not answer. reason: "not_found", "unavailable" or "gh"."""

    def __init__(self, reason, detail=None):
        self.reason = reason
        super().__init__("%s: %s" % (reason, detail) if detail else reason)


class IssueIntent:
    """What the switchboard knows of one issue: its Intent lines, and what kind it is."""

    def __init__(self, number, state, title, intent, done_when, updated_at, charter):
        self.number, self.state, self.title = number, state, title
        self.intent, self.done_when, self.updated_at, self.charter = intent, done_when, updated_at, charter

    @classmethod
    def from_api(cls, data):
        number = data.get("number") if isinstance(data, dict) else None
        if not (isinstance(number, int) and not isinstance(number, bool)):
            raise IntentError("gh", "an issue came back without a number")
        body = data.get("body") if isinstance(data.get("body"), str) else ""
        intent, done_when = parse_intent(body)
        return cls(number, data.get("state"), data.get("title") or "", intent, done_when,
                   data.get("updated_at"), bool(_CHARTER_BLOCK.search(body)))


def _header_line(text):
    return _one_line(text, INTENT_LINE_LIMIT)


def ask_lines(issue):
    """The ask's header lines: Intent, then Done when; one line when neither is recorded."""
    if issue.intent is None and issue.done_when is None:
        return [_header_line("Ask #%d: %s" % (issue.number, NO_INTENT))]
    return [_header_line("Ask #%d Intent: %s" % (issue.number, issue.intent or NO_INTENT)),
            _header_line("Done when: %s" % (issue.done_when or "not recorded"))]


def work_lines(issue):
    return [_header_line("Work item #%d Intent: %s" % (issue.number, issue.intent or NO_INTENT))]


class IntentReader:
    """Reads Intent lines from GitHub, with an in-memory cache.

    Only ever runs `<gh> api <path>`: a GET, with no method, field or input
    flag, so there is nothing here that can write. Entries are keyed by repo
    and issue, remember the issue's `updated_at`, and expire after `ttl`
    seconds; `invalidate(issue)` drops them at once (the webhook handler's
    call, PR 5). A failed read is never cached.
    """

    def __init__(self, gh, repo, runner=subprocess.run, now=time.time, timeout=20, ttl=INTENT_TTL):
        self.gh, self.repo, self.runner, self.now = gh, repo, runner, now
        self.timeout, self.ttl = timeout, ttl
        self._cache = {}

    # -- GitHub

    def _api(self, path):
        argv = [self.gh, "api", path]
        try:
            result = self.runner(argv, capture_output=True, text=True, timeout=self.timeout,
                                 stdin=subprocess.DEVNULL)
        except subprocess.TimeoutExpired:
            raise IntentError("unavailable", "gh did not answer within %ss" % self.timeout) from None
        except OSError as err:
            raise IntentError("unavailable", "cannot run %s: %s" % (self.gh, err.strerror or err)) from None
        if result.returncode != 0:
            detail = _one_line(result.stderr) or _one_line(result.stdout) or "exit %d" % result.returncode
            if re.search(r"\b404\b|Not Found", detail):
                raise IntentError("not_found", detail)
            raise IntentError("gh", detail)
        try:
            return json.loads(result.stdout)
        except ValueError:
            raise IntentError("gh", "gh returned non-JSON: %s" % _one_line(result.stdout, 120)) from None

    def _cached(self, key, fetch):
        hit = self._cache.get(key)
        if hit is not None and self.now() - hit[0] < self.ttl:
            return hit[1]
        value = fetch()
        self._cache[key] = (self.now(), value)
        return value

    def invalidate(self, issue, repo=None):
        """Forget what is cached about `issue`; the next read asks GitHub again."""
        repo = repo or self.repo
        for kind in ("issue", "parent"):
            self._cache.pop((kind, repo, issue), None)

    # -- reading

    def issue(self, number, repo=None):
        repo = repo or self.repo
        return self._cached(("issue", repo, number), lambda: IssueIntent.from_api(
            self._api("repos/%s/issues/%d" % (repo, number))))

    def parent(self, number, repo=None):
        """The parent issue's number, or None when the issue has no parent."""
        repo = repo or self.repo

        def fetch():
            try:
                found = self._api("repos/%s/issues/%d/parent" % (repo, number))
            except IntentError as err:
                if err.reason == "not_found":
                    return None
                raise
            return IssueIntent.from_api(found).number

        return self._cached(("parent", repo, number), fetch)

    def ask_of(self, number, repo=None):
        """(ask, work item) for an issue: a work item's ask is its parent.

        A parent counts as the ask when it has a parent of its own (the
        charter); under the charter itself, the issue is the ask.
        """
        parent = self.parent(number, repo)
        if parent is not None and self.parent(parent, repo) is not None:
            return parent, number
        return number, None

    def header(self, number, repo=None):
        """(ask, ask lines, work item, work lines) for a message about `number`, at most
        three lines; None for a charter, which is never repeated."""
        if self.issue(number, repo).charter:
            return None
        ask, work = self.ask_of(number, repo)
        ask_issue = self.issue(ask, repo)
        if ask_issue.charter:
            return None
        if work is None:
            return ask, ask_lines(ask_issue), None, []
        return ask, ask_lines(ask_issue), work, work_lines(self.issue(work, repo))

    def missing_intent(self, number, repo=None):
        """The issues in this one's ask chain (ask, work item) with no Intent line. Charters are exempt."""
        if self.issue(number, repo).charter:
            return []
        ask, work = self.ask_of(number, repo)
        chain = [self.issue(n, repo) for n in ([ask] if work is None else [ask, work])]
        return [issue.number for issue in chain if issue.intent is None and not issue.charter]

    def open_asks(self, charter, repo=None):
        """The open sub-issues of a charter, derived from GitHub on every call."""
        repo = repo or self.repo
        found = self._api("repos/%s/issues/%d/sub_issues?per_page=100" % (repo, charter))
        asks = []
        for data in found if isinstance(found, list) else []:
            issue = IssueIntent.from_api(data)
            self._cache[("issue", repo, issue.number)] = (self.now(), issue)
            if issue.state == "open":
                asks.append(issue)
        return asks


def intent_reader_for(config, runner=subprocess.run, now=time.time):
    """The IntentReader the config asks for, or None when no `intent_repo` is set."""
    if not config.get("intent_repo"):
        return None
    return IntentReader(config["gh"], config["intent_repo"], runner, now, config["call_timeout_seconds"])


# -- composing: one section per ask

def section_resolver(engine, observation):
    """issue -> (ask, ask lines, work item, work lines) for compose, or None.

    None (no sections at all) when no ask machinery is configured or under the
    `no-intent-header` fault. A header GitHub cannot supply says so instead of
    stopping the delivery: an unreachable GitHub must not hold your agents'
    messages. The repo comes from the recipient's fleet metadata when it names
    one, else the config's `intent_repo`.
    """
    reader = getattr(engine, "intents", None)
    if reader is None or fault("no-intent-header"):
        return None
    repo = ((observation.fleet or {}).get("repo") if observation else None) or reader.repo

    def section(issue):
        try:
            return reader.header(issue, repo)
        except IntentError as err:
            return issue, [_header_line("Ask #%d: intent unavailable (%s)" % (issue, err))], None, []

    return section


def sectioned_lines(facts, section, item):
    """The body of a message: items that name no issue (or a charter) first, then
    one section per ask, never interleaved. A section is the ask's lines, its
    own items, then each work item's line followed by that work item's items."""
    lines, asks = [], {}
    for fact in facts:
        found = section(fact.issue) if fact.issue else None
        if found is None:
            lines.append(item(fact))
            continue
        ask, ask_header, work, work_header = found
        entry = asks.setdefault(ask, {"header": ask_header, "direct": [], "work": {}})
        if work is None:
            entry["direct"].append(item(fact))
        else:
            entry["work"].setdefault(work, (work_header, []))[1].append(item(fact))
    for entry in asks.values():
        lines.append("")
        lines.extend(entry["header"] + entry["direct"])
        for work_header, items in entry["work"].values():
            lines.extend(work_header + items)
    return lines


# -- change surfacing: pure functions over an `issues` webhook payload (PR 5 wires them)

def intent_diff(payload):
    """[(label, old, new)] for the Intent and Done-when an `issues.edited` payload
    actually changed; [] for any other event, or an edit that left them alone."""
    if not isinstance(payload, dict) or payload.get("action") != "edited":
        return []
    old = ((payload.get("changes") or {}).get("body") or {}).get("from")
    if not isinstance(old, str):
        return []  # the body was not edited (a title or label edit)
    new = (payload.get("issue") or {}).get("body")
    old_intent, old_done = parse_intent(old)
    new_intent, new_done = parse_intent(new if isinstance(new, str) else "")
    changes = []
    if old_intent != new_intent:
        changes.append(("Intent", old_intent, new_intent))
    if old_done != new_done:
        changes.append(("Done when", old_done, new_done))
    return changes


def _change_lines(changes):
    return ["%s: %s -> %s" % (label, old or "(none)", new or "(none)") for label, old, new in changes]


def _payload_issue(payload):
    issue = payload.get("issue") or {}
    number, updated = issue.get("number"), issue.get("updated_at")
    if not (isinstance(number, int) and not isinstance(number, bool) and number >= 1):
        raise FactError("an issues event without an issue number")
    try:
        created = datetime.strptime(updated, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc).timestamp()
    except (TypeError, ValueError):
        raise FactError("an issues event without a usable issue.updated_at: %r" % (updated,)) from None
    return number, updated, created


def intent_change_fact(payload, recipient="chief-of-staff"):
    """The Chief of Staff's item for an Intent edit, or None when the edit left
    the Intent section alone. Key `intent.edit:<issue>:<updated_at>`, so a
    redelivered webhook is one item."""
    changes = intent_diff(payload)
    if not changes:
        return None
    number, updated, created = _payload_issue(payload)
    login = (payload.get("sender") or {}).get("login")
    summary = "\n".join(["The Intent section of #%d was edited on GitHub:" % number] + _change_lines(changes))
    return Fact("intent.edit:%d:%s" % (number, updated), recipient, "intent.edit", summary, created,
                issue=number, sender=login if isinstance(login, str) and login else "github")


def intent_change_toast(payload):
    """What to tell you when an Intent changed: {"title", "body"} for
    HerdrClient.notification_show, or None."""
    changes = intent_diff(payload)
    if not changes:
        return None
    number, _, _ = _payload_issue(payload)
    return {"title": "Intent changed on #%d" % number, "body": _one_line("; ".join(_change_lines(changes)), 300)}


# -- `send` needs an issue

def intent_refusal(config, issue):
    """Why `send` must refuse without --issue, or None."""
    if config.get("intent_repo") and config.get("intent_required") and issue is None:
        return ("send needs --issue <n>: every message names the ask it belongs to "
                "(run `%s intent <n>`; set intent_required to false in the config to turn this off)" % PROG)
    return None


# -- status: issues agents refer to that have no Intent section

def referenced_issues(discovery, facts):
    """Issue numbers agents refer to: the issue each fleet agent works on, and
    each pending fact's issue. Charters are exempt when they are looked at."""
    numbers = {fact.issue for fact in facts if fact.issue}
    for agent in discovery.agents.values():
        issue = (agent.fleet or {}).get("issue")
        if isinstance(issue, int) and not isinstance(issue, bool):
            numbers.add(issue)
    return sorted(numbers)


def intent_gap_report(engine, discovery, facts):
    """{"intent_gaps": [issue...], "intent_errors": [text...]}; empty when no ask repo is configured."""
    reader = getattr(engine, "intents", None)
    if reader is None:
        return {}
    gaps, errors = set(), []
    for number in referenced_issues(discovery, facts):
        try:
            gaps.update(reader.missing_intent(number))
        except IntentError as err:
            errors.append("#%d: %s" % (number, err))
    return {"intent_gaps": sorted(gaps), "intent_errors": errors}


def intent_gap_lines(agents):
    lines = []
    if agents.get("intent_gaps"):
        lines.append("      intent     no Intent section: %s" % ", ".join("#%d" % n for n in agents["intent_gaps"]))
    lines.extend("        intent problem: %s" % error for error in agents.get("intent_errors", []))
    return lines


# -- the CLI: `intent` and `intents`

def _intent_reader(runner, now):
    config = load_config()
    active_faults()
    reader = intent_reader_for(config, runner, now)
    if reader is None:
        raise ConfigError("'intent_repo' is not configured in %s: set it to OWNER/REPO, the repo that "
                          "holds charters, asks and work items" % config_path())
    return reader


def cmd_intent(args, runner, now):
    """Print the ask's Intent and Done-when, and the work item's Intent line."""
    reader = _intent_reader(runner, now)
    found = reader.header(args.issue)
    if found is None:
        print("#%d is a charter: its standing job is not repeated in messages. Ask for an ask under it."
              % args.issue)
        return EXIT_OK
    _, ask_header, _, work_header = found
    print("\n".join(ask_header + work_header))
    return EXIT_OK


def caller_fleet(herdr, v2, environ):
    """The caller's `metadata.fleet`: HERDR_PANE_ID -> herdr agent -> v2 session."""
    pane = environ.get("HERDR_PANE_ID")
    if not pane:
        raise CallerError("HERDR_PANE_ID is not set: run intents from a fleet agent's herdr pane")
    session_id = agent_session(herdr.agent_get(pane))
    fleet = _fleet_meta(v2.session_get(session_id)) if session_id else None
    if not fleet or not isinstance(fleet.get("name"), str) or not fleet["name"]:
        raise CallerError("pane %s is not a fleet agent (no metadata.fleet.name)" % pane)
    return fleet


def _is_issue_number(value):
    return isinstance(value, int) and not isinstance(value, bool) and value >= 1


def asks_of_caller(engine, fleet, now):
    """[(owner, IssueIntent)] the caller is accountable for, from GitHub now.

    The rule: an ask is an open sub-issue of an orchestrator's charter. A
    Chief of Staff sees the asks under every orchestrator's charter, found
    from fleet metadata (`role` orchestrator, `charter` an issue number); an
    orchestrator sees the asks under its own charter; any other role sees the
    ask of the issue it works on.
    """
    reader = engine.intents
    repo = fleet.get("repo") or reader.repo
    if fleet.get("role") == "chief-of-staff":
        charters = [(agent.name, (agent.fleet or {}).get("charter"))
                    for agent in sorted(engine.discover(now).agents.values(), key=lambda a: a.name)
                    if (agent.fleet or {}).get("role") == "orchestrator"]
    elif fleet.get("role") == "orchestrator":
        charters = [(fleet["name"], fleet.get("charter"))]
    else:
        issue = fleet.get("issue")
        if not _is_issue_number(issue):
            return []
        ask, _ = reader.ask_of(issue, repo)
        return [(fleet["name"], reader.issue(ask, repo))]
    asks = []
    for owner, charter in charters:
        if _is_issue_number(charter):
            asks.extend((owner, issue) for issue in reader.open_asks(charter, repo))
    return asks


def ask_row(owner, issue):
    return "#%d  [%s]  %s  | Done when: %s" % (issue.number, owner, issue.intent or NO_INTENT,
                                              issue.done_when or "not recorded")


def cmd_intents(args, runner, now):
    """The caller's open asks, one line each with its Done-when."""
    engine, _, config = build_engine(runner, now, "cli", writable=False)
    if engine.intents is None:
        raise ConfigError("'intent_repo' is not configured in %s: set it to OWNER/REPO" % config_path())
    fleet = caller_fleet(engine.herdr, engine.v2, os.environ)
    rows = asks_of_caller(engine, fleet, engine.now())
    if not rows:
        print("no open asks for %s" % fleet["name"])
    for owner, issue in rows:
        print(ask_row(owner, issue))
    return EXIT_OK


INTENT_COMMANDS = {"intent": cmd_intent, "intents": cmd_intents}


def add_intent_parsers(sub):
    intent = sub.add_parser("intent", help="Print an issue's ask: its Intent and Done-when, and the work item's Intent")
    intent.add_argument("issue", type=int, help="The issue number")
    sub.add_parser("intents", help="Your open asks, one line each with its Done-when")


# ============================================================================
# PR 9: the tool-call policy judge
#
# One section, so the stack rebases cleanly. docs/switchboard.md, "Tool-call
# policy (PR 9)" and invariant 9. `fleet-switchboard judge-tool` is what the
# `fleet-hooks` plugin runs, once per tool call, with one JSON object on stdin;
# it prints one JSON line and exits 0 whatever happens, because the judge only
# tightens: when it cannot answer, the configured outcome stands.
#
# The daemon, not v2, holds the OpenRouter key: `judge-tool` runs in v2's
# environment (every agent's shell sees it), so it never reads the key and
# never calls Jev. It asks the daemon over $STATE/judge.sock (see "the judge
# socket" below), and the daemon runs the judgement.
#
# Registered in six places: DEFAULTS (here), `validate_config`
# (`validate_policy_config`), `build_parser` (`add_policy_parsers`), `main`
# (the `judge-tool` branch), `cmd_run` (`start_judge_server`) and the fault
# list (`no-policy-judge`).
#
# This section reads GitHub (the ask's Intent, the charter's standing
# authority) through IntentReader, which can only GET, and reads and writes
# nothing else but its two cache files and the audit log. It never touches
# herdr and never writes to GitHub.
# ============================================================================
POLICY_TOOLS = ("shell", "edit", "webfetch", "subagent", "read", "glob", "grep", "skill", "other")
POLICY_PASS_THROUGH = ("read", "glob", "grep", "skill")  # never judged, never sent to Jev
POLICY_REQUEST_OUTCOMES = ("allow", "ask", "deny")       # what the plugin can configure and be told
POLICY_DEFAULTS = {
    "enabled": False,       # off until the plugin is installed and a `jev` object is configured
    "budget_ms": 900,       # the whole judgement, ask lookup included; no answer in time keeps the configured outcome
    "thresholds": {},       # question id -> probability at which it fires (default POLICY_THRESHOLD)
    "cache_seconds": 300,   # how long a verdict or a resolved ask is reused; 0 turns both caches off
    "cache_entries": 200,   # entries kept in each cache file
}
DEFAULTS["policy"] = None   # None means POLICY_DEFAULTS
POLICY_STDIN_LIMIT = 65536  # bytes of request read from stdin
POLICY_ARG_LIMIT = 4000     # characters of a tool's arguments kept
POLICY_WARM_SECONDS = 8     # after replying, how long a late lookup may go on filling the caches
POLICY_CACHE_BYTES = 1 << 20
POLICY_VERDICT_FILE = "policy-verdicts.json"  # hashes and probabilities only
POLICY_CONTEXT_FILE = "policy-context.json"   # resolved asks and sessions: a disposable copy of what GitHub and v2 say
POLICY_SESSION_RE = re.compile(r"^ses_[A-Za-z0-9]{1,80}$")
NO_STANDING_AUTHORITY = ("none stated: nothing is pre-authorised, so treat any merge, deploy, publish, "
                         "message to others or spend as not covered")
POLICY_FIRED_TEXT = {"hard_to_reverse": "hard to reverse",
                     "speaks_for_you": "speaks for you, which the standing authority does not cover",
                     "outside_scope": "outside this agent's assignment"}
POLICY_ACTOR = "judge-tool"


def validate_policy_config(config, source):
    """Check and complete `policy`: unknown subkeys are refused, every value is checked."""
    raw = config.get("policy")
    if raw is None:
        raw = {}
    if not isinstance(raw, dict):
        raise ConfigError("%s: 'policy' must be an object, got %r" % (source, type(raw).__name__))
    unknown = sorted(set(raw) - set(POLICY_DEFAULTS))
    if unknown:
        raise ConfigError("%s: 'policy' contains key(s) this tool does not read: %s (known: %s)"
                          % (source, ", ".join(unknown), ", ".join(POLICY_DEFAULTS)))
    settings = dict(POLICY_DEFAULTS, **raw)
    if not isinstance(settings["enabled"], bool):
        raise ConfigError("%s: 'policy.enabled' must be true or false, got %r" % (source, settings["enabled"]))
    for name in ("budget_ms", "cache_seconds"):
        value = settings[name]
        if not _is_number(value) or value < 0 or (name == "budget_ms" and value <= 0):
            raise ConfigError("%s: 'policy.%s' must be a %s number, got %r"
                              % (source, name, "positive" if name == "budget_ms" else "non-negative", value))
    entries = settings["cache_entries"]
    if not (isinstance(entries, int) and not isinstance(entries, bool) and 1 <= entries <= 5000):
        raise ConfigError("%s: 'policy.cache_entries' must be an integer from 1 to 5000, got %r" % (source, entries))
    settings["thresholds"] = _checked_policy_thresholds(settings["thresholds"], source)
    if settings["enabled"] and not config.get("jev"):
        raise ConfigError("%s: 'policy.enabled' needs a 'jev' object: there is no decision model to ask" % source)
    config["policy"] = settings


def _checked_policy_thresholds(thresholds, source):
    if not isinstance(thresholds, dict):
        raise ConfigError("%s: 'policy.thresholds' must be an object of question id -> probability" % source)
    for name, value in thresholds.items():
        if name not in POLICY_QUESTIONS:
            raise ConfigError("%s: 'policy.thresholds' names no question %r (known: %s)"
                              % (source, name, ", ".join(POLICY_QUESTIONS)))
        if not _is_number(value) or not 0 < value <= 1:
            raise ConfigError("%s: 'policy.thresholds.%s' must be a number above 0 and at most 1, got %r"
                              % (source, name, value))
    return dict(thresholds)


# ------------------------------------------------------------- the request

class PolicyRequestError(ValueError):
    """What `judge-tool` was given on stdin is not a usable request."""


def parse_policy_request(text):
    """{"session", "tool", "arguments", "configured"} from the plugin's JSON, or PolicyRequestError."""
    try:
        data = json.loads(text)
    except (TypeError, ValueError):
        raise PolicyRequestError("the request is not JSON") from None
    if not isinstance(data, dict):
        raise PolicyRequestError("the request must be a JSON object")
    session = data.get("sessionID")
    if not isinstance(session, str) or not POLICY_SESSION_RE.match(session):
        raise PolicyRequestError("sessionID must be a v2 session id (ses_...)")
    if data.get("tool") not in POLICY_TOOLS:
        raise PolicyRequestError("tool must be one of %s" % ", ".join(POLICY_TOOLS))
    if data.get("outcome") not in POLICY_REQUEST_OUTCOMES:
        raise PolicyRequestError("outcome must be one of %s" % ", ".join(POLICY_REQUEST_OUTCOMES))
    arguments = data.get("arguments", "")
    if arguments is None:
        arguments = ""
    elif not isinstance(arguments, str):
        arguments = _canonical(arguments)
    return {"session": session, "tool": data["tool"], "arguments": arguments[:POLICY_ARG_LIMIT],
            "configured": data["outcome"]}


def _guess_configured(text):
    """The configured outcome in a request we could not use, or `allow`, which no plugin applies."""
    try:
        outcome = json.loads(text).get("outcome")
    except (TypeError, ValueError, AttributeError):
        return "allow"
    return outcome if outcome in POLICY_REQUEST_OUTCOMES else "allow"


_SECRET_PATTERNS = (
    (re.compile(r"(?i)\b(bearer|basic)\s+[A-Za-z0-9._~+/=-]{6,}"), r"\1 [redacted]"),
    (re.compile(r"(?i)\b([A-Za-z0-9_.-]*(?:token|secret|passw(?:or)?d|api[_-]?key|credential|auth)[A-Za-z0-9_.-]*)"
                r"(\s*[=:]\s*|\s+)(\"[^\"]*\"|'[^']*'|\S+)"), r"\1\2[redacted]"),
    (re.compile(r"\b(?:sk-[A-Za-z0-9_-]{8,}|gh[pousr]_[A-Za-z0-9]{16,}|github_pat_[A-Za-z0-9_]{20,}"
                r"|AKIA[0-9A-Z]{12,}|xox[abprs]-[A-Za-z0-9-]{8,})"), "[redacted]"),
    (re.compile(r"(://[^/\s:@]+:)[^@\s/]+@"), r"\1[redacted]@"),
)


def redact_command_text(text, extra=()):
    """`text` with credential-shaped parts replaced, and any value in `extra` (a known key) removed.

    A tool's arguments go to a third-party model and to the audit log; neither
    may see a credential. This is a net, not a promise: it catches the usual shapes.
    """
    text = "" if text is None else str(text)
    for secret in extra:
        if secret:
            text = text.replace(secret, "[redacted]")
    for pattern, replacement in _SECRET_PATTERNS:
        text = pattern.sub(replacement, text)
    return text


# ------------------------------------------------------- standing authority

_STANDING_AUTHORITY = re.compile(r"^(?:[-*]\s+)?\**standing authority\**\s*:\s*\**\s*(.*?)\**\s*$", re.IGNORECASE)


def parse_standing_authority(body):
    """The charter's one-line `Standing authority:` text, or None when it states none.

    It lives in the charter issue's prose, below the yaml block; fenced code is
    ignored, the first such line wins, and "none" counts as none stated.
    """
    fenced = False
    for line in (body or "").splitlines():
        if line.lstrip().startswith(("```", "~~~")):
            fenced = not fenced
            continue
        match = None if fenced else _STANDING_AUTHORITY.match(line.strip())
        if match:
            text = match.group(1).strip()
            return None if not text or text.lower().rstrip(".") in ("none", "none stated", "n/a") else text
    return None


def fetch_standing_authority(reader, charter, repo):
    """The charter issue's standing authority through the reader's GET-only `gh api`."""
    data = reader._api("repos/%s/issues/%d" % (repo, charter))
    return parse_standing_authority(data.get("body") if isinstance(data, dict) else None)


def resolve_policy_context(reader, fleet):
    """{"issue", "intent", "done_when", "authority"} for the agent's ask, from GitHub (IntentError on failure).

    The ask is the agent's issue, or its parent when the issue is a work item;
    an orchestrator with only a charter has no ask (`issue` None). The
    authority comes from the charter above the ask, or the charter itself.
    """
    repo = fleet.get("repo") or reader.repo
    issue, charter = fleet.get("issue"), fleet.get("charter")
    ask = intent = done_when = None
    if _is_issue_number(issue) and reader.issue(issue, repo).charter:
        issue, charter = None, issue
    if _is_issue_number(issue):
        ask, work = reader.ask_of(issue, repo)
        found = reader.issue(ask, repo)
        intent, done_when = found.intent, found.done_when
        if work is not None and reader.issue(work, repo).intent:
            intent = "%s (work item: %s)" % (intent or NO_INTENT, reader.issue(work, repo).intent)
        charter = reader.parent(ask, repo)
    authority = fetch_standing_authority(reader, charter, repo) if _is_issue_number(charter) else None
    return {"issue": ask if intent else None, "intent": intent, "done_when": done_when, "authority": authority}


# ------------------------------------------------------------------ the caches

class BoundedFileCache:
    """A small JSON file of {key: {at, value}}: bounded, expiring, private, replaceable.

    It is a cache and nothing else: deleting it loses only speed (invariant 8).
    Written atomically (a temp file, mode 0600, then rename); a missing,
    oversized or corrupt file reads as empty; a write that fails is not an error.
    A ttl of 0 turns it off.
    """

    def __init__(self, path, now, ttl, limit):
        self.path, self.now, self.ttl, self.limit = Path(path), now, ttl, limit

    def _fresh(self):
        if not self.ttl:
            return {}
        try:
            if self.path.stat().st_size > POLICY_CACHE_BYTES:
                return {}
            data = json.loads(self.path.read_text())
        except (OSError, ValueError):
            return {}
        entries = data.get("entries") if isinstance(data, dict) else None
        if not isinstance(entries, dict):
            return {}
        return {key: entry for key, entry in entries.items()
                if isinstance(entry, dict) and _is_number(entry.get("at")) and self.now() - entry["at"] < self.ttl
                and self.now() >= entry["at"]}

    def get(self, key):
        entry = self._fresh().get(key)
        return entry["value"] if entry else None

    def put(self, key, value):
        """Store one entry, dropping the oldest beyond the limit. True when it was written."""
        if not self.ttl:
            return False
        entries = self._fresh()
        entries[key] = {"at": self.now(), "value": value}
        for old in sorted(entries, key=lambda k: entries[k]["at"])[:max(0, len(entries) - self.limit)]:
            del entries[old]
        temp = self.path.with_name("%s.%d.tmp" % (self.path.name, os.getpid()))
        try:
            fd = os.open(str(temp), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            with os.fdopen(fd, "w") as handle:
                handle.write(json.dumps({"entries": entries}, sort_keys=True))
                handle.flush()
                os.fsync(handle.fileno())
            os.replace(str(temp), str(self.path))
            return True
        except OSError:
            try:
                os.unlink(str(temp))
            except OSError:
                pass
            return False


# ------------------------------------------------------------------- the reply

def policy_reply(outcome, reason, judged=False, cached=False, latency_ms=0):
    """The one JSON line `judge-tool` prints."""
    return {"outcome": outcome, "reason": _one_line(reason, 600), "judged": bool(judged),
            "cached": bool(cached), "latency_ms": int(latency_ms)}


def policy_unjudged_reason(config, request):
    """Why this call is not judged at all (a sentence), or None when it is to be judged."""
    if request["configured"] == "deny":
        return "a configured deny is final: the judge was not consulted"
    if request["tool"] in POLICY_PASS_THROUGH:
        return "not judged: a %s passes straight through" % request["tool"]
    if not config["policy"]["enabled"]:
        return "the policy judge is not enabled"
    if fault("no-policy-judge"):
        return "no-policy-judge fault: the judge is off"
    return None


def _what_text(request):
    return "%s: %s" % (request["tool"], _one_line(request["arguments"], 100))


def escalation_reason(fleet, ask, request):
    """The denial text for a call outside the ask's Intent: escalate, never argue."""
    where = " (ask #%d)" % ask if ask else ""
    route = ("Send the Chief of Staff the proposal with `%s send <chief-of-staff> --issue <n> \"...\"`" % PROG)
    if (fleet or {}).get("role") == "orchestrator":
        route += ", or label your charter awaiting-user with a Decision required section"
    return ("Denied: this call is outside the ask's Intent%s (%s). Do not retry it or work around it. Escalate: "
            "%s. Only the person you report to widens the ask." % (where, _what_text(request), route))


def tightened_reason(combined, fleet, ask, request):
    """The sentence for the outcome the judge reached, for the agent or for you."""
    fired = combined["fired"]
    if "outside_intent" in fired and combined["outcome"] in ("deny", "hard-deny"):
        return escalation_reason(fleet, ask, request)
    if fired and combined["outcome"] != "allow":
        return "Needs your yes: %s (%s)." % ("; ".join(POLICY_FIRED_TEXT[n] for n in fired if n in POLICY_FIRED_TEXT),
                                            _what_text(request))
    return "judge: nothing at its threshold; the configured outcome stands"


def policy_verdict_key(request, fleet_name, context, role):
    """A hash of everything the verdict depends on, for the cache: no text is kept."""
    parts = {"session": request["session"], "agent": fleet_name, "role": role, "ask": context["issue"],
             "intent": context["intent"], "done_when": context["done_when"], "authority": context["authority"],
             "tool": request["tool"], "arguments": request["arguments"]}
    return hashlib.sha256(_canonical(parts).encode("utf-8")).hexdigest()[:32]


def _valid_answers(value):
    answers = value.get("answers") if isinstance(value, dict) else None
    ok = isinstance(answers, dict) and set(answers) == set(POLICY_QUESTIONS) \
        and all(_is_probability(p) for p in answers.values())
    return answers if ok else None


def _valid_session_fleet(value):
    fleet = value.get("fleet") if isinstance(value, dict) else None
    return fleet if isinstance(fleet, dict) and isinstance(fleet.get("name"), str) else None


def _valid_context(value):
    keys = ("issue", "intent", "done_when", "authority")
    ok = isinstance(value, dict) and all(k in value for k in keys) \
        and all(value[k] is None or isinstance(value[k], str) for k in keys[1:]) \
        and (value["issue"] is None or _is_issue_number(value["issue"]))
    return {k: value[k] for k in keys} if ok else None


# ------------------------------------------------------------------ the judge

class PolicyJudge:
    """Judges one tool call: who the agent is, what its ask is, what Jev says, what the code allows.

    Every collaborator is injected, so a test never reaches a real binary. The
    whole judgement runs in one worker thread against `budget_ms`: when it has
    not finished in time the configured outcome is the reply, and the worker
    is left to finish filling the caches, so the next call is fast.
    """

    def __init__(self, config, v2, reader, jev, audit, state, now=time.time, monotonic=time.monotonic, environ=None):
        self.config, self.settings = config, config["policy"]
        self.v2, self.reader, self.jev, self.audit = v2, reader, jev, audit
        self.now, self.monotonic = now, monotonic
        self.environ = os.environ if environ is None else environ
        ttl, limit = self.settings["cache_seconds"], self.settings["cache_entries"]
        self.verdicts = BoundedFileCache(Path(state) / POLICY_VERDICT_FILE, now, ttl, limit)
        self.contexts = BoundedFileCache(Path(state) / POLICY_CONTEXT_FILE, now, ttl, limit)
        self._worker = None

    # -- the whole judgement, against the budget

    def decide(self, request):
        started = self.monotonic()
        box = {"stage": "identifying the agent", "detail": {}}
        worker = threading.Thread(target=self._work, args=(request, box), daemon=True)
        worker.start()
        worker.join(self.settings["budget_ms"] / 1000.0)
        elapsed = int((self.monotonic() - started) * 1000)
        if worker.is_alive():
            self._worker = worker
            reply = policy_reply(request["configured"], "no answer within %d ms (still %s): the configured "
                                 "outcome stands" % (self.settings["budget_ms"], box["stage"]), False, False, elapsed)
        else:
            reply = box.get("reply") or policy_reply(request["configured"], "the judge failed: the configured "
                                                     "outcome stands", False, False, elapsed)
            reply["latency_ms"] = elapsed
        self._audit(request, reply, box)
        return reply

    def finish_late(self, seconds=POLICY_WARM_SECONDS):
        """Wait for a judgement that missed its budget to finish and fill the caches (tests use it)."""
        if self._worker is not None:
            self._worker.join(seconds)

    def _work(self, request, box):
        try:
            box["reply"] = self._judge(request, box)
        except Exception as err:  # a worker thread must never leak a traceback or die without a reply
            box["detail"]["error"] = _one_line("%s: %s" % (type(err).__name__, err), 200)
            box["reply"] = policy_reply(request["configured"], "could not judge while %s (%s): the configured "
                                        "outcome stands" % (box["stage"], _one_line(str(err), 120)))

    def _judge(self, request, box):
        fleet = self.identify(request["session"])
        if fleet is None:
            return policy_reply(request["configured"], "not a fleet agent (no metadata.fleet): not judged")
        box["stage"] = "resolving the ask"
        context = self.context_of(fleet)
        box["detail"].update(agent=fleet["name"], role=fleet.get("role"), ask=context["issue"])
        request = dict(request, arguments=self.redacted(request["arguments"]))  # from here on, nothing sees a credential
        key = policy_verdict_key(request, fleet["name"], context, fleet.get("role"))
        thresholds = dict(self.settings["thresholds"])
        if context["issue"] is None:
            thresholds["outside_intent"] = 2.0  # with no ask there is nothing to be outside of: that question cannot fire
        cached = _valid_answers(self.verdicts.get(key))
        if cached is not None:
            combined = combine_policy(cached, thresholds, request["configured"])
            combined.update(answers=cached, latency_ms=0, usage={}, model=None)
        else:
            box["stage"] = "asking the decision model"
            state = self.state_of(request, fleet, context)
            box["detail"]["state"] = state
            combined = judge_tool_call(self.jev, request["configured"], state, thresholds)
            if "answers" in combined:
                self.verdicts.put(key, {"answers": combined["answers"]})
        box["detail"].update(combined=combined, cached=cached is not None, thresholds=thresholds)
        return self.reply_of(combined, cached is not None, fleet, context, request)

    # -- the pieces

    def identify(self, session):
        known = _valid_session_fleet(self.contexts.get("session:" + session))
        if known is not None:
            return known
        fleet = _fleet_meta(self.v2.session_get(session))
        if fleet is None or not isinstance(fleet.get("name"), str):
            return None
        kept = {k: fleet[k] for k in ("name", "role", "reports_to", "issue", "charter", "repo") if k in fleet}
        self.contexts.put("session:" + session, {"fleet": kept})
        return kept

    def context_of(self, fleet):
        if self.reader is None:
            return {"issue": None, "intent": None, "done_when": None, "authority": None}
        key = "ask:%s:%s:%s" % (fleet.get("repo") or self.reader.repo, fleet.get("issue"), fleet.get("charter"))
        known = _valid_context(self.contexts.get(key))
        if known is not None:
            return known
        context = resolve_policy_context(self.reader, fleet)
        self.contexts.put(key, context)
        return context

    def redacted(self, text):
        secrets = [self.environ.get(self.config["jev"]["key_env"])] if self.config.get("jev") else []
        return redact_command_text(text, secrets)

    def state_of(self, request, fleet, context):
        return policy_state(fleet.get("role") or "unknown", context["intent"] or "not stated: no ask is recorded",
                            context["done_when"] or "not stated", context["authority"] or NO_STANDING_AUTHORITY,
                            request["tool"], request["arguments"])

    def reply_of(self, combined, cached, fleet, context, request):
        outcome = combined["outcome"]
        judged = "answers" in combined
        reason = tightened_reason(combined, fleet, context["issue"], request) if judged else combined["reason"]
        return policy_reply("deny" if outcome == "hard-deny" else outcome, reason, judged, cached,
                            combined.get("latency_ms") or 0)

    def _audit(self, request, reply, box):
        detail, combined = box["detail"], box["detail"].get("combined") or {}
        state = dict(detail.get("state") or {})
        state["arguments"] = _one_line(state.get("arguments"), 300)
        entry = {"agent": detail.get("agent"), "role": detail.get("role"), "session": request["session"],
                 "tool": request["tool"], "configured": request["configured"], "outcome": reply["outcome"],
                 "judged": reply["judged"], "cached": reply["cached"], "reason": reply["reason"],
                 "latency_ms": reply["latency_ms"], "ask": detail.get("ask"), "fired": combined.get("fired"),
                 "answers": combined.get("answers"), "thresholds": detail.get("thresholds"),
                 "question": {"state": state, "ids": list(POLICY_QUESTIONS)} if state else None,
                 "model": combined.get("model"), "usage": combined.get("usage"), "error": detail.get("error")}
        try:
            self.audit.append(POLICY_ACTOR, "policy.judge", "tool:%s:%s" % (request["session"], request["tool"]), entry)
        except OSError:
            pass  # the audit is best effort here: a full disk must not stop a tool call


def judge_request(request, config, build_judge):
    """(reply, judge): the reply for one parsed request, and the judge that made it (None when none was needed).

    `build_judge()` makes the PolicyJudge and is called only for a call that is to be judged.
    """
    why = policy_unjudged_reason(config, request)
    if why is not None:
        return policy_reply(request["configured"], why), None
    judge = build_judge()
    return judge.decide(request), judge


def build_policy_judge(config, runner, now):
    """The PolicyJudge over the configured clients: v2, the ask reader, Jev, the audit log."""
    if config["opencode"] is None:
        raise ConfigError("'opencode' is not configured: the judge cannot identify an agent without v2")
    state = ensure_state_dir()
    settings = config["policy"]
    jev_settings = dict(config["jev"], timeout_seconds=min(config["jev"]["timeout_seconds"], POLICY_WARM_SECONDS))
    jev = build_jev(dict(config, jev=jev_settings))
    v2 = V2Client(config["opencode"], config["opencode_env"], runner, min(config["call_timeout_seconds"], POLICY_WARM_SECONDS))
    return PolicyJudge(config, v2, intent_reader_for(config, runner, now), jev, AuditLog(state / "audit.jsonl"), state, now)


# ------------------------------------------- the judge socket: the daemon holds the key

# `judge-tool` runs inside whatever process the v2 plugin lives in, and its
# environment is the environment of every agent's shell tool. So it never
# reads the OpenRouter key, and never calls Jev: it sends the request over a
# local unix stream socket to the switchboard DAEMON, which holds the key in
# its own environment, judges, and answers with the same one JSON line. The
# daemon, not v2, holds the key.
POLICY_SOCKET = "judge.sock"
POLICY_READ_SECONDS = 2      # the daemon's wait for a request to arrive
POLICY_CLIENT_SLACK = 0.4    # seconds past the budget `judge-tool` waits for the daemon
POLICY_CONNECTIONS = 16      # judgements the daemon runs at once


class PolicyDaemonError(Exception):
    """The daemon could not be reached, or did not answer in time."""


def read_judge_line(conn, limit):
    """Bytes up to a newline or EOF, at most limit + 1 of them; times out with the socket's timeout."""
    data = b""
    while len(data) <= limit and b"\n" not in data:
        chunk = conn.recv(4096)
        if not chunk:
            break
        data += chunk
    return data


def ask_judge_daemon(state_dir, text, timeout):
    """The daemon's reply (a dict) to the request text, or PolicyDaemonError. Never reads any environment variable."""
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        sock.settimeout(timeout)
        with in_directory(state_dir):
            sock.connect(POLICY_SOCKET)
        sock.sendall(text.encode("utf-8"))
        sock.shutdown(socket.SHUT_WR)
        raw = read_judge_line(sock, POLICY_STDIN_LIMIT)
    except (socket.timeout, TimeoutError):
        raise PolicyDaemonError("the daemon did not answer in time") from None
    except OSError as err:
        raise PolicyDaemonError("the daemon is not reachable (%s)" % (err.strerror or err)) from None
    finally:
        sock.close()
    try:
        reply = json.loads(raw.decode("utf-8", "replace").splitlines()[0])
    except (ValueError, IndexError):
        raise PolicyDaemonError("the daemon's answer is not JSON") from None
    if not isinstance(reply, dict) or reply.get("outcome") not in POLICY_REQUEST_OUTCOMES:
        raise PolicyDaemonError("the daemon's answer has no usable outcome")
    return reply


def never_looser(reply, configured):
    """The reply, made no looser than `configured`: the client's own guard, as the plugin has its own."""
    if POLICY_REQUEST_OUTCOMES.index(reply["outcome"]) >= POLICY_REQUEST_OUTCOMES.index(configured):
        return policy_reply(reply["outcome"], reply.get("reason") or "", reply.get("judged"), reply.get("cached"),
                            reply.get("latency_ms") if isinstance(reply.get("latency_ms"), int) else 0)
    return policy_reply(configured, "the daemon answered looser than the configured outcome: ignored")


class JudgeServer:
    """The daemon's end of the judge socket: one request and one reply per connection.

    `handle(text)` returns the reply dict. The socket is $STATE/judge.sock, mode
    0600, a stale one replaced; every connection runs in its own thread, so a
    slow judgement never delays a pass or another judgement.
    """

    def __init__(self, state_dir, handle):
        self.state_dir, self.handle = state_dir, handle
        self.sock = self.thread = None
        self.slots = threading.BoundedSemaphore(POLICY_CONNECTIONS)
        self.stopping = threading.Event()

    def start(self):
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        before = os.umask(0o177)  # the socket is born private, not chmod-ed after anyone could connect
        try:
            with in_directory(self.state_dir):
                try:
                    os.unlink(POLICY_SOCKET)
                except FileNotFoundError:
                    pass
                sock.bind(POLICY_SOCKET)
                os.chmod(POLICY_SOCKET, 0o600)
            sock.listen(POLICY_CONNECTIONS)
            sock.settimeout(0.2)
        except BaseException:
            sock.close()
            raise
        finally:
            os.umask(before)
        self.sock = sock
        self.thread = threading.Thread(target=self._accept, daemon=True)
        self.thread.start()
        return self

    def stop(self):
        self.stopping.set()
        if self.thread is not None:
            self.thread.join(2)
        if self.sock is not None:
            self.sock.close()
            try:
                with in_directory(self.state_dir):
                    os.unlink(POLICY_SOCKET)
            except OSError:
                pass

    def _accept(self):
        while not self.stopping.is_set():
            try:
                conn, _ = self.sock.accept()
            except socket.timeout:
                continue
            except OSError:
                return
            if not self.slots.acquire(blocking=False):
                conn.close()  # too many at once: that caller keeps its configured outcome
                continue
            threading.Thread(target=self._serve, args=(conn,), daemon=True).start()

    def _serve(self, conn):
        try:
            conn.settimeout(POLICY_READ_SECONDS)
            raw = read_judge_line(conn, POLICY_STDIN_LIMIT)
            text = raw.decode("utf-8", "replace")
            if len(raw) > POLICY_STDIN_LIMIT:
                reply = policy_reply(_guess_configured(text), "unusable request (larger than %d bytes): no change"
                                     % POLICY_STDIN_LIMIT)
            else:
                reply = self.handle(text)
            conn.sendall((json.dumps(reply, sort_keys=True) + "\n").encode("utf-8"))
        except (OSError, ValueError):
            pass  # a caller that went away or sent nothing in time: nothing to answer
        finally:
            conn.close()
            self.slots.release()


def make_judge_handler(runner, now):
    """handle(text) for the daemon: parse, judge with the daemon's own key and clients, reply. Never raises."""
    def handle(text):
        try:
            request = parse_policy_request(text)
            config = load_config()  # read at each call, so an edit to `policy` takes effect without a restart
            active_faults()
            return judge_request(request, config, lambda: build_policy_judge(config, runner, now))[0]
        except PolicyRequestError as err:
            return policy_reply(_guess_configured(text), "unusable request (%s): no change" % err)
        except Exception as err:  # the judge only tightens: whatever fails, the configured outcome stands
            return policy_reply(_guess_configured(text), "the judge failed (%s: %s): the configured outcome stands"
                                % (type(err).__name__, _one_line(str(err), 120)))
    return handle


def start_judge_server(config, state, runner, now):
    """The daemon's judge socket when `policy.enabled`, else None."""
    if not config["policy"]["enabled"]:
        return None
    return JudgeServer(state, make_judge_handler(runner, now)).start()


def cmd_judge_tool(args, runner, now, stdin=None):
    """Read one request, print one JSON line, exit 0 whatever happens (invariant 9).

    Decides locally only what needs no model (a read, a configured deny, the
    judge off); everything else goes to the daemon. It reads no environment
    variable of its own accord: the key is the daemon's.
    """
    text = ""
    try:
        text = (stdin or sys.stdin).read(POLICY_STDIN_LIMIT + 1)
        if len(text) > POLICY_STDIN_LIMIT:
            raise PolicyRequestError("the request is larger than %d bytes" % POLICY_STDIN_LIMIT)
        request = parse_policy_request(text)
        config = load_config()
        active_faults()
        why = policy_unjudged_reason(config, request)
        if why is not None:
            reply = policy_reply(request["configured"], why)
        else:
            wait = config["policy"]["budget_ms"] / 1000.0 + POLICY_CLIENT_SLACK
            reply = never_looser(ask_judge_daemon(state_dir_path(), text, wait), request["configured"])
    except PolicyRequestError as err:
        reply = policy_reply(_guess_configured(text), "unusable request (%s): no change" % err)
    except PolicyDaemonError as err:
        reply = policy_reply(request["configured"], "%s: the configured outcome stands" % err)
    except Exception as err:  # nothing the judge does may stop a tool call: the configured outcome stands
        reply = policy_reply(_guess_configured(text), "the judge failed (%s: %s): the configured outcome stands"
                             % (type(err).__name__, _one_line(str(err), 120)))
    try:
        print(json.dumps(reply, sort_keys=True))
        sys.stdout.flush()
    except (OSError, ValueError):
        pass  # the plugin stopped listening
    return EXIT_OK


POLICY_COMMANDS = {"judge-tool": cmd_judge_tool}


def add_policy_parsers(sub):
    sub.add_parser("judge-tool", help="Judge one tool call: JSON on stdin, one JSON line out, exit 0 "
                                      "(the fleet-hooks plugin runs this; the judge only tightens)")


def build_parser():
    parser = argparse.ArgumentParser(
        prog=PROG,
        description="Route facts to fleet agents as OpenCode v2 messages. Never types into a pane.",
        epilog="Config: $XDG_CONFIG_HOME/%s/config.json (optional). "
               "State: $XDG_STATE_HOME/%s/ (mode 0700). See docs/switchboard.md." % (PROG, PROG))
    sub = parser.add_subparsers(dest="action", required=True)
    status = sub.add_parser("status", help="Config, clients, and every fleet agent with what is pending for it")
    status.add_argument("--json", action="store_true", help="Emit machine-readable JSON instead")
    run = sub.add_parser("run", help="The daemon: observe, derive, decide, deliver, every poll seconds")
    run.add_argument("--once", action="store_true", help="One pass, then exit")
    run.add_argument("--poll", type=float, help="Seconds between passes (default: config poll_seconds)")
    run.add_argument("--json", action="store_true", help="With --once: print the pass report as JSON")
    send = sub.add_parser("send", help="Deliver a message to another fleet agent now, by the delivery rule")
    send.add_argument("name", help="The recipient's fleet name")
    send.add_argument("text", nargs="+", help="The message")
    send.add_argument("--issue", type=int, help="The issue the message is about")
    send.add_argument("--from", dest="sender", help="Lab only: the sender's fleet name")
    sub.add_parser("ensure", help="Start the daemon unless it runs (herdr's startup hook calls this)")
    sub.add_parser("poke", help="Ask the daemon for a pass now; silent, never blocks (herdr's event hooks call this)")
    launch = sub.add_parser("launch", help="Start a fleet agent in a new herdr tab, without typing")
    launch.add_argument("name", help="The agent's fleet name (lower case, digits, - and _)")
    launch.add_argument("--agent", required=True, help="The OpenCode agent definition, such as coder")
    launch.add_argument("--dir", required=True, help="The agent's working directory (absolute)")
    launch.add_argument("--workspace", help="The herdr workspace for the new tab (default: $HERDR_WORKSPACE_ID)")
    launch.add_argument("--role", help="metadata.fleet.role")
    launch.add_argument("--reports-to", dest="reports_to", help="metadata.fleet.reports_to")
    launch.add_argument("--issue", type=int, help="metadata.fleet.issue")
    launch.add_argument("--brief-file", dest="brief_file", help="The first prompt: a file, or - for stdin")
    pending = sub.add_parser("pending", help="What is pending for an agent, and why it waits or is held")
    pending.add_argument("name", help="The agent's fleet name")
    pending.add_argument("--json", action="store_true", help="Emit machine-readable JSON instead")
    remind = sub.add_parser("remind", help="A message to an agent that is due later")
    remind.add_argument("name", help="The recipient's fleet name")
    remind.add_argument("when", help="A delay (30m, 2h, 1d) or an ISO time with a zone")
    remind.add_argument("text", nargs="+", help="The reminder")
    remind.add_argument("--issue", type=int, help="The issue the reminder is about")
    remind.add_argument("--from", dest="sender", help="Lab only: the sender's fleet name")
    add_intent_parsers(sub)
    add_foreground_parsers(sub)  # PR 8
    add_policy_parsers(sub)  # PR 9
    sub.add_parser("version", help="Print the version")
    return parser


def main(argv=None, runner=subprocess.run, now=time.time, wait=None, spawn=subprocess.Popen,
         socket_call=None):
    try:
        args = build_parser().parse_args(argv)
    except SystemExit as exit_:
        return EXIT_USAGE if exit_.code not in (0, None) else EXIT_OK
    if args.action == "version":
        print("%s %s" % (PROG, VERSION))
        return EXIT_OK
    if args.action == "status":
        return cmd_status(args, runner, now)
    if args.action == "poke":
        return cmd_poke(args)
    if args.action in POLICY_COMMANDS:  # PR 9: prints one JSON line and exits 0 whatever happens
        return POLICY_COMMANDS[args.action](args, runner, now)
    try:
        if args.action == "ensure":
            return cmd_ensure(args, spawn)
        if args.action == "launch":
            return cmd_launch(args, runner, now, socket_call)
        if args.action == "handoff":  # PR 8
            return cmd_handoff(args, runner, now, socket_call)
        if args.action == "run":
            return cmd_run(args, runner, now, wait)
        if args.action == "send":
            return cmd_send(args, runner, now)
        if args.action == "pending":
            return cmd_pending(args, runner, now)
        if args.action == "remind":
            return cmd_remind(args, runner, now)
        if args.action in INTENT_COMMANDS:
            return INTENT_COMMANDS[args.action](args, runner, now)
    except SimulatedCrash as crash:
        sys.stderr.write("%s: crashed: %s\n" % (PROG, crash))
        return EXIT_CRASH
    except (V2Error, HerdrError, ConfigError, FaultError, FactError, CallerError, LockError,
            LaunchError, IntentError) as err:
        sys.stderr.write("%s: %s\n" % (PROG, _one_line(str(err))))
        return EXIT_ERROR
    sys.stderr.write("%s: unknown command %r\n" % (PROG, args.action))
    return EXIT_USAGE


if __name__ == "__main__":
    sys.exit(main())
