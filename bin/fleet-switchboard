    "answer-unjudged",         # PR 18: `decisions answer` and `decisions resolve` skip the judge
)

LAB_ENV = "FLEET_SWITCHBOARD_LAB"
FAULT_ENV = "FLEET_SWITCHBOARD_FAULT"


class FaultError(Exception):
    """A fault name nobody defined. A typo here would make a control prove nothing."""


def active_faults():
    """The fault names requested in the environment, checked, as a sorted list."""
    raw = os.environ.get(FAULT_ENV, "")
    names = sorted({part.strip() for part in raw.split(",") if part.strip()})
    unknown = [name for name in names if name not in KNOWN_FAULTS]
    if unknown:
        raise FaultError("%s names unknown fault(s): %s (known: %s)"
                         % (FAULT_ENV, ", ".join(unknown), ", ".join(KNOWN_FAULTS)))
    return names


def fault(name):
    """True only in the Lab, and only for a fault named in the environment."""
    if name not in KNOWN_FAULTS:
        raise FaultError("unknown fault: %r" % name)
    requested = active_faults()
    return os.environ.get(LAB_ENV) == "1" and name in requested


class SimulatedCrash(BaseException):
    """The `crash-after-send` fault: the process stops here, as if killed.

    A BaseException, so no per-agent `except Exception` in the pass catches
    it, and AuditLog.external lets it through without writing a result: a
    crashed process writes nothing after the crash. Scenario R2 is built on it.
    """


# ------------------------------------------------------------- the message id

def derive_message_id(recipient, keys):
    """The v2 message id for a delivery: the recipient plus the keys it covers.

    A retry after a crash derives the same id, and v2 admits a repeated id
    once, so a message is delivered at most once (invariant 3). Order and
    duplicates in `keys` do not change the id.
    """
    if not isinstance(recipient, str) or not recipient:
        raise ValueError("recipient must be a non-empty string")
    keys = list(keys)
    if not keys or not all(isinstance(key, str) and key for key in keys):
        raise ValueError("keys must be a non-empty list of non-empty strings")
    canonical = json.dumps([recipient, sorted(set(keys))], separators=(",", ":"), ensure_ascii=False)
    return "msg_" + hashlib.sha256(canonical.encode("utf-8")).hexdigest()[:26]


# ----------------------------------------------------------------- the audit

SENSITIVE = ("token", "key", "password", "secret", "authorization")
REDACTED = "[redacted]"


def _sensitive(name):
    lowered = str(name).lower()
    # `keys` is the list of fact names a message covers (docs/switchboard.md
    # §Data), such as `worker.idle:<session>:<time>`. It is the one thing the
    # audit must show about a delivery, and it never holds a credential.
    if lowered == "keys":
        return False
    return any(word in lowered for word in SENSITIVE)


def redact(value):
    """A copy of `value` with every credential-like key's value replaced."""
    if isinstance(value, dict):
        return {k: (REDACTED if _sensitive(k) else redact(v)) for k, v in value.items()}
    if isinstance(value, (list, tuple)):
        return [redact(v) for v in value]
    return value


def utc_now():
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


class AuditLog:
    """Append-only JSON lines. Never read by a decision; written before and after."""

    def __init__(self, path):
        self.path = Path(path)

    def append(self, actor, event, subject=None, detail=None, **extra):
        entry = {"ts": utc_now(), "actor": actor, "event": event,
                 "subject": subject, "detail": redact(detail)}
        entry.update(redact(extra))
        line = json.dumps(entry, sort_keys=True, default=str) + "\n"
        fd = os.open(str(self.path), os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
        with os.fdopen(fd, "a") as handle:
            handle.write(line)
            handle.flush()
            os.fsync(handle.fileno())
        return entry

    @contextmanager
    def external(self, actor, event, subject=None, detail=None):
        """Audit one write to another system: `intent` before, `result` after.

        Yields a dict the caller may fill with what came back; it becomes the
        result entry's detail. An exception is recorded, then re-raised. A
        SimulatedCrash is re-raised with nothing recorded, as a real crash.
        """
        call = uuid.uuid4().hex[:12]
        self.append(actor, event, subject, detail, phase="intent", call=call)
        outcome = {}
        try:
            yield outcome
        except SimulatedCrash:
            raise
        except BaseException as err:
            self.append(actor, event, subject, outcome or None, phase="result", call=call,
                        ok=False, error="%s: %s" % (type(err).__name__, err))
            raise
        self.append(actor, event, subject, outcome or None, phase="result", call=call, ok=True)


# ------------------------------------------------------------- OpenCode v2

class V2Error(Exception):
    """A v2 call that did not return usable JSON.

    reason: "http" (v2 answered with an HTTP error), "exit" (non-zero exit, no
    HTTP status), "timeout", "bad_json" or "unavailable" (could not run).
    """

    def __init__(self, reason, status=None, detail=None):
        self.reason = reason
        self.status = status
        self.detail = detail
        text = reason if status is None else "%s %s" % (reason, status)
        super().__init__("%s: %s" % (text, detail) if detail else text)


def _one_line(text, limit=300):
    return decision_core.one_line(text, limit)


CURSOR_LIMIT = 2000  # characters of one v2 cursor token we will pass back on an argv
MAX_READ_PAGES = 5   # pages of READ_LIMIT messages `delivered_keys` reads before it holds
DESCRIPTION_MAX = 200  # characters of the one line v2's TUI shows for a synthetic message (PR 13)


def valid_description(text):
    return isinstance(text, str) and bool(text.strip()) and len(text) <= DESCRIPTION_MAX \
        and "\n" not in text and "\r" not in text


class V2Client:
    """The one client for OpenCode v2. Every call is `<binary> api <operation>`."""

    DELIVERIES = ("queue", "steer")
    ORDERS = ("desc", "asc")

    def __init__(self, binary, env=None, runner=subprocess.run, timeout=20):
        self.binary = binary
        self.env = dict(env or {})
        self.runner = runner
        self.timeout = timeout

    def _call(self, operation, params=None, data=None, envelope=False):
        argv = [self.binary, "api", operation]
        for name, value in (params or {}).items():
            if value is not None:
                argv += ["--param", "%s=%s" % (name, value)]
        if data is not None:
            argv += ["-d", json.dumps(data, separators=(",", ":"), sort_keys=True)]
        env = dict(os.environ)
        env.update(self.env)
        # OpenCode v2's `api` command loses the end of a large reply when it writes to a pipe and exits
        # (a real 500 KB transcript arrived cut at 293 KB, inside a string, and every read failed with
        # bad_json). Into a file the reply is whole, so the reply goes to a file and is read back.
        with tempfile.TemporaryFile(mode="w+", encoding="utf-8") as sink:
            try:
                result = self.runner(argv, stdout=sink, stderr=subprocess.PIPE, text=True, timeout=self.timeout,
                                     env=env, stdin=subprocess.DEVNULL)
            except subprocess.TimeoutExpired:
                raise V2Error("timeout", None, "%s did not answer within %ss" % (operation, self.timeout)) from None
            except OSError as err:
                raise V2Error("unavailable", None, "cannot run %s: %s" % (self.binary, err.strerror or err)) from None
            stdout = result.stdout
            if stdout is None:  # a real run wrote to the file
                sink.seek(0)
                stdout = sink.read()
        stdout = stdout or ""
        stderr = result.stderr or ""
        if result.returncode != 0:
            match = re.search(r"\bHTTP (\d{3})\b", stderr)
            if match:
                # v2 put the error body on stdout and `HTTP <code> <reason>` on stderr.
                raise V2Error("http", int(match.group(1)), _one_line(stdout) or _one_line(stderr))
            raise V2Error("exit", None, _one_line(stderr) or _one_line(stdout) or "exit %d" % result.returncode)
        if not stdout.strip():
            return None
        try:
            body = json.loads(stdout)
        except ValueError:
            raise V2Error("bad_json", None, "%s returned non-JSON: %s" % (operation, _one_line(stdout, 120))) from None
        if isinstance(body, dict) and "data" in body:
            return body if envelope else body["data"]  # PR 8: paging needs the cursor beside the data
        return body

    def server_info(self):
        return self._call("server.info")

    def session_create(self, agent, title, directory, metadata, permissions=None):
        if not os.path.isabs(directory):
            raise ValueError("directory must be absolute: %r" % directory)
        data = {"agent": agent, "title": title, "location": {"directory": directory},
                "metadata": metadata}
        if permissions is not None:
            data["permissions"] = permissions
        return self._call("session.create", data=data)

    def session_get(self, session_id):
        return self._call("session.get", {"sessionID": session_id})

    def session_active(self):
        return self._call("session.active")

    def message_list(self, session_id, limit=None, order=None, type=None, cursor=None):
        if order is not None and order not in self.ORDERS:
            raise ValueError("order must be one of %s" % ", ".join(self.ORDERS))
        return self._call("session.message.list", {
            "sessionID": session_id, "limit": limit, "order": order, "type": type, "cursor": cursor})

    def message_page(self, session_id, limit=None, type=None, cursor=None):
        """PR 8: one page of `session.message.list` with its cursor: (messages, cursor).

        `cursor` is v2's `{"previous": .., "next": ..}` object, or None when the
        answer carries none. A cursor argument is v2's opaque token and fixes the
        order, so no `order` is taken here (v2: do not combine them).
        """
        if cursor is not None and (not isinstance(cursor, str) or not cursor or len(cursor) > CURSOR_LIMIT):
            raise ValueError("cursor must be v2's opaque token (a non-empty string), got %r" % (cursor,))
        body = self._call("session.message.list", {
            "sessionID": session_id, "limit": limit, "type": type, "cursor": cursor}, envelope=True)
        if isinstance(body, dict):
            found = body.get("cursor")
            return (body["data"] if isinstance(body.get("data"), list) else []), \
                (found if isinstance(found, dict) else None)
        return (body if isinstance(body, list) else []), None

    def message_pages(self, session_id, limit, type=None, max_pages=1):
        """PR 8: the pages of one listing, newest first, following `cursor.next`.

        UNVERIFIED: that `next` moves to older messages in a newest-first
        listing; the Lab's paging spike must show it. Yields (messages, more):
        `more` is True while v2 names a next cursor, False when it says there is
        none, None when the answer carries no cursor at all. The walk ends after
        a False or None, or after `max_pages`. A continuation that is empty or
        repeats a message already seen means the cursor does not walk the
        listing as assumed: that raises, and the caller holds.
        """
        cursor, seen = None, set()
        for number in range(max_pages):
            page, found = self.message_page(session_id, limit, type, cursor)
            ids = [m.get("id") for m in page if isinstance(m, dict)]
            if number and not page:
                # v2 names a `next` cursor even when the page it just gave held the whole listing (measured:
                # 104 messages at limit 200); following it answers an empty page. That is the end, not a
                # cursor that fails to walk older.
                yield [], False
                return
            if number and any(i in seen for i in ids):
                raise V2Error("bad_json", None, "session.message.list: the next page repeated "
                                                "a message; the cursor does not walk older as assumed")
            seen.update(ids)
            cursor = found.get("next") if found else None
            more = None if found is None else bool(cursor)
            yield page, more
            if not more:
                return

    def synthetic(self, session_id, text, metadata, resume, delivery, message_id, description=None):
        """`description` is the one human line the TUI shows for this message (`session.synthetic` takes it,
        measured in PR 13): at most DESCRIPTION_MAX characters, one line. Every message the switchboard writes
        carries one."""
        if description is not None and not valid_description(description):
            raise ValueError("description must be one non-empty line of at most %d characters: %r"
                             % (DESCRIPTION_MAX, description))
        if not isinstance(resume, bool):
            raise ValueError("resume must be true or false")
        if delivery not in self.DELIVERIES:
            raise ValueError("delivery must be one of %s" % ", ".join(self.DELIVERIES))
        if not isinstance(message_id, str) or not message_id.startswith("msg_"):
            raise ValueError("message id must start with msg_: %r" % message_id)
        body = {"id": message_id, "text": text, "metadata": metadata, "resume": resume, "delivery": delivery}
        if description is not None:
            body["description"] = description
        return self._call("session.synthetic", {"sessionID": session_id}, body)

    def interrupt(self, session_id, resume=False):
        """`session.interrupt`: abort the active execution (the Escape key). VERIFIED in a throwaway v2 2.0.24:
        the in-flight tool call is cut (state error, aborted), the answer is {"interrupted": true} (false when
        idle), and with `resume` false nothing runs after it: a steering input waiting stays in the inbox."""
        return self._call("session.interrupt", {"sessionID": session_id, "resume": "true" if resume else "false"})

    def prompt(self, session_id, text, metadata=None, delivery=None, resume=None):
        if delivery is not None and delivery not in self.DELIVERIES:
            raise ValueError("delivery must be one of %s" % ", ".join(self.DELIVERIES))
        data = {"text": text}
        for name, value in (("metadata", metadata), ("delivery", delivery), ("resume", resume)):
            if value is not None:
                data[name] = value
        return self._call("session.prompt", {"sessionID": session_id}, data)

    def inbox_list(self, session_id):
        return self._call("session.inbox.list", {"sessionID": session_id})

    def permission_list(self, session_id):
        """The session's pending permission requests (S2: `session.permission.list`
        works with the session id alone; `permission.request.list` needs a location)."""
        return self._call("session.permission.list", {"sessionID": session_id})

    def form_list(self, session_id):
        """The session's pending forms (questions): `session.form.list`, an array of {id, sessionID, title,
        fields: [{key, type, title, ...}]} (VERIFIED in a throwaway v2 2.0.24, PR 18)."""
        return self._call("session.form.list", {"sessionID": session_id})

    def permission_reply(self, session_id, request_id, decision, message=None):
        """PR 18: answer a pending permission request: `decision` is `once`, `always` or `reject`, `message` a
        reason (VERIFIED in a throwaway v2 2.0.24: POST /api/session/{sessionID}/permission/{requestID}/reply,
        body {"decision", "message"}; an empty answer; 404 PermissionNotFoundError once answered)."""
        if decision not in ("once", "always", "reject"):
            raise ValueError("decision must be once, always or reject")
        data = {"decision": decision}
        if message:
            data["message"] = message
        return self._call("session.permission.reply", {"sessionID": session_id, "requestID": request_id}, data)

    def form_reply(self, session_id, form_id, answer):
        """PR 18: answer a pending form (a question): `answer` maps each field's key to its value (VERIFIED in a
        throwaway v2 2.0.24: POST /api/session/{sessionID}/form/{formID}/reply, body {"answer": {key: value}};
        an empty answer; the form then reads `state.status` answered)."""
        return self._call("session.form.reply", {"sessionID": session_id, "formID": form_id}, {"answer": dict(answer)})

    def inbox_update(self, session_id, inbox_id, delivery):
        if delivery not in self.DELIVERIES:
            raise ValueError("delivery must be one of %s" % ", ".join(self.DELIVERIES))
        return self._call("session.inbox.update", {"sessionID": session_id, "inboxID": inbox_id},
                          {"delivery": delivery})


# ------------------------------------------------------------------- herdr

class HerdrError(Exception):
    """A herdr call that did not return usable JSON."""

    def __init__(self, reason, detail=None):
        self.reason = reason
        self.detail = detail
        super().__init__("%s: %s" % (reason, detail) if detail else reason)


def herdr_socket_path(environ=None):
    """Where herdr listens: $HERDR_SOCKET_PATH, else herdr.sock in its config directory."""
    environ = os.environ if environ is None else environ
    if environ.get("HERDR_SOCKET_PATH"):
        return environ["HERDR_SOCKET_PATH"]
    base = environ.get("XDG_CONFIG_HOME")
    root = Path(base) if base and os.path.isabs(base) else Path.home() / ".config"
    return str(root / "herdr" / "herdr.sock")


def unix_socket_call(path, method, params, timeout=HERDR_CALL_TIMEOUT):
    """One request to herdr's socket API: a JSON line out, a JSON line back."""
    request = json.dumps({"id": "%s:%s" % (PROG, method), "method": method, "params": params},
                         separators=(",", ":")) + "\n"
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as conn:
            conn.settimeout(timeout)
            conn.connect(path)
            conn.sendall(request.encode("utf-8"))
            reply = b""
            while not reply.endswith(b"\n"):
                chunk = conn.recv(65536)
                if not chunk:
                    break
                reply += chunk
    except socket.timeout:
        raise HerdrError("timeout", "herdr's socket did not answer within %ss" % timeout) from None
    except OSError as err:
        raise HerdrError("unavailable", "cannot reach herdr's socket %s: %s" % (path, err.strerror or err)) from None
    try:
        return json.loads(reply.decode("utf-8"))
    except ValueError:
        raise HerdrError("bad_json", "herdr's socket returned non-JSON: %s" % _one_line(reply.decode("utf-8", "replace"), 120)) from None


TOKEN_NAME = re.compile(r"^[A-Za-z0-9_-]{1,32}$")
TOKEN_VALUE_MAX = 80
TITLE_MAX, BODY_MAX = 80, 240  # herdr's own caps on a toast


class HerdrClient:
    """Reads agents and panes, sets a badge, shows a toast, opens a tab that
    runs a program directly, and closes a pane `launch` itself opened.

    herdr is never a delivery channel (docs/switchboard.md, the herdr table's
    "never" row). This class deliberately has no method that types into a pane
    or moves focus, and no general way to run an arbitrary herdr command. Its
    one socket method, `layout.apply`, execs a program with argv in a new pane:
    there is no shell, so nothing is typed, and no focus key is ever sent.
    """

    SOURCE = PROG
    SOCKET_METHODS = ("layout.apply",)

    def __init__(self, binary, runner=subprocess.run, timeout=HERDR_CALL_TIMEOUT, socket_call=None,
                 socket_path=None):
        self.binary = binary
        self.runner = runner
        self.timeout = timeout
        self.socket_call = socket_call or unix_socket_call
        self.socket_path = socket_path

    def _call(self, *args):
        argv = [self.binary, *args]
        try:
            result = self.runner(argv, capture_output=True, text=True, timeout=self.timeout,
                                 stdin=subprocess.DEVNULL)
        except subprocess.TimeoutExpired:
            raise HerdrError("timeout", "herdr did not answer within %ss" % self.timeout) from None
        except OSError as err:
            raise HerdrError("unavailable", "cannot run %s: %s" % (self.binary, err.strerror or err)) from None
        if result.returncode != 0:
            raise HerdrError("exit", _one_line(result.stderr) or _one_line(result.stdout)
                             or "exit %d" % result.returncode)
        if not (result.stdout or "").strip():
            return None
        try:
            return json.loads(result.stdout)
        except ValueError:
            raise HerdrError("bad_json", "herdr returned non-JSON: %s" % _one_line(result.stdout, 120)) from None

    def _socket(self, method, params):
        if method not in self.SOCKET_METHODS:
            raise ValueError("herdr socket method not allowed: %r" % method)
        reply = self.socket_call(self.socket_path or herdr_socket_path(), method, params, self.timeout)
        if isinstance(reply, dict) and reply.get("error"):
            raise HerdrError("exit", _one_line(json.dumps(reply["error"], sort_keys=True)))
        return reply

    @staticmethod
    def _result(body, field, kind):
        value = (body or {}).get("result", {}).get(field) if isinstance(body, dict) else None
        if not isinstance(value, kind):
            raise HerdrError("bad_shape", "expected result.%s in herdr's reply" % field)
        return value

    def agent_list(self):
        return self._result(self._call("agent", "list"), "agents", list)

    def agent_get(self, target):
        return self._result(self._call("agent", "get", target), "agent", dict)

    def pane_process_info(self, pane):
        """The foreground processes of a pane: [{"cmdline": ..., "name": ...}, ...]."""
        info = self._result(self._call("pane", "process-info", "--pane", pane), "process_info", dict)
        processes = info.get("foreground_processes")
        if not isinstance(processes, list):
            raise HerdrError("bad_shape", "expected foreground_processes in herdr's reply")
        return [p for p in processes if isinstance(p, dict)]

    def pane_report_metadata_token(self, pane, name, value, ttl_ms=None):
        if not TOKEN_NAME.match(str(name)):
            raise ValueError("token name must match %s: %r" % (TOKEN_NAME.pattern, name))
        value = str(value)
        if not value.strip() or len(value) > TOKEN_VALUE_MAX:
            raise ValueError("token value must be 1-%d characters" % TOKEN_VALUE_MAX)
        args = ["pane", "report-metadata", pane, "--source", self.SOURCE, "--token", "%s=%s" % (name, value)]
        if ttl_ms is not None:
            args += ["--ttl-ms", str(int(ttl_ms))]
        return self._call(*args)

    def pane_clear_token(self, pane, name):
        if not TOKEN_NAME.match(str(name)):
            raise ValueError("token name must match %s: %r" % (TOKEN_NAME.pattern, name))
        return self._call("pane", "report-metadata", pane, "--source", self.SOURCE, "--clear-token", name)

    def notification_show(self, title, body=None):
        """Show a toast. Returns {"shown": bool, "reason": ...}: herdr answers
        even when it shows nothing (rate_limited, busy, no_foreground_client, disabled)."""
        args = ["notification", "show", str(title)[:TITLE_MAX]]
        if body:
            args += ["--body", str(body)[:BODY_MAX]]
        body = self._call(*args)
        shown = self._result(body, "shown", bool)
        reason = body["result"].get("reason")
        return {"shown": shown, "reason": reason if isinstance(reason, str) else None}

    def pane_close(self, pane):
        return self._call("pane", "close", pane)

    def workspace_list(self):
        """PR 16: every workspace, as herdr lists them: [{"workspace_id", "label", ...}]."""
        return self._result(self._call("workspace", "list"), "workspaces", list)

    def workspace_create(self, cwd, label, focus=True):
        """PR 16: a new workspace, focused: `bootstrap` opens the Chief of Staff where the person is looking.
        The only call here that can take focus, and only a person's own command makes it (`focus=False` asks
        for `--no-focus`, for scripts and trials). Returns {"workspace_id", "root_pane"}: the empty shell pane
        herdr opens with it (None when it names none)."""
        body = self._call("workspace", "create", "--cwd", cwd, "--label", label, "--focus" if focus else "--no-focus")
        workspace = self._result(body, "workspace", dict)
        if not isinstance(workspace.get("workspace_id"), str):
            raise HerdrError("bad_shape", "expected result.workspace.workspace_id in herdr's reply")
        root = (body["result"].get("root_pane") or {}).get("pane_id")
        return {"workspace_id": workspace["workspace_id"], "root_pane": root if isinstance(root, str) else None}

    def open_tab_running(self, workspace, label, cwd, argv, env):
        """A new tab in `workspace` whose one pane execs `argv` directly. Never
        types, never takes focus. Returns {"tab_id", "pane_id"}."""
        reply = self._socket("layout.apply", {
            "workspace_id": workspace, "tab_label": label,
            "root": {"type": "pane", "label": label, "cwd": cwd, "command": list(argv), "env": dict(env)}})
        layout = (reply or {}).get("result", {}).get("layout") if isinstance(reply, dict) else None
        root = layout.get("root") if isinstance(layout, dict) else None
        pane, tab = (root or {}).get("pane_id"), layout.get("tab_id") if isinstance(layout, dict) else None
        if not isinstance(pane, str) or not isinstance(tab, str):
            raise HerdrError("bad_shape", "expected layout.tab_id and layout.root.pane_id in herdr's reply")
        return {"tab_id": tab, "pane_id": pane}


# ------------------------------------------------------------------ the facts

class FactError(ValueError):
    """A fact that cannot be used: a missing field, or a value of the wrong type."""


class Fact:
    """Something one fleet agent should be told.

    `key` names the source fact, such as `send:<from>:<id>` or `lab.fact:<id>`.
    It is what makes delivery idempotent: every message lists the keys it
    covers, and a key found in the recipient's transcript or inbox is never
    delivered again. `created` is epoch seconds. `batch` false skips the batch
    window, as `send` does.
    """

    FIELDS = ("key", "recipient", "kind", "summary", "created", "issue", "batch", "sender", "rider", "repo",
              "orders")

    def __init__(self, key, recipient, kind, summary, created, issue=None, batch=True, sender=None, rider=False,
                 repo=None, orders=False):
        for name, value in (("key", key), ("recipient", recipient), ("kind", kind)):
            if not isinstance(value, str) or not value.strip():
                raise FactError("fact %s must be a non-empty string, got %r" % (name, value))
        if not isinstance(summary, str):
            raise FactError("fact summary must be a string, got %r" % (summary,))
        if not _is_number(created):
            raise FactError("fact created must be epoch seconds, got %r" % (created,))
        if issue is not None and not (isinstance(issue, int) and not isinstance(issue, bool) and issue >= 1):
            raise FactError("fact issue must be an issue number, got %r" % (issue,))
        if not isinstance(batch, bool):
            raise FactError("fact batch must be true or false, got %r" % (batch,))
        if sender is not None and not isinstance(sender, str):
            raise FactError("fact from must be a string, got %r" % (sender,))
        if not isinstance(rider, bool):
            raise FactError("fact rider must be true or false, got %r" % (rider,))
        if not isinstance(orders, bool):
            raise FactError("fact orders must be true or false, got %r" % (orders,))
        self.key, self.recipient, self.kind, self.summary = key, recipient, kind, summary
        self.created, self.issue, self.batch, self.sender = float(created), issue, batch, sender
        self.rider = rider  # PR 13: carried in the next message, never the reason for one
        if repo is not None and not (isinstance(repo, str) and REPO_RE.match(repo)):
            raise FactError("fact repo must be OWNER/REPO, got %r" % (repo,))
        self.repo = repo  # PR 15: the repo `issue` is in; None means the recipient's own
        self.orders = orders  # PR 17: the charter's standing orders: a note on its own, at once, never a wake

    @classmethod
    def from_json(cls, obj):
        if not isinstance(obj, dict):
            raise FactError("a fact must be a JSON object")
        unknown = sorted(set(obj) - {"key", "recipient", "kind", "summary", "created", "issue", "batch", "from", "rider",
                                  "repo", "orders"})
        if unknown:
            raise FactError("fact has unknown field(s): %s" % ", ".join(unknown))
        missing = [name for name in ("key", "recipient", "kind", "summary", "created") if name not in obj]
        if missing:
            raise FactError("fact is missing: %s" % ", ".join(missing))
        return cls(obj["key"], obj["recipient"], obj["kind"], obj["summary"], obj["created"],
                   obj.get("issue"), obj.get("batch", True), obj.get("from"), obj.get("rider", False),
                   obj.get("repo"), obj.get("orders", False))

    def to_json(self):
        body = {"key": self.key, "recipient": self.recipient, "kind": self.kind, "summary": self.summary,
                "created": self.created, "issue": self.issue, "batch": self.batch, "from": self.sender,
                "rider": self.rider, "orders": self.orders}
        if self.repo is not None:  # one repo: the shape is what it always was
            body["repo"] = self.repo
        return body

    def __repr__(self):
        return "Fact(%r -> %r)" % (self.key, self.recipient)


LAB_FACTS = "lab-facts.jsonl"


def lab_fact_source(state_dir):
    """The Lab's test seam: facts a scenario runner appends to $STATE/lab-facts.jsonl.

    One JSON object per line, in Fact.to_json's shape. Read only when
    FLEET_SWITCHBOARD_LAB=1; anywhere else it yields nothing, so a stray file
    can never cause a delivery. A bad line fails the whole source, loudly: in
    the Lab a typo must not quietly drop a fact.
    """
    path = Path(state_dir) / LAB_FACTS

    def lab_facts():
        if os.environ.get(LAB_ENV) != "1":
            return []
        try:
            text = path.read_text()
        except FileNotFoundError:
            return []
        facts = []
        for number, line in enumerate(text.splitlines(), 1):
            if not line.strip():
                continue
            try:
                facts.append(Fact.from_json(json.loads(line)))
            except ValueError as err:
                raise FactError("%s:%d: %s" % (path, number, err)) from None
        return facts

    return lab_facts


def fact_sources(state_dir):
    """Every fact source, in order: callables that each return a list of Facts.

    The one registration point. Worker facts (PR 4), GitHub facts (PR 5) and
    reminders join this list. `send` is not a source: it delivers directly, by
    the same rule, and stores nothing.
    """
    return [lab_fact_source(state_dir), WorkerFacts(), ReminderFacts(state_dir), ReportRiderFacts(state_dir),
            ForegroundFacts(), OrdersFacts()]


# --------------------------------------------------------- observing the fleet

# herdr's agent_status -> the switchboard's. `done` is idle that you have not
# looked at yet; anything not listed is unknown, and unknown holds.
STATUS = {"working": "working", "idle": "idle", "done": "idle", "blocked": "blocked"}

READ_LIMIT = 200    # transcript messages per read, newest first
SINCE_SLACK = 60    # seconds read back beyond the oldest fact, for clock skew
MESSAGE_CAP = 4000  # characters in one delivered message
HELD_TOAST_AFTER = 15 * 60  # seconds an item is held before you get a toast


def agent_session(entry):
    """The v2 session id a herdr agent entry names, or None.

    herdr 0.9 reports `agent_session` as an object, `{"kind": "id", "value":
    "ses_..."}` (S6); a plain string is accepted too.
    """
    value = entry.get("agent_session") if isinstance(entry, dict) else None
    if isinstance(value, dict):
        value = value.get("value") if value.get("kind", "id") == "id" else None
    return value if isinstance(value, str) and value else None


def runs_program(cmdline, executable):
    """True when a process command line is `executable`, alone or with arguments.

    The program and the configured path are compared by realpath, both sides: a pane runs the resolved
    path of a binary the config names by its stable link (a package upgrade moves the target, not the link).
    """
    if not isinstance(cmdline, str) or not executable:
        return False
    if cmdline == executable or cmdline.startswith(executable + " "):
        return True
    if not os.path.isabs(cmdline) or not os.path.isabs(executable):
        return False
    wanted = os.path.realpath(executable)
    ends = [at for at, char in enumerate(cmdline) if char == " "] + [len(cmdline)]
    return any(os.path.realpath(cmdline[:end]) == wanted for end in ends[:16])


def _seconds(value):
    """v2 time (epoch milliseconds, or seconds) -> epoch seconds; None if absent."""
    if not _is_number(value):
        return None
    return value / 1000.0 if value > 1e11 else float(value)


def _fleet_meta(record):
    """`metadata.fleet` of a v2 record: a message has `metadata` at the top;
    an inbox item (session.inbox.list, 2.0.22) has it under `payload`."""
    if not isinstance(record, dict):
        return None
    meta = record.get("metadata")
    if meta is None and isinstance(record.get("payload"), dict):
        meta = record["payload"].get("metadata")
    fleet = meta.get("fleet") if isinstance(meta, dict) else None
    return fleet if isinstance(fleet, dict) else None


def _fleet_keys(record):
    keys = (_fleet_meta(record) or {}).get("keys")
    return [key for key in keys if isinstance(key, str)] if isinstance(keys, list) else []


def _is_orders_note(record):
    """PR 17: a record whose every key is a standing-orders key (`orders:...`)."""
    keys = _fleet_keys(record)
    return bool(keys) and all(key.startswith("orders:") for key in keys)


def _created(record):
    times = record.get("time") if isinstance(record, dict) else None
    return _seconds(times.get("created")) if isinstance(times, dict) else None


def iso(epoch):
    return decision_core.iso(epoch)


class Observation:
    """One fleet agent as observed now: herdr's status, v2's session.

    `last_human_prompt` is the time of your newest prompt within the
    engagement window, or None when there is none in it. `problem` is set
    when something needed for a decision could not be read; it holds.
    """

    def __init__(self, name, session_id, pane, status, fleet, idle_at=None, outcome=None,
                 last_human_prompt=None, problem=None):
        self.name, self.session_id, self.pane, self.status = name, session_id, pane, status
        self.fleet, self.idle_at, self.outcome = fleet, idle_at, outcome
        self.last_human_prompt, self.problem = last_human_prompt, problem
        self.created = None  # PR 17: when v2 says the session began (epoch seconds)
        self.wrong_program = False  # the pane runs something other than the configured v2
        self.conflict = []  # other sessions that claim the same name

    def engaged(self, now, window):
        """You prompted this agent within `window` seconds. Off under `no-engagement-gate`."""
        if fault("no-engagement-gate"):
            return False
        return self.last_human_prompt is not None and now - self.last_human_prompt < window

    def to_json(self):
        return {"name": self.name, "session": self.session_id, "pane": self.pane, "status": self.status,
                "fleet": self.fleet, "idle_at": iso(self.idle_at), "outcome": self.outcome,
                "last_human_prompt": iso(self.last_human_prompt), "problem": self.problem,
                "wrong_program": self.wrong_program, "conflict": self.conflict}


class Discovery:
    """Every fleet agent found in one look, by name, and what got in the way."""

    def __init__(self):
        self.agents = {}
        self.problems = []
        self.entries = []  # herdr's agent list as read, so render can compare tokens

    def add(self, observation):
        known = self.agents.get(observation.name)
        if known is None:
            self.agents[observation.name] = observation
        elif known.session_id != observation.session_id and observation.session_id not in known.conflict:
            known.conflict.append(observation.session_id)

    def missing(self, name):
        """Why `name` has no observation: not running, or something unreadable."""
        if self.problems:
            return "%s not found; %s" % (name, "; ".join(self.problems))
        return "%s not found: no herdr pane shows a v2 session named %s" % (name, name)


# ------------------------------------------------------------ the decision

class InterruptRefused(Exception):
    """`send --interrupt` from anyone but the recipient's boss."""


class Plan:
    """What the delivery rule says for one recipient now.

    action: "wait" (batching), "hold" (reason says why), "note" or "wake".
    """

    def __init__(self, recipient, action, reason, pending, observation=None, ready_at=None):
        self.recipient, self.action, self.reason = recipient, action, reason
        self.pending, self.observation, self.ready_at = pending, observation, ready_at

    def to_json(self):
        return {"recipient": self.recipient, "action": self.action, "reason": self.reason,
                "ready_at": iso(self.ready_at), "pending": [fact.to_json() for fact in self.pending]}


def hold_reason(observation, missing=None):
    """Why nothing may be written to this agent now, or None."""
    if observation is None:
        return missing or "not found"
    if observation.conflict:
        return "%s is claimed by more than one session (%s); fix the fleet metadata" % (
            observation.name, ", ".join([observation.session_id] + observation.conflict))
    if observation.problem:
        return observation.problem
    if observation.status == "blocked":
        return "%s is blocked on a permission request or a question" % observation.name
    if observation.status not in ("idle", "working"):
        return "%s has status %s in herdr" % (observation.name, observation.status)
    return None


def decide(recipient, pending, observation, now, batch_seconds, engaged_seconds, missing=None):
    """The delivery rule for one recipient's pending facts. Reads nothing; writes nothing.

    Batch: wait until the oldest pending fact is `batch_seconds` old, unless a
    pending fact skips batching (`send`), or under `no-batch`. Then hold if
    the agent is gone, blocked, unknown or unreadable; else a note if you are
    engaged with it, else a wake.
    """
    pending = sorted(pending, key=lambda fact: (fact.created, fact.key))
    # PR 17: standing orders go first and alone, at once, as a note (a wake only under `orders-wake`)
    standing = [fact for fact in pending if fact.orders]
    if standing:
        reason = hold_reason(observation, missing)
        if not reason:
            return Plan(recipient, "wake" if fault("orders-wake") else "note",
                        "standing orders are noted at once, and never wake anyone", standing, observation)
        pending = [fact for fact in pending if not fact.orders]
        if not pending:
            return Plan(recipient, "hold", reason, standing, observation)
    # PR 13: riders are carried, never the reason for a message. Only the others choose the action
    # and start the batch clock; when there is any other, every rider goes with it.
    chosen = pending if fault("no-rider") else [fact for fact in pending if not fact.rider]
    if not chosen:
        return None
    if not fault("no-batch") and all(fact.batch for fact in chosen):
        ready_at = chosen[0].created + batch_seconds
        if now < ready_at:
            return Plan(recipient, "wait", "batching until %s" % iso(ready_at), pending, observation, ready_at)
    reason = hold_reason(observation, missing)
    if reason:
        return Plan(recipient, "hold", reason, pending, observation)
    if observation.engaged(now, engaged_seconds):
        return Plan(recipient, "note", "you prompted %s at %s" % (recipient, iso(observation.last_human_prompt)),
                    pending, observation)
    return Plan(recipient, "wake", "no prompt from you in the engagement window", pending, observation)


def steers_into_turn(config, observation, carried):
    """A wake to an agent that is working goes in as `steer` (with `resume`, so one that outlives its turn starts
    the next at once): the running turn takes it at its next safe point instead of after the turn. Only a
    message that carries a `send` from the agent's own boss; `send_to_working` "queue" turns it off. Measured in
    a throwaway v2 2.0.24: a steer lands after the in-flight tool call, before the next model request."""
    return (config.get("send_to_working", "steer") == "steer" and observation.status == "working"
            and any(fact.kind == "send" and fact.sender and fact.sender == _boss_of(observation) for fact in carried))


def compose(recipient, facts, cap=MESSAGE_CAP, section=None, repos=None):
    """One message for `facts`, oldest first. Returns (text, the facts it carries).

    The first line names the count and the first item; each item follows in
    full. Items that do not fit under `cap` stay pending: the message ends with
    how many, and they go in the next message. A single item longer than the
    cap is cut, and says so. With `section` (PR 6, see sectioned_lines) every
    item that names an issue sits under its ask's Intent lines.
    """
    facts = sorted(facts, key=lambda fact: (fact.created, fact.key))
    if not facts:
        raise ValueError("nothing to compose")
    if facts[0].orders:  # PR 17: the orders note, whole: up to twenty orders of 300 characters
        return orders_note(recipient, facts[0], repos), facts[:1]

    def item(fact):
        where = " (issue %s)" % issue_tag(fact.repo, fact.issue, repos) if fact.issue else ""
        body = fact.summary.strip().replace("\n", "\n  ")
        return "- %s from %s%s: %s" % (fact.kind, fact.sender or "the fleet", where, body)

    def render(count):
        lead = next((fact for fact in facts if not fact.rider), facts[0])
        head = "[switchboard] %d for %s: %s" % (count, recipient, _one_line(lead.summary, 200))
        lines = [head] + (sectioned_lines(facts[:count], section, item) if section
                          else [item(fact) for fact in facts[:count]])
        rest = len(facts) - count
        if rest:
            lines.append("\u2026 and %d more: run fleet-switchboard pending %s" % (rest, recipient))
        return "\n".join(lines)

    for count in range(len(facts), 0, -1):
        text = render(count)
        if len(text) <= cap:
            return text, facts[:count]
    marker = "\n[cut at %d characters]" % cap
    return text[:cap - len(marker)] + marker, facts[:1]


ORDERS_CLOSING = ("These are the owner's standing instructions for this charter. Act on them without asking "
                  "again, within their words. They cover nothing they do not name.")
COS_ORDERS_CLOSING = ("These are the owner's standing orders to you. Answer for the owner only within their words; "
                      "anything they do not name goes to the owner.")


def orders_note(recipient, fact, repos=None):
    """The standing-orders note: each order on its own line, then the closing line. Never cut. PR 18: the Chief of
    Staff's own orders (key `orders:cos:...`) are the file's text as the owner wrote it."""
    if fact.key.startswith("%s:cos:" % ORDERS_KIND):
        return "\n".join(["[switchboard] standing orders for %s (the owner's, to you):" % recipient,
                          fact.summary.strip(), COS_ORDERS_CLOSING])
    lines = ["[switchboard] standing orders for %s (charter %s):" % (recipient, issue_tag(fact.repo, fact.issue, repos))]
    lines.extend("- %s" % order for order in fact.summary.splitlines() if order.strip())
    lines.append(ORDERS_CLOSING)
    return "\n".join(lines)


def is_withdrawal(summary):
    """A `withdrawn` report rider never ages out: only a message carrying it (or its worker going) drops it."""
    return (summary or "").startswith("withdrawn: ")


def collapse_riders(facts, now, max_age):
    """PR 13: riders cut to what is still worth carrying. A rider older than `max_age` seconds is
    dropped, and only the newest `worker.idle` of each sender stays. Facts that are not riders pass."""
    newest = {}
    for fact in facts:
        if fact.rider and fact.kind == WORKER_IDLE:
            known = newest.get(fact.sender)
            if known is None or (fact.created, fact.key) > (known.created, known.key):
                newest[fact.sender] = fact
    kept = []
    for fact in facts:
        if not fact.rider:
            kept.append(fact)
        elif now - fact.created > max_age and not is_withdrawal(fact.summary):
            continue
        elif fact.kind == WORKER_IDLE and newest.get(fact.sender) is not fact:
            continue
        else:
            kept.append(fact)
    return kept


DESCRIBED_AS = {"send": "message", "report": "report", "worker.idle": "finished", "worker.stopped": "stopped",
                "worker.blocked": "blocked", "nudge": "nudge"}


def _line_of(text, limit):
    """`text` as one line of at most `limit` characters, with anything shaped like a bearer
    credential or a provider key taken out."""
    return decision_core.line_of(text, limit)


def describe_items(recipient, facts, repos=None):
    """The one human line v2's TUI shows for a message (PR 13): `switchboard: <sender> <what> on #<issue>:
    <first 100 characters>` for one item, `switchboard: <n> items for <recipient>: <first item, 80 characters>`
    for several. At most DESCRIPTION_MAX characters, never a newline."""
    facts = sorted(facts, key=lambda fact: (fact.created, fact.key))
    if all(fact.orders for fact in facts):
        return "switchboard: standing orders for %s" % recipient
    lead = next((fact for fact in facts if not fact.rider), facts[0])
    if len(facts) == 1:
        where = " on %s" % issue_tag(lead.repo, lead.issue, repos) if lead.issue else ""
        line = "switchboard: %s %s%s: %s" % (lead.sender or "the fleet", DESCRIBED_AS.get(lead.kind, lead.kind),
                                             where, _line_of(lead.summary, 100))
    else:
        line = "switchboard: %d items for %s: %s" % (len(facts), recipient, _line_of(lead.summary, 80))
    return _one_line(line, DESCRIPTION_MAX)


# ---------------------------------------------------------------- the engine

class LockError(Exception):
    """Another `run` holds the single-instance lock."""


@contextmanager
def single_instance(state_dir):
    """Hold $STATE/run.lock for the life of the block, or raise LockError at once."""
    path = Path(state_dir) / "run.lock"
    fd = adopt_inherited_lock(path)
    if fd is None:
        fd = os.open(str(path), os.O_RDWR | os.O_CREAT, 0o600)
    _HELD_LOCK["fd"] = fd
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            holder = os.read(fd, 32).decode("ascii", "replace").strip() or "unknown"
            raise LockError("another %s run holds %s (pid %s)" % (PROG, path, holder)) from None
        os.ftruncate(fd, 0)
        os.lseek(fd, 0, os.SEEK_SET)  # an adopted descriptor is not at the start
        os.write(fd, ("%d\n" % os.getpid()).encode("ascii"))
        yield path
    finally:
        _HELD_LOCK["fd"] = None
        os.close(fd)  # closing the descriptor releases the lock


LOCK_FD_ENV = "FLEET_SWITCHBOARD_LOCK_FD"  # set across a re-exec: the descriptor that still holds run.lock
_HELD_LOCK = {"fd": None}


def adopt_inherited_lock(path):
    """The descriptor a daemon passed across `exec` to itself, when it is the lock file of `path`; else None.
    The flock belongs to the open file description, so it was never released: there was no gap."""
    raw = os.environ.pop(LOCK_FD_ENV, None)
    try:
        fd = int(raw) if raw else None
        if fd is None:
            return None
        held, here = os.fstat(fd), os.stat(str(path))
        if (held.st_dev, held.st_ino) != (here.st_dev, here.st_ino):
            os.close(fd)
            return None
        os.set_inheritable(fd, False)
        return fd
    except (OSError, ValueError):
        return None


class KeyTimes(set):
    """The keys `delivered_keys` found, a plain set, with `at[key]`: when the message that carries it was
    created (the oldest, when several do; None when v2 gave no time). PR 13 reads when a report arrived."""

    def __init__(self):
        super().__init__()
        self.at = {}

    def add_all(self, keys, created):
        for key in keys:
            self.add(key)
            known = self.at.get(key)
            if key not in self.at or (created is not None and (known is None or created < known)):
                self.at[key] = created


class Switchboard:
    """observe -> derive -> decide -> deliver, for every fleet agent.

    Holds no delivery state. `now` is injected so tests run a simulated clock.
    `audit` None makes it read-only: `pending` and `status` use it that way,
    and any write then raises instead of happening unaudited.
    """

    def __init__(self, config, v2, herdr, audit, sources=(), now=time.time, actor="daemon", intents=None,
                 state_dir=None):
        self.config, self.v2, self.herdr, self.audit = config, v2, herdr, audit
        self.state_dir = Path(state_dir) if state_dir is not None else None  # PR 14: where decisions.json goes
        self.hub = None  # the GitHub hub, when this process has one (PR 14: its awaiting-user issues)
        self.decision_seeds = {}        # the last derivation's display id -> source seed (memory only; the sync engine's keys)
        self.decision_seen = {}         # PR 14: (session, request id) -> when first seen, for a request with no time of its own
        self.decisions_generation = 0   # PR 14: the generation last written to decisions.json by this process
        self.request_keys = None        # PR 18: "<session>:<request id>" of every request pending at the last derivation
        self.gh_runner = None           # PR notices: the runner for `gh pr view` (None: subprocess.run)
        self.notice_facts = {}          # PR notices: "owner/repo#N" -> {at, facts, stale, error}; memory only
        self.notice_effects = {"drop": set(), "unreadable": {}}  # what the last derivation asks the daemon to record
        self.synthetic_cache = {}       # PR 14: session -> (newest synthetic id, since, lines), a cache for the decisions
        self.intents = intents  # an IntentReader (PR 6), or None when no ask repo is configured
        self.sources, self.now, self.actor = list(sources), now, actor
        self.batch_seconds = config["batch_seconds"]
        self.engaged_seconds = config["engaged_minutes"] * 60
        self.executable = config["opencode_executable"] or config["opencode"]
        self.toasted = {}  # agent -> the reason last toasted for it, so a steady reason toasts once
        self.pass_toasts = {}  # agent -> (reason, title, body) the pass itself found worth a toast (PR 4)
        self._last = {}  # (event, subject) -> detail last audited, so a steady hold is audited once
        self.discovery = None  # the newest discover(), for sources that read the fleet (PR 4)
        self.judge_warm, self._warm_due = None, 0.0  # the daemon's policy-context warmer, if the judge is on
        self._not_fleet = {}  # session id -> until when it is believed to be no fleet agent (in memory only)
        for source in self.sources:
            bind = getattr(source, "bind", None)
            if bind:
                bind(self)
        self.jev, self._classified = build_jev(config), set()  # PR 7: the decision model; messages classified

    # -- the audit

    def _external(self, event, subject, detail):
        if self.audit is None:
            raise RuntimeError("read-only switchboard asked to write: %s %s" % (event, subject))
        return self.audit.external(self.actor, event, subject, detail)

    def _note(self, event, subject, detail):
        """Audit a non-write event once per change, not once per pass."""
        if self.audit is None or self._last.get((event, subject)) == detail:
            return
        self._last[(event, subject)] = detail
        self.audit.append(self.actor, event, subject, detail)

    # -- observe

    def _messages(self, session_id):
        page = self.v2.message_list(session_id, limit=READ_LIMIT)  # newest first (S5)
        return page if isinstance(page, list) else []

    def last_human_prompt(self, session_id, now, inbox=False):
        """Your newest prompt in the engagement window: type `user` without `metadata.fleet`.
        `inbox` (a Chief of Staff, PR 8) also counts one still waiting in v2's inbox."""
        start = now - self.engaged_seconds
        if inbox:
            waiting = inbox_human_prompts(self, session_id)
            if waiting and (_created(waiting[0]) or 0) >= start:
                return _created(waiting[0])
        for message in self._messages(session_id):
            created = _created(message)
            if created is not None and created < start:
                break  # older than the window: stop reading
            if message.get("type") == "user" and _fleet_meta(message) is None:
                return created
        return None

    NOT_FLEET_SECONDS = 120  # how long "this session is no fleet agent" is believed

    def _observe_entry(self, entry, now):
        """An Observation for one herdr agent, or None when it is not a fleet agent."""
        session_id = agent_session(entry)
        if session_id is None:
            return None
        if self._not_fleet.get(session_id, 0) > now:
            return None  # asked recently and it was not one: herdr lists every pane of every workspace
        try:
            info = self.v2.session_get(session_id) or {}
        except V2Error as err:
            if err.reason == "http" and err.status == 404:
                self._not_fleet[session_id] = now + self.NOT_FLEET_SECONDS  # a pane of someone else's OpenCode
            raise
        fleet = _fleet_meta(info)
        if not fleet or not isinstance(fleet.get("name"), str) or not fleet["name"]:
            self._not_fleet[session_id] = now + self.NOT_FLEET_SECONDS
            return None
        self._not_fleet.pop(session_id, None)
        times = info.get("time") if isinstance(info.get("time"), dict) else {}
        observation = Observation(fleet["name"], session_id, entry.get("pane_id"),
                                  STATUS.get(entry.get("agent_status"), "unknown"), fleet,
                                  _seconds(times.get("idle")), info.get("outcome"))
        observation.created = _seconds(times.get("created"))
        self.check_program(observation)
        if observation.problem:
            return observation
        try:
            observation.last_human_prompt = self.last_human_prompt(
                session_id, now, inbox=fleet.get("role") == "chief-of-staff")
        except V2Error as err:
            observation.problem = "cannot read %s's transcript: %s" % (observation.name, err)
        return observation

    def check_program(self, observation):
        """The restart hazard: after a herdr restart a pane may be a shell, and
        herdr resumes the agent by typing `opencode` into it, which can start
        another OpenCode. A pane whose process is not the configured v2 is held,
        and nothing is delivered to it. A pane that cannot be read is held too."""
        if not observation.pane:
            observation.problem = "%s has no herdr pane to check" % observation.name
            return
        try:
            programs = [p.get("cmdline") for p in self.herdr.pane_process_info(observation.pane)]
        except HerdrError as err:
            observation.problem = "cannot read what pane %s of %s runs: %s" % (observation.pane, observation.name, err)
            return
        if not any(runs_program(cmdline, self.executable) for cmdline in programs):
            observation.wrong_program = True
            observation.problem = "pane %s of %s runs a different opencode than the configured v2 (%s): %s" % (
                observation.pane, observation.name, self.executable,
                _one_line("; ".join(str(c) for c in programs), 120) or "nothing")

    def discover(self, now, entries=None):
        """Every fleet agent: a herdr agent whose v2 session carries `metadata.fleet.name`."""
        found = Discovery()
        self.discovery = found
        if entries is None:
            try:
                entries = self.herdr.agent_list()
            except HerdrError as err:
                found.problems.append("herdr unreachable: %s" % err)
                return found
        found.entries = [entry for entry in entries if isinstance(entry, dict)]
        for entry in entries:
            if not isinstance(entry, dict):
                continue
            try:
                observation = self._observe_entry(entry, now)
            except V2Error as err:
                if err.reason == "http" and err.status == 404:
                    continue  # the pane names a session v2 no longer has
                found.problems.append("v2 unreachable: %s" % err)
                continue
            if observation is not None:
                found.add(observation)
        return found

    def reobserve(self, previous, now):
        """The same agent, read again just before a write (invariant 4). (Observation, why-not)."""
        if not previous.pane:
            return None, "%s has no herdr pane to read again" % previous.name
        try:
            entry = self.herdr.agent_get(previous.pane)
        except HerdrError as err:
            return None, "pane %s of %s cannot be read: %s" % (previous.pane, previous.name, err)
        if agent_session(entry) != previous.session_id:
            return None, "pane %s no longer shows %s's session" % (previous.pane, previous.name)
        entry = dict(entry, pane_id=entry.get("pane_id") or previous.pane)
        try:
            fresh = self._observe_entry(entry, now)
        except V2Error as err:
            return None, "v2 unreachable: %s" % err
        if fresh is None or fresh.name != previous.name:
            return None, "session %s is no longer the fleet agent %s" % (previous.session_id, previous.name)
        fresh.conflict = list(previous.conflict)
        return fresh, None

    def _acknowledge(self, keys):
        """Tell the fact sources that hold items in memory (GitHub, PR 5) which keys are delivered."""
        for source in self.sources:
            acknowledge = getattr(source, "acknowledge", None)
            if acknowledge is not None:
                acknowledge(keys)

    def charter_repo(self, observation):
        """PR 17: the repo an agent's charter is in: its own `repo`, else the intent repo."""
        repo = (observation.fleet or {}).get("repo")
        return repo if isinstance(repo, str) and repo else (self.intents.repo if self.intents is not None else None)

    def charter_orders(self, observation, charter):
        """PR 17: the standing orders of `charter` for one agent: the judge's warmed, cached read of the charter
        when it holds one (the same file the judge reads, so no new `gh` call), else the reader's own cached read."""
        reader = self.intents
        if reader is None:
            return []
        fleet = observation.fleet or {}
        repo = self.charter_repo(observation)
        ttl = (self.config.get("policy") or {}).get("cache_seconds") or 0
        if self.state_dir is not None and ttl:
            cache = BoundedFileCache(self.state_dir / POLICY_CONTEXT_FILE, self.now, ttl, 1)
            known = _valid_context(cache.get("ask:%s:%s:%s" % (repo, fleet.get("issue"), fleet.get("charter"))))
            if known is not None and known["charter"] == charter:
                return known["orders"]
        return reader.charter_orders(charter, repo)

    # -- derive

    def collect_facts(self):
        """Every fact from every source, first key wins for each recipient. A failing source is audited and skipped."""
        facts, seen, problems = [], set(), []
        for source in self.sources:
            name = getattr(source, "__name__", "source")
            try:
                found = source()
            except Exception as err:  # one bad source must not stop the others
                problems.append("%s: %s" % (name, _one_line(str(err))))
                self._note("source.error", name, {"error": _one_line(str(err))})
                continue
            for fact in found:
                # PR 17: first key wins per recipient (the orders key is the charter's, the same for every agent of it)
                if (fact.recipient, fact.key) not in seen:
                    seen.add((fact.recipient, fact.key))
                    facts.append(fact)
        return facts, problems

    def delivered_keys(self, session_id, since):
        """Keys already in the session: its messages since `since`, read newest
        first, plus its v2 inbox. Returns (keys, complete); not complete means
        the read ended before reaching `since`, so a key could be missed."""
        keys, complete = KeyTimes(), False
        # Only synthetic messages carry keys; asking for just those keeps the read
        # short on a chatty recipient, which a 24 h worker look-back needs (PR 4).
        # PR 8: more than READ_LIMIT of them are read page by page, up to MAX_READ_PAGES.
        for page, more in self.v2.message_pages(session_id, READ_LIMIT, "synthetic", MAX_READ_PAGES):
            reached = False
            for message in page:
                created = _created(message)
                if created is not None and created < since:
                    reached = True
                    break
                keys.add_all(_fleet_keys(message), created)
            if reached or len(page) < READ_LIMIT or more is False:
                complete = True
            if complete:
                break
        inbox = self.v2.inbox_list(session_id)
        for item in inbox if isinstance(inbox, list) else []:
            keys.add_all(_fleet_keys(item), _created(item))
        return keys, complete

    def plan(self, recipient, facts, discovery, now):
        """Pending = facts minus delivered keys, then the rule. None if nothing is pending."""
        return self.plan_with_riders(recipient, facts, discovery, now)[0]

    def plan_with_riders(self, recipient, facts, discovery, now):
        """(plan, riders): the plan `plan` returns, and the riders that wait for a message to ride in
        when the plan is None because only riders are pending (PR 13; `pending` and `status` show them)."""
        facts = collapse_riders(facts, now, self.config["rider_max_age_seconds"])
        if not facts:
            return None, []
        plan = self._plan_pending(recipient, facts, discovery, now)
        if plan is not None:
            return plan, []
        return None, self._undelivered(recipient, facts, discovery)

    def _undelivered(self, recipient, facts, discovery):
        """`facts` whose keys the recipient does not have yet; all of them when that cannot be read."""
        observation = discovery.agents.get(recipient)
        if observation is None or fault("no-dedupe"):
            return list(facts)
        try:
            since = min(fact.created - getattr(fact, "look_back", 0) for fact in facts) - SINCE_SLACK
            delivered, _ = self.delivered_keys(observation.session_id, since)
        except V2Error:
            return list(facts)
        return [fact for fact in facts if fact.key not in delivered]

    def _plan_pending(self, recipient, facts, discovery, now):
        observation = discovery.agents.get(recipient)
        if observation is None:
            return decide(recipient, facts, None, now, self.batch_seconds, self.engaged_seconds,
                          discovery.missing(recipient))
        pending = facts
        if not fault("no-dedupe"):
            since = min(fact.created - getattr(fact, "look_back", 0) for fact in facts) - SINCE_SLACK
            try:
                delivered, complete = self.delivered_keys(observation.session_id, since)
            except V2Error as err:
                return decide(recipient, facts, None, now, self.batch_seconds, self.engaged_seconds,
                              "cannot read what %s already has: %s" % (recipient, err))
            pending = [fact for fact in facts if fact.key not in delivered]
            self._acknowledge(delivered)
            if pending and not complete:
                return decide(recipient, pending, None, now, self.batch_seconds, self.engaged_seconds,
                              "the last %d messages of %s reach back less than to %s, so what it "
                              "already has is unknown" % (READ_LIMIT, recipient, iso(since)))
        return decide(recipient, pending, observation, now, self.batch_seconds, self.engaged_seconds)

    # -- deliver

    def deliver(self, plan, interrupt=False):
        """Write one note or wake for `plan`, after observing the agent again.

        Returns {"sent": bool, ...}. When the fresh look no longer supports the
        plan, nothing is sent; the next pass decides again. `interrupt` (`send --interrupt`, only
        from a boss to its own worker) first aborts the agent's running turn and then sends the message
        as a wake, whatever the plan said (a note to an engaged agent included).
        """
        if plan.action not in ("note", "wake"):
            raise ValueError("nothing to deliver for action %r" % plan.action)
        observation = plan.observation
        if not fault("no-recheck"):
            fresh, why = self.reobserve(observation, self.now())
            again = decide(plan.recipient, plan.pending, fresh, self.now(), self.batch_seconds,
                           self.engaged_seconds, why)
            if again.action != plan.action and not (interrupt and again.action in ("note", "wake")):
                detail = {"was": plan.action, "now": again.action, "reason": again.reason,
                          "keys": [fact.key for fact in plan.pending]}
                if self.audit is not None:
                    self.audit.append(self.actor, "recheck", plan.recipient, detail)
                note_unreachable(self, plan.recipient, fresh, why)
                return {"sent": False, "action": again.action, "reason": again.reason}
            observation = fresh
        repos = self.repos_in_play()
        text, carried = compose(plan.recipient, plan.pending, section=section_resolver(self, observation),
                                repos=repos)
        keys = [fact.key for fact in carried]
        # The id lives in v2's namespace, so it is derived from the session the
        # recipient runs now: a relaunched agent is a new recipient for v2.
        message_id = derive_message_id(observation.session_id, keys)
        resume = plan.action == "wake" or interrupt
        delivery = "queue" if resume and not fault("steer-not-queue") else "steer"
        busy = resume and not interrupt and steers_into_turn(self.config, observation, carried)
        if busy:
            delivery = "steer"
        detail = {"mode": plan.action, "session": observation.session_id, "message_id": message_id,
                  "keys": keys, "resume": resume, "delivery": delivery, "left": len(plan.pending) - len(keys)}
        if busy:
            detail["busy"] = True
        description = None if fault("no-description") else describe_items(plan.recipient, carried, repos)
        detail["description"] = description
        if interrupt:
            # resume false: nothing else runs; the wake below is what the agent acts on (and it carries any
            # steering input the interrupt left waiting)
            with self._external("v2.interrupt", plan.recipient, {
                    "session": observation.session_id, "resume": False, "keys": keys, "was": observation.status}) as result:
                reply = self.v2.interrupt(observation.session_id, False)
                result["interrupted"] = reply.get("interrupted") if isinstance(reply, dict) else None
            detail["interrupted"] = True
        with self._external("v2.synthetic", plan.recipient, detail) as result:
            record = self.v2.synthetic(observation.session_id, text,
                                       {"fleet": {"keys": keys, "from": "switchboard"}},
                                       resume, delivery, message_id, description)
            if fault("crash-after-send"):
                raise SimulatedCrash("crash-after-send: %s was admitted; stopping before the audit result"
                                     % message_id)
            result["id"] = record.get("id") if isinstance(record, dict) else None
        self._acknowledge(keys)
        return {"sent": True, "action": plan.action, "message_id": message_id, "keys": keys,
                "left": len(plan.pending) - len(keys)}

    def convert_lapsed_notes(self, observation, now):
        """A note still in v2's inbox once you have not prompted for the
        engagement window becomes a wake: `inbox.update` to queue, then to
        steer (v2 refuses steer to steer). Only on an idle agent. Returns the
        converted inbox ids."""
        if fault("no-note-conversion") or hold_reason(observation) or observation.status != "idle":
            return []
        if observation.engaged(now, self.engaged_seconds):
            return []
        inbox = self.v2.inbox_list(observation.session_id)
        notes = [item for item in (inbox if isinstance(inbox, list) else [])
                 if isinstance(item, dict) and (_fleet_meta(item) or {}).get("from") == "switchboard"
                 and item.get("delivery") == "steer" and item.get("resume") is not True
                 and not _is_orders_note(item)]  # PR 17: an unread orders note never becomes a wake
        converted = []
        for item in notes:
            if not fault("no-recheck"):
                fresh, why = self.reobserve(observation, self.now())
                if fresh is None or hold_reason(fresh) or fresh.status != "idle" \
                        or fresh.engaged(self.now(), self.engaged_seconds):
                    if self.audit is not None:
                        self.audit.append(self.actor, "recheck", observation.name, {
                            "was": "convert", "now": "keep", "inbox_id": item.get("id"),
                            "reason": why or hold_reason(fresh) or "%s is %s or engaged" % (
                                observation.name, fresh.status)})
                    break
            for delivery in ("queue", "steer"):
                with self._external("v2.inbox.update", observation.name, {
                        "session": observation.session_id, "inbox_id": item.get("id"),
                        "delivery": delivery, "keys": _fleet_keys(item), "why": "note outlived engagement"}) as result:
                    record = self.v2.inbox_update(observation.session_id, item.get("id"), delivery)
                    result["delivery"] = record.get("delivery") if isinstance(record, dict) else None
            converted.append(item.get("id"))
        return converted

    # -- the pass

    def _failed(self, subject, step, err, report):
        line = "%s: %s" % (type(err).__name__, _one_line(str(err)))
        report["errors"].append({"subject": subject, "step": step, "error": line})
        if self.audit is not None:
            self.audit.append(self.actor, "error", subject, {"step": step, "error": line})

    def run_pass(self):
        """One pass. One agent's failure is audited and never stops the others."""
        now = self.now()
        report = {"at": iso(now), "sent": [], "held": [], "waiting": [], "converted": [], "errors": [],
                  "badges": [], "toasts": []}
        self.pass_toasts = {}
        discovery = self.discover(now)
        for problem in discovery.problems:
            self._note("observe.problem", None, {"problem": problem})
        for observation in list(discovery.agents.values()):
            if observation.wrong_program:
                self._note("program.guard", observation.name, {"pane": observation.pane, "reason": observation.problem})
            try:
                report["converted"].extend(self.convert_lapsed_notes(observation, now))
            except Exception as err:
                self._failed(observation.name, "convert", err, report)
        run_shadow_classifier(self, discovery, now)  # PR 7: logs, acts on nothing
        facts, _ = self.collect_facts()
        by_recipient = {}
        for fact in facts:
            by_recipient.setdefault(fact.recipient, []).append(fact)
        held = {}
        for recipient in sorted(by_recipient):
            try:
                plan = self.plan(recipient, by_recipient[recipient], discovery, now)
                if plan is None:
                    continue
                if plan.action == "wait":
                    report["waiting"].append(recipient)
                elif plan.action == "hold":
                    held[recipient] = plan
                    report["held"].append({"recipient": recipient, "reason": plan.reason})
                    self._note("hold", recipient, {"reason": plan.reason,
                                                   "keys": [fact.key for fact in plan.pending]})
                else:
                    outcome = self.deliver(plan)
                    if outcome["sent"]:
                        report["sent"].append(dict(outcome, recipient=recipient))
            except Exception as err:
                self._failed(recipient, "deliver", err, report)
        self.render(discovery, held, now, report)
        finish_pass(self, discovery, report)
        return report

    # -- render: the sidebar badge and the toast

    def unread_count(self, observation, held):
        """The unread badge for one agent, derived on every pass, never stored:
        the facts in switchboard notes that wait in v2's inbox for a turn to
        carry them, plus the facts held for the agent. A note a turn has
        carried is read; a wake starts its own turn, so it is never unread."""
        inbox = self.v2.inbox_list(observation.session_id)
        waiting = [item for item in (inbox if isinstance(inbox, list) else [])
                   if isinstance(item, dict) and (_fleet_meta(item) or {}).get("from") == "switchboard"
                   and item.get("delivery") == "steer" and item.get("resume") is not True]
        count = sum(max(1, len(_fleet_keys(item))) for item in waiting)
        plan = held.get(observation.name)
        return count + (len(plan.pending) if plan else 0)

    def render_badges(self, discovery, held, report):
        """Write `unread` where it differs from what herdr's agent list shows."""
        shown = {entry.get("pane_id"): (entry.get("tokens") or {}).get("unread") for entry in discovery.entries}
        for name, observation in sorted(discovery.agents.items()):
            if not observation.pane:
                continue
            try:
                count = self.unread_count(observation, held)
                current = shown.get(observation.pane)
                if count == 0 and current is None or count and current == str(count):
                    continue
                detail = {"pane": observation.pane, "badge": "unread", "count": count, "was": current}
                with self._external("herdr.badge", name, detail):
                    if count:
                        self.herdr.pane_report_metadata_token(observation.pane, "unread", count)
                    else:
                        self.herdr.pane_clear_token(observation.pane, "unread")
                report["badges"].append({"agent": name, "count": count})
            except Exception as err:
                self._failed(name, "badge", err, report)

    def source_toasts(self):
        return collect_source_toasts(self)

    def toast_candidates(self, discovery, held, now):
        """[(agent, reason, title, body)], one per agent, most urgent reason first:
        a pane on another program, a blocked agent, items held past the limit."""
        wanted = {}
        for name, plan in held.items():
            if now - min(fact.created for fact in plan.pending) >= HELD_TOAST_AFTER:
                wanted[name] = ("held: %s" % plan.reason, "%s: %d item(s) held" % (name, len(plan.pending)),
                                plan.reason)
        for name, observation in discovery.agents.items():
            if observation.wrong_program:
                wanted[name] = ("different opencode", "%s: pane runs a different opencode" % name,
                                observation.problem)
            elif observation.status == "blocked":
                wanted[name] = ("blocked", "%s is blocked" % name,
                                "%s is waiting on a permission request or a question" % name)
        for name, found in self.source_toasts().items():  # says what is asked, so it wins over the generic one
            if wanted.get(name, ("",))[0] != "different opencode":
                wanted[name] = found
        return [(name,) + wanted[name] for name in sorted(wanted)]

    def render_toast(self, discovery, held, now, report):
        """At most one toast per pass (herdr allows one a second, and queues none),
        for the first agent whose reason has not been toasted yet. A reason
        that has cleared is forgotten, so it toasts again if it comes back."""
        candidates = self.toast_candidates(discovery, held, now)
        self.toasted = {name: reason for name, reason in self.toasted.items()
                        if any(c[0] == name and c[1] == reason for c in candidates)}
        for name, reason, title, body in candidates:
            if self.toasted.get(name) == reason:
                continue
            with self._external("herdr.notification", name, {"reason": reason, "title": title}) as result:
                reply = self.herdr.notification_show(title, body)
                result["reply"] = reply
            if reply["shown"] or reply["reason"] == "disabled":
                self.toasted[name] = reason  # shown, or herdr has toasts off for good
            report["toasts"].append({"agent": name, "reason": reason, "shown": reply["shown"],
                                     "why": reply["reason"]})
            return  # rate_limited, busy, no_foreground_client: owed, tried again next pass

    def render(self, discovery, held, now, report):
        """Step 5: update herdr. A failure here is audited and never stops the pass."""
        if self.audit is None:
            return
        steps = (("badge", lambda: self.render_badges(discovery, held, report)),
                 ("toast", lambda: self.render_toast(discovery, held, now, report)))
        for step, call in steps:
            try:
                call()
            except Exception as err:
                self._failed(None, step, err, report)

    # -- the CLI's entry points

    def send(self, sender, recipient, text, issue=None, repo=None, interrupt=False):
        """Deliver `text` to `recipient` now, by the rule, without batching. Stores nothing. `interrupt`: only a
        boss to its own worker; raises InterruptRefused otherwise."""
        now = self.now()
        discovery = self.discover(now)
        if interrupt:
            target = discovery.agents.get(recipient)
            if target is None or _boss_of(target) != sender:
                reason = ("%s is not an agent of this fleet that reports to you" % recipient if target is None
                          else "only a boss may interrupt, and %s does not report to %s" % (recipient, sender))
                if self.audit is not None:
                    self.audit.append(self.actor, "interrupt.refused", recipient, {"from": sender, "reason": reason})
                raise InterruptRefused(reason)
        fact = Fact("send:%s:%s" % (sender, uuid.uuid4().hex[:16]), recipient, "send", text, now,
                    issue=None if issue is None else int(issue), batch=False, sender=sender,
                    repo=repo or issue_repo(issue))
        return self.send_fact(fact, discovery, now, interrupt=interrupt)

    def repos_in_play(self):
        """The repos messages may be about: every watched repo. With one, a message names `#2`; with
        several, `api#2` (PR 15)."""
        discovery = getattr(self, "discovery", None)
        return watched_repos(self.config, discovered_fleets(discovery))

    def send_fact(self, fact, discovery, now, carried=(), interrupt=False):
        """The one delivery path of `send` and `report`: `fact` (and any `carried` riders) now, by the rule."""
        recipient = fact.recipient
        plan = self.plan(recipient, [fact] + list(carried), discovery, now)
        if plan.action == "hold":
            if self.audit is not None:
                self.audit.append(self.actor, "hold", recipient, {"reason": plan.reason, "keys": [fact.key]})
            return {"sent": False, "action": "hold", "reason": plan.reason}
        return self.deliver(plan, interrupt=interrupt)

    def report(self, sender, state, text, issue=None, everything=False):
        """PR 13: `sender` tells the one it reports to what happened. An attention report (done, failed, blocked,
        question) is delivered now, by `send`'s own path, with the progress reports waiting for that boss. A
        progress report (working, paused, withdrawn) is a rider: recorded, and carried by the next message. Raises
        ReportError when it cannot be a report."""
        if state not in REPORT_STATES:
            raise ReportError("state must be one of %s, got %r" % (", ".join(REPORT_STATES), state))
        text = " ".join((text or "").split())
        if not text:
            raise ReportError("a report needs one line saying what happened")
        if len(text) > REPORT_MAX:
            raise ReportError("a report is one line of at most %d characters (this one is %d): put the detail on "
                              "GitHub and report its link" % (REPORT_MAX, len(text)))
        if everything and state != "withdrawn":
            raise ReportError("--all only goes with `withdrawn`")
        if state == "withdrawn":
            if everything:
                text = WITHDRAW_ALL + text
            elif text.startswith(WITHDRAW_ALL.strip()):
                text = "- " + text  # a plain withdrawal never reads as --all
        now = self.now()
        discovery = self.discover(now)
        me = discovery.agents.get(sender)
        if me is None:
            raise ReportError(discovery.missing(sender))
        boss = _boss_of(me)
        if boss is None:
            raise ReportError("%s reports to nobody: its fleet metadata has no reports_to, so there is no one to "
                              "tell (use `%s send <name> ...` for a message)" % (sender, PROG))
        repo, number = resolve_issue(self.config, issue, me.fleet, watched_repos(self.config, discovered_fleets(discovery)))
        if number is not None and issue is not None:
            self.check_issue_exists(repo, number, own_repo=(me.fleet or {}).get("repo"))
        if number is None:
            number, repo = _issue_of(me.fleet), _fleet_repo(me.fleet, self.config) if _issue_of(me.fleet) else None
        fact = Fact("%s:%s:%s" % (REPORT, sender, uuid.uuid4().hex[:16]), boss, REPORT, "%s: %s" % (state, text),
                    now, issue=number, batch=False, sender=sender, repo=repo,
                    rider=state in REPORT_PROGRESS and not fault("no-rider"))
        if fact.rider:
            record_report_rider(self, fact)
            return {"sent": False, "action": "rider", "reason": "a progress report is a rider: it rides in the "
                    "next message to %s and never wakes it" % boss, "key": fact.key, "recipient": boss}
        waiting = [f for f in report_rider_facts(self) if f.recipient == boss]
        return self.send_fact(fact, discovery, now, waiting)

    def check_issue_exists(self, repo, number, wait=None, own_repo=None):
        """#89: refuse a report tagged to an issue GitHub says does not exist (a report to a ghost can only be
        cleared by a send on the same ghost). Best effort: no reader, an unreadable or slow lookup, or any answer
        but a clear "not found" accepts the report. The reader's cache serves a known issue without a read."""
        reader = self.intents
        if reader is None:
            return
        if repo not in (None, reader.repo, own_repo):
            return  # a repo this report was only guessed into: not worth refusing a report over
        wait = REPORT_LOOKUP_WAIT if wait is None else wait
        box = {}

        def look():
            try:
                reader.issue(number, repo)
            except IntentError as err:
                box["error"] = err
            except Exception:
                pass  # unreadable: accepted

        thread = threading.Thread(target=look, daemon=True)
        thread.start()
        thread.join(wait)
        err = box.get("error")
        if err is not None and err.reason == "not_found":
            raise ReportError("issue %s#%d does not exist, so a report cannot be tagged to it: check the number "
                              "(or leave --issue out to use your own ask)" % (repo or reader.repo, number))

    def pending(self, name, discovery=None, facts=None):
        """Read-only: what is pending for `name`, and what the rule says about it."""
        now = self.now()
        discovery = discovery or self.discover(now)
        problems = []
        if facts is None:
            facts, problems = self.collect_facts()
        mine = [fact for fact in facts if fact.recipient == name]
        plan, riders = self.plan_with_riders(name, mine, discovery, now) if mine else (None, [])
        observation = discovery.agents.get(name)
        return {"name": name, "observation": observation.to_json() if observation else None,
                "missing": None if observation else discovery.missing(name),
                "plan": plan.to_json() if plan else None, "source_problems": problems,
                "riders": [fact.to_json() for fact in riders]}


# ============================================================================
# PR 7: the decision model, the classifier and the policy judge's questions
#
# One section, so the stack rebases cleanly. docs/switchboard.md, "Classify: a
# decision model" and "The judge". Registered in four places: the config check
# (`validate_jev_config`), `Switchboard.__init__` (`build_jev`), `run_pass`
# (`run_shadow_classifier`) and the unknown-key list (`PR7_CONFIG_KEYS`).
# ============================================================================
import socket
import urllib.error
import urllib.request

JEV_MODEL = "typesafe/jev-1.13"
JEV_URL = "https://openrouter.ai/api/v1/systemone"
JEV_KEY_ENV = "OPENROUTER_API_KEY"
JEV_DEFAULTS = {
    "model": JEV_MODEL,
    "url": JEV_URL,
    "key_env": JEV_KEY_ENV,       # the NAME of the variable that holds the key, never the key
    "key_file": None,             # PR 16: a private file that holds the key; None means jev.key beside config.json
    "timeout_seconds": 20,
    "min_confidence": 0.7,        # the classifier's threshold; SF2 will choose the real one
    "record_file": None,          # append every real call here as a request/response pair
    "replay": None,               # answer from this file instead of calling Jev
}
PR7_CONFIG_KEYS = ("jev", "shadow_judges")
JEV_HTTP_REASONS = {400: "invalid", 401: "unauthorized", 402: "no_credit", 403: "unauthorized",
                    413: "too_large", 422: "invalid", 429: "rate_limited"}
JEV_REASONS = ("invalid", "unauthorized", "no_credit", "too_large", "rate_limited",
               "timeout", "unreachable", "bad_response")
JEV_TEXT_LIMIT = 1000   # characters of any one message or intent sent to Jev
JEV_DETAIL_LIMIT = 160  # characters of a provider's text kept in an error


def validate_jev_config(config, raw, source="config"):
    """Check and complete `jev` and `shadow_judges`. Silent when `raw` has neither."""
    if not any(name in raw for name in PR7_CONFIG_KEYS):
        return
    jev = raw.get("jev")
    if jev is not None:
        config["jev"] = _checked_jev_settings(jev, source)
    shadow = raw.get("shadow_judges")
    if shadow is not None and not isinstance(shadow, bool):
        raise ConfigError("%s: 'shadow_judges' must be true or false, got %r" % (source, shadow))
    if shadow and jev is None:
        raise ConfigError("%s: 'shadow_judges' needs a 'jev' object: there is no decision model to ask" % source)
    config["shadow_judges"] = (jev is not None) if shadow is None else shadow


def _checked_jev_settings(jev, source):
    if not isinstance(jev, dict):
        raise ConfigError("%s: 'jev' must be an object, got %r" % (source, type(jev).__name__))
    unknown = sorted(set(jev) - set(JEV_DEFAULTS))
    if unknown:
        raise ConfigError("%s: 'jev' contains key(s) this tool does not read: %s (known: %s)"
                          % (source, ", ".join(unknown), ", ".join(JEV_DEFAULTS)))
    settings = dict(JEV_DEFAULTS, **jev)
    for name in ("model", "url", "key_env"):
        if not isinstance(settings[name], str) or not settings[name].strip():
            raise ConfigError("%s: 'jev.%s' must be a non-empty string, got %r" % (source, name, settings[name]))
    if not re.match(r"^[A-Za-z_][A-Za-z0-9_]*$", settings["key_env"]):
        raise ConfigError("%s: 'jev.key_env' is the NAME of an environment variable, got %r "
                          "(never put the key itself in this file)" % (source, settings["key_env"]))
    if not re.match(r"^(https://|http://(localhost|127\.0\.0\.1)[:/])", settings["url"]):
        raise ConfigError("%s: 'jev.url' must be https (the key travels with it), got %r" % (source, settings["url"]))
    if not _is_number(settings["timeout_seconds"]) or settings["timeout_seconds"] <= 0:
        raise ConfigError("%s: 'jev.timeout_seconds' must be a positive number, got %r"
                          % (source, settings["timeout_seconds"]))
    if not _is_number(settings["min_confidence"]) or not 0 < settings["min_confidence"] <= 1:
        raise ConfigError("%s: 'jev.min_confidence' must be a number above 0 and at most 1, got %r"
                          % (source, settings["min_confidence"]))
    for name in ("record_file", "replay", "key_file"):
        value = settings[name]
        if value is not None and (not isinstance(value, str) or not os.path.isabs(value)):
            raise ConfigError("%s: 'jev.%s' must be an absolute path, got %r" % (source, name, value))
    if settings["record_file"] and settings["replay"]:
        raise ConfigError("%s: 'jev' cannot both record real calls and replay recorded ones" % source)
    return settings


# ------------------------------------------------------------------ the client

class JevError(Exception):
    """A Jev call with no usable answer. `reason` is one of JEV_REASONS."""

    def __init__(self, reason, detail=None, latency_ms=None):
        self.reason, self.detail, self.latency_ms = reason, detail, latency_ms
        super().__init__("%s: %s" % (reason, detail) if detail else reason)


def _canonical(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":"))


def _scrub_provider_text(text, key=None):
    """One short line of a provider's text with the key (and any bearer value) removed."""
    text = str(text if text is not None else "")
    if key:
        text = text.replace(key, "[key]")
    text = re.sub(r"(?i)bearer\s+\S+", "Bearer [key]", text)
    return _one_line(text, JEV_DETAIL_LIMIT)


def _is_probability(value):
    return _is_number(value) and 0 <= value <= 1


def check_answers(questions, answers):
    """`answers` (a dict by question id, or a list in question order) as a dict, or JevError.

    A missing answer, an out-of-range probability or an option nobody offered
    is a bad answer, never a reading.
    """
    if isinstance(answers, list):
        if len(answers) != len(questions):
            raise JevError("bad_response", "%d answer(s) for %d question(s)" % (len(answers), len(questions)))
        answers = dict(zip(questions, answers))
    if not isinstance(answers, dict):
        raise JevError("bad_response", "no answers")
    for name, question in questions.items():
        answer = answers.get(name)
        if not isinstance(answer, dict):
            raise JevError("bad_response", "question %s is not answered" % name)
        if question.get("type") == "noul":
            if not _is_probability(answer.get("noul")):
                raise JevError("bad_response", "question %s: noul is not a probability" % name)
            continue
        if answer.get("choice") not in question.get("criteria", {}):
            raise JevError("bad_response", "question %s: choice is not one of the options" % name)
        probabilities = answer.get("probabilities")
        if probabilities is not None:
            values = list(probabilities.values()) if isinstance(probabilities, dict) else [None]
            if not all(_is_probability(v) for v in values) or abs(sum(values) - 1) > 0.01:
                raise JevError("bad_response", "question %s: probabilities do not sum to 1" % name)
            if set(probabilities) - set(question["criteria"]):
                raise JevError("bad_response", "question %s: probabilities name an option nobody offered" % name)
    return answers


class KeyFileError(Exception):
    """The key file exists and may not be used. Names the path and the rule, never the key."""


def jev_key_file(settings):
    """Where the decision-model key file is: `jev.key_file`, else jev.key beside config.json."""
    given = (settings or {}).get("key_file")
    return Path(given) if given else config_path().parent / "jev.key"


def locate_jev_key(settings, environ=None):
    """(key, source): the key and where it came from, `environment`, `file`, or (None, `none`).

    The variable named by `key_env` wins. Otherwise the key file, which must be a regular file (not a
    link) that you own and nobody else can read or write, and must not be empty: a file the group or
    the world can read is refused with the reason, and the key is never part of that reason.
    Raises KeyFileError.
    """
    environ = os.environ if environ is None else environ
    name = (settings or {}).get("key_env") or JEV_KEY_ENV
    value = environ.get(name)
    if value:
        return value, "environment"
    path = jev_key_file(settings)
    try:
        info = os.lstat(str(path))
    except FileNotFoundError:
        return None, "none"
    except OSError as err:
        raise KeyFileError("cannot read the key file %s: %s" % (path, err.strerror or err)) from None
    if not stat.S_ISREG(info.st_mode):
        raise KeyFileError("the key file %s must be a regular file, not a link or a directory" % path)
    if info.st_uid != os.getuid():
        raise KeyFileError("the key file %s must be owned by you" % path)
    if info.st_mode & 0o077:
        raise KeyFileError("the key file %s can be read by others: run `chmod 0600 %s`, or save the key again "
                           "with `%s key set` (mode 0600, owned by you)" % (path, path, PROG))
    try:
        text = path.read_text().strip()
    except OSError as err:
        raise KeyFileError("cannot read the key file %s: %s" % (path, err.strerror or err)) from None
    if not text:
        raise KeyFileError("the key file %s is empty" % path)
    return text, "file"


def jev_secrets(config, environ=None):
    """The decision-model key as a list (empty when there is none or the file is refused): what redaction hides."""
    if not config.get("jev"):
        return []
    try:
        key, _ = locate_jev_key(config["jev"], environ)
    except KeyFileError:
        return []
    return [key] if key else []


def _usage_of(usage):
    """The numbers of a usage block under names the audit does not redact."""
    usage = usage if isinstance(usage, dict) else {}
    pairs = (("in", "input_tokens"), ("out", "output_tokens"), ("cost", "cost"))
    return {short: usage[name] for short, name in pairs if _is_number(usage.get(name))}


class JevClient:
    """The decision model over HTTPS (OpenRouter's System One endpoint).

    The key is read from the environment variable named in the config at the
    moment of each call. It is never stored on the client, written to a file,
    put in an argument list, or kept in an error. `opener` has urlopen's shape
    so tests inject a fake and never reach a network.
    """

    def __init__(self, settings, environ=None, opener=None, clock=time.monotonic):
        self.settings = settings
        self.environ = os.environ if environ is None else environ
        self.opener = opener or urllib.request.urlopen
        self.clock = clock

    def decide(self, state, questions):
        """{"model", "answers", "usage", "latency_ms"}. Raises JevError, with the latency."""
        started = self.clock()
        try:
            try:
                key, _ = locate_jev_key(self.settings, self.environ)
            except KeyFileError as err:
                raise JevError("unauthorized", str(err)) from None
            if not key:
                raise JevError("unauthorized", "no key in $%s or the key file" % self.settings["key_env"])
            body = {"model": self.settings["model"], "state": state, "questions": questions}
            out = self._post(body, key)
            answers = check_answers(questions, out.get("answers"))
        except JevError as err:
            err.latency_ms = int((self.clock() - started) * 1000)
            raise
        result = {"model": _scrub_provider_text(out.get("model") or self.settings["model"], key), "answers": answers,
                  "usage": _usage_of(out.get("usage")), "latency_ms": int((self.clock() - started) * 1000)}
        self._record(body, out)
        return result

    def _post(self, body, key):
        request = urllib.request.Request(
            self.settings["url"], data=json.dumps(body).encode("utf-8"), method="POST",
            headers={"Authorization": "Bearer " + key, "Content-Type": "application/json",
                     "Accept": "application/json"})
        response = None
        try:
            response = self.opener(request, timeout=self.settings["timeout_seconds"])
            raw = response.read()
        except urllib.error.HTTPError as err:
            reason = JEV_HTTP_REASONS.get(err.code, "unreachable")
            raise JevError(reason, "HTTP %s %s" % (err.code, _scrub_provider_text(self._body_of(err), key)))
        except (socket.timeout, TimeoutError):
            raise JevError("timeout", "no answer in %ss" % self.settings["timeout_seconds"])
        except urllib.error.URLError as err:
            if isinstance(err.reason, (socket.timeout, TimeoutError)):
                raise JevError("timeout", "no answer in %ss" % self.settings["timeout_seconds"])
            raise JevError("unreachable", _scrub_provider_text(err.reason, key))
        except OSError as err:
            raise JevError("unreachable", _scrub_provider_text(err, key))
        finally:
            if response is not None and hasattr(response, "close"):
                response.close()
        try:
            out = json.loads(raw)
        except (TypeError, ValueError):
            raise JevError("bad_response", "the answer is not JSON")
        if not isinstance(out, dict):
            raise JevError("bad_response", "the answer is not an object")
        return out

    @staticmethod
    def _body_of(err):
        try:
            return err.read().decode("utf-8", "replace")
        except Exception:
            return ""

    def _record(self, body, out):
        path = self.settings.get("record_file")
        if not path:
            return
        line = json.dumps({"request": body, "response": out}, sort_keys=True) + "\n"
        fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
        with os.fdopen(fd, "a") as handle:
            handle.write(line)


class ReplayJev:
    """Answers from a hand-written or recorded file, never from the network.

    The file is a JSON object {"pairs": [...], "rules": [...]} or JSON lines of
    pairs (what `jev.record_file` writes). A pair is {"request": {state,
    questions[, model]}, "response": {answers[, model, usage]}} and matches an
    identical request. A rule is {"contains": text, "choice": {option: p},
    "noul": {question: p}, "error": reason} and matches a request whose
    "message" contains the text (a rule without "contains" matches anything);
    the first match wins. A question nobody answered is an error, loudly.
    """

    def __init__(self, path, model=JEV_MODEL):
        self.path, self.model = path, model
        self._pairs = self._rules = None

    def _load(self):
        if self._pairs is not None:
            return
        try:
            text = Path(self.path).read_text()
            try:
                data = json.loads(text)
            except ValueError:
                data = {"pairs": [json.loads(line) for line in text.splitlines() if line.strip()]}
            if "request" in data:  # a record file holding exactly one line parses as that pair
                data = {"pairs": [data]}
            pairs, rules = list(data.get("pairs") or []), list(data.get("rules") or [])
        except (OSError, ValueError, AttributeError) as err:
            raise JevError("bad_response", "cannot read the replay file: %s" % _scrub_provider_text(err))
        self._pairs = {_canonical({"model": p["request"].get("model", self.model),
                                   "state": p["request"].get("state"),
                                   "questions": p["request"].get("questions")}): p["response"] for p in pairs}
        self._rules = rules

    def decide(self, state, questions):
        self._load()
        response = self._pairs.get(_canonical({"model": self.model, "state": state, "questions": questions}))
        if response is None:
            response = self._by_rule(state, questions)
        answers = check_answers(questions, response.get("answers"))
        return {"model": str(response.get("model") or self.model), "answers": answers,
                "usage": _usage_of(response.get("usage")), "latency_ms": int(response.get("latency_ms") or 0)}

    def _by_rule(self, state, questions):
        message = state.get("message") if isinstance(state, dict) else None
        subject = message if isinstance(message, str) else _canonical(state)
        for rule in self._rules:
            if rule.get("contains", "") in subject:
                if rule.get("error") in JEV_REASONS:
                    raise JevError(rule["error"], "replayed")
                return {"answers": self._answers_of(rule, questions), "model": rule.get("model")}
        raise JevError("bad_response", "nothing recorded for this question")

    @staticmethod
    def _answers_of(rule, questions):
        answers = {}
        for name, question in questions.items():
            if question.get("type") == "noul":
                answers[name] = {"type": "noul", "noul": (rule.get("noul") or {}).get(name, 0.0)}
                continue
            options = list(question.get("criteria", {}))
            given = rule.get("choice") or {}
            probabilities = {option: given.get(option, 0.0) for option in options}
            total = sum(p for p in probabilities.values() if _is_number(p))
            if total > 0:  # a rule may name options this question lacks: scale what is left to 1
                probabilities = {option: p / total for option, p in probabilities.items()}
            top = max(options, key=lambda option: (probabilities[option], option == "current"))
            answers[name] = {"type": "choice", "choice": top, "probabilities": probabilities}
        return answers


def build_jev(config):
    """The decision model the config asks for, or None when `jev` is not configured."""
    settings = config.get("jev")
    if not settings:
        return None
    if settings.get("replay"):
        return ReplayJev(settings["replay"], settings["model"])
    return JevClient(settings)


# ----------------------------------------------------------------- the classifier

CLASSIFY_ID = "about"
CLASSIFY_INSTRUCTIONS = (
    "The Chief of Staff is an AI assistant working for one person, who has just sent a new message. "
    "Which of the following is the new message about: the work in progress, an ask somebody else is "
    "already working on, or something new?")


def _clip(text, limit=JEV_TEXT_LIMIT):
    text = "" if text is None else str(text)
    return text if len(text) <= limit else text[:limit - 1] + "\u2026"


def _ask_line(ask):
    ask = ask or {}
    line = _clip(ask.get("intent") or "no stated intent", 300)
    if ask.get("done_when"):
        line += " (done when: %s)" % _clip(ask["done_when"], 200)
    return line


def classify_options(current_ask, open_asks):
    """Option name -> its criterion: `current`, one per open ask by issue number, `new`."""
    options = {"current": "The message is about the work in progress now: %s." % _ask_line(current_ask)}
    own = str((current_ask or {}).get("issue"))
    for ask in open_asks or []:
        name = str(ask["issue"])
        if name == own:
            continue  # the current ask is `current`, not a second option
        options[name] = "The message is about ask %s (%s), which %s already owns." % (
            name, _clip(ask.get("intent") or "no stated intent", 300), ask.get("owner") or "someone")
    options["new"] = "The message is about something else: new work unrelated to the work in progress and to every open ask."
    return options


def classify_request(message, previous_message, current_ask, open_asks):
    """(state, questions) for one classification."""
    state = {"message": _clip(message), "previous_message": _clip(previous_message) if previous_message else None,
             "current_ask": {"issue": (current_ask or {}).get("issue"), "intent": _ask_line(current_ask)},
             "open_asks": [{"issue": str(a["issue"]), "intent": _clip(a.get("intent") or "", 300),
                            "owner": a.get("owner")} for a in open_asks or []]}
    question = {"type": "choice", "instructions": CLASSIFY_INSTRUCTIONS,
                "criteria": classify_options(current_ask, open_asks)}
    return state, {CLASSIFY_ID: question}


def _default_current(reason, extra=None):
    out = {"choice": "current", "probabilities": None, "confident": False, "reason": reason,
           "jev_choice": None, "model": None, "usage": {}, "latency_ms": None}
    out.update(extra or {})
    return out


def classify(jev, message, previous_message, current_ask, open_asks, min_confidence=0.7):
    """One Jev call: {choice, probabilities, confident, reason, ...}. Never raises on Jev's account.

    `confident` is true when the top probability reaches `min_confidence`. When
    Jev is unreachable, errs, or is unsure, the choice is `current`: the safe
    default changes nothing. `jev_choice` keeps what Jev said, for the audit.
    """
    state, questions = classify_request(message, previous_message, current_ask, open_asks)
    try:
        result = jev.decide(state, questions)
    except JevError as err:
        return _default_current("jev %s" % err.reason, {"latency_ms": err.latency_ms})
    answer = result["answers"][CLASSIFY_ID]
    probabilities = answer.get("probabilities")
    out = {"probabilities": probabilities, "jev_choice": answer["choice"], "model": result["model"],
           "usage": result["usage"], "latency_ms": result["latency_ms"]}
    if not probabilities:
        return dict(_default_current("jev gave no probabilities"), **out, choice="current")
    top = probabilities.get(answer["choice"], 0.0)
    if top < min_confidence:
        return dict(out, choice="current", confident=False,
                    reason="unsure: %s at %.2f is below %.2f" % (answer["choice"], top, min_confidence))
    return dict(out, choice=answer["choice"], confident=True, reason="confident: %s at %.2f" % (answer["choice"], top))


# ---------------------------------------------------------- the policy judge's questions

POLICY_THRESHOLD = 0.5
POLICY_OUTCOMES = ("allow", "ask", "deny", "hard-deny")  # least to most strict
POLICY_QUESTIONS = {
    "outside_intent": ("Is this action beyond the ask's Intent and Done-when?",
                       "The action goes beyond what the Intent and Done-when ask for.",
                       "The action is part of doing what the Intent and Done-when ask for."),
    "hard_to_reverse": ("Is this action destructive, irreversible or security-sensitive?",
                        "It destroys data, cannot be undone, or weakens security.",
                        "It is easy to undo and touches nothing sensitive."),
    "speaks_for_you": ("Is this action a merge, deploy, publish, message to other people, or spend that "
                       "the charter's standing authority does not cover?",
                       "It merges, deploys, publishes, messages others or spends, and nothing in the "
                       "standing authority covers it.",
                       "It does none of those, or the standing authority covers it."),
    "outside_scope": ("Does this action touch a repository, environment, account or credential outside "
                      "this agent's assignment?",
                      "It touches something outside what this agent was assigned.",
                      "It stays inside what this agent was assigned."),
}
POLICY_ASK_FOR = ("hard_to_reverse", "speaks_for_you", "outside_scope")


def policy_questions():
    """The four yes/no questions, by id."""
    return {name: {"type": "noul", "instructions": text, "criteria": {"true": yes, "false": no}}
            for name, (text, yes, no) in POLICY_QUESTIONS.items()}


def policy_state(role, intent, done_when, authority, tool, arguments, authority_clip=None):
    return {"role": role, "intent": _clip(intent, 600), "done_when": _clip(done_when, 400),
            "standing_authority": _clip(authority, authority_clip or ORDERS_STATE_CLIP), "tool": tool,
            "arguments": _clip(_canonical(arguments) if not isinstance(arguments, str) else arguments, 1500)}


def _stricter(first, second):
    return max((first, second), key=POLICY_OUTCOMES.index)


def combine_policy(answers, thresholds=None, configured="allow"):
    """The outcome of the four answers, never looser than `configured` (invariant 9).

    `answers` maps question id to a probability, or None when unanswered.
    outside_intent at its threshold is a hard deny; any of the other three is
    an ask; an unanswered or malformed answer counts for nothing, so the
    configured outcome stands. Returns {outcome, configured, fired, reason}.
    """
    if configured not in POLICY_OUTCOMES:
        raise ValueError("unknown configured outcome: %r" % (configured,))
    limits = dict.fromkeys(POLICY_QUESTIONS, POLICY_THRESHOLD)
    limits.update(thresholds or {})
    answers = answers or {}
    fired = [name for name in POLICY_QUESTIONS
             if _is_probability(answers.get(name)) and answers[name] >= limits[name]]
    judged = "allow"
    if "outside_intent" in fired:
        judged = "hard-deny"
    elif any(name in fired for name in POLICY_ASK_FOR):
        judged = "ask"
    if fault("judge-loosens"):
        outcome = judged  # the fault: the judge's word replaces the configured outcome
    else:
        outcome = _stricter(configured, judged)
    reason = "judge: %s" % ", ".join(fired) if fired else "judge: nothing at its threshold"
    return {"outcome": outcome, "configured": configured, "fired": fired, "reason": reason}


def judge_tool_call(jev, configured, state, thresholds=None):
    """Ask the four questions about one tool call and combine them. Never raises, never loosens.

    No answer (slow, unreachable, an error) leaves the configured outcome.
    """
    questions = policy_questions()
    try:
        result = jev.decide(state, questions)
    except JevError as err:
        combined = combine_policy(None, thresholds, configured)
        combined.update(reason="judge unavailable (%s): configured outcome stands" % err.reason,
                        latency_ms=err.latency_ms, usage={})
        return combined
    answers = {name: result["answers"][name]["noul"] for name in questions}
    combined = combine_policy(answers, thresholds, configured)
    combined.update(answers=answers, latency_ms=result["latency_ms"], usage=result["usage"], model=result["model"])
    return combined


# ------------------------------------------------------- shadow mode in the engine

def _message_text(message):
    text = message.get("text")
    if isinstance(text, str):
        return text
    parts = message.get("content")
    if isinstance(parts, list):
        return "\n".join(p.get("text", "") for p in parts if isinstance(p, dict) and isinstance(p.get("text"), str))
    return ""


def human_prompts(messages):
    """Your prompts in a transcript read newest first: type `user` without `metadata.fleet`."""
    return [m for m in messages if isinstance(m, dict) and m.get("type") == "user" and _fleet_meta(m) is None]


def _ask_of(fleet, owner=None):
    issue = fleet.get("issue")
    if issue is None:
        return None
    return {"issue": issue, "intent": fleet.get("intent") or "", "owner": owner, "repo": fleet.get("repo")}


def open_asks_of(discovery, cos_name):
    """The asks others hold: a fleet agent with an issue, other than the Chief of Staff.

    Intent text arrives with `fleet-switchboard intents` (PR 6); until then an
    ask has its issue number and owner only.
    """
    asks, seen = [], set()
    for name, other in sorted(discovery.agents.items()):
        ask = _ask_of(other.fleet, name)
        if name != cos_name and ask and (ask["repo"], ask["issue"]) not in seen:
            seen.add((ask["repo"], ask["issue"]))
            asks.append(ask)
    return asks


def _classify_audit(engine, observation, message, previous, request, answer, shadow=True):
    state, questions = request
    detail = {"agent": observation.name, "session": observation.session_id, "message_id": message.get("id"),
              "status": observation.status, "shadow": shadow,
              "question": {"state": state, "options": list(questions[CLASSIFY_ID]["criteria"])},
              "answer": {"choice": answer["choice"], "confident": answer["confident"],
                         "reason": answer["reason"], "jev_choice": answer["jev_choice"],
                         "probabilities": answer["probabilities"]},
              "model": answer["model"], "usage": answer["usage"], "latency_ms": answer["latency_ms"]}
    engine.audit.append(engine.actor, "classify", "classify:%s:%s" % (observation.session_id, message.get("id")), detail)


def shadow_classify(engine, observation, discovery, now):
    """Classify your newest prompt to a Chief of Staff once, and write what Jev said. Acts on nothing."""
    prompts = newest_prompts(engine, observation.session_id)
    if not prompts:
        return False
    message = prompts[0]
    created = _created(message)
    key = "classify:%s:%s" % (observation.session_id, message.get("id"))
    if message.get("id") is None or key in engine._classified:
        return False
    if created is None or now - created > engine.engaged_seconds:
        return False
    engine._classified.add(key)  # one attempt per message, whatever the answer
    asks = ask_intents(engine, open_asks_of(discovery, observation.name))  # PR 8: with their Intent
    if observation.status != "working" and not asks:
        return False  # nothing to choose between: it simply becomes the foreground work
    previous = _message_text(prompts[1]) if len(prompts) > 1 else None
    current = ask_intent(engine, _ask_of(observation.fleet, observation.name))
    request = classify_request(_message_text(message), previous, current, asks)
    answer = classify(engine.jev, _message_text(message), previous, current, asks,
                      engine.config["jev"]["min_confidence"])
    _classify_audit(engine, observation, message, previous, request, answer, shadow=not acting(engine))
    if acting(engine):  # PR 8
        note_decision(engine, observation, message, current, asks, answer)
    return True


def run_shadow_classifier(engine, discovery, now):
    """Each Chief of Staff, once per new prompt. A failure is audited and never stops the pass."""
    if engine.jev is None or engine.audit is None or not (engine.config.get("shadow_judges") or acting(engine)):
        return
    if fault("no-classify"):
        return
    for observation in list(discovery.agents.values()):
        if observation.fleet.get("role") != "chief-of-staff" or observation.problem:
            continue
        try:
            shadow_classify(engine, observation, discovery, now)
        except Exception as err:
            engine.audit.append(engine.actor, "error", observation.name,
                                {"step": "classify", "error": "%s: %s" % (type(err).__name__, _one_line(str(err)))})


# ------------------------------------------------- the poke socket and the daemon

POKE_SOCKET = "poke.sock"
ENSURE_PATIENCE = 3.0  # seconds `ensure` waits for the daemon to take its lock
POKE_ALARM = 2         # seconds before a stuck `poke` ends itself


@contextmanager
def in_directory(path):
    """Work from `path` for the block. A unix socket path is limited to about
    100 bytes, so the poke socket is always named relative to the state dir."""
    before = os.getcwd()
    os.chdir(str(path))
    try:
        yield
    finally:
        os.chdir(before)


def open_poke_socket(state_dir):
    """The daemon's end: a datagram socket at $STATE/poke.sock, a stale one replaced."""
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    try:
        with in_directory(state_dir):
            try:
                os.unlink(POKE_SOCKET)
            except FileNotFoundError:
                pass
            sock.bind(POKE_SOCKET)
            os.chmod(POKE_SOCKET, 0o600)
        sock.setblocking(False)
    except BaseException:
        sock.close()
        raise
    return sock


def send_poke(state_dir):
    """Ask the daemon for a pass. One non-blocking datagram; True when it was sent.

    Never blocks and never raises: a daemon that is down, or too busy to take
    one more datagram, has not lost anything, because the next pass derives
    everything again.
    """
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    try:
        sock.setblocking(False)
        with in_directory(state_dir):
            sock.sendto(b"poke", POKE_SOCKET)
        return True
    except OSError:
        return False
    finally:
        sock.close()


def drain_pokes(sock):
    """Read every datagram waiting. Returns how many."""
    count = 0
    while sock is not None:
        try:
            sock.recv(64)
        except (BlockingIOError, InterruptedError):
            break
        count += 1
    return count


def wait_for_poke(sock, timeout):
    """Wait up to `timeout` seconds for a poke. True when one came."""
    if sock is None:
        time.sleep(timeout)
        return False
    ready, _, _ = select.select([sock], [], [], timeout)
    return bool(ready)


DAEMON_RECORD = "daemon.json"  # what the running daemon says about itself: its pid, and where its key came from


def run_daemon(engine, state_dir, poll, wait=None, passes=None, record=None, watch=None, on_reload=None):
    """`run`: a pass on every poke, and at least every `poll` seconds, under the
    single-instance lock.

    The daemon waits on its poke socket with select, and drains every datagram
    before each pass, so a burst of events is one pass. A pass that raises is
    audited and the loop goes on; only a SimulatedCrash (or a signal) ends it.
    `wait(sock, timeout)` and `passes` are for tests and `--once`. `record` is written to daemon.json
    once the lock is held, with this pid: `status` reads it to say what the DAEMON has, not what the shell
    that runs `status` has.
    """
    wait = wait or wait_for_poke
    with single_instance(state_dir):
        if record is not None:
            _write_private(Path(state_dir) / DAEMON_RECORD,
                           json.dumps(dict(record, pid=os.getpid(), started_at=iso(engine.now())), sort_keys=True) + "\n")
        try:
            sock = open_poke_socket(state_dir)
        except OSError as err:  # no pokes then; the poll interval still passes
            sock = None
            engine._note("poke.unavailable", None, {"error": _one_line(str(err))})
        try:
            done = 0
            while True:
                drain_pokes(sock)
                if watch is not None and on_reload is not None and watch.check() == "reload":
                    on_reload(watch)  # does not return when the daemon re-executes itself
                try:
                    engine.run_pass()
                except Exception as err:
                    engine._failed(None, "pass", err, {"errors": []})
                done += 1
                if passes is not None and done >= passes:
                    return done
                timeout = next_poll(engine, poll)
                wait(sock, min(timeout, CONFIG_STABLE_SECONDS) if watch is not None and watch.pending else timeout)
        finally:
            if sock is not None:
                sock.close()


def run_lock_held(state_dir):
    """True when a daemon holds run.lock. Takes and drops the lock to find out."""
    fd = os.open(str(Path(state_dir) / "run.lock"), os.O_RDWR | os.O_CREAT, 0o600)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return True
        return False
    finally:
        os.close(fd)


def daemon_environment(environ):
    """The environment for a daemon started from a hook: herdr's server env
    minus the hook's own pane, which is whatever pane you had focused."""
    return {name: value for name, value in environ.items()
            if not name.startswith("HERDR_PLUGIN_")
            and name not in ("HERDR_PANE_ID", "HERDR_TAB_ID", "HERDR_WORKSPACE_ID")}


def spawn_daemon(state_dir, spawn=subprocess.Popen):
    """Start `run` in a session of its own, with none of the caller's pipes.

    herdr waits for EOF on a hook's stdout and stderr, and counts the hook as
    running until then; a daemon that kept them would hold a plugin slot for
    ever. Its output goes to $STATE/daemon.log, and setsid keeps it alive
    when herdr's hook runner is cleaned up.
    """
    log = os.open(str(Path(state_dir) / "daemon.log"), os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
    try:
        return spawn([sys.executable, os.path.realpath(__file__), "run"], stdin=subprocess.DEVNULL,
                     stdout=log, stderr=log, close_fds=True, start_new_session=True,
                     cwd=str(state_dir), env=daemon_environment(os.environ))
    finally:
        os.close(log)


@contextmanager
def ensure_lock(state_dir, patience, sleep=time.sleep):
    """Serialise concurrent `ensure` runs: a startup hook and a person at once."""
    fd = os.open(str(Path(state_dir) / "ensure.lock"), os.O_RDWR | os.O_CREAT, 0o600)
    try:
        waited = 0.0
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError:
                if waited >= patience:
                    raise LockError("another ensure is still starting the daemon") from None
                sleep(0.05)
                waited += 0.05
        yield
    finally:
        os.close(fd)


def ensure_daemon(state_dir, spawn=subprocess.Popen, patience=ENSURE_PATIENCE, sleep=time.sleep):
    """Make sure a daemon runs. Returns "running" or "started"; raises LockError
    when a started daemon did not take its lock within `patience` seconds."""
    with ensure_lock(state_dir, patience, sleep):
        if run_lock_held(state_dir):
            return "running"
        spawn_daemon(state_dir, spawn)
        waited = 0.0
        while not run_lock_held(state_dir):
            if waited >= patience:
                raise LockError("the daemon did not start within %gs; see %s" % (
                    patience, Path(state_dir) / "daemon.log"))
            sleep(0.05)
            waited += 0.05
        return "started"


# ----------------------------------------------------------------- launching

LAUNCH_PATIENCE = 30  # seconds for the new pane to show the v2 on the new session
NAME_RE = re.compile(r"^[a-z][a-z0-9_-]{0,31}$")  # herdr's own pattern for an agent name


class LaunchError(Exception):
    """A launch that did not finish, and what it left behind."""


def launch_problems(name, agent, directory, workspace, issue, charter=None):
    """Why these launch arguments cannot be used (empty when they can)."""
    problems = []
    if not NAME_RE.match(name or ""):
        problems.append("name must match %s (lower case, digits, - and _), got %r" % (NAME_RE.pattern, name))
    if not agent:
        problems.append("--agent is required")
    if not directory or not os.path.isabs(directory) or not os.path.isdir(directory):
        problems.append("--dir must be an absolute path of an existing directory, got %r" % directory)
    if not workspace:
        problems.append("no target workspace: pass --workspace or run from a herdr pane")
    if issue is not None and not (isinstance(issue, int) and not isinstance(issue, bool) and issue >= 1):
        problems.append("--issue must be an issue number, got %r" % (issue,))
    if charter is not None and not (isinstance(charter, int) and not isinstance(charter, bool) and charter >= 1):
        problems.append("--charter must be an issue number, got %r" % (charter,))
    return problems


def fleet_record(name, role, reports_to, issue, charter=None, repo=None):
    fleet = {"name": name, "role": role, "reports_to": reports_to, "issue": None if issue is None else int(issue),
             "charter": charter, "repo": repo}
    return {key: value for key, value in fleet.items() if value is not None}


def pane_problem(engine, pane, session_id):
    """None when `pane` shows the v2 TUI on `session_id`, else the first thing wrong.

    Positive evidence only: herdr names the agent and the session, and the
    pane's own process is the configured v2 executable. Anything unread or
    unclear is a problem, never a pass.
    """
    try:
        entry = engine.herdr.agent_get(pane)
        programs = [p.get("cmdline") for p in engine.herdr.pane_process_info(pane)]
    except HerdrError as err:
        return "herdr cannot say what pane %s shows yet: %s" % (pane, err)
    if entry.get("agent") != "opencode":
        return "herdr sees agent %r in pane %s, not opencode" % (entry.get("agent"), pane)
    if agent_session(entry) != session_id:
        return "pane %s shows session %s, not %s" % (pane, agent_session(entry), session_id)
    if not any(runs_program(cmdline, engine.executable) for cmdline in programs):
        return "pane %s runs %s, not the configured v2 %s" % (
            pane, _one_line("; ".join(str(c) for c in programs), 120) or "nothing", engine.executable)
    return None


def wait_until_verified(engine, pane, session_id, patience, sleep):
    deadline, problem = engine.now() + patience, None
    while True:
        problem = pane_problem(engine, pane, session_id)
        if problem is None:
            return
        if engine.now() >= deadline:
            raise LaunchError("could not verify the new pane: %s" % problem)
        sleep(1)


def close_own_pane(engine, name, pane, why):
    """Close the one pane this launch opened. Never anything else."""
    try:
        with engine._external("herdr.pane.close", name, {"pane": pane, "why": why}):
            engine.herdr.pane_close(pane)
        return "closed pane %s" % pane
    except Exception as err:  # the original failure matters more than this one
        return "could not close pane %s: %s" % (pane, _one_line(str(err)))


def send_brief(engine, name, session_id, brief):
    """The one place a brief is sent: a prompt whose metadata says it is the brief (`fleet.brief`), which is how a
    later run finds out it was sent."""
    with engine._external("v2.session.prompt", name, {"session": session_id, "brief_chars": len(brief)}):
        engine.v2.prompt(session_id, brief, {"fleet": {"from": "switchboard", "brief": True}})


BRIEF_SCAN_PAGES = 25  # pages of READ_LIMIT messages; a session this long is not one that never got its brief


def brief_in_transcript(engine, session_id):
    """Whether the session's transcript holds a message whose metadata says it is the brief. A listing too long to
    read to its end is taken to hold one: a duplicate brief in a long conversation does more harm than none."""
    more = None
    for page, more in engine.v2.message_pages(session_id, READ_LIMIT, max_pages=BRIEF_SCAN_PAGES):
        if any((_fleet_meta(message) or {}).get("brief") for message in page):
            return True
    return bool(more)


VIEW_ROLE_ENV = "FLEET_SWITCHBOARD_ROLE"  # PR 18: what the pane's TUI reads to pick its Decisions view
VIEW_REPO_ENV = "FLEET_SWITCHBOARD_REPO"


def view_env(role, repo):
    """The pane's environment that tells its TUI who it is (not secrets): the Decisions panel shows every tier and
    repo to the Chief of Staff, one repo to a pane that names it, the human tier to any other."""
    env = {}
    if isinstance(role, str) and role:
        env[VIEW_ROLE_ENV] = role
    if isinstance(repo, str) and repo:
        env[VIEW_REPO_ENV] = repo
    return env


def launch_agent(engine, name, agent, directory, workspace, role=None, reports_to=None, issue=None,
                 brief=None, patience=LAUNCH_PATIENCE, sleep=time.sleep, charter=None, repo=None):
    """Create a fleet agent: a v2 session, its own herdr tab, the brief.

    Nothing is typed. The tab's program is started by argv through herdr's
    socket, so no shell and no PATH decide which OpenCode runs. The brief is
    sent only after the pane is proved to run the configured v2 on the new
    session. A failure after the pane opened closes that pane, and no other.
    Returns {"name", "session", "pane", "tab"}.
    """
    problems = launch_problems(name, agent, directory, workspace, issue, charter)
    if problems:
        raise LaunchError("; ".join(problems))
    taken = engine.discover(engine.now()).agents.get(name)
    if taken is not None:
        raise LaunchError("a fleet agent named %s already runs in pane %s" % (name, taken.pane))
    fleet = fleet_record(name, role, reports_to, issue, charter, repo)
    env = dict(engine.config["opencode_env"], **engine.config["launch_env"])
    env.update(view_env(role, repo or (engine.config.get("intent_repo") if charter else None)))  # PR 18
    accounts = getattr(engine, "accounts", None)
    if repo and accounts is not None:  # PR 15: the agent works as its repo's gh account, and as nobody else
        problem = launch_account_problem(engine.config, accounts, repo)
        if problem:
            raise LaunchError(problem)
        try:
            env.update(accounts.token_env(repo))
        except AccountError as err:
            raise LaunchError(str(err)) from None
    with engine._external("v2.session.create", name, {"agent": agent, "directory": directory,
                                                      "fleet": fleet}) as result:
        session_id = engine.v2.session_create(agent, name, directory, {"fleet": fleet})["id"]
        result["session"] = session_id
    argv = [engine.config["opencode"], "-s", session_id]
    pane = None
    try:
        with engine._external("herdr.layout.apply", name, {
                "workspace": workspace, "label": name, "cwd": directory, "argv": argv,
                "env_names": sorted(env), "session": session_id}) as result:
            opened = engine.herdr.open_tab_running(workspace, name, directory, argv, env)
            pane = result["pane"] = opened["pane_id"]
            result["tab"] = opened["tab_id"]
        wait_until_verified(engine, pane, session_id, patience, sleep)
        if brief:
            send_brief(engine, name, session_id, brief)
    except Exception as err:
        left = close_own_pane(engine, name, pane, "launch failed: %s" % _one_line(str(err), 120)) if pane \
            else "no pane was opened"
        raise LaunchError("%s (session %s was created; %s)" % (_one_line(str(err)), session_id, left)) from err
    return {"name": name, "session": session_id, "pane": pane, "tab": opened["tab_id"]}


def resume_agent(engine, name, session_id, workspace, patience=LAUNCH_PATIENCE, sleep=time.sleep):
    """Open a new tab on a fleet agent's EXISTING session: a restart that keeps its conversation.

    The session must carry metadata.fleet.name == `name` (so a wrong id cannot start someone
    else's session under this name), and no pane may already run `name`. Nothing is created in
    v2 and no brief is sent; the pane is proved to run this session before this returns. A
    failure after the pane opened closes that pane and no other.
    """
    if not NAME_RE.match(name or "") or not workspace:
        raise LaunchError("resume needs a valid name and a target workspace (got name %r, workspace %r)"
                          % (name, workspace))
    session = engine.v2.session_get(session_id)
    fleet = (session.get("metadata") or {}).get("fleet") or {}
    directory = ((session.get("location") or {}).get("directory")) or session.get("directory")
    if fleet.get("name") != name:
        raise LaunchError("session %s belongs to %r, not %r: refusing to start it under this name"
                          % (session_id, fleet.get("name"), name))
    if not directory or not os.path.isabs(directory):
        raise LaunchError("session %s has no working directory to open the tab in" % session_id)
    taken = engine.discover(engine.now()).agents.get(name)
    if taken is not None:
        raise LaunchError("a fleet agent named %s already runs in pane %s: close it first" % (name, taken.pane))
    env = dict(engine.config["opencode_env"], **engine.config["launch_env"])
    env.update(view_env(fleet.get("role"), fleet.get("repo") or (engine.config.get("intent_repo")
                                                               if fleet.get("charter") else None)))  # PR 18
    argv = [engine.config["opencode"], "-s", session_id]
    pane = None
    try:
        with engine._external("herdr.layout.apply", name, {
                "workspace": workspace, "label": name, "cwd": directory, "argv": argv,
                "env_names": sorted(env), "session": session_id, "resume": True}) as result:
            opened = engine.herdr.open_tab_running(workspace, name, directory, argv, env)
            pane = result["pane"] = opened["pane_id"]
            result["tab"] = opened["tab_id"]
        wait_until_verified(engine, pane, session_id, patience, sleep)
    except Exception as err:
        left = close_own_pane(engine, name, pane, "resume failed: %s" % _one_line(str(err), 120)) if pane \
            else "no pane was opened"
        raise LaunchError("%s (session %s is untouched; %s)" % (_one_line(str(err)), session_id, left)) from err
    return {"name": name, "session": session_id, "pane": pane, "tab": opened["tab_id"]}


# ======================================================================
# PR 8: foreground and background
#
# One section, so the stack rebases cleanly. docs/switchboard.md,
# "Foreground and background". Registered in these places, one line each:
#   DEFAULTS            `classifier_mode` (below), checked by validate_foreground_config
#   validate_config     calls validate_foreground_config
#   fact_sources        adds ForegroundFacts
#   shadow_classify     enriches asks with their Intent (ask_intent) and hands
#                       an acting classification to note_decision
#   run_shadow_classifier  also runs when classifier_mode is "act"
#   build_parser, main  the `handoff` command
# The decoration is a fact like any other: it is delivered by the one delivery
# path, as a note, and the key in the transcript is what stops a repeat.
# ======================================================================

FOREGROUND_DEFAULTS = {
    # "shadow": the classifier only logs (PR 7). "act": it also decorates the
    # Chief of Staff's message, and tells it to hand off. SF1/SF2 decide when.
    "classifier_mode": "shadow",
    # Seconds between passes while a Chief of Staff is busy: your message is
    # consumed at its next step boundary (SF1), so the decoration must beat it.
    "busy_poll_seconds": 1,
}
DEFAULTS.update(FOREGROUND_DEFAULTS)
CLASSIFIER_MODES = ("shadow", "act")
DECORATION = "foreground.decoration"
COS_SUBAGENT = "cos-subagent"
SUBAGENT_AGENT = "cos-subagent"  # the OpenCode agent definition a background subagent runs
DECORATION_INTENT_LIMIT = 160    # characters of an Intent inside a decoration


def validate_foreground_config(config, source):
    mode = config["classifier_mode"]
    if mode not in CLASSIFIER_MODES:
        raise ConfigError("%s: 'classifier_mode' must be one of %s, got %r" % (source, ", ".join(CLASSIFIER_MODES), mode))
    busy = config["busy_poll_seconds"]
    if not _is_number(busy) or busy <= 0:
        raise ConfigError("%s: 'busy_poll_seconds' must be a positive number, got %r" % (source, busy))
    if mode == "act" and not config.get("jev"):
        raise ConfigError("%s: 'classifier_mode' \"act\" needs a 'jev' object: there is no decision model to ask" % source)


def chief_busy(engine):
    """True when the newest look found a chief-of-staff-role agent working: the daemon then polls fast."""
    found = getattr(engine, "discovery", None)
    return bool(found) and any(o.fleet.get("role") == "chief-of-staff" and o.status == "working"
                               for o in found.agents.values())


def next_poll(engine, poll):
    """Seconds to wait before the next pass: `busy_poll_seconds` while a Chief of Staff works (only
    when acting: shadow mode has no deadline), else `poll`."""
    if acting(engine) and chief_busy(engine):
        return min(poll, engine.config["busy_poll_seconds"])
    return poll


def inbox_human_prompts(engine, session_id):
    """Your steered prompts still waiting in v2's inbox (SF1: there within ~0.1 s, consumed at the
    next step boundary), as message-like records, newest first. Not yet seen by the model."""
    inbox = engine.v2.inbox_list(session_id)
    found = []
    for item in inbox if isinstance(inbox, list) else []:
        payload = item.get("payload") if isinstance(item, dict) and isinstance(item.get("payload"), dict) else {}
        if isinstance(item, dict) and item.get("type") == "user" and _fleet_meta(item) is None \
                and isinstance(payload.get("text"), str):
            found.append({"id": item.get("id"), "type": "user", "text": payload["text"], "time": item.get("time"),
                          "pending": True})
    return sorted(found, key=lambda m: _created(m) or 0, reverse=True)


def newest_prompts(engine, session_id):
    """Your prompts to a Chief of Staff, newest first: the inbox's (not yet consumed), then the transcript's."""
    return inbox_human_prompts(engine, session_id) + human_prompts(engine._messages(session_id))


def acting(engine):
    """True when the classifier's answers are acted on, not only logged."""
    return engine.config.get("classifier_mode") == "act" and engine.jev is not None


# ---- the asks, with their Intent

def ask_intent(engine, ask):
    """`ask` with its Intent and Done-when read from GitHub (IntentReader, cached).

    Unchanged when no reader is configured or GitHub cannot answer: a
    classification must not wait on, or fail for, an unreachable GitHub.
    """
    if not ask or engine.intents is None:
        return ask
    try:
        issue = engine.intents.issue(ask["issue"], ask.get("repo"))
    except IntentError:
        return ask
    return dict(ask, intent=issue.intent or ask.get("intent") or "", done_when=issue.done_when)


def ask_intents(engine, asks):
    return [ask_intent(engine, ask) for ask in asks]


# ---- the decoration's words (docs/switchboard.md, "Decorate" and "Hand off")

def owned_ask_text(ask):
    """The decoration for a message about an ask somebody else owns. The doc's own wording."""
    where = ""
    if ask.get("intent"):
        where = " (Intent: %s)" % _one_line(ask["intent"], DECORATION_INTENT_LIMIT)
    owner = ask.get("owner") or "its owner"
    return ("This is about ask %s%s. %s is working on it in the background. Send it anything relevant "
            "with: fleet-switchboard send %s --issue %s \"...\". Then continue with what you were doing."
            % (ask["issue"], where, owner, owner, ask["issue"]))


def handoff_text(current):
    """The decoration for something new while the Chief of Staff is busy."""
    ask = current or {}
    number = ask.get("issue") or "<the ask of your current work>"
    doing = ""
    if ask.get("intent"):
        doing = " (ask %s: %s)" % (ask["issue"], _one_line(ask["intent"], DECORATION_INTENT_LIMIT))
    return ("This is not about what you are working on%s, and you are busy with it. Hand it off first: write a short "
            "brief with Done so far, Next steps and Watch out for, and run: fleet-switchboard handoff --issue %s "
            "--brief-file -. A background subagent takes it over; then turn to this message."
            % (doing, number))


def decoration_for(choice, observation, current, asks):
    """(kind, ask, text) for the classification's answer, or None when nothing is added.

    current: nothing. An ask somebody owns: name it and its owner. Something
    new: hand off first when the Chief of Staff is busy, nothing when idle.
    """
    if choice == "current":
        return None
    if choice == "new":
        if observation.status != "working":
            return None
        return "handoff", current, handoff_text(current)
    ask = next((a for a in asks if str(a["issue"]) == choice), None)
    return ("owned", ask, owned_ask_text(ask)) if ask else None


# ---- the decoration as a fact

class ForegroundFacts:
    """`foreground.decoration:` facts for a Chief of Staff, derived on every call.

    The only memory is the classifier's answers, by message id, in this
    process; a restart classifies the newest message once more, and the key
    already in the transcript stops a second delivery (invariant 2). Nothing is
    stored on disk. A decoration holds only while it is true: the message is
    still your newest, still inside the engagement window, and (to hand off)
    the Chief of Staff is still busy.
    """

    __name__ = "foreground_facts"

    def __init__(self):
        self.engine = None
        self.decisions = {}  # session id -> the newest decision for it

    def bind(self, engine):
        self.engine = engine

    def record(self, observation, message, kind, ask, text):
        self.decisions[observation.session_id] = {
            "cos": observation.name, "session": observation.session_id, "message": message["id"],
            "created": _created(message), "kind": kind, "ask": ask, "text": text}

    def __call__(self):
        engine = self.engine
        discovery = getattr(engine, "discovery", None)
        if engine is None or discovery is None or not self.decisions:
            return []
        now, facts = engine.now(), []
        for session, decision in sorted(self.decisions.items()):
            if decision["created"] is None or now - decision["created"] > engine.engaged_seconds:
                del self.decisions[session]  # old news; a decoration is only for your newest message
                continue
            fact = self.fact(decision, discovery)
            if fact is not None:
                facts.append(fact)
        return facts

    def fact(self, decision, discovery):
        observation = discovery.agents.get(decision["cos"])
        if observation is None or observation.problem or observation.conflict \
                or observation.session_id != decision["session"]:
            return None
        if decision["kind"] == "handoff" and observation.status != "working":
            return None  # it has finished what it was doing: nothing left to hand off
        if not self.is_newest(decision):
            return None
        ask = decision["ask"] or {}
        issue = ask.get("issue") if decision["kind"] == "owned" else None
        return Fact("decoration:%s:%s" % (decision["session"], decision["message"]), decision["cos"], DECORATION,
                    decision["text"], decision["created"], issue=issue if _is_issue_number(issue) else None,
                    batch=False)

    def is_newest(self, decision):
        prompts = newest_prompts(self.engine, decision["session"])
        return bool(prompts) and prompts[0].get("id") == decision["message"]


def foreground_source(engine):
    return next((s for s in engine.sources if isinstance(s, ForegroundFacts)), None)


def note_decision(engine, observation, message, current, asks, answer):
    """An acting classification becomes a decoration, kept for the fact source. Audited either way."""
    found = decoration_for(answer["choice"], observation, current, asks)
    source = foreground_source(engine)
    detail = {"agent": observation.name, "message_id": message.get("id"), "choice": answer["choice"],
              "decoration": found[0] if found else None, "owner": (found[1] or {}).get("owner") if found else None}
    if found and source is None:
        detail["problem"] = "no foreground fact source is registered, so nothing can be delivered"
        found = None
    engine.audit.append(engine.actor, "foreground.decision", "decision:%s:%s" % (observation.session_id, message.get("id")),
                        detail)
    if found:
        source.record(observation, message, *found)
        if not message.get("pending"):  # the model already took your message: the decoration cannot ride with it
            engine.audit.append(engine.actor, "foreground.late", "decision:%s:%s" % (observation.session_id, message.get("id")),
                                {"agent": observation.name, "message_id": message.get("id"),
                                 "decoration": found[0], "age_seconds": round(engine.now() - (_created(message) or 0), 2)})


# ---- handoff: a brief, not a fork

class HandoffRefused(Exception):
    """A handoff that was refused before anything was written."""


BRIEF_LIMIT = 20000  # characters; a GitHub comment holds 65536
BRIEF_LABELS = ("goal", "done so far", "next steps", "watch out for")
_BRIEF_INLINE = re.compile(r"^\s{0,3}(?:#{1,6}\s+)?(?:[-*]\s+)?\**(%s)\**\s*:\**\s*(.*?)\s*$"
                           % "|".join(BRIEF_LABELS), re.IGNORECASE)
_BRIEF_HEADING = re.compile(r"^\s{0,3}#{1,6}\s+(%s)\s*#*\s*$" % "|".join(BRIEF_LABELS), re.IGNORECASE)
_BRIEF_TITLE = re.compile(r"^\s{0,3}#{1,6}\s+handoff\b", re.IGNORECASE)


def parse_brief(text):
    """{label: text} from a Chief of Staff's brief: sections named `Done so far:`, `Next steps:`,
    `Watch out for:` (and a `Goal:`, which the switchboard replaces). Anything else is refused,
    so no written word is silently dropped. Raises HandoffRefused."""
    if len(text) > BRIEF_LIMIT:
        raise HandoffRefused("the brief is %d characters; the limit is %d: say less, link more" % (len(text), BRIEF_LIMIT))
    sections, label, stray = {}, None, []
    for line in text.splitlines():
        found = _BRIEF_INLINE.match(line) or _BRIEF_HEADING.match(line)
        if found:
            label = found.group(1).lower()
            sections[label] = [found.group(2)] if found.lastindex == 2 and found.group(2) else []
        elif label is not None:
            sections[label].append(line)
        elif line.strip() and not _BRIEF_TITLE.match(line):
            stray.append(line.strip())
    if stray:
        raise HandoffRefused("the brief has text outside its sections (%s): put it under Done so far, Next steps "
                             "or Watch out for" % _one_line(stray[0], 80))
    parsed = {name: "\n".join(lines).strip() for name, lines in sections.items()}
    missing = [name.capitalize() for name in ("done so far", "next steps") if not parsed.get(name)]
    if missing:
        raise HandoffRefused("the brief has no %s: a subagent cannot continue from a brief without them"
                             % " and no ".join(missing))
    return parsed


def goal_line(issue):
    """Goal, from the ask's own Intent and Done-when: never retyped by the Chief of Staff."""
    line = issue.intent or NO_INTENT
    return "%s (Done when: %s)" % (line, issue.done_when) if issue.done_when else line


def handoff_markdown(issue, parsed):
    """The doc's handoff markdown for ask `issue` (an IssueIntent) and a parsed brief."""
    lines = ["## Handoff: ask %d" % issue.number, "Goal: %s" % goal_line(issue),
             "Done so far: %s" % parsed["done so far"], "Next steps: %s" % parsed["next steps"],
             "Watch out for: %s" % (parsed.get("watch out for") or "nothing noted")]
    return "\n".join(lines)


def post_ask_comment(engine, issue, body, author=None, repo=None):
    """Comment on the ask through the configured `gh`. The GitHub writes the switchboard makes: the handoff
    brief, so the record survives (docs: Hand off), and an agent's own comment (`comment`). Signed with
    the author's name when there is one, so it is never delivered back as an event. Audited before and after."""
    reader = engine.intents
    if author:
        body = body.rstrip("\n") + "\n\n" + fleet_mark(author)
    repo = repo or reader.repo
    path = "repos/%s/issues/%d/comments" % (repo, issue)
    subject = "issue:%d" % issue if repo == reader.repo else "issue:%s#%d" % (repo, issue)
    with engine._external("github.comment", subject, {"repo": repo, "issue": int(issue), "chars": len(body)}) as result:
        env = reader.env_for(repo)
        try:
            done = reader.runner([reader.gh, "api", path, "--method", "POST", "--input", "-"],
                                 input=json.dumps({"body": body}), capture_output=True, text=True,
                                 timeout=reader.timeout, **({"env": env} if env is not None else {}))
        except subprocess.TimeoutExpired:
            raise IntentError("unavailable", "gh did not answer within %ss" % reader.timeout) from None
        except OSError as err:
            raise IntentError("unavailable", "cannot run %s: %s" % (reader.gh, err.strerror or err)) from None
        if done.returncode != 0:
            detail = _one_line(done.stderr) or _one_line(done.stdout) or "exit %d" % done.returncode
            raise IntentError("gh", reader.accounts.scrub(detail) if reader.accounts else detail)
        try:
            posted = json.loads(done.stdout)
        except ValueError:
            posted = {}
        url = posted.get("html_url") if isinstance(posted, dict) else None
        result["url"] = url if isinstance(url, str) else None
    return result["url"]


def handoff_refusals(engine, issue, name, directory, workspace, agent, repo=None):
    """Why nothing may be written, found before anything is: the ask, the agent's name and place.
    Returns the ask (an IssueIntent)."""
    if engine.intents is None:
        raise HandoffRefused("'intent_repo' is not configured: a handoff fills Goal from the ask and posts "
                             "the brief on it")
    ask = engine.intents.issue(issue, repo)
    if ask.charter:
        raise HandoffRefused("#%d is a charter, not an ask: hand off an ask under it" % issue)
    if ask.state != "open":
        raise HandoffRefused("ask #%d is %s: there is nothing to hand off" % (issue, ask.state or "not open"))
    problems = launch_problems(name, agent, directory, workspace, issue)
    if problems:
        raise HandoffRefused("; ".join(problems))
    taken = engine.discover(engine.now()).agents.get(name)
    if taken is not None:
        raise HandoffRefused("a fleet agent named %s already runs in pane %s: send it what is new with "
                             "fleet-switchboard send %s --issue %d" % (name, taken.pane, name, issue))
    return ask


def subagent_prompt(caller, issue, markdown):
    return ("%s\n\nYou are a background subagent for %s. Report with: fleet-switchboard send %s --issue %d \"...\" "
            "when you reach the ask's Done when, or when you are stuck." % (markdown, caller, caller, issue))


def handoff_ask(engine, caller, issue, brief, name=None, directory=None, workspace=None, agent=SUBAGENT_AGENT,
                patience=LAUNCH_PATIENCE, sleep=time.sleep, repo=None):
    """The Chief of Staff's handoff: check, post the brief on the ask, launch the subagent. Returns a dict.

    Everything that can be refused is refused before the comment is posted.
    A launch that fails after the comment says so: the record stands.
    """
    explicit = issue_repo(issue)
    repo = repo or explicit
    issue = int(issue)
    # The subagent's own metadata names a repo only when the caller did, or when several repos are in play:
    # with one repo its metadata is what it always was.
    record = explicit or (repo if len(engine.repos_in_play()) > 1 else None)
    name = name or "cos-%d" % issue
    parsed = parse_brief(brief)
    ask = handoff_refusals(engine, issue, name, directory, workspace, agent, repo)
    markdown = handoff_markdown(ask, parsed)
    url = post_ask_comment(engine, issue, markdown, author=caller, repo=repo)
    try:
        done = launch_agent(engine, name, agent, directory, workspace, COS_SUBAGENT, caller, issue,
                            subagent_prompt(caller, issue, markdown), patience, sleep, repo=record)
    except LaunchError as err:
        raise LaunchError("the brief was posted on ask #%d, but the subagent did not start: %s" % (issue, err)) from err
    return dict(done, issue=issue, reports_to=caller, role=COS_SUBAGENT, comment=url,
                replaced_goal="goal" in parsed)


def cmd_handoff(args, runner, now, socket_call=None):
    workspace = args.workspace or os.environ.get("HERDR_WORKSPACE_ID")
    brief = read_brief(args.brief_file, sys.stdin)
    engine, _, _ = build_engine(runner, now, "cli", socket_call=socket_call)
    caller = identify_caller(engine.herdr, engine.v2, os.environ)
    try:
        repo, number = resolve_for_sender(engine, engine.config, args.issue, caller)
        done = handoff_ask(engine, caller, RepoIssue(number, issue_repo(args.issue)), brief, args.name,
                           args.dir or os.getcwd(), workspace, repo=repo)
    except (HandoffRefused, IssueRefError) as err:
        sys.stderr.write("%s: handoff refused: %s\n" % (PROG, err))
        return EXIT_USAGE
    if done.pop("replaced_goal"):
        sys.stderr.write("%s: the Goal line in your brief was replaced by the ask's own Intent and Done when\n" % PROG)
    print(json.dumps(done, sort_keys=True))
    return EXIT_OK


def cmd_comment(args, runner, now):
    """Post a comment as the calling agent, signed so the switchboard does not deliver it back."""
    engine, _, config = build_engine(runner, now, "cli")
    if engine.intents is None:
        raise ConfigError("'intent_repo' is not configured in %s: set it to OWNER/REPO" % config_path())
    body = read_brief(args.body_file, sys.stdin)
    if body is None:
        raise IntentError("usage", "--body-file is required (a file, or - for stdin)")
    caller = identify_caller(engine.herdr, engine.v2, os.environ)
    try:
        repo, number = resolve_for_sender(engine, config, args.issue, caller)
    except IssueRefError as err:
        sys.stderr.write("%s: %s\n" % (PROG, err))
        return EXIT_USAGE
    url = post_ask_comment(engine, number, body, author=caller, repo=repo)
    print(json.dumps({"issue": number, "author": caller, "comment": url}, sort_keys=True))
    return EXIT_OK


def cmd_whoami(args, runner, now):
    """The calling agent's fleet name: what the `gh` shim signs a comment with. Exit 1, silent on stdout,
    when the caller is not a fleet agent."""
    engine, _, _ = build_engine(runner, now, "cli", writable=False)
    print(identify_caller(engine.herdr, engine.v2, os.environ))
    return EXIT_OK


def add_foreground_parsers(sub):
    sub.add_parser("whoami", help="Print your fleet name (for scripts: the gh shim signs with it)")
    comment = sub.add_parser("comment", help="Comment on an issue as yourself, signed so it does not come back to "
                                             "you as an event")
    comment.add_argument("--issue", type=issue_arg, required=True, help="The issue to comment on")
    comment.add_argument("--body-file", dest="body_file", required=True, help="The comment: a file, or - for stdin")
    handoff = sub.add_parser("handoff", help="Hand your current work to a background subagent: post the brief on "
                                             "the ask and launch it, without typing")
    handoff.add_argument("--issue", type=issue_arg, required=True, help="The ask being handed off")
    handoff.add_argument("--brief-file", dest="brief_file", required=True,
                         help="The brief (Done so far, Next steps, Watch out for): a file, or - for stdin")
    handoff.add_argument("--name", help="The subagent's fleet name (default: cos-<issue>)")
    handoff.add_argument("--dir", help="The subagent's working directory (default: here)")
    handoff.add_argument("--workspace", help="The herdr workspace for its tab (default: $HERDR_WORKSPACE_ID)")


# ======================================================================
# Worker events, reminders and toasts (PR 4)
#
# Two fact sources, registered in fact_sources(): WorkerFacts derives "a worker
# finished" and "a worker is blocked" from herdr and v2 on every pass, and
# ReminderFacts turns the reminders file into facts once they are due. Neither
# stores anything about delivery. The only new state is reminders.json.
# Hooks into the engine: Switchboard.__init__ binds each source that has a
# `bind`, discover() keeps the newest Discovery, deliver() calls
# note_unreachable, render's toast candidates include source_toasts(), and
# run_pass() ends with finish_pass.
# ======================================================================

WORKER_IDLE = "worker.idle"
WORKER_BLOCKED = "worker.blocked"
WORKER_STOPPED = "worker.stopped"  # PR 13: a worker stopped without reporting and the boss must know
NUDGE = "nudge"                    # PR 13: the one reminder to a worker that stopped without reporting
REPORT = "report"
REPORT_ATTENTION = ("done", "failed", "blocked", "question")  # wake the boss when it is not engaged
REPORT_PROGRESS = ("working", "paused", "withdrawn")          # riders: carried, never the reason for a message
REPORT_STATES = REPORT_ATTENTION + REPORT_PROGRESS
WITHDRAW_ALL = decision_core.WITHDRAW_ALL  # leads a `withdrawn` report made with --all: it clears every open question of the worker
REPORT_MAX = 300  # characters: a report is a sentence; detail goes on GitHub
SUMMARY_CAP = 600  # characters of a worker's last reply in its fact
LAB_WORKER_SINCE_ENV = "FLEET_SWITCHBOARD_LAB_WORKER_SINCE"
REMINDERS = "reminders.json"
REMINDER_LOCK = "reminders.lock"
REMINDER_UNITS = {"s": 1, "m": 60, "h": 3600, "d": 86400}


def worker_horizon(config, now):
    """The oldest `idle_at` that still counts: `worker_lookback_hours` back, so a
    restart does not resurface ancient completions. In the Lab, the environment
    may name a later start (LAB_WORKER_SINCE_ENV, epoch seconds), so the warm-up
    turns that precede a play are not news; it is ignored outside the Lab."""
    horizon = now - config["worker_lookback_hours"] * 3600
    raw = os.environ.get(LAB_WORKER_SINCE_ENV) if os.environ.get(LAB_ENV) == "1" else None
    if raw:
        try:
            horizon = max(horizon, float(raw))
        except ValueError:
            raise FactError("%s must be epoch seconds, got %r" % (LAB_WORKER_SINCE_ENV, raw)) from None
    return horizon


def reply_text(message):
    """The text of one v2 assistant message: `text`, or its text parts."""
    if not isinstance(message, dict):
        return ""
    text = message.get("text")
    if not isinstance(text, str):
        parts = message.get("content") if isinstance(message.get("content"), list) else []
        text = " ".join(part.get("text", "") for part in parts
                        if isinstance(part, dict) and isinstance(part.get("text"), str))
    return text


def _issue_of(fleet):
    issue = fleet.get("issue") if isinstance(fleet, dict) else None
    return issue if isinstance(issue, int) and not isinstance(issue, bool) and issue >= 1 else None


def _boss_of(observation):
    """Who a worker reports to, or None when it reports to nobody (or to itself)."""
    boss = observation.fleet.get("reports_to")
    return boss if isinstance(boss, str) and boss and boss != observation.name else None


class WorkerFacts:
    """Facts about workers (fleet agents that have a `reports_to`), derived on every call.

    `worker.idle:<session>:<idle_at ms>`: its turn ended (herdr says idle, v2's
    `time.idle` is set and within the look-back). For its `reports_to`.
    `worker.blocked:<session>:<request id>`: herdr says blocked, and v2 lists a
    pending permission request or form. For its `reports_to`; the human also
    gets a toast (see `toasts`).
    Nothing is stored: the same state gives the same facts (invariant 1).
    """

    __name__ = "worker_facts"

    def __init__(self):
        self.engine = None
        self._blocked = []       # toasts of the last call: (agent, reason, title, body)
        self.requests = []       # PR 14: the pending requests of every blocked agent in the last call (decisions)
        self._summaries = {}     # (session, idle ms) -> text; a cache, rebuilt after a restart
        self._stops = {}         # (session, idle ms) -> the facts of that stop (PR 13); a cache, rebuilt likewise
        self._no_forms = False   # v2 does not know the form operation (UNVERIFIED name)

    def bind(self, engine):
        self.engine = engine

    def toasts(self):
        return list(self._blocked)

    def __call__(self):
        self._blocked, self.requests = [], []
        engine = self.engine
        discovery = getattr(engine, "discovery", None)
        if engine is None or discovery is None or fault("no-worker-source"):
            return []
        horizon = worker_horizon(engine.config, engine.now())
        facts = []
        for observation in sorted(discovery.agents.values(), key=lambda o: o.name):
            boss = _boss_of(observation)
            if observation.conflict or observation.problem:
                continue
            try:
                if boss is not None:
                    facts.extend(self.finished(observation, boss, horizon))
                facts.extend(self.blocked(observation, boss))
            except V2Error as err:  # one worker's trouble never hides the others
                engine._note("source.error", "worker_facts:" + observation.name, {"error": _one_line(str(err))})
        return facts

    def finished(self, observation, boss, horizon):
        """The facts of one worker's finished turn. PR 13: a bare idle is a rider; whether the boss must hear
        about the stop is `stop_facts`'s question."""
        if observation.status != "idle" or observation.idle_at is None or observation.idle_at < horizon:
            return []
        idle_ms = int(round(observation.idle_at * 1000))
        key = "%s:%s:%d" % (WORKER_IDLE, observation.session_id, idle_ms)
        head = "%s finished its turn (%s)" % (observation.name, observation.outcome or "no outcome recorded")
        reply = self.last_reply(observation.session_id, idle_ms)
        idle = Fact(key, boss, WORKER_IDLE, head + (": " + reply if reply else ""), observation.idle_at,
                    issue=_issue_of(observation.fleet), sender=observation.name, rider=not fault("idle-wakes"))
        return self.stop_facts(observation, boss, idle_ms, idle, reply)

    def stop_facts(self, observation, boss, idle_ms, idle, reply):
        """The facts for one stop, worked out once (a stop is asked about once; the cache is rebuilt after a
        restart). The idle rider, plus a nudge for the worker, or instead a `worker.stopped` for the boss."""
        memo = (observation.session_id, idle_ms)
        engine = self.engine
        if memo in self._stops:
            return list(self._stops[memo])
        if engine.audit is None:
            return [idle]  # a read-only look never asks the decision model
        verdict = triage_stop(engine, self, observation, boss, idle_ms, reply)
        if verdict is None:
            found = [idle]   # reported, not worth asking, or not readable: only the rider
        elif verdict["outcome"] == "stopped":
            found = [Fact("%s:%s:%d" % (WORKER_STOPPED, observation.session_id, idle_ms), boss, WORKER_STOPPED,
                          "%s stopped without reporting (%s)%s" % (
                              observation.name, observation.outcome or "no outcome recorded",
                              ": " + reply if reply else ""), observation.idle_at,
                          issue=_issue_of(observation.fleet), sender=observation.name)]
        elif verdict["outcome"] == "nudge":
            found = [idle, verdict["nudge"]]
        else:
            found = [idle]
        if len(self._stops) > 500:
            self._stops.clear()
        self._stops[memo] = list(found)
        return found

    def last_reply(self, session_id, idle_ms):
        """The worker's last assistant reply, cut to SUMMARY_CAP; read once per turn."""
        cached = self._summaries.get((session_id, idle_ms))
        if cached is not None:
            return cached
        page = self.engine.v2.message_list(session_id, limit=1, type="assistant")
        text = _one_line(reply_text(page[0]) if isinstance(page, list) and page else "", SUMMARY_CAP)
        if len(self._summaries) > 500:
            self._summaries.clear()
        self._summaries[(session_id, idle_ms)] = text
        return text

    def blocked(self, observation, boss):
        """The facts for a blocked worker's pending requests. PR 14: every blocked agent's requests are read and
        kept in `requests` (a boss with no boss of its own waits on you too); only a worker has a fact."""
        if observation.status != "blocked":
            return []
        facts = []
        for kind, items in (("permission", self.engine.v2.permission_list(observation.session_id)),
                            ("question", self.pending_forms(observation))):
            for item in items if isinstance(items, list) else []:
                if isinstance(item, dict) and isinstance(item.get("id"), str) and item["id"]:
                    self.requests.append((observation, kind, item))
                    if boss is not None:
                        facts.append(self.blocked_fact(observation, boss, kind, item))
        return facts

    def pending_forms(self, observation):
        if self._no_forms:
            return []
        try:
            return self.engine.v2.form_list(observation.session_id)
        except V2Error as err:
            if err.reason == "http" and err.status == 404:
                self._no_forms = True  # this v2 has no such operation; stop asking
                return []
            raise

    def blocked_fact(self, observation, boss, kind, item):
        key = "%s:%s:%s" % (WORKER_BLOCKED, observation.session_id, item["id"])
        what = " ".join(str(part) for part in [item.get("action") or item.get("title") or kind]
                        + [r for r in item.get("resources") or [] if isinstance(r, str)])
        asked = _created(item)  # when v2 says it asked; without it the fact is urgent, not batched
        summary = "%s is blocked on a %s request and cannot go on until you answer it: %s" % (
            observation.name, kind, _one_line(what, 200))
        if isinstance(item.get("message"), str) and item["message"].strip():
            summary += " (reason given: %s)" % _one_line(item["message"], 200)
        issue = _issue_of(observation.fleet)
        repo = _fleet_repo(observation.fleet, self.engine.config) if issue else None  # PR 15: the issue's repo
        # A hook's message (PR 9: the policy judge's reason) is on the request as `message`: say it first.
        note = _one_line(item["message"], 120) if isinstance(item.get("message"), str) else ""
        shown = "%s (%s)" % (note, _one_line(what, 60)) if note else what
        self._blocked.append((observation.name, key, "Fleet: %s is blocked" % observation.name,
                              _one_line("%s is waiting for you: %s%s" % (
                                  observation.name, shown,
                                  " (issue %s)" % issue_tag(repo, issue, self.engine.repos_in_play()) if issue else ""), 200)))
        return Fact(key, boss, WORKER_BLOCKED, summary, asked if asked is not None else self.engine.now(),
                    issue=issue, batch=asked is not None, sender=observation.name, repo=repo)


# ---- PR 13: workers report, and a stop without a report is triaged
#
# docs/switchboard.md, "Workers report (PR 13)". A worker tells its boss with `fleet-switchboard report`. A
# worker whose turn ends without a report since its latest assigning input is an unreported stop: the decision
# model is asked `report_owed`, and the answer nudges the worker once, stays silent, or (a second stop, or no
# answer) wakes the boss with one `worker.stopped`. Everything here is derived from transcripts, nothing stored.

REPORT_OWED_ID = "report_owed"
REPORT_OWED_TEXT = ("Did this turn end with work done, blocked, failed or needing a decision that the boss has "
                    "not been told about?")
REPORT_TRIAGE_DEFAULTS = {
    "owed_threshold": 0.5,  # the probability at which the answer is "owed": the worker is nudged
    "budget_seconds": 3,    # the longest the decision model may take for one stop; no answer fails open
}
NUDGE_TEXT = ("You stopped without telling %s. If your work is done, failed, blocked or needs a decision, run: "
              "%s report <state> \"one line\". If nothing changed since your last report, say nothing.")


def validate_report_triage_config(config, source):
    raw = config.get("report_triage")
    if raw is None:
        config["report_triage"] = dict(REPORT_TRIAGE_DEFAULTS)
        return
    if not isinstance(raw, dict):
        raise ConfigError("%s: 'report_triage' must be an object, got %r" % (source, type(raw).__name__))
    unknown = sorted(set(raw) - set(REPORT_TRIAGE_DEFAULTS))
    if unknown:
        raise ConfigError("%s: 'report_triage' contains key(s) this tool does not read: %s (known: %s)"
                          % (source, ", ".join(unknown), ", ".join(REPORT_TRIAGE_DEFAULTS)))
    settings = dict(REPORT_TRIAGE_DEFAULTS, **raw)
    if not _is_number(settings["owed_threshold"]) or not 0 < settings["owed_threshold"] <= 1:
        raise ConfigError("%s: 'report_triage.owed_threshold' must be a number above 0 and at most 1, got %r"
                          % (source, settings["owed_threshold"]))
    if not _is_number(settings["budget_seconds"]) or settings["budget_seconds"] <= 0:
        raise ConfigError("%s: 'report_triage.budget_seconds' must be a positive number, got %r"
                          % (source, settings["budget_seconds"]))
    config["report_triage"] = settings


REPORT_LOOKUP_WAIT = 3.0   # seconds a report waits to learn whether its issue exists; slower is accepted


class ReportError(Exception):
    """A report that cannot be made: an unknown state, no line, a line too long, a caller with no boss."""


def report_owed_questions():
    """The one question, by id: a yes/no `noul` like the policy judge's."""
    return {REPORT_OWED_ID: {"type": "noul", "instructions": REPORT_OWED_TEXT,
                             "criteria": {"true": "The turn ended with something the boss has not been told: "
                                                  "work done, blocked, failed, or a decision needed.",
                                          "false": "Nothing happened that the boss needs to hear, or it was "
                                                   "already reported."}}}


def report_owed_state(role, intent, done_when, last_reply, boss):
    return {"role": role or "unknown", "boss": boss, "intent": _clip(intent or "not stated: no ask is recorded", 600),
            "done_when": _clip(done_when or "not stated", 400), "last_reply": _clip(last_reply, 800)}


def assigning_input(engine, observation, boss):
    """(message id, created) of the newest message in the worker's transcript that assigned it work, or None.

    Assigning: a prompt (yours, the fleet's task, or the brief `launch` sent), or a message from its boss
    (`send`, a handoff). Not assigning: a GitHub notice, a decoration, a reminder, a nudge, a toast, a
    report from one of its own workers. Newest first, within READ_LIMIT messages."""
    for message in engine._messages(observation.session_id):
        if not isinstance(message, dict):
            continue
        if message.get("type") == "user" or (
                message.get("type") == "synthetic"
                and any(key.startswith("send:%s:" % boss) for key in _fleet_keys(message))):
            created = _created(message)
            return (message.get("id"), created) if message.get("id") and created is not None else None
    return None


def report_jev(engine, settings):
    """The decision model for triage: the engine's, with a shorter timeout (its budget). None when none is set."""
    base = engine.config.get("jev")
    if not base:
        return None
    capped = dict(base, timeout_seconds=min(base["timeout_seconds"], settings["budget_seconds"]))
    return build_jev(dict(engine.config, jev=capped))


def triage_stop(engine, source, observation, boss, idle_ms, reply):
    """What an unreported stop calls for: None (reported, too old, or not readable: only the idle rider), or
    {"outcome": "nudge", "nudge": Fact} / {"outcome": "silent"} / {"outcome": "stopped"}. Audited once."""
    now = engine.now()
    if now - observation.idle_at > engine.config["rider_max_age_seconds"]:
        return None  # a stop that old is not news, and a nudge would be late
    boss_view = engine.discovery.agents.get(boss) if engine.discovery else None
    if boss_view is None:  # the boss cannot be read, so nothing can be said to have been reported: tell it (held)
        verdict = {"outcome": "stopped", "reason": "the boss %s is not running, so its transcript cannot show a report" % boss}
        try:
            engine.audit.append(engine.actor, "report.triage", "stop:%s:%d" % (observation.session_id, idle_ms), {
                "worker": observation.name, "boss": boss, "session": observation.session_id, "idle_ms": idle_ms,
                "question": None, "answer": None, "latency_ms": 0, "outcome": "stopped", "reason": verdict["reason"]})
        except OSError:
            pass
        return verdict
    assigned = assigning_input(engine, observation, boss)
    if assigned is None:
        return None
    assigned_id, assigned_at = assigned
    keys, complete = engine.delivered_keys(boss_view.session_id, assigned_at - SINCE_SLACK)
    prefix = "%s:%s:" % (REPORT, observation.name)
    if not fault("ignore-reports") and any(
            key.startswith(prefix) and (keys.at.get(key) is None or keys.at[key] >= assigned_at) for key in keys):
        return None  # it reported since it was last given work: this stop is only a rider
    if not complete:
        return None  # the read did not reach back far enough to say it did not report
    nudge_key = "%s:%s:%s" % (NUDGE, observation.session_id, assigned_id)
    if fault("no-nudge-once"):
        nudge_key += ":%d" % idle_ms  # the fault: every stop is a first stop
    worker_keys, _ = engine.delivered_keys(observation.session_id, assigned_at - SINCE_SLACK)
    sent_at = worker_keys.at.get(nudge_key) if nudge_key in worker_keys else None
    audit = {"worker": observation.name, "boss": boss, "session": observation.session_id, "ask": _issue_of(observation.fleet),
             "assigned": assigned_id, "idle_ms": idle_ms, "question": None, "answer": None, "latency_ms": 0,
             "model": None, "usage": {}, "error": None}
    if nudge_key in worker_keys:
        if sent_at is not None and observation.idle_at < sent_at:
            return None  # this is the stop the nudge answered, not a second one
        verdict = {"outcome": "stopped", "reason": "nudged already for this assignment and stopped again "
                                                   "without reporting"}
    else:
        verdict = ask_report_owed(engine, observation, boss, reply, audit)
        if verdict["outcome"] == "nudge":
            verdict["nudge"] = Fact(
                nudge_key, observation.name, NUDGE, NUDGE_TEXT % (boss, PROG), observation.idle_at,
                issue=_issue_of(observation.fleet), batch=False, sender="switchboard")
    audit["outcome"], audit["reason"] = verdict["outcome"], verdict["reason"]
    try:
        engine.audit.append(engine.actor, "report.triage", "stop:%s:%d" % (observation.session_id, idle_ms), audit)
    except OSError:
        pass  # the audit is best effort here, as the judge's is: a full disk must not hide a stopped worker
    return verdict


def ask_report_owed(engine, observation, boss, reply, audit):
    """Ask `report_owed`. {"outcome": "nudge" | "silent" | "stopped", "reason"}; fails open to "stopped"."""
    settings = engine.config["report_triage"]
    questions = report_owed_questions()
    ask = ask_intent(engine, _ask_of(observation.fleet, observation.name)) or {}
    state = report_owed_state(observation.fleet.get("role"), ask.get("intent"), ask.get("done_when"), reply, boss)
    audit["question"] = {"state": state, "ids": list(questions)}
    failure = None
    try:
        jev = report_jev(engine, settings)
        if jev is None:
            failure = "no decision model is configured"
        else:
            result = jev.decide(state, questions)
            audit.update(latency_ms=result["latency_ms"], model=result["model"], usage=result["usage"])
            owed = result["answers"][REPORT_OWED_ID]["noul"]
            audit["answer"] = {REPORT_OWED_ID: owed}
    except JevError as err:
        failure = "decision model unavailable (%s)" % err.reason
        audit.update(latency_ms=err.latency_ms or 0, error=_one_line(str(err), 160))
    if failure:
        if fault("no-fail-open"):
            return {"outcome": "silent", "reason": failure + "; the fault keeps quiet"}
        return {"outcome": "stopped", "reason": failure + ": the boss is told"}
    if owed >= settings["owed_threshold"]:
        return {"outcome": "nudge", "reason": "owed at %.2f, threshold %.2f" % (owed, settings["owed_threshold"])}
    return {"outcome": "silent", "reason": "owed at %.2f, below %.2f" % (owed, settings["owed_threshold"])}


# ---- progress reports: riders that wait for a message to ride in

REPORT_RIDERS = "report-riders.json"
REPORT_RIDER_LOCK = "report-riders.lock"


@contextmanager
def report_riders_lock(state_dir):
    fd = os.open(str(Path(state_dir) / REPORT_RIDER_LOCK), os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)


def read_report_riders(state_dir):
    path = Path(state_dir) / REPORT_RIDERS
    try:
        raw = json.loads(path.read_text())
    except FileNotFoundError:
        return []
    except (OSError, ValueError) as err:
        raise ReminderError("cannot read %s: %s" % (path, err)) from None
    items = raw.get("riders") if isinstance(raw, dict) else None
    if not isinstance(items, list):
        raise ReminderError("%s must hold {\"riders\": [...]}" % path)
    for item in items:
        if not (isinstance(item, dict) and isinstance(item.get("key"), str) and isinstance(item.get("to"), str)
                and _is_number(item.get("created")) and isinstance(item.get("summary"), str)):
            raise ReminderError("%s has a rider without key, to, created and summary: %r" % (path, item))
    return items


def write_report_riders(state_dir, items):
    """Replace the file atomically, mode 0600 (the way reminders.json is written)."""
    path = Path(state_dir) / REPORT_RIDERS
    temp = path.with_name("%s.%d.tmp" % (REPORT_RIDERS, os.getpid()))
    fd = os.open(str(temp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        with os.fdopen(fd, "w") as handle:
            json.dump({"riders": items}, handle, indent=1, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(str(temp), str(path))
    except BaseException:
        try:
            os.unlink(str(temp))
        except OSError:
            pass
        raise


class ReportRiderFacts:
    """The progress reports (`working`, `paused`) that no message has carried yet, as rider facts.

    A progress report is the one thing `report` stores: it must wait for a message to ride in, and a CLI
    process cannot wait. It stays in report-riders.json until its key shows in the boss's transcript or inbox,
    or it is older than `rider_max_age_seconds` (prune_report_riders)."""

    __name__ = "report_rider_facts"

    def __init__(self, state_dir):
        self.state_dir, self.engine = Path(state_dir), None

    def bind(self, engine):
        self.engine = engine

    def entries(self):
        return read_report_riders(self.state_dir)

    def __call__(self):
        return [Fact(item["key"], item["to"], REPORT, item["summary"], item["created"], issue=item.get("issue"),
                     batch=False, sender=item.get("from"), rider=True, repo=item.get("repo")) for item in self.entries()]


def _report_rider_source(engine):
    return next((source for source in engine.sources if isinstance(source, ReportRiderFacts)), None)


def record_report_rider(engine, fact):
    source = _report_rider_source(engine)
    if source is None:
        raise ReportError("this engine has nowhere to keep a progress report")
    item = {"key": fact.key, "to": fact.recipient, "created": fact.created, "summary": fact.summary,
            "issue": fact.issue, "from": fact.sender}
    if fact.repo:
        item["repo"] = fact.repo
    with report_riders_lock(source.state_dir):
        write_report_riders(source.state_dir, read_report_riders(source.state_dir) + [item])
    if engine.audit is not None:
        engine.audit.append(engine.actor, "report.rider", fact.recipient, {"key": fact.key, "from": fact.sender})


def report_rider_facts(engine):
    source = _report_rider_source(engine)
    return source() if source is not None else []


def prune_report_riders(engine, discovery):
    """Forget the progress reports a message has carried, and those too old to be carried. Returns the keys."""
    source = _report_rider_source(engine)
    if source is None:
        return []
    items = source.entries()
    by_recipient = {}
    for item in items:
        by_recipient.setdefault(item["to"], []).append(item)
    gone = {item["key"] for item in items if engine.now() - item["created"] > engine.config["rider_max_age_seconds"]
            and not is_withdrawal(item["summary"])}
    for name, mine in sorted(by_recipient.items()):
        observation = discovery.agents.get(name)
        if observation is None:
            continue
        try:
            keys, _ = engine.delivered_keys(observation.session_id, min(i["created"] for i in mine) - SINCE_SLACK)
        except V2Error:
            continue
        gone.update(item["key"] for item in mine if item["key"] in keys)
    if gone:
        with report_riders_lock(source.state_dir):
            write_report_riders(source.state_dir, [i for i in read_report_riders(source.state_dir)
                                                   if i["key"] not in gone])
        if engine.audit is not None:
            engine.audit.append(engine.actor, "report.prune", None, {"keys": sorted(gone)})
    return sorted(gone)


# ======================================================================
# PR 14: Decisions, a read-only list of what waits on you
#
# docs/switchboard.md, "Decisions (PR 14)". The list is derived on every pass from facts that already
# exist and is never the source of truth (invariant 1): the issues that carry your awaiting-user label
# (the hub's picture, kept by webhook events and the catch-up read), the pending permission requests and
# questions of every fleet agent (WorkerFacts already reads them), and the `question` and `blocked`
# reports a boss has been sent and nobody has answered. The daemon writes it to $STATE/decisions.json
# when it changes, a disposable projection: deleting the file loses nothing and the next pass makes it
# again. `fleet-switchboard decisions` and the TUI plugin only read the file.
# ======================================================================

DECISIONS_FILE = "decisions.json"
DECISIONS_STALE_SECONDS = 120   # a file this old (by mtime, which every pass refreshes) is not current
DECISION_TITLE_MAX = decision_core.DECISION_TITLE_MAX
DECISION_REPORT_TITLE_MAX = decision_core.DECISION_REPORT_TITLE_MAX
DECISION_SOURCES = ("github", "v2", "reports")
REPORT_LINE = decision_core.REPORT_LINE   # the line shapes of a delivered report and send: the module's, with the rules that read them
SEND_LINE = decision_core.SEND_LINE


def repo_of_tag(tag, repos):
    return decision_core.repo_of_tag(tag, repos)


def validate_decisions_config(config, source):
    label = config["awaiting_label"]
    if label is not None and (not isinstance(label, str) or not label.strip() or "\n" in label or "," in label):
        raise ConfigError("%s: 'awaiting_label' must be a label name without a comma or a newline, or null (the "
                          "default, `<OS user>:awaiting-user`), got %r" % (source, label))
    hours = config["decisions_lookback_hours"]
    if not _is_number(hours) or hours <= 0:
        raise ConfigError("%s: 'decisions_lookback_hours' must be a positive number, got %r" % (source, hours))
    cos_label = config["awaiting_cos_label"]
    if cos_label is not None and (not isinstance(cos_label, str) or not cos_label.strip() or "\n" in cos_label
                                  or "," in cos_label):
        raise ConfigError("%s: 'awaiting_cos_label' must be a label name without a comma or a newline, or null (the "
                          "default, `<OS user>:awaiting-cos`), got %r" % (source, cos_label))
    if cos_label is not None and cos_label == label:
        raise ConfigError("%s: 'awaiting_cos_label' and 'awaiting_label' must differ, both are %r" % (source, label))
    grace = config["decisions_cos_grace_seconds"]
    if not _is_number(grace) or grace < 0:
        raise ConfigError("%s: 'decisions_cos_grace_seconds' must be a number of seconds, 0 or more, got %r"
                          % (source, grace))
    hold = config["pr_notice_hold_minutes"]
    if not _is_number(hold) or hold < 0:
        raise ConfigError("%s: 'pr_notice_hold_minutes' must be a number of minutes, 0 (no hold, the default) or "
                          "more, got %r" % (source, hold))
    orders = config["cos_orders_file"]
    if orders is not None and (not isinstance(orders, str) or not os.path.isabs(orders)):
        raise ConfigError("%s: 'cos_orders_file' must be an absolute path, or null (the default, standing-orders.md "
                          "beside config.json), got %r" % (source, orders))


def _decision_number(seed):
    return decision_core.decision_number(seed)


def assign_decision_ids(items, repos=None):
    """The id of each decision in `items`, in the same order (the rules are decision_core.assign_ids's). The Lab's
    `bare-issue-number` fault is read here, not by the module."""
    return decision_core.assign_ids(items, repos, bare_issue_number=fault("bare-issue-number"))


def decision_repos(engine):
    """Every repo being watched now (the derived set, as the hub's): the baseline, the repos of the live agents
    and of the charters they hold. Not the config's list alone, and not the intent repo alone."""
    return watched_repos(engine.config, discovered_fleets(engine.discovery))


# ---- a batch: related findings raised as ONE decision (one issue, one `decision-rows` block in its body)

BATCH_FENCE = decision_core.BATCH_FENCE
BATCH_ROWS_MAX = decision_core.BATCH_ROWS_MAX            # rows one batch may carry (the panel draws one line or two per row)
BATCH_REF_MAX, BATCH_FINDING_MAX, BATCH_REC_MAX = (decision_core.BATCH_REF_MAX, decision_core.BATCH_FINDING_MAX,
                                                   decision_core.BATCH_REC_MAX)
BATCH_TITLE_MAX = decision_core.BATCH_TITLE_MAX
BatchError = decision_core.BatchError
_ROWS_BLOCK = decision_core._ROWS_BLOCK
_ROW_REF = decision_core._ROW_REF


def short_ref_of(ref):
    return decision_core.short_ref_of(ref)


def parse_batch_row(line):
    return decision_core.parse_batch_row(line)


def row_repo(ref):
    return decision_core.row_repo(ref)


def row_of(ref, finding, rec):
    return decision_core.row_of(ref, finding, rec)


def parse_decision_rows(body):
    return decision_core.parse_decision_rows(body)


def batch_headline(title, count):
    return decision_core.batch_headline(title, count)


def batch_body(name, rows):
    lines = "\n".join("%s | %s | %s" % (r["ref"], r["finding"], r["recommendation"]) for r in rows)
    return ("Related findings raised as ONE decision (%d rows) by %s. Each row is `<issue> | <finding> | <recommendation>`; "
            "one answer (`as recommended`, or per-row changes) answers every row. Nothing here changes the row "
            "issues: the raising orchestrator acts on the answer.\n\n```%s\n%s\n```\n\n%s"
            % (len(rows), name, BATCH_FENCE, lines, fleet_mark(name)))


def decisions_from_github(engine, now):
    """(items, problems): the open issues with your label, from the hub's picture. No `gh` call is made here."""
    if not decision_repos(engine):
        return [], []
    hub = engine.hub
    if hub is None:
        return [], ["GitHub is read by the daemon: this process holds no hub, so the issues that wait on you "
                    "are not listed"]
    records, problems = hub.awaiting_listing()
    agents = engine.discovery.agents if engine.discovery is not None else {}
    items = []
    for record in records:
        numbers = [record["number"]] + ([record["parent"]] if record.get("parent") else [])
        items.append({"kind": "issue", "title": record["title"] or "issue #%d" % record["number"],
                      "ask": record["number"], "agent": pick_owner(agents, numbers, record["repo"]),
                      "since": record["since"], "seed": "issue:%s#%d" % (record["repo"], record["number"]),
                      "bare": True, "repo": record["repo"], "tier": record.get("tier") or "human",
                      "rows": record.get("rows") or [], "raised_by": record.get("raised_by")})
    return items, problems


def decisions_from_requests(engine, now):
    """(items, problems): the pending permission requests and questions of every fleet agent, as WorkerFacts read them.

    PR 18: a request is the Chief of Staff's (`cos`) until it has been pending `decisions_cos_grace_seconds`, or
    until the Chief of Staff escalated it (`decisions escalate`, escalated-requests.json); then it is yours. An
    agent blocked on a prompt is never hidden from you for good."""
    source = next((s for s in engine.sources if isinstance(s, WorkerFacts)), None)
    if source is None:
        return [], []
    items, seen = [], {}
    grace = engine.config["decisions_cos_grace_seconds"]
    escalated = read_escalated(engine.state_dir) if engine.state_dir is not None else {}
    for observation, kind, request in source.requests:
        key = (observation.session_id, request["id"])
        what = " ".join(str(part) for part in [request.get("action") or request.get("title") or kind]
                        + [r for r in request.get("resources") or [] if isinstance(r, str)])
        asked = _created(request)
        seen[key] = asked if asked is not None else engine.decision_seen.get(key, now)
        ask = _issue_of(observation.fleet)
        tier = decision_core.request_tier(now, seen[key], grace, "%s:%s" % key in escalated)
        items.append({"kind": kind, "title": "%s: %s" % (kind, what), "ask": ask,
                      "repo": _fleet_repo(observation.fleet, engine.config),
                      "agent": observation.name, "since": seen[key],
                      "seed": "request:%s:%s" % key, "bare": False, "tier": tier,
                      "session": observation.session_id, "request": request["id"]})
    engine.decision_seen = seen  # memory only: a request with no time of its own keeps the first time it was seen
    engine.request_keys = {"%s:%s" % key for key in seen}
    return items, []


# ---- PR 18: a request the Chief of Staff escalated to you

ESCALATED_FILE = "escalated-requests.json"
ESCALATED_LOCK = "escalated-requests.lock"


@contextmanager
def escalated_lock(state_dir):
    fd = os.open(str(Path(state_dir) / ESCALATED_LOCK), os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)


def read_escalated(state_dir):
    """{"<session>:<request id>": iso time} of the permission requests and questions the Chief of Staff escalated.
    A DISPOSABLE file, not a second source of truth: it only moves a request that is still pending from `cos` to
    `human` a little before the grace period would, and it is pruned to the requests pending now. Missing,
    unreadable or malformed reads as empty: the request is then yours when the grace period has run out."""
    try:
        raw = json.loads((Path(state_dir) / ESCALATED_FILE).read_text())
    except (OSError, ValueError):
        return {}
    found = raw.get("requests") if isinstance(raw, dict) else None
    return {k: v for k, v in found.items() if isinstance(k, str) and isinstance(v, str)} if isinstance(found, dict) else {}


def write_escalated(state_dir, requests):
    path = Path(state_dir) / ESCALATED_FILE
    temp = path.with_name("%s.%d.tmp" % (ESCALATED_FILE, os.getpid()))
    fd = os.open(str(temp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        with os.fdopen(fd, "w") as handle:
            json.dump({"requests": requests}, handle, indent=1, sort_keys=True)
            handle.write("\n")
        os.replace(str(temp), str(path))
    except BaseException:
        try:
            os.unlink(str(temp))
        except OSError:
            pass
        raise


def mark_escalated(state_dir, key, when):
    with escalated_lock(state_dir):
        found = read_escalated(state_dir)
        found[key] = iso(when)
        write_escalated(state_dir, found)


def prune_escalated(state_dir, pending):
    """Forget every escalation of a request that is no longer pending (the daemon's, once a pass)."""
    if pending is None or not (Path(state_dir) / ESCALATED_FILE).exists():
        return
    with escalated_lock(state_dir):
        found = read_escalated(state_dir)
        kept = {k: v for k, v in found.items() if k in pending}
        if kept != found:
            write_escalated(state_dir, kept)


def synthetic_lines(engine, session_id, since, waiting=False):
    """The lines of a session's synthetic messages since `since`: [(created, message id, line number, line)],
    newest message first. The one read of what a message said, shared by both report checks.

    `waiting` (the worker's side: the sends that answer a report) adds the notes still in v2's inbox, first. A note
    delivered to a session that is busy or engaged with a person waits there and is in no transcript until its
    next turn: it counts as delivered, as everywhere else (`_fleet_keys`), or a report answered by such a send would
    stay open. The inbox is read every time (one small read; it is not in the cache, because it changes without the
    transcript's newest id changing). The boss's side (the reports) stays the transcript's: a report is listed once
    the boss has it."""
    found = transcript_lines(engine, session_id, since)
    if not waiting:
        return found
    inbox = engine.v2.inbox_list(session_id)  # an inbox that cannot be read raises: the caller says so, it is not guessed
    have = {line[1] for line in found}
    waiting = []
    for item in inbox if isinstance(inbox, list) else []:
        payload = item.get("payload") if isinstance(item, dict) and isinstance(item.get("payload"), dict) else {}
        created = _created(item) if isinstance(item, dict) else None
        if not isinstance(item, dict) or item.get("type") != "synthetic" or item.get("id") in have \
                or created is None or created < since or not isinstance(payload.get("text"), str):
            continue
        waiting.extend((created, item.get("id"), number, line) for number, line in enumerate(payload["text"].splitlines()))
    return sorted(waiting, key=lambda line: -line[0]) + found


def transcript_lines(engine, session_id, since):
    """The transcript's synthetic lines since `since`, newest message first (cached by the newest synthetic id)."""
    newest = engine.v2.message_list(session_id, limit=1, type="synthetic")  # one small read per pass
    newest_id = newest[0].get("id") if isinstance(newest, list) and newest and isinstance(newest[0], dict) else None
    cached = engine.synthetic_cache.get(session_id)
    if cached is not None and cached[0] == newest_id and cached[1] <= since:
        return [line for line in cached[2] if line[0] >= since]  # nothing new since the last full read
    found, complete = [], False
    for page, more in engine.v2.message_pages(session_id, READ_LIMIT, "synthetic", MAX_READ_PAGES):
        for message in page:
            created = _created(message) if isinstance(message, dict) else None
            if created is None:
                continue
            if created < since:
                complete = True
                break
            for number, line in enumerate(reply_text(message).splitlines()):
                found.append((created, message.get("id"), number, line))
        if complete or not more:
            break
    if len(engine.synthetic_cache) > 200:
        engine.synthetic_cache.clear()
    engine.synthetic_cache[session_id] = (newest_id, since, found)  # memory only, rebuilt after a restart
    return found


COS_ALIAS = "chief-of-staff"   # what a worker's reports_to says when it was launched with the role name


class BossProblem(str):
    """A problem line that names the boss it is about (#80): the sync freezes only that boss's reports."""

    boss = None


def resolve_boss(discovery, name):
    """The registered agent a `reports_to` names. The role name `chief-of-staff` is an alias for the one agent whose
    role is chief-of-staff, whatever it is registered as (`cos`); any other name, or an alias with no single
    registered chief of staff, is taken literally."""
    if name in discovery.agents or name != COS_ALIAS:
        return name
    found = [n for n, o in discovery.agents.items() if (o.fleet or {}).get("role") == COS_ALIAS]
    return found[0] if len(found) == 1 else name


def decisions_from_reports(engine, now):
    """(items, problems): `question` and `blocked` reports delivered to a boss that nobody has answered.

    A report is answered when the boss has since sent that worker something on the same ask (a `send` with no
    issue counts for any ask: the worker has one), or the worker has since reported again on that ask."""
    discovery = engine.discovery
    if discovery is None:
        return [], []
    if discovery.problems:
        raise RuntimeError("the fleet cannot be read: %s" % "; ".join(discovery.problems))
    since = now - engine.config["decisions_lookback_hours"] * 3600
    bosses = sorted({resolve_boss(discovery, _boss_of(o)) for o in discovery.agents.values() if _boss_of(o)})
    repos = decision_repos(engine)
    items, problems, sends, unread = [], [], {}, {}
    for boss in bosses:
        observation = discovery.agents.get(boss)
        if observation is None or observation.problem:
            problem = BossProblem("cannot read what was reported to %s: %s" % (
                boss, observation.problem if observation else "it is not running"))
            problem.boss = boss
            problems.append(problem)
            continue
        reports = []
        for created, message_id, number, line in synthetic_lines(engine, observation.session_id, since):
            match = REPORT_LINE.match(line)
            if match:
                sender = discovery.agents.get(match.group(1))
                issue = int(match.group(3)) if match.group(3) else None
                reports.append({"at": (created, number), "message": message_id, "sender": match.group(1),
                                "issue": issue, "state": match.group(4), "text": match.group(5), "boss": boss,
                                "repo": (repo_of_tag(match.group(2), repos)
                                         or (_fleet_repo(sender.fleet, engine.config) if sender else None)),
                                "session": observation.session_id})
        # a withdrawal is a rider: no message has carried it into the transcript yet, but it already counts
        for item in (source.entries() if (source := _report_rider_source(engine)) is not None else []):
            state, _, text = item["summary"].partition(": ")
            sender = discovery.agents.get(item.get("from"))
            if resolve_boss(discovery, item["to"]) == boss and state == "withdrawn" and item["created"] >= since and sender is not None:
                reports.append({"at": (item["created"], 1 << 60), "message": item["key"], "sender": sender.name,
                                "issue": item.get("issue"), "state": state, "text": text, "boss": boss,
                                "repo": item.get("repo") or _fleet_repo(sender.fleet, engine.config), "session": None})
        reports.sort(key=lambda r: r["at"])
        for report in reports:
            if report["state"] not in ("question", "blocked") or report["sender"] not in discovery.agents:
                continue  # not a decision, or the worker that asked no longer runs: no one is waiting
            worker = report["sender"]
            if worker not in unread:
                try:
                    if not fault("decision-resolves-never") and report_answered(engine, report, reports, since, sends):
                        continue
                except (V2Error, RuntimeError) as err:
                    # one worker's unreadable inbox or transcript: its reports stay listed (not answered), the error is
                    # shown once, and every other worker is unaffected
                    unread[worker] = _one_line(str(err), 150)
                    problems.append(unread[worker] if unread[worker].startswith("cannot read what %s" % worker)
                                    else "cannot read what %s was sent: %s" % (worker, unread[worker]))
            title = report["text"] if report["state"] == "question" else "%s: %s" % (report["state"], report["text"])
            if worker in unread:
                considered = "could not read what %s was sent (%s): listed as not answered" % (worker, unread[worker])
            else:
                considered = considered_send(engine, report, repos, since, sends)
            above = _boss_of(discovery.agents[report["boss"]])  # PR 18: a boss that has no boss is the Chief of Staff
            items.append({"kind": "report", "title": title, "ask": report["issue"], "agent": report["sender"],
                          "repo": report["repo"], "tier": decision_core.report_tier(bool(above)),
                          "since": report["at"][0], "bare": False, "boss": report["boss"],
                          "seed": "report:%s:%s:%d" % (report["session"], report["message"], report["at"][1]),
                          "considered": considered})
    return items, problems


def considered_send(engine, report, repos, since, sends):
    """One line saying, for a report still open, the newest send from its boss to its worker that the check looked
    at and why it did not answer, or that there was none (`decisions --fresh` prints it). Stable from pass to pass,
    so it never rewrites decisions.json by itself."""
    worker = engine.discovery.agents[report["sender"]]
    if worker.name not in sends:
        sends[worker.name] = synthetic_lines(engine, worker.session_id, since, waiting=True)
    newest = None
    for created, message_id, _, line in sends[worker.name]:
        match = SEND_LINE.match(line)
        if match and match.group(1) == report["boss"] and (newest is None or created > newest[0]):
            newest = (created, match, message_id)
    who = "%s to %s" % (report["boss"], worker.name)
    if newest is None:
        return "no send from %s in the last %g hours" % (who, engine.config["decisions_lookback_hours"])
    created, match, message_id = newest
    admitted = message_id in {line[1] for line in transcript_lines(engine, worker.session_id, since)}
    tag = "%s#%s" % (match.group(2) or "", match.group(3)) if match.group(3) else "no issue"
    if created <= report["at"][0]:
        why = "older than this report"
    elif match.group(3) and report["issue"] is not None and (int(match.group(3)) != report["issue"]
                             or repo_of_tag(match.group(2), repos) not in (None, report["repo"])):
        why = "tagged %s, not this ask" % tag
    else:
        why = "should answer it"
    return "newest send from %s: %s, %s, %s, %s" % (who, iso(created), tag,
                                                    "admitted" if admitted else "queued in the inbox", why)


def report_answered(engine, report, reports, since, sends):
    """True when the report is answered (the rules are decision_core's: a later report of the worker, or a send of
    the boss on the ask). `sends` caches one read of each worker's transcript per derivation. The sends are read
    only when no later report answers, as before, and an unreadable worker raises here."""
    if decision_core.answered_by_later_report(report, reports):
        return True
    worker = engine.discovery.agents[report["sender"]]
    if worker.problem:
        raise RuntimeError("cannot read what %s was sent: %s" % (worker.name, worker.problem))
    if worker.name not in sends:
        sends[worker.name] = synthetic_lines(engine, worker.session_id, since, waiting=True)
    return decision_core.answered_by_send(report, sends[worker.name], decision_repos(engine))


# ---- the readable headline of a decision (the panel shows this; `title` stays for older readers)

HEADLINE_WIDTH = decision_core.HEADLINE_WIDTH   # the Decisions panel's ROW_WIDTH (plugins/fleet-decisions-tui/decisions.mjs); a test keeps them equal
HEADLINE_LINES = decision_core.HEADLINE_LINES
_URL = decision_core._URL
_GITHUB_REF = decision_core._GITHUB_REF
_ISSUE_URL = decision_core._ISSUE_URL
_SHORT_REF = decision_core._SHORT_REF


def short_refs(text):
    return decision_core.short_refs(text)


def _wrap_count(words, width):
    return decision_core.wrap_count(words, width)


def fit_lines(text, width=HEADLINE_WIDTH, lines=HEADLINE_LINES):
    return decision_core.fit_lines(text, width, lines)


def headline_of(item, issue_title):
    return decision_core.headline_of(item, issue_title)


def cached_issue_title(engine, repo, number, listed):
    """The title of issue `repo#number` from what the daemon already holds, never a new `gh` read: an open decision's
    own title (the hub's picture), else the intent reader's cached issue (any age). None when neither knows it."""
    if (repo, number) in listed:
        return listed[(repo, number)] or None
    reader = getattr(engine, "intents", None)
    hit = reader._cache.get(("issue", repo, number)) if reader is not None and repo else None
    found = hit[1] if hit else None
    return (getattr(found, "title", None) or None)


def named_issues(text, repo, wanted):
    return decision_core.named_issues(text, repo, wanted)


# ---- PR notices: a heads-up that an orchestrator opened (or means to merge) a PR

PR_NOTICES = "pr-notices.json"
PR_NOTICES_LOCK = "pr-notices.lock"
PR_FACTS_TTL = 60                 # seconds a PR's facts (or a failed read) are kept before `gh pr view` runs again
PR_NOTICE_PASS_BUDGET = 15        # seconds one pass may spend reading notices' PRs; the rest wait for the next pass
PR_NOTICE_UNREADABLE_DAYS = 7     # a notice whose PR cannot be read this long is dropped
PR_VIEW_FIELDS = "title,state,additions,deletions,changedFiles,statusCheckRollup,reviewDecision,mergeable,headRefOid,body,author,reviews,comments"
_PR_SHORT = re.compile(r"^([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)#([0-9]+)$")
_PR_URL = re.compile(r"^https?://github\.com/([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)/(pull|issues)/([0-9]+)(?:[/?#].*)?$")


class NoticeError(Exception):
    """A PR notice that cannot be recorded or read."""


def parse_pr_ref(text):
    """`owner/repo#N` or a PR URL -> (repo, number). Raises NoticeError for anything that is not a PR."""
    text = (text or "").strip()
    found = _PR_SHORT.match(text)
    if found and int(found.group(2)) >= 1:
        return found.group(1), int(found.group(2))
    url = _PR_URL.match(text)
    if url and int(url.group(3)) >= 1:
        if url.group(2) != "pull":
            raise NoticeError("%s is an issue, not a pull request: `notice pr` takes a PR" % _one_line(text, 120))
        return url.group(1), int(url.group(3))
    raise NoticeError("%r is not a pull request: write owner/repo#N or the PR's URL" % _one_line(text, 120))


@contextmanager
def pr_notices_lock(state_dir):
    fd = os.open(str(Path(state_dir) / PR_NOTICES_LOCK), os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)


def read_pr_notices(state_dir):
    path = Path(state_dir) / PR_NOTICES
    try:
        raw = json.loads(path.read_text())
    except FileNotFoundError:
        return []
    except (OSError, ValueError) as err:
        raise NoticeError("cannot read %s: %s" % (path, err)) from None
    items = raw.get("notices") if isinstance(raw, dict) else None
    if not isinstance(items, list):
        raise NoticeError("%s must hold {\"notices\": [...]}" % path)
    for item in items:
        if not (isinstance(item, dict) and isinstance(item.get("repo"), str) and isinstance(item.get("number"), int)
                and _is_number(item.get("created"))):
            raise NoticeError("%s has a notice without repo, number and created: %r" % (path, item))
    return items


def write_pr_notices(state_dir, items):
    """Replace the file atomically, mode 0600 (the way report-riders.json is written)."""
    path = Path(state_dir) / PR_NOTICES
    temp = path.with_name("%s.%d.tmp" % (PR_NOTICES, os.getpid()))
    fd = os.open(str(temp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        with os.fdopen(fd, "w") as handle:
            json.dump({"notices": items}, handle, indent=1, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(str(temp), str(path))
    except BaseException:
        try:
            os.unlink(str(temp))
        except OSError:
            pass
        raise


NOTICE_SENDERS_MAX = 20  # distinct senders kept per notice


def notice_senders(item):
    """Every distinct agent that sent this notice (kept across re-sends); an old record has only `from`."""
    found = item.get("senders")
    names = [n for n in (found if isinstance(found, list) else []) if isinstance(n, str) and n]
    if isinstance(item.get("from"), str) and item["from"] and item["from"] not in names:
        names.append(item["from"])
    return names[-NOTICE_SENDERS_MAX:]


def record_pr_notice(state_dir, repo, number, sender, note, now, boss=None):
    """Record (or refresh) the notice of `repo#number`. A re-send keeps the first time (the hold window runs from
    it) and replaces the note and the sender. Returns (item, refreshed)."""
    with pr_notices_lock(state_dir):
        items = read_pr_notices(state_dir)
        old = next((i for i in items if i["repo"] == repo and i["number"] == number), None)
        item = {"repo": repo, "number": number, "from": sender, "note": note,
                "created": old["created"] if old else now, "refreshed": now}
        senders = notice_senders(old) if old else []
        item["senders"] = [n for n in senders if n != sender][-(NOTICE_SENDERS_MAX - 1):] + ([sender] if sender else [])
        boss = boss or (old or {}).get("boss")
        if boss:  # PR 52: who the sender reports to, so a PR whose sender is gone still reaches someone
            item["boss"] = boss
        if old and old.get("unreadable_since") is not None:
            item["unreadable_since"] = old["unreadable_since"]
        write_pr_notices(state_dir, [i for i in items if i is not old] + [item])
    return item, old is not None


def apply_notice_effects(engine):
    """The daemon's end of a pass: forget the notices whose PR is merged, closed or unreadable for good, and note
    when a PR became unreadable (or readable again). Writes only on a change; a failure is tried again next pass."""
    effects = engine.notice_effects
    if engine.state_dir is None or engine.audit is None or not (effects["drop"] or effects["unreadable"]):
        return False
    try:
        with pr_notices_lock(engine.state_dir):
            items = read_pr_notices(engine.state_dir)
            kept = []
            for item in items:
                key = "%s#%d" % (item["repo"], item["number"])
                if key in effects["drop"]:
                    continue
                if key in effects["unreadable"]:
                    item = dict(item)
                    if effects["unreadable"][key] is None:
                        item.pop("unreadable_since", None)
                    else:
                        item["unreadable_since"] = effects["unreadable"][key]
                kept.append(item)
            if kept != items:
                write_pr_notices(engine.state_dir, kept)
                return True
    except (OSError, NoticeError):
        pass
    return False


def pr_ci_of(rollup):
    """`green`, `failing`, `pending` or `none` from gh's statusCheckRollup (check runs and status contexts)."""
    if not isinstance(rollup, list) or not rollup:
        return "none"
    failing = ("FAILURE", "TIMED_OUT", "CANCELLED", "ACTION_REQUIRED", "STARTUP_FAILURE", "ERROR")
    pending = False
    for check in rollup:
        if not isinstance(check, dict):
            continue
        verdict = str(check.get("conclusion") or check.get("state") or "").upper()
        if verdict in failing:
            return "failing"
        if check.get("status") not in (None, "COMPLETED") or verdict in ("PENDING", "EXPECTED", ""):
            pending = True
    return "pending" if pending else "green"


CAPTAIN_MARK = "MERGE: captain"


def pr_is_captain(body):
    """True when the body's FIRST non-empty line starts with `MERGE: captain`. Nothing else of the body is read."""
    if not isinstance(body, str):
        return False
    first = next((l.strip() for l in body.splitlines() if l.strip()), "")
    return first.startswith(CAPTAIN_MARK) and not re.match(r"\w", first[len(CAPTAIN_MARK):len(CAPTAIN_MARK) + 1])


def pr_login(user):
    login = user.get("login") if isinstance(user, dict) else None
    return login if isinstance(login, str) and login else None


def pr_reviews_at(reviews, head, author):
    """[{"by", "state"}] of the reviews by someone other than the author at exactly `head` (pending and dismissed
    ones are not reviews); None when that cannot be told (no list, no head, no author): review not detectable."""
    if not isinstance(reviews, list) or not head or not author:
        return None
    found = {}
    for review in reviews:
        if not isinstance(review, dict):
            return None
        by, state = pr_login(review.get("author")), str(review.get("state") or "").upper()
        commit = review.get("commit")
        oid = commit.get("oid") if isinstance(commit, dict) else None
        if by is None or oid is None:
            return None
        if oid == head and by != author and state in ("APPROVED", "CHANGES_REQUESTED", "COMMENTED"):
            found[by] = state.lower().replace("_", " ")  # the latest review of each reviewer wins
    return [{"by": by, "state": state} for by, state in sorted(found.items())]


CAPTAIN_NO_REVIEW_SECONDS = 2 * 3600  # a captain PR with no review seen is a decision anyway this long after its notice
PR_COMMENTS_READ = 50       # the last comments read for review evidence
PR_COMMENT_CLIP = 20000     # characters of one comment searched
CAPTAIN_EVIDENCE_MAX = 5    # signed reviewers listed in a decision
PLACEHOLDER_SIGNERS = {"agent", "name", "none", "null", "unknown", "nobody", "anonymous", "you", "me", "x", "todo"}


def pr_signed_at(comments, head):
    """The agent names that signed (`<!-- fleet-switchboard:from=NAME -->`) one of the last PR_COMMENTS_READ comments
    naming `head` as a whole token (all 40 characters, or a prefix of at least 7). Only the signature and the token
    are read, never shown. None when the comments cannot be read (no list, no head)."""
    if not isinstance(comments, list) or not head:
        return None
    found = set()
    for comment in comments[-PR_COMMENTS_READ:]:
        body = comment.get("body") if isinstance(comment, dict) else None
        if not isinstance(body, str):
            continue
        body = body[:PR_COMMENT_CLIP]
        mark = FLEET_MARK.search(body)
        if mark is None or mark.group(1).lower() in PLACEHOLDER_SIGNERS:
            continue
        if any(head.lower().startswith(t) for t in re.findall(r"(?<![0-9A-Za-z])([0-9a-f]{7,40})(?![0-9A-Za-z])", body.lower())):
            found.add(mark.group(1))
    return sorted(found)


def captain_evidence(facts, senders):
    """[{"by", "kind": review|comment, "state"}] of the review of a `MERGE: captain` PR at its exact head: formal
    reviews by a non-author, plus signed comments naming the head whose signer is not a sender of the PR's notice.
    None when there is none and a source could not be read (review not detectable)."""
    evidence = [dict(r, kind="review") for r in facts.get("reviews") or []]
    for who in (facts.get("signed") or []):
        if who not in senders and who != facts.get("author") and all(e["by"] != who for e in evidence):
            evidence.append({"by": who, "kind": "comment", "state": "signed comment"})
    if evidence:
        return evidence[:CAPTAIN_EVIDENCE_MAX]
    return None if facts.get("reviews") is None or facts.get("signed") is None else []


def pr_facts_from(data):
    """The facts the panel shows, from `gh pr view --json` output; NoticeError when it is not one."""
    if not isinstance(data, dict) or not isinstance(data.get("state"), str):
        raise NoticeError("gh answered something that is not a pull request")
    review = {"APPROVED": "approved", "CHANGES_REQUESTED": "changes requested"}.get(
        str(data.get("reviewDecision") or "").upper(), "none")

    def count(name):
        value = data.get(name)
        return value if isinstance(value, int) and not isinstance(value, bool) else None
    head = data.get("headRefOid") if isinstance(data.get("headRefOid"), str) else None
    return {"title": " ".join(str(data.get("title") or "").split()), "state": data["state"].lower(),
            "captain": pr_is_captain(data.get("body")), "author": pr_login(data.get("author")),
            "reviews": pr_reviews_at(data.get("reviews"), head, pr_login(data.get("author"))),
            "signed": pr_signed_at(data.get("comments"), head),
            "additions": count("additions"), "deletions": count("deletions"), "files": count("changedFiles"),
            "ci": pr_ci_of(data.get("statusCheckRollup")), "review": review,
            # PR 52: a conflict is `mergeable` CONFLICTING, found in the read a notice already costs; the head
            # commit is what makes it one event per push
            "mergeable": str(data.get("mergeable") or "").upper() or None,
            "head": head}


def read_pr_facts(engine, repo, number):
    """ONE `gh pr view` of the PR, with the repo's configured account (gh_users). The hub's picture holds the PR's
    title, size and state only (not checks or review), so it cannot answer this on its own. Raises NoticeError."""
    config = engine.config
    accounts = getattr(engine, "accounts", None) or GhAccounts(config, engine.gh_runner or subprocess.run, engine.now)
    try:
        env = accounts.env_for(repo)
    except AccountError as err:
        raise NoticeError(str(err)) from None
    extra = {"env": env} if env is not None else {}
    argv = [config["gh"], "pr", "view", str(number), "--repo", repo, "--json", PR_VIEW_FIELDS]
    try:
        done = (engine.gh_runner or subprocess.run)(argv, capture_output=True, text=True,
                                                    timeout=min(config["call_timeout_seconds"],
                                                                GITHUB_ROUTE_READ_TIMEOUT),
                                                    stdin=subprocess.DEVNULL, **extra)
    except (OSError, subprocess.SubprocessError) as err:
        raise NoticeError("gh pr view %s#%d: %s" % (repo, number, accounts.scrub(_one_line(str(err), 120)))) from None
    if done.returncode != 0:
        raise NoticeError("gh pr view %s#%d failed: %s" % (repo, number, accounts.scrub(
            _one_line(done.stderr or "", 160)) or "exit %d" % done.returncode))
    try:
        return pr_facts_from(json.loads(done.stdout or ""))
    except ValueError:
        raise NoticeError("gh pr view %s#%d answered something that is not JSON" % (repo, number)) from None


def notice_facts(engine, repo, number, now, budget=None):
    """{facts, stale, error} for one notice: read at most once per PR_FACTS_TTL seconds (a failed read too), the
    last good facts kept and marked stale when a read fails. `budget` is a one-item list of seconds this pass may
    still spend reading; when it is spent the read is skipped (stale, "skipped": True, not cached) until next pass."""
    key = "%s#%d" % (repo, number)
    held = engine.notice_facts.get(key)
    if held is not None and now - held["at"] < PR_FACTS_TTL:
        return held
    if budget is not None and budget[0] <= 0:
        return {"at": 0, "facts": held["facts"] if held else None, "stale": True, "skipped": True,
                "error": "not read this pass: the notice reads' time budget is spent"}
    started = engine.now()
    try:
        held = {"at": now, "facts": read_pr_facts(engine, repo, number), "stale": False, "error": None}
    except NoticeError as err:
        held = {"at": now, "facts": held["facts"] if held else None, "stale": True, "error": _one_line(str(err), 200)}
    if budget is not None:
        budget[0] -= max(0, engine.now() - started)
    engine.notice_facts[key] = held
    return held


def facts_text(entry):
    """The facts of a notice entry as one line: `+120/-14, 5 files, CI green, approved` (what the panel draws)."""
    parts = []
    if entry.get("additions") is not None and entry.get("deletions") is not None:
        parts.append("+%d/-%d" % (entry["additions"], entry["deletions"]))
    if entry.get("files") is not None:
        parts.append("%d file%s" % (entry["files"], "" if entry["files"] == 1 else "s"))
    if entry.get("ci"):
        parts.append("CI %s" % entry["ci"] if entry["ci"] != "none" else "no CI")
    if entry.get("review"):
        parts.append(entry["review"] if entry["review"] != "none" else "no review")
    return ", ".join(parts)


def decisions_from_notices(engine, now):
    """(entries, problems): each recorded PR notice as an entry of kind `notice` (tier `human`, id `pr:<repo>#N`).

    Not a decision, so not counted with them. The facts come from `gh pr view`, cached; a PR that is merged or
    closed is not listed and is queued in engine.notice_effects for the daemon to forget; one that cannot be read
    keeps its last facts, marked stale, and is dropped (and logged) after PR_NOTICE_UNREADABLE_DAYS."""
    engine.notice_effects = {"drop": set(), "unreadable": {}}
    state_dir = getattr(engine, "state_dir", None)
    if state_dir is None:
        return [], []
    try:
        items = read_pr_notices(state_dir)
    except NoticeError as err:
        return [], [str(err)]
    hold = engine.config.get("pr_notice_hold_minutes") or 0
    escalated = read_escalated(state_dir)
    names = [r.split("/")[-1] for r in decision_repos(engine)] + [i["repo"].split("/")[-1] for i in items]
    entries = []
    budget = [PR_NOTICE_PASS_BUDGET]
    order = lambda i: (i["created"], i["repo"], i["number"])
    # the least recently read go first, so a PR that hangs cannot starve the others of the budget
    seen = lambda i: engine.notice_facts.get("%s#%d" % (i["repo"], i["number"]), {"at": 0})["at"]
    for item in sorted(items, key=lambda i: (seen(i),) + order(i)):
        repo, number = item["repo"], item["number"]
        key = "%s#%d" % (repo, number)
        held = notice_facts(engine, repo, number, now, budget)
        facts = held["facts"]
        if facts is not None and facts["state"] in ("merged", "closed"):
            engine.notice_effects["drop"].add(key)
            continue
        since = item.get("unreadable_since")
        if held.get("skipped"):
            pass  # not read this pass: neither readable nor unreadable, so the unreadable clock is left alone
        elif held["stale"]:
            if since is None:
                engine.notice_effects["unreadable"][key] = iso(now)
            elif now - (parse_iso(since) or now) >= PR_NOTICE_UNREADABLE_DAYS * 86400:
                engine.notice_effects["drop"].add(key)
                engine._note("notice.dropped", key, {"reason": "unreadable for %d days" % PR_NOTICE_UNREADABLE_DAYS,
                                                     "error": held["error"]})
                continue
        elif since is not None:
            engine.notice_effects["unreadable"][key] = None
        name = repo.split("/")[-1]
        tag = repo if names.count(name) > 1 else name
        entry = decision_core.notice_entry(repo, number, tag, facts or {}, held["stale"], item.get("from"),
                                           item["created"], item.get("note"), hold)
        evidence = captain_evidence(facts, set(notice_senders(item))) if facts and facts.get("captain") else []
        if evidence == [] and now - item["created"] >= CAPTAIN_NO_REVIEW_SECONDS:
            pass  # nothing stalls silently: the notice's own clock (a new head does not restart it) lists it
        elif evidence == []:
            evidence = False
        if facts and facts.get("captain") and facts.get("head") and evidence is not False:
            # a `MERGE: captain` PR is the Chief of Staff's decision, in place of the heads-up (never both)
            captain_key = "captain:%s#%d@%s" % (repo, number, facts["head"])
            entry = decision_core.captain_entry(entry, facts, captain_key in escalated, evidence)
            if isinstance(engine.request_keys, set):
                engine.request_keys.add(captain_key)  # keeps its escalation through the daemon's prune
        entries.append((order(item), entry))
    return [entry for _, entry in sorted(entries, key=lambda pair: pair[0])], []



# ---- the sources behind the DecisionSource port. Each wraps the reader that was always called here (looked up by
# name at call time, so a replaced reader is used); a later adapter registers a class of its own.

class GitHubIssuesSource(decision_core.DecisionSource):
    name = "github"

    def __init__(self, engine):
        self.engine = engine

    def read_open(self, now):
        return decisions_from_github(self.engine, now)


class HarnessRequestsSource(decision_core.DecisionSource):
    name = "v2"

    def __init__(self, engine):
        self.engine = engine

    def read_open(self, now):
        return decisions_from_requests(self.engine, now)


class ReportsSource(decision_core.DecisionSource):
    name = "reports"

    def __init__(self, engine):
        self.engine = engine

    def read_open(self, now):
        return decisions_from_reports(self.engine, now)


class PrNoticesSource(decision_core.DecisionSource):
    name = "notices"
    entries = True

    def __init__(self, engine):
        self.engine = engine

    def read_open(self, now):
        return decisions_from_notices(self.engine, now)


# The registry, in the order the list is built: sources of items (folded and numbered) in registration order, then
# the sources of finished entries. A later adapter appends a factory (`factory(engine)` -> a DecisionSource).
DECISION_SOURCE_REGISTRY = [GitHubIssuesSource, HarnessRequestsSource, ReportsSource, PrNoticesSource]


def register_decision_source(factory):
    """Add a source (a class or any `factory(engine)` returning a DecisionSource) after the ones already there."""
    DECISION_SOURCE_REGISTRY.append(factory)
    return factory


def decision_sources(engine):
    return [factory(engine) for factory in DECISION_SOURCE_REGISTRY]


def read_source(engine, source, now, errors):
    """(found, problems) of one source: a source that fails is one error entry (audited once per change) and the
    others are still listed. Every problem is appended to `errors`."""
    try:
        found, problems = source.read_open(now)
    except Exception as err:
        found, problems = [], [_one_line("%s: %s" % (type(err).__name__, err), 200)]
    for problem in problems:
        errors.append(dict({"source": source.name, "error": _one_line(problem, 200)},
                           **({"boss": problem.boss} if getattr(problem, "boss", None) else {})))
        engine._note("decisions.error", source.name, {"error": _one_line(problem, 200)})
    return found, problems


def derive_decisions(engine, now):
    """(decisions, errors): every open decision, oldest first, and what could not be read.

    Each decision is {id, title, headline, ask, repo, agent, kind, since, tier} (`headline`: what the panel shows;
    an issue's decision may add `reported_by`, the agents whose report on it was folded in; PR 18: `cos`, `human` or `orchestrator`; a
    permission request or question also names its `session` and `request`). A source that fails is an error entry and the
    others are still listed (audited once per change). Call after `engine.discover` and a fact collection."""
    items, errors = [], []
    sources = decision_sources(engine)
    for source in (x for x in sources if not x.entries):
        found, problems = read_source(engine, source, now, errors)
        items.extend(found)
    ids = assign_decision_ids(items, decision_repos(engine))
    engine.decision_bosses = {ident: item["boss"] for ident, item in zip(ids, items) if item.get("boss")}  # memory only
    engine.decision_seeds = {ident: item["seed"] for ident, item in zip(ids, items)}  # memory only: the sync engine's keys
    watched = decision_repos(engine)
    home = engine.config.get("intent_repo") or (watched[0] if len(watched) == 1 else None)  # a bare issue's repo
    decisions = decision_core.build_entries(
        items, ids, home, lambda repo, number: cached_issue_title(engine, repo, number, {}),
        tier_flat=fault("tier-flat"))
    for source in (x for x in sources if x.entries):  # PR notices: information rather than decisions (never folded, never counted)
        found, problems = read_source(engine, source, now, errors)
        decisions.extend(found)
    decision_core.order_decisions(decisions)
    return decisions, errors


def read_decisions_file(path):
    """The parsed file, or None when it is missing or not a decisions file."""
    try:
        body = json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return None
    ok = isinstance(body, dict) and isinstance(body.get("decisions"), list) and isinstance(body.get("errors"), list)
    return body if ok else None


class LocalStore(decision_core.DecisionStore):
    """What the Switchboard keeps about decisions on this machine: the projection decisions.json and the
    escalated-requests file. Today's behaviour, behind the DecisionStore port; the functions it calls are unchanged."""

    def __init__(self, engine):
        self.engine = engine

    def read(self, now):
        return decisions_report(self.engine.state_dir, now)

    def publish(self, decisions, errors, now):
        """Write decisions.json when the list changed (or the file is missing or unreadable), atomically, mode
        0600; otherwise touch it, so its age says the daemon is alive. Returns True when written."""
        engine = self.engine
        path = engine.state_dir / DECISIONS_FILE
        current = read_decisions_file(path)
        if current is not None and current["decisions"] == decisions and current["errors"] == errors:
            os.utime(str(path), (now, now))
            return False
        known = current.get("generation") if current is not None else None
        engine.decisions_generation = max(engine.decisions_generation, known if isinstance(known, int) else 0) + 1
        body = {"generation": engine.decisions_generation, "written_at": iso(now), "daemon_pid": os.getpid(),
                "decisions": decisions, "errors": errors}
        temp = path.with_name("%s.%d.tmp" % (DECISIONS_FILE, os.getpid()))
        fd = os.open(str(temp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        try:
            with os.fdopen(fd, "w") as handle:
                json.dump(body, handle, indent=1, sort_keys=True)
                handle.write("\n")
            os.utime(str(temp), (now, now))
            os.replace(str(temp), str(path))
        except BaseException:
            try:
                os.unlink(str(temp))
            except OSError:
                pass
            raise
        return True  # not audited: a projection of facts, and the audit records writes to other systems

    def escalated(self):
        return read_escalated(self.engine.state_dir)

    def mark_escalated(self, key, when):
        mark_escalated(self.engine.state_dir, key, when)

    def prune_escalated(self, pending):
        prune_escalated(self.engine.state_dir, pending)


class NullExternal(decision_core.ExternalDecisionAdapter):
    """The adapter with nothing behind it: healthy, takes every push as a no-op and has no changes. What the
    Switchboard uses while no external adapter is configured, so nothing leaves the machine."""

    def health(self):
        return None

    def push(self, operation, idempotency_key):
        return {"external_id": operation.get("external_id")}

    def lookup(self, key):
        return None

    def pull_changes(self, cursor):
        return [], cursor


NULL_EXTERNAL = NullExternal()


def decision_store(engine):
    return LocalStore(engine)


def decision_external(engine):
    """The external adapter of this engine: its `external` when one was set, else the NullExternal."""
    return getattr(engine, "external", None) or NULL_EXTERNAL


# ---- external decision systems: OFF by default (external_decisions.enabled). The engine is decision_sync's; this
# is the registry of adapters, the host that gives it audit and delivery, and the call at the end of a pass.

EXTERNAL_ADAPTERS = {}


def register_external_adapter(name, factory):
    """Register an adapter under the name `external_decisions.adapter` selects: `factory(settings, mapping,
    state_dir)` returns an ExternalDecisionAdapter. `mapping` is the parsed local mapping file."""
    EXTERNAL_ADAPTERS[name] = factory
    return factory


MAPPING_ADAPTER = "mapping"   # the generic adapter's name in `external_decisions.adapter`


def build_mapping_adapter(settings, mapping, state_dir):
    """The factory of the generic adapter: built from the parsed mapping file, its key source run ONCE here (a command
    source runs now, with its own timeout, and the key is held in memory only). Any failure raises one line that
    never holds the key; the caller shows it as `down: <why>` and tries again only after a backoff."""
    module = load_external_adapter()
    try:
        adapter = module.McpRestAdapter(mapping)
        reason = adapter.start()
    except Exception as err:
        raise RuntimeError(module.scrub(_one_line("%s" % err, 160)))
    if reason:
        raise RuntimeError(module.scrub(_one_line(reason, 160), adapter.keys.secrets()))
    return adapter


register_external_adapter(MAPPING_ADAPTER, build_mapping_adapter)


def judge_inbound_answer(engine, decision, answer, role):
    """Whether an answer that came from outside may be applied, judged as the Chief of Staff's own `decisions answer`
    is: the same four questions, put to the same decision model, with the owner's standing orders as the authority.
    {"verdict": "allow" | "deny" | "unavailable", "reason": one line}.

    Only the owner's agent is judged (the project agent counts as an orchestrator's, the human as the human's: no
    orders are involved). It can only tighten: it is asked after role authority has accepted the answer. It fails
    safe: orders that are missing, empty or unusable, a judge that is not on, or a model that cannot answer is never
    an allow (the first two and the third are a deny, the last is `unavailable`, which the sync engine retries a
    bounded number of times). Nothing is written, and the model is never reached unless the judge is on."""
    if role != "owner_agent":
        return {"verdict": "allow", "reason": "no standing orders are involved for this role"}
    if fault("answer-unjudged"):
        return {"verdict": "allow", "reason": "answer-unjudged fault"}
    config = engine.config
    if not config["policy"]["enabled"] or not config.get("jev") or fault("no-policy-judge"):
        return {"verdict": "deny", "reason": "the owner's standing orders cannot be consulted: the policy judge is not "
                                             "on, so the owner's agent's answer goes to the owner"}
    try:
        orders = read_cos_orders(config)["text"]
    except CosOrdersError as err:
        return {"verdict": "deny", "reason": "the owner's standing orders cannot be used (%s)" % _one_line(str(err), 120)}
    if not orders:
        return {"verdict": "deny", "reason": "no standing orders are stated, so nothing authorises the owner's agent to "
                                             "decide this: it goes to the owner"}
    text = _one_line(answer.get("text") or "", 600)
    chosen = " --option %s" % answer["option_id"] if answer.get("option_id") else ""
    arguments = "%s decisions answer %s%s %s [the decision it acts on: %s by %s, %s tier: %s]" % (
        PROG, decision["id"], chosen, json.dumps(text), decision.get("kind"), decision.get("agent"),
        decision.get("tier"), _one_line(decision.get("title"), 300))
    arguments = redact_command_text(arguments, jev_secrets(config, os.environ))
    state = policy_state("chief-of-staff", "not stated: no ask is recorded", "not stated", orders, "shell", arguments,
                         COS_ORDERS_STATE_CLIP)
    thresholds = dict(config["policy"]["thresholds"])
    thresholds["outside_intent"] = thresholds["outside_scope"] = 2.0   # the Chief of Staff has no ask: as in the judge
    try:
        capped = dict(config["jev"], timeout_seconds=min(config["jev"]["timeout_seconds"], POLICY_WARM_SECONDS))
        combined = judge_tool_call(build_jev(dict(config, jev=capped)), "allow", state, thresholds)
    except Exception as err:
        return {"verdict": "unavailable", "reason": "the judge failed: %s" % _one_line(str(err), 120)}
    if "answers" not in combined:   # judge_tool_call lets the configured outcome stand when the model gave no answer
        return {"verdict": "unavailable", "reason": _one_line(combined["reason"], 200)}
    if combined["outcome"] == "allow":
        return {"verdict": "allow", "reason": "within the owner's standing orders"}
    fired = "; ".join(POLICY_FIRED_TEXT[n] for n in combined["fired"] if n in POLICY_FIRED_TEXT)
    return {"verdict": "deny", "reason": "outside the owner's standing orders (%s): it goes to the owner" % (fired or "judge")}


class ExternalSyncHost(decision_sync.Host):
    """What the sync engine needs of the Switchboard: the audit log, and the asker's own delivery paths."""

    def __init__(self, engine):
        self.engine = engine

    def audit(self, event, subject, detail):
        if self.engine.audit is not None:
            self.engine.audit.append(self.engine.actor, event, subject, detail)

    def _runner(self):
        return self.engine.gh_runner or subprocess.run

    def _boss(self, target):
        discovery = self.engine.discovery or self.engine.discover(self.engine.now())
        found = discovery.agents.get(target.get("agent")) if target.get("agent") else None
        boss = _boss_of(found) if found is not None else None
        if boss is None:
            raise DecisionError("%s: there is no running agent to tell" % (target.get("display_id") or target.get("id")))
        return boss

    def judge_answer(self, entry, intent):
        return judge_inbound_answer(self.engine, entry, intent, intent.get("answered_by"))

    def deliver_answer(self, entry, intent):
        engine, kind = self.engine, entry["kind"]
        text = _one_line(intent.get("text") or "", 600)
        role = (intent.get("answered_by") or "someone").replace("_", " ")
        said = "Answered outside by the %s%s" % (role, ": " + text if text else " (option %s)" % intent.get("option_id"))
        if kind == "report":
            outcome = ReportSendDelivery(engine).deliver(entry, {"by": self._boss(entry), "to": entry["agent"],
                                                                 "text": said, "ask": entry.get("ask"),
                                                                 "repo": entry.get("repo")})
            if not outcome.get("sent"):
                raise DecisionError("the answer was not sent to %s (%s)" % (
                    entry["agent"], outcome.get("reason") or outcome.get("action")))
        elif kind == "issue" and entry.get("rows"):
            rows = ["%s=%s" % (n, c) for n, c in sorted((intent.get("rows") or {}).items(), key=lambda kv: int(kv[0]))]
            args = types.SimpleNamespace(as_recommended=not rows, row=rows, note=said)
            answer_batch(engine, self._runner(), entry, args, engine.actor)
        elif kind == "issue":
            target = _issue_target(engine, entry)
            if target is None or target[0] is None:
                raise DecisionError("%s: cannot tell which repo its issue is in" % entry["id"])
            IssueDelivery(engine, self._runner()).deliver(entry, {
                "repo": target[0], "number": target[1], "add": (),
                "remove": [awaiting_cos_label(engine.config), awaiting_label(engine.config)],
                "author": engine.actor, "comment": said})
        elif kind == "question":
            HarnessReplyDelivery(engine).deliver(entry, {"value": text or str(intent.get("option_id") or ""),
                                                          "note": said, "by": engine.actor})
        else:
            raise DecisionError("%s is a %s: it is not answered from outside" % (entry["id"], kind))

    def deliver_note(self, target, text):
        outcome = ReportSendDelivery(self.engine).deliver(target, {
            "by": self._boss(target), "to": target.get("agent"), "text": text, "ask": target.get("ask"),
            "repo": target.get("repo")})
        if not outcome.get("sent"):
            raise DecisionError("the note was not sent to %s (%s)" % (
                target.get("agent"), outcome.get("reason") or outcome.get("action")))


def external_settings(config):
    section = (config or {}).get("external_decisions") or {}
    return section if section.get("enabled") else None


def sync_for(engine):
    """The sync engine of this daemon, built once; None while external decisions are off (nothing is called), or
    (None, reason) is never returned: a build that fails is `engine.external_sync_error`, shown as a status."""
    settings = external_settings(engine.config)
    if settings is None or engine.state_dir is None:
        return None
    held = getattr(engine, "external_sync", None)
    if held is not None:
        return held
    now = engine.now()
    if now < getattr(engine, "external_sync_retry_at", 0):
        return None   # a failed build is not tried again until its backoff has passed (a key command is not rerun per pass)
    try:
        factory = EXTERNAL_ADAPTERS.get(settings["adapter"])
        if factory is None:
            raise RuntimeError("no adapter named %r is registered" % settings["adapter"])
        try:
            mapping = json.loads(Path(settings["mapping_file"]).read_text())
        except (OSError, ValueError) as err:
            raise RuntimeError("the mapping file cannot be read: %s" % (getattr(err, "strerror", None) or "not JSON"))
        adapter = factory(settings, mapping, engine.state_dir)
        engine.external_sync = decision_sync.SyncEngine(settings, engine.state_dir, adapter, ExternalSyncHost(engine),
                                                       engine.now)
        engine.external_sync_error = None
        engine.external_sync_fails = 0
        ExternalSyncHost(engine).audit("external.started", "external", {"adapter": settings["adapter"]})
    except Exception as err:
        fails = getattr(engine, "external_sync_fails", 0) + 1
        engine.external_sync_fails = fails
        engine.external_sync_error = _one_line("%s" % err, 160)
        engine.external_sync_retry_at = now + min(settings["retry_max_seconds"],
                                                  settings["retry_base_seconds"] * 2 ** (fails - 1))
        try:
            ExternalSyncHost(engine).audit("external.down", "external", {"reason": engine.external_sync_error,
                                                                         "attempt": fails})
        except Exception:
            pass
        return None
    return engine.external_sync


def sync_external(engine, decisions, errors, now):
    """The end of a pass for a project that is switched on: mirror the list outward and take answers back. Returns
    the error entries to show (the adapter down, an outbox past its alarm). Never raises and never changes `decisions`:
    a down adapter cannot hide a local decision or stop local answering."""
    if external_settings(engine.config) is None:
        return []
    found = []
    try:
        sync = sync_for(engine)
        if sync is None:
            reason = getattr(engine, "external_sync_error", None) or "no state directory"
            _write_external_status(engine, {"state": "down", "reason": reason, "outbox": 0, "last_pull": None})
            return [{"source": "external", "error": "external decision system is down: %s" % reason}]
        status = sync.cycle(decisions, errors, getattr(engine, "decision_seeds", {}) or {},
                            getattr(engine, "decision_bosses", {}) or {})
        if status["state"] == "down":
            found.append({"source": "external", "error": "external decision system is down: %s" % status["reason"]})
        if status.get("alarm"):
            found.append({"source": "external", "error": "the outbox to the external decision system is past %d waiting "
                          "operations (none is dropped)" % engine.config["external_decisions"]["outbox_alarm_depth"]})
    except Exception as err:
        found.append({"source": "external", "error": _one_line("external decisions: %s: %s" % (type(err).__name__, err), 200)})
    return found


class EngineWorkHost(work_sync.Host):
    """What the work pump reads from this engine: the discovered fleet agents, the reports their bosses hold (the
    transcript reads the decisions already make, cached), the intent cache the daemon already holds, and the
    decision link table. Nothing here reads GitHub."""

    def __init__(self, engine):
        self.engine = engine

    def agents(self):
        discovery = self.engine.discovery
        found = []
        for name, obs in sorted((discovery.agents if discovery is not None else {}).items()):
            fleet = obs.fleet or {}
            found.append({"name": name, "role": fleet.get("role"), "reports_to": _boss_of(obs),
                          "repo": _fleet_repo(fleet, self.engine.config), "issue": _issue_of(fleet),
                          "status": obs.status, "intent": fleet.get("intent")})
        return found

    def reports(self):
        engine, discovery = self.engine, self.engine.discovery
        if discovery is None:
            return []
        since = engine.now() - engine.config["decisions_lookback_hours"] * 3600
        repos, found = decision_repos(engine), []
        for boss in sorted({_boss_of(o) for o in discovery.agents.values()} - {None}):
            obs = discovery.agents.get(boss)
            if obs is None or obs.problem:
                continue
            for created, _, number, line in synthetic_lines(engine, obs.session_id, since):
                match = REPORT_LINE.match(line)
                if match:
                    sender = discovery.agents.get(match.group(1))
                    found.append({"sender": match.group(1), "issue": int(match.group(3)) if match.group(3) else None,
                                  "state": match.group(4), "text": match.group(5), "at": (created, number),
                                  "repo": repo_of_tag(match.group(2), repos)
                                  or (_fleet_repo(sender.fleet, engine.config) if sender else None)})
        source = _report_rider_source(engine)
        for item in (source.entries() if source is not None else []):
            state, _, text = item["summary"].partition(": ")
            sender = discovery.agents.get(item.get("from"))
            if item["created"] >= since and sender is not None:
                found.append({"sender": sender.name, "issue": item.get("issue"), "state": state, "text": text,
                              "at": (item["created"], 1 << 60),
                              "repo": item.get("repo") or _fleet_repo(sender.fleet, engine.config)})
        return found

    def title_of(self, repo, issue):
        return cached_issue_title(self.engine, repo, issue, {})

    def links(self):
        sync = getattr(self.engine, "external_sync", None)
        return dict(getattr(sync, "links", None) or {})

    def audit(self, event, subject, detail):
        if self.engine.audit is not None:
            self.engine.audit.append(self.engine.actor, event, subject, detail)


def work_sync_external(engine, now):
    """The end of a pass, after the decision sync: mirror worker assignments as work items when `work_items` is on and
    the adapter in use has a work sink. Never raises; nothing at all happens while either is off."""
    settings = external_settings(engine.config)
    if settings is None or not settings.get("work_items") or engine.state_dir is None:
        return
    try:
        sync = getattr(engine, "external_sync", None)
        sink = getattr(getattr(sync, "adapter", None), "work", None)
        if sink is None:
            return
        pump = getattr(engine, "work_pump", None)
        if pump is None:
            pump = engine.work_pump = work_sync.WorkSync(settings, engine.state_dir, sink, EngineWorkHost(engine), engine.now)
        pump.cycle()
    except Exception as err:
        try:
            engine._note("work.error", "pump", {"error": _one_line("%s: %s" % (type(err).__name__, err), 200)})
        except Exception:
            pass


def work_status_line(config, state_dir, now):
    """`work items: 3 open, last write 12s ago, 0 errors` (None when work items are off)."""
    settings = external_settings(config)
    if settings is None or not settings.get("work_items"):
        return None
    body = decision_sync._read_json(str(Path(state_dir) / work_sync.STATUS_FILE))
    if body is None:
        return "work items  waiting for the daemon's first pass"
    last = body.get("last_write")
    return "work items  %s open, last write %s, %s error(s)%s" % (
        body.get("open", 0), "%s ago" % format_age(now - last) if last else "never", body.get("errors", 0),
        "; ALARM: writes are piling up" if body.get("alarm") else "")


def _write_external_status(engine, status):
    try:
        decision_sync._write_json(str(Path(engine.state_dir) / decision_sync.STATUS_FILE),
                                  dict(status, written_at=engine.now()))
    except OSError:
        pass


def external_status_line(config, state_dir, now):
    """The one line `status` and `decisions` show: `external  ok; outbox N; last pull 12s ago`, or `down: why`. None
    when external decisions are off (nothing is printed then)."""
    if external_settings(config) is None:
        return None
    body = decision_sync._read_json(str(Path(state_dir) / decision_sync.STATUS_FILE))
    if body is None:
        return "external  waiting for the daemon's first pass"
    pulled = body.get("last_pull")
    text = "%s; outbox %s; last pull %s" % ("ok" if body.get("state") == "ok" else "down: %s" % body.get("reason"),
                                            body.get("outbox", 0), "%s ago" % format_age(now - pulled) if pulled else "never")
    failures = body.get("permanent_failures") or 0
    return ("external  " + text + ("; %d permanent failure(s)" % failures if failures else "")
            + ("; ALARM: outbox is deep" if body.get("alarm") else ""))


def publish_decisions(engine):
    """The end of a pass: derive the list and hand it to the store (decisions.json when it changed, else a touch, so
    its age says the daemon is alive). Returns True when written."""
    state = engine.state_dir
    if state is None or engine.audit is None or fault("no-decisions-file"):
        return False
    now = engine.now()
    decisions, errors = derive_decisions(engine, now)
    apply_notice_effects(engine)
    store = decision_store(engine)
    try:
        store.prune_escalated(engine.request_keys)
    except OSError:
        pass  # a disposable file: a failed prune is tried again next pass
    errors = errors + sync_external(engine, decisions, errors, now)  # [] unless external_decisions is enabled
    work_sync_external(engine, now)  # nothing unless external_decisions.work_items is on
    return store.publish(decisions, errors, now)


def decisions_report(state_dir, now):
    """What the file says now: {stale, message, age_seconds, written_at, generation, decisions, errors}.

    `stale` is true when the file is missing, unreadable, or older than DECISIONS_STALE_SECONDS by mtime
    (every pass refreshes it): a list the daemon does not keep current is never shown as current. Under the
    `stale-as-fresh` fault an old file still counts as current."""
    path = Path(state_dir) / DECISIONS_FILE
    report = {"stale": True, "message": None, "age_seconds": None, "written_at": None, "generation": None,
              "decisions": [], "errors": []}
    try:
        age = now - path.stat().st_mtime
    except OSError:
        report["message"] = "the daemon is not updating this list: there is no %s in %s" % (DECISIONS_FILE, state_dir)
        return report
    body = read_decisions_file(path)
    if body is None:
        report["message"] = "the daemon is not updating this list: %s cannot be read" % path
        return report
    report.update(decisions=body["decisions"], errors=body["errors"], written_at=body.get("written_at"),
                  generation=body.get("generation"), age_seconds=max(0, int(age)))
    if age > DECISIONS_STALE_SECONDS and not fault("stale-as-fresh"):
        report["message"] = "the daemon is not updating this list: %s was last written %s ago" % (
            DECISIONS_FILE, format_age(age))
    else:
        report["stale"] = False
    return report


def format_age(seconds):
    """`45s`, `12m`, `1h05m`, `3d`: the longest unit that fits, never more than a few characters."""
    seconds = max(0, int(seconds))
    if seconds < 60:
        return "%ds" % seconds
    if seconds < 3600:
        return "%dm" % (seconds // 60)
    if seconds < 86400:
        return "%dh%02dm" % (seconds // 3600, seconds % 3600 // 60) if seconds % 3600 // 60 else "%dh" % (seconds // 3600)
    return "%dd" % (seconds // 86400)


DECISION_TIERS = decision_core.DECISION_TIERS
DECISION_LONG_WAIT = decision_core.DECISION_LONG_WAIT   # seconds: a decision waiting longer is "over 1h" (the panel's LONG_WAIT_SECONDS; a test keeps them equal)


def count_over_an_hour(decisions, now):
    return decision_core.count_over_an_hour(decisions, now)


def decisions_view(fleet, config, repo=None, tier=None):
    """PR 18: which decisions a caller sees (the rules are decision_core's): {"role", "repo", "tiers", "text"}."""
    role = (fleet or {}).get("role")
    return decision_core.decisions_view(role, _fleet_repo(fleet, config) if role == "orchestrator" else None,
                                        repo, tier)


def select_decisions(decisions, view):
    return decision_core.select_decisions(decisions, view)


def format_decisions(report, now, view=None):
    """The human text: one line per decision, `<id>  waiting <age>  <agent>  <title>`, columns aligned.
    With a `view` (PR 18) the first line says which view this is, and a view that mixes tiers shows each one."""
    if report["stale"]:
        return "Decisions unavailable: %s. Start it with `%s ensure`, or read the facts now with `%s decisions --fresh`." % (
            report["message"], PROG, PROG)
    decisions = report["decisions"]
    human_only = view is None or view["tiers"] == ["human"]
    if not decisions:
        lines = ["No decisions are waiting on you." if human_only else "No decisions in this view."]
    else:
        agents = [d.get("agent") or "-" for d in decisions]
        width_id, width_agent = max(len(d["id"]) for d in decisions), max(len(a) for a in agents)
        lines = []
        for decision, agent in zip(decisions, agents):
            since = parse_iso(decision.get("since"))
            tier = "" if human_only else "[%s]  " % decision.get("tier", "human")
            lines.append("%s  waiting %s  %s%s  %s" % (decision["id"].ljust(width_id),
                                                      format_age(now - since) if since is not None else "?",
                                                      tier, agent.ljust(width_agent), decision["title"]))
        lines = [line.rstrip() for line in lines]
        if report.get("fresh"):  # --fresh says, for an open report, which send it looked at (or that there was none)
            lines = [line for pair in zip(lines, [("      " + d["considered"]) if d.get("considered") else None
                                                   for d in decisions]) for line in pair if line is not None]
    lines.extend("(could not read %s: %s)" % (e.get("source"), e.get("error")) for e in report["errors"])
    if view is not None:
        lines.insert(0, "Decisions: %s" % view["text"])
    return "\n".join(lines)


def fresh_engine_decisions(runner, now, writable=False):
    """(engine, decisions, errors) derived now in this process: GitHub is read here, once per repo and label,
    because this process has no hub kept current by webhook events."""
    engine, state, config = build_engine(runner, now, "cli", writable=writable)
    engine.discover(now())
    engine.collect_facts()
    repos = decision_repos(engine)
    if repos:
        hub = GitHubHub(config, state, None, runner, spawn_forwarder, now, "cli")
        hub.engine, engine.hub = engine, hub
        for repo in repos:  # every watched repo, each read with its own account (the hub's gh_api picks it)
            hub.read_awaiting(repo, now())
    decisions, errors = derive_decisions(engine, now())
    return engine, decisions, errors


def fresh_decisions(runner, now):
    """`decisions --fresh`: derive the list in this process, read-only, and write nothing."""
    _, decisions, errors = fresh_engine_decisions(runner, now)
    return {"stale": False, "message": None, "age_seconds": 0, "written_at": iso(now()), "generation": None,
            "decisions": decisions, "errors": errors, "fresh": True}


def watch_decisions(state_dir, now=time.time, sleep=time.sleep, write=None, clear=False, view=None):
    """`decisions --watch`: draw the list, then every second look again and draw it when it differs. Stdlib
    only, for a terminal that has no TUI plugin (a herdr side pane). Ends on Ctrl-C."""
    write = write or sys.stdout.write
    last = None
    try:
        while True:
            report = decisions_report(state_dir, now())
            if view is not None:
                report = dict(report, decisions=select_decisions(report["decisions"], view))
            text = format_decisions(report, now(), view)
            if text != last:
                write(("\x1b[2J\x1b[H" if clear else "") + text + "\n")
                last = text
            sleep(1)
    except KeyboardInterrupt:
        return EXIT_OK


def decisions_caller(args, runner, now):
    """The caller's fleet metadata for a read: its pane's fleet agent, `--from` in the Lab, or {} for anyone who
    is not a fleet agent (a plain shell, a TUI): the human's view."""
    if getattr(args, "sender", None) is not None:
        if os.environ.get(LAB_ENV) != "1":
            raise CallerError("--from is only for the Lab (%s=1); an agent is identified by its pane" % LAB_ENV)
        engine, _, _ = build_engine(runner, now, "cli", writable=False)
        found = engine.discover(engine.now()).agents.get(args.sender)
        if found is None:
            raise CallerError("%s is not a fleet agent the switchboard can see" % args.sender)
        return found.fleet or {}
    if not os.environ.get("HERDR_PANE_ID"):
        return {}
    try:
        engine, _, _ = build_engine(runner, now, "cli", writable=False)
        return caller_fleet(engine.herdr, engine.v2, os.environ)
    except (CallerError, ConfigError, V2Error, HerdrError):
        return {}  # a person's own shell inside herdr has a pane and no agent: the human's view, never a crash


def cmd_decisions(args, runner, now):
    action = getattr(args, "decisions_action", None) or "list"
    if action != "list":
        return cmd_decision_write(args, action, runner, now)
    if args.watch and args.fresh:
        sys.stderr.write("%s: --watch reads the file the daemon writes; it cannot be combined with --fresh\n" % PROG)
        return EXIT_USAGE
    if args.repo is not None and not REPO_RE.match(args.repo):
        sys.stderr.write("%s: --repo must be OWNER/REPO, got %r\n" % (PROG, args.repo))
        return EXIT_USAGE
    try:
        fleet = decisions_caller(args, runner, now)
    except CallerError as err:
        sys.stderr.write("%s: %s\n" % (PROG, err))
        return EXIT_USAGE
    try:
        config = load_config()
    except ConfigError:
        config = {}
    view = decisions_view(fleet, config, args.repo, args.tier)
    state = state_dir_path()
    if args.watch:
        return watch_decisions(state, now, clear=sys.stdout.isatty(), view=view)
    report = fresh_decisions(runner, now) if args.fresh else decisions_report(state, now())
    shown = dict(report, decisions=select_decisions(report["decisions"], view))
    external = external_status_line(config, state, now()) if config else None
    if args.json:
        extra = {"external": external} if external is not None else {}
        print(json.dumps(dict(shown, message=report["message"] or None, view=view, **extra), indent=2, sort_keys=True))
    else:
        print(format_decisions(shown, now(), view))
        if external is not None:
            print("(%s)" % external)
    return EXIT_ERROR if report["stale"] else EXIT_OK


def decisions_summary(state_dir, now):
    """For `status`: how many decisions the file lists (and how many of them are yours, the Chief of Staff's, an
    orchestrator's), and whether the daemon keeps it current."""
    report = decisions_report(state_dir, now())
    by_repo, by_tier = {}, {}
    listed = [d for d in report["decisions"] if d.get("kind") != "notice"]  # a PR notice is information, not a decision
    over_cos = count_over_an_hour([d for d in listed if d.get("tier", "human") == "cos"], now())
    for decision in listed:
        tier = decision.get("tier", "human")
        by_tier[tier] = by_tier.get(tier, 0) + 1
        if decision.get("repo") and tier == "human":
            by_repo[decision["repo"]] = by_repo.get(decision["repo"], 0) + 1
    return {"count": len(listed), "stale": report["stale"], "message": report["message"],
            "age_seconds": report["age_seconds"], "errors": len(report["errors"]), "by_repo": by_repo,
            "by_tier": by_tier, "cos_over_an_hour": over_cos}


def format_decisions_status(summary):
    if summary["stale"]:
        return ["      decisions  %s" % summary["message"]]
    tiers = summary.get("by_tier") or {}
    yours = tiers.get("human", 0) if tiers else summary["count"]
    line = "      decisions  %d waiting on you (`%s decisions`)" % (yours, PROG)
    by_repo = summary.get("by_repo") or {}
    if len(by_repo) > 1:  # with one repo there is nothing to tell apart
        line = "      decisions  %d waiting on you (%s; `%s decisions`)" % (
            yours, ", ".join("%s %d" % (repo, count) for repo, count in sorted(by_repo.items())), PROG)
    elsewhere = {tier: count for tier, count in tiers.items() if tier != "human"}
    if elsewhere:
        line += "; also open: %s" % ", ".join(
            "%d with the Chief of Staff (%d over 1h)" % (count, summary.get("cos_over_an_hour", 0)) if tier == "cos"
            else "%d with an orchestrator" % count for tier, count in sorted(elsewhere.items()))
    return [line + ("; %d source(s) could not be read" % summary["errors"] if summary["errors"] else "")]


# ---- toasts

def note_unreachable(engine, recipient, fresh, why):
    """The re-check could not read the recipient at all (pane closed, session gone):
    the pass's render step toasts it, once, like every other toast."""
    if fresh is None:
        engine.pass_toasts[recipient] = ("unreachable: " + why, "Fleet: %s cannot be reached" % recipient,
                                         _one_line("Held, nothing sent to %s: %s" % (recipient, why), 200))


def collect_source_toasts(engine):
    """What the fact sources and this pass's re-checks ask the human to be told."""
    found = {}
    for source in engine.sources:
        toasts = getattr(source, "toasts", None)
        for agent, reason, title, body in toasts() if toasts else []:
            found[agent] = (reason, title, body)
    found.update(engine.pass_toasts)
    return found


def finish_pass(engine, discovery, report):
    """The end of a pass: reminders that reached their recipient are pruned. A failure is
    audited and never stops the pass."""
    try:
        prune_delivered_reminders(engine, discovery)
    except Exception as err:
        engine._failed("reminders", "reminders", err, report)
    try:
        friction_tick(engine, discovery)
    except Exception as err:
        engine._failed("friction-wake", "friction-wake", err, report)
    try:
        prune_report_riders(engine, discovery)
    except Exception as err:
        engine._failed("report-riders", "report-riders", err, report)
    try:
        publish_decisions(engine)
    except Exception as err:
        engine._failed("decisions", "decisions", err, report)
    schedule_judge_warm(engine, discovery)


# ---- the daily friction wake (docs/switchboard.md, "Self-wakes"). Off unless `friction_wake.enabled`; like
# `external_decisions` the key is absent from DEFAULTS, so a config that never names it is exactly what it was.

FRICTION_TEXT = ("Daily friction check (one short answer): what slowed you or your coders down in the last day? "
                 "If anything is worth fixing, send %(to)s a one-paragraph proposal: "
                 "fleet-switchboard send %(to)s --issue <n> \"<proposal>\". "
                 "If nothing, do nothing and say nothing.")
FRICTION_DEFAULTS = {"enabled": False, "hour": 9, "to": "fleetkit", "text": None}
FRICTION_STATE = "friction-wake.json"
FRICTION_GRACE = 4 * 3600   # a slot is asked for at most this long after it began: a wake at 09:00, never at 15:00


def validate_friction_config(config, source):
    """`friction_wake`: absent or null is off. `hour` is 0-23 in the daemon's local time, or null for every 24 h
    from the first wake; `to` is the agent a proposal goes to; `text` null is the default text."""
    if "friction_wake" not in config:
        return
    raw = config["friction_wake"]
    if raw is None:
        raw = {}
    if not isinstance(raw, dict):
        raise ConfigError("%s: 'friction_wake' must be an object, got %r" % (source, type(raw).__name__))
    unknown = sorted(set(raw) - set(FRICTION_DEFAULTS))
    if unknown:
        raise ConfigError("%s: 'friction_wake' has key(s) this tool does not read: %s" % (source, ", ".join(unknown)))
    section = dict(FRICTION_DEFAULTS, **raw)
    where = "%s: 'friction_wake" % source
    if not isinstance(section["enabled"], bool):
        raise ConfigError("%s.enabled' must be true or false, got %r" % (where, section["enabled"]))
    hour = section["hour"]
    if hour is not None and (not isinstance(hour, int) or isinstance(hour, bool) or not 0 <= hour <= 23):
        raise ConfigError("%s.hour' must be a whole hour 0-23 (the daemon's local time), or null for every 24 h "
                          "from the first wake, got %r" % (where, hour))
    if not isinstance(section["to"], str) or not NAME_RE.match(section["to"]):
        raise ConfigError("%s.to' must be a fleet agent name, got %r" % (where, section["to"]))
    text = section["text"]
    if text is not None and (not isinstance(text, str) or not text.strip() or len(text) > 1000):
        raise ConfigError("%s.text' must be a non-empty string of at most 1000 characters, or null, got %r"
                          % (where, text))
    config["friction_wake"] = section


def friction_slot(now, hour, anchor):
    """The start (epoch seconds) of the newest wake slot at or before `now`: the last `hour`:00 in the daemon's
    local time, or, with no hour, the newest 24 h step from `anchor`."""
    if hour is None:
        return anchor + int((now - anchor) // 86400) * 86400
    moment = datetime.fromtimestamp(now).replace(hour=hour, minute=0, second=0, microsecond=0)
    if moment.timestamp() > now:
        moment = datetime.fromtimestamp(now - 86400).replace(hour=hour, minute=0, second=0, microsecond=0)
    return moment.timestamp()


def read_friction_state(state_dir):
    """{name: {"anchor", "done"}}. Disposable: a file that is missing or unreadable is an empty one."""
    try:
        raw = json.loads((Path(state_dir) / FRICTION_STATE).read_text())
    except (OSError, ValueError):
        return {}
    return {k: v for k, v in raw.items() if isinstance(v, dict)} if isinstance(raw, dict) else {}


def write_friction_state(state_dir, found):
    path = Path(state_dir) / FRICTION_STATE
    temp = path.with_name("%s.%d.tmp" % (FRICTION_STATE, os.getpid()))
    fd = os.open(str(temp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as handle:
        json.dump(found, handle, indent=1, sort_keys=True)
        handle.write("\n")
    os.replace(str(temp), str(path))


def friction_tick(engine, discovery):
    """The end of a pass: an orchestrator whose slot has begun and has not been asked gets ONE reminder (the
    ordinary kind, delivered by the next pass by the ordinary rule). Nothing is read from v2 and nothing is written
    unless someone is due; `friction-wake.json` records the slot asked, so a restart or a later pass makes no second
    one. An orchestrator a person has engaged with, or that is blocked or held, is skipped for now (asked again
    until the slot is FRICTION_GRACE old). Returns [(name, slot)]."""
    section = engine.config.get("friction_wake") or {}
    if not section.get("enabled") or discovery is None or engine.state_dir is None:
        return []
    now, state, asked, changed = engine.now(), read_friction_state(engine.state_dir), [], False
    text = section["text"] or FRICTION_TEXT % {"to": section["to"]}
    for name, seen in sorted(discovery.agents.items()):
        if (seen.fleet or {}).get("role") != "orchestrator" or name == section["to"]:
            continue
        mine = state.get(name, {})
        anchor = mine.get("anchor") if _is_number(mine.get("anchor")) else None
        if section["hour"] is None and anchor is None:
            anchor, changed = int(now), True
            state[name] = mine = dict(mine, anchor=anchor)
        slot = friction_slot(now, section["hour"], anchor)
        if slot <= (mine.get("done") if _is_number(mine.get("done")) else 0) or now - slot >= FRICTION_GRACE:
            continue
        if hold_reason(seen) or seen.engaged(now, engine.engaged_seconds):
            continue
        add_reminder(engine.state_dir, name, now, now, text)
        state[name] = dict(mine, done=slot)
        asked.append((name, slot))
        changed = True
        if engine.audit is not None:
            engine.audit.append(engine.actor, "friction.wake", name, {"slot": iso(slot)})
        write_friction_state(engine.state_dir, state)  # after each one: a crash repeats at most one
    if changed:
        write_friction_state(engine.state_dir, state)
    return asked


# ---- reminders

def parse_when(text, now):
    """`30m`, `+2h`, `1d` (from now), or an ISO-8601 time with an offset or `Z`. Epoch seconds."""
    match = re.fullmatch(r"\+?([0-9]+)([smhd])", text.strip())
    if match:
        return now + int(match.group(1)) * REMINDER_UNITS[match.group(2)]
    try:
        moment = datetime.fromisoformat(text.strip().replace("Z", "+00:00"))
    except ValueError:
        raise ReminderError("when must be a delay such as 30m, 2h or 1d, or an ISO time with a zone "
                            "such as 2030-01-02T09:00:00Z, got %r" % text) from None
    if moment.tzinfo is None:
        raise ReminderError("when %r has no time zone; add Z or an offset" % text)
    return moment.timestamp()


class ReminderError(FactError):
    """reminders.json cannot be read or written, or a reminder cannot be made."""


@contextmanager
def reminders_lock(state_dir):
    """Serialises the CLI and the daemon around the read-modify-write of reminders.json."""
    fd = os.open(str(Path(state_dir) / REMINDER_LOCK), os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)


def read_reminders(state_dir):
    path = Path(state_dir) / REMINDERS
    try:
        raw = json.loads(path.read_text())
    except FileNotFoundError:
        return []
    except (OSError, ValueError) as err:
        raise ReminderError("cannot read %s: %s" % (path, err)) from None
    items = raw.get("reminders") if isinstance(raw, dict) else None
    if not isinstance(items, list):
        raise ReminderError("%s must hold {\"reminders\": [...]}" % path)
    for item in items:
        if not (isinstance(item, dict) and isinstance(item.get("id"), str) and isinstance(item.get("to"), str)
                and _is_number(item.get("at")) and isinstance(item.get("text"), str)):
            raise ReminderError("%s has a reminder without id, to, at and text: %r" % (path, item))
        if item.get("condition") is not None and not isinstance(item["condition"], dict):
            raise ReminderError("%s has a reminder whose condition is not an object: %r" % (path, item))
    return items


def write_reminders(state_dir, items):
    """Replace reminders.json atomically, mode 0600: a crash leaves the old file or the new one."""
    path = Path(state_dir) / REMINDERS
    temp = path.with_name("%s.%d.tmp" % (REMINDERS, os.getpid()))
    fd = os.open(str(temp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        with os.fdopen(fd, "w") as handle:
            json.dump({"reminders": items}, handle, indent=1, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(str(temp), str(path))
    except BaseException:
        try:
            os.unlink(str(temp))
        except OSError:
            pass
        raise


def add_reminder(state_dir, to, at, created, text, issue=None, sender=None, repo=None, condition=None):
    if not isinstance(to, str) or not to.strip():
        raise ReminderError("a reminder needs the name of the agent it is for")
    if not text.strip():
        raise ReminderError("a reminder needs text")
    item = {"id": uuid.uuid4().hex[:12], "to": to, "at": float(at), "created": float(created),
            "text": text, "issue": issue, "from": sender}
    if repo:
        item["repo"] = repo  # PR 15: the repo `issue` is in
    if condition:
        item["condition"] = dict(condition)  # checked when it is due: {"unless_report_from", "since"} or {"while_running"}
    with reminders_lock(state_dir):
        write_reminders(state_dir, read_reminders(state_dir) + [item])
    return item


def remove_reminders(state_dir, ids):
    """Drop these ids from reminders.json. Returns the ids that were there."""
    with reminders_lock(state_dir):
        items = read_reminders(state_dir)
        gone = [item["id"] for item in items if item["id"] in ids]
        if gone:
            write_reminders(state_dir, [item for item in items if item["id"] not in ids])
    return gone


class ReminderFacts:
    """`reminder:<id>` facts for reminders that are due. A reminder not yet due is no fact.

    A due reminder skips the batch window: it is one event at an exact time.
    It stays in the file until its key shows in the recipient's transcript or
    inbox (prune_delivered_reminders), so a crash before delivery loses nothing.
    """

    __name__ = "reminder_facts"

    def __init__(self, state_dir):
        self.state_dir, self.engine = Path(state_dir), None

    def bind(self, engine):
        self.engine = engine

    def due(self):
        now = self.engine.now() if self.engine else time.time()
        return [item for item in read_reminders(self.state_dir) if item["at"] <= now]

    def verdict(self, item):
        """For a due conditional reminder: None (cannot tell yet: it stays), "deliver", or the reason to drop it.
        One read of the boss's transcript and inbox, and only for a reminder that is due and has a condition."""
        condition, discovery = item["condition"], self.engine.discovery if self.engine else None
        if discovery is None:
            return None
        worker = condition.get("unless_report_from") or condition.get("while_running")
        if isinstance(worker, str) and worker not in discovery.agents:
            return "%s is gone" % worker if not discovery.problems else None
        if not isinstance(condition.get("unless_report_from"), str):
            return "deliver"
        boss, since = discovery.agents.get(item["to"]), condition.get("since", 0)
        if not _is_number(since):  # a forged or damaged condition is no condition: deliver, audited
            if self.engine is not None and self.engine.audit is not None:
                self.engine.audit.append(self.engine.actor, "reminder.condition_unusable", item["to"],
                                         {"id": item["id"]})
            return "deliver"
        if boss is None:
            return None
        try:
            lines = synthetic_lines(self.engine, boss.session_id, since, waiting=True)
            riders = read_report_riders(self.state_dir)
        except (V2Error, ReminderError):
            return None
        for _, _, _, line in lines:
            match = REPORT_LINE.match(line) or SEND_LINE.match(line)
            if match and match.group(1) == worker:
                return "%s reported to %s since the launch" % (worker, item["to"])
        if any(r.get("from") == worker and r["to"] == item["to"] and r["created"] >= since for r in riders):
            return "%s reported to %s since the launch" % (worker, item["to"])
        return "deliver"

    def __call__(self):
        facts = []
        for item in self.due():
            if item.get("condition"):
                found = self.verdict(item)
                if found is None:
                    continue
                if found != "deliver":
                    gone = remove_reminders(self.state_dir, {item["id"]})
                    if gone and self.engine is not None and self.engine.audit is not None:
                        self.engine.audit.append(self.engine.actor, "reminder.drop", item["to"],
                                                 {"id": item["id"], "why": found})
                    continue
            facts.append(Fact("reminder:" + item["id"], item["to"], "reminder", item["text"], item["at"],
                              issue=item.get("issue"), batch=False, sender=item.get("from"), repo=item.get("repo")))
        return facts


def prune_delivered_reminders(engine, discovery):
    """Forget the due reminders whose key is already in their recipient's transcript or inbox."""
    source = next((s for s in engine.sources if isinstance(s, ReminderFacts)), None)
    if source is None:
        return []
    by_recipient = {}
    for item in source.due():
        by_recipient.setdefault(item["to"], []).append(item)
    delivered = []
    for name, items in sorted(by_recipient.items()):
        observation = discovery.agents.get(name)
        if observation is None:
            continue
        try:
            keys, _ = engine.delivered_keys(observation.session_id, min(i["at"] for i in items) - SINCE_SLACK)
        except V2Error:
            continue
        delivered += [item["id"] for item in items if "reminder:" + item["id"] in keys]
    gone = remove_reminders(source.state_dir, set(delivered)) if delivered else []
    if gone and engine.audit is not None:
        engine.audit.append(engine.actor, "reminder.prune", None, {"ids": gone})
    return gone


# ---- checkpoint reminders: a launch sets them from the brief's CHECKPOINT (docs/switchboard.md, "Self-wakes")

CHECKPOINT_WORKER_TEXT = "checkpoint due: report now, one line"
CHECKPOINT_OVERDUE_TEXT = "%s has not reported since launch: overdue checkpoint"
_CP_UNIT = r"(seconds?|secs?|minutes?|mins?|hours?|hrs?|[smh])?"
_CP_UNITS = {"s": 1, "m": 60, "h": 3600}
CHECKPOINT_MAX_SECONDS = 30 * 86400  # a checkpoint or overdue further out than this is refused, never an error
CHECKPOINT_MAX_DIGITS = 6


def _cp_when(text, moment):
    """parse_when for a checkpoint flag, bounded: too many digits or further than CHECKPOINT_MAX_SECONDS is refused."""
    if re.search(r"[0-9]{%d}" % (CHECKPOINT_MAX_DIGITS + 1), text):
        raise ReminderError("%r is too large; a checkpoint is at most 30 days out" % text[:40])
    at = parse_when(text, moment)
    if not moment - CHECKPOINT_MAX_SECONDS <= at <= moment + CHECKPOINT_MAX_SECONDS:
        raise ReminderError("%r is too far out; a checkpoint is at most 30 days away" % text[:40])
    return at


def _cp_seconds(number, unit, default):
    unit = (unit or default or "")[:1].lower()
    return int(number) * _CP_UNITS[unit] if unit in _CP_UNITS else None


def parse_checkpoint(brief):
    """(checkpoint seconds, overdue seconds) from the brief's CHECKPOINT line, or None. Best effort and never an
    error: 'Report at 30 minutes ...; overdue at 60', 'in 20m, overdue 45m'. A bare overdue number takes the
    unit of the checkpoint; no unit anywhere, a missing part, or an overdue that is not later = None."""
    line = next((l for l in (brief or "").splitlines() if re.match(r"\s*CHECKPOINT\s*:", l, re.I)), None)
    if line is None:
        return None
    over = re.search(r"\boverdue(?:\s+(?:at|after|in|by))?\s+(\d{1,6})\s*" + _CP_UNIT + r"\b", line, re.I)
    if over is None:
        return None
    head = line[:over.start()]
    first = re.search(r"\b(?:at|in|after|within)\s+(\d{1,6})\s*" + _CP_UNIT + r"\b", head, re.I)
    if first is None:
        return None
    checkpoint = _cp_seconds(first.group(1), first.group(2), over.group(2))
    overdue = _cp_seconds(over.group(1), over.group(2), first.group(2))
    if checkpoint is None or overdue is None or checkpoint <= 0 or overdue <= checkpoint:
        return None
    if overdue > CHECKPOINT_MAX_SECONDS:
        return None
    return checkpoint, overdue


def set_checkpoint_reminders(engine, state, name, boss, issue, repo, brief, checkpoint, overdue, launched, moment):
    """Make the launch's two reminders. `checkpoint`/`overdue` are --checkpoint/--overdue (delays or ISO times) or
    None; with neither, the brief's CHECKPOINT line is parsed. Returns one line for the launch output, or None.
    Never raises: the worker is already running."""
    try:
        notes = []
        if checkpoint is None and overdue is None:
            parsed = parse_checkpoint(brief)
            if parsed is None:
                return ("no checkpoint reminders: no --checkpoint/--overdue and the brief's CHECKPOINT line could "
                        "not be read as 'at <N> minutes ... overdue at <M>'")
            checkpoint, overdue = ("%ds" % parsed[0], "%ds" % parsed[1])
        when_worker = _cp_when(checkpoint, moment) if checkpoint is not None else None
        when_boss = _cp_when(overdue, moment) if overdue is not None and boss else None  # both checked before either is made
        made = []
        if when_worker is not None:
            item = add_reminder(state, name, when_worker, moment, CHECKPOINT_WORKER_TEXT, issue, boss, repo,
                                condition={"while_running": name})
            made.append(("worker", item))
        if overdue is not None:
            if not boss:
                notes.append("no overdue reminder: the launch names no --reports-to")
            else:
                item = add_reminder(state, boss, when_boss, moment, CHECKPOINT_OVERDUE_TEXT % name, issue, name, repo,
                                    condition={"unless_report_from": name, "since": launched})
                made.append(("overdue", item))
        for which, item in made:
            engine.audit.append("cli", "reminder.add", item["to"], {"id": item["id"], "at": iso(item["at"]),
                                                                   "from": item.get("from"), "issue": issue,
                                                                   "repo": repo, "for": "checkpoint-" + which})
        notes[:0] = ["%s reminder at %s" % (which, iso(item["at"])) for which, item in made]
        return "checkpoint reminders: " + "; ".join(notes) if notes else None
    except (ReminderError, OSError, ValueError, OverflowError) as err:
        return "no checkpoint reminders: %s" % _one_line(str(err), 200)


def cmd_remind(args, runner, now):
    engine, state, config = build_engine(runner, now, "cli")
    if args.sender is not None:
        if os.environ.get(LAB_ENV) != "1":
            sys.stderr.write("%s: --from is only for the Lab (%s=1); an agent is identified by its pane\n"
                             % (PROG, LAB_ENV))
            return EXIT_USAGE
        sender = args.sender
    else:
        sender = identify_caller(engine.herdr, engine.v2, os.environ)
    moment = now()
    try:
        repo, number = resolve_for_sender(engine, config, args.issue, sender)
    except IssueRefError as err:
        sys.stderr.write("%s: %s\n" % (PROG, err))
        return EXIT_USAGE
    item = add_reminder(state, args.name, parse_when(args.when, moment), moment,
                        " ".join(args.text).strip(), number, sender, repo)
    engine.audit.append("cli", "reminder.add", args.name, {"id": item["id"], "at": iso(item["at"]),
                                                          "from": sender, "issue": number, "repo": repo})
    print(item["id"])
    sys.stderr.write("%s: reminder for %s at %s\n" % (PROG, args.name, iso(item["at"])))
    return EXIT_OK


# ======================================================= GitHub events (PR 5)
#
# One section, self-contained. The pieces, in the order they are built:
#
#   config      `_validate_github`, called from validate_config
#   verify      `signature_matches`: HMAC-SHA256 of the raw body, constant time
#   items       webhook payloads and catch-up reads -> GitHubItem, with keys
#               made from GitHub object ids (never delivery ids)
#   hub         `GitHubHub`: the localhost listener, one supervised
#               `gh webhook forward` child per watched repo, the in-memory
#               queue the fact source drains, the catch-up read, routing
#   status      `github_status` / `format_github`
#
# Facts are not stored. Webhook arrivals wait in memory until the engine
# reports them delivered (or found in the recipient's transcript); a daemon
# restart relies on the catch-up read. The webhook secret is made for every
# forwarder start and lives only in memory and in that forwarder's argv.

GITHUB_EVENTS = ["issues", "issue_comment", "sub_issues", "pull_request", "pull_request_review",
                 "check_suite", "workflow_run"]
GITHUB_REPO_RE = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")
GITHUB_EVENT_RE = re.compile(r"^[a-z_]+$")
GITHUB_BACKOFF_BASE = 5        # seconds before the first restart; doubles each failure
GITHUB_BACKOFF_MAX = 300
GITHUB_STABLE = 60             # a forwarder that ran this long starts the backoff over
GITHUB_CONFLICT_RETRY = 1800   # seconds between attempts, and catch-up reads, while someone else forwards
GITHUB_CATCHUP_DELAY = 10      # seconds after a start: the forwarder has connected, so no gap remains
GITHUB_LOOKUP_TTL = 600
GITHUB_LOOKUP_RETRY = 60
GITHUB_BODY_LIMIT = 5 * 1024 * 1024
GITHUB_QUEUE_LIMIT = 2000
GITHUB_ROUTE_SECONDS = 5       # per pass: the time routing may spend on `gh api` lookups; the rest waits a pass
GITHUB_ROUTE_READ_TIMEOUT = 8  # seconds for one such lookup
GITHUB_CATCHUP_SECONDS = 90    # per catch-up: after this the remaining reads are left to the next one
GITHUB_CATCHUP_ITEMS = 500     # items one catch-up keeps (the newest)
GITHUB_SUBREAD_TIMEOUT = 10    # seconds for a secondary read (reviews, check suites, workflow runs)
GITHUB_READ_BACKOFF = 600      # a secondary read that failed is not tried again for this long
GITHUB_PAGE_SIZE = 100         # records per page of every list read
GITHUB_PAGE_CAP = 5            # pages one list read follows; the rest is skipped, not chased
GITHUB_MARKER_SLACK = 60       # seconds before the read marker a catch-up starts (a forwarder repo)
READ_MARKER_FILE = "github-read.json"  # {"owner/repo": "<iso>"}: how far each repo was read; a disposable cursor
GITHUB_AUDIT_KEYS = 20         # keys named in one audit line; the rest are only counted
SECONDARY_READS = ("reviews", "check suites", "workflow runs", "items")
GITHUB_REJECT_AUDITS = 20      # bad-signature audit lines per minute; the rest are only counted
CONFLICT_TEXT = "Hook already exists"
WATCH_FILE = "github-watch.json"
WATCH_STATES = ("starting", "running", "backoff", "conflict")


GH_USERS_KEY_RE = re.compile(r"^[A-Za-z0-9_.-]+/(?:[A-Za-z0-9_.-]+|\*)$")
GITHUB_POLL_MIN = 15           # seconds: a poll reads a repo's comments, issues, pulls and runs
GITHUB_LOGIN_RE = re.compile(r"^[A-Za-z0-9](?:[A-Za-z0-9_-]{0,38}|[A-Za-z0-9_-]{0,34}\[bot\])$")


def _validate_github(config, source):
    """Check the github_* keys and `gh`; give `config` its own copies of the lists."""
    repos = config["github_repos"]
    if not isinstance(repos, list) or not all(isinstance(r, str) and GITHUB_REPO_RE.match(r) for r in repos):
        raise ConfigError("%s: 'github_repos' must be a list of \"owner/repo\" strings, got %r" % (source, repos))
    if len(set(repos)) != len(repos):
        raise ConfigError("%s: 'github_repos' names a repo twice: one forwarder per repo" % source)
    events = config["github_events"]
    if not isinstance(events, list) or not events or not all(
            isinstance(e, str) and GITHUB_EVENT_RE.match(e) for e in events):
        raise ConfigError("%s: 'github_events' must be a non-empty list of event names such as "
                          "\"issue_comment\", got %r" % (source, events))
    if not isinstance(config["gh"], str) or not config["gh"].strip():
        raise ConfigError("%s: 'gh' must be a non-empty string (a path or a command name), got %r"
                          % (source, config["gh"]))
    if not _is_number(config["github_lookback_hours"]) or config["github_lookback_hours"] <= 0:
        raise ConfigError("%s: 'github_lookback_hours' must be a positive number, got %r"
                          % (source, config["github_lookback_hours"]))
    port = config["github_port"]
    if port is not None and not (isinstance(port, int) and not isinstance(port, bool) and 1 <= port <= 65535):
        raise ConfigError("%s: 'github_port' must be null (any free port) or a port number, got %r" % (source, port))
    ignore = config["github_ignore_authors"]
    if not isinstance(ignore, list) or not all(isinstance(a, str) and GITHUB_LOGIN_RE.match(a) for a in ignore):
        raise ConfigError("%s: 'github_ignore_authors' must be a list of GitHub logins, got %r" % (source, ignore))
    config["github_repos"], config["github_events"] = list(repos), list(events)
    config["github_ignore_authors"] = list(ignore)
    users = config["gh_users"]
    if not isinstance(users, dict) or not all(
            isinstance(k, str) and GH_USERS_KEY_RE.match(k) and isinstance(v, str) and GITHUB_LOGIN_RE.match(v)
            for k, v in users.items()):
        raise ConfigError("%s: 'gh_users' must map \"owner/repo\" or \"owner/*\" to a gh account name, got %r"
                          % (source, users))
    config["gh_users"] = dict(users)
    poll = config["github_poll_seconds"]
    if not _is_number(poll) or poll < GITHUB_POLL_MIN:
        raise ConfigError("%s: 'github_poll_seconds' must be a number of at least %d (each read of a repo costs "
                          "several API calls), got %r" % (source, GITHUB_POLL_MIN, poll))


# ------------------------------------------------------------- verification

def sign_body(secret, body):
    """The `X-Hub-Signature-256` value for `body` under `secret`."""
    return "sha256=" + hmac.new(secret.encode("utf-8"), body, hashlib.sha256).hexdigest()


def signature_matches(secret, body, header):
    """True when `header` is the signature of the raw `body`. Constant time."""
    if not isinstance(header, str) or not secret:
        return False
    return hmac.compare_digest(sign_body(secret, body).encode("ascii"), header.encode("utf-8", "replace"))


def _scrub(text, *secrets_):
    """`text` with every secret in `secrets_` replaced; for anything read back from a child."""
    for secret in secrets_:
        if secret:
            text = text.replace(secret, REDACTED)
    return text


# -------------------------------------------------------------------- items

class GitHubItem:
    """One thing that happened on GitHub, keyed by object id, not yet routed.

    `issues`: issue numbers it is known to concern (the issue, its parents,
    the issues a PR closes), nearest first. `lookups`: `("issue", n)` or
    `("pr", n)` reads that can add more, made only when `issues` names no
    owner. `recipient` is set once an owner is found.
    """

    def __init__(self, key, kind, summary, repo, issues, lookups, sender, created, numbers=(), actionable=True):
        self.key, self.kind, self.summary, self.repo = key, kind, summary, repo
        self.issues, self.lookups, self.sender, self.created = list(issues), list(lookups), sender, created
        self.recipient = None
        # PR 52: `numbers` are the issue or PR numbers the item sits on (a notice is looked up by them);
        # `actionable` is false for news that is not worth an agent's turn (a passing check, a bot's comment) and
        # is delivered only to an owner the old links found; `routed_by` says which link found the owner.
        self.numbers, self.actionable, self.routed_by = list(numbers), actionable, None

    @property
    def issue(self):
        return self.issues[0] if self.issues else None


CLOSES_RE = re.compile(r"\b(?:close[sd]?|fix(?:e[sd])?|resolve[sd]?)\b:?\s+(?:[\w.-]+/[\w.-]+)?#(\d+)", re.I)


PLAIN_REF_RE = re.compile(r"(?<![\w/&])#(\d{1,7})\b")


def reference_numbers(pr, own):
    """PR 52: the issue numbers a PR that closes nothing points at, for the weak link: the plain `#N` in its title
    and body, else the numbers in its head branch name (`drift2137`). Empty when the PR names a closing issue; the
    PR's own number is never a candidate. The caller accepts only exactly one."""
    if not isinstance(pr, dict) or closing_numbers(pr.get("body")) or pr.get("linked_issues"):
        return []
    text = " ".join(str(pr.get(field) or "") for field in ("title", "body"))
    found = []
    for match in PLAIN_REF_RE.finditer(text):
        if int(match.group(1)) not in found and int(match.group(1)) != own:
            found.append(int(match.group(1)))
    if not found:
        ref = (pr.get("head") or {}).get("ref")
        for match in re.finditer(r"(?<!\d)(\d{1,7})(?!\d)", ref if isinstance(ref, str) else ""):
            if int(match.group(1)) not in found and int(match.group(1)) != own and int(match.group(1)) > 0:
                found.append(int(match.group(1)))
    return found


def closing_numbers(text):
    """Issue numbers named by "closes #N", "fixes #N", "resolves #N" in a PR body."""
    found = []
    for match in CLOSES_RE.finditer(text if isinstance(text, str) else ""):
        if int(match.group(1)) not in found:
            found.append(int(match.group(1)))
    return found


def _id(obj):
    value = obj.get("id") if isinstance(obj, dict) else None
    return value if isinstance(value, int) and not isinstance(value, bool) else None


def _number(obj):
    value = obj.get("number") if isinstance(obj, dict) else None
    return value if isinstance(value, int) and not isinstance(value, bool) and value >= 1 else None


ACTIONABLE_CONCLUSIONS = ("failure", "cancelled", "timed_out")  # PR 52: the checks an agent is told about


def _is_bot(obj):
    """A comment or review written by a bot: a login ending `[bot]` or a user of type Bot."""
    user = obj.get("user") if isinstance(obj, dict) else None
    if not isinstance(user, dict):
        return False
    login = user.get("login")
    return (isinstance(login, str) and login.lower().endswith("[bot]")) or str(user.get("type") or "").lower() == "bot"


def _login(obj):
    user = obj.get("user") if isinstance(obj, dict) else None
    login = user.get("login") if isinstance(user, dict) else None
    return login if isinstance(login, str) and login else None


# An agent's own words on GitHub. The agents share the user's GitHub account, so the author cannot say
# who wrote a comment, and each agent comment came back to its author as a wake (the trial's orchestrator:
# "that message is just my own comment coming back"). `fleet-switchboard comment` and `handoff` sign what
# they post with an HTML comment, invisible when GitHub renders it; a signed comment is never an event.
FLEET_MARK = re.compile(r"<!--\s*fleet-switchboard:from=([A-Za-z0-9_-]{1,64})\s*-->")


def fleet_mark(name):
    return "<!-- fleet-switchboard:from=%s -->" % name


def signed_by_fleet(body):
    """The agent a body was signed by, or None."""
    match = FLEET_MARK.search(body) if isinstance(body, str) else None
    return match.group(1) if match else None


def _url_number(url):
    match = re.search(r"/(?:issues|pulls)/([0-9]+)$", url) if isinstance(url, str) else None
    return int(match.group(1)) if match else None


def awaiting_cos_label(config):
    """PR 18: the label that marks an issue as waiting on the Chief of Staff: the config's, or
    `<user>:awaiting-cos`. The Chief of Staff either resolves it or escalates it to `awaiting_label`."""
    return config.get("awaiting_cos_label") or "%s:awaiting-cos" % getpass.getuser()


def orchestrator_label(config=None):
    """PR 18: the label that marks a charter, `<user>:orchestrator` (skills/fleet-charter)."""
    return "%s:orchestrator" % getpass.getuser()


def awaiting_label(config):
    """The label that marks an issue as waiting on you: the config's, or the charter convention's
    `<user>:awaiting-user`, where the prefix is the OS user (`whoami`), as in skills/fleet-charter."""
    return config.get("awaiting_label") or "%s:awaiting-user" % getpass.getuser()


def parse_iso(text):
    """An ISO-8601 time with `Z` or an offset -> epoch seconds, or None."""
    return decision_core.parse_iso(text)


def parent_of(issue):
    """The parent issue number a payload or REST issue names, if it does."""
    if not isinstance(issue, dict):
        return None
    for field in ("parent", "parent_issue"):
        value = issue.get(field)
        found = value if isinstance(value, int) and not isinstance(value, bool) else _number(value)
        if found:
            return found
    return _url_number(issue.get("parent_issue_url"))


def _is_pr(issue):
    return isinstance(issue, dict) and bool(issue.get("pull_request"))


def _issue_refs(issue, number):
    """(known issue numbers, lookups) for something that lives on issue or PR `number`."""
    if _is_pr(issue):
        return closing_numbers(issue.get("body")), [("pr", number)]
    parent = parent_of(issue)
    if parent:
        return [number, parent], [("issue", parent)]
    return [number], [("issue", number)]


def _pr_refs(pr, number):
    """(known, lookups) for a PR object: the issues it closes, the ones the payload links."""
    known = closing_numbers(pr.get("body") if isinstance(pr, dict) else None)
    linked = pr.get("linked_issues") if isinstance(pr, dict) else None
    for entry in linked if isinstance(linked, list) else []:
        n = entry if isinstance(entry, int) and not isinstance(entry, bool) else _number(entry)
        if n and n not in known:
            known.append(n)
    return known, [("issue", n) for n in known] if known else [("pr", number)]


def _pr_numbers(obj):
    prs = obj.get("pull_requests") if isinstance(obj, dict) else None
    return [n for n in (_number(p) for p in (prs if isinstance(prs, list) else [])) if n]


def _comment_item(repo, comment, issue, now):
    cid = _id(comment)
    number = _number(issue) or _url_number(comment.get("issue_url"))
    if cid is None or number is None or signed_by_fleet(comment.get("body")):
        return None
    known, lookups = _issue_refs(issue, number)
    summary = "@%s commented on #%d: %s" % (_login(comment) or "someone", number, _one_line(comment.get("body") or "", 400))
    return GitHubItem("github.comment:%d" % cid, "github.comment", summary, repo, known, lookups, _login(comment), now,
                      [number], not _is_bot(comment))


def _issue_item(repo, issue, now, what=None):
    iid, number, updated = _id(issue), _number(issue), issue.get("updated_at")
    if iid is None or number is None or not isinstance(updated, str):
        return None
    known, lookups = _issue_refs(issue, number)
    summary = "issue #%d %s: %s" % (number, what or "updated", _one_line(issue.get("title") or "", 200))
    return GitHubItem("github.issue:%d:%s" % (iid, updated), "github.issue", summary, repo, known, lookups,
                      _login(issue), now)


def _pr_state(pr):
    return "merged" if pr.get("merged") or pr.get("merged_at") else str(pr.get("state") or "open")


def _pr_item(repo, pr, now):
    pid, number = _id(pr), _number(pr)
    if pid is None or number is None:
        return None
    state = _pr_state(pr)
    known, lookups = _pr_refs(pr, number)
    summary = "PR #%d is %s: %s" % (number, state, _one_line(pr.get("title") or "", 200))
    return GitHubItem("github.pr:%d:%s" % (pid, state), "github.pr", summary, repo, known, lookups, _login(pr), now,
                      [number], False)


def _conflict_item(repo, number, sha, now):
    """PR 52: one item per PR head commit that cannot be merged; its key makes a redelivery one item."""
    if not isinstance(sha, str) or not sha or not isinstance(number, int):
        return None
    return GitHubItem("github.conflict:%s#%d:%s" % (repo, number, sha), "github.conflict",
                      "PR #%d has a merge conflict with its base (head %s)" % (number, sha[:7]), repo, [],
                      [("pr", number)], None, now, [number], True)


def _pr_conflict(repo, pr, now):
    """The conflict item of a PR object that says so (`mergeable_state` dirty, or `mergeable` false), or None."""
    if not isinstance(pr, dict) or _pr_state(pr) != "open":
        return None
    if str(pr.get("mergeable_state") or "").lower() != "dirty" and pr.get("mergeable") is not False:
        return None
    return _conflict_item(repo, _number(pr), (pr.get("head") or {}).get("sha"), now)


def _review_item(repo, review, pr, now):
    rid, number = _id(review), _number(pr)
    if rid is None or number is None or signed_by_fleet(review.get("body")):
        return None
    known, lookups = _pr_refs(pr, number)
    state = str(review.get("state") or "reviewed").lower()
    summary = "@%s reviewed PR #%d (%s): %s" % (_login(review) or "someone", number, state,
                                                _one_line(review.get("body") or "", 300))
    return GitHubItem("github.review:%d" % rid, "github.review", summary, repo, known, lookups, _login(review), now,
                      [number], state == "changes_requested")


def _check_item(repo, obj, now, prefix, label):
    oid, conclusion = _id(obj), obj.get("conclusion")
    numbers = _pr_numbers(obj)
    if oid is None or not isinstance(conclusion, str) or not conclusion or not numbers:
        return None
    summary = "%s %s on PR %s" % (label, conclusion, ", ".join("#%d" % n for n in numbers))
    return GitHubItem("github.check:%s%d:%s" % (prefix, oid, conclusion), "github.check", summary, repo, [],
                      [("pr", n) for n in numbers], None, now, numbers, conclusion.lower() in ACTIONABLE_CONCLUSIONS)


def _wh_issues(repo, payload, now):
    action, issue = payload.get("action"), payload.get("issue")
    if action not in ("opened", "edited", "closed", "reopened", "labeled", "unlabeled"):
        return []
    what = action
    label = (payload.get("label") or {}).get("name") if isinstance(payload.get("label"), dict) else None
    if action in ("labeled", "unlabeled") and label:
        what = "label %s %s" % (label, "added" if action == "labeled" else "removed")
    item = _issue_item(repo, issue, now, what)
    return [item] if item else []


def _wh_issue_comment(repo, payload, now):
    if payload.get("action") != "created":
        return []
    item = _comment_item(repo, payload.get("comment") or {}, payload.get("issue"), now)
    return [item] if item else []


def _wh_pull_request(repo, payload, now):
    if payload.get("action") not in ("opened", "reopened", "closed", "ready_for_review"):
        return []
    pr = payload.get("pull_request") or {}
    return [item for item in (_pr_item(repo, pr, now), _pr_conflict(repo, pr, now)) if item]


def _wh_review(repo, payload, now):
    if payload.get("action") != "submitted":
        return []
    item = _review_item(repo, payload.get("review") or {}, payload.get("pull_request") or {}, now)
    return [item] if item else []


def _wh_check_suite(repo, payload, now):
    if payload.get("action") != "completed":
        return []
    item = _check_item(repo, payload.get("check_suite") or {}, now, "", "check suite")
    return [item] if item else []


def _wh_workflow_run(repo, payload, now):
    if payload.get("action") != "completed":
        return []
    run = payload.get("workflow_run") or {}
    item = _check_item(repo, run, now, "run-", "workflow %s" % (run.get("name") or "run"))
    return [item] if item else []


def _wh_sub_issues(repo, payload, now):
    parent, sub, action = payload.get("parent_issue"), payload.get("sub_issue"), payload.get("action")
    pid, sid, pn, sn = _id(parent), _id(sub), _number(parent), _number(sub)
    if None in (pid, sid, pn, sn) or not isinstance(action, str):
        return []
    summary = "sub-issue #%d: %s (parent #%d)" % (sn, action.replace("_", " "), pn)
    return [GitHubItem("github.subissue:%d:%d:%s" % (pid, sid, action), "github.subissue", summary, repo,
                       [pn, sn], [("issue", pn)], _login(payload.get("sender")), now)]


WEBHOOK_HANDLERS = {"issues": _wh_issues, "issue_comment": _wh_issue_comment, "pull_request": _wh_pull_request,
                    "pull_request_review": _wh_review, "check_suite": _wh_check_suite,
                    "workflow_run": _wh_workflow_run, "sub_issues": _wh_sub_issues}


def webhook_items(event, payload, now):
    """The items one webhook delivery holds. An event nobody handles holds none."""
    handler = WEBHOOK_HANDLERS.get(event)
    repo = (payload.get("repository") or {}).get("full_name") if isinstance(payload, dict) else None
    if handler is None or not isinstance(repo, str):
        return []
    return handler(repo, payload, now)


def decode_json_stream(text):
    """Every JSON value in `text`: `gh api --paginate` prints one document per page."""
    decoder, values, at = json.JSONDecoder(), [], 0
    while True:
        while at < len(text) and text[at].isspace():
            at += 1
        if at >= len(text):
            return values
        value, at = decoder.raw_decode(text, at)
        values.append(value)


def _records(values, key=None):
    """The records in pages: lists are flattened; with `key`, an object's list under it."""
    records = []
    for value in values:
        if isinstance(value, list):
            records.extend(value)
        elif isinstance(value, dict) and key and isinstance(value.get(key), list):
            records.extend(value[key])
    return [r for r in records if isinstance(r, dict)]


def _is_orchestrator(observation):
    return (observation.fleet or {}).get("role") == "orchestrator"


def pick_owner(agents, numbers, repo=None, default_repo=None):
    """The fleet agent that owns the first of `numbers`, or None. One recipient per item.

    An agent owns the issues in its metadata.fleet `issue` and `charter`. An
    orchestrator beats any other role; then the nearest issue in `numbers`
    wins, then the name.
    """
    best = None
    for name in sorted(agents):
        fleet = agents[name].fleet or {}
        theirs = fleet.get("repo") if isinstance(fleet.get("repo"), str) else default_repo  # PR 15: with several repos
        if repo and theirs and theirs != repo:                                               # an agent has one
            continue
        owned = set()
        for field in ("issue", "charter"):
            value = fleet.get(field)
            if isinstance(value, int) and not isinstance(value, bool):
                owned.add(value)
            elif isinstance(value, str) and value.strip().lstrip("#").isdigit():
                owned.add(int(value.strip().lstrip("#")))
        ranks = [numbers.index(n) for n in owned if n in numbers]
        if ranks:
            rank = (0 if fleet.get("role") == "orchestrator" else 1, min(ranks))
            if best is None or rank < best[0]:
                best = (rank, name)
    return best[1] if best else None


# ------------------------------------------------------------------- the hub

class GitHubUnavailable(Exception):
    """A `gh api` read that did not answer; the caller tries again later."""


FORWARDER_HISTORY_SECONDS = 3600
FORWARDER_DOWN_ALARM = 300       # not running this long (seconds) is an alarm
FORWARDER_FLAP_DROPS = 6         # more than this many drops in FORWARDER_FLAP_WINDOW is flapping
FORWARDER_FLAP_WINDOW = 600
FORWARDER_SHORT_RUN = 60         # a run shorter than this is a short run; three in the window is flapping
FORWARDER_SHORT_RUNS = 3


def forwarder_health(watch, now):
    """#77: what status says about one forwarder, from the snapshot alone: live or down with its own age, the
    drops as quiet history, and an alarm (a string) when it has been down or flapping too long, else None."""
    drops = [(t, r) for t, r in (watch.get("drops") or []) if now - t < FORWARDER_HISTORY_SECONDS]
    live = watch.get("mode") == "forwarder"
    started = parse_iso(watch["started"]) if watch.get("started") else None
    recent = [(t, r) for t, r in drops if now - t < FORWARDER_FLAP_WINDOW]
    health = {"live": live, "up_age": max(0, now - started) if live and started is not None else None,
              "down_age": None, "drops_hour": len(drops), "last_drop_age": max(0, now - drops[-1][0]) if drops else None,
              "alarm": None}
    if watch.get("mode") == "conflict":  # someone else forwards, by intent; catch-up reads continue: not an alarm
        health["quiet"] = "conflict"
        return health
    if not live and watch.get("down_since") is not None and watch.get("mode") not in ("polling", "failed"):
        health["down_age"] = max(0, now - watch["down_since"])
        if health["down_age"] > FORWARDER_DOWN_ALARM:
            health["alarm"] = "down for %s" % format_age(health["down_age"])
    if health["alarm"] is None and len(recent) > FORWARDER_FLAP_DROPS:
        health["alarm"] = "flapping: %d drops in 10 min" % len(recent)
    elif health["alarm"] is None and sum(1 for _, r in recent if r < FORWARDER_SHORT_RUN) >= FORWARDER_SHORT_RUNS:
        health["alarm"] = "flapping: %d runs under %ds in 10 min" % (
            sum(1 for _, r in recent if r < FORWARDER_SHORT_RUN), FORWARDER_SHORT_RUN)
    return health


class Watch:
    """One watched repo: its forwarder child and what is known about it. Memory only."""

    def __init__(self, repo):
        self.repo, self.state, self.proc, self.secret = repo, "backoff", None, None
        self.failures = self.starts = 0
        self.next_start = 0.0
        self.started = self.catchup_at = self.last_catch_up = None
        self.last_error = self.catch_up_error = None
        self.drops = []          # #77: (time dropped, seconds it had run), the last hour's worth; memory only
        self.down_since = None   # when the forwarder last stopped, until it runs again
        # PR 15: a repo whose forwarder cannot work (no such repo yet, no right to make a webhook) is read on
        # a poll instead: the existing catch-up read, every github_poll_seconds.
        self.polling, self.poll_reason, self.next_poll, self.last_poll = False, None, 0.0, None

    @property
    def mode(self):
        """How the repo is watched: forwarder, polling, failed (polling, and the poll cannot read it either),
        or the supervisor's own state while the forwarder starts, backs off or finds a conflict."""
        try:
            alive = self.proc is not None and self.proc.poll() is None
        except Exception:  # describing a watch must never be what fails
            alive = True
        if alive:
            return "forwarder"
        if self.polling:
            return "failed" if self.catch_up_error else "polling"
        return self.state

    def to_json(self):
        """What `status` may show. Never the secret."""
        return {"repo": self.repo, "state": self.state, "mode": self.mode, "poll_reason": self.poll_reason,
                "starts": self.starts, "failures": self.failures,
                "forwarder_pid": getattr(self.proc, "pid", None), "started": iso(self.started),
                "next_start": iso(self.next_start) if self.proc is None else None,
                "last_catch_up": iso(self.last_catch_up), "last_error": self.last_error,
                "drops": [[t, r] for t, r in self.drops], "down_since": self.down_since,
                "catch_up_error": self.catch_up_error}


def spawn_forwarder(argv, log_path, env=None):
    """Start the forwarder detached, its output in `log_path`. It never inherits our pipes. `env` (PR 15)
    is the repo's account's environment, the only place its token ever is."""
    fd = os.open(str(log_path), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        return subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=fd, stderr=fd, env=env,
                                start_new_session=True, close_fds=True)
    finally:
        os.close(fd)


def _terminate(proc):
    """Stop a forwarder and anything it started (it leads its own process group)."""
    try:
        if isinstance(proc, subprocess.Popen):
            os.killpg(proc.pid, signal.SIGTERM)
        else:
            proc.terminate()
    except (OSError, ProcessLookupError):
        pass


_USAGE_LINE = re.compile(r"^\s*(-{1,2}[A-Za-z]|usage:|flags:|examples?:|global flags:|\$ |#|use \")", re.I)
_ERROR_LINE = re.compile(r"\b(error|failed|failure|unauthorized|forbidden|denied|not found|refused|timed? ?out|invalid)\b", re.I)


NO_RIGHTS_RE = re.compile(r"admin rights|Resource not accessible|HTTP 40[13]|Bad credentials|forbidden", re.I)
NOT_FOUND_RE = re.compile(r"Not Found|HTTP 404|Could not resolve", re.I)


def unwatchable_reason(tail):
    """Why a forwarder that exited can never work here (so the repo is polled), or None for an ordinary failure."""
    if NO_RIGHTS_RE.search(tail):
        return "the account cannot create a webhook"
    if NOT_FOUND_RE.search(tail):
        return "the repo does not exist yet, or this account cannot see it"
    return None


def forwarder_reason_line(lines):
    """The line of a dead forwarder's output that says why. cobra prints the error and then the whole usage
    text, so the LAST line is a flag description (the trial's audit said `-U, --url string Address of the
    local server...`). First an error-looking line that is not usage, then any line that is not usage."""
    plain = [line for line in lines if not _USAGE_LINE.match(line)]
    for line in plain:
        if _ERROR_LINE.search(line):
            return line
    return (plain or lines)[0]


class GitHubHub:
    """The listener, the forwarder supervisor, the queue and the catch-up read.

    Everything shared between the listener thread, the supervisor thread and
    the engine's pass is behind `self.lock`. `now`, `runner` (for `gh api`) and
    `spawn` (for the forwarders) are injected, so tests run a simulated clock
    and a fake `gh` and never reach a real binary.
    """

    def __init__(self, config, state_dir, audit=None, runner=subprocess.run, spawn=spawn_forwarder,
                 now=time.time, actor="daemon"):
        self.config, self.state_dir, self.audit = config, Path(state_dir), audit
        self.runner, self.spawn, self.now, self.actor = runner, spawn, now, actor
        self.lock = threading.RLock()
        self.queue = {}        # key -> GitHubItem, until delivered
        self.watches = {repo: Watch(repo) for repo in config["github_repos"]}
        self.accounts = GhAccounts(config, runner, now)  # PR 15: a gh account per repo
        self.lookback = config["github_lookback_hours"] * 3600
        self.backoff_base, self.backoff_max = GITHUB_BACKOFF_BASE, GITHUB_BACKOFF_MAX
        self.conflict_retry, self.catchup_delay = GITHUB_CONFLICT_RETRY, GITHUB_CATCHUP_DELAY
        self.discover = lambda: None  # set by attach()
        self.autostart = True
        self.port, self.server, self.threads, self.stopping = config["github_port"] or 0, None, [], threading.Event()
        self._cache, self._retry, self._rejects, self._suppressed = {}, {}, [], 0
        self._unrouted, self._snapshot = set(), None
        self._route_until, self._unrouted_batch, self._read_backoff = None, [], {}
        self._notices, self._filtered, self._filtered_batch = {}, set(), []   # PR 52
        self._routed_batch, self._conflicts = [], set()
        self.markers, self._markers_dirty, self.last_truncated = self._load_markers(), False, {}
        self.engine = None
        self.intent_edits = {}  # intent.edit key -> the `issues` payload, until delivered (PR 6's item, wired here)
        self.awaiting = {}      # PR 14: (repo, number) -> {"title", "since", "parent"} of an open issue with the label
        self.awaiting_read = {}  # PR 14: repo -> None (read fine) or the error of the last labelled read; absent: never

    # -- wiring

    def attach(self, engine):
        """Make this hub one of `engine`'s fact sources, reading the fleet through it."""
        self.engine = engine
        engine.hub = self  # PR 14: the decisions derivation reads the awaiting-user issues from it
        self.discover = lambda: engine.discover(engine.now())
        engine.sources.append(self.fact_source())
        return engine

    def _audit(self, event, subject, detail):
        if self.audit is not None:
            self.audit.append(self.actor, event, subject, detail)

    # -- the listener

    def open_listener(self):
        """Bind 127.0.0.1 (never another address) and serve POST /github in a thread."""
        hub = self

        class Handler(BaseHTTPRequestHandler):
            server_version = "fleet-switchboard"
            timeout = 10  # a stalled sender must not hold a thread

            def _reply(self, status, text):
                data = (text + "\n").encode("utf-8")
                self.send_response(status)
                self.send_header("Content-Type", "text/plain; charset=utf-8")
                self.send_header("Content-Length", str(len(data)))
                self.end_headers()
                self.wfile.write(data)

            def do_POST(self):
                try:
                    size = int(self.headers.get("Content-Length", ""))
                except ValueError:
                    return self._reply(411, "length required")
                if size < 0 or size > GITHUB_BODY_LIMIT:
                    return self._reply(413, "too large")
                status, text = hub.receive(self.path.split("?")[0], self.headers, self.rfile.read(size))
                self._reply(status, text)

            def do_GET(self):
                self._reply(405, "POST only")

            def log_message(self, *args):  # the daemon's stderr is not a log
                pass

        server = ThreadingHTTPServer(("127.0.0.1", self.port), Handler)
        server.daemon_threads = True
        self.server, self.port = server, server.server_address[1]
        self._thread(server.serve_forever)
        return self.port

    def _thread(self, target):
        thread = threading.Thread(target=target, daemon=True)
        thread.start()
        self.threads.append(thread)

    def start(self):
        """Open the listener, then supervise the forwarders every second. Idempotent."""
        with self.lock:
            if self.server is not None:
                return
            self.stopping.clear()
            self.open_listener()
            self._thread(self._supervise)

    def _supervise(self):
        while not self.stopping.wait(1.0):
            try:
                self.tick()
            except Exception as err:  # the supervisor must outlive any one bad tick
                self._audit("github.error", None, {"error": _one_line(str(err))})

    def stop(self):
        """Stop the listener and every forwarder."""
        self.stopping.set()
        server, self.server = self.server, None
        if server is not None:
            server.shutdown()
            server.server_close()
        with self.lock:
            for watch in self.watches.values():
                if watch.proc is not None:
                    _terminate(watch.proc)
                    watch.proc, watch.secret, watch.state = None, None, "backoff"
            self._save_markers()
            self._write_snapshot(self.now(), stopped=True)

    # -- receiving

    def _verified_repo(self, header, body):
        """The repo whose current secret signed `body`, or None. Checks every secret."""
        match = None
        with self.lock:
            for repo, watch in self.watches.items():
                if watch.secret and signature_matches(watch.secret, body, header):
                    match = repo
        return match

    def _reject(self, reason, body):
        now = self.now()
        with self.lock:
            self._rejects = [t for t in self._rejects if now - t < 60]
            if len(self._rejects) >= GITHUB_REJECT_AUDITS:
                self._suppressed += 1
                return
            self._rejects.append(now)
            suppressed, self._suppressed = self._suppressed, 0
        self._audit("github.rejected", None, {"reason": reason, "bytes": len(body), "also_rejected": suppressed})

    def receive(self, path, headers, body):
        """One POST. The signature is checked before the body is read as anything.

        Returns (HTTP status, one line). Nothing is ingested unless it passes.
        """
        if path != "/github":
            return 404, "not found"
        header = _header(headers, "X-Hub-Signature-256")
        repo = self._verified_repo(header, body)
        if repo is None:
            self._reject("signature missing" if not header else "signature does not match", body)
            return 401, "bad signature"
        try:
            payload = json.loads(body.decode("utf-8"))
            if not isinstance(payload, dict):
                raise ValueError("not an object")
        except ValueError:
            self._audit("github.rejected", repo, {"reason": "body is not a JSON object", "bytes": len(body)})
            return 400, "bad body"
        event = _header(headers, "X-GitHub-Event") or ""
        sent = (payload.get("repository") or {}).get("full_name")
        if sent not in (None, repo):
            self._audit("github.rejected", repo, {"reason": "payload names another repo", "event": event})
            return 202, "ignored"
        try:
            items = webhook_items(event, dict(payload, repository={"full_name": repo}), self.now())
        except Exception as err:
            self._audit("github.rejected", repo, {"reason": "unreadable %s: %s" % (event, _one_line(str(err)))})
            return 400, "bad payload"
        self.enqueue(items)
        with self.lock:  # live traffic moves the marker, unless a catch-up still has a gap to close
            watch = self.watches.get(repo)
            live = watch is not None and watch.catchup_at is None and repo in self.markers
        if live:
            self._set_marker(repo, self.now())
        self.note_issue_edit(event, repo, payload)
        self.note_awaiting_event(event, repo, payload)
        self._audit("github.received", repo, {"event": event, "delivery": _header(headers, "X-GitHub-Delivery"),
                                              "keys": [item.key for item in items]})
        return 202, "accepted"

    def enqueue(self, items):
        ignore = {a.lower() for a in self.config.get("github_ignore_authors") or []}
        if ignore:
            dropped = [item for item in items if (item.sender or "").lower() in ignore]
            if dropped:
                self._audit("github.ignored", dropped[0].repo, {"keys": [item.key for item in dropped],
                                                                "authors": sorted({item.sender for item in dropped})})
                items = [item for item in items if item not in dropped]
        with self.lock:
            for item in items:
                self.queue.setdefault(item.key, item)  # the same object seen twice is one item
            while len(self.queue) > GITHUB_QUEUE_LIMIT:
                self.queue.pop(next(iter(self.queue)))

    def acknowledge(self, keys):
        """The engine found these keys delivered: forget them. Not stored, so a later
        catch-up that reads them again queues them once more, and the transcript
        stops the repeat."""
        with self.lock:
            for key in keys:
                self.queue.pop(key, None)
                self.intent_edits.pop(key, None)

    # -- an edit to an ask's Intent (PR 6's item and toast, which nothing called until now)

    def note_issue_edit(self, event, repo, payload):
        """On an edited issue: drop its cached Intent, so the next message carries the new lines (a
        message built from the old cache said the old Done when), and hold the edit for the Chief of
        Staff when the Intent section itself changed. Never raises: a bad payload is only not surfaced."""
        if event != "issues" or payload.get("action") != "edited":
            return
        try:
            number = (payload.get("issue") or {}).get("number")
            reader = getattr(self.engine, "intents", None)
            if reader is not None and isinstance(number, int):
                reader.invalidate(number, repo)
            fact = intent_change_fact(dict(payload, repository={"full_name": repo}), "chief-of-staff")
            if fact is not None:
                with self.lock:
                    self.intent_edits[fact.key] = dict(payload, repository={"full_name": repo})
                    while len(self.intent_edits) > GITHUB_QUEUE_LIMIT:
                        self.intent_edits.pop(next(iter(self.intent_edits)))
        except Exception as err:
            self._audit("github.rejected", repo, {"reason": "intent edit not surfaced: %s" % _one_line(str(err))})

    def _chiefs_of_staff(self):
        discovery = self.discover()
        agents = discovery.agents if discovery is not None and not discovery.problems else {}
        return sorted(name for name, seen in agents.items() if (seen.fleet or {}).get("role") == "chief-of-staff")

    def intent_edit_facts(self):
        with self.lock:
            edits = list(self.intent_edits.values())
        found = []
        if edits:
            for name in self._chiefs_of_staff():
                for payload in edits:
                    fact = intent_change_fact(payload, name)
                    if fact is not None and fact.created >= self.now() - self.lookback:
                        found.append(fact)
        return found

    def toasts(self):
        """One toast per pending Intent edit, through the engine's render step (the one toast path)."""
        found = []
        with self.lock:
            edits = list(self.intent_edits.values())
        if edits:
            for name in self._chiefs_of_staff():
                for payload in edits:
                    toast = intent_change_toast(payload)
                    if toast is not None:
                        number, updated, _ = _payload_issue(payload)
                        found.append((name, "intent edit #%d %s" % (number, updated), toast["title"], toast["body"]))
        found.extend(self.polling_toasts())
        return found

    def polling_toasts(self):
        """PR 15: one toast per repo that is polled because its forwarder cannot work, for as long as it is."""
        with self.lock:
            polled = [(w.repo, w.poll_reason, w.last_error) for _, w in sorted(self.watches.items()) if w.polling]
        return [("github:%s" % repo, "polling: %s" % reason, "GitHub: %s is read on a poll" % repo,
                 _one_line("no webhook (%s); read every %gs. %s" % (reason, self.config["github_poll_seconds"],
                                                                    last_error or ""), 200))
                for repo, reason, last_error in polled]

    # -- the fact source

    def fact_source(self):
        def github_facts():
            self.reconcile(getattr(self.engine, "discovery", None))  # PR 15: the watched set, every pass
            if self.autostart and self.watches:
                self.start()  # inside the daemon's lock: the first pass starts it
            return self.facts()
        github_facts.acknowledge = self.acknowledge
        github_facts.toasts = self.toasts
        return github_facts

    def reconcile(self, discovery):
        """PR 15: make the watches the derived set (`watched_repos`): start one for a repo that joined, stop
        one that nobody names any more. A fleet that cannot be read changes nothing."""
        if discovery is None or discovery.problems:
            return
        wanted = set(watched_repos(self.config, discovered_fleets(discovery)))
        with self.lock:
            joined = sorted(wanted - set(self.watches))
            left = sorted(set(self.watches) - wanted)
            for repo in joined:
                self.watches[repo] = Watch(repo)
            gone = [(repo, self.watches.pop(repo)) for repo in left]
        for repo in joined:
            self._audit("github.watch", repo, {"state": "joined"})
        for repo, watch in gone:
            if watch.proc is not None:
                _terminate(watch.proc)
            watch.proc = watch.secret = None
            self._audit("github.watch", repo, {"state": "left"})

    def facts(self):
        """Every queued item that has an owner now, as Facts. Expired items are dropped."""
        now = self.now()
        with self.lock:
            for key in [k for k, i in self.queue.items() if i.created < now - self.lookback]:
                del self.queue[key]
        self.note_conflicts(now)
        with self.lock:
            waiting = [item for item in self.queue.values() if item.recipient is None]
        if waiting:
            self._notices = self._load_notices()
            discovery = self.discover()
            self._route_until = None if fault("catch-up-blocks-pass") else now + GITHUB_ROUTE_SECONDS
            try:
                for item in waiting:
                    if self._route_until is not None and self.now() >= self._route_until:
                        break  # the rest is routed on the next pass: the pass itself must stay on schedule
                    self._route(item, discovery, now)
            finally:
                self._route_until = None
            self._audit_unrouted()
            self._audit_routed()
        with self.lock:
            found = [Fact(i.key, i.recipient, i.kind, i.summary, i.created, issue=i.issue, sender=i.sender,
                          repo=i.repo)
                     for i in self.queue.values() if i.recipient]
        found.extend(self.intent_edit_facts())
        for fact in found:
            # An object seen again (a catch-up, a redelivery) was perhaps delivered long
            # ago: the engine's read of the transcript must reach back that far.
            fact.look_back = self.lookback
        return found

    def _route(self, item, discovery, now):
        if discovery is None or discovery.problems:
            return  # the fleet cannot be read: keep it, ask again next pass
        try:
            owner, routed_by = self.route_of(item, discovery.agents, now)
        except GitHubUnavailable:
            return
        with self.lock:
            if owner and not item.actionable and routed_by != "closing":
                # PR 52: an owner found by a new link is told what needs it, not every passing check
                if item.key in self.queue:
                    del self.queue[item.key]
                    if item.key not in self._filtered:
                        if len(self._filtered) > 20000:
                            self._filtered.clear()
                        self._filtered.add(item.key)
                        self._filtered_batch.append((item, routed_by))
            elif owner:
                item.recipient, item.routed_by = owner, routed_by
                self._routed_batch.append(item)
            elif item.key in self.queue:
                del self.queue[item.key]
                if item.key not in self._unrouted:
                    if len(self._unrouted) > 20000:
                        self._unrouted.clear()
                    self._unrouted.add(item.key)
                    self._unrouted_batch.append(item)

    def _audit_unrouted(self):
        """One audit line per repo per pass for the items that belong to nobody, not one line each."""
        with self.lock:
            batch, self._unrouted_batch = self._unrouted_batch, []
        by_repo = {}
        for item in batch:
            by_repo.setdefault(item.repo, []).append(item)
        for repo, items in sorted(by_repo.items(), key=lambda pair: str(pair[0])):
            issues = sorted({n for item in items for n in item.issues})
            prs = sorted({n for item in items for n in item.numbers})
            self._audit("github.unrouted", repo, {"keys": [i.key for i in items[:GITHUB_AUDIT_KEYS]], "count": len(items),
                                                   "issues": issues[:GITHUB_AUDIT_KEYS],
                                                   "prs": prs[:GITHUB_AUDIT_KEYS]})

    def _audit_routed(self):
        """PR 52: one line per repo, link and recipient per pass for what was routed, and one for what a new link
        found an owner for but was not worth delivering (a passing check): the field `routed_by` is how a route is read."""
        with self.lock:
            routed, self._routed_batch = self._routed_batch, []
            filtered, self._filtered_batch = self._filtered_batch, []
        groups = {}
        for item in routed:
            groups.setdefault((item.repo, item.routed_by, item.recipient), []).append(item)
        for (repo, by, recipient), items in sorted(groups.items(), key=lambda pair: tuple(str(x) for x in pair[0])):
            self._audit("github.routed", repo, {"routed_by": by, "to": recipient, "count": len(items),
                                                "keys": [i.key for i in items[:GITHUB_AUDIT_KEYS]]})
        skipped = {}
        for item, by in filtered:
            skipped.setdefault((item.repo, by), []).append(item)
        for (repo, by), items in sorted(skipped.items()):
            self._audit("github.not_delivered", repo, {"routed_by": by, "count": len(items), "why": "not actionable",
                                                       "keys": [i.key for i in items[:GITHUB_AUDIT_KEYS]]})

    def note_conflicts(self, now):
        """PR 52: a conflict item for each open PR with a notice whose last read says it cannot be merged, once per
        head commit (the key names it; the set keeps it from being queued again after delivery). No read of its own:
        it uses what the notice reads (`notice_facts`) already hold, about one per PR per PR_FACTS_TTL."""
        held = getattr(self.engine, "notice_facts", None) or {}
        for key, entry in sorted(held.items()):
            facts = entry.get("facts") if isinstance(entry, dict) else None
            if not facts or facts.get("state") != "open" or facts.get("mergeable") != "CONFLICTING":
                continue
            repo, _, number = key.rpartition("#")
            item = _conflict_item(repo, int(number), facts.get("head"), now) if number.isdigit() else None
            with self.lock:
                if item is None or item.key in self._conflicts:
                    continue
                if len(self._conflicts) > 20000:
                    self._conflicts.clear()
                self._conflicts.add(item.key)
                self.queue.setdefault(item.key, item)

    def _load_notices(self):
        """{(repo, number): notice record}: the PR notices on file, or {} when the file cannot be read."""
        try:
            return {(n["repo"], n["number"]): n for n in read_pr_notices(self.state_dir)}
        except NoticeError:
            return {}

    def owner_of(self, item, agents, now):
        """The owner of an item (see `route_of`, which also says by which link)."""
        return self.route_of(item, agents, now)[0]

    def route_of(self, item, agents, now):
        """(owner, routed_by) of an item, or (None, None). PR 52: the links in order: (closing) the issues the item
        or its PR names, the existing routing, unchanged and first so that nothing that routes today moves;
        (notice) the agent that recorded a `notice pr` for the PR, or its boss when it is gone; (reference) the one
        issue a PR that closes nothing mentions as a plain #N (or in its head branch name). Raises GitHubUnavailable."""
        seen = {}
        owner = self._resolve(item.repo, list(item.issues), list(item.lookups), agents, now, seen)
        if owner:
            return owner, "closing"
        for number in item.numbers:
            notice = self._notices.get((item.repo, number))
            if notice:
                for name in (notice.get("from"), notice.get("boss")):
                    if isinstance(name, str) and name in agents:
                        return name, "notice"
        for number in item.numbers:
            pr = seen.get(number)
            candidates = reference_numbers(pr, number) if pr is not None else []
            if len(candidates) == 1:
                owner = self._resolve(item.repo, candidates[:], [("issue", candidates[0])], agents, now, seen)
                if owner:
                    return owner, "reference"
        return None, None

    def _resolve(self, repo, known, pending, agents, now, seen):
        """The existing walk: known issues first, then reads that climb to parents and to the issues a PR closes."""
        done = set()
        while True:
            owner = pick_owner(agents, known, repo,
                               self.config.get("intent_repo") if len(self.watches) > 1 else None)
            if owner and _is_orchestrator(agents[owner]):
                return owner
            if not pending:
                return owner  # a worker that owns the issue, when no orchestrator above it does
            lookup = pending.pop(0)
            if lookup in done:
                continue
            done.add(lookup)
            more_known, more_lookups = self._expand(repo, lookup, now, seen)
            known += [n for n in more_known if n not in known]
            pending += more_lookups

    def _expand(self, repo, lookup, now, seen=None):
        kind, number = lookup
        data = self._read_one(repo, "%s/%d" % ("pulls" if kind == "pr" else "issues", number), now)
        if kind == "pr" and seen is not None:
            seen[number] = data
        if kind == "pr":
            return _pr_refs(data, number)[0], [("issue", n) for n in _pr_refs(data, number)[0]]
        if _is_pr(data):
            return closing_numbers(data.get("body")), [("pr", number)]
        parent = parent_of(data)
        return ([parent], [("issue", parent)]) if parent else ([], [])

    def _read_one(self, repo, path, now):
        key = (repo, path)
        with self.lock:
            cached = self._cache.get(key)
            if cached and now < cached[0]:
                return cached[1]
            if now < self._retry.get(key, 0):
                raise GitHubUnavailable("read of %s failed recently; trying again later" % path)
        if self._route_until is not None and self.now() >= self._route_until:
            raise GitHubUnavailable("this pass's time for reading GitHub is spent")
        try:
            pages = self.gh_api("repos/%s/%s" % (repo, path), paginate=False,
                                timeout=min(self.config["call_timeout_seconds"], GITHUB_ROUTE_READ_TIMEOUT))
            data = pages[0] if pages and isinstance(pages[0], dict) else {}
        except GitHubUnavailable:
            with self.lock:
                self._retry[key] = now + GITHUB_LOOKUP_RETRY
            raise
        with self.lock:
            self._cache[key] = (now + GITHUB_LOOKUP_TTL, data)
        return data

    # -- the issues that wait on you (PR 14): events keep the picture, the catch-up read makes it right

    def note_awaiting_issue(self, repo, issue, when=None):
        """One issue as a webhook payload or a read shows it: listed when it is open and carries a label,
        forgotten otherwise. `since` is kept from the first time it was seen listed; a `labeled` event says
        when (the issue's `updated_at`), and a read can only say when the issue last changed. PR 18: the tier
        is `human` with your label (an issue with both was escalated), `cos` with the Chief of Staff's only."""
        number = _number(issue)
        if number is None or _is_pr(issue) or not isinstance(issue.get("labels"), list):
            return
        names = {(label.get("name") if isinstance(label, dict) else label) for label in issue["labels"]}
        key = (repo, number)
        tier = decision_core.issue_tier(names, awaiting_label(self.config), awaiting_cos_label(self.config))
        with self.lock:
            if tier is not None and issue.get("state", "open") == "open":
                known = self.awaiting.get(key)
                stamp = parse_iso(issue.get("updated_at"))
                since = known["since"] if known else (stamp if stamp is not None else when or self.now())
                # a batch's rows come from the body this payload or listing already carries: no read of their own
                rows = parse_decision_rows(issue["body"]) if "body" in issue else (known or {}).get("rows", [])
                raised = signed_by_fleet(issue["body"]) if "body" in issue and rows else (known or {}).get("raised_by")
                self.awaiting[key] = {"title": str(issue.get("title") or ""), "since": since,
                                      "parent": parent_of(issue), "tier": tier, "rows": rows,
                                      "raised_by": raised if rows else None}
            else:
                self.awaiting.pop(key, None)

    def note_awaiting_event(self, event, repo, payload):
        """A webhook event that carries an issue: keep the picture current with no read at all."""
        issue = payload.get("issue") if event in ("issues", "issue_comment") else None
        if isinstance(issue, dict):
            self.note_awaiting_issue(repo, issue)

    def read_awaiting(self, repo, now=None):
        """The catch-up's read of the open issues with either label: authoritative for `repo`, so an issue that
        lost its label while no forwarder ran is dropped. Two bounded reads per repo (one per label), never one
        per issue. Returns None, or one line saying why it failed."""
        wanted = (("awaiting-user", awaiting_label(self.config)), ("awaiting-cos", awaiting_cos_label(self.config)))
        found = {}
        for name, label in wanted:
            path = "repos/%s/issues?labels=%s&state=open&per_page=100" % (repo, quote(label, safe=""))
            try:
                records, truncated = self.read_pages(path)
            except GitHubUnavailable as err:
                with self.lock:
                    self.awaiting_read[repo] = _one_line(str(err), 200)
                return "%s issues: %s" % (name, self.awaiting_read[repo])
            found[name] = [r for r in records if not _is_pr(r) and _number(r) is not None]
            if truncated:
                self.last_truncated.setdefault("capped_reads", []).append("%s issues" % name)
        with self.lock:
            old = {key: value for key, value in self.awaiting.items() if key[0] == repo}
            self.awaiting = {key: value for key, value in self.awaiting.items() if key[0] != repo}
        for name, label in reversed(wanted):  # your label last: an issue with both is yours
            for record in found[name]:
                self.note_awaiting_issue(repo, dict(record, state="open", labels=[{"name": label}]), now)
                known = old.get((repo, _number(record)))
                if known:
                    with self.lock:
                        self.awaiting[(repo, _number(record))]["since"] = known["since"]
        with self.lock:
            self.awaiting_read[repo] = None
        return None

    def awaiting_listing(self):
        """(records, errors) for the decisions: what the hub knows, and what it could not read."""
        with self.lock:
            records = [{"repo": repo, "number": number, "title": entry["title"], "since": entry["since"],
                        "parent": entry["parent"], "tier": entry["tier"], "rows": entry.get("rows", []),
                        "raised_by": entry.get("raised_by")}
                       for (repo, number), entry in sorted(self.awaiting.items())]
            errors = []
            for repo in sorted(self.watches):
                if repo not in self.awaiting_read:
                    errors.append("issues of %s that wait on you are not read yet" % repo)
                elif self.awaiting_read[repo]:
                    errors.append("issues of %s that wait on you could not be read: %s" % (repo, self.awaiting_read[repo]))
        return records, errors

    # -- the read marker: how far each repo was read. Forward only; deleting the file means a fresh start.

    def _load_markers(self):
        try:
            raw = json.loads((self.state_dir / READ_MARKER_FILE).read_text())
        except (OSError, ValueError):
            return {}
        now = self.now()
        found = {}
        for repo, stamp in (raw.items() if isinstance(raw, dict) else []):
            moment = parse_iso(stamp) if isinstance(stamp, str) else None
            if moment is not None:
                found[repo] = min(moment, now)
        return found

    def _set_marker(self, repo, moment):
        with self.lock:
            if moment > self.markers.get(repo, 0):
                self.markers[repo] = moment
                self._markers_dirty = True

    def _save_markers(self):
        """At most once a pass, atomically."""
        with self.lock:
            if not self._markers_dirty:
                return
            body, self._markers_dirty = {repo: iso(moment) for repo, moment in sorted(self.markers.items())}, False
        path = self.state_dir / READ_MARKER_FILE
        tmp = path.with_name(READ_MARKER_FILE + ".tmp")
        try:
            fd = os.open(str(tmp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w") as handle:
                handle.write(json.dumps(body, indent=1, sort_keys=True) + "\n")
            os.replace(str(tmp), str(path))
        except OSError:
            with self.lock:
                self._markers_dirty = True  # a cursor that could not be written is written next pass

    def read_pages(self, path, key=None, timeout=None, older=None):
        """One list read, at most GITHUB_PAGE_CAP pages of GITHUB_PAGE_SIZE. Returns (records, truncated). `older`
        is (field, since): a listing newest first stops at the first page that ends before `since`."""
        joiner = "&" if "?" in path else "?"
        records = []
        bounded = not fault("catch-up-blocks-pass")
        number = 0
        while True:
            number += 1
            page = _records(self.gh_api("%s%spage=%d" % (path, joiner, number), paginate=False, timeout=timeout), key)
            records.extend(page)
            if len(page) < GITHUB_PAGE_SIZE:
                return records, False
            if older and isinstance(page[-1].get(older[0]), str) and page[-1][older[0]] < older[1]:
                return records, False
            if bounded and number >= GITHUB_PAGE_CAP:
                return records, True

    # -- gh api, and the catch-up read

    def child_env(self, repo):
        """The repo's account's environment for a child, or None for the default account. Raises
        GitHubUnavailable when gh will not give the account's token (the text names the account only)."""
        try:
            return self.accounts.env_for(repo)
        except AccountError as err:
            raise GitHubUnavailable(str(err)) from None

    def gh_api(self, path, paginate=True, timeout=None):
        argv = [self.config["gh"], "api"] + (["--paginate"] if paginate else []) + [path]
        named = re.match(r"^repos/([^/]+/[^/]+)/", path)
        env = self.child_env(named.group(1)) if named else None
        extra = {"env": env} if env is not None else {}
        try:
            done = self.runner(argv, capture_output=True, text=True,
                               timeout=timeout or self.config["call_timeout_seconds"], **extra)
        except (OSError, subprocess.SubprocessError) as err:
            raise GitHubUnavailable("gh api %s: %s" % (path.split("?")[0],
                                                       self.accounts.scrub(_one_line(str(err))))) from None
        if done.returncode != 0:
            raise GitHubUnavailable("gh api %s failed: %s" % (path.split("?")[0], self.accounts.scrub(
                _one_line(done.stderr or "", 200))))
        try:
            return decode_json_stream(done.stdout or "")
        except ValueError:
            raise GitHubUnavailable("gh api %s answered something that is not JSON" % path.split("?")[0]) from None

    def catch_up_items(self, repo, now, since_epoch=None):
        """The items for everything that changed on `repo` since now - look-back (or `since_epoch`, a later
        time, for a poll that asks only for what is new), keyed exactly as the webhooks are. Returns
        (items, errors): one read failing does not stop the others."""
        since, items, errors, pulls = iso(since_epoch if since_epoch is not None else now - self.lookback), [], [], []
        started, bounded, capped = self.now(), not fault("catch-up-blocks-pass"), []

        def read(name, path, key=None, older=None):
            secondary = name in SECONDARY_READS
            until = self._read_backoff.get((repo, name))
            if bounded and until is not None and self.now() < until:
                return []  # it was reported when it failed; it is not tried, or reported, again until the backoff ends
            if bounded and self.now() - started >= GITHUB_CATCHUP_SECONDS:
                errors.append("%s: left to the next catch-up (this one spent its %ds)" % (name, GITHUB_CATCHUP_SECONDS))
                return []
            try:
                records, truncated = self.read_pages(path, key, GITHUB_SUBREAD_TIMEOUT if secondary and bounded else None,
                                                     older)
                if truncated:
                    capped.append(name)
                return records
            except GitHubUnavailable as err:
                errors.append("%s: %s" % (name, err))
                if secondary and bounded:
                    self._read_backoff[(repo, name)] = self.now() + GITHUB_READ_BACKOFF
                return []

        def fresh(record, field="updated_at"):
            return isinstance(record.get(field), str) and record[field] >= since

        base = "repos/%s/" % repo
        comments = [c for c in read("comments", base + "issues/comments?since=%s&per_page=%d" % (since, GITHUB_PAGE_SIZE)) if fresh(c)]
        commented = {}
        for comment in comments:
            number = _url_number(comment.get("issue_url"))
            commented[number] = max(commented.get(number, ""), comment["updated_at"])
            items.append(_comment_item(repo, comment, None, now))
        for issue in read("issues", base + "issues?state=all&since=%s&per_page=%d" % (since, GITHUB_PAGE_SIZE)):
            if _is_pr(issue) or not fresh(issue):
                continue
            if issue["updated_at"] <= commented.get(_number(issue), ""):
                continue  # a comment bumped it; the comment is the news
            items.append(_issue_item(repo, issue, now))
        for pr in read("pulls", base + "pulls?state=all&sort=updated&direction=desc&per_page=%d" % GITHUB_PAGE_SIZE,
                       older=("updated_at", since)):
            if fresh(pr):
                pulls.append(pr)
                items.append(_pr_item(repo, pr, now))
                items.append(_pr_conflict(repo, pr, now))
        for pr in pulls:
            number = _number(pr)
            for review in read("reviews", base + "pulls/%d/reviews?per_page=100" % number):
                if fresh(review, "submitted_at"):
                    items.append(_review_item(repo, review, pr, now))
            sha = (pr.get("head") or {}).get("sha")
            for suite in read("check suites", base + "commits/%s/check-suites?per_page=100" % sha,
                              "check_suites") if sha else []:
                if fresh(suite):
                    items.append(_check_item(repo, dict(suite, pull_requests=suite.get("pull_requests") or [
                        {"number": number}]), now, "", "check suite"))
        for run in read("workflow runs", base + "actions/runs?per_page=%d" % GITHUB_PAGE_SIZE, "workflow_runs"):
            if fresh(run):
                items.append(_check_item(repo, run, now, "run-", "workflow %s" % (run.get("name") or "run")))
        items = [item for item in items if item is not None]
        skipped = 0
        if bounded and len(items) > GITHUB_CATCHUP_ITEMS:
            skipped = len(items) - GITHUB_CATCHUP_ITEMS
            errors.append("items: kept the newest %d of %d" % (GITHUB_CATCHUP_ITEMS, len(items)))
            items = sorted(items, key=lambda item: item.created)[-GITHUB_CATCHUP_ITEMS:]
        self.last_truncated = {"capped_reads": capped, "items_skipped": skipped} if capped or skipped else {}
        return items, errors

    def catch_up(self, watch, now, polled=False):
        """The catch-up read, forward only. A repo with no read marker is not read at all (no history): its marker is
        set to now and it moves on with live events. With a marker, only the gap is read: from the marker (minus a
        little slack) to now, never further back than the look-back. The marker moves to the start of each catch-up
        whose primary reads (comments, issues, pulls) all answered; secondary reads (reviews, check suites,
        workflow runs) are best-effort and are not read again for a window they missed."""
        repo = watch.repo
        with self.lock:
            marker = self.markers.get(repo)
        items, errors, self.last_truncated = [], [], {}
        fresh_start = marker is None and not fault("catch-up-on-fresh-start")
        if not fresh_start:
            floor, slack = now - self.lookback, (2 * self.config["github_poll_seconds"] if polled else GITHUB_MARKER_SLACK)
            start = floor if marker is None or (fault("full-window-every-time") and not polled) else marker - slack
            if start < floor:
                start = floor
                if marker is not None and marker < floor:
                    self._audit("github.catch_up.skipped", repo, {"marker": iso(marker), "reads_from": iso(floor),
                                                                   "why": "older than the look-back: older events were skipped"})
            items, errors = self.catch_up_items(repo, now, start)
        primary_failed = any(e.split(":")[0] not in SECONDARY_READS for e in errors)
        problem = self.read_awaiting(repo, now)  # PR 14: current state, not events: read on a fresh start too
        if problem:
            errors.append(problem)
        if not primary_failed:
            self._set_marker(repo, now)
        self.enqueue(items)
        said = "; ".join(errors) if errors else None
        with self.lock:
            changed = items or said != watch.catch_up_error or watch.last_catch_up is None
            watch.last_catch_up = now
            watch.catch_up_error = said
            retry = now + GITHUB_LOOKUP_RETRY
            watch.catchup_at = retry if (primary_failed or problem) and not polled else None  # best-effort reads are not retried
        if self.last_truncated:
            self._audit("github.catch_up.truncated", repo, dict(self.last_truncated, marker_advanced=not primary_failed))
        if not polled or changed:  # a quiet poll every minute is not worth an audit line
            self._audit("github.catch_up", repo, {"keys": [item.key for item in items[:GITHUB_AUDIT_KEYS]],
                                                  "count": len(items), "errors": errors, "polled": polled,
                                                  "fresh_start": fresh_start})

    # -- the supervisor

    def tick(self):
        """One supervisor step for every watch: reap, restart with backoff, catch up."""
        now = self.now()
        for watch in list(self.watches.values()):
            try:
                self._tick_watch(watch, now)
            except Exception as err:
                with self.lock:
                    watch.last_error = self.accounts.scrub(_scrub(_one_line(str(err)), watch.secret))
                self._audit("github.error", watch.repo, {"error": watch.last_error})
        self._save_markers()
        self._write_snapshot(now)

    def _tick_watch(self, watch, now):
        if self.watches.get(watch.repo) is not watch:
            return  # PR 15: it left the watched set after this tick took its copy of the list
        if watch.proc is not None:
            code = watch.proc.poll()
            if code is not None:
                self._exited(watch, code, now)
            elif watch.failures and now - watch.started >= GITHUB_STABLE:
                watch.failures = 0
            if watch.proc is not None and watch.polling and now - watch.started >= self.catchup_delay:
                with self.lock:  # the forwarder connected: the repo is no longer polled; one read closes the gap
                    watch.polling, watch.poll_reason, watch.catchup_at = False, None, now
        if watch.proc is None and now >= watch.next_start:
            self._start(watch, now)
        if watch.polling and now >= watch.next_poll:
            with self.lock:
                watch.next_poll = now + self.config["github_poll_seconds"]
            self.catch_up(watch, now, polled=True)
            with self.lock:
                watch.last_poll = now
        if watch.catchup_at is not None and now >= watch.catchup_at:
            self.catch_up(watch, now)

    def argv_for(self, watch):
        url = "http://127.0.0.1:%d/github" % self.port
        return [self.config["gh"], "webhook", "forward", "--repo=%s" % watch.repo,
                "--events=%s" % ",".join(self.config["github_events"]), "--url=%s" % url,
                "--secret=%s" % watch.secret]

    def log_path(self, watch):
        directory = self.state_dir / "logs"
        directory.mkdir(mode=0o700, exist_ok=True)
        return directory / ("forward-%s.log" % watch.repo.replace("/", "-"))

    def _start(self, watch, now):
        try:
            env = self.child_env(watch.repo)
        except GitHubUnavailable as err:
            self._failed(watch, now, str(err))
            return
        secret = secrets.token_hex(32)  # a new one for every start; memory and argv only
        with self.lock:
            watch.secret = secret
        try:
            proc = self.spawn(self.argv_for(watch), self.log_path(watch), **({"env": env} if env is not None else {}))
        except OSError as err:
            with self.lock:
                watch.secret = None
            self._failed(watch, now, "cannot start %s: %s" % (self.config["gh"], _one_line(str(err), 200)))
            return
        with self.lock:
            watch.proc, watch.started, watch.starts = proc, now, watch.starts + 1
            watch.state, watch.next_start, watch.down_since = "running", now, None
            watch.catchup_at = None if watch.polling else now + self.catchup_delay  # a polled repo is read already
        self._audit("github.watch", watch.repo, {"state": "running", "starts": watch.starts})

    def _log_tail(self, watch):
        try:
            with open(str(self.log_path(watch)), "rb") as handle:
                handle.seek(0, os.SEEK_END)
                handle.seek(max(0, handle.tell() - 4096))
                return handle.read().decode("utf-8", "replace")
        except OSError:
            return ""

    def _exited(self, watch, code, now):
        tail = _scrub(self._log_tail(watch), watch.secret)
        with self.lock:
            watch.proc, watch.secret = None, None
            ran = max(0.0, now - (watch.started or now))
            watch.drops = [d for d in watch.drops if now - d[0] < FORWARDER_HISTORY_SECONDS] + [(now, ran)]
            watch.down_since = now
        if CONFLICT_TEXT in tail:
            with self.lock:
                watch.state, watch.next_start = "conflict", now + self.conflict_retry
                watch.last_error = "someone else is already forwarding %s (%s); catch-up reads continue" % (
                    watch.repo, CONFLICT_TEXT)
            self._audit("github.watch", watch.repo, {"state": "conflict", "retry_in": self.conflict_retry})
            return
        lines = [line for line in tail.splitlines() if line.strip()]
        reason = "exited with code %s%s" % (code, ": " + _one_line(forwarder_reason_line(lines), 200) if lines else "")
        if now - (watch.started or now) >= GITHUB_STABLE:
            watch.failures = 0
        unwatchable = unwatchable_reason(tail)
        if unwatchable:  # PR 15: no webhook can be made here, so the repo is read on a poll instead
            with self.lock:
                if not watch.polling:
                    watch.polling, watch.next_poll = True, now
                watch.poll_reason = unwatchable
        self._failed(watch, now, reason)

    def _failed(self, watch, now, reason):
        with self.lock:
            watch.failures += 1
            if watch.down_since is None:  # a spawn that failed never ran, so _exited did not set it
                watch.down_since = now
            delay = min(self.backoff_max, self.backoff_base * 2 ** (watch.failures - 1))
            watch.state, watch.next_start, watch.last_error = "backoff", now + delay, reason
        self._audit("github.watch", watch.repo, {"state": "backoff", "failures": watch.failures,
                                                 "retry_in": delay, "reason": reason})

    # -- status

    def describe(self):
        with self.lock:
            return {"port": self.port, "lookback_hours": self.lookback / 3600.0,
                    "poll_seconds": self.config["github_poll_seconds"],
                    "watches": [dict(w.to_json(), account=self.accounts.describe(w.repo),
                                     read_marker=iso(self.markers.get(w.repo)) if w.repo in self.markers else None)
                                for _, w in sorted(self.watches.items())]}

    def _write_snapshot(self, now, stopped=False):
        """A copy of `describe()` for `status`, which runs in another process. No secret,
        no events; deleting it loses nothing."""
        body = dict(self.describe(), pid=None if stopped else os.getpid())
        text = json.dumps(body, sort_keys=True)
        if text == self._snapshot:
            return
        self._snapshot = text
        path = self.state_dir / WATCH_FILE
        tmp = path.with_name(WATCH_FILE + ".tmp")
        fd = os.open(str(tmp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as handle:
            handle.write(json.dumps(dict(body, updated=iso(now)), sort_keys=True))
        os.replace(str(tmp), str(path))


def _header(headers, name):
    """A header from an http.server message or a plain dict, any case."""
    if hasattr(headers, "get") and not isinstance(headers, dict):
        return headers.get(name)
    lowered = name.lower()
    return next((v for k, v in headers.items() if k.lower() == lowered), None)


def attach_github(engine, config, state_dir, runner, now):
    """The daemon's hub (PR 15: always; the repos it watches are derived on every pass, and with none it opens
    nothing). SIGTERM becomes a clean stop."""
    hub = GitHubHub(config, state_dir, engine.audit, runner, spawn_forwarder, now, engine.actor)
    hub.attach(engine)

    def terminate(*_):
        raise KeyboardInterrupt
    signal.signal(signal.SIGTERM, terminate)
    return hub


def github_status(config, state_dir, fleets=None, now=None):
    """What `status` says about GitHub: the repos watched (the config's and every live agent's, PR 15), how each
    is watched by the daemon's last snapshot, the gh account it uses (a name, never a token) and the fleet
    agents in it."""
    repos = watched_repos(config, fleets or {})
    report = {"repos": repos, "lookback_hours": config["github_lookback_hours"],
              "events": list(config["github_events"]), "daemon": False, "watches": [], "port": None,
              "poll_seconds": config["github_poll_seconds"]}
    snapshot = {}
    try:
        snapshot = json.loads((Path(state_dir) / WATCH_FILE).read_text())
    except (OSError, ValueError):
        pass
    pid = snapshot.get("pid")
    try:
        if isinstance(pid, int):
            os.kill(pid, 0)
            report["daemon"] = True
    except ProcessLookupError:
        pass
    except OSError:
        report["daemon"] = True  # alive, but not ours to signal
    if snapshot:
        report["port"] = snapshot.get("port")
        report["updated"] = snapshot.get("updated")
        report["watches"] = [w for w in snapshot.get("watches", []) if w.get("repo") in repos]
    accounts = GhAccounts(config)
    by_repo = {w["repo"]: w for w in report["watches"]}
    members = {}
    for name, fleet in sorted((fleets or {}).items()):
        repo = _fleet_repo(fleet, config)
        if repo:
            members.setdefault(repo, []).append(name)
    report["detail"] = []
    for repo in repos:
        watch = by_repo.get(repo) if report["daemon"] else None
        how = "unknown" if not report["daemon"] else (watch.get("mode") or watch["state"] if watch else "not yet")
        why = None
        if watch:
            why = "; ".join(x for x in (watch.get("poll_reason"), watch.get("last_error"),
                                        watch.get("catch_up_error")) if x) or None
        marker = parse_iso(watch.get("read_marker")) if watch and watch.get("read_marker") else None
        age = max(0, (time.time() if now is None else now) - marker) if marker is not None else None
        current = time.time() if now is None else now
        health = forwarder_health(watch, current) if watch else None
        if health and health["live"]:
            why = watch.get("poll_reason") or None  # a recovered drop is history, not an error
        report["detail"].append({"repo": repo, "how": how, "account": accounts.describe(repo),
                                 "agents": members.get(repo, []), "why": why, "read_age": age, "health": health})
    return report


def format_github(report):
    """Status lines for GitHub; none when no repo is watched."""
    if not report["repos"]:
        return []
    lines = ["      github     watching %s; catch-up reads reach back %g h, older events are lost"
             % (", ".join(report["repos"]), report["lookback_hours"])]
    if not report["daemon"]:
        lines.append("        daemon not running: forwarder state is unknown")
    watches = {w["repo"]: w for w in report["watches"]}
    for entry in report.get("detail", []):
        watch = watches.get(entry["repo"]) if report["daemon"] else None
        how = entry["how"]
        if how in ("polling", "failed"):
            how += " every %gs" % report.get("poll_seconds", 60) if how == "polling" else ""
        line = "        %-24s %s" % (entry["repo"], how)
        if watch and watch["state"] == "conflict":
            line += " (someone else is forwarding; catch-up reads only)"
        if watch and watch["failures"] and not (entry.get("health") or {}).get("live"):
            line += ", %d failure(s)" % watch["failures"]
        health = entry.get("health")
        if health and health["live"]:
            line += ", live, up %s" % format_age(health["up_age"] or 0)
        elif health and health["down_age"] is not None and not health.get("quiet"):
            line += ", down %s" % format_age(health["down_age"])
        line += "  account %s" % entry["account"]
        if health and health["drops_hour"]:
            line += "  last drop %s ago, %d in the last hour" % (format_age(health["last_drop_age"]), health["drops_hour"])
        if watch:  # for a live forwarder this is only the last catch-up read, not how fresh events are
            label = "catch-up read to" if entry["how"] == "forwarder" else "read to"
            line += "  %s %s ago" % (label, format_age(entry["read_age"])) if entry.get("read_age") is not None \
                else "  not read yet"
        if health and health["alarm"]:
            line += "  ALARM: forwarder %s" % health["alarm"]
        line += "  agents: %s" % (", ".join(entry["agents"]) or "none")
        if entry["why"]:
            line += "  [%s]" % entry["why"]
        lines.append(line)
    return lines


# --------------------------------------------------------------------- the CLI

def _check(probe):
    """Run one probe. Returns (ok, one line). Never raises, never a traceback."""
    try:
        return True, probe()
    except (V2Error, HerdrError, ConfigError, FaultError) as err:
        return False, _one_line(str(err))
    except Exception as err:  # status must always answer; say what broke in one line
        return False, _one_line("unexpected %s: %s" % (type(err).__name__, err))


def _v2_summary(info):
    version = info.get("version") if isinstance(info, dict) else None
    return "server.info answered%s" % (", version %s" % version if version else "")


def collect_status(runner=subprocess.run, now=time.time, platform=None):
    report = {"version": VERSION}
    path = config_path()
    config_ok, config = _check(lambda: load_config(path))
    report["config"] = {"path": str(path), "exists": path.exists(), "ok": config_ok}
    if config_ok:
        report["config"].update({
            "opencode": config["opencode"],
            "opencode_env": sorted(config["opencode_env"]),  # names only, never values
            "opencode_executable": config["opencode_executable"],
            "launch_env": sorted(config["launch_env"]),
            "herdr": config["herdr"],
            "batch_seconds": config["batch_seconds"],
            "engaged_minutes": config["engaged_minutes"],
            "call_timeout_seconds": config["call_timeout_seconds"],
            "poll_seconds": config["poll_seconds"],
        })
    else:
        report["config"]["error"] = config

    state_ok, state = _check(lambda: str(ensure_state_dir()))
    report["state_dir"] = {"path": str(state_dir_path()), "ok": state_ok}
    if not state_ok:
        report["state_dir"]["error"] = state

    faults_ok, faults = _check(active_faults)
    report["lab"] = {"on": os.environ.get(LAB_ENV) == "1", "ok": faults_ok}
    if faults_ok:
        report["lab"]["faults"] = faults
    else:
        report["lab"]["error"] = faults

    agents = {"ok": False, "error": "not checked: v2 and herdr must both answer"}
    if config_ok:
        herdr = HerdrClient(config["herdr"], runner)
        v2 = None
        if config["opencode"] is None:
            v2_ok, v2_line = False, ("not configured: set 'opencode' in %s to the absolute path of "
                                     "the OpenCode v2 binary" % config_path())
        else:
            v2 = V2Client(config["opencode"], config["opencode_env"], runner, config["call_timeout_seconds"])
            v2_ok, v2_line = _check(lambda: _v2_summary(v2.server_info()))
        herdr_ok, entries = _check(herdr.agent_list)
        herdr_line = "%d agent(s)" % len(entries) if herdr_ok else entries
        if v2_ok and herdr_ok and state_ok and faults_ok:
            engine = Switchboard(config, v2, herdr, None, fact_sources(state), now,
                                 intents=intent_reader_for(config, runner, now))
            agents_ok, overview = _check(lambda: fleet_overview(engine, entries))
            agents = overview if agents_ok else {"ok": False, "error": overview}
    else:
        v2_ok, v2_line = False, "not checked: config unusable"
        herdr_ok, herdr_line = False, "not checked: config unusable"
    report["v2"] = {"ok": v2_ok, ("detail" if v2_ok else "error"): v2_line}
    report["herdr"] = {"ok": herdr_ok, ("detail" if herdr_ok else "error"): herdr_line}
    report["agents"] = agents  # informational: an agent's trouble is not the switchboard's
    if config_ok and state_ok:
        fleets = {entry["observation"]["name"]: entry["observation"].get("fleet") or {}
                  for entry in (agents.get("list") or []) if agents.get("ok") and entry.get("observation")}
        report["github"] = github_status(config, state, fleets, now())
    if state_ok:
        report["decisions"] = decisions_summary(state, now)
        line = external_status_line(config, state, now()) if config_ok else None
        if line is not None:   # only when external decisions are on: off prints nothing
            report["external"] = {"line": line}
            work_line = work_status_line(config, state, now())
            if work_line is not None:
                report["external"]["work_line"] = work_line
    report["cos_orders"] = cos_orders_summary(config if config_ok else None)  # PR 18
    if config_ok and state_ok:
        working = sum(1 for entry in (agents.get("list") or []) if agents.get("ok") and entry.get("observation")
                      and entry["observation"]["status"] == "working")
        report["policy"] = policy_liveness(config, state_dir_path(), working, now())
    report["daemon"] = daemon_report(state_dir_path()) if state_ok else {"running": False, "pid": None, "key_source": None}
    report["service"] = service_report(platform)
    report["key"] = key_report(config if config_ok else None, report["daemon"], report["service"])   # PR 16
    report["plugin"] = plugin_report(config, runner) if config_ok else {"state": "unknown", "detail": "config unusable"}
    report["ok"] = all(report[part]["ok"] for part in ("config", "state_dir", "lab", "v2", "herdr"))
    return report


def fleet_overview(engine, entries):
    """Read-only: every fleet agent and every fact recipient, with the rule's answer for each."""
    discovery = engine.discover(engine.now(), entries)
    facts, problems = engine.collect_facts()
    names = sorted(set(discovery.agents) | {fact.recipient for fact in facts})
    overview = {"ok": True, "problems": discovery.problems + problems,
                "list": [engine.pending(name, discovery, facts) for name in names]}
    overview.update(intent_gap_report(engine, discovery, facts))
    return overview


def _plan_line(entry):
    plan, riders = entry["plan"], entry.get("riders") or []
    if plan is None:
        return ("nothing pending; %d rider(s) wait for a message to ride in" % len(riders)) if riders \
            else "nothing pending"
    waiting = sum(1 for fact in plan["pending"] if fact.get("rider"))
    return "%d pending%s: %s (%s)" % (len(plan["pending"]), " (%d rider)" % waiting if waiting else "",
                                      plan["action"], plan["reason"])


def _agent_line(entry):
    seen = entry["observation"]
    if seen is None:
        return "%-14s (not found)  %s" % (entry["name"], _plan_line(entry))
    return "%-14s %-8s %s  pane %s  your last prompt %s  %s" % (
        seen["name"], seen["status"], seen["session"], seen["pane"] or "-",
        seen["last_human_prompt"] or "not in the window", _plan_line(entry))


def format_status(report):
    def mark(part):
        return "ok   " if part["ok"] else "ERROR"

    config = report["config"]
    lines = [report["key"]["notice"]] if report["key"]["notice"] else []  # PR 16: the danger comes first
    lines.append("%s %s" % (PROG, report["version"]))
    if config["ok"]:
        lines.append("%s config     %s%s" % (mark(config), config["path"],
                                             "" if config["exists"] else " (not present; defaults)"))
        lines.append("      opencode   %s  env: %s" % (config["opencode"] or "(not configured)",
                                                       ", ".join(config["opencode_env"]) or "none"))
        if config["opencode_executable"]:
            lines.append("      process    %s (what a pane must run)" % config["opencode_executable"])
        lines.append("      herdr      %s" % config["herdr"])
        lines.append("      timing     batch %ss, engaged %s min, call timeout %ss, poll %ss"
                     % (config["batch_seconds"], config["engaged_minutes"], config["call_timeout_seconds"],
                        config["poll_seconds"]))
    else:
        lines.append("%s config     %s" % (mark(config), config["error"]))
    lines.extend(format_config_lines(report.get("daemon")))  # PR 16: the daemon's own account of its config
    state = report["state_dir"]
    lines.append("%s state      %s" % (mark(state), state["path"] if state["ok"] else state["error"]))
    lab = report["lab"]
    if lab["ok"]:
        lab_line = "on" if lab["on"] else "off"
        if lab["faults"]:
            lab_line += ", faults requested: %s%s" % (", ".join(lab["faults"]), "" if lab["on"] else " (ignored outside the Lab)")
    else:
        lab_line = lab["error"]
    lines.append("%s lab        %s" % (mark(lab), lab_line))
    for name in ("v2", "herdr"):
        part = report[name]
        lines.append("%s %-10s %s" % (mark(part), name, part["detail"] if part["ok"] else part["error"]))
    agents = report["agents"]
    if agents["ok"]:
        listed = [entry for entry in agents["list"] if entry["observation"]]
        lines.append("      agents     %d fleet agent(s)" % len(listed))
        lines.extend("        " + _agent_line(entry) for entry in agents["list"])
        lines.extend("        problem: %s" % problem for problem in agents["problems"])
        lines.extend(intent_gap_lines(agents))
    else:
        lines.append("      agents     %s" % agents["error"])
    lines.extend(format_github(report["github"]) if "github" in report else [])
    lines.extend(format_decisions_status(report["decisions"]) if "decisions" in report else [])
    lines.extend("      " + report["external"]["line"] for _ in [0] if "external" in report)
    lines.extend("      " + report["external"]["work_line"] for _ in [0] if "external" in report and "work_line" in report["external"])
    lines.extend(format_cos_orders_status(report["cos_orders"]) if "cos_orders" in report else [])  # PR 18
    lines.extend("      " + report["policy"]["line"] for _ in [0] if "policy" in report)
    lines.extend(format_install_lines(report))  # PR 16
    return "\n".join(lines)


def cmd_status(args, runner=subprocess.run, now=time.time):
    report = collect_status(runner, now)
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print(format_status(report))
    return EXIT_OK if report["ok"] else EXIT_ERROR


class CallerError(Exception):
    """`send` cannot tell which fleet agent is calling."""


def identify_caller(herdr, v2, environ):
    """The caller's fleet name: HERDR_PANE_ID -> herdr agent -> v2 session -> metadata.fleet.name."""
    pane = environ.get("HERDR_PANE_ID")
    if not pane:
        raise CallerError("HERDR_PANE_ID is not set: run send from a fleet agent's herdr pane")
    session_id = agent_session(herdr.agent_get(pane))
    if not session_id:
        raise CallerError("herdr pane %s shows no agent session" % pane)
    name = (_fleet_meta(v2.session_get(session_id)) or {}).get("name")
    if not isinstance(name, str) or not name:
        raise CallerError("session %s in pane %s is not a fleet agent (no metadata.fleet.name)" % (session_id, pane))
    return name


def build_engine(runner, now, actor, writable=True, socket_call=None):
    """The engine over the configured clients. Refuses an unconfigured v2 or a bad fault name."""
    config = load_runnable_config()
    active_faults()
    state = ensure_state_dir()
    v2 = V2Client(config["opencode"], config["opencode_env"], runner, config["call_timeout_seconds"])
    herdr = HerdrClient(config["herdr"], runner, socket_call=socket_call)
    audit = AuditLog(state / "audit.jsonl") if writable else None
    engine = Switchboard(config, v2, herdr, audit, fact_sources(state), now, actor,
                         intents=intent_reader_for(config, runner, now), state_dir=state)
    engine.accounts = GhAccounts(config, runner, now)  # PR 15
    engine.gh_runner = runner  # PR notices
    return engine, state, config


def cmd_run(args, runner, now, wait):
    signature = config_signature(config_path())  # taken before the read: an edit in between is seen as a change
    engine, state, config = build_engine(runner, now, "daemon")
    if args.once:
        with single_instance(state):
            report = engine.run_pass()
        if args.json:
            print(json.dumps(report, indent=2, sort_keys=True))
        else:
            print("pass at %s: %d sent, %d held, %d waiting, %d converted, %d error(s)" % (
                report["at"], len(report["sent"]), len(report["held"]), len(report["waiting"]),
                len(report["converted"]), len(report["errors"])))
        return EXIT_OK if not report["errors"] else EXIT_ERROR
    if args.standby:  # PR 16: the service waits for the lock instead of exiting and being restarted
        while run_lock_held(state):
            time.sleep(STANDBY_SECONDS)
    hub = attach_github(engine, config, state, runner, now)
    judge_server = start_judge_server(config, state, runner, now)  # PR 9: the daemon holds the key, not v2
    if judge_server is not None:
        engine.judge_warm = make_judge_warmer(config, runner, now)
    watch = ConfigWatch(config_path(), config, now, engine.audit, engine.actor,
                        lambda **fields: update_daemon_record(state, **fields), signature)
    argv = [sys.executable, os.path.realpath(__file__), "run"] + (["--poll", "%g" % args.poll] if args.poll else [])
    # `--standby` is left out of a re-exec: the new process already holds the lock
    try:
        run_daemon(engine, state, args.poll or config["poll_seconds"], wait,
                   record=dict(daemon_record(config), config_loaded_at=iso(now())), watch=watch,
                   on_reload=lambda changed: reload_in_place(engine, hub, judge_server, changed, argv))
    except KeyboardInterrupt:
        return EXIT_OK
    finally:
        if hub is not None:
            hub.stop()
        if judge_server is not None:
            judge_server.stop()
    return EXIT_OK


STANDBY_SECONDS = 10  # how often `run --standby` looks again for a free lock


def cmd_ensure(args, spawn=subprocess.Popen):
    load_config()  # a daemon that cannot read its config would exit at once; say so here
    state = ensure_state_dir()
    outcome = ensure_daemon(state, spawn)
    print("daemon %s" % outcome)
    return EXIT_OK


def cmd_poke(args):
    """Ask the daemon for a pass. Silent, fast, and always exit 0: it runs inside
    herdr's hook runner, which has no timeout and a shared limit on commands."""
    signal.alarm(POKE_ALARM)
    try:
        send_poke(state_dir_path())
    except Exception:  # nothing a poke does may make a hook noisy or slow
        pass
    finally:
        signal.alarm(0)
    return EXIT_OK


def read_brief(path, stdin):
    """The brief for `launch`: a file, or `-` for standard input. None when not given."""
    if path is None:
        return None
    try:
        text = stdin.read() if path == "-" else Path(path).read_text()
    except OSError as err:
        raise LaunchError("cannot read the brief %s: %s" % (path, err.strerror or err)) from None
    if not text.strip():
        raise LaunchError("the brief %s is empty" % path)
    return text


def cmd_launch(args, runner, now, socket_call=None):
    workspace = args.workspace or os.environ.get("HERDR_WORKSPACE_ID")
    engine, state, _ = build_engine(runner, now, "cli", socket_call=socket_call)
    if args.resume:
        done = resume_agent(engine, args.name, args.resume, workspace)
        print(json.dumps(done, sort_keys=True))
        return EXIT_OK
    if not args.agent or not args.dir:
        raise LaunchError("--agent and --dir are required (or --resume SESSION for an existing agent)")
    repo = launch_repo(args)
    brief = read_brief(args.brief_file, sys.stdin)
    launched = now()
    created = None
    if args.new_workspace:
        if args.workspace:
            raise LaunchError("--new-workspace makes the workspace: do not also pass --workspace")
        problems = launch_problems(args.name, args.agent, args.dir, args.new_workspace, args.issue, args.charter)
        if problems:
            raise LaunchError("; ".join(problems))
        problem = launch_account_problem(engine.config, engine.accounts, repo)
        if problem:
            raise LaunchError(problem)
        check_charter_workspace(engine, runner, now, args.charter, repo, args.new_workspace)
        with engine._external("herdr.workspace.create", args.name, {"label": args.new_workspace,
                                                                    "cwd": args.dir}) as result:
            # PR 15's launch never takes focus: only a person's own `bootstrap` does (PR 16)
            created = workspace = result["workspace"] = engine.herdr.workspace_create(
                args.dir, args.new_workspace, focus=False)["workspace_id"]
    try:
        done = launch_agent(engine, args.name, args.agent, args.dir, workspace, args.role, args.reports_to,
                            None if args.issue is None else int(args.issue), brief, charter=args.charter, repo=repo)
    except LaunchError as err:
        if created:
            raise LaunchError("%s (workspace %s was created and is left for you to close)" % (err, created)) from err
        raise
    print(json.dumps(done, sort_keys=True))
    note = set_checkpoint_reminders(engine, state, args.name, args.reports_to, None if args.issue is None
                                    else int(args.issue), repo, brief, getattr(args, "checkpoint", None),
                                    getattr(args, "overdue", None), launched, now())
    if note and (brief or args.checkpoint or args.overdue):
        sys.stderr.write("%s: %s\n" % (PROG, note))
    return EXIT_OK


def launch_repo(args):
    """The repo a launch is for: `--repo`, or the one a qualified `--issue` names; both must agree."""
    named = getattr(args, "repo", None)
    if named is not None and not REPO_RE.match(named):
        raise LaunchError("--repo must be OWNER/REPO, got %r" % named)
    qualified = issue_repo(args.issue)
    if named and qualified and named != qualified:
        raise LaunchError("--repo %s and --issue %s#%d name different repos" % (named, qualified, args.issue))
    return named or qualified


def check_charter_workspace(engine, runner, now, charter, repo, label):
    """Refuse a new workspace whose label is not the one the charter names (an exact match). A charter with no
    `workspace:` line, or no charter, is no objection. A charter that cannot be read is: the label is the one
    name the person you report to is shown, and a wrong one cannot be told from a right one."""
    if charter is None:
        return
    reader = engine.intents
    if reader is None and repo:
        reader = IntentReader(engine.config["gh"], repo, runner, now, engine.config["call_timeout_seconds"],
                              accounts=engine.accounts)
    if reader is None:
        return
    try:
        named = reader.issue(charter, repo).workspace
    except IntentError as err:
        raise LaunchError("cannot read charter #%d to check its workspace label: %s" % (charter, err)) from None
    if named is not None and named != label:
        raise LaunchError("charter #%d names workspace %r but --new-workspace is %r: the label must match exactly"
                          % (charter, named, label))


def resolve_for_sender(engine, config, issue, sender):
    """(repo, number) for an issue reference given by `sender`: its own repo is the default (PR 15)."""
    if issue is None:
        return None, None
    fleets = discovered_fleets(engine.discover(engine.now()))
    return resolve_issue(config, issue, fleets.get(sender, {}), watched_repos(config, fleets))


def cmd_send(args, runner, now):
    engine, _, config = build_engine(runner, now, "cli")
    refusal = intent_refusal(config, args.issue)
    if refusal:
        sys.stderr.write("%s: %s\n" % (PROG, refusal))
        return EXIT_USAGE
    if args.sender is not None:
        if os.environ.get(LAB_ENV) != "1":
            sys.stderr.write("%s: --from is only for the Lab (%s=1); an agent is identified by its pane\n"
                             % (PROG, LAB_ENV))
            return EXIT_USAGE
        sender = args.sender
    else:
        sender = identify_caller(engine.herdr, engine.v2, os.environ)
    text = " ".join(args.text).strip()
    if not text:
        sys.stderr.write("%s: nothing to send\n" % PROG)
        return EXIT_USAGE
    try:
        repo, number = resolve_for_sender(engine, config, args.issue, sender)
    except IssueRefError as err:
        sys.stderr.write("%s: %s\n" % (PROG, err))
        return EXIT_USAGE
    try:
        outcome = engine.send(sender, args.name, text, number, repo, interrupt=args.interrupt)
    except InterruptRefused as err:
        sys.stderr.write("%s: not interrupted, nothing sent: %s\n" % (PROG, err))
        return EXIT_USAGE
    if not outcome["sent"]:
        sys.stderr.write("%s: not sent to %s: %s (%s)\n" % (PROG, args.name, outcome["action"], outcome["reason"]))
        return EXIT_HELD
    print(outcome["message_id"])
    sys.stderr.write("%s: %s delivered to %s\n" % (PROG, outcome["action"], args.name))
    return EXIT_OK


def cmd_report(args, runner, now):
    """PR 13: tell the one you report to what happened. Delivered like `send`; a progress report is a rider."""
    engine, _, _ = build_engine(runner, now, "cli")
    if args.sender is not None:
        if os.environ.get(LAB_ENV) != "1":
            sys.stderr.write("%s: --from is only for the Lab (%s=1); an agent is identified by its pane\n"
                             % (PROG, LAB_ENV))
            return EXIT_USAGE
        sender = args.sender
    else:
        sender = identify_caller(engine.herdr, engine.v2, os.environ)
    try:
        outcome = engine.report(sender, args.state, " ".join(args.text), args.issue, args.everything)
    except (ReportError, IssueRefError) as err:
        sys.stderr.write("%s: %s\n" % (PROG, _one_line(str(err), 400)))
        return EXIT_USAGE
    if outcome.get("action") == "rider":
        sys.stderr.write("%s: %s\n" % (PROG, outcome["reason"]))
        print(outcome["key"])
        return EXIT_OK
    if not outcome["sent"]:
        sys.stderr.write("%s: not reported to %s: %s (%s)\n" % (PROG, outcome.get("recipient", "your boss"),
                                                               outcome["action"], outcome["reason"]))
        return EXIT_HELD
    print(outcome["message_id"])
    sys.stderr.write("%s: %s delivered to the one you report to\n" % (PROG, outcome["action"]))
    return EXIT_OK


def notice_boss(engine, sender):
    """The agent `sender` reports to, as the fleet shows it now, or None (not found, or the fleet cannot be read)."""
    try:
        seen = engine.discover(engine.now()).agents.get(sender)
    except Exception:
        return None
    boss = (seen.fleet or {}).get("reports_to") if seen is not None else None
    return boss if isinstance(boss, str) and boss.strip() else None


def cmd_notice(args, runner, now):
    """PR notices: tell the person about a PR you opened or mean to merge. Recorded for the daemon to show in the
    panel; sends no message and wakes nobody."""
    engine, state, _ = build_engine(runner, now, "cli")
    if args.sender is not None:
        if os.environ.get(LAB_ENV) != "1":
            sys.stderr.write("%s: --from is only for the Lab (%s=1); an agent is identified by its pane\n"
                             % (PROG, LAB_ENV))
            return EXIT_USAGE
        sender = args.sender
    else:
        sender = identify_caller(engine.herdr, engine.v2, os.environ)
    note = " ".join(" ".join(args.note).split())
    try:
        repo, number = parse_pr_ref(args.pr)
        if len(note) > REPORT_MAX:
            raise NoticeError("a note is one line of at most %d characters (this one is %d)" % (REPORT_MAX, len(note)))
        item, refreshed = record_pr_notice(state, repo, number, sender, note, now(), notice_boss(engine, sender))
    except NoticeError as err:
        sys.stderr.write("%s: %s\n" % (PROG, _one_line(str(err), 400)))
        return EXIT_USAGE
    if engine.audit is not None:
        engine.audit.append(engine.actor, "notice.pr", "%s#%d" % (repo, number),
                            {"from": sender, "refreshed": refreshed})
    sys.stderr.write("%s: notice of %s#%d %s; it shows in the person's panel until the PR is merged or closed "
                     "(nobody was messaged)\n" % (PROG, repo, number, "refreshed" if refreshed else "recorded"))
    print("%s#%d" % (repo, number))
    return EXIT_OK


def cmd_pending(args, runner, now):
    engine, _, _ = build_engine(runner, now, "cli", writable=False)
    entry = engine.pending(args.name)
    if args.json:
        print(json.dumps(entry, indent=2, sort_keys=True))
        return EXIT_OK
    print(_agent_line(entry))
    if entry["missing"]:
        print("  %s" % entry["missing"])
    repos = engine.repos_in_play()
    for fact in (entry["plan"] or {}).get("pending", []) + entry.get("riders", []):
        where = " issue %s" % issue_tag(fact.get("repo"), fact["issue"], repos) if fact["issue"] else ""
        print("  - %s%s  %s from %s%s at %s: %s" % (fact["key"], " [rider]" if fact.get("rider") else "", fact["kind"],
                                                    fact["from"] or "the fleet", where, iso(fact["created"]),
                                                    _one_line(fact["summary"], 200)))
    for problem in entry["source_problems"]:
        print("  problem: %s" % problem)
    return EXIT_OK


# ============================================================================
# PR 15: one Chief of Staff, many independent projects
#
# One section. docs/switchboard.md, "Many repos (PR 15)". The watched repos are
# derived on every pass, never listed (`watched_repos`); an issue is named by
# repo and number (`RepoIssue`, `resolve_issue`); and every repo has its own
# `gh` account (`GhAccounts`), whose token exists only in a child's environment.
# ============================================================================

class IssueRefError(Exception):
    """An issue reference that cannot be resolved to one repo."""


class RepoIssue(int):
    """An issue number that also says which repo it is in. It is an int, so every place that
    takes a number takes this; `.repo` is "owner/name", or None for a bare number."""

    repo = None

    def __new__(cls, number, repo=None):
        self = super().__new__(cls, number)
        self.repo = repo
        return self


_ISSUE_REF = re.compile(r"^(?:([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)#|#?)([0-9]+)$")


def parse_issue_ref(text):
    """`7`, `#7` or `owner/repo#7` -> a RepoIssue. Raises ValueError saying the accepted forms."""
    found = _ISSUE_REF.match(text.strip()) if isinstance(text, str) else None
    if not found or int(found.group(2)) < 1:
        raise ValueError("%r is not an issue: write N or owner/repo#N" % (text,))
    return RepoIssue(int(found.group(2)), found.group(1))


def issue_arg(text):
    """argparse's `type` for every --issue and issue argument."""
    try:
        return parse_issue_ref(text)
    except ValueError as err:
        raise argparse.ArgumentTypeError(str(err)) from None


def issue_repo(issue):
    """The repo an issue reference names, or None."""
    return getattr(issue, "repo", None)


def issue_tag(repo, number, repos=None):
    """How a message names an issue: `#2` with one repo in play, `api#2` with several (the repo name,
    or owner/name when two of them share a name)."""
    return decision_core.issue_tag(repo, number, repos)


def _fleet_repo(fleet, config):
    """The repo a fleet agent works in: its metadata, else (for an agent with a charter) `intent_repo`."""
    repo = (fleet or {}).get("repo")
    if isinstance(repo, str) and REPO_RE.match(repo):
        return repo
    if _is_issue_number((fleet or {}).get("charter")):
        return config.get("intent_repo")
    return None


def watched_repos(config, fleets):
    """The repos to watch now, sorted: the config baseline, every `repo` a live fleet agent names, and the
    repo of every charter it holds. `fleets` maps agent name -> metadata.fleet. Derived on every call, so
    there is nothing to keep and nothing to lose (R3). The `static-repos` fault reads the baseline only."""
    found = set(config["github_repos"])
    if fault("static-repos"):
        return sorted(found)
    for fleet in fleets.values():
        repo = _fleet_repo(fleet, config)
        if repo:
            found.add(repo)
    return sorted(found)


def discovered_fleets(discovery):
    return {name: seen.fleet or {} for name, seen in (discovery.agents.items() if discovery else [])}


def resolve_issue(config, issue, fleet=None, watched=None):
    """(repo, number) for an issue reference. A qualifier wins; a bare number is in the caller's own repo,
    else `intent_repo`. With several repos watched, a caller with no repo gets a refusal listing the choices.
    (None, number) when no repo is known at all (the old one-repo behaviour); (None, None) for no issue."""
    if issue is None:
        return None, None
    number = int(issue)
    repo = None if fault("bare-issue-number") else issue_repo(issue)
    if repo:
        return repo, number
    repo = (fleet or {}).get("repo")
    if isinstance(repo, str) and repo:
        return repo, number
    choices = sorted(watched or [])
    if len(choices) > 1:
        raise IssueRefError("issue %d does not say which repo it is in, and %d are watched: write %s"
                            % (number, len(choices), " or ".join("%s#%d" % (c, number) for c in choices)))
    return config.get("intent_repo") or (choices[0] if choices else None), number


# ------------------------------------------------------- a gh account per repo

class AccountError(Exception):
    """No token could be had for a repo's gh account. The text never holds a token."""


TOKEN_ENV_NAMES = ("GH_TOKEN", "GITHUB_TOKEN", "GH_ENTERPRISE_TOKEN", "GITHUB_ENTERPRISE_TOKEN")
TOKEN_TTL = 60  # seconds a token is kept in memory; never written anywhere


class GhAccounts:
    """Which gh account a repo uses, and its token at the moment of use.

    `gh_users` maps `owner/repo` or `owner/*` to an account name: the repo entry first, then the owner
    entry, then nothing (the environment's own default). The token comes from `gh auth token --user
    <account>` when it is needed, is held in memory for TOKEN_TTL seconds, and is handed to a child ONLY
    as GH_TOKEN in that child's environment: never in argv, a URL, a log, an audit entry, a message or an
    error (`scrub` takes it out of any text that was read back from a child).
    """

    def __init__(self, config, runner=subprocess.run, now=time.time, environ=None):
        self.config, self.runner, self.now = config, runner, now
        self.environ = os.environ if environ is None else environ
        self._tokens = {}

    def account_for(self, repo):
        if fault("one-account"):
            return None  # the fault: the default token reads every repo
        users = self.config.get("gh_users") or {}
        if repo in users:
            return users[repo]
        return users.get("%s/*" % repo.split("/")[0]) if isinstance(repo, str) and "/" in repo else None

    def default_available(self):
        return any(self.environ.get(name) for name in ("GH_TOKEN", "GITHUB_TOKEN"))

    def token_for(self, account):
        hit = self._tokens.get(account)
        if hit is not None and self.now() < hit[0]:
            return hit[1]
        clean = {k: v for k, v in self.environ.items() if k not in TOKEN_ENV_NAMES}
        try:
            done = self.runner([self.config["gh"], "auth", "token", "--user", account], capture_output=True,
                               text=True, timeout=self.config["call_timeout_seconds"], stdin=subprocess.DEVNULL,
                               env=clean)
        except (OSError, subprocess.SubprocessError) as err:
            raise AccountError("cannot ask gh for the token of account %s: %s" % (account, _one_line(str(err), 120))) from None
        token = (done.stdout or "").strip()
        if done.returncode != 0 or not token:
            raise AccountError("gh has no token for account %s: %s" % (
                account, _one_line(self.scrub(done.stderr or ""), 160) or "exit %d" % done.returncode))
        self._tokens[account] = (self.now() + TOKEN_TTL, token)
        return token

    def env_for(self, repo):
        """The environment for a child that works on `repo`, or None when the repo uses the default account."""
        account = self.account_for(repo) if repo else None
        if account is None:
            return None
        return dict(self.environ, GH_TOKEN=self.token_for(account))

    def token_env(self, repo):
        """{"GH_TOKEN": token} for an agent working in `repo`, {} when the repo uses the default account."""
        account = self.account_for(repo) if repo else None
        return {} if account is None else {"GH_TOKEN": self.token_for(account)}

    def scrub(self, text):
        for _, token in self._tokens.values():
            if token:
                text = text.replace(token, REDACTED)
        return text

    def describe(self, repo):
        """The account name `status` shows. Never a token."""
        return self.account_for(repo) or "default"


def launch_account_problem(config, accounts, repo):
    """Why a launch into `repo` must be refused (a sentence naming the missing entry), or None."""
    if not repo or not config.get("gh_users") or accounts.account_for(repo) or accounts.default_available() \
            or fault("one-account"):
        return None
    owner = repo.split("/")[0]
    return ("no gh account for %s: add \"%s\" or \"%s/*\" to gh_users in %s (and no default token is set)"
            % (repo, repo, owner, config_path()))


# ---------------------------------------------------------------- the judge's rule

_GH_SEG = re.compile(r"(?:^|[\s;&|(`'\"/])gh\s+([^;&|\n`]*)")
_API_REPOS = re.compile(r"(?:^|[\s'\"])/?(?:orgs/[^/\s'\"]+|user)/repos/?(?=$|[\s'\"?])")
_POST_FLAG = re.compile(r"(?:^|\s)(?:-X\s*|--method[=\s]\s*)POST\b", re.I)
_FIELD_FLAG = re.compile(r"(?:^|\s)(?:-f|-F|--field|--raw-field|--input)\b")


def repo_commissioning_rule(command):
    """The sentence naming what a shell command does to a repo's existence or visibility, or None.

    `gh repo create`, `gh repo delete`, `gh repo edit --visibility` and a POST to `/orgs/*/repos` are
    `hard_to_reverse` whatever the thresholds say: the Chief of Staff commissions a worker to do these, after
    a decision, and no agent does one quietly. Deterministic, so it needs no model; judge machinery only
    ever tightens."""
    if not isinstance(command, str):
        return None
    for found in _GH_SEG.finditer(command):
        words = found.group(1)
        positional = [w for w in words.split() if not w.startswith("-")]
        if positional[:2] in (["repo", "create"], ["repo", "delete"]):
            return "gh repo %s" % positional[1]
        if positional[:2] == ["repo", "edit"] and re.search(r"(?:^|\s)--visibility\b", words):
            return "gh repo edit --visibility"
        if positional[:1] == ["api"] and _API_REPOS.search(" " + words) \
                and (_POST_FLAG.search(words) or (_FIELD_FLAG.search(words) and not re.search(r"(?:-X|--method)", words))):
            return "gh api POST to a repo-creating endpoint"
    return None


# ------------------------------------------------- intent lines (PR 6)
#
# Every message names its ask and carries the ask's Intent and Done-when
# (docs/switchboard.md, "Intent lines"). GitHub is the only copy: this section
# reads an issue's `## Intent` section through `gh api` (GET only, invariant 6)
# and never writes it. Three levels: a charter (never repeated), an ask under
# it (Intent + Done when, written by the Chief of Staff), and optionally a work
# item under the ask (its own Intent line, written by the orchestrator).

INTENT_DEFAULTS = {
    "intent_repo": None,     # OWNER/REPO holding charters, asks and work items; None = no ask machinery
    "intent_required": True,  # with intent_repo set, `send` needs --issue
}
DEFAULTS.update(INTENT_DEFAULTS)

NO_INTENT = "no intent recorded"
INTENT_TTL = 300        # seconds a cached issue is trusted; a webhook invalidates it sooner
INTENT_LINE_LIMIT = 240  # characters per header line
REPO_RE = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")


def validate_intent_config(config, source):
    repo = config["intent_repo"]
    if repo is not None and not (isinstance(repo, str) and REPO_RE.match(repo)):
        raise ConfigError("%s: 'intent_repo' must be OWNER/REPO or null, got %r" % (source, repo))
    if not isinstance(config["intent_required"], bool):
        raise ConfigError("%s: 'intent_required' must be true or false, got %r" % (source, config["intent_required"]))


_HEADING = re.compile(r"^\s{0,3}#{1,6}\s+(.*?)\s*#*\s*$")
_DONE_WHEN = re.compile(r"^(?:[-*]\s+)?\**done when\**\s*:\s*\**\s*(.*?)\**\s*$", re.IGNORECASE)
_CHARTER_BLOCK = re.compile(r"```ya?ml\s*\n\s*orchestrator\s*:", re.IGNORECASE)


def parse_intent(body):
    """(intent, done_when) from the `## Intent` section of an issue body.

    The first line of the section is the Intent; a line starting `Done when:`
    is the Done-when. Either may be missing (None). Fenced code is ignored,
    the section ends at the next heading, and CRLF bodies are fine.
    """
    intent = done_when = None
    inside = fenced = False
    for line in (body or "").splitlines():
        if line.lstrip().startswith(("```", "~~~")):
            fenced = not fenced
            continue
        if fenced:
            continue
        heading = _HEADING.match(line)
        if heading:
            if inside:
                break
            inside = heading.group(1).strip().lower() == "intent"
            continue
        text = line.strip()
        if not inside or not text:
            continue
        match = _DONE_WHEN.match(text)
        if match:
            done_when = done_when or match.group(1).strip() or None
        elif intent is None:
            intent = text
    return intent, done_when


class IntentError(Exception):
    """GitHub could not answer. reason: "not_found", "unavailable" or "gh"."""

    def __init__(self, reason, detail=None):
        self.reason = reason
        super().__init__("%s: %s" % (reason, detail) if detail else reason)


_CHARTER_YAML = re.compile(r"```ya?ml\s*\n(\s*orchestrator\s*:.*?)```", re.IGNORECASE | re.DOTALL)
_WORKSPACE_LINE = re.compile(r"^\s*workspace\s*:\s*(.*?)\s*$", re.IGNORECASE | re.MULTILINE)


def charter_workspace(body):
    """The `workspace:` line of a charter's yaml block (the exact herdr workspace label), or None."""
    block = _CHARTER_YAML.search(body or "")
    line = _WORKSPACE_LINE.search(block.group(1)) if block else None
    value = line.group(1) if line else ""
    if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
        value = value[1:-1]
    return value or None


class IssueIntent:
    """What the switchboard knows of one issue: its Intent lines, and what kind it is."""

    def __init__(self, number, state, title, intent, done_when, updated_at, charter):
        self.number, self.state, self.title = number, state, title
        self.intent, self.done_when, self.updated_at, self.charter = intent, done_when, updated_at, charter
        self.repo = None  # PR 15: set by the reader that fetched it
        self.workspace = None  # PR 15: a charter's `workspace:` line

    @classmethod
    def from_api(cls, data):
        number = data.get("number") if isinstance(data, dict) else None
        if not (isinstance(number, int) and not isinstance(number, bool)):
            raise IntentError("gh", "an issue came back without a number")
        body = data.get("body") if isinstance(data.get("body"), str) else ""
        intent, done_when = parse_intent(body)
        found = cls(number, data.get("state"), data.get("title") or "", intent, done_when,
                    data.get("updated_at"), bool(_CHARTER_BLOCK.search(body)))
        found.workspace = charter_workspace(body)
        return found


def _header_line(text):
    return _one_line(text, INTENT_LINE_LIMIT)


def ask_lines(issue, tag=None):
    """The ask's header lines: Intent, then Done when; one line when neither is recorded. `tag` (PR 15) is how
    the ask is named when several repos are in play: `web#2`."""
    tag = tag or "#%d" % issue.number
    if issue.intent is None and issue.done_when is None:
        return [_header_line("Ask %s: %s" % (tag, NO_INTENT))]
    return [_header_line("Ask %s Intent: %s" % (tag, issue.intent or NO_INTENT)),
            _header_line("Done when: %s" % (issue.done_when or "not recorded"))]


def work_lines(issue, tag=None):
    return [_header_line("Work item %s Intent: %s" % (tag or "#%d" % issue.number, issue.intent or NO_INTENT))]


class IntentReader:
    """Reads Intent lines from GitHub, with an in-memory cache.

    Only ever runs `<gh> api <path>`: a GET, with no method, field or input
    flag, so there is nothing here that can write. Entries are keyed by repo
    and issue, remember the issue's `updated_at`, and expire after `ttl`
    seconds; `invalidate(issue)` drops them at once (the webhook handler's
    call, PR 5). A failed read is never cached.
    """

    def __init__(self, gh, repo, runner=subprocess.run, now=time.time, timeout=20, ttl=INTENT_TTL, accounts=None):
        self.gh, self.repo, self.runner, self.now = gh, repo, runner, now
        self.timeout, self.ttl = timeout, ttl
        self.accounts = accounts  # PR 15: a GhAccounts; None reads every repo with the default account
        self._cache = {}

    # -- GitHub

    def env_for(self, repo):
        """The child environment for `repo`'s account, or None. Raises IntentError, never with a token in it."""
        if self.accounts is None or not repo:
            return None
        try:
            return self.accounts.env_for(repo)
        except AccountError as err:
            raise IntentError("gh", str(err)) from None

    def _api(self, path, repo=None):
        argv = [self.gh, "api", path]
        env = self.env_for(repo)
        extra = {"env": env} if env is not None else {}
        try:
            result = self.runner(argv, capture_output=True, text=True, timeout=self.timeout,
                                 stdin=subprocess.DEVNULL, **extra)
        except subprocess.TimeoutExpired:
            raise IntentError("unavailable", "gh did not answer within %ss" % self.timeout) from None
        except OSError as err:
            raise IntentError("unavailable", "cannot run %s: %s" % (self.gh, err.strerror or err)) from None
        if result.returncode != 0:
            detail = _one_line(result.stderr) or _one_line(result.stdout) or "exit %d" % result.returncode
            if self.accounts is not None:
                detail = self.accounts.scrub(detail)
            if re.search(r"\b404\b|Not Found", detail):
                raise IntentError("not_found", detail)
            raise IntentError("gh", detail)
        try:
            return json.loads(result.stdout)
        except ValueError:
            raise IntentError("gh", "gh returned non-JSON: %s" % _one_line(result.stdout, 120)) from None

    def _cached(self, key, fetch):
        hit = self._cache.get(key)
        if hit is not None and self.now() - hit[0] < self.ttl:
            return hit[1]
        value = fetch()
        self._cache[key] = (self.now(), value)
        return value

    def invalidate(self, issue, repo=None):
        """Forget what is cached about `issue`; the next read asks GitHub again."""
        repo = repo or self.repo
        for kind in ("issue", "parent", "orders"):
            self._cache.pop((kind, repo, issue), None)

    # -- reading

    def issue(self, number, repo=None):
        repo = repo or self.repo

        def fetch():
            found = IssueIntent.from_api(self._api("repos/%s/issues/%d" % (repo, number), repo))
            found.repo = repo
            return found

        return self._cached(("issue", repo, number), fetch)

    def charter_orders(self, number, repo=None):
        """PR 17: the charter's standing orders (a list), read like the rest: cached for `ttl` seconds."""
        repo = repo or self.repo
        return self._cached(("orders", repo, number), lambda: fetch_orders(self, number, repo))

    def parent(self, number, repo=None):
        """The parent issue's number, or None when the issue has no parent."""
        repo = repo or self.repo

        def fetch():
            try:
                found = self._api("repos/%s/issues/%d/parent" % (repo, number), repo)
            except IntentError as err:
                if err.reason == "not_found":
                    return None
                raise
            return IssueIntent.from_api(found).number

        return self._cached(("parent", repo, number), fetch)

    def ask_of(self, number, repo=None):
        """(ask, work item) for an issue: a work item's ask is its parent.

        A parent counts as the ask when it has a parent of its own (the
        charter); under the charter itself, the issue is the ask.
        """
        parent = self.parent(number, repo)
        if parent is not None and self.parent(parent, repo) is not None:
            return parent, number
        return number, None

    def header(self, number, repo=None, repos=None):
        """(ask, ask lines, work item, work lines) for a message about `number`, at most
        three lines; None for a charter, which is never repeated. `repos`: the repos in play; with several,
        the lines name their issue with a repo tag."""
        repo = repo or self.repo
        if self.issue(number, repo).charter:
            return None
        ask, work = self.ask_of(number, repo)
        ask_issue = self.issue(ask, repo)
        if ask_issue.charter:
            return None
        if work is None:
            return ask, ask_lines(ask_issue, issue_tag(repo, ask, repos)), None, []
        return (ask, ask_lines(ask_issue, issue_tag(repo, ask, repos)), work,
                work_lines(self.issue(work, repo), issue_tag(repo, work, repos)))

    def missing_intent(self, number, repo=None):
        """The issues in this one's ask chain (ask, work item) with no Intent line. Charters are exempt."""
        if self.issue(number, repo).charter:
            return []
        ask, work = self.ask_of(number, repo)
        chain = [self.issue(n, repo) for n in ([ask] if work is None else [ask, work])]
        return [issue.number for issue in chain if issue.intent is None and not issue.charter]

    def open_asks(self, charter, repo=None):
        """The open sub-issues of a charter, derived from GitHub on every call."""
        repo = repo or self.repo
        found = self._api("repos/%s/issues/%d/sub_issues?per_page=100" % (repo, charter), repo)
        asks = []
        for data in found if isinstance(found, list) else []:
            issue = IssueIntent.from_api(data)
            issue.repo = repo
            self._cache[("issue", repo, issue.number)] = (self.now(), issue)
            if issue.state == "open":
                asks.append(issue)
        return asks


def intent_reader_for(config, runner=subprocess.run, now=time.time):
    """The IntentReader the config asks for, or None when no `intent_repo` is set."""
    if not config.get("intent_repo"):
        return None
    return IntentReader(config["gh"], config["intent_repo"], runner, now, config["call_timeout_seconds"],
                        accounts=GhAccounts(config, runner, now))


# -- composing: one section per ask

def section_resolver(engine, observation):
    """issue -> (ask, ask lines, work item, work lines) for compose, or None.

    None (no sections at all) when no ask machinery is configured or under the
    `no-intent-header` fault. A header GitHub cannot supply says so instead of
    stopping the delivery: an unreachable GitHub must not hold your agents'
    messages. The repo comes from the recipient's fleet metadata when it names
    one, else the config's `intent_repo`.
    """
    reader = getattr(engine, "intents", None)
    if reader is None or fault("no-intent-header"):
        return None
    own = ((observation.fleet or {}).get("repo") if observation else None) or reader.repo
    repos = engine.repos_in_play()

    def section(issue, repo=None):
        repo = repo or own
        try:
            return reader.header(issue, repo, repos)
        except IntentError as err:
            return issue, [_header_line("Ask %s: intent unavailable (%s)" % (issue_tag(repo, issue, repos), err))], None, []

    return section


def sectioned_lines(facts, section, item):
    """The body of a message: items that name no issue (or a charter) first, then
    one section per ask, never interleaved. A section is the ask's lines, its
    own items, then each work item's line followed by that work item's items."""
    lines, asks = [], {}
    for fact in facts:
        found = section(fact.issue, fact.repo) if fact.issue else None
        if found is None:
            lines.append(item(fact))
            continue
        ask, ask_header, work, work_header = found
        entry = asks.setdefault((fact.repo, ask), {"header": ask_header, "direct": [], "work": {}})  # PR 15: per repo
        if work is None:
            entry["direct"].append(item(fact))
        else:
            entry["work"].setdefault(work, (work_header, []))[1].append(item(fact))
    for entry in asks.values():
        lines.append("")
        lines.extend(entry["header"] + entry["direct"])
        for work_header, items in entry["work"].values():
            lines.extend(work_header + items)
    return lines


# -- change surfacing: pure functions over an `issues` webhook payload (PR 5 wires them)

def intent_diff(payload):
    """[(label, old, new)] for the Intent and Done-when an `issues.edited` payload
    actually changed; [] for any other event, or an edit that left them alone."""
    if not isinstance(payload, dict) or payload.get("action") != "edited":
        return []
    old = ((payload.get("changes") or {}).get("body") or {}).get("from")
    if not isinstance(old, str):
        return []  # the body was not edited (a title or label edit)
    new = (payload.get("issue") or {}).get("body")
    old_intent, old_done = parse_intent(old)
    new_intent, new_done = parse_intent(new if isinstance(new, str) else "")
    changes = []
    if old_intent != new_intent:
        changes.append(("Intent", old_intent, new_intent))
    if old_done != new_done:
        changes.append(("Done when", old_done, new_done))
    return changes


def _change_lines(changes):
    return ["%s: %s -> %s" % (label, old or "(none)", new or "(none)") for label, old, new in changes]


def _payload_issue(payload):
    issue = payload.get("issue") or {}
    number, updated = issue.get("number"), issue.get("updated_at")
    if not (isinstance(number, int) and not isinstance(number, bool) and number >= 1):
        raise FactError("an issues event without an issue number")
    try:
        created = datetime.strptime(updated, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc).timestamp()
    except (TypeError, ValueError):
        raise FactError("an issues event without a usable issue.updated_at: %r" % (updated,)) from None
    return number, updated, created


def intent_change_fact(payload, recipient="chief-of-staff"):
    """The Chief of Staff's item for an Intent edit, or None when the edit left
    the Intent section alone. Key `intent.edit:<issue>:<updated_at>`, so a
    redelivered webhook is one item."""
    changes = intent_diff(payload)
    if not changes:
        return None
    number, updated, created = _payload_issue(payload)
    login = (payload.get("sender") or {}).get("login")
    repo = (payload.get("repository") or {}).get("full_name")
    repo = repo if isinstance(repo, str) and REPO_RE.match(repo) else None
    summary = "\n".join(["The Intent section of #%d was edited on GitHub:" % number] + _change_lines(changes))
    # PR 15: the same number in two repos is two issues, so the key that stops a repeat names the repo
    key = "intent.edit:%s:%s" % ("%s#%d" % (repo, number) if repo else number, updated)
    return Fact(key, recipient, "intent.edit", summary, created, issue=number,
                sender=login if isinstance(login, str) and login else "github", repo=repo)


def intent_change_toast(payload):
    """What to tell you when an Intent changed: {"title", "body"} for
    HerdrClient.notification_show, or None."""
    changes = intent_diff(payload)
    if not changes:
        return None
    number, _, _ = _payload_issue(payload)
    return {"title": "Intent changed on #%d" % number, "body": _one_line("; ".join(_change_lines(changes)), 300)}


# -- `send` needs an issue

def intent_refusal(config, issue):
    """Why `send` must refuse without --issue, or None."""
    if config.get("intent_repo") and config.get("intent_required") and issue is None:
        return ("send needs --issue <n>: every message names the ask it belongs to "
                "(run `%s intent <n>`; set intent_required to false in the config to turn this off)" % PROG)
    return None


# -- status: issues agents refer to that have no Intent section

def referenced_issues(discovery, facts):
    """Issue numbers agents refer to: the issue each fleet agent works on, and
    each pending fact's issue. Charters are exempt when they are looked at."""
    numbers = {fact.issue for fact in facts if fact.issue}
    for agent in discovery.agents.values():
        issue = (agent.fleet or {}).get("issue")
        if isinstance(issue, int) and not isinstance(issue, bool):
            numbers.add(issue)
    return sorted(numbers)


INTENT_GAP_BUDGET = 4.0     # seconds `status` spends checking which referenced issues lack an Intent (#86)
INTENT_GAP_WORKERS = 8      # gh reads in flight at once; each is one subprocess, so they overlap


def intent_gap_report(engine, discovery, facts, budget=None):
    """{"intent_gaps": [issue...], "intent_errors": [text...], "intent_unchecked": n}; empty when no ask repo is
    configured. The reads run in parallel and share one time budget (#86): serial `gh` calls made `status` take
    ~0.4 s per referenced issue. Issues not read in time are counted, never guessed."""
    reader = getattr(engine, "intents", None)
    if reader is None:
        return {}
    budget = INTENT_GAP_BUDGET if budget is None else budget
    numbers = list(referenced_issues(discovery, facts))
    gaps, errors, pending = set(), [], 0
    if numbers:
        # Daemon threads, not an executor: an executor's workers are joined at interpreter exit, so one stuck `gh`
        # would hold the process after the status was printed.
        todo, results, deadline = list(reversed(numbers)), {}, time.monotonic() + budget
        lock = threading.Lock()

        def work():
            while True:
                with lock:
                    if not todo:
                        return
                    number = todo.pop()
                try:
                    results[number] = ("ok", reader.missing_intent(number))
                except IntentError as err:
                    results[number] = ("error", "#%d: %s" % (number, err))
                except Exception as err:  # one odd read must not take the status down
                    results[number] = ("error", "#%d: %s" % (number, _one_line(str(err), 100)))

        threads = [threading.Thread(target=work, daemon=True) for _ in range(min(INTENT_GAP_WORKERS, len(numbers)))]
        for thread in threads:
            thread.start()
        for thread in threads:
            thread.join(max(0.0, deadline - time.monotonic()))
        with lock:
            todo.clear()  # nothing new starts after the budget
        for number, (kind, value) in sorted(dict(results).items()):
            if kind == "ok":
                gaps.update(value)
            else:
                errors.append(value)
        pending = len(numbers) - len(results)
    report = {"intent_gaps": sorted(gaps), "intent_errors": errors}
    if pending:
        report["intent_unchecked"] = pending
    return report


def intent_gap_lines(agents):
    lines = []
    if agents.get("intent_gaps"):
        lines.append("      intent     no Intent section: %s" % ", ".join("#%d" % n for n in agents["intent_gaps"]))
    lines.extend("        intent problem: %s" % error for error in agents.get("intent_errors", []))
    if agents.get("intent_unchecked"):
        lines.append("        intent: %d referenced issue(s) not checked within the %gs budget (partial answer)"
                     % (agents["intent_unchecked"], INTENT_GAP_BUDGET))
    return lines


# -- the CLI: `intent` and `intents`

def _intent_reader(runner, now):
    config = load_config()
    active_faults()
    reader = intent_reader_for(config, runner, now)
    if reader is None:
        raise ConfigError("'intent_repo' is not configured in %s: set it to OWNER/REPO, the repo that "
                          "holds charters, asks and work items" % config_path())
    return reader


def soft_caller(runner, now):
    """(caller's fleet, watched repos) for a command that may be run by hand: what the fleet says when it
    can be read and the caller is a fleet agent, else nothing (and the config's repos)."""
    config = load_config()
    try:
        engine, _, _ = build_engine(runner, now, "cli", writable=False)
        fleets = discovered_fleets(engine.discover(engine.now()))
        watched = watched_repos(config, fleets)
    except (ConfigError, V2Error, HerdrError):
        return {}, watched_repos(config, {})
    try:
        return caller_fleet(engine.herdr, engine.v2, os.environ), watched
    except (CallerError, V2Error, HerdrError):
        return {}, watched


def cmd_intent(args, runner, now):
    """Print the ask's Intent and Done-when, and the work item's Intent line."""
    reader = _intent_reader(runner, now)
    fleet, watched = soft_caller(runner, now)
    try:
        repo, number = resolve_issue(load_config(), args.issue, fleet, watched)
    except IssueRefError as err:
        sys.stderr.write("%s: %s\n" % (PROG, err))
        return EXIT_USAGE
    repos = watched if len(watched) > 1 else None
    found = reader.header(number, repo, repos)
    if found is None:
        print("%s is a charter: its standing job is not repeated in messages. Ask for an ask under it."
              % issue_tag(repo or reader.repo, number, repos))
        return EXIT_OK
    _, ask_header, _, work_header = found
    print("\n".join(ask_header + work_header))
    return EXIT_OK


def caller_fleet(herdr, v2, environ):
    """The caller's `metadata.fleet`: HERDR_PANE_ID -> herdr agent -> v2 session."""
    pane = environ.get("HERDR_PANE_ID")
    if not pane:
        raise CallerError("HERDR_PANE_ID is not set: run intents from a fleet agent's herdr pane")
    session_id = agent_session(herdr.agent_get(pane))
    fleet = _fleet_meta(v2.session_get(session_id)) if session_id else None
    if not fleet or not isinstance(fleet.get("name"), str) or not fleet["name"]:
        raise CallerError("pane %s is not a fleet agent (no metadata.fleet.name)" % pane)
    return fleet


def _is_issue_number(value):
    return isinstance(value, int) and not isinstance(value, bool) and value >= 1


def asks_of_caller(engine, fleet, now):
    """[(owner, IssueIntent)] the caller is accountable for, from GitHub now.

    The rule: an ask is an open sub-issue of an orchestrator's charter. A
    Chief of Staff sees the asks under every orchestrator's charter, found
    from fleet metadata (`role` orchestrator, `charter` an issue number); an
    orchestrator sees the asks under its own charter; any other role sees the
    ask of the issue it works on.
    """
    reader = engine.intents
    repo = fleet.get("repo") or reader.repo
    if fleet.get("role") == "chief-of-staff":
        charters = [(agent.name, (agent.fleet or {}).get("charter"), _fleet_repo(agent.fleet, engine.config) or repo)
                    for agent in sorted(engine.discover(now).agents.values(), key=lambda a: a.name)
                    if (agent.fleet or {}).get("role") == "orchestrator"]
    elif fleet.get("role") == "orchestrator":
        charters = [(fleet["name"], fleet.get("charter"), repo)]
    else:
        issue = fleet.get("issue")
        if not _is_issue_number(issue):
            return []
        ask, _ = reader.ask_of(issue, repo)
        return [(fleet["name"], reader.issue(ask, repo))]
    asks = []
    for owner, charter, charter_repo in charters:
        if _is_issue_number(charter):
            asks.extend((owner, issue) for issue in reader.open_asks(charter, charter_repo))
    return asks


def ask_row(owner, issue, repos=None):
    return "%s  [%s]  %s  | Done when: %s" % (issue_tag(issue.repo, issue.number, repos), owner,
                                              issue.intent or NO_INTENT, issue.done_when or "not recorded")


def cmd_intents(args, runner, now):
    """The caller's open asks, one line each with its Done-when."""
    engine, _, config = build_engine(runner, now, "cli", writable=False)
    if engine.intents is None:
        raise ConfigError("'intent_repo' is not configured in %s: set it to OWNER/REPO" % config_path())
    fleet = caller_fleet(engine.herdr, engine.v2, os.environ)
    rows = asks_of_caller(engine, fleet, engine.now())
    if not rows:
        print("no open asks for %s" % fleet["name"])
    engine.discover(engine.now())
    repos = engine.repos_in_play()
    for owner, issue in rows:
        print(ask_row(owner, issue, repos))
    return EXIT_OK


INTENT_COMMANDS = {"intent": cmd_intent, "intents": cmd_intents}


def add_intent_parsers(sub):
    intent = sub.add_parser("intent", help="Print an issue's ask: its Intent and Done-when, and the work item's Intent")
    intent.add_argument("issue", type=issue_arg, help="The issue number")
    sub.add_parser("intents", help="Your open asks, one line each with its Done-when")


# ============================================================================
# PR 9: the tool-call policy judge
#
# One section, so the stack rebases cleanly. docs/switchboard.md, "Tool-call
# policy (PR 9)" and invariant 9. `fleet-switchboard judge-tool` is what the
# `fleet-hooks` plugin runs, once per tool call, with one JSON object on stdin;
# it prints one JSON line and exits 0 whatever happens, because the judge only
# tightens: when it cannot answer, the configured outcome stands.
#
# The daemon, not v2, holds the OpenRouter key: `judge-tool` runs in v2's
# environment (every agent's shell sees it), so it never reads the key and
# never calls Jev. It asks the daemon over $STATE/judge.sock (see "the judge
# socket" below), and the daemon runs the judgement.
#
# Registered in six places: DEFAULTS (here), `validate_config`
# (`validate_policy_config`), `build_parser` (`add_policy_parsers`), `main`
# (the `judge-tool` branch), `cmd_run` (`start_judge_server`) and the fault
# list (`no-policy-judge`).
#
# This section reads GitHub (the ask's Intent, the charter's standing
# authority) through IntentReader, which can only GET, and reads and writes
# nothing else but its two cache files and the audit log. It never touches
# herdr and never writes to GitHub.
# ============================================================================
POLICY_TOOLS = ("shell", "edit", "webfetch", "subagent", "read", "glob", "grep", "skill", "other")
POLICY_PASS_THROUGH = ("read", "glob", "grep", "skill")  # never judged, never sent to Jev
POLICY_REQUEST_OUTCOMES = ("allow", "ask", "deny")       # what the plugin can configure and be told
POLICY_DEFAULTS = {
    "enabled": False,       # off until the plugin is installed and a `jev` object is configured
    "budget_ms": 1500,      # the whole judgement; no answer in time keeps the configured outcome. Jev alone ran to ~1 s in the trial
    "thresholds": {},       # question id -> probability at which it fires (default POLICY_THRESHOLD)
    "cache_seconds": 300,   # how long a verdict or a resolved ask is reused; 0 turns both caches off
    "cache_entries": 200,   # entries kept in each cache file
    "shadow": False,        # record what the judge would do (audit policy.judge, `shadow`/`verdict`), enforce nothing
}
DEFAULTS["policy"] = None   # None means POLICY_DEFAULTS
POLICY_STDIN_LIMIT = 65536  # bytes of request read from stdin
POLICY_ARG_LIMIT = 4000     # characters of a tool's arguments kept
POLICY_WARM_SECONDS = 8     # after replying, how long a late lookup may go on filling the caches
POLICY_CACHE_BYTES = 1 << 20
POLICY_VERDICT_FILE = "policy-verdicts.json"  # hashes and probabilities only
POLICY_CONTEXT_FILE = "policy-context.json"   # resolved asks and sessions: a disposable copy of what GitHub and v2 say
POLICY_SESSION_RE = re.compile(r"^ses_[A-Za-z0-9]{1,80}$")
NO_STANDING_AUTHORITY = ("none stated: nothing is pre-authorised, so treat any merge, deploy, publish, "
                         "message to others or spend as not covered")
POLICY_FIRED_TEXT = {"hard_to_reverse": "hard to reverse",
                     "speaks_for_you": "speaks for you, which the standing authority does not cover",
                     "outside_scope": "outside this agent's assignment"}
POLICY_ACTOR = "judge-tool"


def validate_policy_config(config, source):
    """Check and complete `policy`: unknown subkeys are refused, every value is checked."""
    raw = config.get("policy")
    if raw is None:
        raw = {}
    if not isinstance(raw, dict):
        raise ConfigError("%s: 'policy' must be an object, got %r" % (source, type(raw).__name__))
    unknown = sorted(set(raw) - set(POLICY_DEFAULTS))
    if unknown:
        raise ConfigError("%s: 'policy' contains key(s) this tool does not read: %s (known: %s)"
                          % (source, ", ".join(unknown), ", ".join(POLICY_DEFAULTS)))
    settings = dict(POLICY_DEFAULTS, **raw)
    if not isinstance(settings["enabled"], bool):
        raise ConfigError("%s: 'policy.enabled' must be true or false, got %r" % (source, settings["enabled"]))
    for name in ("budget_ms", "cache_seconds"):
        value = settings[name]
        if not _is_number(value) or value < 0 or (name == "budget_ms" and value <= 0):
            raise ConfigError("%s: 'policy.%s' must be a %s number, got %r"
                              % (source, name, "positive" if name == "budget_ms" else "non-negative", value))
    if not isinstance(settings["shadow"], bool):
        raise ConfigError("%s: 'policy.shadow' must be true or false, got %r" % (source, settings["shadow"]))
    entries = settings["cache_entries"]
    if not (isinstance(entries, int) and not isinstance(entries, bool) and 1 <= entries <= 5000):
        raise ConfigError("%s: 'policy.cache_entries' must be an integer from 1 to 5000, got %r" % (source, entries))
    settings["thresholds"] = _checked_policy_thresholds(settings["thresholds"], source)
    if settings["enabled"] and not config.get("jev"):
        raise ConfigError("%s: 'policy.enabled' needs a 'jev' object: there is no decision model to ask" % source)
    config["policy"] = settings


def _checked_policy_thresholds(thresholds, source):
    if not isinstance(thresholds, dict):
        raise ConfigError("%s: 'policy.thresholds' must be an object of question id -> probability" % source)
    for name, value in thresholds.items():
        if name not in POLICY_QUESTIONS:
            raise ConfigError("%s: 'policy.thresholds' names no question %r (known: %s)"
                              % (source, name, ", ".join(POLICY_QUESTIONS)))
        if not _is_number(value) or not 0 < value <= 1:
            raise ConfigError("%s: 'policy.thresholds.%s' must be a number above 0 and at most 1, got %r"
                              % (source, name, value))
    return dict(thresholds)


# ------------------------------------------------------------- the request

class PolicyRequestError(ValueError):
    """What `judge-tool` was given on stdin is not a usable request."""


def parse_policy_request(text):
    """{"session", "tool", "arguments", "configured"} from the plugin's JSON, or PolicyRequestError."""
    try:
        data = json.loads(text)
    except (TypeError, ValueError):
        raise PolicyRequestError("the request is not JSON") from None
    if not isinstance(data, dict):
        raise PolicyRequestError("the request must be a JSON object")
    session = data.get("sessionID")
    if not isinstance(session, str) or not POLICY_SESSION_RE.match(session):
        raise PolicyRequestError("sessionID must be a v2 session id (ses_...)")
    if data.get("tool") not in POLICY_TOOLS:
        raise PolicyRequestError("tool must be one of %s" % ", ".join(POLICY_TOOLS))
    if data.get("outcome") not in POLICY_REQUEST_OUTCOMES:
        raise PolicyRequestError("outcome must be one of %s" % ", ".join(POLICY_REQUEST_OUTCOMES))
    arguments = data.get("arguments", "")
    if arguments is None:
        arguments = ""
    elif not isinstance(arguments, str):
        arguments = _canonical(arguments)
    return {"session": session, "tool": data["tool"], "arguments": arguments[:POLICY_ARG_LIMIT],
            "configured": data["outcome"]}


def _guess_configured(text):
    """The configured outcome in a request we could not use, or `allow`, which no plugin applies."""
    try:
        outcome = json.loads(text).get("outcome")
    except (TypeError, ValueError, AttributeError):
        return "allow"
    return outcome if outcome in POLICY_REQUEST_OUTCOMES else "allow"


_SECRET_PATTERNS = (
    (re.compile(r"(?i)\b(bearer|basic)\s+[A-Za-z0-9._~+/=-]{6,}"), r"\1 [redacted]"),
    (re.compile(r"(?i)\b([A-Za-z0-9_.-]*(?:token|secret|passw(?:or)?d|api[_-]?key|credential|auth)[A-Za-z0-9_.-]*)"
                r"(\s*[=:]\s*|\s+)(\"[^\"]*\"|'[^']*'|\S+)"), r"\1\2[redacted]"),
    (re.compile(r"\b(?:sk-[A-Za-z0-9_-]{8,}|gh[pousr]_[A-Za-z0-9]{16,}|github_pat_[A-Za-z0-9_]{20,}"
                r"|AKIA[0-9A-Z]{12,}|xox[abprs]-[A-Za-z0-9-]{8,})"), "[redacted]"),
    (re.compile(r"(://[^/\s:@]+:)[^@\s/]+@"), r"\1[redacted]@"),
)


# The sanctioned channel between agents. What a message *says* is not an action: the trial judged
# `fleet-switchboard send cos "... run gh workflow run deploy.yml ..."` as a deploy. The receiving agent
# judges what it then does. Only these read or message; `launch`, `handoff` and `import-v1` act, and stay judged.
POLICY_MESSAGE_COMMANDS = ("send", "intent", "intents", "pending", "status", "remind")


def _plain_words(text):
    """The words of ONE simple command whose arguments cannot run anything: no substitution, no operator, no
    redirect outside quotes, no unbalanced quote. None for anything this is unsure about."""
    if not isinstance(text, str) or not text.strip():
        return None
    quote, words, word, any_word = None, [], [], False
    for ch in text.strip():
        if quote == "'":
            if ch == "'":
                quote = None
            else:
                word.append(ch)
        elif quote == '"':
            if ch in "`$\\":
                return None  # substitution or an escape inside double quotes
            if ch == '"':
                quote = None
            else:
                word.append(ch)
        elif ch in "'\"":
            quote, any_word = ch, True
        elif ch in "`$\\;&|<>(){}*?[]~#!\n\r":
            return None  # an operator, expansion, glob, comment or a second line outside any quote
        elif ch in " \t":
            if word or any_word:
                words.append("".join(word))
                word, any_word = [], False
        else:
            word.append(ch)
    if quote is not None:
        return None
    if word or any_word:
        words.append("".join(word))
    return words


def _decisions_subcommand(rest):
    """The subcommand word of `decisions ...` (after its flags), or None for a plain list."""
    skip = False
    for word in rest:
        if skip:
            skip = False
        elif word in ("--repo", "--tier", "--from"):
            skip = True
        elif not word.startswith("-"):
            return word
    return None


def plain_switchboard_message(text):
    """True only for ONE simple `fleet-switchboard <send|intent|...> ...` command whose arguments cannot run
    anything (see _plain_words). Anything this is unsure about is judged like any other shell command.

    PR 18: `decisions` (a read, `list`, or `escalate`) and `orders --cos` (a read) are plain too. `decisions
    resolve`, `decisions answer` and `decisions supersede` are NOT: they act for the owner, so the judge reads them against the Chief of
    Staff's standing orders (the `answer-unjudged` fault lets them through). `decisions batch` writes an issue to GitHub,
    so it is judged too, however its quoted rows are written (it was plain: a quoted pipe is text)."""
    words = _plain_words(text)
    if not words or len(words) < 2 or os.path.basename(words[0]) != PROG:
        return False
    if words[1] in POLICY_MESSAGE_COMMANDS:
        return True
    if words[1] == "decisions":
        return _decisions_subcommand(words[2:]) not in ("resolve", "answer", "supersede", "batch") or fault("answer-unjudged")
    return words[1] == "orders" and words[2:] == ["--cos"]


def decision_gloss(state_dir, command):
    """For a judged `decisions answer|resolve <id>`: one line saying what that decision is, read from the file the
    daemon keeps, so the judge's question sees the request and not just its id. Empty when it cannot say."""
    words = _plain_words(command)
    if not words or len(words) < 4 or os.path.basename(words[0]) != PROG or words[1] != "decisions":
        return ""
    rest = words[2:]
    sub = _decisions_subcommand(rest)
    if sub not in ("resolve", "answer", "supersede") or rest.index(sub) + 1 >= len(rest):
        return ""
    ident = rest[rest.index(sub) + 1]
    body = read_decisions_file(Path(state_dir) / DECISIONS_FILE)
    for decision in (body or {}).get("decisions", []):
        if isinstance(decision, dict) and decision.get("id") in (ident, "#" + ident.lstrip("#")):
            return " [the decision it acts on: %s by %s, %s tier: %s]" % (
                decision.get("kind"), decision.get("agent"), decision.get("tier"), _one_line(decision.get("title"), 300))
    return ""


def redact_command_text(text, extra=()):
    """`text` with credential-shaped parts replaced, and any value in `extra` (a known key) removed.

    A tool's arguments go to a third-party model and to the audit log; neither
    may see a credential. This is a net, not a promise: it catches the usual shapes.
    """
    text = "" if text is None else str(text)
    for secret in extra:
        if secret:
            text = text.replace(secret, "[redacted]")
    for pattern, replacement in _SECRET_PATTERNS:
        text = pattern.sub(replacement, text)
    return text


# ------------------------------------------------------- standing authority

_STANDING_AUTHORITY = re.compile(r"^(?:[-*]\s+)?\**standing authority\**\s*:\s*\**\s*(.*?)\**\s*$", re.IGNORECASE)

# PR 17: standing orders. The charter issue's `## Standing orders` section, one order per bullet,
# `- <text> (ordered by <name>, <YYYY-MM-DD>)`; the one-line `Standing authority:` stays valid and
# counts as one more order. `parse_orders` is the one parser.
ORDERS_HEADING = "## Standing orders"
ORDERS_MAX = 20          # orders a charter may carry
ORDER_MAX_CHARS = 300    # characters of one order's text
ORDERS_STATE_CLIP = 600  # characters of the joined orders the judge's model sees
_ORDERS_HEADING = re.compile(r"^#{1,6}\s+standing orders\s*$", re.IGNORECASE)
_ANY_HEADING = re.compile(r"^#{1,6}\s")
_ORDER_BULLET = re.compile(r"^[-*]\s+(\S.*?)\s*$")


class OrdersError(Exception):
    """An order that cannot be recorded or removed, and why."""


def _legacy_authority(body):
    """The charter's one-line `Standing authority:` text, or None when it states none.

    It lives in the charter issue's prose, below the yaml block; fenced code is
    ignored, the first such line wins, and "none" counts as none stated.
    """
    fenced = False
    for line in (body or "").splitlines():
        if line.lstrip().startswith(("```", "~~~")):
            fenced = not fenced
            continue
        match = None if fenced else _STANDING_AUTHORITY.match(line.strip())
        if match:
            text = match.group(1).strip()
            return None if not text or text.lower().rstrip(".") in ("none", "none stated", "n/a") else text
    return None


def _orders_section(body):
    """The first `## Standing orders` section outside a fenced block: None, or a dict with the character
    offsets `start` (its heading), `head_end`, `end` (the next heading, or the end of the body) and
    `bullets`, a list of (start, end, text), one per order, in the body's own bytes."""
    body = body or ""
    fenced, offset, found = False, 0, None
    for line in body.splitlines(keepends=True):
        start, offset = offset, offset + len(line)
        stripped = line.strip()
        if stripped.startswith(("```", "~~~")):
            fenced = not fenced
            continue
        if fenced:
            continue
        if found is None:
            if _ORDERS_HEADING.match(stripped):
                found = {"start": start, "head_end": offset, "end": len(body), "bullets": []}
            continue
        if _ANY_HEADING.match(stripped):
            found["end"] = start
            break
        match = _ORDER_BULLET.match(stripped)
        if match:
            found["bullets"].append((start, offset, match.group(1)))
    return found


def section_orders(body):
    """The orders of the `## Standing orders` section alone, in order."""
    found = _orders_section(body)
    return [text for _, _, text in found["bullets"]] if found else []


def parse_orders(body):
    """Every standing order the charter body states: the section's bullets in order, then the legacy
    `Standing authority:` line when there is one. [] when there are none."""
    legacy = _legacy_authority(body)
    return section_orders(body) + ([legacy] if legacy else [])


def parse_standing_authority(body):
    """The orders joined into one line, or None when the charter states none (the old one-line form,
    kept for its callers: it answers through `parse_orders`)."""
    orders = parse_orders(body)
    return "; ".join(orders) if orders else None


def _eol_of(body):
    return "\r\n" if "\r\n" in body else "\n"


def add_order_to_body(body, text, by, date):
    """`body` with one more order, `- <text> (ordered by <by>, <date>)`, added to the section (made at the
    end of the body when there is none). Every byte outside the section is kept. OrdersError for a text
    that is empty, longer than ORDER_MAX_CHARS or on more than one line, and for a twenty-first order."""
    body = body or ""
    text = (text or "").strip()
    by = " ".join(str(by or "").split())[:60]
    if not text:
        raise OrdersError("an order needs some text")
    if "\n" in text or "\r" in text:
        raise OrdersError("an order is one line")
    if len(text) > ORDER_MAX_CHARS:
        raise OrdersError("an order is at most %d characters; this one has %d" % (ORDER_MAX_CHARS, len(text)))
    if not by:
        raise OrdersError("an order records who ordered it (--by)")
    eol = _eol_of(body)
    bullet = "- %s (ordered by %s, %s)" % (text, by, date)
    found = _orders_section(body)
    if found is not None:
        if len(found["bullets"]) >= ORDERS_MAX:
            raise OrdersError("this charter already has %d standing orders, the most it carries; remove one first"
                              % ORDERS_MAX)
        if found["bullets"]:
            at = found["bullets"][-1][1]
            lead = "" if body[:at].endswith(("\n", "\r")) else eol
            return body[:at] + lead + bullet + eol + body[at:]
        at = found["head_end"]
        lead = "" if body[:at].endswith(("\n", "\r")) else eol
        return body[:at] + lead + eol + bullet + eol + body[at:]
    if not body:
        sep = ""
    elif body.endswith(eol + eol):
        sep = ""
    elif body.endswith(eol):
        sep = eol
    else:
        sep = eol + eol
    return body + sep + ORDERS_HEADING + eol + eol + bullet + eol


def remove_order_from_body(body, number):
    """`body` without order `number` (as `orders list` numbers them). Only the section changes; when the last
    order goes the section goes with it. The legacy `Standing authority:` line is numbered after the section's
    orders but lies outside the section, so it is refused: edit it on GitHub."""
    body = body or ""
    found = _orders_section(body)
    bullets = found["bullets"] if found else []
    total = len(parse_orders(body))
    if not isinstance(number, int) or isinstance(number, bool) or not 1 <= number <= total:
        raise OrdersError("no order %s: this charter has %d" % (number, total))
    if number > len(bullets):
        raise OrdersError("order %d is the legacy `Standing authority:` line, outside the %s section: edit or "
                          "delete that line on GitHub" % (number, ORDERS_HEADING))
    start, end, _ = bullets[number - 1]
    kept = [line for line in body[found["start"]:found["end"]].splitlines()
            if line.strip() and not _ORDERS_HEADING.match(line.strip())]
    if len(bullets) == 1 and len(kept) == 1:  # nothing but this order: the section goes
        start, end = found["start"], found["end"]
        out = body[:start] + body[end:]
        eol = _eol_of(body)
        if end == len(body) and out.endswith(eol + eol):
            out = out[:-len(eol)]  # the blank line that set the section off
        return out
    return body[:start] + body[end:]


def os_user():
    """The operating-system user, the default for `orders add --by`."""
    try:
        return getpass.getuser()
    except Exception:
        return "unknown"


def fetch_charter_body(reader, charter, repo):
    """The charter issue's body (or None) through the reader's GET-only `gh api`: the one read of it."""
    data = reader._api("repos/%s/issues/%d" % (repo, charter), repo)
    return data.get("body") if isinstance(data, dict) and isinstance(data.get("body"), str) else None


def fetch_orders(reader, charter, repo):
    """The charter issue's standing orders (a list) through the reader's GET-only `gh api`."""
    return parse_orders(fetch_charter_body(reader, charter, repo))


def fetch_standing_authority(reader, charter, repo):
    """The orders joined into one line, or None (kept for the callers that want a single string)."""
    orders = fetch_orders(reader, charter, repo)
    return "; ".join(orders) if orders else None


def resolve_policy_context(reader, fleet):
    """{"issue", "intent", "done_when", "authority"} for the agent's ask, from GitHub (IntentError on failure).

    The ask is the agent's issue, or its parent when the issue is a work item;
    an orchestrator with only a charter has no ask (`issue` None). The
    authority comes from the charter above the ask, or the charter itself.
    """
    repo = fleet.get("repo") or reader.repo
    issue, charter = fleet.get("issue"), fleet.get("charter")
    ask = intent = done_when = None
    if _is_issue_number(issue) and reader.issue(issue, repo).charter:
        issue, charter = None, issue
    if _is_issue_number(issue):
        ask, work = reader.ask_of(issue, repo)
        found = reader.issue(ask, repo)
        intent, done_when = found.intent, found.done_when
        if work is not None and reader.issue(work, repo).intent:
            intent = "%s (work item: %s)" % (intent or NO_INTENT, reader.issue(work, repo).intent)
        charter = reader.parent(ask, repo)
    orders = authority = None
    if _is_issue_number(charter):
        body = fetch_charter_body(reader, charter, repo)
        orders = parse_orders(body)
        # PR 17: the model's question sees every order; `orders-never-judged` shows it only the old one-line form
        seen = [_legacy_authority(body)] if fault("orders-never-judged") else orders
        seen = [text for text in seen if text]
        authority = "; ".join(seen) if seen else None
    return {"issue": ask if intent else None, "intent": intent, "done_when": done_when, "authority": authority,
            "charter": charter if _is_issue_number(charter) else None, "charter_repo": repo, "orders": orders or []}


# PR 17: an agent must not edit the charter it works under: that would grant itself authority. This is a
# deterministic rule beside the model's questions. It is a guard, not a proof: a shell can build the call
# out of pieces this text never shows (a variable, a script, an alias, another tool), and the rule sees only
# the agent's own charter. It reads the command's words, as the redaction does.
_GH_ISSUE_EDIT = re.compile(r"\bgh(?:\s+(?:-R|--repo)[ =]\S+)?\s+issue\s+edit\b([^;&|\n]*)", re.IGNORECASE)
_GH_API = re.compile(r"\bgh(?:\s+(?:-R|--repo)[ =]\S+)?\s+api\b([^;&|\n]*)", re.IGNORECASE)
_GH_REPO_FLAG = re.compile(r"\bgh\s+(?:-R|--repo)[ =]['\"]?([\w.-]+/[\w.-]+)", re.IGNORECASE)
_REPO_FLAG = re.compile(r"(?:^|\s)(?:-R|--repo)(?:\s+|=)['\"]?([\w.-]+/[\w.-]+)", re.IGNORECASE)
_API_WRITE_METHOD = re.compile(r"(?:-X|--method)(?:\s+|=)?['\"]?(?:PATCH|PUT|DELETE)\b", re.IGNORECASE)
_API_ISSUE_PATH = re.compile(r"repos/([\w.-]+/[\w.-]+)/issues/(\d+)(?![\w/])")
_ISSUE_WORD = re.compile(r"^['\"]?(?:(?:([\w.-]+/[\w.-]+)#|#)(\d+)|(\d+)|\S*?(?:([\w.-]+/[\w.-]+)/issues/)(\d+))['\"]?$")


def charter_edit_target(command, charters):
    """The number of the charter that a shell command rewrites with gh's issue subcommand or `gh api` PATCH, PUT
    or DELETE of `repos/<repo>/issues/<n>`, or None. `charters` holds what the agent works under: a bare number
    (any repo) or a `(repo, number)` pair, which a command that names another repo (`--repo`, `-R`, a URL, an
    `owner/repo#N` word or the api path) does not hit: issue 1 of another repo is not this charter."""
    text = command if isinstance(command, str) else ""

    def owns(repo, number):
        return any(number == (c[1] if isinstance(c, tuple) else c) and (repo is None or not isinstance(c, tuple)
                                                                        or c[0] is None or c[0].lower() == repo.lower())
                   for c in charters)

    for found in _GH_ISSUE_EDIT.finditer(text):
        rest, repo = found.group(1), None
        flagged = _REPO_FLAG.search(" " + rest) or _GH_REPO_FLAG.search(found.group(0))
        if flagged:
            repo = flagged.group(1)
        for word in rest.split():
            match = _ISSUE_WORD.match(word)
            if not match:
                continue
            named = match.group(1) or match.group(4)
            number = int(match.group(2) or match.group(3) or match.group(5))
            if owns(named or repo, number):
                return number
    for found in _GH_API.finditer(text):
        rest = found.group(1)
        path = _API_ISSUE_PATH.search(rest)
        if path and _API_WRITE_METHOD.search(rest) and owns(path.group(1), int(path.group(2))):
            return int(path.group(2))
    return None


# ------------------------------------------------------------------ the caches

class BoundedFileCache:
    """A small JSON file of {key: {at, value}}: bounded, expiring, private, replaceable.

    It is a cache and nothing else: deleting it loses only speed (invariant 8).
    Written atomically (a temp file, mode 0600, then rename); a missing,
    oversized or corrupt file reads as empty; a write that fails is not an error.
    A ttl of 0 turns it off.
    """

    def __init__(self, path, now, ttl, limit):
        self.path, self.now, self.ttl, self.limit = Path(path), now, ttl, limit

    def _fresh(self):
        if not self.ttl:
            return {}
        try:
            if self.path.stat().st_size > POLICY_CACHE_BYTES:
                return {}
            data = json.loads(self.path.read_text())
        except (OSError, ValueError):
            return {}
        entries = data.get("entries") if isinstance(data, dict) else None
        if not isinstance(entries, dict):
            return {}
        return {key: entry for key, entry in entries.items()
                if isinstance(entry, dict) and _is_number(entry.get("at")) and self.now() - entry["at"] < self.ttl
                and self.now() >= entry["at"]}

    def get(self, key):
        entry = self._fresh().get(key)
        return entry["value"] if entry else None

    def put(self, key, value):
        """Store one entry, dropping the oldest beyond the limit. True when it was written."""
        if not self.ttl:
            return False
        entries = self._fresh()
        entries[key] = {"at": self.now(), "value": value}
        for old in sorted(entries, key=lambda k: entries[k]["at"])[:max(0, len(entries) - self.limit)]:
            del entries[old]
        temp = self.path.with_name("%s.%d.tmp" % (self.path.name, os.getpid()))
        try:
            fd = os.open(str(temp), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            with os.fdopen(fd, "w") as handle:
                handle.write(json.dumps({"entries": entries}, sort_keys=True))
                handle.flush()
                os.fsync(handle.fileno())
            os.replace(str(temp), str(self.path))
            return True
        except OSError:
            try:
                os.unlink(str(temp))
            except OSError:
                pass
            return False


# ------------------------------------------------------------------- the reply

def policy_reply(outcome, reason, judged=False, cached=False, latency_ms=0):
    """The one JSON line `judge-tool` prints."""
    return {"outcome": outcome, "reason": _one_line(reason, 600), "judged": bool(judged),
            "cached": bool(cached), "latency_ms": int(latency_ms)}


def policy_unjudged_reason(config, request):
    """Why this call is not judged at all (a sentence), or None when it is to be judged."""
    if request["configured"] == "deny":
        return "a configured deny is final: the judge was not consulted"
    if request["tool"] in POLICY_PASS_THROUGH:
        return "not judged: a %s passes straight through" % request["tool"]
    if not config["policy"]["enabled"]:
        return "the policy judge is not enabled"
    if fault("no-policy-judge"):
        return "no-policy-judge fault: the judge is off"
    return None


def _what_text(request):
    return "%s: %s" % (request["tool"], _one_line(request["arguments"], 100))


def escalation_reason(fleet, ask, request):
    """The denial text for a call outside the ask's Intent: escalate, never argue."""
    where = " (ask #%d)" % ask if ask else ""
    route = ("Send the Chief of Staff the proposal with `%s send <chief-of-staff> --issue <n> \"...\"`" % PROG)
    if (fleet or {}).get("role") == "orchestrator":
        route += ", or label your charter awaiting-user with a Decision required section"
    return ("Denied: this call is outside the ask's Intent%s (%s). Do not retry it or work around it. Escalate: "
            "%s. Only the person you report to widens the ask." % (where, _what_text(request), route))


def tightened_reason(combined, fleet, ask, request):
    """The sentence for the outcome the judge reached, for the agent or for you."""
    fired = combined["fired"]
    if "outside_intent" in fired and combined["outcome"] in ("deny", "hard-deny"):
        return escalation_reason(fleet, ask, request)
    if fired and combined["outcome"] != "allow":
        return "Needs your yes: %s (%s)." % ("; ".join(POLICY_FIRED_TEXT[n] for n in fired if n in POLICY_FIRED_TEXT),
                                            _what_text(request))
    return "judge: nothing at its threshold; the configured outcome stands"


def policy_verdict_key(request, fleet_name, context, role):
    """A hash of everything the verdict depends on, for the cache: no text is kept."""
    parts = {"session": request["session"], "agent": fleet_name, "role": role, "ask": context["issue"],
             "intent": context["intent"], "done_when": context["done_when"], "authority": context["authority"],
             "tool": request["tool"], "arguments": request["arguments"]}
    return hashlib.sha256(_canonical(parts).encode("utf-8")).hexdigest()[:32]


def _valid_answers(value):
    answers = value.get("answers") if isinstance(value, dict) else None
    ok = isinstance(answers, dict) and set(answers) == set(POLICY_QUESTIONS) \
        and all(_is_probability(p) for p in answers.values())
    return answers if ok else None


def _valid_session_fleet(value):
    fleet = value.get("fleet") if isinstance(value, dict) else None
    return fleet if isinstance(fleet, dict) and isinstance(fleet.get("name"), str) else None


def _valid_context(value):
    keys = ("issue", "intent", "done_when", "authority")
    ok = isinstance(value, dict) and all(k in value for k in keys) \
        and all(value[k] is None or isinstance(value[k], str) for k in keys[1:]) \
        and (value["issue"] is None or _is_issue_number(value["issue"]))
    if not ok:
        return None
    context = {k: value[k] for k in keys}
    # PR 17: the charter and its orders ride along (an older cache entry has neither: they read as none)
    orders = value.get("orders")
    context["charter"] = value.get("charter") if _is_issue_number(value.get("charter")) else None
    context["charter_repo"] = value["charter_repo"] if isinstance(value.get("charter_repo"), str) \
        and REPO_RE.match(value["charter_repo"]) else None
    context["orders"] = [t for t in orders if isinstance(t, str)] if isinstance(orders, list) else []
    return context


# ------------------------------------------------------------------ the judge

class PolicyJudge:
    """Judges one tool call: who the agent is, what its ask is, what Jev says, what the code allows.

    Every collaborator is injected, so a test never reaches a real binary. The
    whole judgement runs in one worker thread against `budget_ms`: when it has
    not finished in time the configured outcome is the reply, and the worker
    is left to finish filling the caches, so the next call is fast.
    """

    def __init__(self, config, v2, reader, jev, audit, state, now=time.time, monotonic=time.monotonic, environ=None):
        self.config, self.settings = config, config["policy"]
        self.v2, self.reader, self.jev, self.audit = v2, reader, jev, audit
        self.now, self.monotonic = now, monotonic
        self.environ = os.environ if environ is None else environ
        ttl, limit = self.settings["cache_seconds"], self.settings["cache_entries"]
        self.verdicts = BoundedFileCache(Path(state) / POLICY_VERDICT_FILE, now, ttl, limit)
        self.contexts = BoundedFileCache(Path(state) / POLICY_CONTEXT_FILE, now, ttl, limit)
        self._worker = None

    # -- the whole judgement, against the budget

    def decide(self, request):
        started = self.monotonic()
        box = {"stage": "identifying the agent", "detail": {}}
        worker = threading.Thread(target=self._work, args=(request, box), daemon=True)
        worker.start()
        worker.join(self.settings["budget_ms"] / 1000.0)
        elapsed = int((self.monotonic() - started) * 1000)
        if worker.is_alive():
            self._worker = worker
            reply = policy_reply(request["configured"], "no answer within %d ms (still %s): the configured "
                                 "outcome stands" % (self.settings["budget_ms"], box["stage"]), False, False, elapsed)
        else:
            reply = box.get("reply") or policy_reply(request["configured"], "the judge failed: the configured "
                                                     "outcome stands", False, False, elapsed)
            reply["latency_ms"] = elapsed
        reply, shadow = self.shadowed(request, reply)
        self._audit(request, reply, box, shadow)
        return reply

    def shadowed(self, request, reply):
        """policy.shadow: the judge's verdict is recorded and never enforced. Returns (reply, verdict-or-None); with
        shadow on, a tightened reply becomes the configured outcome again, so nothing is ever stricter than the
        rules alone. Only a stricter outcome is a would-ask or would-deny."""
        if not self.settings.get("shadow"):
            return reply, None
        order = POLICY_REQUEST_OUTCOMES
        would, configured = reply["outcome"], request["configured"]
        if would in order and configured in order and order.index(would) > order.index(configured):
            return dict(reply, outcome=configured, reason=_one_line(
                "shadow: the judge would %s (%s); not enforced" % (would, reply["reason"]), 600)), "would-%s" % would
        return reply, ("unchanged" if reply["judged"] else None)

    def finish_late(self, seconds=POLICY_WARM_SECONDS):
        """Wait for a judgement that missed its budget to finish and fill the caches (tests use it)."""
        if self._worker is not None:
            self._worker.join(seconds)

    def _work(self, request, box):
        try:
            box["reply"] = self._judge(request, box)
        except Exception as err:  # a worker thread must never leak a traceback or die without a reply
            box["detail"]["error"] = _one_line("%s: %s" % (type(err).__name__, err), 200)
            box["reply"] = policy_reply(request["configured"], "could not judge while %s (%s): the configured "
                                        "outcome stands" % (box["stage"], _one_line(str(err), 120)))

    def _judge(self, request, box):
        fleet = self.identify(request["session"])
        if fleet is None:
            return policy_reply(request["configured"], "not a fleet agent (no metadata.fleet): not judged")
        if request["tool"] == "shell" and plain_switchboard_message(request["arguments"]):
            return policy_reply(request["configured"], "a plain %s message is the agents' own channel: not judged" % PROG)
        rule = None if fault("repo-create-allowed") or request["tool"] != "shell" \
            else repo_commissioning_rule(request["arguments"])
        if rule:  # PR 15: no model and no GitHub read stands between this call and an ask
            return self.rule_reply(request, fleet, rule, box)
        if not fault("anyone-edits-cos-orders") and writes_cos_orders(request["tool"], request["arguments"], self.config):
            return self.orders_guard_reply(request, fleet, box)  # PR 18: no model, no GitHub read
        box["stage"] = "resolving the ask"
        context = self.context_of(fleet)
        box["detail"].update(agent=fleet["name"], role=fleet.get("role"), ask=context["issue"])
        request = dict(request, arguments=self.redacted(request["arguments"]))  # from here on, nothing sees a credential
        if request["tool"] == "shell":  # PR 18: the judge's question sees what `decisions answer|resolve` acts on
            request["arguments"] += decision_gloss(self.verdicts.path.parent, request["arguments"])
        key = policy_verdict_key(request, fleet["name"], context, fleet.get("role"))
        thresholds = dict(self.settings["thresholds"])
        if context["issue"] is None:
            # With no ask there is nothing to be outside of: neither intent nor scope can fire. The
            # trial found the Chief of Staff, which has no ask by design, asked about every routine
            # `gh` and `ls`. The two consequential questions (hard to reverse, speaks for you) still do.
            thresholds["outside_intent"] = thresholds["outside_scope"] = 2.0
        guarded = self.charter_guard(request, fleet, context)
        if guarded is not None:  # PR 17: no model needed, and the cache is not asked
            answers = dict.fromkeys(POLICY_QUESTIONS)
            answers.update(hard_to_reverse=1.0, speaks_for_you=1.0)
            combined = combine_policy(answers, thresholds, request["configured"])
            combined.update(answers=answers, latency_ms=0, usage={}, model=None)
            box["detail"].update(combined=combined, cached=False, thresholds=thresholds, guard="charter-edit")
            reply = self.reply_of(combined, False, fleet, context, request)
            if combined["outcome"] != "allow":
                reply["reason"] = _one_line(
                    "Needs your yes: this edits charter #%d, the one this agent works under, and an agent must "
                    "not grant itself authority. Standing orders are the owner's, recorded by the Chief of Staff "
                    "(%s)." % (guarded, _what_text(request)), 600)
            return reply
        cached = _valid_answers(self.verdicts.get(key))
        if cached is not None:
            combined = combine_policy(cached, thresholds, request["configured"])
            combined.update(answers=cached, latency_ms=0, usage={}, model=None)
        else:
            box["stage"] = "asking the decision model"
            state = self.state_of(request, fleet, context)
            box["detail"]["state"] = state
            combined = judge_tool_call(self.jev, request["configured"], state, thresholds)
            if "answers" in combined:
                self.verdicts.put(key, {"answers": combined["answers"]})
        box["detail"].update(combined=combined, cached=cached is not None, thresholds=thresholds)
        return self.reply_of(combined, cached is not None, fleet, context, request)

    def rule_reply(self, request, fleet, rule, box):
        """`hard_to_reverse`, decided by the code: the commissioning rule (repo_commissioning_rule). Never looser
        than configured, like every judgement."""
        answers = {"hard_to_reverse": 1.0}
        thresholds = {"hard_to_reverse": 0.0}
        combined = combine_policy(answers, thresholds, request["configured"])
        combined.update(answers=answers, latency_ms=0, usage={}, model=None, rule=rule)
        box["detail"].update(agent=fleet["name"], role=fleet.get("role"), ask=None, combined=combined, cached=False,
                             thresholds=thresholds, rule=rule)
        reply = self.reply_of(combined, False, fleet, {"issue": None}, dict(request, arguments=self.redacted(request["arguments"])))
        reply["reason"] = _one_line("%s [rule: %s is hard to reverse whatever the thresholds say]" % (reply["reason"], rule), 600)
        return reply

    def orders_guard_reply(self, request, fleet, box):
        """PR 18: a shell command that writes the Chief of Staff's orders file is `speaks_for_you` and
        `hard_to_reverse`, decided by the code: an agent must not grant itself authority. Never looser than
        configured, like every judgement."""
        thresholds = dict(self.settings["thresholds"])
        answers = dict.fromkeys(POLICY_QUESTIONS)
        answers.update(hard_to_reverse=1.0, speaks_for_you=1.0)
        combined = combine_policy(answers, thresholds, request["configured"])
        combined.update(answers=answers, latency_ms=0, usage={}, model=None)
        box["detail"].update(agent=fleet["name"], role=fleet.get("role"), ask=None, combined=combined, cached=False,
                             thresholds=thresholds, guard="cos-orders-edit")
        shown = dict(request, arguments=self.redacted(request["arguments"]))
        reply = self.reply_of(combined, False, fleet, {"issue": None}, shown)
        if combined["outcome"] != "allow":
            reply["reason"] = _one_line(
                "Needs your yes: this writes the Chief of Staff's standing orders, which are the owner's alone, and "
                "an agent must not grant itself authority. The owner edits that file in an editor (%s)."
                % _what_text(shown), 600)
        return reply

    # -- the pieces

    @staticmethod
    def charter_guard(request, fleet, context):
        """PR 17: the charter number when a shell call by an agent other than the Chief of Staff edits the
        charter it works under, else None."""
        if request["tool"] != "shell" or fleet.get("role") == "chief-of-staff":
            return None
        own = fleet.get("repo") if isinstance(fleet.get("repo"), str) else None
        charters = {(context.get("charter_repo") if n == context.get("charter") else own, n)
                    for n in (context.get("charter"), fleet.get("charter")) if _is_issue_number(n)}
        return charter_edit_target(request["arguments"], charters) if charters else None

    def identify(self, session, refresh=False):
        known = None if refresh else _valid_session_fleet(self.contexts.get("session:" + session))
        if known is not None:
            return known
        fleet = _fleet_meta(self.v2.session_get(session))
        if fleet is None or not isinstance(fleet.get("name"), str):
            return None
        kept = {k: fleet[k] for k in ("name", "role", "reports_to", "issue", "charter", "repo") if k in fleet}
        self.contexts.put("session:" + session, {"fleet": kept})
        return kept

    def warm(self, session):
        """Refresh one agent's identity and ask context ahead of its next tool call. Each lookup is a
        `gh` round trip (about half a second here), and an orchestrator needs several: cold, the first
        calls ran out of budget and went through unjudged."""
        fleet = self.identify(session, refresh=True)
        if fleet is not None:
            self.context_of(fleet, refresh=True)
        return fleet

    def context_of(self, fleet, refresh=False):
        context = self.ask_context_of(fleet, refresh)
        if fleet.get("role") != "chief-of-staff" or fault("cos-orders-unfed"):
            return context
        # PR 18: the Chief of Staff has no charter; what it may decide for the owner is its own orders file. One
        # `stat` per call; the file is read again only when its mtime or size changes, and the verdict key
        # holds the text, so an edit is seen at the next call.
        try:
            text = read_cos_orders(self.config)["text"]
        except CosOrdersError:
            text = None  # a file that cannot be used is no authority at all
        return dict(context, authority=text) if text else context

    def ask_context_of(self, fleet, refresh=False):
        if self.reader is None:
            return {"issue": None, "intent": None, "done_when": None, "authority": None, "charter": None,
                    "charter_repo": None, "orders": []}
        key = "ask:%s:%s:%s" % (fleet.get("repo") or self.reader.repo, fleet.get("issue"), fleet.get("charter"))
        known = None if refresh else _valid_context(self.contexts.get(key))
        if known is not None:
            return known
        context = resolve_policy_context(self.reader, fleet)
        self.contexts.put(key, context)
        return context

    def redacted(self, text):
        return redact_command_text(text, jev_secrets(self.config, self.environ))

    def state_of(self, request, fleet, context):
        return policy_state(fleet.get("role") or "unknown", context["intent"] or "not stated: no ask is recorded",
                            context["done_when"] or "not stated", context["authority"] or NO_STANDING_AUTHORITY,
                            request["tool"], request["arguments"],
                            COS_ORDERS_STATE_CLIP if fleet.get("role") == "chief-of-staff" else None)

    def reply_of(self, combined, cached, fleet, context, request):
        outcome = combined["outcome"]
        judged = "answers" in combined
        reason = tightened_reason(combined, fleet, context["issue"], request) if judged else combined["reason"]
        return policy_reply("deny" if outcome == "hard-deny" else outcome, reason, judged, cached,
                            combined.get("latency_ms") or 0)

    def _audit(self, request, reply, box, shadow=None):
        detail, combined = box["detail"], box["detail"].get("combined") or {}
        state = dict(detail.get("state") or {})
        state["arguments"] = _one_line(state.get("arguments"), 300)
        entry = {"agent": detail.get("agent"), "role": detail.get("role"), "session": request["session"],
                 "tool": request["tool"], "configured": request["configured"], "outcome": reply["outcome"],
                 "judged": reply["judged"], "cached": reply["cached"], "reason": reply["reason"],
                 "latency_ms": reply["latency_ms"], "ask": detail.get("ask"), "fired": combined.get("fired"),
                 "answers": combined.get("answers"), "thresholds": detail.get("thresholds"),
                 "question": {"state": state, "ids": list(POLICY_QUESTIONS)} if state else None,
                 "model": combined.get("model"), "usage": combined.get("usage"), "error": detail.get("error")}
        if shadow is not None:
            entry.update(shadow=True, verdict=shadow)
        try:
            self.audit.append(POLICY_ACTOR, "policy.judge", "tool:%s:%s" % (request["session"], request["tool"]), entry)
        except OSError:
            pass  # the audit is best effort here: a full disk must not stop a tool call


def judge_request(request, config, build_judge):
    """(reply, judge): the reply for one parsed request, and the judge that made it (None when none was needed).

    `build_judge()` makes the PolicyJudge and is called only for a call that is to be judged.
    """
    why = policy_unjudged_reason(config, request)
    if why is not None:
        return policy_reply(request["configured"], why), None
    judge = build_judge()
    return judge.decide(request), judge


def build_policy_judge(config, runner, now):
    """The PolicyJudge over the configured clients: v2, the ask reader, Jev, the audit log."""
    if config["opencode"] is None:
        raise ConfigError("'opencode' is not configured: the judge cannot identify an agent without v2")
    state = ensure_state_dir()
    settings = config["policy"]
    jev_settings = dict(config["jev"], timeout_seconds=min(config["jev"]["timeout_seconds"], POLICY_WARM_SECONDS))
    jev = build_jev(dict(config, jev=jev_settings))
    v2 = V2Client(config["opencode"], config["opencode_env"], runner, min(config["call_timeout_seconds"], POLICY_WARM_SECONDS))
    return PolicyJudge(config, v2, intent_reader_for(config, runner, now), jev, AuditLog(state / "audit.jsonl"), state, now)


def make_judge_warmer(config, runner, now):
    """warm(sessions): refresh each session's judge context, errors counted and audited once, never raised."""
    def warm(sessions):
        done = failed = 0
        try:
            judge = build_policy_judge(config, runner, now)
            for session in sessions:
                try:
                    judge.warm(session)
                    done += 1
                except Exception:
                    failed += 1
            judge.audit.append(POLICY_ACTOR, "policy.warm", "judge", {"sessions": done, "failed": failed})
        except Exception as err:
            sys.stderr.write("%s: judge warm-up skipped: %s\n" % (PROG, _one_line(str(err), 120)))
    return warm


def schedule_judge_warm(engine, discovery):
    """Between passes, now and then, warm the judge for every fleet agent with a session, off the pass's
    thread. At half the cache lifetime, so a context is refreshed before it expires."""
    warm = getattr(engine, "judge_warm", None)
    if warm is None or discovery is None or engine.now() < engine._warm_due:
        return
    ttl = engine.config["policy"]["cache_seconds"] if engine.config.get("policy") else 0
    if not ttl:
        return
    engine._warm_due = engine.now() + max(15, ttl / 2)
    sessions = sorted({o.session_id for o in discovery.agents.values() if o.session_id})
    if sessions:
        threading.Thread(target=warm, args=(sessions,), daemon=True).start()


# ------------------------------------------- the judge socket: the daemon holds the key

# `judge-tool` runs inside whatever process the v2 plugin lives in, and its
# environment is the environment of every agent's shell tool. So it never
# reads the OpenRouter key, and never calls Jev: it sends the request over a
# local unix stream socket to the switchboard DAEMON, which holds the key in
# its own environment, judges, and answers with the same one JSON line. The
# daemon, not v2, holds the key.
POLICY_SOCKET = "judge.sock"
POLICY_READ_SECONDS = 2      # the daemon's wait for a request to arrive
POLICY_CLIENT_SLACK = 0.4    # seconds past the budget `judge-tool` waits for the daemon
POLICY_CONNECTIONS = 16      # judgements the daemon runs at once


class PolicyDaemonError(Exception):
    """The daemon could not be reached, or did not answer in time."""


def read_judge_line(conn, limit):
    """Bytes up to a newline or EOF, at most limit + 1 of them; times out with the socket's timeout."""
    data = b""
    while len(data) <= limit and b"\n" not in data:
        chunk = conn.recv(4096)
        if not chunk:
            break
        data += chunk
    return data


def ask_judge_daemon(state_dir, text, timeout):
    """The daemon's reply (a dict) to the request text, or PolicyDaemonError. Never reads any environment variable."""
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        sock.settimeout(timeout)
        with in_directory(state_dir):
            sock.connect(POLICY_SOCKET)
        sock.sendall(text.encode("utf-8"))
        sock.shutdown(socket.SHUT_WR)
        raw = read_judge_line(sock, POLICY_STDIN_LIMIT)
    except (socket.timeout, TimeoutError):
        raise PolicyDaemonError("the daemon did not answer in time") from None
    except OSError as err:
        raise PolicyDaemonError("the daemon is not reachable (%s)" % (err.strerror or err)) from None
    finally:
        sock.close()
    try:
        reply = json.loads(raw.decode("utf-8", "replace").splitlines()[0])
    except (ValueError, IndexError):
        raise PolicyDaemonError("the daemon's answer is not JSON") from None
    if not isinstance(reply, dict) or reply.get("outcome") not in POLICY_REQUEST_OUTCOMES:
        raise PolicyDaemonError("the daemon's answer has no usable outcome")
    return reply


def never_looser(reply, configured):
    """The reply, made no looser than `configured`: the client's own guard, as the plugin has its own."""
    if POLICY_REQUEST_OUTCOMES.index(reply["outcome"]) >= POLICY_REQUEST_OUTCOMES.index(configured):
        return policy_reply(reply["outcome"], reply.get("reason") or "", reply.get("judged"), reply.get("cached"),
                            reply.get("latency_ms") if isinstance(reply.get("latency_ms"), int) else 0)
    return policy_reply(configured, "the daemon answered looser than the configured outcome: ignored")


class JudgeServer:
    """The daemon's end of the judge socket: one request and one reply per connection.

    `handle(text)` returns the reply dict. The socket is $STATE/judge.sock, mode
    0600, a stale one replaced; every connection runs in its own thread, so a
    slow judgement never delays a pass or another judgement.
    """

    def __init__(self, state_dir, handle):
        self.state_dir, self.handle = state_dir, handle
        self.sock = self.thread = None
        self.slots = threading.BoundedSemaphore(POLICY_CONNECTIONS)
        self.stopping = threading.Event()

    def start(self):
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        before = os.umask(0o177)  # the socket is born private, not chmod-ed after anyone could connect
        try:
            with in_directory(self.state_dir):
                try:
                    os.unlink(POLICY_SOCKET)
                except FileNotFoundError:
                    pass
                sock.bind(POLICY_SOCKET)
                os.chmod(POLICY_SOCKET, 0o600)
            sock.listen(POLICY_CONNECTIONS)
            sock.settimeout(0.2)
        except BaseException:
            sock.close()
            raise
        finally:
            os.umask(before)
        self.sock = sock
        self.thread = threading.Thread(target=self._accept, daemon=True)
        self.thread.start()
        return self

    def stop(self):
        self.stopping.set()
        if self.thread is not None:
            self.thread.join(2)
        if self.sock is not None:
            self.sock.close()
            try:
                with in_directory(self.state_dir):
                    os.unlink(POLICY_SOCKET)
            except OSError:
                pass

    def _accept(self):
        while not self.stopping.is_set():
            try:
                conn, _ = self.sock.accept()
            except socket.timeout:
                continue
            except OSError:
                return
            if not self.slots.acquire(blocking=False):
                conn.close()  # too many at once: that caller keeps its configured outcome
                continue
            threading.Thread(target=self._serve, args=(conn,), daemon=True).start()

    def _serve(self, conn):
        try:
            conn.settimeout(POLICY_READ_SECONDS)
            raw = read_judge_line(conn, POLICY_STDIN_LIMIT)
            text = raw.decode("utf-8", "replace")
            if len(raw) > POLICY_STDIN_LIMIT:
                reply = policy_reply(_guess_configured(text), "unusable request (larger than %d bytes): no change"
                                     % POLICY_STDIN_LIMIT)
            else:
                reply = self.handle(text)
            conn.sendall((json.dumps(reply, sort_keys=True) + "\n").encode("utf-8"))
        except (OSError, ValueError):
            pass  # a caller that went away or sent nothing in time: nothing to answer
        finally:
            conn.close()
            self.slots.release()


def make_judge_handler(runner, now):
    """handle(text) for the daemon: parse, judge with the daemon's own key and clients, reply. Never raises."""
    def handle(text):
        try:
            request = parse_policy_request(text)
            config = load_config()  # read at each call, so an edit to `policy` takes effect without a restart
            active_faults()
            return judge_request(request, config, lambda: build_policy_judge(config, runner, now))[0]
        except PolicyRequestError as err:
            return policy_reply(_guess_configured(text), "unusable request (%s): no change" % err)
        except Exception as err:  # the judge only tightens: whatever fails, the configured outcome stands
            return policy_reply(_guess_configured(text), "the judge failed (%s: %s): the configured outcome stands"
                                % (type(err).__name__, _one_line(str(err), 120)))
    return handle


def start_judge_server(config, state, runner, now):
    """The daemon's judge socket when `policy.enabled`, else None."""
    if not config["policy"]["enabled"]:
        return None
    return JudgeServer(state, make_judge_handler(runner, now)).start()


def cmd_judge_tool(args, runner, now, stdin=None):
    """Read one request, print one JSON line, exit 0 whatever happens (invariant 9).

    Decides locally only what needs no model (a read, a configured deny, the
    judge off); everything else goes to the daemon. It reads no environment
    variable of its own accord: the key is the daemon's.
    """
    text = ""
    try:
        text = (stdin or sys.stdin).read(POLICY_STDIN_LIMIT + 1)
        if len(text) > POLICY_STDIN_LIMIT:
            raise PolicyRequestError("the request is larger than %d bytes" % POLICY_STDIN_LIMIT)
        request = parse_policy_request(text)
        config = load_config()
        active_faults()
        why = policy_unjudged_reason(config, request)
        if why is not None:
            reply = policy_reply(request["configured"], why)
        else:
            wait = config["policy"]["budget_ms"] / 1000.0 + POLICY_CLIENT_SLACK
            reply = never_looser(ask_judge_daemon(state_dir_path(), text, wait), request["configured"])
    except PolicyRequestError as err:
        reply = policy_reply(_guess_configured(text), "unusable request (%s): no change" % err)
    except PolicyDaemonError as err:
        reply = policy_reply(request["configured"], "%s: the configured outcome stands" % err)
    except Exception as err:  # nothing the judge does may stop a tool call: the configured outcome stands
        reply = policy_reply(_guess_configured(text), "the judge failed (%s: %s): the configured outcome stands"
                             % (type(err).__name__, _one_line(str(err), 120)))
    try:
        print(json.dumps(reply, sort_keys=True))
        sys.stdout.flush()
    except (OSError, ValueError):
        pass  # the plugin stopped listening
    return EXIT_OK


POLICY_LIVENESS_SECONDS = 30 * 60   # agents active and no policy.judge for this long is an alarm
POLICY_AUDIT_TAIL = 8 << 20         # bytes of the audit log's end that a report reads


def _audit_tail(state_dir):
    """The parsed entries in the last POLICY_AUDIT_TAIL bytes of audit.jsonl (a torn first line is dropped)."""
    path = Path(state_dir) / "audit.jsonl"
    try:
        with open(path, "rb") as handle:
            size = handle.seek(0, os.SEEK_END)
            handle.seek(max(0, size - POLICY_AUDIT_TAIL))
            data = handle.read()
            torn = size > POLICY_AUDIT_TAIL
    except OSError:
        return []
    lines = data.decode("utf-8", "replace").splitlines()
    out = []
    for number, line in enumerate(lines):
        if number == 0 and torn:
            continue
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        if isinstance(entry, dict):
            out.append(entry)
    return out


def _audit_epoch(entry):
    try:
        return datetime.fromisoformat(str(entry.get("ts")).replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def _percentile(sorted_values, fraction):
    """Nearest-rank percentile of an ascending list (None when empty)."""
    if not sorted_values:
        return None
    return sorted_values[max(0, min(len(sorted_values) - 1, int(math.ceil(fraction * len(sorted_values))) - 1))]


def policy_sample(state_dir, now, window_seconds=3600):
    """Summarise the policy.judge entries of the last `window_seconds`: calls, judged, would-ask, would-deny,
    outcomes actually enforced, and latency p50/p95 (ms). Reads the audit log only."""
    cutoff = now - window_seconds
    calls = judged = would_ask = would_deny = asked = denied = 0
    latencies, last = [], None
    for entry in _audit_tail(state_dir):
        if entry.get("event") != "policy.judge":
            continue
        at = _audit_epoch(entry)
        if at is None:
            continue
        last = at if last is None or at > last else last
        if at < cutoff:
            continue
        detail = entry.get("detail") or {}
        calls += 1
        judged += 1 if detail.get("judged") else 0
        verdict = detail.get("verdict")
        would_ask += verdict == "would-ask"
        would_deny += verdict == "would-deny"
        if not detail.get("shadow"):
            asked += detail.get("outcome") == "ask" and detail.get("configured") != "ask"
            denied += detail.get("outcome") == "deny" and detail.get("configured") != "deny"
        if isinstance(detail.get("latency_ms"), (int, float)):
            latencies.append(detail["latency_ms"])
    latencies.sort()
    return {"window_seconds": window_seconds, "calls": calls, "judged": judged, "would_ask": would_ask,
            "would_deny": would_deny, "tightened_ask": asked, "tightened_deny": denied,
            "latency_p50_ms": _percentile(latencies, 0.5), "latency_p95_ms": _percentile(latencies, 0.95),
            "last_judged_age_seconds": None if last is None else max(0, int(now - last))}


def policy_liveness(config, state_dir, active_agents, now):
    """{state: off|ok|idle|ALARM, line}: the judge must have judged something in the last 30 minutes whenever an
    agent is working. Silence with nobody working is fine; silence with agents working means the plugin is not
    forwarding (the service lacks FLEET_SWITCHBOARD_BIN) and nothing is being judged."""
    if not (config or {}).get("policy", {}).get("enabled"):
        return {"state": "off", "alarm": False, "line": "policy judge  off (policy.enabled is false)"}
    sample = policy_sample(state_dir, now, POLICY_LIVENESS_SECONDS)
    mode = "shadow" if config["policy"].get("shadow") else "enforcing"
    age = sample["last_judged_age_seconds"]
    if sample["calls"]:
        return {"state": "ok", "alarm": False, "sample": sample,
                "line": "policy judge  %s, %d call(s) judged in the last 30 min" % (mode, sample["calls"])}
    seen = "no policy.judge entry yet" if age is None else "last policy.judge %s ago" % format_age(age)
    if active_agents:
        return {"state": "ALARM", "alarm": True, "sample": sample,
                "line": "policy judge  ALARM: %d agent(s) working and no policy.judge in 30 min (%s); the fleet-hooks "
                        "plugin is probably not forwarding (is FLEET_SWITCHBOARD_BIN resolvable?)" % (active_agents, seen)}
    return {"state": "idle", "alarm": False, "sample": sample, "line": "policy judge  %s; no agent working (%s)" % (mode, seen)}


def cmd_policy_report(args, runner, now):
    """`policy-report`: a sample of the judge's work, or with --check its liveness (exit 1 on an alarm)."""
    config = load_config()
    state = state_dir_path()
    if args.check:
        report = collect_status(runner, now)
        result = report.get("policy") or {"state": "unknown", "alarm": False, "line": "policy judge  unknown"}
        if args.json:
            print(json.dumps(result, sort_keys=True))
        else:
            print(result["line"])
        return EXIT_ERROR if result["alarm"] else EXIT_OK
    sample = policy_sample(state, now(), int(args.minutes * 60))
    sample["shadow"] = bool(config["policy"].get("shadow"))
    if args.json:
        print(json.dumps(sample, sort_keys=True))
        return EXIT_OK
    p50, p95 = sample["latency_p50_ms"], sample["latency_p95_ms"]
    print("policy judge, last %g min (%s)" % (args.minutes, "shadow: recorded, not enforced" if sample["shadow"]
                                            else "enforcing"))
    print("  calls judged   %d (%d reached the model or a rule)" % (sample["calls"], sample["judged"]))
    print("  would-ask      %d    would-deny  %d   (shadow verdicts)" % (sample["would_ask"], sample["would_deny"]))
    print("  enforced       %d ask, %d deny" % (sample["tightened_ask"], sample["tightened_deny"]))
    print("  latency        p50 %s ms, p95 %s ms" % ("-" if p50 is None else p50, "-" if p95 is None else p95))
    return EXIT_OK


POLICY_COMMANDS = {"judge-tool": cmd_judge_tool}


def add_policy_parsers(sub):
    report = sub.add_parser("policy-report", help="Summarise the judge's recent work from the audit log: calls, "
                                                   "would-ask/would-deny, latency p50/p95; --check is its liveness")
    report.add_argument("--minutes", type=float, default=60, help="The window to sample (default 60)")
    report.add_argument("--json", action="store_true")
    report.add_argument("--check", action="store_true", help="Liveness: exit 1 when agents are working and nothing "
                                                             "was judged for 30 minutes")
    sub.add_parser("judge-tool", help="Judge one tool call: JSON on stdin, one JSON line out, exit 0 "
                                      "(the fleet-hooks plugin runs this; the judge only tightens)")
# PR 10: move a v1 session into v2 (`import-v1`)
#
# One section, so the stack rebases cleanly. docs/switchboard.md, "v1
# sessions: Imported, not restarted"; docs/switchboard-cutover.md is the
# runbook. Registered in six places: `DEFAULTS` (below), `validate_config`
# (`validate_v1_move_config`), `KNOWN_FAULTS` (`no-import-metadata`),
# `V2Client._call` (`envelope`, so a page keeps its cursor), `build_parser`
# (`add_v1_move_parsers`) and `main` (`V1_MOVE_COMMANDS`).
#
# Three parts: a pure converter (v1's `opencode export` JSON -> v2's
# Session.Info and messages), a checker for the v2 shapes the converter emits,
# and the command. The v1 session is only ever read (`export`), never touched.
# ============================================================================
V1_MOVE_DEFAULTS = {
    # The OpenCode v1 binary, by absolute path; the only thing it is ever asked is
    # `export <session>`. No default: a bare name would be resolved through PATH.
    "v1_opencode": None,
    # `opencode api` takes its JSON inline, so a whole transcript travels in one
    # argument. Longer than this is refused, not cut: see --tool-output-limit.
    "import_body_limit_bytes": 120000,
}
DEFAULTS.update(V1_MOVE_DEFAULTS)

V1_EXPORT_TIMEOUT = 120      # seconds `opencode export` may take
V1_ID_RE = re.compile(r"^ses_[A-Za-z0-9]+$")
V1_LIST_PAGE = 100           # sessions per page when looking for an earlier import
V1_LIST_MAX_PAGES = 500      # beyond this the search is incomplete, and we refuse
V1_FINISH = ("stop", "length", "tool-calls", "content-filter", "error", "unknown")
V1_TOOL_NAMES = {"bash": "shell"}  # v1's tool names that v2 spells differently (measured: v2's is `shell`)
V1_AUDIT_EXAMPLES = 50       # dropped items named one by one in the audit; the rest are counted


class ImportV1Error(Exception):
    """An import that cannot go ahead, and why. Nothing was written to v2."""


def validate_v1_move_config(config, source):
    v1, v2 = config["v1_opencode"], config["opencode"]
    if v1 is not None:
        if not isinstance(v1, str) or not os.path.isabs(v1):
            raise ConfigError("%s: 'v1_opencode' must be the absolute path of the OpenCode v1 binary, got %r"
                              % (source, v1))
        if v2 is not None and os.path.realpath(v1) == os.path.realpath(v2):
            raise ConfigError("%s: 'v1_opencode' and 'opencode' name the same binary; they must be the v1 "
                              "and the v2 programs" % source)
    limit = config["import_body_limit_bytes"]
    if isinstance(limit, bool) or not isinstance(limit, int) or limit < 1000:
        raise ConfigError("%s: 'import_body_limit_bytes' must be an integer of at least 1000, got %r"
                          % (source, limit))


# ------------------------------------------------------------ v2 client calls

def _v2_session_import(self, info, messages, location=None):
    """POST experimental.session.import. The caller has checked the shapes."""
    if not isinstance(info, dict) or not str(info.get("id", "")).startswith("ses"):
        raise ValueError("info.id must start with ses: %r" % (info.get("id") if isinstance(info, dict) else info))
    if not isinstance(messages, list):
        raise ValueError("messages must be a list")
    data = {"info": info, "messages": messages}
    if location is not None:
        data["location"] = location
    return self._call("experimental.session.import", data=data)


def _v2_session_list_page(self, directory=None, cursor=None, limit=V1_LIST_PAGE):
    """One page of session.list: (sessions, cursor of the next page or None)."""
    body = self._call("session.list", {"limit": limit, "directory": directory, "cursor": cursor}, envelope=True)
    if not isinstance(body, dict) or not isinstance(body.get("data"), list):
        raise V2Error("bad_json", None, "session.list returned no data list")
    following = (body.get("cursor") or {}).get("next")
    return body["data"], following if isinstance(following, str) and following else None


V2Client.session_import = _v2_session_import
V2Client.session_list_page = _v2_session_list_page


# ------------------------------------------------------- the shapes we emit
#
# The subset of v2's schemas (Session.Info, Session.Message.User and
# .Assistant, their parts) that the converter writes, as JSON-schema-like
# dicts, and a checker small enough to read. v2 refuses a body that does not
# match; checking first means a bad conversion never reaches it.

def _shape(properties, required=()):
    return {"type": "object", "properties": properties, "required": list(required),
            "additionalProperties": False}


_S_STR, _S_NUM = {"type": "string"}, {"type": "number"}
_S_BOOL, _S_ANY_OBJECT = {"type": "boolean"}, {"type": "object"}
_S_BASE64 = {"type": "string", "pattern": r"^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"}
_S_MENTION = _shape({"start": _S_NUM, "end": _S_NUM, "text": _S_STR}, ("start", "end", "text"))
_S_MODEL = _shape({"id": _S_STR, "providerID": _S_STR, "variant": _S_STR}, ("id", "providerID"))
_S_TOKENS = _shape({"input": _S_NUM, "output": _S_NUM, "reasoning": _S_NUM,
                    "cache": _shape({"read": _S_NUM, "write": _S_NUM}, ("read", "write"))},
                   ("input", "output", "reasoning", "cache"))
_S_ERROR = _shape({"type": _S_STR, "message": _S_STR, "status": {"type": "integer", "minimum": 100},
                   "response": _shape({"body": _S_STR}, ("body",))}, ("type", "message"))
_S_TOOL_CONTENT = {"anyOf": [
    _shape({"type": {"enum": ["text"]}, "text": _S_STR}, ("type", "text")),
    _shape({"type": {"enum": ["file"]}, "uri": _S_STR, "mime": _S_STR,
            "name": {"anyOf": [_S_STR, {"type": "null"}]}}, ("type", "uri", "mime"))]}
_S_TOOL_STATE = {"anyOf": [
    _shape({"status": {"enum": ["streaming"]}, "input": _S_STR}, ("status", "input")),
    _shape({"status": {"enum": ["running"]}, "input": _S_ANY_OBJECT, "metadata": _S_ANY_OBJECT},
           ("status", "input", "metadata")),
    _shape({"status": {"enum": ["completed"]}, "input": _S_ANY_OBJECT, "content": {"type": "array", "items": _S_TOOL_CONTENT},
            "metadata": _S_ANY_OBJECT}, ("status", "input", "content")),
    _shape({"status": {"enum": ["error"]}, "input": _S_ANY_OBJECT, "error": _S_ERROR,
            "content": {"type": "array", "items": _S_TOOL_CONTENT}, "metadata": _S_ANY_OBJECT},
           ("status", "input", "error"))]}
_S_CONTENT = {"anyOf": [
    _shape({"type": {"enum": ["text"]}, "text": _S_STR}, ("type", "text")),
    _shape({"type": {"enum": ["reasoning"]}, "text": _S_STR,
            "time": _shape({"created": _S_NUM, "completed": _S_NUM}, ("created",))}, ("type", "text")),
    _shape({"type": {"enum": ["tool"]}, "id": _S_STR, "name": _S_STR, "executed": _S_BOOL, "state": _S_TOOL_STATE,
            "time": _shape({"created": _S_NUM, "ran": _S_NUM, "completed": _S_NUM}, ("created",))},
           ("type", "id", "name", "state", "time"))]}
_S_MSG_ID = {"type": "string", "pattern": r"^msg_"}
_S_USER = _shape({
    "id": _S_MSG_ID, "metadata": _S_ANY_OBJECT, "time": _shape({"created": _S_NUM}, ("created",)),
    "text": _S_STR, "type": {"enum": ["user"]},
    "files": {"type": "array", "items": _shape({
        "data": _S_BASE64, "mime": _S_STR, "name": _S_STR, "description": _S_STR, "mention": _S_MENTION,
        "source": {"anyOf": [_shape({"type": {"enum": ["inline"]}}, ("type",)),
                             _shape({"type": {"enum": ["uri"]}, "uri": _S_STR}, ("type", "uri"))]}},
        ("data", "mime", "source"))},
    "agents": {"type": "array", "items": _shape({"name": _S_STR, "mention": _S_MENTION}, ("name",))},
}, ("id", "time", "text", "type"))
_S_ASSISTANT = _shape({
    "id": _S_MSG_ID, "metadata": _S_ANY_OBJECT, "type": {"enum": ["assistant"]},
    "time": _shape({"created": _S_NUM, "streamed": _S_NUM, "completed": _S_NUM}, ("created",)),
    "agent": _S_STR, "model": _S_MODEL, "content": {"type": "array", "items": _S_CONTENT},
    "snapshot": _shape({"start": _S_STR, "end": _S_STR, "files": {"type": "array", "items": _S_STR}}),
    "finish": {"enum": list(V1_FINISH)}, "rawFinish": _S_STR, "cost": _S_NUM, "tokens": _S_TOKENS,
    "error": _S_ERROR,
    "retry": _shape({"attempt": {"type": "integer"}, "at": _S_NUM, "error": _S_ERROR}, ("attempt", "at", "error")),
}, ("id", "time", "type", "agent", "model", "content"))
V2_IMPORT_INFO_SCHEMA = _shape({
    "id": {"type": "string", "pattern": r"^ses"}, "parentID": {"type": "string", "pattern": r"^ses"},
    "projectID": _S_STR, "agent": _S_STR, "model": _S_MODEL, "cost": _S_NUM, "tokens": _S_TOKENS,
    "time": _shape({"created": _S_NUM, "updated": _S_NUM, "idle": _S_NUM, "viewed": _S_NUM, "archived": _S_NUM},
                   ("created", "updated")),
    "title": _S_STR, "metadata": _S_ANY_OBJECT, "location": _shape({"directory": _S_STR}, ("directory",)),
}, ("id", "projectID", "cost", "tokens", "time", "location"))
V2_IMPORT_MESSAGE_SCHEMA = {"anyOf": [_S_USER, _S_ASSISTANT]}
V2_IMPORT_SCHEMA = _shape({
    "info": V2_IMPORT_INFO_SCHEMA, "messages": {"type": "array", "items": V2_IMPORT_MESSAGE_SCHEMA},
    "location": _shape({"directory": _S_STR}, ("directory",)),
}, ("info", "messages"))

_SCHEMA_TYPES = {"object": lambda v: isinstance(v, dict), "array": lambda v: isinstance(v, list),
                 "string": lambda v: isinstance(v, str), "boolean": lambda v: isinstance(v, bool),
                 "number": lambda v: _is_number(v) and v == v and v not in (float("inf"), float("-inf")),
                 "integer": lambda v: isinstance(v, int) and not isinstance(v, bool), "null": lambda v: v is None}


def _discriminator(branch):
    """(field, value) when a branch of a union pins one field to one value."""
    for field, rule in (branch.get("properties") or {}).items():
        if isinstance(rule, dict) and len(rule.get("enum", ())) == 1:
            yield field, rule["enum"][0]


def _union_errors(value, schema, path):
    """Errors of a union: of the one branch the value's own tag selects, else of none matching."""
    branches, failures = schema["anyOf"], []
    for branch in branches:
        errors = schema_errors(value, branch, path)
        if not errors:
            return []
        if isinstance(value, dict) and any(value.get(f) == v for f, v in _discriminator(branch)):
            return errors
        failures.append(errors[0])
    return ["%s: matches none of the %d allowed shapes (%s)" % (path, len(branches), "; ".join(failures[:2]))]


def schema_errors(value, schema, path="$"):
    """What is wrong with `value` against `schema` (the subset used above); [] when nothing."""
    if "anyOf" in schema:
        return _union_errors(value, schema, path)
    if "enum" in schema:
        return [] if value in schema["enum"] else ["%s: %r is not one of %s" % (path, value, schema["enum"])]
    expected = schema.get("type")
    if expected and not _SCHEMA_TYPES[expected](value):
        return ["%s: expected %s, got %s" % (path, expected, _one_line(repr(value), 40))]
    errors = []
    if "pattern" in schema and not re.search(schema["pattern"], value):
        errors.append("%s: %s does not match %s" % (path, _one_line(repr(value), 40), schema["pattern"]))
    if "minimum" in schema and value < schema["minimum"]:
        errors.append("%s: %r is below %r" % (path, value, schema["minimum"]))
    if expected == "array":
        for index, item in enumerate(value):
            errors.extend(schema_errors(item, schema["items"], "%s[%d]" % (path, index)))
    if expected == "object":
        errors.extend(_object_errors(value, schema, path))
    return errors


def _object_errors(value, schema, path):
    errors = ["%s.%s: required" % (path, name) for name in schema.get("required", ()) if name not in value]
    properties = schema.get("properties")
    for name, item in sorted(value.items()):
        if properties is None:
            continue
        if name not in properties:
            errors.append("%s.%s: not a field v2 accepts here" % (path, name))
        else:
            errors.extend(schema_errors(item, properties[name], "%s.%s" % (path, name)))
    return errors


def v2_import_problems(info, messages, location=None):
    """Everything v2 would refuse in this body, found before anything is sent."""
    body = {"info": info, "messages": messages}
    if location is not None:
        body["location"] = location
    try:
        json.dumps(body, allow_nan=False)
    except (TypeError, ValueError) as err:
        return ["body is not plain JSON: %s" % err]
    problems = schema_errors(body, V2_IMPORT_SCHEMA)
    ids = [m.get("id") for m in messages if isinstance(m, dict)]
    problems.extend("messages: id %s is used twice" % i for i in sorted({i for i in ids if ids.count(i) > 1}))
    return problems


# ------------------------------------------------------------- the converter
#
# v1's `opencode export` prints {info, messages: [{info, parts: [...]}]}. v2
# has no parts: a user message carries its text and attachments, an assistant
# message carries an ordered `content` list. One v1 message becomes exactly one
# v2 message, so the count and the order survive. What v2 has no place for is
# never lost quietly: it goes into `dropped`, which the command prints and
# audits; what v2 requires and v1 did not say is filled in and listed in
# `defaulted`.
import base64
from urllib.parse import unquote_to_bytes


def v1_target_id(prefix, v1_session, v1_id="", position=0):
    """A v2 id from a v1 one, the same on every run (so a retry is the same import).

    26 hex digits like the ids this tool already makes. A message id starts with
    its position in the transcript, so sorting by id keeps v1's order whichever
    way v2 lists them.
    """
    digest = hashlib.sha256(json.dumps(["v1-import", prefix, v1_session, v1_id],
                                       separators=(",", ":")).encode("utf-8")).hexdigest()
    return prefix + "_" + (format(position, "012x") + digest[:14] if prefix == "msg" else digest[:26])


def _need(condition, what):
    if not condition:
        raise ImportV1Error("not a usable v1 export: " + what)


def _created_ms(time, what):
    created = time.get("created") if isinstance(time, dict) else None
    _need(_is_number(created) and created >= 0, "%s has no numeric time.created" % what)
    return created


class V1Tally:
    """What the conversion dropped or had to fill in."""

    def __init__(self):
        self.dropped, self.defaulted = [], []

    def drop(self, message, part, kind, reason):
        part_id = part.get("id") if isinstance(part, dict) else None
        self.dropped.append({"message": message, "part": part_id, "kind": kind, "reason": reason})

    def default(self, message, field, value, reason):
        self.defaulted.append({"message": message, "field": field, "value": value, "reason": reason})


def _mention_of(box):
    """v1's {value, start, end} as v2's mention, or None."""
    if isinstance(box, dict) and isinstance(box.get("value"), str) and _is_number(box.get("start")) \
            and _is_number(box.get("end")):
        return {"start": box["start"], "end": box["end"], "text": box["value"]}
    return None


def _mention(source):
    """The mention of a v1 file part's `source` (its `text` holds the span)."""
    return _mention_of(source.get("text") if isinstance(source, dict) else None)


def _data_url(url):
    """The base64 data of a `data:` URL, else None."""
    match = re.match(r"^data:[^;,]*((?:;[^;,]*)*),(.*)$", url, re.DOTALL)
    if not match:
        return None
    if ";base64" in match.group(1):
        return match.group(2)
    return base64.b64encode(unquote_to_bytes(match.group(2))).decode("ascii")


def _file_attachment(part, message, tally):
    url, mime = part.get("url"), part.get("mime")
    if not isinstance(url, str) or not isinstance(mime, str):
        tally.drop(message, part, "file", "a file part without a url and a mime type")
        return None
    attachment = {"mime": mime}
    inline = _data_url(url)
    if inline is not None:
        attachment["data"], attachment["source"] = inline, {"type": "inline"}
    else:
        attachment["data"], attachment["source"] = "", {"type": "uri", "uri": url}
        tally.default(message, "file.data", "", "contents of %s are not embedded: the reference is kept" % url)
    if isinstance(part.get("filename"), str):
        attachment["name"] = part["filename"]
    mention = _mention(part.get("source"))
    if mention:
        attachment["mention"] = mention
    elif part.get("source"):
        tally.drop(message, part, "file-source", "v1's file source (path, range) has no v2 equivalent")
    return attachment


def _agent_attachment(part):
    attachment = {"name": part["name"]}
    mention = _mention_of(part.get("source"))
    if mention:
        attachment["mention"] = mention
    return attachment


def _is_typed_text(part):
    return part.get("type") == "text" and isinstance(part.get("text"), str) \
        and not part.get("synthetic") and not part.get("ignored")


def _user_part(part, message, tally, sink):
    """Sort one part of a v1 user message into `sink` (texts, files, agents) or the dropped list."""
    kind = part.get("type") if isinstance(part, dict) else None
    if not isinstance(part, dict):
        tally.drop(message, None, "unreadable", "a part that is not an object")
    elif _is_typed_text(part):
        sink["texts"].append(part["text"])
    elif kind == "text" and part.get("synthetic"):
        tally.drop(message, part, "synthetic-text",
                   "text v1 injected, not typed; a v2 user message holds only what was typed")
    elif kind == "text":
        tally.drop(message, part, "ignored-text", "text v1 kept out of the model's context")
    elif kind == "file":
        attachment = _file_attachment(part, message, tally)
        if attachment:
            sink["files"].append(attachment)
    elif kind == "agent" and isinstance(part.get("name"), str):
        sink["agents"].append(_agent_attachment(part))
    else:
        tally.drop(message, part, str(kind), "no place for this part in a v2 user message")


def convert_v1_user(message, tally):
    info = message["info"]
    sink = {"texts": [], "files": [], "agents": []}
    for part in message["parts"]:
        _user_part(part, info["id"], tally, sink)
    out = {"type": "user", "time": {"created": _created_ms(info.get("time"), "message " + info["id"])},
           "text": "\n\n".join(sink["texts"])}
    for field in ("files", "agents"):
        if sink[field]:
            out[field] = sink[field]
    return out


# ---- assistant messages

def _structured_error(error):
    """v1's {name, data: {message}} (or a bare string) as v2's {type, message}."""
    if isinstance(error, dict):
        data = error.get("data") if isinstance(error.get("data"), dict) else {}
        name = error.get("name") if isinstance(error.get("name"), str) else "error"
        return {"type": name, "message": data["message"] if isinstance(data.get("message"), str) else name}
    return {"type": "error", "message": str(error)}


def _tool_contents(state, limit, message, tally):
    content = []
    output = state.get("output")
    if isinstance(output, str) and output:
        if limit is not None and len(output) > limit:
            tally.default(message, "tool.output", output[:limit],
                          "tool output cut from %d to %d characters (--tool-output-limit)" % (len(output), limit))
            output = output[:limit]
        content.append({"type": "text", "text": output})
    for attachment in state.get("attachments") or ():
        if isinstance(attachment, dict) and isinstance(attachment.get("url"), str):
            item = {"type": "file", "uri": attachment["url"], "mime": attachment.get("mime") or "application/octet-stream"}
            if isinstance(attachment.get("filename"), str):
                item["name"] = attachment["filename"]
            content.append(item)
    return content


def _tool_state(state, limit, message, tally):
    """v1's pending/running/completed/error as v2's streaming/running/completed/error."""
    status, given = state.get("status"), state.get("input")
    if not isinstance(given, dict):
        given = {}
    metadata = dict(state["metadata"]) if isinstance(state.get("metadata"), dict) else {}
    if isinstance(state.get("title"), str) and "title" not in metadata:
        metadata["title"] = state["title"]
    if status == "pending":
        return {"status": "streaming", "input": state["raw"] if isinstance(state.get("raw"), str) else ""}
    if status == "running":
        return {"status": "running", "input": given, "metadata": metadata}
    if status == "completed":
        out = {"status": "completed", "input": given, "content": _tool_contents(state, limit, message, tally)}
    elif status == "error":
        out = {"status": "error", "input": given, "error": _structured_error(state.get("error", "error"))}
    else:
        return None
    if metadata:
        out["metadata"] = metadata
    return out


def _tool_part(part, created, limit, message, tally):
    state = part.get("state") if isinstance(part.get("state"), dict) else {}
    converted = _tool_state(state, limit, message, tally)
    if converted is None or not isinstance(part.get("tool"), str) or not isinstance(part.get("callID"), str):
        tally.drop(message, part, "tool", "a tool call v1 recorded without a name, id or known state")
        return None
    span = state.get("time") if isinstance(state.get("time"), dict) else {}
    time = {"created": span["start"] if _is_number(span.get("start")) else created}
    if _is_number(span.get("start")):
        time["ran"] = span["start"]
    if _is_number(span.get("end")):
        time["completed"] = span["end"]
    if part.get("metadata"):
        tally.drop(message, part, "tool-metadata", "provider metadata on a tool call has no v2 equivalent")
    return {"type": "tool", "id": part["callID"], "name": V1_TOOL_NAMES.get(part["tool"], part["tool"]),
            "state": converted, "time": time}


def _reasoning_part(part, created):
    out = {"type": "reasoning", "text": part["text"]}
    span = part.get("time") if isinstance(part.get("time"), dict) else {}
    if _is_number(span.get("start")):
        out["time"] = {"created": span["start"]}
        if _is_number(span.get("end")):
            out["time"]["completed"] = span["end"]
    return out


class V1Assistant:
    """Collects one assistant message: its content, and the snapshot its markers imply."""

    def __init__(self, message, limit, tally):
        self.info, self.parts, self.limit, self.tally = message["info"], message["parts"], limit, tally
        self.content, self.snapshot, self.retry = [], {}, None
        self.created = _created_ms(self.info.get("time"), "message " + self.info["id"])

    def run(self):
        for part in self.parts:
            self.take(part)
        return self.result()

    def take(self, part):
        kind = part.get("type") if isinstance(part, dict) else None
        handler = getattr(self, "part_" + re.sub(r"\W", "_", str(kind)), None)
        if not isinstance(part, dict):
            self.tally.drop(self.info["id"], None, "unreadable", "a part that is not an object")
        elif handler is None:
            self.tally.drop(self.info["id"], part, "unknown:%s" % kind, "a part kind this converter does not know")
        else:
            handler(part)

    def part_text(self, part):
        if not isinstance(part.get("text"), str):
            self.tally.drop(self.info["id"], part, "text", "a text part without text")
        elif part.get("synthetic") or part.get("ignored"):
            self.tally.drop(self.info["id"], part, "synthetic-text" if part.get("synthetic") else "ignored-text",
                            "text kept out of the model's context, or injected, in v1")
        else:
            self.content.append({"type": "text", "text": part["text"]})

    def part_reasoning(self, part):
        if isinstance(part.get("text"), str):
            self.content.append(_reasoning_part(part, self.created))
        else:
            self.tally.drop(self.info["id"], part, "reasoning", "a reasoning part without text")

    def part_tool(self, part):
        item = _tool_part(part, self.created, self.limit, self.info["id"], self.tally)
        if item:
            self.content.append(item)

    def part_step_start(self, part):
        if isinstance(part.get("snapshot"), str) and "start" not in self.snapshot:
            self.snapshot["start"] = part["snapshot"]
        self.tally.drop(self.info["id"], part, "step-marker", "v2 has no step markers (a snapshot hash, if any, is kept)")

    def part_step_finish(self, part):
        if isinstance(part.get("snapshot"), str):
            self.snapshot["end"] = part["snapshot"]
        self.tally.drop(self.info["id"], part, "step-marker", "v2 has no step markers (a snapshot hash, if any, is kept)")

    def part_patch(self, part):
        files = [f for f in part.get("files") or () if isinstance(f, str)]
        self.snapshot["files"] = sorted(set(self.snapshot.get("files", [])) | set(files))

    def part_retry(self, part):
        span = part.get("time") if isinstance(part.get("time"), dict) else {}
        if _is_number(part.get("attempt")) and _is_number(span.get("created")):
            self.retry = {"attempt": int(part["attempt"]), "at": span["created"], "error": _structured_error(part.get("error"))}
        else:
            self.tally.drop(self.info["id"], part, "retry", "a retry record without an attempt and a time")

    def part_snapshot(self, part):
        self.tally.drop(self.info["id"], part, "snapshot", "a bare snapshot part has no v2 equivalent")

    def part_file(self, part):
        self.tally.drop(self.info["id"], part, "file", "a file part inside an assistant message has no v2 equivalent")

    def part_agent(self, part):
        self.tally.drop(self.info["id"], part, "agent", "an agent mention has no v2 equivalent in an assistant message")

    def part_subtask(self, part):
        self.tally.drop(self.info["id"], part, "subtask", "a subtask request has no v2 equivalent here; the child session is its own import")

    def part_compaction(self, part):
        self.tally.drop(self.info["id"], part, "compaction", "a compaction marker has no v2 equivalent that keeps one message per message")

    def agent_and_model(self):
        info, mid = self.info, self.info["id"]
        agent = info.get("agent") if isinstance(info.get("agent"), str) else info.get("mode")
        if not isinstance(agent, str) or not agent:
            agent = "build"
            self.tally.default(mid, "agent", agent, "v1 recorded no agent for this message")
        model = {"id": info.get("modelID"), "providerID": info.get("providerID")}
        if not (isinstance(model["id"], str) and isinstance(model["providerID"], str)):
            model = {"id": "unknown", "providerID": "unknown"}
            self.tally.default(mid, "model", model, "v1 recorded no model for this message")
        return agent, model

    def result(self):
        info = self.info
        agent, model = self.agent_and_model()
        out = {"type": "assistant", "time": {"created": self.created}, "agent": agent, "model": model,
               "content": self.content}
        if _is_number((info.get("time") or {}).get("completed")):
            out["time"]["completed"] = info["time"]["completed"]
        if self.snapshot:
            out["snapshot"] = self.snapshot
        if isinstance(info.get("finish"), str):
            out["finish"] = info["finish"] if info["finish"] in V1_FINISH else "unknown"
            if out["finish"] != info["finish"]:
                out["rawFinish"] = info["finish"]
        if _is_number(info.get("cost")):
            out["cost"] = info["cost"]
        tokens = v1_tokens(info.get("tokens"))
        if tokens:
            out["tokens"] = tokens
        if info.get("error"):
            out["error"] = _structured_error(info["error"])
        if self.retry:
            out["retry"] = self.retry
        return out


def v1_tokens(raw):
    """v1's token counts as v2's, or None when v1 did not record them all."""
    cache = raw.get("cache") if isinstance(raw, dict) and isinstance(raw.get("cache"), dict) else None
    fields = [raw.get(n) for n in ("input", "output", "reasoning")] if cache is not None else []
    if cache is None or not all(_is_number(v) for v in fields + [cache.get("read"), cache.get("write")]):
        return None
    return {"input": fields[0], "output": fields[1], "reasoning": fields[2],
            "cache": {"read": cache["read"], "write": cache["write"]}}


def convert_v1_assistant(message, limit, tally):
    return V1Assistant(message, limit, tally).run()


# ---- the whole session

def _checked_v1_export(export, directory=None):
    _need(isinstance(export, dict) and isinstance(export.get("info"), dict)
          and isinstance(export.get("messages"), list), "expected an object with `info` and `messages`")
    info = export["info"]
    _need(isinstance(info.get("id"), str) and V1_ID_RE.match(info["id"]), "info.id must look like ses_...")
    _need(directory is not None or (isinstance(info.get("directory"), str) and os.path.isabs(info["directory"])),
          "info.directory must be an absolute path (v2 needs a location); or pass --dir")
    for index, message in enumerate(export["messages"]):
        where = "messages[%d]" % index
        _need(isinstance(message, dict) and isinstance(message.get("info"), dict)
              and isinstance(message.get("parts"), list), "%s needs `info` and `parts`" % where)
        _need(isinstance(message["info"].get("id"), str) and message["info"]["id"], "%s.info.id is missing" % where)
        _need(message["info"].get("role") in ("user", "assistant"),
              "%s has role %r; only user and assistant convert" % (where, message["info"].get("role")))
    return info


def _session_totals(messages):
    cost, tokens = 0, {"input": 0, "output": 0, "reasoning": 0, "cache": {"read": 0, "write": 0}}
    for message in messages:
        cost += message.get("cost", 0)
        used = message.get("tokens")
        if used:
            for name in ("input", "output", "reasoning"):
                tokens[name] += used[name]
            tokens["cache"]["read"] += used["cache"]["read"]
            tokens["cache"]["write"] += used["cache"]["write"]
    return cost, tokens


def _v2_session_info(v1, messages, v2_id, fleet, directory=None):
    cost, tokens = _session_totals(messages)
    stamps = [m["time"]["created"] for m in messages]
    time = v1.get("time") if isinstance(v1.get("time"), dict) else {}
    created = _created_ms(time, "info")
    info = {"id": v2_id, "projectID": v1["projectID"] if isinstance(v1.get("projectID"), str) else "global",
            "cost": cost, "tokens": tokens, "location": {"directory": directory or v1["directory"]},
            "time": {"created": created,
                     "updated": max([time["updated"] if _is_number(time.get("updated")) else created] + stamps)}}
    if isinstance(v1.get("title"), str):
        info["title"] = v1["title"]
    if isinstance(v1.get("parentID"), str) and V1_ID_RE.match(v1["parentID"]):
        info["parentID"] = v1_target_id("ses", v1["parentID"])
    assistants = [m for m in messages if m["type"] == "assistant"]
    if assistants:
        info["agent"], info["model"] = assistants[-1]["agent"], assistants[-1]["model"]
    if fleet is not None and not fault("no-import-metadata"):
        info["metadata"] = {"fleet": dict(fleet, imported_from="v1:" + v1["id"])}
    return info


def convert_v1_export(export, fleet=None, tool_output_limit=None, directory=None):
    """v1's export as {info, messages, dropped, defaulted, v1_session, v2_session}.

    Pure: nothing is read or written. `fleet` is the agent's metadata.fleet
    (name, role, ...); the converter adds `imported_from`. Raises ImportV1Error
    for an export it cannot trust to keep the count (an unknown role, no ids).
    """
    v1 = _checked_v1_export(export, directory)
    tally, messages = V1Tally(), []
    for position, message in enumerate(export["messages"]):
        converted = (convert_v1_user(message, tally) if message["info"]["role"] == "user"
                     else convert_v1_assistant(message, tool_output_limit, tally))
        converted["id"] = v1_target_id("msg", v1["id"], message["info"]["id"], position)
        messages.append(converted)
    v2_id = v1_target_id("ses", v1["id"])
    return {"v1_session": v1["id"], "v2_session": v2_id, "messages": messages, "dropped": tally.dropped,
            "defaulted": tally.defaulted, "info": _v2_session_info(v1, messages, v2_id, fleet, directory)}


def import_order(exports):
    """The exports with every parent before its children (v2 refuses a child first).

    A parent that is not among the exports is assumed to exist already.
    """
    ids = {e["info"]["id"] for e in exports}
    ordered, placed = [], set()
    pending = list(exports)
    while pending:
        ready = [e for e in pending if e["info"].get("parentID") not in ids or e["info"]["parentID"] in placed]
        if not ready:
            raise ImportV1Error("the sessions' parents form a cycle: " + ", ".join(e["info"]["id"] for e in pending))
        for export in ready:
            ordered.append(export)
            placed.add(export["info"]["id"])
            pending.remove(export)
    return ordered


def summarise_dropped(dropped):
    """[{kind, reason, count}] from the dropped list, most numerous first."""
    counts = {}
    for item in dropped:
        counts[(item["kind"], item["reason"])] = counts.get((item["kind"], item["reason"]), 0) + 1
    rows = [{"kind": kind, "reason": reason, "count": count} for (kind, reason), count in counts.items()]
    return sorted(rows, key=lambda row: (-row["count"], row["kind"]))


# ------------------------------------------------------------- the command

def read_v1_export(args, config, runner):
    """The v1 export JSON from `--file`, or from the configured v1 binary's `export`."""
    if args.file:
        try:
            text = Path(args.file).read_text()
        except OSError as err:
            raise ImportV1Error("cannot read %s: %s" % (args.file, err.strerror or err)) from None
    else:
        text = _run_v1_export(args.session, config, runner)
    try:
        return json.loads(text)
    except ValueError as err:
        raise ImportV1Error("the v1 export is not valid JSON: %s" % err) from None


def _run_v1_export(session, config, runner):
    binary = config["v1_opencode"]
    if binary is None:
        raise ImportV1Error("'v1_opencode' is not configured in %s: set it to the absolute path of the "
                            "OpenCode v1 binary (it is only ever asked to `export`), or use --file"
                            % config_path())
    if not V1_ID_RE.match(session or ""):
        raise ImportV1Error("--session must be a v1 session id such as ses_..., got %r" % session)
    try:
        result = runner([binary, "export", session], capture_output=True, text=True,
                        timeout=V1_EXPORT_TIMEOUT, stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        raise ImportV1Error("%s export did not finish within %ds" % (binary, V1_EXPORT_TIMEOUT)) from None
    except OSError as err:
        raise ImportV1Error("cannot run %s: %s" % (binary, err.strerror or err)) from None
    if result.returncode != 0:
        raise ImportV1Error("%s export %s failed: %s" % (binary, session, _one_line(result.stderr or result.stdout)))
    return result.stdout or ""


def find_imported(v2, v1_id, directory):
    """The v2 session already imported from this v1 session, or None.

    Found by listing (`metadata.fleet.imported_from`), page by page. If the
    listing cannot be read to its end, that is an error: an unproven absence
    would let a second copy in.
    """
    wanted, cursor = "v1:" + v1_id, None
    for _ in range(V1_LIST_MAX_PAGES):
        sessions, cursor = v2.session_list_page(directory, cursor)
        for session in sessions:
            if (_fleet_meta(session) or {}).get("imported_from") == wanted:
                return session
        if cursor is None:
            return None
    raise ImportV1Error("v2 has more than %d sessions in %s; cannot prove %s was not imported already"
                        % (V1_LIST_MAX_PAGES * V1_LIST_PAGE, directory, wanted))


def _body_size(conversion):
    body = {"info": conversion["info"], "messages": conversion["messages"],
            "location": conversion["info"]["location"]}
    return len(json.dumps(body, separators=(",", ":"), sort_keys=True).encode("utf-8"))


def _pure_refusals(conversion, limit):
    """Reasons not to send that need no call: v2 would refuse the body, or it is too long."""
    problems = v2_import_problems(conversion["info"], conversion["messages"], conversion["info"]["location"])
    if problems:
        return ["the converted session breaks v2's schema (%d problem(s)); nothing was sent: %s"
                % (len(problems), "; ".join(problems[:5]))]
    size = _body_size(conversion)
    if size > limit:
        return ["the body is %d bytes and `opencode api` takes it inline; the limit is %d "
                "(config import_body_limit_bytes). Try --tool-output-limit N to cut long tool output, "
                "which is listed as defaulted" % (size, limit)]
    return []


def _missing_parent(v2, conversion):
    """A reason not to send when the session's parent is not in v2 yet, else []."""
    parent = conversion["info"].get("parentID")
    if not parent:
        return []
    try:
        v2.session_get(parent)
    except V2Error as err:
        if err.status != 404:
            raise
        return ["its parent %s is not in v2 yet; import the parent first (v2 refuses a child before "
                "its parent)" % parent]
    return []


def _audit_detail(conversion, fleet):
    shown = conversion["dropped"][:V1_AUDIT_EXAMPLES]
    return {"v1_session": conversion["v1_session"], "v2_session": conversion["v2_session"],
            "messages": len(conversion["messages"]), "fleet": fleet,
            "dropped_total": len(conversion["dropped"]), "dropped_by_kind": summarise_dropped(conversion["dropped"]),
            "dropped_examples": shown, "dropped_unlisted": len(conversion["dropped"]) - len(shown),
            "defaulted": conversion["defaulted"][:V1_AUDIT_EXAMPLES],
            "defaulted_total": len(conversion["defaulted"])}


def import_v1_session(v2, audit, export, fleet, limit, tool_output_limit=None, dry_run=False, directory=None):
    """Convert, check, and (unless dry-run) import one v1 session. Returns a report dict.

    Nothing is sent when the conversion is refused. A session already imported
    is reported and left alone. `audit` is None only for a dry run.
    """
    conversion = convert_v1_export(export, fleet, tool_output_limit, directory)
    report = {"status": "dry-run" if dry_run else "imported", "v1_session": conversion["v1_session"],
              "v2_session": conversion["v2_session"], "messages": len(conversion["messages"]),
              "dropped": conversion["dropped"], "defaulted": conversion["defaulted"],
              "body_bytes": _body_size(conversion)}
    refusals = _pure_refusals(conversion, limit)  # before any call, even a read
    if refusals:
        raise ImportV1Error("; ".join(refusals))
    existing = find_imported(v2, conversion["v1_session"], conversion["info"]["location"]["directory"])
    if existing:
        return dict(report, status="exists", v2_session=existing["id"])
    refusals = _missing_parent(v2, conversion)
    if refusals:
        raise ImportV1Error("; ".join(refusals))
    if dry_run:
        return report
    try:
        with audit.external("cli", "v2.session.import", fleet.get("name") if fleet else None,
                            _audit_detail(conversion, fleet)) as result:
            result["session"] = v2.session_import(conversion["info"], conversion["messages"],
                                                  conversion["info"]["location"])["id"]
    except V2Error as err:
        if err.status == 409:  # the second layer: v2 already holds this (deterministic) session id
            return dict(report, status="exists")
        raise
    return report


def format_import_report(report):
    verb = {"imported": "imported", "exists": "already imported (nothing done)",
            "dry-run": "would import"}[report["status"]]
    lines = ["%s: v1 %s -> v2 %s, %d message(s)" % (verb, report["v1_session"], report["v2_session"], report["messages"])]
    if report["status"] == "exists":
        return "\n".join(lines)
    lines.append("  body %d bytes" % report["body_bytes"])
    rows = summarise_dropped(report["dropped"])
    lines.append("  dropped %d item(s)%s" % (len(report["dropped"]), ":" if rows else ""))
    lines.extend("    %5d  %-16s %s" % (row["count"], row["kind"], row["reason"]) for row in rows)
    lines.append("  filled in %d value(s)%s" % (len(report["defaulted"]), ":" if report["defaulted"] else ""))
    lines.extend("    %s %s: %s" % (item["message"], item["field"], item["reason"]) for item in report["defaulted"][:20])
    return "\n".join(lines)


def _import_fleet(args):
    problems = []
    if not NAME_RE.match(args.name or ""):
        problems.append("--name must match %s, got %r" % (NAME_RE.pattern, args.name))
    for flag, value in (("--issue", args.issue), ("--charter", args.charter)):
        if value is not None and not _is_issue_number(value):
            problems.append("%s must be an issue number, got %r" % (flag, value))
    if args.dir is not None and not os.path.isabs(args.dir):
        problems.append("--dir must be an absolute path, got %r" % args.dir)
    if args.tool_output_limit is not None and args.tool_output_limit < 1:
        problems.append("--tool-output-limit must be at least 1, got %r" % args.tool_output_limit)
    if problems:
        raise ImportV1Error("; ".join(problems))
    fleet = fleet_record(args.name, args.role, args.reports_to, args.issue)
    if args.charter is not None:
        fleet["charter"] = args.charter
    return fleet


def cmd_import_v1(args, runner, now):
    config = load_config()
    active_faults()
    if config["opencode"] is None:
        raise ConfigError("'opencode' is not configured in %s: set it to the absolute path of the "
                          "OpenCode v2 binary" % config_path())
    try:
        fleet = _import_fleet(args)
        export = read_v1_export(args, config, runner)
        v2 = V2Client(config["opencode"], config["opencode_env"], runner, config["call_timeout_seconds"])
        audit = None if args.dry_run else AuditLog(ensure_state_dir() / "audit.jsonl")
        report = import_v1_session(v2, audit, export, fleet, config["import_body_limit_bytes"],
                                   args.tool_output_limit, args.dry_run, args.dir)
    except ImportV1Error as err:
        sys.stderr.write("%s: %s\n" % (PROG, _one_line(str(err), 600)))
        return EXIT_ERROR
    print(json.dumps(report, indent=2, sort_keys=True) if args.json else format_import_report(report))
    return EXIT_OK


V1_MOVE_COMMANDS = {"import-v1": cmd_import_v1}


def add_v1_move_parsers(sub):
    move = sub.add_parser("import-v1", help="Copy a v1 session into v2 as a fleet agent's session; v1 is only read")
    source = move.add_mutually_exclusive_group(required=True)
    source.add_argument("--session", help="The v1 session id (read with the configured v1 binary's `export`)")
    source.add_argument("--file", help="A file holding what v1's `opencode export` printed")
    move.add_argument("--name", required=True, help="The agent's fleet name (lower case, digits, - and _)")
    move.add_argument("--role", help="metadata.fleet.role")
    move.add_argument("--reports-to", dest="reports_to", help="metadata.fleet.reports_to")
    move.add_argument("--issue", type=int, help="metadata.fleet.issue")
    move.add_argument("--charter", type=int, help="metadata.fleet.charter (an orchestrator's charter issue)")
    move.add_argument("--tool-output-limit", dest="tool_output_limit", type=int,
                      help="Cut each tool output to this many characters (listed as filled in)")
    move.add_argument("--dir", help="The session's working directory in v2 (absolute); default: the one v1 recorded")
    move.add_argument("--dry-run", dest="dry_run", action="store_true",
                      help="Convert and check; print what would be imported; write nothing")
    move.add_argument("--json", action="store_true", help="Print the report as JSON")


def build_parser():
    parser = argparse.ArgumentParser(
        prog=PROG,
        description="Route facts to fleet agents as OpenCode v2 messages. Never types into a pane.",
        epilog="Config: $XDG_CONFIG_HOME/%s/config.json (optional). "
               "State: $XDG_STATE_HOME/%s/ (mode 0700). See docs/switchboard.md." % (PROG, PROG))
    sub = parser.add_subparsers(dest="action", required=True)
    status = sub.add_parser("status", help="Config, clients, and every fleet agent with what is pending for it")
    status.add_argument("--json", action="store_true", help="Emit machine-readable JSON instead")
    run = sub.add_parser("run", help="The daemon: observe, derive, decide, deliver, every poll seconds")
    run.add_argument("--once", action="store_true", help="One pass, then exit")
    run.add_argument("--poll", type=float, help="Seconds between passes (default: config poll_seconds)")
    run.add_argument("--json", action="store_true", help="With --once: print the pass report as JSON")
    run.add_argument("--standby", action="store_true", help="If another daemon holds the lock, wait for it to go "
                                                           "instead of exiting (the service uses this)")
    send = sub.add_parser("send", help="Deliver a message to another fleet agent now, by the delivery rule")
    send.add_argument("name", help="The recipient's fleet name")
    send.add_argument("text", nargs="+", help="The message")
    send.add_argument("--issue", type=issue_arg, help="The issue the message is about")
    send.add_argument("--interrupt", action="store_true",
                      help="Stop and hold orders only: abort the recipient's running turn (its in-flight tool call "
                           "is cut), then deliver the message as a wake. Only a boss to its own worker.")
    send.add_argument("--from", dest="sender", help="Lab only: the sender's fleet name")
    report = sub.add_parser(
        "report", help="Tell the one you report to what happened: done, failed, blocked, question (they wake it) "
                       "or working, paused, withdrawn (progress: carried by the next message, never waking)",
        description="Tell the agent you report to what happened, in one line (at most %d characters; detail "
                    "goes on GitHub). `done`, `failed`, `blocked` and `question` are attention reports: delivered "
                    "now, by the rule `send` uses. `working`, `paused` and `withdrawn` are progress reports: they ride in "
                    "the next message to your boss and never wake it by themselves. `withdrawn` takes back your "
                    "open question or blocked report on the ask (--all: on every ask) because it no longer stands." % REPORT_MAX)
    report.add_argument("state", choices=REPORT_STATES, help="What happened")
    report.add_argument("text", nargs="+", help="One line: what happened (at most %d characters)" % REPORT_MAX)
    report.add_argument("--issue", type=issue_arg, help="The issue the report is about (default: your own)")
    report.add_argument("--all", dest="everything", action="store_true",
                        help="With `withdrawn`: withdraw every open question or blocked report of yours, on any ask")
    report.add_argument("--from", dest="sender", help="Lab only: the sender's fleet name")
    notice = sub.add_parser(
        "notice", help="Tell the person about a pull request you opened or mean to merge (shown in their panel; "
                       "wakes nobody, sends no message)",
        description="`notice pr` records a heads-up about a PR for the person's Decisions panel: information, not a "
                    "decision. It sends no message and wakes nobody. Send it as soon as you OPEN the PR, so it is seen while CI and "
                    "review run. It stays until the PR is merged or closed; sending it again refreshes the note.")
    notice.add_argument("kind", choices=("pr",), help="What the notice is about (only `pr`)")
    notice.add_argument("pr", help="The pull request: owner/repo#N or its URL (an issue is refused)")
    notice.add_argument("note", nargs="*", help="Optional: one line of why, or what you intend (at most %d characters)" % REPORT_MAX)
    notice.add_argument("--from", dest="sender", help="Lab only: the sender's fleet name")
    sub.add_parser("ensure", help="Start the daemon unless it runs (herdr's startup hook calls this)")
    sub.add_parser("poke", help="Ask the daemon for a pass now; silent, never blocks (herdr's event hooks call this)")
    launch = sub.add_parser("launch", help="Start a fleet agent in a new herdr tab, without typing")
    launch.add_argument("name", help="The agent's fleet name (lower case, digits, - and _)")
    launch.add_argument("--agent", help="The OpenCode agent definition, such as coder")
    launch.add_argument("--dir", help="The agent's working directory (absolute)")
    launch.add_argument("--resume", metavar="SESSION", help="Open a tab on this existing session of NAME instead "
                                                           "of creating one (a restart that keeps the conversation)")
    launch.add_argument("--workspace", help="The herdr workspace for the new tab (default: $HERDR_WORKSPACE_ID)")
    launch.add_argument("--role", help="metadata.fleet.role")
    launch.add_argument("--reports-to", dest="reports_to", help="metadata.fleet.reports_to")
    launch.add_argument("--issue", type=issue_arg, help="metadata.fleet.issue (owner/repo#N also sets --repo)")
    launch.add_argument("--repo", help="metadata.fleet.repo, OWNER/REPO: the project the agent works in. Its gh "
                                       "account (config gh_users) is the agent's GH_TOKEN")
    launch.add_argument("--new-workspace", dest="new_workspace", metavar="LABEL",
                        help="Create a herdr workspace with this label in --dir (never focused), and launch "
                             "into it. A --charter whose `workspace:` line differs is refused")
    launch.add_argument("--charter", type=int, help="metadata.fleet.charter: an orchestrator's charter issue")
    launch.add_argument("--checkpoint", metavar="WHEN", help="Remind the worker to report at this time (30m, or an "
                        "ISO time with a zone). Default: read from the brief's CHECKPOINT line, if it can be")
    launch.add_argument("--overdue", metavar="WHEN", help="Wake --reports-to at this time if the worker has not "
                        "reported since the launch (60m, or an ISO time with a zone)")
    launch.add_argument("--brief-file", dest="brief_file", help="The first prompt: a file, or - for stdin")
    pending = sub.add_parser("pending", help="What is pending for an agent, and why it waits or is held")
    pending.add_argument("name", help="The agent's fleet name")
    pending.add_argument("--json", action="store_true", help="Emit machine-readable JSON instead")
    remind = sub.add_parser("remind", help="A message to an agent that is due later")
    remind.add_argument("name", help="The recipient's fleet name")
    remind.add_argument("when", help="A delay (30m, 2h, 1d) or an ISO time with a zone")
    remind.add_argument("text", nargs="+", help="The reminder")
    remind.add_argument("--issue", type=issue_arg, help="The issue the reminder is about")
    remind.add_argument("--from", dest="sender", help="Lab only: the sender's fleet name")
    add_intent_parsers(sub)
    add_foreground_parsers(sub)  # PR 8
    add_policy_parsers(sub)  # PR 9
    add_v1_move_parsers(sub)  # PR 10
    add_install_parsers(sub)  # PR 16
    add_orders_parsers(sub)  # PR 17
    add_decision_parsers(sub)  # PR 18
    sub.add_parser("version", help="Print the version")
    return parser


def main(argv=None, runner=subprocess.run, now=time.time, wait=None, spawn=subprocess.Popen,
         socket_call=None):
    try:
        args = build_parser().parse_args(argv)
    except SystemExit as exit_:
        return EXIT_USAGE if exit_.code not in (0, None) else EXIT_OK
    if args.action == "version":
        print("%s %s" % (PROG, VERSION))
        return EXIT_OK
    if args.action == "status":
        return cmd_status(args, runner, now)
    if args.action == "poke":
        return cmd_poke(args)
    if args.action == "policy-report":
        return cmd_policy_report(args, runner, now)
    if args.action in POLICY_COMMANDS:  # PR 9: prints one JSON line and exits 0 whatever happens
        return POLICY_COMMANDS[args.action](args, runner, now)
    try:
        if args.action in ENSURE_ON_USE_COMMANDS:  # PR 16: the daemon is alive when a command needs it
            ensure_on_use(spawn)
        if args.action == "ensure":
            return cmd_ensure(args, spawn)
        if args.action == "install":  # PR 16
            return cmd_install(args, runner, now, spawn)
        if args.action == "key":
            return cmd_key(args)
        if args.action == "restart":
            return cmd_restart(args, runner, spawn)
        if args.action == "bootstrap":
            return cmd_bootstrap(args, runner, now, socket_call)
        if args.action == "launch":
            return cmd_launch(args, runner, now, socket_call)
        if args.action == "handoff":  # PR 8
            return cmd_handoff(args, runner, now, socket_call)
        if args.action == "run":
            return cmd_run(args, runner, now, wait)
        if args.action == "send":
            return cmd_send(args, runner, now)
        if args.action == "report":
            return cmd_report(args, runner, now)
        if args.action == "notice":
            return cmd_notice(args, runner, now)
        if args.action == "decisions":
            return cmd_decisions(args, runner, now)
        if args.action == "comment":
            return cmd_comment(args, runner, now)
        if args.action == "whoami":
            return cmd_whoami(args, runner, now)
        if args.action == "pending":
            return cmd_pending(args, runner, now)
        if args.action == "remind":
            return cmd_remind(args, runner, now)
        if args.action in INTENT_COMMANDS:
            return INTENT_COMMANDS[args.action](args, runner, now)
        if args.action in V1_MOVE_COMMANDS:  # PR 10
            return V1_MOVE_COMMANDS[args.action](args, runner, now)
        if args.action == "orders":  # PR 17
            return cmd_orders(args, runner, now)
        if args.action == "labels":  # PR 18
            return cmd_labels(args, runner, now)
    except SimulatedCrash as crash:
        sys.stderr.write("%s: crashed: %s\n" % (PROG, crash))
        return EXIT_CRASH
    except (V2Error, HerdrError, ConfigError, FaultError, FactError, CallerError, LockError,
            LaunchError, IntentError, InstallError) as err:
        sys.stderr.write("%s: %s\n" % (PROG, _one_line(str(err))))
        return EXIT_ERROR
    sys.stderr.write("%s: unknown command %r\n" % (PROG, args.action))
    return EXIT_USAGE


# ============================================================================
# PR 16: install, a service that keeps the daemon alive, the decision-model
# key as a file, the daemon started on use, and `bootstrap`
#
# One section, so the stack rebases cleanly. docs/switchboard.md, "Install
# (PR 16)". Registered in these places:
#   KNOWN_FAULTS         `key-missing-silent`, `no-ensure-on-use`, `shared-profile-default`, `key-env-only-unseen`
#   JEV_DEFAULTS         `key_file` (above, with the key reader)
#   collect_status       the key, daemon, plugin and service lines
#   main                 ensure on use, then the commands: install, key, bootstrap
#   HerdrClient          workspace_list, workspace_create (the one `--focus`)
# The pieces `install` puts into OpenCode's profile are plain functions that
# bin/switchboard-trial calls too: there is one path, not two installers.
# ============================================================================
from xml.sax.saxutils import escape as xml_escape

KIT_ROOT = Path(__file__).resolve().parent.parent
STANDARD_MODEL = "github-copilot/claude-sonnet-5.5"  # the model every kit agent file gets
KIT_AGENTS = ("chief-of-staff", "orchestrator", "coder", "cos-subagent")
DECISIONS_PLUGIN_NAME = "fleet-decisions"  # the directory in the profile's opencode config, named in cli.json
DECISIONS_PLUGIN_FILES = ("tui.tsx", "decisions.mjs")
HOOKS_PLUGIN_FILE = "fleet-hooks.js"
TODOLIST_PLUGIN_NAME = "opencode-todolist"  # the directory (the vendored src/) in the profile's opencode config
TODOLIST_LOADER_FILE = "opencode-todolist.ts"  # plugins/<this>: the one line OpenCode loads
TODOLIST_LOADER_TEXT = 'export { default } from "../opencode-todolist/src/index.ts"\n'
WRAPPER_NAME = "fleet-opencode"  # beside the profile, never named `opencode`: the person's own OpenCode keeps that name
# Names a wrapper strips from a v2 process by shape, before it adds the one `gh` token agents are given. The same
# pattern bin/switchboard-trial strips with: a test keeps the two equal.
KEY_NAME_PATTERN = "(_API_KEY|_SECRET|_PASSWORD|_ACCESS_KEY|_ACCESS_KEY_ID)$"
PANE_ENV = "FLEET_SWITCHBOARD_LAB_PANE"  # a pane's v2 keeps its herdr identity only when this is "1" (config `launch_env`)
PROFILE_DIRS = ("config", "data", "state", "cache", "tmp", "home")
V2_PACKAGE, V2_VERSION = "@opencode/cli", "2.0.22"  # what the Lab and the trial install; a test keeps them equal
SERVICE_LABEL = "com.fleet-kit.switchboard"
SERVICE_UNIT = "fleet-kit-switchboard.service"
HERDR_PLUGIN_ID = "fleet-switchboard"
COS_NAME = "cos"
COS_AGENT = "chief-of-staff"
COS_WORKSPACE_LABEL = "Chief of Staff"

NO_KEY_NOTICE = "No decision-model key: messages are not classified and tool calls are not judged."

ENSURE_ON_USE = True  # tests switch it off: a command run in a test must never start a real daemon
ENSURE_ON_USE_COMMANDS = ("send", "report", "notice", "launch", "handoff", "comment", "remind", "decisions", "intent",
                          "bootstrap")  # never `judge-tool`: it runs inside v2 on every tool call
USE_ENSURE_PATIENCE = 2.0  # seconds a command waits for a daemon it started; then it goes on without


# ------------------------------------------------------------ the daemon on use

def ensure_on_use(spawn=subprocess.Popen, patience=None, sleep=time.sleep, state_dir=None):
    """Make sure a daemon runs before a command that needs one does its work. Quiet and bounded.

    A command that cannot start the daemon still does its work: this writes one warning naming the log
    and returns. A config the daemon could not read is the command's own error, not a second one here.
    """
    if not ENSURE_ON_USE or fault("no-ensure-on-use"):
        return None
    try:
        load_config()
    except ConfigError:
        return None
    try:
        state = ensure_state_dir(state_dir)
        return ensure_daemon(state, spawn, USE_ENSURE_PATIENCE if patience is None else patience, sleep)
    except (LockError, ConfigError, OSError) as err:
        why = "" if isinstance(err, LockError) else " (%s)" % _one_line(str(err), 120)
        sys.stderr.write("%s: the daemon is not running and could not be started%s; see %s\n"
                         % (PROG, why, state_dir_path() / "daemon.log"))
        return None


# ------------------------------------------------------------------ the key

def key_source_of(config, environ=None):
    """Where the decision-model key comes from for a process with `environ`: `environment`, `file`, `none`, or
    `not configured` / `replayed` when no key is needed."""
    jev = (config or {}).get("jev")
    if not jev:
        return "not configured"
    if jev.get("replay"):
        return "replayed"
    try:
        return locate_jev_key(jev, environ)[1]
    except KeyFileError:
        return "none"


def key_file_saved(config):
    """Whether a usable key FILE exists, whatever the environment says: what a service started later would find."""
    try:
        return locate_jev_key((config or {}).get("jev") or {}, {})[1] == "file"
    except KeyFileError:
        return False


def daemon_record(config, environ=None):
    """What the daemon writes about itself at start: where its key came from."""
    return {"key_source": key_source_of(config, environ)}


KEY_UNSEEN_BY_DAEMON = ("The decision-model key is only in this shell's environment, and the running daemon was started "
                        "without it: messages are not classified and tool calls are not judged. Run `%s key set` to "
                        "save it as a file; the daemon reads the file when it needs the key." % PROG)
KEY_UNSEEN_BY_SERVICE = ("The decision-model key is only in an environment variable, not in a file, and the service will "
                         "not have it: launchd and systemd start the daemon without your shell's variables, so after a "
                         "restart messages are not classified and tool calls are not judged. Run `%s key set` to save "
                         "it as a file." % PROG)


def key_report(config, daemon=None, service=None):
    """For `status`: where the key comes from, never what it is. `source` is the DAEMON's when a running
    daemon has recorded it (a service has no shell), else this process's; `cli` is this process's."""
    jev = (config or {}).get("jev")
    if not jev or jev.get("replay"):
        source = key_source_of(config)
        return {"source": source, "cli": source, "daemon": None, "file": False, "notice": None, "problem": None}
    problem = None
    try:
        _, cli = locate_jev_key(jev)
    except KeyFileError as err:
        cli, problem = "none", str(err)
    saved = key_file_saved(config)
    started = (daemon or {}).get("key_source")
    # The daemon's variables are fixed at its start; a file is read when needed, so a file saved since counts.
    here = None if started is None else "environment" if started == "environment" else "file" if saved else "none"
    source = here or cli
    try:
        hide_unseen, hide_missing = fault("key-env-only-unseen"), fault("key-missing-silent")
    except FaultError:
        hide_unseen = hide_missing = False  # a bad fault name is `status`'s own lab line to report
    notice = None
    if here == "none" and cli == "environment":
        notice = None if hide_unseen else KEY_UNSEEN_BY_DAEMON
    elif source == "none":
        notice = None if hide_missing else NO_KEY_NOTICE
    elif "environment" in (cli, here) and not saved and (service or {}).get("installed"):
        notice = None if hide_unseen else KEY_UNSEEN_BY_SERVICE
    return {"source": source, "cli": cli, "daemon": here, "file": saved, "notice": notice, "problem": problem}


def format_key_line(key):
    if key["source"] == "environment" and not key.get("file"):
        detail = ("environment (no key file: only an environment variable has it; `%s key set` saves it)" % PROG)
    else:
        detail = {"none": "none: the classifier and the judge answer nothing until `%s key set` saves one" % PROG,
                  "replayed": "not needed (answers are replayed)",
                  "not configured": "not needed (no `jev` in the config)"}.get(key["source"], key["source"])
    return "      %-10s %s%s" % ("key", detail, " (%s)" % key["problem"] if key["problem"] else "")


def daemon_report(state_dir):
    if not run_lock_held(state_dir):
        return {"running": False, "pid": None, "key_source": None, "config_loaded_at": None, "config_invalid": None}
    try:
        pid = int((Path(state_dir) / "run.lock").read_text().strip())
    except (OSError, ValueError):
        pid = None
    record = daemon_record_of(state_dir, pid)
    source = record.get("key_source")
    return {"running": True, "pid": pid, "key_source": source if isinstance(source, str) else None,
            "config_loaded_at": record.get("config_loaded_at"), "config_invalid": record.get("config_invalid")}


def daemon_record_of(state_dir, pid):
    """What the running daemon wrote about itself, or {}: no record, an unreadable one, or one a different process
    wrote (a daemon that died leaves its record behind)."""
    try:
        record = json.loads((Path(state_dir) / DAEMON_RECORD).read_text())
    except (OSError, ValueError):
        return {}
    if not isinstance(record, dict) or pid is None or record.get("pid") != pid:
        return {}
    return record


def daemon_key_source(state_dir, pid):
    source = daemon_record_of(state_dir, pid).get("key_source")
    return source if isinstance(source, str) else None


def update_daemon_record(state_dir, **fields):
    """Merge `fields` into daemon.json, for this process only (the record is the daemon's own)."""
    path = Path(state_dir) / DAEMON_RECORD
    try:
        record = json.loads(path.read_text())
    except (OSError, ValueError):
        record = {}
    if not isinstance(record, dict) or record.get("pid") not in (None, os.getpid()):
        record = {}
    record.update(fields, pid=os.getpid())
    _write_private(path, json.dumps(record, sort_keys=True) + "\n")


def plugin_report(config, runner):
    """Whether herdr lists the switchboard's plugin: `linked`, `not linked`, or `unknown` with why."""
    try:
        done = runner([config["herdr"], "plugin", "list"], capture_output=True, text=True, timeout=HERDR_CALL_TIMEOUT,
                      stdin=subprocess.DEVNULL)
    except Exception as err:  # status must always answer; say what broke in one line
        return {"state": "unknown", "detail": _one_line(str(err), 100)}
    if done.returncode != 0:
        return {"state": "unknown", "detail": "herdr plugin list exited %d" % done.returncode}
    listed = re.search(r"(?m)^\W*%s\b" % re.escape(HERDR_PLUGIN_ID), done.stdout or "") is not None
    return {"state": "linked" if listed else "not linked", "detail": None}


def service_kind(platform=None):
    platform = sys.platform if platform is None else platform
    if platform == "darwin":
        return "launchd"
    return "systemd" if platform.startswith("linux") else None


def service_file_path(kind):
    if kind == "launchd":
        return Path.home() / "Library" / "LaunchAgents" / (SERVICE_LABEL + ".plist")
    if kind == "systemd":
        return _xdg("XDG_CONFIG_HOME", ".config") / "systemd" / "user" / SERVICE_UNIT
    return None


def service_report(platform=None):
    kind = service_kind(platform)
    path = service_file_path(kind)
    return {"kind": kind, "path": str(path) if path else None, "installed": bool(path and path.is_file())}


def format_install_lines(report):
    lines = []
    daemon = report["daemon"]
    lines.append("      %-10s %s" % ("daemon", "running%s" % (" (pid %d)" % daemon["pid"] if daemon["pid"] else "")
                                    if daemon["running"] else "not running (`%s ensure` starts it)" % PROG))
    lines.append(format_key_line(report["key"]))
    plugin = report["plugin"]
    lines.append("      %-10s %s%s" % ("plugin", plugin["state"], " (%s)" % plugin["detail"] if plugin["detail"] else ""))
    service = report["service"]
    lines.append("      %-10s %s" % ("service", ("installed (%s)" % service["path"]) if service["installed"]
                                    else "not installed (`%s install` adds it)" % PROG if service["kind"]
                                    else "no service manager on this platform"))
    return lines


def _write_private(path, text):
    """Write `text` to `path` atomically with mode 0600: a temporary file in the same directory, then rename."""
    path = Path(path)
    if not path.parent.exists():
        path.parent.mkdir(parents=True, mode=0o700)
    handle, temp = tempfile.mkstemp(prefix=".%s." % path.name, dir=str(path.parent))
    try:
        with os.fdopen(handle, "w") as out:
            out.write(text)
            out.flush()
            os.fsync(out.fileno())
        os.chmod(temp, 0o600)
        os.replace(temp, str(path))
    except BaseException:
        try:
            os.unlink(temp)
        except OSError:
            pass
        raise


def cmd_key(args, runner=None, now=None):
    config = load_config()
    settings = config.get("jev") or dict(JEV_DEFAULTS)
    if args.key_action == "status":
        try:
            _, source = locate_jev_key(settings)
        except KeyFileError as err:
            print("none")
            sys.stderr.write("%s: %s\n" % (PROG, err))
            return EXIT_ERROR
        if source == "environment" and not key_file_saved({"jev": settings}):
            source = "environment (only this shell)"
        print(source)
        return EXIT_OK
    if sys.stdin.isatty():
        key = getpass.getpass("Decision-model key (not shown): ")
    else:
        key = sys.stdin.readline()
    key = key.strip()
    if not key:
        sys.stderr.write("%s: no key given: pipe it in or type it at the prompt\n" % PROG)
        return EXIT_USAGE
    if re.search(r"\s", key) or any(ord(ch) < 32 for ch in key):
        sys.stderr.write("%s: that is not a key: it has spaces or control characters (it is not shown)\n" % PROG)
        return EXIT_USAGE
    path = jev_key_file(settings)
    try:
        _write_private(path, key + "\n")
    except OSError as err:
        sys.stderr.write("%s: could not save the key to %s: %s\n" % (PROG, path, err.strerror or err))
        return EXIT_ERROR
    print("key saved")
    return EXIT_OK


# ----------------------------------------------------------------- bootstrap

COS_BRIEF = """Introduce yourself to the person in one or two sentences: you are the Chief of Staff, the one place
they talk to. You hold the plan and hand work out. You do not do work yourself.

Then run `fleet-switchboard status` and read all of it. Tell the person plainly what you found, in your own
words, and what is missing. Three things matter: whether a decision-model key is saved (without one, messages are
not classified and tool calls are not judged: say so first, and tell them `fleet-switchboard key set` saves one),
whether any GitHub repos are watched (`github_repos` in the switchboard config is empty until they choose), and
whether the daemon, the herdr plugin and the service are all in place.

End by asking what they want to work on. Do not start anything until they answer.
"""


class BootstrapRefused(Exception):
    """`bootstrap` will not open a second Chief of Staff."""


def find_cos_session(v2):
    """The newest v2 session whose fleet name is `cos`, or None: derived from v2, never from a stored id."""
    cursor, found = None, []
    for _ in range(V1_LIST_MAX_PAGES):
        sessions, cursor = v2.session_list_page(None, cursor)
        found.extend(s for s in sessions if isinstance(s, dict) and (_fleet_meta(s) or {}).get("name") == COS_NAME)
        if cursor is None:
            break
    if not found:
        return None
    return max(found, key=lambda s: (s.get("time") or {}).get("created") or 0)


def resume_brief(engine, session_id, pane):
    """A first attempt that died after the session was made leaves a Chief of Staff with no brief. Send it once,
    derived from the transcript: "sent", or "kept" when the session already holds it. A failure closes the pane
    this resume opened, as a failed launch does, and the next run tries again."""
    try:
        if brief_in_transcript(engine, session_id):
            return "kept"
        send_brief(engine, COS_NAME, session_id, COS_BRIEF)
        return "sent"
    except Exception as err:
        left = close_own_pane(engine, COS_NAME, pane, "bootstrap could not send the brief: %s" % _one_line(str(err), 120))
        raise LaunchError("%s (session %s still has no brief; %s; run bootstrap again to resume it and send "
                          "the brief)" % (_one_line(str(err)), session_id, left)) from err


def bootstrap_cos(engine, label=COS_WORKSPACE_LABEL, directory=None, patience=LAUNCH_PATIENCE, sleep=time.sleep,
                  focus=True):
    """Open the Chief of Staff for the first time, or again. {"action", "workspace", "name", "session", "pane", "tab"}.

    A `cos` that already has a pane is refused, naming it. A session without a pane is resumed in the
    workspace labelled `label`, where it was; the first time there is no session, and a new workspace is
    always made (and focused: the person wants to see it), never an old one that happens to share the label.
    The launch and the resume are the ones `launch` uses.
    """
    directory = directory or os.getcwd()
    if not os.path.isabs(directory) or not os.path.isdir(directory):
        raise LaunchError("--dir must be an absolute path of an existing directory, got %r" % directory)
    running = engine.discover(engine.now()).agents.get(COS_NAME)
    if running is not None:
        raise BootstrapRefused("a Chief of Staff already runs: %s in pane %s (session %s). There is one per fleet; "
                               "open its workspace in herdr" % (COS_NAME, running.pane, running.session_id))
    session = find_cos_session(engine.v2)
    existing = None
    if session is not None:
        existing = next((w for w in engine.herdr.workspace_list() if w.get("label") == label), None)
    created = None
    if existing is not None:
        workspace = existing["workspace_id"]
    else:
        with engine._external("herdr.workspace.create", COS_NAME, {"label": label, "cwd": directory}) as result:
            created = engine.herdr.workspace_create(directory, label, focus)
            workspace = result["workspace"] = created["workspace_id"]
    try:
        if session is not None:
            done, action = resume_agent(engine, COS_NAME, session["id"], workspace, patience, sleep), "resumed"
            done["brief"] = resume_brief(engine, session["id"], done["pane"])
        else:
            done, action = launch_agent(engine, COS_NAME, COS_AGENT, directory, workspace, COS_AGENT, None, None,
                                        COS_BRIEF, patience, sleep), "created"
            done["brief"] = "sent"
    except LaunchError as err:
        if created is not None:
            raise LaunchError("%s (the workspace %r was opened and is still there)" % (err, label)) from err
        raise
    if created is not None and created.get("root_pane"):  # the empty shell pane herdr gives a new workspace
        close_own_pane(engine, COS_NAME, created["root_pane"], "the empty pane of the workspace bootstrap opened")
    return dict(done, action=action, workspace=workspace)


def cmd_bootstrap(args, runner, now, socket_call=None):
    engine, _, _ = build_engine(runner, now, "cli", socket_call=socket_call)
    directory = os.path.abspath(args.dir) if args.dir else os.getcwd()
    try:
        done = bootstrap_cos(engine, args.workspace or COS_WORKSPACE_LABEL, directory, focus=not args.stay_put)
    except BootstrapRefused as err:
        sys.stderr.write("%s: bootstrap refused: %s\n" % (PROG, err))
        return EXIT_ERROR
    print(json.dumps(done, sort_keys=True))
    return EXIT_OK


# ------------------------------------------------- the profile pieces (shared)
#
# What `install` puts into OpenCode v2's profile. bin/switchboard-trial calls these same functions with
# the trial's own profile, so there is one path. Each takes the directories it writes, and returns whether
# anything changed. Nothing here reads the environment.

class InstallError(Exception):
    """A step of `install` cannot go on, and says why and what to do."""


def write_if_changed(path, content):
    """Write `content` unless the file already holds it. True when it wrote."""
    path = Path(path)
    try:
        if path.read_text() == content:
            return False
    except OSError:
        pass
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content)
    return True


def kit_agent_text(name, model, kit_root=KIT_ROOT):
    """A kit agent file with the model placeholder filled in."""
    return (Path(kit_root) / "agents" / "opencode" / (name + ".md")).read_text().replace("__PROVIDER__/__MODEL_ID__", model)


def install_agents(config_dir, model=STANDARD_MODEL, kit_root=KIT_ROOT):
    """The four agent definitions into <config_dir>/agents. True when any file changed."""
    changed = False
    for name in KIT_AGENTS:
        changed |= write_if_changed(Path(config_dir) / "agents" / (name + ".md"), kit_agent_text(name, model, kit_root))
    return changed


def kit_skill_names(kit_root=KIT_ROOT):
    root = Path(kit_root) / "skills"
    return sorted(p.name for p in root.iterdir() if (p / "SKILL.md").is_file())


def install_skills(skills_dir, kit_root=KIT_ROOT):
    """The kit's skills into `skills_dir`, one directory each. True when any file changed."""
    changed = False
    for name in kit_skill_names(kit_root):
        text = (Path(kit_root) / "skills" / name / "SKILL.md").read_text()
        changed |= write_if_changed(Path(skills_dir) / name / "SKILL.md", text)
    return changed


def _read_json_object(path, what):
    """The JSON object at `path` ({} when there is no file). Anything else is refused, never overwritten."""
    path = Path(path)
    if not path.exists():
        return {}
    try:
        body = json.loads(path.read_text())
    except (OSError, ValueError):
        body = None
    if not isinstance(body, dict):
        raise InstallError("%s is not a JSON object: fix it by hand (%s), then run again" % (path, what))
    return body


def ensure_skills_path(config_dir, skills_dir, model=None):
    """Name `skills_dir` in the profile's opencode.json under skills.paths, keeping every other key.

    v2 also scans the user's home for skills, and a skill of the same name there would win over one that is
    only copied into the profile; a configured path is read after those and wins. True when it wrote.
    """
    path = Path(config_dir) / "opencode.json"
    body = _read_json_object(path, "it holds the profile's settings")
    skills = body.get("skills")
    if skills is not None and not isinstance(skills, dict):
        raise InstallError("%s: `skills` is not an object: fix it by hand, then run again" % path)
    skills = dict(skills or {})
    paths = skills.get("paths", [])
    if not isinstance(paths, list):
        raise InstallError("%s: `skills.paths` is not a list: fix it by hand, then run again" % path)
    if str(skills_dir) in paths:
        return False
    skills["paths"] = list(paths) + [str(skills_dir)]
    if not body:
        body["$schema"] = "https://opencode.ai/config.json"
        if model:
            body["model"] = model
    body["skills"] = skills
    return write_if_changed(path, json.dumps(body, indent=2) + "\n")


def install_hooks_plugin(config_dir, kit_root=KIT_ROOT):
    return write_if_changed(Path(config_dir) / "plugins" / HOOKS_PLUGIN_FILE,
                            (Path(kit_root) / "plugins" / "fleet-hooks" / "index.js").read_text())


def read_cli_json(config_dir):
    """The profile's cli.json as an object ({} when there is none). A file that is not a JSON object with a
    `plugins` list is refused, never overwritten: it may hold plugins this code knows nothing about."""
    path = Path(config_dir) / "cli.json"
    body = _read_json_object(path, "it names the TUI plugins")
    if not isinstance(body.get("plugins", []), list):
        raise InstallError("%s is not a JSON object with a `plugins` list: fix it by hand, then run again" % path)
    return body


def install_decisions_plugin(config_dir, kit_root=KIT_ROOT):
    """Copy the Decisions TUI plugin into the profile and name its directory in cli.json, keeping every other
    plugin and key there. Idempotent; True when anything changed. Nothing is restarted."""
    source = Path(kit_root) / "plugins" / "fleet-decisions-tui"
    target = Path(config_dir) / DECISIONS_PLUGIN_NAME
    changed = False
    for name in DECISIONS_PLUGIN_FILES:
        changed |= write_if_changed(target / name, (source / name).read_text())
    body = read_cli_json(config_dir)
    wanted = "./" + DECISIONS_PLUGIN_NAME
    if wanted not in body.get("plugins", []):
        body["plugins"] = list(body.get("plugins", [])) + [wanted]
        changed |= write_if_changed(Path(config_dir) / "cli.json", json.dumps(body, indent=2) + "\n")
    return changed


def decisions_plugin_status(config_dir, kit_root=KIT_ROOT):
    """`installed`, `not installed`, or `out of date` (a file differs from the kit's)."""
    try:
        named = ("./" + DECISIONS_PLUGIN_NAME) in read_cli_json(config_dir).get("plugins", [])
    except InstallError:
        named = False
    source = Path(kit_root) / "plugins" / "fleet-decisions-tui"
    target = Path(config_dir) / DECISIONS_PLUGIN_NAME
    if not named or not all((target / name).is_file() for name in DECISIONS_PLUGIN_FILES):
        return "not installed"
    same = all((target / name).read_text() == (source / name).read_text() for name in DECISIONS_PLUGIN_FILES)
    return "installed" if same else "out of date"


def _todolist_files(kit_root):
    """{path relative to src/: bytes} for every file under the vendored plugin's src/."""
    src = Path(kit_root) / "plugins" / "opencode-todolist" / "src"
    return {str(p.relative_to(src)): p.read_bytes() for p in sorted(src.rglob("*")) if p.is_file()}


def _todolist_paths(config_dir):
    config = Path(config_dir)
    return config / TODOLIST_PLUGIN_NAME, config / "plugins" / TODOLIST_LOADER_FILE


def _same_bytes(path, content):
    try:
        return Path(path).read_bytes() == content
    except OSError:
        return False


def install_todolist_plugin(config_dir, kit_root=KIT_ROOT):
    """Copy the vendored todo plugin's src/ into <config>/opencode-todolist/ and write the loader
    <config>/plugins/opencode-todolist.ts that re-exports it (a `plugins` entry naming the directory does not
    load: its package.json exports an unbuilt ./dist). A loader this code did not write is refused, never
    overwritten; so is a differing src file when there is no loader of ours to say the directory is ours.
    Idempotent; True when anything changed."""
    files = _todolist_files(kit_root)
    target, loader = _todolist_paths(config_dir)
    loader_bytes = TODOLIST_LOADER_TEXT.encode()
    if loader.exists() and not _same_bytes(loader, loader_bytes):
        raise InstallError("%s exists and the kit did not write it: move it aside, then run again" % loader)
    ours = loader.exists()
    if not ours:
        for name, body in files.items():
            if (target / name).exists() and not _same_bytes(target / name, body):
                raise InstallError("%s exists and the kit did not write it: move it aside, then run again"
                                   % (target / name))
    changed = False
    for name, body in files.items():
        if not _same_bytes(target / name, body):
            (target / name).parent.mkdir(parents=True, exist_ok=True)
            (target / name).write_bytes(body)
            changed = True
    if not ours:
        loader.parent.mkdir(parents=True, exist_ok=True)
        loader.write_bytes(loader_bytes)
        changed = True
    return changed


def todolist_plugin_status(config_dir, kit_root=KIT_ROOT):
    """`not installed`, `already installed`, or `differs from the kit`."""
    files = _todolist_files(kit_root)
    target, loader = _todolist_paths(config_dir)
    if not loader.exists() and not any((target / name).exists() for name in files):
        return "not installed"
    same = _same_bytes(loader, TODOLIST_LOADER_TEXT.encode()) and all(
        _same_bytes(target / name, body) for name, body in files.items())
    return "already installed" if same else "differs from the kit"


def uninstall_todolist_plugin(config_dir, kit_root=KIT_ROOT):
    """Remove the files install wrote and only those: a file edited since stays, and so does its directory."""
    target, loader = _todolist_paths(config_dir)
    removed = False
    if _same_bytes(loader, TODOLIST_LOADER_TEXT.encode()):
        loader.unlink()
        removed = True
    for name, body in _todolist_files(kit_root).items():
        if _same_bytes(target / name, body):
            (target / name).unlink()
            removed = True
    for path in sorted((p for p in target.rglob("*") if p.is_dir()), reverse=True) if target.is_dir() else []:
        try:
            path.rmdir()
        except OSError:
            pass
    try:
        target.rmdir()
    except OSError:
        pass
    return removed


def remove_if_same(path, content):
    """Delete `path` when it still holds exactly `content` (what the kit wrote). False when absent or edited."""
    path = Path(path)
    try:
        if path.read_text() != content:
            return False
    except OSError:
        return False
    path.unlink()
    return True


def uninstall_agents(config_dir, model=STANDARD_MODEL, kit_root=KIT_ROOT):
    removed = False
    for name in KIT_AGENTS:
        removed |= remove_if_same(Path(config_dir) / "agents" / (name + ".md"), kit_agent_text(name, model, kit_root))
    return removed


def uninstall_skills(skills_dir, kit_root=KIT_ROOT):
    removed = False
    for name in kit_skill_names(kit_root):
        target = Path(skills_dir) / name
        if remove_if_same(target / "SKILL.md", (Path(kit_root) / "skills" / name / "SKILL.md").read_text()):
            removed = True
            try:
                target.rmdir()
            except OSError:
                pass
    try:
        Path(skills_dir).rmdir()
    except OSError:
        pass
    return removed


def uninstall_skills_path(config_dir, skills_dir):
    """Take `skills_dir` out of skills.paths; drop what is then empty; remove the file if it held only that."""
    path = Path(config_dir) / "opencode.json"
    if not path.exists():
        return False
    body = _read_json_object(path, "it holds the profile's settings")
    skills = body.get("skills")
    if not isinstance(skills, dict) or str(skills_dir) not in (skills.get("paths") or []):
        return False
    skills["paths"] = [p for p in skills["paths"] if p != str(skills_dir)]
    if not skills["paths"]:
        del skills["paths"]
    if not skills:
        del body["skills"]
    if set(body) <= {"$schema", "model"}:
        path.unlink()
    else:
        path.write_text(json.dumps(body, indent=2) + "\n")
    return True


def uninstall_hooks_plugin(config_dir, kit_root=KIT_ROOT):
    return remove_if_same(Path(config_dir) / "plugins" / HOOKS_PLUGIN_FILE,
                          (Path(kit_root) / "plugins" / "fleet-hooks" / "index.js").read_text())


def uninstall_decisions_plugin(config_dir, kit_root=KIT_ROOT):
    source = Path(kit_root) / "plugins" / "fleet-decisions-tui"
    target = Path(config_dir) / DECISIONS_PLUGIN_NAME
    removed = False
    for name in DECISIONS_PLUGIN_FILES:
        removed |= remove_if_same(target / name, (source / name).read_text())
    try:
        target.rmdir()
    except OSError:
        pass
    path = Path(config_dir) / "cli.json"
    if path.exists():
        body = read_cli_json(config_dir)
        wanted = "./" + DECISIONS_PLUGIN_NAME
        if wanted in body.get("plugins", []):
            body["plugins"] = [p for p in body["plugins"] if p != wanted]
            if not body["plugins"]:
                del body["plugins"]
            if body:
                path.write_text(json.dumps(body, indent=2) + "\n")
            else:
                path.unlink()
            removed = True
    return removed


# ----------------------------------------------------------------- the service

def render_service(kind, values, kit_root=KIT_ROOT):
    """The LaunchAgent or the systemd user unit, from its template in templates/, placeholders filled in."""
    name = SERVICE_LABEL + ".plist" if kind == "launchd" else SERVICE_UNIT
    text = (Path(kit_root) / "templates" / name).read_text()
    for placeholder, value in values.items():
        text = text.replace(placeholder, xml_escape(value) if kind == "launchd" else value.replace("%", "%%"))
    return text


def service_values(kit_root, path_dirs):
    """The placeholders of both service templates. No secret is among them: the key comes from its file."""
    return {"__PYTHON__": sys.executable, "__HOME__": str(Path.home()), "__PREFIX__": str(kit_root),
            "__STATE_DIR__": str(state_dir_path()), "__CONFIG_HOME__": str(config_path().parent.parent),
            "__STATE_HOME__": str(state_dir_path().parent), "__PATH__": os.pathsep.join(path_dirs)}


def service_path_dirs(kit_root, tools):
    """PATH for the service: the kit's bin, the directories of the tools it runs, then the usual places."""
    dirs = [str(Path(kit_root) / "bin")]
    dirs += [os.path.dirname(tool) for tool in tools if tool and os.path.isabs(tool)]
    dirs += [os.path.dirname(sys.executable), "/opt/homebrew/bin", "/usr/local/bin", "/usr/bin", "/bin",
             "/usr/sbin", "/sbin"]
    seen = []
    return [d for d in dirs if d and not (d in seen or seen.append(d))]


# v2 confined to the kit's private profile, as bin/switchboard-trial's wrapper confines it to the trial's: its XDG
# directories and its HOME are the profile's, so nothing the kit installs is read by your ordinary OpenCode and
# nothing of yours is read by v2; every credential-shaped variable is removed by shape; the agents are given the
# `gh` token (as GH_TOKEN) because they work on GitHub, asked for at every start from your real gh config and
# before HOME is replaced (on macOS gh finds its token in the login keychain via HOME), and never stored.
PRIVATE_WRAPPER_TEXT = """#!/bin/sh
# OpenCode v2 in the Fleet Switchboard's own profile. Written by `fleet-switchboard install`; it holds no secret.
# Run v2 through this file, not by its own name: your ordinary OpenCode never sees this profile, and v2 sees none
# of yours. The agents work on GitHub and their shell runs in the pane's process, so every start asks gh for
# the token itself, before HOME is replaced below. Nothing is stored: not in a file, not in `launch_env`.
GH_FOR_AGENTS=$(GH_CONFIG_DIR={gh_config} {gh} auth token {gh_user_flag} 2>/dev/null)
PROFILE={profile}
export XDG_CONFIG_HOME="$PROFILE/config" XDG_DATA_HOME="$PROFILE/data"
export XDG_STATE_HOME="$PROFILE/state" XDG_CACHE_HOME="$PROFILE/cache"
export TMPDIR="$PROFILE/tmp"
# XDG alone leaves `home` live: v2 would load your skills. herdr's OpenCode integration is written under
# $HOME/.config/opencode, which install links to this profile's opencode directory.
export HOME="$PROFILE/home"
export FLEET_SWITCHBOARD_BIN={fleet_bin}
# The Decisions plugin reads decisions.json from the daemon's state directory.
export FLEET_SWITCHBOARD_STATE={state}
# The fleet-hooks plugin puts this first on PATH of every agent shell: a gh that signs what agents say.
export FLEET_SWITCHBOARD_SHIMS={shims}
# Agents run `fleet-switchboard send`; their shell finds it here.
export PATH={kit_bin}:"$PATH"
for name in $(env | sed -n 's/^\\([A-Za-z_][A-Za-z0-9_]*\\)=.*/\\1/p' \\
    | grep -E '{key_pattern}|^(GH|GITHUB|COPILOT)_'); do
  unset "$name"
done
[ -n "$GH_FOR_AGENTS" ] && export GH_TOKEN="$GH_FOR_AGENTS"
if [ "${pane_env}" != "1" ]; then
  unset HERDR_ENV HERDR_PANE_ID HERDR_SOCKET_PATH HERDR_TAB_ID HERDR_WORKSPACE_ID
fi
exec {v2} "$@"
"""


def private_env(profile_root, base=None):
    """The environment of a process that must see the private profile and nothing else of yours: its XDG
    directories and its HOME are the profile's (herdr writes its OpenCode integration under $HOME/.config/opencode
    and ignores XDG_CONFIG_HOME)."""
    root = Path(profile_root)
    env = dict(os.environ if base is None else base)
    env.update({"XDG_CONFIG_HOME": str(root / "config"), "XDG_DATA_HOME": str(root / "data"),
                "XDG_STATE_HOME": str(root / "state"), "XDG_CACHE_HOME": str(root / "cache"),
                "TMPDIR": str(root / "tmp"), "HOME": str(root / "home")})
    for name in [n for n in env if n.startswith("HERDR_") and n != "HERDR_SOCKET_PATH"]:
        del env[name]  # this process is not in a pane and must not report as one
    return env


def home_link_path(profile_root):
    return Path(profile_root) / "home" / ".config" / "opencode"


def home_link_is_ours(profile_root, config_dir):
    link = home_link_path(profile_root)
    return link.is_symlink() and os.readlink(str(link)) == str(config_dir)


def ensure_home_link(profile_root, config_dir):
    """Make `$HOME/.config/opencode` under the private HOME a link to the profile's opencode directory, where herdr
    writes its integration whatever XDG_CONFIG_HOME says. Returns whether it changed anything; refuses a path
    that is there and is not that link."""
    link = home_link_path(profile_root)
    if home_link_is_ours(profile_root, config_dir):
        return False
    if os.path.lexists(str(link)):
        raise InstallError("%s exists and is not the link to %s: not touching it" % (link, config_dir))
    link.parent.mkdir(parents=True, exist_ok=True)
    os.symlink(str(config_dir), str(link))
    return True


def herdr_integration_status(runner, herdr, env):
    """The `opencode:` line of `herdr integration status`, read with `env` (so HOME says where it would install)."""
    done = runner([herdr, "integration", "status"], capture_output=True, text=True, timeout=30, env=env,
                  stdin=subprocess.DEVNULL)
    return next((line.strip() for line in (done.stdout or "").splitlines() if line.startswith("opencode:")), "")


# ----------------------------------------------------------------- the installer

def v2_version_of(runner, exe):
    """The version `binary --version` prints, as a tuple of ints, or None (it did not run or did not say)."""
    try:
        done = runner([exe, "--version"], capture_output=True, text=True, timeout=30, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        return None
    match = re.search(r"(\d+)\.(\d+)\.(\d+)", (done.stdout or "") + " " + (done.stderr or "")) if done.returncode == 0 else None
    return tuple(int(part) for part in match.groups()) if match else None


class Installer:
    """`fleet-switchboard install`: idempotent steps, each reported `done`, `already done` or `skipped (why)`.

    `runner` runs the other programs (OpenCode, herdr, launchctl, systemctl): tests give it a fake and a
    temporary HOME, so nothing real is touched. `dry_run` reports what would change and writes nothing.
    """

    def __init__(self, runner=subprocess.run, spawn=subprocess.Popen, now=time.time, platform=None, kit_root=KIT_ROOT,
                 dry_run=False, out=None, shared_profile=False, profile=None, gh_user=None):
        self.runner, self.spawn, self.now = runner, spawn, now
        self.platform = platform
        self.kind = service_kind(platform)
        self.kit_root = Path(kit_root)
        self.dry = dry_run
        self.out = out or sys.stdout
        self.problems = []
        self.asked_shared = bool(shared_profile)
        # v2's profile is private unless the person asks for the shared one, by name. (The fault is the bug this
        # fixed: a default that writes where the ordinary OpenCode reads.)
        self.shared = self.asked_shared or fault("shared-profile-default")
        self.profile_arg, self.gh_user = profile, gh_user

    # -- reporting
    def say(self, step, status, detail=""):
        self.out.write("%-24s %s%s\n" % (step, status, " " + detail if detail else ""))

    def result(self, step, changed, detail="", unchanged_detail=None):
        status = ("would be done" if self.dry else "done") if changed else "already done"
        self.say(step, status, detail if changed else (unchanged_detail if unchanged_detail is not None else detail))

    # -- places
    def profile_root(self):
        """The private profile: v2's XDG_CONFIG_HOME, XDG_DATA_HOME, XDG_STATE_HOME and HOME (its wrapper sets them)."""
        if self.profile_arg:
            if not os.path.isabs(self.profile_arg):
                raise InstallError("--profile must be an absolute path, got %r" % self.profile_arg)
            return Path(self.profile_arg)
        return self.data_dir() / "profile"

    def config_dir(self, config):
        """The OpenCode config directory the pieces go into: the private profile's, or with --shared-profile the one
        the ordinary OpenCode reads."""
        if not self.shared:
            return self.profile_root() / "config" / "opencode"
        env = config.get("opencode_env") or {}
        if env.get("OPENCODE_CONFIG_DIR"):
            return Path(env["OPENCODE_CONFIG_DIR"])
        if env.get("XDG_CONFIG_HOME"):
            return Path(env["XDG_CONFIG_HOME"]) / "opencode"
        return _xdg("XDG_CONFIG_HOME", ".config") / "opencode"

    def data_dir(self):
        return _xdg("XDG_DATA_HOME", ".local/share") / PROG

    def skills_dir(self):
        return self.data_dir() / "skills"

    def wrapper_path(self):
        return self.data_dir() / "bin" / WRAPPER_NAME

    # -- 1: the OpenCode v2 binary
    def candidates(self, explicit, config):
        if explicit:
            return [explicit]
        found = []
        configured = config.get("opencode_executable") or config.get("opencode")
        if configured and configured != str(self.wrapper_path()):
            found.append(configured)
        found.append(str(self.data_dir() / "v2" / "node_modules" / "@opencode" / "cli" / "bin" / "opencode.exe"))
        found.append(str(Path.home() / ".local" / "share" / "fleet-v2" / "bin" / "opencode"))
        on_path = shutil.which("opencode")
        if on_path:
            found.append(on_path)
        return found

    def find_v2(self, explicit, config):
        """(binary, version) of an OpenCode v2 by absolute path. Refuses with how to get one."""
        tried = []
        for binary in self.candidates(explicit, config):
            if not os.path.isabs(binary):
                raise InstallError("--opencode must be an absolute path, got %r: a bare name is resolved through PATH, "
                                   "and PATH can find OpenCode v1" % binary)
            version = v2_version_of(self.runner, binary) if os.path.exists(binary) else None
            if version is not None and version[0] == 2:
                return binary, ".".join(str(part) for part in version)
            tried.append("%s (%s)" % (binary, "not there" if not os.path.exists(binary)
                                      else "version %s" % (".".join(map(str, version)) if version else "unreadable")))
        prefix = self.data_dir() / "v2"
        raise InstallError(
            "no OpenCode v2 found (looked at: %s). Your ordinary `opencode` may be v1; this never assumes it is not.\n"
            "  Get v2 into a private directory, never `npm -g` or the curl installer (they replace v1):\n"
            "    npm install --prefix %s --no-audit --no-fund --ignore-scripts %s@%s\n"
            "    (cd %s/node_modules/%s && node ./postinstall.mjs)\n"
            "  then run `%s install --opencode %s/node_modules/@opencode/cli/bin/opencode.exe`."
            % (", ".join(tried) or "nothing", prefix, V2_PACKAGE, V2_VERSION, prefix, V2_PACKAGE, PROG, prefix))

    # -- 2: config.json
    OWNED_KEYS = ("opencode", "opencode_executable")  # what a pane runs: install owns exactly these two

    def wanted_config(self, binary):
        # A shared profile has no wrapper: the binary is run as given (a stable link, not its resolved path, so a
        # package upgrade does not break it). A private one runs it through the wrapper.
        keys = {"opencode": binary if self.shared else str(self.wrapper_path()), "opencode_executable": binary}
        if not self.shared:  # the wrapper drops a pane's herdr identity (its plugin reports status) unless this is set
            keys["launch_env"] = {PANE_ENV: "1"}
        herdr = shutil.which("herdr")
        if herdr:
            keys["herdr"] = herdr
        keys["github_repos"] = []
        keys["jev"] = {"model": JEV_MODEL}
        keys["policy"] = {"enabled": True}
        return keys

    def step_config(self, binary):
        path = config_path()
        raw = _read_json_object(path, "it is the switchboard's config")
        wanted = self.wanted_config(binary)
        missing = {key: value for key, value in wanted.items() if key not in raw}
        stale = {key: wanted[key] for key in self.OWNED_KEYS if key in raw and raw[key] != wanted[key]}
        if not missing and not stale:
            return self.result("config", False, str(path))
        merged = dict(raw, **missing)  # the user's keys keep their values and their order; ours follow
        merged.update(stale)
        validate_config(merged, str(path))
        if not self.dry:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(json.dumps(merged, indent=2) + "\n")
        changes = []
        if missing:
            changes.append("added %s" % ", ".join(missing))
        if stale:
            changes.append("updated %s" % ", ".join("%s (was %s)" % (key, raw[key]) for key in stale))
        return self.result("config", True, "%s: %s" % (path, "; ".join(changes)))

    # -- 2b: the Chief of Staff's standing orders file (PR 18)
    def step_cos_orders(self, config):
        """A template when there is no file; never overwritten, never removed."""
        path = cos_orders_path(config)
        made = install_cos_orders_template(config, self.dry)
        self.result("standing orders", made, "%s (a template: yours to edit; install never overwrites it)" % path,
                    "%s (exists: left as it is)" % path)

    # -- 3: what goes into the profile
    def gh_config_dir(self):
        """Where gh keeps its accounts: read now, because the wrapper's private XDG_CONFIG_HOME would hide it."""
        return os.environ.get("GH_CONFIG_DIR") or str(_xdg("XDG_CONFIG_HOME", ".config") / "gh")

    def wrapper_text(self, binary, config):
        common = dict(fleet_bin=shlex.quote(str(self.kit_root / "bin" / PROG)), shims=shlex.quote(str(self.kit_root / "shims")),
                      state=shlex.quote(str(state_dir_path())), kit_bin=shlex.quote(str(self.kit_root / "bin")),
                      v2=shlex.quote(binary))
        return PRIVATE_WRAPPER_TEXT.format(
            profile=shlex.quote(str(self.profile_root())), gh=shlex.quote(shutil.which("gh") or "gh"),
            gh_config=shlex.quote(self.gh_config_dir()), key_pattern=KEY_NAME_PATTERN, pane_env=PANE_ENV,
            gh_user_flag="--user %s" % shlex.quote(self.gh_user) if self.gh_user else "", **common)

    # -- 3a: the profile itself
    SHARED_NOTICE = ("--shared-profile: the ordinary OpenCode will read the files below too ({dir}). They are v2-shaped "
                     "(a plugin, a decisions directory, skills.paths, cli.json) and can stop a v1 OpenCode that reads "
                     "them from starting. Leave the flag off to keep v2's profile private.")

    def step_profile(self, config):
        if self.shared:
            where = self.config_dir(config)
            if self.asked_shared:
                self.out.write("%s\n" % self.SHARED_NOTICE.format(dir=where))
            return self.say("profile", "shared", str(where))
        root = self.profile_root()
        missing = [name for name in PROFILE_DIRS if not (root / name).is_dir()]
        if missing and not self.dry:
            for name in PROFILE_DIRS:
                (root / name).mkdir(parents=True, exist_ok=True)
            os.chmod(str(root / "state"), 0o700)
        self.result("profile", bool(missing), "%s (private to v2; %s is not touched)" % (root, self.shared_dir()),
                    "%s (private to v2; %s is not touched)" % (root, self.shared_dir()))

    def shared_dir(self):
        return _xdg("XDG_CONFIG_HOME", ".config") / "opencode"

    def piece(self, step, action, detail):
        """Run one profile piece (`action()` returns whether it changed anything). In a dry run, ask without writing."""
        changed = action()
        self.result(step, changed, detail)

    def step_pieces(self, binary, config):
        profile = self.config_dir(config)
        wrapper = self.wrapper_path()
        if self.shared:  # config points at the binary itself: nothing would run a wrapper
            self.say("wrapper", "skipped (--shared-profile: the binary runs as it is)")
        else:
            text = self.wrapper_text(binary, config)
            current = wrapper.read_text() if wrapper.exists() else None
            if not self.dry and current != text:
                write_if_changed(wrapper, text)
                os.chmod(str(wrapper), 0o755)
            self.result("wrapper", current != text, str(wrapper))
        steps = (("agents", lambda: install_agents(profile, STANDARD_MODEL, self.kit_root), "%s/agents" % profile),
                 ("skills", lambda: install_skills(self.skills_dir(), self.kit_root), str(self.skills_dir())),
                 ("skills path", lambda: ensure_skills_path(profile, self.skills_dir(), STANDARD_MODEL),
                  "%s/opencode.json" % profile),
                 ("fleet-hooks plugin", lambda: install_hooks_plugin(profile, self.kit_root),
                  "%s/plugins/%s" % (profile, HOOKS_PLUGIN_FILE)),
                 ("decisions plugin", lambda: install_decisions_plugin(profile, self.kit_root),
                  "%s/%s and cli.json" % (profile, DECISIONS_PLUGIN_NAME)),
                 ("todolist plugin", lambda: install_todolist_plugin(profile, self.kit_root),
                  "%s/%s and plugins/%s" % (profile, TODOLIST_PLUGIN_NAME, TODOLIST_LOADER_FILE)))
        for step, action, detail in steps:
            if self.dry:
                self.dry_piece(step, profile)
            else:
                self.piece(step, action, detail)

    def dry_piece(self, step, profile):
        """What a piece would change, found by running it against a copy: nothing real is written."""
        with tempfile.TemporaryDirectory() as scratch:
            shadow = Path(scratch) / "profile"
            if profile.exists():
                shutil.copytree(str(profile), str(shadow), symlinks=True)
            skills = Path(scratch) / "skills"
            if self.skills_dir().exists():
                shutil.copytree(str(self.skills_dir()), str(skills))
            actions = {"agents": lambda: install_agents(shadow, STANDARD_MODEL, self.kit_root),
                       "skills": lambda: install_skills(skills, self.kit_root),
                       "skills path": lambda: ensure_skills_path(shadow, self.skills_dir(), STANDARD_MODEL),
                       "fleet-hooks plugin": lambda: install_hooks_plugin(shadow, self.kit_root),
                       "decisions plugin": lambda: install_decisions_plugin(shadow, self.kit_root),
                       "todolist plugin": lambda: install_todolist_plugin(shadow, self.kit_root)}
            self.result(step, actions[step](), "in %s" % profile)

    # -- 3b: herdr's OpenCode integration, in the private profile
    def integration_line(self, config):
        """(the `opencode:` line of herdr's integration status read with the private HOME, the path it names)."""
        root = self.profile_root()
        line = herdr_integration_status(self.runner, self.herdr_bin(config), private_env(root))
        named = re.search(r"\((/[^)]*)\)\s*$", line)
        return line, named.group(1) if named else None

    def inside_private_home(self, path):
        return bool(path) and (str(path) + os.sep).startswith(str(self.profile_root() / "home") + os.sep)

    def step_integration(self, config):
        """herdr installs its OpenCode integration (the plugin that reports an agent's status) into
        $HOME/.config/opencode and ignores XDG_CONFIG_HOME. Run with the private HOME, whose `.config/opencode` is a
        link to the private profile, it lands there and never in the ordinary OpenCode's directory. Refused when
        herdr says it would install anywhere else."""
        if self.shared:
            return self.say("herdr integration", "skipped (--shared-profile)")
        try:
            line, path = self.integration_line(config)
        except (OSError, subprocess.SubprocessError) as err:
            return self.say("herdr integration", "skipped (herdr cannot be asked: %s)" % _one_line(str(err), 100))
        if not self.inside_private_home(path):
            raise InstallError("herdr would install its OpenCode integration outside the private profile (%s): "
                               "refusing; nothing was installed" % (line or "no `opencode:` line in `herdr integration status`"))
        if "current" in line:
            return self.result("herdr integration", False, path)
        if self.dry:
            return self.result("herdr integration", True, "`herdr integration install opencode` into %s" % path)
        ensure_home_link(self.profile_root(), self.config_dir(config))
        root = self.profile_root()
        done = self.runner([self.herdr_bin(config), "integration", "install", "opencode"], capture_output=True, text=True,
                           timeout=60, env=private_env(root), stdin=subprocess.DEVNULL)
        if done.returncode != 0:
            raise InstallError("`herdr integration install opencode` failed: %s" % _one_line(done.stderr or done.stdout, 200))
        self.result("herdr integration", True, "installed into %s" % path)

    # -- 4: the herdr plugin
    def herdr_bin(self, config):
        return config.get("herdr") or "herdr"

    def plugin_linked(self, config):
        return plugin_report(config, self.runner)

    def step_link(self, config):
        herdr, source = self.herdr_bin(config), self.kit_root / "herdr"
        state = self.plugin_linked(config)
        if state["state"] == "linked":
            return self.say("herdr plugin", "already done", "%s is linked" % HERDR_PLUGIN_ID)
        if state["state"] == "unknown":
            raise InstallError("cannot tell whether herdr's plugin is linked (%s): is herdr installed and running? "
                               "Run again, or pass --no-herdr-link" % state["detail"])
        self.say("herdr plugin", "would run" if self.dry else "will run", "`%s plugin link %s`" % (herdr, source))
        for line in ("herdr has one server, so a linked plugin's hooks run for every pane in it, including panes that "
                     "run something else:",
                     "  startup: `%s ensure` starts the switchboard daemon unless it runs;" % (self.kit_root / "bin" / PROG),
                     "  pane created, closed, exited, agent detected or its status changed: `%s poke`, which is "
                     "silent, returns at once, and only asks the daemon for a pass;" % (self.kit_root / "bin" / PROG),
                     "  nothing is typed into any pane, and nothing is sent anywhere. `install --uninstall` unlinks it "
                     "(`%s plugin unlink %s`)." % (herdr, HERDR_PLUGIN_ID)):
            self.out.write("    %s\n" % line)
        if self.dry:
            return self.say("herdr plugin", "would be done")
        done = self.runner([herdr, "plugin", "link", str(source)], capture_output=True, text=True,
                           timeout=HERDR_CALL_TIMEOUT * 2, stdin=subprocess.DEVNULL)
        if done.returncode != 0:
            raise InstallError("`herdr plugin link` failed: %s" % _one_line(done.stderr or done.stdout, 200))
        self.say("herdr plugin", "done", "linked %s" % source)

    # -- 4b: the CLI on PATH
    CLI_NAME = PROG

    def cli_target(self):
        return self.kit_root / "bin" / PROG

    def path_dirs_under_home(self):
        """The directories of the current PATH that are under HOME, in order."""
        home = os.path.abspath(str(Path.home())) + os.sep
        dirs = [os.path.abspath(d) for d in os.environ.get("PATH", "").split(os.pathsep) if d]
        return [Path(d) for d in dirs if (d + os.sep).startswith(home)]

    def cli_candidates(self):
        """Where the link may go, best first: ~/.local/bin when it is on PATH, then the first directory of PATH under
        HOME that can be written, then ~/.local/bin anyway (with the line that puts it on PATH)."""
        local = Path.home() / ".local" / "bin"
        on_path = self.path_dirs_under_home()
        writable = [d for d in on_path if d != local and os.access(str(d), os.W_OK)]
        return ([local] if local in on_path else []) + writable + ([] if local in on_path else [local])

    def link_state(self, link):
        """`ours` (a link to this checkout's CLI), `stale` (a link to a checkout that is gone), `other` (anything else
        there: a file, or a link to something else), or `absent`."""
        if not os.path.lexists(str(link)):
            return "absent"
        if not os.path.islink(str(link)):
            return "other"
        target = os.readlink(str(link))
        if os.path.realpath(str(link)) == os.path.realpath(str(self.cli_target())):
            return "ours"
        if not os.path.exists(str(link)) and os.path.basename(target) == PROG:
            return "stale"
        return "other"

    def step_cli_link(self):
        target = self.cli_target()
        candidates = self.cli_candidates()
        for directory in candidates:
            if self.link_state(directory / self.CLI_NAME) == "ours":
                return self.cli_done(directory, False, target)
        directory = candidates[0]
        link = directory / self.CLI_NAME
        state = self.link_state(link)
        if state == "other":
            return self.say("cli link", "skipped (%s exists and is not a link to this checkout's %s; left alone: "
                                        "agents' shells will not find `%s` until it is moved)" % (link, target, PROG))
        if not self.dry:
            directory.mkdir(parents=True, exist_ok=True)
            if state == "stale":
                link.unlink()
            os.symlink(str(target), str(link))
        self.cli_done(directory, True, target)

    def cli_done(self, directory, changed, target):
        link = directory / self.CLI_NAME
        on_path = directory in self.path_dirs_under_home() or str(directory) in os.environ.get("PATH", "").split(os.pathsep)
        self.result("cli link", changed, "%s -> %s" % (link, target))
        if on_path:
            self.out.write("    %s is on your PATH, so a shell (a Chief of Staff's too) finds `%s`.\n" % (directory, PROG))
        else:
            where = str(directory)
            home = str(Path.home())
            if where.startswith(home + os.sep):
                where = "$HOME" + where[len(home):]
            self.out.write("    %s is not on your PATH. Add this line to your shell's startup file:\n"
                           "      export PATH=\"%s:$PATH\"\n" % (directory, where))
        self.out.write("    A moved or deleted checkout breaks this link; run `%s install` again from the new one to "
                       "repair it.\n" % PROG)

    # -- 5: the service
    def service_text(self, config):
        tools = [shutil.which("gh"), self.herdr_bin(config) if os.path.isabs(self.herdr_bin(config)) else shutil.which("herdr")]
        dirs = service_path_dirs(self.kit_root, tools)
        return render_service(self.kind, service_values(self.kit_root, dirs), self.kit_root)

    def loaded(self):
        uid = os.getuid()
        if self.kind == "launchd":
            done = self.runner(["launchctl", "print", "gui/%d/%s" % (uid, SERVICE_LABEL)], capture_output=True, text=True,
                               timeout=30, stdin=subprocess.DEVNULL)
            return done.returncode == 0
        done = self.runner(["systemctl", "--user", "is-enabled", SERVICE_UNIT], capture_output=True, text=True,
                           timeout=30, stdin=subprocess.DEVNULL)
        return done.returncode == 0

    def run_checked(self, argv, what):
        done = self.runner(argv, capture_output=True, text=True, timeout=60, stdin=subprocess.DEVNULL)
        if done.returncode != 0:
            raise InstallError("%s failed: %s" % (what, _one_line(done.stderr or done.stdout, 200)))
        return done

    def load_commands(self, path):
        uid = os.getuid()
        if self.kind == "launchd":
            return [["launchctl", "bootstrap", "gui/%d" % uid, str(path)]]
        return [["systemctl", "--user", "daemon-reload"], ["systemctl", "--user", "enable", "--now", SERVICE_UNIT]]

    def unload_commands(self):
        uid = os.getuid()
        if self.kind == "launchd":
            return [["launchctl", "bootout", "gui/%d/%s" % (uid, SERVICE_LABEL)]]
        return [["systemctl", "--user", "disable", "--now", SERVICE_UNIT]]

    def step_service(self, config):
        path, text = service_file_path(self.kind), self.service_text(config)
        on_disk = path.read_text() if path.exists() else None
        loaded = self.loaded()
        if on_disk == text and loaded:
            return self.say("service", "already done", str(path))
        what = "load" if on_disk == text else "write and load"
        commands = " && ".join(" ".join(c) for c in self.load_commands(path))
        self.say("service", "will run" if not self.dry else "would run", "%s: %s" % (what, commands))
        if self.dry:
            return self.say("service", "would be done", str(path))
        ensure_state_dir()  # launchd opens its log files in the state directory, and will not make it
        if on_disk != text:
            if loaded:  # a changed definition is read only by a fresh load
                for command in self.unload_commands():
                    self.run_checked(command, " ".join(command))
            write_if_changed(path, text)
        for command in self.load_commands(path):
            self.run_checked(command, " ".join(command))
        self.say("service", "done", str(path))

    # -- 6: the daemon, and what status says
    def step_ensure(self, ensure, status):
        if self.dry:
            return self.say("daemon", "skipped (dry run)")
        try:
            self.say("daemon", "done" if ensure() == "started" else "already done")
        except (LockError, ConfigError, OSError) as err:
            self.say("daemon", "FAILED", _one_line(str(err), 200))
        self.out.write("\n%s\n" % status())

    def read_config(self):
        """The config as it stands now (defaults when there is no file). A file that cannot be read stops the install."""
        try:
            return load_config() if config_path().exists() else validate_config({})
        except ConfigError as err:
            raise InstallError(str(err)) from None

    def install(self, explicit_opencode=None, with_service=True, with_link=True, ensure=None, status=None):
        config = self.read_config()
        binary, version = self.find_v2(explicit_opencode, config)
        self.result("opencode v2", binary != config.get("opencode_executable"), "%s (v%s)" % (binary, version),
                    "%s (v%s)" % (binary, version))
        self.step_config(binary)
        config = self.read_config()
        self.step_cos_orders(config)
        self.step_profile(config)
        self.step_pieces(binary, config)
        if with_link:
            self.step_integration(config)
        else:
            self.say("herdr integration", "skipped (--no-herdr-link)")
        if with_link:
            self.step_link(config)
        else:
            self.say("herdr plugin", "skipped (--no-herdr-link)")
        self.step_cli_link()
        if not with_service:
            self.say("service", "skipped (--no-service)")
        elif self.kind is None:
            self.say("service", "skipped (no service manager known for this platform)")
        else:
            self.step_service(config)
        self.step_ensure(ensure or (lambda: ensure_daemon(ensure_state_dir(), self.spawn)),
                         status or (lambda: format_status(collect_status(self.runner, self.now, self.platform))))

    # -- the reverse of 3 to 5
    def uninstall(self, with_service=True, with_link=True):
        config = self.read_config()
        profile = self.config_dir(config)
        if not with_service:
            self.say("service", "skipped (--no-service)")
        elif self.kind is None:
            self.say("service", "skipped (no service manager known for this platform)")
        else:
            path = service_file_path(self.kind)
            had = path.exists()
            if self.loaded():
                self.say("service", "would run" if self.dry else "will run", " && ".join(" ".join(c) for c in self.unload_commands()))
                if not self.dry:
                    for command in self.unload_commands():
                        self.run_checked(command, " ".join(command))
            if had and not self.dry:
                path.unlink()
                if self.kind == "systemd":
                    self.run_checked(["systemctl", "--user", "daemon-reload"], "systemctl --user daemon-reload")
            self.result("service", had, "removed %s" % path, "not installed")
        if with_link:
            state = self.plugin_linked(config)
            if state["state"] == "linked":
                self.say("herdr plugin", "will run" if not self.dry else "would run",
                         "`%s plugin unlink %s`" % (self.herdr_bin(config), HERDR_PLUGIN_ID))
                if not self.dry:
                    self.run_checked([self.herdr_bin(config), "plugin", "unlink", HERDR_PLUGIN_ID], "`herdr plugin unlink`")
                self.result("herdr plugin", True, "unlinked")
            elif state["state"] == "unknown":
                self.say("herdr plugin", "skipped (cannot tell whether it is linked: %s)" % state["detail"])
            else:
                self.result("herdr plugin", False, "not linked")
        else:
            self.say("herdr plugin", "skipped (--no-herdr-link)")
        wrapper = self.wrapper_path()
        self.uninstall_integration(config, profile, with_link)
        for step, action in (("todolist plugin", lambda: uninstall_todolist_plugin(profile, self.kit_root)),
                             ("decisions plugin", lambda: uninstall_decisions_plugin(profile, self.kit_root)),
                             ("fleet-hooks plugin", lambda: uninstall_hooks_plugin(profile, self.kit_root)),
                             ("skills path", lambda: uninstall_skills_path(profile, self.skills_dir())),
                             ("skills", lambda: uninstall_skills(self.skills_dir(), self.kit_root)),
                             ("agents", lambda: uninstall_agents(profile, STANDARD_MODEL, self.kit_root))):
            self.result(step, self.would_remove(step, profile) if self.dry else action(), "removed" , "nothing to remove")
        had = wrapper.exists()
        if had and not self.dry:
            wrapper.unlink()
        self.result("wrapper", had, "removed %s" % wrapper, "nothing to remove")
        self.uninstall_cli_link()
        self.out.write("config, state, sessions and your standing orders file are left alone; a running daemon keeps "
                       "running until it exits\n")

    def uninstall_cli_link(self):
        """Remove the links `install` makes: only a symlink that points at this checkout's CLI."""
        places = [directory / self.CLI_NAME for directory in dict.fromkeys(
            self.cli_candidates() + [Path.home() / ".local" / "bin"])]
        ours = [link for link in places if self.link_state(link) == "ours"]
        for link in ours:
            if not self.dry:
                link.unlink()
        self.result("cli link", bool(ours), "removed %s" % ", ".join(str(link) for link in ours), "nothing to remove")

    def uninstall_integration(self, config, profile, with_link):
        """Remove herdr's OpenCode integration from the private profile, and the home link install made. Only ever
        the private HOME: a status that names any other path leaves it alone."""
        if self.shared:
            return self.say("herdr integration", "skipped (--shared-profile)")
        if not with_link:
            return self.say("herdr integration", "skipped (--no-herdr-link)")
        try:
            line, path = self.integration_line(config)
        except (OSError, subprocess.SubprocessError) as err:
            self.say("herdr integration", "skipped (herdr cannot be asked: %s)" % _one_line(str(err), 100))
            path, line = None, ""
        present = self.inside_private_home(path) and "not installed" not in line and bool(line)
        if present and not self.dry:
            done = self.runner([self.herdr_bin(config), "integration", "uninstall", "opencode"], capture_output=True,
                               text=True, timeout=60, env=private_env(self.profile_root()), stdin=subprocess.DEVNULL)
            if done.returncode != 0:
                raise InstallError("`herdr integration uninstall opencode` failed: %s" % _one_line(done.stderr or done.stdout, 200))
        if path or present:
            self.result("herdr integration", present, "removed %s" % path, "nothing to remove")
        ours = home_link_is_ours(self.profile_root(), profile)
        if ours and not self.dry:
            home_link_path(self.profile_root()).unlink()
        self.result("home link", ours, "removed %s" % home_link_path(self.profile_root()), "nothing to remove")

    def would_remove(self, step, profile):
        """For a dry run of --uninstall: whether the piece is there to remove (a file the user edited is not)."""
        with tempfile.TemporaryDirectory() as scratch:
            shadow, skills = Path(scratch) / "profile", Path(scratch) / "skills"
            if profile.exists():
                shutil.copytree(str(profile), str(shadow), symlinks=True)
            if self.skills_dir().exists():
                shutil.copytree(str(self.skills_dir()), str(skills))
            actions = {"todolist plugin": lambda: uninstall_todolist_plugin(shadow, self.kit_root),
                       "decisions plugin": lambda: uninstall_decisions_plugin(shadow, self.kit_root),
                       "fleet-hooks plugin": lambda: uninstall_hooks_plugin(shadow, self.kit_root),
                       "skills path": lambda: uninstall_skills_path(shadow, self.skills_dir()),
                       "skills": lambda: uninstall_skills(skills, self.kit_root),
                       "agents": lambda: uninstall_agents(shadow, STANDARD_MODEL, self.kit_root)}
            return actions[step]()


def cmd_install(args, runner, now, spawn=subprocess.Popen):
    installer = Installer(runner, spawn, now, dry_run=args.dry_run, shared_profile=args.shared_profile,
                          profile=args.profile, gh_user=args.gh_user)
    try:
        if args.uninstall:
            installer.uninstall(not args.no_service, not args.no_herdr_link)
        else:
            installer.install(args.opencode, not args.no_service, not args.no_herdr_link)
    except InstallError as err:
        sys.stderr.write("%s: install stopped: %s\n" % (PROG, err))
        return EXIT_ERROR
    return EXIT_OK


def add_install_parsers(sub):
    install = sub.add_parser(
        "install", help="Install the switchboard for this user: config, profile pieces, the herdr plugin, a service",
        description="Idempotent. Each step says done, already done, or skipped (why). Finds an OpenCode v2 binary "
                    "(never assumes `opencode` is v2), writes the config keys that are missing, puts the kit's agents, "
                    "skills and plugins into a private v2 profile (never the directory your ordinary OpenCode reads, unless "
                    "--shared-profile), links the herdr plugin, installs a service that keeps "
                    "the daemon alive, then starts the daemon and prints `status`. No secret is written anywhere.")
    install.add_argument("--opencode", help="The OpenCode v2 binary (absolute path); default: the configured one, "
                                           "then the known places")
    install.add_argument("--no-service", dest="no_service", action="store_true", help="Do not install the service")
    install.add_argument("--no-herdr-link", dest="no_herdr_link", action="store_true",
                         help="Do not link herdr's plugin (it starts the daemon whenever herdr starts)")
    install.add_argument("--shared-profile", dest="shared_profile", action="store_true",
                         help="Put v2's pieces in the directory your ordinary OpenCode reads too (%s), which can break "
                              "a v1 OpenCode that reads them. Default: a private profile" % "~/.config/opencode")
    install.add_argument("--profile", metavar="DIR", help="The private profile's directory (absolute); default: "
                                                          "$XDG_DATA_HOME/%s/profile" % PROG)
    install.add_argument("--gh-user", dest="gh_user", metavar="NAME",
                         help="The gh account the agents' token comes from (default: gh's active one)")
    install.add_argument("--dry-run", dest="dry_run", action="store_true", help="Print every step; write nothing")
    install.add_argument("--uninstall", action="store_true",
                         help="Reverse the profile pieces, the herdr link and the service; config, state and sessions stay")
    key = sub.add_parser("key", help="Save or check the decision-model key (it is a private file, never an argument)")
    keys = key.add_subparsers(dest="key_action", required=True)
    keys.add_parser("set", help="Read the key from standard input (hidden at a terminal) into a private file")
    keys.add_parser("status", help="Say where the key comes from: file, environment or none")
    sub.add_parser("restart", help="Stop the daemon by its recorded pid (only if it is a switchboard daemon), then "
                                   "start it again")
    boot = sub.add_parser("bootstrap", help="Open the Chief of Staff in its own herdr workspace, or resume it")
    boot.add_argument("--workspace", metavar="LABEL", help="The workspace's label (default: %s)" % COS_WORKSPACE_LABEL)
    boot.add_argument("--dir", help="The Chief of Staff's working directory (default: here)")
    boot.add_argument("--no-focus", dest="stay_put", action="store_true",
                      help="Open the workspace without taking focus (for scripts and trials)")


# ------------------------------------------------ the config is reloaded when the file changes

CONFIG_STABLE_SECONDS = 1.0  # a changed file must stay as it is this long before it is read (an editor writes twice)


def load_runnable_config(path=None):
    """The config as the daemon needs it: valid, and with the OpenCode v2 binary named. The one validator the start
    path and a reload both use."""
    config = load_config(path)
    if config["opencode"] is None:
        raise ConfigError("'opencode' is not configured in %s: set it to the absolute path of the "
                          "OpenCode v2 binary" % (path or config_path()))
    return config


def config_signature(path):
    """(mtime, size) of the file, None when there is none (every default applies), or an `unreadable` marker."""
    try:
        info = os.stat(str(path))
    except FileNotFoundError:
        return None
    except OSError as err:
        return ("unreadable", err.errno)
    return (info.st_mtime_ns, info.st_size)


class ConfigWatch:
    """Compares the config file's mtime and size with what the daemon last loaded, once a pass.

    A changed file is read only after it has stayed the same for CONFIG_STABLE_SECONDS, so an editor's two writes
    are one reload and a half-written file is only ever read as the invalid file it is. `check()` answers `reload`
    when the file is valid and says something different (`changed` names the keys, never their values, and `config`
    is the new one). An invalid file never stops anything: it is audited once (`config.invalid`, with the reason)
    and recorded in daemon.json, and the daemon goes on with the config it has.
    """

    def __init__(self, path, config, now, audit=None, actor="daemon", record=None, signature=None):
        self.path, self.config, self.now, self.audit, self.actor = path, config, now, audit, actor
        self.record = record or (lambda **fields: None)
        self.evaluated = signature if signature is not None else config_signature(path)
        self.loaded_at, self.pending_since = now(), None
        self.seen = None
        self.invalid, self.changed, self.new_config = None, [], None

    @property
    def pending(self):
        return self.seen is not None

    def _audit(self, event, detail):
        if self.audit is not None:
            self.audit.append(self.actor, event, None, detail)

    def check(self):
        if fault("config-read-once"):
            return None
        signature, moment = config_signature(self.path), self.now()
        if signature == self.evaluated:
            self.seen = None
            return None
        if signature != self.seen:
            self.seen, self.pending_since = signature, moment
            return None
        if moment - self.pending_since < CONFIG_STABLE_SECONDS:
            return None
        try:
            new = load_runnable_config(self.path)
        except ConfigError as err:
            self.evaluated, self.seen = signature, None
            reason = _one_line(str(err), 300)
            since = (self.invalid or {}).get("since") or iso(moment)
            self.invalid = {"since": since, "reason": reason, "loaded_at": iso(self.loaded_at)}
            self._audit("config.invalid", {"reason": reason, "still_running_on_the_config_loaded_at": iso(self.loaded_at)})
            self.record(config_invalid=self.invalid)
            return None
        if config_signature(self.path) != signature:
            return None  # it changed while it was read: look again once it is still
        self.evaluated, self.seen = signature, None
        recovered, self.invalid = self.invalid, None
        if recovered:
            self.record(config_invalid=None)
        self.changed = sorted(name for name in set(new) | set(self.config) if new.get(name) != self.config.get(name))
        if not self.changed:
            if recovered:
                self._audit("config.recovered", {"was_invalid_since": recovered["since"]})
            return None
        self.new_config = new
        return "reload"


def reexec_in_place(argv):
    """Replace this process with `argv`, keeping the pid and the run.lock descriptor (so the lock is never released
    and `ensure` never sees a gap). Returns only when it could not."""
    fd, env = _HELD_LOCK["fd"], dict(os.environ)
    if fd is not None:
        os.set_inheritable(fd, True)
        env[LOCK_FD_ENV] = str(fd)
    try:
        sys.stdout.flush()
        sys.stderr.flush()
        os.execve(argv[0], argv, env)
    except OSError:
        if fd is not None:
            os.set_inheritable(fd, False)
        raise


def reload_in_place(engine, hub, judge_server, watch, argv, execute=reexec_in_place):
    """Apply a valid config change by starting the daemon over: everything built from the config (engine, watch set,
    forwarders, judge server, accounts, clients) is rebuilt together, so nothing is half applied. The forwarders and
    the judge socket are stopped first, the audit line says which, and the new process holds the same lock."""
    forwarders = sorted(repo for repo, w in hub.watches.items() if w.proc is not None) if hub is not None else []
    if hub is not None:
        hub.stop()
    if judge_server is not None:
        judge_server.stop()
    engine.audit.append(engine.actor, "config.reloaded", None, {
        "changed": watch.changed, "forwarders_stopped": forwarders,
        "judge_socket": "closed here, bound again by the new process"})
    try:
        execute(argv)
    except OSError as err:  # it could not start over: carry on, with the old config and what was stopped started again
        engine.audit.append(engine.actor, "config.reload_failed", None, {"error": _one_line(str(err), 200)})
        if hub is not None:
            hub.start()
        if judge_server is not None:
            judge_server.start()


def format_config_lines(daemon):
    """The daemon's own account of its config, for `status`: when it loaded, or that the file is invalid now."""
    lines = []
    invalid = (daemon or {}).get("config_invalid")
    if invalid:
        lines.append("ERROR config     INVALID since %s: %s; still running on the config loaded at %s"
                     % (invalid.get("since"), invalid.get("reason"), invalid.get("loaded_at")))
    elif (daemon or {}).get("config_loaded_at"):
        lines.append("      config     loaded %s (the daemon's own record)" % daemon["config_loaded_at"])
    return lines


RESTART_PATIENCE = 15  # seconds a stopping daemon has to let go of its lock


def cmd_restart(args, runner, spawn=subprocess.Popen, kill=os.kill, sleep=time.sleep):
    """Stop the daemon by its recorded pid, then `ensure`. It signals only a process that is a switchboard daemon."""
    state = ensure_state_dir()
    report = daemon_report(state)
    if report["running"]:
        pid = report["pid"]
        if pid is None:
            sys.stderr.write("%s: restart refused: the lock says a daemon runs but not which pid\n" % PROG)
            return EXIT_ERROR
        try:
            done = runner(["ps", "-p", str(pid), "-o", "command="], capture_output=True, text=True, timeout=10,
                          stdin=subprocess.DEVNULL)
            command = (done.stdout or "").strip()
        except (OSError, subprocess.SubprocessError):
            command = ""
        if PROG not in command or not re.search(r"\brun\b", command):
            sys.stderr.write("%s: restart refused: pid %d is not a %s daemon (it is: %s); nothing was signalled\n"
                             % (PROG, pid, PROG, _one_line(command, 80) or "not running or unreadable"))
            return EXIT_ERROR
        try:
            kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        except OSError as err:
            sys.stderr.write("%s: could not signal pid %d: %s\n" % (PROG, pid, err.strerror or err))
            return EXIT_ERROR
        waited = 0.0
        while run_lock_held(state):
            if waited >= RESTART_PATIENCE:
                sys.stderr.write("%s: pid %d did not stop within %ds; it was asked to, and nothing stronger was "
                                 "sent\n" % (PROG, pid, RESTART_PATIENCE))
                return EXIT_ERROR
            sleep(0.1)
            waited += 0.1
    print("daemon %s" % ensure_daemon(state, spawn))
    return EXIT_OK


INSTALL_COMMANDS = {"key": cmd_key}
# PR 17: standing orders, `fleet-switchboard orders list|add|remove`
#
# docs/switchboard.md, "Standing orders (PR 17)". The orders live in the charter
# issue's `## Standing orders` section on GitHub (parse_orders, above). Only the
# Chief of Staff writes them, through this one command, which edits only that
# section of the body through `gh api` PATCH, reads the issue back and fails
# loudly when the change is not there. The reader (IntentReader) stays GET-only.
# ============================================================================

ORDERS_KIND = "orders"
COMPACTIONS_READ = 20  # compaction messages read per agent per pass, newest first


def orders_hash(orders):
    """Eight hex characters of the orders text: what changes when the owner edits an order."""
    return hashlib.sha256("\n".join(orders).encode("utf-8")).hexdigest()[:8]


def completed_compaction(messages):
    """(id, created) of the newest COMPLETED compaction in `messages` (newest first), or (None, None). v2
    represents a compaction as a message of type `compaction` with a status of running, completed or
    failed; a running or failed one changes nothing."""
    for message in messages if isinstance(messages, list) else []:
        if isinstance(message, dict) and message.get("type") == "compaction" and message.get("status") == "completed" \
                and isinstance(message.get("id"), str) and message["id"]:
            return message["id"], _created(message)
    return None, None


class OrdersFacts:
    """PR 17: the standing orders of a charter, for every fleet agent whose session metadata names it.

    `orders:<charter>:<hash8 of the orders>:<compaction id, or "start">`: derived on every call and stored
    nowhere. It is pending exactly when no such key is in the agent's transcript or inbox, so an agent is
    told at its start, again after each completed compaction (the id is the newest completed compaction
    message's), and again when the owner edits an order (the hash). The fact is delivered as a note, never
    a wake (`Fact.orders`). A charter with no orders gives no fact.
    """

    __name__ = "orders_facts"

    def __init__(self):
        self.engine = None

    def bind(self, engine):
        self.engine = engine

    def __call__(self):
        engine = self.engine
        discovery = getattr(engine, "discovery", None)
        if engine is None or discovery is None:
            return []
        facts = []
        for observation in sorted(discovery.agents.values(), key=lambda o: o.name):
            if (observation.fleet or {}).get("role") == "chief-of-staff":  # PR 18: found by role, not by charter
                if not observation.conflict and not observation.problem:
                    found = self.cos_fact(observation)
                    if found is not None:
                        facts.append(found)
                continue
            charter = (observation.fleet or {}).get("charter")
            repo = engine.charter_repo(observation)
            if not _is_issue_number(charter) or not repo or observation.conflict or observation.problem:
                continue
            try:
                orders = engine.charter_orders(observation, charter)
                compaction, when = (None, None) if fault("orders-start-only") else completed_compaction(
                    engine.v2.message_list(observation.session_id, COMPACTIONS_READ, type="compaction"))
            except (IntentError, V2Error) as err:  # one agent's trouble never hides the others; nothing is guessed
                engine._note("orders.unreadable", observation.name, {"charter": charter,
                                                                      "error": _one_line(str(err), 200)})
                continue
            if not orders:
                continue
            key = "%s:%s#%d:%s:%s" % (ORDERS_KIND, repo, charter, orders_hash(orders), compaction or "start")
            facts.append(Fact(key, observation.name, ORDERS_KIND, "\n".join(orders),
                              max(observation.created or 0.0, when or 0.0), issue=charter, batch=False,
                              orders=True, repo=repo))
        return facts

    def cos_fact(self, observation):
        """PR 18: the Chief of Staff's own orders as a fact: `orders:cos:<hash8 of the text>:<compaction id|start>`,
        derived and stored nowhere, pending exactly when no such key is in its transcript or inbox: at its start, after
        each completed compaction and when the file changes. None when there are no orders, or the file cannot be
        used (said once in the audit)."""
        engine = self.engine
        try:
            found = read_cos_orders(engine.config)
            compaction, when = (None, None) if fault("orders-start-only") else completed_compaction(
                engine.v2.message_list(observation.session_id, COMPACTIONS_READ, type="compaction"))
        except (CosOrdersError, V2Error) as err:  # nothing is guessed; a file too large is refused, not cut
            engine._note("orders.unreadable", observation.name, {"cos": True, "error": _one_line(str(err), 200)})
            return None
        if not found["text"]:
            return None
        digest = hashlib.sha256(found["text"].encode("utf-8")).hexdigest()[:8]
        return Fact("%s:cos:%s:%s" % (ORDERS_KIND, digest, compaction or "start"), observation.name, ORDERS_KIND,
                    found["text"], max(observation.created or 0.0, when or 0.0, found["mtime"] or 0.0), batch=False,
                    orders=True)


def write_issue_body(reader, repo, number, body):
    """The one writer of an issue's body: `gh api repos/R/issues/N --method PATCH --input -` with
    {"body": ...} as its input and nothing else, through the reader's injected runner. IntentError when
    gh fails."""
    path = "repos/%s/issues/%d" % (repo, number)
    env = reader.env_for(repo)  # PR 17 on PR 15: the repo's own gh account, in the child's environment only
    extra = {"env": env} if env is not None else {}
    try:
        done = reader.runner([reader.gh, "api", path, "--method", "PATCH", "--input", "-"],
                             input=json.dumps({"body": body}), capture_output=True, text=True,
                             timeout=reader.timeout, **extra)
    except subprocess.TimeoutExpired:
        raise IntentError("unavailable", "gh did not answer within %ss" % reader.timeout) from None
    except OSError as err:
        raise IntentError("unavailable", "cannot run %s: %s" % (reader.gh, err.strerror or err)) from None
    if done.returncode != 0:
        detail = _one_line(done.stderr) or _one_line(done.stdout) or "exit %d" % done.returncode
        raise IntentError("gh", reader.accounts.scrub(detail) if reader.accounts is not None else detail)


def _charter_body(reader, repo, charter):
    """The charter issue's body, read now (never from the cache). OrdersError when it is no charter."""
    data = reader._api("repos/%s/issues/%d" % (repo, charter), repo)
    body = data.get("body") if isinstance(data, dict) and isinstance(data.get("body"), str) else ""
    if not _CHARTER_BLOCK.search(body):
        raise OrdersError("%s#%d is not a charter issue (it has no ```yaml orchestrator: block)" % (repo, charter))
    return body


def edit_charter_orders(engine, repo, charter, event, detail, change):
    """Edit the charter's orders: read the body, `change(body)` it, write it, read it back; once more
    when the readback does not show the change (somebody edited in between); fail loudly when it still
    does not. Audited before and after. Returns the orders after the change."""
    reader = engine.intents
    body = _charter_body(reader, repo, charter)
    new_body = change(body)  # an OrdersError here is a refusal: nothing is written, nothing audited as a write
    with engine._external(event, "charter:%s#%d" % (repo, charter), dict(detail, charter=charter, repo=repo)) as result:
        for attempt in (1, 2):
            if attempt == 2:
                body = _charter_body(reader, repo, charter)
                new_body = change(body)
            write_issue_body(reader, repo, charter, new_body)
            back = reader._api("repos/%s/issues/%d" % (repo, charter), repo)
            got = back.get("body") if isinstance(back, dict) and isinstance(back.get("body"), str) else ""
            if got == new_body or section_orders(got) == section_orders(new_body):
                result["attempts"] = attempt
                reader.invalidate(charter, repo)
                return parse_orders(got)
        raise OrdersError("wrote #%d twice and read back the issue without the change: the Standing orders "
                          "section there is not what was written. Look at the issue; nothing was recorded" % charter)


def orders_caller(engine, args):
    """(name, role, fleet) of who runs `orders add|remove`: its pane's fleet agent; `--from` in the Lab."""
    if args.sender is not None:
        if os.environ.get(LAB_ENV) != "1":
            raise CallerError("--from is only for the Lab (%s=1); an agent is identified by its pane" % LAB_ENV)
        found = engine.discover(engine.now()).agents.get(args.sender)
        if found is None:
            raise CallerError("%s is not a fleet agent the switchboard can see" % args.sender)
        return found.name, (found.fleet or {}).get("role"), found.fleet or {}
    fleet = caller_fleet(engine.herdr, engine.v2, os.environ)
    return fleet["name"], fleet.get("role"), fleet


def _orders_charter(config, charter, fleet, watched):
    """(repo, number) of the charter an `orders` command names: `owner/repo#N`, or a bare number in the caller's
    own repo, as every issue reference is (PR 15). Refused, listing the choices, when several repos are watched
    and the caller has none."""
    repo, number = resolve_issue(config, charter, fleet, watched)
    if repo is None:
        raise ConfigError("'intent_repo' is not configured in %s: set it to OWNER/REPO" % config_path())
    return repo, number


def cmd_orders(args, runner, now):
    if getattr(args, "cos", False):
        return cmd_orders_cos(args)
    if args.orders_action is None:
        sys.stderr.write("%s: orders needs list, add or remove (a charter's orders), or --cos (the Chief of Staff's "
                         "own)\n" % PROG)
        return EXIT_USAGE
    if args.orders_action == "list":
        reader = _intent_reader(runner, now)
        fleet, watched = soft_caller(runner, now)
        try:
            repo, number = _orders_charter(load_config(), args.charter, fleet, watched)
        except IssueRefError as err:
            sys.stderr.write("%s: %s\n" % (PROG, err))
            return EXIT_USAGE
        orders = fetch_orders(reader, number, repo)
        if args.json:
            print(json.dumps({"charter": number, "repo": repo,
                              "orders": [{"number": n, "text": t} for n, t in enumerate(orders, 1)]}, sort_keys=True))
        elif not orders:
            print("no standing orders for charter %s" % issue_tag(repo, number))
        for n, text in ([] if args.json else enumerate(orders, 1)):
            print("%d. %s" % (n, text))
        return EXIT_OK
    engine, _, _ = build_engine(runner, now, "cli")
    if engine.intents is None:
        raise ConfigError("'intent_repo' is not configured in %s: set it to OWNER/REPO" % config_path())
    caller, role, fleet = orders_caller(engine, args)
    try:
        watched = watched_repos(engine.config, discovered_fleets(engine.discover(engine.now())))
        repo, number = _orders_charter(engine.config, args.charter, fleet, watched)
    except IssueRefError as err:
        sys.stderr.write("%s: %s\n" % (PROG, err))
        return EXIT_USAGE
    return orders_write(engine, args, caller, role, repo, number)


def orders_write(engine, args, caller, role, repo, charter):
    """`orders add|remove` on `repo`'s charter for `caller` (a fleet name) whose fleet role is `role`: refused
    unless it is the chief-of-staff (and audited either way). Prints the orders after the change; returns the
    exit code."""
    where = "%s#%d" % (repo, charter)
    if role != "chief-of-staff" and not fault("anyone-can-order"):
        engine.audit.append(engine.actor, "orders.refused", "charter:%s" % where,
                            {"caller": caller, "role": role, "action": args.orders_action, "repo": repo})
        sys.stderr.write("%s: only the chief-of-staff records or removes standing orders; %s is %s. Ask the Chief "
                         "of Staff, or edit the charter on GitHub yourself\n"
                         % (PROG, caller, "a %s" % role if role else "not given a role"))
        return EXIT_USAGE
    try:
        if args.orders_action == "add":
            by = args.by or os_user()
            date = datetime.fromtimestamp(engine.now(), timezone.utc).strftime("%Y-%m-%d")
            detail = {"caller": caller, "by": by, "text": (args.text or "").strip()}
            orders = edit_charter_orders(engine, repo, charter, "orders.add", detail,
                                         lambda body: add_order_to_body(body, args.text, by, date))
        else:
            current = parse_orders(_charter_body(engine.intents, repo, charter))
            if not 1 <= args.number <= len(current):
                raise OrdersError("no order %d: this charter has %d" % (args.number, len(current)))
            detail = {"caller": caller, "number": args.number, "text": current[args.number - 1]}
            orders = edit_charter_orders(engine, repo, charter, "orders.remove", detail,
                                         lambda body: remove_order_from_body(body, args.number))
    except (OrdersError, IntentError) as err:
        sys.stderr.write("%s: %s\n" % (PROG, _one_line(str(err), 400)))
        return EXIT_USAGE if isinstance(err, OrdersError) else EXIT_ERROR
    for number, text in enumerate(orders, 1):
        print("%d. %s" % (number, text))
    if not orders:
        print("no standing orders for charter %s" % issue_tag(repo, charter))
    return EXIT_OK


CHARTER_HELP = "The charter issue: N (in your own repo) or owner/repo#N"


def add_orders_parsers(sub):
    orders = sub.add_parser(
        "orders", help="A charter's standing orders: list them; the Chief of Staff adds and removes them",
        description="The owner's standing orders live in the charter issue's `%s` section on GitHub, one per "
                    "bullet: `- <text> (ordered by <name>, <YYYY-MM-DD>)`. The switchboard re-supplies them to "
                    "every agent of the charter at its start, after each compaction and when they change, and "
                    "the policy judge reads them at every tool call. `list` is open to anyone. `add` and `remove` "
                    "are for the chief-of-staff only (you are identified by your pane); they edit only that "
                    "section of the issue body. `--cos` prints the Chief of Staff's OWN standing orders: one "
                    "local markdown file the owner edits (nothing here writes it)." % ORDERS_HEADING)
    orders.add_argument("--cos", action="store_true",
                        help="PR 18: print the Chief of Staff's own standing orders file and its path (read-only: "
                             "the owner edits that file in an editor; there is no write command)")
    kinds = orders.add_subparsers(dest="orders_action", required=False)
    listing = kinds.add_parser("list", help="The charter's standing orders, numbered")
    listing.add_argument("--charter", type=issue_arg, required=True, help=CHARTER_HELP)
    listing.add_argument("--json", action="store_true", help="Emit machine-readable JSON instead")
    add = kinds.add_parser("add", help="Chief of Staff only: record one standing order the owner gave")
    add.add_argument("--charter", type=issue_arg, required=True, help=CHARTER_HELP)
    add.add_argument("text", help="The order, in the owner's words (1 to %d characters, one line)" % ORDER_MAX_CHARS)
    add.add_argument("--by", help="Who ordered it (default: the operating-system user)")
    add.add_argument("--from", dest="sender", help="Lab only: the caller's fleet name")
    remove = kinds.add_parser("remove", help="Chief of Staff only: remove one order the owner revoked")
    remove.add_argument("--charter", type=issue_arg, required=True, help=CHARTER_HELP)
    remove.add_argument("number", type=int, help="The order's number in `orders list`")
    remove.add_argument("--from", dest="sender", help="Lab only: the caller's fleet name")


# ============================================================================
# PR 18: decision tiers, the Chief of Staff's own standing orders, per-repo views
#
# docs/switchboard.md, "Decision tiers and the Chief of Staff's orders (PR 18)". The faults added here:
# tier-flat, cos-orders-unfed, anyone-edits-cos-orders, answer-unjudged. Registered elsewhere:
#   DEFAULTS            awaiting_cos_label, decisions_cos_grace_seconds, cos_orders_file
#   GitHubHub           read_awaiting reads both labels; a record carries its tier
#   derive_decisions    `tier` on every decision
#   OrdersFacts         the Chief of Staff's orders, found by role, from the file
#   PolicyJudge         context_of feeds the file as `authority`; the guard on the file
#   launch_agent        FLEET_SWITCHBOARD_ROLE and FLEET_SWITCHBOARD_REPO in the pane's environment
# ============================================================================

COS_ORDERS_NAME = "standing-orders.md"
COS_ORDERS_MAX_BYTES = 8192
COS_ORDERS_STATE_CLIP = 1200  # characters of the Chief of Staff's orders the judge's model sees (a charter's: 600)
COS_ORDERS_TEMPLATE = """<!--
The Chief of Staff's standing orders: what it may decide for you, in your own words.

This ONE file is read by the switchboard. It is yours: edit it in an editor; no fleet command writes it (the
policy judge stops an agent that tries). It is free-form markdown, at most 8 KB; this comment is not shown to
anyone. Write short, plain rules, for example:

  - Answer permission prompts for read-only commands (ls, cat, git status, gh ... view) with allow.
  - Merging a pull request that is green and reviewed: allowed in acme/api; never in acme/web.
  - Anything about money, a release, a deploy, or deleting something: ask me.

The Chief of Staff is told these orders at its start, after each compaction and whenever you change this file,
and the policy judge reads them at each of its tool calls. They can only stop a question that is not worth
asking: they never loosen a configured deny. Anything they do not name goes to you.
-->
"""
_HTML_COMMENT = re.compile(r"<!--.*?-->", re.DOTALL)


class CosOrdersError(Exception):
    """The Chief of Staff's orders file cannot be used as it is, and why."""


def cos_orders_path(config=None):
    """The one file: config `cos_orders_file`, else `standing-orders.md` beside config.json."""
    named = (config or {}).get("cos_orders_file")
    return Path(named) if named else config_path().parent / COS_ORDERS_NAME


def cos_orders_text_of(raw):
    """The orders in a file's text: HTML comments (the template's header) are not orders; None when nothing is left."""
    text = _HTML_COMMENT.sub("", raw or "").strip()
    return text or None


_COS_ORDERS_CACHE = {}  # path -> ((mtime_ns, size), result): one stat per call, a re-read only when either changes


def read_cos_orders(config=None, path=None):
    """{"path", "exists", "size", "mtime", "text", "raw"} of the Chief of Staff's orders file. `text` is the
    orders with the template's comment taken out (None when there are none). Raises CosOrdersError when the file is
    larger than COS_ORDERS_MAX_BYTES or cannot be read: a file that is too big is refused, never cut."""
    path = Path(path) if path else cos_orders_path(config)
    try:
        info = path.stat()
    except FileNotFoundError:
        return {"path": str(path), "exists": False, "size": 0, "mtime": None, "text": None, "raw": ""}
    except OSError as err:
        raise CosOrdersError("cannot read %s: %s" % (path, err.strerror or err)) from None
    signature = (info.st_mtime_ns, info.st_size)
    cached = _COS_ORDERS_CACHE.get(str(path))
    if cached is not None and cached[0] == signature:
        return cached[1]
    if info.st_size > COS_ORDERS_MAX_BYTES:
        raise CosOrdersError("%s is %d bytes: the limit is %d (8 KB). Trim it; nothing is fed to the judge or told "
                             "to the Chief of Staff from a file this large" % (path, info.st_size, COS_ORDERS_MAX_BYTES))
    try:
        raw = path.read_text()
    except (OSError, UnicodeDecodeError) as err:
        raise CosOrdersError("cannot read %s: %s" % (path, getattr(err, "strerror", None) or err)) from None
    result = {"path": str(path), "exists": True, "size": info.st_size, "mtime": info.st_mtime,
              "text": cos_orders_text_of(raw), "raw": raw}
    if len(_COS_ORDERS_CACHE) > 20:
        _COS_ORDERS_CACHE.clear()
    _COS_ORDERS_CACHE[str(path)] = (signature, result)
    return result


def cos_orders_summary(config):
    """For `status`: {"path", "exists", "size", "mtime", "error"}: the file's path, size and mtime, or none."""
    try:
        found = read_cos_orders(config)
    except CosOrdersError as err:
        return {"path": str(cos_orders_path(config)), "exists": True, "size": None, "mtime": None,
                "error": _one_line(str(err), 200)}
    return {"path": found["path"], "exists": found["exists"], "size": found["size"] if found["exists"] else None,
            "mtime": iso(found["mtime"]) if found["mtime"] else None, "error": None}


def format_cos_orders_status(summary):
    if summary["error"]:
        return ["      cos orders %s" % summary["error"]]
    if not summary["exists"]:
        return ["      cos orders none (%s; `%s install` makes a template)" % (summary["path"], PROG)]
    return ["      cos orders %s (%d bytes, modified %s)" % (summary["path"], summary["size"], summary["mtime"])]


def install_cos_orders_template(config, dry=False):
    """Create the orders file's template when there is none. NEVER overwrites a file that exists. True when made."""
    path = cos_orders_path(config)
    if os.path.lexists(str(path)):
        return False
    if not dry:
        path.parent.mkdir(parents=True, exist_ok=True)
        fd = os.open(str(path), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w") as handle:
            handle.write(COS_ORDERS_TEMPLATE)
    return True


# An agent must not grant itself authority by writing the owner's orders for the Chief of Staff. Like the charter
# rule, this is a guard on the words of a command, not a proof: a shell can build the call out of pieces this text
# never shows (a variable, a script, another tool). It looks for the file's path or its file name.
_COS_WRITE_VERBS = re.compile(
    r"(?:\btee\b|\bsed\b[^;&|\n]*\s(?:-[A-Za-z]*i|--in-place)|\b(?:mv|cp|rm|ln|dd|truncate|install|rsync|touch|unlink|shred)\b"
    r"|\b(?:vi|vim|nvim|nano|emacs|ed|ex|pico|micro|joe|code|subl|mate)\b"
    r"|\b(?:python[0-9.]*|perl|ruby|node|bun|deno|php|lua|osascript|awk|gawk)\b[^;&|\n]*\s-[A-Za-z]*[cepE])", re.IGNORECASE)


def writes_cos_orders(tool, arguments, config):
    """True when a tool call writes the Chief of Staff's orders file: a shell command naming the file's path or its
    file name with a redirect into it, `tee`, `sed -i`, `mv`, `cp`, `rm`, an editor or an interpreter one-liner; or
    the `edit` tool on it."""
    text = arguments if isinstance(arguments, str) else ""
    path = cos_orders_path(config)
    names = {str(path), path.name}
    named = [n for n in names if n and n in text]
    if not named:
        return False
    if tool == "edit":
        return True
    if tool != "shell":
        return False
    for n in named:
        if re.search(r">>?\s*[\"']?[^\s;&|\"']*%s" % re.escape(n), text):
            return True
    return bool(_COS_WRITE_VERBS.search(text))


# ---- the decisions that write: escalate, resolve, answer

class DecisionError(Exception):
    """A decision command that is refused, and why. Nothing was changed."""


def _gh_write(engine, runner, repo, path, method, data=None, tolerate_missing=False):
    """One write through gh with the repo's own account, its token only in the child's environment. The
    configured `gh`, `gh api <path> --method M [--input -]`. IntentError when it fails (a 404 is quiet when
    `tolerate_missing`, for removing a label that is not there)."""
    argv = [engine.config["gh"], "api", path, "--method", method] + (["--input", "-"] if data is not None else [])
    accounts = getattr(engine, "accounts", None)
    try:
        env = accounts.env_for(repo) if accounts is not None else None
    except AccountError as err:
        raise IntentError("gh", str(err)) from None
    extra = {"input": json.dumps(data)} if data is not None else {}
    if env is not None:
        extra["env"] = env
    try:
        done = runner(argv, capture_output=True, text=True, timeout=engine.config["call_timeout_seconds"], **extra)
    except subprocess.TimeoutExpired:
        raise IntentError("unavailable", "gh did not answer within %ss" % engine.config["call_timeout_seconds"]) from None
    except OSError as err:
        raise IntentError("unavailable", "cannot run %s: %s" % (engine.config["gh"], err.strerror or err)) from None
    if done.returncode != 0:
        detail = _one_line(done.stderr) or _one_line(done.stdout) or "exit %d" % done.returncode
        if tolerate_missing and ("404" in detail or "Not Found" in detail):
            return done
        raise IntentError("gh", accounts.scrub(detail) if accounts is not None else detail)
    return done


def change_issue_labels(engine, runner, repo, number, add=(), remove=()):
    """Add and remove labels on one issue, the added ones first. Audited before and after."""
    subject = "issue:%s#%d" % (repo, number)
    with engine._external("decisions.labels", subject, {"repo": repo, "issue": number, "add": list(add),
                                                         "remove": list(remove)}):
        base = "repos/%s/issues/%d/labels" % (repo, number)
        if add:
            _gh_write(engine, runner, repo, base, "POST", {"labels": list(add)})
        for label in remove:
            _gh_write(engine, runner, repo, "%s/%s" % (base, quote(label, safe="")), "DELETE", tolerate_missing=True)


def comment_as(engine, runner, repo, number, text, author):
    """A comment on the issue, signed as `author` (a fleet name) so it never comes back as an event."""
    body = text.rstrip("\n") + ("\n\n" + fleet_mark(author) if author else "")
    with engine._external("github.comment", "issue:%s#%d" % (repo, number), {"repo": repo, "issue": number,
                                                                          "chars": len(body)}):
        _gh_write(engine, runner, repo, "repos/%s/issues/%d/comments" % (repo, number), "POST", {"body": body})


# ---- how an answer reaches the asker, behind the AnswerDelivery port: each class is a path that was always taken
# here, with its refusals and messages unchanged (the callers keep the wording that is theirs).

class IssueDelivery(decision_core.AnswerDelivery):
    """The issue path: a comment signed by the answerer and awaiting-label changes on the issue. The answer is
    {repo, number, add, remove, comment (text or None), author, comment_first}; the labels go first unless
    `comment_first`. Audited before and after, each write on its own."""

    def __init__(self, engine, runner):
        self.engine, self.runner = engine, runner

    def deliver(self, decision, answer):
        engine, runner, repo, number = self.engine, self.runner, answer["repo"], answer["number"]
        steps = [lambda: change_issue_labels(engine, runner, repo, number, answer.get("add", ()), answer.get("remove", ()))]
        if answer.get("comment"):
            comment = lambda: comment_as(engine, runner, repo, number, answer["comment"], answer.get("author"))
            steps = [comment] + steps if answer.get("comment_first") else steps + [comment]
        for step in steps:
            step()


class ReportSendDelivery(decision_core.AnswerDelivery):
    """The report path: a `send` to the worker that asked, which is what clears a report. The answer is {by, to, text,
    ask, repo}; returns the send's outcome ({sent, reason, ...}) and raises what the send raises: the caller words
    the refusal."""

    def __init__(self, engine):
        self.engine = engine

    def deliver(self, decision, answer):
        return self.engine.send(answer["by"], answer["to"], answer["text"], answer["ask"], answer.get("repo"))


class HarnessReplyDelivery(decision_core.AnswerDelivery):
    """The harness path: a reply to an agent's pending permission request (`allow` is `once`, `deny` is `reject`) or
    question (the one field of its form), through v2. The answer is {value, note, by}. Returns the line the command
    prints; raises DecisionError for a refusal."""

    def __init__(self, engine):
        self.engine = engine

    def deliver(self, decision, answer):
        engine, value, note, name = self.engine, answer["value"], answer.get("note"), answer.get("by")
        kind, ident = decision["kind"], decision["id"]
        session, request = decision.get("session"), decision.get("request")
        if not session or not request:
            raise DecisionError("%s names no request to reply to" % ident)
        subject = "request:%s:%s" % (session, request)
        detail = {"decision": ident, "kind": kind, "agent": decision.get("agent"), "by": name,
                  "note": _one_line(note or "", 200)}
        if kind == "permission":
            choice = value.strip().lower()
            if choice not in ("allow", "deny"):
                raise DecisionError("%s is a permission request: answer `allow` or `deny`" % ident)
            with engine._external("decisions.answer", subject, dict(detail, answer=choice)):
                engine.v2.permission_reply(session, request, "once" if choice == "allow" else "reject", note)
            return "answered %s: %s" % (ident, choice)
        forms = engine.v2.form_list(session)
        form = next((f for f in forms if isinstance(f, dict) and f.get("id") == request), None) \
            if isinstance(forms, list) else None
        if form is None:
            raise DecisionError("%s is no longer pending: the agent's form is gone" % ident)
        answer = _form_answer(form.get("fields") or [], value)
        with engine._external("decisions.answer", subject, dict(detail, answer=_one_line(value, 200))):
            engine.v2.form_reply(session, request, answer)
        return "answered %s" % ident


def decision_by_id(decisions, ident):
    for wanted in (ident, "#" + ident.lstrip("#")):
        for decision in decisions:
            if decision["id"] == wanted:
                return decision
    return None


def decision_actor(engine, args):
    """(name, role) of who runs a decision write: a fleet agent by its pane (`--from` in the Lab), else (None, None):
    you, in a plain shell. Only the Chief of Staff or you may write; any other fleet agent is refused."""
    if getattr(args, "sender", None) is not None:
        name, role, _ = orders_caller(engine, args)
        return name, role
    try:
        name, role, _ = orders_caller(engine, args)
    except CallerError:
        return None, None
    return name, role


def _issue_target(engine, decision):
    """(repo, number) of the issue a decision is about, or None."""
    if not decision.get("ask"):
        return None
    repo = decision.get("repo") or (engine.intents.repo if engine.intents is not None else None) \
        or engine.config.get("intent_repo")
    watched = decision_repos(engine)
    return (repo or (watched[0] if len(watched) == 1 else None)), decision["ask"]


def escalate_decision(engine, runner, decision, reason, name):
    """Move a decision to you. An issue (or the issue a report is about): your label on, the Chief of Staff's off. A
    permission request or question: marked yours at once, in escalated-requests.json (disposable; the pass reads it)
    and in the audit log. Returns one line saying what was done."""
    kind, ident = decision["kind"], decision["id"]
    if decision.get("tier") == "human":
        return "%s is already yours: nothing changed" % ident
    if kind in ("issue", "report"):
        target = _issue_target(engine, decision)
        if target is None or target[0] is None:
            if kind == "report":
                raise DecisionError("%s is a report that names no issue, so there is nothing to label: put it to "
                                    "the owner in chat" % ident)
            raise DecisionError("%s: cannot tell which repo its issue is in" % ident)
        repo, number = target
        IssueDelivery(engine, runner).deliver(decision, {
            "repo": repo, "number": number, "add": [awaiting_label(engine.config)],
            "remove": [awaiting_cos_label(engine.config)], "author": name,
            "comment": "Escalated to the owner: %s" % reason if reason else None})
        engine._note("decisions.escalate", ident, {"kind": kind, "repo": repo, "issue": number, "by": name,
                                                  "reason": _one_line(reason or "", 200)})
        return "escalated %s to you: %s on %s#%d" % (ident, awaiting_label(engine.config), repo, number)
    if kind == "captain":
        if engine.state_dir is None or not decision.get("head"):
            raise DecisionError("%s cannot be escalated: it names no head" % ident)
        key = "captain:%s#%d@%s" % (decision["repo"], decision["number"], decision["head"])
        with engine._external("decisions.escalate", "request:%s" % key, {"decision": ident, "kind": kind, "by": name,
                                                                          "reason": _one_line(reason or "", 200)}):
            decision_store(engine).mark_escalated(key, engine.now())
        return "escalated %s to you: the MERGE: captain PR is waiting on you" % ident
    if engine.state_dir is None or not decision.get("session") or not decision.get("request"):
        raise DecisionError("%s cannot be escalated: it names no request" % ident)
    key = "%s:%s" % (decision["session"], decision["request"])
    with engine._external("decisions.escalate", "request:%s" % key, {"decision": ident, "kind": kind,
                                                                      "agent": decision.get("agent"), "by": name,
                                                                      "reason": _one_line(reason or "", 200)}):
        decision_store(engine).mark_escalated(key, engine.now())
    return "escalated %s to you: the %s %s is waiting on you" % (ident, decision.get("agent") or "agent", kind)


def _refuse_notice(decision):
    """A PR notice is information: there is nothing to resolve or answer, and it ends when its PR merges or closes."""
    if decision["kind"] == "captain":
        raise DecisionError("%s is a MERGE: captain PR: merge or close the PR (it ends then), or escalate it" % decision["id"])
    if decision["kind"] == "notice":
        raise DecisionError("%s is a PR notice: information, so there is nothing to resolve or answer. It ends when "
                            "the PR merges or closes" % decision["id"])


def resolve_decision(engine, runner, decision, note, name):
    """Take both awaiting labels off the issue. A report is resolved by answering its worker with `send`; its issue's
    labels are the only thing this removes."""
    kind, ident = decision["kind"], decision["id"]
    _refuse_notice(decision)
    if kind in ("permission", "question"):
        raise DecisionError("%s is a %s: answer it with `%s decisions answer %s ...`" % (ident, kind, PROG, ident))
    target = _issue_target(engine, decision)
    if target is None or target[0] is None:
        raise DecisionError("%s is a report that names no issue: answer the worker with `%s send`, which resolves it"
                            % (ident, PROG))
    repo, number = target
    IssueDelivery(engine, runner).deliver(decision, {
        "repo": repo, "number": number, "add": (),
        "remove": [awaiting_cos_label(engine.config), awaiting_label(engine.config)], "author": name,
        "comment": "Resolved by the Chief of Staff: %s" % note if note else None})
    engine._note("decisions.resolve", ident, {"kind": kind, "repo": repo, "issue": number, "by": name,
                                             "note": _one_line(note or "", 200)})
    return "resolved %s: %s and %s are off %s#%d" % (ident, awaiting_cos_label(engine.config),
                                                      awaiting_label(engine.config), repo, number)


def _form_answer(fields, value):
    """{key: value} for the one visible field of a form, or DecisionError when the form is more than a question."""
    visible = [f for f in fields if isinstance(f, dict) and not f.get("hidden") and isinstance(f.get("key"), str)]
    if len(visible) != 1:
        raise DecisionError("this form has %d visible fields (%s): answer it in its own pane, or tell the owner"
                            % (len(visible), ", ".join(f.get("key", "?") for f in visible) or "none"))
    field = visible[0]
    kind = field.get("type")
    if kind == "string":
        return {field["key"]: value}
    if kind == "boolean":
        word = value.strip().lower()
        if word in ("yes", "y", "true", "allow"):
            return {field["key"]: True}
        if word in ("no", "n", "false", "deny"):
            return {field["key"]: False}
        raise DecisionError("this question is yes or no: answer yes or no")
    if kind in ("number", "integer"):
        try:
            return {field["key"]: int(value) if kind == "integer" else float(value)}
        except ValueError:
            raise DecisionError("this question wants a number") from None
    raise DecisionError("this question's field is a %s, which `decisions answer` does not fill: answer it in its "
                        "own pane, or tell the owner" % kind)


def answer_decision(engine, decision, value, note, name):
    """Reply to an agent's pending permission request (`allow` is `once`, `deny` is `reject`) or question (the one
    field of its form), through v2. Audited before and after."""
    kind, ident = decision["kind"], decision["id"]
    _refuse_notice(decision)
    if kind not in ("permission", "question"):
        raise DecisionError("%s is %s: `decisions answer` is for a permission request or a question. Answer a report "
                            "with `%s send`; an issue with a comment, then `decisions resolve`"
                            % (ident, "an issue" if kind == "issue" else "a report", PROG))
    return HarnessReplyDelivery(engine).deliver(decision, {"value": value, "note": note, "by": name})


def read_batch_rows(args):
    """The rows of a `decisions batch`: every --row, then the lines of --file (`-` is stdin), or stdin when neither
    was given and it is piped. Raises BatchError."""
    lines = list(args.row or [])           # an empty --row is refused below; blank lines of a file or stdin are skipped
    more = []
    if args.file is not None:
        try:
            more = (sys.stdin.read() if args.file == "-" else Path(args.file).read_text()).splitlines()
        except OSError as err:
            raise BatchError("cannot read %s: %s" % (args.file, err.strerror or err)) from None
    elif not lines and not sys.stdin.isatty():
        more = sys.stdin.read().splitlines()
    lines.extend(line for line in more if line.strip())
    if not lines:
        raise BatchError("a batch needs rows: --row \"<repo#N> | <finding> | <recommendation>\" (repeat it), or --file")
    if len(lines) > BATCH_ROWS_MAX:
        raise BatchError("a batch is at most %d rows (this one is %d): raise the rest as a second batch"
                         % (BATCH_ROWS_MAX, len(lines)))
    return [parse_batch_row(line) for line in lines]


def cmd_decision_batch(args, runner, now):
    """`decisions batch`: an orchestrator raises related findings as ONE issue in ITS OWN repo, labelled for the
    Chief of Staff, with the rows in a fenced `decision-rows` block. Creates nothing anywhere else."""
    try:
        engine, _, config = build_engine(runner, now, "cli")
        name, role, fleet = orders_caller(engine, args)
        if role != "orchestrator":
            raise BatchError("only an orchestrator raises a batch (%s is %s): a worker reports to its orchestrator"
                             % (name, "a %s" % role if role else "not given a role"))
        repo = _fleet_repo(fleet, config)
        if repo is None:
            raise BatchError("%s has no repo in its fleet metadata: a batch is raised in your own repo" % name)
        title = " ".join((args.title or "").split())
        if not title or len(title) > BATCH_TITLE_MAX:
            raise BatchError("--title is one line of 1 to %d characters" % BATCH_TITLE_MAX)
        rows = read_batch_rows(args)
        for row in rows:
            named = row_repo(row["ref"])
            if named is not None and named != repo or named is None and row["ref"].split("#")[0] != repo.split("/")[1]:
                raise BatchError("row %r names an issue outside %s: a batch holds only issues of its own repo, so a "
                                 "finding about a private repo can never land in a public one's batch. Raise it from "
                                 "that repo's orchestrator" % (_one_line(row["ref"], 60), repo))
        subject = "issue:%s" % repo
        with engine._external("decisions.batch", subject, {"repo": repo, "rows": len(rows), "by": name}):
            done = _gh_write(engine, runner, repo, "repos/%s/issues" % repo, "POST",
                             {"title": title, "body": batch_body(name, rows),
                              "labels": [awaiting_cos_label(config)]})
        try:
            made = json.loads(done.stdout or "")
            number = int(made["number"])
        except (ValueError, KeyError, TypeError):
            raise BatchError("gh created the issue but answered something unreadable: look for it in %s" % repo) from None
    except (BatchError, CallerError, IntentError) as err:
        sys.stderr.write("%s: %s\n" % (PROG, _one_line(str(err), 400)))
        return EXIT_USAGE
    print(issue_tag(repo, number, decision_repos(engine)))
    sys.stderr.write("%s: batch of %d rows raised as %s#%d, waiting on the Chief of Staff\n"
                     % (PROG, len(rows), repo, number))
    try:
        send_poke(state_dir_path())
    except Exception:
        pass
    return EXIT_OK


def batch_answer_rows(decision, args):
    """[(row, outcome text, changed)] for `decisions answer <batch> --as-recommended | --row N=<choice> ...`: a row
    not named keeps its recommendation. Raises DecisionError."""
    rows, wanted = decision["rows"], {}
    if args.as_recommended == bool(args.row):
        raise DecisionError("%s is a batch of %d rows: answer it with --as-recommended, or --row N=<choice> for the "
                            "rows that change (the rest keep their recommendation); not both, not neither"
                            % (decision["id"], len(rows)))
    for item in args.row or []:
        found = re.match(r"^([0-9]+)=(.+)$", item.strip())
        if not found or not " ".join(found.group(2).split()):
            raise DecisionError("%r is not a row answer: write --row N=<choice>" % _one_line(item, 60))
        number = int(found.group(1))
        if not 1 <= number <= len(rows):
            raise DecisionError("row %d does not exist: %s has rows 1 to %d" % (number, decision["id"], len(rows)))
        if number in wanted:
            raise DecisionError("row %d is answered twice" % number)
        wanted[number] = _one_line(found.group(2), BATCH_REC_MAX * 2)
    out = []
    for number, row in enumerate(rows, 1):
        choice = wanted.get(number)
        if choice is None or choice.lower() == "as recommended":
            out.append((row, "as recommended: %s" % row["recommendation"], False))
        else:
            out.append((row, "changed: %s (recommended: %s)" % (choice, row["recommendation"]), True))
    return out


def answer_batch(engine, runner, decision, args, name):
    """First the note to the orchestrator that raised the batch; only once it is delivered, ONE comment on the batch
    issue recording every row's outcome, then both awaiting labels off it, so the batch and all its rows leave the
    list together. A note that cannot be delivered (agent gone, held, error) refuses the answer and writes nothing:
    the batch stays in the cos tier with its labels and no comment, and the same answer can be run again once, with
    no duplicate note or comment. (A batch with no known raiser, or answered with no caller name, has no one to tell.)
    Never touches a row's issue: a row may name an issue only proposed for closing, and the orchestrator acts."""
    ident = decision["id"]
    target = _issue_target(engine, decision)
    if target is None or target[0] is None:
        raise DecisionError("%s: cannot tell which repo its issue is in" % ident)
    repo, number = target
    outcomes = batch_answer_rows(decision, args)
    changed = sum(1 for _, _, c in outcomes if c)
    lines = ["Answer to this batch (%d rows): %s." % (len(outcomes), "as recommended" if not changed else
                                                      "%d row%s changed, the rest as recommended"
                                                      % (changed, "" if changed == 1 else "s"))]
    lines += ["%d. %s: %s" % (n, row["ref"], text) for n, (row, text, _) in enumerate(outcomes, 1)]
    if args.note:
        lines.append("Note: %s" % _one_line(args.note, 300))
    lines.append("The row issues were not changed by this answer: the orchestrator that raised the batch acts on it.")
    told = ""
    raised = decision.get("raised_by")
    if raised and name:
        text = "Batch %s (%s#%d) is answered: %s. The record is the comment on it; you act on it, nothing was done to " \
               "the row issues." % (ident, repo, number, "as recommended" if not changed else "%d row(s) changed" % changed)
        try:
            outcome = ReportSendDelivery(engine).deliver(decision, {"by": name, "to": raised, "text": text,
                                                                    "ask": number, "repo": repo})
        except Exception as err:
            raise DecisionError("%s was not answered: the note to %s could not be delivered (%s); its labels stay, the "
                                "batch stays with the Chief of Staff, nothing was commented. Run the same answer again "
                                "once %s can be reached" % (ident, raised, _one_line(str(err), 100), raised)) from None
        if not outcome.get("sent"):
            raise DecisionError("%s was not answered: the note to %s was not delivered (%s); its labels stay, the batch "
                                "stays with the Chief of Staff, nothing was commented. Run the same answer again once "
                                "%s can be reached" % (ident, raised, outcome.get("reason") or outcome.get("action"), raised))
        told = "; told %s" % raised
    IssueDelivery(engine, runner).deliver(decision, {
        "repo": repo, "number": number, "add": (), "remove": [awaiting_cos_label(engine.config), awaiting_label(engine.config)],
        "author": name, "comment": "\n".join(lines), "comment_first": True})
    engine._note("decisions.answer", ident, {"kind": "batch", "repo": repo, "issue": number, "by": name,
                                            "rows": len(outcomes), "changed": changed,
                                            "note": _one_line(args.note or "", 200)})
    return "answered %s: %d rows (%d as recommended, %d changed); %s and %s are off %s#%d%s" % (
        ident, len(outcomes), len(outcomes) - changed, changed, awaiting_cos_label(engine.config),
        awaiting_label(engine.config), repo, number, told)


def parse_superseding(engine, text):
    """`owner/repo#N`, `name#N` (a watched repo's name) or an issue or pull request URL -> (repo, number, as shown)."""
    text = (text or "").strip()
    found = _GITHUB_REF.match(text)
    if found:
        repo, number = "%s/%s" % (found.group(1), found.group(2)), int(found.group(3))
    else:
        short = _SHORT_REF.fullmatch(text)
        repo = repo_of_tag(short.group(1), decision_repos(engine)) if short else None
        if repo is None:
            raise DecisionError("--by names the superseding issue as owner/repo#N, name#N for a watched repo, or its "
                                "URL (got %r)" % _one_line(text, 60))
        number = int(short.group(2))
    if number < 1:
        raise DecisionError("--by names no issue: %r" % _one_line(text, 60))
    return repo, number, "%s#%d" % (repo, number)


def supersede_decision(engine, runner, decision, shown, note, name):
    """One decision made moot by another issue. An issue: a comment `Superseded by <ref>`, both awaiting labels off.
    A report: the answerer's `send` to its worker naming the superseding issue (what clears a report), then its
    issue's labels off if it has one. A permission request or question is refused. Returns what was done."""
    kind, ident = decision["kind"], decision["id"]
    _refuse_notice(decision)
    if kind in ("permission", "question"):
        raise DecisionError("is a %s: answer it with `%s decisions answer %s ...`" % (kind, PROG, ident))
    said = "Superseded by %s%s" % (shown, ": %s" % _one_line(note, 300) if note else "")
    target = _issue_target(engine, decision)
    both = [awaiting_cos_label(engine.config), awaiting_label(engine.config)]
    if kind == "issue":
        if target is None or target[0] is None:
            raise DecisionError("cannot tell which repo its issue is in")
        repo, number = target
        IssueDelivery(engine, runner).deliver(decision, {"repo": repo, "number": number, "add": (), "remove": both,
                                                         "author": name, "comment": said, "comment_first": True})
        engine._note("decisions.supersede", ident, {"kind": kind, "repo": repo, "issue": number, "by": name,
                                                   "superseded_by": shown})
        return "done: comment and both labels off %s#%d" % (repo, number)
    if not name:
        raise DecisionError("a report is cleared by a send from the boss: run this as the Chief of Staff")
    if not decision.get("ask") or not decision.get("agent"):
        raise DecisionError("is a report that names no issue: a send would clear every question of its worker. "
                            "Answer it with `%s send`" % PROG)
    outcome = ReportSendDelivery(engine).deliver(decision, {
        "by": name, "to": decision["agent"], "ask": decision["ask"], "repo": decision.get("repo"),
        "text": "%s. Your question on this ask is covered there; carry on with that." % said})
    if not outcome.get("sent"):
        raise DecisionError("%s was not sent to %s (%s): the report stays open" % (
            "the note", decision["agent"], outcome.get("reason") or outcome.get("action")))
    engine._note("decisions.supersede", ident, {"kind": kind, "agent": decision["agent"], "by": name,
                                               "superseded_by": shown})
    if target is not None and target[0] is not None:
        try:
            IssueDelivery(engine, runner).deliver(decision, {"repo": target[0], "number": target[1], "add": (),
                                                             "remove": both, "author": name})
        except IntentError as err:
            raise DecisionError("sent to %s, but its issue's labels were not removed: %s" % (decision["agent"], err)) from None
        return "done: sent to %s, both labels off %s#%d" % (decision["agent"], target[0], target[1])
    return "done: sent to %s" % decision["agent"]


def cmd_decision_supersede(args, engine, decisions, name, runner):
    """`decisions supersede <id> ... --by <issue>`: per id one line, `done` or `refused: why`; it carries on past a
    failure. Returns the exit code."""
    repo, number, shown = parse_superseding(engine, args.by)
    failed = 0
    for ident in dict.fromkeys(args.ids):
        try:
            decision = decision_by_id(decisions, ident)
            if decision is None:
                raise DecisionError("no decision %s is waiting" % ident)
            line = supersede_decision(engine, runner, decision, shown, args.note, name)
            print("%s: %s" % (ident, line))
        except (DecisionError, IntentError) as err:
            failed += 1
            print("%s: refused: %s" % (ident, _one_line(str(err), 300)))
        except Exception as err:
            failed += 1
            print("%s: failed: %s" % (ident, _one_line("%s: %s" % (type(err).__name__, err), 300)))
    return EXIT_ERROR if failed else EXIT_OK


def cmd_decision_write(args, action, runner, now):
    """`decisions escalate|resolve|answer|supersede`: the caller is its pane's fleet agent (`--from` in the Lab) or you."""
    if action == "batch":
        return cmd_decision_batch(args, runner, now)
    try:
        engine, decisions, _ = fresh_engine_decisions(runner, now, writable=True)
        name, role = decision_actor(engine, args)
        if name is not None and role != "chief-of-staff":
            engine.audit.append(engine.actor, "decisions.refused", getattr(args, "id", None) or " ".join(args.ids),
                                {"caller": name, "role": role, "action": action})
            sys.stderr.write("%s: only the Chief of Staff, or you in a plain shell, may %s a decision; %s is %s. "
                             "Raise it with `%s report question \"...\"` and your awaiting-cos label\n"
                             % (PROG, action, name, "a %s" % role if role else "not given a role", PROG))
            return EXIT_USAGE
        if action == "supersede":
            code = cmd_decision_supersede(args, engine, decisions, name, runner)
            try:
                send_poke(state_dir_path())
            except Exception:
                pass
            return code
        decision = decision_by_id(decisions, args.id)
        if decision is None:
            raise DecisionError("no decision %s is waiting (see `%s decisions --tier all`)" % (args.id, PROG))
        if action == "escalate":
            line = escalate_decision(engine, runner, decision, args.reason, name)
        elif action == "resolve":
            line = resolve_decision(engine, runner, decision, args.note, name)
        elif decision["kind"] == "issue" and decision.get("rows"):
            line = answer_batch(engine, runner, decision, args, name)
        elif args.as_recommended or args.row:
            raise DecisionError("%s is not a batch: --as-recommended and --row answer a batch; answer this with its "
                                "own value" % args.id)
        elif args.value is None:
            raise DecisionError("answer %s with a value: `allow` or `deny` for a permission request, the text for a "
                                "question" % args.id)
        else:
            line = answer_decision(engine, decision, args.value, args.note, name)
    except (DecisionError, CallerError) as err:
        sys.stderr.write("%s: %s\n" % (PROG, _one_line(str(err), 400)))
        return EXIT_USAGE
    print(line)
    try:
        send_poke(state_dir_path())  # the daemon looks again now; a miss is harmless
    except Exception:
        pass
    return EXIT_OK


# ---- labels ensure

LABEL_SPECS = (("orchestrator", "5319e7", "A charter: an orchestrator's standing job"),
               ("awaiting-cos", "fbca04", "Waiting on the Chief of Staff: it resolves or escalates"),
               ("awaiting-user", "d93f0b", "Waiting on the owner: the fleet's only blocking channel"))


def label_names(config):
    return {"orchestrator": orchestrator_label(config), "awaiting-cos": awaiting_cos_label(config),
            "awaiting-user": awaiting_label(config)}


def ensure_labels(engine, runner, repo):
    """Create the three labels the fleet uses in `repo`, each with the repo's own gh account, unless they exist.
    Returns {label: "created" | "already there"}. Idempotent."""
    names = label_names(engine.config)
    made = {}
    for key, color, text in LABEL_SPECS:
        label = names[key]
        existing = _gh_write(engine, runner, repo, "repos/%s/labels/%s" % (repo, quote(label, safe="")), "GET",
                             tolerate_missing=True)
        if existing.returncode == 0:
            made[label] = "already there"
            continue
        with engine._external("labels.create", "label:%s:%s" % (repo, label), {"repo": repo, "label": label}):
            _gh_write(engine, runner, repo, "repos/%s/labels" % repo, "POST",
                      {"name": label, "color": color, "description": text})
        made[label] = "created"
    return made


def cmd_labels(args, runner, now):
    engine, _, _ = build_engine(runner, now, "cli")
    if args.repo is not None and not REPO_RE.match(args.repo):
        sys.stderr.write("%s: --repo must be OWNER/REPO, got %r\n" % (PROG, args.repo))
        return EXIT_USAGE
    repos = [args.repo] if args.repo else decision_repos(engine)
    if not repos:
        sys.stderr.write("%s: no repo is watched: name one with --repo OWNER/REPO, or add it to github_repos\n" % PROG)
        return EXIT_USAGE
    failed = False
    for repo in repos:
        try:
            made = ensure_labels(engine, runner, repo)
        except IntentError as err:
            sys.stderr.write("%s: %s: %s\n" % (PROG, repo, _one_line(str(err), 300)))
            failed = True
            continue
        for label, what in made.items():
            print("%s  %s  %s" % (repo, label, what))
    return EXIT_ERROR if failed else EXIT_OK


# ---- orders --cos

def cmd_orders_cos(args):
    try:
        found = read_cos_orders(load_config())
    except CosOrdersError as err:
        sys.stderr.write("%s: %s\n" % (PROG, _one_line(str(err), 400)))
        return EXIT_ERROR
    if not found["exists"]:
        print("none: there is no standing-orders file at %s (`%s install` makes a template; edit it in an editor)"
              % (found["path"], PROG))
        return EXIT_OK
    print("The Chief of Staff's standing orders: %s (%d bytes, modified %s)" % (
        found["path"], found["size"], iso(found["mtime"])))
    print()
    print(found["raw"].rstrip("\n"))
    return EXIT_OK


def add_decision_parsers(sub):
    """`decisions [list]`, `decisions escalate|resolve|answer`, and `labels ensure`."""
    decisions = sub.add_parser(
        "decisions", help="What waits on a decision: list it by view, or escalate, resolve or answer one",
        description="Decisions have tiers. An orchestrator never goes straight to you: it raises a decision to the "
                    "Chief of Staff (`report question` and the awaiting-cos label), which resolves it with your "
                    "standing orders or escalates it (the awaiting-user label). `decisions [list]` prints the "
                    "open ones: the issues with either label, the permission requests and questions of every "
                    "fleet agent, and the questions and blocks workers reported that nobody has answered. The "
                    "view depends on who asks (you are identified by your pane): the Chief of Staff sees every "
                    "repo and tier; an orchestrator its own repo, every tier; anyone else only the human tier. "
                    "--repo and --tier override. It says which view it printed. By default it reads "
                    "decisions.json, which the daemon rewrites when the list changes; a file older than %d s is "
                    "said to be stale, never shown as current. `escalate`, `resolve` and `answer` are for the "
                    "Chief of Staff (or you, in a plain shell)." % DECISIONS_STALE_SECONDS)
    add_decision_list_flags(decisions)
    kinds = decisions.add_subparsers(dest="decisions_action", required=False)
    listing = kinds.add_parser("list", help="The open decisions in your view (the default)")
    add_decision_list_flags(listing, suppress=True)
    escalate = kinds.add_parser("escalate", help="Move a decision to the owner (the awaiting-user label, or at once "
                                                 "for a permission request or question). Not judged")
    escalate.add_argument("id", help="The decision's id")
    escalate.add_argument("--reason", help="One line, posted as a comment on the issue, signed as you")
    escalate.add_argument("--from", dest="sender", help="Lab only: the caller's fleet name")
    batch = kinds.add_parser("batch", help="Raise related findings as ONE decision: one issue in your own repo, "
                                           "labelled for the Chief of Staff, one row per finding")
    batch.add_argument("--title", required=True, help="One line: what the batch is about")
    batch.add_argument("--row", action="append", metavar="ROW", help="`<repo#N> | <finding> | <recommendation>`; "
                                                                   "repeat it, at most %d rows" % BATCH_ROWS_MAX)
    batch.add_argument("--file", help="Rows, one per line, from this file (`-` for stdin; with no --row and no "
                                      "--file, piped stdin)")
    batch.add_argument("--from", dest="sender", help="Lab only: the caller's fleet name")
    supersede = kinds.add_parser("supersede", help="Mark several open decisions superseded by one issue. An issue "
                                                   "decision: a comment and both labels off; a report: your `send` "
                                                   "to its worker. Judged like `resolve`")
    supersede.add_argument("ids", nargs="+", metavar="id", help="The decisions' ids")
    supersede.add_argument("--by", required=True, metavar="ISSUE", help="The superseding issue: owner/repo#N, name#N "
                                                                       "for a watched repo, or its URL")
    supersede.add_argument("--note", help="One line, added to each comment and send")
    supersede.add_argument("--from", dest="sender", help="Lab only: the caller's fleet name")
    resolve = kinds.add_parser("resolve", help="Take both awaiting labels off a decision's issue: it is settled. "
                                               "Judged against the Chief of Staff's standing orders")
    resolve.add_argument("id", help="The decision's id")
    resolve.add_argument("--note", help="One line, posted as a comment on the issue, signed as you")
    resolve.add_argument("--from", dest="sender", help="Lab only: the caller's fleet name")
    answer = kinds.add_parser("answer", help="Answer an agent's pending permission request (allow|deny) or question "
                                             "(the answer's text) through v2, or a batch (--as-recommended, --row). Judged against the Chief of Staff's "
                                             "standing orders")
    answer.add_argument("id", help="The decision's id")
    answer.add_argument("value", nargs="?", help="`allow` or `deny` for a permission request; the text for a question "
                                                 "(a batch takes --as-recommended or --row instead)")
    answer.add_argument("--as-recommended", action="store_true", help="A batch: every row as recommended")
    answer.add_argument("--row", action="append", metavar="N=CHOICE", help="A batch: row N (from 1) answered CHOICE; "
                                                                         "repeat it. Rows not named keep their "
                                                                         "recommendation")
    answer.add_argument("--note", help="One line: the order that covers it (a batch: part of the answer's comment)")
    answer.add_argument("--from", dest="sender", help="Lab only: the caller's fleet name")
    labels = sub.add_parser("labels", help="Create the fleet's labels in the watched repos",
                            description="`labels ensure` creates the labels the fleet uses, each with the repo's own "
                                        "gh account, unless they exist: <user>:orchestrator, <user>:awaiting-cos and "
                                        "<user>:awaiting-user. Idempotent. Run it when a repo joins.")
    actions = labels.add_subparsers(dest="labels_action", required=True)
    ensure = actions.add_parser("ensure", help="Create the missing labels (every watched repo by default)")
    ensure.add_argument("--repo", metavar="OWNER/REPO", help="Only this repo")


def add_decision_list_flags(parser, suppress=False):
    given = {"default": argparse.SUPPRESS} if suppress else {}
    parser.add_argument("--repo", metavar="OWNER/REPO", help="Only this repo's decisions", **given)
    parser.add_argument("--tier", choices=DECISION_TIERS + ("all",), help="Only this tier: cos, human or "
                                                                          "orchestrator; all for every tier", **given)
    parser.add_argument("--json", action="store_true", help="Emit the list as JSON (with `stale` and `view`)", **given)
    parser.add_argument("--fresh", action="store_true", help="Derive the list now instead of reading the file", **given)
    parser.add_argument("--watch", action="store_true", help="Redraw when the list changes, until Ctrl-C (a "
                                                            "fallback for a terminal without the TUI plugin)", **given)
    parser.add_argument("--from", dest="sender", help="Lab only: the caller's fleet name", **given)


if __name__ == "__main__":
    sys.exit(main())
