#!/usr/bin/env python3
"""fleet-switchboard — routes facts to fleet agents as OpenCode v2 messages.

Configuration, the private state directory, the one client for OpenCode v2
(`opencode api`), the one client for herdr, the audit log, fault gating for
the Lab, the derived message id, and the delivery engine: each pass observes
the fleet, derives what is pending (facts minus the keys already in each
recipient's transcript or inbox), decides note, wake, wait or hold by the
delivery rule, and delivers. See docs/switchboard.md, "Delivery rule".

    fleet-switchboard run [--once]          the daemon, or one pass
    fleet-switchboard ensure                start the daemon if it is not running
    fleet-switchboard poke                  ask the daemon for a pass now
    fleet-switchboard launch <name> ...     a new fleet agent in its own herdr tab
    fleet-switchboard send <name> <text>    deliver to another agent now
    fleet-switchboard pending <name>        what is pending, and why it waits
    fleet-switchboard remind <name> <when> <text>   a message due later
    fleet-switchboard status                config, clients, fleet agents
    fleet-switchboard intent <issue>        the ask's Intent and Done-when (PR 6)
    fleet-switchboard intents               your open asks, one line each (PR 6)
    fleet-switchboard decisions             what waits on you, one line each, read-only (PR 14)

Rules this file keeps from the start:

  1. herdr is never a delivery channel. HerdrClient reads agents and panes,
     sets a sidebar token, shows a toast, opens a tab that runs a program
     directly (no shell, nothing typed) and closes a pane `launch` itself
     opened. It has no way to type into a pane or to move focus, and a hygiene
     test scans this file to keep it that way.
  2. Every v2 call goes through one method, V2Client._call, which builds the
     argv and runs the configured binary with the configured environment. The
     v2 binary is reached only through a wrapper that isolates its data.
  3. Every write to another system is audited twice: the intent before the
     call and the result after it, including when the call raised.
  4. No secret is ever written to the audit log; values under credential-like
     key names are redacted before a line is written.
  5. Nothing about delivery is stored. Pending is derived on every pass, and
     a key found in the recipient's transcript or v2 inbox is never delivered
     again (docs/switchboard.md, Invariants 1 and 2).

Python 3.9+, standard library only.
"""
import argparse
from contextlib import contextmanager
from datetime import datetime, timezone
import fcntl
import getpass
import hashlib
import hmac
import importlib.util
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import json
import math
import os
from pathlib import Path
import re
import secrets
import select
import shlex
import shutil
import signal
import socket
import stat
import subprocess
import sys
import tempfile
import threading
import time
import types
from urllib.parse import quote
import uuid


def load_decision_core():
    """The pure core of the Decision subsystem, bin/decision_core.py, loaded by path from beside this file.

    Not by `import`: this file has no .py name, is run through a symlink (~/.local/bin), by the daemon's service
    unit, by wrappers, and is loaded by tests with SourceFileLoader, and none of those puts its directory on
    sys.path. The real path of this file (symlinks resolved) is always right. A copy already loaded from the
    same file is reused, so two loads of this script share one module."""
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "decision_core.py")
    held = sys.modules.get("decision_core")
    if held is not None and os.path.realpath(getattr(held, "__file__", "") or "") == path:
        return held
    spec = importlib.util.spec_from_file_location("decision_core", path)
    module = importlib.util.module_from_spec(spec)
    sys.modules["decision_core"] = module
    try:
        spec.loader.exec_module(module)
    except BaseException:
        sys.modules.pop("decision_core", None)
        raise
    return module


decision_core = load_decision_core()


def load_external_adapter():
    """The generic external adapter, bin/external_adapter.py, loaded by path from beside this file, the way
    load_decision_core loads the core. Called only when an external decision system is switched on and names this
    adapter: while it is off the file is never read or imported."""
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "external_adapter.py")
    held = sys.modules.get("external_adapter")
    if held is not None and os.path.realpath(getattr(held, "__file__", "") or "") == path:
        return held
    spec = importlib.util.spec_from_file_location("external_adapter", path)
    module = importlib.util.module_from_spec(spec)
    sys.modules["external_adapter"] = module
    try:
        spec.loader.exec_module(module)
    except BaseException:
        sys.modules.pop("external_adapter", None)
        raise
    return module


