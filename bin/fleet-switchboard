def _declared_listing(directory):
    """[(module name, path, mtime, size)] of the `*.py` files directly in `directory` (no recursion, regular files, plain module names)."""
    out = []
    for entry in sorted(os.scandir(directory), key=lambda e: e.name):
        stem = entry.name[:-3]
        if entry.name.endswith(".py") and re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", stem) and entry.is_file(follow_symlinks=False):   # a symlink is never read
            info = entry.stat()
            out.append((stem, entry.path, info.st_mtime_ns, info.st_size))
    return out


def _declared_key(data):
    """The key a module's source declares with a top-level `CONFIG_KEY = "<key>"` (read with `ast`, so quotes, spacing and indentation of the line do not matter;
    an annotation is allowed), or None. A file that does not parse falls back to the text of the line, so a broken declaring module is still SEEN (and then refused
    when it is loaded), never silently skipped."""
    try:
        declared = None
        for node in ast.parse(data).body:   # the LAST top-level assignment is the one the module ends up holding
            targets = node.targets if isinstance(node, ast.Assign) else [node.target] if isinstance(node, ast.AnnAssign) else []
            if any(isinstance(t, ast.Name) and t.id == "CONFIG_KEY" for t in targets):
                value = getattr(node, "value", None)
                declared = value.value if isinstance(value, ast.Constant) and isinstance(value.value, str) else ""
        return declared
    except (SyntaxError, ValueError, RecursionError):
        found = CONFIG_DECLARATION_TEXT.search(data)
        return found.group(1).decode("utf-8", "replace") if found else None


def config_declarations():
    """{key: module name} for the modules of the bin directory that declare a configuration key with a `CONFIG_KEY = "<key>"` line (and then
    `CONFIG_DEFAULT` and `validate(value, source)`): a new module with a key needs no line in the shared key set or the validation chain.
    Reads only the `*.py` files directly in the bin directory beside this program; a key declared twice, or one the shared defaults own, is a ConfigError."""
    directory = CONFIG_DECLARATIONS_DIR or os.path.dirname(os.path.realpath(__file__))
    try:
        listing = _declared_listing(directory)
    except OSError as err:
        raise ConfigError("the module directory %s cannot be read (%s): no configuration is loaded" % (directory, err.strerror or err)) from None
    cached = _DECLARED_CACHE.get(directory)
    if cached is not None and cached[0] == listing:
        return _meets_floor(dict(cached[1]))
    shared = set(DEFAULTS) | set(PR7_CONFIG_KEYS) | TOP_LEVEL_EXTRA_KEYS
    found = {}
    for name, path, _, _ in listing:
        try:
            with open(path, "rb") as handle:
                declared = _declared_key(handle.read(CONFIG_READ_BYTES))
        except OSError as err:
            raise ConfigError("config module %s.py cannot be read (%s): no configuration is loaded" % (name, err.strerror or err)) from None
        if declared is None:
            continue
        key = declared
        if not CONFIG_KEY_FORM.fullmatch(key):
            raise ConfigError("config module %s.py declares an invalid configuration key %r (lowercase letters, digits and underscores): no configuration is loaded" % (name, _one_line(key, 40)))
        if key in shared:
            raise ConfigError("config key %r is declared by %s.py and is also owned by the shared defaults" % (key, name))
        if key in found:
            raise ConfigError("config key %r is declared by two modules: %s.py and %s.py" % (key, found[key], name))
        found[key] = name
    _DECLARED_CACHE[directory] = (listing, dict(found))
    return _meets_floor(found)


def _meets_floor(found):
    """`found` once every key of CONFIG_MUST_DECLARE is declared by its module (checked on every call, cached or not)."""
    for key, name in sorted(CONFIG_MUST_DECLARE.items()):
        if found.get(key) != name:
            raise ConfigError("config key %r must be declared by %s.py, and it is not (the module is missing, its CONFIG_KEY line is missing or damaged, or it names another key): "
                              "no configuration is loaded" % (key, name))
    return found


def _declared_module(name, key):
    """The module that declares a key, loaded by the generic loader (a test's directory: by path). A module that fails to load, whose own `CONFIG_KEY` is not the
    key the scan read, or that has no `validate`, fails the WHOLE configuration naming its file: a daemon never runs on a partial configuration."""
    try:
        if CONFIG_DECLARATIONS_DIR is None:
            return load_module(name)
        spec = importlib.util.spec_from_file_location("declared_" + name, os.path.join(CONFIG_DECLARATIONS_DIR, name + ".py"))
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
    except Exception as err:
        raise ConfigError("config module %s.py declares a configuration key but cannot be loaded (%s: %s): no configuration is loaded"
                          % (name, type(err).__name__, _one_line(str(err), 160))) from None
    if getattr(module, "CONFIG_KEY", None) != key:
        raise ConfigError("config module %s.py declares the key %r in its text but its CONFIG_KEY is %r: no configuration is loaded"
                          % (name, key, getattr(module, "CONFIG_KEY", None)))
    if not callable(getattr(module, "validate", None)):
        raise ConfigError("config module %s.py declares the key %r but has no validate(value, source): no configuration is loaded" % (name, key))
    return module


def config_known_keys():
    return sorted(set(DEFAULTS) | set(PR7_CONFIG_KEYS) | TOP_LEVEL_EXTRA_KEYS | set(config_declarations()))


def warn_unknown_config(message, section="", names=(), known=()):
    """A key this tool does not read is WARNED about (once per message per process), never refused: a newer config must not break an older
    CLI (a worktree branched before a key existed). A wrong TYPE or value on a key it does read still refuses. The key is also remembered with
    the nearest known key (a likely typo), so `status` can show it: a warning on stderr alone is easy to miss in a daemon."""
    for name in names:
        close = difflib.get_close_matches(str(name), [str(k) for k in known], n=1, cutoff=0.6)
        UNKNOWN_CONFIG[(section, str(name))] = close[0] if close else None
    if message not in _WARNED_CONFIG:
        _WARNED_CONFIG.add(message)
        sys.stderr.write("%s: warning: %s (ignored)\n" % (PROG, message))


def unknown_config_lines():
    """One line per unknown key seen while loading the config: `<section.>key (did you mean <nearest>?)`."""
    lines = []
    for (section, name), close in sorted(UNKNOWN_CONFIG.items()):
        where = "%s.%s" % (section, name) if section else name
        lines.append("%s is not read by this tool%s" % (where, " (did you mean %s?)" % close if close else ""))
    return lines


def validate_config(raw, source="config"):
    """Defaults overlaid with `raw`, fully checked. Raises ConfigError."""
    if not isinstance(raw, dict):
        raise ConfigError("%s must be a JSON object" % source)
    declared = config_declarations()
    unknown = sorted(set(raw) - set(DEFAULTS) - set(PR7_CONFIG_KEYS) - TOP_LEVEL_EXTRA_KEYS - set(declared))
    if unknown:
        warn_unknown_config(
            "%s contains key(s) this tool does not read: %s" % (source, ", ".join(unknown)), '', unknown, config_known_keys())
    config = dict(DEFAULTS)
    config["opencode_env"], config["launch_env"] = {}, {}
    config.update(raw)
    opencode = config["opencode"]
    if opencode is not None and (not isinstance(opencode, str) or not os.path.isabs(opencode)):
        raise ConfigError("%s: 'opencode' must be the absolute path of the OpenCode v2 binary, got %r"
                          % (source, opencode))
    if not isinstance(config["herdr"], str) or not config["herdr"].strip():
        raise ConfigError("%s: 'herdr' must be a non-empty string (a path or a command name), got %r"
                          % (source, config["herdr"]))
    if config["send_to_working"] not in ("steer", "queue"):
        raise ConfigError("%s: 'send_to_working' must be \"steer\" or \"queue\", got %r"
                          % (source, config["send_to_working"]))
    if config["launch_default"] not in ("headless", "terminal"):
        raise ConfigError("%s: 'launch_default' must be \"headless\" or \"terminal\", got %r" % (source, config["launch_default"]))
    executable = config["opencode_executable"]
    if executable is not None and (not isinstance(executable, str) or not os.path.isabs(executable)):
        raise ConfigError("%s: 'opencode_executable' must be an absolute path, got %r" % (source, executable))
    envs = {}
    for key in ("opencode_env", "launch_env"):
        env = config[key]
        if not isinstance(env, dict):
            raise ConfigError("%s: %r must be an object of NAME: value strings, got %r"
                              % (source, key, type(env).__name__))
        for name, value in env.items():
            if not re.match(r"^[A-Za-z_][A-Za-z0-9_]*$", name):
                raise ConfigError("%s: %r has an invalid variable name: %r" % (source, key, name))
            if not isinstance(value, str):
                raise ConfigError("%s: %r value for %s must be a string" % (source, key, name))
        envs[key] = dict(env)
    validate_disk_guard(config["disk_guard"], source)
    try:
        load_reds().settings(config["reds"])
    except ValueError as err:
        raise ConfigError("%s: %s" % (source, err)) from None
    try:
        load_heavy_slots().settings(config["heavy"])
    except Exception as err:
        raise ConfigError("%s: %s" % (source, err)) from None
    try:
        load_cpu_guard().validate(config["cpu_guard"], source)
    except ValueError as err:
        raise ConfigError(str(err))
    for key, name in sorted(declared.items(), key=lambda item: item[1]):   # the modules that declare their own key: its default, then its validator
        module = _declared_module(name, key)
        default = getattr(module, "CONFIG_DEFAULT", None)
        if key not in raw and default is not None:
            config[key] = copy.deepcopy(default)
        try:
            module.validate(config.get(key), source)
        except ValueError as err:
            raise ConfigError(str(err)) from None
        except Exception as err:   # a validator that fails any other way is a broken module, not a bad value: still the whole configuration, naming the file
            raise ConfigError("config module %s.py: its validator failed (%s: %s): no configuration is loaded" % (name, type(err).__name__, _one_line(str(err), 160))) from None
    if not isinstance(config["no_multiplexer"], bool):
        raise ConfigError("%s: 'no_multiplexer' must be true or false, got %r" % (source, config["no_multiplexer"]))
    if not isinstance(config["docker_reaper"], bool):
        raise ConfigError("%s: 'docker_reaper' must be true or false, got %r" % (source, config["docker_reaper"]))
    if config["v2_events"] not in ("auto", "off"):
        raise ConfigError("%s: 'v2_events' must be \"auto\" or \"off\", got %r" % (source, config["v2_events"]))
    if config["v2_plugin_events"] not in ("auto", "off"):
        raise ConfigError("%s: 'v2_plugin_events' must be \"auto\" or \"off\", got %r" % (source, config["v2_plugin_events"]))
    if not isinstance(config["v2_light"], bool):
        raise ConfigError("%s: 'v2_light' must be true or false, got %r" % (source, config["v2_light"]))
    if config["v2_transport"] not in ("auto", "cli"):
        raise ConfigError("%s: 'v2_transport' must be \"auto\" or \"cli\", got %r" % (source, config["v2_transport"]))
    for key in ("v2_cache_seconds", "v2_reads_per_pass", "v2_reads_per_minute"):
        if not isinstance(config[key], int) or isinstance(config[key], bool) or config[key] < 0:
            raise ConfigError("%r must be a whole number of at least 0, got %r" % (key, config[key]))
    if not _is_number(config["clear_remind_minutes"]) or config["clear_remind_minutes"] <= 0:
        raise ConfigError("%r must be a number above 0, got %r" % ("clear_remind_minutes", config["clear_remind_minutes"]))
    for key in ("batch_seconds", "engaged_minutes", "call_timeout_seconds", "send_timeout_seconds", "poll_seconds",
                "worker_lookback_hours", "stalled_working_hours", "review_window_minutes", "rider_max_age_seconds"):
        if not _is_number(config[key]) or config[key] <= 0:
            raise ConfigError("%s: %r must be a positive number, got %r" % (source, key, config[key]))
    if not isinstance(config["herdr_log"], str) or not config["herdr_log"].strip():
        raise ConfigError("%s: 'herdr_log' must be a non-empty path, got %r" % (source, config["herdr_log"]))
    if not _is_number(config["pane_exit_burst_seconds"]) or not 0 < config["pane_exit_burst_seconds"] <= 3600:
        raise ConfigError("%s: 'pane_exit_burst_seconds' must be a number above 0 and at most 3600, got %r" % (source, config["pane_exit_burst_seconds"]))
    if not isinstance(config["pane_exit_burst_min"], int) or isinstance(config["pane_exit_burst_min"], bool) or not 2 <= config["pane_exit_burst_min"] <= 1000:
        raise ConfigError("%s: 'pane_exit_burst_min' must be a whole number from 2 to 1000, got %r" % (source, config["pane_exit_burst_min"]))
    if not retire_idle_window_ok(config["retire_idle_minutes"]):
        raise ConfigError("%s: 'retire_idle_minutes' must be a finite number from %d to %d, got %r" % (source, RETIRE_IDLE_MIN, RETIRE_IDLE_MAX, config["retire_idle_minutes"]))
    validate_intent_config(config, source)
    validate_v1_move_config(config, source)  # PR 10
    _validate_github(config, source)
    config.update(envs)
    validate_jev_config(config, raw, source)
    validate_foreground_config(config, source)  # PR 8
    validate_policy_config(config, source)  # PR 9
    validate_report_triage_config(config, source)  # PR 13
    validate_decisions_config(config, source)  # PR 14
    validate_external_config(config, source)
    validate_friction_config(config, source)
    validate_blocked_alert_config(config, source)
    validate_load_alert_config(config, source)
    validate_source_budgets(config, source)   # #494
    validate_worktree_config(config, source)
    validate_orphan_config(config, source)
    validate_order_burst(config, source)
    if config.get("impact_hold") is not None:   # #179 L4: the hold is off unless `enabled` is true
        try:
            impact_floor.validate_hold_config(config["impact_hold"])
        except ValueError as err:
            raise ConfigError("%s: %s" % (source, err)) from None
    validate_sweep_config(config, source)  # #117
    validate_triage_config(config, source)  # #130
    validate_plan_evaluators(config, source)  # #107: who may record a plan scenario's verdict
    validate_plan_gates_config(config, source)  # #107 slice 3a
    validate_plan_review_config(config, source)  # #109 part 2, R2
    validate_hold_labels_config(config, source)  # #376
    validate_app_config(config, source)  # #609
    return config


PLAN_REVIEW_DEFAULTS = {"enabled": False, "lane_timeout_seconds": 900, "max_parallel": 3, "session_cap": 24, "starts_per_day": 3,
                        "held_globs": [], "lane_agent": "plan-reviewer", "dir": None, "workspace": None, "escalation_hours": 24}


def validate_plan_review_config(config, source):
    """`plan_review`: absent means off. `enabled` (default false: every `plan review` command refuses), `lane_timeout_seconds`,
    `max_parallel` (lanes launched at once), `session_cap` (lane sessions per lineage since its last consensus), `starts_per_day` (per
    caller), `held_globs` (path globs that force a full review), `lane_agent`, and `dir` and `workspace` for the lane sessions."""
    raw = config.get("plan_review")
    if raw is None:
        config.pop("plan_review", None)
        return
    if not isinstance(raw, dict) or set(raw) - set(PLAN_REVIEW_DEFAULTS):
        raise ConfigError("%s: 'plan_review' must be an object with only %s" % (source, ", ".join(sorted(PLAN_REVIEW_DEFAULTS))))
    out = dict(PLAN_REVIEW_DEFAULTS, **raw)
    if not isinstance(out["enabled"], bool):
        raise ConfigError("%s: 'plan_review.enabled' must be true or false" % source)
    for key, low, high in (("lane_timeout_seconds", 60, 7200), ("max_parallel", 1, 6), ("session_cap", 2, 200), ("starts_per_day", 1, 50),
                           ("escalation_hours", 1, 720)):
        if not isinstance(out[key], int) or isinstance(out[key], bool) or not low <= out[key] <= high:
            raise ConfigError("%s: 'plan_review.%s' must be a whole number from %d to %d" % (source, key, low, high))
    if not isinstance(out["held_globs"], list) or not all(isinstance(g, str) and g and len(g) <= 200 for g in out["held_globs"]):
        raise ConfigError("%s: 'plan_review.held_globs' must be a list of path globs" % source)
    if not isinstance(out["lane_agent"], str) or not NAME_RE.match(out["lane_agent"]):
        raise ConfigError("%s: 'plan_review.lane_agent' must be an agent name" % source)
    for key in ("dir", "workspace"):
        if out[key] is not None and not isinstance(out[key], str):
            raise ConfigError("%s: 'plan_review.%s' must be text" % (source, key))
    config["plan_review"] = out


def validate_hold_labels_config(config, source):
    """`hold_labels`: per repository, the label the gh shim holds a pull request by (shims/gh_hold.py reads it live from this file). Absent means none."""
    if config.get("hold_labels") is None:
        config.pop("hold_labels", None)
        return
    path = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "shims", "gh_hold.py")
    spec = importlib.util.spec_from_file_location("gh_hold_check", path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    try:
        module.validate_config(config["hold_labels"])
    except ValueError as err:
        raise ConfigError("%s: %s" % (source, err)) from None


def validate_app_config(config, source):
    """`app_installations` and its key, permission and endpoint settings: the repositories whose gh and git calls use a GitHub App installation token (shims/app_mint.py
    reads them live from this file). The shim's own loader judges them, so a config the shim would refuse is refused here: this kit's own repository, a wildcard, a
    permission beyond the allowed set, no key source. All absent means the feature is off."""
    keys = ("app_installations", "app_key_path", "app_key_command", "app_permissions", "app_api_base")
    if all(config.get(k) is None for k in keys):
        for key in keys:
            config.pop(key, None)
        return
    path = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "shims", "app_mint.py")
    spec = importlib.util.spec_from_file_location("app_mint_check", path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    try:
        module.load_config(config)
    except module.ConfigError as err:
        raise ConfigError("%s: %s" % (source, err)) from None


def validate_plan_gates_config(config, source):
    """`plan_gates`: absent means no repo is opted in. See plan_ledger.validate_plan_gates."""
    if config.get("plan_gates") is None:
        config.pop("plan_gates", None)
        return
    try:
        config["plan_gates"] = plan_ledger.validate_plan_gates(config["plan_gates"], source)
        for name, entry in config["plan_gates"]["repos"].items():   # #770: `item_checks` is declared by its own module; absent means none accepted
            if "item_checks" in entry:
                entry["item_checks"] = load_module("item_verdicts").validate_item_checks(entry["item_checks"], "%s: 'plan_gates.repos.%s'" % (source, name))
    except ValueError as err:
        raise ConfigError(str(err)) from None


PLAN_EVALUATOR_KINDS = ("ci", "tester", "reviewer", "owner")


def validate_plan_evaluators(config, source):
    """`plan_evaluators`: absent or {} means no agent may record any verdict (the safe default). Otherwise an object
    of evaluator (ci|tester|reviewer|owner) -> a list of fleet agent names."""
    raw = config.get("plan_evaluators")
    if raw is None:
        config.pop("plan_evaluators", None)
        return
    if not isinstance(raw, dict):
        raise ConfigError("%s: 'plan_evaluators' must be an object of evaluator -> agent names, got %r" % (source, type(raw).__name__))
    unknown = sorted(set(raw) - set(PLAN_EVALUATOR_KINDS))
    if unknown:
        raise ConfigError("%s: 'plan_evaluators' names no evaluator %s (known: %s)" % (source, ", ".join(map(repr, unknown)),
                                                                                    ", ".join(PLAN_EVALUATOR_KINDS)))
    for kind, names in raw.items():
        if not isinstance(names, list) or not all(isinstance(n, str) and NAME_RE.match(n) for n in names):
            raise ConfigError("%s: 'plan_evaluators.%s' must be a list of fleet agent names" % (source, kind))


def validate_external_config(config, source):
    """`external_decisions`: None or {} is off. Checked like every other key; filled with EXTERNAL_DEFAULTS."""
    if "external_decisions" not in config:
        return   # off: the key is absent from a config that never named it, so nothing about it exists
    raw = config["external_decisions"]
    if raw is None:
        raw = {}
    if not isinstance(raw, dict):
        raise ConfigError("%s: 'external_decisions' must be an object, got %r" % (source, type(raw).__name__))
    unknown = sorted(set(raw) - set(EXTERNAL_DEFAULTS))
    if unknown:
        warn_unknown_config("%s: 'external_decisions' has key(s) this tool does not read: %s" % (source, ", ".join(unknown)), 'external_decisions', unknown, list(EXTERNAL_DEFAULTS))
    section = dict(EXTERNAL_DEFAULTS, **raw)
    where = "%s: 'external_decisions" % source
    if not isinstance(section["enabled"], bool):
        raise ConfigError("%s.enabled' must be true or false, got %r" % (where, section["enabled"]))
    if section["adapter"] is not None and (not isinstance(section["adapter"], str)
                                           or not re.match(r"^[a-z][a-z0-9_-]{0,40}$", section["adapter"])):
        raise ConfigError("%s.adapter' must be a lower-case adapter name, got %r" % (where, section["adapter"]))
    repos = section["repos"]
    if not isinstance(repos, list) or not all(isinstance(r, str) and GITHUB_REPO_RE.match(r) for r in repos):
        raise ConfigError("%s.repos' must be a list of OWNER/REPO names, got %r" % (where, repos))
    kinds = section["kinds"]
    if not isinstance(kinds, list) or not kinds or not all(k in ("issue", "report", "question") for k in kinds):
        raise ConfigError("%s.kinds' must be a list of issue, report or question (a permission request never goes "
                          "out), got %r" % (where, kinds))
    mapping = section["mapping_file"]
    if mapping is not None and (not isinstance(mapping, str) or not os.path.isabs(mapping)):
        raise ConfigError("%s.mapping_file' must be an absolute path, got %r" % (where, mapping))
    tiers = section["tier_map"]
    if tiers is not None:
        if (not isinstance(tiers, dict) or set(tiers) != set(decision_core.TIER_LADDER)
                or not all(isinstance(v, str) and v.strip() for v in tiers.values())):
            raise ConfigError("%s.tier_map' must name a floor tier (a non-empty string) for each of %s, got %r"
                              % (where, ", ".join(decision_core.TIER_LADDER), tiers))
    pushed = section["tiers"]
    if (not isinstance(pushed, list) or not all(isinstance(t, str) and t in decision_core.TIER_LADDER for t in pushed)
            or len(set(pushed)) != len(pushed)):
        raise ConfigError("%s.tiers' must be a list of tier names, each once, from %s (an empty list pushes nothing), got %r"
                          % (where, ", ".join(decision_core.TIER_LADDER), pushed))
    for key in ("poll_seconds", "retry_base_seconds", "retry_max_seconds"):
        if not _is_number(section[key]) or section[key] <= 0:
            raise ConfigError("%s.%s' must be a positive number, got %r" % (where, key, section[key]))
    if not isinstance(section["work_items"], bool):
        raise ConfigError("%s.work_items' must be true or false, got %r" % (where, section["work_items"]))
    if not _is_number(section["work_grace_seconds"]) or section["work_grace_seconds"] <= 0:
        raise ConfigError("%s.work_grace_seconds' must be a positive number, got %r" % (where, section["work_grace_seconds"]))
    if not isinstance(section["work_outbox_alarm_depth"], int) or isinstance(section["work_outbox_alarm_depth"], bool) \
            or section["work_outbox_alarm_depth"] < 1:
        raise ConfigError("%s.work_outbox_alarm_depth' must be a whole number of 1 or more, got %r"
                          % (where, section["work_outbox_alarm_depth"]))
    if section["retry_max_seconds"] < section["retry_base_seconds"]:
        raise ConfigError("%s.retry_max_seconds' must be at least retry_base_seconds" % where)
    depth = section["outbox_alarm_depth"]
    if not isinstance(depth, int) or isinstance(depth, bool) or depth < 1:
        raise ConfigError("%s.outbox_alarm_depth' must be a whole number of 1 or more, got %r" % (where, depth))
    if section["enabled"]:
        for key in ("adapter", "mapping_file", "tier_map"):
            if section[key] is None:
                raise ConfigError("%s.%s' is required when external_decisions is enabled" % (where, key))
        if not repos:
            raise ConfigError("%s.repos' must name at least one repo when external_decisions is enabled" % where)
    if section["enabled"] and section["mapping_file"] and load_module("repo_exclusion").az_without_subscription(section["mapping_file"]):
        message = load_module("repo_exclusion").AZ_WARNING
        if message not in _WARNED_CONFIG:   # once per process
            _WARNED_CONFIG.add(message)
            sys.stderr.write("%s: warning: %s\n" % (PROG, message))
    config["external_decisions"] = section


def load_config(path=None):
    """Read config.json. A missing file means every default applies."""
    path = Path(path) if path else config_path()
    try:
        text = path.read_text()
    except FileNotFoundError:
        return validate_config({}, str(path))
    except OSError as err:
        raise ConfigError("cannot read %s: %s" % (path, err.strerror or err))
    try:
        raw = json.loads(text)
    except ValueError as err:
        raise ConfigError("%s is not valid JSON: %s" % (path, err))
    return validate_config(raw, str(path))


# ------------------------------------------------------------------- the state

def ensure_state_dir(path=None):
    """Create the state directory with mode 0700, or check the existing one.

    It holds the audit log, which records who was sent what. A directory that
    someone else owns, or that the group or world can read, is refused rather
    than repaired: something changed it, and that deserves a person's look.
    """
    path = Path(path) if path else state_dir_path()
    if not path.exists():
        try:
            path.mkdir(parents=True, mode=0o700)
        except FileExistsError:
            pass   # another process (three `heavy` wrappers started together) made it between the look and the mkdir: checked below like any existing one
        else:
            os.chmod(str(path), 0o700)  # mkdir's mode is filtered by the umask; only the process that made it sets it
    info = path.stat()
    if not path.is_dir():
        raise ConfigError("state path is not a directory: %s" % path)
    if info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise ConfigError("state directory must be private (mode 0700, owned by you): %s" % path)
    return path


