    remind.add_argument("--cancel", metavar="ID", help="Cancel one of your pending reminders by its id (see --list)")
    remind.add_argument("--keep-if-closed", action="store_true", help="With --issue: deliver even if that issue has been closed "
                        "(by default a reminder about an issue is dropped, unsent, once the issue is closed)")
    remind.add_argument("--issue", type=issue_arg, help="The issue the reminder is about")
    remind.add_argument("--from", dest="sender", help="Lab only: the sender's fleet name")
