def _make_loader(function, module):
    def loader():
        return load_module(module)
    loader.__name__ = loader.__qualname__ = function
    loader.__doc__ = "The helper module bin/%s.py, loaded by path from beside this file (`load_module(%r)`)." % (module, module)
    return loader


for _function, _module in HELPER_MODULES.items():
    globals()[_function] = _make_loader(_function, _module)
del _function, _module


decision_core = load_decision_core()


def run_cloud(function, *arguments):
    """`cloud_worker.<function>(*arguments)`; a CloudError reads as a LaunchError (a one-line failure, exit 1)."""
    module = load_module("cloud_worker").bind(globals())
    try:
        return getattr(module, function)(*arguments)
    except module.CloudError as err:
        raise LaunchError(str(err)) from None


def refuse_cloud_name(name):
    """A LOCAL launch of a name that has a cloud record is refused (LaunchError). Fail-open WITH a warning line on stderr: a cloud module that is missing, broken or cannot read its
    records never breaks a local launch (only a real refusal does)."""
    try:
        run_cloud("refuse_local_launch", name)
    except LaunchError:
        raise
    except Exception as err:   # loud, never silent: the one-name-one-kind guard could not run (the class of the failure only, never its text)
        sys.stderr.write("%s: warning: the cloud-name check could not run (%s); launching locally\n" % (PROG, type(err).__name__))
        return







def health_recorder(engine):
    """The engine's recorder of what it has already read (#357), made on first use. None when it cannot be made: health is never in a pass's way."""
    held = getattr(engine, "health", None)
    if held is None:
        try:
            held = engine.health = load_health_records().Recorder(time.time)
        except Exception:
            return None
    return held


def _health_fault(engine, where, err):
    """A recorder fault is never in a pass's way, but it is said once per change of the error (`_note`), so a recorder that never records leaves a trace."""
    try:
        engine._note("health.error", where, {"error": _one_line("%s: %s" % (type(err).__name__, err), 160)})
    except Exception:
        pass


def health_ingest_messages(engine, session, page):
    """Messages the feed has just read, handed to the recorder. No read of its own; a fault is ignored."""
    try:
        recorder = health_recorder(engine)
        if recorder is not None and isinstance(page, list):
            for message in page[:20]:
                recorder.ingest_message(session, message)
    except Exception as err:
        _health_fault(engine, "ingest", err)


def health_watched_repos(state_dir):
    """The repositories whose events the daemon receives: those with a running watch in github-watch.json (read only). [] when it is missing."""
    try:
        with open(str(Path(state_dir) / WATCH_FILE), "rb") as handle:
            body = json.loads(handle.read(1000001).decode("utf-8"))
        return [w["repo"] for w in body.get("watches", []) if isinstance(w, dict) and w.get("state") == "running" and isinstance(w.get("repo"), str)]
    except (OSError, ValueError, AttributeError):
        return []


def health_write(engine, state, now):
    """End of every pass (#357, from `finish_pass`, so it runs whatever is configured): the pushes seen in the PR picture, when one exists
    (`state` is the ci recorder's, or None: the engine's own is used), and `health-records.json` (written only when its content changed, or on the heartbeat)."""
    try:
        recorder = health_recorder(engine)
        if recorder is None or engine.state_dir is None:
            return
        state = state if state is not None else getattr(engine, "ci_record_state", None)
        recorder.ingest_prs(getattr(state, "pr_state", None))
        records = load_health_records()
        listed = registry_read(engine.state_dir)   # the records are a view of the registry: only its agents' sessions; a read that is not whole drops nothing
        body = recorder.body(records.read_tool_file(engine.state_dir), light=bool((getattr(engine, "config", None) or {}).get("v2_light")), watched=health_watched_repos(engine.state_dir),
                             retired_sessions={r.get("session") for r in listed["retired"].values() if r.get("session")} if listed["whole"] else None)
        state_write(Path(engine.state_dir) / records.FILE, json.dumps(body, sort_keys=True), _without(body, "written_at"), HEARTBEAT_PR_STATE, nofollow=True)
    except Exception as err:
        _health_fault(engine, "write", err)




