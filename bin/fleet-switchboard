_MODULE_LOCKS = {}            # one reentrant lock per module name: a load of one module never waits behind the import of another
_MODULE_LOCKS_GUARD = threading.Lock()   # held only to fetch or make a name's lock, never across an import
_MODULES_DONE = {}            # name -> the module object whose import FINISHED (sys.modules holds a module while it still runs)


def load_module(name):
    """A helper module of bin/, loaded by path from beside this file: the one loader behind every `load_<module>()` below,
    so a new module needs no loader of its own (call `load_module("name")`).

    Not by `import`: this file has no .py name, is run through a symlink (~/.local/bin), by the daemon's service
    unit, by wrappers, and is loaded by tests with SourceFileLoader, and none of those puts its directory on
    sys.path. The real path of this file (symlinks resolved) is always right. A copy already loaded from the
    same file is reused, so two loads of this script share one module. The name is a plain module name, never
    a path: anything else is refused (ValueError), and a name with no file here fails as it always did.

    A module already loaded is returned with no lock at all (this is on the hot path). A first load holds the lock of THAT name only, and
    checks again once it has it, so concurrent first loads of one module all get the finished module and a failed import (never kept) raises
    for every caller; the import of one module never delays another."""
    if not isinstance(name, str) or not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name):
        raise ValueError("not a module name: %r" % (name,))
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), name + ".py")
    done = _MODULES_DONE.get(name)
    if done is not None and sys.modules.get(name) is done and os.path.realpath(getattr(done, "__file__", "") or "") == path:
        return done
    with _MODULE_LOCKS_GUARD:
        lock = _MODULE_LOCKS.setdefault(name, threading.RLock())
    with lock:   # reentrant: a module that loads another while it runs does not wait for itself
        held = sys.modules.get(name)
        if held is not None and os.path.realpath(getattr(held, "__file__", "") or "") == path:
            return held
        spec = importlib.util.spec_from_file_location(name, path)
        module = importlib.util.module_from_spec(spec)
        sys.modules[name] = module
        try:
            spec.loader.exec_module(module)
        except BaseException:
            sys.modules.pop(name, None)
            raise
        _MODULES_DONE[name] = module
        return module


