# ---------------------------------------------------------------- the owner-clear code (#532): bin/impact_hold.py
# The code that decides who may clear, hold or release an impact hold lives in a module the impact matrix lists as a top tier path. This is its registration only:
# the module is bound to this file's globals, so its functions are found here under their old names. A missing or unloadable module stops the daemon (never a
# switchboard that runs without the rule).
try:
    load_module("impact_hold").bind(globals())
except Exception as _err:
    raise SystemExit("fleet-switchboard: the clear, hold and gate module (impact_hold) could not be loaded, so nothing runs without it: %s: %s" % (type(_err).__name__, _err))


# ---------------------------------------------------------------- the front door: self-registering commands
#
# A command is two functions named for it and nothing else: `add_<name>_parsers(sub)` (registers its argparse parsers; found by name) and
# `cmd_<action with - as _>(args, ...)` (runs it; found by name). `main` lists neither. The few special cases are explicit, here, and are the only
# things a new command could ever need to edit: nothing shared. Its dispatch group is said next to its own definition, as an attribute of the
# function: `cmd_x.direct = True` (run outside the error mapping and without ensuring the daemon), `cmd_x.ledger = True` (its own errors are usage
# errors) and `cmd_x.ensure_on_use = True` (the daemon is started first). DIRECT_ACTIONS, LEDGER_ACTIONS and ENSURE_ON_USE_COMMANDS below are VIEWS of
# those attributes, derived once everything is defined (see `derive_action_groups`), never lists to edit; `dispatch` asks the view AND the attribute
# (a test that swaps a command's function for a recorder keeps the group the module defined).

RATING_PATH_FUNCTIONS = ("cmd_review", "parse_review_block", "rating_inputs", "resolve_command", "dispatch", "call_command")   # `main` checks these are the same objects after the registrars ran (#835)
COMMAND_NAME_RE = re.compile(r"[a-z][a-z0-9-]*")
REGISTRAR_NAME_RE = re.compile(r"add_[a-z0-9_]+_parsers")
COMMAND_ARGUMENTS = ("args", "runner", "now", "spawn", "socket_call", "wait")   # what a command function may ask for, by parameter name


def command_registrars():
    """The `add_*_parsers` functions of this module, by name (sorted): the one place commands are collected."""
    return [globals()[name] for name in sorted(n for n in globals() if REGISTRAR_NAME_RE.fullmatch(n)) if callable(globals()[name])]


def resolve_command(action, known):
    """The function that runs `action`, or None. ONLY a `cmd_<action>` function of this module, ONLY for an action that is a registered
    subcommand (`known`) and whose name is plain lower case: a hostile or unknown name never reaches `getattr` of anything else, so it can
    never run an arbitrary function."""
    if not isinstance(action, str) or not COMMAND_NAME_RE.fullmatch(action) or action not in known:
        return None
    handler = globals().get("cmd_" + action.replace("-", "_"))
    return handler if callable(handler) else None


def call_command(handler, **available):
    """`handler(...)` with the arguments it names, taken from `available` (args, runner, now, spawn, socket_call, wait): `cmd_poke(args)` gets one,
    `cmd_run(args, runner, now, wait)` four. A required parameter outside COMMAND_ARGUMENTS is a programming error, said plainly."""
    params = inspect.signature(handler).parameters
    missing = [n for n, p in params.items() if p.default is p.empty and p.kind in (p.POSITIONAL_OR_KEYWORD, p.KEYWORD_ONLY) and n not in available]
    if missing:
        raise TypeError("%s asks for %s, which a command is never given (it may ask for: %s)" % (handler.__name__, ", ".join(missing), ", ".join(COMMAND_ARGUMENTS)))
    return handler(**{n: available[n] for n in params if n in available})


def cmd_plan(args, runner, now, socket_call=None):
    """`plan check` (the default) or `plan review` (#109 part 2: writes the ledger and launches lanes; off unless plan_review.enabled)."""
    if args.plan_action == "review":
        return cmd_plan_review(args, runner, now, socket_call)
    if args.plan_action == "template":
        return cmd_plan_template(args, runner, now)
    return cmd_plan_check(args, runner, now)


cmd_plan.direct = True   # no error mapping, no daemon start


def dispatch(args, known, runner=subprocess.run, now=time.time, wait=None, spawn=subprocess.Popen, socket_call=None):
    """Run the parsed command: the exit code. `known` is the set of registered subcommands (parser.commands)."""
    available = {"args": args, "runner": runner, "now": now, "spawn": spawn, "socket_call": socket_call, "wait": wait}
    if args.action == "version":
        print("%s %s" % (PROG, VERSION))
        return EXIT_OK
    handler = resolve_command(args.action, known)
    if handler is not None and (args.action in DIRECT_ACTIONS or getattr(handler, "direct", False) is True):   # reads or answers on its own terms: no daemon start, no error mapping
        return call_command(handler, **available)
    try:
        if handler is not None:
            if args.action in ENSURE_ON_USE_COMMANDS or getattr(handler, "ensure_on_use", False) is True:  # PR 16: the daemon is alive when a command needs it
                ensure_on_use(spawn)
            if args.action in LEDGER_ACTIONS or getattr(handler, "ledger", False) is True:
                try:
                    return call_command(handler, **available)
                except (LedgerCommandError, PlanInputError, plan_ledger.LedgerError) as err:
                    sys.stderr.write("%s: %s: %s\n" % (PROG, args.action, _one_line(str(err), 400)))
                    return EXIT_USAGE
            return call_command(handler, **available)
    except SimulatedCrash as crash:
        sys.stderr.write("%s: crashed: %s\n" % (PROG, crash))
        return EXIT_CRASH
    except (V2Error, HerdrError, ConfigError, FaultError, FactError, CallerError, LockError,
            LaunchError, IntentError, InstallError) as err:
        sys.stderr.write("%s: %s\n" % (PROG, _one_line(str(err))))
        return EXIT_ERROR
    sys.stderr.write("%s: unknown command %r\n" % (PROG, args.action))
    return EXIT_USAGE


def main(argv=None, runner=subprocess.run, now=time.time, wait=None, spawn=subprocess.Popen,
         socket_call=None):
    os.environ.setdefault(OWN_GH_ENV, "1")   # the gh calls of this process are the switchboard's own: never re-identified
    raw = tuple(argv if argv is not None else sys.argv[1:])   # #835: the command line as typed, captured BEFORE any registrar runs: `review record` reads its rating inputs from this, never from the shared parser
    held = {name: (globals()[name], globals()[name].__code__) for name in RATING_PATH_FUNCTIONS if name in globals()}
    parser = build_parser()
    try:
        args, extra = parser.parse_known_args(list(raw))
        args.raw_argv = raw   # set here, after the parse: no registrar default, Action or wrapper can set it first
        if extra and args.action == "remind" and not (args.list_mine or args.cancel) and not any(word.startswith("-") for word in extra):
            args.text = list(args.text or []) + extra   # words after an option (`remind a 1h --issue 3 the text`): argparse lets an optional positional end early
        elif extra:
            parser.error("unrecognized arguments: %s" % " ".join(extra))
    except SystemExit as exit_:
        return EXIT_USAGE if exit_.code not in (0, None) else EXIT_OK
    if getattr(args, "action", None) == "review" and (set(held) != set(RATING_PATH_FUNCTIONS) or any(globals().get(name) is not fn or fn.__code__ is not code for name, (fn, code) in held.items())):
        sys.stderr.write("%s: review: a command registrar replaced code on the rating path: nothing was recorded\n" % PROG)   # a registrar reassigned one of the functions the rating is read and recorded by
        return EXIT_ERROR
    return dispatch(args, parser.commands, runner=runner, now=now, wait=wait, spawn=spawn, socket_call=socket_call)


