# ------------------------------------------------------------------ the config

DEFAULTS = {
    # No default: the v2 binary must be named by absolute path. A bare name is
    # resolved through PATH, and a shell's PATH can find the OpenCode v1 binary
    # instead; the Lab hit exactly that.
    "opencode": None,
    "opencode_env": {},
    # The program that actually runs in a pane, when `opencode` is a wrapper
    # that execs something else (the Lab). None: `opencode` itself.
    "opencode_executable": None,
    # Extra environment for the TUI `launch` starts, beside opencode_env.
    "launch_env": {},
    "herdr": "herdr",
    "batch_seconds": 90,
    "send_to_working": "steer",     # a boss's `send` to a working agent: "steer" (its next safe point) or "queue" (after its turn)
    "engaged_minutes": 10,
    "call_timeout_seconds": 20,
    "poll_seconds": 5,
    "worker_lookback_hours": 24,  # how far back a worker's finished turn still counts (PR 4)
    "rider_max_age_seconds": 3600,  # PR 13: a rider older than this is dropped, and an older stop is not triaged
    "report_triage": None,          # PR 13: None means REPORT_TRIAGE_DEFAULTS (the `report_owed` question's settings)
    # GitHub events (PR 5)
    "github_repos": [],
    "gh": "gh",
    "github_lookback_hours": 24,
    "github_events": ["issues", "issue_comment", "sub_issues", "pull_request", "pull_request_review",
                      "check_suite", "workflow_run"],
    "github_port": None,
    "github_ignore_authors": [],  # logins whose events are never delivered: the agents' own account, when it is not yours
    "awaiting_label": None,         # PR 14: the label that marks a decision for you; None means `<OS user>:awaiting-user`
    "decisions_lookback_hours": 72,  # PR 14: how far back a boss's transcript is read for open report questions
    "awaiting_cos_label": None,     # PR 18: the label that marks a decision for the Chief of Staff; None means `<OS user>:awaiting-cos`
    "decisions_cos_grace_seconds": 300,  # PR 18: a pending request or question is the Chief of Staff's this long, then yours (0: at once)
    "pr_notice_hold_minutes": 0,    # PR notices: minutes a PR notice asks orchestrators to wait before merging (0: no hold, nothing shown)
    "cos_orders_file": None,        # PR 18: the Chief of Staff's own standing orders, an absolute path; None means standing-orders.md beside config.json
    # PR 15: many repos, one fleet. "owner/repo" or "owner/*" -> the gh account whose token that repo uses
    "gh_users": {},
    "github_poll_seconds": 60,  # PR 15: how often a repo without a forwarder is read (the catch-up read, on a poll)
}

EXTERNAL_DEFAULTS = {
    "enabled": False,             # nothing is called, read or written while this is false
    "adapter": None,              # the registered adapter's name (register_external_adapter)
    "repos": [],                  # a project is switched on per repo: only decisions of these repos go outward
    "kinds": ["issue", "report"],  # which decisions go: issue (batches included), report, question; never a permission request
    "mapping_file": None,         # an absolute path to a LOCAL file holding everything specific to the other system
    "tier_map": None,             # {"orchestrator": name, "cos": name, "human": name}: the floor tier each tier maps to
    "tiers": ["human"],           # which fleet tiers are pushed: only the human's by default; [] pushes nothing. An item of a tier not listed is withdrawn
    "poll_seconds": 30,           # how often answers are pulled
    "outbox_alarm_depth": 1000,   # a deeper outbox raises an alarm in the status line; nothing is ever dropped
    "retry_base_seconds": 5,      # backoff of a failed outbound operation: base * 2^(attempts-1), up to the ceiling
    "retry_max_seconds": 600,
    "work_items": False,          # one work item per worker assignment, as information (needs an adapter with a work sink)
    "work_grace_seconds": 600,    # an agent gone this long without a final report is finished as cancelled
    "work_outbox_alarm_depth": 1000,   # more writes waiting than this raises an alarm in the status line; none is dropped
}

HERDR_CALL_TIMEOUT = 15  # seconds; herdr answers locally or not at all


class ConfigError(Exception):
    """The config, or the state directory, cannot be used as it is."""


def _xdg(variable, fallback):
    """An XDG base directory. A relative value is ignored, as the spec says."""
    value = os.environ.get(variable)
    if value and os.path.isabs(value):
        return Path(value)
    return Path.home() / fallback


def config_path():
    return _xdg("XDG_CONFIG_HOME", ".config") / PROG / "config.json"


def state_dir_path():
    return _xdg("XDG_STATE_HOME", ".local/state") / PROG


def _is_number(value):
    return isinstance(value, (int, float)) and not isinstance(value, bool)


def validate_config(raw, source="config"):
    """Defaults overlaid with `raw`, fully checked. Raises ConfigError."""
    if not isinstance(raw, dict):
        raise ConfigError("%s must be a JSON object" % source)
    unknown = sorted(set(raw) - set(DEFAULTS) - set(PR7_CONFIG_KEYS) - {"external_decisions", "friction_wake"})
    if unknown:
        raise ConfigError(
            "%s contains key(s) this tool does not read: %s. "
            "A setting that is silently ignored is worse than a missing one."
            % (source, ", ".join(unknown)))
    config = dict(DEFAULTS)
    config["opencode_env"], config["launch_env"] = {}, {}
    config.update(raw)
    opencode = config["opencode"]
    if opencode is not None and (not isinstance(opencode, str) or not os.path.isabs(opencode)):
        raise ConfigError("%s: 'opencode' must be the absolute path of the OpenCode v2 binary, got %r"
                          % (source, opencode))
    if not isinstance(config["herdr"], str) or not config["herdr"].strip():
        raise ConfigError("%s: 'herdr' must be a non-empty string (a path or a command name), got %r"
                          % (source, config["herdr"]))
    if config["send_to_working"] not in ("steer", "queue"):
        raise ConfigError("%s: 'send_to_working' must be \"steer\" or \"queue\", got %r"
                          % (source, config["send_to_working"]))
    executable = config["opencode_executable"]
    if executable is not None and (not isinstance(executable, str) or not os.path.isabs(executable)):
        raise ConfigError("%s: 'opencode_executable' must be an absolute path, got %r" % (source, executable))
    envs = {}
    for key in ("opencode_env", "launch_env"):
        env = config[key]
        if not isinstance(env, dict):
            raise ConfigError("%s: %r must be an object of NAME: value strings, got %r"
                              % (source, key, type(env).__name__))
        for name, value in env.items():
            if not re.match(r"^[A-Za-z_][A-Za-z0-9_]*$", name):
                raise ConfigError("%s: %r has an invalid variable name: %r" % (source, key, name))
            if not isinstance(value, str):
                raise ConfigError("%s: %r value for %s must be a string" % (source, key, name))
        envs[key] = dict(env)
    for key in ("batch_seconds", "engaged_minutes", "call_timeout_seconds", "poll_seconds",
                "worker_lookback_hours", "rider_max_age_seconds"):
        if not _is_number(config[key]) or config[key] <= 0:
            raise ConfigError("%s: %r must be a positive number, got %r" % (source, key, config[key]))
    validate_intent_config(config, source)
    validate_v1_move_config(config, source)  # PR 10
    _validate_github(config, source)
    config.update(envs)
    validate_jev_config(config, raw, source)
    validate_foreground_config(config, source)  # PR 8
    validate_policy_config(config, source)  # PR 9
    validate_report_triage_config(config, source)  # PR 13
    validate_decisions_config(config, source)  # PR 14
    validate_external_config(config, source)
    validate_friction_config(config, source)
    return config


def validate_external_config(config, source):
    """`external_decisions`: None or {} is off. Checked like every other key; filled with EXTERNAL_DEFAULTS."""
    if "external_decisions" not in config:
        return   # off: the key is absent from a config that never named it, so nothing about it exists
    raw = config["external_decisions"]
    if raw is None:
        raw = {}
    if not isinstance(raw, dict):
        raise ConfigError("%s: 'external_decisions' must be an object, got %r" % (source, type(raw).__name__))
    unknown = sorted(set(raw) - set(EXTERNAL_DEFAULTS))
    if unknown:
        raise ConfigError("%s: 'external_decisions' has key(s) this tool does not read: %s" % (source, ", ".join(unknown)))
    section = dict(EXTERNAL_DEFAULTS, **raw)
    where = "%s: 'external_decisions" % source
    if not isinstance(section["enabled"], bool):
        raise ConfigError("%s.enabled' must be true or false, got %r" % (where, section["enabled"]))
    if section["adapter"] is not None and (not isinstance(section["adapter"], str)
                                           or not re.match(r"^[a-z][a-z0-9_-]{0,40}$", section["adapter"])):
        raise ConfigError("%s.adapter' must be a lower-case adapter name, got %r" % (where, section["adapter"]))
    repos = section["repos"]
    if not isinstance(repos, list) or not all(isinstance(r, str) and GITHUB_REPO_RE.match(r) for r in repos):
        raise ConfigError("%s.repos' must be a list of OWNER/REPO names, got %r" % (where, repos))
    kinds = section["kinds"]
    if not isinstance(kinds, list) or not kinds or not all(k in ("issue", "report", "question") for k in kinds):
        raise ConfigError("%s.kinds' must be a list of issue, report or question (a permission request never goes "
                          "out), got %r" % (where, kinds))
    mapping = section["mapping_file"]
    if mapping is not None and (not isinstance(mapping, str) or not os.path.isabs(mapping)):
        raise ConfigError("%s.mapping_file' must be an absolute path, got %r" % (where, mapping))
    tiers = section["tier_map"]
    if tiers is not None:
        if (not isinstance(tiers, dict) or set(tiers) != set(decision_core.TIER_LADDER)
                or not all(isinstance(v, str) and v.strip() for v in tiers.values())):
            raise ConfigError("%s.tier_map' must name a floor tier (a non-empty string) for each of %s, got %r"
                              % (where, ", ".join(decision_core.TIER_LADDER), tiers))
    pushed = section["tiers"]
    if (not isinstance(pushed, list) or not all(isinstance(t, str) and t in decision_core.TIER_LADDER for t in pushed)
            or len(set(pushed)) != len(pushed)):
        raise ConfigError("%s.tiers' must be a list of tier names, each once, from %s (an empty list pushes nothing), got %r"
                          % (where, ", ".join(decision_core.TIER_LADDER), pushed))
    for key in ("poll_seconds", "retry_base_seconds", "retry_max_seconds"):
        if not _is_number(section[key]) or section[key] <= 0:
            raise ConfigError("%s.%s' must be a positive number, got %r" % (where, key, section[key]))
    if not isinstance(section["work_items"], bool):
        raise ConfigError("%s.work_items' must be true or false, got %r" % (where, section["work_items"]))
    if not _is_number(section["work_grace_seconds"]) or section["work_grace_seconds"] <= 0:
        raise ConfigError("%s.work_grace_seconds' must be a positive number, got %r" % (where, section["work_grace_seconds"]))
    if not isinstance(section["work_outbox_alarm_depth"], int) or isinstance(section["work_outbox_alarm_depth"], bool) \
            or section["work_outbox_alarm_depth"] < 1:
        raise ConfigError("%s.work_outbox_alarm_depth' must be a whole number of 1 or more, got %r"
                          % (where, section["work_outbox_alarm_depth"]))
    if section["retry_max_seconds"] < section["retry_base_seconds"]:
        raise ConfigError("%s.retry_max_seconds' must be at least retry_base_seconds" % where)
    depth = section["outbox_alarm_depth"]
    if not isinstance(depth, int) or isinstance(depth, bool) or depth < 1:
        raise ConfigError("%s.outbox_alarm_depth' must be a whole number of 1 or more, got %r" % (where, depth))
    if section["enabled"]:
        for key in ("adapter", "mapping_file", "tier_map"):
            if section[key] is None:
                raise ConfigError("%s.%s' is required when external_decisions is enabled" % (where, key))
        if not repos:
            raise ConfigError("%s.repos' must name at least one repo when external_decisions is enabled" % where)
    config["external_decisions"] = section


def load_config(path=None):
    """Read config.json. A missing file means every default applies."""
    path = Path(path) if path else config_path()
    try:
        text = path.read_text()
    except FileNotFoundError:
        return validate_config({}, str(path))
    except OSError as err:
        raise ConfigError("cannot read %s: %s" % (path, err.strerror or err))
    try:
        raw = json.loads(text)
    except ValueError as err:
        raise ConfigError("%s is not valid JSON: %s" % (path, err))
    return validate_config(raw, str(path))


# ------------------------------------------------------------------- the state

def ensure_state_dir(path=None):
    """Create the state directory with mode 0700, or check the existing one.

    It holds the audit log, which records who was sent what. A directory that
    someone else owns, or that the group or world can read, is refused rather
    than repaired: something changed it, and that deserves a person's look.
    """
    path = Path(path) if path else state_dir_path()
    if not path.exists():
        path.mkdir(parents=True, mode=0o700)
        os.chmod(str(path), 0o700)  # mkdir's mode is filtered by the umask
    info = path.stat()
    if not path.is_dir():
        raise ConfigError("state path is not a directory: %s" % path)
    if info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise ConfigError("state directory must be private (mode 0700, owned by you): %s" % path)
    return path


