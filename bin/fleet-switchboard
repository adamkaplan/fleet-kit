# ---- #105: an order the Chief of Staff records or removes is a heads-up to the owner (the visibility half of letting it)

ORDER_NOTICES = "order-notices.json"
ORDER_NOTICES_LOCK = "order-notices.lock"
ORDER_NOTICE_TTL_SECONDS = 86400  # a heads-up about an order drops after a day, or at once when the owner acks it


@contextmanager
def order_notices_lock(state_dir):
    fd = os.open(str(Path(state_dir) / ORDER_NOTICES_LOCK), os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)


def read_order_notices(state_dir):
    """The recorded order heads-ups ([] for none). Raises NoticeError for a file that is not one."""
    path = Path(state_dir) / ORDER_NOTICES
    try:
        raw = json.loads(path.read_text())
    except FileNotFoundError:
        return []
    except (OSError, ValueError) as err:
        raise NoticeError("cannot read %s: %s" % (path, err)) from None
    items = raw.get("notices") if isinstance(raw, dict) else None
    if not isinstance(items, list):
        raise NoticeError("%s must hold {\"notices\": [...]}" % path)
    return [i for i in items if isinstance(i, dict) and isinstance(i.get("id"), str) and isinstance(i.get("repo"), str)
            and isinstance(i.get("charter"), int) and _is_number(i.get("created"))]


def write_order_notices(state_dir, items):
    path = Path(state_dir) / ORDER_NOTICES
    temp = path.with_name("%s.%d.tmp" % (ORDER_NOTICES, os.getpid()))
    fd = os.open(str(temp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        with os.fdopen(fd, "w") as handle:
            json.dump({"notices": items}, handle, indent=1, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(str(temp), str(path))
    except BaseException:
        try:
            os.unlink(str(temp))
        except OSError:
            pass
        raise


def record_order_notice(state_dir, repo, charter, action, text, caller, ordered_by, now):
    """Record that `caller` (the Chief of Staff) `action`ed (add or remove) an order on `repo#charter`. Expired ones are
    dropped here. Returns the item."""
    with order_notices_lock(state_dir):
        items = [i for i in read_order_notices(state_dir) if now - i["created"] < ORDER_NOTICE_TTL_SECONDS]
        taken = {i["id"] for i in items}
        base = "order:%s#%d.%d" % (repo.split("/")[-1], charter, int(now))
        ident, n = base, 1
        while ident in taken:
            n += 1
            ident = "%s-%d" % (base, n)
        item = {"id": ident, "repo": repo, "charter": charter, "action": action, "text": text, "from": caller,
                "ordered_by": ordered_by, "created": now}
        write_order_notices(state_dir, items + [item])
    return item


def ack_order_notice(state_dir, ident, window=None, now=None):
    """Drop one heads-up, or a whole burst when `ident` is a group id (`<first id>+<count>`). Returns True when something was dropped, False when
    nothing matched, and the string `changed:<n>` when the burst the id names now has n members (not `count`): nothing is dropped, so an order that
    joined after the owner saw the row is never dropped unseen. Groups are made the way the panel's rows are: from the unexpired orders only and
    with the same window. An old single id still drops just that one."""
    with order_notices_lock(state_dir):
        items = read_order_notices(state_dir)
        gone = {ident}
        m = _GROUP_ID.match(ident)
        if m and not any(i["id"] == ident for i in items):
            live = [i for i in items if (now if now is not None else time.time()) - i["created"] < ORDER_NOTICE_TTL_SECONDS]
            for group in order_groups(live, ORDER_BURST_MINUTES * 60 if window is None else window):
                if group[0]["id"] == m.group(1):
                    if len(group) != int(m.group(2)):
                        return "changed:%d" % len(group)
                    gone = {g["id"] for g in group}
                    break
        kept = [i for i in items if i["id"] not in gone]
        if len(kept) == len(items):
            return False
        write_order_notices(state_dir, kept)
    return True


ORDER_BURST_MINUTES = 10   # orders of the same action by the same actor on the same charter within this many minutes of the first are ONE heads-up
_GROUP_ID = re.compile(r"^(order:.+)\+([0-9]+)$")


def order_burst_seconds(config):
    value = (config or {}).get("order_notice_burst_minutes", ORDER_BURST_MINUTES)
    return 0 if isinstance(value, bool) or not isinstance(value, (int, float)) or value <= 0 else int(value * 60)


def validate_order_burst(config, source):
    raw = config.get("order_notice_burst_minutes")
    if raw is not None and (isinstance(raw, bool) or not isinstance(raw, (int, float)) or not 0 <= raw <= 1440):
        raise ConfigError("%s: 'order_notice_burst_minutes' must be a number of minutes from 0 (no grouping) to 1440, got %r" % (source, raw))


def order_groups(items, window):
    """[[item, ...]] oldest first: consecutive orders of the same action by the same actor on the same charter, each within `window` seconds of the
    FIRST of its group, form one group (a window of 0 groups nothing)."""
    groups, open_by_key = [], {}
    for item in sorted(items, key=lambda i: (i["created"], i["id"])):
        key = (item["repo"], item["charter"], item.get("action"), item.get("from"))
        group = open_by_key.get(key)
        if window > 0 and group is not None and item["created"] - group[0]["created"] <= window:
            group.append(item)
        else:
            group = [item]
            open_by_key[key] = group
            groups.append(group)
    return groups


def order_group_id(group):
    return group[0]["id"] if len(group) == 1 else "%s+%d" % (group[0]["id"], len(group))


def decisions_from_order_notices(engine, now):
    """(entries, problems): each unexpired order heads-up as an entry of kind `notice` (tier `human`, id `order:<repo>#N.<time>`):
    information for the owner, never a decision, never counted. Read-only: an expired one is only left out here.

    The headline LEADS WITH WHAT DIFFERS (`<repo>#<charter> order +: <text> (cos)`, `+` added, `-` removed), so the number is never what a narrow
    row cuts; the text is. A burst (orders of one action by one actor on one charter within `order_notice_burst_minutes`) is ONE entry,
    `<repo>#<charter>: 19 orders added by cos: <first words>`, whose id is the first id plus the count and whose note lists the member ids."""
    state_dir = getattr(engine, "state_dir", None)
    if state_dir is None:
        return [], []
    try:
        items = read_order_notices(state_dir)
    except NoticeError as err:
        return [], [str(err)]
    window = order_burst_seconds(getattr(engine, "config", None))
    live = [i for i in items if now - i["created"] < ORDER_NOTICE_TTL_SECONDS]
    entries = []
    for group in order_groups(live, window):
        first = group[0]
        short, sign = first["repo"].split("/")[-1], "+" if first.get("action") == "add" else "-"
        who = first.get("from") or "cos"
        text = first.get("text") or ""
        if len(group) == 1:
            headline = decision_core.fit_lines("%s#%d order %s: %s (%s)" % (short, first["charter"], sign, text, who))
            note = "not ack'd: `%s notice ack %s` drops it" % (PROG, first["id"])
        else:
            word = "added" if sign == "+" else "removed"
            headline = decision_core.fit_lines("%s#%d: %d orders %s by %s: %s" % (short, first["charter"], len(group), word, who, text))
            note = "not ack'd: `%s notice ack %s` drops all %d (members: %s)" % (PROG, order_group_id(group), len(group), ", ".join(g["id"] for g in group))
        entries.append({"id": order_group_id(group), "title": decision_core.line_of(headline, decision_core.DECISION_TITLE_MAX),
                        "headline": headline, "ask": None, "repo": first["repo"], "agent": first.get("from"),
                        "kind": "notice", "tier": "human", "since": iso(first["created"]), "number": first["charter"],
                        "url": "https://github.com/%s/issues/%d" % (first["repo"], first["charter"]),
                        "state": None, "additions": None, "deletions": None, "files": None, "ci": None,
                        "review": None, "stale": False, "note": note, "merge_after": None})
    return entries, []


class PrNoticesSource(decision_core.DecisionSource):
    name = "notices"
    entries = True

    def __init__(self, engine):
        self.engine = engine

    def read_open(self, now):
        return decisions_from_notices(self.engine, now)


class OrderNoticesSource(decision_core.DecisionSource):
    name = "order-notices"
    entries = True

    def __init__(self, engine):
        self.engine = engine

    def read_open(self, now):
        return decisions_from_order_notices(self.engine, now)


# The registry, in the order the list is built: sources of items (folded and numbered) in registration order, then
# the sources of finished entries. A later adapter appends a factory (`factory(engine)` -> a DecisionSource).
DECISION_SOURCE_REGISTRY = [GitHubIssuesSource, HarnessRequestsSource, ReportsSource, PrNoticesSource, OrderNoticesSource]


def register_decision_source(factory):
    """Add a source (a class or any `factory(engine)` returning a DecisionSource) after the ones already there."""
    DECISION_SOURCE_REGISTRY.append(factory)
    return factory


def decision_sources(engine):
    return [factory(engine) for factory in DECISION_SOURCE_REGISTRY]


def read_source(engine, source, now, errors):
    """(found, problems) of one source: a source that fails is one error entry (audited once per change) and the
    others are still listed. Every problem is appended to `errors`."""
    try:
        found, problems = source.read_open(now)
    except Exception as err:
        found, problems = [], [_one_line("%s: %s" % (type(err).__name__, err), 200)]
    for problem in problems:
        errors.append(dict({"source": source.name, "error": _one_line(problem, 200)},
                           **({"boss": problem.boss} if getattr(problem, "boss", None) else {})))
        engine._note("decisions.error", source.name, {"error": _one_line(problem, 200)})
    return found, problems


def derive_decisions(engine, now):
    """(decisions, errors): every open decision, oldest first, and what could not be read.

    Each decision is {id, title, headline, ask, repo, agent, kind, since, tier} (`headline`: what the panel shows;
    an issue's decision may add `reported_by`, the agents whose report on it was folded in; PR 18: `cos`, `human` or `orchestrator`; a
    permission request or question also names its `session` and `request`). A source that fails is an error entry and the
    others are still listed (audited once per change). Call after `engine.discover` and a fact collection."""
    items, errors = [], []
    sources = decision_sources(engine)
    for source in (x for x in sources if not x.entries):
        found, problems = read_source(engine, source, now, errors)
        items.extend(found)
    ids = assign_decision_ids(items, decision_repos(engine))
    engine.decision_bosses = {ident: item["boss"] for ident, item in zip(ids, items) if item.get("boss")}  # memory only
    engine.decision_seeds = {ident: item["seed"] for ident, item in zip(ids, items)}  # memory only: the sync engine's keys
    watched = decision_repos(engine)
    home = engine.config.get("intent_repo") or (watched[0] if len(watched) == 1 else None)  # a bare issue's repo
    decisions = decision_core.build_entries(
        items, ids, home, lambda repo, number: cached_issue_title(engine, repo, number, {}),
        tier_flat=fault("tier-flat"), known_parent=chain_parent_lookup(engine))
    for source in (x for x in sources if x.entries):  # PR notices: information rather than decisions (never folded, never counted)
        found, problems = read_source(engine, source, now, errors)
        decisions.extend(found)
    decision_core.fold_reports_into_prs(decisions)   # a report naming a `pr:` decision is that PR's question: one row, not two
    decision_core.order_decisions(decisions)
    decision_core.annotate_order(decisions)   # optional order fields, only when some decision says what it waits for
    return decisions, errors


def read_decisions_file(path):
    """The parsed file, or None when it is missing or not a decisions file."""
    try:
        body = json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return None
    ok = isinstance(body, dict) and isinstance(body.get("decisions"), list) and isinstance(body.get("errors"), list)
    return body if ok else None


class LocalStore(decision_core.DecisionStore):
    """What the Switchboard keeps about decisions on this machine: the projection decisions.json and the
    escalated-requests file. Today's behaviour, behind the DecisionStore port; the functions it calls are unchanged."""

    def __init__(self, engine):
        self.engine = engine

    def read(self, now):
        return decisions_report(self.engine.state_dir, now)

    def publish(self, decisions, errors, now, provisional=False):
        """Write decisions.json when the list changed (or the file is missing or unreadable), atomically, mode
        0600; otherwise touch it, so its age says the daemon is alive. Returns True when written. `provisional` (#467 slice 3: the early write of a pass that is
        still reading) is kept in the file until the end of the pass publishes the final list: a change of that flag alone is a write."""
        engine = self.engine
        path = engine.state_dir / DECISIONS_FILE
        current = read_decisions_file(path)
        if current is not None and current["decisions"] == decisions and current["errors"] == errors and (current.get("provisional") is True) == bool(provisional):
            os.utime(str(path), (now, now))
            return False
        known = current.get("generation") if current is not None else None
        same = current is not None and current["decisions"] == decisions and current["errors"] == errors   # only the provisional flag changes: the list is the same generation
        engine.decisions_generation = max(engine.decisions_generation, known if isinstance(known, int) else 0) + (0 if same and isinstance(known, int) else 1)
        body = {"generation": engine.decisions_generation, "written_at": iso(now), "daemon_pid": os.getpid(),
                "decisions": decisions, "errors": errors}
        if provisional:
            body["provisional"] = True
        temp = path.with_name("%s.%d.tmp" % (DECISIONS_FILE, os.getpid()))
        fd = os.open(str(temp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        try:
            with os.fdopen(fd, "w") as handle:
                json.dump(body, handle, indent=1, sort_keys=True)
                handle.write("\n")
            os.utime(str(temp), (now, now))
            os.replace(str(temp), str(path))
        except BaseException:
            try:
                os.unlink(str(temp))
            except OSError:
                pass
            raise
        return True  # not audited: a projection of facts, and the audit records writes to other systems

    def escalated(self):
        return read_escalated(self.engine.state_dir)

    def mark_escalated(self, key, when):
        mark_escalated(self.engine.state_dir, key, when)

    def prune_escalated(self, pending):
        return prune_escalated(self.engine.state_dir, pending)


class NullExternal(decision_core.ExternalDecisionAdapter):
    """The adapter with nothing behind it: healthy, takes every push as a no-op and has no changes. What the
    Switchboard uses while no external adapter is configured, so nothing leaves the machine."""

    def health(self):
        return None

    def push(self, operation, idempotency_key):
        return {"external_id": operation.get("external_id")}

    def lookup(self, key):
        return None

    def pull_changes(self, cursor):
        return [], cursor


NULL_EXTERNAL = NullExternal()


def decision_store(engine):
    return LocalStore(engine)


def decision_external(engine):
    """The external adapter of this engine: its `external` when one was set, else the NullExternal."""
    return getattr(engine, "external", None) or NULL_EXTERNAL


# ---- external decision systems: OFF by default (external_decisions.enabled). The engine is decision_sync's; this
# is the registry of adapters, the host that gives it audit and delivery, and the call at the end of a pass.

EXTERNAL_ADAPTERS = {}


def register_external_adapter(name, factory):
    """Register an adapter under the name `external_decisions.adapter` selects: `factory(settings, mapping,
    state_dir)` returns an ExternalDecisionAdapter. `mapping` is the parsed local mapping file."""
    EXTERNAL_ADAPTERS[name] = factory
    return factory


MAPPING_ADAPTER = "mapping"   # the generic adapter's name in `external_decisions.adapter`


def build_mapping_adapter(settings, mapping, state_dir):
    """The factory of the generic adapter: built from the parsed mapping file, its key source run ONCE here (a command
    source runs now, with its own timeout, and the key is held in memory only). Any failure raises one line that
    never holds the key; the caller shows it as `down: <why>` and tries again only after a backoff."""
    module = load_external_adapter()
    try:
        adapter = module.McpRestAdapter(mapping)
        reason = adapter.start()
    except Exception as err:
        raise RuntimeError(module.scrub(_one_line("%s" % err, 160)))
    if reason:
        raise RuntimeError(module.scrub(_one_line(reason, 160), adapter.keys.secrets()))
    return adapter


register_external_adapter(MAPPING_ADAPTER, build_mapping_adapter)


def judge_inbound_answer(engine, decision, answer, role):
    """Whether an answer that came from outside may be applied, judged as the Chief of Staff's own `decisions answer`
    is: the same four questions, put to the same decision model, with the owner's standing orders as the authority.
    {"verdict": "allow" | "deny" | "unavailable", "reason": one line}.

    Only the owner's agent is judged (the project agent counts as an orchestrator's, the human as the human's: no
    orders are involved). It can only tighten: it is asked after role authority has accepted the answer. It fails
    safe: orders that are missing, empty or unusable, a judge that is not on, or a model that cannot answer is never
    an allow (the first two and the third are a deny, the last is `unavailable`, which the sync engine retries a
    bounded number of times). Nothing is written, and the model is never reached unless the judge is on."""
    if role != "owner_agent":
        return {"verdict": "allow", "reason": "no standing orders are involved for this role"}
    if fault("answer-unjudged"):
        return {"verdict": "allow", "reason": "answer-unjudged fault"}
    config = engine.config
    if not config["policy"]["enabled"] or not config.get("jev") or fault("no-policy-judge"):
        return {"verdict": "deny", "reason": "the owner's standing orders cannot be consulted: the policy judge is not "
                                             "on, so the owner's agent's answer goes to the owner"}
    try:
        orders = read_cos_orders(config)["text"]
    except CosOrdersError as err:
        return {"verdict": "deny", "reason": "the owner's standing orders cannot be used (%s)" % _one_line(str(err), 120)}
    if not orders:
        return {"verdict": "deny", "reason": "no standing orders are stated, so nothing authorises the owner's agent to "
                                             "decide this: it goes to the owner"}
    text = _one_line(answer.get("text") or "", 600)
    chosen = " --option %s" % answer["option_id"] if answer.get("option_id") else ""
    arguments = "%s decisions answer %s%s %s [the decision it acts on: %s by %s, %s tier: %s]" % (
        PROG, decision["id"], chosen, json.dumps(text), decision.get("kind"), decision.get("agent"),
        decision.get("tier"), _one_line(decision.get("title"), 300))
    arguments = redact_command_text(arguments, jev_secrets(config, os.environ))
    state = policy_state("chief-of-staff", "not stated: no ask is recorded", "not stated", orders, "shell", arguments)
    thresholds = dict(config["policy"]["thresholds"])
    thresholds["outside_intent"] = thresholds["outside_scope"] = 2.0   # the Chief of Staff has no ask: as in the judge
    try:
        capped = dict(config["jev"], timeout_seconds=min(config["jev"]["timeout_seconds"], POLICY_WARM_SECONDS))
        combined = judge_tool_call(build_jev(dict(config, jev=capped)), "allow", state, thresholds)
    except Exception as err:
        return {"verdict": "unavailable", "reason": "the judge failed: %s" % _one_line(str(err), 120)}
    if "answers" not in combined:   # judge_tool_call lets the configured outcome stand when the model gave no answer
        return {"verdict": "unavailable", "reason": _one_line(combined["reason"], 200)}
    if combined["outcome"] == "allow":
        return {"verdict": "allow", "reason": "within the owner's standing orders"}
    fired = "; ".join(POLICY_FIRED_TEXT[n] for n in combined["fired"] if n in POLICY_FIRED_TEXT)
    return {"verdict": "deny", "reason": "outside the owner's standing orders (%s): it goes to the owner" % (fired or "judge")}


class ExternalSyncHost(decision_sync.Host):
    """What the sync engine needs of the Switchboard: the audit log, and the asker's own delivery paths."""

    def __init__(self, engine):
        self.engine = engine

    def audit(self, event, subject, detail):
        if self.engine.audit is not None:
            self.engine.audit.append(self.engine.actor, event, subject, detail)

    def _runner(self):
        return self.engine.gh_runner or subprocess.run

    def _boss(self, target):
        discovery = self.engine.discovery or self.engine.discover(self.engine.now())
        found = discovery.agents.get(target.get("agent")) if target.get("agent") else None
        boss = boss_name(discovery, found) if found is not None else None
        if boss is None:
            raise DecisionError("%s: there is no running agent to tell" % (target.get("display_id") or target.get("id")))
        return boss

    def judge_answer(self, entry, intent):
        return judge_inbound_answer(self.engine, entry, intent, intent.get("answered_by"))

    def deliver_answer(self, entry, intent):
        engine, kind = self.engine, entry["kind"]
        text = _one_line(intent.get("text") or "", 600)
        role = (intent.get("answered_by") or "someone").replace("_", " ")
        said = "Answered outside by the %s%s" % (role, ": " + text if text else " (option %s)" % intent.get("option_id"))
        if kind == "report":
            outcome = ReportSendDelivery(engine).deliver(entry, {"by": self._boss(entry), "to": entry["agent"],
                                                                 "text": said, "ask": entry.get("ask"),
                                                                 "repo": entry.get("repo")})
            if not outcome.get("sent"):
                raise DecisionError("the answer was not sent to %s (%s)" % (
                    entry["agent"], outcome.get("reason") or outcome.get("action")))
        elif kind == "issue" and entry.get("rows"):
            rows = ["%s=%s" % (n, c) for n, c in sorted((intent.get("rows") or {}).items(), key=lambda kv: int(kv[0]))]
            args = types.SimpleNamespace(as_recommended=not rows, row=rows, note=said)
            answer_batch(engine, self._runner(), entry, args, engine.actor)
        elif kind == "issue":
            target = _issue_target(engine, entry)
            if target is None or target[0] is None:
                raise DecisionError("%s: cannot tell which repo its issue is in" % entry["id"])
            IssueDelivery(engine, self._runner()).deliver(entry, {
                "repo": target[0], "number": target[1], "add": (),
                "remove": [awaiting_cos_label(engine.config), awaiting_label(engine.config)],
                "author": engine.actor, "comment": said})
        elif kind == "question":
            HarnessReplyDelivery(engine).deliver(entry, {"value": text or str(intent.get("option_id") or ""),
                                                          "note": said, "by": engine.actor})
        else:
            raise DecisionError("%s is a %s: it is not answered from outside" % (entry["id"], kind))

    def deliver_note(self, target, text):
        outcome = ReportSendDelivery(self.engine).deliver(target, {
            "by": self._boss(target), "to": target.get("agent"), "text": text, "ask": target.get("ask"),
            "repo": target.get("repo")})
        if not outcome.get("sent"):
            raise DecisionError("the note was not sent to %s (%s)" % (
                target.get("agent"), outcome.get("reason") or outcome.get("action")))


def external_settings(config):
    section = (config or {}).get("external_decisions") or {}
    return section if section.get("enabled") else None


def sync_for(engine):
    """The sync engine of this daemon, built once; None while external decisions are off (nothing is called), or
    (None, reason) is never returned: a build that fails is `engine.external_sync_error`, shown as a status."""
    settings = external_settings(engine.config)
    if settings is None or engine.state_dir is None:
        return None
    held = getattr(engine, "external_sync", None)
    if held is not None:
        return held
    now = engine.now()
    if now < getattr(engine, "external_sync_retry_at", 0):
        return None   # a failed build is not tried again until its backoff has passed (a key command is not rerun per pass)
    try:
        factory = EXTERNAL_ADAPTERS.get(settings["adapter"])
        if factory is None:
            raise RuntimeError("no adapter named %r is registered" % settings["adapter"])
        try:
            mapping = json.loads(Path(settings["mapping_file"]).read_text())
        except (OSError, ValueError) as err:
            raise RuntimeError("the mapping file cannot be read: %s" % (getattr(err, "strerror", None) or "not JSON"))
        adapter = factory(settings, mapping, engine.state_dir)
        engine.external_sync = decision_sync.SyncEngine(settings, engine.state_dir, adapter, ExternalSyncHost(engine),
                                                       engine.now)
        engine.external_sync_error = None
        engine.external_sync_fails = 0
        ExternalSyncHost(engine).audit("external.started", "external", {"adapter": settings["adapter"]})
    except Exception as err:
        fails = getattr(engine, "external_sync_fails", 0) + 1
        engine.external_sync_fails = fails
        engine.external_sync_error = _one_line("%s" % err, 160)
        engine.external_sync_retry_at = now + min(settings["retry_max_seconds"],
                                                  settings["retry_base_seconds"] * 2 ** (fails - 1))
        try:
            ExternalSyncHost(engine).audit("external.down", "external", {"reason": engine.external_sync_error,
                                                                         "attempt": fails})
        except Exception:
            pass
        return None
    return engine.external_sync


def sync_external(engine, decisions, errors, now):
    """The end of a pass for a project that is switched on: mirror the list outward and take answers back. Returns
    the error entries to show (the adapter down, an outbox past its alarm). Never raises and never changes `decisions`:
    a down adapter cannot hide a local decision or stop local answering."""
    if external_settings(engine.config) is None:
        return []
    found = []
    try:
        sync = sync_for(engine)
        if sync is None:
            reason = getattr(engine, "external_sync_error", None) or "no state directory"
            _write_external_status(engine, {"state": "down", "reason": reason, "outbox": 0, "last_pull": None})
            return [{"source": "external", "error": "external decision system is down: %s" % reason}]
        status = sync.cycle(decisions, errors, getattr(engine, "decision_seeds", {}) or {},
                            getattr(engine, "decision_bosses", {}) or {})
        if status["state"] == "down":
            found.append({"source": "external", "error": "external decision system is down: %s" % status["reason"]})
        if status.get("alarm"):
            found.append({"source": "external", "error": "the outbox to the external decision system is past %d waiting "
                          "operations (none is dropped)" % engine.config["external_decisions"]["outbox_alarm_depth"]})
    except Exception as err:
        found.append({"source": "external", "error": _one_line("external decisions: %s: %s" % (type(err).__name__, err), 200)})
    return found


class EngineWorkHost(work_sync.Host):
    """What the work pump reads from this engine: the discovered fleet agents, the reports their bosses hold (the
    transcript reads the decisions already make, cached), the intent cache the daemon already holds, and the
    decision link table. Nothing here reads GitHub."""

    def __init__(self, engine):
        self.engine = engine

    def agents(self):
        discovery = self.engine.discovery
        found = []
        for name, obs in sorted((discovery.agents if discovery is not None else {}).items()):
            fleet = obs.fleet or {}
            found.append({"name": name, "role": fleet.get("role"), "reports_to": _boss_of(obs),
                          "repo": _fleet_repo(fleet, self.engine.config), "issue": _issue_of(fleet),
                          "status": obs.status, "intent": fleet.get("intent")})
        return found

    def reports(self):
        engine, discovery = self.engine, self.engine.discovery
        if discovery is None:
            return []
        since = engine.now() - engine.config["decisions_lookback_hours"] * 3600
        repos, found = decision_repos(engine), []
        for boss in sorted({boss_name(discovery, o) for o in discovery.agents.values()} - {None}):
            obs = discovery.agents.get(boss)
            if obs is None or obs.problem:
                continue
            for created, _, number, line in synthetic_lines(engine, obs.session_id, since):
                match = REPORT_LINE.match(line)
                if match:
                    sender = discovery.agents.get(match.group(1))
                    found.append({"sender": match.group(1), "issue": int(match.group(3)) if match.group(3) else None,
                                  "state": match.group(4), "text": match.group(5), "at": (created, number),
                                  "repo": repo_of_tag(match.group(2), repos)
                                  or (_fleet_repo(sender.fleet, engine.config) if sender else None)})
        source = _report_rider_source(engine)
        for item in (source.entries() if source is not None else []):
            state, _, text = item["summary"].partition(": ")
            sender = discovery.agents.get(item.get("from"))
            if item["created"] >= since and sender is not None:
                found.append({"sender": sender.name, "issue": item.get("issue"), "state": state, "text": text,
                              "at": (item["created"], 1 << 60),
                              "repo": item.get("repo") or _fleet_repo(sender.fleet, engine.config)})
        return found

    def title_of(self, repo, issue):
        return cached_issue_title(self.engine, repo, issue, {})

    def links(self):
        sync = getattr(self.engine, "external_sync", None)
        return dict(getattr(sync, "links", None) or {})

    def audit(self, event, subject, detail):
        if self.engine.audit is not None:
            self.engine.audit.append(self.engine.actor, event, subject, detail)


def work_sync_external(engine, now):
    """The end of a pass, after the decision sync: mirror worker assignments as work items when `work_items` is on and
    the adapter in use has a work sink. Never raises; nothing at all happens while either is off."""
    settings = external_settings(engine.config)
    if settings is None or not settings.get("work_items") or engine.state_dir is None:
        return
    try:
        sync = getattr(engine, "external_sync", None)
        sink = getattr(getattr(sync, "adapter", None), "work", None)
        if sink is None:
            return
        pump = getattr(engine, "work_pump", None)
        if pump is None:
            pump = engine.work_pump = work_sync.WorkSync(settings, engine.state_dir, sink, EngineWorkHost(engine), engine.now)
        pump.cycle()
    except Exception as err:
        try:
            engine._note("work.error", "pump", {"error": _one_line("%s: %s" % (type(err).__name__, err), 200)})
        except Exception:
            pass


def work_status_line(config, state_dir, now):
    """`work items: 3 open, last write 12s ago, 0 errors` (None when work items are off)."""
    settings = external_settings(config)
    if settings is None or not settings.get("work_items"):
        return None
    body = decision_sync._read_json(str(Path(state_dir) / work_sync.STATUS_FILE))
    if body is None:
        return "work items  waiting for the daemon's first pass"
    last = body.get("last_write")
    return "work items  %s open, last write %s, %s error(s)%s" % (
        body.get("open", 0), "%s ago" % format_age(now - last) if last else "never", body.get("errors", 0),
        "; ALARM: writes are piling up" if body.get("alarm") else "")


def _write_external_status(engine, status):
    try:
        decision_sync._write_json(str(Path(engine.state_dir) / decision_sync.STATUS_FILE),
                                  dict(status, written_at=engine.now()))
    except OSError:
        pass


def external_status_line(config, state_dir, now):
    """The one line `status` and `decisions` show: `external  ok; outbox N; last pull 12s ago`, or `down: why`. None
    when external decisions are off (nothing is printed then)."""
    if external_settings(config) is None:
        return None
    body = decision_sync._read_json(str(Path(state_dir) / decision_sync.STATUS_FILE))
    if body is None:
        return "external  waiting for the daemon's first pass"
    pulled = body.get("last_pull")
    text = "%s; outbox %s; last pull %s" % ("ok" if body.get("state") == "ok" else "down: %s" % body.get("reason"),
                                            body.get("outbox", 0), "%s ago" % format_age(now - pulled) if pulled else "never")
    failures = body.get("permanent_failures") or 0
    waiting = body.get("settled_waiting")
    if isinstance(waiting, int) and not isinstance(waiting, bool) and waiting > 0:   # decided outside, answer not here yet: never invisible if it never arrives
        oldest = body.get("settled_oldest")
        text += "; settled outside, waiting for its answer: %d%s" % (waiting, " (oldest %s)" % format_age(max(0, now - oldest)) if isinstance(oldest, (int, float)) and not isinstance(oldest, bool) else "")
    return ("external  " + text + ("; %d permanent failure(s)" % failures if failures else "")
            + ("; ALARM: outbox is deep" if body.get("alarm") else ""))


# ---------------------------------------------------------------- how many v2 calls the daemon makes (every one is an `opencode api` process)
V2_CALLS_FILE = "v2-calls.json"


def v2_calls_summary(v2, now):
    """{"at", "last_minute": {op: n}, "avg_5min": {op: n/min}} from the client's own call record, or None when it keeps none (a fake in a test)."""
    count = getattr(v2, "calls_by_operation", None)
    if count is None:
        return None
    summary = {"at": iso(now), "last_minute": count(60.0),   # the client's own clock: the calls were stamped with it
               "avg_5min": {op: round(n / 5.0, 1) for op, n in sorted(count(300.0).items())}}
    by_transport = getattr(v2, "calls_by_transport", None)
    if by_transport is not None:
        summary["by_transport"] = by_transport(60.0)   # the same record, the way each call travelled: http, cli, cli-fallback
    return summary


def record_v2_calls(engine):
    """After a pass: leave the figures where `status` can read them (a small file, renamed into place). Never raises."""
    try:
        if engine.state_dir is None:
            return
        summary = v2_calls_summary(engine.v2, engine.now())
        if summary is None:
            return
        if getattr(engine, "feed", None) is not None:
            summary["events"] = engine.feed.status()   # the event feed's figures beside the call figures: the same file, the same line
        path = Path(engine.state_dir) / V2_CALLS_FILE
        state_write(path, json.dumps(summary, sort_keys=True) + "\n", _without(summary, "at"), STATE_HEARTBEAT_SECONDS, nofollow=True)   # private; `status` reads its `at` as liveness, so a heartbeat
    except Exception as err:   # evidence only: a pass never fails for it, but the failure is said (once per change); state_write leaves no temp file
        try:
            engine._note("v2_calls.error", None, {"error": _one_line("%s: %s" % (type(err).__name__, err), 200)})
        except Exception:
            pass


GITHUB_CALLS_FILE = "github-calls.json"


def record_github_calls(engine):
    """After a pass: leave the GitHub read figures (by account and endpoint, the 304s, a pause) where `status` can read them. Never raises."""
    try:
        accounts = getattr(engine, "accounts", None)
        if engine.state_dir is None or not isinstance(accounts, GhAccounts):
            return
        summary = accounts.call_summary(engine.now())
        path = Path(engine.state_dir) / GITHUB_CALLS_FILE
        state_write(path, json.dumps(summary, sort_keys=True) + "\n", _without(summary, "at"), STATE_HEARTBEAT_SECONDS, nofollow=True)
        cursor, fresh = getattr(engine, "agent_calls_cursor", None), {}   # #367: the daemon's new calls, and the agent shells' spool, into the hourly count
        with accounts.lock:
            for at, account, endpoint, _ in accounts.calls:
                if cursor is None or at > cursor:
                    fresh.setdefault(account, {})
                    key = "api " + endpoint   # the form the shim writes (a command), so the one reduction reads it
                    fresh[account][key] = fresh[account].get(key, 0) + 1   # the daemon is the lane "daemon"; its calls carry their endpoint class
        if agent_calls.fold(str(engine.state_dir), engine.now(), fresh) or not fresh:
            engine.agent_calls_cursor = engine.now()   # advanced only once the calls are written: a failed write is counted at the next pass
        last_usage = getattr(engine, "usage_read_at", None)
        if last_usage is None or engine.now() - last_usage >= agent_calls.USAGE_EVERY:
            engine.usage_read_at = engine.now()   # once a minute, tried again next minute whatever happens
            agent_calls.record_usage(str(engine.state_dir), engine.now(), accounts.read_usage())
    except Exception as err:
        try:
            engine._note("github_calls.error", None, {"error": _one_line("%s: %s" % (type(err).__name__, err), 200)})
        except Exception:
            pass


def github_calls_status(state_dir, now):
    """The `status` lines for GitHub reads: `github calls/min by account: work 14 (issues/# 9, pulls 4), default 2 (5-min average 11/min; 5 not modified)`, and
    `github: rate limited until 14:05, reads paused` while an account is paused. Empty list without a record."""
    try:
        body = json.loads((Path(state_dir) / GITHUB_CALLS_FILE).read_text())
        lines = []
        last = body["last_minute"]
        parts = []
        for account, endpoints in sorted(last.items(), key=lambda kv: -sum(kv[1].values())):
            top = ", ".join("%s %d" % (name, n) for name, n in sorted(endpoints.items(), key=lambda kv: -kv[1])[:3])
            parts.append("%s %d (%s)" % (_plain(account, 40), sum(endpoints.values()), top))
        text = "%s (5-min average %.0f/min; %d not modified)" % (", ".join(parts) or "none", body["avg_5min"], body.get("not_modified", 0))
        at = parse_iso(body.get("at"))
        if at is not None and now - at > 120:
            text += "; recorded %s ago: the daemon is not passing" % format_age(now - at)
        lines.append("github calls/min by account: " + text)
        for account, until in sorted((body.get("paused") or {}).items()):
            moment = parse_iso(until)
            if moment is not None and moment > now:
                lines.append("github: rate limited until %s, reads paused (account %s)" % (time.strftime("%H:%M", time.localtime(moment)), _plain(account, 40)))
        return lines
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        return []


def v2_calls_status(state_dir, now):
    """The `status` line text: `14/min (session.get 9, ...; 5-min average 11/min)`, or None without a record. Says so when the record is old."""
    try:
        body = json.loads((Path(state_dir) / V2_CALLS_FILE).read_text())
        last = body["last_minute"]
        by = ", ".join("%s %d" % (op, n) for op, n in sorted(last.items(), key=lambda kv: -kv[1])[:4])
        average = sum(body["avg_5min"].values())
        text = "%d/min (%s; 5-min average %.0f/min)" % (sum(last.values()), by or "none", average)
        travelled = body.get("by_transport")
        if isinstance(travelled, dict) and travelled:
            text += "; by transport: " + ", ".join("%s %d" % (name, n) for name, n in sorted(travelled.items()) if isinstance(n, int))
        events = body.get("events")
        if isinstance(events, dict):
            text += "; events: %s (%s heard, %s resync, %s missed)" % ("stream" if events.get("connected") else "DOWN: old reads", events.get("events"),
                                                                       events.get("resyncs"), events.get("missed"))
        at = parse_iso(body.get("at"))
        if at is not None and now - at > 120:
            text += "; recorded %s ago: the daemon is not passing" % format_age(now - at)
        return text
    except (OSError, ValueError, KeyError, TypeError, AttributeError):   # a record of any other shape is no record
        return None


EARLY_DECISIONS_AGE = DECISIONS_STALE_SECONDS // 3   # a file this old (or missing) is written before the heavy sources are collected: a third of the staleness bound (60 s of 180 s)


def early_decisions(engine, discovery=None):
    """(#467) At the START of a pass (after `discover`, before the fact sources): when the decisions file is missing or older than EARLY_DECISIONS_AGE, derive
    the list from its OWN sources and write it now, so a heavy source (the sweep, triage, the load alert, a first catch-up after a restart under load) cannot delay
    it past the staleness bound. Its own sources include the pending permission requests and questions, which only the worker source reads: that source is
    run first and its facts are kept for this pass's fact collection (it is read once, not twice). The early step is skipped, writing and touching nothing, when
    the fleet could not be read (`discovery` has problems: a list built from half a fleet must not look fresh), when the worker source or the derivation
    raises (`decisions.early_error` is noted), and when a fresh file is there (steady state: the end of the pass publishes exactly as before). What it
    writes is provisional: the end of the pass derives again and publishes (the sweep may withdraw or add). The file's time changes only through the store's
    own write, with content derived from reads just made. The in-memory request records it sets are the end-of-pass derivation's too. Never raises.
    Returns True when it wrote."""
    state = engine.state_dir
    if state is None or engine.audit is None or fault("no-decisions-file"):
        return False
    if discovery is None or discovery.problems:
        return False
    try:
        try:
            age = engine.now() - (Path(state) / DECISIONS_FILE).stat().st_mtime
        except OSError:
            age = None   # missing or unreadable: write it now
        if age is not None and age < EARLY_DECISIONS_AGE:
            return False
        now = engine.now()
        worker = next((x for x in engine.sources if isinstance(x, WorkerFacts)), None)
        if worker is not None:
            engine._early_facts = {id(worker): worker()}   # the pending requests are filled by this call; collect_facts reuses its facts
        kept = {name: copy.deepcopy(engine.__dict__[name]) for name in ("notice_obs", "notice_effects") if name in engine.__dict__}
        try:
            decisions, errors = derive_decisions(engine, now)
        finally:   # the derivation advances the notice time accounting: the end of the pass derives again and must see it as it was
            for name in ("notice_obs", "notice_effects"):
                if name in kept:
                    engine.__dict__[name] = kept[name]
                else:
                    engine.__dict__.pop(name, None)
        return bool(decision_store(engine).publish(decisions, errors, now, provisional=True))   # provisional: the end of this pass publishes the final list
    except Exception as err:   # a pass that cannot read its decision sources writes nothing here; the end of the pass says the same
        engine._early_facts = {}
        engine._note("decisions.early_error", None, {"error": _one_line("%s: %s" % (type(err).__name__, err), 200)})
        return False


def publish_decisions(engine):
    """The end of a pass: derive the list and hand it to the store (decisions.json when it changed, else a touch, so
    its age says the daemon is alive). Returns True when written."""
    state = engine.state_dir
    if state is None or engine.audit is None or fault("no-decisions-file"):
        return False
    now = engine.now()
    decisions, errors = derive_decisions(engine, now)
    try:
        decisions = sweep_decisions(engine, decisions, now, errors)  # #117: withdraws the stale, finds the rest; never raises
    except Exception as err:
        engine._note("sweep.error", None, {"error": _one_line("%s: %s" % (type(err).__name__, err), 200)})
    try:
        triage_pass(engine, decisions, now, errors)  # #130: audits and counts; writes nothing to GitHub; never raises
    except Exception as err:
        engine._note("triage.error", None, {"error": _one_line("%s: %s" % (type(err).__name__, err), 200)})
    try:
        pr_events_pass(engine, now)   # #354: folds the webhook events into the pr-state picture and writes it, for watched repos too; no GitHub call
    except Exception as err:
        engine._note("pr_state.error", None, {"error": _one_line("%s: %s" % (type(err).__name__, err), 200)})
    try:
        ci_record_pass(engine, now)   # #107: records ci verdicts for open PRs under a plan; reads GitHub, writes only the ledger and audit
    except Exception as err:
        engine._note("ci_record.error", None, {"error": _one_line("%s: %s" % (type(err).__name__, err), 200)})
    try:
        pane_health_pass(engine, now)   # the control plane: detached or dead panes, reads only, wakes the Chief of Staff
    except Exception as err:
        engine._note("fleetpane.error", None, {"error": _one_line("%s: %s" % (type(err).__name__, err), 200)})
    try:
        pane_exit_pass(engine, now)   # why a pane ended: herdr's log read-only and bounded, one `fleetpane.exit` line per exit
    except Exception as err:
        engine._note("fleetpane.error", None, {"error": _one_line("%s: %s" % (type(err).__name__, err), 200)})
    try:
        adoption_pass(engine, now)   # #838: a worker whose boss is gone is adopted by its charter's orchestrator, else the Chief of Staff
    except Exception as err:
        engine._note("boss.adoption_error", None, {"error": _one_line("%s: %s" % (type(err).__name__, err), 200)})
    chat_clear_pass(engine, decisions, now)   # #457: the owner clears a held PR in his chat; SHADOW unless chat_clear.live; never raises
    try:
        impact_would_hold_pass(engine, now)   # #179 L3: audits gate.would_hold from the diff's floor; ADVISORY, writes nothing to GitHub
    except Exception as err:
        engine._note("impact.error", None, {"error": _one_line("%s: %s" % (type(err).__name__, err), 200)})
    try:
        clear_notice_pass(engine, now)   # #827: delivers the clear notices still pending, drops one whose pull request merged, closed or changed head, and sends the one "cleared, merge it" reminder
    except Exception as err:
        engine._note("gate.clear_notify_failed", None, {"error": _one_line("%s: %s" % (type(err).__name__, err), 200)})
    try:
        merged_labels = load_module("merged_labels")   # #559: the merge and hold labels of a merged PR come off (fresh read, fleet labels only)
        merged_labels.run_pass(types.SimpleNamespace(**{n: globals()[n] for n in merged_labels.NEEDS}), engine, now,
                               ((engine.config.get("impact_hold") or {}).get("calls_per_pass") or IMPACT_PASS_CALLS))   # its own cap of gh reads, the impact hold's setting
    except Exception as err:
        engine._note("merged_labels.error", None, {"error": _one_line("%s: %s" % (type(err).__name__, err), 200)})
    try:
        closed_labels = load_module("closed_labels")   # #570: a closed issue's awaiting labels come off (fresh read, fleet prefix only, one line to the Chief of Staff)
        closed_labels.run_pass(types.SimpleNamespace(**{n: globals()[n] for n in closed_labels.NEEDS}), engine, now,
                               ((engine.config.get("impact_hold") or {}).get("calls_per_pass") or IMPACT_PASS_CALLS))
    except Exception as err:
        engine._note("closed_labels.error", None, {"error": _one_line("%s: %s" % (type(err).__name__, err), 200)})
    try:
        ejections = load_module("queue_ejections")   # #584: a pull request ejected from the merge queue wakes its orchestrator with the failing tests
        ejections.run_pass(types.SimpleNamespace(**{n: globals()[n] for n in ejections.NEEDS}), engine, now,
                           ((engine.config.get("impact_hold") or {}).get("calls_per_pass") or IMPACT_PASS_CALLS))
    except Exception as err:
        engine._note("queue_ejection.error", None, {"error": _one_line("%s: %s" % (type(err).__name__, err), 200)})
    apply_notice_effects(engine)
    store = decision_store(engine)
    try:
        prune_escalations_pass(engine, store, now)
    except OSError:
        pass  # a disposable file: a failed prune is tried again next pass
    errors = errors + sync_external(engine, decisions, errors, now)  # [] unless external_decisions is enabled
    work_sync_external(engine, now)  # nothing unless external_decisions.work_items is on
    published = store.publish(decisions, errors, now)
    engine.awaiting_first_full_pass = False   # #796: a full, non-provisional list is out; the load tick may judge from the next one
    return published


def decisions_report(state_dir, now):
    """What the file says now: {stale, message, age_seconds, written_at, generation, decisions, errors}.

    `stale` is true when the file is missing, unreadable, or older than DECISIONS_STALE_SECONDS by mtime
    (every pass refreshes it): a list the daemon does not keep current is never shown as current. Under the
    `stale-as-fresh` fault an old file still counts as current."""
    path = Path(state_dir) / DECISIONS_FILE
    report = {"stale": True, "message": None, "age_seconds": None, "written_at": None, "generation": None,
              "decisions": [], "errors": []}
    try:
        age = now - path.stat().st_mtime
    except OSError:
        report["message"] = "the daemon is not updating this list: there is no %s in %s" % (DECISIONS_FILE, state_dir)
        return report
    body = read_decisions_file(path)
    if body is None:
        report["message"] = "the daemon is not updating this list: %s cannot be read" % path
        return report
    report.update(decisions=body["decisions"], errors=body["errors"], written_at=body.get("written_at"),
                  generation=body.get("generation"), age_seconds=max(0, int(age)))
    if body.get("provisional") is True:
        report["provisional"] = True   # only when it is: the shape of the report is otherwise what it always was
    if age > DECISIONS_STALE_SECONDS and not fault("stale-as-fresh"):
        report["message"] = "the daemon is not updating this list: %s was last written %s ago" % (
            DECISIONS_FILE, format_age(age))
    else:
        report["stale"] = False
    return report


def format_age(seconds):
    """`45s`, `12m`, `1h05m`, `3d`: the longest unit that fits, never more than a few characters."""
    seconds = max(0, int(seconds))
    if seconds < 60:
        return "%ds" % seconds
    if seconds < 3600:
        return "%dm" % (seconds // 60)
    if seconds < 86400:
        return "%dh%02dm" % (seconds // 3600, seconds % 3600 // 60) if seconds % 3600 // 60 else "%dh" % (seconds // 3600)
    return "%dd" % (seconds // 86400)


DECISION_TIERS = decision_core.DECISION_TIERS
DECISION_LONG_WAIT = decision_core.DECISION_LONG_WAIT   # seconds: a decision waiting longer is "over 1h" (the panel's LONG_WAIT_SECONDS; a test keeps them equal)


def count_over_an_hour(decisions, now):
    return decision_core.count_over_an_hour(decisions, now)


def decisions_view(fleet, config, repo=None, tier=None):
    """PR 18: which decisions a caller sees (the rules are decision_core's): {"role", "repo", "tiers", "text"}."""
    role = (fleet or {}).get("role")
    return decision_core.decisions_view(role, _fleet_repo(fleet, config) if role == "orchestrator" else None,
                                        repo, tier)


def select_decisions(decisions, view):
    return decision_core.select_decisions(decisions, view)


def format_decisions(report, now, view=None):
    """The human text: one line per decision, `<id>  waiting <age>  <agent>  <title>`, columns aligned.
    With a `view` (PR 18) the first line says which view this is, and a view that mixes tiers shows each one."""
    if report["stale"]:
        return "Decisions unavailable: %s. Start it with `%s ensure`, or read the facts now with `%s decisions --fresh`." % (
            report["message"], PROG, PROG)
    decisions = decision_core.arranged(report["decisions"])   # as listed, unless some decision says what it waits for (then: by order)
    human_only = view is None or view["tiers"] == ["human"]
    if not decisions:
        lines = ["No decisions are waiting on you." if human_only else "No decisions in this view."]
    else:
        agents = [d.get("agent") or "-" for d in decisions]
        indents = ["   " * min(d.get("depth") or 0, decision_core.ORDER_DEPTH_MAX) if isinstance(d.get("depth"), int) else "" for d in decisions]
        width_id, width_agent = max(len(i) + len(d["id"]) for i, d in zip(indents, decisions)), max(len(a) for a in agents)
        lines = []
        for decision, agent, indent in zip(decisions, agents, indents):
            since = parse_iso(decision.get("since"))
            tier = "" if human_only else "[%s]  " % decision.get("tier", "human")
            note = {"next": "  [next]", "cycle": "  [cycle: they wait for each other]"}.get(decision.get("mark"), "")
            if decision.get("blocked_by"):
                note += "  [waits for %s]" % decision["blocked_by"]
            lines.append("%s  waiting %s  %s%s  %s%s" % ((indent + decision["id"]).ljust(width_id),
                                                        format_age(now - since) if since is not None else "?",
                                                        tier, agent.ljust(width_agent), decision["title"], note))
        lines = [line.rstrip() for line in lines]
        if report.get("fresh"):  # --fresh says, for an open report, which send it looked at (or that there was none)
            lines = [line for pair in zip(lines, [("      " + d["considered"]) if d.get("considered") else None
                                                   for d in decisions]) for line in pair if line is not None]
    lines.extend("(could not read %s: %s)" % (e.get("source"), e.get("error")) for e in report["errors"])
    if view is not None:
        lines.insert(0, "Decisions: %s" % view["text"])
    return "\n".join(lines)


def fresh_engine_decisions(runner, now, writable=False):
    """(engine, decisions, errors) derived now in this process: GitHub is read here, once per repo and label,
    because this process has no hub kept current by webhook events."""
    engine, state, config = build_engine(runner, now, "cli", writable=writable)
    engine.discover(now())
    engine.collect_facts()
    repos = decision_repos(engine)
    if repos:
        hub = GitHubHub(config, state, None, runner, spawn_forwarder, now, "cli")
        hub.engine, engine.hub = engine, hub
        for repo in repos:  # every watched repo, each read with its own account (the hub's gh_api picks it)
            hub.read_awaiting(repo, now())
    decisions, errors = derive_decisions(engine, now())
    return engine, decisions, errors


def fresh_decisions(runner, now):
    """`decisions --fresh`: derive the list in this process, read-only, and write nothing."""
    _, decisions, errors = fresh_engine_decisions(runner, now)
    return {"stale": False, "message": None, "age_seconds": 0, "written_at": iso(now()), "generation": None,
            "decisions": decisions, "errors": errors, "fresh": True}


def watch_decisions(state_dir, now=time.time, sleep=time.sleep, write=None, clear=False, view=None):
    """`decisions --watch`: draw the list, then every second look again and draw it when it differs. Stdlib
    only, for a terminal that has no TUI plugin (a herdr side pane). Ends on Ctrl-C."""
    write = write or sys.stdout.write
    last = None
    try:
        while True:
            report = decisions_report(state_dir, now())
            if view is not None:
                report = dict(report, decisions=select_decisions(report["decisions"], view))
            text = format_decisions(report, now(), view)
            if text != last:
                write(("\x1b[2J\x1b[H" if clear else "") + text + "\n")
                last = text
            sleep(1)
    except KeyboardInterrupt:
        return EXIT_OK


def decisions_caller(args, runner, now):
    """The caller's fleet metadata for a read: its pane's fleet agent, `--from` in the Lab, or {} for anyone who
    is not a fleet agent (a plain shell, a TUI): the human's view."""
    if getattr(args, "sender", None) is not None:
        if os.environ.get(LAB_ENV) != "1":
            raise CallerError("--from is only for the Lab (%s=1); an agent is identified by its pane" % LAB_ENV)
        engine, _, _ = build_engine(runner, now, "cli", writable=False)
        found = engine.discover(engine.now()).agents.get(args.sender)
        if found is None:
            raise CallerError("%s is not a fleet agent the switchboard can see" % args.sender)
        return found.fleet or {}
    if not os.environ.get("HERDR_PANE_ID") and not os.environ.get(SESSION_ENV):
        return {}
    try:
        engine, _, _ = build_engine(runner, now, "cli", writable=False)
        return caller_fleet(engine.herdr, engine.v2, os.environ)
    except IdentityUncertain:
        raise  # never the human's view: an uncertain identity is refused
    except (CallerError, ConfigError, V2Error, HerdrError):
        return {}  # a person's own shell inside herdr has a pane and no agent: the human's view, never a crash


def held_merge_order_hints(decisions, runner, now):
    """#818: advisory `merge order: #A, then #B (shared files)` lines among the HELD pull requests of the listed decisions (kind `captain`) that share files, the one
    that has waited longest first. ONE bounded read per repo that has two or more held pull requests (CLI only, never the daemon); any failure gives no hint."""
    by_repo = {}
    for d in decisions:
        since = parse_iso(d.get("since"))
        if d.get("kind") == "captain" and d.get("repo") and isinstance(d.get("number"), int) and since is not None:
            by_repo.setdefault(d["repo"], {})[d["number"]] = since
    hints = []
    for repo, waited in sorted(by_repo.items()):
        if len(waited) < 2:
            continue
        try:
            engine = build_engine(runner, now, "cli", writable=False)[0]
            listing = read_open_overlap(engine, repo, runner)
            if listing:
                hints.extend(("%s: " % repo if len(by_repo) > 1 else "") + h for h in overlap_waiting_order(listing, sorted(waited.items())))
        except Exception:
            continue
    return hints


def cmd_decisions(args, runner, now):
    action = getattr(args, "decisions_action", None) or "list"
    if action != "list":
        return cmd_decision_write(args, action, runner, now)
    if args.watch and args.fresh:
        sys.stderr.write("%s: --watch reads the file the daemon writes; it cannot be combined with --fresh\n" % PROG)
        return EXIT_USAGE
    if args.repo is not None and not REPO_RE.match(args.repo):
        sys.stderr.write("%s: --repo must be OWNER/REPO, got %r\n" % (PROG, args.repo))
        return EXIT_USAGE
    try:
        fleet = decisions_caller(args, runner, now)
    except CallerError as err:
        sys.stderr.write("%s: %s\n" % (PROG, err))
        return EXIT_USAGE
    try:
        config = load_config()
    except ConfigError:
        config = {}
    view = decisions_view(fleet, config, args.repo, args.tier)
    state = state_dir_path()
    if args.watch:
        return watch_decisions(state, now, clear=sys.stdout.isatty(), view=view)
    report = fresh_decisions(runner, now) if args.fresh else decisions_report(state, now())
    shown = dict(report, decisions=select_decisions(report["decisions"], view))
    external = external_status_line(config, state, now()) if config else None
    hints = [] if report["stale"] else held_merge_order_hints(shown["decisions"], runner, now)
    if args.json:
        extra = {"external": external} if external is not None else {}
        if hints:
            extra["merge_order"] = hints
        print(json.dumps(dict(shown, message=report["message"] or None, view=view, **extra), indent=2, sort_keys=True))
    else:
        print(format_decisions(shown, now(), view))
        for hint in hints:
            print(hint)
        if external is not None:
            print("(%s)" % external)
    return EXIT_ERROR if report["stale"] else EXIT_OK


cmd_decisions.ensure_on_use = True   # the daemon is alive when it runs


def decisions_summary(state_dir, now):
    """For `status`: how many decisions the file lists (and how many of them are yours, the Chief of Staff's, an
    orchestrator's), and whether the daemon keeps it current."""
    report = decisions_report(state_dir, now())
    by_repo, by_tier = {}, {}
    listed = [d for d in report["decisions"] if d.get("kind") != "notice"]  # a PR notice is information, not a decision
    over_cos = count_over_an_hour([d for d in listed if d.get("tier", "human") == "cos"], now())
    for decision in listed:
        tier = decision.get("tier", "human")
        by_tier[tier] = by_tier.get(tier, 0) + 1
        if decision.get("repo") and tier == "human":
            by_repo[decision["repo"]] = by_repo.get(decision["repo"], 0) + 1
    return {"count": len(listed), "stale": report["stale"], "message": report["message"],
            "age_seconds": report["age_seconds"], "errors": len(report["errors"]), "by_repo": by_repo,
            "by_tier": by_tier, "cos_over_an_hour": over_cos, **({"provisional": True} if report.get("provisional") else {})}


def format_decisions_status(summary):
    if summary["stale"]:
        return ["      decisions  %s" % summary["message"]]
    tiers = summary.get("by_tier") or {}
    yours = tiers.get("human", 0) if tiers else summary["count"]
    line = "      decisions  %d waiting on you (`%s decisions`)" % (yours, PROG)
    by_repo = summary.get("by_repo") or {}
    if len(by_repo) > 1:  # with one repo there is nothing to tell apart
        line = "      decisions  %d waiting on you (%s; `%s decisions`)" % (
            yours, ", ".join("%s %d" % (repo, count) for repo, count in sorted(by_repo.items())), PROG)
    elsewhere = {tier: count for tier, count in tiers.items() if tier != "human"}
    if elsewhere:
        line += "; also open: %s" % ", ".join(
            "%d with the Chief of Staff (%d over 1h)" % (count, summary.get("cos_over_an_hour", 0)) if tier == "cos"
            else "%d with an orchestrator" % count for tier, count in sorted(elsewhere.items()))
    line += "; provisional: the pass that wrote it is still reading" if summary.get("provisional") else ""
    return [line + ("; %d source(s) could not be read" % summary["errors"] if summary["errors"] else "")]


# ---- toasts

def note_unreachable(engine, recipient, fresh, why):
    """The re-check could not read the recipient at all (pane closed, session gone):
    the pass's render step toasts it, once, like every other toast."""
    if fresh is None:
        engine.pass_toasts[recipient] = ("unreachable: " + why, "Fleet: %s cannot be reached" % recipient,
                                         _one_line("Held, nothing sent to %s: %s" % (recipient, why), 200))


def collect_source_toasts(engine):
    """What the fact sources and this pass's re-checks ask the human to be told."""
    found = {}
    for source in engine.sources:
        toasts = getattr(source, "toasts", None)
        for agent, reason, title, body in toasts() if toasts else []:
            found[agent] = (reason, title, body)
    found.update(engine.pass_toasts)
    return found


# ---- #467 slice 3: what is still catching up after a start, for `status` (which runs in another process)

CATCHING_UP_FILE = "catching-up.json"
CATCHING_UP_REWRITE_SECONDS = 120    # an unchanged pending state is rewritten this often, so its age says the daemon is alive
CATCHING_UP_SHOW_SECONDS = 600       # `status` shows a record at most this old: a daemon that stopped updating it says nothing
CATCHING_UP_LABELS = {"load_alert": "load alert", "charters": "charter orders", "catch_up": "catch-up"}


def write_catching_up(engine):
    """The pending state of the budgeted readers (`source_states`) as a small file: only what is still pending, names and counts (0600), rewritten only when it
    changes or is older than CATCHING_UP_REWRITE_SECONDS. An idle pass with nothing pending writes nothing (the file, if there is one, is made empty once)."""
    if engine.state_dir is None:
        return False
    pending = {name: info["pending"] for name, info in sorted(source_states(engine).items()) if info.get("state") == "pending"}
    now = engine.now()
    last = engine.__dict__.get("_catching_up_written")
    if last is not None and last[0] == pending and (now - last[1] < CATCHING_UP_REWRITE_SECONDS or not pending):
        return False
    path = Path(engine.state_dir) / CATCHING_UP_FILE
    if last is None and not pending and not path.exists():
        engine._catching_up_written = (pending, now)
        return False
    temp = path.with_name("%s.%d.tmp" % (CATCHING_UP_FILE, os.getpid()))
    fd = os.open(str(temp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        with os.fdopen(fd, "w") as handle:
            json.dump({"at": iso(now), "sources": pending}, handle, sort_keys=True)
            handle.write("\n")
        os.replace(str(temp), str(path))
    except BaseException:
        try:
            os.unlink(str(temp))
        except OSError:
            pass
        raise
    engine._catching_up_written = (pending, now)
    return True


CATCHING_UP_READ_BYTES = 65536   # the file is small by construction; more than this is not ours


def catching_up_lines(state_dir, now):
    """For `status`: ONE line naming the sources still catching up, or [] (nothing pending, no file, a file that cannot be read or is too large, a record the daemon
    has stopped updating, or one dated in the future). Everything shown is cut to one short plain line. Never raises."""
    try:
        with open(str(Path(state_dir) / CATCHING_UP_FILE), "rb") as handle:
            raw = handle.read(CATCHING_UP_READ_BYTES + 1)
        if len(raw) > CATCHING_UP_READ_BYTES:
            return []
        body = json.loads(raw.decode("utf-8"))
        sources = body["sources"]
        written = datetime.strptime(body["at"], "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc).timestamp()
        age = now - written
        if not isinstance(sources, dict) or age > CATCHING_UP_SHOW_SECONDS or age < -60:
            return []
        parts = []
        for name in sorted(sources, key=str):
            waiting = [str(w) for w in sources[name] if isinstance(w, str)] if isinstance(sources[name], list) else []
            if waiting:
                label = CATCHING_UP_LABELS.get(name) or _plain(name, 30)
                parts.append("%s (%d: %s%s)" % (label, len(waiting), ", ".join(_plain(w, 40) for w in waiting[:3]), ", ..." if len(waiting) > 3 else ""))
        return ["      catching up  %s" % "; ".join(parts)] if parts else []
    except (OSError, ValueError, KeyError, TypeError, AttributeError, RecursionError):
        return []


def finish_pass(engine, discovery, report):
    """The end of a pass: reminders that reached their recipient are pruned. A failure is
    audited and never stops the pass."""
    try:
        prune_delivered_reminders(engine, discovery)
    except Exception as err:
        engine._failed("reminders", "reminders", err, report)
    try:
        friction_tick(engine, discovery)
    except Exception as err:
        engine._failed("friction-wake", "friction-wake", err, report)
    try:
        load_tick(engine, discovery)
    except Exception as err:
        engine._failed("load-alert", "load-alert", err, report)
    try:
        prune_report_riders(engine, discovery)
    except Exception as err:
        engine._failed("report-riders", "report-riders", err, report)
    try:
        publish_decisions(engine)
    except Exception as err:
        engine._failed("decisions", "decisions", err, report)
    try:
        write_catching_up(engine)
    except Exception as err:
        engine._failed("catching-up", "catching-up", err, report)
    try:
        health_write(engine, None, engine.now())   # #357: not tied to the GitHub ci recorder, which returns early on a fleet with no plan_gates
    except Exception as err:
        engine._failed("health-records", "health-records", err, report)
    schedule_judge_warm(engine, discovery)


# ---- #117: the "waiting on the person" sweep. Deterministic (no model), over what the hub can read in a few bounded,
# cached list reads per repo. S1 a decision section and the awaiting label disagree; S2 a PR held for the person that is
# not a `MERGE: captain` PR; S3 something said to wait on the person that is not in the human tier; S4 a decision whose
# issue or PR is closed (withdrawn); S5 a cos-tier decision that has aged. It never edits GitHub and never changes a tier.

SWEEP_DEFAULTS = {"enabled": False, "aged_cos_hours": 2, "comment_window_days": 7, "max_findings": 20,
                  "realarm_hours": 6, "person_names": ["the owner"], "calls_per_pass": 12}
SWEEP_S6A_GRACE = 900         # a PR younger than this is not yet "marker without label": the label is applied after it opens
SWEEP_S1A_GRACE = 600         # a decision section whose issue changed this recently may be mid-escalation (one label off, the next not yet on)
SWEEP_TTL = 900               # seconds a repo's lists are kept before they are read again
SWEEP_CALLS_PER_PASS = SWEEP_DEFAULTS["calls_per_pass"]   # default of `sweep.calls_per_pass`: the most `gh` calls one pass makes
SWEEP_CALLS_CAP = 100
SWEEP_CONFIRM_RESERVE = 2     # of them, kept for the single-issue reads (is this decision's issue closed?)
SWEEP_PASS_SECONDS = 8        # no new read is started once the sweep has spent this long in a pass
SWEEP_LIST_PAGES = 2          # pages one list read follows (200 records); more is shown as capped
SWEEP_PR_COMMENTS = 5         # the last comments of an item that are searched for the phrases
SWEEP_FILE = "sweep.json"
SWEEP_ALARMED_FILE = "sweep-alarmed.json"   # #805: when each finding was last raised, so the re-alarm window survives a restart
SWEEP_KINDS = {"S6a": "first-line marker without the merge-captain label (our PR)", "S6b": "merge label and first-line marker disagree",
               "S1a": "decision section without an awaiting label", "S1b": "awaiting label without a decision section",
               "S2": "held for the person but not marked as a captain PR (no merge-captain label)", "S3": "said to wait on the person, not in their tier",
               "S5": "cos-tier decision aged (and not already in the owner's tier)",
               "S7": "decisions that wait for each other (a cycle): none of them can be done first",
               "S8": "a decision waits for an issue that is closed or missing",
               "S9": "a merge or hold label left on a closed, unmerged PR",
               "S10": "a charter recorded by two orchestrators in the registry (the lane of its pull requests is unknown)"}
SWEEP_WAIT_VERBS = ("held for", "hold for", "waiting on", "waits on", "awaiting", "blocked on", "pending", "needs")


def validate_sweep_config(config, source):
    """`sweep`: absent, null or {} runs in shadow (findings are audited, nobody is woken, nothing is withdrawn) until
    `enabled` is true; an absent key adds nothing to the config. `false` turns the sweep fully off (no reads, no writes)."""
    if "sweep" not in config:
        return
    raw = config["sweep"]
    if raw is False:
        return
    if raw is None:
        config["sweep"] = dict(SWEEP_DEFAULTS, person_names=list(SWEEP_DEFAULTS["person_names"]))
        return
    if not isinstance(raw, dict):
        raise ConfigError("%s: 'sweep' must be an object, got %r" % (source, type(raw).__name__))
    unknown = sorted(set(raw) - set(SWEEP_DEFAULTS))
    if unknown:
        warn_unknown_config("%s: 'sweep' has key(s) this tool does not read: %s (known: %s)"
                          % (source, ", ".join(unknown), ", ".join(SWEEP_DEFAULTS)), 'sweep', unknown, list(SWEEP_DEFAULTS))
    section = dict(SWEEP_DEFAULTS, **raw)
    where = "%s: 'sweep" % source
    if not isinstance(section["enabled"], bool):
        raise ConfigError("%s.enabled' must be true or false, got %r" % (where, section["enabled"]))
    for key in ("aged_cos_hours", "comment_window_days", "realarm_hours"):
        if not _is_number(section[key]) or section[key] <= 0:
            raise ConfigError("%s.%s' must be a positive number, got %r" % (where, key, section[key]))
    cap = section["max_findings"]
    if not isinstance(cap, int) or isinstance(cap, bool) or not 1 <= cap <= 200:
        raise ConfigError("%s.max_findings' must be a whole number from 1 to 200, got %r" % (where, cap))
    calls = section["calls_per_pass"]
    if not isinstance(calls, int) or isinstance(calls, bool) or not 4 <= calls <= SWEEP_CALLS_CAP:
        raise ConfigError("%s.calls_per_pass' must be a whole number from 4 to %d, got %r" % (where, SWEEP_CALLS_CAP, calls))
    names = section["person_names"]
    if not isinstance(names, list) or not names or not all(isinstance(n, str) and re.fullmatch(r"[\w@ .-]{1,40}", n)
                                                           for n in names):
        raise ConfigError("%s.person_names' must be a non-empty list of names, got %r" % (where, names))
    section["person_names"] = list(names)
    config["sweep"] = section


def sweep_phrase_re(names):
    """The phrases that say an item waits on the person: held for / hold for / waiting on / waits on / awaiting /
    blocked on / pending / needs <name>, `<name> to review|approve|decide|merge|answer`, and `for <name>'s review`.
    Whole phrases, case-insensitive; a curly apostrophe is the straight one. `names` may hold a handle (`@login`)."""
    who = "|".join(re.escape(n) for n in names)
    verbs = "|".join(re.escape(v) for v in SWEEP_WAIT_VERBS)
    return re.compile(r"(?<![\w])(?:(?:%s)\s+(?:%s)|(?:%s)\s+to\s+(?:review|approve|decide|merge|answer)"
                      r"|for\s+(?:%s)'s\s+review)(?![\w])" % (verbs, who, who, who), re.I)


SWEEP_STRONG_VERBS = ("waiting on", "waits on", "held for")
SWEEP_STRONG_NEEDS = ("decision", "yes", "answer", "approval", "review", "ok")
SWEEP_HEDGE_RE = re.compile(r"\b(?:if|would|may|proposal|proposals|option|options|could|says|saying|said"
                            r"|when|once|before|after|later|deferred|parked|not started)\b", re.I)   # the later words name a FUTURE gate
SWEEP_FUTURE_AFTER_RE = re.compile(r"\b(?:deferred|parked|not started|when (?:picked up|a quiet window))\b", re.I)


def sweep_strong_re(names):
    """The strong forms only (S3): waiting on / waits on / held for <name>, needs <name>'s decision|yes|answer|approval|
    review|OK, for <name>'s review. Whole phrases, any case."""
    who = "|".join(re.escape(n) for n in names)
    verbs = "|".join(re.escape(v) for v in SWEEP_STRONG_VERBS)
    needs = "|".join(SWEEP_STRONG_NEEDS)
    return re.compile(r"(?<![\w])(?:(?:%s)\s+(?:%s)|needs\s+(?:%s)'s\s+(?:%s)|for\s+(?:%s)'s\s+review)(?![\w])"
                      % (verbs, who, who, needs, who), re.I)


SWEEP_BOUNDARY_RE = re.compile(r"(?<=[.!?])\s+|\n")
SWEEP_REF_RE = re.compile(r"(?<![\w/&#])(?:([\w.-]+/[\w.-]+)|([\w.-]+))?#(\d+)\b")


def sweep_strong_statement(strong, text, default_repo, repos, matched=None):
    """(fires, refs): whether `text` states, in a strong form that no hedge or negation cancels, that something waits on the
    person, and the refs `[(repo, number)]` its sentence(s) NAME (`#N`, `repo#N`, `owner/repo#N`; a bare `#N` is in
    `default_repo`, a short `repo#N` among `repos`). A sentence ends at `.`, `!` or `?` followed by a space, or a line end,
    so `v3.3, #9101` stays one sentence. No refs means the statement names nothing by itself."""
    if not isinstance(text, str):
        return False, []
    text = SWEEP_QUOTED_RE.sub(" ", text.replace("\u2019", "'"))
    fires, refs = False, []
    for match in strong.finditer(text):
        before = [m.end() for m in SWEEP_BOUNDARY_RE.finditer(text, 0, match.start())]
        start = before[-1] if before else 0
        after = SWEEP_BOUNDARY_RE.search(text, match.end())
        sentence_end = after.start() if after else len(text)
        if SWEEP_HEDGE_RE.search(text[start:match.start()]) or SWEEP_NEGATION_RE.search(
                text[max(0, match.start() - 30):match.start()]) or SWEEP_FUTURE_AFTER_RE.search(text[match.end():sentence_end]):
            continue
        fires = True
        if matched is not None:
            matched[:] = [_one_line(match.group(0), 80)]   # the phrase that fired, for the audit
        for full, short, number in SWEEP_REF_RE.findall(text[start:sentence_end]):
            repo = full or ((decision_core.repo_of_tag(short, repos) or short) if short else default_repo)  # unresolved: kept as named
            if repo and (repo, int(number)) not in refs:
                refs.append((repo, int(number)))
    return fires, refs


def sweep_says_waiting_strong(strong, text):
    """A strong form, outside code and quotes, not negated, in a sentence with no conditional or descriptive marker before it
    (if, would, may, could, proposal, option(s), and reported speech: says, saying, said): a statement that it waits, not a description of a plan."""
    if not isinstance(text, str):
        return False
    text = SWEEP_QUOTED_RE.sub(" ", text.replace("\u2019", "'"))
    for match in strong.finditer(text):
        start = max(text.rfind(c, 0, match.start()) for c in ".!?\n") + 1
        clause = text[start:match.start()]  # only what comes BEFORE the phrase hedges it: "waiting on the owner, if you agree" fires
        end = [i for i in (text.find(c, match.end()) for c in ".!?\n") if i >= 0]
        rest = text[match.end():min(end) if end else len(text)]   # a plain "deferred" / "parked" after it also makes it not-now
        if (SWEEP_HEDGE_RE.search(clause) or SWEEP_NEGATION_RE.search(text[max(0, match.start() - 30):match.start()])
                or SWEEP_FUTURE_AFTER_RE.search(rest)):
            continue
        return True
    return False


SWEEP_NEGATION_RE = re.compile(r"\b(?:not|no longer|never|isn't|aren't|wasn't|don't|doesn't|didn't|nobody|without|was|were|had been|previously|formerly)\s+"
                               r"(?:\w+\s+){0,2}$", re.I)
SWEEP_QUOTED_RE = re.compile(r"(?s:```.*?```)|`[^`\n]*`|^[ \t]*>.*$", re.M)


def sweep_says_waiting(regex, text):
    """True when the text, outside code blocks, inline code and quoted lines, says an item waits on the person and does
    not negate it ("not waiting on the owner", "no longer needs the owner"). Quoted text is somebody else's sentence."""
    if not isinstance(text, str):
        return False
    text = SWEEP_QUOTED_RE.sub(" ", text.replace("\u2019", "'"))
    for match in regex.finditer(text):
        if not SWEEP_NEGATION_RE.search(text[max(0, match.start() - 30):match.start()]):
            return True
    return False


DECISION_SECTION_RE = re.compile(r"^##[ \t]+decision required(?![A-Za-z0-9_])", re.I | re.M)


def sweep_has_heading(body):
    """True when a line of the body STARTS with a level-2 `## Decision required` heading (any case, CRLF-safe) followed by
    the end of the line or any suffix that does not continue the word: `## Decision required (re-verified 2026-10-09)`,
    `## Decision required: pick`, `## Decision required - x`. Not a heading that merely contains the words
    (`## Resolved (was: Decision required)`), not a deeper heading (`###`), not an inline mention, not code or a quote."""
    if not isinstance(body, str):
        return False
    body = body.replace("\r\n", "\n").replace("\r", "\n")  # text typed in the web editor keeps CRLF
    return bool(DECISION_SECTION_RE.search(SWEEP_QUOTED_RE.sub(" ", body)))


def sweep_has_section(body):
    """The heading, or a decision-rows block (a batch issue's decision). S1b (a label with no section) takes either; S1a
    (a section with no label) takes the heading only: a resolved batch keeps its rows block."""
    return sweep_has_heading(body) or (isinstance(body, str) and bool(parse_decision_rows(body)))


class SweepState:
    """Memory only. Everything here is rebuilt from GitHub and the decision list; losing it costs one re-read and, at
    worst, one repeated (and key-deduplicated) wake."""

    def __init__(self):
        self.repos = {}          # repo -> {"at", "items": {number: {...}}, "truncated", "error"}
        self.checked = {}        # (repo, number) -> (read time, closed)
        self.alarmed = {}        # (kind, ref) -> time cos was last told
        self.withdrawn = set()   # refs already audited as withdrawn
        self.logged = set()      # (kind, ref, day): findings already audited today
        self.woken_logged = set()  # (kind, ref, day): of those, the ones audited as woken (a later wake the same day is audited once more)
        self.facts = {}          # key -> (summary, created): the pending cos facts, until they age out
        self.deferred_since = {}  # repo or "*" -> when S3 was first deferred for it
        self.confirmed = {}      # (kind, ref) -> when a fresh read last bore the finding out
        self.attempted = {}      # (kind, ref) -> when it was last tried (the oldest is tried first)
        self.sources = {}        # (kind, ref) -> what raised it, for the audit line
        self.current = {}        # the last run's counts
        self.strong = sweep_strong_re(SWEEP_DEFAULTS["person_names"])
        self.started = 0         # when this pass's sweep began (the time budget)


def sweep_alarmed_load(engine, state, now, cfg):
    """Once per process: the raise times of the last run, within the re-alarm window (older ones are forgotten)."""
    if getattr(state, "alarmed_loaded", False) or engine.state_dir is None:
        return
    state.alarmed_loaded = True
    for key, record in list(_read_small(engine.state_dir, SWEEP_ALARMED_FILE).items())[:5000]:   # only this code writes it: a bound anyway
        kind, _, ref = key.partition(" ")
        at = record.get("at")
        if kind in SWEEP_KINDS and isinstance(at, (int, float)) and not isinstance(at, bool) and now - at < cfg["realarm_hours"] * 3600:
            state.alarmed.setdefault((kind, ref), at)
            state.logged.add((kind, ref, int(now // 86400)))   # raised inside the window: a restart does not log it again


def sweep_alarmed_save(engine, state, now, cfg):
    if engine.state_dir is None:
        return
    keep = {"%s %s" % pair: {"at": at} for pair, at in sorted(state.alarmed.items()) if now - at < cfg["realarm_hours"] * 3600}
    try:
        _write_small(engine.state_dir, SWEEP_ALARMED_FILE, keep)
    except OSError:
        pass   # a disposable file: a failed write costs one repeated finding after a restart


def sweep_state(engine):
    state = getattr(engine, "sweep", None)
    if state is None:
        state = engine.sweep = SweepState()
    return state


def sweep_pages_used(records, truncated):
    return SWEEP_LIST_PAGES if truncated else max(1, -(-len(records) // GITHUB_PAGE_SIZE))


def sweep_read_repo(hub, repo, now, window_days, regex, budget, strong):
    """One repo's open issues and PRs (one bounded list read: bodies and labels come with it) and the recent
    comments (one bounded list read, newest first). Only reduced facts are kept: no text survives. `budget` is a
    one-item list: the calls this pass may still make; each read is charged what it used."""
    since = iso(now - window_days * 86400)
    items, truncated = {}, False
    records, cut = hub.read_pages("repos/%s/issues?state=open&per_page=100" % repo, cap=SWEEP_LIST_PAGES)
    budget[0] -= sweep_pages_used(records, cut)
    truncated = truncated or cut
    for record in records:
        number = _number(record)
        if number is None:
            continue
        names = {(l.get("name") if isinstance(l, dict) else l) for l in record.get("labels") or []}
        body = record.get("body")
        items[number] = {"pr": _is_pr(record), "labels": names,
                         "section": sweep_has_section(body), "heading": sweep_has_heading(body),
                         "captain": is_captain({"labels": names, "body": body}),
                         "captain_findings": pr_marker_state(names, body)["findings"], "holds": pr_hold_reasons(names), "marker": pr_marker(body),
                         "author": (pr_login(record.get("user")) or "").lower(),
                         "created": parse_iso(record.get("created_at")), "updated": parse_iso(record.get("updated_at")),
                         "assignees": [(pr_login(a) or "").lower() for a in record.get("assignees") or [] if isinstance(a, dict)],
                         "body_waits": sweep_says_waiting(regex, body), "comments": [], "comment_ids": [],
                         "latest_strong": False, "latest_refs": [], "latest_source": None}
    closed_holds = {}   # S9: the most recent closed (or merged) PRs that still carry a merge or hold label
    recent, cut = hub.read_pages("repos/%s/issues?state=closed&sort=updated&direction=desc&per_page=50" % repo, cap=1)
    budget[0] -= sweep_pages_used(recent, cut)
    for record in recent:
        number = _number(record)
        names = {(l.get("name") if isinstance(l, dict) else l) for l in record.get("labels") or []}
        if number is not None and _is_pr(record) and not _issue_pr_merged(record) and _label_kind(names, CAPTAIN_MERGE_LABELS[:1] + CAPTAIN_HOLD_LABELS):   # #559: a merged PR is the daemon's to clean, never a finding
            closed_holds[number] = sorted(_label_kind(names, CAPTAIN_MERGE_LABELS[:1] + CAPTAIN_HOLD_LABELS))
    comments, cut = hub.read_pages("repos/%s/issues/comments?since=%s&sort=created&direction=desc&per_page=100"
                                   % (repo, since), older=("created_at", since), cap=SWEEP_LIST_PAGES)
    budget[0] -= sweep_pages_used(comments, cut)
    truncated = truncated or cut
    for comment in reversed(comments):  # oldest first, so the last N are the newest
        number = _url_number(comment.get("issue_url"))
        if number in items and isinstance(comment.get("created_at"), str) and comment["created_at"] >= since:
            items[number]["comments"].append(sweep_says_waiting(regex, comment.get("body")))
            items[number]["comment_ids"].append(comment.get("id"))
            matched = []
            fires, refs = sweep_strong_statement(strong, comment.get("body"), repo, [repo], matched)  # the last one wins
            items[number]["latest_strong"], items[number]["latest_refs"] = fires, refs
            items[number]["latest_source"] = {"source": "comment:%s" % comment.get("id"), "match": matched[0] if matched else ""} if fires else None
    return {"at": now, "items": items, "truncated": truncated, "error": None, "closed_holds": closed_holds}


def sweep_refresh(engine, state, repos, now, cfg, regex, budget):
    """Read stale repos, the least recently read first, while the pass's call budget (less the reserve for the
    single-issue reads) allows a whole repo (its two lists, up to SWEEP_LIST_PAGES pages each). Oldest first means
    every repo is reached in turn: none starves. A failed read keeps the old picture and is retried after SWEEP_TTL."""
    hub = getattr(engine, "hub", None)
    if hub is None:
        return
    stale = sorted((r for r in repos if now - state.repos.get(r, {"at": 0})["at"] >= SWEEP_TTL),
                   key=lambda r: (state.repos.get(r, {"at": 0})["at"], r))
    for repo in stale:
        if budget[0] - SWEEP_CONFIRM_RESERVE < 2 or engine.now() - state.started >= SWEEP_PASS_SECONDS:
            break
        try:
            state.repos[repo] = sweep_read_repo(hub, repo, now, cfg["comment_window_days"], regex, budget,
                                                state.strong)
        except GitHubUnavailable as err:
            budget[0] -= 1
            old = state.repos.get(repo) or {"items": {}, "truncated": False}
            state.repos[repo] = dict(old, at=now, error=_one_line(str(err), 160))


def sweep_ref_of(decision, home):
    number = decision.get("number") if isinstance(decision.get("number"), int) else decision.get("ask")
    if not isinstance(number, int) or isinstance(number, bool):
        return None
    return (decision.get("repo") or home, number)


_DECISION_ID_REF = re.compile(r"^pr:([A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)?)#(\d+)$")


def sweep_ref_keys(decision, home, repos):
    """The set of (repo lower-case, number) a decision is about: its repo and ask or number, and the ref its id spells (`pr:owner/repo#N`
    or `pr:repo#N`, the short name resolved among `repos` when exactly one matches). Repos are compared without case."""
    keys = set()
    ref = sweep_ref_of(decision, home)
    if ref and ref[0]:
        keys.add((ref[0].lower(), ref[1]))
    found = _DECISION_ID_REF.match(str(decision.get("id") or ""))
    if found:
        tag, number = found.group(1).lower(), int(found.group(2))
        if "/" in tag:
            keys.add((tag, number))
        else:
            named = [r.lower() for r in repos if r.lower().split("/")[-1] == tag]
            if len(named) == 1:
                keys.add((named[0], number))
    return keys


def sweep_withdraw(engine, state, decisions, home, now, cfg, budget):
    """(kept decisions, refs found stale): a decision whose issue or PR is closed or merged is stale. Closed state is read
    one issue at a time, cached SWEEP_TTL, within the pass's call budget (the least recently read first)."""
    hub = getattr(engine, "hub", None)
    candidates = {}
    for d in decisions:
        ref = sweep_ref_of(d, home)
        if d.get("kind") in ("issue", "captain") and ref and ref[0]:  # a report's question may outlive its closed ask
            candidates.setdefault(ref, []).append(d)
    if hub is not None:
        due = sorted((r for r in candidates if now - state.checked.get(r, (0, False))[0] >= SWEEP_TTL),
                     key=lambda r: (state.checked.get(r, (0, False))[0], r))
        for ref in due[:max(0, budget[0])]:
            if engine.now() - state.started >= SWEEP_PASS_SECONDS:
                break
            budget[0] -= 1
            try:
                data = hub._read_one(ref[0], "issues/%d" % ref[1], now, fresh=True)
            except GitHubUnavailable:
                state.checked[ref] = (now, state.checked.get(ref, (0, False))[1])
                continue
            state.checked[ref] = (now, isinstance(data, dict) and data.get("state") == "closed")
    stale = sorted(r for r in candidates if state.checked.get(r, (0, False))[1])
    drop = {id(d) for r in stale for d in candidates[r]}
    return [d for d in decisions if id(d) not in drop], stale


def sweep_ours(engine, repo, number, author, assignees, notices=None):
    """Whether a PR is OURS (a fleet agent's), by the rule the triage uses to tell ours from other-owner items: its author or an
    assignee is one of `our_logins` (the triage's key, else the `gh_users` accounts and `owner_logins`), or an agent of ours recorded a
    notice for it. Another team's PR is not ours: the sweep only flags what our own fleet should have labelled."""
    tcfg = engine.config.get("triage")
    mine = triage_our_logins(engine, tcfg if isinstance(tcfg, dict) else {})
    if notices is None:
        try:
            notices = {(n["repo"], n["number"]) for n in read_pr_notices(engine.state_dir)}
        except (NoticeError, OSError, TypeError):
            notices = set()
    return (author in mine or any(a in mine for a in assignees or []) or (repo, number) in notices)


def sweep_within(when, now, seconds):
    """True when `when` (epoch seconds, or None when unknown) is less than `seconds` before `now`: the grace is only ever given on
    a time that is known."""
    return isinstance(when, (int, float)) and 0 <= now - when < seconds


def sweep_findings(engine, state, decisions, home, now, cfg, regex, defer=(), decisions_whole=True):
    """The S1, S2, S3 and S5 findings: [(kind, "repo#n")], sorted. Reads nothing: it works on what the refresh kept.
    `defer` holds the repos (or "*": all) whose human-tier decisions are not all known this pass (their source failed or
    is still unread): S3, the only kind that a missing decision can raise falsely, is not judged for them. S1 reads only
    labels and bodies, S5 only the cos-tier decisions that ARE listed: neither waits."""
    found = set()
    state.sources = {}   # (kind, ref) -> what raised it: {"source": "comment:<id>" | "report:<id>" | "body", "match": the phrase}
    awaiting = {awaiting_label(engine.config), awaiting_cos_label(engine.config)}
    human = {sweep_ref_of(d, home) for d in decisions if d.get("tier", "human") == "human" and d.get("kind") != "notice"}

    def ref_text(repo, number):
        return "%s#%d" % (repo, number)
    s2, unattributed = set(), 0
    try:
        notices = {(n["repo"], n["number"]) for n in read_pr_notices(engine.state_dir)}
    except (NoticeError, OSError, TypeError):
        notices = set()
    for repo, picture in state.repos.items():
        for number, item in picture["items"].items():
            if not item["pr"]:
                labelled = bool(item["labels"] & awaiting)
                if item["heading"] and not labelled:
                    if not sweep_within(item.get("updated"), now, SWEEP_S1A_GRACE):
                        found.add(("S1a", ref_text(repo, number)))
                elif labelled and not item["section"]:
                    found.add(("S1b", ref_text(repo, number)))
            elif not item["captain"] and (item["body_waits"] or any(item["comments"][-SWEEP_PR_COMMENTS:])):
                found.add(("S2", ref_text(repo, number)))
                s2.add((repo, number))
                waiting = [i for i, w in enumerate(item["comments"][-SWEEP_PR_COMMENTS:]) if w]
                ids = item.get("comment_ids", [])[-SWEEP_PR_COMMENTS:]
                state.sources[("S2", ref_text(repo, number))] = (
                    {"source": "body", "match": "the PR body says it waits"} if item["body_waits"] else
                    {"source": "comment:%s" % (ids[waiting[-1]] if waiting and waiting[-1] < len(ids) else "?"), "match": "a recent comment says it waits"})
            if item["pr"]:   # #133: the label is the truth; the first-line marker is read only in the transition window
                if "marker-without-label" in item["captain_findings"] and not sweep_within(
                        item.get("created"), now, SWEEP_S6A_GRACE) and sweep_ours(
                        engine, repo, number, item.get("author", ""), item.get("assignees"), notices):
                    found.add(("S6a", ref_text(repo, number)))   # only OUR PR: another team's author may carry the line
                if "disagree" in item["captain_findings"] and not impact_rehold_open(engine.state_dir, repo, number) and not sweep_clear_agrees(engine, repo, number, item["labels"], item.get("marker")):   # (#815) a re-hold at this head is not a disagreement
                    found.add(("S6b", ref_text(repo, number)))
    for repo, picture in state.repos.items():
        if repo in defer or "*" in defer:
            continue
        for number, item in picture["items"].items():
            if not item["latest_strong"]:
                continue
            # a comment on an item is about that item, unless its sentence names other refs and not this one
            refs = item.get("latest_refs", [])
            named = [r for r in refs if r[0] in state.repos]
            targets = [(repo, number)] if not refs or (repo, number) in named else named
            if refs and not named:
                unattributed += 1   # it names only refs we cannot resolve to a watched item: not assumed to be about this one
            for target in targets:
                if target not in s2 and target not in human and target[1] in (state.repos[target[0]]["items"]):
                    found.add(("S3", ref_text(*target)))
                    state.sources[("S3", ref_text(*target))] = item.get("latest_source") or {"source": "comment:?", "match": ""}
    repos_known = list(state.repos) + ([home] if home else [])
    human_keys = set()
    for d in decisions:   # everything the owner's tier already holds, however its ref is spelled
        if d.get("tier", "human") == "human" and d.get("kind") != "notice":
            human_keys |= sweep_ref_keys(d, home, repos_known)
    for d in decisions:
        ref = sweep_ref_of(d, home)
        # a report is about the refs its sentence names, never assumed to be about its own ask
        matched = []
        fires, refs = (sweep_strong_statement(state.strong, d.get("title"), ref[0], list(state.repos), matched)
                       if d.get("kind") == "report" and ref and ref[0] else (False, []))
        for target in (refs if fires else ()):
            if (target[0] in defer or "*" in defer or target in human or target in s2 or target[0] not in state.repos
                    or target[1] not in state.repos[target[0]]["items"]):
                continue
            found.add(("S3", ref_text(*target)))
            state.sources[("S3", ref_text(*target))] = {"source": "report:%s" % d.get("id"), "match": matched[0] if matched else ""}
        since = parse_iso(d.get("since"))
        if (decisions_whole and d.get("tier") == "cos" and d.get("kind") != "notice" and since is not None
                and now - since >= cfg["aged_cos_hours"] * 3600
                and not (sweep_ref_keys(d, home, repos_known) & human_keys)):   # already the owner's: not stale for cos
            found.add(("S5", d.get("id") or ref_text(*(ref or ("?", 0)))))
    for repo, picture in state.repos.items():   # S9: a merge or hold label left on a closed, unmerged PR (read-only: nothing is removed; a merged one is the daemon's to clean, #559)
        for number in sorted(picture.get("closed_holds") or {}):
            found.add(("S9", ref_text(repo, number)))
    for group in decision_core.find_cycles(decisions):   # S7: one finding per cycle, named by its first member
        found.add(("S7", group[0]))
    listed = {decision_core.decision_ref(d) for d in decisions} - {None}
    for d in decisions:   # S8: waits for an issue that is in a watched repo, is not an open decision and is not an open item there
        for target in d.get("waits_for") or []:
            repo, _, number = target.rpartition("#")
            picture = state.repos.get(repo)
            if (target not in listed and picture is not None and not picture.get("error") and not picture.get("truncated")
                    and number.isdigit() and int(number) not in picture["items"]):
                found.add(("S8", target))
    try:   # S10 (#969): a charter number two orchestrators of one repo record in the REGISTRY (read from the registry rows, never from GitHub or session metadata): one finding on the charter's issue, naming both
        registry = load_module("registry")
        reg = registry.read(engine.state_dir) if engine.state_dir is not None else None
        for (crepo, charter), names in sorted((registry.duplicate_charters(reg["agents"]) if reg and reg["whole"] else {}).items(), key=lambda kv: (str(kv[0][0]), kv[0][1])):
            if crepo:
                found.add(("S10", ref_text(crepo, charter)))
                state.sources[("S10", ref_text(crepo, charter))] = {"source": "registry", "match": "recorded by %s" % ", ".join(names)}
    except Exception:
        pass   # an unreadable registry raises nothing: the lookup itself says "unknown"
    state.unattributed = unattributed
    return sorted(found)


def _issue_pr_merged(record):
    """True when an issue record (the issues API) of a pull request says it was merged: its `pull_request.merged_at` is set (#559)."""
    pull = record.get("pull_request") if isinstance(record, dict) else None
    return isinstance(pull, dict) and bool(pull.get("merged_at"))


def sweep_verify(engine, state, kind, ref, now, cfg, regex, budget):
    """Re-check one finding against a fresh read of its issue or PR (and, when comments raised it, a fresh read of its
    last comments), so a cached copy cannot raise it. True: still holds. False: no longer (or never did). None: could not
    be checked now (no budget, a failed or truncated read): it is neither raised nor audited this pass."""
    if kind in ("S5", "S7", "S10"):
        return True  # about the decision list, or the registry, derived this very pass
    hub = getattr(engine, "hub", None)
    repo, _, number = ref.rpartition("#")
    if hub is None or not number.isdigit():
        return None
    number = int(number)
    picture = (state.repos.get(repo) or {"items": {}})["items"].get(number) or {}
    comments_raised = ((kind == "S2" and any(picture.get("comments", [])[-SWEEP_PR_COMMENTS:]))
                       or (kind == "S3" and picture.get("latest_strong", False)))
    if budget[0] < (2 if comments_raised else 1):
        return None
    budget[0] -= 1
    if kind == "S9":   # still a PR, no longer open, not merged, and still carrying a merge or hold label
        try:
            data = hub._read_one(repo, "issues/%d" % number, now, fresh=True)
        except GitHubUnavailable:
            return None
        if not isinstance(data, dict) or "state" not in data:
            return None
        names = {(l.get("name") if isinstance(l, dict) else l) for l in data.get("labels") or []}
        return _is_pr(data) and data.get("state") != "open" and not _issue_pr_merged(data) and bool(_label_kind(names, CAPTAIN_MERGE_LABELS[:1] + CAPTAIN_HOLD_LABELS))
    if kind == "S8":   # a decision waits for this issue: it still holds when the issue is closed, or is not there at all
        try:
            data = hub._read_one(repo, "issues/%d" % number, now, fresh=True)
        except GitHubUnavailable as err:
            return True if NOT_FOUND_RE.search(str(err)) else None
        return None if not isinstance(data, dict) or "state" not in data else data.get("state") == "closed"
    try:
        data = hub._read_one(repo, "issues/%d" % number, now, fresh=True)
    except GitHubUnavailable:
        return None
    if not isinstance(data, dict) or "number" not in data and "state" not in data:
        return None
    if data.get("state") != "open":
        return False
    names = {(l.get("name") if isinstance(l, dict) else l) for l in data.get("labels") or []}
    body, is_pr = data.get("body"), _is_pr(data)
    labelled = bool(names & {awaiting_label(engine.config), awaiting_cos_label(engine.config)})
    if kind in ("S6a", "S6b"):
        want = "marker-without-label" if kind == "S6a" else "disagree"
        if kind == "S6a" and not sweep_ours(engine, repo, number, (pr_login(data.get("user")) or "").lower(),
                                            [(pr_login(a) or "").lower() for a in data.get("assignees") or [] if isinstance(a, dict)]):
            return False
        if kind == "S6a" and sweep_within(parse_iso(data.get("created_at")), now, SWEEP_S6A_GRACE):
            return False   # opened a moment ago: the label is applied after it opens
        if kind == "S6b" and impact_rehold_open(engine.state_dir, repo, number):
            return False   # (#815) held again at this head: the line and the label are being reconciled
        return is_pr and want in pr_marker_state(names, body)["findings"] and not (kind == "S6b" and sweep_clear_agrees(engine, repo, number, names, pr_marker(body)))
    if kind in ("S1a", "S1b"):
        if is_pr:
            return False
        if kind == "S1a" and sweep_within(parse_iso(data.get("updated_at")), now, SWEEP_S1A_GRACE):
            return False   # changed a moment ago: an escalation may be half done (one label off, the next not yet on)
        return (sweep_has_heading(body) and not labelled) if kind == "S1a" else (labelled and not sweep_has_section(body))
    waits_in_comments = False
    if comments_raised:
        budget[0] -= 1
        since = iso(now - cfg["comment_window_days"] * 86400)
        try:
            recent, cut = hub.read_pages("repos/%s/issues/%d/comments?since=%s&per_page=100" % (repo, number, since),
                                         cap=1)
        except GitHubUnavailable:
            return None
        if cut:
            return None  # the last comments are not on the first page: cannot say
        if kind == "S3":   # only the LATEST comment on the item counts
            waits_in_comments = bool(recent) and sweep_says_waiting_strong(state.strong, recent[-1].get("body"))
        else:
            waits_in_comments = any(sweep_says_waiting(regex, c.get("body")) for c in recent[-SWEEP_PR_COMMENTS:])
    if kind == "S2":
        return is_pr and not is_captain({"labels": names, "body": body}) and (sweep_says_waiting(regex, body) or waits_in_comments)
    if kind == "S3":
        if awaiting_label(engine.config) in names:
            return False  # it carries the person's label: a human-tier decision, whatever the list copy said
        return waits_in_comments or not comments_raised
    return None


SWEEP_DEFER_SECONDS = 1800   # S3 waits at most this long for a repo's decisions to be read; then it runs and says so


def sweep_deferrals(state, errors, repos, now):
    """(repos whose S3 is deferred now, [{"for", "why", "since", "overdue"}]). S3 is judged against the human-tier
    decisions, so a repo whose awaiting issues are unread or unreadable (its own entry), or a failed reports or request
    source (every repo), defers it. A deferral that outlasts SWEEP_DEFER_SECONDS stops deferring (the fresh label check
    still guards each finding) and is reported as overdue: nothing is hidden for good, and `status` and doctor show it."""
    reasons = {}
    for entry in errors or ():
        source, text = entry.get("source"), str(entry.get("error") or "")
        if source == "github":
            named = [r for r in repos if r in text]
            for key in named or ["*"]:
                reasons.setdefault(key, text)
        elif source in ("v2", "reports", "registry"):
            reasons.setdefault("*", "%s: %s" % (source, text))
    state.deferred_since = {k: v for k, v in getattr(state, "deferred_since", {}).items() if k in reasons}
    deferred, defer = [], set()
    for key, why in sorted(reasons.items()):
        since = state.deferred_since.setdefault(key, now)
        overdue = now - since >= SWEEP_DEFER_SECONDS
        deferred.append({"for": key, "why": _one_line(why, 160), "since": iso(since), "overdue": overdue})
        if not overdue:
            defer.add(key)
    return defer, deferred


def sweep_decisions(engine, decisions, now, errors=()):
    """The list after the sweep (stale decisions removed when enabled), with the sweep's side effects: audit lines, the
    pending cos fact and sweep.json. Called once per pass with the freshly derived list."""
    cfg = engine.config.get("sweep", SWEEP_DEFAULTS)  # no key at all: shadow
    if cfg is False or cfg is None:
        return decisions  # `sweep: false`: fully off, reads nothing, writes nothing
    state = sweep_state(engine)
    state.started = engine.now()
    sweep_alarmed_load(engine, state, now, cfg)
    repos = decision_repos(engine)
    watched = [d for d in decisions]
    home = engine.config.get("intent_repo") or (repos[0] if len(repos) == 1 else None)
    regex = sweep_phrase_re(cfg["person_names"])
    state.strong = sweep_strong_re(cfg["person_names"])
    budget = [cfg.get("calls_per_pass", SWEEP_CALLS_PER_PASS)]
    sweep_refresh(engine, state, repos, now, cfg, regex, budget)
    share = [(budget[0] + 1) // 2]  # the single reads are split: half for S4, the rest (and S4's unused) to verifying
    start = share[0]
    kept, stale = sweep_withdraw(engine, state, watched, home, now, cfg, share)
    budget[0] -= start - share[0]
    for ref in stale:
        text = "%s#%d" % ref
        if text not in state.withdrawn:
            if len(state.withdrawn) > 5000:
                state.withdrawn.clear()
            state.withdrawn.add(text)
            engine._note("sweep.withdrawn" if cfg["enabled"] else "sweep.finding", text,
                         {"kind": "S4", "ref": text, "applied": cfg["enabled"], "why": "its issue or PR is closed"})
    notices_whole, why = whole(engine, "notices")   # #805: the owner-tier rows of held PRs come from the notice read: S3 and S5 judge by them, and a read that is not whole is no evidence of an absence
    if not notices_whole:
        errors = list(errors or ()) + [{"source": "registry", "error": "the notice read is not whole: %s" % why}]
    defer, deferred = sweep_deferrals(state, errors, repos, now)
    candidates = sweep_findings(engine, state, kept, home, now, cfg, regex, defer, notices_whole or "*" not in defer)
    findings, unchecked = [], 0
    attempts = sorted(candidates, key=lambda c: (state.attempted.get(c, 0), c))  # the longest untried first
    for pair in attempts:
        if now - state.confirmed.get(pair, 0) < SWEEP_TTL:
            findings.append(pair)
            continue
        if engine.now() - state.started >= SWEEP_PASS_SECONDS:
            unchecked += 1
            continue
        state.attempted[pair] = now
        verdict = sweep_verify(engine, state, pair[0], pair[1], now, cfg, regex, budget)
        if verdict:
            state.confirmed[pair] = now
            findings.append(pair)
        elif verdict is None:
            unchecked += 1
        else:
            state.confirmed.pop(pair, None)
            if (pair, int(now // 86400)) not in state.logged:
                state.logged.add((pair, int(now // 86400)))
                engine._note("sweep.dismissed", pair[1], {"kind": pair[0], "ref": pair[1],
                                                          "why": "a fresh read does not bear it out"})
    findings.sort()
    day = int(now // 86400)
    due = [(k, r) for k, r in findings
           if cfg["enabled"] and now - state.alarmed.get((k, r), 0) >= cfg["realarm_hours"] * 3600]   # what is queued this pass
    woken = sweep_queue_fact(state, due, now, cfg) if due else set()   # #849: "woken" = the pass's wake carried the finding: the pairs the queue function set the re-alarm memory for
    if due:
        sweep_alarmed_save(engine, state, now, cfg)
    for kind, ref in findings:
        once = (kind, ref, day)
        if once not in state.logged or ((kind, ref) in woken and once not in state.woken_logged):
            if len(state.logged) > 5000:
                state.logged.clear()
                state.woken_logged.clear()
            state.logged.add(once)
            if (kind, ref) in woken:
                state.woken_logged.add(once)
            detail = {"kind": kind, "ref": ref, "what": SWEEP_KINDS[kind], "woken": (kind, ref) in woken}
            if (kind, ref) in state.sources:
                detail["source"] = state.sources[(kind, ref)]["source"]   # #805: what raised it, so the reason is readable from the audit
                detail["match"] = _one_line(state.sources[(kind, ref)]["match"], 80)
            engine._note("sweep.finding", ref, detail)
    counts = {}
    for kind, _ in findings:
        counts[kind] = counts.get(kind, 0) + 1
    if stale:
        counts["S4"] = len(stale)
    state.current = {"enabled": cfg["enabled"], "counts": counts, "total": len(findings),
                     "truncated": sorted(r for r, p in state.repos.items() if p.get("truncated")),
                     "unreadable": sorted(r for r, p in state.repos.items() if p.get("error")), "at": iso(now),
                     "deferred": deferred, "unchecked": unchecked,
                     "unattributed": getattr(state, "unattributed", 0)}
    sweep_write(engine, state)
    return kept if cfg["enabled"] else decisions


def sweep_queue_fact(state, due, now, cfg):
    """ONE fact for everything newly due: `sweep: N findings: ref kind, ...`, capped, refs and kinds only. The key
    names the set and the slot, so a restart that rebuilds the same set in the same slot is one delivery."""
    shown = due[:cfg["max_findings"]]
    digest = hashlib.sha256("|".join("%s:%s" % pair for pair in shown).encode()).hexdigest()[:10]
    key = "sweep:%s:%d" % (digest, int(now // (cfg["realarm_hours"] * 3600)))
    kinds = sorted({k for k, _ in due})
    summary = "sweep: %d finding%s: %s%s. %s. Resolve or escalate each; the sweep changes nothing." % (
        len(due), "" if len(due) == 1 else "s", ", ".join("%s %s" % (ref, kind) for kind, ref in shown),
        " (+%d more)" % (len(due) - len(shown)) if len(due) > len(shown) else "",
        "; ".join("%s = %s" % (k, SWEEP_KINDS[k]) for k in kinds))
    for pair in due:
        state.alarmed[pair] = now
    state.facts[key] = (summary, now)
    for old in [k for k, (_, at) in state.facts.items() if now - at > cfg["realarm_hours"] * 7200]:
        del state.facts[old]
    return set(due)   # every due finding is carried (named, or counted in "+N more") and remembered


def sweep_write(engine, state):
    """sweep.json: the last run's counts, for `status` (a display; nothing decides from it). Written on a change."""
    path = Path(engine.state_dir) / SWEEP_FILE
    try:
        state_write(path, json.dumps(state.current, sort_keys=True) + "\n", _without(state.current, "at"), HEARTBEAT_SWEEP)   # its `at` is when it last ran: a heartbeat keeps it honest
    except OSError:
        pass


def sweep_summary(state_dir):
    """What `status` shows: the daemon's last sweep, or None."""
    try:
        raw = json.loads((Path(state_dir) / SWEEP_FILE).read_text())
    except (OSError, ValueError):
        return None
    return raw if isinstance(raw, dict) and isinstance(raw.get("counts"), dict) else None


class SweepFacts:
    """The sweep's pending fact for the Chief of Staff (`sweep:<set>:<slot>`), one per Chief of Staff that runs. It
    stays pending until delivered (the engine finds its key in the transcript), then ages out of the sweep's memory."""

    __name__ = "sweep_facts"

    def __init__(self):
        self.engine = None

    def bind(self, engine):
        self.engine = engine

    def __call__(self):
        engine = self.engine
        state = getattr(engine, "sweep", None) if engine else None
        discovery = getattr(engine, "discovery", None) if engine else None
        if not state or not state.facts or discovery is None or discovery.problems:
            return []
        chiefs = sorted(n for n, o in discovery.agents.items() if (o.fleet or {}).get("role") == "chief-of-staff")
        return [Fact(key, name, "sweep", summary, created, sender="switchboard")
                for key, (summary, created) in sorted(state.facts.items()) for name in chiefs]


# ---- #130: the triage function (rule family T), grown from the sweep: the same hub reads, call budget, fresh re-check
# before a finding, shadow default and batched fact to the Chief of Staff. THE OWNER'S HOLD (binding): it WRITES NOTHING to
# GitHub, ever: no label, assignment, comment, close or edit. Its only writes are audit lines, triage.json (a display
# file) and the batched fact to the Chief of Staff. The fix rules of the plan stay unbuilt until he lifts the hold.

TRIAGE_DEFAULTS = {"enabled": False, "repos": None, "required_labels": {}, "sla": {}, "sla_overrides": {},
                   "our_logins": None, "daily_summary": True, "realarm_hours": 24, "max_findings": 30,
                   "calls_per_pass": 30, "pass_seconds": 10, "backoff": True, "digest_interval_minutes": 60, "ownerless": None, "alert_labels": {}, "integration_branch": None}
# Every `_days` value is in days and may be a fraction (2/24 is two hours); `t7_ours_hours` is in hours.
TRIAGE_SLA = {"t1_days": 1, "t2_days": 1 / 24, "t3_ask_days": 1, "t3_other_days": 3, "t5_days": 1, "t6_days": 2,
              "t7_ours_hours": 4, "t7_other_days": 2, "t8_days": 1, "t9_days": 3, "t11_days": 1}
# (No tracked repo is named here: a public source names no private org. The extra repos go in the config's `triage.repos`.)
TRIAGE_KINDS = {"T1": "owner missing", "T2": "required label missing", "T3": "no next step",
                "T5": "human-tier decision unanswered", "T6": "MERGE: captain PR waiting", "T7": "PR with no review",
                "T8": "blocked ask", "T9": "ask with no activity", "T10": "closed but still labelled awaiting",
                "T11": "orphan", "T12": "plan issue still open after its PR merged", "OO": "other-owner (flag only)"}
# #805: the inputs each rule judges, in ONE table: the candidates a pass drops and the records the prune keeps are both read from it, so they cannot drift.
# A rule that judges whether an item is OURS (every one but T5, T6 and T10) also needs `agents`: ownership comes from the running agents.
TRIAGE_RULE_INPUTS = {"T1": ("agents", "issues", "merged"), "T2": ("agents", "issues"), "T3": ("agents", "issues", "comments"), "T5": ("decisions", "issues"),
                      "T6": ("decisions", "issues"), "T7": ("agents", "issues", "comments", "decisions"), "T8": ("agents", "issues"),
                      "T9": ("agents", "issues", "comments"), "T10": ("closed",), "T11": ("agents", "issues", "merged"), "T12": ("agents", "issues", "merged")}
# "agents" and "decisions" are global; the others are per repository (`<name>:<repo>`). T7 also reads the decision list (a captain PR listed there is T6's);
# T1 and T11 give way to T12 when a merged PR links the item (so they read `merged`), and T9 gives way to T3 (so it reads `comments`).
# The records of the OTHER kinds are kept whenever ANY input of ANY rule is not whole: the other-owner flag stands for whichever rule would have fired, and the
# invalid-park flag is raised from the digest of all of them. Their set is derived from the table, so a new rule's input is included at once.
TRIAGE_UNION_KINDS = ("OO", "PARKED")


def triage_inputs(kind):
    """The inputs the records of `kind` judge, or None for a kind the table does not know (its records are then all kept)."""
    if kind in TRIAGE_UNION_KINDS:
        return tuple(sorted({name for needs in TRIAGE_RULE_INPUTS.values() for name in needs}))
    return TRIAGE_RULE_INPUTS.get(kind)


TRIAGE_T10_GRACE = 600         # seconds after a close in which a still-set awaiting label is not yet a finding
TRIAGE_TTL = 900               # seconds a unit read is kept
TRIAGE_CALLS_PER_PASS = TRIAGE_DEFAULTS["calls_per_pass"]   # default of `triage.calls_per_pass` (reads and fresh checks alike)
TRIAGE_CALLS_CAP = 100
TRIAGE_PASS_SECONDS = TRIAGE_DEFAULTS["pass_seconds"]       # default of `triage.pass_seconds`; cap TRIAGE_SECONDS_CAP
TRIAGE_SECONDS_CAP = 60
TRIAGE_LIST_PAGES = 2
TRIAGE_MERGED_PER_PAGE = 50    # #384: the recently closed pull requests read per repo per refresh (one page)
TRIAGE_COMMENT_DAYS = 14       # the comment window: next-step markers and review comments are looked for in it
TRIAGE_UNREADABLE_RETRY = 3600
TRIAGE_FILE = "triage.json"
TRIAGE_OWNER_RE = re.compile(r"^[ \t]*(?:[-*][ \t]+)?(?:\*\*|__)?(?:owner|owned by)(?:\*\*|__)?[ \t]*:?(?:\*\*|__)?[ \t]*([A-Za-z0-9@_`\"'\[(][^\n]*)$", re.I | re.M)
TRIAGE_OWNER_PLACEHOLDER_RE = re.compile(r"^[\W_]*(?:tbd|tbc|none|n/?a|na|nobody|no one|unknown|unassigned|unowned|todo|\?+)[\W_]*$", re.I)
TRIAGE_NOT_APPROVING_RE = re.compile(r"\b(?:not\s+(?:yet\s+)?(?:approved|lgtm)|changes\s+requested|needs?\s+changes|request(?:s|ed)?\s+changes)\b", re.I)
PARKED_UNTIL_RE = re.compile(r"^[ \t]*Parked until:[ \t]*([0-9]{4}-[0-9]{2}-[0-9]{2})[ \t]*\r?$", re.M)  # ASCII digits only; a CRLF body is read
PARKED_MAX_DAYS = 366   # a park reaches at most this far ahead of the moment it is judged: `9999-12-31` does not park forever


def parked_until(body, labels):
    """The epoch second a `<user>:parked` item is parked until, or None. It counts ONLY with the label AND one line
    `Parked until: YYYY-MM-DD` in the body (outside quotes and code); a missing, malformed or impossible date is None, and the day
    is parked through its end (UTC). Strict by design: a deferral that cannot be read is not a deferral."""
    if not any(isinstance(l, str) and l.endswith(":parked") for l in labels or ()) or not isinstance(body, str):
        return None
    found = PARKED_UNTIL_RE.findall(SWEEP_QUOTED_RE.sub(" ", body))
    if len(found) != 1:
        return None
    try:
        day = datetime.strptime(found[0], "%Y-%m-%d").replace(tzinfo=timezone.utc)
    except ValueError:
        return None
    return day.timestamp() + 86400.0


def triage_parked_now(item, now):
    """True while a normalised item is parked: its `parked_until` (read by `parked_until` above, the one date reader) is in the future and within PARKED_MAX_DAYS. T3 and the
    ownerless line share this one definition; the owner-wait exemption is T3's own."""
    until = item.get("parked_until")
    return until is not None and now < until <= now + PARKED_MAX_DAYS * 86400.0
TRIAGE_NEXT_RE = re.compile(r"^[ \t]*(?:next(?: steps?)?[ \t]*:|[-*][ \t]+\[[ xX]\])", re.I | re.M)
TRIAGE_REVIEW_RE = re.compile(r"\b(?:review of [0-9a-f]{7}|approved?|changes requested|lgtm)\b", re.I)


def triage_says_reviewed(text):
    """A comment that reads as an approving review: it says review/approved/lgtm and does not say `not approved`, `changes
    requested` or `needs changes`. (A review that asks for changes is not a reason to call the PR reviewed.)"""
    return bool(isinstance(text, str) and TRIAGE_REVIEW_RE.search(text) and not TRIAGE_NOT_APPROVING_RE.search(text))


def triage_names_owner(body):
    """True when a line of the body (outside code and quotes) says `Owner: <name>` or `owned by <name>` with a real name: a
    placeholder (TBD, none, n/a, unknown, ?) is not an owner."""
    if not isinstance(body, str):
        return False
    return any(not TRIAGE_OWNER_PLACEHOLDER_RE.match(m.group(1)) for m in TRIAGE_OWNER_RE.finditer(SWEEP_QUOTED_RE.sub(" ", body)))


def triage_owner_name(body):
    """The name on the FIRST `Owner:` line of the body (outside code and quotes): its first word, or None. Only that one word is kept."""
    if not isinstance(body, str):
        return None
    for m in TRIAGE_OWNER_RE.finditer(SWEEP_QUOTED_RE.sub(" ", body)):
        word = re.match(r"[\W_]*([A-Za-z0-9][A-Za-z0-9._-]*)", m.group(1))
        return word.group(1) if word and not TRIAGE_OWNER_PLACEHOLDER_RE.match(m.group(1)) else None
    return None


def _alert_not_a_map(raw, repos):
    return None if isinstance(raw, dict) else "must be a map of OWNER/REPO to a list of label names, got %r" % (type(raw).__name__,)


def _alert_bad_repo(raw, repos):
    bad = [r for r in raw if not (isinstance(r, str) and REPO_RE.match(r))] if isinstance(raw, dict) else []
    return "the repository name must be OWNER/REPO, got %r" % (bad[0],) if bad else None


def _alert_labels_not_a_list(raw, repos):
    bad = [r for r, v in raw.items() if not isinstance(v, list)] if isinstance(raw, dict) else []
    return "%r must name a list of label names" % (bad[0],) if bad else None


def _alert_bad_label(raw, repos):
    for repo, labels in (raw.items() if isinstance(raw, dict) else []):
        for label in labels if isinstance(labels, list) else []:
            if not (isinstance(label, str) and label.strip() and label == label.strip() and "," not in label):
                return "%r holds a label that is not a non-empty string without surrounding spaces or a comma: %r" % (repo, label)
    return None


def _alert_duplicate_label(raw, repos):
    for repo, labels in (raw.items() if isinstance(raw, dict) else []):
        labels = [l for l in labels if isinstance(l, str)] if isinstance(labels, list) else []
        if len(set(labels)) != len(labels):
            return "%r names a label twice" % (repo,)
    return None


def _alert_repo_not_read(raw, repos):
    if repos is None or not isinstance(raw, dict):
        return None   # with no `triage.repos` the watched repositories are read
    missing = [r for r in raw if isinstance(r, str) and r not in repos]
    return "%r is not in triage.repos, so its issues are never read" % (missing[0],) if missing else None


# (code, check(alert_labels, triage_repos) -> a problem text or None), in the order they are applied: the one table the validator and its tests read.
ALERT_SHAPE_CHECKS = [("not-a-map", _alert_not_a_map), ("bad-repo", _alert_bad_repo), ("labels-not-a-list", _alert_labels_not_a_list),
                      ("bad-label", _alert_bad_label), ("duplicate-label", _alert_duplicate_label), ("repo-not-read", _alert_repo_not_read)]


def validate_triage_config(config, source):
    """`triage`: absent, null or {} runs in shadow (findings audited, nobody woken); `enabled` true adds only the wake of
    the Chief of Staff; `false` turns it fully off. Nothing here can make it write to GitHub: there is no such code."""
    if "triage" not in config:
        return
    raw = config["triage"]
    if raw is False:
        return
    if raw is None:
        raw = {}
    if not isinstance(raw, dict):
        raise ConfigError("%s: 'triage' must be an object or false, got %r" % (source, type(raw).__name__))
    unknown = sorted(set(raw) - set(TRIAGE_DEFAULTS))
    if unknown:
        warn_unknown_config("%s: 'triage' has key(s) this tool does not read: %s (known: %s)"
                          % (source, ", ".join(unknown), ", ".join(TRIAGE_DEFAULTS)), 'triage', unknown, list(TRIAGE_DEFAULTS))
    section = dict(TRIAGE_DEFAULTS, **raw)
    where = "%s: 'triage" % source
    if section["integration_branch"] is not None and not (isinstance(section["integration_branch"], str) and section["integration_branch"]):   # #921
        raise ConfigError("%s.integration_branch' must be a branch name or null, got %r" % (where, section["integration_branch"]))
    for key in ("enabled", "daily_summary", "backoff"):
        if not isinstance(section[key], bool):
            raise ConfigError("%s.%s' must be true or false, got %r" % (where, key, section[key]))
    for key in ("repos", "our_logins"):
        value = section[key]
        if value is not None and not (isinstance(value, list) and all(isinstance(r, str) and r for r in value)):
            raise ConfigError("%s.%s' must be a list of strings or null, got %r" % (where, key, value))
    if section["repos"] is not None and not all(REPO_RE.match(r) for r in section["repos"]):
        raise ConfigError("%s.repos' must be OWNER/REPO names, got %r" % (where, section["repos"]))
    if not _is_number(section["realarm_hours"]) or section["realarm_hours"] <= 0:
        raise ConfigError("%s.realarm_hours' must be a positive number, got %r" % (where, section["realarm_hours"]))
    if not _is_number(section["digest_interval_minutes"]) or section["digest_interval_minutes"] < 0:
        raise ConfigError("%s.digest_interval_minutes' must be a number of minutes, 0 or more (0 sends a digest every pass that has one), got %r" % (where, section["digest_interval_minutes"]))
    own = section["ownerless"]   # #605: off unless the owner names the team repositories
    if own is not None:
        if not isinstance(own, dict) or set(own) - {"repos", "days", "limit", "owner_labels"}:
            raise ConfigError("%s.ownerless' must be null or {repos, days, limit, owner_labels}, got %r" % (where, own))
        repos = own.get("repos")
        if isinstance(repos, dict):   # a map of OWNER/REPO to {label_owners: {label: lane}}
            if not repos or not all(isinstance(r, str) and REPO_RE.match(r) for r in repos):
                raise ConfigError("%s.ownerless.repos' must be a non-empty list or map of OWNER/REPO names, got %r" % (where, list(repos)))
            for repo, entry in repos.items():
                if not isinstance(entry, dict) or set(entry) - {"label_owners"}:
                    raise ConfigError("%s.ownerless.repos.%s' must be {label_owners: {label: lane}}, got %r" % (where, repo, entry))
                lo = entry.get("label_owners", {})
                if not isinstance(lo, dict) or not all(isinstance(k, str) and k.strip() and isinstance(v, str) and v.strip() for k, v in lo.items()):
                    raise ConfigError("%s.ownerless.repos.%s.label_owners' must be a map of non-empty label to non-empty lane name, got %r" % (where, repo, lo))
        elif not (isinstance(repos, list) and repos and all(isinstance(r, str) and REPO_RE.match(r) for r in repos)):
            raise ConfigError("%s.ownerless.repos' must be a non-empty list or map of OWNER/REPO names, got %r" % (where, repos))
        if "days" in own and (not _is_number(own["days"]) or own["days"] <= 0):
            raise ConfigError("%s.ownerless.days' must be a positive number of days, got %r" % (where, own["days"]))
        if "limit" in own and (not isinstance(own["limit"], int) or isinstance(own["limit"], bool) or not 100 <= own["limit"] <= 2000):
            raise ConfigError("%s.ownerless.limit' must be a whole number from 100 to 2000, got %r" % (where, own["limit"]))
        if "owner_labels" in own and not (isinstance(own["owner_labels"], list) and all(isinstance(x, str) and x for x in own["owner_labels"])):
            raise ConfigError("%s.ownerless.owner_labels' must be a list of label names or patterns (agent:*), got %r" % (where, own["owner_labels"]))
    for code, check in ALERT_SHAPE_CHECKS:   # #851: one table of the shapes `alert_labels` may not take; each is a named error
        bad = check(section["alert_labels"], section["repos"])
        if bad:
            raise ConfigError("%s.alert_labels' %s: %s" % (where, code, bad))
    cap = section["max_findings"]
    if not isinstance(cap, int) or isinstance(cap, bool) or not 1 <= cap <= 200:
        raise ConfigError("%s.max_findings' must be a whole number from 1 to 200, got %r" % (where, cap))
    calls = section["calls_per_pass"]
    if not isinstance(calls, int) or isinstance(calls, bool) or not 4 <= calls <= TRIAGE_CALLS_CAP:
        raise ConfigError("%s.calls_per_pass' must be a whole number from 4 to %d, got %r" % (where, TRIAGE_CALLS_CAP, calls))
    seconds = section["pass_seconds"]
    if not _is_number(seconds) or not 1 <= seconds <= TRIAGE_SECONDS_CAP:
        raise ConfigError("%s.pass_seconds' must be a number from 1 to %d, got %r" % (where, TRIAGE_SECONDS_CAP, seconds))
    for name in ("sla",):
        _check_sla(section[name], where + "." + name)
    overrides = section["sla_overrides"]
    if not isinstance(overrides, dict):
        raise ConfigError("%s.sla_overrides' must map OWNER/REPO to an sla object, got %r" % (where, overrides))
    for repo, sla in overrides.items():
        _check_sla(sla, "%s.sla_overrides.%s" % (where, repo))
    labels = section["required_labels"]
    if not isinstance(labels, dict) or not all(
            isinstance(repo, str) and isinstance(group, list) and all(
                isinstance(l, str) or (isinstance(l, list) and l and all(isinstance(x, str) for x in l)) for l in group)
            for repo, group in labels.items()):
        raise ConfigError("%s.required_labels' must map OWNER/REPO to a list of labels (or lists of alternatives), "
                          "got %r" % (where, labels))
    config["triage"] = section


def _check_sla(sla, where):
    if not isinstance(sla, dict) or any(k not in TRIAGE_SLA or not _is_number(v) or v <= 0 for k, v in sla.items()):
        raise ConfigError("%s' must be an object of positive numbers named among %s, got %r"
                          % (where, ", ".join(TRIAGE_SLA), sla))


def triage_sla(cfg, repo):
    merged = dict(TRIAGE_SLA)
    merged.update(cfg.get("sla") or {})
    merged.update((cfg.get("sla_overrides") or {}).get(repo) or {})
    return merged


def triage_repos(engine, cfg):
    if cfg.get("repos") is not None:
        return list(cfg["repos"])
    return sorted(set(decision_repos(engine)))


def triage_our_logins(engine, cfg):
    if cfg.get("our_logins") is not None:
        return {l.lower() for l in cfg["our_logins"]}
    config = engine.config
    return {str(v).lower() for v in (config.get("gh_users") or {}).values()} | {l.lower() for l in config.get("owner_logins") or []}


def triage_t10_graced(engine, cfg, record, now):
    """True when a close is too recent for T10: inside TRIAGE_T10_GRACE of `closed_at`, UNLESS the closer (`closed_by`, when the
    record names one) is one of ours: our own agents take the label off in the same sweep as the close, so a label still set is
    their miss and no grace is given (the owner's panel shows a closed-but-labelled issue meanwhile). A closer the record does
    not name, or one that is not ours, keeps the grace."""
    if not sweep_within(parse_iso(record.get("closed_at")), now, TRIAGE_T10_GRACE):
        return False
    closer = record.get("closed_by")
    login = (_login_of(closer) or "").lower() if isinstance(closer, dict) else ""
    tcfg = cfg if isinstance(cfg, dict) else {}
    return not (login and login in triage_our_logins(engine, tcfg))


class TriageState:
    """Memory only: rebuilt from GitHub and the decision list."""

    def __init__(self):
        self.wanted = 0          # #1140: units a pass wants read (repositories x units), for the skip line
        self.units = {}          # (repo, unit) -> {"at", "data", "truncated", "error"}
        self.unreadable = {}     # repo -> reason, audited once
        self.confirmed, self.attempted, self.alarmed = {}, {}, {}
        self.verified = {}       # (rule, ref) -> when a fresh read last gave an answer (true or false): the age of "unchecked"
        self.first_seen = {}     # (rule, ref) -> when a pass first saw it as a candidate (the age of one never checked)
        self.enriched = {}       # (rule, ref) -> evidence the fresh read added
        self.live = {}           # #576: (repo, number) -> {"token": the issue's updated time, "info": the label's age facts or None, "at"}: one timeline read each
        self.batch_waiting = {}  # #921: repo -> how many open issues wait for the batch (their change merged into the integration branch), this pass
        self.reasons = {}        # (rule, ref) -> the worded reason of a finding that carries one (`awaiting-live expired`)
        self.logged, self.woken_logged, self.facts, self.current = set(), set(), {}, {}
        self.started, self.day, self.day_counts = 0, None, {}
        self.summarised = None
        self.seen = None         # #349: the stale digest's memory (bin/triage_digest.py), loaded at the first pass
        self.meta = None         # #406: its cadence (warm-up done, the last delivery), kept in the same file


def triage_state(engine):
    state = getattr(engine, "triage", None)
    if state is None:
        state = engine.triage = TriageState()
    return state


def _login_of(user):
    return pr_login(user)


def triage_norm(issue):
    """One issue or PR record as the rules read it; None when it is not usable. Only reduced facts: no text is kept
    except the booleans computed from the body."""
    number = _number(issue)
    created, updated = parse_iso(issue.get("created_at")), parse_iso(issue.get("updated_at"))
    if number is None or created is None or updated is None:
        return None
    body = issue.get("body")
    summary = issue.get("sub_issues_summary") if isinstance(issue.get("sub_issues_summary"), dict) else {}
    total, done = summary.get("total"), summary.get("completed")
    return {"number": number, "pr": _is_pr(issue), "draft": bool(issue.get("draft")), "state": issue.get("state", "open"),
            "created": created, "updated": updated, "author": (_login_of(issue.get("user")) or "").lower(),
            "assignees": [(_login_of(a) or "").lower() for a in issue.get("assignees") or [] if isinstance(a, dict)],
            "labels": {(l.get("name") if isinstance(l, dict) else l) for l in issue.get("labels") or []},
            "section": sweep_has_section(body), "next_body": bool(isinstance(body, str) and TRIAGE_NEXT_RE.search(
                SWEEP_QUOTED_RE.sub(" ", body))), "parent": parent_of(issue),
            "parked_until": parked_until(body, {(l.get("name") if isinstance(l, dict) else l) for l in issue.get("labels") or []}),
            "owner_body": triage_names_owner(body), "owner_name": triage_owner_name(body),
            "open_sub": isinstance(total, int) and isinstance(done, int) and total > done,
            "pending_text": load_triage_plan_open().pending_text(body),   # #410: its own text says work is left
            "captain": is_captain({"labels": {(l.get("name") if isinstance(l, dict) else l) for l in issue.get("labels") or []},
                                   "body": body})}


def triage_comment_facts(records):
    """[{"at", "next", "review"}] oldest first from comment records; no text kept."""
    found = []
    for c in records:
        at = parse_iso(c.get("created_at")) if isinstance(c, dict) else None
        text = SWEEP_QUOTED_RE.sub(" ", c.get("body") or "") if at is not None and isinstance(c.get("body"), str) else ""
        if at is not None:
            found.append({"at": at, "next": bool(TRIAGE_NEXT_RE.search(text)), "review": triage_says_reviewed(text)})
    return sorted(found, key=lambda c: c["at"])


def triage_pending_proofs(engine, links, items, repo):
    """#410: the open issues of `links` whose linked merged PR still has a proof the ledger has not seen pass. The ledger is one local file, read only
    when a T12 candidate exists; an unreadable or tampered one makes every candidate unknown (suppressed this pass), never a finding."""
    candidates = {n: l for n, l in links.items() if n in items}
    if not candidates:
        return set()
    if engine.state_dir is None:
        return set()   # no state directory: no ledger exists
    try:
        entries, problem = plan_ledger.read_ledger(engine.state_dir)
    except Exception:
        return set(candidates)
    if problem:
        return set(candidates)
    return load_triage_plan_open().pending_issues(candidates, entries, repo)


def triage_context(engine, repo, items, discovery):
    """The charters, asks, work items and agent-owned numbers of one repo, from the agents list and the parent links the
    issue list carries (`parent_issue_url`): no read of their own."""
    owned, charters = set(), set()
    view = registry_charter_view(engine)   # #969: an orchestrator's charter is the registry's; its metadata `issue` is an ask, never a charter
    for agent in (discovery.agents.values() if discovery else []):
        fleet = agent.fleet or {}
        if _fleet_repo(fleet, engine.config) != repo and fleet.get("repo") != repo:
            continue
        mine = owned_numbers(agent.name, fleet, view)
        owned |= mine
        if fleet.get("role") == "orchestrator":
            charters |= mine
        elif isinstance(fleet.get("charter"), int) and not isinstance(fleet.get("charter"), bool):
            charters.add(fleet["charter"])
    charters |= {n for n, i in items.items() if any(str(l).endswith(":orchestrator") for l in i["labels"])}
    asks = {n for n, i in items.items() if i["parent"] in charters}
    below, unresolved = triage_charter_descendants(items, charters)
    return {"charters": charters, "asks": asks, "chain": charters | below, "owned": owned, "unresolved": unresolved}


TRIAGE_ANCESTOR_DEPTH = 8   # #396: how many parent links the owner walk follows (a deeper chain ends the walk)


def triage_charter_descendants(items, charters):
    """(numbers whose parent chain reaches a charter within TRIAGE_ANCESTOR_DEPTH links, numbers whose chain leaves the issues read first).
    Memory only: the parent links of the lists already held, so no read. A cycle or a too-deep chain ends the walk (neither). A parent that
    is not among the issues read (another repo, closed) makes the answer unknown, never a missing owner."""
    below, unresolved = set(), set()
    for start in items:
        seen, current = {start}, start
        for _ in range(TRIAGE_ANCESTOR_DEPTH):
            parent = items[current]["parent"]
            if parent is None:
                break                                  # the root of the chain: no charter above it
            if parent in charters:
                below.add(start)
                break
            if parent not in items:
                unresolved.add(start)
                break
            if parent in seen:
                break                                  # a cycle: the walk ends
            seen.add(parent)
            current = parent
    return below, unresolved


def triage_awaits_live(item):
    """True when an open issue carries a label ending in `:awaiting-live`: it waits on a live event, so T9 and T12 stay quiet (#574),
    until the label is older than `awaiting_live_days` with no comment since (#576)."""
    return bool(load_module("awaiting_live").label_names(item["labels"]))


def triage_rules(item, comments, ctx, sla, now, ours_logins, required, notice_prs, window_ok=True, captain_skip=False, merged=None, pending=None, live=None, live_days=None, waiting=None):
    """{rule: evidence} for one OPEN item (a pure function: the list copy and the fresh copy go through it alike), and
    whether the item is ours. `comments` is None when the comment unit is not read (T3 and T7 are then not judged).
    Evidence holds only labels' names, ages in days and owner logins."""
    number, found = item["number"], {}
    chain = number in ctx["chain"]
    ours = (item["author"] in ours_logins or any(a in ours_logins for a in item["assignees"]) or chain
            or number in ctx["owned"] or number in notice_prs)
    day = 86400.0
    age_created, age_updated = (now - item["created"]) / day, (now - item["updated"]) / day
    ask = number in ctx["asks"]
    if not item["pr"]:
        named = item.get("owner_body", False)   # an explicit `Owner: <name>` or `owned by <name>` line names the owner
        if not load_module("triage_ownerless").is_claimed(dict(item, owner_body=named), ctx) and age_created >= sla["t1_days"]:   # one definition of "has an owner" (#605)
            found["T1"] = {"created_days": round(age_created, 2)}
        group_missing = [g for g in required if not any(l in item["labels"] for l in (g if isinstance(g, list) else [g]))]
        if group_missing and age_created >= sla["t2_days"]:
            found["T2"] = {"missing": [g if isinstance(g, str) else "/".join(g) for g in group_missing],
                           "labels": sorted(item["labels"])[:8]}
        awaiting = any(str(l).endswith((":awaiting-user", ":awaiting-cos")) or "awaiting" in str(l) for l in item["labels"])
        parked = triage_parked_now(item, now) and not awaiting  # a park reaches at most PARKED_MAX_DAYS ahead: `9999-12-31` does not park forever. It never exempts an owner-wait; T5 and the captain PRs are other rules
        if comments is not None and not item["section"] and not awaiting and not item["next_body"] and not parked \
                and not item["open_sub"] and not any(c["next"] for c in comments) \
                and age_updated >= (sla["t3_ask_days"] if ask else sla["t3_other_days"]):
            found["T3"] = {"quiet_days": round(age_updated, 2), "ask": ask}
        if ask and any("blocked" in str(l).lower() for l in item["labels"]) and age_updated >= sla["t8_days"]:
            found["T8"] = {"quiet_days": round(age_updated, 2)}
        if ask and "T3" not in found and not triage_awaits_live(item) and age_updated >= sla["t9_days"]:
            found["T9"] = {"quiet_days": round(age_updated, 2)}
        if triage_awaits_live(item):   # #576: the exemption is capped: an old label with no comment since comes back, an unreadable age stays visible
            module = load_module("awaiting_live")
            reason = module.judge(live, now, live_days or module.CONFIG_DEFAULT)
            if reason:
                found["T9"] = {"quiet_days": round(age_updated, 2), "reason": reason}
                if live is not None:
                    found["T9"]["label_days"] = round((now - live["set"]) / day, 2)
        if not chain and not item["assignees"] and not named and "T1" not in found and number not in ctx["unresolved"] \
                and age_updated >= sla["t11_days"]:
            found["T11"] = {"quiet_days": round(age_updated, 2)}
        link = (merged or {}).get(number) if number not in ctx["charters"] and number not in ctx["asks"] else None   # a charter or an ask is a long-lived umbrella: a merged part does not finish it
        if number in (waiting or ()) and number not in ctx["charters"] and number not in ctx["asks"]:   # #921: its change merged into the integration branch and waits for the batch: not done yet, and it has an owner of record
            found.pop("T1", None)
            found.pop("T11", None)
        if link:   # #384: its PR merged and it is still open: that is the finding, not "no owner"; ours when the PR's author is ours
            found.pop("T1", None)
            found.pop("T11", None)
            if not (item["open_sub"] or item["pending_text"] or number in (pending or ()) or triage_awaits_live(item)):   # #410: not truly done: an open sub-issue, pending work in its text or a proof not passed
                found["T12"] = load_triage_plan_open().evidence(link, max(0.0, now - (parse_iso(link["merged_at"]) or now)) / day)
                ours = ours or link["by"] in ours_logins
    elif not item["draft"] and comments is not None and ours and not captain_skip:
        # Only OUR PRs: our agents review by signed comment, which is in the data; other teams use formal GitHub reviews,
        # which the triage does not read, so a PR of theirs cannot be called unreviewed (it would be a false positive).
        limit = sla["t7_ours_hours"] * 3600
        if now - item["created"] >= limit and not any(c["review"] for c in comments):
            if now - item["created"] <= TRIAGE_COMMENT_DAYS * day:   # older: the review may be outside the window
                found["T7"] = {"waiting_hours": round((now - item["created"]) / 3600, 1)}
    return found, ours


def triage_read_unit(hub, repo, unit, now, budget):
    """One unit's list read, charged what it used. Units: issues (open issues and PRs), comments (the last
    TRIAGE_COMMENT_DAYS), closed:<label> (closed issues that still carry a label)."""
    if unit == "issues":
        path = "repos/%s/issues?state=open&per_page=100" % repo
        records, cut = hub.read_pages(path, cap=TRIAGE_LIST_PAGES)
    elif unit == "merged":   # #384: ONE page of the recently closed pull requests; those with a merge date name the issues they implemented
        records, cut = hub.read_pages("repos/%s/pulls?state=closed&sort=updated&direction=desc&per_page=%d" % (repo, TRIAGE_MERGED_PER_PAGE), cap=1)
    elif unit == "comments":
        since = iso(now - TRIAGE_COMMENT_DAYS * 86400)
        records, cut = hub.read_pages("repos/%s/issues/comments?since=%s&sort=created&direction=desc&per_page=100"
                                      % (repo, since), older=("created_at", since), cap=TRIAGE_LIST_PAGES)
    else:
        label = unit.split(":", 1)[1]
        records, cut = hub.read_pages("repos/%s/issues?state=closed&labels=%s&per_page=100" % (repo, quote(label, safe="")),
                                      cap=1)
    budget[0] -= sweep_pages_used(records, cut)
    return records, cut


def triage_refresh(engine, state, repos, units, now, budget, reserve=1, seconds=TRIAGE_PASS_SECONDS):
    """Read the stalest units (round-robin across every repo and unit, the least recently read first) while the pass's
    call budget (less the reserve for fresh checks) and time allow. A repo the account cannot read is `unreadable`, once."""
    hub = getattr(engine, "hub", None)
    if hub is None:
        return
    todo = []
    for repo in repos:
        if repo in state.unreadable and now - state.unreadable[repo][1] < TRIAGE_UNREADABLE_RETRY:
            continue
        for unit in units:
            held = state.units.get((repo, unit))
            if held is None or now - held["at"] >= TRIAGE_TTL:
                todo.append(((held or {"at": 0})["at"], repo, unit))
    alerts = set(((engine.config.get("triage") or {}).get("alert_labels") or {}) if isinstance(engine.config.get("triage"), dict) else ())
    # #1140: the not-yet-read `issues` unit of an alert repository goes first (one list per such repository), then the old order
    for _, repo, unit in sorted(todo, key=lambda t: (not (t[0] == 0 and t[2] == "issues" and t[1] in alerts),) + t):
        if budget[0] - reserve < 1 or engine.now() - state.started >= seconds:
            break
        try:
            records, cut = triage_read_unit(hub, repo, unit, now, budget)
            state.units[(repo, unit)] = {"at": now, "data": records, "truncated": cut, "error": None}
            state.unreadable.pop(repo, None)
        except GitHubUnavailable as err:
            budget[0] -= 1
            reason = _one_line(str(err), 160)
            if (repo, unit) in state.units:   # it was read before: a failed refresh keeps the old copy and tries later
                state.units[(repo, unit)].update(at=now, error=reason)
            else:
                if repo not in state.unreadable:
                    engine._note("triage.unreadable", repo, {"repo": repo, "unit": unit, "reason": reason})
                state.unreadable[repo] = (reason, now)


def triage_read_live(engine, state, repos, now, budget, reserve=1, seconds=TRIAGE_PASS_SECONDS):
    """#576: the age of each `:awaiting-live` label, from the issue's timeline: ONE bounded read (a single page) per labelled open issue, kept in
    `state.live` while the issue's updated time is the one it was read at (a re-added label or a new comment moves it), so an unchanged issue is not read
    again. Each read is charged to the pass's call budget (less the reserve for fresh checks), the least recently read first. A failed or cut read is kept as
    unknown and tried again after TRIAGE_TTL: never read as fresh. Reads nothing when no issue carries the label."""
    hub, module = getattr(engine, "hub", None), load_module("awaiting_live")
    if hub is None:
        return
    todo = []
    for repo in repos:
        unit = state.units.get((repo, "issues"))
        for record in (unit["data"] if unit else []):
            item = triage_norm(record)
            if item is None or item["pr"] or item["state"] != "open" or not module.label_names(item["labels"]):
                continue
            held = state.live.get((repo, item["number"]))
            if held is None or held["token"] != item["updated"] or (held["info"] is None and now - held["at"] >= TRIAGE_TTL):
                todo.append(((held or {"at": 0})["at"], repo, item))
    for _, repo, item in sorted(todo, key=lambda t: t[:2] + (t[2]["number"],)):
        if budget[0] - reserve < 1 or engine.now() - state.started >= seconds:
            break
        budget[0] -= 1
        info = None
        try:
            events, cut = hub.read_pages("repos/%s/issues/%d/timeline?per_page=100" % (repo, item["number"]), cap=1)
            if not cut:   # a page that is not the whole timeline cannot tell the latest label event or the last comment
                info = module.read(events, module.label_names(item["labels"]), parse_iso)
        except GitHubUnavailable:
            pass
        state.live[(repo, item["number"])] = {"token": item["updated"], "info": info, "at": now}


def triage_findings(engine, state, repos, decisions, cfg, now, errors):
    """(candidates [(rule, ref, evidence)], unchecked {repo: [units missing]}, truncated repos). Reads nothing."""
    discovery = getattr(engine, "discovery", None)
    ours_logins = triage_our_logins(engine, cfg)
    notice_prs = {}
    try:
        for n in read_pr_notices(engine.state_dir):
            notice_prs.setdefault(n["repo"], set()).add(n["number"])
    except (NoticeError, OSError, TypeError):
        pass
    out, unchecked, truncated = [], {}, []
    state.batch_waiting = {}   # #921: repo -> open plan issues whose change merged into the integration branch and waits for the batch (counted apart)
    agents_whole = whole(engine, "agents")[0]
    live_days = load_module("awaiting_live").days_of(engine.config)
    captain_listed = {sweep_ref_of(d, engine.config.get("intent_repo")) for d in decisions if d.get("kind") == "captain"}
    for repo in repos:
        issues_unit = state.units.get((repo, "issues"))
        if issues_unit is None:
            continue
        if issues_unit["truncated"]:
            truncated.append(repo)
        items = {}
        for record in issues_unit["data"]:
            item = triage_norm(record)
            if item is not None and item["state"] == "open":
                items[item["number"]] = item
        ctx = triage_context(engine, repo, items, discovery)
        comments_unit = state.units.get((repo, "comments"))
        by_number = {}
        if comments_unit is not None:
            for c in comments_unit["data"]:
                n = _url_number(c.get("issue_url"))
                if n is not None:
                    by_number.setdefault(n, []).append(c)
        merged_unit = state.units.get((repo, "merged"))   # #384: not read yet (or no unit): no T12, never a guess
        links = load_triage_plan_open().merged_links(merged_unit["data"], repo) if merged_unit is not None else {}
        integration = cfg.get("integration_branch")   # #921: the only place the integration branch is named: the configuration (none: judged as before)
        links, waiting = load_triage_plan_open().split_batch_waiting(merged_unit["data"] if merged_unit is not None else [], links, integration if isinstance(integration, str) else None)
        state.batch_waiting[repo] = sum(1 for n in waiting if n in items and not items[n]["pr"] and n not in ctx["charters"] and n not in ctx["asks"])
        pending = triage_pending_proofs(engine, links, items, repo)
        sla, required = triage_sla(cfg, repo), (cfg.get("required_labels") or {}).get(repo) or []
        if comments_unit is None:
            unchecked.setdefault(repo, []).append("comments")
        for number, item in sorted(items.items()):
            comments = triage_comment_facts(by_number.get(number, [])) if comments_unit is not None else None
            # a `MERGE: captain` PR already in the decision list is T6's; while the list is incomplete a captain PR waits
            captain_skip = item["captain"] and ((repo, number) in captain_listed or bool(errors))
            live = state.live.get((repo, number)) if triage_awaits_live(item) else None
            found, ours = triage_rules(item, comments, ctx, sla, now, ours_logins, required, notice_prs.get(repo, set()),
                                       captain_skip=captain_skip, merged=links, pending=pending,
                                       live=live["info"] if live else None, live_days=live_days, waiting=waiting)
            if not agents_whole:   # #805: "no owner" is judged against the running agents: a fleet that was not read whole is no evidence of an absence
                for rule in [r for r in found if "agents" in (triage_inputs(r) or ())]:
                    found.pop(rule)
                    whole_skipped(engine, "triage.owner_rules", "agents")
            if not found:
                continue
            ref = "%s#%d" % (repo, number)
            if ours:
                out.extend((rule, ref, evidence) for rule, evidence in sorted(found.items()))
            else:   # another person's or team's: only ever a flag, never counted as our violation
                out.append(("OO", ref, {"would_be": sorted(found)}))
        for unit in ("closed:" + l for l in sorted(triage_awaiting_labels(engine))):
            held = state.units.get((repo, unit))
            if held is None:
                unchecked.setdefault(repo, []).append(unit)
                continue
            for record in held["data"]:
                number = _number(record)
                names = {(l.get("name") if isinstance(l, dict) else l) for l in record.get("labels") or []}
                if (number is not None and record.get("state") == "closed" and unit.split(":", 1)[1] in names
                        and not triage_t10_graced(engine, cfg, record, now)):   # the label usually comes off minutes after the close
                    out.append(("T10", "%s#%d" % (repo, number), {"label": unit.split(":", 1)[1]}))
    if not errors:   # T5, T6 read only the decision list: judged only when it is whole
        for d in decisions:
            since = parse_iso(d.get("since"))
            if d.get("tier") != "human" or d.get("kind") not in ("issue", "report", "captain") or since is None:
                continue
            ref = sweep_ref_of(d, engine.config.get("intent_repo"))
            ident = "%s#%d" % ref if ref and ref[0] else (d.get("id") or "?")
            days = (now - since) / 86400
            if d.get("kind") == "captain" and days >= triage_sla(cfg, ref[0] if ref else "")["t6_days"]:
                evidence = {"waiting_days": round(days, 2), "waiting_hours": round(days * 24, 1)}
                if d.get("holds"):
                    evidence["holds"] = list(d["holds"])   # the hold-* labels: why it is held
                out.append(("T6", ident, evidence))
            elif d.get("kind") != "captain" and days >= triage_sla(cfg, ref[0] if ref else "")["t5_days"]:
                out.append(("T5", ident, {"waiting_days": round(days, 2), "waiting_hours": round(days * 24, 1)}))
    return out, unchecked, truncated


def triage_awaiting_labels(engine):
    return {awaiting_label(engine.config), awaiting_cos_label(engine.config)}


def triage_verify(engine, state, rule, ref, cfg, now, budget, evidence=None):
    """True when a FRESH read bears the finding out, False when it does not, None when it cannot be checked now. T5 and
    T6 are about the decision list derived this very pass (no read)."""
    if rule in ("T5", "T6"):
        return True
    hub = getattr(engine, "hub", None)
    repo, _, number = ref.rpartition("#")
    if hub is None or not number.isdigit():
        return None
    wants_comments = rule in ("T3", "T7") or (rule == "OO" and {"T3", "T7"} & set((evidence or {}).get("would_be", [])))
    number, need = int(number), (2 if wants_comments else 1)
    if rule == "T7":
        return triage_verify_t7(engine, state, repo, number, cfg, now, budget)
    if budget[0] < need:
        return None
    budget[0] -= 1
    try:
        data = hub._read_one(repo, "issues/%d" % number, now, fresh=True)
    except GitHubUnavailable:
        return None
    if not isinstance(data, dict) or "number" not in data and "state" not in data:
        return None
    if rule == "T10":
        names = {(l.get("name") if isinstance(l, dict) else l) for l in data.get("labels") or []}
        return (data.get("state") == "closed" and any(l in names for l in triage_awaiting_labels(engine))
                and not triage_t10_graced(engine, cfg, data, now))
    if data.get("state") != "open":
        return False
    if rule == "T12":   # #384: the merged PR was read in the list; the issue still being open is what a fresh read confirms
        return True
    item = triage_norm(data)
    if item is None:
        return None
    comments = None
    if need == 2:
        budget[0] -= 1
        since = iso(now - TRIAGE_COMMENT_DAYS * 86400)
        try:
            recent, cut = hub.read_pages("repos/%s/issues/%d/comments?since=%s&per_page=100" % (repo, number, since), cap=1)
        except GitHubUnavailable:
            return None
        if cut:
            return None
        comments = triage_comment_facts(recent)
    issues_unit = state.units.get((repo, "issues"))
    items = {}
    for record in (issues_unit["data"] if issues_unit else []):
        other = triage_norm(record)
        if other is not None and other["state"] == "open":
            items[other["number"]] = other
    items[number] = item
    ctx = triage_context(engine, repo, items, getattr(engine, "discovery", None))
    notice_prs = set()
    try:
        notice_prs = {n["number"] for n in read_pr_notices(engine.state_dir) if n["repo"] == repo}
    except (NoticeError, OSError, TypeError):
        pass
    live = state.live.get((repo, number)) if triage_awaits_live(item) else None   # #576: the age read this or an earlier pass; none read is "unknown", still a finding
    found, ours = triage_rules(item, comments, ctx, triage_sla(cfg, repo), now, triage_our_logins(engine, cfg),
                               (cfg.get("required_labels") or {}).get(repo) or [], notice_prs,
                               live=live["info"] if live else None, live_days=load_module("awaiting_live").days_of(engine.config))
    return (rule in found) if (ours and rule != "OO") else (rule == "OO" and bool(found))


def triage_verify_t7(engine, state, repo, number, cfg, now, budget):
    """T7 against the captain decision's own evidence (`captain_evidence`, built on `pr_reviews_at` and `pr_signed_at`): a
    formal review by a non-author at the exact head, or a signed head-naming comment from a non-author agent that is not a
    sender of the PR's notice, means REVIEWED: no finding. A review at an OLDER head only fires once the last push is older
    than the T7 SLA, with the evidence 'review at an older head'. True/False/None as `triage_verify`."""
    if budget[0] < 1:
        return None
    budget[0] -= 1
    try:
        facts = read_pr_facts(engine, repo, number, "commits")
    except NoticeError:
        return None
    if facts["state"] != "open":
        return False
    if facts.get("verdict_review"):
        return False         # the independent reviewer's verdict review of this exact head, from any account (T7 only)
    senders, noticed = set(), False
    try:
        for item in read_pr_notices(engine.state_dir):
            if item["repo"] == repo and item["number"] == number:
                senders |= set(notice_senders(item))
                noticed = True
    except (NoticeError, OSError, TypeError):
        noticed = False
    # A signed comment is review evidence only when the PR's notice is on file (its sender is then known and excluded):
    # with none, the author's own signed comment would pass for a review. Without a notice only a formal review counts.
    if noticed:
        evidence = captain_evidence(facts, senders)
    else:
        evidence = facts["reviews"] if facts.get("reviews") is None else [dict(r, kind="review") for r in facts["reviews"]]
        if evidence is not None and not evidence:
            # No notice to name the author's agent: only a comment that SAYS it is a review (not merely names the head) counts, and
            # the PR's own author login never does.
            reviewers = [who for who in (facts.get("signed_review") or []) if who != facts.get("author")]
            if reviewers:
                evidence = [{"by": who, "kind": "comment", "state": "signed review comment"} for who in reviewers[:CAPTAIN_EVIDENCE_MAX]]
    if evidence is None:
        return None          # reviews or comments could not be read: no finding either way
    if evidence:
        return False         # reviewed at the exact head, in the fleet's own flow
    note = {} if noticed else {"notice": "no notice on file"}
    if facts.get("reviews_older"):
        pushed = facts.get("head_at")
        hours = cfg and triage_sla(cfg, repo)["t7_ours_hours"]
        if pushed is None or now - pushed < hours * 3600:
            return False     # reviewed before the last push, and the push is not older than the SLA yet
        note.update(review="review at an older head", since_push_hours=round((now - pushed) / 3600, 1))
    if note:
        state.enriched[("T7", "%s#%d" % (repo, number))] = note
    return True


def triage_ownerless_options(cfg):
    """The `triage.ownerless` settings with their defaults, or None when it is off."""
    own = (cfg or {}).get("ownerless") if isinstance(cfg, dict) else None
    if not isinstance(own, dict) or not own.get("repos"):
        return None
    module = load_module("triage_ownerless")
    return {"repos": list(own["repos"]), "label_owners": {r: dict((e or {}).get("label_owners") or {}) for r, e in own["repos"].items()} if isinstance(own["repos"], dict) else {},
            "days": own.get("days", module.DEFAULT_DAYS), "limit": own.get("limit", module.DEFAULT_LIMIT),
            "owner_labels": list(own.get("owner_labels") or module.DEFAULT_OWNER_LABELS)}


def triage_read_ownerless(hub, repo, options, budget):
    """(records, cut, total) of one team repository: every open item, page by page to `limit` items, and the repository's own count of open items (one more read) for
    `read X of Y`. Charged to the pass's call budget."""
    records, cut = hub.read_pages("repos/%s/issues?state=open&sort=updated&direction=asc&per_page=100" % repo, cap=max(1, -(-options["limit"] // 100)))   # the LEAST recently updated first: a cut keeps the stale ones this line exists for (the triage's own shared read is unchanged)
    budget[0] -= sweep_pages_used(records, cut) + 1
    total = None
    try:
        total = hub.open_issues_count(repo)
    except GitHubUnavailable:
        total = None
    if total is None and not cut:
        total = len(records)
    return records, cut, total


def triage_refresh_ownerless(engine, state, cfg, now, budget, seconds):
    """Read the team repositories' whole lists (the stalest first) while the call budget and time allow. A failed read keeps the old copy."""
    options, hub = triage_ownerless_options(cfg), getattr(engine, "hub", None)
    if options is None or hub is None:
        return
    todo = sorted((state.units.get((repo, "ownerless"), {"at": 0})["at"], repo) for repo in options["repos"]
                  if repo not in state.unreadable and now - state.units.get((repo, "ownerless"), {"at": 0})["at"] >= TRIAGE_TTL)
    for _, repo in todo:
        if budget[0] < 2 or engine.now() - state.started >= seconds:
            return
        try:
            records, cut, total = triage_read_ownerless(hub, repo, options, budget)
            state.units[(repo, "ownerless")] = {"at": now, "data": records, "truncated": cut, "total": total, "error": None}
        except GitHubUnavailable as err:
            budget[0] -= 1
            if (repo, "ownerless") in state.units:   # it was read before: a failed refresh keeps the old copy and tries again after the usual wait
                state.units[(repo, "ownerless")].update(at=now, error=_one_line(str(err), 160))
            else:
                state.units[(repo, "ownerless")] = {"at": now - TRIAGE_TTL + 60, "data": [], "truncated": False, "total": None, "error": _one_line(str(err), 160), "empty": True}


OWNERLESS_FILE = "triage-ownerless.json"   # {repo: {"at": epoch}}: when each repository's daily line was last sent (private; survives a restart)


def triage_ownerless_pass(engine, state, cfg, now):
    """#605: once a day per team repository, ONE line to the Chief of Staff and to the orchestrators of that repository: how many open issues have no owner and no
    activity for N days, how old the oldest is, the five oldest as links, and how much of the list was read. Counts, ages and links only; nothing is written to any issue.
    Returns {repo: summary} for the report. Never raises."""
    options = triage_ownerless_options(cfg)
    if options is None or engine.state_dir is None:
        return {}
    if whole_skipped(engine, "triage.ownerless", "agents"):
        return {}   # #805: an issue is ownerless when no running agent owns it: a fleet that was not read whole is no evidence of that
    module, shown = load_module("triage_ownerless"), {}
    try:
        discovery, ours = getattr(engine, "discovery", None), triage_our_logins(engine, cfg)
        for repo in options["repos"]:
            unit = state.units.get((repo, "ownerless"))
            if unit is None or unit.get("empty") or unit.get("error") and not unit["data"]:
                continue
            items = {}
            for record in unit["data"]:
                item = triage_norm(record)
                if item is not None and item["state"] == "open":
                    items[item["number"]] = item
            lanes = {name.lower() for name, agent in (discovery.agents.items() if discovery else [])   # a known lane: an orchestrator the daemon holds for the repository
                     if (agent.fleet or {}).get("role") == "orchestrator" and (_fleet_repo(agent.fleet or {}, engine.config) == repo or (agent.fleet or {}).get("repo") == repo)}
            rows, parked = module.ownerless_split(items, triage_context(engine, repo, items, discovery), ours, options["owner_labels"], now, options["days"],
                                                  options["label_owners"].get(repo), lanes, triage_parked_now)   # #889: a future-parked issue is counted apart, never listed
            read, total = len(unit["data"]), unit.get("total")
            shown[repo] = {"count": len(rows), "parked": len(parked), "read": read, "total": total, "oldest_days": int(rows[0][1]) if rows else None}
            if not rows:
                continue
            sent = _read_small(engine.state_dir, OWNERLESS_FILE)
            if now - sent.get(repo, {}).get("at", 0) < 86400:
                continue
            sent[repo] = {"at": int(now)}
            _write_small(engine.state_dir, OWNERLESS_FILE, sent)   # before the send: at most one line a day, even when a send fails
            line = module.summary_line(repo, rows, read, total, options["days"], unit.get("truncated") is True, len(parked))
            names = ["chief-of-staff"] + sorted(name for name, agent in (discovery.agents.items() if discovery else [])
                                                if _is_orchestrator(agent) and _fleet_repo(agent.fleet or {}, engine.config) == repo)
            told = []
            for name in names:
                try:
                    outcome = engine.send("switchboard", name, line)
                    if not (isinstance(outcome, dict) and outcome.get("sent") is False):
                        told.append(name)
                except Exception as err:   # a failed send is audited, never retried into a second line
                    engine._note("triage.ownerless_send_failed", repo, {"to": name, "error": _one_line(str(err), 120)})
            engine._note("triage.ownerless", repo, {"count": len(rows), "parked": len(parked), "read": read, "total": total, "told": told})
    except Exception as err:
        engine._note("triage.ownerless_error", "", {"error": _one_line("%s: %s" % (type(err).__name__, err), 160)})
    return shown


def read_mark(engine, name, whole, reason, now):
    """Record that the input `name` was (or was not) read whole in this pass: no error, not cut by a budget, not provisional.
    The record lives in memory only, so a restart leaves every input not whole until its first whole read (#805)."""
    reads = engine.__dict__.setdefault("read_whole", {})
    reads[name] = {"whole": bool(whole), "reason": "" if whole else (reason or "not read whole"), "at": now}


def whole(engine, name):
    """(True, "") when `name` was read whole in the latest pass, else (False, why). Never read yet in this process is not whole."""
    held = getattr(engine, "read_whole", {}).get(name)
    if held is None:
        return False, "not read yet in this process"
    return held["whole"], held["reason"]


def whole_skipped(engine, consumer, name):
    """One debug audit line, at most once per pass and consumer, saying a destructive step was skipped because `name` was not whole."""
    ok, why = whole(engine, name)
    if ok:
        return False
    at = engine.read_whole.get(name, {}).get("at") if getattr(engine, "read_whole", None) else None
    said = engine.__dict__.setdefault("read_whole_said", {})
    if said.get((consumer, name)) != at:
        said[(consumer, name)] = at
        state = getattr(engine, "triage", None)
        if name.startswith("issues:") and state is not None and getattr(state, "wanted", 0):
            why = "%s (%d of %d units read)" % (why, sum(1 for u in state.units.values() if u["error"] is None), state.wanted)   # #1140: how far the cold start has got
        engine._note("whole.skipped", None, {"consumer": consumer, "input": name, "why": why})
    return True


def mark_decisions_read(engine, errors, now):
    """The decision list is whole only with no error and a notice read that finished whole: a noticed PR the reader has no facts for
    derives no held-PR row, so its absence is no evidence it left. Never inherited: an input no read marked, or whose read raised, is not whole."""
    notices, notices_why = whole(engine, "notices")
    why = "the decision list had errors" if errors else ("" if notices else notices_why)
    read_mark(engine, "decisions", not errors and notices, why, now)


def triage_mark_unit(engine, state, name, repo, units, now):
    """Mark `<name>:<repo>` from the held units of that kind: whole only when every one is held, without error and not cut."""
    bad = None
    for unit_name in units:
        unit = state.units.get((repo, unit_name))   # a unit never read, a failed read or a cut list is no evidence of an absence
        if unit is None:
            bad = "%s not read yet" % unit_name
        elif unit.get("error"):
            bad = "the last read of %s failed: %s" % (unit_name, unit["error"])
        elif unit.get("truncated"):
            bad = "the %s list was cut" % unit_name
        if bad:
            break
    read_mark(engine, "%s:%s" % (name, repo), bad is None, bad or "", now)


def triage_mark_reads(engine, state, repos, errors, now):
    """The inputs the triage rules judge, marked from the reads this pass already made (no new read)."""
    mark_decisions_read(engine, errors, now)
    closed = ["closed:" + l for l in sorted(triage_awaiting_labels(engine))]
    for repo in repos:
        triage_mark_unit(engine, state, "issues", repo, ["issues"], now)
        triage_mark_unit(engine, state, "comments", repo, ["comments"], now)
        triage_mark_unit(engine, state, "merged", repo, ["merged"], now)
        triage_mark_unit(engine, state, "closed", repo, closed, now)


def triage_owner_tier_t6(engine, decisions):
    """{("T6", ref)} for the merge-held PR decisions already at the owner's tier."""
    out = set()
    for d in decisions:
        if d.get("kind") == "captain" and d.get("tier") == "human":
            ref = sweep_ref_of(d, engine.config.get("intent_repo"))
            if ref and ref[0]:
                out.add(("T6", "%s#%d" % ref))
    return out


def triage_pass(engine, decisions, now, errors=()):
    """The triage's whole pass: refresh a few units, judge, re-check each candidate against a fresh read, audit, count,
    and (only when enabled) queue ONE batched fact for the Chief of Staff and the daily summary. Writes nothing to GitHub."""
    cfg = engine.config.get("triage", TRIAGE_DEFAULTS)
    if cfg is False or cfg is None:
        return
    repos = triage_repos(engine, cfg)
    if not repos:
        return  # nothing is tracked: nothing to read, nothing to say
    state = triage_state(engine)
    state.started = engine.now()
    budget = [cfg.get("calls_per_pass", TRIAGE_CALLS_PER_PASS)]
    seconds = cfg.get("pass_seconds", TRIAGE_PASS_SECONDS)
    units = ["issues", "comments", "merged"] + ["closed:" + l for l in sorted(triage_awaiting_labels(engine))]
    state.wanted = len(repos) * len(units)
    triage_refresh(engine, state, repos, units, now, budget, max(1, budget[0] // 3), seconds)  # a third kept for fresh checks
    triage_read_live(engine, state, repos, now, budget, max(1, cfg.get("calls_per_pass", TRIAGE_CALLS_PER_PASS) // 3), seconds)
    triage_refresh_ownerless(engine, state, cfg, now, budget, seconds)   # #605: the team repositories' whole lists, after the shared units
    try:
        plan_wake_pass(engine, state, repos, now, budget)   # #765: the plans posted or edited, from the units just held
    except Exception as err:
        engine._note("plan_wake.error", "", {"error": _one_line("%s: %s" % (type(err).__name__, err), 160)})
    triage_mark_reads(engine, state, repos, errors, now)
    try:
        alert_wake_pass(engine, state, cfg, now)   # #851: an alert issue wakes its repository's orchestrator once, from the lists just held
    except Exception as err:
        engine._note("alert_wake.error", "", {"error": _one_line("%s: %s" % (type(err).__name__, err), 160)})
    candidates, unchecked_units, truncated = triage_findings(engine, state, repos, decisions, cfg, now, errors)
    findings, unchecked, unchecked_other, oldest = [], 0, 0, 0.0
    why = {}   # #605: repo -> {reason: count}, and its other-owner share and oldest age, for the report

    def verify(rule, ref, evidence):
        """True/False/None for one finding; keeps the confirmed, verified and attempted records."""
        pair = (rule, ref)
        state.attempted[pair] = now
        verdict = triage_verify(engine, state, rule, ref, cfg, now, budget, evidence)
        if verdict is not None:
            state.verified[pair] = now
        if verdict:
            state.confirmed[pair] = now
        elif verdict is False:
            state.confirmed.pop(pair, None)
            if (pair, "d", int(now // 86400)) not in state.logged:
                state.logged.add((pair, "d", int(now // 86400)))
                engine._note("triage.dismissed", ref, {"rule": rule, "ref": ref, "why": "a fresh read does not bear it out"})
        return verdict

    # Our own findings first, the other-owner flags (which nobody acts on) after them: they must not use the budget our findings
    # need. Within each, the least recently attempted first, so every one is reached within a bounded number of passes.
    for rule, ref, evidence in sorted(candidates, key=lambda c: (c[0] == "OO", state.attempted.get((c[0], c[1]), 0), c[0], c[1])):
        pair = (rule, ref)
        state.first_seen.setdefault(pair, now)
        if now - state.confirmed.get(pair, 0) < TRIAGE_TTL:
            findings.append((rule, ref, evidence))
            continue
        verdict = None
        if engine.now() - state.started < seconds:
            verdict = verify(rule, ref, evidence)
        if verdict:
            findings.append((rule, ref, dict(evidence, **state.enriched.pop(pair, {}))))
        elif verdict is None:
            unchecked += 1
            unchecked_other += rule == "OO"
            oldest = max(oldest, now - state.verified.get(pair, state.first_seen[pair]))
            repo_of = ref.rpartition("#")[0]
            reason = "call budget" if (budget[0] < 1 or engine.now() - state.started >= seconds) else "failed read"
            entry = why.setdefault(repo_of, {"reasons": {}, "other_owner": 0, "oldest": 0.0})
            entry["reasons"][reason] = entry["reasons"].get(reason, 0) + 1
            entry["other_owner"] += rule == "OO"
            entry["oldest"] = max(entry["oldest"], now - state.verified.get(pair, state.first_seen[pair]))
    findings.sort()
    day = int(now // 86400)
    counts, other_owner = {}, 0
    for rule, ref, evidence in findings:
        if isinstance(evidence, dict) and evidence.get("reason"):
            state.reasons[(rule, ref)] = evidence["reason"]
        if rule == "OO":
            other_owner += 1   # a flag, never counted as one of our findings
        else:
            counts[rule] = counts.get(rule, 0) + 1
    for repo_of, units_missing in unchecked_units.items():   # a unit not read yet is a finding that could not be judged
        if units_missing:
            why.setdefault(repo_of, {"reasons": {}, "other_owner": 0, "oldest": 0.0})["reasons"]["not read yet"] = len(units_missing)
    for repo_of in repos:
        if (repo_of, "issues") not in state.units and repo_of not in state.unreadable:
            why.setdefault(repo_of, {"reasons": {}, "other_owner": 0, "oldest": 0.0})["reasons"]["not read yet"] = why.get(repo_of, {}).get("reasons", {}).get("not read yet", 0) + 1
    ownerless = triage_ownerless_pass(engine, state, cfg, now)
    state.current = {"enabled": cfg["enabled"], "counts": counts, "total": sum(counts.values()),
                     "other_owner": other_owner, "at": iso(now),
                     "unchecked": unchecked, "unchecked_other_owner": unchecked_other,
                     "waiting_for_batch": sum(state.batch_waiting.values()),
                     "oldest_unchecked_seconds": int(oldest), "unchecked_units": {r: sorted(u) for r, u in unchecked_units.items()},
                     "unreadable": sorted(state.unreadable), "truncated": sorted(truncated), "repos": len(repos),
                     "digest_interval_minutes": cfg.get("digest_interval_minutes", 60)}
    if why:
        state.current["unchecked_why"] = {r: {"reasons": v["reasons"], "other_owner": v["other_owner"], "oldest_seconds": int(v["oldest"])} for r, v in sorted(why.items())}
    if ownerless:
        state.current["ownerless"] = ownerless
    held = getattr(engine, "plan_wake", None)
    if held is not None and held.unapproved:   # #765: the plans that look unapproved, one status line (a hint: see docs/switchboard.md)
        state.current["plans_unapproved"] = held.unapproved[:load_triage_plan_open().MAX_LISTED]
        state.current["plans_unapproved_more"] = max(0, len(held.unapproved) - load_triage_plan_open().MAX_LISTED)
    triage_write(engine, state)
    flagged = [(r, ref) for r, ref, _ in findings if r == "OO" and now - state.alarmed.get((r, ref), 0) >= cfg["realarm_hours"] * 3600]
    owner_t6 = triage_owner_tier_t6(engine, decisions)
    due, invalid = triage_digest_due(engine, state, [(r, ref) for r, ref, _ in findings if r != "OO"],
                                     [(r, ref) for r, ref, _ in candidates if r != "OO"], cfg, now, owner_t6)
    triage_logged_seed(state, due, cfg, now, day)   # #849: before the commit below rewrites the memory
    if cfg["enabled"] and cfg.get("backoff", True):   # #406: warm up first, then at most one digest per interval; a held digest keeps its memory untouched
        before = state.meta["swept"]
        open_units = sum(len(u) for u in unchecked_units.values()) + sum(1 for r in repos if (r, "issues") not in state.units and r not in state.unreadable)   # a list not read yet is a finding not checked
        if not state.meta["swept"] and getattr(state, "warming_since", None) is None:
            state.warming_since = now
        allowed, digest = triage_digest.gate(state.meta, now, unchecked + open_units, cfg.get("digest_interval_minutes", 60) * 60,
                                             getattr(state, "warming_since", None))
        state.current["digest"] = digest
        triage_write(engine, state)
        if state.meta["swept"] != before:
            triage_digest.write_seen(engine.state_dir, state.seen, state.meta)
        if not allowed:
            due, invalid = [], []
    rolled = None
    if cfg["enabled"] and state.meta is not None:   # #766: the one daily line for T5 items listed before and still in the owner's tier
        rolled = triage_digest.rollup(state.seen, state.meta, [(r, ref) for r, ref, _ in findings if r == "T5" or (r, ref) in owner_t6], now)
        if rolled:
            state.facts["triage.rollup:%d" % int(now)] = (rolled, now)
            triage_digest.cost_record(engine.state_dir, now, rolled)
            engine._note("triage.rollup", None, {"text": rolled, "at": iso(now)})
            triage_digest.write_seen(engine.state_dir, state.seen, state.meta)
    if cfg["enabled"] and (due or invalid):   # never a wake solely for other-owner flags: they ride along when a wake happens anyway
        state.carried = set()
        text = triage_queue_fact(state, due, now, cfg, len(flagged), invalid)
        triage_digest.cost_record(engine.state_dir, now, text)
        state.meta["last"] = now
        triage_digest_commit(engine, state, due[:cfg["max_findings"]], invalid, now)
        if state.current.get("digest", {}).get("state") == "ready" and cfg.get("digest_interval_minutes", 60) > 0:
            state.current["digest"] = {"state": "held", "next_at": now + cfg["digest_interval_minutes"] * 60}
            triage_write(engine, state)
        for pair in flagged:
            state.alarmed[pair] = now
        for rule, _ in due:
            state.day_counts[rule] = state.day_counts.get(rule, 0) + 1
        woken = set(state.carried) | set(flagged)   # #849: what the digest carried, and the other-owner flags that rode along (counted in its text, remembered below)
    else:
        woken = set()
    for rule, ref, evidence in findings:   # #849: the audit line says what was done: woken only when this pass queued a wake for it
        once = (rule, ref, day)
        if once not in state.logged or ((rule, ref) in woken and once not in state.woken_logged):
            if len(state.logged) > 20000:
                state.logged.clear()
                state.woken_logged.clear()
            state.logged.add(once)
            if (rule, ref) in woken:
                state.woken_logged.add(once)
            engine._note("triage.finding", ref, {"rule": rule, "ref": ref, "what": TRIAGE_KINDS[rule],
                                                 "evidence": evidence, "woken": (rule, ref) in woken, "applied": False})
    triage_daily_summary(engine, state, cfg, now, day, repos)


def triage_logged_seed(state, due, cfg, now, day):
    """Once per process: what the persisted digest memory listed inside the re-alarm window (and is not due again now) was
    already audited before the restart, so it is not logged again (#849). Needs the memory loaded."""
    if getattr(state, "logged_seeded", False) or state.seen is None:
        return
    state.logged_seeded = True
    again = set(due)
    for key, rec in state.seen.items():
        rule, _, ref = key.partition(" ")
        if rule in TRIAGE_KINDS and (rule, ref) not in again and now - rec["at"] < cfg["realarm_hours"] * 3600:
            state.logged.add((rule, ref, day))


def triage_digest_items(state):
    """"repo#N" -> the reduced issue the rules read, from the lists already held (no read)."""
    index = {}
    for (repo, unit), held in state.units.items():
        if unit == "issues" and isinstance(held, dict) and isinstance(held.get("data"), list):
            for record in held["data"]:
                item = triage_norm(record) if isinstance(record, dict) else None
                if item is not None:
                    index["%s#%d" % (repo, item["number"])] = item
    return index


def triage_digest_memory(engine, state):
    """The digest's memory and its cadence, loaded once together (the gate and the commit both need `state.meta`)."""
    if state.seen is None or state.meta is None:
        state.seen = triage_digest.load_seen(engine.state_dir)
        state.meta = triage_digest.load_meta(engine.state_dir)


def triage_digest_keep(engine):
    """keep(rule, ref) for the prune: True when the record's candidates could not be computed in this pass (#805)."""
    def keep(rule, ref):
        needs = triage_inputs(rule)
        if needs is None:
            return True   # a rule the table does not know: nothing about it is forgotten
        repo = ref.rpartition("#")[0]
        return any(whole_skipped(engine, "triage.prune", name if name in ("agents", "decisions") else "%s:%s" % (name, repo))
                   for name in needs if name in ("agents", "decisions") or repo)
    return keep


def triage_digest_due(engine, state, ours, candidates, cfg, now, owner_t6=()):
    """([(rule, ref)] for this pass's one digest, [ref] with an invalid parked label); see bin/triage_digest.py."""
    triage_digest_memory(engine, state)
    triage_digest.prune(state.seen, candidates, triage_digest_keep(engine))
    mutes = triage_digest.load_mutes(engine.state_dir) if engine.state_dir else {}
    return triage_digest.select(state.seen, triage_digest_items(state), mutes, ours, now, cfg.get("backoff", True), state.alarmed,
                                cfg["realarm_hours"] * 3600, PARKED_MAX_DAYS, owner_t6)


def triage_digest_commit(engine, state, shown, invalid, now):
    triage_digest.commit(state.seen, triage_digest_items(state), shown, invalid, now)
    for ref in invalid:
        engine._note("triage.parked_invalid", ref, {"ref": ref, "why": "a parked label without one valid `Parked until: YYYY-MM-DD` line"})
    triage_digest.write_seen(engine.state_dir, state.seen, state.meta)


def triage_queue_fact(state, due, now, cfg, other_owner=0, invalid=()):
    """Queue THE one digest of the pass and return its text (the cost figure counts it). Only the shown items are marked."""
    shown = due[:cfg["max_findings"]]
    digest = hashlib.sha256("|".join("%s:%s" % pair for pair in shown).encode()).hexdigest()[:10]
    key = "triage:%s:%d" % (digest, int(now // (cfg["realarm_hours"] * 3600)))
    kinds = sorted({r for r, _ in due})
    if not due:   # only the once-only flag of an invalid park: still one message, and nothing else in it
        summary = "triage: no stale item to show; parked without a valid `Parked until: YYYY-MM-DD` line (treated as not parked): %s." % ", ".join(invalid)
        state.facts["triage:parked:%s" % hashlib.sha256(summary.encode()).hexdigest()[:10]] = (summary, now)
        return summary
    summary = "triage: %d finding%s: %s%s. %s. Resolve, route or escalate each; the triage changes nothing on GitHub." % (
        len(due), "" if len(due) == 1 else "s", ", ".join("%s %s%s" % (ref, rule, " (%s)" % state.reasons[(rule, ref)] if (rule, ref) in state.reasons else "") for rule, ref in shown),
        " (+%d more)" % (len(due) - len(shown)) if len(due) > len(shown) else "",
        "; ".join("%s = %s" % (k, TRIAGE_KINDS[k]) for k in kinds))
    if other_owner:
        summary += " Also %d other-owner flag(s): not ours, nothing to do." % other_owner
    if invalid:
        summary += " Parked without a valid `Parked until: YYYY-MM-DD` line (treated as not parked): %s." % ", ".join(invalid)
    for pair in shown:
        state.alarmed[pair] = now
    state.facts[key] = (summary, now)
    for old in [k for k, (_, at) in state.facts.items() if now - at > cfg["realarm_hours"] * 7200 and "summary" not in k]:
        del state.facts[old]
    state.carried = set(shown)   # #849: what this digest carried and remembered; an overflow beyond the cap stays due
    return summary


def triage_daily_summary(engine, state, cfg, now, day, repos):
    """Once per 24 h SINCE THE LAST ONE (not per calendar day): found, other-owner, escalated, unchecked and unreadable counts.
    Audited always; sent to the Chief of Staff only when enabled and `daily_summary`. Not before every repo was read once."""
    if not state.current or (state.summarised is not None and now - state.summarised < 86400):
        return
    if not all((r, "issues") in state.units or r in state.unreadable for r in repos):
        return   # not every repo has been read once yet (a restart's first passes): a summary of nothing says nothing
    state.summarised = now
    counts = state.current["counts"]
    text = "triage summary: found %d (%s); other-owner flags %d; escalated since the last summary %d; unchecked %d; unreadable repos %d%s" % (
        state.current["total"], ", ".join("%s %d" % kv for kv in sorted(counts.items())) or "none",
        state.current.get("other_owner", 0), sum(state.day_counts.values()), state.current["unchecked"],
        len(state.current["unreadable"]),
        " (" + ", ".join(state.current["unreadable"][:5]) + ")" if state.current["unreadable"] else "")
    state.day_counts = {}
    engine._note("triage.summary", None, {"text": text, "counts": counts, "enabled": cfg["enabled"], "at": iso(now)})
    if cfg["enabled"] and cfg["daily_summary"]:
        state.facts["triage.summary:%d" % int(now)] = (text, now)
        triage_digest.cost_record(engine.state_dir, now, text)


def triage_write(engine, state):
    path = Path(engine.state_dir) / TRIAGE_FILE
    body = json.dumps(state.current, sort_keys=True)
    try:
        state_write(path, body + "\n", _without(state.current, "at"), HEARTBEAT_SWEEP)
    except OSError:
        pass


def triage_summary(state_dir):
    try:
        raw = json.loads((Path(state_dir) / TRIAGE_FILE).read_text())
    except (OSError, ValueError):
        return None
    if not (isinstance(raw, dict) and isinstance(raw.get("counts"), dict)):
        return None
    raw["cost"] = triage_digest.cost_read(str(state_dir))   # #349: None means no figure was recorded
    return raw


# ---- #765: a posted or edited plan tells its approver once per hash. Reads only what the triage pass already holds (no GitHub read of its own).

PLAN_WAKE_FILE = "plan-wake.json"
PLAN_WAKE_FACT_KEEP = 2 * 86400


class PlanWakeState:
    """The announced hashes (kept in PLAN_WAKE_FILE so a restart never repeats one) and the facts waiting to be delivered (memory)."""

    def __init__(self, state_dir):
        self.announced, self.facts, self.unapproved, self.problem = {}, {}, [], None
        try:
            raw = json.loads((Path(state_dir) / PLAN_WAKE_FILE).read_text())
            if isinstance(raw, dict) and isinstance(raw.get("announced"), dict):
                self.announced = {k: v for k, v in raw["announced"].items() if isinstance(k, str) and isinstance(v, (int, float))}
        except FileNotFoundError:
            pass
        except (OSError, ValueError) as err:
            self.problem = "plan-wake.json cannot be read, so plans of the last 24 hours may be announced again: %s" % _one_line(type(err).__name__, 40)


def plan_wake_state(engine):
    state = getattr(engine, "plan_wake", None)
    if state is None:
        state = engine.plan_wake = PlanWakeState(engine.state_dir)
        if state.problem:
            engine._note("plan_wake.error", "", {"error": state.problem})
    return state


def plan_wake_consensus(engine):
    """The plan hashes with a consensus pass in the local ledger; empty when it cannot be read (a plan is then judged on comments and pull requests alone)."""
    try:
        entries, _ = plan_ledger.read_ledger(engine.state_dir)
    except Exception as err:
        engine._note("plan_wake.error", "", {"error": "the ledger cannot be read for consensus: %s" % _one_line(type(err).__name__, 40)})
        return set()
    return {e.get("plan_hash") for e in entries if e.get("kind") == "consensus" and e.get("result") == "pass" and isinstance(e.get("plan_hash"), str)}


def plan_wake_route(number, items, ctx, discovery, chiefs, owners=None):
    """(recipient names, "ask" or "work item") for the plan of issue `number`, from the held parent links alone (never from the plan's text):
    a sub-issue of a charter is an ask (the Chief of Staff); a sub-issue of such an ask is a work item (its charter's orchestrator). None otherwise."""
    parent = (items.get(number) or {}).get("parent")
    if parent in ctx["charters"]:
        return list(chiefs), "ask"
    if parent in ctx["asks"]:
        charter = (items.get(parent) or {}).get("parent")
        names = sorted(n for n, o in (discovery.agents.items() if discovery else [])
                       if (o.fleet or {}).get("role") == "orchestrator" and (owners or {}).get(n) == charter)   # #969: the registry's charter (`owners`), never the session metadata
        return names, "work item"
    return None


def plan_wake_pass(engine, state, repos, now, budget=None):
    """Announce each new plan hash to its approver once, and list the plans that look unapproved. Never raises; reads nothing from GitHub."""
    wake = plan_wake_state(engine)
    module, check_module = load_triage_plan_open(), load_plan_check()
    discovery = getattr(engine, "discovery", None)
    if discovery is None or discovery.problems:
        return
    chiefs = sorted(n for n, o in discovery.agents.items() if (o.fleet or {}).get("role") == "chief-of-staff")
    consensus, sends, listed, changed = None, None, [], False
    for repo in repos:
        issues_unit, comments_unit = state.units.get((repo, "issues")), state.units.get((repo, "comments"))
        if issues_unit is None or comments_unit is None:
            continue
        raw = {}
        for record in issues_unit["data"]:
            item = triage_norm(record)
            if item is not None and item["state"] == "open" and not item["pr"]:
                raw[item["number"]] = (item, record)
        items = {n: i for n, (i, _) in raw.items()}
        ctx = triage_context(engine, repo, items, discovery)
        by_issue = {}
        for comment in comments_unit["data"]:
            n = _url_number(comment.get("issue_url")) if isinstance(comment, dict) else None
            if n is not None:
                by_issue.setdefault(n, []).append(comment)
        pulls = [r for r in issues_unit["data"] if _is_pr(r)] + list((state.units.get((repo, "merged")) or {}).get("data") or [])
        for number, plan in sorted(module.latest_plans(comments_unit["data"], check_module.HEADING_RE, _url_number).items()):
            if number not in items:
                continue
            route = plan_wake_route(number, items, ctx, discovery, chiefs, registry_owners(engine))
            if route is None:
                continue
            posted = parse_iso(plan.get("updated_at") or plan.get("created_at"))
            if posted is None or now - posted > module.ANNOUNCE_SECONDS:
                continue
            body = plan["body"]
            plan_hash = check_module.plan_hash(body)
            if consensus is None:
                consensus = plan_wake_consensus(engine)
            if (plan_hash in consensus or module.approved_by_comment(plan, plan_hash, by_issue.get(number, []), signed_by_fleet)
                    or module.cited_by_pr(repo, number, plan, pulls, parse_iso)):
                continue
            if sends is None:
                sends = _audit_tail(engine.state_dir)   # #790: the sends the audit already holds, read once per pass and only for a plan no other form approved
            if module.approved_by_send(plan, plan_hash, sends, signed_by_fleet):
                continue
            url = module.plan_url(repo, number, plan["id"])
            key = "%s#%d:%s" % (repo, number, plan_hash)
            names = route[0]
            if key not in wake.announced and names:
                own = raw[number][1]
                source = number
                done_when = parse_intent(own.get("body"))[1]
                if route[1] == "work item":
                    parent_record = (raw.get((items[number] or {}).get("parent")) or (None, {}))[1]
                    if parse_intent(parent_record.get("body"))[1]:
                        source, done_when = items[number]["parent"], parse_intent(parent_record.get("body"))[1]
                stale, defect = False, ""
                try:
                    result = check_module.check(body, done_when, None)
                    passed = result["result"] == "pass"
                    defect = _one_line(str((result.get("defects") or [""])[0]), 160)
                except Exception:
                    passed = False
                if not passed:   # #802: a FAIL is confirmed against ONE fresh read of the issue that supplied the Done-when, never the cached body
                    stale = True
                    hub = getattr(engine, "hub", None)
                    if hub is not None and (budget is None or budget[0] >= 1):
                        if budget is not None:
                            budget[0] -= 1
                        try:
                            fresh = hub._read_one(repo, "issues/%d" % source, now, fresh=True)
                            fresh_done = parse_intent(fresh.get("body"))[1] if isinstance(fresh, dict) else None
                        except Exception:
                            fresh_done = None
                        if fresh_done:
                            stale = False
                            try:
                                result = check_module.check(body, fresh_done, None)
                                passed = result["result"] == "pass"
                                defect = _one_line(str((result.get("defects") or [""])[0]), 160)
                            except Exception:
                                passed = False
                text = module.line(number, url, plan_hash, passed, stale and not passed)
                for name in names:
                    wake.facts["plan:%s:%s" % (key, name)] = (text, now, name, repo, number)
                wake.announced[key] = now
                changed = True
                engine._note("plan_wake.announced", "%s#%d" % (repo, number), {"hash": plan_hash, "to": names, "route": route[1], "check": "PASS" if passed else "FAIL", "stale": bool(stale and not passed), "defect": "" if passed else defect})
            if now - posted >= module.UNAPPROVED_SECONDS:
                listed.append("%s#%d" % (repo, number) if len(repos) > 1 else "#%d" % number)
    wake.unapproved = sorted(listed)
    for old in [k for k, v in wake.announced.items() if now - v > 14 * 86400]:
        del wake.announced[old]
        changed = True
    for old in [k for k, v in wake.facts.items() if now - v[1] > PLAN_WAKE_FACT_KEEP]:
        del wake.facts[old]
    if changed:
        try:
            state_write(Path(engine.state_dir) / PLAN_WAKE_FILE, json.dumps({"announced": wake.announced}, sort_keys=True) + "\n", fsync=True)
        except OSError as err:
            engine._note("plan_wake.error", "", {"error": "plan-wake.json was not saved, so a restart may announce again: %s" % _one_line(type(err).__name__, 40)})


class PlanWakeFacts:
    """The one line each approver is told about a new plan hash: an ordinary fact, so the usual rule picks a note or a wake and a key found in the
    recipient's inbox is never delivered again."""

    __name__ = "plan_wake_facts"

    def __init__(self):
        self.engine = None

    def bind(self, engine):
        self.engine = engine

    def __call__(self):
        wake = getattr(self.engine, "plan_wake", None) if self.engine else None
        if not wake or not wake.facts:
            return []
        return [Fact(key, name, "plan", text, created, issue=number, sender="switchboard", repo=repo)
                for key, (text, created, name, repo, number) in sorted(wake.facts.items())]


# ---- #851: an open issue carrying a configured alert label wakes that repository's orchestrator once per issue and label. Reads only what the triage pass holds.

ALERT_WAKE_FILE = "alert-wake.json"   # {"<repo>#<number> <label>": {"at": epoch}}: what was already told (private; survives a restart)
ALERT_WAKES_PER_PASS = 5              # a burst is told in steps of this many issues; the rest is named in one line and follows on the next passes
ALERT_TITLE_CHARS = 100
ALERT_FACT_KEEP = 2 * 86400
ALERT_MEMORY_MAX = 5000
ALERT_KEY_RE = re.compile(r"^[^#\s]+#[0-9]+ \S.*$")
ALERT_CONTROL_RE = re.compile(r"[\x00-\x1f\x7f-\x9f]")


class AlertWakeState:
    """What was told (`told`: key -> when) and the lines still waiting (`lines`: key -> {recipient: text}), both kept in ALERT_WAKE_FILE: a line is kept there
    until it is old enough (ALERT_FACT_KEEP) and loaded back as a fact at start, so a daemon that stops between queueing and delivery still delivers it. The
    fact key is stable, and a key already in the recipient's inbox is never delivered again, so re-queueing cannot repeat a delivered wake."""

    def __init__(self, state_dir, now=None):
        self.told, self.lines, self.facts, self.problem = {}, {}, {}, None
        try:
            with open(str(Path(state_dir) / ALERT_WAKE_FILE), "rb") as handle:
                raw = json.loads(handle.read(1000001).decode("utf-8"))   # a bounded read: the file is ours, but a runaway one must not be loaded whole
            if isinstance(raw, dict):
                for key, value in list(raw.items())[:ALERT_MEMORY_MAX]:
                    if not (isinstance(key, str) and ALERT_KEY_RE.match(key) and isinstance(value, dict) and _is_number(value.get("at"))):
                        continue   # a malformed key is dropped, never parsed later
                    self.told[key] = value["at"]
                    lines = value.get("lines")
                    if now is not None and isinstance(lines, dict) and now - value["at"] < ALERT_FACT_KEEP:
                        repo, _, rest = key.partition("#")
                        number = int(rest.split(" ", 1)[0])
                        self.lines[key] = {n: l for n, l in lines.items() if isinstance(n, str) and isinstance(l, str)}
                        for name, text in self.lines[key].items():
                            self.facts["alert:%s:%s" % (key, name)] = (text, value["at"], name, repo, number)
        except FileNotFoundError:
            pass
        except (OSError, ValueError, UnicodeError) as err:
            self.problem = "alert-wake.json cannot be read, so alert issues may be told again: %s" % _one_line(type(err).__name__, 40)


def alert_wake_state(engine):
    state = getattr(engine, "alert_wake", None)
    if state is None:
        state = engine.alert_wake = AlertWakeState(engine.state_dir, engine.now())
        if state.problem:
            engine._note("alert_wake.error", "", {"error": state.problem})
    return state


def alert_line(repo, number, title, label):
    """The one line the orchestrator reads. The title is the issue author's text: one line, bounded, quoted, and data (never an instruction)."""
    return "alert issue %s#%d \"%s\" carries label %s" % (repo, number, _one_line(ALERT_CONTROL_RE.sub(" ", title), ALERT_TITLE_CHARS).replace('"', "'"), label)


def alert_wake_pass(engine, state, cfg, now):
    """Judges an input only when it was read whole: a repository whose issue list was not (cut, failed, never read) wakes nothing and forgets nothing,
    and neither does a pass whose roster of agents was not read whole."""
    configured = {r: list(l) for r, l in (cfg.get("alert_labels") or {}).items() if l}
    if not configured or engine.state_dir is None:
        return
    wake = alert_wake_state(engine)
    for old in [k for k, v in wake.facts.items() if now - v[1] > ALERT_FACT_KEEP]:
        del wake.facts[old]
    if whole_skipped(engine, "alert_wake", "agents"):
        return
    discovery, changed = getattr(engine, "discovery", None), False
    for repo, labels in sorted(configured.items()):
        if whole_skipped(engine, "alert_wake", "issues:" + repo):
            continue
        unit = state.units.get((repo, "issues"))
        if unit is None:
            continue
        open_numbers, pending = set(), []
        for record in unit["data"]:
            item = triage_norm(record)
            if item is None or item["pr"] or item["state"] != "open":
                continue
            open_numbers.add(item["number"])
            title = record.get("title") if isinstance(record.get("title"), str) else ""
            for label in labels:
                key = "%s#%d %s" % (repo, item["number"], label)
                if label in item["labels"] and key not in wake.told:
                    pending.append((item["number"], label, key, title))
        names = sorted(n for n, a in (discovery.agents.items() if discovery else []) if _is_orchestrator(a) and _fleet_repo(a.fleet or {}, engine.config) == repo)
        pending.sort(key=lambda p: (p[0], labels.index(p[1])))
        if names:   # nobody to tell: nothing is remembered, so the first orchestrator of the repository is told
            for number, label, key, title in pending[:ALERT_WAKES_PER_PASS]:
                for name in names:
                    wake.facts["alert:%s:%s" % (key, name)] = (alert_line(repo, number, title, label), now, name, repo, number)
                wake.lines[key] = {name: wake.facts["alert:%s:%s" % (key, name)][0] for name in names}
                wake.told[key] = now
                changed = True
                engine._note("alert_wake.sent", "%s#%d" % (repo, number), {"label": label, "to": names})
            rest = pending[ALERT_WAKES_PER_PASS:]
            if rest:
                digest = hashlib.sha256("\n".join(p[2] for p in rest).encode()).hexdigest()[:12]
                for old in [k for k in wake.facts if k.startswith("alert:%s:more:" % repo)]:
                    del wake.facts[old]   # one summary line per repository: a newer count replaces one not yet delivered
                for name in names:
                    wake.facts["alert:%s:more:%s:%s" % (repo, digest, name)] = (
                        "%d more alert issue(s) of %s will be told on the next passes" % (len(rest), repo), now, name, repo, None)
        for key in [k for k in wake.told if k.startswith(repo + "#") and int(k[len(repo) + 1:].split(" ", 1)[0]) not in open_numbers]:
            del wake.told[key]   # a closed issue is forgotten, on a whole read only
            wake.lines.pop(key, None)
            changed = True
    if changed:
        keep = {k: dict({"at": at}, **({"lines": wake.lines[k]} if k in wake.lines and now - at < ALERT_FACT_KEEP else {}))
                for k, at in sorted(wake.told.items(), key=lambda kv: kv[1])[-ALERT_MEMORY_MAX:]}
        try:
            _write_small(engine.state_dir, ALERT_WAKE_FILE, keep)
        except OSError as err:
            engine._note("alert_wake.error", "", {"error": "alert-wake.json was not saved, so a restart may tell again: %s" % _one_line(type(err).__name__, 40)})


class AlertWakeFacts:
    """The alert lines, as ordinary facts: the usual rule picks a note or a wake, and a key found in the recipient's inbox is never delivered again."""

    __name__ = "alert_wake_facts"

    def __init__(self):
        self.engine = None

    def bind(self, engine):
        self.engine = engine

    def __call__(self):
        wake = getattr(self.engine, "alert_wake", None) if self.engine else None
        if not wake or not wake.facts:
            return []
        return [Fact(key, name, "alert", text, created, issue=number, sender="switchboard", repo=repo)
                for key, (text, created, name, repo, number) in sorted(wake.facts.items())]


def testers_status(config, agents, fleets, state):
    """The `status` lines of the resolved testers per repo with their source (#372); [] when there are none or the picture is unreadable."""
    try:
        if not (agents.get("ok") and fleets is not None):
            return []
        sessions = {entry["observation"]["name"]: entry["observation"].get("session") for entry in (agents.get("list") or []) if entry.get("observation")}
        repo_of = lambda fleet: _fleet_repo(fleet, config)
        repos = {repo_of(fleet) for fleet in fleets.values() if isinstance(fleet, dict) and fleet.get("role") == "orchestrator"} - {None}
        try:
            retired = registry_retired_strict(state)
        except RetiredUnreadable:
            return ["      testers    retired file unreadable: launch-record testers disabled"]   # the same fail-closed rule the verdict gate applies
        return load_launch_testers().status_lines(config.get("plan_evaluators"), fleets, sessions, repos, repo_of, retired)
    except Exception as err:
        return ["      tester     unreadable: the resolved testers could not be listed (%s)" % _one_line(type(err).__name__, 40)]


def triage_status_lines(triage):
    if not triage:
        return []
    parts = ", ".join("%s %d" % (k, n) for k, n in sorted(triage["counts"].items())) or "none"
    lines = ["      triage     %s: %s finding(s) (%s) over %s repo(s) as of %s" % (
        "on (wakes the Chief of Staff; writes nothing to GitHub)" if triage.get("enabled") else "shadow (audit only; writes nothing to GitHub)",
        triage.get("total", 0), parts, triage.get("repos", "?"), triage.get("at", "?"))]
    plans = load_triage_plan_open().unapproved_line(triage.get("plans_unapproved"), triage.get("plans_unapproved_more", 0))
    if plans:
        lines.append("      triage     " + plans)
    if triage.get("waiting_for_batch"):   # #921: counted apart, never a finding
        lines.append("      triage     %d plan issue(s) waiting for the batch (their change merged into the integration branch)" % triage["waiting_for_batch"])
    if triage.get("other_owner"):
        lines.append("      triage     %d other-owner flag(s): not ours, not counted, never a wake on their own" % triage["other_owner"])
    if triage.get("unreadable"):
        lines.append("      triage     unreadable repo(s), no findings from them: " + ", ".join(triage["unreadable"]))
    if triage.get("unchecked_units"):
        lines.append("      triage     unchecked units: " + "; ".join(
            "%s (%s)" % (r, ", ".join(u)) for r, u in sorted(triage["unchecked_units"].items())))
    if triage.get("unchecked"):
        extra = ""
        if triage.get("unchecked_other_owner"):
            extra += " (%d of them other-owner flags)" % triage["unchecked_other_owner"]
        if triage.get("oldest_unchecked_seconds") is not None:
            extra += "; oldest unchecked for %s" % format_age(triage["oldest_unchecked_seconds"])
        lines.append("      triage     %d finding(s) not checked this pass (call budget or a failed read)%s: neither "
                     "raised nor audited" % (triage["unchecked"], extra))
    for repo_of, info in sorted((triage.get("unchecked_why") or {}).items()):   # #605: why, per repository
        text = load_module("triage_ownerless").reasons_line(repo_of, info.get("reasons") or {}, info.get("other_owner", 0), info.get("oldest_seconds"))
        if text:
            lines.append("      triage     " + text)
    for repo_of, info in sorted((triage.get("ownerless") or {}).items()):
        lines.append("      triage     ownerless in %s: %d open issue(s) with no owner and quiet; parked %d; read %s of %s open item(s)" % (
            repo_of, info.get("count", 0), info.get("parked", 0), info.get("read"), info.get("total") if info.get("total") is not None else "an unknown number"))
    if triage.get("truncated"):
        lines.append("      triage     lists capped for " + ", ".join(triage["truncated"]))
    cadence = triage_digest.digest_line(triage.get("digest"), parse_iso(triage.get("at")) or time.time(), triage.get("digest_interval_minutes", 60))   # #406
    if cadence:
        lines.append("      triage     " + cadence)
    if "cost" in triage:   # #349: what the digests cost the Chief of Staff to read, per day
        lines.extend(triage_digest.cost_lines(triage["cost"], str(triage.get("at") or "")[:10]) if triage["cost"]
                     else ["      triage     cost per day: not recorded (nothing delivered yet)"])
    return lines


class TriageFacts:
    """The triage's pending facts for the Chief of Staff (the batched findings and the daily summary), one per Chief of
    Staff that runs; kept until delivered, then they age out of the triage's memory."""

    __name__ = "triage_facts"

    def __init__(self):
        self.engine = None

    def bind(self, engine):
        self.engine = engine

    def __call__(self):
        engine = self.engine
        state = getattr(engine, "triage", None) if engine else None
        discovery = getattr(engine, "discovery", None) if engine else None
        if not state or not state.facts or discovery is None or discovery.problems:
            return []
        chiefs = sorted(n for n, o in discovery.agents.items() if (o.fleet or {}).get("role") == "chief-of-staff")
        return [Fact(key, name, "triage", summary, created, sender="switchboard")
                for key, (summary, created) in sorted(state.facts.items()) for name in chiefs]


# ---- the daily friction wake (docs/switchboard.md, "Self-wakes"). Off unless `friction_wake.enabled`; like
# `external_decisions` the key is absent from DEFAULTS, so a config that never names it is exactly what it was.

FRICTION_TEXT = ("Daily friction check (one short answer): what slowed you or your coders down in the last day? "
                 "If anything is worth fixing, send %(to)s a one-paragraph proposal: "
                 "fleet-switchboard send %(to)s --issue <n> \"<proposal>\". "
                 "If nothing, do nothing and say nothing.")
FRICTION_DEFAULTS = {"enabled": False, "hour": 9, "to": "cos", "cos_to": "improver", "text": None}
FRICTION_STATE = "friction-wake.json"
FRICTION_GRACE = 4 * 3600   # a slot is asked for at most this long after it began: a wake at 09:00, never at 15:00


def validate_friction_config(config, source):
    """`friction_wake`: absent or null is off. `hour` is 0-23 in the daemon's local time, or null for every 24 h
    from the first wake; `to` is the agent an orchestrator's proposal goes to; `cos_to` the agent the Chief of Staff's
    goes to; `text` null is the default text."""
    if "friction_wake" not in config:
        return
    raw = config["friction_wake"]
    if raw is None:
        raw = {}
    if not isinstance(raw, dict):
        raise ConfigError("%s: 'friction_wake' must be an object, got %r" % (source, type(raw).__name__))
    unknown = sorted(set(raw) - set(FRICTION_DEFAULTS))
    if unknown:
        warn_unknown_config("%s: 'friction_wake' has key(s) this tool does not read: %s" % (source, ", ".join(unknown)), 'friction_wake', unknown, list(FRICTION_DEFAULTS))
    section = dict(FRICTION_DEFAULTS, **raw)
    where = "%s: 'friction_wake" % source
    if not isinstance(section["enabled"], bool):
        raise ConfigError("%s.enabled' must be true or false, got %r" % (where, section["enabled"]))
    hour = section["hour"]
    if hour is not None and (not isinstance(hour, int) or isinstance(hour, bool) or not 0 <= hour <= 23):
        raise ConfigError("%s.hour' must be a whole hour 0-23 (the daemon's local time), or null for every 24 h "
                          "from the first wake, got %r" % (where, hour))
    if not isinstance(section["to"], str) or not NAME_RE.match(section["to"]):
        raise ConfigError("%s.to' must be a fleet agent name, got %r" % (where, section["to"]))
    if not isinstance(section["cos_to"], str) or not NAME_RE.match(section["cos_to"]):
        raise ConfigError("%s.cos_to' must be a fleet agent name, got %r" % (where, section["cos_to"]))
    text = section["text"]
    if text is not None and (not isinstance(text, str) or not text.strip() or len(text) > 1000):
        raise ConfigError("%s.text' must be a non-empty string of at most 1000 characters, or null, got %r"
                          % (where, text))
    config["friction_wake"] = section


def friction_slot(now, hour, anchor):
    """The start (epoch seconds) of the newest wake slot at or before `now`: the last `hour`:00 in the daemon's
    local time, or, with no hour, the newest 24 h step from `anchor`."""
    if hour is None:
        return anchor + int((now - anchor) // 86400) * 86400
    moment = datetime.fromtimestamp(now).replace(hour=hour, minute=0, second=0, microsecond=0)
    if moment.timestamp() > now:
        moment = datetime.fromtimestamp(now - 86400).replace(hour=hour, minute=0, second=0, microsecond=0)
    return moment.timestamp()


def read_friction_state(state_dir):
    """{name: {"anchor", "done"}}. Disposable: a file that is missing or unreadable is an empty one."""
    try:
        raw = json.loads((Path(state_dir) / FRICTION_STATE).read_text())
    except (OSError, ValueError):
        return {}
    return {k: v for k, v in raw.items() if isinstance(v, dict)} if isinstance(raw, dict) else {}


def write_friction_state(state_dir, found):
    path = Path(state_dir) / FRICTION_STATE
    temp = path.with_name("%s.%d.tmp" % (FRICTION_STATE, os.getpid()))
    fd = os.open(str(temp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as handle:
        json.dump(found, handle, indent=1, sort_keys=True)
        handle.write("\n")
    os.replace(str(temp), str(path))


def friction_tick(engine, discovery):
    """The end of a pass: an orchestrator (or the Chief of Staff, whose proposals go to `cos_to`) whose slot has begun and has not been asked gets ONE reminder (the
    ordinary kind, delivered by the next pass by the ordinary rule). Nothing is read from v2 and nothing is written
    unless someone is due; `friction-wake.json` records the slot asked, so a restart or a later pass makes no second
    one. An orchestrator a person has engaged with, or that is blocked or held, is skipped for now (asked again
    until the slot is FRICTION_GRACE old). Returns [(name, slot)]."""
    section = engine.config.get("friction_wake") or {}
    if not section.get("enabled") or discovery is None or engine.state_dir is None:
        return []
    now, state, asked, changed = engine.now(), read_friction_state(engine.state_dir), [], False
    text = section["text"] or FRICTION_TEXT % {"to": section["to"]}
    for name, seen in sorted(discovery.agents.items()):
        role = (seen.fleet or {}).get("role")
        if role == "chief-of-staff":  # its own proposals go to `cos_to`; its slot has a key of its own
            if name == section["cos_to"]:
                continue
            key, wake_text = "cos:" + name, FRICTION_TEXT % {"to": section["cos_to"]}
        elif role == "orchestrator" and name != section["to"]:
            key, wake_text = name, text
        else:
            continue
        mine = state.get(key, {})
        anchor = mine.get("anchor") if _is_number(mine.get("anchor")) else None
        if section["hour"] is None and anchor is None:
            anchor, changed = int(now), True
            state[key] = mine = dict(mine, anchor=anchor)
        slot = friction_slot(now, section["hour"], anchor)
        if slot <= (mine.get("done") if _is_number(mine.get("done")) else 0) or now - slot >= FRICTION_GRACE:
            continue
        if hold_reason(seen) or seen.engaged(now, engine.engaged_seconds):
            continue
        add_reminder(engine.state_dir, name, now, now, wake_text)
        state[key] = dict(mine, done=slot)
        asked.append((name, slot))
        changed = True
        if engine.audit is not None:
            engine.audit.append(engine.actor, "friction.wake", name, {"slot": iso(slot)})
        write_friction_state(engine.state_dir, state)  # after each one: a crash repeats at most one
    if changed:
        write_friction_state(engine.state_dir, state)
    return asked


def friction_status_line(config, state_dir, now=None):
    """The `status` line for the daily friction wake, or None when the config cannot be read."""
    section = (config or {}).get("friction_wake")
    if not section or not section.get("enabled"):
        return "friction wake: off"
    hour = section["hour"]
    slots = [v.get("done") for v in read_friction_state(state_dir).values() if _is_number(v.get("done"))]
    last = iso(max(slots)) if slots else "none yet"
    return "friction wake: on, %s to %s; cos to %s; last slot %s" % (
        "%02d:00" % hour if hour is not None else "every 24 h", section["to"], section["cos_to"], last)


# ---- the audited resume (docs/switchboard.md, "A blocked agent is reported"). ONE function resumes an agent whose turn has ended: the
# `resume` command and the blocked-report pass both call `resume_ended_turn`, so the refusals, the rate limit and the audit line are the same.

RESUME_STATE = "resumes.json"   # {agent: {"at": epoch}}: the last resume of each agent (the rate limit; an ordinary state row)
RESUME_SECONDS = 600            # one resume per agent per 10 minutes
RESUME_TEXT = "Your last turn ended without a finished answer (for example a provider error). Carry on from where you stopped."
RESUME_REASON = "its turn ended and nothing is open"
RESUME_COMMAND = PROG + " resume"   # the one spelling the report, the documentation, the help and the owner's grant use
PROVIDER_ERROR = re.compile(r"\b499\b|ECONNRESET|time(?:d)?[ -]?out", re.I)


class ResumeRefused(Exception):
    """The resume was not sent: the reason is the message, and nothing was written."""


def last_turn_error(engine, session_id):
    """The error text of the session's newest message, or "" (none, or it could not be read)."""
    try:
        newest = (engine.v2.message_list(session_id, limit=1, order="desc") or [None])[0]
    except Exception:
        return ""
    error = (newest.get("error") or (newest.get("info") or {}).get("error")) if isinstance(newest, dict) else None
    return _one_line(json.dumps(error) if not isinstance(error, str) else error, 300) if error else ""


def resume_ended_turn(engine, caller, name, reason, discovery=None):
    """Send the resume text to `name`'s session, only when its turn has ended and nothing is open. Raises ResumeRefused (nothing sent, nothing
    audited) for a missing or unreadable agent, a working session, an open permission request or question (that goes to the owner), and an agent
    resumed less than RESUME_SECONDS ago. Otherwise one `resume` audit line (who, whom, why) and the send; returns the message id."""
    caller, reason = blocked_sender(caller), _one_line(reason or RESUME_REASON, 200)
    now = engine.now()
    discovery = discovery if discovery is not None else engine.discover(now)
    seen = discovery.agents.get(name)
    if seen is None:
        raise ResumeRefused(discovery.missing(name))
    seen, why = engine.reobserve(seen, now)   # a read before a write
    if seen is None:
        raise ResumeRefused(why)
    if seen.conflict or seen.problem:
        raise ResumeRefused(seen.problem or "%s is claimed by more than one session" % name)
    if seen.status == "working":
        raise ResumeRefused("%s is working: nothing is sent to a session that is working" % name)
    if seen.status not in ("idle", "blocked", "working"):
        raise ResumeRefused("%s has status %s in herdr: only an ended turn is resumed" % (name, seen.status))
    try:
        opened = [("permission request", engine.v2.permission_list(seen.session_id)), ("question", engine.v2.form_list(seen.session_id))]
    except V2Error as err:
        raise ResumeRefused("v2 unreachable, so an open request cannot be ruled out: %s" % _one_line(str(err), 120)) from None
    kinds = [kind for kind, found in opened if found]
    if kinds:
        raise ResumeRefused("%s has an open %s: that goes to the owner, nothing is sent" % (name, " and an open ".join(kinds)))
    taken = {}

    def take(state):   # the rate record, under the lock: a second resume inside the window finds this one
        last = state.get(name, {}).get("at")
        taken["last"] = last
        if _is_number(last) and now - last < RESUME_SECONDS:
            return None
        state[name] = {"at": now}
        taken["ok"] = True
        return state
    blocked_update(engine.state_dir, RESUME_STATE, take)
    if not taken.get("ok"):
        raise ResumeRefused("%s was resumed %d minutes ago: one resume per agent per %d minutes" % (name, int((now - taken["last"]) // 60), RESUME_SECONDS // 60))
    keys = ["resume:%d" % now]
    message_id = derive_message_id(seen.session_id, keys)
    try:
        engine.v2.synthetic(seen.session_id, RESUME_TEXT, {"fleet": {"keys": keys, "from": "switchboard"}}, True, "queue", message_id,
                            "Resume: your turn ended, carry on")
    except Exception:
        blocked_update(engine.state_dir, RESUME_STATE, lambda s: dict(s, **{name: {"at": taken["last"]}}) if _is_number(taken["last"]) else {k: v for k, v in s.items() if k != name})
        raise
    engine.reads.forget(seen.session_id)
    if engine.audit is not None:
        engine.audit.append(engine.actor, "resume", name, {"by": caller, "reason": reason, "session": seen.session_id, "message_id": message_id})
    return message_id


def resume_first_recovery(engine, discovery, seen, reported):
    """The automatic first recovery of the blocked report: a stop whose turn error holds HTTP 499, ECONNRESET or a timeout is resumed once,
    through `resume_ended_turn` (the same refusals, rate limit and audit line), before it is reported. True when it was resumed; never raises."""
    try:
        error = last_turn_error(engine, seen.session_id) if reported is None else ""
        found = PROVIDER_ERROR.search(error)
        if not found:
            return False
        resume_ended_turn(engine, "switchboard", seen.name, "the blocked report found a provider error (%s) after an ended turn" % found.group(0), discovery)
        return True
    except Exception:
        return False


def ended_turn_text(name, resumed):
    """What the blocked report says of an ended turn with nothing open: the real command, or that it was just resumed."""
    if resumed:
        return ("an ended turn after a provider error: the switchboard resumed it once just now (`%s %s`, audited); "
                "a second stop within %d minutes is reported as usual" % (RESUME_COMMAND, name, RESUME_SECONDS // 60))
    return ("an ended turn with nothing open (the terminal shows it blocked, often after a provider error; not a real question): "
            "the Chief of Staff may resume it with `%s %s`, which is audited and sends nothing while it works or has anything open" % (RESUME_COMMAND, name))


# ---- a long block is reported (docs/switchboard.md, "A blocked agent is reported"). `hold_reason` holds a message for an agent
# the terminal shows as blocked: nothing is typed into a prompt, and that is right. The missing part was the report. Once per
# block (repeated at most every `repeat_minutes`, closed with one final line) its boss and the Chief of Staff are told. It reads
# only what the pass already has (the observations, the held plans, the requests WorkerFacts read, reminders.json): no `gh` call.

BLOCKED_ALERT_DEFAULTS = {"minutes": 20, "repeat_minutes": 60}
BLOCKED_ALERT_STATE = "blocked-alert.json"


def validate_blocked_alert_config(config, source):
    """`blocked_alert`: absent or null is the defaults (on); false is off; else {"minutes", "repeat_minutes"}, numbers above 0."""
    if "blocked_alert" not in config or config["blocked_alert"] is None:
        return
    raw = config["blocked_alert"]
    if raw is False:
        return
    if not isinstance(raw, dict):
        raise ConfigError("%s: 'blocked_alert' must be false, null or an object, got %r" % (source, type(raw).__name__))
    unknown = sorted(set(raw) - set(BLOCKED_ALERT_DEFAULTS))
    if unknown:
        warn_unknown_config("%s: 'blocked_alert' has key(s) this tool does not read: %s" % (source, ", ".join(unknown)), 'blocked_alert', unknown, list(BLOCKED_ALERT_DEFAULTS))
    section = dict(BLOCKED_ALERT_DEFAULTS, **raw)
    for key in BLOCKED_ALERT_DEFAULTS:
        if not _is_number(section[key]) or section[key] <= 0:
            raise ConfigError("%s: 'blocked_alert.%s' must be a number of minutes above 0, got %r" % (source, key, section[key]))
    config["blocked_alert"] = section


def blocked_alert_section(config):
    """The settings, or None when the alert is off."""
    raw = (config or {}).get("blocked_alert", {})
    if raw is False:
        return None
    return dict(BLOCKED_ALERT_DEFAULTS, **(raw or {}))


def blocked_kind(engine, observation, resumed=False):
    """What a blocked agent waits on, in words, as the pass read it: an open permission request or question, or (nothing open) an ended turn."""
    source = next((s for s in engine.sources if isinstance(s, WorkerFacts)), None)
    if source is None:
        return "a permission request or a question (not read)"
    kinds = sorted({kind for who, kind, _ in source.requests if who.session_id == observation.session_id})
    if kinds:
        return "an open %s; it goes to the owner" % " and an open ".join("%s request" % k if k == "permission" else k for k in kinds)
    return ended_turn_text(observation.name, resumed)


BLOCKED_HELD_SENDS = "blocked-held-sends.json"   # {agent: {"rows": [{"from", "at"}]}}: sends refused while it was blocked (a `send` stores nothing, so the report counts them here)
BLOCKED_LOCK = "blocked-alert.lock"
BLOCKED_HELD_KEEP = 100      # rows kept per agent: the recorded case held 11 messages in 2.5 hours, so this is about nine times that
BLOCKED_HELD_AGENTS = 64     # agents kept in the file: the number blocked at once in a fleet is a handful; 64 is far above any real fleet
BLOCKED_LINE_SENDERS = 10    # senders named in a line, then "and N more"
BLOCKED_LINE_REMINDERS = 5   # reminders named in a line, then "and N more"
BLOCKED_LINE_CHARS = 1200    # the whole line


@contextmanager
def blocked_lock(state_dir):
    """Serialises the `send` command and the daemon around every read-modify-write of blocked-alert.json and blocked-held-sends.json."""
    fd = os.open(str(Path(state_dir) / BLOCKED_LOCK), os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)


def blocked_update(state_dir, name, change):
    """The one write path of the two state files: read, `change(state)` and write, under `blocked_lock`, through the atomic `_write_small`.
    `change` returns the new state, or None to write nothing. Returns the state as it was written (or read)."""
    with blocked_lock(state_dir):
        state = _read_small(state_dir, name)
        new = change(state)
        if new is None:
            return state
        _write_small(state_dir, name, new)
        return new


def note_held_send(state_dir, recipient, sender, now, observation):
    """A `send` held for a blocked agent is remembered (who, when) so a long block can name it. Never raises: the delivery path is not its
    business, and the hold itself is audited (`hold`), so a row lost to a full disk costs the count, not the message's record."""
    if state_dir is None or observation is None or observation.status != "blocked" or hold_reason(observation) is None:
        return

    def add(state):
        entry = state.get(recipient)
        rows = [r for r in (entry.get("rows") if isinstance(entry, dict) else None) or [] if isinstance(r, dict)]
        state[recipient] = {"rows": (rows + [{"from": blocked_sender(sender), "at": now}])[-BLOCKED_HELD_KEEP:]}
        if len(state) > BLOCKED_HELD_AGENTS:   # the oldest agents' rows go first
            newest = sorted(state, key=lambda n: max([r.get("at", 0) for r in state[n].get("rows", []) if _is_number(r.get("at"))] or [0]), reverse=True)
            state = {n: state[n] for n in newest[:BLOCKED_HELD_AGENTS]}
        return state
    try:
        blocked_update(state_dir, BLOCKED_HELD_SENDS, add)
    except OSError:
        pass


def _named(items, limit):
    shown = list(items)[:limit]
    return ", ".join(shown) + (" and %d more" % (len(items) - limit) if len(items) > limit else "")


def blocked_sender(who):
    """The one gate for a sender name that a caller claimed: the daemon's own agent-name pattern (NAME_RE, full match, so a trailing newline fails), else "unknown".
    Every name in the report line, the end line, the reminder, the audit and the state file passes through it."""
    return who if isinstance(who, str) and NAME_RE.fullmatch(who) else "unknown"


def _sender_names(who):
    return sorted({blocked_sender(w) for w in who})


def blocked_line(engine, observation, since, now, held, refused, kind):
    """`held` is one sender per message the daemon holds (delivered when the block ends); `refused` one sender per send that was refused
    and stored nowhere (the sender must send again). The two are said apart."""
    minutes = int((now - since) // 60)
    reminders = [r for r in read_reminders(engine.state_dir) if r.get("to") == observation.name and r.get("from") == observation.name
                 and isinstance(r.get("at"), (int, float)) and since <= r["at"] <= now]
    text = "%s has been blocked for %d minutes (first seen blocked at %s) on %s." % (observation.name, minutes, iso(since), kind)
    if held or not refused:
        text += " Held for it: %d message%s from %s." % (len(held), "" if len(held) == 1 else "s", _named(_sender_names(held), BLOCKED_LINE_SENDERS) or "nobody")
    if refused:
        text += " %d refused send%s the senders must repeat (not stored; ask %s)." % (len(refused), "" if len(refused) == 1 else "s", _named(_sender_names(refused), BLOCKED_LINE_SENDERS))
    if reminders:
        text += " Its own reminders due during the block: %s." % _named(["%s due %s" % (r["id"], iso(r["at"])) for r in reminders], BLOCKED_LINE_REMINDERS)
    return _one_line(text, BLOCKED_LINE_CHARS)


def _refused_senders(entry):
    rows = entry.get("rows") if isinstance(entry, dict) else None
    return [blocked_sender(r.get("from")) for r in (rows if isinstance(rows, list) else [])[-BLOCKED_HELD_KEEP:] if isinstance(r, dict)]


def blocked_tick(engine, discovery, held):
    """The end of a pass, after delivery: report a block that has lasted `minutes` with a message held for the agent, once, then at most
    every `repeat_minutes`; one final line when it ends. Returns [(agent, "report" | "repeat" | "end")]."""
    section = blocked_alert_section(engine.config)
    if section is None or discovery is None or engine.state_dir is None:
        return []
    now, state, done = engine.now(), blocked_update(engine.state_dir, BLOCKED_ALERT_STATE, lambda _: None), []
    waiting = {n for n, o in discovery.agents.items() if o.status == "blocked"}
    ended_refused = {}

    def forget(found):   # a send refused for an agent that is no longer blocked is forgotten, after the end line has named its senders
        if set(found) - waiting:
            ended_refused.update({n: v for n, v in found.items() if n not in waiting})
            return {n: v for n, v in found.items() if n in waiting}
        return None
    refused = blocked_update(engine.state_dir, BLOCKED_HELD_SENDS, forget)
    cos = next((n for n, o in sorted(discovery.agents.items()) if (o.fleet or {}).get("role") == "chief-of-staff"), None)

    def tell(observation, text, event, detail):
        boss = boss_name(discovery, observation)
        boss_seen = discovery.agents.get(boss) if boss else None
        recipients = []
        if boss and boss_seen is not None and not hold_reason(boss_seen):
            recipients.append(boss)   # a boss that is itself blocked or gone is not told: the Chief of Staff alone is
        if cos and cos not in recipients:
            recipients.append(cos)
        recipients = [r for r in recipients if r != observation.name]
        for who in recipients:
            add_reminder(engine.state_dir, who, now, now, "Blocked agent: " + text)
        if engine.audit is not None:
            engine.audit.append(engine.actor, event, observation.name, dict(detail, told=recipients, text=_one_line(text, 400)))

    changed = False
    for name, seen in sorted(discovery.agents.items()):
        entry = state.get(name)
        if seen.status != "blocked":
            continue
        if not isinstance(entry, dict) or entry.get("session") != seen.session_id or not _is_number(entry.get("since")):
            entry = state[name] = {"session": seen.session_id, "since": now}
            changed = True
        plan = held.get(name)
        messages = [blocked_sender(fact.sender) for fact in (plan.pending if plan is not None else [])]
        refusals = _refused_senders(refused.get(name))
        entry["held"], entry["refused"] = len(messages), len(refusals)   # what the end line may say: the daemon's messages arrive, the refused ones never do
        if not messages and not refusals:
            continue
        last = entry.get("reported")
        if last is None and now - entry["since"] >= section["minutes"] * 60:
            event = "blocked.report"
        elif last is not None and now - last >= section["repeat_minutes"] * 60:
            event = "blocked.repeat"
        else:
            continue
        kind = blocked_kind(engine, seen, resume_first_recovery(engine, discovery, seen, last))
        tell(seen, blocked_line(engine, seen, entry["since"], now, messages, refusals, kind),
             event, {"since": iso(entry["since"]), "held": len(messages), "refused": len(refusals)})
        entry["reported"] = now
        blocked_update(engine.state_dir, BLOCKED_ALERT_STATE, lambda _: state)   # after each one: a crash repeats at most one
        done.append((name, event.split(".")[1]))
    for name in sorted(set(state) - waiting):
        entry = state.pop(name)   # the block ended, or the agent is gone
        changed = True
        if not isinstance(entry, dict) or entry.get("reported") is None:
            continue
        seen = discovery.agents.get(name)
        if seen is None:
            continue   # gone from the fleet: nobody to say it about
        refusals = _refused_senders(ended_refused.get(name))
        had_held = bool(entry.get("held")) or (name in held and bool(held[name].pending))
        still = name in held and bool(held[name].pending)
        released = had_held and not still   # what is known is only that the daemon holds them no longer: not that a delivery happened
        parts = []
        if still:
            parts.append("its messages are still held: %s" % _one_line(held[name].reason, 200))
        elif had_held:
            parts.append("the messages the daemon held for it are no longer held")
        if refusals:
            parts.append("%d refused send%s never stored and NOT delivered: ask %s to send again" % (
                len(refusals), "" if len(refusals) == 1 else "s", _named(_sender_names(refusals), BLOCKED_LINE_SENDERS)))
        text = "%s was blocked from %s to %s (%d minutes); the block has ended%s." % (
            name, iso(entry["since"]), iso(now), int((now - entry["since"]) // 60), (" and " + "; ".join(parts)) if parts else "")
        tell(seen, text, "blocked.end", {"since": iso(entry["since"]), "no_longer_held": released, "refused": len(refusals)})
        done.append((name, "end"))
    if changed or done:
        blocked_update(engine.state_dir, BLOCKED_ALERT_STATE, lambda _: state)
    return done


# ---- reminders

def parse_when(text, now):
    """`30m`, `+2h`, `1d` (from now), or an ISO-8601 time with an offset or `Z`. Epoch seconds."""
    match = re.fullmatch(r"\+?([0-9]+)([smhd])", text.strip())
    if match:
        return now + int(match.group(1)) * REMINDER_UNITS[match.group(2)]
    try:
        moment = datetime.fromisoformat(text.strip().replace("Z", "+00:00"))
    except ValueError:
        raise ReminderError("when must be a delay such as 30m, 2h or 1d, or an ISO time with a zone "
                            "such as 2030-01-02T09:00:00Z, got %r" % text) from None
    if moment.tzinfo is None:
        raise ReminderError("when %r has no time zone; add Z or an offset" % text)
    return moment.timestamp()


class ReminderError(FactError):
    """reminders.json cannot be read or written, or a reminder cannot be made."""


@contextmanager
def reminders_lock(state_dir):
    """Serialises the CLI and the daemon around the read-modify-write of reminders.json."""
    fd = os.open(str(Path(state_dir) / REMINDER_LOCK), os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)


def read_reminders(state_dir):
    path = Path(state_dir) / REMINDERS
    try:
        raw = json.loads(path.read_text())
    except FileNotFoundError:
        return []
    except (OSError, ValueError) as err:
        raise ReminderError("cannot read %s: %s" % (path, err)) from None
    items = raw.get("reminders") if isinstance(raw, dict) else None
    if not isinstance(items, list):
        raise ReminderError("%s must hold {\"reminders\": [...]}" % path)
    for item in items:
        if not (isinstance(item, dict) and isinstance(item.get("id"), str) and isinstance(item.get("to"), str)
                and _is_number(item.get("at")) and isinstance(item.get("text"), str)):
            raise ReminderError("%s has a reminder without id, to, at and text: %r" % (path, item))
        if item.get("condition") is not None and not isinstance(item["condition"], dict):
            raise ReminderError("%s has a reminder whose condition is not an object: %r" % (path, item))
    return items


def write_reminders(state_dir, items):
    """Replace reminders.json atomically, mode 0600: a crash leaves the old file or the new one."""
    path = Path(state_dir) / REMINDERS
    temp = path.with_name("%s.%d.tmp" % (REMINDERS, os.getpid()))
    fd = os.open(str(temp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        with os.fdopen(fd, "w") as handle:
            json.dump({"reminders": items}, handle, indent=1, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(str(temp), str(path))
    except BaseException:
        try:
            os.unlink(str(temp))
        except OSError:
            pass
        raise


def add_reminder(state_dir, to, at, created, text, issue=None, sender=None, repo=None, condition=None):
    if not isinstance(to, str) or not to.strip():
        raise ReminderError("a reminder needs the name of the agent it is for")
    if not text.strip():
        raise ReminderError("a reminder needs text")
    item = {"id": uuid.uuid4().hex[:12], "to": to, "at": float(at), "created": float(created),
            "text": text, "issue": issue, "from": sender}
    if repo:
        item["repo"] = repo  # PR 15: the repo `issue` is in
    if condition:
        item["condition"] = dict(condition)  # checked when it is due: {"unless_report_from", "since"} or {"while_running"}
    with reminders_lock(state_dir):
        write_reminders(state_dir, read_reminders(state_dir) + [item])
    return item


def remove_reminders(state_dir, ids):
    """Drop these ids from reminders.json. Returns the ids that were there."""
    with reminders_lock(state_dir):
        items = read_reminders(state_dir)
        gone = [item["id"] for item in items if item["id"] in ids]
        if gone:
            write_reminders(state_dir, [item for item in items if item["id"] not in ids])
    return gone


def found_reason(why):
    return "merged" if why.endswith(" is merged") else "closed"


class ReminderFacts:
    """`reminder:<id>` facts for reminders that are due. A reminder not yet due is no fact.

    A due reminder skips the batch window: it is one event at an exact time.
    It stays in the file until its key shows in the recipient's transcript or
    inbox (prune_delivered_reminders), so a crash before delivery loses nothing.
    """

    __name__ = "reminder_facts"

    def __init__(self, state_dir):
        self.state_dir, self.engine = Path(state_dir), None

    def bind(self, engine):
        self.engine = engine

    def due(self):
        now = self.engine.now() if self.engine else time.time()
        return [item for item in read_reminders(self.state_dir) if item["at"] <= now]

    def until_holds(self, condition):
        """A reminder's cancel condition (`until_closed` an issue, `until_merged` a pull request, each `owner/repo#N`):
        the reason it is moot, or None (not met, or cannot be read now: the reminder stays)."""
        for key, kind in (("until_closed", "issue"), ("until_merged", "pr")):
            ref = condition.get(key)
            match = re.fullmatch(r"([\w.-]+/[\w.-]+)#([0-9]+)", ref) if isinstance(ref, str) else None
            if match is None or self.engine is None:
                continue
            try:
                state = read_ref_state(self.engine, match.group(1), int(match.group(2)), kind)
            except (NoticeError, OSError, ValueError):
                continue
            if (key == "until_closed" and state in ("closed", "merged")) or (key == "until_merged" and state == "merged"):
                return "%s is %s" % (ref, state)
        return None

    def last_report(self, worker, boss=None):
        """When `worker` last made a report (to anyone) or sent a message to `boss` (epoch seconds, from `last-reports.json`), or None. A time in the
        future is no sign of life: a damaged or forged record cannot silence the wake for good."""
        try:
            entry = _read_small(self.state_dir, LAST_REPORT_FILE).get(worker, {})
            sends = entry.get("send_to") if isinstance(entry.get("send_to"), dict) else {}
            times = [entry.get("at"), sends.get(boss) if isinstance(boss, str) else None]
        except (OSError, AttributeError):
            return None
        now = self.engine.now() if self.engine else time.time()
        times = [float(t) for t in times if _is_number(t) and t <= now + 60]
        return max(times) if times else None

    def overdue_text(self, item):
        """The wake's text with the fact the boss needs: when the worker last reported, or that it has not since the launch."""
        worker, since = item["condition"].get("unless_report_from"), item["condition"].get("since", 0)
        last = self.last_report(worker, item["to"]) if isinstance(worker, str) else None
        if last is None:
            tail = "no report from %s since launch" % _plain(worker, 60)
        else:
            tail = "last report from %s %s ago%s" % (_plain(worker, 60), _age_text(max(0, int(self.engine.now() - last))), "" if not _is_number(since) or last >= since else " (before this launch)")
        return "%s (%s)" % (item["text"], tail)

    def verdict(self, item):
        """For a due conditional reminder: None (cannot tell yet: it stays), "deliver", or the reason to drop it.
        One read of the boss's transcript and inbox, and only for a reminder that is due and has a condition."""
        condition, discovery = item["condition"], self.engine.discovery if self.engine else None
        moot = self.until_holds(condition)
        if moot:
            return moot  # a cancel condition holds: dropped (audited by the caller)
        if discovery is None:
            return None
        worker = condition.get("unless_report_from") or condition.get("while_running")
        if isinstance(worker, str) and worker not in discovery.agents:
            return "%s is gone" % worker if not discovery.problems else None
        if not isinstance(condition.get("unless_report_from"), str):
            return "deliver"
        boss, since = discovery.agents.get(item["to"]), condition.get("since", 0)
        if not _is_number(since):  # a forged or damaged condition is no condition: deliver, audited
            if self.engine is not None and self.engine.audit is not None:
                self.engine.audit.append(self.engine.actor, "reminder.condition_unusable", item["to"],
                                         {"id": item["id"]})
            return "deliver"
        last = self.last_report(worker, item["to"])
        if last is not None and last >= since:   # the durable record `report` writes for EVERY report (a rider, a direct one, to any boss): it needs no read of the boss's transcript, which v2_light never makes and a delivered rider no longer shows
            return "%s reported to its boss since the launch (%s ago)" % (worker, _age_text(max(0, int(self.engine.now() - last))))
        if boss is None:
            return None
        try:
            lines = synthetic_lines(self.engine, boss.session_id, since, waiting=True)
            riders = read_report_riders(self.state_dir)
        except (V2Error, ReminderError):
            return None
        for _, _, _, line in lines:
            match = REPORT_LINE.match(line) or SEND_LINE.match(line)
            if match and match.group(1) == worker:
                return "%s reported to %s since the launch" % (worker, item["to"])
        if any(r.get("from") == worker and r["to"] == item["to"] and r["created"] >= since for r in riders):
            return "%s reported to %s since the launch" % (worker, item["to"])
        return "deliver"

    def notify_drop(self, item, why):
        """#1132: a reminder dropped because its issue closed or its pull request merged tells its setter ONCE. Called only by the caller
        that removed the reminder from the file (`gone` was non-empty), so a second sweep finds nothing to drop and sends nothing."""
        sender = item.get("from")
        match = re.search(r" is (closed|merged)$", why)
        if match is None or not isinstance(sender, str) or not sender.strip() or self.engine is None:
            return
        reason = "the pull request merged" if match.group(1) == "merged" else "the issue closed"
        text = "Reminder %s for %s was dropped, unsent: %s (%s). Its text: %s. Set it with --keep-if-closed to keep it." % (
            item["id"], item["to"], reason, why, item["text"])
        add_reminder(self.state_dir, sender, self.engine.now(), self.engine.now(), text)
        if self.engine.audit is not None:
            self.engine.audit.append(self.engine.actor, "reminder.drop_notice", sender, {"id": item["id"], "why": found_reason(why)})

    def __call__(self):
        facts = []
        for item in self.due():
            if item.get("condition"):
                found = self.verdict(item)
                if found is None:
                    continue
                if found != "deliver":
                    gone = remove_reminders(self.state_dir, {item["id"]})
                    if gone and self.engine is not None and self.engine.audit is not None:
                        self.engine.audit.append(self.engine.actor, "reminder.drop", item["to"],
                                                 {"id": item["id"], "why": found})
                    if gone:
                        self.notify_drop(item, found)
                    continue
            text = self.overdue_text(item) if isinstance(item.get("condition"), dict) and isinstance(item["condition"].get("unless_report_from"), str) and self.engine else item["text"]
            facts.append(Fact("reminder:" + item["id"], item["to"], "reminder", text, item["at"],
                              issue=item.get("issue"), batch=False, sender=item.get("from"), repo=item.get("repo")))
        return facts


def prune_delivered_reminders(engine, discovery):
    """Forget the due reminders whose key is already in their recipient's transcript or inbox."""
    source = next((s for s in engine.sources if isinstance(s, ReminderFacts)), None)
    if source is None:
        return []
    by_recipient = {}
    for item in source.due():
        by_recipient.setdefault(item["to"], []).append(item)
    delivered = []
    for name, items in sorted(by_recipient.items()):
        observation = discovery.agents.get(name)
        if observation is None:
            continue
        try:
            keys, _ = engine.delivered_keys(observation.session_id, min(i["at"] for i in items) - SINCE_SLACK)
        except V2Error:
            continue
        delivered += [item["id"] for item in items if "reminder:" + item["id"] in keys]
    gone = remove_reminders(source.state_dir, set(delivered)) if delivered else []
    if gone and engine.audit is not None:
        engine.audit.append(engine.actor, "reminder.prune", None, {"ids": gone})
    return gone


# ---- checkpoint reminders: a launch sets them from the brief's CHECKPOINT (docs/switchboard.md, "Self-wakes")

CHECKPOINT_WORKER_TEXT = "checkpoint due: report now, one line"
CHECKPOINT_OVERDUE_TEXT = "%s has not reported since launch: overdue checkpoint"
_CP_UNIT = r"(seconds?|secs?|minutes?|mins?|hours?|hrs?|[smh])?"
_CP_UNITS = {"s": 1, "m": 60, "h": 3600}
CHECKPOINT_MAX_SECONDS = 30 * 86400  # a checkpoint or overdue further out than this is refused, never an error
CHECKPOINT_MAX_DIGITS = 6


def how_long(seconds):
    """A length of time as words, exact to the second: `15 min`, `1 min 30 s`, `2 h 5 min`, `1 d 2 h`. Never rounds: the line a lane reads must be the stored time."""
    seconds = int(round(abs(seconds)))
    parts = []
    for unit, size in (("d", 86400), ("h", 3600), ("min", 60), ("s", 1)):
        count, seconds = divmod(seconds, size)
        if count:
            parts.append("%d %s" % (count, unit))
    return " ".join(parts) if parts else "0 s"


def reminder_when(at, now):
    """The words the three routes print for one reminder, built from the STORED time and the same `now`: `in 15 min, at 2030-01-02T15:05:05Z` (or `15 min ago`)."""
    return ("in %s" % how_long(at - now) if at >= now else "%s ago" % how_long(now - at)) + ", at %s" % iso(at)


def _print_when_now(now):
    try:
        return iso(now)
    except Exception:
        return str(now)


def _print_when(at, now):
    """`reminder_when`, but the printing never fails a command: a reminder that was made still exits 0 (the plain clock time is the fallback)."""
    try:
        return reminder_when(at, now)
    except Exception:
        return "at %s" % at


def _cp_when(text, moment):
    """parse_when for a checkpoint flag, bounded: too many digits or further than CHECKPOINT_MAX_SECONDS is refused."""
    if re.search(r"[0-9]{%d}" % (CHECKPOINT_MAX_DIGITS + 1), text):
        raise ReminderError("%r is too large; a checkpoint is at most 30 days out" % text[:40])
    at = parse_when(text, moment)
    if not moment - CHECKPOINT_MAX_SECONDS <= at <= moment + CHECKPOINT_MAX_SECONDS:
        raise ReminderError("%r is too far out; a checkpoint is at most 30 days away" % text[:40])
    return at


def _cp_seconds(number, unit, default):
    unit = (unit or default or "")[:1].lower()
    return int(number) * _CP_UNITS[unit] if unit in _CP_UNITS else None


def parse_checkpoint(brief):
    """(checkpoint seconds, overdue seconds) from the brief's CHECKPOINT line, or None. Best effort and never an
    error: 'Report at 30 minutes ...; overdue at 60', 'in 20m, overdue 45m'. A bare overdue number takes the
    unit of the checkpoint; no unit anywhere, a missing part, or an overdue that is not later = None."""
    line = next((l for l in (brief or "").splitlines() if re.match(r"\s*CHECKPOINT\s*:", l, re.I)), None)
    if line is None:
        return None
    over = re.search(r"\boverdue(?:\s+(?:at|after|in|by))?\s+(\d{1,6})\s*" + _CP_UNIT + r"\b", line, re.I)
    if over is None:
        return None
    head = line[:over.start()]
    first = re.search(r"\b(?:at|in|after|within)\s+(\d{1,6})\s*" + _CP_UNIT + r"\b", head, re.I)
    if first is None:
        return None
    checkpoint = _cp_seconds(first.group(1), first.group(2), over.group(2))
    overdue = _cp_seconds(over.group(1), over.group(2), first.group(2))
    if checkpoint is None or overdue is None or checkpoint <= 0 or overdue <= checkpoint:
        return None
    if overdue > CHECKPOINT_MAX_SECONDS:
        return None
    return checkpoint, overdue


def set_checkpoint_reminders(engine, state, name, boss, issue, repo, brief, checkpoint, overdue, launched, moment):
    """Make the launch's two reminders. `checkpoint`/`overdue` are --checkpoint/--overdue (delays or ISO times) or
    None; with neither, the brief's CHECKPOINT line is parsed. Returns one line for the launch output, or None.
    Never raises: the worker is already running."""
    try:
        notes = []
        if boss:  # #102: the overdue wake goes to the registered agent the role name chief-of-staff stands for
            try:
                boss = resolve_boss(engine.discover(engine.now()), boss)
            except Exception:
                pass  # the fleet cannot be read now: the name as given
        if checkpoint is None and overdue is None:
            parsed = parse_checkpoint(brief)
            if parsed is None:
                return ("no checkpoint reminders: no --checkpoint/--overdue and the brief's CHECKPOINT line could "
                        "not be read as 'at <N> minutes ... overdue at <M>'")
            checkpoint, overdue = ("%ds" % parsed[0], "%ds" % parsed[1])
        when_worker = _cp_when(checkpoint, moment) if checkpoint is not None else None
        when_boss = _cp_when(overdue, moment) if overdue is not None and boss else None  # both checked before either is made
        made = []
        if when_worker is not None:
            item = add_reminder(state, name, when_worker, moment, CHECKPOINT_WORKER_TEXT, issue, boss, repo,
                                condition={"while_running": name})
            made.append(("worker", item))
        if overdue is not None:
            if not boss:
                notes.append("no overdue reminder: the launch names no --reports-to")
            else:
                item = add_reminder(state, boss, when_boss, moment, CHECKPOINT_OVERDUE_TEXT % name, issue, name, repo,
                                    condition={"unless_report_from": name, "since": launched})
                made.append(("overdue", item))
        for which, item in made:
            engine.audit.append("cli", "reminder.add", item["to"], {"id": item["id"], "at": iso(item["at"]),
                                                                   "from": item.get("from"), "issue": issue,
                                                                   "repo": repo, "for": "checkpoint-" + which})
        notes[:0] = ["%s reminder %s" % (which, _print_when(item["at"], moment)) for which, item in made]
        return "checkpoint reminders (now %s): " % _print_when_now(moment) + "; ".join(notes) if notes else None
    except (ReminderError, OSError, ValueError, OverflowError) as err:
        return "no checkpoint reminders: %s" % _one_line(str(err), 200)


REMIND_LIST_MAX = 50   # reminders `remind --list` prints


def remind_manage(args, engine, state, sender, moment):
    """`remind --list` (the caller's own pending reminders: set by it or for it) and `remind --cancel <id>` (one of those, by id). Nothing else is
    shown or touched: another agent's reminder is not listed and is refused with the same words as an unknown id."""
    if args.list_mine and args.cancel:
        sys.stderr.write("%s: remind: give --list or --cancel, not both\n" % PROG)
        return EXIT_USAGE
    if args.name or args.when or args.text:
        sys.stderr.write("%s: remind: --list and --cancel take no recipient, time or text\n" % PROG)
        return EXIT_USAGE
    try:
        mine = [item for item in read_reminders(state) if sender in (item.get("to"), item.get("from"))]
    except ReminderError as err:
        sys.stderr.write("%s: remind: %s\n" % (PROG, _one_line(str(err), 200)))
        return EXIT_ERROR
    if args.list_mine:
        mine.sort(key=lambda item: item["at"])
        for item in mine[:REMIND_LIST_MAX]:
            print("%s  %s  to=%s  issue=%s  %s" % (item["id"], iso(item["at"]), item["to"], item.get("issue") or "-", _one_line(item["text"], 120)))
        if len(mine) > REMIND_LIST_MAX:
            print("(%d more not shown)" % (len(mine) - REMIND_LIST_MAX))
        if not mine:
            sys.stderr.write("%s: no pending reminders for %s\n" % (PROG, sender))
        return EXIT_OK
    if args.cancel not in {item["id"] for item in mine}:
        sys.stderr.write("%s: remind: no pending reminder %s of yours (see `%s remind --list`)\n" % (PROG, _one_line(args.cancel, 40), PROG))
        return EXIT_USAGE
    if not remove_reminders(state, {args.cancel}):   # delivered or cancelled between the read and the removal
        sys.stderr.write("%s: remind: reminder %s is already gone\n" % (PROG, _one_line(args.cancel, 40)))
        return EXIT_USAGE
    engine.audit.append("cli", "reminder.cancel", sender, {"id": args.cancel})
    print("cancelled %s" % args.cancel)
    return EXIT_OK


def cmd_remind(args, runner, now):
    engine, state, config = build_engine(runner, now, "cli")
    if args.sender is not None:
        if os.environ.get(LAB_ENV) != "1":
            sys.stderr.write("%s: --from is only for the Lab (%s=1); an agent is identified by its pane\n"
                             % (PROG, LAB_ENV))
            return EXIT_USAGE
        sender = args.sender
    else:
        sender = identify_caller(engine.herdr, engine.v2, os.environ)
    moment = now()
    if args.list_mine or args.cancel:
        return remind_manage(args, engine, state, sender, moment)
    if not args.name or not args.when or not args.text:
        sys.stderr.write("%s: remind needs <name> <when> <text> (or --list, or --cancel <id>)\n" % PROG)
        return EXIT_USAGE
    try:
        repo, number = resolve_for_sender(engine, config, args.issue, sender)
    except IssueRefError as err:
        sys.stderr.write("%s: %s\n" % (PROG, err))
        return EXIT_USAGE
    condition = {}
    for flag, key in ((args.until_closed, "until_closed"), (args.until_merged, "until_merged")):
        if flag:
            if not re.fullmatch(r"[\w.-]+/[\w.-]+#[0-9]+", flag):
                sys.stderr.write("%s: --until-closed/--until-merged take OWNER/REPO#N, got %r\n" % (PROG, flag[:60]))
                return EXIT_USAGE
            condition[key] = flag
    if number is not None and repo and not condition and not args.keep_if_closed:
        condition["until_closed"] = "%s#%d" % (repo, number)   # a reminder about an issue is moot once it is closed: dropped unsent (`--keep-if-closed` opts out)
    warning = None
    if number is not None and repo and not args.keep_if_closed:
        try:
            ref_state = read_ref_state(engine, repo, number, "issue")
        except Exception:   # the warning never fails a command
            ref_state = "open"   # unreadable: warned as open, never refused
        if ref_state in ("closed", "merged"):
            sys.stderr.write("%s: %s#%d is already closed; a reminder about a closed issue is dropped when it is due. "
                             "Use --keep-if-closed to keep it\n" % (PROG, repo, number))
            return EXIT_USAGE
        warning = ("%s: reminder is dropped if it closes (%s#%d closes or its pull request merges), with one notice to you; "
                   "use --keep-if-closed to keep it\n" % (PROG, repo, number))
    item = add_reminder(state, args.name, parse_when(args.when, moment), moment,
                        " ".join(args.text).strip(), number, sender, repo, condition=condition or None)
    engine.audit.append("cli", "reminder.add", args.name, {"id": item["id"], "at": iso(item["at"]),
                                                          "from": sender, "issue": number, "repo": repo})
    print(item["id"])
    sys.stderr.write("%s: reminder for %s %s (now %s)\n" % (PROG, args.name, _print_when(item["at"], moment), _print_when_now(moment)))
    if warning:
        sys.stderr.write(warning)
    return EXIT_OK


cmd_remind.ensure_on_use = True   # the daemon is alive when it runs


def add_budget_notice_parsers(sub):
    notice = sub.add_parser("budget-notice", help="Tell the orchestrator of the top spender that a GitHub account is low on budget (the gh shim runs this; at most once an hour per account)",
                            description="`budget-notice --account NAME`: when the account's fresh reading is below the low-budget line, names the agent that made the most agent-shell "
                                        "GitHub calls in the last hour to that agent's orchestrator (the Chief of Staff when it has none), in one message, at most once an hour per account. "
                                        "It takes only the account's name: the budget, the ranking and the text all come from the daemon's own records, so a call to it cannot invent "
                                        "a message. There is no per-agent cap: the shim only makes that agent's reads that are not answered from the cache wait a few seconds while the "
                                        "account is low.")
    notice.add_argument("--account", required=True, help="The gh account's name as `status` shows it")


def cmd_budget_notice(args, runner, now):
    """One message, only when the account is low, only once an hour per account, to the orchestrator of the top spender. Exit 0 whether or not a message went: the shim
    never waits on the answer, and a quiet account is not an error."""
    calls = load_module("agent_calls")
    state = ensure_state_dir()
    account = args.account
    moment = now()
    low = calls.low_budget(str(state), account, moment)
    top = calls.top_spender(str(state), account, moment) if low is not None else None
    if low is None or top is None:
        print("no message: %s is not below the low-budget line, or nobody spent on it in the last hour" % _one_line(account, 40))
        return EXIT_OK
    engine, state, _config = build_engine(runner, now, "cli")
    discovery = engine.discover(moment)
    if discovery is None or discovery.problems:
        print("no message: the agent list cannot be read")   # nothing was claimed: the next call tries again
        return EXIT_OK
    seen = discovery.agents.get(top[0])
    boss = boss_name(discovery, seen) if seen is not None else None
    chiefs = chiefs_of_staff(discovery)
    to = boss if boss in discovery.agents else (chiefs[0] if len(chiefs) == 1 else None)
    if to is None:
        print("no message: %s has no orchestrator or Chief of Staff to tell" % top[0])
        return EXIT_OK
    if not calls.claim_notice(str(state), account, moment):
        print("no message: one already went for this account in the last hour")
        return EXIT_OK
    text = calls.notice_text(_one_line(account, 40), low[0], low[1], top[0], top[1], top[2])
    try:
        item = add_reminder(state, to, moment, moment, text)
    except Exception:
        calls.release_notice(str(state), account)   # the hour was claimed and no message was made: give it back
        raise
    engine.audit.append("cli", "budget.notice", to, {"account": _one_line(account, 40), "agent": top[0], "id": item["id"]})
    print("told %s about %s" % (to, top[0]))
    return EXIT_OK


cmd_budget_notice.direct = True   # run by the gh shim: no daemon start, no error mapping


# ======================================================= GitHub events (PR 5)
#
# One section, self-contained. The pieces, in the order they are built:
#
#   config      `_validate_github`, called from validate_config
#   verify      `signature_matches`: HMAC-SHA256 of the raw body, constant time
#   items       webhook payloads and catch-up reads -> GitHubItem, with keys
#               made from GitHub object ids (never delivery ids)
#   hub         `GitHubHub`: the localhost listener, one supervised
#               `gh webhook forward` child per watched repo, the in-memory
#               queue the fact source drains, the catch-up read, routing
#   status      `github_status` / `format_github`
#
# Facts are not stored. Webhook arrivals wait in memory until the engine
# reports them delivered (or found in the recipient's transcript); a daemon
# restart relies on the catch-up read. The webhook secret is made for every
# forwarder start and lives only in memory and in that forwarder's argv.

GITHUB_EVENTS = ["issues", "issue_comment", "sub_issues", "pull_request", "pull_request_review",
                 "check_suite", "workflow_run"]
GITHUB_REPO_RE = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")
GITHUB_EVENT_RE = re.compile(r"^[a-z_]+$")
GITHUB_BACKOFF_BASE = 5        # seconds before the first restart; doubles each failure
GITHUB_BACKOFF_MAX = 300
GITHUB_STABLE = 60             # a forwarder that ran this long starts the backoff over
GITHUB_CONFLICT_RETRY = 1800   # seconds between attempts, and catch-up reads, while someone else forwards
GITHUB_CATCHUP_DELAY = 10      # seconds after a start: the forwarder has connected, so no gap remains
GITHUB_LOOKUP_TTL = 600
GITHUB_LOOKUP_RETRY = 60
GITHUB_BODY_LIMIT = 5 * 1024 * 1024
GITHUB_QUEUE_LIMIT = 2000
GITHUB_ROUTE_SECONDS = 5       # per pass: the time routing may spend on `gh api` lookups; the rest waits a pass
GITHUB_ROUTE_READ_TIMEOUT = 8  # seconds for one such lookup
GITHUB_CATCHUP_STUCK_PASSES = 3   # #494: a catch-up that stopped this many passes in a row is said in `status`, not silently starved
GITHUB_CATCHUP_ITEMS = 500     # items one catch-up keeps (the newest)
GITHUB_SUBREAD_TIMEOUT = 10    # seconds for a secondary read (reviews, check suites, workflow runs)
GITHUB_READ_BACKOFF = 600      # a secondary read that failed is not tried again for this long
GITHUB_PAGE_SIZE = 100         # records per page of every list read
GITHUB_PAGE_CAP = 5            # pages one list read follows; the rest is skipped, not chased
GITHUB_MARKER_SLACK = 60       # seconds before the read marker a catch-up starts (a forwarder repo)
READ_MARKER_FILE = "github-read.json"  # {"owner/repo": "<iso>"}: how far each repo was read; a disposable cursor
GITHUB_AUDIT_KEYS = 20         # keys named in one audit line; the rest are only counted
SECONDARY_READS = ("reviews", "check suites", "workflow runs", "items")
GITHUB_REJECT_AUDITS = 20      # bad-signature audit lines per minute; the rest are only counted
CONFLICT_TEXT = "Hook already exists"
WATCH_FILE = "github-watch.json"
WATCH_STATES = ("starting", "running", "backoff", "conflict")


GH_USERS_KEY_RE = re.compile(r"^[A-Za-z0-9_.-]+/(?:[A-Za-z0-9_.-]+|\*)$")
GITHUB_POLL_MIN = 15           # seconds: a poll reads a repo's comments, issues, pulls and runs
GITHUB_LOGIN_RE = re.compile(r"^[A-Za-z0-9](?:[A-Za-z0-9_-]{0,38}|[A-Za-z0-9_-]{0,34}\[bot\])$")


def _validate_github(config, source):
    """Check the github_* keys and `gh`; give `config` its own copies of the lists."""
    repos = config["github_repos"]
    if not isinstance(repos, list) or not all(isinstance(r, str) and GITHUB_REPO_RE.match(r) for r in repos):
        raise ConfigError("%s: 'github_repos' must be a list of \"owner/repo\" strings, got %r" % (source, repos))
    if len(set(repos)) != len(repos):
        raise ConfigError("%s: 'github_repos' names a repo twice: one forwarder per repo" % source)
    events = config["github_events"]
    if not isinstance(events, list) or not events or not all(
            isinstance(e, str) and GITHUB_EVENT_RE.match(e) for e in events):
        raise ConfigError("%s: 'github_events' must be a non-empty list of event names such as "
                          "\"issue_comment\", got %r" % (source, events))
    if not isinstance(config["gh"], str) or not config["gh"].strip():
        raise ConfigError("%s: 'gh' must be a non-empty string (a path or a command name), got %r"
                          % (source, config["gh"]))
    if not _is_number(config["github_lookback_hours"]) or config["github_lookback_hours"] <= 0:
        raise ConfigError("%s: 'github_lookback_hours' must be a positive number, got %r"
                          % (source, config["github_lookback_hours"]))
    port = config["github_port"]
    if port is not None and not (isinstance(port, int) and not isinstance(port, bool) and 1 <= port <= 65535):
        raise ConfigError("%s: 'github_port' must be null (any free port) or a port number, got %r" % (source, port))
    ignore = config["github_ignore_authors"]
    if not isinstance(ignore, list) or not all(isinstance(a, str) and GITHUB_LOGIN_RE.match(a) for a in ignore):
        raise ConfigError("%s: 'github_ignore_authors' must be a list of GitHub logins, got %r" % (source, ignore))
    config["github_repos"], config["github_events"] = list(repos), list(events)
    config["github_ignore_authors"] = list(ignore)
    owners = config["owner_logins"]
    if not isinstance(owners, list) or not all(isinstance(a, str) and GITHUB_LOGIN_RE.match(a) for a in owners):
        raise ConfigError("%s: 'owner_logins' must be a list of GitHub logins, got %r" % (source, owners))
    config["owner_logins"] = list(owners)
    users = config["gh_users"]
    if not isinstance(users, dict) or not all(
            isinstance(k, str) and GH_USERS_KEY_RE.match(k) and isinstance(v, str) and GITHUB_LOGIN_RE.match(v)
            for k, v in users.items()):
        raise ConfigError("%s: 'gh_users' must map \"owner/repo\" or \"owner/*\" to a gh account name, got %r"
                          % (source, users))
    seen_keys = {}
    for key, account in users.items():
        same = GhAccounts.normal_repo(key)
        if same in seen_keys and seen_keys[same][1].lower() != account.lower():   # GitHub names are not case sensitive: two spellings of one repo may not name two accounts
            raise ConfigError("%s: 'gh_users' names %r and %r, the same repo, with different accounts (%s, %s)" % (source, seen_keys[same][0], key, seen_keys[same][1], account))
        seen_keys.setdefault(same, (key, account))
    config["gh_users"] = dict(users)
    poll = config["github_poll_seconds"]
    if not _is_number(poll) or poll < GITHUB_POLL_MIN:
        raise ConfigError("%s: 'github_poll_seconds' must be a number of at least %d (each read of a repo costs "
                          "several API calls), got %r" % (source, GITHUB_POLL_MIN, poll))
    silence = config["intent_live_silence_minutes"]
    if not _is_number(silence) or silence < 0:
        raise ConfigError("%s: 'intent_live_silence_minutes' must be a number of minutes, 0 or more (0 keeps the long trust always), got %r" % (source, silence))


# ------------------------------------------------------------- verification

def sign_body(secret, body):
    """The `X-Hub-Signature-256` value for `body` under `secret`."""
    return "sha256=" + hmac.new(secret.encode("utf-8"), body, hashlib.sha256).hexdigest()


def signature_matches(secret, body, header):
    """True when `header` is the signature of the raw `body`. Constant time."""
    if not isinstance(header, str) or not secret:
        return False
    return hmac.compare_digest(sign_body(secret, body).encode("ascii"), header.encode("utf-8", "replace"))


def _scrub(text, *secrets_):
    """`text` with every secret in `secrets_` replaced; for anything read back from a child."""
    for secret in secrets_:
        if secret:
            text = text.replace(secret, REDACTED)
    return text


# -------------------------------------------------------------------- items

class GitHubItem:
    """One thing that happened on GitHub, keyed by object id, not yet routed.

    `issues`: issue numbers it is known to concern (the issue, its parents,
    the issues a PR closes), nearest first. `lookups`: `("issue", n)` or
    `("pr", n)` reads that can add more, made only when `issues` names no
    owner. `recipient` is set once an owner is found.
    """

    def __init__(self, key, kind, summary, repo, issues, lookups, sender, created, numbers=(), actionable=True):
        self.key, self.kind, self.summary, self.repo = key, kind, summary, repo
        self.issues, self.lookups, self.sender, self.created = list(issues), list(lookups), sender, created
        self.recipient = None
        # PR 52: `numbers` are the issue or PR numbers the item sits on (a notice is looked up by them);
        # `actionable` is false for news that is not worth an agent's turn (a passing check, a bot's comment) and
        # is delivered only to an owner the old links found; `routed_by` says which link found the owner.
        self.numbers, self.actionable, self.routed_by = list(numbers), actionable, None

    @property
    def issue(self):
        return self.issues[0] if self.issues else None


CLOSES_RE = re.compile(r"\b(?:close[sd]?|fix(?:e[sd])?|resolve[sd]?)\b:?\s+(?:[\w.-]+/[\w.-]+)?#(\d+)", re.I)


PLAIN_REF_RE = re.compile(r"(?<![\w/&])#(\d{1,7})\b")


def reference_numbers(pr, own):
    """PR 52: the issue numbers a PR that closes nothing points at, for the weak link: the plain `#N` in its title
    and body, else the numbers in its head branch name (`drift4242`). Empty when the PR names a closing issue; the
    PR's own number is never a candidate. The caller accepts only exactly one."""
    if not isinstance(pr, dict) or closing_numbers(pr.get("body")) or pr.get("linked_issues"):
        return []
    text = " ".join(str(pr.get(field) or "") for field in ("title", "body"))
    found = []
    for match in PLAIN_REF_RE.finditer(text):
        if int(match.group(1)) not in found and int(match.group(1)) != own:
            found.append(int(match.group(1)))
    if not found:
        ref = (pr.get("head") or {}).get("ref")
        for match in re.finditer(r"(?<!\d)(\d{1,7})(?!\d)", ref if isinstance(ref, str) else ""):
            if int(match.group(1)) not in found and int(match.group(1)) != own and int(match.group(1)) > 0:
                found.append(int(match.group(1)))
    return found


def closing_numbers(text):
    """Issue numbers named by "closes #N", "fixes #N", "resolves #N" in a PR body."""
    found = []
    for match in CLOSES_RE.finditer(text if isinstance(text, str) else ""):
        if int(match.group(1)) not in found:
            found.append(int(match.group(1)))
    return found


def _id(obj):
    value = obj.get("id") if isinstance(obj, dict) else None
    return value if isinstance(value, int) and not isinstance(value, bool) else None


def _number(obj):
    value = obj.get("number") if isinstance(obj, dict) else None
    return value if isinstance(value, int) and not isinstance(value, bool) and value >= 1 else None


ACTIONABLE_CONCLUSIONS = ("failure", "cancelled", "timed_out")  # PR 52: the checks an agent is told about


def _is_bot(obj):
    """A comment or review written by a bot: a login ending `[bot]` or a user of type Bot."""
    user = obj.get("user") if isinstance(obj, dict) else None
    if not isinstance(user, dict):
        return False
    login = user.get("login")
    return (isinstance(login, str) and login.lower().endswith("[bot]")) or str(user.get("type") or "").lower() == "bot"


def _login(obj):
    user = obj.get("user") if isinstance(obj, dict) else None
    login = user.get("login") if isinstance(user, dict) else None
    return login if isinstance(login, str) and login else None


# An agent's own words on GitHub. The agents share the user's GitHub account, so the author cannot say
# who wrote a comment, and each agent comment came back to its author as a wake (the trial's orchestrator:
# "that message is just my own comment coming back"). `fleet-switchboard comment` and `handoff` sign what
# they post with an HTML comment, invisible when GitHub renders it; a signed comment is never an event.
FLEET_MARK = re.compile(r"<!--\s*fleet-switchboard:from=([A-Za-z0-9_-]{1,64})\s*-->")


def fleet_mark(name):
    return "<!-- fleet-switchboard:from=%s -->" % name


def signed_by_fleet(body):
    """The agent a body was signed by, or None."""
    match = FLEET_MARK.search(body) if isinstance(body, str) else None
    return match.group(1) if match else None


def _url_number(url):
    match = re.search(r"/(?:issues|pulls)/([0-9]+)$", url) if isinstance(url, str) else None
    return int(match.group(1)) if match else None


def awaiting_cos_label(config):
    """PR 18: the label that marks an issue as waiting on the Chief of Staff: the config's, or
    `<user>:awaiting-cos`. The Chief of Staff either resolves it or escalates it to `awaiting_label`."""
    return config.get("awaiting_cos_label") or "%s:awaiting-cos" % getpass.getuser()


def awaiting_live_label(config=None):
    """The label that marks an issue as waiting on a live event, `<user>:awaiting-live` (the same `<user>:` namespace as the other awaiting labels; `config` is
    accepted for the shape of its siblings: this one has no override)."""
    return "%s:awaiting-live" % getpass.getuser()


def orchestrator_label(config=None):
    """PR 18: the label that marks a charter, `<user>:orchestrator` (skills/fleet-charter)."""
    return "%s:orchestrator" % getpass.getuser()


def awaiting_label(config):
    """The label that marks an issue as waiting on you: the config's, or the charter convention's
    `<user>:awaiting-user`, where the prefix is the OS user (`whoami`), as in skills/fleet-charter."""
    return config.get("awaiting_label") or "%s:awaiting-user" % getpass.getuser()


def parse_iso(text):
    """An ISO-8601 time with `Z` or an offset -> epoch seconds, or None."""
    return decision_core.parse_iso(text)


def parent_of(issue):
    """The parent issue number a payload or REST issue names, if it does."""
    if not isinstance(issue, dict):
        return None
    for field in ("parent", "parent_issue"):
        value = issue.get(field)
        found = value if isinstance(value, int) and not isinstance(value, bool) else _number(value)
        if found:
            return found
    return _url_number(issue.get("parent_issue_url"))


def _is_pr(issue):
    return isinstance(issue, dict) and bool(issue.get("pull_request"))


def _issue_refs(issue, number):
    """(known issue numbers, lookups) for something that lives on issue or PR `number`."""
    if _is_pr(issue):
        return closing_numbers(issue.get("body")), [("pr", number)]
    parent = parent_of(issue)
    if parent:
        return [number, parent], [("issue", parent)]
    return [number], [("issue", number)]


def _pr_refs(pr, number):
    """(known, lookups) for a PR object: the issues it closes, the ones the payload links."""
    known = closing_numbers(pr.get("body") if isinstance(pr, dict) else None)
    linked = pr.get("linked_issues") if isinstance(pr, dict) else None
    for entry in linked if isinstance(linked, list) else []:
        n = entry if isinstance(entry, int) and not isinstance(entry, bool) else _number(entry)
        if n and n not in known:
            known.append(n)
    return known, [("issue", n) for n in known] if known else [("pr", number)]


def _pr_numbers(obj):
    prs = obj.get("pull_requests") if isinstance(obj, dict) else None
    return [n for n in (_number(p) for p in (prs if isinstance(prs, list) else [])) if n]


def _comment_item(repo, comment, issue, now):
    cid = _id(comment)
    number = _number(issue) or _url_number(comment.get("issue_url"))
    if cid is None or number is None or signed_by_fleet(comment.get("body")):
        return None
    known, lookups = _issue_refs(issue, number)
    summary = "@%s commented on #%d: %s" % (_login(comment) or "someone", number, _one_line(comment.get("body") or "", 400))
    return GitHubItem("github.comment:%d" % cid, "github.comment", summary, repo, known, lookups, _login(comment), now,
                      [number], not _is_bot(comment))


def _issue_item(repo, issue, now, what=None):
    iid, number, updated = _id(issue), _number(issue), issue.get("updated_at")
    if iid is None or number is None or not isinstance(updated, str):
        return None
    known, lookups = _issue_refs(issue, number)
    summary = "issue #%d %s: %s" % (number, what or "updated", _one_line(issue.get("title") or "", 200))
    return GitHubItem("github.issue:%d:%s" % (iid, updated), "github.issue", summary, repo, known, lookups,
                      _login(issue), now)


def _pr_state(pr):
    return "merged" if pr.get("merged") or pr.get("merged_at") else str(pr.get("state") or "open")


def _pr_item(repo, pr, now):
    pid, number = _id(pr), _number(pr)
    if pid is None or number is None:
        return None
    state = _pr_state(pr)
    known, lookups = _pr_refs(pr, number)
    summary = "PR #%d is %s: %s" % (number, state, _one_line(pr.get("title") or "", 200))
    return GitHubItem("github.pr:%d:%s" % (pid, state), "github.pr", summary, repo, known, lookups, _login(pr), now,
                      [number], False)


def _conflict_item(repo, number, sha, now):
    """PR 52: one item per PR head commit that cannot be merged; its key makes a redelivery one item."""
    if not isinstance(sha, str) or not sha or not isinstance(number, int):
        return None
    return GitHubItem("github.conflict:%s#%d:%s" % (repo, number, sha), "github.conflict",
                      "PR #%d has a merge conflict with its base (head %s)" % (number, sha[:7]), repo, [],
                      [("pr", number)], None, now, [number], True)


def _pr_conflict(repo, pr, now):
    """The conflict item of a PR object that says so (`mergeable_state` dirty, or `mergeable` false), or None."""
    if not isinstance(pr, dict) or _pr_state(pr) != "open":
        return None
    if str(pr.get("mergeable_state") or "").lower() != "dirty" and pr.get("mergeable") is not False:
        return None
    return _conflict_item(repo, _number(pr), (pr.get("head") or {}).get("sha"), now)


def _review_item(repo, review, pr, now):
    rid, number = _id(review), _number(pr)
    if rid is None or number is None or signed_by_fleet(review.get("body")):
        return None
    known, lookups = _pr_refs(pr, number)
    state = str(review.get("state") or "reviewed").lower()
    summary = "@%s reviewed PR #%d (%s): %s" % (_login(review) or "someone", number, state,
                                                _one_line(review.get("body") or "", 300))
    return GitHubItem("github.review:%d" % rid, "github.review", summary, repo, known, lookups, _login(review), now,
                      [number], state == "changes_requested")


def _check_item(repo, obj, now, prefix, label):
    oid, conclusion = _id(obj), obj.get("conclusion")
    numbers = _pr_numbers(obj)
    if oid is None or not isinstance(conclusion, str) or not conclusion or not numbers:
        return None
    summary = "%s %s on PR %s" % (label, conclusion, ", ".join("#%d" % n for n in numbers))
    return GitHubItem("github.check:%s%d:%s" % (prefix, oid, conclusion), "github.check", summary, repo, [],
                      [("pr", n) for n in numbers], None, now, numbers, conclusion.lower() in ACTIONABLE_CONCLUSIONS)


def _wh_issues(repo, payload, now):
    action, issue = payload.get("action"), payload.get("issue")
    if action not in ("opened", "edited", "closed", "reopened", "labeled", "unlabeled"):
        return []
    what = action
    label = (payload.get("label") or {}).get("name") if isinstance(payload.get("label"), dict) else None
    if action in ("labeled", "unlabeled") and label:
        what = "label %s %s" % (label, "added" if action == "labeled" else "removed")
    item = _issue_item(repo, issue, now, what)
    return [item] if item else []


def _wh_issue_comment(repo, payload, now):
    if payload.get("action") != "created":
        return []
    item = _comment_item(repo, payload.get("comment") or {}, payload.get("issue"), now)
    return [item] if item else []


def _wh_pull_request(repo, payload, now):
    if payload.get("action") not in ("opened", "reopened", "closed", "ready_for_review"):
        return []
    pr = payload.get("pull_request") or {}
    return [item for item in (_pr_item(repo, pr, now), _pr_conflict(repo, pr, now)) if item]


def _wh_review(repo, payload, now):
    if payload.get("action") != "submitted":
        return []
    item = _review_item(repo, payload.get("review") or {}, payload.get("pull_request") or {}, now)
    return [item] if item else []


def _wh_check_suite(repo, payload, now):
    if payload.get("action") != "completed":
        return []
    item = _check_item(repo, payload.get("check_suite") or {}, now, "", "check suite")
    return [item] if item else []


def _wh_workflow_run(repo, payload, now):
    if payload.get("action") != "completed":
        return []
    run = payload.get("workflow_run") or {}
    item = _check_item(repo, run, now, "run-", "workflow %s" % (run.get("name") or "run"))
    return [item] if item else []


def _wh_sub_issues(repo, payload, now):
    parent, sub, action = payload.get("parent_issue"), payload.get("sub_issue"), payload.get("action")
    pid, sid, pn, sn = _id(parent), _id(sub), _number(parent), _number(sub)
    if None in (pid, sid, pn, sn) or not isinstance(action, str):
        return []
    summary = "sub-issue #%d: %s (parent #%d)" % (sn, action.replace("_", " "), pn)
    return [GitHubItem("github.subissue:%d:%d:%s" % (pid, sid, action), "github.subissue", summary, repo,
                       [pn, sn], [("issue", pn)], _login(payload.get("sender")), now)]


WEBHOOK_HANDLERS = {"issues": _wh_issues, "issue_comment": _wh_issue_comment, "pull_request": _wh_pull_request,
                    "pull_request_review": _wh_review, "check_suite": _wh_check_suite,
                    "workflow_run": _wh_workflow_run, "sub_issues": _wh_sub_issues}


def webhook_items(event, payload, now):
    """The items one webhook delivery holds. An event nobody handles holds none."""
    handler = WEBHOOK_HANDLERS.get(event)
    repo = (payload.get("repository") or {}).get("full_name") if isinstance(payload, dict) else None
    if handler is None or not isinstance(repo, str):
        return []
    return handler(repo, payload, now)


def decode_json_stream(text):
    """Every JSON value in `text`: `gh api --paginate` prints one document per page."""
    decoder, values, at = json.JSONDecoder(), [], 0
    while True:
        while at < len(text) and text[at].isspace():
            at += 1
        if at >= len(text):
            return values
        value, at = decoder.raw_decode(text, at)
        values.append(value)


def _records(values, key=None):
    """The records in pages: lists are flattened; with `key`, an object's list under it."""
    records = []
    for value in values:
        if isinstance(value, list):
            records.extend(value)
        elif isinstance(value, dict) and key and isinstance(value.get(key), list):
            records.extend(value[key])
    return [r for r in records if isinstance(r, dict)]


def _is_orchestrator(observation):
    return (observation.fleet or {}).get("role") == "orchestrator"


def pick_owner(agents, numbers, repo=None, default_repo=None, view=None):
    """The fleet agent that owns the first of `numbers`, or None. One recipient per item.

    An orchestrator owns its charter (the registry row's, `view`; #969), any other agent its metadata.fleet `issue` and `charter`. An
    orchestrator beats any other role; then the nearest issue in `numbers`
    wins, then the name.
    """
    best = None
    view = view or {}
    for name in sorted(agents):
        fleet = agents[name].fleet or {}
        theirs = fleet.get("repo") if isinstance(fleet.get("repo"), str) else default_repo  # PR 15: with several repos
        if repo and theirs and theirs != repo:                                               # an agent has one
            continue
        owned = owned_numbers(name, fleet, view)
        ranks = [numbers.index(n) for n in owned if n in numbers]
        if ranks:
            rank = (0 if fleet.get("role") == "orchestrator" else 1, min(ranks))
            if best is None or rank < best[0]:
                best = (rank, name)
    return best[1] if best else None


# ------------------------------------------------------------------- the hub

class GitHubUnavailable(Exception):
    """A `gh api` read that did not answer; the caller tries again later."""


FORWARDER_HISTORY_SECONDS = 3600
FORWARDER_DOWN_ALARM = 300       # not running this long (seconds) is an alarm
FORWARDER_FLAP_DROPS = 6         # more than this many drops in FORWARDER_FLAP_WINDOW is flapping
FORWARDER_FLAP_WINDOW = 600
FORWARDER_SHORT_RUN = 60         # a run shorter than this is a short run; three in the window is flapping
FORWARDER_SHORT_RUNS = 3


def forwarder_health(watch, now):
    """#77: what status says about one forwarder, from the snapshot alone: live or down with its own age, the
    drops as quiet history, and an alarm (a string) when it has been down or flapping too long, else None."""
    drops = [(t, r) for t, r in (watch.get("drops") or []) if now - t < FORWARDER_HISTORY_SECONDS]
    live = watch.get("mode") == "forwarder"
    started = parse_iso(watch["started"]) if watch.get("started") else None
    recent = [(t, r) for t, r in drops if now - t < FORWARDER_FLAP_WINDOW]
    health = {"live": live, "up_age": max(0, now - started) if live and started is not None else None,
              "down_age": None, "drops_hour": len(drops), "last_drop_age": max(0, now - drops[-1][0]) if drops else None,
              "alarm": None}
    if watch.get("mode") == "conflict":  # someone else forwards, by intent; catch-up reads continue: not an alarm
        health["quiet"] = "conflict"
        return health
    if not live and watch.get("down_since") is not None and watch.get("mode") not in ("polling", "failed"):
        health["down_age"] = max(0, now - watch["down_since"])
        if health["down_age"] > FORWARDER_DOWN_ALARM:
            health["alarm"] = "down for %s" % format_age(health["down_age"])
    if health["alarm"] is None and len(recent) > FORWARDER_FLAP_DROPS:
        health["alarm"] = "flapping: %d drops in 10 min" % len(recent)
    elif health["alarm"] is None and sum(1 for _, r in recent if r < FORWARDER_SHORT_RUN) >= FORWARDER_SHORT_RUNS:
        health["alarm"] = "flapping: %d runs under %ds in 10 min" % (
            sum(1 for _, r in recent if r < FORWARDER_SHORT_RUN), FORWARDER_SHORT_RUN)
    return health


class Watch:
    """One watched repo: its forwarder child and what is known about it. Memory only."""

    def __init__(self, repo):
        self.repo, self.state, self.proc, self.secret = repo, "backoff", None, None
        self.failures = self.starts = 0
        self.next_start = 0.0
        self.started = self.catchup_at = self.last_catch_up = None
        self.last_error = self.catch_up_error = None
        self.last_event = None   # #367: when a webhook event last arrived for this repo (memory only)
        self.drops = []          # #77: (time dropped, seconds it had run), the last hour's worth; memory only
        self.down_since = None   # when the forwarder last stopped, until it runs again
        # PR 15: a repo whose forwarder cannot work (no such repo yet, no right to make a webhook) is read on
        # a poll instead: the existing catch-up read, every github_poll_seconds.
        self.polling, self.poll_reason, self.next_poll, self.last_poll = False, None, 0.0, None

    @property
    def mode(self):
        """How the repo is watched: forwarder, polling, failed (polling, and the poll cannot read it either),
        or the supervisor's own state while the forwarder starts, backs off or finds a conflict."""
        try:
            alive = self.proc is not None and self.proc.poll() is None
        except Exception:  # describing a watch must never be what fails
            alive = True
        if alive:
            return "forwarder"
        if self.polling:
            return "failed" if self.catch_up_error else "polling"
        return self.state

    def to_json(self):
        """What `status` may show. Never the secret."""
        return {"repo": self.repo, "state": self.state, "mode": self.mode, "poll_reason": self.poll_reason,
                "starts": self.starts, "failures": self.failures,
                "forwarder_pid": getattr(self.proc, "pid", None), "started": iso(self.started),
                "next_start": iso(self.next_start) if self.proc is None else None,
                "last_catch_up": iso(self.last_catch_up), "last_error": self.last_error,
                "drops": [[t, r] for t, r in self.drops], "down_since": self.down_since,
                "catch_up_error": self.catch_up_error}


def spawn_forwarder(argv, log_path, env=None):
    """Start the forwarder detached, its output in `log_path`. It never inherits our pipes. `env` (PR 15)
    is the repo's account's environment, the only place its token ever is."""
    fd = os.open(str(log_path), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        return subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=fd, stderr=fd, env=env,
                                start_new_session=True, close_fds=True)
    finally:
        os.close(fd)


def _terminate(proc):
    """Stop a forwarder and anything it started (it leads its own process group)."""
    try:
        if isinstance(proc, subprocess.Popen):
            os.killpg(proc.pid, signal.SIGTERM)
        else:
            proc.terminate()
    except (OSError, ProcessLookupError):
        pass


_USAGE_LINE = re.compile(r"^\s*(-{1,2}[A-Za-z]|usage:|flags:|examples?:|global flags:|\$ |#|use \")", re.I)
_ERROR_LINE = re.compile(r"\b(error|failed|failure|unauthorized|forbidden|denied|not found|refused|timed? ?out|invalid)\b", re.I)


NO_RIGHTS_RE = re.compile(r"admin rights|Resource not accessible|HTTP 40[13]|Bad credentials|forbidden", re.I)
NOT_FOUND_RE = re.compile(r"Not Found|HTTP 404|Could not resolve", re.I)


def unwatchable_reason(tail):
    """Why a forwarder that exited can never work here (so the repo is polled), or None for an ordinary failure."""
    if NO_RIGHTS_RE.search(tail):
        return "the account cannot create a webhook"
    if NOT_FOUND_RE.search(tail):
        return "the repo does not exist yet, or this account cannot see it"
    return None


def forwarder_reason_line(lines):
    """The line of a dead forwarder's output that says why. cobra prints the error and then the whole usage
    text, so the LAST line is a flag description (the trial's audit said `-U, --url string Address of the
    local server...`). First an error-looking line that is not usage, then any line that is not usage."""
    plain = [line for line in lines if not _USAGE_LINE.match(line)]
    for line in plain:
        if _ERROR_LINE.search(line):
            return line
    return (plain or lines)[0]


class GitHubHub:
    """The listener, the forwarder supervisor, the queue and the catch-up read.

    Everything shared between the listener thread, the supervisor thread and
    the engine's pass is behind `self.lock`. `now`, `runner` (for `gh api`) and
    `spawn` (for the forwarders) are injected, so tests run a simulated clock
    and a fake `gh` and never reach a real binary.
    """

    def __init__(self, config, state_dir, audit=None, runner=subprocess.run, spawn=spawn_forwarder,
                 now=time.time, actor="daemon"):
        self.config, self.state_dir, self.audit = config, Path(state_dir), audit
        self.runner, self.spawn, self.now, self.actor = runner, spawn, now, actor
        self.lock = threading.RLock()
        self.queue = {}        # key -> GitHubItem, until delivered
        self.watches = {repo: Watch(repo) for repo in watched_repos(config, {})}   # the baseline less the excluded repositories
        self.accounts = GhAccounts(config, runner, now)  # PR 15: a gh account per repo
        self.lookback = config["github_lookback_hours"] * 3600
        self.backoff_base, self.backoff_max = GITHUB_BACKOFF_BASE, GITHUB_BACKOFF_MAX
        self.conflict_retry, self.catchup_delay = GITHUB_CONFLICT_RETRY, GITHUB_CATCHUP_DELAY
        self.discover = lambda: None  # set by attach()
        self.autostart = True
        self.port, self.server, self.threads, self.stopping = config["github_port"] or 0, None, [], threading.Event()
        self._cache, self._retry, self._rejects, self._suppressed = {}, {}, [], 0
        self._unrouted, self._snapshot = set(), None
        self._route_until, self._unrouted_batch, self._read_backoff = None, [], {}
        self._notices, self._filtered, self._filtered_batch = {}, set(), []   # PR 52
        self._routed_batch, self._conflicts = [], set()
        self.markers, self._markers_dirty, self.last_truncated = self._load_markers(), False, {}
        self._cursors, self.last_incomplete, self.last_failed_primary = {}, False, False   # #494: per repo, the steps of an unfinished catch-up window
        self.engine = None
        self.intent_verdicts = {}  # intent.edit key -> (wakes the Chief of Staff, why): decided once per edit
        self.intent_edits = {}  # intent.edit key -> the `issues` payload, until delivered (PR 6's item, wired here)
        self.closed_issues = {}  # #570: "owner/repo#N" -> {"labels", "at"} of the last verified issues-closed event (memory only; bin/closed_labels.py cleans their awaiting labels)
        self.pr_events = {}     # #354: "owner/repo#N" -> the `pr-state` entry the last verified pull_request event made (memory only; the pass folds it in)
        self.awaiting = {}      # PR 14: (repo, number) -> {"title", "since", "parent"} of an open issue with the label
        self.awaiting_read = {}  # PR 14: repo -> None (read fine) or the error of the last labelled read; absent: never

    # -- wiring

    def attach(self, engine):
        """Make this hub one of `engine`'s fact sources, reading the fleet through it."""
        self.engine = engine
        engine.hub = self  # PR 14: the decisions derivation reads the awaiting-user issues from it
        self.discover = lambda: engine.discover(engine.now())
        engine.sources.append(self.fact_source())
        shared = getattr(engine, "accounts", None)
        if isinstance(shared, GhAccounts):
            self.accounts = shared   # the hub reads through the engine's gate: one pause and one counter for the account
        reader = getattr(engine, "intents", None)
        if reader is not None:
            reader.live = self.forwarder_generation   # a repo with a live forwarder: its webhook invalidates, so an Intent may be trusted longer
        return engine

    def forwarder_generation(self, repo):
        """The number of times `repo`'s forwarder has started while it is running now, or None when it is not live (polling, down, starting): an entry
        cached under one generation is trusted for the long time only while that same forwarder runs, so an event missed in a gap is never trusted."""
        watch = self.watches.get(repo)
        if watch is None or watch.mode != "forwarder":
            return None
        silence = self.config.get("intent_live_silence_minutes")   # #367: alive but silent (lag, a stuck connection) is not trusted for the long time
        if _is_number(silence) and silence > 0:
            heard = max(watch.last_event or 0, watch.started or 0)
            if self.now() - heard > silence * 60:
                return None
        return watch.starts

    def _audit(self, event, subject, detail):
        if self.audit is not None:
            self.audit.append(self.actor, event, subject, detail)

    # -- the listener

    def open_listener(self):
        """Bind 127.0.0.1 (never another address) and serve POST /github in a thread."""
        hub = self

        class Handler(BaseHTTPRequestHandler):
            server_version = "fleet-switchboard"
            timeout = 10  # a stalled sender must not hold a thread

            def _reply(self, status, text):
                data = (text + "\n").encode("utf-8")
                self.send_response(status)
                self.send_header("Content-Type", "text/plain; charset=utf-8")
                self.send_header("Content-Length", str(len(data)))
                self.end_headers()
                self.wfile.write(data)

            def do_POST(self):
                try:
                    size = int(self.headers.get("Content-Length", ""))
                except ValueError:
                    return self._reply(411, "length required")
                if size < 0 or size > GITHUB_BODY_LIMIT:
                    return self._reply(413, "too large")
                status, text = hub.receive(self.path.split("?")[0], self.headers, self.rfile.read(size))
                self._reply(status, text)

            def do_GET(self):
                self._reply(405, "POST only")

            def log_message(self, *args):  # the daemon's stderr is not a log
                pass

        server = ThreadingHTTPServer(("127.0.0.1", self.port), Handler)
        server.daemon_threads = True
        self.server, self.port = server, server.server_address[1]
        self._thread(server.serve_forever)
        return self.port

    def _thread(self, target):
        thread = threading.Thread(target=target, daemon=True)
        thread.start()
        self.threads.append(thread)

    def start(self):
        """Open the listener, then supervise the forwarders every second. Idempotent."""
        with self.lock:
            if self.server is not None:
                return
            self.stopping.clear()
            self.open_listener()
            self._thread(self._supervise)

    def _supervise(self):
        while not self.stopping.wait(1.0):
            try:
                self.tick()
            except Exception as err:  # the supervisor must outlive any one bad tick
                self._audit("github.error", None, {"error": _one_line(str(err))})

    def stop(self):
        """Stop the listener and every forwarder."""
        self.stopping.set()
        server, self.server = self.server, None
        if server is not None:
            server.shutdown()
            server.server_close()
        with self.lock:
            for watch in self.watches.values():
                if watch.proc is not None:
                    _terminate(watch.proc)
                    watch.proc, watch.secret, watch.state = None, None, "backoff"
            self._save_markers()
            self._write_snapshot(self.now(), stopped=True)

    # -- receiving

    def _verified_repo(self, header, body):
        """The repo whose current secret signed `body`, or None. Checks every secret."""
        match = None
        with self.lock:
            for repo, watch in self.watches.items():
                if watch.secret and signature_matches(watch.secret, body, header):
                    match = repo
        return match

    def _reject(self, reason, body):
        now = self.now()
        with self.lock:
            self._rejects = [t for t in self._rejects if now - t < 60]
            if len(self._rejects) >= GITHUB_REJECT_AUDITS:
                self._suppressed += 1
                return
            self._rejects.append(now)
            suppressed, self._suppressed = self._suppressed, 0
        self._audit("github.rejected", None, {"reason": reason, "bytes": len(body), "also_rejected": suppressed})

    def receive(self, path, headers, body):
        """One POST. The signature is checked before the body is read as anything.

        Returns (HTTP status, one line). Nothing is ingested unless it passes.
        """
        if path != "/github":
            return 404, "not found"
        header = _header(headers, "X-Hub-Signature-256")
        repo = self._verified_repo(header, body)
        if repo is None:
            self._reject("signature missing" if not header else "signature does not match", body)
            return 401, "bad signature"
        try:
            payload = json.loads(body.decode("utf-8"))
            if not isinstance(payload, dict):
                raise ValueError("not an object")
        except ValueError:
            self._audit("github.rejected", repo, {"reason": "body is not a JSON object", "bytes": len(body)})
            return 400, "bad body"
        event = _header(headers, "X-GitHub-Event") or ""
        sent = (payload.get("repository") or {}).get("full_name")
        if sent not in (None, repo):
            self._audit("github.rejected", repo, {"reason": "payload names another repo", "event": event})
            return 202, "ignored"
        try:
            items = webhook_items(event, dict(payload, repository={"full_name": repo}), self.now())
        except Exception as err:
            self._audit("github.rejected", repo, {"reason": "unreadable %s: %s" % (event, _one_line(str(err)))})
            return 400, "bad payload"
        self.enqueue(items)
        with self.lock:  # live traffic moves the marker, unless a catch-up still has a gap to close
            watch = self.watches.get(repo)
            if watch is not None:
                watch.last_event = self.now()
            live = watch is not None and watch.catchup_at is None and repo in self.markers
        if live:
            self._set_marker(repo, self.now())
        self.note_issue_edit(event, repo, payload)
        self.note_awaiting_event(event, repo, payload)
        try:   # #348: a push, a PR opened or merged is real movement of the ask it closes: one small row, for the load figure
            load_fleet_health().append_moves(self.state_dir, load_fleet_health().move_rows(event, payload, repo, self.now(), closing_numbers))
        except Exception as err:   # the load figure then under-counts movement: say so in the audit, never fail the delivery
            self._audit("load.moves_failed", repo, {"error": _one_line("%s: %s" % (type(err).__name__, err), 160)})
        try:   # #470: a closed, relabelled or edited issue, or a changed sub-issue list, makes the cached asks list of this repository stale
            load_fleet_health().mark_stale(self.state_dir, event, payload, repo, self.now())
        except Exception as err:
            self._audit("load.stale_failed", repo, {"error": _one_line("%s: %s" % (type(err).__name__, err), 160)})
        self.note_pr_event(event, repo, payload)
        self._audit("github.received", repo, {"event": event, "delivery": _header(headers, "X-GitHub-Delivery"),
                                              "keys": [_one_line(item.key, 80) for item in items[:5]], "count": len(items)})   # ids, not bodies: the first few of them
        return 202, "accepted"

    def enqueue(self, items):
        ignore = {a.lower() for a in self.config.get("github_ignore_authors") or []}
        if ignore:
            dropped = [item for item in items if (item.sender or "").lower() in ignore]
            if dropped:
                self._audit("github.ignored", dropped[0].repo, {"keys": [item.key for item in dropped],
                                                                "authors": sorted({item.sender for item in dropped})})
                items = [item for item in items if item not in dropped]
        with self.lock:
            for item in items:
                self.queue.setdefault(item.key, item)  # the same object seen twice is one item
            while len(self.queue) > GITHUB_QUEUE_LIMIT:
                self.queue.pop(next(iter(self.queue)))

    def acknowledge(self, keys):
        """The engine found these keys delivered: forget them. Not stored, so a later
        catch-up that reads them again queues them once more, and the transcript
        stops the repeat."""
        with self.lock:
            for key in keys:
                self.queue.pop(key, None)
                self.intent_edits.pop(key, None)

    # -- an edit to an ask's Intent (PR 6's item and toast, which nothing called until now)

    def note_issue_edit(self, event, repo, payload):
        """On a sub-issue event: forget the cached parent link and issue of both ends (a long-trusted entry must not outlive a change of the tree).
        On an edited issue: drop its cached Intent, so the next message carries the new lines (a
        message built from the old cache said the old Done when), and hold the edit for the Chief of
        Staff when the Intent section itself changed. Never raises: a bad payload is only not surfaced."""
        if event == "sub_issues":
            reader = getattr(self.engine, "intents", None)
            for key in ("sub_issue", "parent_issue"):
                number = (payload.get(key) or {}).get("number")
                if reader is not None and isinstance(number, int):
                    reader.invalidate(number, repo)
            return
        if event != "issues" or payload.get("action") != "edited":
            return
        try:
            number = (payload.get("issue") or {}).get("number")
            reader = getattr(self.engine, "intents", None)
            if reader is not None and isinstance(number, int):
                reader.invalidate(number, repo)
            fact = intent_change_fact(dict(payload, repository={"full_name": repo}), "chief-of-staff")
            if fact is not None:
                with self.lock:
                    self.intent_edits[fact.key] = dict(payload, repository={"full_name": repo})
                    while len(self.intent_edits) > GITHUB_QUEUE_LIMIT:
                        self.intent_edits.pop(next(iter(self.intent_edits)))
        except Exception as err:
            self._audit("github.rejected", repo, {"reason": "intent edit not surfaced: %s" % _one_line(str(err))})

    def _chiefs_of_staff(self):
        discovery = self.discover()
        agents = discovery.agents if discovery is not None and not discovery.problems else {}
        return sorted(name for name, seen in agents.items() if (seen.fleet or {}).get("role") == "chief-of-staff")

    def intent_edit_wakes(self, fact):
        """(wakes, note): does this Intent edit reach the Chief of Staff? Decided once per edit (the key), then
        remembered. It does when the editor is the person (`owner_logins`), or the issue is one of our charters, or
        an ask or work item under one (the same climb to a fleet agent's charter that routes a comment); anything
        else (another team's issue that happens to have an Intent line) is only audited. When the chain cannot be
        read it wakes, labelled: an ask's Intent change is never lost to a failed read."""
        known = self.intent_verdicts.get(fact.key)
        if known is not None:
            return known
        login = (fact.sender or "").lower()
        owners = {a.lower() for a in self.config.get("owner_logins") or []}
        note, memo = None, True
        if login in owners:
            wakes, why = True, "edited by the owner"
        else:
            discovery = self.discover()
            if discovery is None or discovery.problems:
                wakes, why, note, memo = True, "the fleet cannot be read", "chain unchecked: woken to be safe", False
            else:
                try:
                    owner = self._resolve(fact.repo, [fact.issue], [("issue", fact.issue)], discovery.agents,
                                          self.now(), {})
                except GitHubUnavailable:
                    wakes, why, note = True, "the issue's chain cannot be read", "chain unreadable: woken to be safe"
                else:
                    wakes = owner is not None
                    why = "under a charter of %s" % owner if wakes else "not under any of our charters"
        result = (wakes, note)
        if memo:
            if len(self.intent_verdicts) > GITHUB_QUEUE_LIMIT:
                self.intent_verdicts.clear()
            self.intent_verdicts[fact.key] = result
            self._audit("intent.edit", fact.repo or "-", {"issue": fact.issue, "by": fact.sender, "woke": wakes,
                                                          "why": why})
        return result

    def intent_edit_facts(self):
        with self.lock:
            edits = list(self.intent_edits.values())
        found = []
        if edits:
            for name in self._chiefs_of_staff():
                for payload in edits:
                    fact = intent_change_fact(payload, name)
                    if fact is None or fact.created < self.now() - self.lookback:
                        continue
                    wakes, note = self.intent_edit_wakes(fact)
                    if not wakes:
                        continue
                    if note:
                        fact.summary += "\n(%s)" % note
                    found.append(fact)
        return found

    def toasts(self):
        """One toast per pending Intent edit that wakes the Chief of Staff, through the engine's render step."""
        found = []
        with self.lock:
            edits = list(self.intent_edits.values())
        if edits:
            for name in self._chiefs_of_staff():
                for payload in edits:
                    toast = intent_change_toast(payload)
                    fact = intent_change_fact(payload, name) if toast is not None else None
                    if fact is not None and self.intent_edit_wakes(fact)[0]:
                        number, updated, _ = _payload_issue(payload)
                        found.append((name, "intent edit #%d %s" % (number, updated), toast["title"], toast["body"]))
        found.extend(self.polling_toasts())
        return found

    def polling_toasts(self):
        """PR 15: one toast per repo that is polled because its forwarder cannot work, for as long as it is."""
        with self.lock:
            polled = [(w.repo, w.poll_reason, w.last_error) for _, w in sorted(self.watches.items()) if w.polling]
        return [("github:%s" % repo, "polling: %s" % reason, "GitHub: %s is read on a poll" % repo,
                 _one_line("no webhook (%s); read every %gs. %s" % (reason, self.config["github_poll_seconds"],
                                                                    last_error or ""), 200))
                for repo, reason, last_error in polled]

    # -- the fact source

    def fact_source(self):
        def github_facts():
            self.reconcile(getattr(self.engine, "discovery", None))  # PR 15: the watched set, every pass
            if self.autostart and self.watches:
                self.start()  # inside the daemon's lock: the first pass starts it
            return self.facts()
        github_facts.acknowledge = self.acknowledge
        github_facts.toasts = self.toasts
        return github_facts

    def reconcile(self, discovery):
        """PR 15: make the watches the derived set (`watched_repos`): start one for a repo that joined, stop
        one that nobody names any more. A fleet that cannot be read changes nothing."""
        if discovery is None or discovery.problems:
            return
        wanted = set(watched_repos(self.config, discovered_fleets(discovery)))
        with self.lock:
            joined = sorted(wanted - set(self.watches))
            left = sorted(set(self.watches) - wanted)
            for repo in joined:
                self.watches[repo] = Watch(repo)
            gone = [(repo, self.watches.pop(repo)) for repo in left]
            self.prune_cursors()
        for repo in joined:
            self._audit("github.watch", repo, {"state": "joined"})
        for repo, watch in gone:
            if watch.proc is not None:
                _terminate(watch.proc)
            watch.proc = watch.secret = None
            self._audit("github.watch", repo, {"state": "left"})

    def prune_cursors(self):
        """#494: the cursor of an unfinished catch-up belongs to a repo that is watched NOW and not excluded: a repo that left the watched set (or was
        excluded since) loses it, so it never shows as catching up and never causes a read, and a repo that joins again starts a fresh window. The caller holds the lock."""
        exclusion = load_module("repo_exclusion")
        for repo in [r for r in self._cursors if r not in self.watches or exclusion.is_excluded(self.config, r)]:
            del self._cursors[repo]

    def facts(self):
        """Every queued item that has an owner now, as Facts. Expired items are dropped."""
        now = self.now()
        with self.lock:
            for key in [k for k, i in self.queue.items() if i.created < now - self.lookback]:
                del self.queue[key]
        self.note_conflicts(now)
        with self.lock:
            waiting = [item for item in self.queue.values() if item.recipient is None]
        if waiting:
            self._notices = self._load_notices()
            discovery = self.discover()
            self._route_until = None if fault("catch-up-blocks-pass") else now + GITHUB_ROUTE_SECONDS
            try:
                for item in waiting:
                    if self._route_until is not None and self.now() >= self._route_until:
                        break  # the rest is routed on the next pass: the pass itself must stay on schedule
                    self._route(item, discovery, now)
            finally:
                self._route_until = None
            self._audit_unrouted()
            self._audit_routed()
        with self.lock:
            found = [Fact(i.key, i.recipient, i.kind, i.summary, i.created, issue=i.issue, sender=i.sender,
                          repo=i.repo)
                     for i in self.queue.values() if i.recipient]
        found.extend(self.intent_edit_facts())
        for fact in found:
            # An object seen again (a catch-up, a redelivery) was perhaps delivered long
            # ago: the engine's read of the transcript must reach back that far.
            fact.look_back = self.lookback
        return found

    def _route(self, item, discovery, now):
        if discovery is None or discovery.problems:
            return  # the fleet cannot be read: keep it, ask again next pass
        try:
            owner, routed_by = self.route_of(item, discovery.agents, now)
        except GitHubUnavailable:
            return
        with self.lock:
            if owner and not item.actionable and routed_by != "closing":
                # PR 52: an owner found by a new link is told what needs it, not every passing check
                if item.key in self.queue:
                    del self.queue[item.key]
                    if item.key not in self._filtered:
                        if len(self._filtered) > 20000:
                            self._filtered.clear()
                        self._filtered.add(item.key)
                        self._filtered_batch.append((item, routed_by))
            elif owner:
                item.recipient, item.routed_by = owner, routed_by
                self._routed_batch.append(item)
            elif item.key in self.queue:
                del self.queue[item.key]
                if item.key not in self._unrouted:
                    if len(self._unrouted) > 20000:
                        self._unrouted.clear()
                    self._unrouted.add(item.key)
                    self._unrouted_batch.append(item)

    def _audit_unrouted(self):
        """One audit line per repo per pass for the items that belong to nobody, not one line each."""
        with self.lock:
            batch, self._unrouted_batch = self._unrouted_batch, []
        by_repo = {}
        for item in batch:
            by_repo.setdefault(item.repo, []).append(item)
        for repo, items in sorted(by_repo.items(), key=lambda pair: str(pair[0])):
            issues = sorted({n for item in items for n in item.issues})
            prs = sorted({n for item in items for n in item.numbers})
            self._audit("github.unrouted", repo, {"keys": [i.key for i in items[:GITHUB_AUDIT_KEYS]], "count": len(items),
                                                   "issues": issues[:GITHUB_AUDIT_KEYS],
                                                   "prs": prs[:GITHUB_AUDIT_KEYS]})

    def _audit_routed(self):
        """PR 52: one line per repo, link and recipient per pass for what was routed, and one for what a new link
        found an owner for but was not worth delivering (a passing check): the field `routed_by` is how a route is read."""
        with self.lock:
            routed, self._routed_batch = self._routed_batch, []
            filtered, self._filtered_batch = self._filtered_batch, []
        groups = {}
        for item in routed:
            groups.setdefault((item.repo, item.routed_by, item.recipient), []).append(item)
        for (repo, by, recipient), items in sorted(groups.items(), key=lambda pair: tuple(str(x) for x in pair[0])):
            self._audit("github.routed", repo, {"routed_by": by, "to": recipient, "count": len(items),
                                                "keys": [i.key for i in items[:GITHUB_AUDIT_KEYS]]})
        skipped = {}
        for item, by in filtered:
            skipped.setdefault((item.repo, by), []).append(item)
        for (repo, by), items in sorted(skipped.items()):
            self._audit("github.not_delivered", repo, {"routed_by": by, "count": len(items), "why": "not actionable",
                                                       "keys": [i.key for i in items[:GITHUB_AUDIT_KEYS]]})

    def note_conflicts(self, now):
        """PR 52: a conflict item for each open PR with a notice whose last read says it cannot be merged, once per
        head commit (the key names it; the set keeps it from being queued again after delivery). No read of its own:
        it uses what the notice reads (`notice_facts`) already hold, about one per PR per PR_FACTS_TTL."""
        held = getattr(self.engine, "notice_facts", None) or {}
        for key, entry in sorted(held.items()):
            facts = entry.get("facts") if isinstance(entry, dict) else None
            if not facts or facts.get("state") != "open" or facts.get("mergeable") != "CONFLICTING":
                continue
            repo, _, number = key.rpartition("#")
            item = _conflict_item(repo, int(number), facts.get("head"), now) if number.isdigit() else None
            with self.lock:
                if item is None or item.key in self._conflicts:
                    continue
                if len(self._conflicts) > 20000:
                    self._conflicts.clear()
                self._conflicts.add(item.key)
                self.queue.setdefault(item.key, item)

    def _load_notices(self):
        """{(repo, number): notice record}: the PR notices on file, or {} when the file cannot be read."""
        try:
            return {(n["repo"], n["number"]): n for n in read_pr_notices(self.state_dir)}
        except NoticeError:
            return {}

    def owner_of(self, item, agents, now):
        """The owner of an item (see `route_of`, which also says by which link)."""
        return self.route_of(item, agents, now)[0]

    def notice_names(self, repo, number):
        """The agent names a `notice pr` record of this pull request names (its sender, then its boss), whether or not they run: who WAS told to watch it."""
        notice = self._notices.get((repo, number)) or {}
        return [n for n in (notice.get("from"), notice.get("boss")) if isinstance(n, str) and n]

    def route_of(self, item, agents, now):
        """(owner, routed_by) of an item, or (None, None). PR 52: the links in order: (closing) the issues the item
        or its PR names, the existing routing, unchanged and first so that nothing that routes today moves;
        (notice) the agent that recorded a `notice pr` for the PR, or its boss when it is gone; (reference) the one
        issue a PR that closes nothing mentions as a plain #N (or in its head branch name). Raises GitHubUnavailable."""
        seen = {}
        owner = self._resolve(item.repo, list(item.issues), list(item.lookups), agents, now, seen)
        if owner:
            return owner, "closing"
        for number in item.numbers:
            notice = self._notices.get((item.repo, number))
            if notice:
                for name in (notice.get("from"), notice.get("boss")):
                    if isinstance(name, str) and name in agents:
                        return name, "notice"
        for number in item.numbers:
            pr = seen.get(number)
            candidates = reference_numbers(pr, number) if pr is not None else []
            if len(candidates) == 1:
                owner = self._resolve(item.repo, candidates[:], [("issue", candidates[0])], agents, now, seen)
                if owner:
                    return owner, "reference"
        return None, None

    def _resolve(self, repo, known, pending, agents, now, seen):
        """The existing walk: known issues first, then reads that climb to parents and to the issues a PR closes."""
        done = set()
        while True:
            owner = pick_owner(agents, known, repo,
                               self.config.get("intent_repo") if len(self.watches) > 1 else None, view=registry_charter_view(self))
            if owner and _is_orchestrator(agents[owner]):
                return owner
            if not pending:
                return owner  # a worker that owns the issue, when no orchestrator above it does
            lookup = pending.pop(0)
            if lookup in done:
                continue
            done.add(lookup)
            more_known, more_lookups = self._expand(repo, lookup, now, seen)
            known += [n for n in more_known if n not in known]
            pending += more_lookups

    def _expand(self, repo, lookup, now, seen=None):
        kind, number = lookup
        data = self._read_one(repo, "%s/%d" % ("pulls" if kind == "pr" else "issues", number), now)
        if kind == "pr" and seen is not None:
            seen[number] = data
        if kind == "pr":
            return _pr_refs(data, number)[0], [("issue", n) for n in _pr_refs(data, number)[0]]
        if _is_pr(data):
            return closing_numbers(data.get("body")), [("pr", number)]
        parent = parent_of(data)
        return ([parent], [("issue", parent)]) if parent else ([], [])

    def _read_one(self, repo, path, now, fresh=False):
        key = (repo, path)
        with self.lock:
            cached = self._cache.get(key)
            if cached and now < cached[0] and not fresh:
                return cached[1]
            if now < self._retry.get(key, 0):
                raise GitHubUnavailable("read of %s failed recently; trying again later" % path)
        if self._route_until is not None and self.now() >= self._route_until:
            raise GitHubUnavailable("this pass's time for reading GitHub is spent")
        try:
            pages = self.gh_api("repos/%s/%s" % (repo, path), paginate=False,
                                timeout=min(self.config["call_timeout_seconds"], GITHUB_ROUTE_READ_TIMEOUT))
            data = pages[0] if pages and isinstance(pages[0], dict) else {}
        except GitHubUnavailable:
            with self.lock:
                self._retry[key] = now + GITHUB_LOOKUP_RETRY
            raise
        with self.lock:
            self._cache[key] = (now + GITHUB_LOOKUP_TTL, data)
        return data

    def open_issues_count(self, repo):
        """The repository's own count of open issues and pull requests (`open_issues_count` of `repos/<repo>`), one read; None when it cannot be told. Raises GitHubUnavailable."""
        pages = self.gh_api("repos/%s" % repo, paginate=False, timeout=min(self.config["call_timeout_seconds"], GITHUB_ROUTE_READ_TIMEOUT))
        count = pages[0].get("open_issues_count") if pages and isinstance(pages[0], dict) else None
        return count if isinstance(count, int) and not isinstance(count, bool) else None

    # -- the issues that wait on you (PR 14): events keep the picture, the catch-up read makes it right

    @staticmethod
    def awaiting_key(repo, number):
        """THE key of an awaiting issue: the repository folded the one way the fleet folds names everywhere else (`plan_ledger.normal_repo`), so the
        configured case, the case an event carries and the case a ref carries are one issue. Every read and write of `self.awaiting` goes through it."""
        return (plan_ledger.normal_repo(repo), number)

    def note_awaiting_issue(self, repo, issue, when=None):
        """One issue as a webhook payload or a read shows it: listed when it is open and carries a label,
        forgotten otherwise. `since` is kept from the first time it was seen listed; a `labeled` event says
        when (the issue's `updated_at`), and a read can only say when the issue last changed. PR 18: the tier
        is `human` with your label (an issue with both was escalated), `cos` with the Chief of Staff's only. A CLOSED issue is
        never ADDED (#570), and one already kept leaves only when a FRESH read says it is closed (`forget_awaiting`, called by bin/closed_labels.py): a closed
        payload alone, which may be late or replayed after a reopen, never hides an open decision."""
        number = _number(issue)
        if number is None or _is_pr(issue) or not isinstance(issue.get("labels"), list):
            return
        names = {(label.get("name") if isinstance(label, dict) else label) for label in issue["labels"]}
        key = self.awaiting_key(repo, number)
        tier = decision_core.issue_tier(names, awaiting_label(self.config), awaiting_cos_label(self.config))
        with self.lock:
            closed = issue.get("state", "open") == "closed"
            if closed:
                return   # #570: a closed PAYLOAD alone never drops (or adds) an issue, whatever labels it carries (a late, replayed or forged event would hide an open decision):
                         # bin/closed_labels.py reads it fresh and calls forget_awaiting when GitHub says closed; the next catch-up read (open issues only) corrects the rest
            if tier is not None:
                known = self.awaiting.get(key)
                stamp = parse_iso(issue.get("updated_at"))
                since = known["since"] if known else (stamp if stamp is not None else when or self.now())
                # a batch's rows come from the body this payload or listing already carries: no read of their own
                rows = parse_decision_rows(issue["body"]) if "body" in issue else (known or {}).get("rows", [])
                raised = signed_by_fleet(issue["body"]) if "body" in issue and rows else (known or {}).get("raised_by")
                waits = decision_core.parse_waits_for(issue["body"], repo) if "body" in issue else (known or {}).get("waits_for", [])
                self.awaiting[key] = {"title": str(issue.get("title") or ""), "since": since,
                                      "parent": parent_of(issue), "tier": tier, "rows": rows,
                                      "raised_by": raised if rows else None, "closed": closed, "waits_for": waits,
                                      "repo": repo}
            else:
                self.awaiting.pop(key, None)

    def note_pr_event(self, event, repo, payload):
        """A verified `pull_request` event: keep the entry for its PR in memory, with no read at all (#354). Never raises: a bad payload is not kept."""
        try:
            number = (payload.get("pull_request") or {}).get("number") if isinstance(payload, dict) else None
            ref = "%s#%s" % (plan_ledger.normal_repo(repo), number)
            with self.lock:
                made = load_pr_events().entry_for(self.pr_events.get(ref), event, payload, self.now())
                if made is not None:
                    self.pr_events[ref] = made[1]
                    while len(self.pr_events) > PR_STATE_MAX:
                        self.pr_events.pop(min(self.pr_events, key=lambda r: self.pr_events[r].get("at", 0)))
        except Exception as err:
            self._audit("github.rejected", repo, {"reason": "pull_request event not kept: %s" % _one_line(str(err))})

    def pr_event_snapshot(self):
        """A copy of the entries the events made, for the pass that folds them into the picture."""
        with self.lock:
            return {ref: dict(entry) for ref, entry in self.pr_events.items()}

    def note_awaiting_event(self, event, repo, payload):
        """A webhook event that carries an issue: keep the picture current with no read at all."""
        issue = payload.get("issue") if event in ("issues", "issue_comment") else None
        if isinstance(issue, dict):
            self.note_awaiting_issue(repo, issue)
            if event == "issues" and payload.get("action") == "closed":
                self.note_closed_issue(repo, issue)

    def forget_awaiting(self, repo, number):
        """#570: the issue is CLOSED by a fresh read: it leaves the list. (A closed event payload alone never does: see `note_awaiting_issue`.)"""
        with self.lock:
            self.awaiting.pop(self.awaiting_key(repo, number), None)

    def note_closed_issue(self, repo, issue):
        """#570: a verified `issues` closed event for an issue (not a pull request): keep its ref and labels, in memory, for the pass that takes its awaiting labels off
        (bin/closed_labels.py). No read. Never raises."""
        try:
            number = _number(issue)
            if number is None or _is_pr(issue) or not isinstance(issue.get("labels"), list):
                return
            names = sorted({_one_line(str(l.get("name") if isinstance(l, dict) else l), 60) for l in issue["labels"][:30]})
            with self.lock:
                self.closed_issues["%s#%d" % (plan_ledger.normal_repo(repo), number)] = {"labels": names, "at": self.now()}
                while len(self.closed_issues) > PR_STATE_MAX:
                    self.closed_issues.pop(min(self.closed_issues, key=lambda r: self.closed_issues[r]["at"]))
        except Exception as err:   # said, never silent: the issue's awaiting labels would stay on
            self._audit("github.rejected", repo, {"reason": "issues closed event not kept: %s" % _one_line(str(err))})

    def closed_issue_snapshot(self):
        """A copy of the closed-issue events the hub holds, for the pass that cleans their labels."""
        with self.lock:
            return {ref: dict(entry) for ref, entry in self.closed_issues.items()}

    def read_awaiting(self, repo, now=None):
        """The catch-up's read of the open issues with either label: authoritative for `repo`, so an issue that
        lost its label while no forwarder ran is dropped. Two bounded reads per repo (one per label), never one
        per issue. Returns None, or one line saying why it failed."""
        wanted = (("awaiting-user", awaiting_label(self.config)), ("awaiting-cos", awaiting_cos_label(self.config)))
        found = {}
        for name, label in wanted:
            # your label is read with the closed issues too (a closed issue that still carries it still waits on you); the
            # Chief of Staff's label only open ones
            path = "repos/%s/issues?labels=%s&state=%s&per_page=100" % (repo, quote(label, safe=""),
                                                                       "open")   # #570: a closed issue is never listed
            try:
                records, truncated = self.read_pages(path)
            except GitHubUnavailable as err:
                with self.lock:
                    self.awaiting_read[repo] = _one_line(str(err), 200)
                return "%s issues: %s" % (name, self.awaiting_read[repo])
            found[name] = [r for r in records if not _is_pr(r) and _number(r) is not None]
            if truncated:
                self.last_truncated.setdefault("capped_reads", []).append("%s issues" % name)
        with self.lock:
            folded = plan_ledger.normal_repo(repo)
            old = {key: value for key, value in self.awaiting.items() if key[0] == folded}
            self.awaiting = {key: value for key, value in self.awaiting.items() if key[0] != folded}
        for name, label in reversed(wanted):  # your label last: an issue with both is yours
            for record in found[name]:
                self.note_awaiting_issue(repo, dict(record, state="closed" if record.get("state") == "closed" else "open",
                                                    labels=[{"name": label}]), now)
                known = old.get(self.awaiting_key(repo, _number(record)))
                if known:
                    with self.lock:
                        self.awaiting[self.awaiting_key(repo, _number(record))]["since"] = known["since"]
        with self.lock:
            self.awaiting_read[repo] = None
        return None

    def awaiting_listing(self):
        """(records, errors) for the decisions: what the hub knows, and what it could not read."""
        with self.lock:
            names = {plan_ledger.normal_repo(name): name for name in self.watches}   # shown in the configured case, whatever case an event carried
            records = [{"repo": names.get(repo, entry.get("repo") or repo), "number": number, "title": entry["title"], "since": entry["since"],
                        "parent": entry["parent"], "tier": entry["tier"], "rows": entry.get("rows", []),
                        "raised_by": entry.get("raised_by"), "closed": bool(entry.get("closed")),
                        "waits_for": entry.get("waits_for") or []}
                       for (repo, number), entry in sorted(self.awaiting.items())]
            errors = []
            for repo in sorted(self.watches):
                if repo not in self.awaiting_read:
                    errors.append("issues of %s that wait on you are not read yet" % repo)
                elif self.awaiting_read[repo]:
                    errors.append("issues of %s that wait on you could not be read: %s" % (repo, self.awaiting_read[repo]))
        return records, errors

    # -- the read marker: how far each repo was read. Forward only; deleting the file means a fresh start.

    def _load_markers(self):
        try:
            raw = json.loads((self.state_dir / READ_MARKER_FILE).read_text())
        except (OSError, ValueError):
            return {}
        now = self.now()
        found = {}
        for repo, stamp in (raw.items() if isinstance(raw, dict) else []):
            moment = parse_iso(stamp) if isinstance(stamp, str) else None
            if moment is not None:
                found[repo] = min(moment, now)
        return found

    def _set_marker(self, repo, moment):
        with self.lock:
            if moment > self.markers.get(repo, 0):
                self.markers[repo] = moment
                self._markers_dirty = True

    def _save_markers(self):
        """At most once a pass, atomically."""
        with self.lock:
            if not self._markers_dirty:
                return
            body, self._markers_dirty = {repo: iso(moment) for repo, moment in sorted(self.markers.items())}, False
        path = self.state_dir / READ_MARKER_FILE
        tmp = path.with_name(READ_MARKER_FILE + ".tmp")
        try:
            fd = os.open(str(tmp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w") as handle:
                handle.write(json.dumps(body, indent=1, sort_keys=True) + "\n")
            os.replace(str(tmp), str(path))
        except OSError:
            with self.lock:
                self._markers_dirty = True  # a cursor that could not be written is written next pass

    def read_pages(self, path, key=None, timeout=None, older=None, cap=None):
        """One list read, at most GITHUB_PAGE_CAP pages of GITHUB_PAGE_SIZE. Returns (records, truncated). `older`
        is (field, since): a listing newest first stops at the first page that ends before `since`."""
        joiner = "&" if "?" in path else "?"
        records = []
        bounded = not fault("catch-up-blocks-pass")
        number = 0
        while True:
            number += 1
            page = _records(self.gh_api("%s%spage=%d" % (path, joiner, number), paginate=False, timeout=timeout), key)
            records.extend(page)
            if len(page) < GITHUB_PAGE_SIZE:
                return records, False
            if older and isinstance(page[-1].get(older[0]), str) and page[-1][older[0]] < older[1]:
                return records, False
            if bounded and number >= min(GITHUB_PAGE_CAP, cap or GITHUB_PAGE_CAP):
                return records, True

    # -- gh api, and the catch-up read

    def child_env(self, repo):
        """The repo's account's environment for a child, or None for the default account. Raises
        GitHubUnavailable when gh will not give the account's token (the text names the account only)."""
        try:
            config = getattr(self, "config", None)
            refuse_excluded(config if config is not None else getattr(self.accounts, "config", None), repo)   # #446: the forwarder start and every hub read take their environment here
            return self.accounts.env_for(repo)
        except AccountError as err:
            raise GitHubUnavailable(str(err)) from None

    def gh_api(self, path, paginate=True, timeout=None):
        argv = [self.config["gh"], "api"] + (["--paginate"] if paginate else []) + [path]
        named = re.match(r"^repos/([^/]+/[^/]+)/", path)
        env = self.child_env(named.group(1)) if named else None
        extra = {"env": env} if env is not None else {}
        try:
            if named:   # counted, conditional (a 304 costs nothing) and paused while the account is rate limited
                done = self.accounts.read(self.runner, path, named.group(1), timeout or self.config["call_timeout_seconds"], paginate=paginate)
            else:
                done = self.runner(argv, capture_output=True, text=True,
                                   timeout=timeout or self.config["call_timeout_seconds"], **extra)
        except GhRateLimited as err:   # fail closed, on purpose: while the account is paused every hub read says "unavailable" (callers already hold on that); no hub read is exempt
            raise GitHubUnavailable(str(err)) from None
        except AccountError as err:
            raise GitHubUnavailable(str(err)) from None
        except (OSError, subprocess.SubprocessError) as err:
            raise GitHubUnavailable("gh api %s: %s" % (path.split("?")[0],
                                                       self.accounts.scrub(_one_line(str(err))))) from None
        if done.returncode != 0:
            raise GitHubUnavailable("gh api %s failed: %s" % (path.split("?")[0], self.accounts.scrub(
                _one_line(done.stderr or "", 200))))
        try:
            return decode_json_stream(done.stdout or "")
        except ValueError:
            raise GitHubUnavailable("gh api %s answered something that is not JSON" % path.split("?")[0]) from None

    def catch_up_items(self, repo, now, since_epoch=None, cursor=None):
        """The items for everything that changed on `repo` since now - look-back (or `since_epoch`, a later
        time, for a poll that asks only for what is new), keyed exactly as the webhooks are. Returns
        (items, errors): one read failing does not stop the others.

        #494: the reads are steps in a fixed order (comments, issues, pulls, then each pull's reviews and check suites, then the workflow runs).
        `cursor` (a dict, filled in here) remembers which steps are done: when the time budget of the catch-up is spent, or a primary read fails,
        the catch-up stops at that step with `self.last_incomplete` set, and a call with the same cursor continues from it: no step is read twice
        and no step is skipped. A secondary read that fails is best effort (done, as it always was); one the budget stopped is NOT done."""
        since, items, errors, pulls = iso(since_epoch if since_epoch is not None else now - self.lookback), [], [], []
        started, bounded, capped = self.now(), not fault("catch-up-blocks-pass"), []
        if cursor is None:
            cursor = {}
        done = cursor.setdefault("done", set())
        commented = cursor.setdefault("commented", {})
        pulls = cursor.setdefault("pulls", [])
        seconds = source_budget_seconds(self.config, "catch_up")
        stopped, failed = [], []   # `stopped`: the budget is spent, no later step runs in this call; `failed`: a primary read that did not answer (later steps still run)

        def read(key, name, path, rkey=None, older=None):
            """The records of one step, or None when the step is done already or could not run now (the budget is spent, or a primary read failed)."""
            if key in done or stopped:
                return None
            secondary = name in SECONDARY_READS
            until = self._read_backoff.get((repo, name))
            if bounded and until is not None and self.now() < until:
                done.add(key)
                return []  # it was reported when it failed; it is not tried, or reported, again until the backoff ends
            if bounded and seconds and self.now() - started >= seconds:
                errors.append("%s: left to the next catch-up (this one spent its %ds)" % (name, seconds))
                stopped.append(name)
                return None
            try:
                records, truncated = self.read_pages(path, rkey, GITHUB_SUBREAD_TIMEOUT if secondary and bounded else None,
                                                     older)
                if truncated:
                    capped.append(name)
                done.add(key)
                return records
            except GitHubUnavailable as err:
                errors.append("%s: %s" % (name, err))
                if secondary:
                    if bounded:
                        self._read_backoff[(repo, name)] = self.now() + GITHUB_READ_BACKOFF
                    done.add(key)   # best effort: a secondary read is not read again for a window it missed
                    return []
                failed.append(name)   # a primary read that failed: the catch-up goes on from this step next time; the other steps still run
                return None

        def fresh(record, field="updated_at"):
            return isinstance(record.get(field), str) and record[field] >= since

        base = "repos/%s/" % repo
        found = read("comments", "comments", base + "issues/comments?since=%s&per_page=%d" % (since, GITHUB_PAGE_SIZE))
        for comment in [c for c in found or [] if fresh(c)]:
            number = _url_number(comment.get("issue_url"))
            commented[number] = max(commented.get(number, ""), comment["updated_at"])
            items.append(_comment_item(repo, comment, None, now))
        for issue in read("issues", "issues", base + "issues?state=all&since=%s&per_page=%d" % (since, GITHUB_PAGE_SIZE)) or []:
            if _is_pr(issue) or not fresh(issue):
                continue
            if issue["updated_at"] <= commented.get(_number(issue), ""):
                continue  # a comment bumped it; the comment is the news
            items.append(_issue_item(repo, issue, now))
        found = read("pulls", "pulls", base + "pulls?state=all&sort=updated&direction=desc&per_page=%d" % GITHUB_PAGE_SIZE,
                     older=("updated_at", since))
        for pr in [x for x in found or [] if fresh(x)]:
            pulls.append(pr)
            items.append(_pr_item(repo, pr, now))
            items.append(_pr_conflict(repo, pr, now))
        for pr in list(pulls):
            number = _number(pr)
            for review in read(("reviews", number), "reviews", base + "pulls/%d/reviews?per_page=100" % number) or []:
                if fresh(review, "submitted_at"):
                    items.append(_review_item(repo, review, pr, now))
            sha = (pr.get("head") or {}).get("sha")
            for suite in (read(("checks", number), "check suites", base + "commits/%s/check-suites?per_page=100" % sha,
                               "check_suites") if sha else []) or []:
                if fresh(suite):
                    items.append(_check_item(repo, dict(suite, pull_requests=suite.get("pull_requests") or [
                        {"number": number}]), now, "", "check suite"))
        for run in read("runs", "workflow runs", base + "actions/runs?per_page=%d" % GITHUB_PAGE_SIZE, "workflow_runs") or []:
            if fresh(run):
                items.append(_check_item(repo, run, now, "run-", "workflow %s" % (run.get("name") or "run")))
        self.last_failed_primary = bool(failed)
        self.last_incomplete = bool(stopped or failed)   # #494: a step is still to do: the caller keeps the cursor and the marker where they are
        items = [item for item in items if item is not None]
        skipped = 0
        if bounded and len(items) > GITHUB_CATCHUP_ITEMS:
            skipped = len(items) - GITHUB_CATCHUP_ITEMS
            errors.append("items: kept the newest %d of %d" % (GITHUB_CATCHUP_ITEMS, len(items)))
            items = sorted(items, key=lambda item: item.created)[-GITHUB_CATCHUP_ITEMS:]
        self.last_truncated = {"capped_reads": capped, "items_skipped": skipped} if capped or skipped else {}
        return items, errors

    def catch_up(self, watch, now, polled=False):
        """The catch-up read, forward only. A repo with no read marker is not read at all (no history): its marker is
        set to now and it moves on with live events. With a marker, only the gap is read: from the marker (minus a
        little slack) to now, never further back than the look-back. The marker moves to the start of each catch-up
        whose primary reads (comments, issues, pulls) all answered; secondary reads (reviews, check suites,
        workflow runs) are best-effort and are not read again for a window they missed."""
        repo = watch.repo
        with self.lock:
            marker = self.markers.get(repo)
            self.prune_cursors()   # a stale cursor of a repo no longer watched (or excluded) is never read from
        items, errors, self.last_truncated, self.last_incomplete, self.last_failed_primary = [], [], {}, False, False
        cursor = self._cursors.get(repo)   # #494: the steps an earlier call of this catch-up finished: they are not read again
        fresh_start = marker is None and not fault("catch-up-on-fresh-start")
        if not fresh_start:
            floor, slack = now - self.lookback, (2 * self.config["github_poll_seconds"] if polled else GITHUB_MARKER_SLACK)
            start = floor if marker is None or (fault("full-window-every-time") and not polled) else marker - slack
            if start < floor:
                start = floor
                if marker is not None and marker < floor:
                    self._audit("github.catch_up.skipped", repo, {"marker": iso(marker), "reads_from": iso(floor),
                                                                   "why": "older than the look-back: older events were skipped"})
            if cursor is None:
                cursor = self._cursors[repo] = {"since_epoch": start, "until": now, "stops": 0}   # the window is fixed until it is read whole
            items, errors = self.catch_up_items(repo, now, cursor["since_epoch"], cursor)
        incomplete = self.last_incomplete
        primary_failed = self.last_failed_primary   # a primary read that did not answer (a budget stop is not a failure)
        stopped_by_time = incomplete and not primary_failed
        problem = None if stopped_by_time else self.read_awaiting(repo, now)  # PR 14: current state, not events: read on a fresh start too (once the window is read: not again on every resume)
        if problem:
            errors.append(problem)
        if cursor is not None and stopped_by_time:   # #494: stopped by the budget part way: the marker stays, the cursor keeps what was read, the rest is read next time
            cursor["stops"] += 1
            if cursor["stops"] >= GITHUB_CATCHUP_STUCK_PASSES:
                errors.append("catch-up not finished after %d passes (the window since %s is still being read)" % (cursor["stops"], iso(cursor["since_epoch"])))
        elif primary_failed:
            self._cursors.pop(repo, None)   # a read that did not answer: the window is read again whole from the marker, as it always was
        else:
            # the whole window was read: the marker moves over it, never past it (a window read over several calls: to where its first call began, which no step is older than)
            self._set_marker(repo, cursor["until"] if cursor is not None and cursor["stops"] else now)
            self._cursors.pop(repo, None)
        self.enqueue(items)
        said = "; ".join(errors) if errors else None
        with self.lock:
            changed = items or said != watch.catch_up_error or watch.last_catch_up is None
            watch.last_catch_up = now
            watch.catch_up_error = said
            retry = now + GITHUB_LOOKUP_RETRY
            watch.catchup_at = retry if (primary_failed or problem) and not polled else None  # best-effort reads are not retried
            if incomplete and not primary_failed:
                watch.catchup_at = now   # #494: only the time budget stopped it: the next pass goes on at once
        if self.last_truncated:
            self._audit("github.catch_up.truncated", repo, dict(self.last_truncated, marker_advanced=not primary_failed))
        if not polled or changed:  # a quiet poll every minute is not worth an audit line
            self._audit("github.catch_up", repo, {"keys": [item.key for item in items[:GITHUB_AUDIT_KEYS]],
                                                  "count": len(items), "errors": errors, "polled": polled,
                                                  "fresh_start": fresh_start})

    # -- the supervisor

    def tick(self):
        """One supervisor step for every watch: reap, restart with backoff, catch up."""
        now = self.now()
        for watch in list(self.watches.values()):
            try:
                self._tick_watch(watch, now)
            except Exception as err:
                with self.lock:
                    watch.last_error = self.accounts.scrub(_scrub(_one_line(str(err)), watch.secret))
                self._audit("github.error", watch.repo, {"error": watch.last_error})
        self._save_markers()
        engine = getattr(self, "engine", None)
        if engine is not None:
            set_source_state(engine, "catch_up", self.catching_up())
        self._write_snapshot(now)

    def catching_up(self):
        """#494: the repos whose catch-up window is not read whole yet, each with the passes it has taken ([] when every catch-up is done)."""
        with self.lock:
            self.prune_cursors()   # only repos watched now and not excluded
            return ["%s (%d pass%s)" % (repo, c.get("stops", 0), "" if c.get("stops", 0) == 1 else "es") for repo, c in sorted(self._cursors.items())]

    def _tick_watch(self, watch, now):
        if self.watches.get(watch.repo) is not watch:
            return  # PR 15: it left the watched set after this tick took its copy of the list
        if watch.proc is not None:
            code = watch.proc.poll()
            if code is not None:
                self._exited(watch, code, now)
            elif watch.failures and now - watch.started >= GITHUB_STABLE:
                watch.failures = 0
            if watch.proc is not None and watch.polling and now - watch.started >= self.catchup_delay:
                with self.lock:  # the forwarder connected: the repo is no longer polled; one read closes the gap
                    watch.polling, watch.poll_reason, watch.catchup_at = False, None, now
        if watch.proc is None and now >= watch.next_start:
            self._start(watch, now)
        if watch.polling and now >= watch.next_poll:
            with self.lock:
                watch.next_poll = now + self.config["github_poll_seconds"]
            self.catch_up(watch, now, polled=True)
            with self.lock:
                watch.last_poll = now
        if watch.catchup_at is not None and now >= watch.catchup_at:
            self.catch_up(watch, now)

    def argv_for(self, watch):
        url = "http://127.0.0.1:%d/github" % self.port
        return [self.config["gh"], "webhook", "forward", "--repo=%s" % watch.repo,
                "--events=%s" % ",".join(self.config["github_events"]), "--url=%s" % url,
                "--secret=%s" % watch.secret]

    def log_path(self, watch):
        directory = self.state_dir / "logs"
        directory.mkdir(mode=0o700, exist_ok=True)
        return directory / ("forward-%s.log" % watch.repo.replace("/", "-"))

    def _start(self, watch, now):
        try:
            env = self.child_env(watch.repo)
        except GitHubUnavailable as err:
            self._failed(watch, now, str(err))
            return
        secret = secrets.token_hex(32)  # a new one for every start; memory and argv only
        with self.lock:
            watch.secret = secret
        try:
            proc = self.spawn(self.argv_for(watch), self.log_path(watch), **({"env": env} if env is not None else {}))
        except OSError as err:
            with self.lock:
                watch.secret = None
            self._failed(watch, now, "cannot start %s: %s" % (self.config["gh"], _one_line(str(err), 200)))
            return
        with self.lock:
            watch.proc, watch.started, watch.starts = proc, now, watch.starts + 1
            watch.state, watch.next_start, watch.down_since = "running", now, None
            watch.catchup_at = None if watch.polling else now + self.catchup_delay  # a polled repo is read already
        self._audit("github.watch", watch.repo, {"state": "running", "starts": watch.starts})

    def _log_tail(self, watch):
        try:
            with open(str(self.log_path(watch)), "rb") as handle:
                handle.seek(0, os.SEEK_END)
                handle.seek(max(0, handle.tell() - 4096))
                return handle.read().decode("utf-8", "replace")
        except OSError:
            return ""

    def _exited(self, watch, code, now):
        tail = _scrub(self._log_tail(watch), watch.secret)
        with self.lock:
            watch.proc, watch.secret = None, None
            ran = max(0.0, now - (watch.started or now))
            watch.drops = [d for d in watch.drops if now - d[0] < FORWARDER_HISTORY_SECONDS] + [(now, ran)]
            watch.down_since = now
        if CONFLICT_TEXT in tail:
            with self.lock:
                watch.state, watch.next_start = "conflict", now + self.conflict_retry
                watch.last_error = "someone else is already forwarding %s (%s); catch-up reads continue" % (
                    watch.repo, CONFLICT_TEXT)
            self._audit("github.watch", watch.repo, {"state": "conflict", "retry_in": self.conflict_retry})
            return
        lines = [line for line in tail.splitlines() if line.strip()]
        reason = "exited with code %s%s" % (code, ": " + _one_line(forwarder_reason_line(lines), 200) if lines else "")
        if now - (watch.started or now) >= GITHUB_STABLE:
            watch.failures = 0
        unwatchable = unwatchable_reason(tail)
        if unwatchable:  # PR 15: no webhook can be made here, so the repo is read on a poll instead
            with self.lock:
                if not watch.polling:
                    watch.polling, watch.next_poll = True, now
                watch.poll_reason = unwatchable
        self._failed(watch, now, reason)

    def _failed(self, watch, now, reason):
        with self.lock:
            watch.failures += 1
            if watch.down_since is None:  # a spawn that failed never ran, so _exited did not set it
                watch.down_since = now
            delay = min(self.backoff_max, self.backoff_base * 2 ** (watch.failures - 1))
            watch.state, watch.next_start, watch.last_error = "backoff", now + delay, reason
        self._audit("github.watch", watch.repo, {"state": "backoff", "failures": watch.failures,
                                                 "retry_in": delay, "reason": reason})

    # -- status

    def describe(self):
        with self.lock:
            return {"port": self.port, "lookback_hours": self.lookback / 3600.0,
                    "poll_seconds": self.config["github_poll_seconds"],
                    "watches": [dict(w.to_json(), account=self.accounts.describe(w.repo),
                                     read_marker=iso(self.markers.get(w.repo)) if w.repo in self.markers else None)
                                for _, w in sorted(self.watches.items())]}

    def _write_snapshot(self, now, stopped=False):
        """A copy of `describe()` for `status`, which runs in another process. No secret,
        no events; deleting it loses nothing."""
        body = dict(self.describe(), pid=None if stopped else os.getpid())
        text = json.dumps(body, sort_keys=True)
        if text == self._snapshot:
            return
        self._snapshot = text
        path = self.state_dir / WATCH_FILE
        tmp = path.with_name(WATCH_FILE + ".tmp")
        fd = os.open(str(tmp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as handle:
            handle.write(json.dumps(dict(body, updated=iso(now)), sort_keys=True))
        os.replace(str(tmp), str(path))


def _header(headers, name):
    """A header from an http.server message or a plain dict, any case."""
    if hasattr(headers, "get") and not isinstance(headers, dict):
        return headers.get(name)
    lowered = name.lower()
    return next((v for k, v in headers.items() if k.lower() == lowered), None)


def attach_github(engine, config, state_dir, runner, now):
    """The daemon's hub (PR 15: always; the repos it watches are derived on every pass, and with none it opens
    nothing). SIGTERM becomes a clean stop."""
    hub = GitHubHub(config, state_dir, engine.audit, runner, spawn_forwarder, now, engine.actor)
    hub.attach(engine)

    def terminate(*_):
        raise KeyboardInterrupt
    signal.signal(signal.SIGTERM, terminate)
    return hub


def github_status(config, state_dir, fleets=None, now=None):
    """What `status` says about GitHub: the repos watched (the config's and every live agent's, PR 15), how each
    is watched by the daemon's last snapshot, the gh account it uses (a name, never a token) and the fleet
    agents in it."""
    repos = watched_repos(config, fleets or {})
    excluded = sorted(load_module("repo_exclusion").excluded_set(config))
    report = {"repos": repos, "excluded": excluded, "lookback_hours": config["github_lookback_hours"],
              "events": list(config["github_events"]), "daemon": False, "watches": [], "port": None,
              "poll_seconds": config["github_poll_seconds"]}
    snapshot = {}
    try:
        snapshot = json.loads((Path(state_dir) / WATCH_FILE).read_text())
    except (OSError, ValueError):
        pass
    pid = snapshot.get("pid")
    try:
        if isinstance(pid, int):
            os.kill(pid, 0)
            report["daemon"] = True
    except ProcessLookupError:
        pass
    except OSError:
        report["daemon"] = True  # alive, but not ours to signal
    if snapshot:
        report["port"] = snapshot.get("port")
        report["updated"] = snapshot.get("updated")
        report["watches"] = [w for w in snapshot.get("watches", []) if w.get("repo") in repos]
    accounts = GhAccounts(config)
    by_repo = {w["repo"]: w for w in report["watches"]}
    members = {}
    for name, fleet in sorted((fleets or {}).items()):
        repo = _fleet_repo(fleet, config)
        if repo:
            members.setdefault(repo, []).append(name)
    report["detail"] = []
    for repo in repos:
        watch = by_repo.get(repo) if report["daemon"] else None
        how = "unknown" if not report["daemon"] else (watch.get("mode") or watch["state"] if watch else "not yet")
        why = None
        if watch:
            why = "; ".join(x for x in (watch.get("poll_reason"), watch.get("last_error"),
                                        watch.get("catch_up_error")) if x) or None
        marker = parse_iso(watch.get("read_marker")) if watch and watch.get("read_marker") else None
        age = max(0, (time.time() if now is None else now) - marker) if marker is not None else None
        current = time.time() if now is None else now
        health = forwarder_health(watch, current) if watch else None
        if health and health["live"]:
            why = watch.get("poll_reason") or None  # a recovered drop is history, not an error
        report["detail"].append({"repo": repo, "how": how, "account": accounts.describe(repo),
                                 "agents": members.get(repo, []), "why": why, "read_age": age, "health": health})
    return report


def format_github(report):
    """Status lines for GitHub; none when no repo is watched and none is excluded."""
    excluded = ["      github     excluded from watching and reading: %s (excluded_repos)" % ", ".join(report["excluded"])] if report.get("excluded") else []
    if not report["repos"]:
        return excluded
    lines = excluded + ["      github     watching %s; catch-up reads reach back %g h, older events are lost"
             % (", ".join(report["repos"]), report["lookback_hours"])]
    if not report["daemon"]:
        lines.append("        daemon not running: forwarder state is unknown")
    watches = {w["repo"]: w for w in report["watches"]}
    for entry in report.get("detail", []):
        watch = watches.get(entry["repo"]) if report["daemon"] else None
        how = entry["how"]
        if how in ("polling", "failed"):
            how += " every %gs" % report.get("poll_seconds", 60) if how == "polling" else ""
        line = "        %-24s %s" % (entry["repo"], how)
        if watch and watch["state"] == "conflict":
            line += " (someone else is forwarding; catch-up reads only)"
        if watch and watch["failures"] and not (entry.get("health") or {}).get("live"):
            line += ", %d failure(s)" % watch["failures"]
        health = entry.get("health")
        if health and health["live"]:
            line += ", live, up %s" % format_age(health["up_age"] or 0)
        elif health and health["down_age"] is not None and not health.get("quiet"):
            line += ", down %s" % format_age(health["down_age"])
        line += "  account %s" % entry["account"]
        if health and health["drops_hour"]:
            line += "  last drop %s ago, %d in the last hour" % (format_age(health["last_drop_age"]), health["drops_hour"])
        if watch:  # for a live forwarder this is only the last catch-up read, not how fresh events are
            label = "catch-up read to" if entry["how"] == "forwarder" else "read to"
            line += "  %s %s ago" % (label, format_age(entry["read_age"])) if entry.get("read_age") is not None \
                else "  not read yet"
        if health and health["alarm"]:
            line += "  ALARM: forwarder %s" % health["alarm"]
        line += "  agents: %s" % (", ".join(entry["agents"]) or "none")
        if entry["why"]:
            line += "  [%s]" % entry["why"]
        lines.append(line)
    return lines


# --------------------------------------------------------------------- the CLI

def _check(probe):
    """Run one probe. Returns (ok, one line). Never raises, never a traceback."""
    try:
        return True, probe()
    except (V2Error, HerdrError, ConfigError, FaultError) as err:
        return False, _one_line(str(err))
    except Exception as err:  # status must always answer; say what broke in one line
        return False, _one_line("unexpected %s: %s" % (type(err).__name__, err))


def _v2_summary(info):
    version = info.get("version") if isinstance(info, dict) else None
    return "server.info answered%s" % (", version %s" % version if version else "")


def collect_status(runner=subprocess.run, now=time.time, platform=None):
    report = {"version": VERSION}
    path = config_path()
    UNKNOWN_CONFIG.clear()   # what this status finds in this file, not what an earlier load in the process found
    config_ok, config = _check(lambda: load_config(path))
    report["config"] = {"path": str(path), "exists": path.exists(), "ok": config_ok}
    if config_ok:
        report["config"].update({
            "opencode": config["opencode"],
            "opencode_env": sorted(config["opencode_env"]),  # names only, never values
            "opencode_executable": config["opencode_executable"],
            "launch_env": sorted(config["launch_env"]),
            "herdr": config["herdr"],
            "batch_seconds": config["batch_seconds"],
            "engaged_minutes": config["engaged_minutes"],
            "call_timeout_seconds": config["call_timeout_seconds"],
            "poll_seconds": config["poll_seconds"],
        })
    else:
        report["config"]["error"] = config
    report["config"]["unknown_keys"] = unknown_config_lines()   # found by the load above (warned, ignored)

    state_ok, state = _check(lambda: str(ensure_state_dir()))
    report["state_dir"] = {"path": str(state_dir_path()), "ok": state_ok}
    if not state_ok:
        report["state_dir"]["error"] = state

    faults_ok, faults = _check(active_faults)
    report["lab"] = {"on": os.environ.get(LAB_ENV) == "1", "ok": faults_ok}
    if faults_ok:
        report["lab"]["faults"] = faults
    else:
        report["lab"]["error"] = faults

    agents = {"ok": False, "error": "not checked: v2 and herdr must both answer"}
    if config_ok:
        herdr = HerdrClient(config["herdr"], runner)
        v2 = None
        if config["opencode"] is None:
            v2_ok, v2_line = False, ("not configured: set 'opencode' in %s to the absolute path of "
                                     "the OpenCode v2 binary" % config_path())
        else:
            v2 = V2Client(config["opencode"], config["opencode_env"], runner, config["call_timeout_seconds"], transport=config["v2_transport"])
            v2_ok, v2_line = _check(lambda: _v2_summary(v2.server_info()))
        herdr_ok, entries = _check(herdr.agent_list)
        herdr_line = "%d agent(s)" % len(entries) if herdr_ok else entries
        if v2_ok and herdr_ok and state_ok and faults_ok:
            engine = Switchboard(config, v2, herdr, None, fact_sources(state), now,
                                 intents=intent_reader_for(config, runner, now))
            engine.headless_state = Path(state)   # read-only: the headless records are listed, and `status` still writes nothing
            agents_ok, overview = _check(lambda: fleet_overview(engine, entries))
            agents = overview if agents_ok else {"ok": False, "error": overview}
    else:
        v2_ok, v2_line = False, "not checked: config unusable"
        herdr_ok, herdr_line = False, "not checked: config unusable"
    report["v2"] = {"ok": v2_ok, ("detail" if v2_ok else "error"): v2_line}
    report["herdr"] = {"ok": herdr_ok, ("detail" if herdr_ok else "error"): herdr_line}
    report["agents"] = agents  # informational: an agent's trouble is not the switchboard's
    if config_ok and state_ok:
        fleets = {entry["observation"]["name"]: entry["observation"].get("fleet") or {}
                  for entry in (agents.get("list") or []) if agents.get("ok") and entry.get("observation")}
        report["github"] = github_status(config, state, fleets, now())
        report["testers"] = testers_status(config, agents, fleets, state)   # #372
    if state_ok:
        report["decisions"] = decisions_summary(state, now)
        report["v2_calls"] = v2_calls_status(state, now())
        report["github_calls"] = github_calls_status(state, now()) + agent_calls.status_lines(str(state), now()) + agent_calls.usage_lines(str(state), now())   # #367
        if config_ok and disk_guard_settings(config) is not None:
            report["disk"] = disk_status_line(config, state)   # one stat of the volume
        if config_ok:
            sg = load_module("spotlight_guard")
            spot_cfg = sg.settings(config.get("spotlight_guard"))
            if spot_cfg is not None:
                report["spotlight"] = sg.status_lines(spot_cfg, sg.load(state), now())   # the file the hourly background check wrote: no process
        if config_ok:
            cg = load_cpu_guard()
            cpu_cfg = cg.settings(config.get("cpu_guard"))
            if cpu_cfg is not None:
                report["cpu"] = cg.status_line(cpu_cfg, cg.reading(), cg.slots_text(config, state))   # a system call (and the optional heavy_slots module): no process
                report["mem"] = cg.mem_status_line(cg.memory_reading(), cg.biggest_holders(cg.process_table()))   # the kernel's counters and process table: no process
        if config_ok:
            report["orphans"] = orphan_status_line(config)   # one `ps`; None when there is none or the reaper is off
        if config_ok and config.get("v2_light"):
            try:
                unknown = SentLedger(state).unknown_count()
                ledger = "; %d send(s) of unknown fate, counted as delivered (sent-keys.json)" % unknown if unknown else ""
            except V2Error as err:   # status never crashes on a bad state file: it says the ledger is unusable and that the sends are stopped
                ledger = "; sent-keys ledger: UNREADABLE (sends stopped: fail closed): %s" % _one_line(str(err), 160)
            report["v2_light"] = "ON (features off: %s)%s" % ("; ".join(V2_LIGHT_OFF), ledger)
        report["sweep"] = sweep_summary(state)  # #117
        report["triage"] = triage_summary(state)  # #130
        report["ci_record"] = ci_record_status_line(state, now())
        if config_ok:
            reconcile_agents_on_read(state, herdr)   # the view checks right now and removes a dead agent through the registry (#919)
        report["pane_lines"] = pane_health_status_lines(state, now()) + headless_route_status_lines(state)
        report["catching_up"] = catching_up_lines(state, now())
        report["v2_link"] = v2_link_status_line(state, now())
        if config_ok:
            report["friction"] = friction_status_line(config, state)
            report["load"] = load_fleet_health().status_lines(state, now())
        report["stopped_news"] = stopped_news_summary(state, now())
        line = external_status_line(config, state, now()) if config_ok else None
        if line is not None:   # only when external decisions are on: off prints nothing
            report["external"] = {"line": line}
            work_line = work_status_line(config, state, now())
            if work_line is not None:
                report["external"]["work_line"] = work_line
    skills_ok, skills_text = skills_status_line()
    report["skills"] = {"ok": skills_ok, "detail": skills_text}   # read only
    report["cos_orders"] = cos_orders_summary(config if config_ok else None)  # PR 18
    report["plan_gates"] = plan_gates_status(config if config_ok else None, state if state_ok else None, now()) if state_ok else None
    if config_ok and state_ok:
        working = sum(1 for entry in (agents.get("list") or []) if agents.get("ok") and entry.get("observation")
                      and entry["observation"]["status"] == "working")
        report["policy"] = policy_liveness(config, state_dir_path(), working, now())
    report["daemon"] = daemon_report(state_dir_path()) if state_ok else {"running": False, "pid": None, "key_source": None}
    report["service"] = service_report(platform)
    report["key"] = key_report(config if config_ok else None, report["daemon"], report["service"])   # PR 16
    report["plugin"] = plugin_report(config, runner) if config_ok else {"state": "unknown", "detail": "config unusable"}
    report["ok"] = all(report[part]["ok"] for part in ("config", "state_dir", "lab", "v2", "herdr", "skills"))
    return report


def identity_overview(discovery):
    """{"sessions": [{"session", "name", "pane"}], "warnings": [...]}: the agent each live session resolves to, and
    every place where the pane and the session disagree: one session shown in two panes, a name claimed by two sessions,
    a pane whose herdr label is not the fleet name of its session. (The caller's own shell is `caller_identity`.)"""
    sessions = [{"session": seen.session_id, "name": seen.name, "pane": seen.pane}
                for seen in sorted(discovery.agents.values(), key=lambda o: o.name)]
    warnings, panes, by_session = [], {}, {}
    for seen in discovery.agents.values():
        by_session[seen.session_id] = seen
        if seen.conflict:
            warnings.append("%s is claimed by more than one session (%s): an agent cannot be told from another"
                            % (seen.name, ", ".join([seen.session_id] + seen.conflict)))
    for entry in discovery.entries:
        session, pane = agent_session(entry), entry.get("pane_id")
        if session and isinstance(pane, str):
            panes.setdefault(session, []).append(pane)
            seen = by_session.get(session)
            label = next((entry.get(k) for k in ("name", "agent_name", "label") if isinstance(entry.get(k), str)), None)
            if seen is not None and label and label != seen.name:
                warnings.append("pane %s is labelled %s in herdr but its session %s is the fleet agent %s"
                                % (pane, label, session, seen.name))
    for session, where in sorted(panes.items()):
        if len(where) > 1 and session in by_session:
            warnings.append("session %s (%s) is shown in %d panes (%s): the pane does not say who is calling"
                            % (session, by_session[session].name, len(where), ", ".join(sorted(where))))
    return {"sessions": sessions, "warnings": warnings}


def caller_identity(herdr, v2, environ):
    """What THIS shell resolves to, for `status`: the agent name, an `identity uncertain` refusal, or None for a shell
    that names neither a pane nor a session (a person's)."""
    if not environ.get("HERDR_PANE_ID") and not environ.get(SESSION_ENV):
        return None
    try:
        return {"name": identify_caller(herdr, v2, environ)}
    except CallerError as err:
        return {"error": _one_line(str(err), 400)}
    except (V2Error, HerdrError) as err:
        return {"error": _one_line("cannot read: %s" % err, 200)}


def fleet_overview(engine, entries):
    """Read-only: every fleet agent and every fact recipient, with the rule's answer for each."""
    discovery = engine.discover(engine.now(), entries)
    facts, problems = engine.collect_facts()
    names = sorted(set(discovery.agents) | {fact.recipient for fact in facts})
    overview = {"ok": True, "problems": discovery.problems + problems,
                "list": [engine.pending(name, discovery, facts) for name in names],
                "identity": identity_overview(discovery),
                "caller": caller_identity(engine.herdr, engine.v2, os.environ)}
    overview.update(intent_gap_report(engine, discovery, facts))
    return overview


def _plan_line(entry):
    plan, riders = entry["plan"], entry.get("riders") or []
    if plan is None:
        return ("nothing pending; %d rider(s) wait for a message to ride in" % len(riders)) if riders \
            else "nothing pending"
    waiting = sum(1 for fact in plan["pending"] if fact.get("rider"))
    return "%d pending%s: %s (%s)" % (len(plan["pending"]), " (%d rider)" % waiting if waiting else "",
                                      plan["action"], plan["reason"])


def identity_lines(agents):
    """The `status` lines for identity: who each live session resolves to, a WARNING for every disagreement of pane and
    session, and what this shell itself resolves to."""
    identity = agents.get("identity") or {}
    lines = []
    if identity.get("sessions"):
        lines.append("      identity   " + "; ".join("%s = %s (pane %s)" % (s["session"], s["name"], s["pane"] or "-")
                                                      for s in identity["sessions"]))
    lines.extend("      WARNING    identity: %s" % w for w in identity.get("warnings") or [])
    caller = agents.get("caller")
    if caller:
        lines.append("      identity   this shell: %s" % (caller["name"] if "name" in caller else "WARNING " + caller["error"]))
    return lines


def _agent_line(entry):
    seen = entry["observation"]
    if seen is None:
        return "%-14s (not found)  %s" % (entry["name"], _plan_line(entry))
    return "%-14s %-8s %s  pane %s  your last prompt %s  %s" % (
        seen["name"], seen["status"], seen["session"], seen["pane"] or ("(headless)" if seen.get("headless") else "-"),
        seen["last_human_prompt"] or "not in the window", _plan_line(entry))


def sweep_status_lines(sweep):
    """The `status` lines for the daemon's last sweep (empty until it has swept): counts by kind, what is deferred and
    why, and how many findings could not be checked."""
    if not sweep:
        return []
    parts = ", ".join("%s %d" % (k, n) for k, n in sorted(sweep["counts"].items())) or "none"
    lines = ["      sweep      %s: %s finding(s) (%s)%s" % (
        ("on" if sweep.get("enabled") else "shadow (audit only)") + " as of " + str(sweep.get("at", "?")),
        sweep.get("total", 0), parts,
        "; lists capped for " + ", ".join(sweep["truncated"]) if sweep.get("truncated") else "")]
    for item in sweep.get("deferred") or []:
        lines.append("      sweep      S3 %s for %s since %s: %s" % (
            "NOT deferred any more (overdue), running on the fresh check alone" if item.get("overdue") else "deferred",
            "every repo" if item["for"] == "*" else item["for"], item["since"], item["why"]))
    if sweep.get("unattributed"):
        lines.append("      sweep      %d comment(s) say it waits but name only refs outside the watched repos: not "
                     "attributed to their own item" % sweep["unattributed"])
    if sweep.get("unchecked"):
        lines.append("      sweep      %d finding(s) not checked this pass (call budget or a failed read): neither "
                     "raised nor audited" % sweep["unchecked"])
    return lines


def format_status(report):
    def mark(part):
        return "ok   " if part["ok"] else "ERROR"

    config = report["config"]
    lines = [report["key"]["notice"]] if report["key"]["notice"] else []  # PR 16: the danger comes first
    lines.append("%s %s" % (PROG, report["version"]))
    if config["ok"]:
        lines.append("%s config     %s%s" % (mark(config), config["path"],
                                             "" if config["exists"] else " (not present; defaults)"))
        lines.append("      opencode   %s  env: %s" % (config["opencode"] or "(not configured)",
                                                       ", ".join(config["opencode_env"]) or "none"))
        if config["opencode_executable"]:
            lines.append("      process    %s (what a pane must run)" % config["opencode_executable"])
        lines.append("      herdr      %s" % config["herdr"])
        lines.append("      timing     batch %ss, engaged %s min, call timeout %ss, poll %ss"
                     % (config["batch_seconds"], config["engaged_minutes"], config["call_timeout_seconds"],
                        config["poll_seconds"]))
    else:
        lines.append("%s config     %s" % (mark(config), config["error"]))
    for note in config.get("unknown_keys", ()):
        lines.append("WARN  config     %s" % note)
    lines.extend(format_config_lines(report.get("daemon")))  # PR 16: the daemon's own account of its config
    state = report["state_dir"]
    lines.append("%s state      %s" % (mark(state), state["path"] if state["ok"] else state["error"]))
    lab = report["lab"]
    if lab["ok"]:
        lab_line = "on" if lab["on"] else "off"
        if lab["faults"]:
            lab_line += ", faults requested: %s%s" % (", ".join(lab["faults"]), "" if lab["on"] else " (ignored outside the Lab)")
    else:
        lab_line = lab["error"]
    lines.append("%s lab        %s" % (mark(lab), lab_line))
    for name in ("v2", "herdr"):
        part = report[name]
        lines.append("%s %-10s %s" % (mark(part), name, part["detail"] if part["ok"] else part["error"]))
    agents = report["agents"]
    if agents["ok"]:
        listed = [entry for entry in agents["list"] if entry["observation"]]
        lines.append("      agents     %d fleet agent(s)" % len(listed))
        lines.extend("        " + _agent_line(entry) for entry in agents["list"])
        lines.extend("        problem: %s" % problem for problem in agents["problems"])
        lines.extend(identity_lines(agents))
        lines.extend(intent_gap_lines(agents))
    else:
        lines.append("      agents     %s" % agents["error"])
    lines.extend(format_github(report["github"]) if "github" in report else [])
    lines.extend(format_decisions_status(report["decisions"]) if "decisions" in report else [])
    lines.extend(report.get("catching_up") or [])   # #467 slice 3
    lines.extend("      disk       " + report["disk"] for _ in [0] if report.get("disk"))
    lines.extend("      cpu        " + report["cpu"] for _ in [0] if report.get("cpu"))
    lines.extend("      mem        " + report["mem"] for _ in [0] if report.get("mem"))
    lines.extend("      spotlight  " + text for text in report.get("spotlight") or [])
    lines.extend("      orphans    " + report["orphans"] for _ in [0] if report.get("orphans"))
    lines.extend("      v2 calls   " + report["v2_calls"] for _ in [0] if report.get("v2_calls"))
    lines.extend("      " + text for text in report.get("github_calls") or [])
    lines.extend("      v2_light   " + report["v2_light"] for _ in [0] if report.get("v2_light"))
    lines.extend(sweep_status_lines(report.get("sweep")))  # #117
    lines.extend(report.get("testers") or [])   # #372
    lines.extend(triage_status_lines(report.get("triage")))  # #130
    lines.extend("      " + report["ci_record"] for _ in [0] if report.get("ci_record"))
    lines.extend(report.get("pane_lines") or [])
    lines.extend("      " + report["v2_link"] for _ in [0] if report.get("v2_link"))
    lines.extend("      " + report["friction"] for _ in [0] if report.get("friction"))
    lines.extend("      " + line for line in report.get("load") or [])   # #348
    counts = report.get("stopped_news")
    if counts:  # #96: only when the judge ran in the last hour
        lines.append("      stopped    %d note(s) judged for news in the last hour: %d dropped, %d would be dropped (shadow)"
                     % (counts["judged"], counts["dropped"], counts["would_drop"]))
    lines.extend("      " + report["external"]["line"] for _ in [0] if "external" in report)
    lines.extend("      " + report["external"]["work_line"] for _ in [0] if "external" in report and "work_line" in report["external"])
    lines.extend(format_cos_orders_status(report["cos_orders"]) if "cos_orders" in report else [])  # PR 18
    lines.extend("      " + line for line in ((report.get("plan_gates") or {}).get("lines") or []))  # #107
    lines.extend("      " + report["policy"]["line"] for _ in [0] if "policy" in report)
    lines.extend(format_install_lines(report))  # PR 16
    if "skills" in report:
        lines.append("%s skills     %s" % (mark(report["skills"]), report["skills"]["detail"]))
    return "\n".join(lines)


def cmd_status(args, runner=subprocess.run, now=time.time):
    report = collect_status(runner, now)
    try:
        cloud_lines, cloud_rows = load_module("cloud_worker").bind(globals()).status_extra(runner)   # cloud workers (#371): nothing when there are none
    except Exception as err:   # the module missing or broken must not take `status` down for a local-only fleet
        cloud_lines, cloud_rows = ["      cloud workers: unavailable (%s)" % _one_line(str(err), 100)], []
    if cloud_rows:
        report["cloud"] = cloud_rows
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print(format_status(report))
        if cloud_lines:
            print("\n".join(cloud_lines))
    return EXIT_OK if report["ok"] else EXIT_ERROR


cmd_status.direct = True   # no error mapping, no daemon start


class CallerError(Exception):
    """`send` cannot tell which fleet agent is calling."""


class IdentityUncertain(CallerError):
    """The caller's own session is not one the switchboard knows, so who is calling cannot be told. Refused, never
    guessed, and NEVER read as "a person in a plain shell". (A session v2 knows that is not a fleet agent is a person's.)"""


SESSION_ENV = "OPENCODE_SESSION_ID"   # the harness sets it per session, unique: the one thing the caller IS


def _agent_label(v2, session_id):
    try:
        name = (_fleet_meta(v2.session_get(session_id)) or {}).get("name")
    except (V2Error, HerdrError):
        name = None
    return name if isinstance(name, str) and name else "not a fleet agent"


def session_identity(herdr, v2, environ):
    """The caller's `metadata.fleet`, found from its OWN session (OPENCODE_SESSION_ID) in the switchboard's registry (v2's
    session records and herdr's agent list), never from inherited environment variables (HERDR_PANE_ID, the role and
    repo variables, the token), which a restart can leave belonging to another agent. None when no session is named.
    Raises IdentityUncertain when v2 does not know the session, CallerError when it is known and not a fleet agent (a
    person's). A HERDR_PANE_ID that names another agent's session is only a diagnostic, one warning line."""
    own = environ.get(SESSION_ENV)
    if not own:
        return None
    try:
        info = v2.session_get(own)
    except V2Error as err:
        if err.reason == "http" and err.status == 404:
            raise IdentityUncertain("cannot tell who you are: session %s is not known to the switchboard's registry "
                                    "(nothing was done)" % own) from None
        raise
    fleet = _fleet_meta(info)
    if not fleet or not isinstance(fleet.get("name"), str) or not fleet["name"]:
        raise CallerError("session %s is not a fleet agent (no metadata.fleet.name)" % own)
    warn_pane_disagrees(herdr, v2, environ, own, fleet["name"])
    return fleet


_WARNED_PANES = set()


def warn_pane_disagrees(herdr, v2, environ, own, name):
    """The diagnostic: HERDR_PANE_ID names a pane whose agent runs another session. The identity is taken from the
    session; the warning says what is wrong with the environment, once per process."""
    pane = environ.get("HERDR_PANE_ID")
    if not pane or (pane, own) in _WARNED_PANES:
        return
    try:
        theirs = agent_session(herdr.agent_get(pane))
    except (HerdrError, V2Error):
        return
    if not theirs or theirs == own:
        return
    if _agent_label(v2, theirs) == name:
        return   # the pane's agent is THIS fleet agent under an older or newer session (a restart, a move): the inherited variable is stale, not another agent's
    _WARNED_PANES.add((pane, own))
    where = ""
    try:
        for entry in herdr.agent_list():
            if agent_session(entry) == own and isinstance(entry.get("pane_id"), str):
                where = "; this session runs in pane %s" % entry["pane_id"]
                break
    except (HerdrError, V2Error, AttributeError, TypeError):
        pass
    sys.stderr.write("%s: warning: HERDR_PANE_ID %s belongs to session %s (%s) but this session is %s (%s)%s: the "
                     "identity is taken from the session, not from the pane; fix the environment (HERDR_PANE_ID, "
                     "FLEET_SWITCHBOARD_ROLE, FLEET_SWITCHBOARD_REPO and the token travel together)\n"
                     % (PROG, pane, theirs, _agent_label(v2, theirs), own, name, where))


def caller_workspace(engine, explicit, environ=None):
    """The herdr workspace a launch or handoff goes to when --workspace is not given: the workspace of the CALLER'S OWN session (OPENCODE_SESSION_ID, found
    in herdr's agent list), never an inherited HERDR_WORKSPACE_ID that may belong to another session. An explicit --workspace wins. When the two
    disagree, the caller's own is used and stderr says which one was used and which was left. When the caller's own workspace cannot be found
    (a plain shell, a session herdr does not show), the variable is used as before: never a refusal."""
    if explicit:
        return explicit
    environ = os.environ if environ is None else environ
    inherited = environ.get("HERDR_WORKSPACE_ID")
    own = environ.get(SESSION_ENV)
    mine = None
    if own:
        try:
            for entry in engine.herdr.agent_list():
                if agent_session(entry) == own and isinstance(entry.get("pane_id"), str):
                    mine = entry.get("workspace_id") if isinstance(entry.get("workspace_id"), str) else engine.herdr.pane_get(entry["pane_id"]).get("workspace_id")
                    break
        except (HerdrError, V2Error, AttributeError, TypeError):
            mine = None
    if not isinstance(mine, str) or not mine:
        return inherited
    if inherited and inherited != mine:
        sys.stderr.write("%s: workspace: using %s, the workspace of this session; HERDR_WORKSPACE_ID=%s belongs to another session and was not used "
                         "(pass --workspace to choose)\n" % (PROG, mine, inherited))
    return mine


def no_pane_error(how):
    return CallerError("cannot tell who you are: neither %s nor HERDR_PANE_ID is set: %s" % (SESSION_ENV, how))


def identify_caller(herdr, v2, environ):
    """The caller's fleet name: HERDR_PANE_ID -> herdr agent -> v2 session -> metadata.fleet.name."""
    fleet = session_identity(herdr, v2, environ)
    if fleet is not None:
        return fleet["name"]
    pane = environ.get("HERDR_PANE_ID")
    if not pane:
        raise no_pane_error("run send from a fleet agent's herdr pane")
    session_id = agent_session(herdr.agent_get(pane))
    if not session_id:
        raise CallerError("herdr pane %s shows no agent session" % pane)
    name = (_fleet_meta(v2.session_get(session_id)) or {}).get("name")
    if not isinstance(name, str) or not name:
        raise CallerError("session %s in pane %s is not a fleet agent (no metadata.fleet.name)" % (session_id, pane))
    return name


def build_engine(runner, now, actor, writable=True, socket_call=None):
    """The engine over the configured clients. Refuses an unconfigured v2 or a bad fault name."""
    config = load_runnable_config()
    active_faults()
    state = ensure_state_dir()
    v2 = V2Client(config["opencode"], config["opencode_env"], runner, config["call_timeout_seconds"], transport=config["v2_transport"])
    if actor == "daemon":
        v2.state_dir = state   # the daemon's link is what `status` reports
    herdr = HerdrClient(config["herdr"], runner, socket_call=socket_call)
    audit = AuditLog(state / "audit.jsonl") if writable else None
    engine = Switchboard(config, v2, herdr, audit, fact_sources(state), now, actor,
                         intents=intent_reader_for(config, runner, now), state_dir=state)
    engine.accounts = GhAccounts(config, runner, now)  # PR 15
    engine.route_check = shim_route_problem   # headless launch: is the per-command gh/git route in place (#669)
    engine.accounts.audit, engine.accounts.actor = audit, actor   # the rate-limit pause is audited, once per episode
    if engine.intents is not None:
        engine.intents.accounts = engine.accounts   # ONE gate for every read of one account: one pause, one counter, one set of remembered answers
    engine.gh_runner = runner  # PR notices
    return engine, state, config


def enable_conditional_reads(engine):
    """The daemon's GitHub reads ask with `-i` and keep ETags (see `GhAccounts.read`). Nothing else turns it on."""
    accounts = getattr(engine, "accounts", None)
    if isinstance(accounts, GhAccounts):
        accounts.conditional = True


def cmd_run(args, runner, now, wait):
    if not args.once:   # the daemon: whoever started it, it is nobody's agent (see CALLER_ENV_NAMES)
        for name in CALLER_ENV_NAMES:
            os.environ.pop(name, None)
    signature = config_signature(config_path())  # taken before the read: an edit in between is seen as a change
    engine, state, config = build_engine(runner, now, "daemon")
    enable_conditional_reads(engine)   # the daemon's reads keep ETags (a 304 is free); a one-shot command reads plainly
    if args.once:
        with single_instance(state):
            report = engine.run_pass()
        if args.json:
            print(json.dumps(report, indent=2, sort_keys=True))
        else:
            print("pass at %s: %d sent, %d held, %d waiting, %d converted, %d error(s)" % (
                report["at"], len(report["sent"]), len(report["held"]), len(report["waiting"]),
                len(report["converted"]), len(report["errors"])))
        return EXIT_OK if not report["errors"] else EXIT_ERROR
    if args.standby:  # PR 16: the service waits for the lock instead of exiting and being restarted
        while run_lock_held(state):
            time.sleep(STANDBY_SECONDS)
    engine.temp_janitor_runner = runner   # the weekly temp janitor runs only in the real daemon, by this attribute and by nothing a caller passes (#762)
    engine.docker_reap_runner = runner   # the daily reap of expired labelled docker objects runs only in the real daemon
    hub = attach_github(engine, config, state, runner, now)
    start_event_feed(engine, config, now)
    judge_server = start_judge_server(config, state, runner, now, engine)  # PR 9: the daemon holds the key, not v2
    if judge_server is not None and config["policy"]["enabled"]:
        engine.judge_warm = make_judge_warmer(config, runner, now)
    watch = ConfigWatch(config_path(), config, now, engine.audit, engine.actor,
                        lambda **fields: update_daemon_record(state, **fields), signature)
    argv = [sys.executable, os.path.realpath(__file__), "run"] + (["--poll", "%g" % args.poll] if args.poll else [])
    # `--standby` is left out of a re-exec: the new process already holds the lock
    try:
        run_daemon(engine, state, args.poll or config["poll_seconds"], wait,
                   record=dict(daemon_record(config), config_loaded_at=iso(now())), watch=watch,
                   on_reload=lambda changed: reload_in_place(engine, hub, judge_server, changed, argv))
    except KeyboardInterrupt:
        return EXIT_OK
    finally:
        if getattr(engine, "feed", None) is not None:
            engine.feed.stop()
        if hub is not None:
            hub.stop()
        if judge_server is not None:
            judge_server.stop()
    return EXIT_OK


STANDBY_SECONDS = 10  # how often `run --standby` looks again for a free lock


def cmd_ensure(args, spawn=subprocess.Popen):
    load_config()  # a daemon that cannot read its config would exit at once; say so here
    state = ensure_state_dir()
    outcome = ensure_daemon(state, spawn)
    print("daemon %s" % outcome)
    return EXIT_OK


def cmd_resume(args, runner, now):
    """`resume AGENT [--reason TEXT]`: the audited resume of an agent whose turn has ended (the same `resume_ended_turn` the blocked report uses).
    Refused (exit 3, nothing sent) for a working session, an open permission request or question, and an agent resumed in the last 10 minutes."""
    engine, _, _ = build_engine(runner, now, "cli")
    if args.sender is not None:
        if os.environ.get(LAB_ENV) != "1":
            sys.stderr.write("%s: --from is only for the Lab (%s=1); an agent is identified by its pane\n" % (PROG, LAB_ENV))
            return EXIT_USAGE
        caller = args.sender
    else:
        caller = identify_caller(engine.herdr, engine.v2, os.environ)
    try:
        message_id = resume_ended_turn(engine, caller, args.name, args.reason)
    except ResumeRefused as err:
        sys.stderr.write("%s: not resumed: %s\n" % (PROG, _one_line(str(err), 300)))
        return EXIT_HELD
    print(message_id)
    sys.stderr.write("%s: resumed %s (audited)\n" % (PROG, args.name))
    return EXIT_OK


cmd_resume.ensure_on_use = True


def add_resume_parsers(sub):
    resume = sub.add_parser("resume", help="Resume an agent whose turn has ended (audited; one per agent per 10 minutes)",
                            description="`%s AGENT` sends the resume text to AGENT's session only when its turn has ended and nothing is open. It refuses "
                                        "an agent with an open permission request or question (that goes to the owner), a session that is working, and an "
                                        "agent resumed in the last %d minutes. Each resume writes one audit line naming who resumed whom and why."
                                        % (RESUME_COMMAND, RESUME_SECONDS // 60))
    resume.add_argument("name", metavar="AGENT")
    resume.add_argument("--reason", default=RESUME_REASON, help="why, for the audit line (default: %(default)s)")
    resume.add_argument("--from", dest="sender", default=None, help=argparse.SUPPRESS)


def cmd_poke(args):
    """Ask the daemon for a pass. Silent, fast, and always exit 0: it runs inside
    herdr's hook runner, which has no timeout and a shared limit on commands."""
    signal.alarm(POKE_ALARM)
    try:
        send_poke(state_dir_path())
    except Exception:  # nothing a poke does may make a hook noisy or slow
        pass
    finally:
        signal.alarm(0)
    return EXIT_OK


cmd_poke.direct = True   # no error mapping, no daemon start


def read_brief(path, stdin):
    """The brief for `launch`: a file, or `-` for standard input. None when not given."""
    if path is None:
        return None
    try:
        text = stdin.read() if path == "-" else Path(path).read_text()
    except OSError as err:
        raise LaunchError("cannot read the brief %s: %s" % (path, err.strerror or err)) from None
    if not text.strip():
        raise LaunchError("the brief %s is empty" % path)
    return text


MEMORY_FREE_MIN = 40          # percent: the lanes' safety check for a NEW launch, not a rule about coders
MEMORY_WAIT_SECONDS = 30      # the two Swapouts reads are this far apart
MEMORY_CACHE_SECONDS = 60     # a cached reading older than this is never trusted
MEMORY_CACHE_FILE = "memory-reading.json"
MEMORY_PROBES = {"memory_pressure": "/usr/bin/memory_pressure", "vm_stat": "/usr/bin/vm_stat"}   # absolute paths, never resolved through PATH; a missing one is "not available" (pass open)
memory_sleep = time.sleep   # a test replaces it; production never does


def memory_read(runner):
    """(free_percent, swapouts), or None when either probe is missing or its output cannot be read (Linux, a failure): the test then passes open."""
    try:
        pressure = runner([MEMORY_PROBES["memory_pressure"]], capture_output=True, text=True, timeout=20)
        vm = runner([MEMORY_PROBES["vm_stat"]], capture_output=True, text=True, timeout=20)
        free = re.search(r"free percentage:\s*(\d{1,3})\s*%", pressure.stdout or "")
        swapouts = re.search(r"^Swapouts:\s*(\d+)\.?\s*$", vm.stdout or "", re.M)
        if pressure.returncode != 0 or vm.returncode != 0 or not free or not swapouts:
            return None
        return int(free.group(1)), int(swapouts.group(1))
    except (OSError, subprocess.SubprocessError, TypeError, AttributeError, ValueError):
        return None


def launch_memory_check(args, engine, state, runner, now):
    """The lanes' safety check before a NEW launch (not the owner's rule; no caps on coders): `memory_pressure` free >= 40 percent AND the `vm_stat`
    Swapouts counter unchanged between two reads 30 s apart. Returns None to go on, or the refusal line (the caller exits EXIT_MEMORY). A fresh cached
    reading (state dir, < 60 s old) that shows the counter flat saves the wait, but never makes a launch pass when this first read's free is under 40.
    FAIL OPEN: a missing or unreadable probe passes with one line and an audit record. `--memory-ok <reason>` skips the test and audits it."""
    reason = getattr(args, "memory_ok", None)
    path = Path(state) / MEMORY_CACHE_FILE
    audit = lambda kind, data: engine.audit.append(engine.actor, kind, args.name, data) if engine.audit is not None else None
    first = memory_read(runner)

    def remember(*reads):
        try:
            path.parent.mkdir(parents=True, exist_ok=True)
            tmp = path.with_name(path.name + ".%d.tmp" % os.getpid())
            tmp.write_text(json.dumps({"at": now(), "reads": [list(r) for r in reads][-2:]}))
            os.replace(tmp, path)
        except OSError:
            pass   # the cache is only an optimisation: a failed write costs the next launch one wait, deliberately silent
    if reason is not None:
        audit("launch.memory_ok", {"reason": _one_line(reason, 200), "measured": ("free %d%%, swapouts %d" % first) if first else "not measured"})
        return None
    if first is None:
        sys.stderr.write("%s: memory test not available: launching\n" % PROG)
        audit("launch.memory_unavailable", {"measured": "not measured"})
        return None
    free, before = first
    cached = None
    try:
        with open(path) as handle:
            record = json.loads(handle.read(4096))   # a small file: a bigger one is not ours and is not trusted
        reads = record["reads"]
        if not isinstance(reads, list) or len(reads) > 2:
            raise ValueError("unexpected cache shape")
        if 0 <= now() - float(record["at"]) < MEMORY_CACHE_SECONDS and len(reads) >= 1:
            cached = reads[-1][1]
            if len(reads) >= 2 and reads[-2][1] != cached:
                cached = None   # the cached pair moved: not flat
    except (OSError, ValueError, KeyError, IndexError, TypeError):
        cached = None
    if free < MEMORY_FREE_MIN:
        remember(first)
        return "memory: free %d%%, swapouts %d: not launching; override: --memory-ok <reason>" % (free, before)
    if cached is not None and cached == before:
        remember(first, first)
        sys.stderr.write("%s: memory: free %d%%, swapouts flat (cached reading under %d s old)\n" % (PROG, free, MEMORY_CACHE_SECONDS))
        return None
    memory_sleep(MEMORY_WAIT_SECONDS)   # the wait is a constant: no environment variable or argument changes it; only `--memory-ok <reason>` skips the test
    second = memory_read(runner)
    if second is None:
        sys.stderr.write("%s: memory test not available: launching\n" % PROG)
        audit("launch.memory_unavailable", {"measured": "free %d%%, swapouts %d" % first})
        return None
    remember(first, second)
    if second[0] < MEMORY_FREE_MIN or second[1] != before:
        return "memory: free %d%%, swapouts %d -> %d in %d s: not launching; override: --memory-ok <reason>" % (second[0], before, second[1], MEMORY_WAIT_SECONDS)
    return None


def cmd_launch(args, runner, now, socket_call=None):
    if getattr(args, "read_repo", None) is not None and (getattr(args, "cloud", False) or args.resume):
        raise LaunchError("--read-repo needs a terminal launch of a new worker (not --headless, --cloud or --resume)")
    if getattr(args, "stack", False) and not getattr(args, "cloud", False):   # before anything is read or called: the option is the cloud launcher's
        sys.stderr.write("%s: --stack needs --cloud: the nested Docker stack is a cloud worker's pod; nothing was created\n" % PROG)
        return EXIT_USAGE
    if getattr(args, "cloud", False):   # a worker in the cloud (#371): its own module; nothing below runs
        return run_cloud("cmd_launch", args, runner, now)
    refuse_cloud_name(args.name)   # a name that has a cloud record is not launched locally (#640)
    engine, state, _ = build_engine(runner, now, "cli", socket_call=socket_call)
    if getattr(args, "terminal", False) and getattr(args, "headless", False):
        raise LaunchError("--terminal and --headless contradict each other: pick one")
    # #433: a plain launch takes its mode from `launch_default` (shipped: headless). A terminal is asked for by --terminal, or implied by --workspace/--new-workspace.
    by_default = not (args.resume or getattr(args, "headless", False) or getattr(args, "terminal", False) or args.workspace or getattr(args, "new_workspace", None))
    use_headless = bool(getattr(args, "headless", False)) or (by_default and engine.config.get("launch_default", "headless") == "headless")
    workspace = args.workspace if (args.workspace or getattr(args, "new_workspace", None) or use_headless) \
        else caller_workspace(engine, None)   # a workspace made now, or none at all, needs no look at the caller's own
    if args.resume:
        given = getattr(args, "repo", None)
        if given:
            stored = ((engine.v2.session_get(args.resume).get("metadata") or {}).get("fleet") or {}).get("repo")
            if stored and given != stored:
                raise LaunchError("--repo %s differs from the session's stored repo %s: a resume keeps what the session says, never the caller's" % (given, stored))
        # the same authorisation and one-at-a-time lock as `reattach`: this path can close a stale tab too
        who = reattach_caller_problem(engine, runner, now, engine.discover(engine.now()), args.name, args.resume)
        if who:
            if engine.audit is not None:
                engine.audit.append(engine.actor, "fleetpane.reattach_refused", args.name, {"why": _one_line(who, 160), "via": "launch --resume"})
            raise LaunchError("refused: %s" % who)
        resume_brief, brief = load_module("resume_brief"), None
        if args.brief_file is not None:   # read AFTER the repo and caller checks and BEFORE any pane opens: a bad brief opens nothing
            try:
                brief = resume_brief.read(read_brief, args.brief_file, sys.stdin)
            except resume_brief.BriefRefused as err:
                sys.stderr.write("%s: launch --resume: %s; no pane was opened\n" % (PROG, _one_line(str(err), 300)))
                return EXIT_USAGE
        try:
            with agent_lock(state, args.name):
                done = resume_agent(engine, args.name, args.resume, workspace)
        except ImpactStateBusy:
            raise LaunchError("another reattach of %s is running: wait for it" % args.name) from None
        if brief is not None:   # the pane is proven to run the session: the brief is sent once, and the output says it was
            ns = types.SimpleNamespace(**{name: globals()[name] for name in resume_brief.NEEDS})
            return resume_brief.deliver(ns, engine, done, brief, print, lambda text: sys.stderr.write(text + "\n"))
        print(json.dumps(done, sort_keys=True))
        return EXIT_OK
    if not args.agent or not args.dir:
        raise LaunchError("--agent and --dir are required (or --resume SESSION for an existing agent)")
    if getattr(args, "memory_ok", None) is not None and (not args.memory_ok.strip() or re.search(r"[\x00-\x1f\x7f-\x9f]", args.memory_ok)):
        sys.stderr.write("%s: launch: --memory-ok needs a reason: non-empty text on one line, no control characters\n" % PROG)
        return EXIT_USAGE
    refusal = launch_memory_check(args, engine, state, runner, now)   # a NEW launch only: every resume, --cloud and the other routes returned above
    if refusal:
        sys.stderr.write("%s: %s\n" % (PROG, refusal))
        return EXIT_MEMORY
    if getattr(args, "headless", False) and (args.workspace or args.new_workspace):
        raise LaunchError("--headless opens no terminal, so it takes no --workspace or --new-workspace (`%s watch NAME` opens one later)" % PROG)
    if (args.name or "").startswith(LANE_NAME_PREFIX):
        raise LaunchError("names starting %r are the plan review engine's reviewer lanes: only it launches them" % LANE_NAME_PREFIX)
    repo = launch_repo(args)
    if not repo and not args.charter:   # #473: no --repo, no issue repo, no charter: the worker would have no repository of its own (and so no account)
        repo, why = origin_repository(runner, args.dir)
        if repo:
            sys.stderr.write("%s: repository: %s (from origin)\n" % (PROG, repo))
            if engine.audit is not None:
                engine.audit.append(engine.actor, "launch.repo_from_origin", args.name, {"repo": repo})
        else:
            sys.stderr.write("%s: no repository recorded (%s): pushes will be refused; pass --repo\n" % (PROG, why))
    read_repo = launch_read_repo(args, repo, getattr(engine, "accounts", None), engine.config, use_headless)
    problem = launch_agent_problem(engine.config, runner, args.agent)
    if problem:
        raise LaunchError(problem)
    brief = read_brief(args.brief_file, sys.stdin)
    launch_gate_probe(engine, state, engine.config, args, brief, runner, now)   # #107 slice 3c: shadow only, never refuses
    launched = now()
    created = None
    if args.new_workspace:
        if args.workspace:
            raise LaunchError("--new-workspace makes the workspace: do not also pass --workspace")
        problems = launch_problems(args.name, args.agent, args.dir, args.new_workspace, args.issue, args.charter)
        if problems:
            raise LaunchError("; ".join(problems))
        problem = launch_account_problem(engine.config, engine.accounts, repo)
        if problem:
            raise LaunchError(problem)
        check_charter_workspace(engine, runner, now, args.charter, repo, args.new_workspace)
        with engine._external("herdr.workspace.create", args.name, {"label": args.new_workspace,
                                                                    "cwd": args.dir}) as result:
            # PR 15's launch never takes focus: only a person's own `bootstrap` does (PR 16)
            created = workspace = result["workspace"] = engine.herdr.workspace_create(
                args.dir, args.new_workspace, focus=False)["workspace_id"]
    try:
        launcher = identify_caller(engine.herdr, engine.v2, os.environ)   # #372: who ran this launch, recorded in the session; a plain shell is nobody
    except Exception:
        launcher = None   # an identity failure records nobody, on purpose: that agent never counts as a launched tester (fail closed)
    launched_by = launcher if isinstance(launcher, str) and launcher else None
    try:
        done = None
        if use_headless:
            try:
                done = launch_headless(engine, args.name, args.agent, args.dir, args.role, args.reports_to,
                                       None if args.issue is None else int(args.issue), brief, charter=args.charter, repo=repo,
                                       launched_by=launched_by)
            except HeadlessRefused as err:
                if getattr(args, "headless", False):
                    raise   # asked for by name: the refusal is the answer
                reason = _one_line(str(err), 200)
                sys.stderr.write("%s: launch: headless refused for %s (%s); opened a terminal instead\n" % (PROG, args.name, reason))
                try:
                    if engine.audit is not None:
                        engine.audit.append(engine.actor, "launch.fallback_terminal", args.name, {"why": reason, "repo": repo})
                except Exception as aerr:   # the line above is the report; a failing audit sink must not turn a safe fallback into a failed launch
                    sys.stderr.write("%s: launch: the fallback could not be audited (%s)\n" % (PROG, _one_line(str(aerr), 100)))
                try:
                    workspace = caller_workspace(engine, None)
                except Exception as werr:
                    raise LaunchError("headless refused (%s) and no terminal workspace could be found (%s)" % (reason, _one_line(str(werr), 120))) from werr
        if done is None:
            done = launch_agent(engine, args.name, args.agent, args.dir, workspace, args.role, args.reports_to,
                                None if args.issue is None else int(args.issue), brief, charter=args.charter, repo=repo,
                                launched_by=launched_by, read_repo=read_repo)
    except LaunchError as err:
        if created:
            raise LaunchError("%s (workspace %s was created and is left for you to close)" % (err, created)) from err
        raise
    print(json.dumps(done, sort_keys=True))
    if done.get("identity"):
        sys.stderr.write("%s: %s\n" % (PROG, done["identity"]))
    if read_repo:   # the one line that says the grant (#618); it is also in the worker's record (metadata.fleet.read_repo)
        sys.stderr.write("%s: %s can read %s, read only (a shim guard: writes there are refused)\n" % (PROG, args.name, read_repo))
        if engine.audit is not None:
            engine.audit.append(engine.actor, "launch.read_repo", args.name, {"read_repo": read_repo})
    if args.role == "orchestrator":   # #838: a relaunched or replacement orchestrator inherits the workers its predecessor left, in the same step
        launched_charter = int(re.search(r"(\d+)\s*$", str(args.charter)).group(1)) if args.charter and re.search(r"(\d+)\s*$", str(args.charter)) else None
        for path, bosses in (("relaunch", {args.name}), ("replace", None)):
            if path == "replace" and launched_charter is None:
                continue   # a replacement is of a charter's orchestrator: with no charter named there is nothing to inherit
            try:
                adopted, problem = adopt_workers(engine, path, identify_who(engine, runner, now), bosses=bosses, charter=launched_charter if path == "replace" else None)
            except Exception as err:
                adopted, problem = [], "%s: %s" % (type(err).__name__, err)
            for worker, heir in adopted:
                print("adopted: %s now reports to %s" % (worker, heir))
            if problem:
                sys.stderr.write("%s: %s launched, but its workers were not re-pointed (%s): the next daemon pass retries\n" % (PROG, args.name, _one_line(problem, 160)))
    register_item_tester(engine, state, args, repo, launched_by, done, now)   # #770: a tester launched for a work item with no pull request is registered for that item only
    boss = args.reports_to
    if boss is None and (brief or getattr(args, "checkpoint", None) or getattr(args, "overdue", None)):
        try:  # a launch with no --reports-to: the launching agent is who an overdue checkpoint should wake (the worker's metadata is unchanged)
            boss = identify_caller(engine.herdr, engine.v2, os.environ)
        except Exception:
            boss = None  # launched from a plain shell: no one to wake, as before
    note = set_checkpoint_reminders(engine, state, args.name, boss, None if args.issue is None
                                    else int(args.issue), repo, brief, getattr(args, "checkpoint", None),
                                    getattr(args, "overdue", None), launched, now())
    if note and (brief or args.checkpoint or args.overdue):
        sys.stderr.write("%s: %s\n" % (PROG, note))
    return EXIT_OK


cmd_launch.ensure_on_use = True   # the daemon is alive when it runs


def launch_gate_probe(engine, state, config, args, brief, runner, now):
    """Slice 3c, E4 of the gate engine design: SHADOW ONLY. Before a launch, check that the assignment's brief links a `PLAN:` whose
    plan has a consensus record (G0b) at its CURRENT plan hash. It records `gate.would_refuse` and never refuses, whatever the
    mode (refusing is a later step, and needs the plan review engine that writes the consensus record). Same opt-in, mode,
    `enabled: false` and `plan-gates.off` handling as `gates-check`; fail-open: any trouble is `gate.fail_open` and the launch
    goes on. It never raises. (It cannot tell a hotfix or the gate engine's own repair assignment: those are exempt in the
    design, so a later enforcing slice needs a way to say so.)"""
    try:
        link = plan_ledger.PLAN_LINK_RE.search(brief or "")
        try:
            plan_repo = parse_plan_source(link.group(1).strip("<>.,"), config.get("intent_repo"))[0] if link else None
        except PlanInputError:
            plan_repo = None
        repo = launch_repo(args) or plan_repo or config.get("intent_repo")
        setting = plan_ledger.repo_setting(config, repo) if repo else None
        if setting is None or not setting["enabled"]:
            return
        subject = "launch:%s" % args.name
        if gates_off_path(state).exists():
            _gates_audit(engine, "gate.killed", subject, {"for": "launch", "by": GATES_OFF_FILE})
            return
        box = {}

        def work():
            try:
                plan = None
                if link:
                    ns = types.SimpleNamespace(source=link.group(1).strip("<>.,"), file=None, ask=None, done_when=None)
                    try:
                        text, label, result = load_plan(ns, runner, now)
                        plan = dict(result, scenarios_parsed=[])
                    except (PlanInputError, ValueError, ConfigError, IntentError):
                        plan = None
                entries, problem = plan_ledger.read_ledger(state)
                box["findings"] = plan_ledger.launch_findings(brief, plan, entries)
                box["overridden"] = plan_ledger.consensus_overridden(entries, plan["plan_hash"]) if plan else None
                box["problem"] = problem
            except BaseException as err:
                box["error"] = "%s: %s" % (type(err).__name__, _one_line(str(err), 150))
        thread = threading.Thread(target=work, daemon=True)
        thread.start()
        thread.join(setting["budget_ms"] / 1000.0)
        if thread.is_alive():
            raise TimeoutError("no answer within %d ms" % setting["budget_ms"])
        if "error" in box:
            raise RuntimeError(box["error"])
        gates_note(state, now(), repo, "checks")
        findings = box["findings"]
        if box.get("problem") and not any(f["gate"] == "G0b" for f in findings):
            findings.append({"gate": "G0b", "missing": ["the ledger is not trustworthy: %s" % box["problem"]]})
        if findings:
            why = "; ".join("%s: %s" % (f["gate"], "; ".join(f["missing"])) for f in findings)
            gates_note(state, now(), repo, "would_refuse")
            _gates_audit(engine, "gate.would_refuse", subject, {"for": "launch", "mode": setting["mode"],
                                                              "failed": [f["gate"] for f in findings], "reason": _one_line(why, 300)})
            sys.stderr.write("%s: gates: a launch under this brief would be refused (shadow: %s): %s\n" % (PROG, setting["mode"], _one_line(why, 240)))
        elif box.get("overridden"):   # a consensus that is there only because an objection was overridden is shown, not hidden
            _gates_audit(engine, "gate.consensus_overridden", subject, {"for": "launch", "overridden_by": box["overridden"]})
            sys.stderr.write("%s: gates: the plan's consensus was OVERRIDDEN by %s (an objection was decided past)\n" % (PROG, box["overridden"]))
    except BaseException as err:
        if isinstance(err, (KeyboardInterrupt, SystemExit)):
            raise
        try:
            first = gates_note(state, now(), repo, "fail_opens", alarm="fail-open:%s" % type(err).__name__) if repo else False
            _gates_audit(engine, "gate.fail_open", "launch:%s" % getattr(args, "name", "?"),
                         {"for": "launch", "reason": "%s: %s" % (type(err).__name__, _one_line(str(err), 200)), "first_today": first})
        except BaseException:
            pass


def launch_read_repo(args, repo, accounts, config, use_headless=False):
    """The ONE extra repository a worker may READ (`--read-repo`, #618), as the exact lower-case `owner/name` the shims will match, or None when none was
    asked for. Refused (LaunchError) when it is not written exactly that way (no case, whitespace, `.git`, `/`, `owner/*`, URL or path spelling: the
    same rules as the launch guard's `normal_repo`, which must leave it unchanged), is the worker's own repository, has no `gh_users` account (a read
    would run as the wrong account), or is combined with --headless, --cloud or --resume (no shim pins those workers). The grant is a shim guard, not a
    GitHub guard: the account behind it may still be able to write."""
    given = getattr(args, "read_repo", None)
    if given is None:
        return None
    if getattr(args, "headless", False) or getattr(args, "cloud", False) or args.resume:
        raise LaunchError("--read-repo needs a terminal launch of a new worker (not --headless, --cloud or --resume)")
    if use_headless:   # #433: a plain launch is headless by default, and no shim pins a headless worker: the grant would be unguarded, so it asks for the terminal by name
        raise LaunchError("--read-repo needs a terminal launch: add --terminal (a plain launch is headless by default, and no shim pins a headless worker)")
    exact = isinstance(given, str) and given.isascii() and re.fullmatch(r"[a-z0-9_.-]+/[a-z0-9_.-]+", given) is not None \
        and not given.endswith(".git") and ".." not in given.split("/") and "." not in given.split("/") and GhAccounts.normal_repo(given) == given
    if not exact:
        raise LaunchError("--read-repo must be exactly OWNER/NAME in lower case (no whitespace, .git, URL, path or wildcard), got %r" % _one_line(str(given), 60))
    if repo and GhAccounts.normal_repo(repo) == given:
        raise LaunchError("--read-repo %s is the worker's own repository: nothing to add" % given)
    if accounts is None or not config.get("gh_users") or not accounts.account_for(given):
        raise LaunchError("--read-repo %s has no gh account: add \"%s\" or \"%s/*\" to gh_users in %s" % (given, given, given.split("/")[0], config_path()))
    return given


def launch_repo(args):
    """The repo a launch is for: `--repo`, or the one a qualified `--issue` names; both must agree."""
    named = getattr(args, "repo", None)
    if named is not None and not REPO_RE.match(named):
        raise LaunchError("--repo must be OWNER/REPO, got %r" % named)
    qualified = issue_repo(args.issue)
    if named and qualified and named != qualified:
        raise LaunchError("--repo %s and --issue %s#%d name different repos" % (named, qualified, args.issue))
    return named or qualified


_ORIGIN_NAME = r"([A-Za-z0-9][A-Za-z0-9-]{0,38})/([A-Za-z0-9._-]{1,100}?)(?:\.git)?"
ORIGIN_HTTPS_RE = re.compile(r"https://github\.com/" + _ORIGIN_NAME)
ORIGIN_SSH_RE = re.compile(r"git@github\.com:" + _ORIGIN_NAME)


def origin_repository(runner, directory):
    """(`owner/name`, None) for the repository the `origin` remote of `directory` names, else (None, why). Read ONCE, by the launcher, never by a shim or
    at call time (a worker controls its own remote settings): `git config --local --no-includes --get-all remote.origin.url` as an argv, no shell, no network, nothing
    but the repository's own config. Only `https://github.com/OWNER/NAME[.git]` and `git@github.com:OWNER/NAME[.git]` are accepted, exactly one `origin`
    url: another host, a path, a `file:` or `ssh://` url, a url with a user or a token in it, an alias, a trailing path or no origin at all gives no
    repository. The result is lower case. `why` is a fixed phrase: the url itself is NEVER returned, printed or logged."""
    if not isinstance(directory, str) or not os.path.isabs(directory) or not os.path.isdir(directory):
        return None, "the working directory is not an existing absolute path"
    clean = {k: v for k, v in os.environ.items() if not (k in ("GIT_DIR", "GIT_WORK_TREE", "GIT_COMMON_DIR", "GIT_INDEX_FILE", "GIT_CEILING_DIRECTORIES") or k.startswith("GIT_CONFIG"))}
    try:   # the launcher's own environment must not point git at another repository or config: scrubbed
        done = subprocess.run(["git", "-C", directory, "config", "--local", "--no-includes", "--get-all", "remote.origin.url"], capture_output=True, text=True,
                              timeout=WORKTREE_GIT_SECONDS, stdin=subprocess.DEVNULL, env=clean)
    except (OSError, subprocess.SubprocessError):
        return None, "git could not be run there"
    urls = [line for line in (done.stdout or "").splitlines() if line.strip()]
    if done.returncode != 0 or not urls:
        return None, "the directory has no origin remote"
    if len(urls) != 1:
        return None, "origin names more than one url"
    found = ORIGIN_HTTPS_RE.fullmatch(urls[0]) or ORIGIN_SSH_RE.fullmatch(urls[0])
    if not found or found.group(2) in (".", "..") or found.group(2).lower().endswith(".git"):
        return None, "origin is not a plain github.com repository url"
    repo = ("%s/%s" % found.groups()).lower()
    return (repo, None) if REPO_RE.match(repo) else (None, "origin is not a plain github.com repository url")


def check_charter_workspace(engine, runner, now, charter, repo, label):
    """Refuse a new workspace whose label is not the one the charter names (an exact match). A charter with no
    `workspace:` line, or no charter, is no objection. A charter that cannot be read is: the label is the one
    name the person you report to is shown, and a wrong one cannot be told from a right one."""
    if charter is None:
        return
    reader = engine.intents
    if reader is None and repo:
        reader = IntentReader(engine.config["gh"], repo, runner, now, engine.config["call_timeout_seconds"],
                              accounts=engine.accounts)
    if reader is None:
        return
    try:
        named = reader.issue(charter, repo).workspace
    except IntentError as err:
        raise LaunchError("cannot read charter #%d to check its workspace label: %s" % (charter, err)) from None
    if named is not None and named != label:
        raise LaunchError("charter #%d names workspace %r but --new-workspace is %r: the label must match exactly"
                          % (charter, named, label))


def resolve_for_sender(engine, config, issue, sender):
    """(repo, number) for an issue reference given by `sender`: its own repo is the default (PR 15)."""
    if issue is None:
        return None, None
    fleets = discovered_fleets(engine.discover(engine.now()))
    return resolve_issue(config, issue, fleets.get(sender, {}), watched_repos(config, fleets))


def run_bounded(work, seconds):
    """(finished, result): `work()` on a worker thread, waited for at most `seconds`. When it is not done by then the thread is left to finish
    or die with the process (it is a daemon thread) and the caller says so: a slow dependency is a clear failure line, never a silent wait."""
    box = {}

    def target():
        try:
            box["result"] = work()
        except BaseException as err:   # re-raised in the caller, with the original type
            box["error"] = err
    thread = threading.Thread(target=target, daemon=True)
    thread.start()
    thread.join(seconds)
    if thread.is_alive():
        return False, None
    if "error" in box:
        raise box["error"]
    return True, box.get("result")


def cmd_send(args, runner, now):
    """`send`, bounded as a whole by `send_timeout_seconds` (default 60 s): past it the command exits 1 saying the delivery did not finish, may
    still complete or have been cut off part way (the state is unknown), never a silent multi-minute wait. FAIL MODE: the timeout fails CLOSED
    (exit 1, "state unknown"): it never reports a delivery it did not see; an unreadable config falls OPEN to the default bound, and says so."""
    try:
        seconds = load_config()["send_timeout_seconds"]
    except ConfigError as err:   # the command itself reports the config error below; the bound falls back to the default, and says so
        seconds = DEFAULTS["send_timeout_seconds"]
        sys.stderr.write("%s: the config could not be read (%s): the default send bound of %s s applies\n" % (PROG, _one_line(str(err), 160), seconds))
    done, code = run_bounded(lambda: _cmd_send(args, runner, now), seconds)
    if not done:
        sys.stderr.write("%s: send to %s did not finish within %s s (a slow v2 or herdr): it may still be delivered, or have been cut off "
                         "part way: the state is unknown, so check `%s pending %s` and the recipient before sending again\n" % (
                             PROG, _one_line(re.sub(r"[\x00-\x1f\x7f-\x9f]", " ", args.name), 80), seconds, PROG,
                             _one_line(re.sub(r"[\x00-\x1f\x7f-\x9f]", " ", args.name), 80)))
        return EXIT_ERROR
    return code


cmd_send.ensure_on_use = True   # the daemon is alive when it runs


def _send_by_registry(args, runner, now):
    """#1131: an agent with no pane goes to its registry endpoint (cloud channel); None means the old path serves it (a pane, or a name the registry does not hold)."""
    es = load_module("endpoint_send")
    found = es.route(load_module("registry"), state_dir_path(), args.name)
    if found[0] in ("pane", "none"):
        return None
    if found[0] == "half":
        if not found[2]:
            return None   # the recipient is not known to be an endpoint row: the old path serves a pane agent, or finds nothing
        sys.stderr.write("%s: not sent: %s\n" % (PROG, found[1]))
        return EXIT_HELD
    engine, _, config = build_engine(runner, now, "cli")
    refusal = intent_refusal(config, args.issue)
    if refusal:
        sys.stderr.write("%s: %s\n" % (PROG, refusal))
        return EXIT_USAGE
    if args.interrupt:
        sys.stderr.write("%s: --interrupt is not supported on an endpoint route: nothing sent\n" % PROG)
        return EXIT_USAGE
    if args.sender is not None:
        if os.environ.get(LAB_ENV) != "1":
            sys.stderr.write("%s: --from is only for the Lab (%s=1); an agent is identified by its pane\n" % (PROG, LAB_ENV))
            return EXIT_USAGE
        sender = args.sender
    else:
        sender = identify_caller(engine.herdr, engine.v2, os.environ)
    text = " ".join(args.text).strip()
    if not text:
        sys.stderr.write("%s: nothing to send\n" % PROG)
        return EXIT_USAGE
    held = es.blocked_reason(args.name, found[2], hold_reason)
    if held:
        sys.stderr.write("%s: not sent to %s: hold (%s)\n" % (PROG, args.name, held))
        return EXIT_HELD
    ok, line = es.deliver(load_module("cloud_client"), found[1], sender, args.name, text)
    if not ok:
        sys.stderr.write("%s: not sent to %s: %s\n" % (PROG, args.name, line))
        return EXIT_HELD
    sys.stderr.write("%s: delivered to %s\n" % (PROG, args.name))
    return EXIT_OK


def _cmd_send(args, runner, now):
    routed = _send_by_registry(args, runner, now)
    if routed is not None:
        return routed
    remote = run_cloud("route", args.name)   # a cloud worker has an endpoint record (#371)
    if remote is not None:
        return run_cloud("cmd_send", args, runner, now, remote)
    engine, _, config = build_engine(runner, now, "cli")
    refusal = intent_refusal(config, args.issue)
    if refusal:
        sys.stderr.write("%s: %s\n" % (PROG, refusal))
        return EXIT_USAGE
    if args.sender is not None:
        if os.environ.get(LAB_ENV) != "1":
            sys.stderr.write("%s: --from is only for the Lab (%s=1); an agent is identified by its pane\n"
                             % (PROG, LAB_ENV))
            return EXIT_USAGE
        sender = args.sender
    else:
        sender = identify_caller(engine.herdr, engine.v2, os.environ)
    text = " ".join(args.text).strip()
    if not text:
        sys.stderr.write("%s: nothing to send\n" % PROG)
        return EXIT_USAGE
    try:
        repo, number = resolve_for_sender(engine, config, args.issue, sender)
    except IssueRefError as err:
        sys.stderr.write("%s: %s\n" % (PROG, err))
        return EXIT_USAGE
    lane_problem = review_lane_send_problem(config, args.name, sender)
    if lane_problem:
        sys.stderr.write("%s: not sent, %s\n" % (PROG, lane_problem))
        return EXIT_USAGE
    try:
        outcome = engine.send(sender, args.name, text, number, repo, interrupt=args.interrupt)
    except InterruptRefused as err:
        sys.stderr.write("%s: not interrupted, nothing sent: %s\n" % (PROG, err))
        return EXIT_USAGE
    except MessageTooLong as err:
        sys.stderr.write("%s: %s\n" % (PROG, err))
        return EXIT_USAGE
    if not outcome["sent"]:
        sys.stderr.write("%s: not sent to %s: %s (%s)\n" % (PROG, args.name, outcome["action"], outcome["reason"]))
        return EXIT_HELD
    print(outcome["message_id"])
    sys.stderr.write("%s: %s delivered to %s\n" % (PROG, outcome["action"], args.name))
    return EXIT_OK


def cmd_report(args, runner, now):
    """PR 13: tell the one you report to what happened. Delivered like `send`; a progress report is a rider."""
    engine, _, _ = build_engine(runner, now, "cli")
    if args.sender is not None:
        if os.environ.get(LAB_ENV) != "1":
            sys.stderr.write("%s: --from is only for the Lab (%s=1); an agent is identified by its pane\n"
                             % (PROG, LAB_ENV))
            return EXIT_USAGE
        sender = args.sender
    else:
        sender = identify_caller(engine.herdr, engine.v2, os.environ)
    try:
        outcome = engine.report(sender, args.state, " ".join(args.text), args.issue, args.everything)
    except (ReportError, IssueRefError) as err:
        sys.stderr.write("%s: %s\n" % (PROG, _one_line(str(err), 400)))
        return EXIT_USAGE
    if outcome.get("action") == "rider":
        sys.stderr.write("%s: %s\n" % (PROG, outcome["reason"]))
        print(outcome["key"])
        return EXIT_OK
    if not outcome["sent"]:
        sys.stderr.write("%s: not reported to %s: %s (%s)\n" % (PROG, outcome.get("recipient", "your boss"),
                                                               outcome["action"], outcome["reason"]))
        return EXIT_HELD
    print(outcome["message_id"])
    sys.stderr.write("%s: %s delivered to the one you report to\n" % (PROG, outcome["action"]))
    for line in outcome.get("worktrees") or []:
        sys.stderr.write("%s: worktree: %s\n" % (PROG, line))
    return EXIT_OK


cmd_report.ensure_on_use = True   # the daemon is alive when it runs


def notice_boss(engine, sender):
    """The agent `sender` reports to, as the fleet shows it now, or None (not found, or the fleet cannot be read)."""
    try:
        discovery = engine.discover(engine.now())
        seen = discovery.agents.get(sender)
    except Exception:
        return None
    boss = (seen.fleet or {}).get("reports_to") if seen is not None else None
    boss = boss if isinstance(boss, str) and boss.strip() else None
    return resolve_boss(discovery, boss) if boss is not None else None


def withdraw_pr_notice(state_dir, repo, number, caller):
    """Remove the notice of `repo#number` for its sender (any agent that sent it) or the boss recorded with it.
    Returns ("withdrawn", item), ("absent", None) or ("refused", item). Holds the notices lock; idempotent."""
    with pr_notices_lock(state_dir):
        items = read_pr_notices(state_dir)
        old = next((i for i in items if i["repo"] == repo and i["number"] == number), None)
        if old is None:
            return "absent", None
        allowed = {n for n in notice_senders(old)} | ({old["boss"]} if isinstance(old.get("boss"), str) and old.get("boss") else set())
        if not caller or caller not in allowed:
            return "refused", old
        write_pr_notices(state_dir, [i for i in items if i is not old])
    return "withdrawn", old


def _check_open_pr(engine, repo, number):
    """NoticeError unless `repo#number` is an open pull request at this moment. One bounded `gh pr view` (cached facts first);
    a lookup that fails for any other reason (network, auth, a timeout) is accepted: best effort, never a block."""
    held = engine.notice_facts.get("%s#%d" % (repo, number))
    try:
        facts = held["facts"] if held and held.get("facts") and not held.get("stale") else read_pr_facts(engine, repo, number)
    except NoticeNotFound:
        raise NoticeError("%s#%d is not a pull request I can find (a mistyped number, or an issue): nothing recorded" % (repo, number)) from None
    except Exception:  # NoticeError, or a runner that fails in some other way: best effort, a lookup never blocks a notice
        return
    if facts.get("state") != "open":
        raise NoticeError("%s#%d is %s, not an open pull request: nothing recorded" % (repo, number, facts.get("state") or "not open"))


def _notice_withdraw(args, engine, state, sender, note):
    if note:
        sys.stderr.write("%s: notice withdraw takes only the PR\n" % PROG)
        return EXIT_USAGE
    try:
        repo, number = parse_pr_ref(args.pr)
    except NoticeError as err:
        sys.stderr.write("%s: %s\n" % (PROG, _one_line(str(err), 400)))
        return EXIT_USAGE
    try:
        verdict, item = withdraw_pr_notice(state, repo, number, sender)
    except NoticeError as err:
        sys.stderr.write("%s: %s\n" % (PROG, _one_line(str(err), 400)))
        return EXIT_USAGE
    key = "%s#%d" % (repo, number)
    if verdict == "refused":
        sys.stderr.write("%s: only the agent that sent the notice for %s (or its boss) can withdraw it\n" % (PROG, key))
        return EXIT_USAGE
    if verdict == "withdrawn" and engine.audit is not None:
        engine.audit.append(engine.actor, "notice.withdrawn", key, {"by": sender, "from": item.get("from"), "boss": item.get("boss")})
    sys.stderr.write("%s: notice of %s %s\n" % (PROG, key, "withdrawn; a comment on the PR no longer routes to its sender" if verdict == "withdrawn" else "was not recorded (nothing to withdraw)"))
    print(key)
    return EXIT_OK


def _notice_ack(args, engine, state):
    """`notice ack <id>`: the owner drops an order heads-up. Only you, in a plain shell: any fleet agent is refused."""
    try:
        caller = None
        if args.sender is not None and os.environ.get(LAB_ENV) == "1":
            caller = args.sender
        else:
            try:
                caller = caller_fleet(engine.herdr, engine.v2, os.environ)["name"]
            except IdentityUncertain:
                raise
            except CallerError:
                caller = None  # a plain shell: you
        if caller is not None:
            sys.stderr.write("%s: only the owner, in a plain shell, acks a heads-up; %s is a fleet agent\n" % (PROG, caller))
            return EXIT_USAGE
        found = ack_order_notice(state, args.pr, order_burst_seconds(engine.config), engine.now())
    except (NoticeError, OSError) as err:
        sys.stderr.write("%s: %s\n" % (PROG, _one_line(str(err), 400)))
        return EXIT_USAGE
    if isinstance(found, str) and found.startswith("changed:"):
        sys.stderr.write("%s: heads-up %s changed since it was shown (it now holds %s orders): nothing was dropped; ack the row as it reads now\n"
                         % (PROG, args.pr, found.split(":", 1)[1]))
        return EXIT_USAGE
    if engine.audit is not None and found:
        engine.audit.append(engine.actor, "notice.ack", args.pr, {})
    sys.stderr.write("%s: %s\n" % (PROG, "heads-up %s dropped" % args.pr if found else "no heads-up %s" % args.pr))
    return EXIT_OK if found else EXIT_USAGE


def cmd_notice(args, runner, now):
    """PR notices: tell the person about a PR you opened or mean to merge. Recorded for the daemon to show in the
    panel; sends no message and wakes nobody."""
    engine, state, _ = build_engine(runner, now, "cli")
    if args.kind == "ack":
        return _notice_ack(args, engine, state)
    if args.sender is not None:
        if os.environ.get(LAB_ENV) != "1":
            sys.stderr.write("%s: --from is only for the Lab (%s=1); an agent is identified by its pane\n"
                             % (PROG, LAB_ENV))
            return EXIT_USAGE
        sender = args.sender
    else:
        sender = identify_caller(engine.herdr, engine.v2, os.environ)
    note = " ".join(" ".join(args.note).split())
    if args.kind == "withdraw":
        return _notice_withdraw(args, engine, state, sender, note)
    try:
        repo, number = parse_pr_ref(args.pr)
        if len(note) > REPORT_MAX:
            raise NoticeError("a note is one line of at most %d characters (this one is %d)" % (REPORT_MAX, len(note)))
        _check_open_pr(engine, repo, number)  # a mistyped number is refused now; an unreadable lookup never blocks
        item, refreshed = record_pr_notice(state, repo, number, sender, note, now(), notice_boss(engine, sender))
    except NoticeError as err:
        sys.stderr.write("%s: %s\n" % (PROG, _one_line(str(err), 400)))
        return EXIT_USAGE
    if engine.audit is not None:
        engine.audit.append(engine.actor, "notice.pr", "%s#%d" % (repo, number),
                            {"from": sender, "refreshed": refreshed})
    sys.stderr.write("%s: notice of %s#%d %s; it shows in the person's panel until the PR is merged or closed "
                     "(nobody was messaged)\n" % (PROG, repo, number, "refreshed" if refreshed else "recorded"))
    print("%s#%d" % (repo, number))
    return EXIT_OK


cmd_notice.ensure_on_use = True   # the daemon is alive when it runs


def cmd_pending(args, runner, now):
    engine, _, _ = build_engine(runner, now, "cli", writable=False)
    entry = engine.pending(args.name)
    if args.json:
        print(json.dumps(entry, indent=2, sort_keys=True))
        return EXIT_OK
    print(_agent_line(entry))
    if entry["missing"]:
        print("  %s" % entry["missing"])
    repos = engine.repos_in_play()
    for fact in (entry["plan"] or {}).get("pending", []) + entry.get("riders", []):
        where = " issue %s" % issue_tag(fact.get("repo"), fact["issue"], repos) if fact["issue"] else ""
        print("  - %s%s  %s from %s%s at %s: %s" % (fact["key"], " [rider]" if fact.get("rider") else "", fact["kind"],
                                                    fact["from"] or "the fleet", where, iso(fact["created"]),
                                                    _one_line(fact["summary"], 200)))
    for problem in entry["source_problems"]:
        print("  problem: %s" % problem)
    return EXIT_OK


# ============================================================================
# PR 15: one Chief of Staff, many independent projects
#
# One section. docs/switchboard.md, "Many repos (PR 15)". The watched repos are
# derived on every pass, never listed (`watched_repos`); an issue is named by
# repo and number (`RepoIssue`, `resolve_issue`); and every repo has its own
# `gh` account (`GhAccounts`), whose token exists only in a child's environment.
# ============================================================================

class IssueRefError(Exception):
    """An issue reference that cannot be resolved to one repo."""


class RepoIssue(int):
    """An issue number that also says which repo it is in. It is an int, so every place that
    takes a number takes this; `.repo` is "owner/name", or None for a bare number."""

    repo = None

    def __new__(cls, number, repo=None):
        self = super().__new__(cls, number)
        self.repo = repo
        return self


_ISSUE_REF = re.compile(r"^(?:([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)#|#?)([0-9]+)$")


def parse_issue_ref(text):
    """`7`, `#7` or `owner/repo#7` -> a RepoIssue. Raises ValueError saying the accepted forms."""
    found = _ISSUE_REF.match(text.strip()) if isinstance(text, str) else None
    if not found or int(found.group(2)) < 1:
        raise ValueError("%r is not an issue: write N or owner/repo#N" % (text,))
    return RepoIssue(int(found.group(2)), found.group(1))


def issue_arg(text):
    """argparse's `type` for every --issue and issue argument."""
    try:
        return parse_issue_ref(text)
    except ValueError as err:
        raise argparse.ArgumentTypeError(str(err)) from None


def issue_repo(issue):
    """The repo an issue reference names, or None."""
    return getattr(issue, "repo", None)


def issue_tag(repo, number, repos=None):
    """How a message names an issue: `#2` with one repo in play, `api#2` with several (the repo name,
    or owner/name when two of them share a name)."""
    return decision_core.issue_tag(repo, number, repos)


def _fleet_repo(fleet, config):
    """The repo a fleet agent works in: its metadata, else (for an agent with a charter) `intent_repo`."""
    repo = (fleet or {}).get("repo")
    if isinstance(repo, str) and REPO_RE.match(repo):
        return repo
    if _is_issue_number((fleet or {}).get("charter")):
        return config.get("intent_repo")
    return None


def watched_repos(config, fleets):
    """The repos to watch now, sorted: the config baseline, every `repo` a live fleet agent names, and the
    repo of every charter it holds. `fleets` maps agent name -> metadata.fleet. Derived on every call, so
    there is nothing to keep and nothing to lose (R3). The `static-repos` fault reads the baseline only. The config's `excluded_repos` are taken out of the result,
    so every consumer of this set (forwarders, sweep, triage) honours them."""
    found = set(config["github_repos"])
    if not fault("static-repos"):
        for fleet in fleets.values():
            repo = _fleet_repo(fleet, config)
            if repo:
                found.add(repo)
    return sorted(load_module("repo_exclusion").without_excluded(config, found))   # #446: an excluded repository is never watched, whatever names it


def discovered_fleets(discovery):
    return {name: seen.fleet or {} for name, seen in (discovery.agents.items() if discovery else [])}


def resolve_issue(config, issue, fleet=None, watched=None):
    """(repo, number) for an issue reference. A qualifier wins; a bare number is in the caller's own repo,
    else `intent_repo`. With several repos watched, a caller with no repo gets a refusal listing the choices.
    (None, number) when no repo is known at all (the old one-repo behaviour); (None, None) for no issue."""
    if issue is None:
        return None, None
    number = int(issue)
    repo = None if fault("bare-issue-number") else issue_repo(issue)
    if repo:
        return repo, number
    repo = (fleet or {}).get("repo")
    if isinstance(repo, str) and repo:
        return repo, number
    choices = sorted(watched or [])
    if len(choices) > 1:
        raise IssueRefError("issue %d does not say which repo it is in, and %d are watched: write %s"
                            % (number, len(choices), " or ".join("%s#%d" % (c, number) for c in choices)))
    return config.get("intent_repo") or (choices[0] if choices else None), number


# ------------------------------------------------------- a gh account per repo

class AccountError(Exception):
    """No token could be had for a repo's gh account. The text never holds a token."""


TOKEN_ENV_NAMES = ("GH_TOKEN", "GITHUB_TOKEN", "GH_ENTERPRISE_TOKEN", "GITHUB_ENTERPRISE_TOKEN")
TOKEN_TTL = 60  # seconds a token is kept in memory; never written anywhere


class GhRateLimited(Exception):
    """A read the daemon did not make because the account's rate limit is spent until `until` (epoch)."""

    def __init__(self, account, until):
        self.account, self.until = account, until
        super().__init__("github: rate limited until %s, reads paused" % time.strftime("%H:%M", time.localtime(until)))


GH_ETAG_MAX = 400            # remembered answers (for a conditional read); the oldest go
GH_ETAG_BODY_MAX = 262144    # an answer larger than this is not remembered
GH_ETAG_BYTES_MAX = 8 * 1024 * 1024   # and all the remembered answers together stay under this: the oldest go
GH_LIMIT_MIN_PAUSE = 30      # a pause is at least this long (a reset that is in the past is not a reason to try at once)
GH_LIMIT_MAX_PAUSE = 3700    # and at most an hour and a little: a bad header cannot stop reads for a day
GH_LIMIT_DEFAULT_PAUSE = 120 # the limit was said but not when it lifts
_HTTP_HEAD = re.compile(r"\AHTTP/\S+\s+(\d{3})[^\r\n]*\r?\n")


def _split_http(text):
    """(status, {lower-case header: value}, body) of `gh api -i` output, or (None, {}, text) when it has no HTTP header block."""
    found = _HTTP_HEAD.match(text or "")
    if found is None:
        return None, {}, text
    rest = text[found.end():]
    split = re.search(r"\r?\n\r?\n", rest)
    head, body = (rest[:split.start()], rest[split.end():]) if split else (rest, "")
    headers = {}
    for line in head.splitlines():
        name, _, value = line.partition(":")
        if value:
            headers[name.strip().lower()] = value.strip()
    return int(found.group(1)), headers, body


def _says_rate_limited(*texts):
    """True when gh's own words say the rate limit is spent (`API rate limit exceeded`, `secondary rate limit`, HTTP 429)."""
    return any(re.search(r"rate limit|\bHTTP 429\b|abuse detection", text or "", re.I) for text in texts)


def _endpoint_of(path):
    """A path as the counter groups it: no repo, no query, numbers as `#` (`repos/o/r/issues/12/parent` -> `issues/#/parent`)."""
    return agent_calls.reduce_endpoint("api " + path)[4:]   # the allow-listed class: no repository, owner or name (#867)


class RepoExcluded(AccountError):
    """A read of a repository the config excludes (`excluded_repos`, #446): no process is started. An AccountError, so every caller that already
    degrades on an account problem (the hub's reads, the intent reader, a notice) degrades the same way."""


def refuse_excluded(config, repo):
    """The one check of the exclusion for a gh read of `repo`: raises RepoExcluded when the config excludes it. No config at all means no exclusion list, so the
    read is allowed (a deliberate fail open for a test double built without one: every real hub and GhAccounts carries its config)."""
    if repo and config is not None and load_module("repo_exclusion").is_excluded(config, repo):
        raise RepoExcluded("repository %s is excluded from the fleet's reads (excluded_repos)" % repo)


class GhAccounts:
    """Which gh account a repo uses, and its token at the moment of use.

    `gh_users` maps `owner/repo` or `owner/*` to an account name: the repo entry first, then the owner
    entry, then nothing (the environment's own default). The token comes from `gh auth token --user
    <account>` when it is needed, is held in memory for TOKEN_TTL seconds, and is handed to a child ONLY
    as GH_TOKEN in that child's environment: never in argv, a URL, a log, an audit entry, a message or an
    error (`scrub` takes it out of any text that was read back from a child).
    """

    def __init__(self, config, runner=subprocess.run, now=time.time, environ=None):
        self.config, self.runner, self.now = config, runner, now
        self.environ = os.environ if environ is None else environ
        self._tokens = {}
        self.etags = collections.OrderedDict()   # (account, path) -> (etag, body): for a conditional read; memory only, bounded
        self.calls = collections.deque()         # (time, account, endpoint, answered 304) of every read through `read`, newest last
        self.paused = {}                         # account -> epoch until which its reads wait (the limit's reset)
        self.limited_once = set()                # accounts whose pause was audited, so it is said once per episode
        self.lock = threading.Lock()             # the hub's threads and the pass read through one gate
        self.audit, self.actor = None, "daemon"
        self.conditional = False                 # ask with `-i` and keep the ETag: the daemon turns it on; a one-shot command or a test reads plainly

    @staticmethod
    def normal_repo(repo):
        """`owner/name` the way GitHub treats it: whitespace and a trailing `.git` or `/` off, lower case (GitHub names are not case sensitive). None when
        it is not a string. Used for the repo and for every `gh_users` key, so a different spelling of a mapped repo is still the mapped repo."""
        if not isinstance(repo, str):
            return None
        text = repo.strip().rstrip("/")
        if text.lower().endswith(".git"):
            text = text[:-4]
        return text.lower()

    def account_for(self, repo):
        if fault("one-account"):
            return None  # the fault: the default token reads every repo
        want = self.normal_repo(repo)
        if not want:
            return None
        users = {self.normal_repo(key): account for key, account in (self.config.get("gh_users") or {}).items() if isinstance(key, str)}
        if want in users:
            return users[want]
        return users.get("%s/*" % want.split("/")[0]) if "/" in want else None

    def default_available(self):
        return any(self.environ.get(name) for name in ("GH_TOKEN", "GITHUB_TOKEN"))

    def token_for(self, account):
        hit = self._tokens.get(account)
        if hit is not None and self.now() < hit[0]:
            return hit[1]
        clean = {k: v for k, v in self.environ.items() if k not in TOKEN_ENV_NAMES}
        try:
            done = self.runner([self.config["gh"], "auth", "token", "--user", account], capture_output=True,
                               text=True, timeout=self.config["call_timeout_seconds"], stdin=subprocess.DEVNULL,
                               env=clean)
        except (OSError, subprocess.SubprocessError) as err:
            raise AccountError("cannot ask gh for the token of account %s: %s" % (account, _one_line(str(err), 120))) from None
        token = (done.stdout or "").strip()
        if done.returncode != 0 or not token:
            raise AccountError("gh has no token for account %s: %s" % (
                account, _one_line(self.scrub(done.stderr or ""), 160) or "exit %d" % done.returncode))
        self._tokens[account] = (self.now() + TOKEN_TTL, token)
        return token

    def env_for(self, repo):
        """The environment for a child that works on `repo`, or None when the repo uses the default account."""
        account = self.account_for(repo) if repo else None
        if account is None:
            return None
        return dict(self.environ, GH_TOKEN=self.token_for(account), **{OWN_GH_ENV: "1"})

    def token_env(self, repo):
        """{"GH_TOKEN": token} for an agent working in `repo`, {} when the repo uses the default account."""
        account = self.account_for(repo) if repo else None
        return {} if account is None else {"GH_TOKEN": self.token_for(account)}

    def scrub(self, text):
        for _, token in self._tokens.values():
            if token:
                text = text.replace(token, REDACTED)
        return text

    def describe(self, repo):
        """The account name `status` shows. Never a token."""
        return self.account_for(repo) or "default"

    # -- reads: counted, conditional (ETag) and paused while the account is rate limited

    def read(self, runner, path, repo, timeout, paginate=False, **run_kwargs):
        """One `gh api <path>` GET with the repo's account. Returns a CompletedProcess like the runner's, its stdout the BODY only:

          - a read GitHub answered `304 Not Modified` to (we send the ETag we hold) is answered from memory and costs nothing against the limit;
          - every read is counted by account and endpoint (`status` shows them);
          - a 403/429 that says the limit is spent pauses every read of that account until the limit resets (GhRateLimited is raised
            at once, no process is started). No read is exempt: writes do not go through here.
        A runner whose answer has no HTTP header block (a fake, `--paginate`) is passed through as it is."""
        refuse_excluded(self.config, repo)   # #446: the lowest layer every gh read goes through: nothing is spawned for an excluded repository
        account = self.describe(repo)
        now = self.now()
        with self.lock:
            until = self.paused.get(account)
            if until is not None and now >= until:
                self.paused.pop(account, None)
                self.limited_once.discard(account)
                self._audit("github.rate_resumed", account, {})
                until = None
            if until is not None:
                raise GhRateLimited(account, until)
            cached = None if paginate else self.etags.get((account, path))
        use_head = self.conditional and not paginate
        flags = ["--paginate"] if paginate else (["-i"] + (["-H", "If-None-Match: " + cached[0]] if cached else []) if use_head else [])
        argv = [self.config["gh"], "api"] + flags + [path]   # the path stays last
        env = self.env_for(repo) if repo else None
        if env is not None:
            run_kwargs["env"] = env
        done = runner(argv, capture_output=True, text=True, timeout=timeout, **run_kwargs)
        status, headers, body = _split_http(done.stdout) if use_head else (None, {}, done.stdout)
        with self.lock:
            self.calls.append((now, account, _endpoint_of(path), status == 304))
            while self.calls and self.calls[0][0] < now - 600:
                self.calls.popleft()
        if status is None:
            if done.returncode != 0 and _says_rate_limited(done.stderr, done.stdout):   # a plain read: no header block, but gh says it in words
                self._pause(account, now + GH_LIMIT_DEFAULT_PAUSE, 0)
            return done
        if status == 304 and cached is not None:
            with self.lock:
                self.etags.move_to_end((account, path))
            return subprocess.CompletedProcess(argv, 0, cached[1], "")
        if 200 <= status < 300:
            etag = headers.get("etag")
            if etag and len(body) <= GH_ETAG_BODY_MAX and "since=" not in path:   # a moving window never repeats: nothing to be conditional about
                with self.lock:
                    self.etags[(account, path)] = (etag, body)
                    self.etags.move_to_end((account, path))
                    while len(self.etags) > GH_ETAG_MAX or sum(len(v[1]) for v in self.etags.values()) > GH_ETAG_BYTES_MAX:
                        self.etags.popitem(last=False)
            return subprocess.CompletedProcess(argv, done.returncode, body, done.stderr)
        if status in (403, 429):
            reset = self._limit_reset(status, headers, body, now)
            if reset is not None:
                self._pause(account, reset, status)
        return subprocess.CompletedProcess(argv, done.returncode or 1, body, done.stderr or ("HTTP %d" % status))

    def read_usage(self):
        """{account: (used, remaining, limit, reset)} from `gh api rate_limit` for each account this fleet reads with (the `gh_users` accounts, and the default
        token when one is set). That endpoint does not count against the budget, and it is NOT counted here either (it does not go through `read`, and the
        child carries the switchboard's own marker). Bounded: at most 8 accounts, one call each, each with the call timeout. Never raises; an account that
        cannot be read is left out."""
        found = {}
        names = sorted({a for a in (self.config.get("gh_users") or {}).values() if isinstance(a, str) and a})[:agent_calls.USAGE_ACCOUNTS]
        for account in names + ([None] if self.default_available() else []):
            try:
                env = dict(self.environ, **{OWN_GH_ENV: "1"})
                if account is not None:
                    env["GH_TOKEN"] = self.token_for(account)
                done = self.runner([self.config["gh"], "api", "rate_limit"], capture_output=True, text=True,
                                   timeout=self.config["call_timeout_seconds"], stdin=subprocess.DEVNULL, env=env)
                got = agent_calls.parse_usage(done.stdout or "") if done.returncode == 0 else None
                if got is not None:
                    found[account or "default"] = got
            except Exception:
                continue
        return found

    def _pause(self, account, until, status):
        with self.lock:
            self.paused[account] = max(until, self.paused.get(account, 0))   # a later, shorter answer never shortens a pause
            first = account not in self.limited_once
            self.limited_once.add(account)
        if first:
            self._audit("github.rate_limited", account, {"until": iso(until), "status": status})

    @staticmethod
    def _limit_reset(status, headers, body, now):
        """When a 403/429 that is the rate limit lets reads go on again (epoch), or None when it is some other refusal (a 403 for a private repo)."""
        remaining, reset, retry = headers.get("x-ratelimit-remaining"), headers.get("x-ratelimit-reset"), headers.get("retry-after")
        limited = status == 429 or remaining == "0" or retry is not None or re.search(r"rate limit", body or "", re.I) is not None
        if not limited:
            return None
        until = None
        if retry is not None and re.fullmatch(r"[0-9]{1,10}", retry):
            until = now + int(retry)
        elif remaining == "0" and reset is not None and re.fullmatch(r"[0-9]{1,12}", reset):
            until = float(reset)
        if until is None:
            until = now + GH_LIMIT_DEFAULT_PAUSE
        return min(max(until, now + GH_LIMIT_MIN_PAUSE), now + GH_LIMIT_MAX_PAUSE)

    def _audit(self, event, subject, detail):
        try:
            if self.audit is not None:
                self.audit.append(self.actor, event, subject, detail)
        except Exception:
            pass   # evidence only

    def call_summary(self, now):
        """{"at", "last_minute": {account: {endpoint: n}}, "avg_5min": n/min, "not_modified": n (last minute), "paused": {account: iso}}."""
        with self.lock:
            recent = [c for c in self.calls if c[0] >= now - 300]
            paused = {a: u for a, u in self.paused.items() if u > now}
        last = collections.defaultdict(collections.Counter)
        for at, account, endpoint, _ in recent:
            if at >= now - 60:
                last[account][endpoint] += 1
        return {"at": iso(now), "last_minute": {a: dict(c) for a, c in sorted(last.items())}, "avg_5min": round(len(recent) / 5.0, 1),
                "not_modified": sum(1 for c in recent if c[0] >= now - 60 and c[3]), "paused": {a: iso(u) for a, u in sorted(paused.items())}}


def launch_account_problem(config, accounts, repo):
    """Why a launch into `repo` must be refused (a sentence naming the missing entry), or None."""
    if not repo or not config.get("gh_users") or accounts.account_for(repo) or accounts.default_available() \
            or fault("one-account"):
        return None
    owner = repo.split("/")[0]
    return ("no gh account for %s: add \"%s\" or \"%s/*\" to gh_users in %s (and no default token is set)"
            % (repo, repo, owner, config_path()))


# ---------------------------------------------------------------- the judge's rule

_GH_SEG = re.compile(r"(?:^|[\s;&|(`'\"/])gh\s+([^;&|\n`]*)")
_API_REPOS = re.compile(r"(?:^|[\s'\"])/?(?:orgs/[^/\s'\"]+|user)/repos/?(?=$|[\s'\"?])")
_POST_FLAG = re.compile(r"(?:^|\s)(?:-X\s*|--method[=\s]\s*)POST\b", re.I)
_FIELD_FLAG = re.compile(r"(?:^|\s)(?:-f|-F|--field|--raw-field|--input)\b")


def repo_commissioning_rule(command):
    """The sentence naming what a shell command does to a repo's existence or visibility, or None.

    `gh repo create`, `gh repo delete`, `gh repo edit --visibility` and a POST to `/orgs/*/repos` are
    `hard_to_reverse` whatever the thresholds say: the Chief of Staff commissions a worker to do these, after
    a decision, and no agent does one quietly. Deterministic, so it needs no model; judge machinery only
    ever tightens."""
    if not isinstance(command, str):
        return None
    for found in _GH_SEG.finditer(command):
        words = found.group(1)
        positional = [w for w in words.split() if not w.startswith("-")]
        if positional[:2] in (["repo", "create"], ["repo", "delete"]):
            return "gh repo %s" % positional[1]
        if positional[:2] == ["repo", "edit"] and re.search(r"(?:^|\s)--visibility\b", words):
            return "gh repo edit --visibility"
        if positional[:1] == ["api"] and _API_REPOS.search(" " + words) \
                and (_POST_FLAG.search(words) or (_FIELD_FLAG.search(words) and not re.search(r"(?:-X|--method)", words))):
            return "gh api POST to a repo-creating endpoint"
    return None


# ------------------------------------------------- intent lines (PR 6)
#
# Every message names its ask and carries the ask's Intent and Done-when
# (docs/switchboard.md, "Intent lines"). GitHub is the only copy: this section
# reads an issue's `## Intent` section through `gh api` (GET only, invariant 6)
# and never writes it. Three levels: a charter (never repeated), an ask under
# it (Intent + Done when, written by the Chief of Staff), and optionally a work
# item under the ask (its own Intent line, written by the orchestrator).

INTENT_DEFAULTS = {
    "intent_repo": None,     # OWNER/REPO holding charters, asks and work items; None = no ask machinery
    "intent_required": True,  # with intent_repo set, `send` needs --issue
}
DEFAULTS.update(INTENT_DEFAULTS)

NO_INTENT = "no intent recorded"
INTENT_TTL = 300        # seconds a cached issue is trusted; a webhook invalidates it sooner
INTENT_TTL_LIVE = 1800  # ... while the repo's webhook forwarder is live (the same one that cached it): the webhook is what invalidates
INTENT_LINE_LIMIT = 240  # characters per header line
REPO_RE = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")


def validate_intent_config(config, source):
    repo = config["intent_repo"]
    if repo is not None and not (isinstance(repo, str) and REPO_RE.match(repo)):
        raise ConfigError("%s: 'intent_repo' must be OWNER/REPO or null, got %r" % (source, repo))
    if not isinstance(config["intent_required"], bool):
        raise ConfigError("%s: 'intent_required' must be true or false, got %r" % (source, config["intent_required"]))


_HEADING = re.compile(r"^\s{0,3}#{1,6}\s+(.*?)\s*#*\s*$")
_DONE_WHEN = re.compile(r"^(?:[-*]\s+)?\**done when\**\s*:\s*\**\s*(.*?)\**\s*$", re.IGNORECASE)
_CHARTER_BLOCK = re.compile(r"```ya?ml\s*\n\s*orchestrator\s*:", re.IGNORECASE)


def parse_intent(body):
    """(intent, done_when) from the `## Intent` section of an issue body.

    The first line of the section is the Intent; a line starting `Done when:`
    is the Done-when. Either may be missing (None). Fenced code is ignored,
    the section ends at the next heading, and CRLF bodies are fine.
    """
    intent = done_when = None
    inside = fenced = False
    for line in (body or "").splitlines():
        if line.lstrip().startswith(("```", "~~~")):
            fenced = not fenced
            continue
        if fenced:
            continue
        heading = _HEADING.match(line)
        if heading:
            if inside:
                break
            inside = heading.group(1).strip().lower() == "intent"
            continue
        text = line.strip()
        if not inside or not text:
            continue
        match = _DONE_WHEN.match(text)
        if match:
            done_when = done_when or match.group(1).strip() or None
        elif intent is None:
            intent = text
    return intent, done_when


class IntentError(Exception):
    """GitHub could not answer. reason: "not_found", "unavailable" or "gh"."""

    def __init__(self, reason, detail=None):
        self.reason = reason
        super().__init__("%s: %s" % (reason, detail) if detail else reason)


_CHARTER_YAML = re.compile(r"```ya?ml\s*\n(\s*orchestrator\s*:.*?)```", re.IGNORECASE | re.DOTALL)
_WORKSPACE_LINE = re.compile(r"^\s*workspace\s*:\s*(.*?)\s*$", re.IGNORECASE | re.MULTILINE)


def charter_workspace(body):
    """The `workspace:` line of a charter's yaml block (the exact herdr workspace label), or None."""
    block = _CHARTER_YAML.search(body or "")
    line = _WORKSPACE_LINE.search(block.group(1)) if block else None
    value = line.group(1) if line else ""
    if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
        value = value[1:-1]
    return value or None


class IssueIntent:
    """What the switchboard knows of one issue: its Intent lines, and what kind it is."""

    def __init__(self, number, state, title, intent, done_when, updated_at, charter):
        self.number, self.state, self.title = number, state, title
        self.intent, self.done_when, self.updated_at, self.charter = intent, done_when, updated_at, charter
        self.repo = None  # PR 15: set by the reader that fetched it
        self.workspace = None  # PR 15: a charter's `workspace:` line

    @classmethod
    def from_api(cls, data):
        number = data.get("number") if isinstance(data, dict) else None
        if not (isinstance(number, int) and not isinstance(number, bool)):
            raise IntentError("gh", "an issue came back without a number")
        body = data.get("body") if isinstance(data.get("body"), str) else ""
        intent, done_when = parse_intent(body)
        found = cls(number, data.get("state"), data.get("title") or "", intent, done_when,
                    data.get("updated_at"), bool(_CHARTER_BLOCK.search(body)))
        found.workspace = charter_workspace(body)
        found.labels = [l.get("name") if isinstance(l, dict) else l for l in (data.get("labels") or []) if isinstance(l.get("name") if isinstance(l, dict) else l, str)]   # #432: the load feed's waiting and parked asks
        found.parked_until = parked_until(body, found.labels)   # the switchboard's own parser: the load module never copies it
        return found


def _header_line(text):
    return _one_line(text, INTENT_LINE_LIMIT)


def ask_lines(issue, tag=None):
    """The ask's header lines: Intent, then Done when; one line when neither is recorded. `tag` (PR 15) is how
    the ask is named when several repos are in play: `web#2`."""
    tag = tag or "#%d" % issue.number
    if issue.intent is None and issue.done_when is None:
        return [_header_line("Ask %s: %s" % (tag, NO_INTENT))]
    return [_header_line("Ask %s Intent: %s" % (tag, issue.intent or NO_INTENT)),
            _header_line("Done when: %s" % (issue.done_when or "not recorded"))]


def work_lines(issue, tag=None):
    return [_header_line("Work item %s Intent: %s" % (tag or "#%d" % issue.number, issue.intent or NO_INTENT))]


class IntentReader:
    """Reads Intent lines from GitHub, with an in-memory cache.

    Only ever runs `<gh> api <path>`: a GET, with no method, field or input
    flag, so there is nothing here that can write. Entries are keyed by repo
    and issue, remember the issue's `updated_at`, and expire after `ttl`
    seconds; `invalidate(issue)` drops them at once (the webhook handler's
    call, PR 5). A failed read is never cached.
    """

    def __init__(self, gh, repo, runner=subprocess.run, now=time.time, timeout=20, ttl=INTENT_TTL, accounts=None):
        self.gh, self.repo, self.runner, self.now = gh, repo, runner, now
        self.timeout, self.ttl = timeout, ttl
        self.accounts = accounts  # PR 15: a GhAccounts; None reads every repo with the default account
        self.config = None        # the config whose excluded_repos are never read; when None, the config of `accounts` (every reader has one)
        self._cache = {}
        self.live, self.live_ttl = None, INTENT_TTL_LIVE   # live(repo) -> the running forwarder's generation, or None (the hub sets it)

    # -- GitHub

    def env_for(self, repo):
        """The child environment for `repo`'s account, or None. Raises IntentError, never with a token in it."""
        if self.accounts is None or not repo:
            return None
        try:
            return self.accounts.env_for(repo)
        except AccountError as err:
            raise IntentError("gh", str(err)) from None

    def _api(self, path, repo=None):
        config = self.config if self.config is not None else getattr(self.accounts, "config", None)   # every construction passes `accounts=GhAccounts(config, ...)`
        if config is not None and load_module("repo_exclusion").is_excluded(config, repo or self.repo):
            raise IntentError("excluded", "repository %s is excluded from the fleet's reads (excluded_repos)" % (repo or self.repo))   # #446: no read
        argv = [self.gh, "api", path]
        env = self.env_for(repo)
        extra = {"env": env} if env is not None else {}
        try:
            if self.accounts is not None and repo:   # counted, conditional (a 304 costs nothing) and paused while the account is rate limited
                result = self.accounts.read(self.runner, path, repo, self.timeout, stdin=subprocess.DEVNULL)
            else:
                result = self.runner(argv, capture_output=True, text=True, timeout=self.timeout,
                                     stdin=subprocess.DEVNULL, **extra)
        except GhRateLimited as err:
            raise IntentError("unavailable", str(err)) from None
        except AccountError as err:
            raise IntentError("gh", str(err)) from None
        except subprocess.TimeoutExpired:
            raise IntentError("unavailable", "gh did not answer within %ss" % self.timeout) from None
        except OSError as err:
            raise IntentError("unavailable", "cannot run %s: %s" % (self.gh, err.strerror or err)) from None
        if result.returncode != 0:
            detail = _one_line(result.stderr) or _one_line(result.stdout) or "exit %d" % result.returncode
            if self.accounts is not None:
                detail = self.accounts.scrub(detail)
            if re.search(r"\b404\b|Not Found", detail):
                raise IntentError("not_found", detail)
            raise IntentError("gh", detail)
        try:
            return json.loads(result.stdout)
        except ValueError:
            raise IntentError("gh", "gh returned non-JSON: %s" % _one_line(result.stdout, 120)) from None

    def _api_bytes(self, path, repo=None, limit=None):
        """The raw bytes `gh api <path>` prints (an archive), through the same account and exclusion rule as `_api`. `limit` bounds the bytes kept."""
        config = self.config if self.config is not None else getattr(self.accounts, "config", None)
        if config is not None and load_module("repo_exclusion").is_excluded(config, repo or self.repo):
            raise IntentError("excluded", "repository %s is excluded from the fleet's reads (excluded_repos)" % (repo or self.repo))
        env = self.env_for(repo)
        extra = {"env": env} if env is not None else {}
        try:
            result = self.runner([self.gh, "api", path], capture_output=True, timeout=self.timeout, stdin=subprocess.DEVNULL, **extra)
        except subprocess.TimeoutExpired:
            raise IntentError("unavailable", "gh did not answer within %ss" % self.timeout) from None
        except OSError as err:
            raise IntentError("unavailable", "cannot run %s: %s" % (self.gh, err.strerror or err)) from None
        if result.returncode != 0:
            detail = _one_line((result.stderr or b"").decode("utf-8", "replace")) or "exit %d" % result.returncode
            if self.accounts is not None:
                detail = self.accounts.scrub(detail)
            raise IntentError("not_found" if re.search(r"\b404\b|Not Found", detail) else "gh", detail)
        out = result.stdout if isinstance(result.stdout, bytes) else str(result.stdout or "").encode()
        if limit is not None and len(out) > limit:
            raise IntentError("gh", "the archive is %d bytes, over the limit of %d bytes" % (len(out), limit))
        return out

    def _generation(self, key):
        """The running forwarder's generation for this entry's repo (for the long-lived kinds), or None."""
        if self.live is None or self.ttl <= 0 or key[0] not in ("issue", "parent"):
            return None
        try:
            return self.live(key[1])
        except Exception:
            return None

    def _cached(self, key, fetch):
        hit = self._cache.get(key)
        if hit is not None:
            gen = hit[2] if len(hit) > 2 else None
            ttl = self.live_ttl if gen is not None and gen == self._generation(key) else self.ttl   # long only under the SAME live forwarder: its webhook invalidates
            if self.now() - hit[0] < ttl:
                return hit[1]
        value = fetch()
        self._cache[key] = (self.now(), value, self._generation(key))
        return value

    def invalidate(self, issue, repo=None):
        """Forget what is cached about `issue`; the next read asks GitHub again."""
        repo = repo or self.repo
        for kind in ("issue", "parent", "orders"):
            self._cache.pop((kind, repo, issue), None)

    # -- reading

    def issue(self, number, repo=None):
        repo = repo or self.repo

        def fetch():
            found = IssueIntent.from_api(self._api("repos/%s/issues/%d" % (repo, number), repo))
            found.repo = repo
            return found

        return self._cached(("issue", repo, number), fetch)

    def charter_orders(self, number, repo=None):
        """PR 17: the charter's standing orders (a list), read like the rest: cached for `ttl` seconds."""
        repo = repo or self.repo
        return self._cached(("orders", repo, number), lambda: fetch_orders(self, number, repo))

    def parent(self, number, repo=None):
        """The parent issue's number, or None when the issue has no parent."""
        repo = repo or self.repo

        def fetch():
            try:
                found = self._api("repos/%s/issues/%d/parent" % (repo, number), repo)
            except IntentError as err:
                if err.reason == "not_found":
                    return None
                raise
            return IssueIntent.from_api(found).number

        return self._cached(("parent", repo, number), fetch)

    def ask_of(self, number, repo=None):
        """(ask, work item) for an issue: a work item's ask is its parent.

        A parent counts as the ask when it has a parent of its own (the
        charter); under the charter itself, the issue is the ask.
        """
        parent = self.parent(number, repo)
        if parent is not None and self.parent(parent, repo) is not None:
            return parent, number
        return number, None

    def header(self, number, repo=None, repos=None):
        """(ask, ask lines, work item, work lines) for a message about `number`, at most
        three lines; None for a charter, which is never repeated. `repos`: the repos in play; with several,
        the lines name their issue with a repo tag."""
        repo = repo or self.repo
        if self.issue(number, repo).charter:
            return None
        ask, work = self.ask_of(number, repo)
        ask_issue = self.issue(ask, repo)
        if ask_issue.charter:
            return None
        if work is None:
            return ask, ask_lines(ask_issue, issue_tag(repo, ask, repos)), None, []
        return (ask, ask_lines(ask_issue, issue_tag(repo, ask, repos)), work,
                work_lines(self.issue(work, repo), issue_tag(repo, work, repos)))

    def missing_intent(self, number, repo=None):
        """The issues in this one's ask chain (ask, work item) with no Intent line. Charters are exempt."""
        if self.issue(number, repo).charter:
            return []
        ask, work = self.ask_of(number, repo)
        chain = [self.issue(n, repo) for n in ([ask] if work is None else [ask, work])]
        return [issue.number for issue in chain if issue.intent is None and not issue.charter]

    def open_asks(self, charter, repo=None):
        """The open sub-issues of a charter, derived from GitHub on every call."""
        repo = repo or self.repo
        found = self._api("repos/%s/issues/%d/sub_issues?per_page=100" % (repo, charter), repo)
        asks = []
        for data in found if isinstance(found, list) else []:
            issue = IssueIntent.from_api(data)
            issue.repo = repo
            self._cache[("issue", repo, issue.number)] = (self.now(), issue)
            if issue.state == "open":
                asks.append(issue)
        return asks


def intent_reader_for(config, runner=subprocess.run, now=time.time):
    """The IntentReader the config asks for, or None when no `intent_repo` is set."""
    if not config.get("intent_repo"):
        return None
    reader = IntentReader(config["gh"], config["intent_repo"], runner, now, config["call_timeout_seconds"],
                          accounts=GhAccounts(config, runner, now))
    reader.config = config
    return reader


# -- composing: one section per ask

def section_resolver(engine, observation):
    """issue -> (ask, ask lines, work item, work lines) for compose, or None.

    None (no sections at all) when no ask machinery is configured or under the
    `no-intent-header` fault. A header GitHub cannot supply says so instead of
    stopping the delivery: an unreachable GitHub must not hold your agents'
    messages. The repo comes from the recipient's fleet metadata when it names
    one, else the config's `intent_repo`.
    """
    reader = getattr(engine, "intents", None)
    if reader is None or fault("no-intent-header"):
        return None
    own = ((observation.fleet or {}).get("repo") if observation else None) or reader.repo
    repos = engine.repos_in_play()

    def section(issue, repo=None):
        repo = repo or own
        try:
            return reader.header(issue, repo, repos)
        except IntentError as err:
            return issue, [_header_line("Ask %s: intent unavailable (%s)" % (issue_tag(repo, issue, repos), err))], None, []

    return section


def sectioned_lines(facts, section, item):
    """The body of a message: items that name no issue (or a charter) first, then
    one section per ask, never interleaved. A section is the ask's lines, its
    own items, then each work item's line followed by that work item's items."""
    lines, asks = [], {}
    for fact in facts:
        found = section(fact.issue, fact.repo) if fact.issue else None
        if found is None:
            lines.append(item(fact))
            continue
        ask, ask_header, work, work_header = found
        entry = asks.setdefault((fact.repo, ask), {"header": ask_header, "direct": [], "work": {}})  # PR 15: per repo
        if work is None:
            entry["direct"].append(item(fact))
        else:
            entry["work"].setdefault(work, (work_header, []))[1].append(item(fact))
    for entry in asks.values():
        lines.append("")
        lines.extend(entry["header"] + entry["direct"])
        for work_header, items in entry["work"].values():
            lines.extend(work_header + items)
    return lines


# -- change surfacing: pure functions over an `issues` webhook payload (PR 5 wires them)

def intent_diff(payload):
    """[(label, old, new)] for the Intent and Done-when an `issues.edited` payload
    actually changed; [] for any other event, or an edit that left them alone."""
    if not isinstance(payload, dict) or payload.get("action") != "edited":
        return []
    old = ((payload.get("changes") or {}).get("body") or {}).get("from")
    if not isinstance(old, str):
        return []  # the body was not edited (a title or label edit)
    new = (payload.get("issue") or {}).get("body")
    old_intent, old_done = parse_intent(old)
    new_intent, new_done = parse_intent(new if isinstance(new, str) else "")
    changes = []
    if old_intent != new_intent:
        changes.append(("Intent", old_intent, new_intent))
    if old_done != new_done:
        changes.append(("Done when", old_done, new_done))
    return changes


def _change_lines(changes):
    return ["%s: %s -> %s" % (label, old or "(none)", new or "(none)") for label, old, new in changes]


def _payload_issue(payload):
    issue = payload.get("issue") or {}
    number, updated = issue.get("number"), issue.get("updated_at")
    if not (isinstance(number, int) and not isinstance(number, bool) and number >= 1):
        raise FactError("an issues event without an issue number")
    try:
        created = datetime.strptime(updated, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc).timestamp()
    except (TypeError, ValueError):
        raise FactError("an issues event without a usable issue.updated_at: %r" % (updated,)) from None
    return number, updated, created


def intent_change_fact(payload, recipient="chief-of-staff"):
    """The Chief of Staff's item for an Intent edit, or None when the edit left
    the Intent section alone. Key `intent.edit:<issue>:<updated_at>`, so a
    redelivered webhook is one item."""
    changes = intent_diff(payload)
    if not changes:
        return None
    number, updated, created = _payload_issue(payload)
    login = (payload.get("sender") or {}).get("login")
    repo = (payload.get("repository") or {}).get("full_name")
    repo = repo if isinstance(repo, str) and REPO_RE.match(repo) else None
    summary = "\n".join(["The Intent section of #%d was edited on GitHub:" % number] + _change_lines(changes))
    # PR 15: the same number in two repos is two issues, so the key that stops a repeat names the repo
    key = "intent.edit:%s:%s" % ("%s#%d" % (repo, number) if repo else number, updated)
    return Fact(key, recipient, "intent.edit", summary, created, issue=number,
                sender=login if isinstance(login, str) and login else "github", repo=repo)


def intent_change_toast(payload):
    """What to tell you when an Intent changed: {"title", "body"} for
    HerdrClient.notification_show, or None."""
    changes = intent_diff(payload)
    if not changes:
        return None
    number, _, _ = _payload_issue(payload)
    return {"title": "Intent changed on #%d" % number, "body": _one_line("; ".join(_change_lines(changes)), 300)}


# -- `send` needs an issue

def intent_refusal(config, issue):
    """Why `send` must refuse without --issue, or None."""
    if config.get("intent_repo") and config.get("intent_required") and issue is None:
        return ("send needs --issue <n>: every message names the ask it belongs to "
                "(run `%s intent <n>`; set intent_required to false in the config to turn this off)" % PROG)
    return None


# -- status: issues agents refer to that have no Intent section

def referenced_issues(discovery, facts):
    """Issue numbers agents refer to: the issue each fleet agent works on, and
    each pending fact's issue. Charters are exempt when they are looked at."""
    numbers = {fact.issue for fact in facts if fact.issue}
    for agent in discovery.agents.values():
        issue = (agent.fleet or {}).get("issue")
        if isinstance(issue, int) and not isinstance(issue, bool):
            numbers.add(issue)
    return sorted(numbers)


INTENT_GAP_BUDGET = 4.0     # seconds `status` spends checking which referenced issues lack an Intent (#86)
INTENT_GAP_WORKERS = 8      # gh reads in flight at once; each is one subprocess, so they overlap


def intent_gap_report(engine, discovery, facts, budget=None):
    """{"intent_gaps": [issue...], "intent_errors": [text...], "intent_unchecked": n}; empty when no ask repo is
    configured. The reads run in parallel and share one time budget (#86): serial `gh` calls made `status` take
    ~0.4 s per referenced issue. Issues not read in time are counted, never guessed."""
    reader = getattr(engine, "intents", None)
    if reader is None:
        return {}
    budget = INTENT_GAP_BUDGET if budget is None else budget
    numbers = list(referenced_issues(discovery, facts))
    gaps, errors, pending = set(), [], 0
    if numbers:
        # Daemon threads, not an executor: an executor's workers are joined at interpreter exit, so one stuck `gh`
        # would hold the process after the status was printed.
        todo, results, deadline = list(reversed(numbers)), {}, time.monotonic() + budget
        lock = threading.Lock()

        def work():
            while True:
                with lock:
                    if not todo:
                        return
                    number = todo.pop()
                try:
                    results[number] = ("ok", reader.missing_intent(number))
                except IntentError as err:
                    results[number] = ("error", "#%d: %s" % (number, err))
                except Exception as err:  # one odd read must not take the status down
                    results[number] = ("error", "#%d: %s" % (number, _one_line(str(err), 100)))

        threads = [threading.Thread(target=work, daemon=True) for _ in range(min(INTENT_GAP_WORKERS, len(numbers)))]
        for thread in threads:
            thread.start()
        for thread in threads:
            thread.join(max(0.0, deadline - time.monotonic()))
        with lock:
            todo.clear()  # nothing new starts after the budget
        for number, (kind, value) in sorted(dict(results).items()):
            if kind == "ok":
                gaps.update(value)
            else:
                errors.append(value)
        pending = len(numbers) - len(results)
    report = {"intent_gaps": sorted(gaps), "intent_errors": errors}
    if pending:
        report["intent_unchecked"] = pending
    return report


def intent_gap_lines(agents):
    lines = []
    if agents.get("intent_gaps"):
        lines.append("      intent     no Intent section: %s" % ", ".join("#%d" % n for n in agents["intent_gaps"]))
    lines.extend("        intent problem: %s" % error for error in agents.get("intent_errors", []))
    if agents.get("intent_unchecked"):
        lines.append("        intent: %d referenced issue(s) not checked within the %gs budget (partial answer)"
                     % (agents["intent_unchecked"], INTENT_GAP_BUDGET))
    return lines


# -- the CLI: `intent` and `intents`

def _intent_reader(runner, now):
    config = load_config()
    active_faults()
    reader = intent_reader_for(config, runner, now)
    if reader is None:
        raise ConfigError("'intent_repo' is not configured in %s: set it to OWNER/REPO, the repo that "
                          "holds charters, asks and work items" % config_path())
    return reader


def soft_caller(runner, now):
    """(caller's fleet, watched repos) for a command that may be run by hand: what the fleet says when it
    can be read and the caller is a fleet agent, else nothing (and the config's repos)."""
    config = load_config()
    try:
        engine, _, _ = build_engine(runner, now, "cli", writable=False)
        fleets = discovered_fleets(engine.discover(engine.now()))
        watched = watched_repos(config, fleets)
    except (ConfigError, V2Error, HerdrError):
        return {}, watched_repos(config, {})
    try:
        return caller_fleet(engine.herdr, engine.v2, os.environ), watched
    except IdentityUncertain:
        raise
    except (CallerError, V2Error, HerdrError):
        return {}, watched


def cmd_intent(args, runner, now):
    """Print the ask's Intent and Done-when, and the work item's Intent line."""
    reader = _intent_reader(runner, now)
    fleet, watched = soft_caller(runner, now)
    try:
        repo, number = resolve_issue(load_config(), args.issue, fleet, watched)
    except IssueRefError as err:
        sys.stderr.write("%s: %s\n" % (PROG, err))
        return EXIT_USAGE
    repos = watched if len(watched) > 1 else None
    found = reader.header(number, repo, repos)
    if found is None:
        print("%s is a charter: its standing job is not repeated in messages. Ask for an ask under it."
              % issue_tag(repo or reader.repo, number, repos))
        return EXIT_OK
    _, ask_header, _, work_header = found
    print("\n".join(ask_header + work_header))
    return EXIT_OK


cmd_intent.ensure_on_use = True   # the daemon is alive when it runs


def caller_fleet(herdr, v2, environ):
    """The caller's `metadata.fleet`: HERDR_PANE_ID -> herdr agent -> v2 session."""
    fleet = session_identity(herdr, v2, environ)
    if fleet is not None:
        return fleet
    pane = environ.get("HERDR_PANE_ID")
    if not pane:
        raise no_pane_error("run intents from a fleet agent's herdr pane")
    session_id = agent_session(herdr.agent_get(pane))
    fleet = _fleet_meta(v2.session_get(session_id)) if session_id else None
    if not fleet or not isinstance(fleet.get("name"), str) or not fleet["name"]:
        raise CallerError("pane %s is not a fleet agent (no metadata.fleet.name)" % pane)
    return fleet


def _is_issue_number(value):
    return isinstance(value, int) and not isinstance(value, bool) and value >= 1


def asks_of_caller(engine, fleet, now):
    """[(owner, IssueIntent)] the caller is accountable for, from GitHub now.

    The rule: an ask is an open sub-issue of an orchestrator's charter. A
    Chief of Staff sees the asks under every orchestrator's charter, found
    from the registry (`role` orchestrator, `charter` an issue number, #969); an
    orchestrator sees the asks under its own charter; any other role sees the
    ask of the issue it works on.
    """
    reader = engine.intents
    repo = fleet.get("repo") or reader.repo
    owners = registry_owners(engine)   # #969: an orchestrator's charter is the registry row's, never the launch metadata (which a `charter set` correction cannot reach)
    if fleet.get("role") == "chief-of-staff":
        charters = [(agent.name, owners.get(agent.name), _fleet_repo(agent.fleet, engine.config) or repo)
                    for agent in sorted(engine.discover(now).agents.values(), key=lambda a: a.name)
                    if (agent.fleet or {}).get("role") == "orchestrator"]
    elif fleet.get("role") == "orchestrator":
        charters = [(fleet["name"], owners.get(fleet["name"]), repo)]
    else:
        issue = fleet.get("issue")
        if not _is_issue_number(issue):
            return []
        ask, _ = reader.ask_of(issue, repo)
        return [(fleet["name"], reader.issue(ask, repo))]
    asks = []
    for owner, charter, charter_repo in charters:
        if _is_issue_number(charter):
            asks.extend((owner, issue) for issue in reader.open_asks(charter, charter_repo))
    return asks


def ask_row(owner, issue, repos=None):
    return "%s  [%s]  %s  | Done when: %s" % (issue_tag(issue.repo, issue.number, repos), owner,
                                              issue.intent or NO_INTENT, issue.done_when or "not recorded")


def cmd_intents(args, runner, now):
    """The caller's open asks, one line each with its Done-when."""
    engine, _, config = build_engine(runner, now, "cli", writable=False)
    if engine.intents is None:
        raise ConfigError("'intent_repo' is not configured in %s: set it to OWNER/REPO" % config_path())
    fleet = caller_fleet(engine.herdr, engine.v2, os.environ)
    rows = asks_of_caller(engine, fleet, engine.now())
    if not rows:
        print("no open asks for %s" % fleet["name"])
    engine.discover(engine.now())
    repos = engine.repos_in_play()
    for owner, issue in rows:
        print(ask_row(owner, issue, repos))
    return EXIT_OK


INTENT_COMMANDS = {"intent": cmd_intent, "intents": cmd_intents}


def add_intent_parsers(sub):
    intent = sub.add_parser("intent", help="Print an issue's ask: its Intent and Done-when, and the work item's Intent")
    intent.add_argument("issue", type=issue_arg, help="The issue number")
    sub.add_parser("intents", help="Your open asks, one line each with its Done-when")


# ---------------------------------------------------------------- `plan check` (#135, gate G0a)

PLAN_URL_RE = re.compile(r"^https?://github\.com/([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)/issues/([0-9]+)(?:#issuecomment-([0-9]+))?/?$")
PLAN_COMMENT_PAGES = 10


class PlanInputError(Exception):
    """The plan or the ask cannot be read: exit 2."""


def parse_plan_source(text, default_repo=None):
    """(repo, number, comment id or None) from `owner/repo#N`, an issue URL (a `#issuecomment-ID` picks that comment),
    or a bare `N` / `#N` with `default_repo`. Raises PlanInputError."""
    text = (text or "").strip()
    found = PLAN_URL_RE.match(text)
    if found:
        return found.group(1), int(found.group(2)), int(found.group(3)) if found.group(3) else None
    found = re.match(r"^([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)#([0-9]+)$", text) or re.match(r"^()#?([0-9]+)$", text)
    if not found or int(found.group(2)) < 1:
        raise PlanInputError("%r is not a plan: write owner/repo#N, an issue URL, or --file PATH" % text)
    repo = found.group(1) or default_repo
    if not repo:
        raise PlanInputError("%r names no repo and no intent_repo is configured: write owner/repo#N" % text)
    return repo, int(found.group(2)), None


def fetch_plan(reader, repo, number, comment_id=None):
    """(text, source label, done_when of the issue) read from GitHub with GETs only. `reader` has `_api(path, repo)`."""
    try:
        issue = reader._api("repos/%s/issues/%d" % (repo, number), repo)
        comments = []
        for page in range(1, PLAN_COMMENT_PAGES + 1):
            got = reader._api("repos/%s/issues/%d/comments?per_page=100&page=%d" % (repo, number, page), repo)
            if not isinstance(got, list):
                raise PlanInputError("the comments of %s#%d did not come back as a list" % (repo, number))
            comments.extend(got)
            if len(got) < 100:
                break
    except IntentError as err:
        raise PlanInputError("cannot read %s#%d: %s" % (repo, number, err)) from None
    body = issue.get("body") if isinstance(issue, dict) and isinstance(issue.get("body"), str) else ""
    if comment_id is not None:
        picked = [c for c in comments if isinstance(c, dict) and c.get("id") == comment_id]
        if not picked:
            raise PlanInputError("%s#%d has no comment %d" % (repo, number, comment_id))
        text, source = picked[0].get("body") or "", "comment %d%s" % (comment_id, plan_check.comment_author(picked[0]))
    else:
        text, source = plan_check.select_plan_text(body, comments)
    return text, "%s of %s#%d" % (source, repo, number), parse_intent(body)[1]


def load_plan(args, runner, now):
    """(text, source label, result) of the plan `args` names (source, file, ask, done_when), checked. Raises
    PlanInputError, ValueError (an unreadable block) or the readers' errors."""
    try:
        plan_check.MAX_BYTES
    except Exception as err:  # the module is missing or broken: say so, never a traceback
        raise PlanInputError("the plan checker (bin/plan_check.py) cannot be loaded: %s" % _one_line(str(err), 150)) from None
    done_when = args.done_when
    plan_own = None
    if args.file:
        if args.source:
            raise PlanInputError("give a plan source or --file, not both")
        try:
            with open(args.file, "r", encoding="utf-8") as handle:
                text = handle.read(plan_check.MAX_BYTES * 4 + 1)
        except (OSError, UnicodeDecodeError) as err:
            raise PlanInputError("cannot read %s: %s" % (args.file, getattr(err, "strerror", None) or err)) from None
        if len(text) > plan_check.MAX_BYTES * 4:
            raise PlanInputError("%s is larger than %d bytes" % (args.file, plan_check.MAX_BYTES * 4))
        source = "file %s" % args.file
        plan_own = parse_intent(text)[1]
        done_when = done_when or plan_own
        plan_own = plan_own if done_when != plan_own else None
    else:
        if not args.source:
            raise PlanInputError("give a plan: owner/repo#N, an issue URL, or --file PATH")
        config = load_config()
        repo, number, comment_id = parse_plan_source(args.source, config.get("intent_repo"))
        reader = IntentReader(config["gh"], repo, runner, now, config["call_timeout_seconds"],
                              accounts=GhAccounts(config, runner, now))
        text, source, issue_done = fetch_plan(reader, repo, number, comment_id)
        if args.ask and not done_when:
            ask_repo, ask_number, _ = parse_plan_source(args.ask, repo)
            done_when = reader.issue(ask_number, ask_repo).done_when  # the ask is the authority
            plan_own = issue_done
        elif done_when:
            plan_own = issue_done if issue_done and issue_done != done_when else None
        else:
            done_when = issue_done
    if args.ask and args.file and not args.done_when:
        raise PlanInputError("--ask needs a plan read from GitHub; for --file give --done-when TEXT")
    return text, source, plan_check.check(text, done_when, plan_own)


def cmd_plan_check(args, runner, now):
    """`plan check`: read a plan, check it, print PASS or FAIL with one line per defect and the content hash. Exit 0
    pass, 1 fail, 2 unreadable. Reads only; never writes GitHub."""
    def finish(code, payload, lines, error=None):
        if args.json:
            print(json.dumps(payload, sort_keys=True))
        elif error:
            sys.stderr.write("%s: plan check: %s\n" % (PROG, error))
        else:
            print("\n".join(lines))
        return code

    try:
        text, source, result = load_plan(args, runner, now)
    except (PlanInputError, ValueError, ConfigError, IntentError) as err:
        return finish(EXIT_USAGE, {"result": "error", "error": _one_line(str(err), 300)}, [], _one_line(str(err), 300))
    result["source"] = source
    return finish(EXIT_OK if result["result"] == "pass" else EXIT_ERROR, result, plan_check.render(result, source, explaining=getattr(args, "explain", False)))


def cmd_plan_template(args, runner, now):
    """`plan template <ask>` (or `--done-when TEXT`): print a prefilled plan for the ask: its Done-when clauses numbered and one scenario stub
    per clause. Reads only (a GET of the ask); never writes GitHub. Exit 0, or 2 when the ask or its Done-when cannot be read."""
    try:
        done_when, source = args.done_when, None
        if not done_when:
            if not args.ask:
                raise PlanInputError("give the ask (owner/repo#N) or --done-when TEXT")
            config = load_config()
            repo, number, _ = parse_plan_source(args.ask, config.get("intent_repo"))
            reader = IntentReader(config["gh"], repo, runner, now, config["call_timeout_seconds"], accounts=GhAccounts(config, runner, now))
            done_when, source = reader.issue(number, repo).done_when, "%s#%d" % (repo, number)
        clauses = plan_check.clauses_of(done_when)
        if not (done_when or "").strip() or not clauses:
            raise PlanInputError("the ask has no Done-when line: nothing to prefill (write the plan by hand, or add the Done-when first)")
    except (PlanInputError, ValueError, ConfigError, IntentError) as err:
        sys.stderr.write("%s: plan template: %s\n" % (PROG, _one_line(str(err), 300)))
        return EXIT_USAGE
    print("\n".join(plan_check.template(clauses, _plain(source, 120) if source else None)))
    return EXIT_OK


# ---------------------------------------------------------------- `plan review` (#109 part 2, slice R2)
#
# docs/plan-review-engine-design.md. R2: the ledger records, and `start`, `verdict`, `respond`, `status`, `abandon`, with real lane launching
# (the existing `launch_agent`; tests use the fake herdr). Inert by default: `plan_review.enabled` is false. It writes the ledger and audit
# and launches lane sessions; it writes nothing to GitHub. NOT here (later slices): the daemon's read of a lane's final message (R3), the
# closing round, the consensus write, escalation and `decide` (R4), `report` (R5). So no consensus record is ever written by this slice.

class ReviewError(Exception):
    """A `plan review` command that cannot go on (exit 2): said in one line, nothing was recorded."""


REVIEW_ACTIONS = ("start", "verdict", "respond", "status", "abandon", "decide", "tick", "close", "report")
DECISIONS_HEADING_RE = re.compile(r"(?m)^##[ \t]+Decisions[ \t]*$")
REVIEW_TABLE_MAX = 65536     # bytes read from a response table or a verdict block
REVIEW_OBJECTIONS_MAX = 20   # objections in one verdict


def _read_capped(path, limit):
    """The text of a file or stdin (`-`), refused when it is over `limit` bytes: one entry cannot bloat the ledger."""
    text = sys.stdin.read(limit + 1) if path in (None, "-") else Path(path).read_text(encoding="utf-8")
    if len(text.encode("utf-8")) > limit:
        raise ReviewError("the input is over %d bytes" % limit)
    return text
PATH_TOKEN_RE = re.compile(r"[A-Za-z0-9_.@~+-]*(?:/[A-Za-z0-9_.@~+-]+)*")


def review_lane_send_problem(config, recipient, sender):
    """A plan review lane takes no message from an agent: its brief is its only input (the plan is untrusted text, and so is any message).
    Only the switchboard itself may send to a lane of an open review. Applies only when the engine is on; fails open (None) on any trouble."""
    try:
        if sender == PROG or not (config.get("plan_review") or {}).get("enabled"):
            return None
        entries, problem = plan_ledger.read_ledger(ensure_state_dir())
        if problem or not any(e.get("kind") == "lane_session" and e.get("session") == recipient for e in entries):
            return None
        review = next(e["review"] for e in entries if e.get("kind") == "lane_session" and e.get("session") == recipient)
        rnd = _round_of(entries, review)
        if plan_review.lineage_state([e for e in entries if e.get("lineage") == rnd["lineage"]], rnd["plan_hash"])["open_review"]:
            return "%s is a reviewer lane of the open plan review %s: it takes no message from an agent" % (recipient, review)
    except Exception:
        return None
    return None


def review_config(config):
    cfg = config.get("plan_review")
    if not cfg or not cfg.get("enabled"):
        raise ReviewError("the plan review engine is off: set `plan_review.enabled` to true in the switchboard config")
    return cfg


def review_entries(state):
    entries, problem = plan_ledger.read_ledger(state)
    if problem:
        raise ReviewError("the ledger is not trustworthy, nothing was recorded: %s" % problem)
    return entries


def review_caller(runner, now, who):
    """(kind, name): `start` and `abandon` are for a person at a shell or a registered orchestrator or the chief of staff; `respond` is
    the planner (the round's recorded starter)."""
    got = gates_caller_kind(runner, now)
    if got[0] == "person":
        return "person", "owner"
    if got[0] == "agent" and got[2] in ("orchestrator", "chief-of-staff"):
        return "agent", got[1]
    raise ReviewError("%s may not %s: only a registered orchestrator, the chief of staff, or a person at a shell" % (got[1], who))


def _review_record(engine, state, entry, now):
    stored = plan_ledger.append_entry(state, entry, now())
    if engine.audit is not None:
        engine.audit.append(engine.actor, "plan.review.%s" % entry["kind"], entry.get("lineage") or "-",
                            {"review": entry.get("review"), "round": entry.get("round"), "lane": entry.get("lane"),
                             "seq": stored["seq"], "chain": stored["hash"]})
    return stored


def _plan_ask_problem(config, runner, now, plan_repo, plan_number, ask_repo, ask_number):
    """None when the plan issue IS the ask or sits under it (its parent chain, up to 6 links, reaches the ask), read from GitHub with the
    repo's account like `plan check`; else a sentence. The caller's `--ask` is only a claim: this is what makes the lineage the ask's."""
    if (plan_repo.lower(), plan_number) == (ask_repo.lower(), ask_number):
        return None
    reader = IntentReader(config["gh"], plan_repo, runner, now, config["call_timeout_seconds"], accounts=GhAccounts(config, runner, now))
    repo, number = plan_repo, plan_number
    for _ in range(6):
        issue = reader._api("repos/%s/issues/%d" % (repo, number), repo)
        parent = parent_of(issue) if isinstance(issue, dict) else None
        if not parent:
            break
        if (repo.lower(), parent) == (ask_repo.lower(), ask_number):
            return None
        number = parent
    return "%s#%d is not the ask's plan: its issue is not %s#%d and does not sit under it (a plan is reviewed under the ask it serves)" % (
        plan_repo, plan_number, ask_repo, ask_number)


def _unit_paths(text):
    """Every path-like token in the plan text: a plan that names a held path anywhere is reviewed in full (err to full; the plan's own
    claim about its areas is not read)."""
    return sorted({m for m in PATH_TOKEN_RE.findall(text or "") if "/" in m or "." in m})


def _ask_facts(config, runner, now, ask_text, default_repo):
    """(repo, number, kind, parent lineage or None, intent, done_when) of the ask a plan serves, from the issue itself: a charter is an
    `epic`, an issue with a parent a `work_item`, else an `ask`."""
    repo, number, _ = parse_plan_source(ask_text, default_repo)
    reader = IntentReader(config["gh"], repo, runner, now, config["call_timeout_seconds"], accounts=GhAccounts(config, runner, now))
    issue = reader._api("repos/%s/issues/%d" % (repo, number), repo)
    if not isinstance(issue, dict):
        raise ReviewError("cannot read the ask %s#%d" % (repo, number))
    parent = parent_of(issue)
    charter = bool(_CHARTER_BLOCK.search(issue.get("body") if isinstance(issue.get("body"), str) else ""))
    kind = "work_item" if parent else ("epic" if charter else "ask")
    found = IssueIntent.from_api(issue)
    return (repo, number, kind, plan_review.lineage_key(repo, parent) if parent else None, found.intent or "", found.done_when or "")


def _abandoned(entries, review):
    """True when the review was abandoned: it takes no verdict, no response, no closing round and no consensus (a new `start` for the ask is how
    it goes on: the lineage's count continues)."""
    return any(e.get("kind") == "abandoned" and e.get("review") == review for e in entries)


def _refuse_if_abandoned(entries, review):
    if _abandoned(entries, review):
        raise ReviewError("refused: review %s was abandoned: it takes no more verdicts, responses, closing round or consensus "
                          "(`plan review start` for the same ask opens a new review and the count continues)" % review)


def _round_of(entries, review):
    rounds = [e for e in entries if e.get("kind") == "round" and e.get("review") == review]
    if not rounds:
        raise ReviewError("no review %s" % review)
    return rounds[-1]


def _sessions_of(entries, review, number):
    return {e["lane"]: e["session"] for e in entries if e.get("kind") == "lane_session" and e.get("review") == review
            and e.get("round") == number}


def _verdicts_of(entries, review, number):
    return {e["lane"]: e for e in entries if e.get("kind") == "lane" and e.get("review") == review and e.get("round") == number}


def _carried(entries, lineage, lane):
    """The lane's own open blocking objections from the lineage's earlier rounds (what its next round must answer)."""
    mine = [e for e in entries if e.get("lineage") == lineage and e.get("kind") == "lane" and e.get("lane") == lane]
    latest = {}
    for entry in mine:
        for obj in entry.get("objections") or []:
            latest[obj["id"]] = dict(obj, lane=lane)
    return [o for o in latest.values() if o.get("severity") == "blocking" and o.get("state") not in plan_review.CLOSED_STATES]


def _launch_lanes(engine, state, cfg, round_entry, text, intent, done_when, now, planner):
    """Launch up to `max_parallel` of the round's waiting lanes (the rest wait for a verdict). Each success is recorded as a `lane_session`."""
    entries = review_entries(state)
    launched = _sessions_of(entries, round_entry["review"], round_entry["round"])
    active = [l for l in launched if l not in _verdicts_of(entries, round_entry["review"], round_entry["round"])]
    room = max(0, cfg["max_parallel"] - len(active))
    workspace = cfg.get("workspace") or os.environ.get("HERDR_WORKSPACE_ID")
    directory = cfg.get("dir") or os.getcwd()
    made = []
    for lane in [l for l in round_entry["lanes"] if l not in launched][:room]:
        name = "planrev-%s-%s-r%d" % (round_entry["review"], lane.lower(), round_entry["round"])
        brief = plan_review.lane_brief(lane, round_entry["plan_ref"], round_entry["plan_hash"], text, intent, done_when,
                                       carried=_carried(entries, round_entry["lineage"], lane), closing=bool(round_entry.get("closing")))
        try:
            done = launch_agent(engine, name, cfg["lane_agent"], directory, workspace, role="reviewer", reports_to=None,
                                issue=round_entry.get("ask_number"), brief=brief)
        except LaunchError as err:
            raise ReviewError("lane %s did not launch (%s): the review stays open and the lane waits" % (lane, _one_line(str(err), 160))) from None
        _review_record(engine, state, {"kind": "lane_session", "lineage": round_entry["lineage"], "review": round_entry["review"],
                                       "round": round_entry["round"], "lane": lane, "session": name, "pane": done.get("pane"),
                                       "by": planner}, now)
        made.append((lane, name, done.get("pane")))
    return made


def _ask_texts(config, runner, now, rnd):
    """(intent, done_when) of the round's ask, read again for the next round's briefs."""
    repo, _, number = rnd["lineage"].rpartition("#")
    got = _ask_facts(config, runner, now, "%s#%s" % (repo, number), config.get("intent_repo"))
    return got[4], got[5]


def review_start(args, runner, now, socket_call=None):
    config = load_config()
    cfg = review_config(config)
    _, planner = review_caller(runner, now, "start a plan review")
    engine, state, _ = build_engine(runner, now, "cli", writable=True, socket_call=socket_call)
    default_repo = config.get("intent_repo")
    ns = types.SimpleNamespace(source=args.source, file=None, ask=args.ask, done_when=None)
    text, label, result = load_plan(ns, runner, now)
    if result["result"] != "pass":
        raise ReviewError("the plan fails `plan check` (%d defect(s)): fix it first" % len(result["defects"]))
    plan_hash = result["plan_hash"]
    ask_repo, ask_number, kind, parent_lineage, ask_intent, ask_done = _ask_facts(config, runner, now, args.ask, default_repo)
    lineage = plan_review.lineage_key(ask_repo, ask_number)
    plan_repo, plan_number, _ = parse_plan_source(args.source, default_repo)
    plan_ref = "%s#%d" % (plan_repo, plan_number)
    problem = _plan_ask_problem(config, runner, now, plan_repo, plan_number, ask_repo, ask_number)
    if problem:
        raise ReviewError("refused: %s" % problem)
    hits = plan_review.path_hits(_unit_paths(text), cfg["held_globs"])
    chosen = {}

    def decide(entries, seq):
        """Everything that decides whether this review may open, and its id, under the ledger lock with the ledger as it stands."""
        for entry in entries:   # a plan source belongs to ONE ask
            if entry.get("kind") == "round" and entry.get("plan_ref") == plan_ref and entry.get("lineage") != lineage:
                raise ReviewError("%s is already under the review of %s: a plan does not move to another ask's count" % (plan_ref, entry["lineage"]))
        mine = [e for e in entries if e.get("lineage") == lineage]
        ok, why = plan_review.may_start(plan_review.lineage_state(mine, plan_hash), plan_hash)
        if not ok:
            raise ReviewError("refused: %s" % why)
        day_ago = now() - 86400
        if not plan_review.starts_today_ok(len([e for e in entries if e.get("kind") == "round" and e.get("start") and e.get("by") == planner
                                               and e.get("ts", 0) >= day_ago]), cfg["starts_per_day"]):
            raise ReviewError("refused: %s has started %d reviews in the last day (the limit)" % (planner, cfg["starts_per_day"]))
        has_consensus = bool(parent_lineage) and any(e.get("kind") == "consensus" and e.get("lineage") == parent_lineage for e in entries)
        tier, tier_why = plan_review.compute_tier(kind, hits, cfg["held_globs"], ask_has_consensus=has_consensus, requested=args.tier)
        lanes = plan_review.lanes_for_tier(tier, held_area=bool(hits))
        used = len([e for e in mine if e.get("kind") == "lane_session"])
        if not plan_review.session_budget_ok(used, len(lanes), cfg["session_cap"]):
            raise ReviewError("refused: the lineage has used %d of its %d lane sessions" % (used, cfg["session_cap"]))
        chosen.update(review="rv%d" % seq, tier=tier, why=tier_why, lanes=lanes)   # the id comes from the appended sequence number
        return {"kind": "round", "lineage": lineage, "review": chosen["review"], "round": 1, "closing": False, "start": True,
                "ask_number": ask_number, "plan_ref": plan_ref, "plan_hash": plan_hash, "scenario_hash": result.get("scenario_hash"),
                "tier": tier, "tier_why": tier_why, "lanes": lanes, "held_area": bool(hits), "by": planner}

    stored = plan_ledger.append_checked(state, now(), decide)
    if engine.audit is not None:
        engine.audit.append(engine.actor, "plan.review.round", lineage, {"review": chosen["review"], "round": 1, "seq": stored["seq"],
                                                                            "chain": stored["hash"]})
    made = _launch_lanes(engine, state, cfg, stored, text, ask_intent, ask_done, now, planner)
    return {"review": chosen["review"], "lineage": lineage, "tier": chosen["tier"], "why": chosen["why"], "lanes": chosen["lanes"],
            "launched": made, "plan_hash": plan_hash}


def _launch_waiting(engine, state, cfg, config, runner, now, rnd):
    """After a verdict: launch the round's waiting lanes (up to `max_parallel` running). Best effort: a launch problem is returned, not raised."""
    entries = review_entries(state)
    sessions, verdicts = _sessions_of(entries, rnd["review"], rnd["round"]), _verdicts_of(entries, rnd["review"], rnd["round"])
    if all(l in sessions for l in rnd["lanes"]) or all(l in verdicts for l in rnd["lanes"]):
        return [], None
    try:
        ns = types.SimpleNamespace(source=rnd["plan_ref"], file=None, ask=None, done_when=None)
        text = load_plan(ns, runner, now)[0]
        made = _launch_lanes(engine, state, cfg, rnd, text, *_ask_texts(config, runner, now, rnd), now, rnd["by"])
        return made, None
    except (ReviewError, PlanInputError, ValueError, ConfigError, IntentError) as err:
        return [], _one_line(str(err), 200)


def review_verdict(args, runner, now, socket_call=None):
    """The fallback path (the daemon's own read of a lane's final message is R3): a lane records its verdict for its own lane."""
    config = load_config()
    cfg = review_config(config)
    engine, state, _ = build_engine(runner, now, "cli", writable=True, socket_call=socket_call)
    entries = review_entries(state)
    _refuse_if_abandoned(entries, args.review)
    rnd = _round_of(entries, args.review)
    caller = identify_caller(engine.herdr, engine.v2, os.environ)
    sessions = _sessions_of(entries, args.review, rnd["round"])
    if sessions.get(args.lane) != caller:
        raise ReviewError("refused: %s is not the session launched for lane %s of this round (that is %s)" % (
            caller, args.lane, sessions.get(args.lane) or "not launched"))
    if caller == rnd["by"]:
        raise ReviewError("refused: the planner cannot record a lane's verdict")
    if args.lane in _verdicts_of(entries, args.review, rnd["round"]):
        raise ReviewError("refused: lane %s already has its verdict for this round" % args.lane)
    text = _read_capped(args.file, REVIEW_TABLE_MAX)
    parsed, why = plan_review.parse_verdict_block(text, rnd["plan_hash"], args.lane)
    if parsed is None:
        raise ReviewError("refused: %s" % why)
    if len(parsed["objections"]) > REVIEW_OBJECTIONS_MAX:
        raise ReviewError("refused: %d objections in one verdict (at most %d): say the strongest" % (len(parsed["objections"]), REVIEW_OBJECTIONS_MAX))
    entry = {"kind": "lane", "lineage": rnd["lineage"], "review": args.review, "round": rnd["round"], "lane": args.lane,
             "verdict": parsed["verdict"], "plan_hash": rnd["plan_hash"], "objections": parsed["objections"], "by": caller}
    def guarded(ledger, seq):
        _refuse_if_abandoned(ledger, args.review)   # under the lock: an abandon that landed meanwhile still wins
        if any(e.get("kind") == "lane" and e.get("review") == args.review and e.get("round") == rnd["round"] and e.get("lane") == args.lane for e in ledger):
            raise ReviewError("refused: lane %s already has its verdict for this round" % args.lane)
        return entry
    stored = plan_ledger.append_checked(state, now(), guarded)
    if engine.audit is not None:
        engine.audit.append(engine.actor, "plan.review.lane", rnd["lineage"], {"review": args.review, "round": rnd["round"], "lane": args.lane,
                                                                                "seq": stored["seq"], "chain": stored["hash"]})
    made, trouble = _launch_waiting(engine, state, cfg, config, runner, now, rnd)
    out = {"recorded": args.lane, "verdict": parsed["verdict"], "objections": len(parsed["objections"]),
           "launched_next": [lane for lane, _, _ in made]}
    if trouble:
        out["waiting_lanes_not_launched"] = trouble
    if rnd.get("closing"):
        out.update(_closing_outcome(engine, state, cfg, config, runner, now, args.review))
    return out


def _closing_outcome(engine, state, cfg, config, runner, now, review):
    """Once every lane of a closing round has reported: write the consensus (every lane of the tier approved the exact final hash and nothing
    blocking is open), or escalate a blocking objection raised on the final text, or say it is still pending. The tally is computed from the
    ledger alone; the consensus is bound to the final plan hash."""
    entries = review_entries(state)
    rnd = _round_of(entries, review)
    if _abandoned(entries, review):
        return {}
    if not rnd.get("closing") or any(l not in _verdicts_of(entries, review, rnd["round"]) for l in rnd["lanes"]):
        return {}
    lineage = [e for e in entries if e.get("lineage") == rnd["lineage"]]
    st = plan_review.lineage_state(lineage, rnd["plan_hash"])
    lane_entries = [e for e in lineage if e.get("kind") == "lane"]
    verdict, why = plan_review.decide_consensus(lane_entries, rnd["lanes"], rnd["plan_hash"], rounds_left=plan_review._rounds_left(st))
    if verdict == "escalate":
        out = _escalate(engine, state, cfg, config, runner, now, rnd, st, "", rnd["by"])
        return {"tally": "escalate", "tally_why": why, "escalated": out["escalated"], "boss": out["boss"], "owner_only": out["owner_only"]}
    if verdict != "consensus":
        return {"tally": verdict, "tally_why": why}

    def write(ledger, seq):
        """Under the lock, from the ledger as it stands: the same tally, and not twice for one hash."""
        _refuse_if_abandoned(ledger, review)
        mine = [e for e in ledger if e.get("lineage") == rnd["lineage"]]
        again, _ = plan_review.decide_consensus([e for e in mine if e.get("kind") == "lane"], rnd["lanes"], rnd["plan_hash"],
                                                rounds_left=plan_review._rounds_left(plan_review.lineage_state(mine, rnd["plan_hash"])))
        if again != "consensus":
            raise ReviewError("the tally changed: no consensus")
        if any(e.get("kind") == "consensus" and e.get("plan_hash") == rnd["plan_hash"] for e in ledger):
            raise ReviewError("a consensus already exists at this hash")
        return {"kind": "consensus", "result": "pass", "pr": "-", "scenario": "-", "lineage": rnd["lineage"], "review": review,
                "plan_hash": rnd["plan_hash"], "plan_ref": rnd["plan_ref"], "tier": rnd["tier"], "lanes": rnd["lanes"],
                "rounds": st["rounds"], "closing_round": rnd["round"], "by": "plan-review"}
    try:
        stored = plan_ledger.append_checked(state, now(), write)
    except ReviewError as err:
        return {"tally": "pending", "tally_why": str(err)}
    if engine.audit is not None:
        engine.audit.append(engine.actor, "plan.review.consensus", rnd["lineage"], {"review": review, "plan_hash": rnd["plan_hash"],
                                                                                    "seq": stored["seq"], "chain": stored["hash"]})
    return {"tally": "consensus", "consensus_at": rnd["plan_hash"]}


def review_close(args, runner, now, socket_call=None):
    """The closing round: the planner publishes the FINAL synthesized revision (`plan check` PASS, a `## Decisions` section); every lane of the tier
    then confirms that exact text or objects. Only an approve at that hash from every lane makes a consensus: no closing round, no consensus.
    Outside the 3-round cap, once per final hash, never with a blocking objection open or an escalation undecided."""
    config = load_config()
    cfg = review_config(config)
    _, planner = review_caller(runner, now, "close a plan review")
    engine, state, _ = build_engine(runner, now, "cli", writable=True, socket_call=socket_call)
    entries = review_entries(state)
    _refuse_if_abandoned(entries, args.review)
    rnd = _round_of(entries, args.review)
    if planner != rnd["by"] and planner != "owner":
        raise ReviewError("refused: only the planner who started the review (%s) closes it" % rnd["by"])
    missing = [l for l in rnd["lanes"] if l not in _verdicts_of(entries, args.review, rnd["round"])]
    if missing:
        raise ReviewError("refused: lanes %s have not reported for round %d" % (", ".join(missing), rnd["round"]))
    ns = types.SimpleNamespace(source=args.plan_ref, file=None, ask=None, done_when=None)
    text, label, result = load_plan(ns, runner, now)
    if result["result"] != "pass":
        raise ReviewError("the final revision fails `plan check` (%d defect(s))" % len(result["defects"]))
    if not DECISIONS_HEADING_RE.search(text):
        raise ReviewError("the final revision has no `## Decisions` section (the synthesis the planner owes: decision, drivers, alternatives, why)")
    plan_repo, plan_number, _ = parse_plan_source(args.plan_ref, config.get("intent_repo"))
    ask_repo, _, ask_number = rnd["lineage"].rpartition("#")
    problem = _plan_ask_problem(config, runner, now, plan_repo, plan_number, ask_repo, int(ask_number))
    if problem:
        raise ReviewError("refused: %s" % problem)
    lanes = plan_review.lanes_for_tier(rnd["tier"], held_area=bool(rnd.get("held_area")))
    used = len([e for e in entries if e.get("lineage") == rnd["lineage"] and e.get("kind") == "lane_session"])
    if not plan_review.session_budget_ok(used, len(lanes), cfg["session_cap"]):
        raise ReviewError("refused: the lineage has used %d of its %d lane sessions" % (used, cfg["session_cap"]))
    plan_ref = "%s#%d" % (plan_repo, plan_number)

    def decide(ledger, seq):
        _refuse_if_abandoned(ledger, args.review)
        mine = [e for e in ledger if e.get("lineage") == rnd["lineage"]]
        later = [e for e in ledger if e.get("kind") == "round" and e.get("review") == args.review and e.get("round") > rnd["round"]]
        if later:
            raise ReviewError("refused: round %d of this review is already open" % later[-1]["round"])
        ok, why = plan_review.may_open_round(plan_review.lineage_state(mine, result["plan_hash"]), closing=True, plan_hash=result["plan_hash"])
        if not ok:
            raise ReviewError("refused: %s" % why)
        return {"kind": "round", "lineage": rnd["lineage"], "review": args.review, "round": rnd["round"] + 1, "closing": True,
                "ask_number": rnd.get("ask_number"), "plan_ref": plan_ref, "plan_hash": result["plan_hash"],
                "scenario_hash": result.get("scenario_hash"), "tier": rnd["tier"], "lanes": lanes,
                "held_area": rnd.get("held_area", False), "by": rnd["by"]}

    stored = plan_ledger.append_checked(state, now(), decide)
    made = _launch_lanes(engine, state, cfg, stored, text, *_ask_texts(config, runner, now, rnd), now, rnd["by"])
    return {"review": args.review, "closing_round": stored["round"], "lanes": lanes, "launched": made, "plan_hash": result["plan_hash"]}


def review_report(args, runner, now):
    """What the review cost and what the reviewers caught: per round and lane the wall time, the verdict and the objections by severity, how many
    the planner accepted and rejected, the objection titles, the totals, and the rounds to consensus. Token and money cost are NOT measured (the
    harness records none yet): it says so, and records the session names so a later measure can join them."""
    config = load_config()
    review_config(config)
    state = ensure_state_dir()
    entries = review_entries(state)
    rnd = _round_of(entries, args.review)
    mine = [e for e in entries if e.get("lineage") == rnd["lineage"]]
    rounds = sorted([e for e in mine if e.get("kind") == "round" and e.get("review") == args.review], key=lambda e: e["round"])
    out_rounds, caught, total_sessions = [], [], 0
    for r in rounds:
        starts = {}
        for e in mine:
            if e.get("kind") == "lane_session" and e.get("review") == args.review and e.get("round") == r["round"]:
                starts.setdefault(e["lane"], e["ts"])
                total_sessions += 1
        lanes = {}
        for e in mine:
            if e.get("kind") == "lane" and e.get("review") == args.review and e.get("round") == r["round"]:
                blocking = len([o for o in e["objections"] if o["severity"] == "blocking"])
                lanes[e["lane"]] = {"verdict": e["verdict"], "blocking": blocking, "advisory": len(e["objections"]) - blocking,
                                    "seconds": e["ts"] - starts.get(e["lane"], e["ts"])}
                for o in e["objections"]:
                    if o["state"] == "open":
                        caught.append({"round": r["round"], "lane": e["lane"], "id": o["id"], "severity": o["severity"], "text": o["text"]})
        responses = [e for e in mine if e.get("kind") == "response" and e.get("review") == args.review and e.get("round") == r["round"]]
        out_rounds.append({"round": r["round"], "closing": bool(r.get("closing")), "lanes": lanes,
                           "accepted": sum(e.get("accepted", 0) for e in responses), "rejected": sum(e.get("rejected", 0) for e in responses)})
    consensus = next((e for e in reversed(mine) if e.get("kind") == "consensus" and e.get("review") == args.review), None)
    end = consensus["ts"] if consensus else max(e["ts"] for e in mine)
    return {"review": args.review, "lineage": rnd["lineage"], "tier": rounds[0]["tier"], "rounds": out_rounds,
            "rounds_to_consensus": len([r for r in rounds if not r.get("closing")]) if consensus else None,
            "consensus": ({"plan_hash": consensus["plan_hash"], "overridden_by": consensus.get("overridden_by")} if consensus else None),
            "escalations": len([e for e in mine if e.get("kind") == "escalation" and e.get("review") == args.review]),
            "sessions": total_sessions, "wall_seconds": end - rounds[0]["ts"],
            "caught": caught[:60], "caught_total": len(caught),
            "cost": "tokens and money are not measured (the harness records none yet); the lane session names are in the ledger to join a later measure"}


def review_status(args, runner, now):
    config = load_config()
    review_config(config)
    state = ensure_state_dir()
    entries = review_entries(state)
    rnd = _round_of(entries, args.review)
    mine = [e for e in entries if e.get("lineage") == rnd["lineage"]]
    st = plan_review.lineage_state(mine, rnd["plan_hash"])
    sessions, verdicts = _sessions_of(entries, args.review, rnd["round"]), _verdicts_of(entries, args.review, rnd["round"])
    lanes = {lane: ("verdict:%s" % verdicts[lane]["verdict"] if lane in verdicts else "running" if lane in sessions else "waiting")
             for lane in rnd["lanes"]}
    return {"review": args.review, "lineage": rnd["lineage"], "round": rnd["round"], "tier": rnd["tier"], "plan_hash": rnd["plan_hash"],
            "rounds_used": st["rounds"], "lanes": lanes, "open_blocking": st["open_blocking"], "open_review": st["open_review"],
            "undecided_escalation": st["undecided"],
            "overridden": st["overridden"].get(rnd["plan_hash"]), "consensus": rnd["plan_hash"] in st["consensus_hashes"],
            "closing": bool(rnd.get("closing")),
            "next": ("respond: the planner answers the open objections" if all(l in verdicts for l in rnd["lanes"]) and st["open_blocking"]
                     else ("the consensus is recorded" if rnd["plan_hash"] in st["consensus_hashes"]
                           else "tally pending: see `plan review close` (the closing round)") if all(l in verdicts for l in rnd["lanes"])
                     else "waiting for the lanes")}


def review_respond(args, runner, now, socket_call=None):
    """The planner answers a finished round: the response table (every open blocking objection named), the new revision (`plan check`
    PASS, a new hash), and the next round for the lanes that still object (plus L1 when the scenarios changed)."""
    config = load_config()
    cfg = review_config(config)
    _, planner = review_caller(runner, now, "respond to a plan review")
    engine, state, _ = build_engine(runner, now, "cli", writable=True, socket_call=socket_call)
    entries = review_entries(state)
    _refuse_if_abandoned(entries, args.review)
    rnd = _round_of(entries, args.review)
    if planner != rnd["by"] and planner != "owner":
        raise ReviewError("refused: only the planner who started the review (%s) answers it" % rnd["by"])
    verdicts = _verdicts_of(entries, args.review, rnd["round"])
    missing = [l for l in rnd["lanes"] if l not in verdicts]
    if missing:
        raise ReviewError("refused: lanes %s have not reported for round %d" % (", ".join(missing), rnd["round"]))
    mine = [e for e in entries if e.get("lineage") == rnd["lineage"]]
    st = plan_review.lineage_state(mine, rnd["plan_hash"])
    if not st["open_blocking"]:
        raise ReviewError("nothing blocking is open: the next step is the closing round (`plan review close`), not another round")
    ok, why = plan_review.may_open_round(st)
    if not ok and st["undecided"]:
        raise ReviewError("refused: %s" % why)
    table = _read_capped(args.table, REVIEW_TABLE_MAX)
    if not ok:   # the rounds are spent: what survives ESCALATES (recorded, and the boss told), it is never dropped
        return _escalate(engine, state, cfg, config, runner, now, rnd, st, table, planner)
    answered = {m.group(1) for m in re.finditer(r"(?m)^\s*([A-Za-z0-9]+/O[0-9]{1,3})\s*:\s*(?:accept|reject)\b", table)}
    absent = [k for k in st["open_blocking"] if k not in answered]
    if absent:
        raise ReviewError("refused: the response table needs one line `<lane>/<id>: accept|reject, why` for each open objection; missing %s"
                          % ", ".join(absent))
    ns = types.SimpleNamespace(source=args.plan_ref, file=None, ask=None, done_when=None)
    text, label, result = load_plan(ns, runner, now)
    if result["result"] != "pass":
        raise ReviewError("the new revision fails `plan check` (%d defect(s))" % len(result["defects"]))
    if result["plan_hash"] == rnd["plan_hash"]:
        raise ReviewError("the revision has the same plan hash: a new round needs a changed plan")
    plan_repo, plan_number, _ = parse_plan_source(args.plan_ref, config.get("intent_repo"))
    ask_repo, _, ask_number = rnd["lineage"].rpartition("#")
    problem = _plan_ask_problem(config, runner, now, plan_repo, plan_number, ask_repo, int(ask_number))
    if problem:
        raise ReviewError("refused: %s" % problem)
    # the next lanes come from the lineage's OPEN objections (their lanes), plus L1 when the scenarios changed: a lane-wide approve that
    # omitted an id leaves it open, and its lane runs again; a round with no lane to run is refused, never opened.
    objecting = {k.split("/", 1)[0] for k in st["open_blocking"]}
    if result.get("scenario_hash") != rnd.get("scenario_hash"):
        objecting.add("L1")
    lanes = sorted(objecting & set(plan_review.LANES))
    if not lanes:
        raise ReviewError("refused: no lane has an open objection to re-run: nothing would review the new round")
    used = len([e for e in mine if e.get("kind") == "lane_session"])
    if not plan_review.session_budget_ok(used, len(lanes), cfg["session_cap"]):
        raise ReviewError("refused: the lineage has used %d of its %d lane sessions" % (used, cfg["session_cap"]))
    plan_ref = "%s#%d" % (plan_repo, plan_number)

    def decide(entries, seq):
        """Under the ledger lock: this review is still at the round the planner answered, and the round may open."""
        _refuse_if_abandoned(entries, args.review)
        later = [e for e in entries if e.get("kind") == "round" and e.get("review") == args.review and e.get("round") > rnd["round"]]
        if later:
            raise ReviewError("refused: round %d of this review is already open" % later[-1]["round"])
        now_state = plan_review.lineage_state([e for e in entries if e.get("lineage") == rnd["lineage"]], rnd["plan_hash"])
        allowed, why_not = plan_review.may_open_round(now_state)
        if not allowed:
            raise ReviewError("refused: %s" % why_not)
        return {"kind": "round", "lineage": rnd["lineage"], "review": args.review, "round": rnd["round"] + 1, "closing": False,
                "ask_number": rnd.get("ask_number"), "plan_ref": plan_ref, "plan_hash": result["plan_hash"],
                "scenario_hash": result.get("scenario_hash"), "tier": rnd["tier"], "lanes": lanes,
                "held_area": rnd.get("held_area", False), "by": rnd["by"]}

    stored = plan_ledger.append_checked(state, now(), decide)
    _review_record(engine, state, {"kind": "response", "lineage": rnd["lineage"], "review": args.review, "round": rnd["round"],
                                   "table_hash": hashlib.sha256(table.encode("utf-8")).hexdigest(), "plan_ref": plan_ref,
                                   "accepted": len(re.findall(r"(?m)^\s*[A-Za-z0-9]+/O[0-9]{1,3}\s*:\s*accept\b", table)),
                                   "rejected": len(re.findall(r"(?m)^\s*[A-Za-z0-9]+/O[0-9]{1,3}\s*:\s*reject\b", table)),
                                   "plan_hash": result["plan_hash"], "by": planner}, now)
    made = _launch_lanes(engine, state, cfg, stored, text, *_ask_texts(config, runner, now, rnd), now, rnd["by"])
    return {"review": args.review, "round": stored["round"], "lanes": lanes, "launched": made, "plan_hash": result["plan_hash"]}


def _boss_of_planner(engine, planner):
    """The agent that decides an escalation: the planner's boss, else the chief of staff (a person planner has none)."""
    discovery = engine.discover(engine.now())
    me = discovery.agents.get(planner)
    boss = boss_name(discovery, me) if me is not None else None
    return boss or resolve_boss(discovery, "chief-of-staff") or "chief-of-staff"


def _escalation_target(engine, planner, already_escalated=False):
    """(boss, owner_only) for an escalation: the planner's boss, else the chief of staff; but a planner that IS that boss (the chief of staff's
    own plan) cannot judge its own plan, so the escalation goes to the owner directly, as does any escalation after the rounds that follow
    an earlier one."""
    boss = _boss_of_planner(engine, planner)
    if already_escalated or boss == planner:
        return "owner", True
    return boss, False


def _tell(engine, recipient, text):
    """The switchboard's own message through the outbox (a sender no agent can be). Never raises: the ledger holds the fact either way."""
    try:
        outcome = engine.send(PROG, recipient, text)
        return bool(outcome.get("sent"))
    except (MessageTooLong, InterruptRefused, Exception):
        return False


def _response_of(table, key):
    match = re.search(r"(?m)^\s*%s\s*:\s*((?:accept|reject)\b.*)$" % re.escape(key), table or "")
    return match.group(1).strip() if match else ""


def _escalate(engine, state, cfg, config, runner, now, rnd, st, table, planner):
    """Record an `escalation` entry for every blocking objection still open (with the planner's response beside it) and tell the boss. After an
    earlier escalation the rounds that follow it are spent: the escalation is then the owner's alone."""
    boss, owner_only = _escalation_target(engine, planner, bool(st["escalated"]))
    told = []
    lanes_entries = [e for e in review_entries(state) if e.get("lineage") == rnd["lineage"] and e.get("kind") == "lane"]
    objections = {}
    for entry in lanes_entries:
        for obj in entry.get("objections") or []:
            objections["%s/%s" % (entry["lane"], obj["id"])] = dict(obj, lane=entry["lane"])
    for key in st["open_blocking"]:
        obj = objections.get(key, {"id": key.split("/", 1)[-1], "lane": key.split("/", 1)[0], "text": ""})
        response = _response_of(table, key)
        def once(entries, seq, key=key, obj=obj, response=response):
            """Under the ledger lock: an objection already escalated and undecided is not escalated (or announced) twice."""
            if key in _escalations(entries, rnd["review"]):
                raise ReviewError("%s is already escalated" % key)
            return {"kind": "escalation", "lineage": rnd["lineage"], "review": rnd["review"], "round": rnd["round"],
                    "objection": key, "lane": obj["lane"], "text": plan_ledger.clip(obj.get("text"), 400),
                    "response": plan_ledger.clip(response, 400), "boss": boss, "owner_only": owner_only,
                    "plan_hash": rnd["plan_hash"], "held_area": bool(rnd.get("held_area")), "by": planner}
        try:
            stored = plan_ledger.append_checked(state, now(), once)
        except ReviewError:
            continue
        if engine.audit is not None:
            engine.audit.append(engine.actor, "plan.review.escalation", rnd["lineage"], {"review": rnd["review"], "objection": key,
                                                                                          "seq": stored["seq"], "chain": stored["hash"]})
        recipient = "chief-of-staff" if owner_only else boss
        told.append((key, _tell(engine, recipient, plan_review.escalation_message(rnd["lineage"], dict(obj, id=key), response))))
    return {"review": rnd["review"], "escalated": [k for k, _ in told], "boss": boss, "owner_only": owner_only,
            "told": [k for k, ok in told if ok], "not_delivered": [k for k, ok in told if not ok],
            "next": "decide: `plan review decide %s --objection <lane/id> --accept|--override --reason ...`" % rnd["review"]}


def _escalations(entries, review):
    """The review's undecided escalations, newest entry per objection."""
    latest = {}
    for entry in entries:
        if entry.get("review") != review:
            continue
        if entry.get("kind") == "escalation":
            latest[entry["objection"]] = entry
        elif entry.get("kind") == "decision":
            latest.pop(entry.get("objection"), None)
    return latest


def review_decide(args, runner, now):
    """Resolve an escalated objection: `--accept` (the planner revises, within the rounds left) or `--override` (with a reason): an override of
    the last open one writes the `consensus` entry, marked `overridden_by` with the reason. The risk lane and held-PR areas: the owner only."""
    config = load_config()
    review_config(config)
    engine, state, _ = build_engine(runner, now, "cli", writable=True)
    got = gates_caller_kind(runner, now)
    if got[0] == "person":
        kind, who = "person", "owner"
    elif got[0] == "agent":
        kind, who = "agent", got[1]
    else:
        raise ReviewError("refused: %s" % got[1])
    action = "override" if args.override else "accept"
    reason = " ".join((args.reason or "").split())
    if len(reason) < plan_ledger.WAIVER_REASON_MIN:
        raise ReviewError("a reason of at least %d characters is required" % plan_ledger.WAIVER_REASON_MIN)
    outcome = {}

    def build(entries, seq):
        _refuse_if_abandoned(entries, args.review)
        escalations = _escalations(entries, args.review)
        esc = escalations.get(args.objection)
        if esc is None:
            raise ReviewError("refused: %s has no undecided escalation in %s (open: %s)" % (args.objection, args.review, ", ".join(sorted(escalations)) or "none"))
        planner = _round_of(entries, args.review)["by"]
        if kind == "agent" and who == planner:
            ok, why = False, "the planner of a plan cannot decide an objection to it: only the owner at a terminal, or a boss that is not the planner"
        else:
            ok, why = plan_review.decision_allowed(action, esc.get("lane"), esc.get("held_area"), esc.get("owner_only"), kind, who == esc.get("boss"))
        if not ok:
            _gates_audit(engine, "plan.review.decide.refused", args.review, {"by": who, "objection": args.objection, "why": why})
            raise ReviewError("refused: %s" % why)
        outcome.update(esc=esc, others=[k for k in escalations if k != args.objection])
        return {"kind": "decision", "lineage": esc["lineage"], "review": args.review, "objection": args.objection, "action": action,
                "reason": plan_ledger.clip(reason, 300), "by": who, "decider": kind}

    stored = plan_ledger.append_checked(state, now(), build)
    esc = outcome["esc"]
    if engine.audit is not None:
        engine.audit.append(engine.actor, "plan.review.decision", esc["lineage"], {"review": args.review, "objection": args.objection,
                                                                                    "action": action, "by": who, "seq": stored["seq"]})
    result = {"decided": args.objection, "action": action, "by": who}
    entries = review_entries(state)
    if action == "override" and not outcome["others"]:
        mine = [e for e in entries if e.get("review") == args.review]
        accepted = [e for e in mine if e.get("kind") == "decision" and e.get("action") == "accept"]
        rnd = _round_of(entries, args.review)
        # the last open objection was overridden and nothing awaits a revision: the consensus is written, marked overridden
        if not accepted or accepted[-1]["seq"] < max(e["seq"] for e in mine if e.get("kind") == "escalation"):
            if not _abandoned(entries, args.review) and not any(e.get("kind") == "consensus" and e.get("plan_hash") == rnd["plan_hash"] for e in entries):
                consensus = plan_ledger.append_entry(state, {"kind": "consensus", "result": "pass", "pr": "-", "scenario": "-",
                                                             "lineage": rnd["lineage"], "review": args.review, "plan_hash": rnd["plan_hash"],
                                                             "plan_ref": rnd["plan_ref"], "tier": rnd["tier"], "lanes": rnd["lanes"],
                                                             "rounds": rnd["round"], "overridden_by": who, "override_reason": plan_ledger.clip(reason, 300),
                                                             "by": "plan-review"}, now())
                result["consensus"] = "written, overridden by %s" % who
                if engine.audit is not None:
                    engine.audit.append(engine.actor, "plan.review.consensus", rnd["lineage"], {"review": args.review, "overridden_by": who,
                                                                                                "seq": consensus["seq"], "chain": consensus["hash"]})
    elif action == "accept":
        _tell(engine, _round_of(entries, args.review)["by"], "Plan review %s: objection %s was accepted by %s: revise the plan (%s). Then `plan review respond`."
              % (args.review, args.objection, who, plan_ledger.clip(reason, 200)))
        result["next"] = "the planner revises and runs `plan review respond` (the rounds after an escalation are limited to %d)" % plan_review.POST_ESCALATION_ROUNDS
    return result


def review_tick(args, runner, now, socket_call=None):
    """Housekeeping over the open reviews (run by a person, an orchestrator, the chief of staff or a timer): a lane with no verdict after
    `lane_timeout_seconds` is relaunched once and then escalated as unavailable; an escalation nobody decided gets a reminder every
    `escalation_hours`. Never counts a stalled lane as an approval."""
    config = load_config()
    cfg = review_config(config)
    review_caller(runner, now, "run the plan review housekeeping")
    engine, state, _ = build_engine(runner, now, "cli", writable=True, socket_call=socket_call)
    entries = review_entries(state)
    done = {"relaunched": [], "unavailable": [], "reminded": []}
    reviews = sorted({e["review"] for e in entries if e.get("kind") == "round"})
    for review in reviews:
        rnd = _round_of(entries, review)
        mine = [e for e in entries if e.get("lineage") == rnd["lineage"]]
        st = plan_review.lineage_state(mine, rnd["plan_hash"])
        if not st["open_review"]:
            continue
        sessions = [e for e in entries if e.get("kind") == "lane_session" and e.get("review") == review and e.get("round") == rnd["round"]]
        times = {}
        for e in sessions:
            times[e["lane"]] = e["ts"]
        verdict_lanes = set(_verdicts_of(entries, review, rnd["round"]))
        for lane, started in sorted(plan_review.stuck_lanes(rnd["lanes"], times, verdict_lanes, now(), cfg["lane_timeout_seconds"]).items()):
            tries = len([e for e in sessions if e["lane"] == lane])
            if tries <= plan_review.LANE_RETRIES:
                name = "planrev-%s-%s-r%d-retry%d" % (review, lane.lower(), rnd["round"], tries)

                def claim(ledger, seq, lane=lane, tries=tries, name=name):
                    """Under the ledger lock: the relaunch is claimed once (two ticks cannot both relaunch the same lane)."""
                    have = [e for e in ledger if e.get("kind") == "lane_session" and e.get("review") == review and e.get("round") == rnd["round"]
                            and e.get("lane") == lane]
                    if len(have) != tries or any(e.get("session") == name for e in have):
                        raise ReviewError("already relaunched")
                    return {"kind": "lane_session", "lineage": rnd["lineage"], "review": review, "round": rnd["round"], "lane": lane,
                            "session": name, "pane": None, "retry": tries, "by": "plan-review"}
                try:
                    plan_ledger.append_checked(state, now(), claim)
                except ReviewError:
                    continue
                try:
                    ns = types.SimpleNamespace(source=rnd["plan_ref"], file=None, ask=None, done_when=None)
                    text = load_plan(ns, runner, now)[0]
                    brief = plan_review.lane_brief(lane, rnd["plan_ref"], rnd["plan_hash"], text, *_ask_texts(config, runner, now, rnd),
                                                   carried=_carried(entries, rnd["lineage"], lane), closing=bool(rnd.get("closing")))
                    launch_agent(engine, name, cfg["lane_agent"], cfg.get("dir") or os.getcwd(),
                                 cfg.get("workspace") or os.environ.get("HERDR_WORKSPACE_ID"), role="reviewer", reports_to=None,
                                 issue=rnd.get("ask_number"), brief=brief)
                    done["relaunched"].append(lane)
                except (LaunchError, PlanInputError, ValueError, ConfigError, IntentError):
                    pass   # the claim stands: the next tick finds the lane still silent with its retry spent, and escalates it
                continue
            boss, owner_only = _escalation_target(engine, rnd["by"])
            key = "%s/unavailable" % lane

            def unavailable(ledger, seq, lane=lane, key=key, boss=boss, owner_only=owner_only):
                if key in _escalations(ledger, review):
                    raise ReviewError("already escalated")
                return {"kind": "escalation", "lineage": rnd["lineage"], "review": review, "round": rnd["round"], "objection": key,
                        "lane": lane, "text": "lane %s gave no verdict after a relaunch" % lane, "response": "", "boss": boss,
                        "owner_only": owner_only, "plan_hash": rnd["plan_hash"], "held_area": bool(rnd.get("held_area")), "by": "plan-review"}
            try:
                plan_ledger.append_checked(state, now(), unavailable)
            except ReviewError:
                continue
            _tell(engine, "chief-of-staff" if owner_only else boss,
                  "Plan review %s: lane %s is unavailable (no verdict after a relaunch); a stalled lane never counts as an approval. "
                  "Decide with `plan review decide %s --objection %s --accept|--override --reason ...`." % (review, lane, review, key))
            done["unavailable"].append((lane, boss))
        for key, esc in _escalations(entries, review).items():
            def remind(ledger, seq, key=key, esc=esc):
                times = [e["ts"] for e in ledger if e.get("kind") == "reminder" and e.get("review") == review and e.get("objection") == key]
                if not plan_review.reminder_due(esc["ts"], max(times) if times else None, now(), cfg["escalation_hours"]):
                    raise ReviewError("not due")
                return {"kind": "reminder", "lineage": rnd["lineage"], "review": review, "objection": key, "by": "plan-review"}
            try:
                plan_ledger.append_checked(state, now(), remind)
            except ReviewError:
                continue
            _tell(engine, "chief-of-staff" if esc.get("owner_only") else esc.get("boss"),
                  "Reminder: plan review %s has an escalation (%s) undecided for over %d hours." % (review, key, cfg["escalation_hours"]))
            done["reminded"].append(key)
        entries = review_entries(state)
    done["unavailable"] = [l for l, _ in done["unavailable"]]
    return done


def review_abandon(args, runner, now):
    config = load_config()
    review_config(config)
    _, who = review_caller(runner, now, "abandon a plan review")
    engine, state, _ = build_engine(runner, now, "cli", writable=True)
    entries = review_entries(state)
    rnd = _round_of(entries, args.review)
    if _abandoned(entries, args.review):
        raise ReviewError("review %s is already abandoned" % args.review)
    reason = " ".join((args.reason or "").split())
    if len(reason) < plan_ledger.WAIVER_REASON_MIN:
        raise ReviewError("a reason of at least %d characters is required" % plan_ledger.WAIVER_REASON_MIN)
    _review_record(engine, state, {"kind": "abandoned", "lineage": rnd["lineage"], "review": args.review, "round": rnd["round"],
                                   "reason": plan_ledger.clip(reason, 300), "by": who}, now)
    closed = []
    for key, esc in sorted(_escalations(review_entries(state), args.review).items()):   # an abandoned review's escalations are closed, so a new start is not refused for ever
        _review_record(engine, state, {"kind": "decision", "lineage": rnd["lineage"], "review": args.review, "objection": key,
                                       "action": "abandoned", "reason": plan_ledger.clip(reason, 300), "by": who, "decider": "abandon"}, now)
        closed.append(key)
    return {"abandoned": args.review, "lineage": rnd["lineage"], "by": who, "escalations_closed": closed}


def cmd_plan_review(args, runner, now, socket_call=None):
    """`plan review start|verdict|respond|status|abandon`: exit 0 done, 2 refused or unusable. One JSON object on stdout with --json."""
    try:
        action = {"start": review_start, "verdict": review_verdict, "respond": review_respond, "status": review_status,
                  "abandon": review_abandon, "decide": review_decide, "tick": review_tick, "close": review_close,
                  "report": review_report}[args.review_action]
        done = (action(args, runner, now, socket_call) if args.review_action in ("start", "respond", "verdict", "tick", "close")
                else action(args, runner, now))
    except (ReviewError, PlanInputError, ValueError, ConfigError, IntentError, plan_ledger.LedgerError, CallerError, IdentityUncertain,
            LaunchError, OSError) as err:
        sys.stderr.write("%s: plan review: %s\n" % (PROG, _one_line(str(err), 400)))
        return EXIT_USAGE
    if getattr(args, "json", False):
        print(json.dumps(done, sort_keys=True))
    else:
        for key, value in done.items():
            print("%s: %s" % (key, value if not isinstance(value, (list, dict)) else json.dumps(value, sort_keys=True)))
    return EXIT_OK


# ---------------------------------------------------------------- `prove`, `verdict`, `gates` (#107): the evidence ledger

PLAN_LINE_RE = re.compile(r"(?m)^\s*PLAN:\s*(\S+)")
LEDGER_PR_PATTERN = r"owner/repo#N or the PR's URL"


class LedgerCommandError(Exception):
    """A `prove`, `verdict` or `gates` command that cannot go on (exit 2): a usage problem, said in one line."""


def pr_picture(engine, repo, number, state):
    """(facts, body, notice senders) of a PR, best effort: ({}, "", []) with a reason string when it cannot be read."""
    try:
        raw = read_pr_json(engine, repo, number)
        facts = pr_facts_from(raw)
    except (NoticeError, AttributeError) as err:
        return None, "", [], _one_line(str(err), 160)
    body = raw.get("body") if isinstance(raw.get("body"), str) else ""
    item = next((i for i in read_pr_notices(state) if i["repo"] == repo and i["number"] == number), None)
    return facts, body, notice_senders(item) if item else [], None


def authoritative_plan(entries, pr, body):
    """(source, where) of the plan a PR is under, which its writer does not choose: the `PLAN:` line of the PR body, else
    the plan of the PR's FIRST ledger entry. (None, None) when neither exists yet."""
    found = PLAN_LINE_RE.search(body or "")
    if found:
        return found.group(1).strip("<>.,"), "the PR body's PLAN: line"
    for entry in entries:
        if entry.get("pr") == pr and entry.get("plan_ref"):
            return entry["plan_ref"], "the PR's first ledger entry"
    return None, None


def _same_plan(a, b, default_repo):
    try:
        return parse_plan_source(a, default_repo) == parse_plan_source(b, default_repo)
    except PlanInputError:
        return a == b


def plan_source_for(explicit, entries, pr, body, default_repo=None):
    """The plan to use: the authoritative one. `--plan` may only repeat it, or name the first plan when there is none yet;
    a different one is refused (LedgerCommandError), so the writer cannot swap the plan its own work is judged against."""
    source, where = authoritative_plan(entries, pr, body)
    if explicit and source and not _same_plan(explicit, source, default_repo):
        raise LedgerCommandError("--plan %s is not the PR's plan: %s names %s. Change the PR body's PLAN: line to change the "
                                 "plan (that voids the earlier entries), not the command" % (explicit, where, source))
    return source or explicit


def checked_plan(engine_config, source, ask, runner, now):
    """The plan at `source`, checked: {"result", "defects", "scenarios_parsed", "plan_hash", "source"}."""
    ns = types.SimpleNamespace(source=source, file=None, ask=ask, done_when=None)
    text, label, result = load_plan(ns, runner, now)
    parsed = plan_check.parse_scenarios(plan_check.scenario_block(text))
    return dict(result, scenarios_parsed=parsed, source=label, text=text)


def _ledger_pr(args):
    try:
        repo, number = parse_pr_ref(args.pr)
    except NoticeError as err:
        raise LedgerCommandError(str(err)) from None
    return repo, number, "%s#%d" % (repo, number)


def _ledger_context(args, runner, now, writable, parts=None, floor=False):
    """Everything `prove`, `verdict` and `gates` share: the engine, state, PR ref, its picture and its checked plan. `parts` is
    (engine, state, config) when the caller already has them (the daemon's pass); else the engine is built."""
    engine, state, config = parts if parts is not None else build_engine(runner, now, "cli", writable=writable)
    repo, number, pr = _ledger_pr(args)
    entries, problem = plan_ledger.read_ledger(state)
    facts, body, senders, unreadable = pr_picture(engine, repo, number, state)
    if writable:   # #770: an item's entries are written only by the item commands
        why = item_entry_refusal(engine, repo, number, entries, unreadable)
        if why:
            _gates_audit(engine, "plan.item.refused", pr, {"item": pr, "why": why, "stage": "pull request command"})
            raise LedgerCommandError("refused: %s" % why)
    facts = dict(facts or {}, body=body, notice_senders=senders, held_check=lambda: held_defects(body))
    if floor and facts.get("head"):
        facts["floor"] = gate_floor_fact(engine, state, repo, number, facts["head"])
    source = plan_source_for(args.plan, entries, pr, body, config.get("intent_repo"))
    plan, plan_problem = None, None
    if source:
        try:
            plan = checked_plan(config, source, args.ask, runner, now)
        except (PlanInputError, ValueError, ConfigError, IntentError) as err:
            plan_problem = _one_line(str(err), 200)
    return types.SimpleNamespace(engine=engine, state=state, config=config, repo=repo, number=number, pr=pr, entries=entries,
                                 problem=problem, facts=facts, unreadable=unreadable, source=source, plan=plan,
                                 plan_problem=plan_problem)


def _plan_usable(ctx):
    if ctx.plan is None:
        raise LedgerCommandError("no plan to bind to: %s" % (ctx.plan_problem or "pass --plan <owner/repo#N>, or put "
                                                              "`PLAN: <link>` in the PR body"))
    if ctx.plan["result"] != "pass":
        raise LedgerCommandError("the plan fails `plan check` (%d defect(s)): fix it first, nothing was recorded" % len(ctx.plan["defects"]))


def _scenario_of(ctx, sid):
    _plan_usable(ctx)
    found = next((x for x in ctx.plan["scenarios_parsed"] if x.get("id") == sid), None)
    if found is None:
        raise LedgerCommandError("the plan has no scenario %s (it has %s)" % (sid, ", ".join(x.get("id", "?") for x in ctx.plan["scenarios_parsed"][:12])))
    if plan_ledger.claim_of(found) != "pr":
        raise LedgerCommandError("%s is claimed at the epic, not per PR: it is proven at the epic's integrated head" % sid)
    return found


def _head_of(ctx, args):
    known = (ctx.facts or {}).get("head")
    head = args.head or known
    if known and args.head and not (known.startswith(args.head) or args.head.startswith(known)):
        raise LedgerCommandError("--head %s is not the PR's head (%s): nothing was recorded" % (args.head[:12], known[:12]))
    if not head or not re.fullmatch(r"[0-9a-f]{7,40}", head):
        raise LedgerCommandError("the PR head is unknown (%s): pass --head <sha>" % (ctx.unreadable or "not a sha"))
    return head


def _record(ctx, args, now, entry):
    stored = plan_ledger.append_entry(ctx.state, entry, now())
    if ctx.engine.audit is not None:
        ctx.engine.audit.append(ctx.engine.actor, "plan.%s" % entry["kind"], ctx.pr,
                                {"scenario": entry["scenario"], "result": entry["result"], "seq": stored["seq"], "by": entry["by"],
                                 "chain": stored["hash"]})
    return stored


def _evidence(args):
    text = plan_ledger.clip(redact_command_text(args.evidence), plan_ledger.EVIDENCE_LIMIT)
    if not text:
        raise LedgerCommandError("--evidence is required: a link, or what you ran and saw")
    return text


def _already_proven(ctx, sid, plan_hash, head, result):
    """The newest proof of `sid` for this PR when it is at THIS plan hash and head with the same result, else None."""
    mine = [e for e in ctx.entries if e.get("pr") == ctx.pr and e.get("kind") == "proof" and e.get("scenario") == sid]
    fresh = [e for e in mine if e.get("plan_hash") == plan_hash and e.get("head") == head]
    return fresh[-1] if fresh and fresh[-1].get("result") == result else None


def cmd_prove(args, runner, now):
    """`prove <scenario>... --pr <repo#N> --evidence ...`: the calling agent records what it ran and saw for each named scenario of
    the PR's plan, at the PR's head, bound to the plan's hash. It records a PROOF; it never records a verdict. Each scenario gets one
    line: recorded (stdout), or already recorded at this head and plan hash (stdout, counts as recorded), or refused with its
    reason (stderr). Exit 0 when every named scenario is recorded; EXIT_PARTIAL when any was refused. What applies to the whole
    command (no plan, a failing plan check, no caller, no evidence, an unknown head) stays a usage error: nothing is recorded."""
    ctx = _ledger_context(args, runner, now, True)
    caller = identify_caller(ctx.engine.herdr, ctx.engine.v2, os.environ)
    _plan_usable(ctx)
    refused, common = 0, None
    for sid in dict.fromkeys(args.scenario):
        try:
            _scenario_of(ctx, sid)
        except LedgerCommandError as err:
            print("not recorded: %s: %s" % (sid, err), file=sys.stderr)
            refused += 1
            continue
        if common is None:
            head = _head_of(ctx, args)
            common = (head, _evidence(args))
        head, evidence = common
        found = _already_proven(ctx, sid, ctx.plan["plan_hash"], head, args.result)
        if found:
            print("already recorded proof #%d: %s %s at %s (%s), bound to plan %s" % (found["seq"], sid, args.result, head[:8], ctx.pr,
                                                                                  ctx.plan["plan_hash"][:19]))
            continue
        entry = {"kind": "proof", "pr": ctx.pr, "scenario": sid, "plan_ref": ctx.source,
                 "plan_hash": ctx.plan["plan_hash"], "head": head, "result": args.result, "by": caller,
                 "evidence": evidence, "command": plan_ledger.clip(redact_command_text(args.command or "")),
                 "env": "%s %s" % (sys.platform, "python%d.%d" % sys.version_info[:2])}
        stored = _record(ctx, args, now, entry)
        print("recorded proof #%d: %s %s at %s (%s), bound to plan %s" % (stored["seq"], sid, args.result,
                                                                          head[:8], ctx.pr, entry["plan_hash"][:19]))
    return EXIT_PARTIAL if refused else EXIT_OK


cmd_prove.ledger = True   # state and GETs only; its own errors are usage errors


def launched_testers_for(ctx):
    """({name: launch record}, {name: session id}, {name: metadata.fleet}) from ONE read of the running agents: the testers the launch record makes testers
    of this PR's repo (#372), and what the lane rule needs. Never raises: a discovery that fails gives nothing launched (so only the configured list
    counts, and the lane rule has nobody to apply to); an unreadable retired list counts every launched tester as retired (fail closed)."""
    try:
        agents = ctx.engine.discover(ctx.engine.now()).agents
        fleets = {name: (seen.fleet or {}) for name, seen in agents.items()}
        sessions = {name: seen.session_id for name, seen in agents.items()}
    except Exception:
        return {}, {}, {}
    try:
        retired = registry_retired_strict(ctx.engine.state_dir) if ctx.engine.state_dir is not None else {}
    except Exception as err:   # a corrupt retired file could hide a retired tester: no launched tester counts, loudly (audit; `status` says so too)
        ctx.engine._note("testers.retired_unreadable", None, {"error": _one_line(str(err), 160), "effect": "launch-record testers disabled"})
        return {}, sessions, fleets
    return load_launch_testers().launched(fleets, sessions, ctx.repo, lambda fleet: _fleet_repo(fleet, ctx.config), retired), sessions, fleets


def cmd_verdict(args, runner, now):
    """`verdict <scenario> --pr <repo#N> --as <evaluator> --result ...`: record the evaluator's verdict for a scenario. Only
    the evaluator the scenario names, only by an agent registered for it (`plan_evaluators`), never by a writer of the PR."""
    ctx = _ledger_context(args, runner, now, True)
    every = bool(getattr(args, "all_scenarios", False))
    if every:   # `--all`: every per-PR scenario this evaluator judges, in one command; never another evaluator's
        if args.scenario:
            raise LedgerCommandError("--all takes no scenario id: it records every scenario the plan names for --as %s" % args.evaluator)
        _plan_usable(ctx)
        targets = [x for x in ctx.plan["scenarios_parsed"]
                   if plan_ledger.claim_of(x) == "pr" and plan_ledger.evaluator_of(x) == args.evaluator]
        if not targets:
            raise LedgerCommandError("no per-PR scenario of this plan is judged by %s: nothing was recorded" % args.evaluator)
        named = args.evaluator
    else:
        if not args.scenario:
            raise LedgerCommandError("name the scenario (`verdict S1 ...`), or use --all for every scenario judged by --as")
        scenario = _scenario_of(ctx, args.scenario)
        named = plan_ledger.evaluator_of(scenario)
        targets = [scenario]
        if args.evaluator != named:
            raise LedgerCommandError("scenario %s is judged by %s, not %s: nothing was recorded" % (args.scenario, named, args.evaluator))
    senders = ctx.facts.get("notice_senders") or ()
    if named == "owner":
        # The owner's verdict comes only from the owner's own terminal: a caller with NO agent session. An agent (even an
        # unregistered one, even the chief of staff) is refused; so is an uncertain identity.
        got = gates_caller_kind(runner, now)
        caller, ok = "owner", got[0] == "person"
        why = None if ok else "only the owner, from the owner's own terminal (no agent session), may record `owner` verdicts; %s is %s" % (
            got[1], "an agent" if got[0] == "agent" else "not known")
    else:
        caller = identify_caller(ctx.engine.herdr, ctx.engine.v2, os.environ)
        if not plan_ledger.known_writers(ctx.entries, ctx.pr, senders):
            raise LedgerCommandError("refused: no writer of %s is known to the switchboard (nobody has recorded a proof or sent its "
                                     "`notice pr`): its author must do that first, so the author can be excluded" % ctx.pr)
        allowed, launch, sessions, fleets = ctx.config.get("plan_evaluators"), {}, {}, {}
        authors = plan_ledger.authors_of(ctx.entries, ctx.pr, senders, ctx.facts.get("author"))
        if named == "tester":   # #372: the configured list UNION the testers the launch record names for this repo; any trouble reading it is the configured list alone
            launch, sessions, fleets = launched_testers_for(ctx)
            allowed = load_launch_testers().evaluators(allowed, launch)
        ok, why = plan_ledger.may_record_verdict(named, caller, allowed, authors)
        if ok and named == "tester" and caller in launch:
            why = load_launch_testers().lane_refusal(caller, launch, authors, sessions, fleets)
            ok = why is None
    if not ok:
        if ctx.engine.audit is not None:
            ctx.engine.audit.append(ctx.engine.actor, "plan.verdict.refused", ctx.pr,
                                    {"scenario": args.scenario or "--all", "by": caller if named != "owner" else "(not the owner's terminal)",
                                     "evaluator": named, "why": why})
        raise LedgerCommandError("refused: %s" % why)
    if every and not args.head:   # the verdicts say "I judged THIS head": never guess it for a batch (the head may have moved)
        raise LedgerCommandError("--all needs --head <sha> (the head you judged): a batch is never stamped with whatever the head is now")
    head, evidence = _head_of(ctx, args), _evidence(args)
    entries = [{"kind": "verdict", "pr": ctx.pr, "scenario": target["id"], "plan_ref": ctx.source,
                "plan_hash": ctx.plan["plan_hash"], "head": head, "result": args.result, "by": caller,
                "evaluator": named, "evidence": evidence} for target in targets]
    try:
        stored = plan_ledger.append_many(ctx.state, entries, now())   # all of them or none
    except plan_ledger.LedgerError as err:
        raise LedgerCommandError("%s" % err) from None
    for entry, one in zip(entries, stored):
        if ctx.engine.audit is not None:
            detail = {"scenario": entry["scenario"], "result": entry["result"], "seq": one["seq"], "by": entry["by"], "chain": one["hash"]}
            if named == "tester" and caller in launch and load_launch_testers().source_of(caller, ctx.config.get("plan_evaluators"), launch) == "launch record":
                detail["launch_record"] = {k: v for k, v in launch[caller].items() if v is not None}   # #372: the record this verdict relied on
            ctx.engine.audit.append(ctx.engine.actor, "plan.verdict", ctx.pr, detail)
        print("recorded %s verdict #%d: %s %s at %s (%s), bound to plan %s" % (named, one["seq"], entry["scenario"], args.result,
                                                                             head[:8], ctx.pr, entry["plan_hash"][:19]))
    return EXIT_OK


cmd_verdict.ledger = True   # state and GETs only; its own errors are usage errors


def cmd_waive(args, runner, now):
    """`waive <repo#N> --gates G0a,G1 --reason "..."`: the logged override of G0 to G5 for ONE PR at ITS CURRENT HEAD, for a hotfix.
    The chief of staff or a person at a shell only (an unknown session is refused, never read as a person: #138); never G6, G7 or
    G8; a reason of at least WAIVER_REASON_MIN characters; never by a writer of the PR. A ledger entry (kind `waiver`, hash-chained)
    and an audit line. It lasts WAIVER_SECONDS (the due date of the retroactive plan) and covers the head it was recorded at: a push
    needs a new one. `gates` shows the gate as `waived`, never as passed."""
    engine, state, config = build_engine(runner, now, "cli")
    kind = gates_caller_kind(runner, now)   # THE shared check: a person path needs the owner's own terminal (#164), no second copy
    ok = kind[0] == "person" or (kind[0] == "agent" and kind[2] == "chief-of-staff")
    who = kind[1]
    gates, why = plan_ledger.parse_waiver_gates(args.gates)
    if ok and why is None and len(" ".join((args.reason or "").split())) < plan_ledger.WAIVER_REASON_MIN:
        why = "a reason of at least %d characters is required: say why this PR may skip the gates" % plan_ledger.WAIVER_REASON_MIN
    if not ok or why is not None:
        _gates_audit(engine, "gate.waiver.refused", args.pr, {"by": who, "gates": args.gates, "why": why or "the caller may not waive"})
        raise LedgerCommandError("refused: %s" % (why or "%s may not waive gates (the chief of staff, or a person at a shell, may)" % who))
    repo, number, pr = _ledger_pr(args)
    entries, problem = plan_ledger.read_ledger(state)
    if problem:
        _gates_audit(engine, "gate.waiver.refused", pr, {"by": who, "why": "the ledger is not trustworthy"})
        raise LedgerCommandError("refused: the ledger is not trustworthy, nothing was recorded: %s" % problem)
    facts, body, senders, unreadable = pr_picture(engine, repo, number, state)
    why = item_entry_refusal(engine, repo, number, entries, unreadable)   # #770: a work item's gates are not waived through the pull request command
    if why:
        _gates_audit(engine, "plan.item.refused", pr, {"item": pr, "why": why, "stage": "waive"})
        raise LedgerCommandError("refused: %s" % why)
    ctx = types.SimpleNamespace(facts=dict(facts or {}, body=body, notice_senders=senders), unreadable=unreadable)
    head = _head_of(ctx, args)
    writers = plan_ledger.authors_of(entries, pr, senders, (facts or {}).get("author"))
    if who in writers:
        _gates_audit(engine, "gate.waiver.refused", pr, {"by": who, "why": "a writer of the PR"})
        raise LedgerCommandError("refused: %s wrote this PR (recorded its proof or sent its notice): a writer cannot waive its own gates" % who)
    reason = plan_ledger.clip(redact_command_text(" ".join(args.reason.split())), plan_ledger.FIELD_LIMIT)
    expires = int(now()) + plan_ledger.WAIVER_SECONDS
    entry = {"kind": "waiver", "pr": pr, "head": head, "gates": gates, "reason": reason, "by": who, "result": "pass",
             "expires": expires, "evidence": reason}
    stored = plan_ledger.append_entry(state, entry, now())
    _gates_audit(engine, "plan.waiver", pr, {"gates": gates, "head": head, "by": who, "reason": reason, "expires": iso(expires),
                                              "seq": stored["seq"], "chain": stored["hash"]})
    print("recorded waiver #%d: %s of %s at %s by %s, until %s (the retroactive plan is due then); `gates` shows it as waived, not passed"
          % (stored["seq"], ",".join(gates), pr, head[:8], who, iso(expires)))
    return EXIT_OK


cmd_waive.ledger = True   # state and GETs only; its own errors are usage errors


# ---- #818: which open pull requests change the same files. Read-only information, never a block. Pure parsing and the two texts; the one bounded read is `read_open_overlap`.
OVERLAP_LIST_CAP = 50    # the most open pull requests read, in one call
OVERLAP_FILES_CAP = 100  # the most files of one pull request used; a pull request with more changed files is left out
OVERLAP_SHOW_FILES = 3   # files named in a `shares` line
OVERLAP_PATH_MAX = 300  # a longer path, or one with a control character, is not printed: the pull request is left out
OVERLAP_SHOW_PRS = 5     # pull requests named in a `shares` line or a merge order


def overlap_parse_listing(raw):
    """{number: [paths]} of the pull requests whose whole file list was read. Anything else is left out, never guessed."""
    out = {}
    if not isinstance(raw, list):
        return out
    for item in raw[:OVERLAP_LIST_CAP]:
        if not isinstance(item, dict) or isinstance(item.get("number"), bool) or not isinstance(item.get("number"), int):
            continue
        files, total = item.get("files"), item.get("changedFiles")
        if not isinstance(files, list) or isinstance(total, bool) or not isinstance(total, int):
            continue
        if total > OVERLAP_FILES_CAP or len(files) != total:
            continue   # truncated or over the cap: not the whole list
        paths = [f.get("path") for f in files if isinstance(f, dict)]
        if len(paths) != total or not all(isinstance(p, str) and 0 < len(p) <= OVERLAP_PATH_MAX and p.isprintable() for p in paths):
            continue
        out[item["number"]] = sorted(set(paths))
    return out


def overlap_shared(listing, number, other):
    return sorted(set(listing.get(number) or ()) & set(listing.get(other) or ()))


def overlap_shares_line(listing, number):
    """`shares <file>, <file> with #N, #M`, or None. Files: the first OVERLAP_SHOW_FILES (sorted) changed by this pull request AND another listed one;
    pull requests: the first OVERLAP_SHOW_PRS by number. None when this pull request's own list was not read or nothing overlaps."""
    if not isinstance(listing, dict) or number not in listing:
        return None
    others = sorted(n for n in listing if n != number and overlap_shared(listing, number, n))
    if not others:
        return None
    files = sorted({p for n in others for p in overlap_shared(listing, number, n)})
    return "shares %s with %s" % (", ".join(files[:OVERLAP_SHOW_FILES]), ", ".join("#%d" % n for n in others[:OVERLAP_SHOW_PRS]))


def overlap_waiting_order(listing, waited):
    """Hints among held pull requests that share files. `waited` is [(number, since)] of the held ones (since: epoch seconds, smaller waited longer).
    One hint per group of held pull requests linked by shared files, the one that has waited longest first: `merge order: #748, then #736 (shared files)`."""
    held = {n: s for n, s in waited if n in (listing or {})}
    seen, hints = set(), []
    for start in sorted(held):
        if start in seen:
            continue
        group, todo = set(), [start]
        while todo:
            n = todo.pop()
            if n in group:
                continue
            group.add(n)
            todo.extend(m for m in held if m not in group and overlap_shared(listing, n, m))
        seen |= group
        if len(group) > 1:
            ordered = sorted(group, key=lambda n: (held[n], n))[:OVERLAP_SHOW_PRS]
            hints.append("merge order: %s (shared files)" % ", then ".join("#%d" % n for n in ordered))
    return hints


def read_open_overlap(engine, repo, runner):
    """{number: [paths]} of the open pull requests of `repo` whose whole file list was read , or None when it cannot be read. ONE bounded
    `gh pr list` (at most OVERLAP_LIST_CAP pull requests, OVERLAP_FILES_CAP files each), cached on the engine for the call. CLI only: the daemon never calls it (#818)."""
    cache = engine.__dict__.setdefault("_overlap_cache", {})
    if repo in cache:
        return cache[repo]
    cache[repo] = None
    try:
        accounts = getattr(engine, "accounts", None) or GhAccounts(engine.config, engine.gh_runner or runner, engine.now)
        refuse_excluded(engine.config, repo)
        env = accounts.env_for(repo)
        argv = [engine.config["gh"], "pr", "list", "--repo", repo, "--state", "open", "--limit", str(OVERLAP_LIST_CAP), "--json", "number,files,changedFiles"]
        done = (engine.gh_runner or runner)(argv, capture_output=True, text=True, timeout=min(engine.config["call_timeout_seconds"], GITHUB_ROUTE_READ_TIMEOUT),
                                            stdin=subprocess.DEVNULL, **({"env": env} if env is not None else {}))
        if done.returncode == 0:
            cache[repo] = overlap_parse_listing(json.loads(done.stdout or "[]"))
    except Exception:   # advisory: whatever goes wrong, there is no line (never a wrong one) and nothing else changes
        cache[repo] = None
    return cache[repo]


def cmd_gates(args, runner, now):
    """`gates <repo#N>`: read-only. One line per gate G0a to G8: status, who decides it, what is missing. Exit 0 when every
    tracked gate that applies to a PR is satisfied, 1 when something is missing, 2 when it cannot be read. Enforces nothing."""
    if args.pr in ("mode", "off", "on"):
        return cmd_gates_switch(args, runner, now)
    if args.pr == "ci-record":
        args.pr = args.rest[0] if args.rest else ""
        return cmd_gates_ci_record(args, runner, now)
    if args.pr == "item":   # #770: `gates item <repo#N>` is a work item with no pull request
        return cmd_item_gates(args, runner, now)
    if args.pr == "item-ci-record":
        return cmd_item_ci_record(args, runner, now)
    if args.pr == "preflight":
        args.pr = args.rest[0] if args.rest else ""
        return cmd_gates_preflight(args, runner, now)
    if args.pr == "stats":
        return cmd_gates_stats(args, runner, now)
    ctx = _ledger_context(args, runner, now, False, floor=True)
    plan = ctx.plan
    report = plan_ledger.evaluate_gates(plan, ctx.entries, ctx.problem, ctx.facts if ctx.facts.get("head") or ctx.facts.get("body") else None, ctx.pr,
                                        now=now())
    report["plan_problem"] = ctx.plan_problem
    report["pr_unreadable"] = ctx.unreadable
    report["impact_rating"] = gate_impact_rating(ctx.state, ctx.pr, ctx.facts.get("head"))   # #892: output text only; no gate reads it
    gates_carried_note(report, ctx)
    plan_ledger.enforced_view(report, enforced_gates_of(ctx))
    first = next((e.get("plan_ref") for e in ctx.entries if e.get("pr") == ctx.pr and e.get("plan_ref")), None)
    report["plan_source"] = ctx.source
    if first and ctx.source and not _same_plan(first, ctx.source, ctx.config.get("intent_repo")):
        report["plan_changed"] = "the PR's plan is now %s; its entries were recorded against %s (they are void)" % (ctx.source, first)
    shares = overlap_shares_line(read_open_overlap(ctx.engine, ctx.repo, runner), ctx.number) if not ctx.unreadable else None   # #818: information only
    if args.json:
        if isinstance(ctx.facts, dict) and rating_block_note(ctx.entries, ctx.pr, ctx.facts.get("head")):
            report["rating_block"] = rating_block_note(ctx.entries, ctx.pr, ctx.facts.get("head"))
        if shares:
            report["shares"] = shares
        print(json.dumps(report, sort_keys=True))
    else:
        lines = plan_ledger.render_gates(report, ctx.pr)
        if shares:
            lines.append(shares)
        if ctx.unreadable:
            lines.append("PR not read: %s" % ctx.unreadable)
        if ctx.plan_problem:
            lines.append("plan not read: %s" % ctx.plan_problem)
        note = rating_block_note(ctx.entries, ctx.pr, ctx.facts.get("head")) if isinstance(ctx.facts, dict) else None
        if note:
            lines.append("rating: %s" % note)
        if report.get("plan_changed"):
            lines.append("PLAN CHANGED: %s" % report["plan_changed"])
        print("\n".join(lines))
    ok = report["ready"] if getattr(args, "all_gates", False) else report["ready_enforced"]   # --all: the full board
    return EXIT_OK if ok else EXIT_ERROR


cmd_gates.ledger = True   # state and GETs only; its own errors are usage errors


# ---------------------------------------------------------------- verdicts for a work item with no pull request (#770, plan fleet-kit#777)
# The rules are bin/item_verdicts.py. This is the reading (GET only) and the writing (the ledger and the audit). The pull request RULES (`launched_testers_for`,
# `plan_ledger.may_record_verdict`, `ci_record_core`) are untouched, and the ordinary pull request COMMANDS refuse an item (an issue number or a number with an item
# registration: `item_entry_refusal`), so an item's entries are written only here. An item key is `owner/repo#N` of an ISSUE.

def _item_of(args):
    try:
        repo, number, comment = parse_plan_source(args.item, None)
    except PlanInputError:
        raise LedgerCommandError("%r is not a work item: write owner/repo#N of an issue" % args.item) from None
    if comment is not None or not repo:
        raise LedgerCommandError("%r is not a work item: write owner/repo#N of an issue" % args.item)
    return repo, number, load_module("item_verdicts").item_ref(repo, number)


def item_issue(engine, repo, number):
    """{"author", "body", "state", "parent"} of the ISSUE `repo#number`. A pull request is refused (its rules are the pull request's: use --pr)."""
    try:
        data = engine.intents._api("repos/%s/issues/%d" % (repo, number), repo)
    except (IntentError, AttributeError) as err:
        raise LedgerCommandError("%s#%d could not be read: %s" % (repo, number, _one_line(str(err), 160))) from None
    if not isinstance(data, dict):
        raise LedgerCommandError("%s#%d could not be read" % (repo, number))
    if data.get("pull_request"):
        raise LedgerCommandError("%s#%d is a pull request: use --pr (the pull request rules apply to it, not the work item rules)" % (repo, number))
    user = data.get("user") if isinstance(data.get("user"), dict) else {}
    return {"author": user.get("login") if isinstance(user.get("login"), str) else None, "body": data.get("body") if isinstance(data.get("body"), str) else "",
            "state": data.get("state"), "parent": parent_of(data)}


def item_chain(engine, repo, number, parent, limit=4):
    """The issue numbers from the item up through its sub-issue parents (the ask, the charter): [item, ask, charter...]. An unreadable link ends the chain (fail closed)."""
    chain, current = [number], parent
    for _ in range(limit):
        if not current or current in chain:
            break
        chain.append(current)
        try:
            current = parent_of(engine.intents._api("repos/%s/issues/%d" % (repo, current), repo))
        except (IntentError, AttributeError):
            break
    return chain


def item_context(args, runner, now, writable):
    """The item's picture: engine, state, config, ledger, the issue, its plan (the PLAN: line of the issue body, never `--plan`, as for a pull request)."""
    engine, state, config = build_engine(runner, now, "cli", writable=writable)
    repo, number, item = _item_of(args)
    entries, problem = plan_ledger.read_ledger(state)
    if problem:
        raise LedgerCommandError("the ledger is not trustworthy, nothing was recorded: %s" % problem)
    issue = item_issue(engine, repo, number)
    source = plan_source_for(getattr(args, "plan", None), entries, item, issue["body"], config.get("intent_repo"))
    plan, plan_problem = None, None
    if source:
        try:
            plan = checked_plan(config, source, getattr(args, "ask", None), runner, now)
        except (PlanInputError, ValueError, ConfigError, IntentError) as err:
            plan_problem = _one_line(str(err), 200)
    own = False
    if source:
        try:
            own = parse_plan_source(source, config.get("intent_repo"))[:2] == (repo, number)
        except PlanInputError:
            own = False
    return types.SimpleNamespace(engine=engine, state=state, config=config, repo=repo, number=number, pr=item, item=item, entries=entries, problem=problem, facts={},
                                 unreadable=None, source=source, plan=plan, plan_problem=plan_problem, issue=issue, plan_own=own)


def _item_scenario(ctx, sid):
    """The scenario an item may claim: one `claim_of` reads as `pr` (so never an epic or ask-level live one) and, in a shared plan, one sliced to this item."""
    scenario = _scenario_of(ctx, sid)
    why = load_module("item_verdicts").claim_problem(scenario, ctx.number, ctx.plan_own)
    if why:
        raise LedgerCommandError(why)
    return scenario


class ItemAgentsUnreadable(Exception):
    """The running agents (or the retired list) could not be read: nothing about who wrote the item can be said, so a write refuses and a read says NOT READY."""


def item_agents(ctx):
    """({name: launch record}, {name: session}, {name: metadata.fleet}) like `launched_testers_for`, but a failure RAISES ItemAgentsUnreadable (fail closed at the read too)."""
    try:
        agents = ctx.engine.discover(ctx.engine.now()).agents
        fleets = {name: (seen.fleet or {}) for name, seen in agents.items()}
        sessions = {name: seen.session_id for name, seen in agents.items()}
        state_dir = getattr(ctx.engine, "state_dir", None)
        retired = registry_retired_strict(state_dir) if state_dir is not None else {}
    except Exception as err:
        raise ItemAgentsUnreadable("the running agents cannot be read (%s: %s)" % (type(err).__name__, _one_line(str(err), 120))) from None
    return load_launch_testers().launched(fleets, sessions, ctx.repo, lambda fleet: _fleet_repo(fleet, ctx.config), retired), sessions, fleets


def item_entry_refusal(engine, repo, number, entries, unreadable):
    """Why the ORDINARY pull request commands (prove, verdict, gates ci-record, waive) must not write for `repo#number`, or None. They refuse a number that is an ISSUE (the pull request
    could not be read and GitHub says it is an issue) and a number that has an item registration: an item's entries are written only by item-prove, item-verdict and item-ci-record.
    A real pull request is never affected (it is read, and has no registration)."""
    ref = "%s#%d" % (repo, number)
    if load_module("item_verdicts").registrations(entries, ref):
        return "%s is a work item (a tester is registered for it): its proofs and verdicts are written only by item-prove, item-verdict and gates item-ci-record" % ref
    if unreadable:
        try:
            item_issue(engine, repo, number)
        except LedgerCommandError:
            return None   # a pull request, or not readable at all: the pull request rules apply as they always did
        return "%s is an issue, not a pull request: use item-prove or item-verdict for a work item" % ref
    return None


def _item_audit(ctx, event, detail):
    _gates_audit(ctx.engine, event, ctx.item, dict(detail, item=ctx.item))


def _item_writers(ctx, sessions=None, fleets=None):
    """(writers, launch, sessions, fleets): the excluded set of the item and the launched testers, from ONE read of the running agents."""
    launch, sessions, fleets = item_agents(ctx)
    chain = item_chain(ctx.engine, ctx.repo, ctx.number, ctx.issue["parent"])
    ask = chain[1] if len(chain) > 1 else None
    return load_module("item_verdicts").excluded(ctx.item, ctx.number, ask, ctx.issue["author"], ctx.entries, fleets, sessions), launch, sessions, fleets


def cmd_item_prove(args, runner, now):
    """`prove <scenario>... --item <repo#N> --evidence ...`: the same proof as for a pull request, for a work item, at the item's reference commit."""
    iv = load_module("item_verdicts")
    ctx = item_context(args, runner, now, True)
    caller = identify_caller(ctx.engine.herdr, ctx.engine.v2, os.environ)
    if not caller:
        raise LedgerCommandError("refused: a proof names who recorded it: run this as a fleet agent")
    _plan_usable(ctx)
    pin = iv.pinned(ctx.entries, ctx.item)
    if not pin:
        raise LedgerCommandError("%s has no reference commit yet: its orchestrator launches a tester with --issue for it first (that registration pins the commit)" % ctx.item)
    refused = 0
    for sid in dict.fromkeys(args.scenario):
        try:
            _item_scenario(ctx, sid)
        except LedgerCommandError as err:
            print("not recorded: %s: %s" % (sid, err), file=sys.stderr)
            refused += 1
            continue
        evidence = _evidence(args)
        found = _already_proven(ctx, sid, ctx.plan["plan_hash"], pin, args.result)
        if found:
            print("already recorded proof #%d: %s %s at %s (%s)" % (found["seq"], sid, args.result, pin[:8], ctx.item))
            continue
        entry = {"kind": "proof", "pr": ctx.item, "scenario": sid, "plan_ref": ctx.source, "plan_hash": ctx.plan["plan_hash"], "head": pin, "result": args.result,
                 "by": caller, "evidence": evidence, "command": plan_ledger.clip(redact_command_text(args.command or "")), "via": "item",
                 "env": "%s %s" % (sys.platform, "python%d.%d" % sys.version_info[:2])}
        stored = plan_ledger.append_entry(ctx.state, entry, now())
        _item_audit(ctx, "plan.item.proof", {"scenario": sid, "result": args.result, "by": caller, "reference_commit": pin, "seq": stored["seq"]})
        print("recorded proof #%d: %s %s at %s (%s)" % (stored["seq"], sid, args.result, pin[:8], ctx.item))
    return EXIT_PARTIAL if refused else EXIT_OK


def cmd_item_verdict(args, runner, now):
    """`verdict <scenario>|--all --item <repo#N> --as tester ...`: a tester registered for THIS item (by its orchestrator's launch) records a verdict at the item's
    reference commit. `ci` is never typed: `gates item-ci-record` records it from the Checks API."""
    iv = load_module("item_verdicts")
    ctx = item_context(args, runner, now, True)
    if args.evaluator != "tester":
        raise LedgerCommandError("a work item takes `tester` verdicts from its registered tester (`ci` is recorded by `gates item-ci-record`; reviewer and owner verdicts are for pull requests): nothing was recorded")
    caller = identify_caller(ctx.engine.herdr, ctx.engine.v2, os.environ)
    _plan_usable(ctx)
    if getattr(args, "all_scenarios", False):
        if args.scenario:
            raise LedgerCommandError("--all takes no scenario id")
        targets = [x for x in ctx.plan["scenarios_parsed"] if plan_ledger.claim_of(x) == "pr" and plan_ledger.evaluator_of(x) == "tester"
                   and iv.claim_problem(x, ctx.number, ctx.plan_own) is None]
        if not targets:
            raise LedgerCommandError("no scenario of this plan that this item may claim is judged by tester: nothing was recorded")
        if not args.head:
            raise LedgerCommandError("--all needs --head <sha> (the item's reference commit): a batch is never stamped with a guess")
    else:
        if not args.scenario:
            raise LedgerCommandError("name the scenario (`verdict S1 --item ...`), or use --all")
        scenario = _item_scenario(ctx, args.scenario)
        if plan_ledger.evaluator_of(scenario) != "tester":
            raise LedgerCommandError("scenario %s is judged by %s, not tester: nothing was recorded" % (args.scenario, plan_ledger.evaluator_of(scenario)))
        targets = [scenario]
    pin = iv.pinned(ctx.entries, ctx.item)
    head = args.head or pin
    try:
        writers, launch, sessions, fleets = _item_writers(ctx)
    except ItemAgentsUnreadable as err:
        _item_audit(ctx, "plan.item.refused", {"scenario": args.scenario or "--all", "by": caller, "evaluator": "tester", "reference_commit": pin, "why": str(err)})
        raise LedgerCommandError("refused: %s" % err) from None
    why = None
    if caller not in launch:
        why = "%s is not a tester launched by an orchestrator of %s: only a registered tester of the lane may record a work item's verdict" % (caller, ctx.repo)
    if why is None:
        why = iv.verdict_problem(ctx.item, caller, ctx.entries, writers, sessions.get(caller), now(), head)
    if why is None:
        why = load_launch_testers().lane_refusal(caller, launch, writers, sessions, fleets)
    if why:
        _item_audit(ctx, "plan.item.refused", {"scenario": args.scenario or "--all", "by": caller, "evaluator": "tester", "reference_commit": pin, "why": why})
        raise LedgerCommandError("refused: %s" % why)
    evidence = _evidence(args)
    regs = iv.registrations(ctx.entries, ctx.item)
    reg = regs[-1] if regs else {}
    entries = [{"kind": "verdict", "pr": ctx.item, "scenario": t["id"], "plan_ref": ctx.source, "plan_hash": ctx.plan["plan_hash"], "head": head, "result": args.result,
                "by": caller, "evaluator": "tester", "evidence": evidence, "via": "item", "session": sessions.get(caller)} for t in targets]

    def recheck(fresh):   # under the ledger's exclusive lock: only what lives in the ledger is re-read (the agents were read above, never under the lock)
        problem = iv.verdict_problem(ctx.item, caller, fresh, writers | iv.ledger_writers(ctx.item, ctx.number, ctx.issue["author"], fresh), sessions.get(caller), now(), head)
        if problem:
            raise plan_ledger.LedgerError(problem)
        return entries
    try:
        stored = plan_ledger.append_many_checked(ctx.state, recheck, now())
    except plan_ledger.LedgerError as err:
        _item_audit(ctx, "plan.item.refused", {"scenario": args.scenario or "--all", "by": caller, "evaluator": "tester", "reference_commit": pin, "why": str(err), "stage": "append"})
        raise LedgerCommandError("refused: %s" % err) from None
    for entry, one in zip(entries, stored):
        _item_audit(ctx, "plan.item.verdict", {"scenario": entry["scenario"], "result": entry["result"], "by": caller, "reference_commit": head, "seq": one["seq"],
                                               "chain": one["hash"], "registration_seq": reg.get("seq")})
        print("recorded tester verdict #%d: %s %s at %s (%s)" % (one["seq"], entry["scenario"], args.result, head[:8], ctx.item))
    return EXIT_OK


cmd_item_prove.ledger = True      # state and GETs only; its own errors are usage errors
cmd_item_verdict.ledger = True


def item_gates_report(ctx, writers):
    """{"item", "head", "plan_hash", "ready", "rows"}: G0a (the plan) and G1 (every scenario the item claims: proof and verdict at the reference commit, by a writer that is not excluded)."""
    iv = load_module("item_verdicts")
    pin = iv.pinned(ctx.entries, ctx.item)
    seen = iv.visible(ctx.entries, ctx.item, plan_ledger.CI_RECORDER)   # an entry that cannot be tied to the item path (a pull request command wrote it) counts for nothing
    rows = []
    if ctx.plan is None:
        rows.append({"gate": "G0a", "status": "missing", "missing": ["no plan found: put `PLAN: <link>` in the item's body"]})
    elif ctx.plan["result"] != "pass":
        rows.append({"gate": "G0a", "status": "missing", "missing": ["plan check fails: %d defect(s)" % len(ctx.plan["defects"])]})
    else:
        rows.append({"gate": "G0a", "status": "ok", "missing": [], "detail": "plan hash %s" % ctx.plan["plan_hash"]})
    scen = []
    if ctx.plan is not None and ctx.plan["result"] == "pass" and pin:
        claimed = [s for s in ctx.plan["scenarios_parsed"] if plan_ledger.claim_of(s) == "pr" and iv.claim_problem(s, ctx.number, ctx.plan_own) is None]
        scen = [plan_ledger.scenario_state(s, seen, ctx.item, ctx.plan["plan_hash"], pin, writers) for s in claimed]
        bad = [s for s in scen if s["status"] != "ok"]
        rows.append({"gate": "G1", "status": "missing" if bad or not scen else "ok", "missing": ["%s: %s" % (s["id"], "; ".join(s["missing"])) for s in bad] or ([] if scen else ["no scenario is claimed by this item"]),
                     "detail": "%d of %d claimed scenarios proven and judged at %s" % (len(scen) - len(bad), len(scen), pin[:8])})
    else:
        rows.append({"gate": "G1", "status": "missing", "missing": ["no reference commit yet: its orchestrator launches a tester with --issue for it" if not pin else "needs a plan that passes G0a"]})
    return {"item": ctx.item, "head": pin, "plan_hash": ctx.plan["plan_hash"] if ctx.plan else None, "scenarios": scen, "rows": rows,
            "ready": all(r["status"] == "ok" for r in rows)}


def cmd_item_gates(args, runner, now):
    """`gates item <repo#N>`: read-only. G0a and G1 for a work item, at its reference commit, with the writers excluded NOW (a tester that later wrote loses its verdicts)."""
    args.item = args.rest[0] if args.rest else ""
    ctx = item_context(args, runner, now, False)
    try:
        writers = _item_writers(ctx)[0]
        report = item_gates_report(ctx, writers)
    except ItemAgentsUnreadable as err:   # fail CLOSED: with the agents unreadable the writer set shrinks, so nothing is read as accepted
        report = {"item": ctx.item, "head": load_module("item_verdicts").pinned(ctx.entries, ctx.item), "plan_hash": ctx.plan["plan_hash"] if ctx.plan else None, "scenarios": [],
                  "rows": [{"gate": "G1", "status": "missing", "missing": ["NOT READY: %s, so the writers of the item cannot be excluded" % err]}], "ready": False}
    if args.json:
        print(json.dumps(report, sort_keys=True))
    else:
        print("gates for %s at %s: %s" % (ctx.item, (report["head"] or "no reference commit")[:8], "READY" if report["ready"] else "NOT READY"))
        print("plan hash: %s" % (report["plan_hash"] or "none"))
        for row in report["rows"]:
            print("%-4s %-8s %s" % (row["gate"], row["status"], "; ".join(row["missing"]) or row.get("detail", "")))
    return EXIT_OK if report["ready"] else EXIT_ERROR


def cmd_item_ci_record(args, runner, now):
    """`gates item-ci-record <repo#N>`: the switchboard records the `ci` verdict of a work item from the Checks API at its reference commit. Any caller may run it: it
    says only what the repository's own checks (`plan_gates.repos.<repo>.item_checks`, name AND app) say. An agent never types a ci verdict."""
    iv = load_module("item_verdicts")
    args.item = args.rest[0] if args.rest else ""
    ctx = item_context(args, runner, now, True)
    _plan_usable(ctx)
    pin = iv.pinned(ctx.entries, ctx.item)
    if not pin:
        raise LedgerCommandError("%s has no reference commit: nothing was recorded" % ctx.item)
    setting = plan_ledger.repo_setting(ctx.config, ctx.repo)
    checks = (setting or {}).get("item_checks") or []
    audit = {"scenarios": [], "recorded": [], "reference_commit": pin}
    try:
        runs, on_branch = [], False
        if checks:
            reader = ctx.engine.intents
            default = (reader._api("repos/%s" % ctx.repo, ctx.repo) or {}).get("default_branch")
            if isinstance(default, str) and default:
                compare = reader._api("repos/%s/compare/%s...%s" % (ctx.repo, urllib.parse.quote(default, safe=""), pin), ctx.repo)
                on_branch = isinstance(compare, dict) and compare.get("status") in ("identical", "behind")
            data = reader._api("repos/%s/commits/%s/check-runs?per_page=100" % (ctx.repo, pin), ctx.repo)
            runs = data.get("check_runs") if isinstance(data, dict) and isinstance(data.get("check_runs"), list) else []
    except (IntentError, AttributeError) as err:
        _item_audit(ctx, "plan.item.ci_record", dict(audit, ok=False, why="the checks could not be read: %s" % _one_line(str(err), 120)))
        raise LedgerCommandError("the checks at %s could not be read: nothing was recorded" % pin[:8]) from None
    ok, seen, why = iv.ci_decision(runs, checks)
    if ok and not on_branch:
        ok, why = False, "the reference commit %s is not on the default branch: its workflow files were not reviewed" % pin[:8]
    audit.update(checks=seen, ok=ok)
    if not ok:
        _item_audit(ctx, "plan.item.ci_record", dict(audit, why=why))
        raise LedgerCommandError("%s: nothing was recorded" % why)
    wanted = [x for x in ctx.plan["scenarios_parsed"] if plan_ledger.claim_of(x) == "pr" and plan_ledger.evaluator_of(x) == "ci" and iv.claim_problem(x, ctx.number, ctx.plan_own) is None]
    audit["scenarios"] = [x["id"] for x in wanted]
    for scenario in wanted:
        fresh = [e for e in ctx.entries if e.get("pr") == ctx.item and e.get("scenario") == scenario["id"] and e.get("kind") == "verdict" and e.get("evaluator") == "ci"
                 and e.get("plan_hash") == ctx.plan["plan_hash"] and e.get("head") == pin and e.get("result") == "pass" and e.get("by") == plan_ledger.CI_RECORDER]
        if not fresh:
            plan_ledger.append_entry(ctx.state, {"kind": "verdict", "pr": ctx.item, "scenario": scenario["id"], "plan_ref": ctx.source, "plan_hash": ctx.plan["plan_hash"],
                                                 "head": pin, "result": "pass", "by": plan_ledger.CI_RECORDER, "evaluator": "ci", "via": "item",
                                                 "evidence": "the repository's checks passed at %s: %s" % (pin[:12], ", ".join(c["name"] for c in checks))}, now())
            audit["recorded"].append(scenario["id"])
    _item_audit(ctx, "plan.item.ci_record", audit)
    print("CI is green at %s for %s: recorded %s" % (pin[:8], ctx.item, ", ".join(audit["recorded"]) or "nothing new"))
    return EXIT_OK


def register_item_tester(engine, state, args, repo, launched_by, done, now):
    """After a `launch --role tester --issue N` of an ISSUE with no pull request: the switchboard itself writes the registration (a ledger entry and an audit line) when,
    and only when, the caller (identified by its own pane) is the orchestrator of this repo that the tester reports to, the item is an open issue of this repo, and the
    orchestrator's charter is in the item's parent chain. It never fails the launch: an unregistered tester can record nothing (fail closed)."""
    if args.role != "tester" or args.issue is None or not repo:
        return
    item, why = "%s#%d" % (repo, int(args.issue)), None
    try:
        issue = item_issue(engine, repo, int(args.issue))
    except LedgerCommandError as err:
        if "is a pull request" in str(err):
            return   # a pull request's tester registers as before: this path does not apply
        why = str(err)
        issue = None
    try:
        if why is None:
            fleets = {n: (s.fleet or {}) for n, s in engine.discover(engine.now()).agents.items()}
            boss = fleets.get(launched_by) if launched_by else None
            iv = load_module("item_verdicts")
            if not isinstance(boss, dict) or boss.get("role") != "orchestrator" or _fleet_repo(boss, engine.config) != repo:
                why = "the launch was not run by an orchestrator of %s" % repo
            elif args.reports_to != launched_by:
                why = "the tester must report to the orchestrator that launches it"
            elif issue["state"] != "open":
                why = "%s is not open" % item
            else:
                chain = item_chain(engine, repo, int(args.issue), issue["parent"])
                charter = charter_or_first_seen(engine, launched_by, boss)   # #969: the launching orchestrator's charter is the registry's (its launch value only while it has no row)
                if not iv.lane_ok(chain, charter):
                    why = "%s is not in the lane of %s: its parent chain %s does not reach the orchestrator's charter" % (item, launched_by, chain)
        pin = None
        if why is None:
            default = (engine.intents._api("repos/%s" % repo, repo) or {}).get("default_branch")
            tip = engine.intents._api("repos/%s/commits/%s" % (repo, urllib.parse.quote(str(default), safe="")), repo) if default else None
            pin = tip.get("sha") if isinstance(tip, dict) else None
            if not load_module("item_verdicts").sha_ok(pin):
                why = "the default branch tip of %s could not be read" % repo
        if why is None:
            link = PLAN_LINE_RE.search(issue["body"] or "")
            stored = plan_ledger.append_entry(state, {"kind": "item_tester", "pr": item, "item": item, "tester": args.name, "session": done.get("session"),
                                                      "orchestrator": launched_by, "head": pin, "plan_ref": link.group(1).strip("<>.,") if link else None, "by": launched_by}, now())
            _gates_audit(engine, "plan.item.register", item, {"item": item, "tester": args.name, "session": done.get("session"), "orchestrator": launched_by,
                                                              "reference_commit": pin, "seq": stored["seq"], "chain": stored["hash"]})
            return
    except Exception as err:   # the launch has happened: say why nothing is registered, never raise
        why = "%s: %s" % (type(err).__name__, _one_line(str(err), 160))
    _gates_audit(engine, "plan.item.refused", item, {"item": item, "tester": args.name, "orchestrator": launched_by, "why": why, "stage": "registration"})
    sys.stderr.write("%s: %s is NOT registered as a tester of %s: %s\n" % (PROG, args.name, item, _one_line(why, 200)))


def gates_stats_core(entries, merged_at, limit=10):
    """Per gated PR that has merged: the evidence records by actor (the switchboard's own `ci` records are the automatic ones) and the
    minutes from the first gate record to the merge. `entries` is the ledger; `merged_at(pr)` is the merge time (epoch seconds) or None.
    Newest merged first, at most `limit`. Returns {"prs": [...], "unmerged": n}."""
    by_pr = {}
    for entry in entries:
        if entry.get("pr") and entry.get("kind") in plan_ledger.EVIDENCE_KINDS and isinstance(entry.get("ts"), (int, float)):
            by_pr.setdefault(entry["pr"], []).append(entry)
    rows, unmerged = [], 0
    for pr, items in by_pr.items():
        merged = merged_at(pr)
        if merged is None:
            unmerged += 1
            continue
        actors = {}
        for item in items:
            actors[item.get("by") or "?"] = actors.get(item.get("by") or "?", 0) + 1
        first = min(i["ts"] for i in items)
        manual = sum(n for who, n in actors.items() if who != plan_ledger.CI_RECORDER)
        rows.append({"pr": pr, "records": len(items), "by": dict(sorted(actors.items())), "manual_records": manual,
                     "automatic_records": len(items) - manual, "minutes_to_merge": round(max(0.0, merged - first) / 60.0, 1),
                     "merged_at": iso(merged)})
    rows.sort(key=lambda r: r["merged_at"], reverse=True)
    return {"prs": rows[:limit], "unmerged": unmerged}


# ---------------------------------------------------------------- the impact floor (#179, slice L3): advisory, writes NOTHING

IMPACT_REVIEW_REASON = "rating: the independent impact reviewer's action for this head is hold"


def impact_review_hold(state_dir, pr, head):
    """(hold, problem): `hold` is True when the independent impact reviewer's record for EXACTLY this head says `hold` (the L2 `review record
    --impact-action hold`): an input that can only ADD a hold, nothing it says lowers the floor. **Fail mode: toward hold.** When the ledger
    cannot be read or is not trustworthy the rating is UNKNOWN, and an unknown input holds (as an unreadable diff does, and as G1 already
    refuses on a bad ledger): `hold` is True and `problem` says why; the caller audits it (`impact.ledger_unreadable`)."""
    entries, problem = impact_rating_entries(state_dir, pr, head)   # the one filter of the records at this head
    if problem:
        return True, "the ledger could not be read, so the independent rating is unknown: %s" % _one_line(str(problem), 120)
    latest = entries[-1] if entries else None
    return bool(latest and latest.get("impact_action") == "hold"), None


def impact_review_record(state_dir, pr, head):
    """((action, class), problem): the independent impact reviewer's newest record for EXACTLY this head as (impact_action, impact_class) (None when there is
    none), and what is wrong when the ledger cannot be read (the rating is then unknown: the owner decision reads it as a hold). The records come from `impact_rating_entries`, the one filter."""
    entries, problem = impact_rating_entries(state_dir, pr, head)
    if problem:
        return None, problem
    latest = entries[-1] if entries else None
    return ((latest.get("impact_action"), latest.get("impact_class")) if latest else None), None


def rating_block_note(entries, pr, head):
    """#901: the one line `no agent block` when the independent reviewer's records of `pr` at EXACTLY `head` exist and none carries the agent's block (it clears nothing by score), else None. The same
    words as the clear's refusal (`delegated_clear.NO_AGENT_BLOCK`); display only, no decision reads it."""
    try:
        module = load_module("delegated_clear")
        block = module.score_block()
        roles = block["rating_roles"] if block else ["reviewer"]
        mine = [e for e in entries if isinstance(e, dict) and e.get("kind") == "review_record" and e.get("reviewer") == "impact" and e.get("pr") == pr and e.get("head") == head and e.get("by_role") in roles]
        return module.uncounted_line(mine)
    except Exception as err:   # display only, but never silent: the line says the note could not be made
        return "no rating note: the clear module or the matrix could not be read (%s)" % type(err).__name__


RETYPED_FORM_TEXT = "made by the retyped-field form (flags, no verbatim block): record it with `review record --block-file FILE`"


def rating_mismatch_lines(state_dir, pr, head):
    """#1126: one line per impact rating recorded for `pr` (at any head): reviewer, head, recorded severity/probability/action, the block's own, and the first differing field (severity, probability, action, head), `agrees`, or `no block to compare` (a rating with no block never agrees).
    Display only: no verdict reads it. A rating whose head is not `head` says so. Returns [] when there is no ledger or no rating."""
    if state_dir is None:
        return []
    try:
        entries, problem = plan_ledger.read_ledger(state_dir)
    except Exception:
        return []
    if problem:
        return []
    lines = []
    for e in entries:
        if not (isinstance(e, dict) and e.get("kind") == "review_record" and e.get("reviewer") == "impact" and e.get("pr") == pr):
            continue
        has_block = isinstance(e.get("block_sha256"), str) and e.get("block_sha256") != "none"
        rec = [e.get("impact_severity"), e.get("impact_probability"), e.get("impact_action")]
        blk = [e.get("block_impact_severity"), e.get("block_impact_probability"), e.get("block_impact_action")] if has_block else [None, None, None]
        first = None
        if isinstance(head, str) and e.get("head") != head:
            first = "head"
        else:
            for name, r, b in zip(("severity", "probability", "action"), rec, blk):
                if not has_block:
                    break
                if name == "action":   # a block with no action line means no action: `none` agrees, any other recorded action differs
                    r, b = (None if r in (None, "none") else r), (None if b in (None, "none") else b)
                if r != b:
                    first = name
                    break
        shown = lambda v: "none" if v is None else str(v)
        line = "%s %s: recorded %s/%s/%s; block %s; %s" % (
            e.get("reviewer"), str(e.get("head") or "")[:8], shown(rec[0]), shown(rec[1]), shown(rec[2]),
            "%s/%s/%s" % tuple(shown(v) for v in blk) if has_block else "none kept", "no block to compare" if first is None and not has_block else "agrees" if first is None else "differs first at %s" % first)
        if first == "head":
            line += ": the rating's head %s is not the current head %s" % (str(e.get("head") or "")[:8], str(head)[:8])
        if first and first != "head":
            line += " (recorded %s, block %s)" % (shown(rec[("severity", "probability", "action").index(first)]), shown(blk[("severity", "probability", "action").index(first)]))
        if not has_block:
            line += "; " + RETYPED_FORM_TEXT
        lines.append(line)
    return lines


def impact_rating_entries(state_dir, pr, head):
    """([ledger entries], problem): every impact reviewer record of EXACTLY this pull request and head (the delegated clear's score is the highest of those whose recorded role counts: `delegated_clear.judge` decides which).
    A ledger that cannot be read, or whose chain is broken, gives ([], why): the score is then unknown. #835."""
    try:
        entries, problem = plan_ledger.read_ledger(state_dir)
    except Exception as err:
        return [], "%s: %s" % (type(err).__name__, _one_line(str(err), 100))
    if problem:
        return [], _one_line(str(problem), 120)
    return [e for e in entries if e.get("kind") == "review_record" and e.get("reviewer") == "impact" and e.get("pr") == pr and e.get("head") == head], None


def gate_impact_rating(state_dir, pr, head):
    """What the `gates` impact-rating line says (#892), from the engine's own records and rule and nothing computed here: `impact_rating_entries` (the one filter of the independent
    reviewer's records at EXACTLY this head) and `delegated_clear.judge` (the level of the highest record whose recorded role counts, from the matrix cell: the SAME function the delegated
    clear scores with). `plan_ledger.impact_rating_fact` shapes the answer. None when there is no head. A ledger it cannot read is said, never guessed."""
    if not head or state_dir is None:
        return None
    entries, problem = impact_rating_entries(state_dir, pr, head)
    if problem:
        return {"problem": problem}
    try:   # never an exception out of `gates`: what cannot be read is said as unknown
        module = load_module("delegated_clear")
        block = module.score_block()
        cells = impact_floor._matrix_cached()["cells"]
        if not block or not cells:
            return {"problem": "the score rule or the matrix could not be read"}
        level = module.judge(block, cells, entries, {"pr": pr, "head": head, "top_tier_hits": {}}, block["delegable_levels"][0]).get("level") if entries else None
        return plan_ledger.impact_rating_fact(entries, level, block["rating_roles"])
    except Exception as err:
        return {"problem": _one_line("%s: %s" % (type(err).__name__, err), 100)}


def _file_text_at(engine, repo, path, ref):
    """The text of `path` at `ref`: the string, "" is a real empty file, or None when the path does not exist there (a 404). Raises IntentError for any
    other failure (the caller says unreadable and holds)."""
    reader = getattr(engine, "intents", None)
    if reader is None:
        raise IntentError("gh", "no GitHub reader")
    try:
        data = reader._api("repos/%s/contents/%s?ref=%s" % (repo, urllib.parse.quote(path, safe="/"), ref), repo)
    except IntentError as err:
        if err.reason == "not_found":
            return None
        raise
    if not isinstance(data, dict) or data.get("type") not in (None, "file") or data.get("encoding") != "base64" or not isinstance(data.get("content"), str):
        raise IntentError("gh", "%s is not a readable file at %s" % (path, str(ref)[:8]))
    try:
        return base64.b64decode(data["content"]).decode("utf-8")
    except (ValueError, UnicodeError):
        raise IntentError("gh", "%s is not text at %s" % (path, str(ref)[:8])) from None


def agent_block_states(engine, repo, matrix, paths, base, head):
    """#451 slice 2: {path: "unchanged"|"changed"|"added"|"removed"|"unreadable"} for the changed paths the matrix file judges by content (an agent
    definition: only its permission block counts). Two reads for each (its base and its head) and none when there is no such path or more than the matrix
    file allows (the decision holds those unread). A read that fails is "unreadable", never "unchanged"."""
    narrowed, limit = impact_floor.narrow_paths(matrix, paths)
    if not narrowed or len(narrowed) > limit:
        return {}
    keys = impact_floor.narrow_rule(matrix)[1]
    states = {}
    for path in narrowed:
        try:
            if not base or not head:
                raise IntentError("gh", "the base or head commit is unknown")
            before, after = _file_text_at(engine, repo, path, base), _file_text_at(engine, repo, path, head)
        except IntentError:
            states[path] = "unreadable"
            continue
        if before is None and after is None:
            states[path] = "unreadable"
        elif before is None:
            states[path] = "added"
        elif after is None:
            states[path] = "removed"
        else:
            states[path] = impact_floor.block_state(before, after, keys)
    return states


def pr_floor_report(engine, repo, number, rated_pairs=()):
    """Read one PR's files and decide: {"pr", "head", "floor_paths", "complete", "rated", "decision", "reasons", "globs"}. Reads only (one
    `gh pr view`). `rated_pairs` is the independent rating's (severity, probability) list, an input that can only ADD a hold."""
    raw = read_pr_json(engine, repo, number, "files,baseRefOid")
    files = [f for f in (raw.get("files") if isinstance(raw.get("files"), list) else []) if isinstance(f, dict)]
    globs, exclude, force = impact_floor.floor_for(repo, engine.config)
    paths, renamed = [], []
    for item in files:
        paths.append(item.get("path"))
        old = item.get("previous_filename") or item.get("previousFilename") or item.get("oldPath")
        if isinstance(old, str) and old:
            paths.append(old)   # a rename or copy out of a floor path counts through its OLD path
        elif str(item.get("changeType") or "").upper() in ("RENAMED", "COPIED"):
            renamed.append(item.get("path"))   # `gh pr view` does not say where it came from
    total = raw.get("changedFiles") if isinstance(raw.get("changedFiles"), int) else len(files)
    complete = len(files) >= total and not raw.get("truncated")
    hit = impact_floor.floor_paths(paths, globs, exclude, force)
    unknown = None
    if globs and not complete:
        unknown = "GitHub listed %d of %d changed files" % (len(files), total)
    elif globs and renamed:
        unknown = "%d renamed or copied file(s) with no known source path (%s)" % (len(renamed), ", ".join(renamed[:3]))
    matrix = impact_floor.load_matrix()
    rated = impact_floor.rate(matrix, list(rated_pairs))
    decision, reasons = impact_floor.decide(hit, rated, unknown)
    head = raw.get("headRefOid")
    narrow = agent_block_states(engine, repo, matrix, paths, raw.get("baseRefOid"), head)
    record, record_problem = (impact_review_record(engine.state_dir, "%s#%d" % (repo, number), head) if engine.state_dir is not None and isinstance(head, str) else (None, None))
    if record_problem:
        record = ("hold", None)   # an unreadable ledger is an unknown rating: it holds
    owner = impact_floor.owner_decide(matrix, paths, [(sev, prob, None) for sev, prob in rated_pairs], unknown, hit, narrow, record)
    if record_problem:
        owner = (owner[0], owner[1] + ["the ledger could not be read, so the independent rating is unknown: %s" % _one_line(str(record_problem), 120)])   # advisory (#451): which tier the owner-hold rule puts it in; the labels still follow `decision` until the re-judge slice
    if engine.state_dir is not None and isinstance(head, str):
        review, problem = impact_review_hold(engine.state_dir, "%s#%d" % (repo, number), head)
        if problem:
            if engine.audit is not None:
                engine._note("impact.ledger_unreadable", "%s#%d" % (repo, number), {"why": problem, "fails": "toward hold"})
            reasons = reasons + [problem]
        elif review:
            reasons = reasons + [IMPACT_REVIEW_REASON]
        if review:
            decision = "hold"
    rating_entries = impact_rating_entries(engine.state_dir, "%s#%d" % (repo, number), head)[0] if engine.state_dir is not None and isinstance(head, str) else []
    return {"pr": "%s#%d" % (repo, number), "head": raw.get("headRefOid"), "globs": globs, "exclude": exclude, "rating_block": rating_block_note(rating_entries, "%s#%d" % (repo, number), head), "rating_lines": rating_mismatch_lines(engine.state_dir, "%s#%d" % (repo, number), head),
            "floor_paths": hit, "files_read": len(files), "files_total": total, "renamed_no_source": renamed[:20], "complete": complete,
            "top_tier_hits": impact_floor.top_tier_hits(paths, matrix), "review_action": record[0] if record else None, "review_class": record[1] if record else None,   # #661: display data the delegated clear reads; no decision changes
            "changed_paths": [p for p in paths if isinstance(p, str)][:200], "unknown": unknown, "rated": [list(r) for r in rated],
            "decision": decision, "reasons": reasons, "owner_decision": owner[0], "owner_reasons": owner[1], "draft": raw.get("isDraft") is True,
            "base": raw.get("baseRefOid")}


def cmd_impact(args, runner, now):
    """`impact floor|hold|clear`."""
    return {"floor": cmd_impact_floor, "hold": cmd_impact_hold, "clear": cmd_impact_clear, "delegated": cmd_impact_delegated, "matrix": cmd_impact_matrix}[args.impact_action](args, runner, now)


cmd_impact.direct = True   # no error mapping, no daemon start


IMPACT_MATRIX_PATHS_MAX = 50   # paths printed per floor rule by `impact matrix --for-rater`
IMPACT_MATRIX_PATH_LEN = 200


def _printable_path(path):
    """A changed file's path as safe display text: control characters (an escape sequence in a file name) become `?`, and it is cut at IMPACT_MATRIX_PATH_LEN. The reader of `impact matrix --for-rater` is a rater agent or a person's terminal."""
    text = "".join(c if c.isprintable() else "?" for c in str(path))
    return text if len(text) <= IMPACT_MATRIX_PATH_LEN else text[:IMPACT_MATRIX_PATH_LEN - 1] + "\u2026"


def impact_matrix_words(for_rater=None):
    """{"severities", "probabilities", "cells": {severity: {probability: {"level", "action"}}}, "floor_rules": {rule id: class}, "for_rater": the pull request's floor hits or None}: the kit's matrix file's own words
    (the same loader the clear reads), so a rater in a repository with no review laws gets them from the file and never retypes them. #901."""
    matrix = impact_floor.load_matrix()
    score = ((matrix.get("owner_hold") or {}).get("delegated_clear") or {}).get("score") or {}
    return {"severities": list(matrix["severities"]), "probabilities": list(matrix["probabilities"]), "not_rated": list(matrix.get("not_rated") or []),
            "cells": {s: {p: dict(c) for p, c in row.items()} for s, row in matrix["cells"].items()},
            "floor_rules": dict((score.get("floor") or {}).get("rules") or {}), "lowest_floor_level": (score.get("floor") or {}).get("lowest_level"), "for_rater": for_rater}


def impact_matrix_lines(words):
    """The text `impact matrix` prints, as lines (also written into a review checkout, #1047, so a reviewer subagent in its own worktree can read the matrix without a command)."""
    for_rater = words.get("for_rater")
    out = ["impact matrix (the kit's matrix file; read-only)", "severities: %s" % ", ".join(words["severities"]), "probabilities: %s" % ", ".join(words["probabilities"])]
    for severity in words["severities"]:
        for probability, cell in words["cells"][severity].items():
            out.append("cell %s / %s: level %s, action %s" % (severity, probability, cell["level"], cell["action"]))
    for rule_id, cls in sorted(words["floor_rules"].items()):
        out.append("floor rule %s: class %s" % (rule_id, cls))
    if for_rater is not None:
        out.append("floor report for %s at %s: %s" % (for_rater["pr"], (for_rater["head"] or "unknown head")[:8], "complete" if for_rater["complete"] else "INCOMPLETE file list"))
        for rule_id, paths in for_rater["floor_hits"].items():
            out.append("floor hit %s: %s" % (rule_id, ", ".join(paths)))
        if not for_rater["floor_hits"]:
            out.append("floor hit: none")
    return out


def cmd_impact_matrix(args, runner, now):
    """`impact matrix [--for-rater <pr>] [--json]`: print the matrix file's severities, probabilities, cells (level and action) and floor rule ids; with `--for-rater` also that pull request's floor report
    (each floor rule id the changed paths hit, and the paths): the SAME `pr_floor_report` `impact floor` prints. Read-only: no ledger, state or audit write. Works with no review laws in the repository."""
    try:
        for_rater = None
        if args.for_rater:
            engine, _, _ = build_engine(runner, now, "cli", writable=False)
            repo, number = parse_pr_ref(args.for_rater)
            report = pr_floor_report(engine, repo, number)
            rules = impact_matrix_words()["floor_rules"]
            hits = report.get("top_tier_hits") or {}
            for_rater = {"pr": report["pr"], "head": report["head"], "complete": report.get("complete"),
                         "floor_hits": {rule_id: [_printable_path(p) for p in sorted(hits.get(cls) or [])[:IMPACT_MATRIX_PATHS_MAX]] for rule_id, cls in sorted(rules.items()) if hits.get(cls)},
                         "owner_decision": report.get("owner_decision")}
        words = impact_matrix_words(for_rater)
    except (impact_floor.MatrixError, NoticeError, ValueError) as err:
        sys.stderr.write("%s: impact matrix: %s\n" % (PROG, _one_line(str(err), 300)))
        return EXIT_USAGE
    if args.json:
        print(json.dumps(words, sort_keys=True))
        return EXIT_OK
    print("\n".join(impact_matrix_lines(words)))
    return EXIT_OK


cmd_impact_matrix.direct = True


def cmd_impact_floor(args, runner, now):
    """`impact floor <repo#N> [--rating SEVERITY/PROBABILITY ...] [--json]`: what the deterministic floor (and an independent rating, if
    given) would decide for a PR. Read-only: it writes no label, no comment and no audit line."""
    engine, _, _ = build_engine(runner, now, "cli", writable=False)
    try:
        repo, number = parse_pr_ref(args.pr)
    except NoticeError as err:
        sys.stderr.write("%s: impact floor: %s\n" % (PROG, err))
        return EXIT_USAGE
    pairs = []
    for item in args.rating or []:
        severity, _, probability = item.partition("/")
        pairs.append((severity.strip().capitalize(), probability.strip().capitalize()))
    try:
        matrix = impact_floor.load_matrix()
        for severity, probability in pairs:
            if severity not in matrix["severities"] or probability not in matrix["probabilities"] + matrix["not_rated"]:
                raise ValueError("--rating SEVERITY/PROBABILITY: severity is one of %s, probability one of %s (got %s/%s)" % (
                    ", ".join(matrix["severities"]), ", ".join(matrix["probabilities"] + matrix["not_rated"]), severity, probability))
        report = pr_floor_report(engine, repo, number, pairs)
    except impact_floor.MatrixError as err:   # the rule file cannot be read: it is HELD ON PURPOSE (never read as "no floor"), said in words and in json; nothing was judged and nothing is written
        why = _one_line(str(err), 200)
        if args.json:
            print(json.dumps({"pr": "%s#%d" % (repo, number), "head": None, "decision": "hold", "owner_decision": "hold", "reasons": [], "owner_reasons": ["held on purpose: the rule file cannot be read: %s" % why],
                              "unknown": "the rule file cannot be read", "floor_paths": [], "globs": []}, sort_keys=True))
        else:
            print("impact floor for %s: HELD ON PURPOSE (advisory: nothing is written)" % ("%s#%d" % (repo, number)))
            print("  held on purpose: the rule file cannot be read, so nothing was judged and no change may be read as not held: %s" % why)
        return EXIT_OK
    except (NoticeError, ValueError) as err:
        sys.stderr.write("%s: impact floor: %s\n" % (PROG, _one_line(str(err), 300)))
        return EXIT_USAGE
    if args.json:
        print(json.dumps(report, sort_keys=True))   # the report as the daemon's pass reads it: `owner_decision` and `owner_reasons` next to the path-floor fields
    else:
        owner = report.get("owner_decision")
        words = {"hold": "HOLD for the owner", "second-review": "not held for the owner: a second independent review", "none": "not held"}.get(owner, "HELD ON PURPOSE (unknown decision %r)" % (owner,))
        read, total = report.get("files_read"), report.get("files_total")
        counted = "%s file%s read" % (read, "" if read == 1 else "s") if isinstance(read, int) else "files read unknown"
        cut = report.get("complete") is False
        blind = report.get("renamed_no_source") or []   # renamed or copied files whose source path the list does not carry: a top tier path could be the source
        stamp = "(advisory: nothing is written)"
        if cut and owner != "hold":   # the daemon's own answer for a list it could not read in full is printed as it is, and said to be no verdict: a cut list never reads as "not held"
            print("impact floor for %s at %s: CANNOT TELL: only %s of %s files were read (the daemon's decision for the files it read: %s) %s" % (
                report["pr"], (report["head"] or "unknown head")[:8], read, total, words, stamp))
        elif blind and owner != "hold":
            print("impact floor for %s at %s: CANNOT TELL: %d renamed or copied file(s) with no source path (the daemon's decision for the paths it saw: %s), %s %s" % (
                report["pr"], (report["head"] or "unknown head")[:8], len(blind), words, counted, stamp))
        else:
            print("impact floor for %s at %s: %s, %s %s" % (report["pr"], (report["head"] or "unknown head")[:8], words, counted, stamp))
        for reason in report.get("owner_reasons") or []:
            print("  %s: %s" % ("why" if owner == "hold" else "because", reason))
        if report.get("rating_block"):
            print("  rating: %s" % report["rating_block"])
        for line in report.get("rating_lines") or []:
            print("  rating considered: %s" % line)
        if owner == "none" and not report.get("owner_reasons") and not cut and not blind:
            print("  because: no changed path is a top tier path of the matrix, and no independent review or rating holds it")
        if cut and owner != "hold":
            print("  incomplete: GitHub gave %s of %s changed files, so a path outside those may be a top tier path; this is not a verdict of \"not held\"" % (read, total))
        if blind and owner != "hold":
            print("  rename: the source path of %s was not seen, and it may have been a top tier path; this is not a verdict of \"not held\"" % ", ".join(blind[:3]))
        print("  path floor (older advisory, not the owner's rule): %s" % report["decision"].upper().replace("-", " "))
        for reason in report["reasons"]:
            print("  %s" % reason)
        for path in report["floor_paths"]:
            print("  floor path: %s" % path)
        if not report["globs"]:
            print("  this repo names no floor globs (set impact_floor.repos in config.json)")
        if report.get("unknown"):
            print("  unknown floor, held on purpose: %s" % report["unknown"])
    return EXIT_OK


IMPACT_PASS_CALLS = 6        # `gh pr view` calls the daemon pass may spend per pass
IMPACT_RETRY_SECONDS = 300   # a PR whose floor could not be read is retried after this
CLEAR_LINE_PASS_MAX = 2      # held pull requests whose "who can clear this" line one pass reads and may post (#946)
CLEAR_LINE_PAGES = 10        # pages of 100 comments read to find the line already posted
CLEAR_LINE_MARKER = re.compile(r"<!-- fleet-switchboard:clear-line head=([0-9a-f]{12}) hash=([0-9a-f]{12}) -->")


IMPACT_STATE_FILE = "impact-hold.json"   # {"clears": {pr: {head, reason, by, at[, fingerprint]}}, "applied": {pr: {head, merge_label_added}}, "carried": {pr: {head, from, fingerprint, at}}, "carry_void": {pr: {head, reason}}}


IMPACT_STATE_MAX_BYTES = 1000000
IMPACT_LOCK_FILE = "impact-hold.lock"
IMPACT_LOCK_SECONDS = 30


class ImpactStateBusy(RuntimeError):
    """The impact state lock could not be taken in time: nothing was done, try again."""


class impact_state_lock:
    """ONE exclusive lock around everything that reads the impact state and acts on it: the daemon's `clear check -> label write -> applied record`
    and the owner's `clear record -> label removal` cannot interleave, so a clear is never lost and a cleared hold is never re-added.
    Waits up to IMPACT_LOCK_SECONDS, then raises (a write that cannot take the lock is retried later, never done unlocked)."""

    def __init__(self, state_dir, seconds=None):
        self.path, self.seconds = Path(state_dir) / IMPACT_LOCK_FILE, IMPACT_LOCK_SECONDS if seconds is None else seconds
        self.fd = None

    def __enter__(self):
        self.fd = os.open(str(self.path), os.O_RDWR | os.O_CREAT, 0o600)
        deadline = time.monotonic() + self.seconds
        while True:
            try:
                fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return self
            except OSError:
                if time.monotonic() >= deadline:
                    os.close(self.fd)
                    self.fd = None
                    raise ImpactStateBusy("the impact state is locked by another process (waited %s s)" % self.seconds) from None
                time.sleep(0.05)

    def __exit__(self, *exc):
        if self.fd is not None:
            os.close(self.fd)
            self.fd = None
        return False


AGENT_LOCK_SECONDS = 10   # how long a second reattach of the same agent waits for the first (keep it above PANE_SETTLE_SECONDS)


class agent_lock(impact_state_lock):
    """One flock per agent name: two concurrent reattaches of the same agent cannot both open or close a tab."""

    def __init__(self, state_dir, name, seconds=None):
        super().__init__(state_dir, AGENT_LOCK_SECONDS if seconds is None else seconds)
        self.path = Path(state_dir) / ("reattach-%s.lock" % re.sub(r"[^a-z0-9_-]", "_", (name or "").lower()))


CARRY_ANSWER_MAX = 8 * 1024 * 1024   # bytes of one GitHub answer the carry will parse; more voids the carry


def impact_carry_get(engine, runner, repo):
    """The `get(path)` the carry reads GitHub through: `gh api` GET with the repo's own account, parsed. Raises on any failure (the carry then voids)."""
    def get(path):
        done = _gh_write(engine, runner, repo, path, "GET")
        if len(done.stdout or "") > CARRY_ANSWER_MAX:
            raise ValueError("GitHub's answer is over %d bytes" % CARRY_ANSWER_MAX)
        return json.loads(done.stdout or "null")
    return get


CLEAR_NOTIFIED_FILE = "clear-notified.json"
CLEAR_NOTIFIED_MAX = 400
CLEAR_PENDING_FILE = "clear-notice-pending.json"   # #827: the notices of owner clears not yet delivered to everyone they are for
CLEAR_PENDING_MAX = 100
CLEAR_PENDING_BODY_MAX = 4000   # the pull request body as far as the lane lookup needs it (its PLAN line)
CLEAR_NOTICE_KINDS = ("clear", "carry")   # THE one table of notice kinds: the record, the delivery and the pass accept these and no other; a test derives the callers from the code and fails on a kind missing here
CLEAR_NOTICE_BACKOFF = (60, 120, 300, 900, 1800, 3600)   # seconds before the next try of a failed notice or reminder, by the number of tries made (the last step repeats): a lane that is down for a while still gets it
CLEAR_NOTICE_MAX_AGE_SECONDS = 86400   # a notice or a reminder is given up (audited) only after this long: the budget is time, never a count of fast tries
CLEAR_NOTICE_CLAIM_SECONDS = 90   # a delivery in flight is not started again within this (longer than a send is allowed to take)
CLEAR_NOTICE_PASS_MAX = 3       # deliveries one daemon pass makes
CLEAR_REMINDED_FILE = "clear-reminded.json"   # #827: the heads whose "cleared, merge it" reminder is done
_PLAN_ISSUE_RE = re.compile(r"github\.com/([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)/(?:issues|pull)/([0-9]+)")


_PLAN_REF_SHORT = re.compile(r"^([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)#([0-9]+)$")


NOTIFY_CLEAR_DEADLINE_SECONDS = 2.0   # the most a clear waits for its notice


IMPACT_POSTED_KEEP = 5   # versions of the rule whose posted list is remembered
IMPACT_LIST_MAX = 40     # pull requests named in a posted list


def impact_records(state_dir):
    """({(pr, head): (impact_action, impact_class)}, problem): the independent impact reviewer's newest record per pull request and head, read once. A ledger
    that cannot be read gives ({}, why): the rating is then unknown and nothing is released on it."""
    try:
        entries, problem = plan_ledger.read_ledger(state_dir)
    except Exception as err:
        return {}, "%s: %s" % (type(err).__name__, _one_line(str(err), 100))
    if problem:
        return {}, _one_line(str(problem), 120)
    found = {}
    for entry in entries:
        if entry.get("kind") == "review_record" and entry.get("reviewer") == "impact":
            found[(entry.get("pr"), entry.get("head"))] = (entry.get("impact_action"), entry.get("impact_class"))
    return found, None


def impact_carry_marks(state_dir):
    """({(pr, head): n}, problem): how many reviewer records at each pull request and head carry a confirmation for a conflict-resolving carry (#815). Read with the ledger, whole or not at
    all; it only decides when the carry is tried again, never whether it holds (the carry reads the ledger itself)."""
    try:
        entries, problem = plan_ledger.read_ledger(state_dir)
    except Exception as err:
        return {}, "%s: %s" % (type(err).__name__, _one_line(str(err), 100))
    if problem:
        return {}, _one_line(str(problem), 120)
    found = {}
    for entry in entries:
        if entry.get("kind") == "review_record" and entry.get("carry_confirmed") is True:
            found[(entry.get("pr"), entry.get("head"))] = found.get((entry.get("pr"), entry.get("head")), 0) + 1
    return found, None


def _impact_rehold_now(engine, repo, number, pr, report, record):
    """(#830) True when this judged pull request is HELD AGAIN at its head (a clear recorded for another head, none for this one, no rating here) and the hold was applied (or already
    stands). Only on a whole read: an unreadable state or ledger returns False and changes nothing here (the caller then releases nothing either: `records_problem`). Raises on a failed
    write, like the hold branch, so the caller backs off."""
    state, problem = read_impact_state(engine.state_dir)
    if problem or not report.get("head"):
        return False
    if rating_at(engine, pr, report["head"])[1]:
        return False   # the ledger cannot be read: no change here, and the caller releases nothing either
    why = rehold_reason(engine, state, repo, pr, report["head"])
    if not why:
        return False
    apply_impact_hold(engine, repo, number, dict(report, reasons=[why], rehold=why, owner_decision="hold"), record)
    return True


def _impact_rehold_try(engine, repo, number, pr, report, record, now, seen):
    """(#830) `_impact_rehold_now` for the pass: a failed write is said (`impact.error`), the retry time is set like the hold branch's, and "failed" is returned (it IS held again, so the
    caller never releases it); True when the hold stands or was written, False when it is not held again."""
    try:
        return _impact_rehold_now(engine, repo, number, pr, report, record)
    except Exception as err:
        seen[(repo, number, "retry")] = now + IMPACT_RETRY_SECONDS
        engine._note("impact.error", pr, {"error": _one_line(str(err), 160), "write": True})
        return "failed"


def _impact_cos(engine):
    discovery = getattr(engine, "discovery", None)
    agents = getattr(discovery, "agents", None) or {}
    return next((n for n, o in sorted(agents.items()) if (getattr(o, "fleet", None) or {}).get("role") == "chief-of-staff"), None)


def _impact_matrix_episode(engine, now, err):
    """The matrix file cannot be read (#451 slice 3, PC-4): no label is added or removed (the caller returns), ONE `impact.error` and ONE wake of the Chief of
    Staff for the episode, kept in impact-hold.json so a restart does not say it again; the episode ends when the file reads (`impact.recovered`)."""
    try:
        with impact_state_lock(engine.state_dir):
            state, problem = read_impact_state(engine.state_dir)
            if problem:
                _impact_state_noted(engine, problem)
            episode = state.get("matrix_error") if isinstance(state.get("matrix_error"), dict) else {}
            changed = False
            if not episode.get("noted"):
                engine.audit.append(engine.actor, "impact.error", "matrix", {"error": _one_line(str(err), 160), "floor": "unreadable"})   # once for the episode (kept in the state file)
                episode.update(noted=True, since=int(now))
                changed = True
            if not episode.get("woken"):
                cos = _impact_cos(engine)
                if cos:
                    add_reminder(engine.state_dir, cos, now, now, "The impact matrix file cannot be read: no hold is added or removed until it reads again, and the "
                                 "merge gate waits for every pull request it cannot judge (%s)." % _one_line(str(err), 120))
                    engine.audit.append(engine.actor, "impact.error_wake", cos, {"error": _one_line(str(err), 160)})
                    episode["woken"] = True
                    changed = True
            if changed:
                state["matrix_error"] = episode
                write_impact_state(engine.state_dir, state)
    except Exception as failure:   # the pass never raises: a failed note is tried again next pass
        sys.stderr.write("%s: impact: %s\n" % (PROG, _one_line(str(failure), 160)))


def _impact_matrix_recovered(engine, now):
    """The matrix file reads again: a standing episode ends (audited) so the next failure is a new one."""
    try:
        state, problem = read_impact_state(engine.state_dir)
        if problem or not state.get("matrix_error"):
            return
        with impact_state_lock(engine.state_dir):
            state, problem = read_impact_state(engine.state_dir)
            if problem or not state.get("matrix_error"):
                return
            since = state["matrix_error"].get("since")
            state["matrix_error"] = {}
            write_impact_state(engine.state_dir, state)
            engine.audit.append(engine.actor, "impact.recovered", "matrix", {"since": since})
    except Exception as failure:
        sys.stderr.write("%s: impact: %s\n" % (PROG, _one_line(str(failure), 160)))


def _impact_post_list(engine, now, rule, held, released, second):
    """One audit line and one note to the Chief of Staff for this version of the rule: the pull requests that stay held, those released and those that now
    ask for a second review. Remembered in impact-hold.json (`posted`) so a restart does not post it again."""
    try:
        with impact_state_lock(engine.state_dir):
            state, problem = read_impact_state(engine.state_dir)
            posted = state.setdefault("posted", {})
            if problem or rule in posted:
                return
            cos = _impact_cos(engine)
            text = ("The owner-hold rule (version %s) was applied to the waiting pull requests. Still held for the owner (%d): %s. Released (%d): %s. "
                    "Second review only (%d): %s." % (rule, len(held), ", ".join(held[:IMPACT_LIST_MAX]) or "none", len(released),
                                                      ", ".join(released[:IMPACT_LIST_MAX]) or "none", len(second), ", ".join(second[:IMPACT_LIST_MAX]) or "none"))
            engine.audit.append(engine.actor, "impact.rejudged", "rule:%s" % rule, {"held": held[:IMPACT_LIST_MAX], "released": released[:IMPACT_LIST_MAX],
                                                                                      "second_review": second[:IMPACT_LIST_MAX]})
            if cos:
                add_reminder(engine.state_dir, cos, now, now, text)
            posted[rule] = int(now)
            for old in sorted(posted, key=lambda k: posted[k])[:-IMPACT_POSTED_KEEP]:
                del posted[old]
            write_impact_state(engine.state_dir, state)
    except Exception as failure:
        sys.stderr.write("%s: impact: %s\n" % (PROG, _one_line(str(failure), 160)))


CHAT_CLEAR_NEW_PER_PASS = 3   # the owner's new messages judged in one pass (one Jev call each): the rest wait for the next pass


def chat_clear_config(config):
    """{"enabled", "live"} of the owner's `chat_clear` key. On by default but in SHADOW: `live` is true only when the owner's own config says `"live": true`. This build never sets it."""
    raw = config.get("chat_clear") if isinstance(config, dict) else None
    raw = raw if isinstance(raw, dict) else {}
    return {"enabled": raw.get("enabled") is not False, "live": raw.get("live") is True}


CHAT_CLEAR_OFF_FILE = "chat-clear.off"   # the owner's panic stop: its mere presence in the state directory forces SHADOW, checked every pass


def chat_clear_live_now(engine):
    """(live, why): may the hook WRITE on this pass? Only when ALL hold, judged afresh every pass: the config this daemon runs on says `live` (a real true), the kill file
    `chat-clear.off` is not in the state directory, and the CURRENT config file, read now, is valid and also says `live` and not `enabled: false`. The daemon keeps its last good
    config when a reload fails, so an invalid or half-edited file would otherwise leave the owner's `live` on: here it means SHADOW at once. `why` is None when live or when
    shadow is simply the configured mode, else a short reason."""
    if not chat_clear_config(engine.config)["live"]:
        return False, None
    if getattr(engine, "light", False):   # #977: under v2_light the chat clear is SHADOW even with `live: true` (the owner's key AND light off, as before the light read existed)
        return False, "v2_light"
    if os.path.lexists(str(Path(engine.state_dir) / CHAT_CLEAR_OFF_FILE)):   # ANY entry, even a dangling symlink, is the panic stop
        return False, "kill file"
    try:
        current = chat_clear_config(load_runnable_config())
    except Exception as err:   # an invalid, unreadable or missing config file: never live on a file that cannot be read
        return False, "config invalid: %s" % _one_line(str(err), 120)
    if not (current["live"] and current["enabled"]):
        return False, "config says shadow"
    return True, None


def chat_clear_holds(decisions, names):
    """The holds the owner is shown, read from the SAME decisions the Decisions list is made of: [{"pr", "head", "labels", "summary"}] for every `captain` row that names its head,
    with the owner-tier labels that row stands for (the captain label, and one `hold-*` label for each hold reason it lists). A reason this build cannot name drops the PR."""
    holds = []
    for d in decisions or []:
        if not isinstance(d, dict) or d.get("kind") != "captain":
            continue
        repo, number, head = d.get("repo"), d.get("number"), d.get("head")
        if not (isinstance(repo, str) and isinstance(number, int) and not isinstance(number, bool) and isinstance(head, str) and head):
            continue
        reasons = [h for h in (d.get("holds") or []) if isinstance(h, str)]
        if any("hold-%s" % h not in names for h in reasons):
            continue
        holds.append({"pr": "%s#%d" % (repo, number), "head": head, "labels": [names["merge-captain"]] + [names["hold-%s" % h] for h in reasons],
                      "summary": d.get("review_evidence") or d.get("headline") or d.get("title") or ""})
    return holds


def chat_clear_pass(engine, decisions, now):
    """THE daemon hook of #457, called once at the end of a pass with the decisions the Decisions list is made of. Records the offers (the owner-tier holds at the heads shown), and
    only when there is at least one reads the owner's NEW messages in the Chief of Staff's session (one read, inside v2_light and the call budget), judges each once (one Jev call) and,
    in LIVE mode only (`chat_clear.live`), clears or asks once. In SHADOW (the default) it logs what it would do and writes nothing to GitHub and sends nothing. Never raises.
    No command, verb or agent reaches it: only `publish_decisions` calls it, and only the daemon runs that."""
    try:
        _chat_clear_pass(engine, decisions, now)
    except Exception as err:
        engine._note("chat_clear.error", None, {"error": _one_line("%s: %s" % (type(err).__name__, err), 200)})


CHAT_CLEAR_LIGHT_LIMIT = 10        # v2_light: the newest user messages of the Chief of Staff's session read in one pass (the page is one `session.message.list` call)
CHAT_CLEAR_LIGHT_BYTES = 65536     # v2_light: a page bigger than this (as JSON) is read for nothing: the bound is ~7x the measured page (8940 bytes for 10 records)


def chat_clear_prompts(engine, session_id, now):
    """The owner's prompts the chat clear judges, newest first. Not under v2_light: as before (`newest_prompts`). UNDER v2_light this is the ONE allowed read of session
    history besides the write-gate's: ONE `session.message.list` of the newest CHAT_CLEAR_LIGHT_LIMIT user messages of THIS session (the Chief of Staff's), no inbox, no
    second page, no other session; fleet-sent records are dropped here and `persons_text` decides again. A page over CHAT_CLEAR_LIGHT_BYTES, or a read that fails, gives
    None and an audit line saying why (once per change, not once per pass; the byte bound is applied AFTER the read, the call itself is capped by its limit): nothing is judged and nothing is marked seen. Never raises."""
    if not getattr(engine, "light", False):
        return newest_prompts(engine, session_id)
    try:
        page = engine.v2.message_list(session_id, limit=CHAT_CLEAR_LIGHT_LIMIT, type="user")
    except Exception as err:
        engine._note("chat_clear.read_refused", "chat_clear", {"why": "the read failed: %s" % _one_line(str(err), 160)})
        return None
    page = page if isinstance(page, list) else []
    size = len(json.dumps(page, separators=(",", ":"), default=str))
    if size > CHAT_CLEAR_LIGHT_BYTES:
        engine._note("chat_clear.read_refused", "chat_clear", {"why": "the page was %d bytes, over the bound of %d: nothing is judged" % (size, CHAT_CLEAR_LIGHT_BYTES),
                                                                                    "bytes": size, "bound": CHAT_CLEAR_LIGHT_BYTES})
        return None
    engine._note("chat_clear.read", "chat_clear", {"records": len(page), "bytes": size, "light": True})
    return [m for m in page if isinstance(m, dict) and _fleet_meta(m) is None]


def _chat_clear_pass(engine, decisions, now):
    cfg = chat_clear_config(engine.config)
    if not cfg["enabled"] or engine.actor != "daemon" or engine.state_dir is None or engine.audit is None or engine.jev is None:
        return
    live, why = chat_clear_live_now(engine)
    cfg = dict(cfg, live=live)
    mode = "live" if live else ("shadow (%s)" % why if why else "shadow")
    if engine.__dict__.get("chat_clear_mode") != mode:   # said once per change, loudly: the owner's switch took (or stopped taking) effect
        previous = engine.__dict__.get("chat_clear_mode")
        engine.__dict__["chat_clear_mode"] = mode
        if previous is not None or why:
            engine.audit.append(engine.actor, "chat_clear.mode", "chat_clear", {"mode": mode, "was": previous, "why": why})
    if whole_skipped(engine, "chat_clear.offers", "notices"):
        return   # #805: a held PR whose notice was not read is absent from the holds: its offer (the head the person was shown) must not be forgotten and re-recorded
    cc = load_module("chat_clear")
    names = label_names(engine.config)
    holds = chat_clear_holds(decisions, names)
    refreshed = cc.refresh_offers(engine.state_dir, holds, names, now)
    if refreshed["added"] or refreshed["dropped"] or refreshed["problem"] or refreshed["damaged"]:
        engine.audit.append(engine.actor, "chat_clear.offers", "chat_clear", {"added": refreshed["added"][:20], "dropped": refreshed["dropped"][:20],
                                                                              "problem": refreshed["problem"], "damaged": refreshed["damaged"][:20]})
    offers = refreshed["offers"]
    if not offers:
        return   # nothing is held for the owner: no read of his messages, no Jev call
    discovery = getattr(engine, "discovery", None)
    cos = next((o for o in (discovery.agents.values() if discovery is not None else []) if (o.fleet or {}).get("role") == "chief-of-staff" and not o.problem and o.session_id), None)
    if cos is None:
        return
    prompts = chat_clear_prompts(engine, cos.session_id, now)
    if prompts is None:
        return   # refused (see `chat_clear.read_refused`): nothing was read, nothing is marked seen
    messages = cc.person_messages(prompts, cc.read_seen(engine.state_dir), now, _created)
    current_heads = {h["pr"]: h["head"] for h in holds}
    bar = (engine.config.get("jev") or {}).get("min_confidence", cc.HIGH_CONFIDENCE)
    for message in messages[:CHAT_CLEAR_NEW_PER_PASS]:
        cc.mark_seen(engine.state_dir, message["id"], now)   # BEFORE anything is done: one attempt per message, whatever happens
        offers = cc.read_offers(engine.state_dir)
        if not offers:
            engine.audit.append(engine.actor, "chat_clear.dropped", "chat_clear", {"message_id": message["id"], "why": "the offers went away before the message was judged"})
            return
        verdict = cc.decide(engine.jev, message["text"], offers, message["created"], now, bar)
        live_now, shadow_why = chat_clear_live_now(engine)   # AGAIN, right before acting: a kill file or a broken config that appears during this pass stops the very next message
        _chat_clear_act(engine, cc, dict(cfg, live=live_now, shadow=shadow_why), message, verdict, offers, current_heads, now)


def _chat_clear_act(engine, cc, cfg, message, verdict, offers, current_heads, now):
    live, quoted = cfg["live"], cc.quote(message["text"])
    action, pr, why = verdict["action"], verdict.get("pr"), verdict.get("why")
    judge = verdict.get("judge") or {}
    if action == "clear" and not cc.head_matches(offers.get(pr), current_heads.get(pr)):
        # the head moved since he was shown it (or the offer was never shown): never a clear. The question shows the new head.
        action, why = "ask", "head_changed"
        verdict = dict(verdict, question=cc.question_text("head_changed", offers, [pr], current_heads), shown=[pr])
    detail = {"message_id": message["id"], "quote": quoted, "action": action, "why": why, "pr": pr, "live": live, "would_clear": action == "clear",
              "probabilities": judge.get("probabilities"), "jev_choice": judge.get("jev_choice"), "model": judge.get("model"), "reason": judge.get("reason"),
              "screen": (verdict.get("screen") or {}).get("why"), "shadow": None if live else cfg.get("shadow")}
    engine.audit.append(engine.actor, "chat_clear.verdict", pr or "chat_clear", detail)
    if action == "none" or not live:
        return   # shadow: the verdict is logged and nothing else happens
    if action == "clear":
        try:
            chat_clear_apply(engine, cc, pr, offers[pr], quoted, message["id"], now)
        except Exception as err:   # the clear failed or was refused at the point of effect: one question, nothing more
            engine.audit.append(engine.actor, "chat_clear.failed", pr, {"message_id": message["id"], "error": _one_line("%s: %s" % (type(err).__name__, err), 200)})
            verdict = dict(verdict, question=cc.question_text("failed" if not isinstance(err, NoticeError) else "not_held", offers, [pr], current_heads), shown=[pr])
            action = "ask"
        else:
            return
    if action == "ask":
        text = "[chat clear] %s\n(your words: \"%s\")" % (verdict["question"], quoted)
        try:
            engine.send("switchboard", "chief-of-staff", text)
        except Exception as err:
            engine.audit.append(engine.actor, "chat_clear.reply_failed", pr or "chat_clear", {"error": _one_line(str(err), 160)})
            return
        for shown in verdict.get("shown") or []:   # the owner was just shown these: their shown head is the one the question named
            head = current_heads.get(shown)
            if head:
                cc.show(engine.state_dir, shown, head, now)


def chat_clear_apply(engine, cc, pr, offer, quoted, message_id, now):
    """THE clear. Called only by the daemon's hook, in LIVE mode, for a message that is the owner's own, names exactly this one PR, was confirmed by Jev at the high bar and is newer
    than the offer. At the point of effect it READS THE PR AGAIN: it must be open, at exactly the head the owner was shown, with only owner-tier hold labels and the captain marker
    (any other hold label refuses). It then removes those labels (never any other, never adds one) through the same head-bound core `impact clear` uses, comments with his words,
    and tells the Chief of Staff."""
    repo, _, number = pr.rpartition("#")
    number = int(number)
    runner = getattr(engine, "gh_runner", None) or subprocess.run
    names = label_names(engine.config)
    seen = {}

    def verify(raw):   # run by the core on the SAME read it clears from: open, at the shown head (the core checks), only owner-tier labels
        if str(raw.get("state") or "").upper() != "OPEN":
            raise NoticeError("%s is not open any more" % pr)
        labels = raw.get("labels") or []
        if raw.get("headRefOid") != offer["head"] or not cc.is_offerable(names, labels):
            raise NoticeError("%s changed since the owner was shown it: its head or its labels are not what he saw" % pr)
        seen["remove"] = cc.owner_tier_labels(names, labels)

    raw = read_pr_json(engine, repo, number)
    verify(raw)   # a cheap refusal before the core's own read; the core verifies again on the read it clears from
    lines = impact_clear_core(engine, runner, repo, number, "owner (chat)", quoted, remove=seen["remove"], head=offer["head"], via="chat:%s" % message_id, verify=verify)
    remove = seen["remove"]
    short = offer["head"][:8]
    shown_words = quoted.replace("@", "@\u200b").replace("`", "'")   # a public comment: no @mention and no code span can come out of his words
    body = "The owner cleared this hold in his chat with the Chief of Staff, at head `%s`. His words: \"%s\"\n\nRemoved: %s." % (short, shown_words, ", ".join("`%s`" % l for l in remove))
    try:
        comment_as(engine, runner, repo, number, body, "switchboard")
    except Exception as err:   # the clear is made and audited; a comment that cannot be posted is said, not undone
        engine.audit.append(engine.actor, "chat_clear.comment_failed", pr, {"error": _one_line(str(err), 160)})
    try:
        engine.send("switchboard", "chief-of-staff", "[chat clear] Cleared %s at %s on your words: \"%s\" (removed %s)." % (pr, short, quoted, ", ".join(remove)))
    except Exception as err:
        engine.audit.append(engine.actor, "chat_clear.reply_failed", pr, {"error": _one_line(str(err), 160)})
    return lines


def _impact_release_reason(before, base, rule, record, head, new_head):
    """The reason a hold no longer holds, from what the pull request was last judged on: `base changed`, `rule changed` (the matrix), `record changed` (the
    impact review record or rating), `head changed`, else `rule no longer holds` (nothing remembered: a restart, or the first judgement). It only names; it decides nothing."""
    if before is None:
        return "rule no longer holds"
    if new_head and before[3] != new_head:
        return "head changed"
    if before[0] != base:
        return "base changed"
    if before[1] != rule:
        return "rule changed"
    if before[2] != record:
        return "record changed"
    return "rule no longer holds"


def impact_ours(engine):
    """(the hold state's `applied` records, the problem or None). A state that cannot be read lists none. Which of them are ours for a repo: `applied_for_repo`."""
    state, problem = read_impact_state(engine.state_dir)
    if problem:
        return {}, problem
    return state.get("applied") or {}, None


def _impact_not_checked(engine, what, why):
    """A hold that cannot be re-checked because an input cannot be read: its labels stay, and this says so ONCE for the episode (`impact.not_checked`)."""
    if engine.__dict__.get("impact_not_checked") == what:
        return
    engine.__dict__["impact_not_checked"] = what
    engine.audit.append(engine.actor, "impact.not_checked", None, {"input": what, "why": _one_line(str(why), 160), "kept": "every label this daemon added stays until it can be read"})


def clear_line_marker(head, line):
    """The hidden marker of the posted line: the head (12 hex) and a hash of the line's content (12 hex). The once-per-content rule is read back from it."""
    return "<!-- fleet-switchboard:clear-line head=%s hash=%s -->" % ((head or "")[:12], hashlib.sha256(line.encode("utf-8")).hexdigest()[:12])


def clear_line_post(engine, runner, repo, number, head, report=None):
    """One held ready head's line: "posted", "present" (the pull request already carries this head and content) or "none" (nothing to say). Raises on any read that failed (never a confident
    line from a failed read; the caller retries later). The only write is the one comment. #946."""
    who = clear_who(engine, runner, repo, number, report)
    if who["unreadable"]:
        raise ValueError("who can clear it cannot be read: %s" % who["unreadable"])
    if who["head"] != head:
        raise ValueError("the pull request moved while the line was made (%s, then %s)" % (head[:8], str(who["head"])[:8]))
    line = load_module("delegated_clear").clear_line(who) if who["hold"] else None
    if line is None:
        return "none"
    marker = clear_line_marker(head, line)
    get, last = impact_carry_get(engine, runner, repo), None
    for page in range(1, CLEAR_LINE_PAGES + 1):
        got = get("repos/%s/issues/%d/comments?per_page=100&page=%d" % (repo, number, page))
        if not isinstance(got, list):
            raise ValueError("the comments did not come back as a list")
        for comment in got:
            body = comment.get("body") if isinstance(comment, dict) else None
            if isinstance(body, str) and fleet_mark("switchboard") in body and CLEAR_LINE_MARKER.search(body):
                last = CLEAR_LINE_MARKER.findall(body)[-1]
        if len(got) < 100:
            break
    else:
        raise ValueError("the comments are more than %d pages: the line already posted cannot be found" % CLEAR_LINE_PAGES)
    if last is not None and "<!-- fleet-switchboard:clear-line head=%s hash=%s -->" % last == marker:
        return "present"
    comment_as(engine, runner, repo, number, line + "\n\n" + marker, "switchboard")
    return "posted"


def clear_line_pass(engine, now, rule, heads, reports):
    """(#946) At the first ready head of a pull request this daemon holds, post ONE comment line: who can clear it (`clear_who`, the clear's own rule), again only when its content changes or the head does.
    Held and enforced only; a draft, a pull request that holds nothing and one the owner cleared at this head get nothing. A failed read posts nothing, is noted ONCE and retried later; it is never marked
    done. What is done is remembered per (head, rule, delegation) and the line already posted is read back from the pull request's own comment marker, so a restart posts nothing twice. Never raises."""
    done = engine.__dict__.setdefault("clear_line_done", {})
    retry = engine.__dict__.setdefault("clear_line_retry", {})
    noted = engine.__dict__.setdefault("clear_line_noted", set())
    runner = getattr(engine, "gh_runner", None) or subprocess.run
    delegation = json.dumps((engine.config or {}).get("delegated_clear"), sort_keys=True, default=str)
    spent = 0
    for (repo, number), head in sorted(heads.items()):
        try:
            report = reports.get((repo, number))
            if impact_floor.hold_mode(engine.config, repo) != "enforce" or not isinstance(report, dict) or report.get("owner_decision") != "hold" or report.get("head") != head or report.get("rule") != rule:
                continue
            signature = (head, rule, delegation)
            if done.get((repo, number)) == signature or now < retry.get((repo, number), 0):
                continue
            if (read_impact_state(engine.state_dir)[0].get("clears") or {}).get("%s#%d" % (repo, number), {}).get("head") == head:
                continue   # the owner cleared this head: nothing is held
            if spent >= CLEAR_LINE_PASS_MAX:
                break
            spent += 1
            try:
                clear_line_post(engine, runner, repo, number, head, report)
                done[(repo, number)] = signature
                noted.discard((repo, number))
            except Exception as err:
                retry[(repo, number)] = now + IMPACT_RETRY_SECONDS
                if (repo, number) not in noted:
                    noted.add((repo, number))
                    engine._note("clear_line.error", "%s#%d" % (repo, number), {"error": _one_line("%s: %s" % (type(err).__name__, err), 160)})
        except Exception as err:   # the pass is never stopped by this line
            engine._note("clear_line.error", "%s#%d" % (repo, number), {"error": _one_line("%s: %s" % (type(err).__name__, err), 160)})


def impact_would_hold_pass(engine, now):
    """The daemon hook (#179 L3, #451 slice 3): for the open PRs the ci recorder's list already holds (repos under `plan_gates`), decide the owner-hold
    rule once per (PR, head, version of the rule, impact review record), audit `gate.would_hold` when it holds, and, when `impact_hold` enforces, WRITE the hold
    for a pull request that holds and RELEASE (only the labels this daemon added) one that no longer does. One `gh pr view` per judgement, within
    IMPACT_PASS_CALLS per pass. When the matrix file cannot be read nothing is added or removed (one error and one wake for the episode). Off with
    `impact_floor.enabled: false` or the global gates kill file. Never raises."""
    cfg = (engine.config.get("impact_floor") or {}) if isinstance(engine.config, dict) else {}
    if cfg.get("enabled") is False or engine.state_dir is None or engine.audit is None or gates_off_path(engine.state_dir).exists():
        return
    state = getattr(engine, "ci_record_state", None)
    if state is None:
        return
    try:
        rule = impact_floor.rule_fingerprint()
    except impact_floor.MatrixError as err:   # fail LOUD and still: no judgement, no label added, none removed
        _impact_matrix_episode(engine, now, err)
        return
    engine.impact_rule = rule
    seen = engine.__dict__.setdefault("impact_seen", {})
    reports = engine.__dict__.setdefault("impact_reports", {})
    released_now = engine.__dict__.setdefault("impact_released", {}).setdefault(rule, [])
    hold_cfg = (engine.config.get("impact_hold") or {}) if isinstance(engine.config, dict) else {}
    budget = hold_cfg.get("calls_per_pass", cfg.get("calls_per_pass", IMPACT_PASS_CALLS))   # `impact_hold.calls_per_pass` wins when set
    records, records_problem = impact_records(engine.state_dir)
    basis = engine.__dict__.setdefault("impact_basis", {})   # what each pull request was last judged on (base, rule, record): it NAMES a release's reason, it never skips a judgement
    judged_at = engine.__dict__.setdefault("impact_judged_at", {})
    ours_applied, state_problem = impact_ours(engine)   # the pull requests carrying labels this daemon added: judged even when the floor is now empty (#999)
    if state_problem or (records_problem and any(applied_for_repo(ours_applied, k) for k in state.lists)):
        _impact_not_checked(engine, "the impact review ledger" if records_problem else "the hold state file", records_problem or state_problem)
    else:
        engine.__dict__.pop("impact_not_checked", None)
    marks = impact_carry_marks(engine.state_dir)[0]
    unjudged, live, heads = 0, set(), {}
    for key, (_, listed) in sorted(state.lists.items()):
        ours_prs = applied_for_repo(ours_applied, key)
        for record in sorted(listed, key=lambda r: judged_at.get((key, r.get("number")), 0) if isinstance(r, dict) else 0):   # the one judged longest ago first: a small budget never starves a pull request
            number = record.get("number") if isinstance(record, dict) else None
            head = ((record.get("head") or {}).get("sha")) if isinstance(record, dict) else None
            if not isinstance(number, int) or isinstance(number, bool) or not head or (record.get("draft") and "%s#%d" % (key, number) not in ours_prs):
                continue
            pr = "%s#%d" % (key, number)
            ours = pr in ours_prs
            live.add((key, number))
            heads[(key, number)] = head
            enforce = impact_floor.hold_mode(engine.config, key) == "enforce"
            earlier = reports.get((key, number))
            listed_base = record.get("base") if isinstance(record.get("base"), dict) else {}   # (#999) the list already carries the base: a RETARGET (a changed base.ref) re-judges with no extra call; a move of the same base's tip is not in the key (it does not change a three-dot diff, and keying on it would re-judge every open pull request at each merge)
            list_base = listed_base.get("ref")
            backoff = seen.get((key, number, "retry"))
            if earlier is not None and earlier["head"] == head and earlier.get("rule") == rule and earlier.get("owner_decision") != "hold" and enforce and not earlier.get("rehold") \
                    and not (backoff and now < backoff) and not records_problem and (pr, head) in records and seen.get((key, number)) != (head, rule, records[(pr, head)], list_base):
                # an impact review record that is new since this head was judged, on a pull request that holds nothing: no gh read (the paths are unchanged).
                # A `hold` of a top tier, missing or unknown class can only ADD a hold; anything else changes nothing, so it is only noted as seen.
                newest = records[(pr, head)]
                if newest[0] == "hold" and impact_floor.class_is_top_tier(impact_floor._matrix_cached(), newest[1]):
                    added = dict(earlier, decision="hold", owner_decision="hold", reasons=earlier["reasons"] + [IMPACT_REVIEW_REASON])
                    try:
                        budget -= apply_impact_hold(engine, key, number, added, record)
                        reports[(key, number)] = added
                        seen[(key, number)] = (head, rule, newest, list_base)
                        engine.audit.append(engine.actor, "gate.would_hold", pr, {"head": head, "reasons": added["reasons"], "floor_paths": [], "advisory": False, "unknown": None})
                    except Exception as err:
                        seen[(key, number, "retry")] = now + IMPACT_RETRY_SECONDS
                        engine._note("impact.error", pr, {"error": _one_line(str(err), 160), "write": True})
                else:
                    seen[(key, number)] = (head, rule, newest, list_base)
                continue
            try:
                globs = impact_floor.floor_for(key, engine.config)[0]
            except impact_floor.MatrixError as err:   # fail LOUD: no judgement is made while the matrix file cannot be read (never read as "no floor")
                _impact_matrix_episode(engine, now, err)
                return
            if not globs and not ours:   # a pull request holding our labels is judged even when the floor is now empty: the release is the point
                continue
            signature = (head, rule, "unreadable" if records_problem else records.get((pr, head)), list_base) \
                + ((marks[(pr, head)],) if (pr, head) in marks else ())   # (#815) a new confirmation re-judges
            if seen.get((key, number)) == signature:
                continue   # judged on exactly these inputs: held or not, it costs no call until one of them changes (head, rule, record, base)
            if budget <= 0:
                unjudged += 1
                continue
            retry = seen.get((key, number, "retry"))
            if retry and now < retry:
                unjudged += 1
                continue
            budget -= 1
            try:
                report = pr_floor_report(engine, key, number)
            except Exception as err:
                seen[(key, number, "retry")] = now + IMPACT_RETRY_SECONDS
                engine._note("impact.error", pr, {"error": _one_line(str(err), 160)})
                unjudged += 1
                continue
            report["rule"] = rule
            owner = report.get("owner_decision")
            judged_at[(key, number)] = now
            if owner != "hold":
                report["release_reason"] = _impact_release_reason(basis.get((key, number)), report.get("base"), rule, signature[2], head, report.get("head"))
            if owner == "hold":
                engine.audit.append(engine.actor, "gate.would_hold", report["pr"],
                                    {"head": report["head"], "floor_paths": report["floor_paths"][:20], "reasons": report.get("owner_reasons", [])[:10],
                                     "complete": report["complete"], "unknown": report["unknown"], "advisory": not enforce, "globs": report["globs"][:20]})
                if enforce:
                    try:
                        budget -= apply_impact_hold(engine, key, number, dict(report, reasons=report.get("owner_reasons", [])), record)
                    except Exception as err:   # a failed write is retried, never marked done
                        seen[(key, number, "retry")] = now + IMPACT_RETRY_SECONDS
                        engine._note("impact.error", pr, {"error": _one_line(str(err), 160), "write": True})
                        unjudged += 1
                        continue
            elif enforce and (rehold := _impact_rehold_try(engine, key, number, pr, report, record, now, seen)):   # (#830) cleared at an earlier head, none here: held again, never released
                if rehold == "failed":   # the write failed: retried later, never marked done
                    unjudged += 1
                    continue
                budget -= 1
                report = dict(report, rehold=True)
            elif enforce and not records_problem:   # a release is a LOOSENING: only on a decision made from every input, never on a failed read
                try:
                    removed = release_impact_hold(engine, key, number, report, record)
                    budget -= removed + 1   # each removal is a write, and the release read the labels
                    if removed and pr not in released_now:
                        released_now.append(pr)
                except Exception as err:
                    seen[(key, number, "retry")] = now + IMPACT_RETRY_SECONDS
                    engine._note("impact.error", pr, {"error": _one_line(str(err), 160), "write": True})
                    unjudged += 1
                    continue
            judged_head = report["head"] or head
            seen[(key, number)] = (judged_head, rule, "unreadable" if records_problem else records.get((pr, judged_head)), signature[3]) + ((marks[(pr, judged_head)],) if (pr, judged_head) in marks else ())
            basis[(key, number)] = (report.get("base"), rule, seen[(key, number)][2], report.get("head") or head)
            reports[(key, number)] = report
    for memo in (basis, judged_at):   # nothing is kept for a pull request that is no longer open
        for gone in [k for k in memo if k not in live]:
            del memo[gone]
    clear_line_pass(engine, now, rule, heads, reports)   # #946: one line per held ready head, who can clear it (reads, then at most one comment each)
    _impact_matrix_recovered(engine, now)   # the file and the floor of every repo were read this pass: a standing episode is over
    if not unjudged and not records_problem and any(impact_floor.hold_mode(engine.config, key) == "enforce" for key, _ in live):
        judged = [reports[k] for k in sorted(live) if k in reports and reports[k].get("rule") == rule]
        if judged:   # every open pull request of the repos under the hold has been judged under this version of the rule
            held = sorted(r["pr"] for r in judged if r.get("owner_decision") == "hold")
            second = sorted(r["pr"] for r in judged if r.get("owner_decision") == "second-review")
            _impact_post_list(engine, now, rule, held, sorted(released_now), second)


def cmd_gates_stats(args, runner, now):
    """`gates stats [--limit N] [--json]`: what the gates cost per merged gated PR (records by actor, minutes from the first gate record
    to the merge). Read-only: the ledger, and one `gh pr view` per PR in it."""
    engine, state, config = build_engine(runner, now, "cli", writable=False)
    entries, problem = plan_ledger.read_ledger(state)
    cache = {}

    def merged_at(pr):
        if pr not in cache:
            repo, _, number = pr.rpartition("#")
            try:
                raw = read_pr_json(engine, repo, int(number), "mergedAt,state")
                when = raw.get("mergedAt") if raw.get("state") == "MERGED" else None
                cache[pr] = datetime.strptime(when, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc).timestamp() if when else None
            except (NoticeError, ValueError, TypeError, AttributeError):
                cache[pr] = None
        return cache[pr]
    got = gates_stats_core(entries, merged_at, max(1, getattr(args, "limit", 10) or 10))
    if args.json:
        print(json.dumps(dict(got, ledger_problem=problem), sort_keys=True))
        return EXIT_OK
    if problem:
        print("LEDGER: %s" % problem)
    print("gates cost per merged gated PR (newest first; %d gated PR(s) not merged yet)" % got["unmerged"])
    for row in got["prs"]:
        print("  %-28s %2d record(s) (%d by agents, %d automatic): %s; first record to merge %.1f min" % (
            row["pr"], row["records"], row["manual_records"], row["automatic_records"],
            ", ".join("%s %d" % kv for kv in row["by"].items()), row["minutes_to_merge"]))
    if got["prs"]:
        print("  mean: %.1f agent record(s), %.1f min first record to merge" % (
            sum(r["manual_records"] for r in got["prs"]) / len(got["prs"]), sum(r["minutes_to_merge"] for r in got["prs"]) / len(got["prs"])))
    return EXIT_OK


def gates_carried_note(report, ctx):
    """The gate row of a PR whose owner's clear CARRIED to its current head says so (G6 `carried from <head>`), and the report gains `carried`. Reads the local state file only."""
    try:
        carried = (read_impact_state(ctx.state)[0].get("carried") or {}).get(ctx.pr)
        if not isinstance(carried, dict) or carried.get("head") != report.get("head") or not impact_floor.carry_enabled(ctx.config, ctx.pr.rsplit("#", 1)[0]):
            return
        for row in report["gates"]:
            if row["gate"] == "G6" and row["status"] == "ok":
                row["detail"] = "not a held PR: the owner's clear of %s carried to this head (only main was merged in; own change %s)" % (
                    str(carried.get("from"))[:8], str(carried.get("fingerprint"))[:19])
        report["carried"] = {"from": carried.get("from"), "head": carried.get("head"), "fingerprint": carried.get("fingerprint")}
    except (OSError, ValueError, KeyError, TypeError, AttributeError) as err:   # the row then omits "carried": said, never silent
        report["carried_error"] = _one_line("%s: %s" % (type(err).__name__, err), 160)


def enforced_gates_of(ctx):
    """The gates this PR's repo really refuses on, or None when it refuses on none (shadow, unlisted, off, killed, or an
    `enforce` whose preflight does not pass and so runs as shadow): then `gates` judges the whole board, as it always did."""
    try:
        repo = plan_ledger.normal_repo(ctx.pr.rsplit("#", 1)[0])
        setting = plan_ledger.repo_setting(ctx.config, repo)
        if setting is None or not setting.get("enabled") or gates_off_path(ctx.state).exists():
            return None
        mode, _ = plan_ledger.effective_mode(ctx.config, setting, lambda: ci_recorder_proven(ctx.state, time.time()), cos_ready_check)
        return list(setting.get("enforce_gates") or plan_ledger.DEFAULT_ENFORCED) if mode == "enforce" else None
    except Exception:
        return None


# ---------------------------------------------------------------- `gates-check` and the mode switches (#107 slice 3a)
#
# docs/plan-gate-engine-design.md. `gates-check` answers one question for a future shim: allow or refuse? It is read-only.
# Exit 0 allow, 10 refuse, anything else a fail-open (the caller allows). Nothing calls it yet and, with every repo in `shadow`
# or unlisted, it never refuses. Only exit 10 refuses; a Python exception exits 3 (fail-open), never 10.

GATES_OFF_FILE = "plan-gates.off"
GATES_STATE_FILE = "plan-gates-state.json"


def gates_off_path(state):
    return Path(state) / GATES_OFF_FILE


def _day(now):
    return time.strftime("%Y-%m-%d", time.gmtime(now))


def gates_state(state, now):
    """The per-day counters and alarm marks, {"day", "repos": {repo: {checks, refusals, would_refuse, fail_opens}}, "alarmed": [..]}.
    A new UTC day starts empty."""
    try:
        data = json.loads((Path(state) / GATES_STATE_FILE).read_text())
        if isinstance(data, dict) and data.get("day") == _day(now) and isinstance(data.get("repos"), dict):
            return data
    except (OSError, ValueError):
        pass
    return {"day": _day(now), "repos": {}, "alarmed": []}


def gates_note(state, now, repo, counter, alarm=None):
    """Count `counter` for `repo` today; True when `alarm` (a kind) is new today for this repo (so it should be raised)."""
    data = gates_state(state, now)
    entry = data["repos"].setdefault(normal_repo_name(repo), {"checks": 0, "refusals": 0, "would_refuse": 0, "fail_opens": 0})
    entry[counter] = entry.get(counter, 0) + 1
    fresh = False
    if alarm:
        mark = "%s:%s" % (normal_repo_name(repo), alarm)
        if mark not in data["alarmed"]:
            data["alarmed"].append(mark)
            fresh = True
    try:
        temp = Path(state) / ("%s.%d.tmp" % (GATES_STATE_FILE, os.getpid()))
        fd = os.open(str(temp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as handle:
            handle.write(json.dumps(data, sort_keys=True))
        os.replace(str(temp), str(Path(state) / GATES_STATE_FILE))
    except OSError:
        pass   # a counter is best effort
    return fresh


def normal_repo_name(repo):
    return plan_ledger.normal_repo(repo)


def _gates_audit(engine, event, subject, detail):
    if engine.audit is not None:
        try:
            engine.audit.append(engine.actor, event, subject, detail)
        except OSError:
            pass


COS_DEFINITION_ENV = "FLEET_COS_DEFINITION"


def cos_ready_check():
    """"" when the installed chief-of-staff definition allows `waive` and `gates mode * shadow` (the way out of a refusal), else
    what it lacks. The file is the one the installer puts in ~/.config/opencode/agents; FLEET_COS_DEFINITION overrides the path."""
    path = os.environ.get(COS_DEFINITION_ENV) or str(Path.home() / ".config" / "opencode" / "agents" / "chief-of-staff.md")
    try:
        text = Path(path).read_text()
    except (OSError, UnicodeError):
        text = None
    return plan_ledger.cos_lacking(text)


def cmd_gates_check(args, runner, now):
    """`gates-check <pr> --for ready|merge`. Read-only (state counters aside). 0 allow, 10 refuse, 3 fail-open."""
    exit_code, payload = plan_ledger.EXIT_FAIL_OPEN, {"verdict": "fail-open"}
    engine = state = None
    repo = None
    try:
        repo, number, pr = _ledger_pr(args)
        config = load_config()
        setting = plan_ledger.repo_setting(config, repo)
        state = ensure_state_dir()
        engine, _, _ = build_engine(runner, now, "cli", writable=True)
        if setting is None or not setting["enabled"]:
            payload = {"verdict": "allow", "reason": "not opted in" if setting is None else "disabled (kill switch)"}
            exit_code = plan_ledger.EXIT_ALLOW
        elif gates_off_path(state).exists():
            _gates_audit(engine, "gate.killed", pr, {"for": args.check_for, "by": "plan-gates.off"})
            payload = {"verdict": "allow", "reason": "the global kill file %s exists" % GATES_OFF_FILE}
            exit_code = plan_ledger.EXIT_ALLOW
        else:
            box = {}

            def work():
                try:
                    ns = types.SimpleNamespace(pr=args.pr, plan=args.plan, ask=args.ask, head=None)
                    ctx = _ledger_context(ns, runner, now, False, floor=True)
                    box["report"] = plan_ledger.evaluate_gates(ctx.plan, ctx.entries, ctx.problem,
                                                                ctx.facts if ctx.facts.get("head") or ctx.facts.get("body") else None, ctx.pr,
                                                                now=now())
                    box["unreadable"] = ctx.unreadable
                    box["head"] = (ctx.facts or {}).get("head")
                except BaseException as err:  # the answer must reach the caller as a fail-open, not a traceback
                    box["error"] = "%s: %s" % (type(err).__name__, _one_line(str(err), 150))
            thread = threading.Thread(target=work, daemon=True)
            thread.start()
            thread.join(setting["budget_ms"] / 1000.0)
            if thread.is_alive():
                raise TimeoutError("no answer within %d ms" % setting["budget_ms"])
            if "error" in box:
                raise RuntimeError(box["error"])
            report = box["report"]
            if box.get("unreadable"):
                raise RuntimeError("GitHub unreadable: %s" % box["unreadable"])   # an unknown is not a refusal
            mode, downgraded = plan_ledger.effective_mode(config, setting, lambda: ci_recorder_proven(state, now()), cos_ready_check)
            if downgraded and gates_note(state, now(), repo, "downgraded", alarm="enforce-downgraded"):
                _gates_audit(engine, "gate.enforce_downgraded", pr, {"reason": _one_line(downgraded, 300)})   # once a day per repo
            verdict, failed, why = plan_ledger.decide(report, args.check_for, mode, setting.get("enforce_gates"))
            gates_note(state, now(), repo, "checks")
            payload = {"verdict": verdict, "mode": mode, "for": args.check_for, "failed": failed, "reason": why}
            if downgraded:
                payload["downgraded"] = downgraded
            if isinstance(box.get("head"), str) and box["head"]:
                payload["head"] = box["head"]   # the head these gates were checked at: the shim binds a merge to it
            if verdict == "refuse":
                payload["message"] = plan_ledger.refusal_message(PROG, args.check_for, args.pr, failed, repo)
            if report.get("ledger_problem") and gates_note(state, now(), repo, "ledger_broken", alarm="ledger.broken"):
                _gates_audit(engine, "gate.ledger_broken", pr, {"problem": report["ledger_problem"]})   # once a day per repo
            if verdict == "refuse":
                gates_note(state, now(), repo, "refusals")
                _gates_audit(engine, "gate.refused", pr, {"for": args.check_for, "failed": [f["gate"] for f in failed]})
                exit_code = plan_ledger.EXIT_REFUSE
            else:
                exit_code = plan_ledger.EXIT_ALLOW
                if failed:   # shadow: what enforcement would have refused (every gate); enforce: gates reported but not enforced
                    kind = "gate.would_refuse" if mode == "shadow" else "gate.reported"
                    gates_note(state, now(), repo, "would_refuse" if mode == "shadow" else "reported")
                    _gates_audit(engine, kind, pr, {"for": args.check_for, "failed": [f["gate"] for f in failed],
                                                    "enforced": [f["gate"] for f in failed if f["enforced"]],
                                                    "reason": _one_line(why, 300)})
    except BaseException as err:
        if isinstance(err, (KeyboardInterrupt, SystemExit)):
            raise
        reason = "%s: %s" % (type(err).__name__, _one_line(str(err), 200))
        payload = {"verdict": "fail-open", "reason": reason}
        exit_code = plan_ledger.EXIT_FAIL_OPEN
        if state is not None and repo:
            first = gates_note(state, now(), repo, "fail_opens", alarm="fail-open:%s" % type(err).__name__)
            if engine is not None:
                _gates_audit(engine, "gate.fail_open", "%s" % args.pr, {"for": args.check_for, "reason": reason, "first_today": first})
    if args.json:
        print(json.dumps(payload, sort_keys=True))
    elif payload["verdict"] == "refuse":
        sys.stderr.write("%s\n" % plan_ledger.refusal_message(PROG, args.check_for, args.pr, payload["failed"], repo))
    elif payload["verdict"] == "fail-open":
        sys.stderr.write("%s: gates-check: could not check (%s): allowed\n" % (PROG, payload["reason"]))
    return exit_code


cmd_gates_check.ledger = True   # state and GETs only; its own errors are usage errors


# ---- #962: the fleet's own merge queue. `merge-gate` reads (and writes nothing); `--pass` runs the gate and takes the lock; `--check` is what the gh shim
# asks before `gh pr merge`; `--release` frees the lock. The rules are in bin/merge_gate.py, the shared pull-request reading in bin/pr_reading.py.
MERGE_GATE_SLEEP = time.sleep   # the wait between two reads of a re-run; a test replaces it


def add_merge_gate_parsers(sub):
    gate = sub.add_parser("merge-gate", help="The fleet's merge queue: may this pull request merge now? Read-only by default; `--pass` runs the gate and takes the "
                                             "per-branch lock, `--release` frees it. The gh shim enforces it for a gated branch (the `merge_gate` configuration key)",
                          description="Prints ONE block: the branch tip now, the branch tip the pull request's last CI run was computed on, equal or not, the run's "
                                      "result at the current head, the latest completed run on the branch and whether a merge is allowed now and why. It writes "
                                      "nothing. `--pass` re-runs that pull request's CI on the current merge ref when the branch moved (a close and reopen: head and "
                                      "labels untouched; a held pull request only with `--rerun-held`), waits up to `merge_gate.wait_minutes` (default 45), and on "
                                      "green records the pass and takes the lock of the repository and branch. `--check` (the shim) exits 0 to allow and 10 to refuse.")
    gate.add_argument("pr", help="The pull request: owner/repo#N or its URL")
    mode = gate.add_mutually_exclusive_group()
    mode.add_argument("--pass", dest="gate_pass", action="store_true", help="Run the gate, re-run CI if the branch moved, take the lock and record the pass")
    mode.add_argument("--check", action="store_true", help="What the gh shim asks: exit 0 allow, 10 refuse (one line on stderr)")
    mode.add_argument("--release", action="store_true", help="Release the lock you hold on the pull request's branch")
    gate.add_argument("--merge", action="store_true", help="With --pass: after the pass, in the same process, re-read the head, labels and gates and squash-merge with "
                                                          "--match-head-commit on that head; any mismatch merges nothing and releases the lock. Not for a held pull request")
    gate.add_argument("--rerun-held", action="store_true", help="With --pass: close and reopen a HELD pull request to recompute its merge ref (its orchestrator agrees first)")
    gate.add_argument("--json", action="store_true")


def merge_gate_gh(config, runner, repo):
    """`gh(argv, own=True) -> (code, stdout, stderr)` for `repo`'s account, never raising; a call names itself the switchboard's own, so the shim does not probe it,
    EXCEPT with `own=False` (the one merge call of `--pass --merge`): that call carries no marker, so the shim's own checks (the review check among them) run."""
    accounts = GhAccounts(config, runner, time.time)
    try:
        refuse_excluded(config, repo)
        env = accounts.env_for(repo)
    except AccountError as err:
        raise LedgerCommandError(str(err)) from None
    env = dict(env if env is not None else os.environ, **{OWN_GH_ENV: "1"})
    plain_env = {k: v for k, v in env.items() if k != OWN_GH_ENV}

    def gh(argv, own=True):
        try:
            done = runner([config["gh"]] + argv, capture_output=True, text=True, timeout=config["call_timeout_seconds"], stdin=subprocess.DEVNULL,
                          env=env if own else plain_env)
        except (OSError, subprocess.SubprocessError) as err:
            return 1, "", accounts.scrub(_one_line(str(err), 120))
        return done.returncode, done.stdout or "", accounts.scrub(done.stderr or "")
    return gh


def cmd_merge_gate(args, runner, now):
    gate, reading = load_module("merge_gate"), load_module("pr_reading")
    try:
        repo, number = parse_pr_ref(args.pr)
    except NoticeError as err:
        raise LedgerCommandError(str(err)) from None
    ref = "%s#%d" % (repo, number)
    config = load_runnable_config()
    conf = gate.settings(config)
    gh = merge_gate_gh(config, runner, repo)
    state = state_dir_path()
    if not (args.gate_pass or args.check or args.release):
        facts = gate.read_facts(reading, gh, repo, number, conf)
        allowed, reason, _ = gate.decide(facts)
        print(gate.block(facts, allowed, reason))
        if args.json:
            print(json.dumps({"allowed": allowed, "reason": reason, "tip": facts["tip"], "run_base": facts["run_base"], "head": facts["head"]}, sort_keys=True))
        return EXIT_OK if allowed else EXIT_ERROR
    engine, state, _ = build_engine(runner, now, "cli", writable=True)
    kind = gates_caller_kind(runner, now)
    if kind[0] == "unknown":
        _gates_audit(engine, "merge_gate.refused", ref, {"why": "identity unknown"})
        raise LedgerCommandError("refused: %s" % kind[1])
    who = "owner-terminal" if kind[0] == "person" else kind[1]
    if args.release:
        facts = gate.read_facts(reading, gh, repo, number, conf)
        if facts["problems"]:
            raise LedgerCommandError("unreadable: %s" % facts["problems"][0])
        done = gate.release(state, repo, facts["branch"], who)
        _gates_audit(engine, "merge_gate.release", ref, {"by": who, "released": done})
        print("released the merge lock on %s %s" % (repo, facts["branch"]) if done else "%s holds no merge lock on %s %s: nothing released" % (who, repo, facts["branch"]))
        return EXIT_OK
    if args.merge and not args.gate_pass:
        raise LedgerCommandError("--merge goes with --pass")
    if args.gate_pass and args.merge:
        code, lines, record = gate.pass_and_merge(reading, gh, conf, state, repo, number, who, os.getppid() if kind[0] == "person" else None, now, MERGE_GATE_SLEEP,
                                                  allow_held=args.rerun_held)
        for line in lines:
            print(line)
        _gates_audit(engine, "merge_gate.pass_merge", ref, dict(record, by=who))
        return code
    if args.gate_pass:
        ok, lines = gate.gate_pass(reading, gh, conf, state, repo, number, who, os.getppid() if kind[0] == "person" else None, now,   # an agent's shell exits before its merge: only a person's own terminal has a process to watch
                                     MERGE_GATE_SLEEP, allow_held=args.rerun_held)
        for line in lines:
            print(line)
        _gates_audit(engine, "merge_gate.pass" if ok else "merge_gate.blocked", ref, {"by": who, "result": _one_line(lines[-1] if lines else "", 300)})
        return EXIT_OK if ok else EXIT_ERROR

    def waived(head):
        entries, problem = plan_ledger.read_ledger(state)
        return not problem and gate.WAIVER_GATE in plan_ledger.valid_waivers(entries, ref, head, now())
    allowed, why, head = gate.check_merge(reading, gh, conf, state, repo, number, who, kind[0] == "person", waived, now)
    _gates_audit(engine, "merge_gate.allowed" if allowed else "merge_gate.refused", ref, {"by": who, "why": _one_line(why, 300)})
    if args.json:
        print(json.dumps({"allowed": allowed, "reason": why, "head": head, "locked": why.startswith(gate.GATE_PASSED)}, sort_keys=True))
    elif not allowed:
        sys.stderr.write("%s\n" % why)
    return EXIT_OK if allowed else plan_ledger.EXIT_REFUSE


cmd_merge_gate.ledger = True   # state and GETs only; its own errors are usage errors


ANCESTOR_DEPTH = 25
AGENT_PROCESS_NAMES = ("opencode", "fleet-opencode", "copilot")


PS_CANDIDATES = ("/bin/ps", "/usr/bin/ps")   # fixed paths, never PATH: a `ps` earlier on PATH must not decide who is a person
PS_ENV = {"PATH": "/usr/bin:/bin", "LC_ALL": "C", "LANG": "C"}   # a scrubbed environment for the child


def _trusted_ps():
    """The `ps` binary to use, or None: the first of PS_CANDIDATES that is a regular, executable file owned by root and not
    writable by anyone else. A binary that is not the expected one is refused, not used."""
    for path in PS_CANDIDATES:
        try:
            info = os.stat(path)
        except OSError:
            continue
        if stat.S_ISREG(info.st_mode) and os.access(path, os.X_OK) and info.st_uid == 0 and not info.st_mode & 0o022:
            return path
    return None


def _ps_line(pid):
    """(ppid, command) of `pid` from the trusted `ps` (see _trusted_ps) run with a scrubbed environment, or None when there is
    no trusted `ps` or the line cannot be read (the caller then refuses)."""
    binary = _trusted_ps()
    if binary is None:
        return None
    try:
        done = subprocess.run([binary, "-o", "ppid=,command=", "-p", str(pid)], capture_output=True, text=True, timeout=3,
                              stdin=subprocess.DEVNULL, env=dict(PS_ENV))
    except (OSError, subprocess.SubprocessError):
        return None
    line = done.stdout.strip() if done.returncode == 0 else ""
    found = re.match(r"^(\d+)\s+(.*)$", line)
    return (int(found.group(1)), found.group(2)) if found else None


def _is_agent_command(command):
    for token in command.split()[:6]:
        # an executable named for the agent, or a script under a directory named for it (`node /lib/opencode/cli.js`)
        if any(part.lower() in AGENT_PROCESS_NAMES for part in token.split("/")):
            return True
    return False


def owner_terminal_problem(stdin=None, stdout=None, ps=None, start_pid=None, depth=ANCESTOR_DEPTH):
    """Why this process cannot be established as the owner's own terminal, or None when it can. Two things must hold: (a) standard
    input AND output are a controlling terminal (an agent's tool shell runs on pipes), and (b) no ancestor in the caller's process
    chain is an opencode or agent process (the chain is walked up to `depth` parents). If either cannot be established (no `ps`,
    an unreadable parent, a chain that does not end) the answer is a reason, never "yes". A strong mistake guard, not a boundary:
    see docs/switchboard.md."""
    stdin, stdout, ps = stdin or sys.stdin, stdout or sys.stdout, ps or _ps_line
    try:
        if not (stdin.isatty() and stdout.isatty()):
            return "standard input and output are not a terminal (an agent's tool shell runs on pipes)"
    except (AttributeError, ValueError, OSError):
        return "whether this is a terminal cannot be established"
    pid = os.getppid() if start_pid is None else start_pid
    for _ in range(depth):
        if pid <= 1:
            return None
        got = ps(pid)
        if got is None:
            return "the process chain cannot be read (process %d): refused, not guessed" % pid
        parent, command = got
        if _is_agent_command(command):
            return "an agent process is an ancestor of this command (%s)" % _one_line(command.split()[0] if command.split() else "?", 60)
        if parent == pid:
            return None
        pid = parent
    return "the process chain is deeper than %d: it cannot be established" % depth


def gates_caller_kind(runner, now):
    """THE ONE human-terminal check: every command that must be run by the owner in person asks this function, and no other code
    decides who is a person. Today: `verdict --as owner`, `gates mode`, `gates off|on`, `move` (its operator path) and `waive` (its chief-of-staff caller is an agent
    session; its person path asks this function like the rest). Returns (kind, who[, role]).
    "person" (the owner's own terminal: no agent session and no pane, or a session v2 knows is not a fleet
    agent), "agent" (a fleet agent, even one nobody registered) or "unknown" (an uncertain identity: #138 refuses it, never reads
    it as a person; or the registry cannot be read). All agents share one GitHub login, so the login cannot be the test: it is the
    session identity. A mistake-guard, not a boundary: an agent that unsets its own session and pane variables looks like a person."""
    try:
        engine, _, _ = build_engine(runner, now, "cli", writable=False)
        fleet = caller_fleet(engine.herdr, engine.v2, os.environ)
    except IdentityUncertain:
        return "unknown", "unknown (an uncertain identity is refused, never read as a person: #138)"
    except CallerError:
        problem = owner_terminal_problem()
        if problem:
            return "unknown", "not established as the owner's own terminal: %s" % problem
        return "person", "a person at a shell"
    except (V2Error, HerdrError):
        return "unknown", "unknown (the registry could not be read)"
    return "agent", fleet.get("name") or "an agent", fleet.get("role")


def gates_caller_may_switch(runner, now):
    """(ok, who): the chief of staff, or a person at a shell with no fleet identity, may change a gate mode. Any other fleet
    agent is refused."""
    got = gates_caller_kind(runner, now)
    if got[0] == "person":
        return True, got[1]
    if got[0] == "agent" and got[2] == "chief-of-staff":
        return True, got[1]
    return False, got[1]


def _write_gates_config(raw_edit):
    """Edit the config file's `plan_gates` through `raw_edit(section) -> section`, atomically, keeping every other key, and
    check the result with validate_config before it is written."""
    path = config_path()
    try:
        raw = json.loads(path.read_text()) if path.exists() else {}
    except (OSError, ValueError) as err:
        raise ConfigError("cannot read %s to edit it: %s" % (path, _one_line(str(err), 100))) from None
    section = raw.get("plan_gates") if isinstance(raw.get("plan_gates"), dict) else {}
    section = dict(section, repos=dict(section.get("repos") or {}))   # every other key (ci_record) is kept
    raw["plan_gates"] = raw_edit(section)
    validate_config(raw, str(path))
    path.parent.mkdir(parents=True, exist_ok=True)
    temp = path.with_name("%s.%d.tmp" % (path.name, os.getpid()))
    mode = stat.S_IMODE(path.stat().st_mode) if path.exists() else 0o600
    fd = os.open(str(temp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    with os.fdopen(fd, "w") as handle:
        handle.write(json.dumps(raw, indent=2) + "\n")
    os.replace(str(temp), str(path))


def cmd_gates_switch(args, runner, now):
    """`gates mode <repo> shadow|enforce|off` and `gates off|on`: change enforcement. chief of staff or a person only; audited."""
    kind = gates_caller_kind(runner, now)
    ok, who = kind[0] == "person" or (kind[0] == "agent" and kind[2] == "chief-of-staff"), kind[1]
    engine, state, config = build_engine(runner, now, "cli")
    word = args.pr
    if not ok:
        _gates_audit(engine, "gate.mode.refused", word, {"by": who, "args": args.rest[:3]})
        raise LedgerCommandError("refused: %s may not change gate modes (the chief of staff, or a person at a shell, may)" % who)
    # Turning enforcement ON is the owner's, in person: the COMMAND refuses any other caller (the chief of staff, any agent session, an
    # unknown session, a caller that is not the owner's own terminal), whatever wraps it (`timeout`, `env`, a pipe): the command sees
    # the caller, not the wrapper. Turning gates off, to shadow, and waiving stay the chief of staff's.
    enables = word == "on" or (word == "mode" and len(args.rest) == 2 and args.rest[1] == "enforce")
    if enables and kind[0] != "person":
        _gates_audit(engine, "gate.mode.refused", word, {"by": who, "args": args.rest[:3], "why": "enabling enforcement is the owner's, at their own terminal"})
        raise LedgerCommandError("refused: only the owner, at their own terminal, turns enforcement on (%s is %s). You may turn gates off, "
                                 "set a repo to shadow, or waive; ask the owner for the rest" % (who, "the chief of staff" if kind[0] == "agent" and kind[2] == "chief-of-staff"
                                                                                         else "an agent" if kind[0] == "agent" else "not established as the owner"))
    if word in ("off", "on"):
        path = gates_off_path(state)
        if word == "off":
            fd = os.open(str(path), os.O_WRONLY | os.O_CREAT, 0o600)
            os.close(fd)
        else:
            try:
                path.unlink()
            except FileNotFoundError:
                pass
        _gates_audit(engine, "gate.mode", "all", {"by": who, "global": word})
        print("plan gates: global kill file %s (%s)" % ("created: every repo is off" if word == "off" else "removed", GATES_OFF_FILE))
        return EXIT_OK
    if len(args.rest) != 2 or args.rest[1] not in ("shadow", "enforce", "off"):
        raise LedgerCommandError("usage: gates mode <owner/repo> shadow|enforce|off")
    repo, target = args.rest
    if target == "enforce":
        blocking, notes = plan_ledger.preflight(config, repo, lambda: ci_recorder_proven(state, now()), cos_ready_check)
        if blocking:
            raise LedgerCommandError("refused: %s not switched to enforce: %s" % (repo, "; ".join(blocking)))
        for note in notes:
            sys.stderr.write("%s: gates mode: note: %s\n" % (PROG, note))

    def edit(section):
        repos = section["repos"]
        current = next((n for n in repos if plan_ledger.normal_repo(n) == plan_ledger.normal_repo(repo)), repo)
        entry = dict(repos.get(current) or {})
        if target == "off":
            entry["enabled"] = False
        else:
            entry["mode"], entry["enabled"] = target, True
        repos[current] = entry
        return section
    _write_gates_config(edit)
    _gates_audit(engine, "gate.mode", repo, {"by": who, "mode": target})
    shown = plan_ledger.repo_setting(load_config(), repo) if target != "off" else None
    print("plan gates: %s is now %s%s" % (repo, "off (kill switch)" if target == "off" else target,
                                          "; refuses on %s (others are reported)" % ", ".join(shown["enforce_gates"]) if shown and target == "enforce" else ""))
    return EXIT_OK


def ci_recorder_proven(state, now_ts):
    """True when the audit holds a successful `gate.ci_record` within the last week: the built-in `ci` recorder has really run."""
    for entry in reversed(_audit_tail(state)):
        detail = entry.get("detail") or {}
        if entry.get("event") == "gate.ci_record" and detail.get("ok") is True and (detail.get("recorded") or detail.get("already")):
            at = detail.get("at")   # the switchboard's own clock when it recorded (the audit line's ts is the wall clock)
            if isinstance(at, (int, float)) and now_ts - at <= plan_ledger.CI_RECORD_FRESH_SECONDS:
                return True
    return False


def ci_record_core(ctx, now, quiet=False):
    """The ci recorder's one piece of logic, for the command and for the daemon pass. Returns {"status", "head", "ci", "scenarios",
    "recorded", "already", "why"}; status is "recorded" (at least one verdict written or already there at this head and plan),
    "nothing" (CI is green but no per-PR scenario names `ci`), "not-green", "unreadable", "no-plan" or "no-head". It records
    only for a complete, green run at the PR's CURRENT head and the plan's CURRENT hash, never twice, and writes nothing to GitHub.
    `quiet` leaves the audit alone for everything but a real record (the pass runs this for many PRs: a failing run is not news)."""
    out = {"status": None, "head": None, "ci": None, "scenarios": [], "recorded": [], "already": [], "why": None}
    if ctx.unreadable:
        return dict(out, status="unreadable", why="the PR could not be read: %s" % ctx.unreadable)
    head = (ctx.facts or {}).get("head")
    ci = (ctx.facts or {}).get("ci")
    out.update(head=head, ci=ci)
    if ctx.plan is None or ctx.plan["result"] != "pass":
        return dict(out, status="no-plan", why="no passing plan for the PR (%s)" % (ctx.plan_problem or "run `plan check`"))
    wanted = [x for x in ctx.plan["scenarios_parsed"] if plan_ledger.claim_of(x) == "pr" and plan_ledger.evaluator_of(x) == "ci"]
    out["scenarios"] = [x["id"] for x in wanted]
    detail = {"head": head, "ci": ci, "scenarios": out["scenarios"], "at": int(now())}
    if not head:
        return dict(out, status="no-head", why="the PR's head is unknown")
    if ci != "green":
        if not quiet:
            _gates_audit(ctx.engine, "gate.ci_record", ctx.pr, dict(detail, ok=False, why="CI is %s at the head" % ci))
        return dict(out, status="not-green", why="CI is %s at %s (only a complete, green run is recorded)" % (ci, head[:8]))
    if not wanted:
        if not quiet:   # nothing was recorded, so this is NOT proof that the recorder works (ok stays False for the preflight)
            _gates_audit(ctx.engine, "gate.ci_record", ctx.pr, dict(detail, ok=False, why="no scenario names ci"))
        return dict(out, status="nothing")
    for scenario in wanted:
        fresh = [e for e in ctx.entries if e.get("pr") == ctx.pr and e.get("scenario") == scenario["id"] and e.get("kind") == "verdict"
                 and e.get("evaluator") == "ci" and e.get("plan_hash") == ctx.plan["plan_hash"] and e.get("head") == head
                 and e.get("result") == "pass" and e.get("by") == plan_ledger.CI_RECORDER]
        if fresh:
            out["already"].append(scenario["id"])
            continue
        plan_ledger.append_entry(ctx.state, {"kind": "verdict", "pr": ctx.pr, "scenario": scenario["id"], "plan_ref": ctx.source,
                                             "plan_hash": ctx.plan["plan_hash"], "head": head, "result": "pass",
                                             "by": plan_ledger.CI_RECORDER, "evaluator": "ci",
                                             "evidence": "CI green at %s: every check run complete and passing" % head[:12]}, now())
        out["recorded"].append(scenario["id"])
    if out["recorded"] or not quiet:
        _gates_audit(ctx.engine, "gate.ci_record", ctx.pr, dict(detail, ok=True, recorded=out["recorded"], already=out["already"]))
    return dict(out, status="recorded")


def cmd_gates_ci_record(args, runner, now):
    """`gates ci-record <repo#N>`: the switchboard itself records the `ci` verdict (see ci_record_core). Any caller may run it: the
    verdict says only what GitHub's checks say, whoever asked. The daemon runs the same logic for open PRs (ci_record_pass)."""
    ns = types.SimpleNamespace(pr=args.pr, plan=getattr(args, "plan", None), ask=getattr(args, "ask", None), head=None)
    ctx = _ledger_context(ns, runner, now, True)
    got = ci_record_core(ctx, now)
    if got["status"] in ("unreadable", "no-plan", "no-head", "not-green"):
        raise LedgerCommandError("%s: nothing was recorded" % got["why"])
    if got["status"] == "nothing":
        print("CI is green at %s; the plan has no per-PR scenario that names `ci`: nothing to record" % got["head"][:8])
        return EXIT_OK
    print("CI is green at %s: recorded %s%s" % (got["head"][:8], ", ".join(got["recorded"]) or "nothing new",
                                               " (already recorded: %s)" % ", ".join(got["already"]) if got["already"] else ""))
    return EXIT_OK


# ---- the daemon pass of the ci recorder (#107): so a push does not leave `proof: test` scenarios waiting for a hand-run command.
# Shadow-safe by construction: it only records `ci` verdicts into the ledger and audit lines. It refuses nothing and writes NOTHING to
# GitHub (GET reads only). Budgeted like the triage: `calls_per_pass`, `pass_seconds`, a 3 minute cache of each repo's open-PR list (a settled PR is looked at every 15 minutes).

CI_RECORD_TTL = 900            # a settled PR (recorded, or nothing to record) is looked at again after this
CI_RECORD_LIST_TTL = 180       # the open-PR list is re-read this often: a new PR, a push or an edited body is seen within minutes
CI_RECORD_PENDING_RETRY = 60   # a PR whose checks are still running is looked at again this soon, so green is recorded within minutes
CI_RECORD_FAILED_RETRY = 180   # a failing or missing run, or a plan that does not pass yet
CI_RECORD_STATUS_FILE = "ci-record-status.json"
CI_RECORD_PR_COST = 4   # calls one PR may use: its view, the plan issue and its comments (charged up front)
CI_RECORD_RETRY = (300, 1800)   # an unreadable PR is retried after 5 minutes, doubling, to at most 30


class CiRecordState:
    def __init__(self):
        self.lists = {}     # normalised repo -> (read at, records)
        self.good = {}      # normalised repo -> (read at, records, cut): the list of the LAST read of it in this process that SUCCEEDED; a failed read removes it (memory only)
        self.checked = {}   # (normalised repo, number) -> {"list_head", "at", "retry_at", "fails"}: the LAST-CHECKED time decides
        self.recorded = 0   # verdicts this process recorded
        self.last_record = None
        self.written = 0
        self.pr_state = {}  # "owner/repo#N" -> the cached state `pr-state` shows (written to pr-state.json)
        self.pr_state_written = 0


def ci_record_pass(engine, now):
    """Run the ci recorder over the open PRs of the repos listed in `plan_gates` that carry a `PLAN:` link in their body, within the
    call and time budget. Never raises. See the comment above for what it does and does not do."""
    section = engine.config.get("plan_gates")
    if not section or not section.get("repos") or engine.state_dir is None or engine.audit is None:
        return
    cfg = section.get("ci_record") or {}
    if cfg.get("enabled") is False or gates_off_path(engine.state_dir).exists():
        return
    hub = getattr(engine, "hub", None)
    if hub is None:
        return
    repos = [name for name, entry in sorted(section["repos"].items()) if entry.get("enabled", True)]
    if not repos:
        return
    state = engine.__dict__.setdefault("ci_record_state", CiRecordState())
    started, seconds = engine.now(), cfg.get("pass_seconds", 10)
    budget = [cfg.get("calls_per_pass", 30)]
    stale = sorted(((state.lists.get(plan_ledger.normal_repo(r), (0, []))[0], r) for r in repos
                    if now - state.lists.get(plan_ledger.normal_repo(r), (0, []))[0] >= CI_RECORD_LIST_TTL))
    for _, repo in stale:
        if budget[0] < 2 or engine.now() - started >= seconds:
            break
        key = plan_ledger.normal_repo(repo)
        try:
            records, cut = hub.read_pages("repos/%s/pulls?state=open&per_page=100" % repo, cap=2)
            budget[0] -= sweep_pages_used(records, cut)
            state.lists[key] = (now, records)
            state.good[key] = (now, records, bool(cut) or len(records) >= LABEL_HOLD_LIST_CUT)
            read_mark(engine, "pulls:" + key, not cut, "the open pull request list was cut", now)   # #811
        except GitHubUnavailable as err:
            budget[0] -= 1
            read_mark(engine, "pulls:" + key, False, "the open pull request list could not be read", now)
            state.good.pop(key, None)   # a failed read is no evidence: the old list stays for the rows, never for a prune
            state.lists[key] = (now, state.lists.get(key, (0, []))[1])   # keep the old list and try again after the TTL
            engine._note("ci_record.unreadable", repo, {"repo": repo, "reason": _one_line(str(err), 160)})
    pr_state_from_lists(state, repos)
    todo = []
    for repo in repos:
        key = plan_ledger.normal_repo(repo)
        for record in state.lists.get(key, (0, []))[1]:
            number = record.get("number") if isinstance(record, dict) else None
            head = ((record.get("head") or {}).get("sha")) if isinstance(record, dict) else None
            body = record.get("body") if isinstance(record, dict) and isinstance(record.get("body"), str) else ""
            if not isinstance(number, int) or isinstance(number, bool) or not plan_ledger.PLAN_LINK_RE.search(body):   # drafts too: `gh pr ready` needs G1 present
                continue
            held = state.checked.get((key, number))
            # Skip a PR that was checked and is not yet due: decided by when it was last CHECKED (not by what the check found), so a PR
            # that is unreadable, or whose head had moved since the list, is not re-read every pass. A head the list now shows
            # differently from the one it was checked under is new news and is due at once.
            if held and held["list_head"] == head and now < held["retry_at"]:
                continue
            todo.append(((held or {"at": 0})["at"], repo, number, head))
    runner = getattr(engine, "gh_runner", None) or subprocess.run
    for _, repo, number, listed_head in sorted(todo):
        if budget[0] < CI_RECORD_PR_COST or engine.now() - started >= seconds:
            break
        budget[0] -= CI_RECORD_PR_COST
        key = (plan_ledger.normal_repo(repo), number)
        fails = (state.checked.get(key) or {}).get("fails", 0)
        try:
            ns = types.SimpleNamespace(pr="%s#%d" % (repo, number), plan=None, ask=None, head=None)
            ctx = _ledger_context(ns, runner, engine.now, True, parts=(engine, engine.state_dir, engine.config))
            got = ci_record_core(ctx, engine.now, quiet=True)
            if got["status"] == "unreadable":
                raise RuntimeError(got["why"])
            if got["recorded"]:
                state.recorded += len(got["recorded"])
                state.last_record = now
            retry_at = now + CI_RECORD_TTL
            if got["status"] == "not-green":   # the checks are running (or failed): look again soon, not in a quarter of an hour
                retry_at = now + (CI_RECORD_PENDING_RETRY if got["ci"] == "pending" else CI_RECORD_FAILED_RETRY)
            elif got["status"] == "no-plan":
                retry_at = now + CI_RECORD_FAILED_RETRY
            if got["head"] and got["head"] != listed_head:
                # the head moved since the list was read: the next list refresh will show it, so wait for that, not every pass
                retry_at = max(now + 1, state.lists.get(plan_ledger.normal_repo(repo), (now, []))[0] + CI_RECORD_LIST_TTL)
            state.checked[key] = {"list_head": listed_head, "at": now, "retry_at": retry_at, "fails": 0}
            pr_state_enrich(state, repo, number, ctx, now)
        except Exception as err:
            fails += 1
            delay = min(CI_RECORD_RETRY[1], CI_RECORD_RETRY[0] * 2 ** (fails - 1))   # unreadable: 5 min, 10, 20, then 30
            state.checked[key] = {"list_head": listed_head, "at": now, "retry_at": now + delay, "fails": fails}
            engine._note("ci_record.error", "%s#%d" % (repo, number), {"error": _one_line("%s: %s" % (type(err).__name__, err), 200),
                                                                      "retry_in": delay})
    write_ci_record_status(engine, state, now, len(repos))
    write_pr_state(engine, state, now)


# ---- `pr-state`: what the daemon already knows of a PR, for an agent that would otherwise poll GitHub in a loop. The daemon's ci recorder
# pass keeps this picture (the open-PR lists it reads anyway, and for a PR under a plan the head, checks per job and the gates it evaluates
# for the ledger); it leaves it in `pr-state.json` (0600, renamed into place, bounded). The command reads that file and the local ledger and
# makes NO call to GitHub: a PR the daemon has not cached is `unknown`, never fetched.
PR_STATE_FILE = "pr-state.json"
PR_STATE_MAX = 400          # PRs kept in the file: the most recently seen
PR_STATE_WRITE_GAP = 20     # seconds between writes of the file (unless something changed enough to matter: the pass always writes the first)


def pr_events_pass(engine, now):
    """Fold the entries the hub's verified pull_request events made into the picture and leave it for `pr-state`; a repo that is only watched (not under
    `plan_gates`) is known from the moment a PR opens (#354). Reads nothing from GitHub; never raises into the pass."""
    hub = getattr(engine, "hub", None)
    if hub is None or engine.state_dir is None or not hasattr(hub, "pr_event_snapshot"):
        return
    state = engine.__dict__.setdefault("ci_record_state", CiRecordState())
    load_pr_events().fold(state.pr_state, hub.pr_event_snapshot(), PR_STATE_MAX)
    write_pr_state(engine, state, now)


def pr_state_from_lists(state, repos):
    """The base entry of every open PR the pass's lists hold (head, draft, labels, when the list was read); a PR that left the list since is marked so."""
    for repo in repos:
        key = plan_ledger.normal_repo(repo)
        at, records = state.lists.get(key, (0, []))
        seen = set()
        for record in records:
            number = record.get("number") if isinstance(record, dict) else None
            if not isinstance(number, int) or isinstance(number, bool):
                continue
            ref = "%s#%d" % (key, number)
            seen.add(ref)
            if (state.pr_state.get(ref) or {}).get("via") == "event" and state.pr_state[ref].get("at", 0) > at:
                continue   # #354: a webhook event newer than this list read is fresher than the list
            head = (record.get("head") or {}).get("sha") if isinstance(record.get("head"), dict) else None
            labels = sorted(_plain(name, 60) for name in ((l.get("name") if isinstance(l, dict) else l) for l in (record.get("labels") if isinstance(record.get("labels"), list) else [])[:20]) if isinstance(name, str) and name)   # label names are GitHub's, set by anyone who can label: one line, no control characters, bounded
            old = state.pr_state.get(ref) or {}
            entry = {"state": "draft" if record.get("draft") else "open", "head": head, "labels": labels, "at": at, "listed_at": at}
            if old.get("head") == head and old.get("checks") is not None:   # what the examination found at this very head stays until it is examined again
                entry.update({k: old[k] for k in ("checks", "ci", "mergeable", "gates", "examined_at", "examined_head") if k in old})
            state.pr_state[ref] = entry
        for ref, old in list(state.pr_state.items()):
            if ref.startswith(key + "#") and ref not in seen and old.get("state") in ("open", "draft") and at > old.get("listed_at", 0):
                state.pr_state[ref] = dict(old, state="gone", at=at, why="no longer in the open list (merged or closed)")


def pr_state_enrich(state, repo, number, ctx, now):
    """What one examination of a PR under a plan adds: its checks per job, CI, mergeability, and the gates the ledger evaluates (ready, what is missing)."""
    ref = "%s#%d" % (plan_ledger.normal_repo(repo), number)
    entry = state.pr_state.get(ref)
    facts = ctx.facts or {}
    if entry is None or not facts.get("head"):
        return
    entry.update({"checks": facts.get("checks") or [], "ci": facts.get("ci"), "mergeable": facts.get("mergeable"), "examined_at": now, "at": now,
                  "examined_head": facts.get("head")})
    if facts.get("state") in ("merged", "closed"):
        entry["state"] = facts["state"]
    try:
        report = plan_ledger.evaluate_gates(ctx.plan, ctx.entries, ctx.problem, facts, ctx.pr, now=now)
        missing = [_plain("%s %s" % (g["gate"], m), 160) for g in report.get("gates", []) if g.get("tracked") and g.get("status") == "missing" for m in g.get("missing", [])][:12]
        entry["gates"] = {"ready": bool(report.get("ready")), "missing": missing}
    except Exception as err:   # the picture is best effort: the gates are said not evaluated (not "no plan"), never guessed
        entry["gates"] = {"error": _one_line("%s: %s" % (type(err).__name__, err), 120)}


def write_pr_state(engine, state, now):
    """After a pass: leave the picture where `pr-state` reads it (renamed into place, 0600, bounded). Never raises."""
    if not state.pr_state or (state.pr_state_written and now - state.pr_state_written < PR_STATE_WRITE_GAP):
        return
    state.pr_state_written = now
    try:
        newest = sorted(state.pr_state.items(), key=lambda kv: kv[1].get("at", 0), reverse=True)[:PR_STATE_MAX]
        body = {"written_at": int(now), "daemon_pid": os.getpid(), "prs": dict(newest)}
        path = Path(engine.state_dir) / PR_STATE_FILE
        state_write(path, json.dumps(body, sort_keys=True), _without(body, "written_at", "daemon_pid"), HEARTBEAT_PR_STATE, fsync=True, nofollow=True)   # only when the picture changed (or every 5 minutes)
    except OSError as err:
        engine._note("pr_state.error", None, {"error": _one_line("%s: %s" % (type(err).__name__, err), 160)})   # `_note` says it once per change of the error; the age on every line shows a stale file


PR_STATE_EXAMINED_STALE = 600   # seconds: checks and gates examined longer ago than this are shown as STALE, never READY-looking without their age
PR_STATE_READ_MAX = 2 * 1024 * 1024   # the file the daemon writes is far smaller; past this it is not one


def pr_state_read(state_dir, now):
    """(body, why): the file the daemon left, or (None, why) when there is none or it is not one."""
    try:
        with open(str(Path(state_dir) / PR_STATE_FILE)) as handle:
            text = handle.read(PR_STATE_READ_MAX + 1)
        if len(text) > PR_STATE_READ_MAX:
            return None, "the snapshot is larger than any the daemon writes"
        body = json.loads(text)
        if isinstance(body, dict) and isinstance(body.get("prs"), dict) and _finite(body.get("written_at")):
            return body, None
        return None, "the snapshot is not a pr-state file"
    except FileNotFoundError:
        return None, "no snapshot: the daemon is not running, or has not passed over a watched repo yet"
    except (OSError, ValueError):
        return None, "the snapshot cannot be read"


def _finite(value):
    """True for a real finite number (json.loads accepts NaN and Infinity; a bool is not a time)."""
    return isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value)


def _text(value, limit):
    """`value` as plain bounded text when it is a string, else None."""
    return _plain(value, limit) if isinstance(value, str) else None


def pr_state_view(ref, body, entries, now, ledger_ref=None, ledger_problem=None):
    """The answer for `ref` (`owner/repo#N`) as a dict, from the snapshot and the local ledger only. Every string in it is plain bounded text and
    every field is shape-checked: the snapshot is a same-user file, not a boundary, and a malformed entry is `unknown`, never a traceback."""
    entry = (body or {}).get("prs", {}).get(ref) if isinstance((body or {}).get("prs"), dict) else None
    unknown = {"pr": ref, "known": False, "why": "not watched, or not cached by the daemon yet"}
    if entry is None:
        return unknown
    if not isinstance(entry, dict) or not _finite(entry.get("at", 0)):
        return dict(unknown, why="the snapshot's entry for it is malformed")
    head, examined = _text(entry.get("head"), 40), _text(entry.get("examined_head"), 40)
    reviews = [] if not ledger_problem else None   # None: not known (the ledger could not be read), which is not "none recorded"
    if head and reviews is not None:
        for reviewer in plan_ledger.REVIEWERS_NOW:
            found = [e for e in entries if e.get("kind") == "review_record" and e.get("pr") == (ledger_ref or ref) and e.get("head") == entry.get("head") and e.get("reviewer") == reviewer]
            if found:
                reviews.append(dict({"reviewer": reviewer, "verdict": _text(found[-1].get("verdict"), 20), "head": head}, **({"uncited": True} if found[-1].get("uncited") is True else {})))
    stale_head = bool(examined and head and examined != head)   # what was examined belongs to another head: it is not shown as this head's
    checks = None
    if isinstance(entry.get("checks"), list) and not stale_head:
        checks = [{"name": _text(c.get("name"), 60) or "?", "conclusion": _text(c.get("conclusion"), 30) or "?"} for c in entry["checks"][:30] if isinstance(c, dict)]
    gates = entry.get("gates") if isinstance(entry.get("gates"), dict) and not stale_head else None
    if gates is not None:
        gates = {"ready": gates.get("ready") is True, "missing": [_plain(m, 160) for m in (gates.get("missing") if isinstance(gates.get("missing"), list) else [])[:12] if isinstance(m, str)]}
        if isinstance(entry["gates"].get("error"), str):
            gates = {"error": _plain(entry["gates"]["error"], 120)}
    at = entry.get("at", now)
    examined_at = entry.get("examined_at")
    examined_age = max(0, int(now - examined_at)) if _finite(examined_at) and not stale_head else None
    view = {"pr": ref, "known": True, "state": _text(entry.get("state"), 20), "head": head, "mergeable": None if stale_head else _text(entry.get("mergeable"), 20),
            "ci": None if stale_head else _text(entry.get("ci"), 20), "checks": checks, "examined_head": examined,
            "labels": [name for name in (_plain(l, 60) for l in (entry.get("labels") if isinstance(entry.get("labels"), list) else [])[:20] if isinstance(l, str)) if name],
            "gates": gates, "reviews": reviews, "reviews_problem": _text(ledger_problem, 100) if ledger_problem else None,
            "age_seconds": max(0, int(now - at)), "examined_age_seconds": examined_age, "examined_stale": bool(examined_age is not None and examined_age > PR_STATE_EXAMINED_STALE),
            "snapshot_age_seconds": max(0, int(now - body["written_at"]))}
    if isinstance(entry.get("why"), str):
        view["why"] = _plain(entry["why"], 100)
    return view


def _age_text(seconds):
    return "%ds" % seconds if seconds < 120 else "%dm" % (seconds // 60) if seconds < 7200 else "%dh" % (seconds // 3600)


def pr_state_line(view):
    """One line for a view. The checks and gates come from an EXAMINATION that can be older than the list that says the PR is open: their own
    age is printed next to them, and past PR_STATE_EXAMINED_STALE they say STALE, so a READY never shows without how old it is."""
    if not view.get("known"):
        return "%s: unknown (%s); nothing was read from GitHub" % (view["pr"], view["why"])
    parts = [view["pr"], view.get("state") or "?", "head %s" % (view["head"] or "?")[:8]]
    if view.get("mergeable"):
        parts.append("mergeable %s" % view["mergeable"].lower())
    if view.get("checks") is not None:
        parts.append("CI %s%s (%s)" % (_plain(view.get("ci") or "?", 20), "" if view.get("examined_age_seconds") is None else " examined %s ago%s" % (_age_text(view["examined_age_seconds"]), "; STALE" if view.get("examined_stale") else ""), ", ".join("%s: %s" % (_plain(c.get("name"), 60), _plain(c.get("conclusion"), 30)) for c in (view["checks"] if isinstance(view["checks"], list) else [])[:8] if isinstance(c, dict)) or "no checks"))
    elif view.get("examined_head") and view["examined_head"] != view["head"]:
        parts.append("CI not examined at this head (last examined at %s)" % view["examined_head"][:8])
    else:
        parts.append("CI not examined")
    gates = view.get("gates")
    examined = view.get("examined_age_seconds")
    suffix = "" if examined is None else " [examined %s ago%s]" % (_age_text(examined), "; STALE" if view.get("examined_stale") else "")
    if gates is None:
        parts.append("gates unknown (no plan examined)")
    elif "error" in gates:
        parts.append("gates unknown (not evaluated: %s)" % gates["error"])
    else:
        parts.append("gates %s%s" % ("READY" if gates["ready"] else "NOT (%s)" % ("; ".join(_plain(m, 160) for m in gates["missing"][:4]) or "see `gates`"), suffix))
    if view.get("reviews") is None:
        parts.append("reviews unknown (ledger unreadable: %s)" % _plain(view.get("reviews_problem") or "?", 100))
    else:
        parts.append("reviews %s" % (", ".join("%s %s%s" % (_plain(r["reviewer"], 20), _plain(r["verdict"], 20), " (names no rule, does not block)" if r.get("uncited") else "") for r in view["reviews"]) or "none recorded at this head"))
    parts.append("labels %s" % (", ".join(_plain(l, 60) for l in view["labels"]) or "none"))
    parts.append("list read %ds ago" % view["age_seconds"])
    if view.get("why"):
        parts.append(view["why"])
    return "; ".join(parts)


def cmd_pr_state(args, runner, now):
    """`pr-state <owner/repo#N>`: what the daemon already knows, from its cache and the local ledger: ZERO GitHub calls, one line (or --json).
    `unknown` when the daemon has no data for the PR (never fetched to fill it); fails soft when the daemon has left no snapshot."""
    try:
        repo, number, typed = _ledger_pr(args)
        ref = "%s#%d" % (plan_ledger.normal_repo(repo), number)
    except (LedgerCommandError, ValueError) as err:
        sys.stderr.write("%s: pr-state: %s\n" % (PROG, _one_line(str(err), 200)))
        return EXIT_USAGE
    state = ensure_state_dir()
    body, why = pr_state_read(state, now())
    if body is None:
        print(json.dumps({"pr": ref, "known": False, "why": why}, sort_keys=True) if args.json else "%s: unknown (%s); nothing was read from GitHub" % (ref, why))
        return EXIT_OK
    entries, problem = plan_ledger.read_ledger(state)
    view = pr_state_view(ref, body, entries, now(), typed, problem)
    print(json.dumps(view, sort_keys=True) if args.json else pr_state_line(view))
    return EXIT_OK


cmd_pr_state.direct = True   # reads a file: no daemon start, no GitHub


def add_pr_state_parsers(sub):
    state = sub.add_parser("pr-state", help="One line of what the daemon already knows of a PR: head, state, checks per job, gates, reviews, labels (zero GitHub calls)",
                           description="Reads the daemon's cached picture of the PR (pr-state.json) and the local ledger, and prints one line. It never calls GitHub: "
                                       "a PR the daemon has not cached is 'unknown'. Use it instead of polling GitHub in a shell loop; wait with `remind`.")
    state.add_argument("pr", help="The pull request: owner/repo#N or its URL")
    state.add_argument("--json", action="store_true", help="The same, as one JSON object")


def write_ci_record_status(engine, state, now, repos):
    """What `status` shows of the daemon pass: the daemon is the one writer. At most once a minute, unless a verdict was just recorded."""
    if state.written and now - state.written < 60 and state.last_record != now:
        return
    state.written = now
    body = {"at": int(now), "repos": repos, "recorded": state.recorded,
            "last_record": None if state.last_record is None else int(state.last_record)}
    try:
        state_write(Path(engine.state_dir) / CI_RECORD_STATUS_FILE, json.dumps(body, sort_keys=True), _without(body, "at"), STATE_HEARTBEAT_SECONDS)
    except OSError:
        pass   # a status line is best effort


def ci_record_status_line(state_dir, now_ts):
    """The `status` line for the daemon's ci recorder pass, or None when it has never run."""
    try:
        raw = json.loads((Path(state_dir) / CI_RECORD_STATUS_FILE).read_text())
        at, recorded = float(raw["at"]), int(raw["recorded"])
    except (OSError, ValueError, KeyError, TypeError):
        return None
    ago = max(0, int(now_ts - at))
    last = raw.get("last_record")
    return "ci-record: last pass %s (%s ago), recorded %d since the daemon started%s" % (
        iso(at), "%d s" % ago if ago < 120 else "%d min" % (ago // 60), recorded,
        "; last record " + iso(last) if isinstance(last, (int, float)) else "")


def v2_link_status_line(state_dir, now_ts):
    """The `status` line for the daemon's link to the OpenCode service (route and breaker; the call counts are the `v2 calls` line), or None."""
    try:
        raw = json.loads((Path(state_dir) / V2_LINK_STATUS_FILE).read_text())
        at, fallbacks, skipped = float(raw["at"]), int(raw["fallbacks"]), int(raw["skipped"])
        transport, breaker = str(raw["transport"])[:8], str(raw["breaker"])[:8]
    except (OSError, ValueError, KeyError, TypeError):
        return None
    ago = max(0, int(now_ts - at))
    p95 = raw.get("p95_ms")
    return "v2-link: %s (%s ago): %d fell back to the CLI in the last 10 min; breaker %s%s%s" % (
        transport, "%d s" % ago if ago < 120 else "%d min" % (ago // 60), fallbacks,
        "CLOSED" if breaker == "closed" else "OPEN: optional reads are being skipped (v2.backoff), %d so far" % skipped,
        "; p95 %d ms" % p95 if isinstance(p95, int) else "", "; %s episode(s) so far" % raw.get("episodes") if raw.get("episodes") else "")


def cmd_gates_preflight(args, runner, now):
    config = load_config()
    blocking, notes = plan_ledger.preflight(config, args.pr, lambda: ci_recorder_proven(ensure_state_dir(), now()), cos_ready_check)
    setting = plan_ledger.repo_setting(config, args.pr)
    print("preflight for enforcing %s: %s" % (args.pr, "BLOCKED" if blocking else "nothing blocks it"))
    print("  enforced gates: %s (others are reported, not enforced; set `enforce_gates` in plan_gates to change)"
          % ", ".join((setting or {}).get("enforce_gates") or plan_ledger.DEFAULT_ENFORCED))
    for line in blocking:
        print("  blocking: %s" % line)
    for line in notes:
        print("  note: %s" % line)
    return EXIT_ERROR if blocking else EXIT_OK


def plan_gates_status(config, state, now_ts):
    """{"line": ..., "repos": {...}, "killed": bool} for `status`."""
    section = (config or {}).get("plan_gates") if isinstance(config, dict) else None
    killed = bool(state) and gates_off_path(state).exists()
    out = {"killed": killed, "repos": {}, "lines": []}
    if killed:
        out["lines"].append("PLAN GATES: the global kill file exists (%s): every repo is OFF. `%s gates on` removes it" % (GATES_OFF_FILE, PROG))
    if not section or not section.get("repos"):
        if killed:
            return out
        return None
    counts = gates_state(state, now_ts)["repos"] if state else {}
    for name, entry in sorted(section["repos"].items()):
        c = counts.get(plan_ledger.normal_repo(name), {})
        label = "off (kill switch)" if not entry["enabled"] else entry["mode"]
        if entry["enabled"] and entry["mode"] == "enforce":
            actual, why = plan_ledger.effective_mode(config, dict(entry, name=name), lambda: ci_recorder_proven(state, now_ts))
            if why:
                label = "enforce REQUESTED but running as shadow (%s)" % why
        out["repos"][name] = dict(entry, counts=c)
        if entry["enabled"] and entry["mode"] == "enforce":
            label += " on " + ", ".join(entry.get("enforce_gates") or plan_ledger.DEFAULT_ENFORCED)
        out["lines"].append("plan gates %s: %s; today %d check(s), %d refusal(s), %d would-refuse, %d fail-open(s)" % (
            name, label, c.get("checks", 0), c.get("refusals", 0), c.get("would_refuse", 0), c.get("fail_opens", 0)))
    return out


def add_ledger_parsers(sub):
    def common(p, scenario=True, multi=False):
        if scenario:
            p.add_argument("scenario", nargs="+" if multi else None, help="The scenario id in the plan (S1, U2, ...)")
            p.add_argument("--pr", required=True, help="The pull request: owner/repo#N or its URL")
        else:
            p.add_argument("pr", help="The pull request: owner/repo#N or its URL")
        p.add_argument("--plan", help="The plan: owner/repo#N or an issue URL (default: the one the PR's ledger entries "
                                      "name, else the `PLAN:` line of the PR body)")
        p.add_argument("--ask", help="The ask whose Done-when the plan must cover (as `plan check --ask`)")
        p.add_argument("--head", help="The PR head sha (default: read from GitHub)")
    prove = sub.add_parser("prove", help="Record proof for a plan scenario of a PR, at its head, bound to the plan's hash")
    common(prove, multi=True)
    prove.add_argument("--evidence", required=True, help="A link, or what you ran and saw")
    prove.add_argument("--result", choices=("pass", "fail"), default="pass")
    prove.add_argument("--command", help="The command you ran, if any")
    verdict = sub.add_parser("verdict", help="Record an evaluator's verdict for a scenario (only the evaluator the "
                                             "scenario names, never a writer of the PR)")
    common(verdict)
    for action in verdict._actions:
        if action.dest == "scenario":
            action.nargs, action.default = "?", None   # `--all` takes no scenario id
    verdict.add_argument("--all", dest="all_scenarios", action="store_true",
                         help="Record the verdict for EVERY per-PR scenario of the plan judged by --as, at the current head (no scenario id)")
    verdict.add_argument("--as", dest="evaluator", required=True, choices=("ci", "tester", "reviewer", "owner"))
    verdict.add_argument("--result", choices=("pass", "fail"), required=True)
    verdict.add_argument("--evidence", required=True, help="A link, or the evaluator's own artefact")
    # #770: a work item with no pull request has its own commands (the pull request commands above keep their exact surface)
    iprove = sub.add_parser("item-prove", help="Record proof for a plan scenario of a work item that has no pull request, at its reference commit")
    iverdict = sub.add_parser("item-verdict", help="A tester registered for a work item (by its orchestrator's launch) records its verdict, at the item's reference commit")
    for p in (iprove, iverdict):
        p.add_argument("scenario", nargs="+" if p is iprove else "?", default=None if p is iverdict else argparse.SUPPRESS, help="The scenario id in the item's plan (S1, U2, ...)")
        p.add_argument("--item", required=True, help="The work item: owner/repo#N of an ISSUE (a pull request is refused: use prove/verdict --pr)")
        p.add_argument("--plan", help="Only repeats the plan the issue body links with `PLAN:`")
        p.add_argument("--ask", help="The ask whose Done-when the plan must cover")
        p.add_argument("--head", help="The item's reference commit (default: the one pinned at registration)")
        p.add_argument("--evidence", required=True, help="A link, or what you ran and saw")
    iprove.add_argument("--result", choices=("pass", "fail"), default="pass")
    iprove.add_argument("--command", help="The command you ran, if any")
    iverdict.add_argument("--all", dest="all_scenarios", action="store_true", help="Every scenario of the plan this item may claim and the tester judges")
    iverdict.add_argument("--as", dest="evaluator", default="tester", choices=("tester",), help="Only tester verdicts: `ci` is recorded by `gates item-ci-record`")
    iverdict.add_argument("--result", choices=("pass", "fail"), required=True)
    waive = sub.add_parser("waive", help="The chief of staff's logged override of gates G0 to G5 for one PR at its head (a hotfix); "
                                         "never G6, G7 or G8, never by a writer of the PR",
                           description="Waive gates G0 to G5 for ONE PR at its CURRENT head, for a hotfix: the chief of staff (or a "
                                       "person at a shell) only, with a reason of at least 20 characters, never G6, G7 or G8 and never "
                                       "by a writer of the PR. A ledger entry and an audit line; it lasts 24 hours (the retroactive "
                                       "plan is due then) and a push needs a new one. `gates` shows the gate as waived, not passed.")
    waive.add_argument("pr", help="The pull request: owner/repo#N or its URL")
    waive.add_argument("--gates", required=True, help="Comma-separated gates: G0a,G0b,G0c,G1,G2/G3,G4,G5, or MG (the merge gate, #962)")
    waive.add_argument("--reason", required=True, help="Why (at least %d characters)" % plan_ledger.WAIVER_REASON_MIN)
    waive.add_argument("--head", help="The PR head sha (default: read from GitHub)")
    gates = sub.add_parser("gates", help="Read-only: the plan's gates G0a to G8 for a PR, what each needs and who decides it. "
                                         "Also `gates mode <repo> shadow|enforce|off`, `gates off|on` (the global kill file) and "
                                         "`gates preflight <repo>`. May add one `shares <file> with #N` line when another open PR changes the same files "
                                         "(one read of at most 50 open PRs and 100 files each; information only)")
    common(gates, scenario=False)
    gates.add_argument("rest", nargs="*", help="With `mode`: <owner/repo> <shadow|enforce|off>")
    gates.add_argument("--json", action="store_true")
    gates.add_argument("--limit", type=int, default=10, help="With `stats`: how many merged PRs to show (default 10)")
    gates.add_argument("--all", dest="all_gates", action="store_true",
                       help="Exit by the whole board, not only the gates the repo enforces")
    check = sub.add_parser("gates-check", help="Is a ready or a merge allowed? Read-only: exit 0 allow, 10 refuse, anything else "
                                               "a fail-open. Only exit 10 refuses. Nothing calls it yet")
    check.add_argument("pr", help="The pull request: owner/repo#N or its URL")
    check.add_argument("--for", dest="check_for", required=True, choices=plan_ledger.CHECK_FOR)
    check.add_argument("--plan")
    check.add_argument("--ask")
    check.add_argument("--json", action="store_true")


# ---------------------------------------------------------------- `review-laws install` (#179, slice L1)

REVIEW_LAWS_FILES = ("REVIEW_LAWS.md", "CODING_STANDARDS.md", "SECURITY_STANDARDS.md", "TEST_STANDARDS.md")
REVIEW_LAWS_EDIT = {
    "REVIEW_LAWS.md": "the verdict format, the matrix cells you tighten (never loosen), and the floor paths your repository names",
    "CODING_STANDARDS.md": "add the rules your repository's own code needs; remove none without saying why",
    "SECURITY_STANDARDS.md": "add the rules for your repository's own identities, secrets and permissions",
    "TEST_STANDARDS.md": "add how your repository's tests are run in CI and what they must cover",
}


def review_laws_source():
    return Path(os.path.realpath(__file__)).parent.parent / "docs" / "review-laws"


def cmd_review_laws(args, runner, now):
    """`review-laws install <repo path>`: copy the generic starter set (REVIEW_LAWS.md, CODING_STANDARDS.md, SECURITY_STANDARDS.md,
    TEST_STANDARDS.md, each opening with `extends: fleet-kit-review-laws @ review-laws-<n>`) to the root of a repository and say what to edit. It
    writes only those files, never overwrites one the repository already has (`--force` replaces it), and touches nothing else (not
    AGENTS.md: the laws must not contradict it, so the pointer line is the repository's own edit)."""
    source = review_laws_source()
    try:
        version = (source / "VERSION").read_text().strip()
        texts = {name: (source / name).read_text() for name in REVIEW_LAWS_FILES}
    except OSError as err:
        sys.stderr.write("%s: review-laws: the starter set is not readable (%s): %s\n" % (PROG, source, getattr(err, "strerror", None) or err))
        return EXIT_USAGE
    target = Path(args.repo).expanduser()
    if not target.is_dir():
        sys.stderr.write("%s: review-laws: %s is not a directory\n" % (PROG, args.repo))
        return EXIT_USAGE
    header = "extends: fleet-kit-review-laws @ %s" % version
    bad = [n for n, text in texts.items() if text.splitlines()[0] != header]
    if bad:
        sys.stderr.write("%s: review-laws: the starter set is inconsistent: %s do not open with %r\n" % (PROG, ", ".join(bad), header))
        return EXIT_USAGE
    links = [n for n in REVIEW_LAWS_FILES if os.path.islink(str(target / n))]   # a link (even a dangling one) is never replaced, forced or not
    if links:
        sys.stderr.write("%s: review-laws: %s is a symbolic link in %s: nothing was written (a link could send the copy somewhere else; remove it yourself)\n"
                         % (PROG, ", ".join(links), target))
        return EXIT_USAGE
    existing = [n for n in REVIEW_LAWS_FILES if os.path.lexists(str(target / n))]
    if existing and not args.force:
        sys.stderr.write("%s: review-laws: %s already has %s: nothing was written (the repository's own copies are its law; --force replaces them)\n"
                         % (PROG, target, ", ".join(existing)))
        return EXIT_USAGE
    written = []
    for name in REVIEW_LAWS_FILES:
        temp = target / (".%s.%d.tmp" % (name, os.getpid()))
        try:
            temp.write_text(texts[name])
            os.replace(str(temp), str(target / name))
        except OSError as err:
            try:
                temp.unlink()
            except OSError:
                pass
            sys.stderr.write("%s: review-laws: could not write %s: %s (written so far: %s)\n"
                             % (PROG, name, getattr(err, "strerror", None) or err, ", ".join(written) or "none"))
            return EXIT_ERROR
        written.append(name)
    lines = ["review laws (%s) installed in %s. What to edit:" % (version, target)] + ["  %s: %s" % (n, REVIEW_LAWS_EDIT[n]) for n in written]
    lines.append("Next: keep the `extends:` line (it says which version you started from); make sure the laws do not contradict your AGENTS.md "
                 "(leave a pointer line there for any hygiene rule you moved); reviewers read these files from the base branch of a pull request.")
    if (target / "AGENTS.md").exists():
        lines.append("Your repository has an AGENTS.md: it was not touched.")
    print("\n".join(lines))
    return EXIT_OK


cmd_review_laws.direct = True   # no error mapping, no daemon start


# ---------------------------------------------------------------- `review record` and `review laws` (#179, slice L2)

REVIEW_LAW_FILES = REVIEW_LAWS_FILES + ("REVIEW_OVERLAY.md",)   # the laws a reviewer loads, and the repository's own overlay
REVIEW_FILE_MAX = 30000      # bytes of one law file a reviewer is shown
REVIEW_TOTAL_MAX = 90000     # bytes of all of them together


def _review_pr(args, engine):
    """(repo, number, ref, raw) of the PR in `args`, read with the PR's own account; raises ReviewError."""
    bare = args.review_cmd == "laws" and _BARE_PR.match((args.pr or "").strip())
    try:
        repo, number = parse_bare_pr_ref(args.pr) if bare else parse_pr_ref(args.pr)
    except NoticeError as err:
        raise ReviewError(str(err)) from None
    try:
        raw = read_pr_json(engine, repo, number, "baseRefOid,baseRefName,files")
    except NoticeError as err:
        if bare and isinstance(err, NoticeNotFound):
            err = "%s: %s does not name a pull request: pass owner/repo#N or the PR's URL" % (err, _one_line(args.pr, 40))
        raise ReviewError(str(err)) from None
    return repo, number, "%s#%d" % (repo, number), raw


def review_laws_text(engine, config, runner, now, repo, base_sha):
    """The review laws of `repo` AS THEY STAND AT `base_sha` (the PR's base commit, never its head: a PR cannot rewrite the law it is judged
    by), then the repository's overlay and a local overlay kept outside the repository. Returns (text, missing files)."""
    reader = IntentReader(config["gh"], repo, runner, now, config["call_timeout_seconds"], accounts=GhAccounts(config, runner, now))
    parts, missing, total = [], [], 0
    for name in REVIEW_LAW_FILES:
        try:
            got = reader._api("repos/%s/contents/%s?ref=%s" % (repo, name, base_sha), repo)
        except IntentError:
            missing.append(name)
            continue
        raw = got.get("content") if isinstance(got, dict) else None
        if not isinstance(raw, str) or got.get("encoding") != "base64":
            missing.append(name)
            continue
        try:
            text = base64.b64decode(raw).decode("utf-8", "replace")
        except ValueError:
            missing.append(name)
            continue
        if len(text.encode("utf-8")) > REVIEW_FILE_MAX:
            text = text.encode("utf-8")[:REVIEW_FILE_MAX].decode("utf-8", "ignore") + "\n[cut at %d bytes]" % REVIEW_FILE_MAX
        total += len(text)
        if total > REVIEW_TOTAL_MAX:
            missing.append(name + " (over the total size limit)")
            continue
        parts.append("===== %s (from %s at the base commit %s) =====\n%s" % (name, repo, base_sha[:12], text))
    local = local_review_overlay(repo)
    if local:
        parts.append("===== local overlay for %s (kept outside the repository) =====\n%s" % (repo, local))
    return "\n\n".join(parts), missing


def local_review_overlay(repo):
    """The operator's own overlay for `repo`, if one exists: $XDG_CONFIG_HOME/fleet-switchboard/review-overlay/<owner>__<repo>.md (capped)."""
    path = config_path().parent / "review-overlay" / (repo.replace("/", "__").lower() + ".md")
    try:
        return path.read_text(encoding="utf-8")[:REVIEW_FILE_MAX]
    except (OSError, UnicodeError):
        return ""


def parse_review_block(text):
    """(fields, why not) from the verdict block a reviewer RETURNS as text (the reviewers hold no write command: the coder session records what
    they returned). Lines: `verdict: ...`, `head: <sha>`, optional `impact-action: ...`, `findings:` and one `- <rule> | block|note | ...` per finding. Counts
    come from the findings, so a block cannot claim a count it does not list. A block may sit inside a code fence or prose; the first one found is read."""
    if not isinstance(text, str) or not text.strip():
        return None, "no verdict block"
    lines = [l.strip() for l in text.splitlines()]
    fields = {"verdict": None, "head": None, "impact_action": None, "impact_class": None, "impact_severity": None, "impact_probability": None, "impact_reason": None, "blocks": 0, "notes": 0, "findings": 0, "files_read": [], "files_problem": None, "block_count": 0}
    started, section = False, "findings"
    for line in lines:
        if started and line.startswith("verdict:"):
            fields["block_count"] += 1   # #1126: a second `verdict:` line before the block ends opens another block (`--block` keeps reading the first verdict and the last rating)
        if line.startswith("verdict:") and not started:
            fields["verdict"], started = line.split(":", 1)[1].strip(), True
        elif started and line.startswith("head:"):
            fields["head"] = line.split(":", 1)[1].strip()
        elif started and line.startswith("impact-action:"):
            fields["impact_action"] = line.split(":", 1)[1].strip()
        elif started and line.startswith("impact-class:"):
            fields["impact_class"] = line.split(":", 1)[1].strip().lower()
        elif started and line.startswith("impact-severity:"):
            fields["impact_severity"] = line.split(":", 1)[1].strip()
        elif started and line.startswith("impact-probability:"):
            fields["impact_probability"] = line.split(":", 1)[1].strip()
        elif started and line.startswith("impact-reason:"):
            fields["impact_reason"] = line.split(":", 1)[1].strip()
        elif started and line.startswith("files-read:"):
            section = "files"
        elif started and line.startswith("findings:"):
            section = "findings"
        elif started and section == "files" and line.startswith("- "):
            row = parse_files_read_row(line[2:]) if len(fields["files_read"]) < FILES_READ_ROWS_MAX else None
            if row is None:
                fields["files_problem"] = fields["files_problem"] or "a `files-read:` row is not `- <path> | <lines read> | <lines in its diff>` (numbers): %r" % line[:80]
            else:
                fields["files_read"].append(row)
        elif started and line.startswith("- "):
            parts = [p.strip() for p in line[2:].split("|")]
            if len(parts) >= 2 and parts[1] in ("block", "note"):
                fields["findings"] += 1
                if parts[1] == "block":
                    if not re.fullmatch(r"R-[A-Z]+-[0-9]+", parts[0]) and not re.fullmatch(r"[A-Za-z0-9_.-]+-[0-9]+", parts[0]):
                        fields["notes"] += 1   # a blocking finding that cites no rule is counted as a note; the verdict itself is recorded as given and marked uncited (#1047)
                    else:
                        fields["blocks"] += 1
                else:
                    fields["notes"] += 1
        elif started and line.startswith("```"):
            break
    if not started or fields["verdict"] not in plan_ledger.REVIEW_VERDICTS:
        return None, "the block has no `verdict:` line with one of %s" % ", ".join(plan_ledger.REVIEW_VERDICTS)
    if not fields["head"] or not re.fullmatch(r"[0-9a-f]{7,40}", fields["head"]):
        return None, "the block has no `head: <sha>` line: say which commit was judged"
    if fields["impact_action"] not in (None, "hold", "second-review", "none"):
        return None, "`impact-action:` must be hold, second-review or none"
    if fields["impact_class"] is not None and not IMPACT_CLASS_RE.fullmatch(fields["impact_class"]):
        return None, "`impact-class:` must be one lower-case word naming the class of the impact (see the matrix file's classes)"
    return fields, None


def pr_changed_paths(raw):
    """(paths, None) of the pull request's changed files from GitHub's own list, or (None, why) when that list is not whole: the same test `pr_floor_report` makes (`changedFiles` against the files listed)."""
    files = raw.get("files")
    if not isinstance(files, list):
        return None, "GitHub's list of changed files could not be read"
    paths = [f.get("path") for f in files if isinstance(f, dict) and isinstance(f.get("path"), str)]
    total = raw.get("changedFiles") if isinstance(raw.get("changedFiles"), int) else len(paths)
    if len(paths) < total or raw.get("truncated"):
        return None, "GitHub listed %d of %d changed files" % (len(paths), total)
    return paths, None


def parse_files_read_row(text):
    """(path, lines read, lines in its diff) from `<path> | <lines read> | <lines in its diff>`, or None when it is not that shape."""
    parts = [p.strip() for p in text.rsplit("|", 2)]
    if len(parts) != 3 or not parts[0] or not parts[1].isdigit() or not parts[2].isdigit() or len(parts[1]) > 9 or len(parts[2]) > 9:
        return None
    return parts[0], int(parts[1]), int(parts[2])


FILES_READ_ROWS_MAX = 5000   # the most `files-read:` rows a block may list (the checkout's own file limit)
RATER_CHUNK_LINES = 200   # #1047: the ONE chunk size (diff lines) a rater reads at a time, under the ~280 lines where recorded reads were cut; the agent definition and the refusal text render it from here


def pr_changed_bounds(raw):
    """{path: additions + deletions} from GitHub's own per-file list: a diff has at least that many lines, so no honest count of one is lower (a file with no counts, or none given, is 0)."""
    out = {}
    for f in raw.get("files") or []:
        if isinstance(f, dict) and isinstance(f.get("path"), str):
            out[f["path"]] = sum(f[k] for k in ("additions", "deletions") if isinstance(f.get(k), int) and not isinstance(f.get(k), bool) and f[k] > 0)
    return out


def whole_read_problem(files_read, listed, bounds=None):
    """Why a rater's files-read rows are not a whole read of the pull request's changed files `listed` (GitHub's list: paths), or None. Names the missing files and the first unread line.
    `bounds` ({path: additions + deletions} from GitHub's list) is the least a diff can hold: a row whose total or lines read is below it is refused, whatever the rater's own total says."""
    rows = {}
    for path, read, total in files_read:
        rows[path] = (max(read, rows[path][0]) if path in rows else read, max(total, rows[path][1]) if path in rows else total)
    missing = [p for p in listed if p not in rows]
    if missing:
        return "the files-read list is shorter than the pull request's changed files: not read: %s (first unread line: 1 of each)" % ", ".join(_printable_path(p) for p in missing[:10])
    for path in listed:
        read, total = rows[path]
        bound = (bounds or {}).get(path, 0)
        if total < bound or read < bound:
            return "%s: the row says %d lines read of %d in its diff, but GitHub counts %d added and deleted lines, so its diff has at least %d (the bound): read it again to its last line and count them" % (_printable_path(path), read, total, bound, bound)
        if read < total:
            return "%s was read to line %d of %d: the first unread line is line %d (chunks of %d lines; read every file to its last line)" % (_printable_path(path), read, total, read + 1, RATER_CHUNK_LINES)
    return None


IMPACT_CLASS_RE = re.compile(r"[a-z][a-z-]{0,31}")
IMPACT_RATING_FIELDS = ("impact_severity", "impact_probability", "impact_reason")   # the record's rating fields: the code's one table (parse, record, flags)
# #895: `review record --block`: the ONE table of which flags go with it. The refusal, the `--block` help and the impact reviewer's agent definition all say BLOCK_TABLE_TEXT (rendered here, never retyped).
BLOCK_FLAG_TABLE = (   # (flag, dest, mode): `refused` (the block carries it: giving it is an error), `accepted` (goes with --block), `wins` (accepted, and the flag wins over the block's own line)
    ("--reviewer", "reviewer", "accepted"), ("--summary", "summary", "accepted"),
    ("--verdict", "verdict", "refused"), ("--head", "head", "refused"), ("--blocks", "blocks", "refused"), ("--notes", "notes", "refused"), ("--impact-action", "impact_action", "refused"),
    ("--impact-class", "impact_class", "wins"), ("--impact-severity", "impact_severity", "wins"), ("--impact-probability", "impact_probability", "wins"), ("--impact-reason", "impact_reason", "wins"),
    ("--confirms-carry", "confirms_carry", "accepted"),   # (#815) a flag with no value: the reviewer's own confirmation, never a line of the block
)


def block_table_text():
    """The table as one sentence: what `review record --block` refuses and what it accepts."""
    pick = lambda *modes: ", ".join(flag for flag, _, mode in BLOCK_FLAG_TABLE if mode in modes)
    return ("With --block, refused (the block carries them): %s; accepted: %s, and of these %s win over the block's own lines; "
            "the score comes from the block's impact-severity:, impact-probability: and impact-reason: lines, so a block without the first two is recorded WITHOUT a score"
            % (pick("refused"), pick("accepted", "wins"), pick("wins")))


BLOCK_TABLE_TEXT = block_table_text()
NO_SCORE_TEXT = ("recorded WITHOUT a score (no impact severity and probability): it clears nothing by score; add --impact-severity and --impact-probability, or `impact-severity:` and `impact-probability:` lines in the block")
RATING_INPUTS = IMPACT_RATING_FIELDS + ("impact_action", "impact_class", "block", "block_file")   # every input of `review record` that decides the rating: read ONLY by `rating_inputs`, from the raw argv


CARRY_FLAG_INPUTS = ("confirms_carry",)   # (#815) a flag with no value: whether a record confirms a carry
DECISION_INPUTS = ("reviewer", "verdict")   # (#815) what the carry and the score read from a record besides the rating: the reviewer role it is for, and its verdict (a confirmation is an approve)
PRIVATE_INPUTS = RATING_INPUTS + DECISION_INPUTS + CARRY_FLAG_INPUTS   # every input of `review record` that can change what the clear, the carry or the score reads: read ONLY from the raw argv
REVIEW_RECORD_PUBLIC_INPUTS = {   # the inputs of `review record` read from the shared namespace, each with the reason it cannot change what the clear, the carry or the score reads
    "review_cmd": "selects the subcommand; the record branch is the one that writes",
    "pr": "required positional: the record binds to the pull request GitHub resolves from it (`ref` in the audit line); argparse refuses its absence and no value of it reaches a rating, a verdict or a confirmation",
    "head": "only checked against the pull request's head (a different one is refused); the head recorded is GitHub's, never this value",
    "blocks": "a count that can only refuse (an approve with blocking findings); neither the carry nor the score reads it",
    "notes": "a count; neither the carry nor the score reads it",
    "summary": "free text, redacted and clipped; neither the carry nor the score reads it",
}


def _private_parse(raw_argv, values, flags):
    """{dest: value} of the inputs of `values` (each takes a value) and `flags` (each takes none: True) GIVEN in `raw_argv` (a tuple of strings: the command line `main` captured before it built the shared
    parser), parsed by a PRIVATE minimal parser: no abbreviation, no default (an absent input is absent), nothing shared with `build_parser`. A registrar's `set_defaults`, a replaced or re-parsed subparser, a
    same-dest argument or a wrapper on the namespace cannot change what this returns. A raw argv that is not a tuple or list of strings gives nothing."""
    if not isinstance(raw_argv, (tuple, list)) or not all(isinstance(x, str) for x in raw_argv):
        return {}
    parser = argparse.ArgumentParser(add_help=False, allow_abbrev=False, argument_default=argparse.SUPPRESS, exit_on_error=False)
    for name in values:
        parser.add_argument("--" + name.replace("_", "-"), dest=name)
    for name in flags:
        parser.add_argument("--" + name.replace("_", "-"), dest=name, action="store_true", default=argparse.SUPPRESS)
    try:
        parsed, _ = parser.parse_known_args(list(raw_argv))
    except (argparse.ArgumentError, SystemExit):
        return {}
    return dict(vars(parsed))


def rating_inputs(raw_argv):
    """{dest: value} of the rating inputs GIVEN in `raw_argv`: the six flags of RATING_INPUTS, through `_private_parse`. A raw argv that is not a tuple or list of strings gives nothing (no rating). #835."""
    return _private_parse(raw_argv, RATING_INPUTS, ())


def record_inputs(raw_argv):
    """{dest: value} of DECISION_INPUTS and CARRY_FLAG_INPUTS GIVEN in `raw_argv`, through `_private_parse` (#815): the reviewer and the verdict of a record, and whether it confirms a carry. Nothing given
    (or a raw argv that is missing) gives nothing: no reviewer, no verdict, no confirmation."""
    return _private_parse(raw_argv, DECISION_INPUTS, CARRY_FLAG_INPUTS)


def cmd_review(args, runner, now):
    """`review laws <pr>` (print the laws and overlay from the PR's base commit) and `review record <pr> --reviewer X ...` (a reviewer writes
    its result per head). Reads GitHub with GETs only; `record` writes the hash-chained ledger and the audit."""
    if args.review_cmd == "measure":
        return cmd_review_measure(args, runner, now)
    if args.review_cmd == "checkout":
        return cmd_review_checkout(args, runner, now)
    try:
        engine, state, config = build_engine(runner, now, "cli", writable=args.review_cmd == "record")
        repo, number, ref, raw = _review_pr(args, engine)
        head = raw.get("headRefOid") if isinstance(raw.get("headRefOid"), str) else None
        if args.review_cmd == "blockers":
            entries, problem = plan_ledger.read_ledger(state)
            if problem:
                raise ReviewError("the ledger is not trustworthy: %s" % problem)
            at = args.head or head
            latest = {}
            for entry in entries:
                if entry.get("kind") == "review_record" and entry.get("pr") == ref and entry.get("head") == at:
                    latest[entry.get("reviewer")] = entry
            for reviewer, entry in sorted(latest.items()):
                if plan_ledger.review_blocks(entry):
                    print("%s recorded request-changes (%s blocking finding(s)) at %s" % (reviewer, entry.get("blocks"), (at or "")[:8]))
                elif entry.get("verdict") == "request-changes":
                    print("%s recorded request-changes at %s: it names no rule and does not block (not a blocker)" % (reviewer, (at or "")[:8]))
            return EXIT_OK
        if args.review_cmd == "laws":
            base = raw.get("baseRefOid")
            if not isinstance(base, str) or not re.fullmatch(r"[0-9a-f]{40}", base):
                raise ReviewError("the PR's base commit is unknown: nothing is shown (the laws are read from the base, never the head)")
            text, missing = review_laws_text(engine, config, runner, now, repo, base)
            if not text:
                raise ReviewError("%s has no review laws at its base commit %s (none of %s): install them with `review-laws install`" % (
                    repo, base[:12], ", ".join(REVIEW_LAW_FILES)))
            print(text)
            if missing:
                sys.stderr.write("%s: review laws: not at the base commit: %s\n" % (PROG, ", ".join(missing)))
            return EXIT_OK
        chosen = record_inputs(getattr(args, "raw_argv", ()))   # (#815) the reviewer, the verdict and the confirmation come from the raw argv too (same reason as the rating's inputs)
        reviewer, verdict, confirms = chosen.get("reviewer"), chosen.get("verdict"), chosen.get("confirms_carry") is True
        if reviewer not in plan_ledger.REVIEWERS:
            raise ReviewError("--reviewer must be one of %s" % ", ".join(plan_ledger.REVIEWERS))
        given = rating_inputs(getattr(args, "raw_argv", ()))   # #835: the rating's inputs come from the raw argv through a private parser, never from the shared namespace (a registrar's set_defaults, a replaced parser or a wrapper cannot reach them); a missing raw argv gives no rating
        action, klass = given.get("impact_action"), given.get("impact_class")
        rating_in = {name: given.get(name) for name in IMPACT_RATING_FIELDS}
        block_digest, block_fields, block_rows, block_problem = None, {}, None, None
        from_file = given.get("block_file") is not None
        block_path = given.get("block") if given.get("block") is not None else given.get("block_file")
        if given.get("block_file") is not None:   # #1126: the verbatim block, and nothing restated: the rating comes from the block alone
            restated = [flag for flag, value in (("--block", given.get("block")), ("--verdict", verdict), ("--head", args.head), ("--blocks", args.blocks), ("--notes", args.notes),
                                                 ("--impact-action", action), ("--impact-class", klass), ("--impact-severity", rating_in["impact_severity"]),
                                                 ("--impact-probability", rating_in["impact_probability"]), ("--impact-reason", rating_in["impact_reason"])) if value]
            if restated:
                raise ReviewError("refused: --block-file takes the rater's block verbatim and derives severity, probability, action and class from it; do not give %s with it (nothing was recorded)" % ", ".join(restated))
        if block_path is not None:   # the reviewer's returned text: the coder session records it
            carried = {"verdict": verdict, "head": args.head, "blocks": args.blocks, "notes": args.notes, "impact_action": action}
            if any(carried[dest] for flag, dest, mode in BLOCK_FLAG_TABLE if mode == "refused"):
                raise ReviewError(BLOCK_TABLE_TEXT)
            block_text = _read_capped(block_path, REVIEW_TABLE_MAX)
            fields, why = parse_review_block(block_text)
            if fields is None:
                raise ReviewError("refused: %s" % why)
            if from_file and fields["block_count"] > 0:   # #1126: a verbatim block file is ONE block; the verdict (first block) and the rating (last block) of two would splice
                raise ReviewError("refused: the file holds %d blocks: a block file is ONE block, the rater's own (nothing was recorded)" % (fields["block_count"] + 1))
            block_raw = block_text.encode("utf-8")
            block_digest, block_fields = (hashlib.sha256(block_raw).hexdigest(), len(block_raw)), {name: fields[name] for name in IMPACT_RATING_FIELDS}
            block_fields["impact_action"], block_fields["impact_class"] = fields["impact_action"], fields["impact_class"]   # #1126: kept so the floor can print what the block itself said
            verdict, args.head, args.blocks, args.notes, action = (fields["verdict"], fields["head"], fields["blocks"], fields["notes"], fields["impact_action"])
            block_rows, block_problem = fields["files_read"], fields["files_problem"]
            klass = klass or fields["impact_class"]
            for name in IMPACT_RATING_FIELDS:   # the rating's severity and probability (the score is derived from the matrix's cell), and the reason that names a floor rule
                if rating_in[name] is None:
                    rating_in[name] = fields[name]
        if verdict not in plan_ledger.REVIEW_VERDICTS:
            raise ReviewError("--verdict must be one of %s (or give --block with the reviewer's returned text)" % ", ".join(plan_ledger.REVIEW_VERDICTS))
        for name, count in (("blocks", args.blocks), ("notes", args.notes)):
            if count < 0 or count > 200:
                raise ReviewError("--%s must be a number from 0 to 200" % name)
        if verdict == "approve" and args.blocks:
            raise ReviewError("an approve cannot carry blocking findings (%d given)" % args.blocks)
        uncited = verdict == "request-changes" and not args.blocks   # #1047: a verdict is recorded exactly as given; one that cites no rule is MARKED, never refused or softened
        if confirms and verdict != "approve":
            raise ReviewError("--confirms-carry belongs to an approve: a reviewer who found a change to the pull request's own lines does not confirm it")
        if action and reviewer != "impact":
            raise ReviewError("--impact-action belongs to the impact reviewer")
        impact_class = (klass or "").strip().lower() or None
        if impact_class is not None and reviewer != "impact":
            raise ReviewError("--impact-class belongs to the impact reviewer")
        rating = {name: (rating_in[name] or "").strip() or None for name in IMPACT_RATING_FIELDS}
        if any(rating.values()) and reviewer != "impact":
            raise ReviewError("--impact-severity, --impact-probability and --impact-reason belong to the impact reviewer")
        if rating["impact_severity"] or rating["impact_probability"]:
            try:
                cells = impact_floor._matrix_cached()["cells"]
                known = isinstance(cells.get(rating["impact_severity"]), dict) and rating["impact_probability"] in cells[rating["impact_severity"]]
            except (impact_floor.MatrixError, KeyError, TypeError, AttributeError):
                raise ReviewError("refused: the impact matrix file cannot be read, so the rating cannot be checked (nothing was recorded)") from None
            if not known:
                raise ReviewError("the rating %r / %r is not a cell of the matrix (nothing was recorded)" % (str(rating["impact_severity"])[:30], str(rating["impact_probability"])[:30]))
        if impact_class is not None and not IMPACT_CLASS_RE.fullmatch(impact_class):
            raise ReviewError("impact-class must be one lower-case word naming the class of the impact (see the matrix file's classes), got %r" % impact_class[:40])
        if action == "hold" and impact_class is None:
            raise ReviewError("an impact hold must name its class (--impact-class or an `impact-class:` line): run the review again (nothing was recorded)")
        if action == "hold":   # #692: the class must be one the matrix file names (read now, never a list of our own)
            try:
                rule = impact_floor.owner_hold_rule(impact_floor._matrix_cached())
            except impact_floor.MatrixError as err:
                raise ReviewError("refused: the impact matrix file cannot be read, so the class %r cannot be checked: %s (nothing was recorded)" % (impact_class, err)) from None
            if rule is None:
                raise ReviewError("refused: the impact matrix file's owner_hold block is missing or malformed, so the class %r cannot be checked (nothing was recorded)" % impact_class)
            valid = rule[0] + rule[1]
            if impact_class not in valid:
                raise ReviewError("an impact hold must name a class of the matrix (%s), got %r: run the review again (nothing was recorded)" % (", ".join(valid), impact_class))
        if not head or not re.fullmatch(r"[0-9a-f]{40}", head):
            raise ReviewError("the PR head is unknown: nothing was recorded")
        given = args.head or head
        if not (head.startswith(given) or given.startswith(head)) or len(given) < 7:
            raise ReviewError("the head given (%s) is not the PR's head (%s): a record belongs to the head it judged, nothing was recorded" % (given[:40], head))
        files_count = None
        if reviewer == "impact" and block_digest:   # #1047: a rating is recorded only from a whole read, checked against GitHub's own list of changed files (never the block's)
            if block_problem and verdict != "incomplete":
                raise ReviewError("refused: %s (nothing was recorded)" % block_problem)
            listed, listed_problem = pr_changed_paths(raw)
            if verdict != "incomplete":   # fails toward refusal: a list GitHub did not give whole is never replaced by the block's own
                if listed is None:
                    raise ReviewError("refused: %s, so the read cannot be checked (nothing was recorded)" % listed_problem)
                why_short = whole_read_problem(block_rows, listed, pr_changed_bounds(raw))
                if why_short:
                    raise ReviewError("refused: %s (nothing was recorded; record `verdict: incomplete` if you could not read it all)" % why_short)
            files_count = (len({r[0] for r in block_rows}), len(listed) if listed is not None else None)
        kind = gates_caller_kind(runner, now)
        if kind[0] == "unknown":
            raise ReviewError("refused: %s" % kind[1])
        by = kind[1] if kind[0] == "agent" else "person"
        entry = {"kind": "review_record", "pr": ref, "head": head, "reviewer": reviewer, "verdict": verdict,
                 "blocks": args.blocks, "notes": args.notes, "by": by,
                 "summary": plan_ledger.clip(redact_command_text(args.summary or ""), 200)}
        if uncited:
            entry["uncited"] = True   # #1047: the verdict word is the reviewer's own; this only says no finding named a rule
        if files_count is not None:
            entry["files_read"], entry["files_total"] = files_count
        if confirms:
            entry["carry_confirmed"] = True   # (#815) read by `impact_hold.carry_confirmer`: only a reviewer's own record at the head it judged
        if action:
            entry["impact_action"] = action
        if reviewer == "impact" or confirms:   # (#815) a carry confirmation is read by the same recorded role as a rating
            entry["by_role"] = kind[2] if kind[0] == "agent" and len(kind) > 2 and isinstance(kind[2], str) else None   # #835: the RECORDED role of the session that made the record (never a flag or a text): only the independent reviewer's rating counts
        for name in IMPACT_RATING_FIELDS:
            if rating[name]:
                entry[name] = plan_ledger.clip(redact_command_text(rating[name]), 200)
        if reviewer == "impact":   # #901: the block's own bytes and rating lines are kept, so only a record that carries the agent's block counts by score
            entry["block_sha256"] = block_digest[0] if block_digest else "none"
            if block_digest:
                entry["block_size"] = block_digest[1]
                entry["record_form"] = "block-file" if from_file else "block"
                for name, value in block_fields.items():
                    if value:
                        entry["block_" + name] = plan_ledger.clip(redact_command_text(value), 200)
        if impact_class:
            entry["impact_class"] = impact_class   # #451 slice 2: the class of the impact that drives the action; a missing one holds for the owner
        stored = plan_ledger.append_entry(state, entry, now())
        if engine.audit is not None:
            engine.audit.append(engine.actor, "review.record", ref, {"reviewer": reviewer, "verdict": verdict, "head": head[:12],
                                                                    "by": by, "seq": stored["seq"], "chain": stored["hash"]})
        entries, problem = plan_ledger.read_ledger(state)
        got = plan_ledger.review_records_at(entries, ref, head)
        print("recorded %s review %s at %s (%s): %d of %d reviewers recorded at this head%s" % (
            reviewer, verdict, head[:8], ref, len(got["recorded"]), len(got["expected"]),
            "; missing %s" % ", ".join(got["missing"]) if got["missing"] else ""))
        if entry.get("uncited"):
            print("note: this request-changes names no rule: it is recorded as given, marked uncited, and does not block")
        if reviewer == "impact" and not (entry.get("impact_severity") and entry.get("impact_probability")):
            sys.stderr.write("%s: review: %s\n" % (PROG, NO_SCORE_TEXT))
        return EXIT_OK
    except (ReviewError, plan_ledger.LedgerError, ConfigError, IdentityUncertain, CallerError) as err:
        sys.stderr.write("%s: review: %s\n" % (PROG, _one_line(str(err), 700)))
        return EXIT_USAGE


cmd_review.direct = True   # no error mapping, no daemon start


def cmd_review_checkout(args, runner, now):
    """`review checkout <pr>` (#721): the PR's exact head tree, diff and base copies in `.review/<head sha>/` of the working directory, printed;
    `review checkout --remove <dir>` removes a directory this command made. The head is read ONCE (or given) and used for every fetch."""
    rc = load_module("review_checkout")
    try:
        if args.remove:
            if args.pr or args.head:
                raise ReviewError("--remove takes only the directory")
            try:
                removed = rc.remove(args.remove, os.getcwd())
            except rc.Unsafe as err:
                raise ReviewError("refused: %s" % err) from None
            print("removed %s" % removed)
            return EXIT_OK
        if not args.pr:
            raise ReviewError("give the pull request (owner/repo#N), or --remove <directory>")
        engine, state, config = build_engine(runner, now, "cli", writable=False)
        repo, number, ref, raw = _review_pr(args, engine)
        head = args.head or raw.get("headRefOid")
        base = raw.get("baseRefOid")
        if not isinstance(head, str) or not re.fullmatch(r"[0-9a-f]{40}", head):
            raise ReviewError("the head must be a full 40-character commit sha (the PR's head is unknown, or --head is short)")
        reader = IntentReader(config["gh"], repo, runner, now, config["call_timeout_seconds"], accounts=GhAccounts(config, runner, now))

        def api(path):
            try:
                return reader._api(path, repo)
            except IntentError as err:
                raise rc.Problem("%s: %s" % (path.split("?")[0], _one_line(str(err), 160))) from None

        def archive(sha):
            try:
                return reader._api_bytes("repos/%s/tarball/%s" % (repo, sha), repo, limit=rc.MAX_TOTAL_BYTES + 16 * 1024 * 1024)
            except IntentError as err:
                raise rc.Problem("tarball: %s" % _one_line(str(err), 160)) from None

        try:
            try:
                matrix_text = "\n".join(impact_matrix_lines(impact_matrix_words())) + "\n"   # #1047: the matrix's words, from the file the clear reads, written beside the diff
            except impact_floor.MatrixError as err:
                matrix_text = None
                sys.stderr.write("%s: review checkout: the impact matrix cannot be read, so impact-matrix.txt is not written to the checkout: %s\n" % (PROG, _one_line(str(err), 160)))
            path = rc.checkout(api, repo, number, head, base, os.getcwd(), extra_files=({rc.MATRIX_FILE: matrix_text} if matrix_text else None), archive=archive, notify=lambda text: sys.stderr.write("%s: review checkout: %s\n" % (PROG, text)))
        except rc.OverBound as err:
            sys.stderr.write("%s: review checkout: refused, nothing left behind: %s\n" % (PROG, _one_line(str(err), 400)))
            return EXIT_USAGE
        except (rc.Unsafe, rc.Problem) as err:
            raise ReviewError("refused, nothing left behind: %s" % err) from None
        print(path)
        return EXIT_OK
    except (ReviewError, ConfigError, IdentityUncertain, CallerError) as err:
        sys.stderr.write("%s: review: %s\n" % (PROG, _one_line(str(err), 400)))
        return EXIT_ERROR


# ---------------------------------------------------------------- `review measure` (#179, slice L7)
#
# Read-only. Did moving coding-hygiene text out of the agent definitions into the reviewers' standards make changes land faster and cleaner? It
# prints, for the merged PRs a repository has, per PR: minutes from the first commit to green CI, review rounds, findings and escaped defects,
# and the medians of a BASELINE group (the N merged before a split PR) and an AFTER group (the N merged from it on). HEURISTICS, stated:
#   to green    first commit date -> the latest completion time among the PR's successful checks at its merged head (a rerun can inflate it)
#   rounds      distinct heads with a recorded review in the local ledger (blank when none was recorded: only recorded reviews are counted)
#   findings    blocking and note counts of the latest recorded review per head and reviewer
#   escaped     another PR merged within 14 days after this one whose title starts with Revert or Fix and names this PR as #N in its title or body
# The running agents load their definitions at start: the AFTER group only measures the new text once agents have restarted after the split.

MEASURE_ESCAPE_DAYS = 14
MEASURE_SCAN_MAX = 40   # GitHub refuses a bigger read of the commits' authors (a node limit)
MEASURE_GROUP_MAX = 50
_MEASURE_FIX_RE = re.compile(r"^\s*(revert|fix)\b", re.I)


def _measure_time(text):
    try:
        return datetime.strptime(text, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc).timestamp()
    except (TypeError, ValueError):
        return None


def measure_row(pr, entries, all_prs, repo):
    """One table row for the merged PR `pr` (the object of `gh pr list --json`); `entries` is the review ledger."""
    number = pr.get("number")
    merged = _measure_time(pr.get("mergedAt"))
    starts = [t for t in (_measure_time(c.get("committedDate")) for c in pr.get("commits") or []) if t is not None] or \
        [t for t in (_measure_time(pr.get("createdAt")),) if t is not None]
    greens = [t for t in (_measure_time(c.get("completedAt")) for c in pr.get("statusCheckRollup") or []
                          if isinstance(c, dict) and c.get("conclusion") == "SUCCESS") if t is not None]
    to_green = round((max(greens) - min(starts)) / 60.0, 1) if greens and starts and max(greens) >= min(starts) else None
    latest = {}
    for entry in entries or []:
        if entry.get("kind") == "review_record" and entry.get("pr") == "%s#%s" % (repo, number):
            latest[(entry.get("head"), entry.get("reviewer"))] = entry
    heads = {head for head, _ in latest}
    escaped = 0
    for other in all_prs:
        later = _measure_time(other.get("mergedAt"))
        if other.get("number") == number or later is None or merged is None or not 0 < later - merged <= MEASURE_ESCAPE_DAYS * 86400:
            continue
        if _MEASURE_FIX_RE.match(other.get("title") or "") and re.search(r"#%s\b" % number, (other.get("title") or "") + " " + (other.get("body") or "")):
            escaped += 1
    # a title is the author's text: no terminal escapes reach the screen
    lines = (pr.get("additions") or 0) + (pr.get("deletions") or 0)
    return {"pr": number, "title": _one_line(re.sub(r"[\x00-\x1f\x7f-\x9f]", " ", str(pr.get("title") or "")), 50), "merged": pr.get("mergedAt"), "lines": lines, "to_green_min": to_green,
            "rounds": len(heads) if heads else None, "blocks": sum(e.get("blocks") or 0 for e in latest.values()) if heads else None,
            "notes": sum(e.get("notes") or 0 for e in latest.values()) if heads else None, "escaped": escaped}


def _median(values):
    values = sorted(v for v in values if v is not None)
    if not values:
        return None
    mid = len(values) // 2
    return values[mid] if len(values) % 2 else round((values[mid - 1] + values[mid]) / 2.0, 1)


def measure_summary(rows):
    """The medians of a group, and minutes to green per 100 changed lines (so a group of larger changes is not read as slower)."""
    per_100 = [round(r["to_green_min"] * 100.0 / max(r["lines"], 1), 1) for r in rows if r["to_green_min"] is not None]
    return {"prs": len(rows), "median_to_green_min": _median(r["to_green_min"] for r in rows), "median_green_min_per_100_lines": _median(per_100),
            "median_rounds": _median(r["rounds"] for r in rows), "median_blocks": _median(r["blocks"] for r in rows),
            "median_notes": _median(r["notes"] for r in rows), "median_lines": _median(r["lines"] for r in rows),
            "escaped_prs": sum(1 for r in rows if r["escaped"])}


def measure_groups(prs, count, split=None):
    """(baseline, after) lists of merged PRs, oldest first. With `split` (a PR number in the list): the `count` merged before it and the `count`
    from it on. Without: the newest `count` as the baseline and an empty after."""
    ordered = sorted((p for p in prs if _measure_time(p.get("mergedAt")) is not None), key=lambda p: _measure_time(p["mergedAt"]))
    if split is None:
        return ordered[-count:], []
    where = [i for i, p in enumerate(ordered) if p.get("number") == split]
    if not where:
        raise ReviewError("PR #%s is not among the %d merged PRs read: raise --scan or name a recent merged PR" % (split, len(ordered)))
    return ordered[max(0, where[0] - count):where[0]], ordered[where[0]:where[0] + count]


def format_measure(base_rows, after_rows):
    head = "%-6s %-50s %6s %9s %6s %6s %6s %7s" % ("PR", "title", "lines", "to-green", "rounds", "blocks", "notes", "escaped")

    def line(r):
        cells = [("-" if r[k] is None else str(r[k])) for k in ("lines", "to_green_min", "rounds", "blocks", "notes", "escaped")]
        return "%-6s %-50s %6s %9s %6s %6s %6s %7s" % tuple(["#%s" % r["pr"], r["title"]] + cells)
    out = []
    for name, rows in (("BASELINE", base_rows), ("AFTER", after_rows)):
        if not rows and name == "AFTER":
            continue
        out += ["%s (%d PRs; to-green in minutes)" % (name, len(rows)), head] + [line(r) for r in rows]
        out.append("  median: " + json.dumps(measure_summary(rows), sort_keys=True))
        out.append("")
    return "\n".join(out).rstrip()


def cmd_review_measure(args, runner, now):
    try:
        if not 1 <= args.count <= MEASURE_GROUP_MAX or not args.count <= args.scan <= MEASURE_SCAN_MAX:
            raise ReviewError("--count must be 1 to %d and --scan from --count to %d" % (MEASURE_GROUP_MAX, MEASURE_SCAN_MAX))
        engine, state, config = build_engine(runner, now, "cli", writable=False)
        accounts = getattr(engine, "accounts", None) or GhAccounts(config, runner, now)
        try:
            refuse_excluded(config, args.repo)   # #446
            env = accounts.env_for(args.repo)
        except AccountError as err:
            raise ReviewError(str(err)) from None
        argv = [config["gh"], "pr", "list", "--repo", args.repo, "--state", "merged", "--limit", str(args.scan), "--json",
                "number,title,body,createdAt,mergedAt,additions,deletions,commits,statusCheckRollup"]
        try:
            done = (engine.gh_runner or runner)(argv, capture_output=True, text=True, timeout=config["call_timeout_seconds"],
                                                stdin=subprocess.DEVNULL, **({"env": env} if env is not None else {}))
        except (OSError, subprocess.SubprocessError) as err:
            raise ReviewError("gh pr list %s: %s" % (args.repo, accounts.scrub(_one_line(str(err), 120)))) from None
        if done.returncode != 0:
            raise ReviewError("gh pr list %s failed: %s" % (args.repo, accounts.scrub(_one_line(done.stderr or "", 160)) or "exit %d" % done.returncode))
        try:
            prs = json.loads(done.stdout or "[]")
        except ValueError:
            raise ReviewError("gh pr list answered something that is not JSON") from None
        if not isinstance(prs, list):
            raise ReviewError("gh pr list answered something that is not a list")
        entries, problem = plan_ledger.read_ledger(state)
        if problem:   # fail open on purpose (R-CODE-2): the figures are a read-only report, so say it loudly and carry on with the intact entries
            sys.stderr.write("%s: review measure: the review ledger is damaged (%s): blank review columns may be missing records\n" % (PROG, _one_line(problem, 200)))
        base, after = measure_groups(prs, args.count, args.split)
        rows = lambda group: [measure_row(p, entries, prs, args.repo) for p in group]
        if args.json:
            print(json.dumps({"baseline": rows(base), "after": rows(after)}, indent=2, sort_keys=True))
        else:
            print(format_measure(rows(base), rows(after)))
        return EXIT_OK
    except (ReviewError, plan_ledger.LedgerError, ConfigError) as err:
        sys.stderr.write("%s: review measure: %s\n" % (PROG, _one_line(str(err), 400)))
        return EXIT_USAGE


def add_review_parsers(sub):
    review = sub.add_parser("review", help="Reviewer subagents (#179): print the laws from the PR's base commit, record a reviewer's result")
    rsub = review.add_subparsers(dest="review_cmd", required=True)
    laws = rsub.add_parser("laws", help="Print the repository's review laws and overlay as they stand at the PR's BASE commit")
    laws.add_argument("pr", help="1234, #1234 (the working directory's remote), owner/repo#N or the PR's URL")
    blockers = rsub.add_parser("blockers", help="Read-only: the reviewers whose LATEST recorded result at the PR's head is request-changes (one line each)")
    blockers.add_argument("pr", help="owner/repo#N or the PR's URL")
    blockers.add_argument("--head", help="The commit to look at (default: the PR's head)")
    record = rsub.add_parser("record", allow_abbrev=False, help="Record a reviewer's result for the PR's current head (the coder session records what the reviewer returned)")
    record.add_argument("pr", help="owner/repo#N or the PR's URL")
    record.add_argument("--reviewer", required=True, help="code | architecture | security | impact | test")
    record.add_argument("--head", help="The commit judged (default: the PR's head; a different one is refused)")
    record.add_argument("--verdict", help="approve | request-changes | comment | incomplete")
    record.add_argument("--block", help="File (or - for stdin) holding the verdict block a reviewer returned: verdict, head, counts and impact action are read from it. " + BLOCK_TABLE_TEXT)
    record.add_argument("--block-file", dest="block_file", help="File holding the rater's verbatim block: severity, probability, action, class, verdict and head are read from it and NO restating flag is accepted (only --reviewer, --summary, --confirms-carry)")
    record.add_argument("--blocks", type=int, default=0, help="Blocking findings (each cites a rule)")
    record.add_argument("--notes", type=int, default=0, help="Notes and proposals")
    record.add_argument("--impact-action", dest="impact_action", choices=("hold", "second-review", "none"),
                        help="The impact reviewer's action from the matrix")
    for flag in IMPACT_RATING_FIELDS:
        record.add_argument("--" + flag.replace("_", "-"), dest=flag, help="#835: the impact reviewer's rating (%s): the severity and the probability name a cell of the matrix, the reason names the floor rule it applied" % flag.split("_", 1)[1])
    record.add_argument("--impact-class", dest="impact_class", help="The class of the impact that drives the action (a class of the matrix file's owner_hold block)")
    record.add_argument("--confirms-carry", dest="confirms_carry", action="store_true",
                        help="(#815) With an approve: the resolution of a conflict in a merge of main touched no line this pull request adds or removes, so the owner's clear may carry to this head")
    record.add_argument("--summary", help="One line (at most 200 characters)")
    checkout = rsub.add_parser("checkout", help="Write the PR's exact head tree, its diff and the base copies of the touched files into .review/<head sha> here, read-only, and print the path; --remove <dir> removes one")
    checkout.add_argument("pr", nargs="?", help="owner/repo#N or the PR's URL")
    checkout.add_argument("--head", help="The commit to materialise (default: the PR's head, read once at the start)")
    checkout.add_argument("--remove", metavar="DIR", help="Remove a directory this command made (restores the permissions it set; anything else is refused)")
    measure = rsub.add_parser("measure", help="Read-only: per merged PR, time to green CI, review rounds, findings, escaped defects; baseline and after medians")
    measure.add_argument("repo", help="owner/repo")
    measure.add_argument("--count", type=int, default=10, help="PRs per group (default 10)")
    measure.add_argument("--scan", type=int, default=MEASURE_SCAN_MAX, help="Merged PRs read (default %d; the escape check looks among them)" % MEASURE_SCAN_MAX)
    measure.add_argument("--split", type=int, help="A merged PR number: the baseline is the --count merged before it, the after is --count from it on")
    measure.add_argument("--json", action="store_true", help="Machine-readable rows")


# ---------------------------------------------------------------- `pr-explain` (#179, slice L6)
#
# The explainer is NOT a reviewer: reviewers give no advice and no summaries. It writes, for the PR description, (a) a short before and after
# pseudo-code WHY block on every PR. It never writes a summary flowchart (ask #687: a Mermaid diagram belongs only where it shows data flow, system
# design or component design, never at the top of a body). This command is the simplest thing that works without write authority: it reads the PR once (a GET) and PRINTS the block (or the
# whole new body with the block put in once); the author pastes it with their own `gh pr edit --body-file`. `--check` judges a body.

EXPLAINER_BEGIN = "<!-- pr-explainer:begin -->"
EXPLAINER_END = "<!-- pr-explainer:end -->"
EXPLAINER_HEADER_RE = re.compile(r"^(?:PLAN|MERGE|canon):", re.I)   # the lines a body opens with; the block goes right after them
# The generated summary flowchart this tool used to write (four boxes: Changes, Touches, Irreversible, Risk). It is never emitted; a body that still holds it fails
# `--check`. Detection is by the four box labels inside ONE Mermaid fence, read line by line (bounded, linear, no lowered copy, ASCII-only matching).
SUMMARY_FLOWCHART_LABELS = ("Changes", "Touches", "Irreversible", "Risk")
_SUMMARY_LABEL = re.compile(r'[\["(]\s*(%s)\s*:' % "|".join(SUMMARY_FLOWCHART_LABELS), re.A | re.I)   # built from the tuple: one list of labels
_SUMMARY_LINE_MAX = 400   # a box label is short: the rest of a longer line is not looked at
_SUMMARY_BODY_MAX = 1 << 20   # a body is cut at 1 MB for this check (GitHub's own limit is 65536 characters)
_SUMMARY_FENCE_RE = re.compile(r"^(?:[ \t>]|[-*+][ \t]|\d{1,9}[.)][ \t])*(`{3,}|~{3,})(.*)$")   # a fence at any indent, inside quotes, or opened after any run of quote marks and list markers: GitHub renders those too (each prefix piece starts with a different character, so the run has one way to match: linear)
SUMMARY_FLOWCHART_DEFECT = ("the body holds the generated summary flowchart (a Mermaid diagram whose boxes are Changes:, Touches:, Irreversible:, Risk:): remove it; "
                            "a diagram is only for data flow, system design or component design")


def summary_flowchart_found(body):
    """True when a Mermaid fence ANYWHERE in the body holds the four labelled boxes of the generated summary flowchart (Changes:, Touches:, Irreversible:, Risk:). One
    pass over the lines under a step budget; each line is cut to _SUMMARY_LINE_MAX; fences are read as the held-body scan reads them (three or more backticks or
    tildes, closed by the same character at least as long, an unclosed fence running to the end) but at ANY indent and behind blockquote marks, since GitHub renders a fence
    nested in a list item or a quote; it is a lint for the generator's own output (a renamed label is not caught, and it errs toward finding it: a closing line written `- ```` counts), not a boundary; no lowered copy is indexed
    (ASCII-only folding). A diagram that shows data flow (without all four labels in ONE fence) is not it."""
    lines = str(body or "")[:_SUMMARY_BODY_MAX].splitlines()   # any line break, CR-only included
    budget = _held_steps(len(lines))
    fence, mermaid, seen = None, False, set()
    for line in lines:
        _held_spend(budget)
        text = line[:_SUMMARY_LINE_MAX]
        found = _SUMMARY_FENCE_RE.match(text)
        opens = found and not (found.group(1)[0] == "`" and "`" in found.group(2))
        words = found.group(2).split() if opens else []
        if opens and words and _ascii_lower(words[0]) == "mermaid":   # a Mermaid opener always (re)starts the scan, even inside a decoy fence: a decoy cannot hide the real one
            fence, mermaid, seen = (found.group(1)[0], len(found.group(1))), True, set()
            continue
        if fence is None:
            if opens:
                fence, mermaid, seen = (found.group(1)[0], len(found.group(1))), False, set()
            continue
        if found and found.group(1)[0] == fence[0] and len(found.group(1)) >= fence[1] and not found.group(2).strip():
            if mermaid and len(seen) == len(SUMMARY_FLOWCHART_LABELS):
                return True
            fence = None
        elif mermaid:
            for label in _SUMMARY_LABEL.finditer(text):
                seen.add(label.group(1).capitalize())
    return fence is not None and mermaid and len(seen) == len(SUMMARY_FLOWCHART_LABELS)   # a fence left open at the end of the body counts too


def summary_flowchart_defects(body):
    """The defect list for the summary flowchart: [] when absent, one message when found, and a message (never a raise) when the scan could not finish."""
    try:
        return [SUMMARY_FLOWCHART_DEFECT] if summary_flowchart_found(body) else []
    except ValueError as err:
        return ["the body could not be scanned for the summary flowchart (%s)" % _one_line(str(err), 100)]


def explainer_text(text):
    """A before or after line made safe for the block: one line, and never a marker comment, a comment close or a code fence (any of them would
    end the block early, add a second marker or break the fenced why part)."""
    plain = " ".join(str(text or "").split())
    for bad in (EXPLAINER_BEGIN, EXPLAINER_END, "<!--", "-->", "```"):
        plain = plain.replace(bad, " ")
    return " ".join(plain.split())


def explainer_block(why_before, why_after):
    """The ONE block of a PR description: the why part (every PR), between two marker comments. Never a diagram."""
    why_before, why_after = explainer_text(why_before), explainer_text(why_after)
    parts = [EXPLAINER_BEGIN, ""]
    parts += ["**Why (before and after)**", "", "```text", "before: %s" % why_before, "after:  %s" % why_after, "```", "", EXPLAINER_END]
    return "\n".join(parts)


def explainer_insert(body, block):
    """`body` with `block` in it ONCE: any block already there (between the markers) is removed first, and the new one goes right after the lines the
    body opens with (`PLAN:`, `MERGE:`, `canon:`), so a gate that reads the first line still sees it."""
    body = body or ""
    while EXPLAINER_BEGIN in body and EXPLAINER_END in body.split(EXPLAINER_BEGIN, 1)[1]:
        head, rest = body.split(EXPLAINER_BEGIN, 1)
        body = head.rstrip("\n") + "\n" + rest.split(EXPLAINER_END, 1)[1].lstrip("\n")
    lines = body.split("\n")
    at = 0
    while at < len(lines) and (EXPLAINER_HEADER_RE.match(lines[at]) or (not lines[at].strip() and at and EXPLAINER_HEADER_RE.match(lines[at - 1]))):
        at += 1
    if HELD_WHY in body:   # a held PR's top part stays first: the block goes below it, where the technical section begins
        at = next((i for i, l in enumerate(lines) if l.strip() in HELD_PARTS), at)
        at += held_top_end(lines[at:])
    head, tail = lines[:at], lines[at:]
    return "\n".join(head + ([""] if head and head[-1].strip() else []) + block.split("\n") + ([""] if tail and tail[0].strip() else []) + tail)


def explainer_defects(body):
    """What is wrong with a PR description's explainer: exactly one block, a why part with a real before and a real after (no placeholder left), and no
    generated summary flowchart anywhere in the body. A body with no diagram passes."""
    body = body or ""
    count = body.count(EXPLAINER_BEGIN)
    if count != 1 or body.count(EXPLAINER_END) != 1 or body.index(EXPLAINER_BEGIN) > body.index(EXPLAINER_END):
        return ["the description has %d explainer blocks: it carries exactly one (between %s and %s)" % (count, EXPLAINER_BEGIN, EXPLAINER_END)] + (
            summary_flowchart_defects(body))
    inner = body.split(EXPLAINER_BEGIN, 1)[1].split(EXPLAINER_END, 1)[0]
    problems = []
    why = re.search(r"```text\n(.*?)```", inner, re.S)
    before = re.search(r"^before: (.+)$", why.group(1), re.M) if why else None
    after = re.search(r"^after: +(.+)$", why.group(1), re.M) if why else None
    if not why or not before or not after:
        problems.append("the why part needs a ```text block with a `before:` line and an `after:` line")
    elif any(re.search(r"<[^>]*>", m.group(1)) for m in (before, after)):
        problems.append("the why part still has a placeholder in <angle brackets>")
    problems += summary_flowchart_defects(body)
    return problems


HELD_WHY = "## Why this needs you"
HELD_TABLE = "## What changes for you"
HELD_EXAMPLE = "## Example"
HELD_QUESTIONS = "## Questions for you"
HELD_PARTS = (HELD_WHY, HELD_TABLE, HELD_EXAMPLE, HELD_QUESTIONS)
def _held_none(line):
    """True for the line `Questions: none`, then an optional one-line parenthetical (and an optional final dot). Plain string tests: no backtracking."""
    line = line.strip()
    if not line.startswith("Questions: none"):
        return False
    tail = line[len("Questions: none"):].strip()
    return tail in ("", ".") or (tail.startswith("(") and (tail.endswith(")") or tail.endswith(").")))


def pr_is_held(labels, body, now=None):
    """A PR is held for the owner: it carries a hold label, or (the same rule as everywhere) a merge-captain label or the legacy first line."""
    return bool(pr_hold_reasons(labels)) or is_captain({"labels": labels, "body": body}, now)


_HELD_FENCE_RE = re.compile(r"^ {0,3}(`{3,}|~{3,})(.*)$")
HELD_BODY_MAX = 70000   # a longer body is not read (GitHub's own cap is 65536)
_HELD_PLACEHOLDER_RE = re.compile(r"<[^<>]*>")   # linear: the class stops at the next `<`


_ASCII_LOWER = {c: c + 32 for c in range(ord("A"), ord("Z") + 1)}


def _ascii_lower(text):
    """`text` with only A-Z lowered: the length never changes (str.lower() can make a string LONGER, e.g. U+0130), so an index found in the copy is
    an index of the original. ONE helper for every case-insensitive scan of a held body."""
    return text.translate(_ASCII_LOWER)


def _held_steps(size):
    """A fresh step budget for one scan loop: each iteration spends one, and running out raises (the body is then unreadable), so no input can hang the daemon."""
    return [4 * size + 64]


def _held_spend(budget):
    budget[0] -= 1
    if budget[0] < 0:
        raise ValueError("the scan did not finish within its step budget")


_HTML_SPACE = " \t\n\f\r"   # HTML whitespace: space, tab, LF, FF, CR (not NBSP, not a vertical tab)
_HTML_SPACE_RE = re.compile(r"[ \t\n\f\r]+")


def _held_skip_space(text, i):
    """The first index at or after `i` that is not HTML whitespace: the ONE helper for every attribute step."""
    while i < len(text) and text[i] in _HTML_SPACE:
        i += 1
    return i


def _held_class_tokens(tag):
    """The class tokens (ASCII-lowered) of an HTML tag's text: a linear walk over every `class` (HTML whitespace around the name and the `=`, quoted either
    way or bare); tokens are separated by HTML whitespace only."""
    low = _ascii_lower(tag)
    budget = _held_steps(len(low))
    tokens, at = [], low.find("class")
    while at >= 0:
        _held_spend(budget)
        i = _held_skip_space(low, at + 5)
        if i < len(low) and low[i] == "=":
            i = _held_skip_space(low, i + 1)
            if i < len(low) and low[i] in "\"'":
                end = low.find(low[i], i + 1)
                end = len(low) if end < 0 else end
                tokens += [t for t in _HTML_SPACE_RE.split(low[i + 1:end]) if t]
                i = end
            else:
                end = i
                while end < len(low) and low[end] not in _HTML_SPACE and low[end] != ">":
                    end += 1
                tokens += [t for t in _HTML_SPACE_RE.split(low[i:end]) if t]
                i = end
        at = low.find("class", max(i, at + 5))
    return tokens


def _held_tag_end(line, at):
    """Index of the `>` that closes the tag opened at `at`, skipping quoted attribute values (a `>` inside quotes does not close it); -1 when it never closes."""
    i, size = at, len(line)
    while i < size:
        c = line[i]
        if c in "\"'":
            i = line.find(c, i + 1)
            if i < 0:
                return -1
        elif c == ">":
            return i
        i += 1
    return -1


def _held_pre_mermaid(line):
    """True when `line` opens a `<pre>` whose class tokens include `mermaid`, or a `<pre` that is never closed on the line (it cannot be judged, so it
    counts). Each `<pre` is walked to its closing `>` with `find` and the search resumes after it: linear, no window, no backtracking."""
    low = _ascii_lower(line)
    budget = _held_steps(len(low))
    at = low.find("<pre")
    while at >= 0:
        _held_spend(budget)
        after = low[at + 4:at + 5]
        if not after.isalpha():
            end = _held_tag_end(line, at)
            if end < 0:
                return True
            if "mermaid" in _held_class_tokens(line[at:end]):
                return True
            at = low.find("<pre", end)
        else:
            at = low.find("<pre", at + 4)
    return False


def held_scan(lines):
    """(clean, mermaid): `clean` is `lines` with every fenced code block (fences included: three or more backticks or tildes, up to three spaces of
    indent, closed by the same character at least as long, an unclosed fence running to the end) and every HTML comment blanked, so a heading
    counts only outside them (the explainer block's own opening marker is kept); `mermaid` lists the indexes where a Mermaid block opens (a fence
    whose info string starts with `mermaid`, any case, or a `<pre class=mermaid>`)."""
    clean, mermaid, fence, comment = [], [], None, False
    for i, line in enumerate(lines):
        if fence is not None:
            found = _HELD_FENCE_RE.match(line)
            if found and found.group(1)[0] == fence[0] and len(found.group(1)) >= fence[1] and not found.group(2).strip():
                fence = None
            clean.append("")
            continue
        if not comment:
            found = _HELD_FENCE_RE.match(line)
            if found and not (found.group(1)[0] == "`" and "`" in found.group(2)):
                fence = (found.group(1)[0], len(found.group(1)))
                words = found.group(2).split()
                if words and _ascii_lower(words[0]) == "mermaid":
                    mermaid.append(i)
                clean.append("")
                continue
            if line.strip() == EXPLAINER_BEGIN:
                clean.append(line)
                continue
        if _held_pre_mermaid(line):
            mermaid.append(i)
        parts, pos, size = [], 0, len(line)   # walk with an index: no slicing, no growing concatenation
        budget = _held_steps(size)
        while pos < size:
            _held_spend(budget)
            if comment:
                end = line.find("-->", pos)
                if end < 0:
                    pos = size
                else:
                    comment, pos = False, end + 3
            else:
                start = line.find("<!--", pos)
                if start < 0:
                    parts.append(line[pos:])
                    pos = size
                else:
                    parts.append(line[pos:start])
                    comment, pos = True, start + 4
        out = "".join(parts)
        clean.append(out)
    return clean, mermaid


def held_top_end(rest):
    """Index in `rest` where the top part ends (PC-5): the first heading (outside code fences and comments) after the first top part that is not one of
    the four top parts, or the explainer block's opening marker; the end of the body when there is none. `rest` is the body after the opening lines."""
    clean = held_scan(rest)[0]
    first = next((i for i, l in enumerate(clean) if l.strip() in HELD_PARTS), None)
    if first is None:
        return len(rest)
    return next((i for i in range(first + 1, len(rest)) if (clean[i].startswith("#") and clean[i].strip() not in HELD_PARTS) or clean[i].strip() == EXPLAINER_BEGIN), len(rest))


def held_defects(body):
    """The ONE check of a held PR's top (see `_held_defects`); anything it cannot read is a defect, never a pass."""
    try:
        if len(body or "") > HELD_BODY_MAX:
            return ["the held PR's top is unreadable: the body is longer than %d characters" % HELD_BODY_MAX]
        return _held_defects(body)
    except Exception as err:   # a body it cannot parse fails: unreadable, never ok
        return ["the held PR's top is unreadable (%s)" % _one_line("%s: %s" % (type(err).__name__, err), 100)]


def _held_defects(body):
    """What is wrong with the top of a PR body held for the owner (used by `pr-explain --check` and gate G6b). After the opening lines
    (PLAN:, MERGE:, canon:), in this order: `## Why this needs you` (1 to 3 sentences, no placeholder), `## What changes for you` (a Before | After
    table of 2 to 4 rows of real cells), `## Example` (real text), `## Questions for you` (a numbered list, each item with `Recommendation:`) or the
    line `Questions: none (reason)`. An image may sit anywhere in the top; a Mermaid block in the top is a defect; nothing below the top part is
    judged, except that the generated summary flowchart (four boxes: Changes:, Touches:, Irreversible:, Risk:) is a defect ANYWHERE in the body. Headings count only outside code fences and comments. Reads the body only."""
    lines = (body or "").split("\n")
    clean_all, mermaid_all = held_scan(lines)
    at = 0
    while at < len(lines) and (EXPLAINER_HEADER_RE.match(lines[at]) or not clean_all[at].strip()):
        at += 1
    rest = lines[at:]
    top_end = held_top_end(rest)
    top = clean_all[at:at + top_end]
    pos = {}
    for i, l in enumerate(top):
        pos.setdefault(l.strip(), i)

    def section(name):
        start = pos[name] + 1
        stop = next((i for i in range(start, len(top)) if top[i].startswith("## ")), len(top))
        return top[start:stop]

    def words(text):
        return len(re.findall(r"[^\W_]", text))   # underscores are not word characters here

    problems = []
    if HELD_WHY not in pos:
        problems.append("the held PR needs a `%s` section after the opening lines" % HELD_WHY)
    else:
        text = " ".join(l.strip() for l in section(HELD_WHY) if l.strip() and not l.strip().startswith("!["))
        sentences = [x for x in re.split(r"(?<=[.!?])\s+", text) if x.strip()]
        if words(text) < 3 or _HELD_PLACEHOLDER_RE.search(text):
            problems.append("`%s` is empty or still has a <placeholder>" % HELD_WHY)
        elif len(sentences) > 3:
            problems.append("`%s` has %d sentences: it is one to three" % (HELD_WHY, len(sentences)))
    if HELD_TABLE not in pos:
        problems.append("the held PR needs a `%s` table (Before | After, 2 to 4 rows)" % HELD_TABLE)
    else:
        rows = [[c.strip() for c in l.strip().strip("|").split("|")] for l in section(HELD_TABLE) if l.strip().startswith("|")]
        head = [_ascii_lower(c) for c in rows[0]] if rows else []
        sep_cells = len(rows) >= 2 and all(re.fullmatch(r":?-{3,}:?", c) for c in rows[1])
        has_sep = sep_cells and len(rows[1]) == len(head)
        data = rows[2:] if has_sep else []
        dup = next((n for n in ("before", "after") if head.count(n) > 1), None)
        fenced = not rows and any(l.strip().startswith("|") for l in lines[at + pos[HELD_TABLE]:at + top_end])
        if fenced:
            problems.append("`%s`: the table is inside a code fence, it must be plain text" % HELD_TABLE)
        elif "before" not in head:
            problems.append("`%s`: the table has no Before column" % HELD_TABLE)
        elif "after" not in head:
            problems.append("`%s`: the table has no After column" % HELD_TABLE)
        elif dup:
            problems.append("`%s`: the table has a duplicate %s column" % (HELD_TABLE, dup.capitalize()))
        elif sep_cells and not has_sep:
            problems.append("`%s`: separator row has %d columns, the header has %d" % (HELD_TABLE, len(rows[1]), len(head)))
        elif not has_sep:
            problems.append("`%s`: the table has no separator row" % HELD_TABLE)
        elif not data:
            problems.append("`%s`: the table has no data row" % HELD_TABLE)
        elif not 2 <= len(data) <= 4:
            problems.append("`%s`: the table has %d rows, it is 2 to 4" % (HELD_TABLE, len(data)))
        elif any(len(r) != len(head) or any(words(r[i]) < 3 or _HELD_PLACEHOLDER_RE.search(r[i]) for i in (head.index("before"), head.index("after"))) for r in data):
            problems.append("`%s`: every table cell is a plain sentence (at least 3 word characters, no <placeholder>)" % HELD_TABLE)
    if HELD_EXAMPLE not in pos:
        problems.append("the held PR needs an `%s` section: one concrete case in a few lines" % HELD_EXAMPLE)
    else:
        text = " ".join(l.strip() for l in section(HELD_EXAMPLE) if l.strip() and not l.strip().startswith("!["))
        if len(text) < 20 or _HELD_PLACEHOLDER_RE.search(text):
            problems.append("`%s` is empty, too short (20 characters) or still has a <placeholder>" % HELD_EXAMPLE)
    if any(at <= m < at + top_end for m in mermaid_all):
        problems.append("the top part shows a Mermaid diagram: it goes below, in the technical section")
    if summary_flowchart_found(body):   # ANYWHERE in the body, the top part or below it or inside the explainer markers (ask #687)
        problems.append(SUMMARY_FLOWCHART_DEFECT)
    nones = [i for i, l in enumerate(top) if _held_none(l)]
    if HELD_QUESTIONS in pos:
        section_lines = [l for l in section(HELD_QUESTIONS) if l.strip()]
        items, cur = [], None
        for l in section_lines:
            if re.match(r"^\s*\d+\.\s", l):
                cur = [l]
                items.append(cur)
            elif cur is not None:
                cur.append(l)
        if items:
            for n, item in enumerate(items, 1):
                if "Recommendation:" not in " ".join(item):
                    problems.append("question %d has no `Recommendation:`" % n)
        elif not (len(section_lines) == 1 and _held_none(section_lines[0])):
            problems.append("`%s` is a numbered list (each with `Recommendation:`) or exactly one line `Questions: none (reason)`" % HELD_QUESTIONS)
    elif len(nones) != 1:
        problems.append("the held PR needs `%s` (a numbered list, each question with `Recommendation:`) or the line `Questions: none (reason)`" % HELD_QUESTIONS)
    order = [pos[n] for n in HELD_PARTS if n in pos]
    if HELD_QUESTIONS not in pos and len(nones) == 1:
        order.append(nones[0])
    if order != sorted(order):
        problems.append("the order is wrong: Why this needs you, What changes for you, Example, then Questions for you")
    return problems


def cmd_pr_explain(args, runner, now):
    """`pr-explain <owner/repo#N>`: read the PR once and print the explainer block (the why part), or with
    `--body-file F` the whole new body with the block in once, or with `--check` judge the description it has. It writes nothing anywhere."""
    try:
        repo, number = parse_pr_ref(args.pr)
    except NoticeError as err:
        sys.stderr.write("%s: %s\n" % (PROG, _one_line(str(err), 300)))
        return EXIT_USAGE
    engine, _, _ = build_engine(runner, now, "cli", writable=False)
    try:
        pr = read_pr_json(engine, repo, number)
    except NoticeError as err:
        sys.stderr.write("%s: %s\n" % (PROG, _one_line(str(err), 300)))
        return EXIT_ERROR
    body = pr.get("body") if isinstance(pr.get("body"), str) else ""
    if args.check:
        problems = explainer_defects(body)
        if pr_is_held(pr.get("labels") or [], body):
            problems += [p for p in held_defects(body) if p not in problems]   # the summary flowchart is named once
        for problem in problems:
            print("DEFECT: %s" % problem)
        print("explainer: %s" % ("FAIL" if problems else "PASS"))
        return EXIT_ERROR if problems else EXIT_OK
    block = explainer_block(args.before or "<what happened before, one or two lines>", args.after or "<what happens after, one or two lines>")
    if args.body_file:
        try:
            current = body if args.body_file == "-" else Path(args.body_file).read_text()
        except OSError as err:
            sys.stderr.write("%s: pr-explain: cannot read %s: %s\n" % (PROG, args.body_file, getattr(err, "strerror", None) or err))
            return EXIT_USAGE
        print(explainer_insert(current, block))
    else:
        print(block)
    return EXIT_OK


cmd_pr_explain.direct = True   # no error mapping, no daemon start


def add_pr_explain_parsers(sub):
    explain = sub.add_parser("pr-explain", help="Print the PR explainer block: a before/after why part (read-only; never a diagram)",
                             description="Reads the PR once and PRINTS the block for its description; it writes nothing. Paste it, or use --body-file to get the whole "
                                         "new body with the block in once, then `gh pr edit --body-file`. --check judges the description the PR has.")
    explain.add_argument("pr", help="The pull request: owner/repo#N or its URL")
    explain.add_argument("--before", help="The behaviour before, one or two lines")
    explain.add_argument("--after", help="The behaviour after, one or two lines")
    explain.add_argument("--body-file", help="A file with a PR body (or - for the PR's own): print it with the block in once")
    explain.add_argument("--check", action="store_true", help="Judge the PR description: one block, a real why part, no generated summary flowchart")


def add_impact_parsers(sub):
    impact = sub.add_parser("impact", help="The impact hold's deterministic floor (#179, advisory: writes nothing)")
    impact_sub = impact.add_subparsers(dest="impact_action", required=True)
    floor = impact_sub.add_parser("floor", help="What the path-glob floor (and an optional independent rating) would decide for a PR")
    floor.add_argument("pr", help="The pull request: owner/repo#N or its URL")
    floor.add_argument("--rating", action="append", metavar="SEVERITY/PROBABILITY",
                       help="An independent rating's impact, e.g. Critical/Remote (repeatable; it can only add a hold; Eliminated is not rated)")
    floor.add_argument("--json", action="store_true")
    matrix = impact_sub.add_parser("matrix", help="Read-only: print the kit's impact matrix words (severities, probabilities, cells, floor rule ids); with --for-rater also a pull request's floor hits (for a repository with no review laws)")
    matrix.add_argument("--for-rater", dest="for_rater", metavar="PR", help="Also that pull request's floor report: owner/repo#N or its URL")
    matrix.add_argument("--json", action="store_true")
    hold = impact_sub.add_parser("hold", help="What the daemon would label as held right now (read-only dry run; the daemon writes the labels)")
    hold.add_argument("--dry-run", action="store_true", dest="dry_run")
    hold.add_argument("--repo", help="One repo (OWNER/REPO); default: every repo under plan_gates")
    delegated = impact_sub.add_parser("delegated", help="List every clear the Chief of Staff made under an order of the owner's: the pull request, head, score, threshold and her judgement (read-only)")
    delegated.add_argument("--json", action="store_true")
    delegated.add_argument("--check", action="store_true", help="The fleet doctor's check: fail when a configured owner-file order no longer matches exactly one line of the owner's standing-orders file")
    clear = impact_sub.add_parser("clear", help="The owner's own terminal: clear a false impact hold for this head, with a reason (the Chief of Staff only under a standing order of the owner's, with --under-order)")
    clear.add_argument("pr", help="The pull request: owner/repo#N or its URL")
    clear.add_argument("--under-order", type=int, dest="under_order", metavar="N", help="The Chief of Staff only: clear under the owner's standing order N (it must be listed under delegated_clear in the configuration); recorded as her act under that order")
    clear.add_argument("--reason", required=True, help="Why the hold is false (at least 10 characters), logged")
    clear.add_argument("--revoke", action="store_true", help="Take the clear back (and any carry of it): the PR is held again at the daemon's next pass")


# ---------------------------------------------------------------- `disk prune`: reclaim old docker build cache and images, and nothing else
#
# The two commands below, and the volume step after them, are the ONLY ones it runs, with exactly these arguments: old build cache and old unused images (a
# week), then `docker volume prune -f` (never `-a`: docker's own anonymous-only prune, which removes only anonymous volumes no container references, stopped ones
# included) and ONLY when the docker server is 23.0 or newer (before that, `volume prune` removed every unused volume, named ones too). Never a running
# container (`image prune -a` keeps every image a container uses), never `system prune`. It refuses when there is no docker. `--dry-run` prints the commands and
# runs none. Nothing runs it on its own: the docs give a launchd snippet for a weekly run, not installed.
DISK_PRUNE_COMMANDS = (("docker", "builder", "prune", "-f", "--filter", "until=168h"),
                       ("docker", "image", "prune", "-a", "-f", "--filter", "until=168h"))
DISK_PRUNE_TIMEOUT = 600
DISK_VOLUME_PRUNE = ("volume", "prune", "-f")       # NEVER -a or --all
DISK_VOLUME_MIN_ENGINE = (23, 0)                    # from here `volume prune` removes only ANONYMOUS volumes
DISK_VOLUME_MIN_API = (1, 42)                       # the API of Docker 23.0
DISK_VOLUME_READ_BYTES = 1000000                    # docker output parsed: no more than this
DISK_ANONYMOUS_LABEL = "com.docker.volume.anonymous"
DISK_VOLUME_LIMIT = 200                             # volumes examined: past it the count is "at least"
DISK_VOLUME_SECONDS = 30
_SIZE_UNITS = {"B": 1, "KB": 10 ** 3, "MB": 10 ** 6, "GB": 10 ** 9, "TB": 10 ** 12}
_RECLAIMED = re.compile(r"Total reclaimed space:\s*(\S+)", re.I)


def _version_pair(text):
    found = re.match(r"\s*(\d{1,4})\.(\d{1,4})", text or "")
    return (int(found.group(1)), int(found.group(2))) if found else None


def docker_volume_prune_gate(docker, runner):
    """(ok, why, kind): is it safe to run `docker volume prune -f`? Only when ALL hold: the server is Docker (Engine or Desktop: a compatible program such as podman
    prunes every unused volume), its version is 23.0 or newer, the API both ends speak is 1.42 or newer (an older API makes the daemon prune EVERY unused
    volume, named ones too, whatever the server version), and `DOCKER_API_VERSION` does not pin it lower. Anything unreadable refuses."""
    try:
        done = runner([docker, "version", "--format", "{{.Server.Version}}|{{.Server.Platform.Name}}|{{.Server.APIVersion}}|{{.Client.APIVersion}}"],
                      capture_output=True, text=True, timeout=DISK_VOLUME_SECONDS, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        return False, "the docker server version could not be read (is docker running?)", "unreadable"
    parts = (done.stdout or "")[:2000].strip().split("|") if done.returncode == 0 else []
    if len(parts) != 4 or _version_pair(parts[0]) is None or _version_pair(parts[2]) is None or _version_pair(parts[3]) is None:
        return False, "the docker server version could not be read (is docker running?)", "unreadable"
    version, platform, server_api, client_api = _version_pair(parts[0]), parts[1], _version_pair(parts[2]), _version_pair(parts[3])
    if not platform.strip().lower().startswith("docker"):
        return False, "the server is %r, not Docker Engine or Docker Desktop (use Docker's own engine, or run the prune by hand)" % _plain(platform, 40), "unsafe"
    if version < DISK_VOLUME_MIN_ENGINE:
        return False, "docker server %d.%d is older than 23.0, where `volume prune` removes named volumes too (upgrade docker)" % version, "unsafe"
    pinned = os.environ.get("DOCKER_API_VERSION", "").strip()
    if pinned and (_version_pair(pinned) is None or _version_pair(pinned) < DISK_VOLUME_MIN_API):
        return False, "DOCKER_API_VERSION=%s pins the API below 1.42, where `volume prune` removes named volumes too (unset it)" % _plain(pinned, 20), "unsafe"
    if min(server_api, client_api) < DISK_VOLUME_MIN_API:
        return False, "the docker API in use is %d.%d, below 1.42, where `volume prune` removes named volumes too (upgrade the docker client or server)" % min(server_api, client_api), "unsafe"
    return True, "", ""


def _volume_bytes(text):
    found = re.fullmatch(r"\s*(\d+(?:\.\d+)?)\s*([kKMGT]?B)\s*", text or "")
    return int(float(found.group(1)) * _SIZE_UNITS[found.group(2).upper()]) if found else None


def anonymous_volumes(docker, runner):
    """(names, bytes or None, complete): the volumes docker lists as dangling (no container references them, stopped ones included) whose inspect shows the
    anonymous label. Names are checked against docker's own shape, so nothing hostile is printed. `bytes` is the sum of their sizes from `docker system df -v`,
    None when docker would not say; `complete` is False past DISK_VOLUME_LIMIT. Read only. Raises OSError when docker cannot answer."""
    def run(argv):
        done = runner([docker] + list(argv), capture_output=True, text=True, timeout=DISK_VOLUME_SECONDS, stdin=subprocess.DEVNULL)
        if done.returncode != 0:
            raise OSError("docker %s: exit %s: %s" % (" ".join(argv[:2]), done.returncode, _plain(done.stderr or done.stdout, 160)))
        return (done.stdout or "")[:DISK_VOLUME_READ_BYTES]
    listed = [l.strip() for l in run(("volume", "ls", "-q", "-f", "dangling=true")).splitlines() if l.strip()]
    ids = [l for l in listed if _DOCKER_ID["volume"].fullmatch(l)]
    complete = len(ids) <= DISK_VOLUME_LIMIT
    ids = ids[:DISK_VOLUME_LIMIT]
    found = [r.get("Name") for r in (_docker_inspect(docker, runner, "volume", ids) if ids else [])
             if isinstance(r.get("Labels"), dict) and DISK_ANONYMOUS_LABEL in r["Labels"] and isinstance(r.get("Name"), str)]
    names = [n for n in found if _DOCKER_ID["volume"].fullmatch(n)]
    size = None
    if names:
        try:
            rows = json.loads(run(("system", "df", "-v", "--format", "{{json .Volumes}}")) or "[]")
            sizes = {r.get("Name"): _volume_bytes(r.get("Size")) for r in rows if isinstance(r, dict)}
            size = sum(sizes[n] for n in names) if all(sizes.get(n) is not None for n in names) else None
        except (OSError, ValueError, subprocess.SubprocessError):
            size = None
    return names, size, complete


def anonymous_volumes_line(docker, runner):
    try:
        names, size, complete = anonymous_volumes(docker, runner)
    except (OSError, subprocess.SubprocessError) as err:
        return "unmounted anonymous volumes: not readable (%s)" % _plain(str(err), 120)
    return "unmounted anonymous volumes: %s%d (%s)" % ("" if complete else ">=", len(names), _human(size) if size is not None else "size not read")


def disk_volume_step(docker, runner, dry_run):
    """The third prune step. Returns (status, lines). Refused unless the server is 23.0 or newer."""
    ok, why, kind = docker_volume_prune_gate(docker, runner)
    if not ok:
        return (EXIT_ERROR if kind == "unreadable" else EXIT_OK), ["volume prune: refused: %s; %s" % (why, "the other two would still run" if dry_run else "the other two ran")]
    lines = []
    if dry_run:
        try:
            names, size, complete = anonymous_volumes(docker, runner)
            lines.append("candidate anonymous volumes: %s%d (%s)" % ("" if complete else ">=", len(names), _human(size) if size is not None else "size not read"))
            lines.extend("  " + n for n in names[:20])
            if len(names) > 20:
                lines.append("  %d more" % (len(names) - 20))
        except (OSError, subprocess.SubprocessError) as err:
            lines.append("candidate anonymous volumes: not readable (%s)" % _plain(str(err), 120))
        lines.append("would run %s (never -a)" % " ".join(["docker"] + list(DISK_VOLUME_PRUNE)))
        return EXIT_OK, lines
    try:
        done = runner([docker] + list(DISK_VOLUME_PRUNE), capture_output=True, text=True, timeout=DISK_PRUNE_TIMEOUT, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError) as err:
        return EXIT_ERROR, ["volume prune: failed: %s" % _plain(str(err), 160)]
    if done.returncode != 0:
        return EXIT_ERROR, ["volume prune: failed (exit %s): %s" % (done.returncode, _plain(done.stderr or done.stdout, 200))]
    found = _RECLAIMED.search(done.stdout or "")
    return EXIT_OK, ["volume prune: reclaimed %s" % (_plain(found.group(1), 40) if found else "nothing reported")]


def cmd_disk_reap_docker(args, runner, now):
    """`disk reap-docker [--apply]`: list (the default) or remove the expired labelled docker objects."""
    docker = _docker_executable(args.docker)
    if docker is None:
        sys.stderr.write("%s: disk reap-docker: %s: nothing was run\n" % (PROG, _docker_message(args.docker)))
        return EXIT_USAGE
    apply = bool(args.apply)
    if apply and not load_config().get("docker_reaper", True):
        sys.stderr.write("%s: disk reap-docker: docker_reaper is false in the config (the kill switch): nothing was removed\n" % PROG)
        return EXIT_USAGE
    audit = AuditLog(ensure_state_dir() / "audit.jsonl") if apply else None
    result = docker_reap(docker, runner, now(), apply, audit, "operator")
    print("%s: %d expired labelled object(s)%s" % ("removed" if apply else "dry run (nothing removed; --apply removes)", len(result["removed"]), ""))
    for kind, ident, owner, expires in result["removed"]:
        print("  %s %s  owner %s  expired %s" % (kind, _plain(ident, 80), _plain(owner, 60), iso(expires)))
    for kind, ident, owner, expires, why in result["kept"]:
        if why != "not expired":
            print("  kept %s %s: %s" % (kind, _plain(ident, 80), why))
    for error in result["errors"]:
        print("  error: %s" % error)
    return EXIT_ERROR if result["errors"] else EXIT_OK


cmd_disk_reap_docker.direct = True


def cmd_disk_prune(args, runner, now):
    """`disk prune [--dry-run]`."""
    docker = _docker_executable(args.docker)
    if docker is None:
        sys.stderr.write("%s: disk prune: %s: nothing was run\n" % (PROG, _docker_message(args.docker)))
        return EXIT_USAGE
    commands = [(docker,) + argv[1:] for argv in DISK_PRUNE_COMMANDS]
    if args.dry_run:
        print("dry run: %s would run, in order, and nothing else (never `-a` on a volume, a running container or `system prune`):" % PROG)
        for argv in commands:
            print("  " + " ".join(shlex.quote(a) for a in argv))
        volume_status, volume_lines = disk_volume_step(docker, runner, True)
        for line in volume_lines:
            print(line)
        return volume_status
    before = disk_free(ensure_state_dir())
    status = EXIT_OK
    for argv in commands:
        try:
            done = runner(list(argv), capture_output=True, text=True, timeout=DISK_PRUNE_TIMEOUT, stdin=subprocess.DEVNULL)
        except (OSError, subprocess.SubprocessError) as err:
            print("%s: failed: %s" % (" ".join(argv[1:3]), _plain(str(err), 160)))
            status = EXIT_ERROR
            continue
        found = _RECLAIMED.search(done.stdout or "")
        if done.returncode != 0:
            print("%s: failed (exit %s): %s" % (" ".join(argv[1:3]), done.returncode, _plain(done.stderr or done.stdout, 200)))
            status = EXIT_ERROR
        else:
            print("%s: reclaimed %s" % (" ".join(argv[1:3]), _plain(found.group(1), 40) if found else "nothing reported"))
    volume_status, volume_lines = disk_volume_step(docker, runner, False)
    for line in volume_lines:
        print(line)
    status = max(status, volume_status)
    after = disk_free(ensure_state_dir())
    if before and after:
        print("disk: %d GB free before, %d GB after" % (before[0] / 1e9, after[0] / 1e9))
    return status


# ---------------------------------------------------------------- `disk report` (#321 slice 1): what holds the disk, read only
#
# On demand only: the daemon's pass never runs it (the status line stays one stat). It lists free space, docker usage (ONE `docker system df`), the
# registered worktrees per agent with size and git state (capped), cache sizes (a bounded walk, no `du`), and orphan CANDIDATES (a process
# parented to init that works inside a registered worktree or the temp dir: a count, never a kill). It writes and removes nothing.

DISK_REPORT_WORKTREES = 20       # worktrees whose git state is read per report: git is a process per question
DISK_WALK_ENTRIES = 200000       # entries one size walk looks at; past it the size is "at least"
DISK_WALK_SECONDS = 5.0
DISK_PS_SECONDS = 20
DISK_PS_LINES = 20000             # lines of the process table scanned
OPENCODE_DATA_DIR = "~/.local/share/opencode"


def tree_size(path, entries=DISK_WALK_ENTRIES, seconds=DISK_WALK_SECONDS, clock=time.monotonic):
    """(bytes, complete): the sum of the file sizes under `path` by a bounded walk (symlinks are not followed and counted at their own size).
    `complete` is False when the entry or time budget ran out: the number is then a lower bound."""
    total, seen, deadline = 0, 0, clock() + seconds
    pending = [str(path)]
    while pending:
        try:
            scan = os.scandir(pending.pop())
        except OSError:
            continue
        with scan:
            for entry in scan:
                seen += 1
                if seen > entries or clock() > deadline:
                    return total, False
                try:
                    if entry.is_dir(follow_symlinks=False):
                        pending.append(entry.path)
                    else:
                        total += entry.stat(follow_symlinks=False).st_size
                except OSError:
                    continue
    return total, True


def _human(size):
    for unit in ("B", "KB", "MB", "GB"):
        if size < 1000 or unit == "GB":
            return "%d %s" % (size, unit) if unit == "B" else "%.1f %s" % (size, unit)
        size /= 1000.0


def disk_temp_dir():
    return Path(tempfile.gettempdir()) / "opencode"


def orphan_candidates(table, roots):
    """The rows of a `ps -axo pid=,ppid=,etime=,command=` text whose parent is init (pid 1) and whose command line names a path under one of `roots`:
    [(pid, etime, command)]. Read only: slice 4 decides what may be killed."""
    found = []
    prefixes = tuple(r.rstrip("/") + "/" for r in roots if r)
    for line in table.splitlines():
        parts = line.split(None, 3)
        if len(parts) < 4 or parts[1] != "1" or not parts[0].isdigit():
            continue
        if any(p in parts[3] for p in prefixes):
            found.append((int(parts[0]), parts[2], parts[3]))
    return found


def disk_report(args, runner, now, out=print):
    """The five sections as a list of lines. Never raises for a tool that is missing: that section says so."""
    engine, state, config = build_engine(runner, now, "cli", writable=False)
    lines = ["free"]
    status = disk_status_line(config, state)
    lines.append("  state volume: %s" % (status or "not readable"))
    lines.append("docker")
    docker = _docker_executable(args.docker)
    if docker is None:
        why = _docker_problem(args.docker)[1]
        lines.append("  docker: %s (%s)" % (why if why.startswith("not installed") else "refused: " + why, _plain(args.docker, 100)))
    else:
        try:
            done = runner([docker, "system", "df"], capture_output=True, text=True, timeout=DOCKER_REAP_TIMEOUT, stdin=subprocess.DEVNULL)
            if done.returncode != 0:
                lines.append("  docker: error: %s" % _plain(done.stderr or done.stdout, 160))
            else:
                lines.extend("  " + _plain(l, 160) for l in (done.stdout or "").splitlines()[:12])
        except (OSError, subprocess.SubprocessError) as err:
            lines.append("  docker: error: %s" % _plain(str(err), 160))
        lines.append("  " + anonymous_volumes_line(docker, runner))
    lines.append("worktrees")
    registry = {p: e for p, e in read_worktrees(state).items() if isinstance(e, dict)}
    shown = sorted(registry.items(), key=lambda kv: (str(kv[1].get("agent")), kv[0]))
    if not shown:
        lines.append("  none registered")
    for path, entry in shown[:DISK_REPORT_WORKTREES]:
        facts = worktree_facts(runner, path)
        if not facts["exists"]:
            lines.append("  %s  %s  gone (registered, directory missing)" % (_plain(entry.get("agent"), 40), _plain(path, 120)))
            continue
        size, complete = tree_size(path)
        git = facts["why"] or "%s, %s" % ("dirty" if facts["dirty"] else "clean", "pushed" if facts["pushed"] else "unpushed")
        lines.append("  %s  %s  %s%s  %s" % (_plain(entry.get("agent"), 40), _plain(path, 120), "" if complete else ">=", _human(size), git))
    if len(shown) > DISK_REPORT_WORKTREES:
        lines.append("  %d more not read (cap %d)" % (len(shown) - DISK_REPORT_WORKTREES, DISK_REPORT_WORKTREES))
    lines.append("caches")
    temp = disk_temp_dir()
    for label, path in (("state dir", state), ("opencode data", Path(os.path.expanduser(OPENCODE_DATA_DIR))), ("temp dir", temp)):
        if not Path(path).is_dir():
            lines.append("  %s: not present (%s)" % (label, _plain(path, 120)))
            continue
        size, complete = tree_size(path)
        lines.append("  %s: %s%s (%s)" % (label, "" if complete else ">=", _human(size), _plain(path, 120)))
    lines.append("orphans")
    try:
        done = runner(["ps", "-axo", "pid=,ppid=,etime=,command="], capture_output=True, text=True, timeout=DISK_PS_SECONDS, stdin=subprocess.DEVNULL)
        table = "\n".join((done.stdout or "").splitlines()[:DISK_PS_LINES]) if done.returncode == 0 else None
    except (OSError, subprocess.SubprocessError):
        table = None
    if table is None:
        lines.append("  candidates: not readable (ps failed)")
    else:
        found = orphan_candidates(table, list(registry) + [str(temp)])
        lines.append("  candidates: %d (parent is init and the command names a registered worktree or the temp dir; reported only, nothing is killed)" % len(found))
        for pid, etime, command in found[:10]:
            lines.append("    %d  up %s  %s" % (pid, etime, _plain(command.split(None, 1)[0], 100)))   # the program only: its arguments could carry a secret
    return lines


def cmd_disk_report(args, runner, now):
    """`disk report` (and a bare `disk`): free space, docker usage, worktrees per agent, cache sizes and orphan candidates. Read only."""
    for line in disk_report(args, runner, now):
        print(line)
    return EXIT_OK


JANITOR_OPEN_SECONDS = 30   # the open-file check's own time limit: past it the entries are kept, never waited for


def janitor_agent_roots(engine, now, days):
    """[(agent name, directory)]: the working directory and the private temp directory of every agent the registry holds NOW, live, or retired within `days`.
    THE ONE FUNCTION that reads the agent list for the janitor: when the one registry (#929) lands, only its body changes. Raises janitor.Unknown when a
    record exists and cannot be read (the janitor then keeps every entry); a missing record is an empty one."""
    if engine.state_dir is None:
        raise janitor_unknown("there is no state directory")
    live, retired_at = {}, {}
    try:
        with open(str(Path(engine.state_dir) / PANE_HEALTH_FILE), "rb") as handle:
            raw = json.loads(handle.read(1000001).decode("utf-8"))
        if not isinstance(raw, dict) or not isinstance(raw.get("agents", {}), dict):
            raise ValueError("not a map of agents")
    except FileNotFoundError:
        raw = {}
    except (OSError, ValueError, UnicodeError) as err:
        raise janitor_unknown("%s cannot be read (%s)" % (PANE_HEALTH_FILE, _one_line(str(err), 60)))
    for name, info in (raw.get("agents") or {}).items():
        live[name] = info.get("cwd") if isinstance(info, dict) else None
    for name in (getattr(getattr(engine, "discovery", None), "agents", None) or {}):
        live.setdefault(name, None)
    try:
        retired = read_retired_strict(engine.state_dir)
    except RetiredUnreadable as err:
        raise janitor_unknown("%s cannot be read (%s)" % (RETIRED_FILE, _one_line(str(err), 60)))
    cutoff = now - days * 86400
    for name, entry in retired.items():
        at = entry.get("at")
        if not isinstance(at, (int, float)) or isinstance(at, bool) or at >= cutoff:   # a time that cannot be read counts as recent: the doubt keeps
            record = entry.get("record") if isinstance(entry.get("record"), dict) else {}
            retired_at[name] = record.get("cwd")
    roots = []
    for name, cwd in sorted(dict(retired_at, **live).items()):
        if isinstance(cwd, str) and os.path.isabs(cwd):
            roots.append((name, cwd))
        if NAME_RE.fullmatch(name or "") and not agent_tmp_shared_name(name):   # the shared directory is the janitor's own: it is no one agent's
            for base in (agent_tmp_root(engine.config), headless_tmp_root()):
                if base is not None:
                    roots.append((name, str(base / name)))
    return roots


def janitor_unknown(message):
    return load_disk_janitor().Unknown(message)


def janitor_busy_function(engine, runner, janitor):
    """`busy(path)` for the temp janitor: why an entry is in use, else None; raises janitor.Unknown when something cannot be read (the entry is then kept).
    In use = a herdr pane (an agent's or a plain terminal) works in it, a non-retired agent's session runs in it (both from `worktree_in_use`), or ANY live
    process has it as its working directory (one `lsof -a -d cwd -Fn` per run, bounded by a timeout)."""
    held = {}
    days = (engine.config.get("temp_janitor") or {}).get("days", 7)
    if isinstance(days, bool) or not isinstance(days, int):
        days = 7

    def open_paths():
        """The paths of every file a live process holds open (one `lsof -Fn` per run, bounded by a timeout). A timeout, an error or a list too long raises Unknown."""
        if "open" not in held:
            try:
                done = runner(["lsof", "-n", "-P", "-Fn"], capture_output=True, text=True, timeout=JANITOR_OPEN_SECONDS, stdin=subprocess.DEVNULL)
            except (OSError, subprocess.SubprocessError) as err:   # includes a timeout
                raise janitor.Unknown("the open-file check did not finish: %s" % _one_line(str(err), 80))
            if done.returncode not in (0, 1) or (done.returncode == 1 and not (done.stdout or "").strip()):
                raise janitor.Unknown("the open-file check failed (exit %s)" % done.returncode)
            lines = (done.stdout or "").splitlines()
            if len(lines) > 2000000:
                raise janitor.Unknown("the open-file check listed more than 2000000 lines: a file past the limit would not protect its entry")
            limit, resolved = time.monotonic() + JANITOR_OPEN_SECONDS, []
            for l in lines:
                if l.startswith("n/"):
                    if time.monotonic() > limit:
                        raise janitor.Unknown("resolving the open-file list took longer than %d s" % JANITOR_OPEN_SECONDS)
                    resolved.append(os.path.realpath(l[1:]))
            held["open"] = resolved
        return held["open"]

    def process_directories():
        if "dirs" not in held:
            try:
                done = runner(["lsof", "-a", "-d", "cwd", "-Fn"], capture_output=True, text=True, timeout=30, stdin=subprocess.DEVNULL)
            except (OSError, subprocess.SubprocessError) as err:
                raise janitor.Unknown("lsof did not run: %s" % _one_line(str(err), 80))
            if done.returncode not in (0, 1) or (done.returncode == 1 and not (done.stdout or "").strip()):
                raise janitor.Unknown("lsof failed (exit %s)" % done.returncode)
            lines = (done.stdout or "").splitlines()
            if len(lines) > 200000:
                raise janitor.Unknown("lsof listed more than 200000 lines: a process past the limit would not protect its directory")
            held["dirs"] = [os.path.realpath(l[1:]) for l in lines if l.startswith("n/")]
        return held["dirs"]

    def busy(path):
        why = worktree_in_use(engine, path)
        if why:
            return why
        root = os.path.realpath(path).rstrip("/") + "/"
        try:
            roots = janitor_agent_roots(engine, engine.now(), days)
        except janitor.Unknown:
            raise
        except Exception as err:   # a registry that cannot be read keeps the entry
            raise janitor.Unknown("the agent registry cannot be read (%s)" % _one_line("%s: %s" % (type(err).__name__, err), 80))
        for name, where in roots:
            here = os.path.realpath(where).rstrip("/") + "/"
            if here.casefold().startswith(root.casefold()) or root.casefold().startswith(here.casefold()):   # case-folded: a case-insensitive volume may spell it otherwise (over-keeping is the safe side)   # it is, contains or sits inside the agent's directory
                return "it is, holds or sits inside the temp or working directory of agent %s" % _plain(name, 60)
        for where in process_directories():
            if (where.rstrip("/") + "/").casefold().startswith(root.casefold()):
                return "a live process has it as its working directory (%s)" % _plain(where, 100)
        for where in open_paths():
            if (where.rstrip("/") + "/").casefold().startswith(root.casefold()):
                return "a live process has a file of it open"
        return None
    return busy


def cmd_disk_janitor(args, runner, now):
    """`disk janitor [--apply]`: the temp-directory janitor (bin/disk_janitor.py). A dry run by default; `--apply` is the operator's or the Chief of Staff's."""
    janitor = load_disk_janitor()
    engine, state, config = build_engine(runner, now, "cli", writable=bool(args.apply))
    cfg = janitor.settings(config.get("temp_janitor"))
    if args.apply:
        kind = gates_caller_kind(runner, now)
        if not (kind[0] == "person" or (kind[0] == "agent" and len(kind) > 2 and kind[2] == "chief-of-staff")):
            raise LaunchError("refused: only the operator or the Chief of Staff may --apply the temp janitor (%s is %s)" % (kind[1], "an agent" if kind[0] == "agent" else "not known"))
        if not cfg["enabled"]:
            raise LaunchError("the temp janitor is switched off (temp_janitor.enabled is false)")
    temp = Path(cfg["dir"]) if cfg.get("dir") else janitor.default_dir()
    reviewed = getattr(args, "i_reviewed", None)
    if reviewed and not args.apply:
        raise LaunchError("--i-reviewed names the preview an --apply may remove: add --apply, or drop the flag for a dry run")
    if args.apply and not reviewed:
        raise LaunchError("refused: --apply needs --i-reviewed <fingerprint> naming the preview you just read. Run `%s disk janitor` (a dry run), read the list, "
                          "and pass the fingerprint it prints. The weekly run is the daemon's, under a recorded yes (`disk janitor-ack`); nothing else removes anything" % PROG)
    weekly = bool(getattr(args, "weekly", False))
    if args.apply and weekly:
        raise LaunchError("refused: --weekly is the daemon's run: a hand-run --apply takes no --weekly (the preview you read was made under the ordinary budget)")
    audit = lambda name, detail: engine.audit.append(engine.actor, "temp.removed", _plain(name, 120), detail)
    with worktree_sweep(engine):   # one session.list for every in-use check of this run
        preview = []   # the dry run's list: its fingerprint is the daemon's, by the same function (`preview_fingerprint`), so a yes and this flag name the same thing
        lines, removed, kept = janitor.run(temp, state, now(), cfg, False, audit, busy=janitor_busy_function(engine, runner, janitor), weekly=weekly, outcome=preview)
        fingerprint = janitor.preview_fingerprint(janitor.rule_fingerprint(cfg), [o["name"] for o in preview])
        if args.apply:
            if reviewed != fingerprint:
                raise LaunchError("refused: --i-reviewed %s is not this preview's fingerprint (%s): the rule or the list changed since you read it. Nothing was removed; "
                                  "run the dry run again and read it" % (_one_line(reviewed, 40), fingerprint))
            lines, removed, kept = janitor.run(temp, state, now(), cfg, True, audit, busy=janitor_busy_function(engine, runner, janitor), weekly=False,
                                               only=set(o["name"] for o in preview))   # only what the fingerprint named: an entry that qualifies between the two scans is kept
    for line in lines:
        print(_plain(line, 300))
    print("%s: %d %s, %d kept (%s)" % (PROG, removed, "removed" if args.apply else "would be removed (a dry run: add --apply --i-reviewed %s)" % fingerprint, kept, _plain(temp, 160)))
    if not args.apply:
        print("preview fingerprint: %s" % fingerprint)
    return EXIT_OK


def cmd_disk_janitor_ack(args, runner, now):
    """`disk janitor-ack <preview>`: record the yes to the temp janitor's would-remove preview the daemon sent. Only the operator or the Chief of Staff; the
    fingerprint must be the pending preview's (a yes to an older one is refused, and the daemon compares it again before it applies anything)."""
    kind = gates_caller_kind(runner, now)
    if not (kind[0] == "person" or (kind[0] == "agent" and len(kind) > 2 and kind[2] == "chief-of-staff")):
        raise LaunchError("refused: only the operator or the Chief of Staff may record the yes to a temp janitor preview (%s is %s)" % (kind[1], "an agent" if kind[0] == "agent" else "not known"))
    engine, state, _ = build_engine(runner, now, "cli", writable=True)
    ok, gate = read_janitor_record(state, TEMP_JANITOR_GATE_FILE)
    if not ok or gate.get("sent") is not True or gate.get("preview") != args.preview:
        raise LaunchError("no pending temp janitor preview has the fingerprint %s (it may be an older one: the newest is in the Chief of Staff's message): nothing recorded" % _one_line(args.preview, 40))
    _write_small(state, TEMP_JANITOR_ACK_FILE, {"rule": gate["rule"], "preview": gate["preview"], "nonce": gate.get("nonce", ""), "by": kind[1], "at": now()})
    engine.audit.append(engine.actor, "janitor.ack", "temp", {"rule": gate["rule"], "preview": gate["preview"], "by": kind[1]})
    print("%s: recorded the yes to temp janitor preview %s (rule %s): the daemon may apply while temp_janitor.daemon_apply is true" % (PROG, gate["preview"], gate["rule"]))
    return EXIT_OK


def cmd_disk(args, runner, now):
    """The `disk` group: `prune` (the disk guard, #319), `reap-docker` (#326) and `reclaim-worktrees` / `register-worktree` (the worktree lifecycle, #321)."""
    try:   # `direct` skips dispatch's error mapping, so refusals are mapped here for every subcommand
        return {"report": cmd_disk_report, None: cmd_disk_report, "prune": cmd_disk_prune, "reap-docker": cmd_disk_reap_docker, "janitor": cmd_disk_janitor, "janitor-ack": cmd_disk_janitor_ack, "reap-orphans": cmd_disk_reap_orphans, "reclaim-worktrees": cmd_disk_reclaim_worktrees, "register-worktree": cmd_disk_register_worktree}[args.disk_action](args, runner, now)
    except (LaunchError, ConfigError, CallerError, LockError) as err:
        sys.stderr.write("%s: %s\n" % (PROG, _one_line(str(err))))
        return EXIT_ERROR


cmd_disk.direct = True   # an operator's command on the machine: no daemon start


class _RedsReader:
    """GET-only reads for `reds` through the repo's own gh account: JSON through the account gate (counted, paused when the limit is spent); the artifact as bytes
    straight from the runner (not counted by the gate; its size was checked against the artifact list before this is called)."""

    def __init__(self, config, runner, now, repo):
        self.config, self.runner, self.repo = config, runner, repo
        self.accounts = GhAccounts(config, runner, now)

    def json(self, path):
        done = self.accounts.read(self.runner, path, self.repo, self.config["call_timeout_seconds"], stdin=subprocess.DEVNULL)
        if done.returncode != 0:
            raise load_reds().RedsError("gh api %s: %s" % (path.split("?")[0], self.accounts.scrub(_one_line(done.stderr or done.stdout or "exit %d" % done.returncode, 120))))
        try:
            return json.loads(done.stdout)
        except ValueError:
            raise load_reds().RedsError("gh api %s: not JSON" % path.split("?")[0]) from None

    def zip(self, path):
        refuse_excluded(self.config, self.repo)   # #446: json() refuses first; the zip read does not rely on that
        env = self.accounts.env_for(self.repo)
        extra = {"env": env} if env is not None else {}
        done = self.runner([self.config["gh"], "api", path], capture_output=True, timeout=max(60, self.config["call_timeout_seconds"]), stdin=subprocess.DEVNULL, **extra)
        if done.returncode != 0:
            err = done.stderr if isinstance(done.stderr, str) else (done.stderr or b"").decode("utf-8", "replace")
            raise load_reds().RedsError("gh api %s: %s" % (path.split("?")[0], self.accounts.scrub(_one_line(err, 120)) or "exit %d" % done.returncode))
        return done.stdout

    PULL_STATE_QUERY = "query($owner:String!,$name:String!,$number:Int!){repository(owner:$owner,name:$name){pullRequest(number:$number){state mergeQueueEntry{id state}}}}"

    def pull_state(self, number):
        """{"state": "OPEN"|"MERGED"|"CLOSED", "queued": bool, "entry_state": the queue entry's state or None} of one pull request (#584, #696): ONE GraphQL read, a query with fixed text (the number is a typed variable).
        gh's `pr view` has no merge queue field. Raises RedsError when it cannot be read."""
        refuse_excluded(self.config, self.repo)
        owner, _, name = self.repo.partition("/")
        env = self.accounts.env_for(self.repo)
        extra = {"env": env} if env is not None else {}
        argv = [self.config["gh"], "api", "graphql", "-f", "query=" + self.PULL_STATE_QUERY, "-f", "owner=" + owner, "-f", "name=" + name, "-F", "number=%d" % number]
        done = self.runner(argv, capture_output=True, text=True, timeout=self.config["call_timeout_seconds"], stdin=subprocess.DEVNULL, **extra)
        if done.returncode != 0:
            raise load_reds().RedsError("gh api graphql: %s" % (self.accounts.scrub(_one_line(done.stderr or done.stdout or "", 120)) or "exit %d" % done.returncode))
        try:
            pull = json.loads(done.stdout)["data"]["repository"]["pullRequest"]
            state = pull["state"]
        except (ValueError, KeyError, TypeError):
            raise load_reds().RedsError("gh api graphql: no pull request in the answer") from None
        if state not in ("OPEN", "MERGED", "CLOSED"):
            raise load_reds().RedsError("gh api graphql: unknown pull request state")
        entry = pull.get("mergeQueueEntry")
        entry_state = entry.get("state") if isinstance(entry, dict) and isinstance(entry.get("state"), str) else None
        return {"state": state, "queued": bool(entry), "entry_state": entry_state}


def cmd_reds(args, runner, now):
    """`reds <owner/repo#N>`: classify a pull request's failing tests (#342): failing on main's latest run, flaky there, or new. Read only."""
    module = load_reds()
    match = re.fullmatch(r"([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)#([0-9]{1,9})", args.pr)
    if match is None:
        sys.stderr.write("%s: reds: %r is not OWNER/REPO#N\n" % (PROG, _plain(args.pr, 80)))
        return EXIT_USAGE
    repo, number = match.group(1), int(match.group(2))
    config = load_config()
    events = (module.settings(config.get("reds")).get(repo)) or list(module.DEFAULT_EVENTS)
    try:
        cache_dir = ensure_state_dir()
    except Exception:
        cache_dir = None   # no cache is only more calls
    reader = _RedsReader(config, runner, now, repo)
    return module.run(reader, repo, number, events, cache_dir, now, sys.stdout, module.workflows(config.get("reds")).get(repo))


cmd_reds.direct = True   # reads GitHub on its own terms: no daemon start


def add_reds_parsers(sub):
    reds = sub.add_parser("reds", help="Classify a pull request's failing tests: failing on main's latest run, flaky there, or new (read only)",
                          description="`reds OWNER/REPO#N` reads the `failing-tests` artifact (failing-tests.json v1) of the pull request's run and of main's last runs and "
                                      "prints which failing names also fail on main's latest run, which are flaky there (2 or more of its last 5 usable runs) and which "
                                      "are new. Main's runs are the runs of the repo's reference events on the default branch (config reds.reference_events, default push; "
                                      "a merge_group reference is read by its gh-readonly-queue ref). Main is judged ONLY by main's own runs: the pull request's list "
                                      "and its `complete` flag are its own claim. A run with no artifact, an expired one or complete=false is UNKNOWN, never passing. "
                                      "Names match in full, else by a UNIQUE leaf (marked 'matched by name only'). Bounded calls, cached by run id; it writes nothing to GitHub.")
    reds.add_argument("pr", help="OWNER/REPO#N")


HEAVY_SEND_SECONDS = 45   # the one message to the lane after a stop is bounded: a stop never waits on it for long


def heavy_stop_send(engine, lane, text):
    """Tell `lane` of a stopped heavy run through the engine's own delivery: "sent", "unknown name" (no such agent: nothing is sent) or "failed"."""
    discovery = engine.discover(engine.now())
    target = resolve_boss(discovery, lane)
    if target not in discovery.agents:
        return "unknown name"
    outcome = engine.send("switchboard", target, text)
    return "sent" if outcome.get("sent") else "failed"


def heavy_stop_reporter(module, config, make_engine, actor):
    """`on_stop(phase, info, holder, lane)` for the heavy module. Phase "decided" (before the stop) writes the audit line `heavy.stopped`; phase "told" (after it) sends the
    one bounded message to the lane and writes `heavy.lane_told`. `make_engine()` gives the engine to send with and audit through; a failure never stops the stop."""
    box = {}

    def audit(event, subject, detail):
        engine = box.get("engine")
        log = engine.audit if engine is not None and engine.audit is not None else AuditLog(ensure_state_dir() / "audit.jsonl")
        log.append(getattr(engine, "actor", actor), event, subject, detail)

    def send(name, text):
        def work():
            box["engine"] = box.get("engine") or make_engine()
            return heavy_stop_send(box["engine"], name, text)
        done, told = run_bounded(work, HEAVY_SEND_SECONDS)
        return told if done else "failed"

    def on_stop(phase, info, holder, lane):
        if phase == "decided":
            module.record_stop(info, holder, audit, sys.stderr.write)
        elif phase == "lost":   # a waiter died in the line: one audit line, no message (nobody is running)
            module.record_lost(info, audit, sys.stderr.write)
        else:
            module.tell_lane(info, holder, lane, send, audit, module.ceiling_table(config)["max"], sys.stderr.write)
    return on_stop


def cmd_heavy(args, runner=subprocess.run, now=time.time):
    """`heavy [--slots N] [--wait-max S] [--ceiling S] -- <command...>`: run the command in a CPU slot (ask #34); its exit status is ours."""
    module = load_heavy_slots()
    command = list(args.command)
    if command[:1] == ["--"]:
        command = command[1:]
    try:
        if not command:
            raise module.HeavyError("no command: heavy [--slots N] [--wait-max S] -- <command...>")
        if args.slots is not None and not 1 <= args.slots <= module.SLOTS_MAX:
            raise module.HeavyError("--slots must be from 1 to %d" % module.SLOTS_MAX)
        if args.wait_max is not None and args.wait_max < 0:
            raise module.HeavyError("--wait-max must be 0 or more")
        heavy_config = load_config().get("heavy") if config_path().exists() else None
        configured = module.settings(heavy_config)
    except (module.HeavyError, ConfigError) as err:
        sys.stderr.write("%s: heavy: %s\n" % (PROG, err))
        return EXIT_USAGE
    try:
        state = ensure_state_dir()
    except Exception as err:   # a state directory that cannot be made or is refused: the command still runs, without a slot (heavy never fails someone else's command)
        sys.stderr.write("heavy: no slot (%s): running without one\n" % _one_line(str(err), 160))
        state = None
    reporter = heavy_stop_reporter(module, heavy_config, lambda: build_engine(runner, now, "cli")[0], "heavy") if state is not None else None
    return module.run(command, state, args.slots or configured, module.DEFAULT_WAIT_MAX if args.wait_max is None else args.wait_max, args.name,
                      short=bool(getattr(args, "short", False)), ceiling=getattr(args, "ceiling", None), ceiling_config=heavy_config, on_stop=reporter)


cmd_heavy.direct = True   # the wrapper of someone else's command: no daemon start, no error mapping


def add_heavy_parsers(sub):
    heavy = sub.add_parser("heavy", help="Run a heavy command (a full test suite, a browser or e2e run) in one of a few CPU slots, at background priority",
                           description="`heavy [--slots N] [--wait-max SECONDS] [--short] [--name WHO] -- <command...>`: waits for a free slot in arrival order (default 3, config `heavy.slots`; one line "
                                       "every 30 s says your place and who holds them), then runs the command as `taskpolicy -b <command>` (else `nice -n 10`) with its stdin, stdout, "
                                       "exit status and signals passed through. After --wait-max seconds (default 1800) it exits 75 and does not run the command.")
    heavy.add_argument("--slots", type=int, help="How many commands may run at once (default: config heavy.slots, else 3)")
    heavy.add_argument("--wait-max", type=int, dest="wait_max", help="Give up after this many seconds without a slot: exit 75 (default 1800)")
    heavy.add_argument("--short", action="store_true", help="The command is short: when the ordinary slots are busy it may use the one express slot, and the wrapper stops it after 120 seconds (exit 124)")
    heavy.add_argument("--ceiling", help="Ask for a longer (or shorter) time ceiling in seconds than the kind of command's default, up to the hard maximum (14400); 0 reads as the maximum, an unreadable value as the default")
    heavy.add_argument("--name", help="Who the slot is held for (default: FLEET_HEAVY_NAME, the OpenCode session id, the user)")
    heavy.add_argument("command", nargs=argparse.REMAINDER, help="-- <command...>")


# ---- `preflight-pr`: the CI-critical focused classes a coder skips, one PASS or FAIL line each. The ONE table of classes is PREFLIGHT_CLASSES.
# (name, time ceiling in seconds, commands: each runs in turn under `heavy`, and the class passes when every one exits 0, when files change under: None = always)
PREFLIGHT_CLASSES = (
    ("cli-surface", 240, (("bin/test-switchboard", "-k", "TestSelfRegisteringCli"),), None),
    ("hygiene", 240, (("bin/test-switchboard", "-k", "TestHygiene", "-k", "test_the_role_files_do_not_grow"),), None),
    ("public-names", 60, (("python3", "bin/check-public-names"),), None),
    ("cloud", 600, (("bin/test-cloud-worker",), ("bin/test-cloud-launcher",), ("cloud/tests/test-cloud",)), "cloud/"),
)
# The preflight sub-checks CI runs for the pull request itself (#942): (command, the name it is shown by). Each row is skipped, with a line that says so, when the
# workflow at the base runs that command on `pull_request`; every other sub-check of PREFLIGHT_CLASSES always runs. Not being able to tell is a run.
PREFLIGHT_CI_SKIPS = (("bin/test-cloud-launcher", "cloud launcher"),)
PREFLIGHT_WORKFLOW = ".github/workflows/test.yml"
PREFLIGHT_STEP_IF = ("${{ !cancelled() }}", "${{ always() }}", "${{ success() }}", "${{ success() || failure() }}", "always()", "success()")   # a step condition that still runs it


PREFLIGHT_JOB_KEYS_HIDING = ("if", "continue-on-error")   # job-level keys after which a failure of the job cannot fail CI (or the job may not run): the job does not count
PREFLIGHT_SWALLOW = r"\|\|\s*(true|:|exit 0)\b|\bset\s+\+e\b"   # a run line that swallows the command's failure


def job_hides(line):
    """True for a job-level key (four spaces) of PREFLIGHT_JOB_KEYS_HIDING that can hide the job's failure: any `if`, any `continue-on-error` other than false."""
    key = re.match(r"    (%s)\s*:\s*(.*)$" % "|".join(re.escape(k) for k in PREFLIGHT_JOB_KEYS_HIDING), line)
    return bool(key) and not (key.group(1) == "continue-on-error" and re.match(r"false\b", key.group(2).strip()))


def workflow_job_running(text, command):
    """The name of a job of the workflow `text` that runs `command` on `pull_request`, or None when it cannot be told: a text-only reading (no YAML library), the
    safe side being None. The job needs no job-level `if`; the step that runs the command needs no `continue-on-error` and no condition but one of PREFLIGHT_STEP_IF."""
    lines = text.splitlines()
    try:
        top = next(i for i, line in enumerate(lines) if re.match(r"on\s*:", line))
        jobs = next(i for i, line in enumerate(lines) if line.rstrip() == "jobs:")
    except StopIteration:
        return None
    head = lines[top]
    block = [head] + [line for line in lines[top + 1:jobs] if line.startswith((" ", "\t")) or not line.strip()]
    if not any(re.match(r"\s*(on\s*:\s*)?(\[.*\bpull_request\b.*\]|pull_request\s*:?)\s*(#.*)?$", line) or re.match(r"on\s*:.*\bpull_request\b", line) for line in block if not line.lstrip().startswith("#")):
        return None
    for number, line in enumerate(block):   # a filter under the trigger (paths, branches, types ...) or an inline mapping: CI may not run for this pull request
        if re.match(r"\s+pull_request\s*:\s*(#.*)?$", line):
            indent = len(line) - len(line.lstrip())
            nested = [l for l in block[number + 1:] if l.strip() and not l.lstrip().startswith("#")][:1]
            if nested and len(nested[0]) - len(nested[0].lstrip()) > indent:
                return None
        if re.match(r"on\s*:.*\{", line) or re.match(r"\s+pull_request\s*:\s*\S", line) and not re.match(r"\s+pull_request\s*:\s*(#.*)?$", line):
            return None
    name, found = None, []
    for line in lines[jobs + 1:]:
        if line and not line.startswith(" ") and not line.startswith("#"):
            break
        job = re.fullmatch(r"  ([A-Za-z0-9_-]+):\s*", line)
        if job:
            name = job.group(1)
            found.append((name, []))
        elif found:
            found[-1][1].append(line)
    for name, body in found:
        if any(job_hides(line) for line in body):
            continue
        steps, current = [], None
        for line in body:
            if re.match(r"      - ", line):
                current = [line]
                steps.append(current)
            elif current is not None:
                current.append(line)
        for step in steps:
            live = [line for line in step if not line.lstrip().startswith("#") and not re.match(r"\s*(- )?name\s*:", line)]
            runs = [re.sub(r"^\s*(- )?(run\s*:\s*(\|[-+]?\s*)?)?", "", line) for line in live]
            starts = [line for line in runs if re.match(r"%s(\s|$)" % re.escape(command), line)]   # the command is the FIRST word of a line, not a mention
            if not starts:
                continue
            conditions = [re.sub(r"^\s*(- )?if\s*:\s*", "", line).strip() for line in step if re.match(r"\s*(- )?if\s*:", line)]
            hidden = any(re.match(r"\s*(- )?continue-on-error\s*:\s*(?!false\b)", line) for line in step) or any(c not in PREFLIGHT_STEP_IF for c in conditions)
            if hidden or any(re.search(PREFLIGHT_SWALLOW, line) for line in runs):
                continue
            return name
    return None


def preflight_ci_runs(runner, root, command, changed):
    """The job name when CI runs `command` for this pull request (the workflow file runs it on `pull_request`, and this branch does not change the workflow, so the file
    in the work tree is the one at the base), else None. It reads a file and makes no git call."""
    if changed is None or PREFLIGHT_WORKFLOW in changed:
        return None
    try:
        with open(os.path.join(root, PREFLIGHT_WORKFLOW), encoding="utf-8") as handle:
            text = handle.read(262144)
    except (OSError, UnicodeDecodeError):
        return None
    return workflow_job_running(text, command)


PREFLIGHT_CEILING_MAX = 3600   # the absolute maximum of any class's ceiling, in seconds: a hung class still ends


def preflight_ceiling(base, load1, cores):
    """The ceiling of a class on a machine with this load: `base * (1 + load1 / cores)`, at most PREFLIGHT_CEILING_MAX .
    Load 0 gives `base`; a load of one per core doubles it."""
    try:
        factor = 1.0 + max(0.0, float(load1)) / max(1, int(cores))
    except (TypeError, ValueError):
        factor = 1.0
    return int(min(base * factor, PREFLIGHT_CEILING_MAX))


def preflight_load():
    try:
        return os.getloadavg()[0], os.cpu_count() or 1
    except (OSError, AttributeError):
        return 0.0, 1


PREFLIGHT_TOKEN_LENGTH = 49   # the macOS-only path-length trap: a token-shaped directory name of this length under TMPDIR


def preflight_changed(runner, root):
    """The files changed against the base (merge-base with origin/main, else main), or None when no base can be found (the cloud class then runs: safe side)."""
    for base in ("origin/main", "main"):
        found = runner(["git", "merge-base", "HEAD", base], cwd=root, capture_output=True, text=True)
        if found.returncode == 0 and found.stdout.strip():
            diff = runner(["git", "diff", "--name-only", found.stdout.strip()], cwd=root, capture_output=True, text=True)
            if diff.returncode == 0:
                return diff.stdout.split()
    return None


def cmd_preflight_pr(args, runner, now):
    """`preflight-pr`: run each class of PREFLIGHT_CLASSES under `heavy`, print one PASS or FAIL line per class, exit 1 when any fails. Only runs tests."""
    top = runner(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    if top.returncode != 0:
        sys.stderr.write("%s: preflight-pr: not inside a git work tree\n" % PROG)
        return EXIT_USAGE
    root = top.stdout.strip()
    changed = preflight_changed(runner, root)
    failed = 0
    with tempfile.TemporaryDirectory(prefix="preflight-") as work:
        for name, base_ceiling, commands, under in PREFLIGHT_CLASSES:
            load1, cores = preflight_load()
            ceiling = preflight_ceiling(base_ceiling, load1, cores)
            if under is not None and changed is not None and not any(path.startswith(under) for path in changed):
                continue
            commands = list(commands)
            for skipped, shown in PREFLIGHT_CI_SKIPS:
                job = preflight_ci_runs(runner, root, skipped, changed) if (skipped,) in commands else None
                if job:
                    commands.remove((skipped,))
                    print("preflight-pr: %s: skipped, CI runs it for this pull request (job %s)" % (shown, job))
            env = dict(os.environ, FLEET_HEAVY_MAX_SECONDS=str(ceiling), **NO_CREDENTIAL_DIALOG_ENV)   # the ceiling runs INSIDE the slot (heavy's watchdog starts when the slot is granted): a wait in the queue is never a timeout
            sys.stderr.write("preflight-pr: %s: waiting for a slot, then running (ceiling %ds once running)\n" % (name, ceiling))
            if under is not None:
                scratch = os.path.join(work, ("tok_" + "x" * PREFLIGHT_TOKEN_LENGTH)[:PREFLIGHT_TOKEN_LENGTH])
                os.makedirs(scratch, exist_ok=True)
                env.update(TMPDIR=scratch, CLOUD_TEST_SKIP_DOCKER="1")
            started, verdict, tail = now(), "PASS", ""
            for command in commands:
                try:
                    done = runner([sys.executable, os.path.abspath(__file__), "heavy", "--"] + list(command), cwd=root, env=env, capture_output=True, text=True)
                except subprocess.TimeoutExpired:   # only a runner of its own making raises this: heavy has no outer clock here
                    verdict, tail = "FAIL", "timed out after %ds, its ceiling (load average %.1f on %d cores)" % (ceiling, load1, cores)
                    break
                if done.returncode == 124:
                    verdict, tail = "FAIL", "timed out after %ds running, its ceiling (load average %.1f on %d cores)" % (ceiling, load1, cores)
                    break
                if done.returncode == 64 and "heavy: refused: a full-suite job is already queued or running" in (done.stderr or ""):   # heavy's refusal (a test that itself exits 64 is a failure)
                    verdict, tail = "FAIL", "refused: a full-suite job is already queued or running in this worktree (the tests did not run)"
                    break
                if done.returncode == 75:
                    verdict, tail = "NOSLOT", "no heavy slot came in time (the tests did not run)"
                    break
                if done.returncode != 0:
                    verdict, tail = "FAIL", "exit %d: %s" % (done.returncode, _one_line(" ".join(command), 80))
                    sys.stderr.write("".join(("%s: %s\n" % (name, line)) for line in ((done.stdout or "") + (done.stderr or "")).splitlines()[-15:]))
                    break
            failed += verdict != "PASS"
            print("%s %s (%ds)%s" % (verdict, name, max(0, int(now() - started)), (": " + tail) if tail else ""))
    return EXIT_ERROR if failed else EXIT_OK


cmd_preflight_pr.direct = True   # only runs tests: no daemon start, no GitHub, no ledger


def add_preflight_pr_parsers(sub):
    sub.add_parser("preflight-pr", help="Run the CI-critical focused test classes coders skip, under `heavy`: one PASS or FAIL line each, exit 1 when any fails",
                   description="Runs, each under the `heavy` wrapper and a time ceiling: the command-surface snapshot class, the hygiene and role-file classes, "
                               "bin/check-public-names and, when files under cloud/ changed against the base, the cloud suites with TMPDIR a 49-character "
                               "token-shaped directory name. Only runs tests: it never pushes, labels or records a verdict.")


def add_disk_parsers(sub):
    disk = sub.add_parser("disk", allow_abbrev=False, help="Disk tools: `disk report` (a bare `disk`) shows what holds the disk, read only; `disk prune` removes old docker build cache and images (never volumes or running containers); `disk reclaim-worktrees` removes the clean, pushed worktrees of retired agents")
    disk_sub = disk.add_subparsers(dest="disk_action", required=False)
    disk.add_argument("--docker", default="docker", help="The docker executable the bare `disk` report asks (default: docker on PATH)")
    report = disk_sub.add_parser("report", allow_abbrev=False, help="what holds the disk: free space, docker usage, worktrees per agent, cache sizes, orphan candidates (read only; also a bare `disk`)")
    report.add_argument("--docker", default=argparse.SUPPRESS, help="The docker executable (default: docker on PATH)")
    prune = disk_sub.add_parser("prune", allow_abbrev=False, help="docker builder prune, docker image prune -a (older than a week) and, on docker 23.0 or newer, docker volume prune -f (anonymous volumes only), and nothing else",
                                description="Runs exactly `docker builder prune -f --filter until=168h` and `docker image prune -a -f --filter until=168h` and prints what "
                                            "was reclaimed, then (only when the docker server is 23.0 or newer, where it removes ANONYMOUS volumes no container references and nothing named) "
                                            "`docker volume prune -f`, never `-a`. Never a running container, never `system prune`. Refuses without docker. NOTE: "
                                            "`until=168h` is the image's age, not its last use: a locally built image with no registry copy is removed too if no "
                                            "container uses it.")
    prune.add_argument("--dry-run", action="store_true", help="Print the commands and the candidate anonymous volumes and run none of them")
    reap = disk_sub.add_parser("reap-docker", allow_abbrev=False, help="remove EXPIRED docker containers, networks and volumes that carry fleet.owner and fleet.expires labels",
                               description="Lists (the default) or, with --apply, removes docker containers (`rm -f`), networks and volumes that carry BOTH labels "
                                           "`fleet.owner=<agent>` and `fleet.expires=<epoch seconds>` and whose expiry has passed. Never an unlabelled object, a live "
                                           "one, or a volume a running container mounts; no `system prune`, no sudo. The daemon applies this daily unless the config "
                                           "key `docker_reaper` is false. Each removal is one `docker.reaped` audit line.")
    reap.add_argument("--apply", action="store_true", help="Remove them (the default only lists)")
    reap.add_argument("--docker", default=argparse.SUPPRESS, help="The docker executable (default: docker on PATH)")
    prune.add_argument("--docker", default=argparse.SUPPRESS, help="The docker executable (default: docker on PATH)")
    janitor = disk_sub.add_parser("janitor", allow_abbrev=False, help="remove old, unnamed entries of the opencode temp directory (a dry run unless --apply)",
                                  description="Lists (the default) or, with --apply, removes the top-level entries of the temp directory whose newest file is older than "
                                              "temp_janitor.days (default 7) and that no state file of the fleet names, no keep glob matches and no .fleet-keep marker "
                                              "protects. Never follows a link, never touches another user's entry. Each removal is one temp.removed audit line.")
    janitor.add_argument("--apply", action="store_true", help="Remove them (the default only lists)")
    janitor.add_argument("--i-reviewed", dest="i_reviewed", metavar="FINGERPRINT", default=None, help="With --apply: the preview fingerprint the dry run printed. Refused when it no longer matches the rule and the listed names")
    janitor.add_argument("--weekly", action="store_true", help="The weekly job: scan under the longer budget temp_janitor.weekly_scan_seconds (default 600 s) instead of scan_seconds (60 s)")
    ack = disk_sub.add_parser("janitor-ack", allow_abbrev=False, help="record the yes to the temp janitor's would-remove preview (the Chief of Staff's or the operator's)",
                              description="The daemon sends the Chief of Staff one would-remove preview after any change of the janitor's selection rule and applies nothing until "
                                          "the yes to that exact preview is recorded here. A changed rule makes a new preview and needs a new yes.")
    ack.add_argument("preview", help="the preview's fingerprint, as the message gives it")
    orphans = disk_sub.add_parser("reap-orphans", allow_abbrev=False, help="Signal (SIGTERM, then SIGKILL) orphaned test helpers past the grace: parent launchd, an exact allow-list; a dry run unless --apply")
    orphans.add_argument("--apply", action="store_true", help="Do it (default: a dry run)")
    reclaim = disk_sub.add_parser("reclaim-worktrees", allow_abbrev=False, help="Remove the registered worktrees of retired agents when clean and pushed; else keep and say why (a dry run unless --apply)")
    reclaim.add_argument("--apply", action="store_true", help="Do it (default: a dry run)")
    register = disk_sub.add_parser("register-worktree", allow_abbrev=False, help="Record a linked worktree for an agent (launch records its own)")
    register.add_argument("path", help="The worktree's directory")
    register.add_argument("--agent", required=True, help="The agent it belongs to")
    register.add_argument("--repo", help="OWNER/REPO (optional)")


# ---------------------------------------------------------------- `agents verify` (#179): did the service register OUR agents as written?
#
# OpenCode v2 silently registers an agent whose front matter does not parse as a default PRIMARY agent with a handful of rules of its own making.
# The service is asked (`opencode api GET /api/agent`, read-only) and each of our agents is compared with its definition: its mode, and EVERY rule its
# front matter declares (a `permissions:` list of {action, resource, effect}, or a `permission:` map, where `edit: allow` is action edit, resource `*`
# and `bash` is action `shell`) must be among the registered rules with the same effect. Not a count (the service adds default rules of its own, and
# the number of them changes between versions) and not an order (the last match wins, but a present rule is a loaded one). A default agent has none of
# ours, so a failed parse fails it. A service that is not running is said, not failed: nothing was installed wrongly.
EXPECTED_AGENTS = {
    "chief-of-staff": "primary",
    "cos-subagent": "primary",
    "orchestrator": "primary",
    "coder": "primary",
    "reviewer-code": "subagent",
    "reviewer-architecture": "subagent",
    "reviewer-security": "subagent",
    "reviewer-impact": "subagent",
    "reviewer-test": "subagent",
}
AGENTS_VERIFY_TIMEOUT = 20
AGENT_DEFINITION_DIRS = ("opencode", "reviewers")
_RULE_LINE = re.compile(r'^\s*-\s*\{action:\s*(.+?),\s*resource:\s*(".*"),\s*effect:\s*(allow|deny|ask)\}\s*$')
_MAP_LINE = re.compile(r'^  ([A-Za-z_][A-Za-z0-9_]*):\s*(allow|deny|ask)\s*(?:#.*)?$')


def agent_definition(name, root=None):
    """(rules, unread, path) of the kit's definition of agent `name`: its declared rules as a sorted list of (action, resource, effect), the
    lines of its permission block that the parser could not read (so they could not be checked), and the file used; None when the
    definition cannot be found (an install without the kit's agents directory)."""
    base = Path(root) if root is not None else Path(os.path.realpath(__file__)).parent.parent / "agents"
    for folder in AGENT_DEFINITION_DIRS:
        path = base / folder / (name + ".md")
        try:
            text = path.read_text()
        except OSError:
            continue
        front = text.split("\n---\n", 1)[0].splitlines()[1:]   # without the opening ---
        rules, unread, section = set(), 0, None
        for line in front:
            if line.startswith("permissions:"):
                section = "list"
            elif line.startswith("permission:"):
                section = "map"
            elif line and not line.startswith((" ", "#")):
                section = None
            elif section and line.strip() and not line.lstrip().startswith("#"):
                match = _RULE_LINE.match(line) if section == "list" else _MAP_LINE.match(line)
                if match is None:
                    unread += 1
                elif section == "list":
                    try:
                        action = json.loads(match.group(1)) if match.group(1).startswith('"') else match.group(1)
                        rules.add((action, json.loads(match.group(2)), match.group(3)))
                    except ValueError:   # a quoted string that is not valid JSON (a bad escape): not read, so not verified, and said
                        unread += 1
                else:
                    rules.add(("shell" if match.group(1) == "bash" else match.group(1), "*", match.group(2)))
        return sorted(rules), unread, str(path)
    return None


def agent_definition_rules(name, root=None):
    """The declared rules of the definition (see `agent_definition`), or None when it cannot be found."""
    found = agent_definition(name, root)
    return None if found is None else found[0]


def agents_found(runner, opencode, timeout):
    """(state, payload): ("down", why) when the service cannot be asked, else ("up", {name: (mode, {(action, resource, effect)})}) or ("bad", why)."""
    try:
        refuse_real_opencode_under_test(runner, opencode)
        done = runner([opencode, "api", "GET", "/api/agent"], capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL)
    except V2Error as err:
        return "down", str(err)
    except subprocess.TimeoutExpired:
        return "down", "%s did not answer within %ds" % (opencode, timeout)
    except OSError as err:
        return "down", "cannot run %s: %s" % (opencode, err.strerror or err)
    if done.returncode != 0:
        return "down", "%s api GET /api/agent exited %s: %s" % (opencode, done.returncode, _one_line(done.stderr or done.stdout))
    try:
        rows = json.loads(done.stdout)["data"]
        return "up", {row["id"]: (row["mode"], {(p.get("action"), p.get("resource"), p.get("effect")) for p in row["permissions"] if isinstance(p, dict)})
                      for row in rows}
    except (ValueError, KeyError, TypeError, AttributeError) as err:
        return "bad", "the service answered something that is not the agent list (%s)" % err


def agent_body(text):
    """The prose of an agent file: what follows its front matter (the model line, the permissions and the mode are in the front matter, so they are not compared)."""
    return text.split("\n---\n", 1)[1] if "\n---\n" in text else text


def default_installed_agents_dir():
    """Where `install` writes the agent files of the private profile. Under the test suite there is none unless a test names one: the suite never reads the machine's own profile."""
    if os.environ.get(UNDER_TEST_ENV):
        return None
    return _xdg("XDG_DATA_HOME", ".local/share") / PROG / "profile" / "config" / "opencode" / "agents"


def stale_installed_agents(installed_dir, expected=None, root=None):
    """[(name, path)] of the agents whose installed file has a body that is not the kit's (the model line is not compared). An agent with no installed file, or no kit file, is not listed; an installed file that is there but cannot be read is."""
    out = []
    if installed_dir is None:
        return out
    for name in sorted(expected or EXPECTED_AGENTS):
        found = agent_definition(name, root)
        if found is None:
            continue
        installed = Path(installed_dir) / (name + ".md")
        try:
            kit = agent_body(Path(found[2]).read_text())
            current = agent_body(installed.read_text())
        except FileNotFoundError:
            continue   # nothing installed under that name: nothing to compare
        except (OSError, ValueError):
            out.append((name, str(installed)))   # present but unreadable: said as out of date, never passed over
            continue
        if kit != current:
            out.append((name, str(installed)))
    return out


def agents_problems(found, expected=None, root=None, unchecked=None):
    """One line per agent of ours that is missing, in the wrong mode, short of a rule its definition declares, or whose definition has lines
    the check cannot read. `unchecked` (a list, when given) collects the agents whose rules were NOT compared (no definition found): only the mode was."""
    problems = []
    for name, mode in sorted((expected or EXPECTED_AGENTS).items()):
        if name not in found:
            problems.append("%s: not registered (install it, then restart the service)" % name)
            continue
        got_mode, registered = found[name]
        if got_mode != mode:
            problems.append("%s: registered as %s, expected %s (its front matter probably failed to parse: quote any description with a colon)" % (name, got_mode, mode))
            continue
        definition = agent_definition(name, root)
        if definition is None:
            if unchecked is not None:
                unchecked.append(name)   # no definition to compare with: the mode was checked, the rules were not
            continue
        declared, unread, path = definition
        if unread:
            problems.append("%s: %d lines of the permission block in %s are not in a form this check reads, so they were not verified" % (name, unread, path))
        missing = [rule for rule in declared if rule not in registered]
        if missing:
            problems.append("%s: %d of its %d rules (from %s) are not registered as written, for example %s %s %s (its permission block did not load as written)"
                            % (name, len(missing), len(declared), path, missing[0][0], missing[0][1], missing[0][2]))
    return problems


def charters_report(sb_engine, registry_module, now):
    """#969: per orchestrator, where its charter is recorded: the registry row's `charter`, and the live session metadata's `charter` and `issue` with the session's start time. Read-only.
    `metadata_names_other_charter` lists the numbers its session metadata (`charter` or `issue`) names that the registry gives to ANOTHER orchestrator: before #969 the lane lookup counted such an orchestrator as a second owner; now the metadata is ignored and this line is the defect report.
    Returns ([{"name", "session", "started", "repo", "registry_charter", "meta_charter", "meta_issue", "metadata_names_other_charter": [{"charter", "field", "owner"}]}], the registry's problem line or None)."""
    discovery = sb_engine.discover(now)
    reg = registry_module.read(sb_engine.state_dir)
    rows = []
    for name, obs in sorted(discovery.agents.items()):
        fleet = obs.fleet or {}
        if fleet.get("role") != "orchestrator":
            continue
        row = reg["agents"].get(name) if reg["whole"] else None
        rows.append({"name": name, "session": obs.session_id, "started": iso(obs.created) if obs.created else None, "repo": fleet.get("repo"),
                     "registry_charter": row.get("charter") if isinstance(row, dict) else None,
                     "meta_charter": fleet.get("charter"), "meta_issue": fleet.get("issue"), "metadata_names_other_charter": []})
    for row in rows:
        for field in ("charter", "issue"):
            value = row["meta_" + field]
            for other in rows:
                if other is not row and isinstance(value, int) and not isinstance(value, bool) and value == other["registry_charter"] and other["repo"] == row["repo"]:
                    row["metadata_names_other_charter"].append({"charter": value, "field": field, "owner": other["name"]})
    return rows, (None if reg["whole"] else reg["problem"] or "registry not read")


def cmd_agents_charters(args, runner, now):
    """`agents charters [--json]`: read-only. For every live orchestrator: its registry charter, and the live session metadata's `charter` and `issue` with the session's start time, so a charter number
    recorded for the wrong orchestrator is seen with the record that carries it (#969)."""
    engine, _, _ = build_engine(runner, now, "cli", writable=False)
    registry = load_module("registry")
    rows, problem = charters_report(engine, registry, now())
    reg = registry.read(engine.state_dir)
    duplicates = registry.duplicate_charters(reg["agents"]) if reg["whole"] else {}
    if args.json:
        print(json.dumps({"orchestrators": rows, "registry_problem": problem, "duplicates": [{"repo": r, "charter": n, "names": names} for (r, n), names in sorted(duplicates.items(), key=lambda kv: (str(kv[0][0]), kv[0][1]))]}, sort_keys=True))
        return EXIT_OK
    if problem:
        print("registry: %s" % problem)
    for r in rows:
        print("%s (session %s, started %s, repo %s): registry charter %s; session metadata charter %s, issue %s" % (
            r["name"], r["session"], r["started"] or "unknown", r["repo"], r["registry_charter"], r["meta_charter"], r["meta_issue"]))
        for claim in r["metadata_names_other_charter"]:
            print("  session metadata disagrees with the registry: its `%s` is %s, a charter the registry gives to %s (the lane lookup ignores the session metadata)" % (claim["field"], claim["charter"], claim["owner"]))
    for (crepo, number), names in sorted(duplicates.items(), key=lambda kv: (str(kv[0][0]), kv[0][1])):
        print("charter #%s of %s is recorded by %d orchestrators in the registry: %s" % (number, crepo, len(names), ", ".join(names)))
    return EXIT_OK


def cmd_agents(args, runner, now):
    """`agents verify`: read-only; exit 0 when every agent of ours is registered as written or the service is not running, 1 otherwise."""
    if args.agents_action == "charters":
        return cmd_agents_charters(args, runner, now)
    state, payload = agents_found(runner, args.opencode, args.timeout)
    if state == "down":
        print("agents: the OpenCode service is not running or not reachable, so nothing was checked (%s). Start it, then run this again." % payload)
        return EXIT_ERROR if args.strict else EXIT_OK
    if state == "bad":
        sys.stderr.write("%s: agents verify: %s\n" % (PROG, payload))
        return EXIT_ERROR
    unchecked = []
    problems = agents_problems(payload, unchecked=unchecked)
    installed_dir = Path(args.installed_dir) if args.installed_dir else default_installed_agents_dir()
    for name, path in stale_installed_agents(installed_dir):
        problems.append("%s: out of date (the installed copy %s has a different wording from the kit's); run `%s install`, then restart the service" % (name, path, PROG))
    if problems:
        for line in problems:
            print("FAIL  " + line)
        print("agents: %d problems among %d agents" % (len(problems), len(EXPECTED_AGENTS)))
        return EXIT_ERROR
    if unchecked:
        print("agents: PASS on mode only for %d of %d (%s): their definitions were not found beside this binary, so their rules were not compared"
              % (len(unchecked), len(EXPECTED_AGENTS), ", ".join(unchecked)))
        return EXIT_ERROR if args.strict else EXIT_OK
    print("agents: PASS (%d of %d registered with the expected mode and every rule their definitions declare; rules loaded, not proof they take effect: the last match wins)" % (len(EXPECTED_AGENTS), len(EXPECTED_AGENTS)))
    return EXIT_OK


def add_agents_parsers(sub):
    agents = sub.add_parser("agents", help="Check that the service registered the kit's agents as written (read-only)")
    agents_sub = agents.add_subparsers(dest="agents_action", required=True)
    verify = agents_sub.add_parser("verify", help="Ask the running OpenCode service for its agents and compare each of ours with its expected mode and the rules its definition declares",
                                   description="Reads `opencode api GET /api/agent` and fails (exit 1) when an agent of the kit is missing, has the wrong mode or "
                                               "lacks a rule its definition declares. A service that is not running is reported, not failed. Run it after installing the agents and "
                                               "restarting the service.")
    charters = agents_sub.add_parser("charters", help="Read-only: per live orchestrator, its registry charter and its live session metadata's charter and issue (where a charter number is recorded)")
    charters.add_argument("--json", action="store_true")
    verify.add_argument("--strict", action="store_true", help="Exit 1 when the service cannot be asked (default: say so and exit 0)")
    verify.add_argument("--installed-dir", default=None, help="The folder of installed agent files to compare bodies with (default: the private profile's agents folder)")
    verify.add_argument("--opencode", default="opencode", help="The opencode executable (default: opencode on PATH)")
    verify.add_argument("--timeout", type=int, default=AGENTS_VERIFY_TIMEOUT, help="Seconds to wait for the service (default %d)" % AGENTS_VERIFY_TIMEOUT)


# ---------------------------------------------------------------- `job`: a long run that survives being asked about, and says when it did not survive
#
# A restart of the service (or the pane) can silently kill a coder's background suite, and the coder keeps saying "running" for hours. `job start`
# runs a command detached in its own session and records it under the shared temp dir; the wrapper writes the exit code to a file when the command
# ends, so the three states are told apart by evidence: an exit file (finished, with its code), a live process that is the one that was started
# (alive), neither (dead: killed, no exit code). A dead job its starter has not looked at is reported, once, to the starter's boss (JobFacts).
JOB_NAME_RE = re.compile(r"^[a-z0-9][a-z0-9_-]{0,39}$")
JOB_DEAD = "job.dead"
JOBS_DIR_ENV = "FLEET_JOBS_DIR"
# The wrapper runs the command in the background and waits, so that a signal it can catch (TERM, HUP, INT) is handled at once: it writes the reason ("signal N") and the
# exit code 128+N, passes the stop on to the command (INT as TERM: a background command ignores INT) and, only once the command is gone, ends (a command that outlives the stop keeps the job alive: the record is never false). A signal that cannot be caught leaves neither file: the daemon says "unknown".
JOB_WRAPPER = ('exit_path=$1; shift; '
               'finish() { printf "%s\\n" "$1" > "$exit_path.tmp" && mv "$exit_path.tmp" "$exit_path"; }; '
               'caught() { printf "signal %s\\n" "$1" > "$exit_path.reason"; kill -"${2:-$1}" "$child" 2>/dev/null; wait "$child"; finish "$((128 + $1))"; exit "$((128 + $1))"; }; '
               'trap "caught 15" TERM; trap "caught 1" HUP; trap "caught 2 15" INT; '
               'missing() { printf "fleet-job: %s: %s\\n" "$1" "$2" >&2; finish "$3"; exit "$3"; }; '
               'case "$1" in */*) [ -e "$1" ] || missing "$1" "No such file or directory" 127; { [ -x "$1" ] && [ ! -d "$1" ]; } || missing "$1" "Permission denied" 126;; '
               '*) command -v "$1" >/dev/null 2>&1 || missing "$1" "command not found" 127;; esac; '
               'exec 3>&2 2>/dev/null; "$@" 2>&3 3>&- & child=$!; wait "$child"; code=$?; finish "$code"; exit "$code"')
JOB_ENDED_MARK = "ended-recorded"   # in the job's directory: the one audit line of how it ended is written once
JOB_LAST_SEEN_MAX = 160
JOB_TAIL_BYTES = 4096


JOB_SCAN_MAX = 200   # the most job directories one daemon pass looks at


def jobs_dir():
    return Path(os.environ.get(JOBS_DIR_ENV) or os.path.join(tempfile.gettempdir(), "fleet-jobs"))


def job_private(path):
    """True when `path` is a directory owned by this user that nobody else can enter or write: a shared temp dir is where another user could
    plant a record, so a jobs dir that is not private is neither written nor believed."""
    try:
        info = os.lstat(str(path))
    except OSError:
        return False
    return stat.S_ISDIR(info.st_mode) and info.st_uid == os.getuid() and not info.st_mode & 0o077


def job_ensure_root(root):
    """Create the jobs dir private (0700). Raises OSError when it exists and is not private."""
    root = Path(root)
    try:
        os.makedirs(str(root), mode=0o700, exist_ok=True)
    except OSError:
        pass
    if not job_private(root):
        raise OSError(errno.EPERM, "%s is not a private directory (owned by you, mode 0700)" % root)


def job_write_atomic(path, text):
    """The file whole or not at all (a reader never sees half of it): a temp file beside it, renamed into place."""
    temp = Path("%s.%d.tmp" % (path, os.getpid()))
    fd = os.open(str(temp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    try:
        with os.fdopen(fd, "w") as handle:
            handle.write(text)
        os.replace(str(temp), str(path))
    except BaseException:
        try:
            temp.unlink()
        except OSError:
            pass
        raise


def job_paths(name, root=None):
    base = Path(root or jobs_dir()) / name
    return {"dir": base, "record": base / "job.json", "log": base / "out.log", "exit": base / "exit", "collected": base / "collected", "reason": base / "exit.reason", "marker": base / JOB_ENDED_MARK}


def job_process_token(pid):
    """What identifies THIS process among later ones with the same pid: its start time as ps prints it, or None when it cannot be read."""
    try:
        done = subprocess.run(["ps", "-o", "lstart=", "-p", str(int(pid))], capture_output=True, text=True, timeout=5, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError, ValueError):
        return None
    text = (done.stdout or "").strip()
    return text if done.returncode == 0 and text else None


def job_read(name, root=None):
    paths = job_paths(name, root)
    try:
        if os.lstat(str(paths["record"])).st_uid != os.getuid():
            return None   # a record someone else wrote is not believed
        record = json.loads(paths["record"].read_text())
    except (OSError, ValueError):
        return None
    return record if isinstance(record, dict) and record.get("name") == name else None


def job_state(record, root=None):
    """("finished", exit code) | ("alive", None) | ("dead", None) | ("unknown", None): by evidence, never by a guess."""
    paths = job_paths(record["name"], root)
    try:
        code = int(paths["exit"].read_text().strip())
        return "finished", code
    except (OSError, ValueError):
        pass
    pid = record.get("pid")
    if not isinstance(pid, int) or pid < 2:
        return "unknown", None
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return "dead", None
    except PermissionError:
        return "alive", None   # it exists, owned by someone else: not ours to call dead
    token = record.get("token")
    now_token = job_process_token(pid)
    if token and now_token and now_token != token:
        return "dead", None    # the pid was reused by another process: ours is gone
    return "alive", None


def boot_time():
    """When the machine last started, in epoch seconds, or None when it cannot be read (Linux /proc/stat, else the BSD/macOS `sysctl kern.boottime`)."""
    try:
        for line in Path("/proc/stat").read_text().splitlines():
            if line.startswith("btime "):
                return float(line.split()[1])
    except (OSError, ValueError, IndexError):
        pass
    try:
        done = subprocess.run(["sysctl", "-n", "kern.boottime"], capture_output=True, text=True, timeout=5, stdin=subprocess.DEVNULL)
        found = re.search(r"sec\s*=\s*([0-9]+)", done.stdout or "")
        return float(found.group(1)) if done.returncode == 0 and found else None
    except (OSError, subprocess.SubprocessError, ValueError):
        return None


def job_last_seen(record, root, now):
    """(the last non-empty line the job printed, how many seconds ago) with control characters turned into spaces and the line bounded; ("", None) when it printed nothing
    or the log cannot be read. A log line is untrusted text."""
    path = job_paths(record["name"], root)["log"]
    try:
        with open(str(path), "rb") as handle:
            size = os.fstat(handle.fileno()).st_size
            handle.seek(max(0, size - JOB_TAIL_BYTES))
            tail = handle.read(JOB_TAIL_BYTES).decode("utf-8", "replace")
            age = max(0, int(now - os.fstat(handle.fileno()).st_mtime))
    except OSError:
        return "", None
    lines = [line for line in re.split(r"[\r\n]+", tail) if line.strip()]
    return (_plain(lines[-1], JOB_LAST_SEEN_MAX).strip() if lines else ""), (age if lines else None)


def job_end_reason(record, root, now, boot=None):
    """How a job that ended without finishing normally ended, as the audit line tells it, or None when it is alive, unknown or finished without a signal. The reason is
    what can be told: "signal N" (the wrapper caught it and wrote it), "host rebooted" (the machine started after the job did), else "unknown" (an uncatchable signal;
    its sender cannot be known). Never the command's arguments or environment."""
    state, code = job_state(record, root)
    paths = job_paths(record["name"], root)
    started = float(record.get("started") or 0)
    if state == "finished":
        try:
            said = _plain(paths["reason"].read_text().strip(), 40)
        except OSError:
            return None
        if not re.fullmatch(r"signal [0-9]{1,3}", said):
            return None
        reason = said
    elif state == "dead":
        booted = (boot or boot_time)()
        reason = "host rebooted" if booted is not None and started and booted > started else "unknown"
    else:
        return None
    seen, age = job_last_seen(record, root, now)
    detail = {"reason": reason, "age_seconds": max(0, int(now - started)), "last_seen": seen, "last_seen_age_seconds": age, "source": "job"}
    if code is not None:
        detail["exit_code"] = code
    return detail


def job_record_end(record, root, now, audit, boot=None):
    """The ONE audit line `job.dead` of a job that ended without finishing normally, with its reason and last-seen line; a marker file in the job's directory makes it once
    whoever looks first (the daemon or `job status`). True when this call wrote it. A sink that fails never raises."""
    paths = job_paths(record["name"], root)
    detail = job_end_reason(record, root, now, boot)
    if detail is None:
        return False
    try:
        fd = os.open(str(paths["marker"]), os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        os.close(fd)
    except OSError:
        return False   # another look wrote it, or the directory is not writable
    try:
        audit(JOB_DEAD, record["name"], detail)
    except Exception as err:
        try:
            paths["marker"].unlink()   # nothing was written: the next look tries again
        except OSError:
            pass
        sys.stderr.write("%s: job: could not write the audit line %s (%s)\n" % (PROG, JOB_DEAD, _plain("%s: %s" % (type(err).__name__, err), 120)))
    return True


def job_age(seconds):
    seconds = max(0, int(seconds))
    return "%ds" % seconds if seconds < 120 else "%dm" % (seconds // 60) if seconds < 7200 else "%dh" % (seconds // 3600)


def job_line(record, state, code, now, root=None):
    paths = job_paths(record["name"], root)
    age = job_age(now - float(record.get("started") or now))
    if state == "alive":
        return "alive: %s pid %s, running %s; log %s" % (record["name"], record.get("pid"), age, paths["log"])
    if state == "finished":
        return "finished: %s exit code %d after it started %s ago; result %s" % (record["name"], code, age, paths["log"])
    if state == "dead":
        return "dead: %s was killed (no exit code); it started %s ago; what it printed is in %s" % (record["name"], age, paths["log"])
    return "unknown: %s has no process id on record" % record["name"]


def cmd_job(args, runner, now, spawn=subprocess.Popen):
    """`job start <name> -- <command...>` and `job status <name>`. Start is detached and prints one line; status is one line."""
    if not JOB_NAME_RE.match(args.name or ""):
        sys.stderr.write("%s: job: name must match %s, got %r\n" % (PROG, JOB_NAME_RE.pattern, args.name))
        return EXIT_USAGE
    root = jobs_dir()
    if args.job_action == "status":
        record = job_read(args.name, root)
        if record is None:
            sys.stderr.write("%s: job: no job named %s under %s\n" % (PROG, args.name, root))
            return EXIT_ERROR
        state, code = job_state(record, root)
        print(job_line(record, state, code, now(), root))
        try:
            job_record_end(record, root, now(), lambda event, subject, detail: AuditLog(ensure_state_dir() / "audit.jsonl").append("job", event, subject, detail))
        except Exception:
            pass   # `job status` never fails for the audit line's sake
        if state != "alive":   # whoever asked has now seen how it ended: it is collected, and nobody else is told
            try:
                job_write_atomic(job_paths(args.name, root)["collected"], str(int(now())))
            except OSError:
                pass
        return EXIT_OK if state == "alive" or (state == "finished" and code == 0) else EXIT_ERROR
    command = [part for part in (args.command or []) if part != "--"] if args.command and args.command[0] == "--" else list(args.command or [])
    if not command:
        sys.stderr.write("%s: job start: give the command after --, e.g. `job start suite -- bin/test-switchboard`\n" % PROG)
        return EXIT_USAGE
    try:
        job_ensure_root(root)
    except OSError as err:
        sys.stderr.write("%s: job: %s\n" % (PROG, err.strerror or err))
        return EXIT_ERROR
    paths = job_paths(args.name, root)
    lock = os.open(str(root / (args.name + ".lock")), os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX)   # the check and the start are one step: two starts of one name cannot both pass
        earlier = job_read(args.name, root)
        if earlier is not None and job_state(earlier, root)[0] == "alive":
            sys.stderr.write("%s: job: %s is still running (pid %s): `job status %s`; pick another name or wait\n" % (PROG, args.name, earlier.get("pid"), args.name))
            return EXIT_ERROR
        paths["dir"].mkdir(parents=True, exist_ok=True)
        os.chmod(str(paths["dir"]), 0o700)
        for stale in (paths["record"], paths["exit"], paths["collected"], paths["reason"], paths["marker"], Path(str(paths["exit"]) + ".tmp")):   # the old record goes FIRST: no window shows it uncollected
            try:
                stale.unlink()
            except OSError:
                pass
        log = os.open(str(paths["log"]), os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
        try:
            process = spawn(["/bin/sh", "-c", JOB_WRAPPER, "fleet-job", str(paths["exit"])] + command, stdin=subprocess.DEVNULL, stdout=log,
                            stderr=subprocess.STDOUT, start_new_session=True, close_fds=True, cwd=os.getcwd())
        except OSError as err:
            sys.stderr.write("%s: job: cannot start %s: %s\n" % (PROG, command[0], err.strerror or err))
            return EXIT_ERROR
        finally:
            os.close(log)
        session, starter = job_starter(runner, now)
        record = {"name": args.name, "argv": command, "pid": process.pid, "started": now(), "token": job_process_token(process.pid),
                  "cwd": os.getcwd(), "session": session, "starter": starter}
        job_write_atomic(paths["record"], json.dumps(record, indent=1, sort_keys=True) + "\n")
    finally:
        os.close(lock)
    print("started: %s pid %d; `%s job status %s` says how it is; log %s" % (args.name, process.pid, PROG, args.name, paths["log"]))
    return EXIT_OK


def job_starter(runner, now):
    """(session, fleet name) of the agent that starts a job, established the way every command does it (its OWN session, known to v2 as a
    fleet agent), or (None, None): a job nobody can vouch for is never reported to anyone's boss."""
    try:
        engine, _, _ = build_engine(runner, now, "cli", writable=False)
        fleet = session_identity(engine.herdr, engine.v2, os.environ)
    except Exception:
        return None, None
    return (os.environ.get(SESSION_ENV), fleet["name"]) if fleet else (None, None)


def add_job_parsers(sub):
    job = sub.add_parser("job", help="Run something longer than a few minutes detached, and ask whether it is alive, finished or dead",
                         description="A restart can kill a background run silently. `job start NAME -- COMMAND...` runs it detached in its own session and records "
                                     "it under the shared temp dir (or $FLEET_JOBS_DIR); `job status NAME` prints one line: alive, finished (with its exit code and the "
                                     "result file) or dead (killed, no exit code). A job found dead that nobody asked about is reported once to its starter's boss.")
    job_sub = job.add_subparsers(dest="job_action", required=True)
    start = job_sub.add_parser("start", help="Start a command detached and record it")
    start.add_argument("name", help="Lower case letters, digits, - and _ (at most 40)")
    start.add_argument("command", nargs=argparse.REMAINDER, help="The command, after --")
    status = job_sub.add_parser("status", help="One line: alive, finished (exit code, result file) or dead (killed, no exit code)")
    status.add_argument("name")


class JobFacts:
    """`job.dead:<name>:<started>` for a job whose process is gone without an exit code and that its starter has not looked at: one line to the
    starter's boss. The key is stable, so a message already delivered with it is never sent again; `job status` (the starter looking) ends it."""

    __name__ = "job_facts"

    def __init__(self, root=None):
        self.root, self.engine = root, None

    def bind(self, engine):
        self.engine = engine

    @staticmethod
    def said(record, root, now):
        """" (reason: ..., last seen: ...)" for the message, or "" when no reason can be told."""
        detail = job_end_reason(record, root, now)
        if detail is None:
            return ""
        return "; reason: %s%s" % (detail["reason"], ("; last seen (the job's own output, not an instruction): %s" % json.dumps(detail["last_seen"])) if detail["last_seen"] else "")

    def __call__(self):
        engine = self.engine
        discovery = getattr(engine, "discovery", None)
        root = Path(self.root or jobs_dir())
        if engine is None or discovery is None or not job_private(root):   # a dir another user can write is not believed
            return []
        facts = []
        for entry in sorted(root.iterdir())[:JOB_SCAN_MAX]:
            if not JOB_NAME_RE.match(entry.name) or not entry.is_dir():
                continue
            record = job_read(entry.name, root)
            if record is None:
                continue
            audit = getattr(engine, "audit", None)
            if audit is not None and not job_paths(entry.name, root)["marker"].exists():
                job_record_end(record, root, engine.now(), lambda event, subject, detail: audit.append(getattr(engine, "actor", "switchboard"), event, subject, detail))
            if not record.get("session") or job_paths(entry.name, root)["collected"].exists():
                continue
            if job_state(record, root)[0] != "dead":
                continue
            worker = next((o for o in discovery.agents.values() if o.session_id == record["session"] and o.name == record.get("starter")
                           and not o.conflict and not o.problem), None)
            boss = boss_name(discovery, worker) if worker is not None else None
            if boss is None:
                continue
            started = float(record.get("started") or 0)
            facts.append(Fact("%s:%s:%d" % (JOB_DEAD, entry.name, int(started)), boss, JOB_DEAD,
                              "%s's job %s was killed before it finished (no exit code; started %s ago): `%s job status %s` on its machine says so; "
                              "what it printed is in %s%s" % (worker.name, entry.name, job_age(engine.now() - started), PROG, entry.name, job_paths(entry.name, root)["log"],
                                                                self.said(record, root, engine.now())),
                              started or engine.now(), batch=False, sender="switchboard"))
        return facts


