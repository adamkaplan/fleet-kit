                        help="With `withdrawn`: withdraw every open question or blocked report of yours, on any ask")
    report.add_argument("--from", dest="sender", help="Lab only: the sender's fleet name")
    notice = sub.add_parser(
        "notice", help="Tell the person about a pull request you opened or mean to merge (shown in their panel; "
                       "wakes nobody, sends no message)",
        description="`notice pr` records a heads-up about a PR for the person's Decisions panel: information, not a "
                    "decision. It sends no message and wakes nobody. Send it as soon as you OPEN the PR, so it is seen while CI and "
                    "review run. It stays until the PR is merged or closed; sending it again refreshes the note. A number that is "
                    "not an OPEN pull request is refused when you send it (an unreadable lookup never blocks). `notice withdraw <pr>` removes a "
                    "notice (the agent that sent it, or its boss); a notice whose PR cannot be read for an hour is dropped.")
    notice.add_argument("kind", choices=("pr", "withdraw", "ack"), help="`pr` records a notice; `withdraw` removes the one for a PR (its sender or its boss); `ack` (you, in a plain shell) drops an order heads-up by its id")
    notice.add_argument("pr", help="The pull request: owner/repo#N or its URL (an issue, a number that is not an open PR, is refused)")
    notice.add_argument("note", nargs="*", help="Optional: one line of why, or what you intend (at most %d characters)" % REPORT_MAX)
    notice.add_argument("--from", dest="sender", help="Lab only: the sender's fleet name")
    sub.add_parser("ensure", help="Start the daemon unless it runs (herdr's startup hook calls this)")
    sub.add_parser("poke", help="Ask the daemon for a pass now; silent, never blocks (herdr's event hooks call this)")
    launch = sub.add_parser("launch", help="Start a fleet agent (headless by default, or in a new herdr tab with --terminal), without typing", description="Start a fleet agent (headless by default, or in a new herdr tab with --terminal), without typing. A NEW launch (not a resume or --cloud) first runs the memory test: this is the lanes' safety check, not the owner's rule (there are no caps on coders), and `--memory-ok <reason>` overrides it. A refusal exits 5.")
