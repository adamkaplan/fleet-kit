    t0 = time.monotonic()
    self.refused(504, "could not be read in time", CODER, "prove", **PROVE)
    self.assertLess(time.monotonic() - t0, 1.5)
    self.assertEqual(self.raw(), b"")
""",
        "test_trickling_headers_are_cut_at_the_total_deadline": """
def test_trickling_headers_are_cut_at_the_total_deadline(self):
    took, err = self.timed_fetch(relay)
    self.assertIsInstance(err, TimeoutError)
    self.assertLess(took, 2.0)
""",
        "test_mutant_without_the_watchdog_is_caught": """
def test_mutant_without_the_watchdog_is_caught(self):
    mod = load_backend_module("threading.Timer(READ_DEADLINE, cut)", "threading.Timer(1000, cut)", extra=(("worker.join(READ_DEADLINE)", "worker.join()"),))
    took, _ = self.timed_fetch(mod)
    self.assertGreater(took, 2.0)
""",
        "test_slow_dns_is_cut_at_the_deadline": """
def test_slow_dns_is_cut_at_the_deadline(self):
    took, err = self.timed(relay, self.slow_dns(), 1.0)
    self.assertIsInstance(err, relay.PassCut)
    self.assertLess(took, 2.0)
""",
        "test_mutant_without_the_thread_cut_is_caught_by_dns": """
def test_mutant_without_the_thread_cut_is_caught_by_dns(self):
    mod = load_backend_module("worker.join(READ_DEADLINE)", "worker.join()")
    took, _ = self.timed(mod, self.slow_dns(), 1.0)
    self.assertGreater(took, 5.0)
""",
        "test_four_dead_addresses_share_one_deadline": """
def test_four_dead_addresses_share_one_deadline(self):
    took, err = self.timed(relay, self.full_backlog(), 2.0)
    self.assertIsInstance(err, TimeoutError)
    self.assertLess(took, 3.5)
""",
        "test_mutant_without_the_thread_cut_is_caught_by_addresses": """
def test_mutant_without_the_thread_cut_is_caught_by_addresses(self):
    mod = load_backend_module("worker.join(READ_DEADLINE)", "worker.join()")
    took, _ = self.timed(mod, self.full_backlog(), 2.0)
    self.assertGreater(took, 5.0)
""",
    }
    NEW_UNLISTED = """
def test_a_new_comparison_of_a_measured_duration_without_a_reason(self):
    t0 = time.monotonic()
    self.work()
    took = time.monotonic() - t0
    self.assertLess(took, 3.0)
"""
    # KEPT with a reason (three places): a function of the file or an OLD text above. Any other flagged comparison fails the scan.
    KEPT = {
        "_late_post_scenario": "the poll that waits at most 5 seconds for the threads of a pass to end: a generous hang guard (the slowest honest case is "
                               "about 0.1 s, the guard 50 times that) that exits at the first observation; a broken mechanism fails instead of hanging, "
                               "and the poll is never what the test judges",
        "OLD[test_a_trickling_hub_is_cut_at_the_total_deadline]": "the literal OLD text of a test converted by #1417: the input of that scan's mutant "
                                                                  "check, never run as a test",
        "OLD[test_mutant_without_the_total_deadline_is_caught]": "the literal OLD text of a test converted by #1417: the input of that scan's mutant "
                                                                 "check, never run as a test",
    }

    @classmethod
    def clock_call(cls, x):
        import ast
        return isinstance(x, ast.Call) and isinstance(x.func, ast.Attribute) and x.func.attr in cls.CLOCKS and \
            isinstance(x.func.value, ast.Name) and x.func.value.id == "time"

    @classmethod
    def helpers_returning_a_difference(cls, tree):
        """The functions of the file whose body returns a clock difference (timed_fetch, timed): their value is a measured duration."""
        import ast
        found = set()
        for fn in ast.walk(tree):
            if isinstance(fn, ast.FunctionDef):
                for ret in ast.walk(fn):
                    if isinstance(ret, ast.Return) and ret.value is not None and any(
                            isinstance(b, ast.BinOp) and isinstance(b.op, ast.Sub) and any(cls.clock_call(c) for c in ast.walk(b)) for b in ast.walk(ret.value)):
                        found.add(fn.name)
        return found

    @classmethod
    def measured_comparison_lines(cls, fn, helpers, follow_derived=True):
        """The line numbers, inside the function node fn, of a comparison of a measured duration with a number under 10 seconds. A value is
        measured when it is a clock call, a name assigned from an expression holding a measured value, or the value of a helper that returns a
        clock difference. follow_derived=False is the scan variant that skips everything derived from a clock difference (differences, the
        names assigned from them, the helpers' values) and the tests of loops: it must flag nothing in the old forms (not vacuous)."""
        import ast

        def is_difference(x, names):
            return isinstance(x, ast.BinOp) and isinstance(x.op, ast.Sub) and any(cls.clock_call(c) or (isinstance(c, ast.Name) and c.id in names) for c in ast.walk(x))

        def is_helper_call(x):
            return isinstance(x, ast.Call) and ((isinstance(x.func, ast.Attribute) and x.func.attr in helpers) or (isinstance(x.func, ast.Name) and x.func.id in helpers))

        def measured(x, names):
            if not follow_derived and (is_difference(x, names) or is_helper_call(x)):
                return False
            if cls.clock_call(x) or (isinstance(x, ast.Name) and x.id in names) or (follow_derived and is_helper_call(x)):
                return True
            return any(measured(c, names) for c in ast.iter_child_nodes(x))

        def has_small(x):
            return any(isinstance(c, ast.Constant) and isinstance(c.value, (int, float)) and not isinstance(c.value, bool) and c.value < 10 for c in ast.walk(x))
        names, bounds = set(), set()   # measured names; names holding a clock plus a small number (a deadline of a loop)
        pairs = []   # (targets, value): a tuple assigned from a tuple of the same length is taken element by element
        for node in ast.walk(fn):
            if isinstance(node, ast.Assign):
                if isinstance(node.targets[0], ast.Tuple) and isinstance(node.value, ast.Tuple) and len(node.targets[0].elts) == len(node.value.elts):
                    pairs.extend(([t], v) for t, v in zip(node.targets[0].elts, node.value.elts))
                else:
                    pairs.append((node.targets, node.value))
        for _ in range(6):   # fixpoint over the assignments of the function
            for targets, value in pairs:
                if measured(value, names):
                    if is_helper_call(value) and isinstance(targets[0], ast.Tuple):
                        targets = [targets[0].elts[0]]   # the first value of a helper's pair is the measured time
                    for tgt in targets:
                        for n in ast.walk(tgt):
                            if isinstance(n, ast.Name):
                                names.add(n.id)
                                if has_small(value):
                                    bounds.add(n.id)
        skipped = set()
        if not follow_derived:
            for node in ast.walk(fn):
                if isinstance(node, ast.While):
                    skipped.update(id(c) for c in ast.walk(node.test))
        lines = []
        for node in ast.walk(fn):
            if id(node) in skipped:
                continue
            if isinstance(node, ast.Compare):
                parts = [node.left] + list(node.comparators)
            elif isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute) and node.func.attr in (
                    "assertLess", "assertGreater", "assertLessEqual", "assertGreaterEqual"):
                parts = list(node.args[:2])
            else:
                continue
            if any(i != j and measured(a, names) and (has_small(b) or any(isinstance(c, ast.Name) and c.id in bounds for c in ast.walk(b)))
                   for i, a in enumerate(parts) for j, b in enumerate(parts)):
                lines.append(node.lineno)
        return lines

    @classmethod
    def flagged_in_text(cls, src, helpers, follow_derived=True):
        import ast
        import textwrap
        return cls.measured_comparison_lines(ast.parse(textwrap.dedent(src)), helpers, follow_derived)

    @classmethod
    def flagged_in_file(cls, text, follow_derived=True):
        """{outermost function name: [lines]} for every function of the file (a test, a helper of a test)."""
        import ast
        tree = ast.parse(text)
        helpers = cls.helpers_returning_a_difference(tree)
        found = {}
        for outer in ast.walk(tree):
            if isinstance(outer, (ast.ClassDef, ast.Module)):
                for fn in outer.body:
                    if isinstance(fn, ast.FunctionDef):
                        lines = cls.measured_comparison_lines(fn, helpers, follow_derived)
                        if lines:
                            found[fn.name] = lines
        return found

    def unlisted(self, found):
        return {k: v for k, v in found.items() if k not in self.KEPT}

    def test_no_function_of_the_file_compares_a_measured_duration_with_a_small_bound_except_the_kept(self):
        found = self.flagged_in_file(self.own_text())
        self.assertEqual(self.unlisted(found), {}, "a comparison of a measured duration under 10 seconds (test name: lines)")

    def test_the_kept_places_are_flagged_and_each_has_a_reason(self):
        self.assertEqual(len(self.KEPT), 3)
        for key, reason in self.KEPT.items():
            self.assertGreater(len(reason), 40, key)
        found = self.flagged_in_file(self.own_text())
        self.assertIn("_late_post_scenario", found)   # the kept poll is really found: the entry is not stale
        helpers = self.helpers_returning_a_difference(__import__("ast").parse(self.own_text()))
        for name in self.NAMES:
            self.assertTrue(self.flagged_in_text(self.OLD[name], helpers), name)
            self.assertIn("OLD[%s]" % name, self.KEPT)

    def test_the_helpers_that_return_a_measured_time_are_followed(self):
        helpers = self.helpers_returning_a_difference(__import__("ast").parse(self.own_text()))
        self.assertLessEqual({"timed_fetch", "timed"}, helpers)

    def test_the_scan_flags_the_old_forms_and_a_new_unlisted_comparison_and_is_not_vacuous(self):
        import ast
        helpers = self.helpers_returning_a_difference(ast.parse(self.own_text()))
        old = sum(1 for src in self.OLD_1521.values() if self.flagged_in_text(src, helpers))
        new = sum(1 for src in (self.NEW_UNLISTED,) if self.flagged_in_text(src, helpers))
        variant = sum(1 for src in self.OLD_1521.values() if self.flagged_in_text(src, helpers, follow_derived=False))
        print("S8: old forms flagged %d of %d, new unlisted flagged %d of 1, kept %d" % (old, len(self.OLD_1521), new, len(self.KEPT)))
        self.assertEqual((len(self.OLD_1521), old, new), (8, 8, 1))
        self.assertEqual(variant, 0)   # the variant that skips names derived from a clock difference sees none of the 8: the full scan is not vacuous
        self.assertEqual(self.unlisted({"test_a_new_comparison_of_a_measured_duration_without_a_reason": [1]}),
                         {"test_a_new_comparison_of_a_measured_duration_without_a_reason": [1]})

    def test_a_bound_of_ten_seconds_or_more_on_a_measured_duration_is_not_flagged_by_the_file_scan(self):
        import ast
        helpers = self.helpers_returning_a_difference(ast.parse(self.own_text()))
        self.assertEqual(self.flagged_in_text(self.NEW_UNLISTED.replace("3.0", "10.0"), helpers), [])


if __name__ == "__main__":
    result = unittest.main(exit=False).result
    print("RESULT: PASS" if result.wasSuccessful() else "RESULT: FAIL")
    sys.exit(0 if result.wasSuccessful() else 1)
