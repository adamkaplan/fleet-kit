    def test_t12_the_reference_rules(self):
        refs = sb.load_triage_plan_open().references
        self.assertEqual(refs("Closes #5. fixes #6, Resolved #7 and Part of #8", "acme/api"), {5, 6, 7, 8})
        self.assertEqual(refs("PLAN: acme/api#9", "acme/api"), {9})
        self.assertEqual(refs("PLAN: <https://github.com/ACME/api/issues/10>", "acme/api"), {10})
        self.assertEqual(refs("Closes acme/web#11 and see #12 and PLAN: https://github.com/acme/web/issues/13", "acme/api"), set())
        self.assertEqual(refs(None, "acme/api"), set())
        links = sb.load_triage_plan_open().merged_links([{"number": 1, "body": "Part of #5", "merged_at": "2026-01-01T00:00:00Z"},
                                                          {"number": 2, "body": "Part of #5", "merged_at": "2026-02-01T00:00:00Z"},
                                                          {"number": 3, "body": "Part of #5", "merged_at": None}, "junk"], "acme/api")
        self.assertEqual(links[5]["pr"], 2)          # the latest merge wins; an unmerged one is ignored

