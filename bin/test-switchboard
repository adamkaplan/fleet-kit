    def test_reattach_by_a_dead_panes_remembered_record_and_it_refuses_when_the_session_is_gone(self):
        os.environ["HERDR_WORKSPACE_ID"] = "w1"
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.health()                                                      # the agent is remembered while it is alive
        session = self.gone()
        for n in range(sb.PANE_MISSING_PASSES):
            self.health(n)
        self.assertTrue([e for e in self.world.audit() if e["event"] == "fleetpane.dead"])
        with captured() as (out, err):
            code = sb.main(["reattach", "platform"], runner=self.world.route, now=self.world.clock.now, socket_call=self.world.herdr.socket)
        self.assertEqual(code, 0, err.getvalue())
        self.assertEqual(json.loads(out.getvalue())["session"], session)
        del self.world.herdr.panes[json.loads(out.getvalue())["pane"]]
        del self.world.v2.sessions[session]                               # the session itself is gone
        with captured() as (out, err):
            code = sb.main(["reattach", "platform", "--session", session], runner=self.world.route, now=self.world.clock.now,
                           socket_call=self.world.herdr.socket)
        self.assertNotEqual(code, 0)
        self.assertIn("no longer exists", err.getvalue())
        self.assertIn("relaunch", err.getvalue())

