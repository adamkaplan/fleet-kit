class TestDecorationIsAFact(ActingCase):
    def test_a_restart_classifies_once_more_and_the_transcript_stops_a_second_delivery(self):
        self.work()
        self.say("Also, the billing export?")
        self.passes(3)
        self.assertEqual(len(self.decorations()), 1)
        self.restart()
        self.passes(3)
        self.assertEqual(len(self.jev.calls), 1, "the new process classified the newest message once")
        self.assertEqual(len(self.decorations()), 1, "the key is in the transcript: never delivered again")
        self.assertEqual(len(self.world.v2.writes), 1)

    def test_the_same_state_gives_the_same_key_after_a_restart(self):
        self.work()
        self.say("Also, the billing export?")
        self.passes(1)
        first = [f.key for f in self.world.engine.collect_facts()[0]]
        self.restart()
        self.world.engine.discover(self.world.clock.now())
        self.world.engine.run_pass()
        second = [f.key for f in self.world.engine.collect_facts()[0]]
        self.assertEqual(first, second)
        self.assertEqual(len(first), 1)

    def test_the_crash_after_send_fault_does_not_double_deliver(self):
        self.work()
        self.say("Also, the billing export?")
        os.environ[sb.FAULT_ENV] = "crash-after-send"
        with self.assertRaises(sb.SimulatedCrash):
            self.world.engine.run_pass()
        os.environ[sb.FAULT_ENV] = ""
        self.restart()
        self.passes(3)
        self.assertEqual(len(self.decorations()), 1)

    def test_a_newer_message_replaces_a_decoration_nobody_has_received(self):
        self.work()
        self.say("Also, the billing export?")
        engine = self.world.engine
        engine.run_pass()
        source = sb.foreground_source(engine)
        first = [f.key for f in source()]
        self.world.tick(5)
        self.answer = "current"
        self.say("Never mind, how is it going?")
        self.assertEqual(source(), [], "the first message is no longer your newest")
        self.assertEqual(len(first), 1)

    def test_a_handoff_decoration_lapses_when_the_chief_of_staff_has_stopped_working(self):
        self.work(lasts=20, steps=2)
        self.say("Also, the billing export?")
        engine = self.world.engine
        engine.run_pass()
        self.assertEqual(len(sb.foreground_source(engine)()), 1)
        self.world.tick(30)
        engine.discover(self.world.clock.now())
        self.assertEqual(sb.foreground_source(engine)(), [], "idle: nothing is left to hand off")

    def test_a_decoration_lapses_with_the_engagement_window(self):
        self.work(lasts=2000, steps=2)
        self.say("Also, the billing export?")
        engine = self.world.engine
        engine.run_pass()
        self.assertEqual(len(sb.foreground_source(engine)()), 1)
        self.world.tick(11 * 60)
        engine.discover(self.world.clock.now())
        self.assertEqual(sb.foreground_source(engine)(), [])
        self.assertEqual(sb.foreground_source(engine).decisions, {})

    def test_it_is_a_batch_free_fact_for_the_chief_of_staff(self):
        self.work()
        self.say("Also, the billing export?")
        self.world.engine.run_pass()
        (found,) = sb.foreground_source(self.world.engine)()
        self.assertEqual((found.kind, found.recipient, found.batch), (sb.DECORATION, "cos", False))
        self.assertTrue(found.key.startswith("decoration:%s:msg_" % self.cos))

    def test_the_source_is_registered_and_the_engine_has_no_second_way_to_write(self):
        self.assertIsNotNone(sb.foreground_source(self.world.engine))
        source = SWITCHBOARD.read_text()
        section = source.split("# PR 8: foreground and background", 1)[1].split("# Worker events, reminders", 1)[0]
        for forbidden in ("v2.synthetic(", "v2.prompt(", "herdr.agent_prompt"):
            self.assertNotIn(forbidden, section.split("def launch_agent")[0], forbidden)
        self.assertNotIn(".synthetic(", section)


class HandoffCase(IntentCase):
    BRIEF = ("Done so far: found that the staging config drops the project binding\n"
             "Next steps:\n1. patch the binding\n2. redeploy staging\nWatch out for: production is untouched\n")

    def setUp(self):
        super().setUp()
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "gh": FAKE_GH, "intent_repo": FAKE_REPO})
        self.cos = self.world.add_agent("cos", fleet={"role": "chief-of-staff"})
        self.work = self.home / "work"
        self.work.mkdir()
        self.order = []
        os.environ["HERDR_PANE_ID"] = self.world.panes["cos"]

    def route(self, argv, **kwargs):
        if argv[0] == FAKE_GH:
            self.order.append("gh")
            return self.gh(argv, **kwargs)
        if argv[0] == FAKE_OPENCODE and argv[2:3] == ["session.create"]:
            self.order.append("session.create")
        return self.world.route(argv, **kwargs)

    def main(self, brief=None, *extra, issue="2"):
        path = self.home / "brief.md"
        path.write_text(self.BRIEF if brief is None else brief)
        with captured() as (out, err):
            code = sb.main(["handoff", "--issue", issue, "--brief-file", str(path), "--dir", str(self.work),
                            "--workspace", "w1"] + list(extra), runner=self.route, now=self.world.clock.now,
                           socket_call=self.world.herdr.socket)
        return code, out.getvalue(), err.getvalue()

    def comments(self):
        return self.gh.__dict__.get("comments", [])

    def subagents(self):
        return [s for s in self.world.v2.sessions.values()
                if (s["metadata"].get("fleet") or {}).get("role") == "cos-subagent"]

    def assertNothingWritten(self):
        self.assertEqual(self.comments(), [])
        self.assertEqual(self.subagents(), [])
        self.assertEqual([c for c in self.gh.calls if "--method" in c], [])


SHIM = REPO / "shims" / "gh"
# The shim looks its identity up with a short deadline (3 s by default, two process starts for an older switchboard). A test that expects a NAME must not
# depend on how busy the machine is, so its shim runs get the longest deadline the shim allows (10 s). The tests of the deadline itself set their own.
SHIM_LOOKUP_SECONDS = "10"


class TestShimHygiene(unittest.TestCase):
    def test_it_is_executable_portable_stdlib_only_and_impersonal(self):
        text = SHIM.read_text()
        self.assertTrue(os.access(str(SHIM), os.X_OK))
        self.assertEqual(text.splitlines()[0], "#!/usr/bin/env python3")
        roots = _stdlib_roots()
        for node in ast.walk(ast.parse(text)):
            names = [a.name.split(".")[0] for a in node.names] if isinstance(node, ast.Import) else \
                [node.module.split(".")[0]] if isinstance(node, ast.ImportFrom) and node.level == 0 else []
            for name in names:
                origin = importlib.util.find_spec(name).origin or ""
                self.assertTrue(origin in ("built-in", "frozen") or os.path.realpath(origin).startswith(roots), name)
        self.assertIn("\nimport sys\n", text)
        pattern = re.compile("|".join(["jan" + "us", "sp" + "ire", "adk" + "aplan", "/Us" + "ers/", "direc" + "tor(?!y|ies)"]),
                             re.IGNORECASE)
        for number, line in enumerate(text.splitlines(), 1):
            self.assertIsNone(pattern.search(line), "%d: %s" % (number, line))


GIT_SHIM = REPO / "shims" / "git"


class TestGitShim(Base):
    """The `git` shim: the network verbs get the fleet's credential helper, everything else runs the real git unchanged. A fake real git records what it got."""

    RESET = "credential.https://github.com.helper="
    HELPER = "credential.https://github.com.helper=!gh auth git-credential"

    def setUp(self):
        super().setUp()
        self.bin = self.home / "realbin"
        self.bin.mkdir()
        self.log = self.home / "git-log.json"
        self.starts = self.home / "git-starts"
        fake = self.bin / "git"
        fake.write_text("#!/usr/bin/env python3\nimport json,os,sys\n"
                        "open(%r,'a').write('x')\n"
                        "json.dump({'argv': sys.argv[1:], 'stdin': None if sys.stdin.isatty() else sys.stdin.read(), 'token_env': os.environ.get('GH_TOKEN'), 'env': {k: os.environ.get(k) for k in ('GIT_TERMINAL_PROMPT', 'GCM_INTERACTIVE')}}, open(%r,'w'))\n"
                        "print('real git out'); sys.exit(int(os.environ.get('FAKE_GIT_EXIT','0')))\n" % (str(self.starts), str(self.log)))
        fake.chmod(0o755)
        self.write_users({"acme/*": "acct-acme"})

    def write_users(self, users):
        config = self.home / "xdg-config" / "fleet-switchboard"
        config.mkdir(parents=True, exist_ok=True)
        (config / "config.json").write_text(json.dumps({"gh_users": users} if users is not None else {}))

    def run_git(self, *args, stdin="", env=None, path=None):
        environ = {"PATH": path or "%s:%s:%s" % (GIT_SHIM.parent, self.bin, SAFE_PATH), "HOME": str(self.home), "XDG_CONFIG_HOME": str(self.home / "xdg-config")}
        environ.update(env or {})
        for p in (self.log, self.starts):
            if p.exists():
                p.unlink()
        done = subprocess.run([sys.executable, str(GIT_SHIM)] + list(args), input=stdin, capture_output=True, text=True, env=environ, timeout=60)
        seen = json.loads(self.log.read_text()) if self.log.exists() else None
        if seen is not None:   # #1050: every call carries the no-dialog pair; the older tests below read the arguments without it (the new tests read `no_dialog_env` and check the pair)
            argv = seen["argv"]
            pair = [i for i in range(len(argv) - 1) if argv[i] == "-c" and argv[i + 1] == "credential.interactive=false"]
            self.assertTrue(pair, "no -c credential.interactive=false in %r" % (argv,))
            seen["argv_with_pair"] = list(argv)
            del argv[pair[0]:pair[0] + 2]
        return done, seen

    def routed(self, *globals_, verb, rest=()):
        return list(globals_) + ["-c", self.RESET, "-c", self.HELPER, verb] + list(rest)

    def fake_switchboard(self, read_repo):
        sb_bin = self.home / "sb"
        answer = {"name": "w", "repo": "acme-org/widget-service", "own": True}
        if read_repo != "absent":
            answer["read_repo"] = read_repo
        sb_bin.write_text("#!/bin/sh\n[ \"$1\" = whoami ] && echo '%s' && exit 0\nexit 2\n" % json.dumps(answer))
        sb_bin.chmod(0o755)
        return {"FLEET_SWITCHBOARD_BIN": str(sb_bin)}

    def test_a_push_by_a_worker_with_a_read_repo_is_refused_when_it_targets_that_repository_or_cannot_be_read(self):
        env = self.fake_switchboard("acme-org/widget-api")
        for target in ("https://github.com/acme-org/widget-api.git", "git@github.com:Acme-Org/Widget-Api.git", "https://github.com/acme-org/widget-api",
                       "file:///tmp/x", "https://evil.example/acme-org/widget-service"):
            with self.subTest(target=target):
                done, seen = self.run_git("push", target, "main", env=env)
                self.assertEqual(done.returncode, 1, done.stderr)
                self.assertIsNone(seen)
        for pushed in (("-o", "x", "https://github.com/acme-org/widget-api.git"), ("--push-option", "x", "https://github.com/acme-org/widget-api.git"),
                       ("--repo=https://github.com/acme-org/widget-api.git",), ("-u", "https://github.com/acme-org/widget-api.git", "main"),
                       ("--receive-pack=x", "git@github.com:acme-org/widget-api.git"), ("-o", "x", "file:///tmp/x")):
            with self.subTest(pushed=pushed):
                done, seen = self.run_git("push", *pushed, env=env)
                self.assertEqual(done.returncode, 1, done.stderr)
                self.assertIsNone(seen)
        done, seen = self.run_git("-C", "/w", "push", "https://github.com/acme-org/widget-api.git", env=env)
        self.assertEqual((done.returncode, seen), (1, None))
        done, seen = self.run_git("push", "https://github.com/acme-org/widget-service.git", "main", env=env)
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertIsNotNone(seen)
        for state in ("absent", "Bad/Record", False):
            done, seen = self.run_git("push", "https://github.com/acme-org/widget-api.git", env=self.fake_switchboard(state))
            self.assertEqual(done.returncode == 1, state != "absent", (state, done.stderr))
        done, seen = self.run_git("fetch", "https://github.com/acme-org/widget-api.git", env=env)
        self.assertEqual(done.returncode, 0, "a fetch (a read) of the read repository is not a push")

    def test_s1_every_network_verb_gets_the_reset_then_the_fleets_helper_right_before_the_verb(self):
        cases = (("push", ["origin", "branch"]), ("fetch", ["--all"]), ("pull", ["--ff-only"]), ("clone", ["https://github.com/acme/api.git", "x"]),
                 ("ls-remote", ["origin"]))
        for verb, rest in cases:
            for globals_ in ([], ["-C", "/work/tree"], ["-c", "user.name=x", "--no-pager"], ["--git-dir=/g", "-C", "/w", "-p"]):
                with self.subTest(verb=verb, globals=globals_):
                    done, seen = self.run_git(*globals_, verb, *rest)
                    self.assertEqual(done.returncode, 0, done.stderr)
                    self.assertEqual(seen["argv"], self.routed(*globals_, verb=verb, rest=rest))
        done, seen = self.run_git("remote", "update", "--prune")
        self.assertEqual(seen["argv"], self.routed(verb="remote", rest=["update", "--prune"]))
        done, seen = self.run_git("-C", "/w", "remote", "-v", "update")
        self.assertEqual(seen["argv"], self.routed("-C", "/w", verb="remote", rest=["-v", "update"]))

    def test_s2_every_other_command_runs_the_real_git_with_the_same_arguments_input_and_exit_status(self):
        for args in (("status", "-sb"), ("log", "--oneline", "-5"), ("diff", "--stat"), ("commit", "-m", "x"), ("remote", "add", "o", "u"), ("remote", "-v"),
                     ("config", "credential.helper"), ("stash", "list"), ("-C", "/w", "checkout", "-b", "x"), ("--version",), (), ("push-like",)):
            with self.subTest(args=args):
                done, seen = self.run_git(*args, stdin="input text", env={"FAKE_GIT_EXIT": "3"})
                self.assertEqual(done.returncode, 3)
                self.assertEqual(seen["argv"], list(args))
                self.assertEqual(seen["stdin"], "input text")
                self.assertEqual(done.stdout, "real git out\n")
        done, seen = self.run_git("push", "origin", stdin="in", env={"FAKE_GIT_EXIT": "5"})
        self.assertEqual((done.returncode, seen["stdin"]), (5, "in"), "a network verb keeps its input and exit status too")

    def test_s3_a_callers_own_credential_configuration_is_left_alone(self):
        for args in (("-c", "credential.helper=store", "push", "origin"), ("-c", "credential.https://github.com.helper=!x", "fetch"),
                     ("--config-env", "credential.helper=SOME_ENV", "pull"), ("--config-env=credential.helper=SOME_ENV", "push"),
                     ("-c", "Credential.UseHttpPath=true", "push")):
            with self.subTest(args=args):
                done, seen = self.run_git(*args)
                self.assertEqual(seen["argv"], list(args))
        done, seen = self.run_git("-c", "user.name=x", "push")
        self.assertEqual(seen["argv"], self.routed("-c", "user.name=x", verb="push"), "a -c that is not a credential setting does not count")

    def test_s3_it_finds_the_real_git_behind_its_own_directory_and_never_runs_itself(self):
        twice = "%s:%s:%s:%s" % (GIT_SHIM.parent, GIT_SHIM.parent, self.bin, SAFE_PATH)
        done, seen = self.run_git("status", path=twice)
        self.assertEqual((done.returncode, seen["argv"], self.starts.read_text()), (0, ["status"], "x"), "the fake started once")
        done, seen = self.run_git("status", path=str(GIT_SHIM.parent))
        self.assertEqual((done.returncode, seen), (127, None))
        self.assertIn("no real git", done.stderr)
        link = self.home / "linkdir"
        link.mkdir()
        (link / "git").symlink_to(GIT_SHIM)
        done, seen = self.run_git("status", path="%s:%s" % (link, str(GIT_SHIM.parent)))
        self.assertEqual((done.returncode, seen), (127, None), "a symlink to the shim is the shim, not a real git")
        done, seen = self.run_git("status", path="%s:%s" % (GIT_SHIM.parent, SAFE_PATH), env={"FLEET_REAL_GIT": str(self.bin / "git")})
        self.assertEqual((done.returncode, seen["argv"]), (0, ["status"]), "FLEET_REAL_GIT names the real git")

    def test_a_parse_it_does_not_understand_and_a_real_git_that_cannot_start_never_block_the_command(self):
        for args in (("-c",), ("-C",), ("-c", "user.name=x")):   # a value option with no value, or no verb at all: nothing to route
            with self.subTest(args=args):
                done, seen = self.run_git(*args)
                self.assertEqual(seen["argv"], list(args))
        broken = self.home / "brokenbin"
        broken.mkdir()
        (broken / "git").write_text("#!/nonexistent/interpreter\n")
        (broken / "git").chmod(0o755)
        done, seen = self.run_git("status", path="%s:%s" % (GIT_SHIM.parent, broken))
        self.assertEqual((done.returncode, seen), (126, None))
        self.assertIn("git: cannot run", done.stderr)

    def test_it_routes_only_when_accounts_are_mapped_and_not_switched_off(self):
        for label, setup, env in (("no gh_users at all", lambda: self.write_users(None), {}), ("an empty map", lambda: self.write_users({}), {}),
                                  ("switched off", lambda: self.write_users({"acme/*": "a"}), {"FLEET_GIT_SHIM": "off"}),
                                  ("an unreadable config", lambda: (self.home / "xdg-config" / "fleet-switchboard" / "config.json").write_text("{bad"), {})):
            with self.subTest(label):
                setup()
                done, seen = self.run_git("push", "origin", env=env)
                self.assertEqual(seen["argv"], ["push", "origin"], "git keeps its own credentials")
        self.write_users({"acme/*": "a"})
        done, seen = self.run_git("push", "origin")
        self.assertEqual(seen["argv"], self.routed(verb="push", rest=["origin"]))
        for sub in ("show", "prune", "update"):
            done, seen = self.run_git("remote", sub, "origin")
            self.assertEqual(seen["argv"], self.routed(verb="remote", rest=[sub, "origin"]), sub)
        done, seen = self.run_git("remote", "add", "o", "u")
        self.assertEqual(seen["argv"], ["remote", "add", "o", "u"])

    def test_the_shim_reads_no_token_and_prints_nothing_of_its_own(self):
        done, seen = self.run_git("push", env={"GH_TOKEN": "tok-secret"})
        self.assertNotIn("tok-secret", " ".join(seen["argv"]) + done.stdout + done.stderr)
        self.assertEqual(done.stderr, "")

    def test_s5_the_fleet_coordination_skill_says_git_push_needs_no_manual_credential_route(self):
        skill = " ".join((REPO / "skills" / "fleet-coordination" / "SKILL.md").read_text().split())
        self.assertIn("git push works as the repository's account", skill)
        self.assertIn("no manual -c", skill)
        self.assertIn("guardrail, not a boundary", skill)

    def test_the_shim_is_executable_stdlib_only_and_impersonal(self):
        text = GIT_SHIM.read_text()
        self.assertTrue(os.access(str(GIT_SHIM), os.X_OK))
        self.assertEqual(text.splitlines()[0], "#!/usr/bin/env python3")
        pattern = re.compile("|".join(["jan" + "us", "sp" + "ire", "adk" + "aplan", "/Us" + "ers/"]), re.IGNORECASE)
        for number, line in enumerate(text.splitlines(), 1):
            self.assertIsNone(pattern.search(line), "%d: %s" % (number, line))


    # ---- #1050 (in TestGitShim, which owns the fake real git and run_git)
    """#1050: no git call of the fleet may open a credential dialog. S2 (the shim's environment and argument on every verb and host), S3 (launch environments), S4 (heavy and
    test setup), S5 (a real git, a recording fake helper, three mutants of the shim), S6 (docs), S7 (nothing writes the global git configuration)."""

    NO = "credential.interactive=false"
    VERBS = (("push", ["origin", "b"]), ("fetch", ["--all"]), ("pull", ["--ff-only"]), ("clone", ["URL", "x"]), ("ls-remote", ["URL"]), ("remote", ["update"]),
             ("status", ["-sb"]), ("log", ["-1"]), ("commit", ["-m", "x"]), ("config", ["a.b"]))
    HOSTS = ("https://github.com/acme/api.git", "https://git.example.test/acme/api.git")

    def test_s2_every_verb_for_the_code_host_and_another_host_carries_all_three_settings(self):
        count = 0
        for host in self.HOSTS:
            for verb, rest in self.VERBS:
                with self.subTest(host=host, verb=verb):
                    done, seen = self.run_git(verb, *[host if a == "URL" else a for a in rest])
                    self.assertEqual(done.returncode, 0, done.stderr)
                    self.assertEqual(seen["env"], {"GIT_TERMINAL_PROMPT": "0", "GCM_INTERACTIVE": "never"})
                    self.assertEqual(seen["argv_with_pair"].count(self.NO), 1)
                    self.assertLess(seen["argv_with_pair"].index(self.NO), seen["argv_with_pair"].index(verb), "the setting is a global option, before the verb")
                    count += 1
        self.assertEqual(count, len(self.HOSTS) * len(self.VERBS))

    def test_s2_a_callers_interactive_true_is_overridden_and_another_credential_setting_stays(self):
        done, seen = self.run_git("-c", "credential.interactive=true", "-c", "credential.helper=store", "-c", "GCM_INTERACTIVE=always", "fetch")
        argv = seen["argv_with_pair"]
        self.assertGreater(argv.index(self.NO), argv.index("credential.interactive=true"), "ours comes last, so it wins")
        self.assertIn("credential.helper=store", argv)
        done, seen = self.run_git("-c", "credential.interactive=true", "status", env={"GIT_TERMINAL_PROMPT": "1", "GCM_INTERACTIVE": "always"})
        self.assertEqual(seen["env"], {"GIT_TERMINAL_PROMPT": "0", "GCM_INTERACTIVE": "never"}, "a caller's environment cannot turn them back on")

    def test_s3_the_launch_environments_hold_both_variables(self):
        both = {"GIT_TERMINAL_PROMPT": "0", "GCM_INTERACTIVE": "never"}
        env = sb.launch_base_env({"opencode_env": {"GIT_TERMINAL_PROMPT": "1", "X": "1"}, "launch_env": {"GCM_INTERACTIVE": "always"}})   # a terminal launch and a reattach
        self.assertEqual({k: env[k] for k in both}, both)
        self.assertEqual(env["X"], "1")
        seen = {}

        def runner(argv, **kwargs):
            seen["env"] = kwargs["env"]
            return subprocess.CompletedProcess(argv, 0, "", "")
        sb.V2Client("/opt/lab/bin/opencode", {"GIT_TERMINAL_PROMPT": "1"}, runner, 7).server_info()   # the service client (a headless worker's tools)
        self.assertEqual({k: seen["env"][k] for k in both}, both)
        entry = (REPO / "cloud" / "worker" / "entrypoint.sh").read_text()
        self.assertRegex(entry, r"(?m)^GIT_TERMINAL_PROMPT=0; export GIT_TERMINAL_PROMPT$")   # the pod's entrypoint, before it runs the command
        self.assertRegex(entry, r"(?m)^GCM_INTERACTIVE=never; export GCM_INTERACTIVE$")
        self.assertLess(entry.index("export GCM_INTERACTIVE"), entry.index('exec "$@"'))

    def test_s4_the_heavy_wrapper_and_the_test_setup_set_both_variables(self):
        out = self.home / "heavy-env"
        hs = sb.load_heavy_slots()
        code = hs.run([sys.executable, "-c", "import os,sys;open(sys.argv[1],'w').write(os.environ.get('GIT_TERMINAL_PROMPT','')+' '+os.environ.get('GCM_INTERACTIVE',''))", str(out)],
                      str(self.home / "heavy-state"), environ={"PATH": os.environ["PATH"], "FLEET_HEAVY": "off", "GIT_TERMINAL_PROMPT": "1"}, out=io.StringIO())
        self.assertEqual((code, out.read_text()), (0, "0 never"))
        self.assertEqual((os.environ["GIT_TERMINAL_PROMPT"], os.environ["GCM_INTERACTIVE"]), ("0", "never"), "this suite's own setup")

    def test_s4_no_test_runs_real_git_against_a_local_server_without_a_private_home(self):
        offenders = []
        for path in sorted(BIN.glob("test-*")) + sorted((REPO / "cloud").rglob("test*.py")):
            text = path.read_text(errors="replace")
            local = re.search(r"git[^\n]{0,80}(?:ls-remote|clone|fetch|push)[^\n]{0,120}http://(?:127\.0\.0\.1|localhost)", text)
            if local and "GIT_CONFIG_NOSYSTEM" not in text:
                offenders.append(str(path))
        self.assertEqual(offenders, [])

    def fake_helper(self):
        starts = self.home / "helper-starts"
        helper = self.home / "helper"
        # a stand-in for a helper that opens a dialog unless told not to (as Git Credential Manager does: GCM_INTERACTIVE and its `credential.interactive` setting; git's own prompt is GIT_TERMINAL_PROMPT)
        helper.write_text("#!/bin/sh\n[ \"$GCM_INTERACTIVE\" = never ] && [ \"$GIT_TERMINAL_PROMPT\" = 0 ] && [ \"$(git config credential.interactive)\" = false ] || echo started >> %s\n" % starts)
        helper.chmod(0o755)
        (self.home / "private").mkdir(exist_ok=True)
        self.helper_path = helper   # handed to git through GIT_CONFIG_COUNT in `lsremote`: no git configuration file is written
        return starts

    def lsremote(self, shim, env_drop=(), extra_env=None):
        """git ls-remote to a closed local port through `shim` (a copy of the real one, or a mutant), with a private home and a helper that records its start."""
        starts = self.fake_helper()
        if starts.exists():
            starts.unlink()
        server = socket.socket()
        server.bind(("127.0.0.1", 0))
        server.listen(1)
        port = server.getsockname()[1]
        got = []

        def serve():   # a server that answers 401 once: this is what makes git ask its credential helper
            try:
                conn, _ = server.accept()
                conn.recv(65536)
                conn.sendall(b"HTTP/1.1 401 Unauthorized\r\nWWW-Authenticate: Basic realm=x\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
                conn.close()
            except OSError:
                pass
        thread = threading.Thread(target=serve, daemon=True)
        thread.start()
        real = shutil.which("git", path=SAFE_PATH) or shutil.which("git")
        env = {"PATH": "%s:%s" % (os.path.dirname(real), SAFE_PATH), "HOME": str(self.home / "private"), "GIT_CONFIG_NOSYSTEM": "1", "FLEET_REAL_GIT": real,
               "XDG_CONFIG_HOME": str(self.home / "xdg-none"), "GIT_CONFIG_COUNT": "1", "GIT_CONFIG_KEY_0": "credential.helper", "GIT_CONFIG_VALUE_0": str(self.helper_path)}
        env.update(extra_env or {})   # (the sentinel test points the home variables at its scratch home)
        started = time.time()
        done = subprocess.run([sys.executable, str(shim), "ls-remote", "http://127.0.0.1:%d/x.git" % port], capture_output=True, text=True, env=env, timeout=30)
        took = time.time() - started
        server.close()
        thread.join(5)
        return done, took, starts.exists() and starts.read_text().count("started")

    def mutant(self, name, old, new):
        text = GIT_SHIM.read_text()
        self.assertIn(old, text, "the mutant %s no longer applies" % name)
        path = self.home / ("mutant-" + name)
        path.mkdir()
        (path / "stash_guard.py").write_text((GIT_SHIM.parent / "stash_guard.py").read_text())
        (path / "git").write_text(text.replace(old, new, 1))
        (path / "git").chmod(0o755)
        return path / "git"

    def test_s5_a_local_port_url_fails_at_once_and_the_helper_never_starts(self):
        if not (shutil.which("git", path=SAFE_PATH) or shutil.which("git")):
            self.skipTest("no real git")
        done, took, starts = self.lsremote(GIT_SHIM)
        self.assertEqual((done.returncode, starts), (128, 0), done.stderr)
        self.assertLess(took, 5)
        self.assertNotIn("started", done.stdout + done.stderr)

    def test_s5_three_mutants_of_the_shim_start_the_helper_or_do_not_fail(self):
        if not (shutil.which("git", path=SAFE_PATH) or shutil.which("git")):
            self.skipTest("no real git")
        mutants = {
            "drop-terminal-prompt": ('{"GIT_TERMINAL_PROMPT": "0", "GCM_INTERACTIVE": "never"}', '{"GCM_INTERACTIVE": "never"}'),
            "drop-gcm-interactive": ('{"GIT_TERMINAL_PROMPT": "0", "GCM_INTERACTIVE": "never"}', '{"GIT_TERMINAL_PROMPT": "0"}'),
            "interactive-back-on": ('NO_DIALOG_CONFIG = "credential.interactive=false"', 'NO_DIALOG_CONFIG = "credential.interactive=true"'),
            "code-host-only": ("    return no_dialog(route_credentials(args))", "    return no_dialog(route_credentials(args)) if any('github.com' in a for a in args) else route_credentials(args)"),
        }
        for name, (old, new) in mutants.items():
            with self.subTest(name):
                done, took, starts = self.lsremote(self.mutant(name, old, new))
                self.assertTrue(starts >= 1 or done.returncode != 128, "the mutant %s was not caught: exit %s, %s helper starts" % (name, done.returncode, starts))

    def test_s6_the_documentation_names_each_place_next_to_both_variables(self):
        text = (REPO / "docs" / "no-credential-dialog.md").read_text()
        rows = [line for line in text.splitlines() if line.startswith("| ") and "GIT_TERMINAL_PROMPT" in line and "GCM_INTERACTIVE" in line]
        for place in ("shims/git", "bin/fleet-switchboard", "entrypoint.sh", "bin/heavy_slots.py"):
            self.assertEqual(len([r for r in rows if place in r]), 1, place)
        self.assertEqual(len(rows), 4)

    # S7/U1, a cheap first line only: a text scan is a deny-list and cannot see a spelling built from pieces ("--glo"+"bal", a split-joined XDG path). The ROOT check is
    # behavioural (test_s7_u2_...). Each row below has a hostile sample that ONLY that row finds, and a test that skips each row in turn and fails (one mutant per row).
    _G, _S = "glo" + "bal", "sys" + "tem"
    CONFIG_WRITE_FLAGS = ["--" + w for w in ("add", "unset", "unset-all", "replace-all", "edit", "rename-section", "remove-section")]
    CONFIG_WRITE_SPELLINGS = (   # (name, regex over one line, a hostile line that only this row catches)
        ("config command with a write flag", r"\bconfig\b[^\n]*(?:%s)(?![\w-])" % "|".join(re.escape(f) for f in CONFIG_WRITE_FLAGS),
         'run(["git", "con' + 'fig", "--a' + 'dd", "k", "v"])'),
        ("the short write flag", r"\bcon" + r"fig\b[^\n]*\s-e\b", "git con" + "fig -e"),
        ("the global or system scope", r"\bconfig\b[^\n]*--(?:%s|%s)(?![\w-])" % (_G, _S), 'os.system("git config --' + _S + ' a b")'),
        ("the file scope", r"\bcon" + r"fig\b[^\n]*(?:\s-f\b|--fi" + "le\\b)", "git con" + "fig -f out.cfg a b"),
        ("the home gitconfig path", r"\.git" + "config", 'open(os.path.expanduser("~")+"/.git' + 'config","a")'),
        ("the XDG git directory", r"\.con" + r"fig/git\b|XDG_CONFIG" + r"_HOME[^\n]*/git\b|XDG_CONFIG" + r"_HOME[^\n]*[\"']git[\"']", 'echo x > "$XDG_CONFIG' + '_HOME/git/con' + 'fig"'),
        ("the global/system override variables", r"GIT_CONFIG_(?:%s|%s)\b" % (_G.upper(), _S.upper()), "GIT_CONFIG_" + _G.upper() + " = path"),
    )

    @classmethod
    def config_write_hits(cls, text):
        return [(n, line) for line in text.splitlines() for n, rx, _ in cls.CONFIG_WRITE_SPELLINGS if re.search(rx, line)]

    @staticmethod
    def added_lines(diff):
        return "\n".join(l[1:] for l in diff.splitlines() if l.startswith("+") and not l.startswith("+++"))

    def test_s7_u1_every_row_of_the_scan_finds_its_sample_and_only_that_row_does(self):
        for name, rx, hostile in self.CONFIG_WRITE_SPELLINGS:
            with self.subTest(name):   # the mutant: skip this row; the sample must then go unfound by every other row, so the row cannot be dropped unseen
                found = [n for n, other, _ in self.CONFIG_WRITE_SPELLINGS if re.search(other, hostile)]
                self.assertEqual(found, [name])
        for extra in ("git con" + "fig --fi" + "le=/x/y a b", "git con" + "fig -" + "f /x a b"):
            self.assertTrue(self.config_write_hits(extra), extra)
        for clean in ('env = {"GIT_CONFIG_NO' + 'SYSTEM": "1"}', "git config credential.interactive", 'run(["git", "config", "--get", "a.b"])'):
            self.assertEqual(self.config_write_hits(clean), [], clean)

    def test_s7_u2_the_focused_paths_leave_a_sentinel_home_byte_identical_and_add_no_file(self):
        if not (shutil.which("git", path=SAFE_PATH) or shutil.which("git")):
            self.skipTest("no real git")
        scratch = self.home / "sentinel-home"
        (scratch / (".con" + "fig") / "git").mkdir(parents=True)
        (scratch / (".git" + "config")).write_text("[user]\n\tname = Sentinel\n")
        (scratch / (".con" + "fig") / "git" / "con" "fig").write_text("[core]\n\tabbrev = 9\n")

        def snapshot():
            return {str(p.relative_to(scratch)): (p.read_bytes() if p.is_file() else None) for p in sorted(scratch.rglob("*"))}
        before = snapshot()
        pointed = {"HOME": str(scratch), "GIT_CONFIG_" + self._G.upper(): str(scratch / (".git" + "config")), "XDG_CONFIG" + "_HOME": str(scratch / (".con" + "fig"))}
        with mock.patch.dict(os.environ, pointed):
            sb.launch_base_env({"opencode_env": {}, "launch_env": {}})
            sb.V2Client("/opt/lab/bin/opencode", {}, lambda argv, **kw: subprocess.CompletedProcess(argv, 0, "", ""), 7).server_info()
            hs = sb.load_heavy_slots()
            hs.run([sys.executable, "-c", "pass"], str(self.home / "heavy-sentinel"), environ=dict(os.environ, FLEET_HEAVY="off"), out=io.StringIO())
            self.run_git("fetch", "--all")
            self.run_git("config", "a.b")
            done, took, starts = self.lsremote(GIT_SHIM, extra_env=pointed)   # the real shim in front of a real git, the sentinel as its home
            self.assertEqual((done.returncode, starts), (128, 0), done.stderr)
        self.assertEqual(snapshot(), before, "a focused path wrote, changed or added a file in the home it was pointed at")

    def test_s7_u1_no_file_of_this_change_writes_the_global_git_configuration(self):
        base = None
        for ref in ("origin/main", "main"):
            probe = subprocess.run(["git", "-C", str(REPO), "merge-base", ref, "HEAD"], capture_output=True, text=True)
            if probe.returncode == 0 and probe.stdout.strip():
                base = probe.stdout.strip()
                break
        if base is None:
            self.skipTest("no main to diff against (a shallow checkout)")
        diff = subprocess.run(["git", "-C", str(REPO), "diff", base, "-U0", "--no-color"], capture_output=True, text=True, timeout=60).stdout
        self.assertEqual(self.config_write_hits(self.added_lines(diff)), [])


class TestGitStashGuard(Base):
    """The `git` shim refuses the `git stash` forms that change the stack (ask #341). These run the shim in front of the machine's real git, in a throwaway repository."""

    FORMS = ("push", "save", "pop", "apply", "drop", "clear", "branch", "create", "store")

    def setUp(self):
        super().setUp()
        self.real = shutil.which("git", path=SAFE_PATH) or shutil.which("git")
        if not self.real:
            self.skipTest("no real git")
        self.shimdir = self.home / "shimbin"
        self.shimdir.mkdir()
        (self.shimdir / "git").symlink_to(GIT_SHIM)
        self.repo = self.home / "repo"
        self.repo.mkdir()
        self.env = {"PATH": "%s:%s:%s" % (self.shimdir, os.path.dirname(self.real), SAFE_PATH), "HOME": str(self.home), "XDG_CONFIG_HOME": str(self.home / "xdg"), "GIT_CONFIG_NOSYSTEM": "1",
                    "GIT_CONFIG_GLOBAL": str(self.home / "gitconfig"), "GIT_AUTHOR_NAME": "a", "GIT_AUTHOR_EMAIL": "a@x", "GIT_COMMITTER_NAME": "a", "GIT_COMMITTER_EMAIL": "a@x"}
        (self.home / "gitconfig").write_text("")
        self.run_real("init", "-q", "-b", "main")
        (self.repo / "f").write_text("one\n")
        self.run_real("add", "f")
        self.run_real("commit", "-q", "-m", "one")

    def run_real(self, *args, env=None, cwd=None):
        e = dict(self.env, PATH=os.path.dirname(self.real))
        e.update(env or {})
        return subprocess.run([self.real] + list(args), capture_output=True, text=True, env=e, cwd=cwd or self.repo, timeout=60)

    def run_shim(self, *args, env=None, cwd=None, path=None):
        e = dict(self.env)
        if path is not None:
            e["PATH"] = path
        e.update(env or {})
        return subprocess.run([sys.executable, str(GIT_SHIM)] + list(args), capture_output=True, text=True, env=e, cwd=cwd or self.repo, timeout=60)

    def stashed(self):
        return self.run_real("stash", "list").stdout

    def dirty_and_stash_one(self):
        (self.repo / "f").write_text("two\n")
        self.assertEqual(self.run_real("stash", "push", "-q").returncode, 0)
        (self.repo / "f").write_text("three\n")

    def assertRefused(self, done, why=""):
        self.assertEqual(done.returncode, 1, "%s %s %s" % (why, done.stdout, done.stderr))
        self.assertIn("scratch branch", done.stderr, why)
        self.assertIn("git switch -c scratch/", done.stderr, why)
        self.assertEqual(done.stdout, "", why)

    def test_s1_s5_every_stack_changing_form_is_refused_with_the_scratch_branch_message_and_changes_nothing(self):
        self.dirty_and_stash_one()
        before = (self.stashed(), self.run_real("status", "--porcelain").stdout, sorted(p.name for p in self.repo.iterdir()))
        for form in self.FORMS:
            for extra in ((), ("-q",), ("x",)):
                with self.subTest(form=form, extra=extra):
                    self.assertRefused(self.run_shim("stash", form, *extra), form)
        self.assertEqual((self.stashed(), self.run_real("status", "--porcelain").stdout, sorted(p.name for p in self.repo.iterdir())), before, "no stash created, dropped or applied")
        self.assertEqual((self.repo / "f").read_text(), "three\n")

    def test_the_bare_stash_and_its_option_forms_push_so_they_are_refused(self):
        (self.repo / "f").write_text("two\n")
        for args in ((), ("-u",), ("-p",), ("-m", "msg"), ("--", "f"), ("-q", "--", "f"), ("--keep-index",), ("f",), ("--include-untracked", "--", "f"), ("-q", "list"),
                     ("--quiet", "pop"), ("LIST",), ("list ",), ("lis",), ("sh",), ("",)):
            with self.subTest(args=args):
                self.assertRefused(self.run_shim("stash", *args))
        self.assertEqual(self.stashed(), "")
        self.assertEqual((self.repo / "f").read_text(), "two\n")

    def test_global_options_before_the_verb_do_not_hide_it(self):
        (self.repo / "f").write_text("two\n")
        other = self.home / "elsewhere"
        other.mkdir()
        for globals_ in (["-C", str(self.repo)], ["-c", "user.name=x"], ["--no-pager"], ["-p"], ["-P"], ["--git-dir", str(self.repo / ".git")], ["--git-dir=%s" % (self.repo / ".git")],
                         ["--work-tree", str(self.repo)], ["-C", str(self.repo), "-c", "a.b=c", "--no-pager"], ["--bare"], ["--exec-path=/nonexistent"], ["--namespace", "n"],
                         ["--config-env", "a.b=HOME"], ["--config-env=a.b=HOME"], ["--literal-pathspecs"], ["--no-replace-objects"]):
            with self.subTest(globals=globals_):
                done = self.run_shim(*globals_, "stash", "push", cwd=other if "-C" in globals_ else None)
                self.assertRefused(done)
        self.assertEqual(self.stashed(), "")

    def test_an_alias_to_stash_is_followed_from_every_place_git_reads_one(self):
        (self.repo / "f").write_text("two\n")
        self.run_real("config", "alias.sp", "stash push")
        self.run_real("config", "alias.chain", "sp")
        self.run_real("config", "alias.quoted", "-c x.y=z --no-pager stash")
        self.run_real("config", "alias.sh", "!git stash push")
        self.run_real("config", "alias.Up", "stash")
        (self.home / "gitconfig").write_text("[alias]\n\tglobalstash = stash\n\tlistit = stash list\n")
        cases = [("sp",), ("chain",), ("quoted", "-q"), ("sh",), ("globalstash",), ("-c", "alias.s=stash", "s"), ("-c", "alias.s=stash push", "s", "-q"), ("-c", "alias.s=!git stash", "s"),
                 ("-c", "alias.a=b", "-c", "alias.b=stash", "a"), ("-c", "alias.s=-C . stash", "s"), ("-c", "alias.s=stash push", "-c", "x.y=z", "s"), ("--config-env", "alias.s=STASHALIAS", "s"),
                 ("-c", "alias.s=stash", "-C", ".", "s"), ("Up",)]
        for args in cases:
            with self.subTest(args=args):
                self.assertRefused(self.run_shim(*args, env={"STASHALIAS": "stash"}))
        for env in ({"GIT_CONFIG_COUNT": "1", "GIT_CONFIG_KEY_0": "alias.e", "GIT_CONFIG_VALUE_0": "stash"}, {"GIT_CONFIG_PARAMETERS": "'alias.e=stash'"}):
            with self.subTest(env=env):
                self.assertRefused(self.run_shim("e", env=env))
        self.assertEqual(self.stashed(), "")
        self.assertEqual((self.repo / "f").read_text(), "two\n")

    def test_an_alias_loop_or_one_it_cannot_read_is_refused_and_a_harmless_alias_runs(self):
        for key, value in (("a", "b"), ("b", "a"), ("self", "self")):
            self.run_real("config", "alias." + key, value)
        for verb in ("a", "self"):
            with self.subTest(verb=verb):
                done = self.run_shim(verb)
                self.assertEqual(done.returncode, 1)
                self.assertIn("scratch branch", done.stderr)
        self.run_real("config", "alias.st", "status --porcelain")
        self.run_real("config", "alias.shellok", "!echo hello")
        self.assertEqual(self.run_shim("st").returncode, 0)
        self.assertEqual((self.run_shim("shellok").returncode, self.run_shim("shellok").stdout), (0, "hello\n"))
        self.run_real("config", "alias.bad", "log '--oneline")   # an unterminated quote git cannot split either
        self.assertEqual(self.run_shim("bad").returncode, 1)

    def test_a_shell_alias_that_runs_git_stash_reaches_the_guard_again_through_path(self):
        self.run_real("config", "alias.hid", "!sh -c 'g=git; $g stash push'")
        (self.repo / "f").write_text("two\n")
        done = subprocess.run(["sh", "-c", "git hid"], capture_output=True, text=True, env=self.env, cwd=self.repo, timeout=60)
        self.assertEqual(done.returncode, 1, done.stderr)
        self.assertEqual(self.stashed(), "")

    def test_command_env_and_subshell_forms_all_reach_the_shim_through_path(self):
        (self.repo / "f").write_text("two\n")
        for script in ("command git stash", "env git stash push", "$(command -v git) stash pop", "(git stash)", "sh -c 'git stash push'", "x=$(git stash push 2>&1); echo $x; exit 1",
                       "cd . && git stash", "git -C . stash push", "FOO=1 git stash", "exec git stash push", "bash -c 'git stash save'"):
            with self.subTest(script=script):
                done = subprocess.run(["bash", "-c", script], capture_output=True, text=True, env=self.env, cwd=self.repo, timeout=60)
                self.assertNotEqual(done.returncode, 0, done.stdout + done.stderr)
                self.assertIn("scratch branch", done.stdout + done.stderr)
        self.assertEqual(self.stashed(), "")

    def test_autocorrect_and_a_moved_exec_path_cannot_turn_an_unknown_verb_into_stash(self):
        (self.repo / "f").write_text("two\n")
        execdir = self.home / "exec"
        execdir.mkdir()
        evil = execdir / "git-zz"
        evil.write_text("#!/bin/sh\nexec %s stash push\n" % self.real)
        evil.chmod(0o755)
        for value in ("-1", "-5", "1", "5", "20", "immediate", "prompt", "true", "yes", "on", "bogus", ""):
            for verb in ("stsh", "stahs", "stas", "zz", "STASH"):
                with self.subTest(value=value, verb=verb):
                    done = self.run_shim("-c", "help.autocorrect=" + value, verb, "pop")
                    self.assertEqual(done.returncode, 1, done.stderr)
                    self.assertIn("scratch branch", done.stderr)
        for verb in ("stsh", "stas"):
            for globals_, env in (([], {"GIT_CONFIG_COUNT": "1", "GIT_CONFIG_KEY_0": "help.autocorrect", "GIT_CONFIG_VALUE_0": "-1"}), ([], {"GIT_CONFIG_PARAMETERS": "'help.autocorrect=immediate'"}),
                                  (["--config-env", "help.autocorrect=AC"], {"AC": "-1"}), (["--config-env=help.autocorrect=AC"], {"AC": "1"}), ([], {"GIT_EXEC_PATH": str(execdir)}),
                                  (["--exec-path=%s" % execdir], {}), (["-c", "alias.s=stash", "-c", "help.autocorrect=-1"], {})):
                with self.subTest(verb=verb, globals=globals_, env=env):
                    done = self.run_shim(*globals_, verb, "pop", env=env)
                    self.assertEqual(done.returncode, 1, done.stderr)
                    self.assertIn("scratch branch", done.stderr)
        self.assertEqual(self.run_shim("-c", "alias.s=stash", "-c", "help.autocorrect=-1", "s", "pop").returncode, 1)
        self.assertEqual(self.stashed(), "")
        self.assertEqual((self.repo / "f").read_text(), "two\n")
        for value in ("-1", "-5", "immediate", "1"):   # from a config file git reads (the repository's own, and the global one)
            for where in (("config", "--local"), ("config", "--global")):
                self.run_real(*where, "help.autocorrect", value)
                with self.subTest(value=value, where=where):
                    self.assertEqual(self.run_shim("stsh", "pop").returncode, 1)
                    self.assertEqual(self.run_shim("stas").returncode, 1)
                    self.assertEqual(self.run_shim("status", "--porcelain").returncode, 0, "a known command still runs with autocorrect on")
                    self.assertEqual(self.run_shim("log", "--oneline", "-1").returncode, 0)
                self.run_real(*where, "--unset", "help.autocorrect")
        self.assertEqual(self.stashed(), "")
        self.assertEqual((self.repo / "f").read_text(), "two\n")

    def test_an_unknown_verb_without_autocorrect_or_a_moved_exec_path_is_left_to_git(self):
        for args in (("frobnicate",), ("stsh",)):
            done = self.run_shim(*args)
            real = self.run_real(*args)
            self.assertEqual((done.returncode, done.stdout, done.stderr), (real.returncode, real.stdout, real.stderr))
        for value in ("0", "false", "no", "off", "never", "show"):   # git's own off words: the verb is git's to reject (or, for show, to suggest)
            done, real = self.run_shim("-c", "help.autocorrect=" + value, "stsh"), self.run_real("-c", "help.autocorrect=" + value, "stsh")
            self.assertEqual((done.returncode, done.stdout, done.stderr), (real.returncode, real.stdout, real.stderr), value)

    def test_s2_list_show_and_every_other_command_are_byte_identical_to_the_real_git(self):
        self.dirty_and_stash_one()
        (self.repo / "g").write_text("g\n")
        self.run_real("config", "alias.st", "status -s")
        for args in (("stash", "list"), ("stash", "show"), ("stash", "show", "-p"), ("stash", "show", "stash@{0}"), ("stash", "list", "--oneline"), ("stash", "-h"),
                     ("status",), ("log", "--oneline"), ("diff",), ("st",), ("-C", str(self.repo), "stash", "list"), ("-c", "x.y=z", "stash", "show"), ("--no-pager", "stash", "list"),
                     ("branch", "--list"), ("rev-parse", "HEAD"), ("--version",), ("config", "alias.st")):
            with self.subTest(args=args):
                a, b = self.run_shim(*args), self.run_real(*args)
                self.assertEqual((a.returncode, a.stdout, a.stderr), (b.returncode, b.stdout, b.stderr))
        self.assertEqual(self.run_shim("stash", "list").returncode, 0)
        self.assertNotIn("scratch", self.run_shim("stash", "list").stderr)

    def test_other_stash_like_words_are_not_touched(self):
        for args in (("log", "--grep=stash"), ("commit", "--allow-empty", "-m", "stash push"), ("checkout", "-b", "stash"), ("branch", "stash-notes"), ("tag", "stash", "HEAD"),
                     ("log", "-S", "stash"), ("config", "alias.zz", "stash")):
            with self.subTest(args=args):
                done = self.run_shim(*args)
                self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual(self.stashed(), "")

    def test_s4_the_owners_terminal_with_no_shim_on_path_can_stash(self):
        (self.repo / "f").write_text("two\n")
        done = subprocess.run(["git", "stash", "push", "-q"], capture_output=True, text=True, env=dict(self.env, PATH=os.path.dirname(self.real)), cwd=self.repo, timeout=60)
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertIn("stash@{0}", self.stashed())
        done = self.run_shim("stash", "list", path=os.path.dirname(self.real))
        self.assertEqual(done.returncode, 0)

    def test_the_refusal_does_not_depend_on_the_credential_routing_switch_or_the_fleet_config(self):
        (self.repo / "f").write_text("two\n")
        for env in ({"FLEET_GIT_SHIM": "off"}, {"FLEET_REAL_GIT": self.real}):
            self.assertRefused(self.run_shim("stash", "push", env=env))
        self.assertEqual(self.stashed(), "")

    def test_a_guard_that_cannot_be_loaded_still_refuses_anything_that_mentions_stash_and_runs_the_rest(self):
        copy = self.home / "lonely"
        copy.mkdir()
        shutil.copy(GIT_SHIM, copy / "git")
        e = dict(self.env, PATH="%s:%s" % (copy, os.path.dirname(self.real)))
        stash = subprocess.run([sys.executable, str(copy / "git"), "stash", "push"], capture_output=True, text=True, env=e, cwd=self.repo, timeout=60)
        self.assertEqual(stash.returncode, 1)
        self.assertIn("scratch branch", stash.stderr)
        ok = subprocess.run([sys.executable, str(copy / "git"), "status", "-s"], capture_output=True, text=True, env=e, cwd=self.repo, timeout=60)
        self.assertEqual(ok.returncode, 0, ok.stderr)

    def test_a_check_that_itself_breaks_refuses_stash_words_and_never_blocks_other_commands(self):
        spec = importlib.util.spec_from_file_location("stash_guard_under_test", str(GIT_SHIM.parent / "stash_guard.py"))
        stash_guard = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(stash_guard)
        original = stash_guard.judge
        def boom(*a, **k):
            raise RuntimeError("bug")
        stash_guard.judge = boom
        try:
            self.assertIn("scratch", stash_guard.refusal(["stash", "pop"], self.real))
            self.assertIn("scratch", stash_guard.refusal(["-c", "alias.s=STASH", "s"], self.real))
            self.assertIsNone(stash_guard.refusal(["status"], self.real))
        finally:
            stash_guard.judge = original

    def test_s3_every_coder_and_orchestrator_definition_says_to_commit_to_a_scratch_branch_instead_of_stashing(self):
        for rel in ("agents/opencode/coder.md", "agents/copilot/coder.agent.md", "agents/opencode/orchestrator.md", "agents/copilot/orchestrator.agent.md"):
            with self.subTest(rel=rel):
                text = " ".join((REPO / rel).read_text().split())
                self.assertEqual(len(re.findall(r"never `git stash`", text, re.I)), 1)
                self.assertIn("scratch branch", text)
                self.assertRegex(text, re.compile(r"never `git stash`.{0,600}scratch branch", re.I))


def write_fake_env(home, environ):
    """The shim starts the switchboard with an ALLOW-LISTED environment, so a `FAKE_*` the test sets never reaches a fake switchboard: hand them over the way the
    account's own program would find them, in a file under TMPDIR (a name the shim does pass). The fake sources it when it is there."""
    lines = ["%s=%s; export %s" % (k, shlex.quote(v), k) for k, v in sorted(environ.items()) if k.startswith("FAKE_")]
    (home / "fake-sb.env").write_text("\n".join(lines) + "\n")
    environ["TMPDIR"] = str(home)


FAKE_SB_SOURCE = '[ -f "$TMPDIR/fake-sb.env" ] && . "$TMPDIR/fake-sb.env"\n'


class TestGhShimGateProbe(Base):
    """The shim asks `gates-check` before `pr ready` and `pr merge`: a refusal (exit 10, only in an enforcing repo) stops the command."""

    def setUp(self):
        super().setUp()
        self.bin = self.home / "realbin"
        self.bin.mkdir()
        self.log = self.home / "gh-log.json"
        fake = self.bin / "gh"
        fake.write_text("#!/usr/bin/env python3\nimport json,os,sys\n"
                        "if sys.argv[1:3] == ['repo', 'view']:\n    v = os.environ.get('FAKE_REPO')\n    print(v or ''); sys.exit(0 if v else 1)\n"
                        "if sys.argv[1:3] == ['pr', 'view'] and 'reviews,headRefOid,reviewDecision' in sys.argv:\n"
                        "    if os.environ.get('FAKE_REVIEWS_EXIT'): sys.exit(int(os.environ['FAKE_REVIEWS_EXIT']))\n"
                        "    print(os.environ.get('FAKE_REVIEWS') or '{\"reviews\": [], \"headRefOid\": \"' + 'a'*40 + '\"}'); sys.exit(0)\n"
                        "if sys.argv[1:3] == ['pr', 'view']:\n    v = os.environ.get('FAKE_PRURL')\n    print(v or ''); sys.exit(0 if v else 1)\n"
                        "json.dump({'argv': sys.argv[1:]}, open(%r,'w'))\n"
                        "print('real gh out'); sys.exit(7)\n" % str(self.log))
        fake.chmod(0o755)
        self.calls_log = self.home / "gates-calls.log"
        self.sb = self.home / "fakesb"
        self.sb.write_text("#!/bin/sh\n" + FAKE_SB_SOURCE +
                           "if [ \"$1\" = whoami ]; then\n  if [ \"$2\" = --json ]; then echo '{\"name\": \"worker\", \"repo\": \"acme/app\"}'; else echo worker; fi; exit 0; fi\n"
                           "if [ \"$1\" = review ] && [ \"$2\" = blockers ]; then\n  echo \"$@\" >> %r\n  [ -n \"$FAKE_BLOCKERS_EXIT\" ] && exit $FAKE_BLOCKERS_EXIT\n  [ -n \"$FAKE_BLOCKERS\" ] && echo \"$FAKE_BLOCKERS\"; exit 0; fi\n"
                           "if [ \"$1\" = gates-check ]; then\n  echo \"$@ own=$FLEET_SWITCHBOARD_OWN_GH\" >> %r\n"
                           "  [ -n \"$FAKE_GATE_SLEEP\" ] && sleep $FAKE_GATE_SLEEP\n  if [ -n \"$FAKE_GATE_JSON\" ]; then echo \"$FAKE_GATE_JSON\"; else echo '{\"verdict\": \"x\"}'; fi; exit ${FAKE_GATE_EXIT:-0}\nfi\nexit 2\n" % (str(self.calls_log) + ".review", str(self.calls_log)))
        self.sb.chmod(0o755)
        subprocess.run([str(self.sb), "whoami", "--json"], capture_output=True, timeout=60)   # the first start of a new file is the slow one
        self.state = self.home / "state"
        self.state.mkdir()
        self.write_gates({"acme/app": {"mode": "shadow"}})

    def write_gates(self, repos):
        config = self.home / ".config" / "fleet-switchboard" / "config.json"
        config.parent.mkdir(parents=True, exist_ok=True)
        config.write_text(json.dumps({"plan_gates": {"repos": repos}} if repos is not None else {}))

    def run_shim(self, *args, env=None, binary=True):
        environ = {"PATH": "%s:%s:%s" % (SHIM.parent, self.bin, SAFE_PATH), "HOME": str(self.home),
                   "FLEET_SWITCHBOARD_STATE": str(self.state), "FLEET_SHIM_LOOKUP_SECONDS": SHIM_LOOKUP_SECONDS,
                   "FLEET_SHIM_GATE_SECONDS": SHIM_LOOKUP_SECONDS}   # the gate question's bound too: the largest the shim allows
        if binary:
            environ["FLEET_SWITCHBOARD_BIN"] = str(self.sb)
        environ.update(env or {})
        write_fake_env(self.home, environ)
        if self.log.exists():
            self.log.unlink()
        started = time.time()
        done = subprocess.run([sys.executable, str(SHIM), *args], capture_output=True, text=True, env=environ, timeout=60)
        self.elapsed = time.time() - started
        seen = json.loads(self.log.read_text()) if self.log.exists() else None
        return done, seen

    def gate_calls(self):
        return self.calls_log.read_text().splitlines() if self.calls_log.exists() else []

    def spool(self):
        path = self.state / "gate-failopen.jsonl"
        return [json.loads(l) for l in path.read_text().splitlines()] if path.exists() else []

    def test_ready_and_merge_ask_gates_check_for_the_right_pr_and_the_real_gh_runs_unchanged(self):
        for args, kind in ((("pr", "ready", "12", "-R", "acme/app"), "ready"), (("pr", "merge", "12", "--repo", "acme/app", "--squash"), "merge"),
                           (("pr", "merge", "https://github.com/acme/app/pull/12", "--delete-branch"), "merge"),
                           (("pr", "ready", "12"), "ready")):   # a bare number: the repo is the caller's own (whoami)
            with self.subTest(args=args):
                if self.calls_log.exists():
                    self.calls_log.unlink()
                done, seen = self.run_shim(*args, env={"FAKE_REPO": "acme/app"})
                self.assertEqual((done.returncode, done.stdout.strip()), (7, "real gh out"), "the real gh's exit code and output pass through")
                self.assertEqual(seen["argv"], list(args))
                (call,) = self.gate_calls()
                self.assertEqual(call, "gates-check acme/app#12 --for %s --json own=1" % kind)

    def review(self, state, who="rev", at="2026-01-01T00:00:00Z"):
        return {"state": state, "author": {"login": who}, "submittedAt": at}

    def merge(self, *extra, reviews=(), env=None, args=("pr", "merge", "12", "-R", "acme/app", "--merge")):
        e = {"FAKE_REPO": "acme/app", "FAKE_REVIEWS": json.dumps({"reviews": list(reviews), "headRefOid": self.HEAD})}
        e.update(env or {})
        return self.run_shim(*args, *extra, env=e)

    def test_a_merge_over_a_changes_requested_review_is_refused_naming_the_reviewer_in_any_repo(self):
        done, seen = self.merge(reviews=[self.review("CHANGES_REQUESTED", "reviewer-a")])
        self.assertEqual(done.returncode, 10)
        self.assertIn("blocking review(s): reviewer-a: CHANGES_REQUESTED", done.stderr)
        self.assertIn("--over-review", done.stderr)
        self.assertIsNone(seen, "the real gh never ran")
        done, seen = self.merge("--admin", reviews=[self.review("CHANGES_REQUESTED", "reviewer-a")])
        self.assertEqual((done.returncode, seen), (10, None))                    # --admin changes nothing
        done, seen = self.merge(reviews=[self.review("CHANGES_REQUESTED", "reviewer-a")], env={"FAKE_REPO": "other/repo"},
                                args=("pr", "merge", "12", "-R", "other/repo", "--merge"))
        self.assertEqual(done.returncode, 10)                                    # a repo not listed under plan_gates is covered too

    OLD = "b" * 40

    def review_at(self, state, who, oid):
        return dict(self.review(state, who), commit={"oid": oid})

    def merge_decided(self, reviews, decision, *extra):
        e = {"FAKE_REPO": "acme/app", "FAKE_REVIEWS": json.dumps({"reviews": reviews, "headRefOid": self.HEAD, "reviewDecision": decision})}
        return self.run_shim("pr", "merge", "12", "-R", "acme/app", "--merge", *extra, env=e)

    def test_s1_a_changes_requested_review_at_the_current_head_blocks(self):
        done, seen = self.merge_decided([self.review_at("CHANGES_REQUESTED", "reviewer-a", self.HEAD)], "CHANGES_REQUESTED")
        self.assertEqual((done.returncode, seen), (10, None))
        self.assertIn("blocking review(s): reviewer-a: CHANGES_REQUESTED", done.stderr)

    def test_s2_an_old_head_changes_requested_review_blocks_while_github_says_changes_requested(self):
        done, seen = self.merge_decided([self.review_at("CHANGES_REQUESTED", "reviewer-a", self.OLD)], "CHANGES_REQUESTED")
        self.assertEqual((done.returncode, seen), (10, None))
        self.assertIn("reviewer-a: CHANGES_REQUESTED", done.stderr)

    def test_s3_a_newer_comment_by_the_same_reviewer_supersedes_an_old_head_changes_requested_review(self):
        reviews = [self.review_at("CHANGES_REQUESTED", "reviewer-a", self.OLD), self.review_at("COMMENTED", "reviewer-a", self.HEAD)]
        done, seen = self.merge_decided(reviews, "APPROVED")
        self.assertEqual((done.returncode, done.stdout.strip()), (7, "real gh out"), done.stderr)
        self.assertEqual([l for l in self.spool() if l["event"] == "over_review"], [], "no over-review line")

    def test_an_old_head_changes_requested_review_with_no_newer_review_does_not_block_unless_github_says_so(self):
        done, seen = self.merge_decided([self.review_at("CHANGES_REQUESTED", "reviewer-a", self.OLD)], "APPROVED")
        self.assertEqual(done.returncode, 7, done.stderr)

    def test_a_review_without_a_commit_blocks_and_a_comment_before_it_or_another_changes_request_does_not_clear_it(self):
        for reviews in ([self.review("CHANGES_REQUESTED", "reviewer-a")],
                        [self.review_at("COMMENTED", "reviewer-a", self.HEAD), self.review_at("CHANGES_REQUESTED", "reviewer-a", self.HEAD)],
                        [self.review_at("CHANGES_REQUESTED", "reviewer-a", self.OLD), self.review_at("COMMENTED", "reviewer-a", self.OLD),
                         self.review_at("CHANGES_REQUESTED", "reviewer-a", self.HEAD)]):
            with self.subTest(reviews=[r["state"] for r in reviews]):
                done, seen = self.merge_decided(reviews, None)
                self.assertEqual((done.returncode, seen), (10, None), done.stderr)

    def test_a_same_head_changes_requested_review_is_not_cleared_by_a_comment_from_the_same_shared_login(self):
        reviews = [self.review_at("CHANGES_REQUESTED", "reviewer-a", self.HEAD), self.review_at("COMMENTED", "reviewer-a", self.HEAD)]
        for decision in ("", None, "APPROVED"):
            with self.subTest(decision=decision):
                done, seen = self.merge_decided(reviews, decision)
                self.assertEqual((done.returncode, seen), (10, None), done.stderr)
        done, seen = self.merge_decided(reviews + [self.review_at("APPROVED", "reviewer-a", self.HEAD)], "APPROVED")   # an approval clears it
        self.assertEqual(done.returncode, 7, done.stderr)

    def test_s4_a_newer_comment_by_another_reviewer_does_not_supersede(self):
        reviews = [self.review_at("CHANGES_REQUESTED", "reviewer-a", self.HEAD), self.review_at("COMMENTED", "reviewer-b", self.HEAD)]
        done, seen = self.merge_decided(reviews, "")
        self.assertEqual((done.returncode, seen), (10, None))
        self.assertIn("reviewer-a: CHANGES_REQUESTED", done.stderr)
        self.assertNotIn("reviewer-b", done.stderr)

    def test_s5_an_unreadable_reviews_read_fails_open_with_one_warning_and_the_override_is_still_logged(self):
        done, seen = self.merge(env={"FAKE_REVIEWS_EXIT": "1"})
        self.assertEqual(done.returncode, 7)
        self.assertEqual(done.stderr.count("review check skipped"), 1, done.stderr)

    def test_s7_the_over_review_reason_rule_holds_with_the_head_rule(self):
        block = [self.review_at("CHANGES_REQUESTED", "reviewer-a", self.HEAD)]
        done, seen = self.merge("--over-review", "abcdefghi", reviews=block)
        self.assertEqual((done.returncode, seen), (10, None))
        done, seen = self.merge("--over-review", "abcdefghij", reviews=block)
        self.assertEqual(done.returncode, 7, done.stderr)
        self.assertEqual(len([l for l in self.spool() if l["event"] == "over_review"]), 1)

    def test_a_dismissed_or_superseded_review_and_plain_comments_do_not_block(self):
        for reviews in ([self.review("CHANGES_REQUESTED", "rev"), self.review("DISMISSED", "rev")],
                        [self.review("CHANGES_REQUESTED", "rev"), self.review("APPROVED", "rev")],
                        [self.review("CHANGES_REQUESTED", "rev"), self.review("COMMENTED", "other"), self.review("APPROVED", "rev")],
                        [self.review("APPROVED", "rev"), self.review("COMMENTED", "rev")]):
            with self.subTest(reviews=[r["state"] for r in reviews]):
                done, seen = self.merge(reviews=reviews)
                self.assertEqual((done.returncode, done.stdout.strip()), (7, "real gh out"), done.stderr)
        done, seen = self.merge(reviews=[self.review("APPROVED", "a"), self.review("CHANGES_REQUESTED", "b")])   # one reviewer's block is enough
        self.assertEqual(done.returncode, 10)

    def test_a_recorded_blocking_verdict_at_the_current_head_blocks_and_is_named(self):
        done, seen = self.merge(env={"FAKE_BLOCKERS": "security recorded request-changes (2 blocking finding(s)) at aaaaaaaa"})
        self.assertEqual(done.returncode, 10)
        self.assertIn("security recorded request-changes", done.stderr)
        asked = (self.calls_log.parent / (self.calls_log.name + ".review")).read_text().split()
        self.assertEqual(asked, ["review", "blockers", "acme/app#12", "--head", self.HEAD])      # the shim binds the question to the head it read

    def test_over_review_with_a_reason_goes_ahead_is_stripped_and_logged_and_without_one_it_is_refused(self):
        block = [self.review("CHANGES_REQUESTED", "reviewer-a")]
        done, seen = self.merge("--over-review", "the owner accepted the risk in chat", reviews=block)
        self.assertEqual((done.returncode, done.stdout.strip()), (7, "real gh out"), done.stderr)
        self.assertNotIn("--over-review", " ".join(seen["argv"]))
        self.assertNotIn("the owner accepted", " ".join(seen["argv"]))
        self.assertIn("on purpose", done.stderr)
        (line,) = [l for l in self.spool() if l["event"] == "over_review"]
        self.assertIn("worker", line["detail"])
        self.assertIn("the owner accepted the risk in chat", line["detail"])
        self.assertIn("reviewer-a: CHANGES_REQUESTED", line["detail"])
        self.assertEqual(line["pr"], "acme/app#12")
        done, seen = self.merge("--over-review=a reason of enough length", reviews=block)           # the = spelling
        self.assertEqual(done.returncode, 7)
        for extra in (("--over-review", "short"), ("--over-review",)):
            done, seen = self.merge(*extra, reviews=block)
            self.assertEqual((done.returncode, seen), (10, None))
            self.assertIn("at least 10 characters", done.stderr)
        done, seen = self.merge("--over-review", "a reason that nobody needs", reviews=[])           # nothing to override: just stripped
        self.assertEqual((done.returncode, "--over-review" in " ".join(seen["argv"])), (7, False))

    def test_a_reviews_api_or_switchboard_failure_lets_the_merge_through_with_a_visible_warning(self):
        done, seen = self.merge(env={"FAKE_REVIEWS_EXIT": "1"})
        self.assertEqual((done.returncode, done.stdout.strip()), (7, "real gh out"))
        self.assertIn("could not be read): not checked", done.stderr)
        done, seen = self.merge(env={"FAKE_BLOCKERS_EXIT": "1"})
        self.assertEqual(done.returncode, 7)
        self.assertIn("recorded verdicts could not be read", done.stderr)
        done, seen = self.merge(env={"FAKE_REVIEWS": "not json"})
        self.assertEqual(done.returncode, 7)
        self.assertIn("not checked", done.stderr)

    def tagged(self, first, who="shared", tag="rev", at="2026-01-01T00:00:00Z", state="COMMENTED"):
        body = "%s\n\nfindings...\n\n<!-- fleet-switchboard:from=%s -->" % (first, tag)
        return {"state": state, "author": {"login": who}, "submittedAt": at, "body": body}

    def test_a_commented_review_whose_first_line_says_changes_requested_at_the_current_head_blocks_and_a_later_approve_clears_it(self):
        cr = self.tagged("Review of %s: CHANGES REQUESTED" % self.HEAD)
        done, seen = self.merge(reviews=[cr])
        self.assertEqual((done.returncode, seen), (10, None))
        self.assertIn("shared/rev: CHANGES REQUESTED (Review of %s)" % self.HEAD[:8], done.stderr)
        for spelling in ("Review of %s: CHANGES REQUESTED" % self.HEAD[:7], "review of %s - changes requested" % self.HEAD, "Review of %s: REQUEST CHANGES" % self.HEAD):
            done, seen = self.merge(reviews=[self.tagged(spelling)])                  # a short sha prefix and the other spellings count
            self.assertEqual(done.returncode, 10, spelling)
        done, seen = self.merge(reviews=[cr, self.tagged("Review of %s: APPROVE" % self.HEAD)])
        self.assertEqual((done.returncode, done.stdout.strip()), (7, "real gh out"), done.stderr)
        done, seen = self.merge(reviews=[cr, self.tagged("Review of %s: APPROVED" % self.HEAD, tag="other")])   # another reviewer's approve does not clear this one
        self.assertEqual(done.returncode, 10)
        done, seen = self.merge(reviews=[self.tagged("Review of %s: APPROVE" % self.HEAD), cr])                 # the latest one decides
        self.assertEqual(done.returncode, 10)

    def test_a_changes_requested_tag_at_an_old_head_and_untagged_comments_never_block(self):
        old = "b" * 40
        for reviews in ([self.tagged("Review of %s: CHANGES REQUESTED" % old)],
                        [{"state": "COMMENTED", "author": {"login": "shared"}, "body": "CHANGES REQUESTED, please fix this"}],
                        [{"state": "COMMENTED", "author": {"login": "shared"}, "body": "Looks fine.\nReview of %s: CHANGES REQUESTED" % self.HEAD}],   # not the FIRST line
                        [{"state": "COMMENTED", "author": {"login": "shared"}, "body": None}],
                        [self.tagged("Review of nothex: CHANGES REQUESTED")]):
            with self.subTest(body=str(reviews[0].get("body"))[:40]):
                done, seen = self.merge(reviews=reviews)
                self.assertEqual((done.returncode, done.stdout.strip()), (7, "real gh out"), done.stderr)
        done, seen = self.merge("--over-review", "the owner reviewed this head in person", reviews=[self.tagged("Review of %s: CHANGES REQUESTED" % self.HEAD)])
        self.assertEqual(done.returncode, 7)                                    # the explicit override still works

    def test_an_override_whose_log_cannot_be_written_is_refused_and_a_pr_number_after_the_flag_is_not_its_reason(self):
        block = [self.review("CHANGES_REQUESTED", "reviewer-a")]
        done, seen = self.merge("--over-review", "a fine long reason here", reviews=block, env={"FLEET_SWITCHBOARD_STATE": str(self.home / "no-such-state")})
        self.assertEqual((done.returncode, seen), (10, None))
        self.assertIn("could not be logged", done.stderr)
        done, seen = self.merge(reviews=block, args=("pr", "merge", "--over-review", "12", "-R", "acme/app", "--merge"))   # `12` is the PR
        self.assertEqual(done.returncode, 10)
        self.assertIn("at least 10 characters", done.stderr)
        done, seen = self.merge("--over-review", "x" * 300, reviews=block)       # a long reason: the head and the overridden review still fit the line
        self.assertEqual(done.returncode, 7)
        line = [l for l in self.spool() if l["event"] == "over_review"][-1]["detail"]
        self.assertIn(self.HEAD[:12], line)
        self.assertIn("reviewer-a: CHANGES_REQUESTED", line)
        done, seen = self.merge("--over-review", "a reason\x1b[31m with escapes", reviews=block)
        logged = [l for l in self.spool() if l["event"] == "over_review"][-1]["detail"]
        self.assertNotIn("\x1b", logged)
        self.assertIn("with escapes", logged)

    def test_only_merge_is_checked_and_the_daemons_own_calls_are_not(self):
        block = [self.review("CHANGES_REQUESTED", "reviewer-a")]
        done, seen = self.merge(reviews=block, args=("pr", "ready", "12", "-R", "acme/app"))
        self.assertEqual(done.returncode, 7)
        done, seen = self.merge(reviews=block, env={"FLEET_SWITCHBOARD_OWN_GH": "1"})
        self.assertEqual(done.returncode, 7)

    HEAD = "a" * 40
    REFUSAL = ("fleet-switchboard: merge of acme/app#12 refused: missing G1: no passing CI record at this head. Way out: ask the chief of "
               "staff for a logged waiver (`fleet-switchboard waive acme/app#12 --gates G1 --reason ...`; never for G6 or G8), or the chief "
               "of staff can switch the repo to shadow (`fleet-switchboard gates mode acme/app shadow`).")

    def test_an_enforcing_refusal_stops_the_command_and_prints_the_reason(self):
        self.write_gates({"acme/app": {"mode": "enforce"}})
        for args in (("pr", "merge", "12", "-R", "acme/app"), ("pr", "ready", "12", "-R", "acme/app")):
            with self.subTest(args=args):
                done, seen = self.run_shim(*args, env={"FAKE_GATE_EXIT": "10", "FAKE_GATE_JSON": json.dumps({"verdict": "refuse", "mode": "enforce", "message": self.REFUSAL})})
                self.assertEqual(done.returncode, 10)
                self.assertIsNone(seen, "the real gh did not run")
                self.assertEqual(done.stdout, "")
                self.assertEqual(done.stderr.strip(), self.REFUSAL)
                self.assertEqual(self.spool()[-1]["event"], "refused")

    def test_a_refusal_with_no_message_still_stops(self):
        done, seen = self.run_shim("pr", "merge", "12", "-R", "acme/app", env={"FAKE_GATE_EXIT": "10", "FAKE_GATE_JSON": json.dumps({"mode": "enforce"})})
        self.assertEqual((done.returncode, seen), (10, None))
        self.assertIn("refused", done.stderr)

    def test_everything_else_runs_the_real_gh(self):
        for code in ("3", "1", "127", "0"):   # fail-open, crash, missing, allow (a valid waiver, a shadow repo, a kill switch all answer 0)
            with self.subTest(code=code):
                done, seen = self.run_shim("pr", "merge", "12", "-R", "acme/app", env={"FAKE_GATE_EXIT": code})
                self.assertEqual((done.returncode, seen["argv"]), (7, ["pr", "merge", "12", "-R", "acme/app"]))
        done, seen = self.run_shim("pr", "merge", "12", "-R", "acme/app", env={"FAKE_GATE_EXIT": "0", "FAKE_GATE_JSON": "not json"})
        self.assertEqual(seen["argv"], ["pr", "merge", "12", "-R", "acme/app"])

    def test_an_enforcing_merge_is_bound_to_the_checked_head(self):
        self.write_gates({"acme/app": {"mode": "enforce"}})
        ok = {"FAKE_GATE_JSON": json.dumps({"verdict": "allow", "mode": "enforce", "head": self.HEAD})}
        done, seen = self.run_shim("pr", "merge", "12", "-R", "acme/app", "--squash", env=ok)
        self.assertEqual(seen["argv"], ["pr", "merge", "12", "-R", "acme/app", "--squash", "--match-head-commit", self.HEAD])
        done, seen = self.run_shim("pr", "merge", "12", "-R", "acme/app", "--match-head-commit", self.HEAD, env=ok)
        self.assertEqual(seen["argv"], ["pr", "merge", "12", "-R", "acme/app", "--match-head-commit", self.HEAD], "the caller's own binding stands")
        done, seen = self.run_shim("pr", "merge", "12", "-R", "acme/app", "--match-head-commit=" + "b" * 40, env=ok)
        self.assertEqual((done.returncode, seen), (10, None), "a binding to another head is refused")
        self.assertIn("not the head the gates were checked at", done.stderr)
        done, seen = self.run_shim("pr", "ready", "12", "-R", "acme/app", env=ok)
        self.assertEqual(seen["argv"], ["pr", "ready", "12", "-R", "acme/app"], "ready is not bound")
        done, seen = self.run_shim("pr", "merge", "12", "-R", "acme/app", env={"FAKE_GATE_JSON": json.dumps({"mode": "enforce"})})
        self.assertEqual(seen["argv"], ["pr", "merge", "12", "-R", "acme/app"], "no head known: fail-open, recorded")
        self.assertEqual(self.spool()[-1]["event"], "fail_open")

    def test_auto_merge_is_refused_only_when_enforcing(self):
        enforcing = {"FAKE_GATE_JSON": json.dumps({"verdict": "allow", "mode": "enforce", "head": self.HEAD})}
        done, seen = self.run_shim("pr", "merge", "12", "-R", "acme/app", "--auto", env=enforcing)
        self.assertEqual((done.returncode, seen), (10, None))
        self.assertIn("--auto", done.stderr)
        done, seen = self.run_shim("pr", "merge", "12", "-R", "acme/app", "--auto",
                                   env={"FAKE_GATE_JSON": json.dumps({"verdict": "allow", "mode": "shadow", "head": self.HEAD})})
        self.assertEqual(seen["argv"], ["pr", "merge", "12", "-R", "acme/app", "--auto"], "shadow never refuses and never rewrites")

    ENFORCE = {"FAKE_GATE_JSON": json.dumps({"verdict": "allow", "mode": "enforce", "head": "a" * 40})}

    def test_the_head_binding_cannot_be_dodged_by_how_the_flag_is_spelled(self):
        head = "a" * 40
        for extra, want in ((["--match-head-commit", ""], []), (["--match-head-commit="], []), (["--match-head-commit"], []),
                            (["--match-head-commit", head.upper()], []), (["--match-head-commit=" + head, "--match-head-commit", ""], []),
                            (["--match-head-commit", "", "--match-head-commit", head], [])):
            with self.subTest(extra=extra):
                done, seen = self.run_shim("pr", "merge", "12", "-R", "acme/app", *extra, env=self.ENFORCE)
                self.assertEqual(done.returncode, 7)
                self.assertEqual(seen["argv"], ["pr", "merge", "12", "-R", "acme/app", "--match-head-commit", head])
        done, seen = self.run_shim("pr", "merge", "12", "-R", "acme/app", "--match-head-commit", "a", env=self.ENFORCE)
        self.assertEqual((done.returncode, seen), (10, None), "a prefix is not the head")
        done, seen = self.run_shim("pr", "merge", "12", "-R", "acme/app", "--match-head-commit", "b" * 40, "--match-head-commit=" + head, env=self.ENFORCE)
        self.assertEqual((done.returncode, seen), (10, None), "every given value must be the checked head")

    def test_a_bare_pr_number_uses_the_repo_the_real_gh_would(self):
        self.write_gates({"acme/app": {"mode": "enforce"}})
        done, seen = self.run_shim("pr", "merge", "5", env=dict(self.ENFORCE, FAKE_REPO="other/place"))
        self.assertEqual(self.gate_calls(), [], "the directory's repo is not listed: not asked, not rewritten")
        self.assertEqual(seen["argv"], ["pr", "merge", "5"])
        done, seen = self.run_shim("pr", "merge", "5", env=dict(self.ENFORCE, FAKE_REPO="acme/app"))
        self.assertEqual(self.gate_calls()[-1], "gates-check acme/app#5 --for merge --json own=1")
        self.assertEqual(seen["argv"][-2:], ["--match-head-commit", "a" * 40])
        done, seen = self.run_shim("pr", "merge", "5", env=dict(self.ENFORCE, GH_REPO="acme/app"))
        self.assertEqual(self.gate_calls()[-1], "gates-check acme/app#5 --for merge --json own=1", "GH_REPO is honoured")
        self.calls_log.unlink()
        done, seen = self.run_shim("pr", "merge", "5", env=self.ENFORCE)   # the real gh cannot say which repo: never guess the fleet repo
        self.assertEqual((done.returncode, self.gate_calls()), (7, []))
        self.assertIn("could not resolve the repo", self.spool()[-1]["detail"])

    def test_ordinary_spellings_are_understood(self):
        head = "a" * 40
        for args in (("pr", "merge", "-sd", "5", "-R", "acme/app"), ("pr", "merge", "5", "-R", "acme/app", "-sd"),
                     ("pr", "merge", "5", "--squash=true", "-R", "acme/app"), ("pr", "merge", "5", "-Racme/app"),
                     ("pr", "merge", "5", "--repo=acme/app", "--delete-branch=false"),
                     ("pr", "merge", "https://github.com/acme/app/pull/5/files")):
            with self.subTest(args=args):
                done, seen = self.run_shim(*args, env=self.ENFORCE)
                self.assertEqual(self.gate_calls()[-1], "gates-check acme/app#5 --for merge --json own=1")
                self.assertEqual(seen["argv"], list(args) + ["--match-head-commit", head])
        for args in (("pr", "merge", "5", "-R", "acme/app", "--auto=true"), ("pr", "merge", "5", "-R", "acme/app", "-sd", "--auto")):
            with self.subTest(args=args):
                done, seen = self.run_shim(*args, env=self.ENFORCE)
                self.assertEqual((done.returncode, seen), (10, None))
        done, seen = self.run_shim("pr", "merge", "5", "-R", "acme/app", "--auto=false", env=self.ENFORCE)
        self.assertEqual(seen["argv"][-2:], ["--match-head-commit", head], "--auto=false is not auto")

    def test_no_argument_and_a_branch_name_are_resolved_by_the_real_gh_or_recorded(self):
        for args in (("pr", "merge"), ("pr", "merge", "my-branch", "-R", "acme/app"), ("pr", "ready")):
            with self.subTest(args=args):
                done, seen = self.run_shim(*args, env=dict(self.ENFORCE, FAKE_PRURL="https://github.com/acme/app/pull/8"))
                self.assertEqual(self.gate_calls()[-1].split()[1], "acme/app#8")
                self.assertEqual(seen["argv"][:len(args)], list(args))
        self.calls_log.unlink()
        done, seen = self.run_shim("pr", "merge", env=self.ENFORCE)
        self.assertEqual((done.returncode, self.gate_calls()), (7, []))
        self.assertIn("could not resolve the PR", self.spool()[-1]["detail"])
        done, seen = self.run_shim("pr", "ready", "12", "--undo", "-R", "acme/app", env=self.ENFORCE)
        self.assertIn("shape not understood", self.spool()[-1]["detail"])

    def test_a_refusal_is_printed_without_control_characters_and_only_for_an_enforce_reply(self):
        reply = json.dumps({"mode": "enforce", "message": "bad \x1b]0;title\x07 \x1b[2Jtext"})
        done, seen = self.run_shim("pr", "merge", "12", "-R", "acme/app", env={"FAKE_GATE_EXIT": "10", "FAKE_GATE_JSON": reply})
        self.assertEqual((done.returncode, done.stderr), (10, "bad ]0;title [2Jtext\n"))
        done, seen = self.run_shim("pr", "merge", "12", "-R", "acme/app",
                                   env={"FAKE_GATE_EXIT": "10", "FAKE_GATE_JSON": json.dumps({"mode": "shadow", "message": "x"})})
        self.assertEqual(seen["argv"], ["pr", "merge", "12", "-R", "acme/app"], "exit 10 from a shadow reply does not refuse")

    def test_a_check_that_hangs_costs_at_most_the_bound_and_the_command_still_runs(self):
        done, seen = self.run_shim("pr", "ready", "12", "-R", "acme/app", env={"FAKE_GATE_SLEEP": "30", "FLEET_SHIM_GATE_SECONDS": "1"})
        self.assertEqual(seen["argv"], ["pr", "ready", "12", "-R", "acme/app"])
        self.assertLess(self.elapsed, 6)
        (entry,) = self.spool()
        self.assertEqual(entry["event"], "fail_open")
        self.assertIn("no answer within 1s", entry["detail"])

    def test_the_bound_is_clamped_and_defaults_to_three_seconds(self):
        source = SHIM.read_text()
        self.assertIn("GATE_SECONDS = 3.0", source)
        done, seen = self.run_shim("pr", "ready", "12", "-R", "acme/app", env={"FAKE_GATE_SLEEP": "30", "FLEET_SHIM_GATE_SECONDS": "0.01"})
        self.assertLess(self.elapsed, 25, "a bound below 0.2 s is raised to 0.2 s, not 0")

    def test_with_no_switchboard_the_command_runs_and_the_gap_is_recorded(self):
        done, seen = self.run_shim("pr", "merge", "12", "-R", "acme/app", binary=False, env={"HOME": str(self.home / "nohome")})
        self.assertEqual(seen["argv"], ["pr", "merge", "12", "-R", "acme/app"])

    def test_shapes_it_does_not_understand_pass_through_and_are_not_probed(self):
        for args in (("pr", "merge"), ("pr", "merge", "my-branch", "-R", "acme/app"), ("pr", "ready", "12", "--undo", "-R", "acme/app"),
                     ("pr", "merge", "12", "13", "-R", "acme/app"), ("pr", "merge", "12", "--mystery", "-R", "acme/app"),
                     ("pr", "merge", "12", "-R", "not a repo"), ("pr", "merge", "--", "12"), ("pr", "ready", "0", "-R", "acme/app"),
                     ("pr", "create", "--title", "t", "--body", "b"), ("pr", "view", "12", "-R", "acme/app"),
                     ("pr", "merge", "https://example.com/acme/app/pull/12")):
            with self.subTest(args=args):
                done, seen = self.run_shim(*args)
                if args[1] != "view":
                    self.assertEqual(seen["argv"][:2], list(args)[:2])
                self.assertEqual(self.gate_calls(), [])

    def test_a_repo_not_listed_is_not_probed_and_the_match_ignores_case(self):
        self.run_shim("pr", "merge", "12", "-R", "acme/other")
        self.assertEqual(self.gate_calls(), [])
        self.write_gates({"Acme/App": {"mode": "shadow"}})
        self.run_shim("pr", "merge", "12", "-R", "ACME/app")
        self.assertEqual(len(self.gate_calls()), 1)
        self.write_gates({})
        self.calls_log.unlink()
        self.run_shim("pr", "merge", "12", "-R", "acme/app")
        self.assertEqual(self.gate_calls(), [], "no plan_gates in the config: nothing is probed")
        self.write_gates(None)
        self.run_shim("pr", "merge", "12", "-R", "acme/app")
        self.assertEqual(self.gate_calls(), [])

    def test_a_fork_pr_url_is_asked_about_under_its_own_repo(self):
        self.write_gates({"acme/app": {"mode": "shadow"}})
        self.run_shim("pr", "merge", "https://github.com/someone/app/pull/9")
        self.assertEqual(self.gate_calls(), [], "a fork's PR is another repo: not listed, not probed")

    def test_the_switchboards_own_gh_calls_are_not_probed(self):
        done, seen = self.run_shim("pr", "merge", "12", "-R", "acme/app", env={"FLEET_SWITCHBOARD_OWN_GH": "1"})
        self.assertEqual(seen["argv"], ["pr", "merge", "12", "-R", "acme/app"])
        self.assertEqual(self.gate_calls(), [])

    def test_the_spool_is_private_clipped_and_bounded(self):
        self.run_shim("pr", "merge", "12", "-R", "acme/app", env={"FAKE_GATE_EXIT": "3"})
        path = self.state / "gate-failopen.jsonl"
        self.assertEqual(stat.S_IMODE(os.stat(str(path)).st_mode), 0o600)
        path.write_text("x" * 300000)
        self.run_shim("pr", "merge", "12", "-R", "acme/app", env={"FAKE_GATE_EXIT": "3"})
        self.assertEqual(len(path.read_text()), 300000, "a full spool takes no more lines")
        path.unlink()
        self.state.rmdir()
        self.run_shim("pr", "merge", "12", "-R", "acme/app", env={"FAKE_GATE_EXIT": "3"})   # no state dir: nothing written, nothing fails

    def test_signing_and_the_account_environment_are_untouched(self):
        done, seen = self.run_shim("pr", "comment", "3", "--body", "hello")
        self.assertIn("fleet-switchboard:from=worker", seen["argv"][-1])
        self.assertEqual(self.gate_calls(), [])


class TestGhShim(Base):
    """The agent types plain `gh issue comment ...`; the shim signs it. A fake gh records what it was given."""

    def setUp(self):
        super().setUp()
        self.bin = self.home / "realbin"
        self.bin.mkdir()
        self.log = self.home / "gh-log.json"
        fake = self.bin / "gh"
        fake.write_text("#!/usr/bin/env python3\nimport json,os,sys\n"
                        "files={a: open(a).read() for a in sys.argv[1:] if os.path.isfile(a)}\n"
                        "json.dump({'argv': sys.argv[1:], 'stdin': None if sys.stdin.isatty() else sys.stdin.read(), 'files': files}, "
                        "open(%r,'w'))\nprint('real gh out'); sys.stderr.write('real gh err\\n'); sys.exit(int(os.environ.get('FAKE_GH_EXIT','0')))\n"
                        % str(self.log))
        fake.chmod(0o755)
        self.who = self.home / "whoami"
        # One process start answers: `whoami --json` gets the JSON a current switchboard gives; only FAKE_WHO_OLD=1 makes it an old
        # one (plain text, so the shim asks again with a second start: the fallback, and only its test wants that).
        self.who.write_text("#!/bin/sh\n" + FAKE_SB_SOURCE + "[ -n \"$FAKE_WHO_SLEEP\" ] && sleep \"$FAKE_WHO_SLEEP\"\n[ \"$1\" = whoami ] || exit 2\n"
                            "[ \"$FAKE_WHO_EXIT\" ] && exit $FAKE_WHO_EXIT\n"
                            "if [ \"$2\" = --json ] && [ -z \"$FAKE_WHO_OLD\" ]; then echo \"{\\\"name\\\": \\\"${FAKE_WHO:-platform}\\\"}\"; exit 0; fi\n"
                            "echo \"${FAKE_WHO:-platform}\"\n")
        self.who.chmod(0o755)
        # The first start of a new file is the slow one on some machines (a scan of it): pay for it here, not inside the shim's deadline.
        subprocess.run([str(self.who), "whoami", "--json"], capture_output=True, timeout=60)

    def run_shim(self, *args, stdin="", env=None, who=True):
        environ = {"PATH": "%s:%s:%s" % (SHIM.parent, self.bin, SAFE_PATH), "HOME": str(self.home), "FLEET_SHIM_LOOKUP_SECONDS": SHIM_LOOKUP_SECONDS}
        if who:
            environ["FLEET_SWITCHBOARD_BIN"] = str(self.who)
        environ.update(env or {})
        write_fake_env(self.home, environ)
        if self.log.exists():
            self.log.unlink()
        done = subprocess.run([sys.executable, str(SHIM)] + list(args), input=stdin, capture_output=True, text=True,
                              env=environ, timeout=60)
        seen = json.loads(self.log.read_text()) if self.log.exists() else None
        return done, seen

    def link_switchboard(self, target=None, dangling=False):
        link = self.home / ".local" / "bin"
        link.mkdir(parents=True, exist_ok=True)
        (link / "fleet-switchboard").symlink_to(self.home / "gone" if dangling else (target or self.who))

    # --- #767: a body file directly in a shared temp directory is warned about, never refused
    def shim_warnings(self, *args, env=None):
        done, seen = self.run_shim(*args, env=env)
        return done, seen, [l for l in done.stderr.splitlines() if "shared temp directory" in l]

    def test_s3_a_body_file_in_a_shared_temp_directory_warns_once_and_runs_unchanged(self):
        root = self.home / "profile-tmp"
        env = {"FLEET_AGENT_TMPDIR": str(root / "coder")}
        for flag, path in (("--body-file", "/tmp/x.md"), ("-F", "/private/tmp/y.md"), ("--body-file", str(root / "z.md"))):
            with self.subTest(path=path):
                done, seen, lines = self.shim_warnings("issue", "comment", "2", flag, path, env=env)
                self.assertEqual((done.returncode, len(lines)), (0, 1))
                self.assertIn("$TMPDIR", lines[0])
                self.assertEqual(seen["argv"][:3], ["issue", "comment", "2"])
        done, seen, lines = self.shim_warnings("pr", "create", "--body-file=/tmp/a.md", env=env)
        self.assertEqual(len(lines), 1)
        done, seen, lines = self.shim_warnings("pr", "create", "-F/tmp/a.md", env=env)
        self.assertEqual(len(lines), 1)
        done, seen, lines = self.shim_warnings("issue", "comment", "2", "--body-file", "/tmp/../tmp/q.md", env=env)
        self.assertEqual(len(lines), 1)
        done, seen, lines = self.shim_warnings("issue", "comment", "2", "--body-file", "/tmp/sub/../x.md", env=env)
        self.assertEqual(len(lines), 1)   # folded lexically to /tmp/x.md

    def test_s4_an_own_directory_a_mktemp_subdirectory_and_a_relative_path_give_no_warning(self):
        root = self.home / "profile-tmp"
        env = {"FLEET_AGENT_TMPDIR": str(root / "coder")}
        for path in (str(root / "coder" / "x.md"), "/tmp/tmp.AbC123/x.md", "body.md", "./body.md", "/tmp/sub/../tmp.d/x.md"):
            with self.subTest(path=path):
                done, seen, lines = self.shim_warnings("issue", "comment", "2", "--body-file", path, env=env)
                self.assertEqual((done.returncode, lines), (0, []))

    def test_s5_the_path_is_never_opened_stat_ed_or_read(self):
        spec = importlib.util.spec_from_loader("gh_shim_767", importlib.machinery.SourceFileLoader("gh_shim_767", str(SHIM)))
        shim = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(shim)
        fifo = self.home / "pipe"
        os.mkfifo(str(fifo))
        locked = self.home / "locked.md"
        locked.write_text("x")
        locked.chmod(0)
        paths = ["/tmp/%s" % fifo.name, "/tmp/missing-767.md", "/tmp/%s" % locked.name]
        calls = []

        def boom(*a, **k):
            calls.append(a)
            raise AssertionError("touched the filesystem")
        with mock.patch.multiple(os, stat=boom, lstat=boom, open=boom, listdir=boom, access=boom), \
                mock.patch.multiple(os.path, exists=boom, isfile=boom, isdir=boom, islink=boom, realpath=boom), \
                mock.patch("builtins.open", boom):
            for path in paths:
                self.assertEqual(shim.shared_body_file(["issue", "comment", "2", "--body-file", path], {}), path)
        self.assertEqual(calls, [])
        done, seen, lines = self.shim_warnings("issue", "comment", "2", "--body-file", paths[1])
        self.assertEqual((done.returncode, len(lines)), (0, 1))

    def test_the_warning_shows_no_control_characters(self):
        done, seen, lines = self.shim_warnings("issue", "comment", "2", "--body-file", "/tmp/a\x1b[31m\rb.md")
        self.assertEqual(len(lines), 1)
        self.assertNotIn("\x1b", done.stderr.split("real gh")[0])
        self.assertNotIn("\r", done.stderr)

    def test_the_unchanged_exit_code_and_gh_api_fields(self):
        done, seen, lines = self.shim_warnings("issue", "comment", "2", "--body-file", "/tmp/x.md", env={"FAKE_GH_EXIT": "3"})
        self.assertEqual((done.returncode, len(lines)), (3, 1))
        done, seen, lines = self.shim_warnings("api", "x", "-F", "/tmp/x.md")
        self.assertEqual(lines, [])

    def test_unset_env_falls_back_to_the_linked_switchboard(self):
        self.link_switchboard()
        done, seen = self.run_shim("issue", "comment", "2", "--body", "hi", who=False)
        self.assertIn("from=platform", seen["argv"][-1])

    def test_the_env_var_wins_over_the_link(self):
        self.link_switchboard()
        other = self.home / "other-who"
        other.write_text("#!/bin/sh\necho elsewhere\n")
        other.chmod(0o755)
        done, seen = self.run_shim("issue", "comment", "2", "--body", "hi", env={"FLEET_SWITCHBOARD_BIN": str(other)})
        self.assertIn("from=elsewhere", seen["argv"][-1])

    def test_a_relative_env_var_is_agent_not_the_link(self):
        self.link_switchboard()
        done, seen = self.run_shim("issue", "comment", "2", "--body", "hi", env={"FLEET_SWITCHBOARD_BIN": "rel/x"})
        self.assertIn("from=agent", seen["argv"][-1])

    def test_no_link_or_a_dangling_one_or_a_non_executable_is_agent(self):
        done, seen = self.run_shim("issue", "comment", "2", "--body", "hi", who=False)
        self.assertIn("from=agent", seen["argv"][-1])
        self.link_switchboard(dangling=True)
        done, seen = self.run_shim("issue", "comment", "2", "--body", "hi", who=False)
        self.assertIn("from=agent", seen["argv"][-1])
        (self.home / ".local" / "bin" / "fleet-switchboard").unlink()
        plain = self.home / "plain"
        plain.write_text("x")
        self.link_switchboard(plain)
        done, seen = self.run_shim("issue", "comment", "2", "--body", "hi", who=False)
        self.assertIn("from=agent", seen["argv"][-1])

    def test_a_failing_or_odd_whoami_through_the_link_is_agent(self):
        self.link_switchboard()
        for env in ({"FAKE_WHO_EXIT": "1"}, {"FAKE_WHO": "bad name!"}):
            done, seen = self.run_shim("issue", "comment", "2", "--body", "hi", who=False, env=env)
            self.assertIn("from=agent", seen["argv"][-1])

    MARK = "<!-- fleet-switchboard:from=platform -->"

    def test_a_slow_identity_lookup_is_the_whole_of_the_old_flakiness(self):
        """The signing tests failed on a busy machine ('from=agent' for 'from=platform'): the shim's 3 s lookup deadline ran out because the lookup (two process
        starts) was slow, not because the real switchboard was reached (the run's environment is scrubbed and its binary is the fake). Shown on purpose: with a
        deadline shorter than the lookup the name is `agent`; with the deadline the tests now use it is the name."""
        slow = {"FAKE_WHO_SLEEP": "1.5"}   # the old-style fake: two starts
        done, seen = self.run_shim("issue", "comment", "2", "--body", "hi", env=dict(slow, FLEET_SHIM_LOOKUP_SECONDS="0.2"))
        self.assertIn("from=agent", seen["argv"][-1], "a lookup slower than its deadline falls back to agent")
        done, seen = self.run_shim("issue", "comment", "2", "--body", "hi", env=slow)
        self.assertIn("from=platform", seen["argv"][-1], "the same slow lookup within the tests' deadline is the name")

    def test_each_way_of_giving_a_body_is_signed(self):
        signed = "hello\n\n" + self.MARK + "\n"
        for args, expected in (
                (("issue", "comment", "2", "--body", "hello"), ["issue", "comment", "2", "--body", signed]),
                (("issue", "comment", "2", "-b", "hello"), ["issue", "comment", "2", "-b", signed]),
                (("pr", "comment", "7", "--body", "hello", "-R", "o/r"), ["pr", "comment", "7", "--body", signed, "-R", "o/r"]),
                (("issue", "comment", "2", "--body=hello"), ["issue", "comment", "2", "--body=" + signed]),
                (("issue", "comment", "2", "-bhello"), ["issue", "comment", "2", "-b" + signed]),
                (("pr", "review", "7", "--approve", "--body", "hello"), ["pr", "review", "7", "--approve", "--body", signed]),
                (("issue", "create", "--title", "t", "--body", "hello"), ["issue", "create", "--title", "t", "--body", signed]),
                (("pr", "create", "--title", "t", "--body", "hello"), ["pr", "create", "--title", "t", "--body", signed])):
            with self.subTest(args=args):
                done, seen = self.run_shim(*args)
                self.assertEqual(done.returncode, 0, done.stderr)
                self.assertEqual(seen["argv"], expected)

    def test_a_body_file_is_signed_through_a_copy_and_the_original_is_left_alone(self):
        original = self.home / "body.md"
        original.write_text("from a file")
        done, seen = self.run_shim("issue", "comment", "2", "--body-file", str(original))
        (sent_path,) = [a for a in seen["argv"] if a.endswith(".md") and a != str(original)]
        self.assertEqual(seen["files"][sent_path], "from a file\n\n" + self.MARK + "\n")
        self.assertEqual(original.read_text(), "from a file")
        self.assertFalse(os.path.exists(sent_path), "the signed copy is removed afterwards")

    def test_a_body_on_stdin_is_signed(self):
        done, seen = self.run_shim("issue", "comment", "2", "-F", "-", stdin="from stdin\nline two")
        self.assertEqual(seen["argv"], ["issue", "comment", "2", "-F", "-"])
        self.assertEqual(seen["stdin"], "from stdin\nline two\n\n" + self.MARK + "\n")

    def test_an_already_signed_body_is_not_signed_twice(self):
        done, seen = self.run_shim("issue", "comment", "2", "--body", "x\n\n<!-- fleet-switchboard:from=cos -->")
        self.assertEqual(seen["argv"][4].count("fleet-switchboard:from"), 1)

    def test_everything_else_runs_the_real_gh_with_exactly_the_same_arguments(self):
        for args in (("issue", "view", "2", "--json", "body"), ("pr", "list"), ("api", "repos/o/r/issues/2/comments",
                     "-f", "body=x"), ("issue", "comment", "2"), ("issue", "comment", "2", "--editor"),
                     ("issue", "comment"), ("--version",), ()):
            with self.subTest(args=args):
                done, seen = self.run_shim(*args)
                self.assertEqual(seen["argv"], list(args))

    def test_the_real_gh_output_and_exit_code_pass_through(self):
        done, _ = self.run_shim("issue", "comment", "2", "--body", "x", env={"FAKE_GH_EXIT": "3"})
        self.assertEqual((done.returncode, done.stdout, done.stderr), (3, "real gh out\n", "real gh err\n"))
        done, _ = self.run_shim("issue", "view", "2", env={"FAKE_GH_EXIT": "4"})
        self.assertEqual(done.returncode, 4)

    def test_the_signature_names_the_agent_or_says_agent_when_it_cannot_be_found(self):
        _, seen = self.run_shim("issue", "comment", "2", "--body", "x", env={"FAKE_WHO": "cos-2"})
        self.assertIn("from=cos-2", seen["argv"][4])
        for kwargs in ({"who": False}, {"env": {"FAKE_WHO_EXIT": "1"}}, {"env": {"FAKE_WHO": "Not A Name!"}},
                       {"env": {"FLEET_SWITCHBOARD_BIN": "relative/fleet-switchboard"}},
                       {"env": {"FLEET_SWITCHBOARD_BIN": "/does/not/exist"}}):
            with self.subTest(kwargs=kwargs):
                done, seen = self.run_shim("issue", "comment", "2", "--body", "x", **kwargs)
                self.assertEqual(done.returncode, 0, done.stderr)
                self.assertIn("from=agent", seen["argv"][4], "still signed: the signature is what stops the echo")

    def test_it_never_calls_itself_and_says_so_when_there_is_no_real_gh_behind_it(self):
        environ = {"PATH": str(SHIM.parent), "HOME": str(self.home)}
        done = subprocess.run([sys.executable, str(SHIM), "issue", "view", "1"], capture_output=True, text=True, env=environ)
        self.assertEqual(done.returncode, 127)
        self.assertIn("no real gh", done.stderr)

    def test_an_unreadable_body_file_runs_the_command_unchanged(self):
        done, seen = self.run_shim("issue", "comment", "2", "--body-file", "/no/such/file.md")
        self.assertEqual(seen["argv"], ["issue", "comment", "2", "--body-file", "/no/such/file.md"])

    # ---- readable text: the shim warns on stderr, never refuses (ask #401, shims/body_warn.py)
    WARN = "may be hard to read"
    LONG = "word " * 140                                  # 700 characters
    GOOD = "Short paragraph one.\n\n" + "- first item\n- second item\n- third item\n\n" + ("A fair sentence. " * 17).strip() + "\n"

    def load_warn(self):
        spec = importlib.util.spec_from_file_location("body_warn_t", str(SHIM.parent / "body_warn.py"))
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        return module

    def test_s2_each_bad_comment_prints_one_warning_and_the_real_gh_runs_with_its_status(self):
        for body in ("line one\\nline two", self.LONG, "Steps: (1) a (2) b (3) c done."):
            with self.subTest(body=body[:20]):
                done, seen = self.run_shim("issue", "comment", "2", "--body", body, env={"FAKE_GH_EXIT": "3"})
                self.assertEqual(done.returncode, 3)
                self.assertEqual(done.stderr.count(self.WARN), 1, done.stderr)
                self.assertIn("real gh out", done.stdout)
                self.assertIn("Markdown lists", done.stderr)
                self.assertEqual(seen["argv"][:3], ["issue", "comment", "2"])

    def test_s2_the_other_spellings_and_commands_warn_too(self):
        for args in (("pr", "create", "--title", "t", "--body=a\\nb"), ("issue", "edit", "2", "-ba\\nb"), ("pr", "review", "2", "-b", "x\\ny")):
            with self.subTest(args=args):
                done, seen = self.run_shim(*args)
                self.assertEqual(done.stderr.count(self.WARN), 1, done.stderr)
                self.assertIsNotNone(seen)

    def test_s2_a_body_file_and_stdin_are_never_opened_or_read_by_the_warning(self):
        module = self.load_warn()
        fifo = self.home / "pipe"
        os.mkfifo(fifo)
        (self.home / "f.md").write_text("one\\ntwo\n")
        for args in (("issue", "comment", "2", "--body-file", str(fifo)), ("issue", "comment", "2", "-F", str(fifo)), ("issue", "comment", "2", "--body-file=" + str(fifo)),
                     ("issue", "comment", "2", "-F", str(self.home / "f.md")), ("issue", "comment", "2", "-F", "-")):
            with self.subTest(args=args):
                self.assertIsNone(module.warning(list(args)))   # a FIFO with no writer would hang a warning that opened it
        # through the shim: a regular file and stdin go to gh without a warning (the shim's own signing reads them, as before)
        for args, stdin in ((("issue", "comment", "2", "-F", str(self.home / "f.md")), None), (("issue", "comment", "2", "-F", "-"), "a\\nb")):
            with self.subTest(shim=args):
                done, seen = self.run_shim(*args, stdin=stdin)
                self.assertNotIn(self.WARN, done.stderr)
                self.assertIsNotNone(seen)

    def test_s3_a_fence_or_a_code_span_hides_what_would_warn(self):
        for body in ("Intro.\n\n```\n" + self.LONG + "\n(1) (2) (3) \\n\n```\n", "Run `printf 'a\\nb (1) (2) (3)'` and see.", "~~~sh\nx\\ny\n~~~\n"):
            with self.subTest(body=body[:20]):
                done, _ = self.run_shim("issue", "comment", "2", "--body", body)
                self.assertNotIn(self.WARN, done.stderr)

    def test_s4_a_well_formed_body_prints_nothing_and_the_real_gh_runs_once(self):
        done, seen = self.run_shim("issue", "comment", "2", "--body", self.GOOD)
        self.assertEqual(done.stderr, "real gh err\n")
        self.assertIsNotNone(seen)
        self.assertGreater(max(len(p) for p in self.GOOD.split("\n\n")), 200)

    def test_s4_a_long_list_is_not_one_long_paragraph(self):
        done, _ = self.run_shim("issue", "comment", "2", "--body", "\n".join("- item number %d of the list" % n for n in range(40)))
        self.assertNotIn(self.WARN, done.stderr)

    def test_u1_a_command_with_no_text_flag_loads_nothing_and_spawns_nothing_extra(self):
        done, seen = self.run_shim("issue", "view", "2")
        self.assertEqual(done.stderr, "real gh err\n")
        source = (SHIM.parent / "body_warn.py").read_text()
        self.assertNotRegex(source, r"import .*\b(subprocess|socket|urllib|http|os)\b")

    def test_s8_an_inline_post_starts_no_process_and_no_network_and_opens_no_file(self):
        module = self.load_warn()
        def boom(*a, **k):
            raise AssertionError("no process, network or file")
        with mock.patch.object(subprocess, "run", boom), mock.patch.object(subprocess, "Popen", boom), mock.patch.object(socket, "socket", boom), \
                mock.patch.object(os, "system", boom), mock.patch.object(os, "open", boom), mock.patch.object(os, "stat", boom), mock.patch("builtins.open", boom):
            self.assertIn(self.WARN, module.warning(["issue", "comment", "2", "--body", "a\\nb"]))
            self.assertIsNone(module.warning(["issue", "comment", "2", "--body-file", "/no/such"]))

    def test_a_doubt_means_no_warning(self):
        module = self.load_warn()
        for args in (["issue", "comment", "2", "--body"], ["issue", "view", "2", "--body", "a\\nb"], ["issue"]):
            with self.subTest(args=args):
                self.assertIsNone(module.warning(args))

    def test_s6_the_warning_files_name_no_private_thing(self):
        pattern = re.compile("|".join(["jan" + "us", "sp" + "ire", "adk" + "aplan", "/Us" + "ers/", "direc" + "tor(?!y|ies)"]), re.I)
        for path in (SHIM.parent / "body_warn.py",):
            for number, line in enumerate(path.read_text().splitlines(), 1):
                self.assertIsNone(pattern.search(line), "%s:%d" % (path.name, number))


class TestSignedComments(HandoffCase):
    """The trial's agents share the user's GitHub account, so an agent's comment came back to it as a wake.
    A comment the switchboard posts is signed, and a signed comment is never an event."""

    def comment(self, body="Status: done", issue="2", *extra):
        path = self.home / "comment.md"
        path.write_text(body)
        with captured() as (out, err):
            code = sb.main(["comment", "--issue", issue, "--body-file", str(path)] + list(extra), runner=self.route,
                           now=self.world.clock.now, socket_call=self.world.herdr.socket)
        return code, out.getvalue(), err.getvalue()

    def test_the_comment_command_posts_as_the_caller_with_its_signature(self):
        code, out, err = self.comment("Status: complete.\nEvidence: curl returned 200.")
        self.assertEqual(code, 0, err)
        (posted,) = self.comments()
        self.assertEqual(posted["body"], "Status: complete.\nEvidence: curl returned 200.\n\n<!-- fleet-switchboard:from=cos -->")
        done = json.loads(out)
        self.assertEqual((done["issue"], done["author"]), (2, "cos"))
        self.assertTrue(done["comment"].startswith("https://"))

    def test_the_signature_is_invisible_html_and_names_the_agent_only(self):
        self.assertEqual(sb.fleet_mark("platform"), "<!-- fleet-switchboard:from=platform -->")
        self.assertEqual(sb.signed_by_fleet("text\n\n<!--fleet-switchboard:from=cos-2 -->"), "cos-2")
        for body in (None, 5, "", "a plain comment", "<!-- fleet-switchboard:from= -->", "<!-- other:from=cos -->",
                     "fleet-switchboard:from=cos"):
            self.assertIsNone(sb.signed_by_fleet(body), body)

    def test_it_needs_the_ask_repo_a_body_and_a_caller_who_is_a_fleet_agent(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "gh": FAKE_GH})
        code, _, err = self.comment()
        self.assertNotEqual(code, 0)
        self.assertIn("intent_repo", err)
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "gh": FAKE_GH, "intent_repo": FAKE_REPO})
        self.assertEqual(self.comments(), [])
        code, _, err = self.comment(body="   \n")
        self.assertNotEqual(code, 0)
        self.assertEqual(self.comments(), [])

    def test_whoami_prints_the_callers_fleet_name_and_fails_quietly_for_anyone_else(self):
        with captured() as (out, err):
            code = sb.main(["whoami"], runner=self.route, now=self.world.clock.now, socket_call=self.world.herdr.socket)
        self.assertEqual((code, out.getvalue().strip()), (0, "cos"))
        os.environ.pop("HERDR_PANE_ID")
        with captured() as (out, err):
            code = sb.main(["whoami"], runner=self.route, now=self.world.clock.now, socket_call=self.world.herdr.socket)
        self.assertNotEqual(code, 0)
        self.assertEqual(out.getvalue(), "")

    def test_a_comment_without_an_author_is_posted_as_it_is(self):
        engine = sb.build_engine(self.route, self.world.clock.now, "cli")[0]
        sb.post_ask_comment(engine, 2, "from a human tool")
        self.assertEqual(self.comments()[-1]["body"], "from a human tool")


class TestSignedCommentsAreNotEvents(Base):
    def setUp(self):
        super().setUp()
        self.rig = GithubRig(self, agents={"platform": {"role": "orchestrator", "charter": 1}})
        self.gh, self.hub = self.rig.gh, self.rig.hub
        self.gh.issue(1)
        self.gh.issue(12, parent=1)
        self.hub.tick()

    def test_a_signed_comment_is_dropped_from_the_webhook_and_an_unsigned_one_is_kept(self):
        self.gh.comment(12, "I finished.\n\n<!-- fleet-switchboard:from=platform -->", 5001)
        self.gh.comment(12, "A human note", 5002)
        self.assertEqual(sorted(f.key for f in self.hub.facts()), ["github.comment:5002"])

    def test_the_catch_up_read_drops_it_too_so_a_restart_does_not_bring_it_back(self):
        self.gh.comment(12, "I finished.\n\n<!-- fleet-switchboard:from=platform -->", 5001, forward=False)
        self.gh.comment(12, "A human note", 5002, forward=False)
        items, errors = self.hub.catch_up_items(GH_REPO, self.rig.world.clock.now())
        self.assertEqual(([i.key for i in items if i.kind == "github.comment"], errors), (["github.comment:5002"], []))

    def test_a_signed_review_is_dropped_as_well(self):
        review = {"id": 77, "state": "commented", "body": "ok\n\n<!-- fleet-switchboard:from=cos -->", "user": {"login": "x"}}
        self.assertIsNone(sb._review_item(GH_REPO, review, {"number": 5}, 0))
        self.assertIsNotNone(sb._review_item(GH_REPO, dict(review, body="ok"), {"number": 5}, 0))


class TestIgnoredAuthors(Base):
    """When the agents run as a bot account rather than as you, the author does say who wrote it."""

    def rig(self, ignore):
        rig = GithubRig(self, agents={"platform": {"role": "orchestrator", "charter": 1}},
                        config={"github_ignore_authors": ignore})
        rig.gh.issue(1)
        rig.gh.issue(12, parent=1)
        rig.hub.tick()
        return rig

    def test_events_by_an_ignored_author_are_not_delivered_and_the_audit_says_so(self):
        rig = self.rig(["Fleet-Bot"])
        rig.gh.comment(12, "from an agent", 5001, login="fleet-bot")
        rig.gh.comment(12, "from the human", 5002, login="you")
        self.assertEqual(sorted(f.key for f in rig.hub.facts()), ["github.comment:5002"])
        ignored = [e for e in rig.world.audit() if e["event"] == "github.ignored"]
        self.assertEqual(ignored[0]["detail"], {"keys": ["github.comment:5001"], "authors": ["fleet-bot"]})

    def test_with_nobody_ignored_every_author_is_delivered(self):
        rig = self.rig([])
        rig.gh.comment(12, "a", 5001, login="fleet-bot")
        self.assertEqual([f.key for f in rig.hub.facts()], ["github.comment:5001"])

    def test_the_setting_is_a_list_of_logins(self):
        base = {"opencode": None, "gh": "gh"}
        self.assertEqual(sb.validate_config(dict(base, github_ignore_authors=["a-b", "bot[bot]"]))["github_ignore_authors"],
                         ["a-b", "bot[bot]"])
        for bad in ("fleet-bot", [1], ["has space"], ["-x"], [""]):
            with self.subTest(value=bad), self.assertRaises(sb.ConfigError):
                sb.validate_config(dict(base, github_ignore_authors=bad))


class TestBriefParsing(unittest.TestCase):
    def test_the_sections_are_read_with_or_without_markup(self):
        parsed = sb.parse_brief("## Handoff: ask 2\nGoal: retyped, ignored\n**Done so far:** a\nb\n"
                                "## Next steps\n1. c\n- Watch out for: d\n")
        self.assertEqual(parsed, {"goal": "retyped, ignored", "done so far": "a\nb", "next steps": "1. c",
                                  "watch out for": "d"})

    def test_a_brief_without_done_so_far_or_next_steps_is_refused(self):
        for text, missing in (("Next steps: x\n", "Done so far"), ("Done so far: x\n", "Next steps"),
                              ("Watch out for: x\n", "Done so far and no Next steps"),
                              ("Done so far:\nNext steps: x\n", "Done so far")):
            with self.subTest(brief=text), self.assertRaises(sb.HandoffRefused) as caught:
                sb.parse_brief(text)
            self.assertIn(missing, str(caught.exception))

    def test_words_outside_the_sections_are_refused_not_dropped(self):
        with self.assertRaises(sb.HandoffRefused) as caught:
            sb.parse_brief("Please take over.\nDone so far: a\nNext steps: b\n")
        self.assertIn("outside its sections", str(caught.exception))

    def test_an_oversized_brief_is_refused(self):
        with self.assertRaises(sb.HandoffRefused):
            sb.parse_brief("Done so far: " + "x" * sb.BRIEF_LIMIT + "\nNext steps: b")

    def test_the_markdown_is_the_docs_with_goal_from_the_ask(self):
        issue = sb.IssueIntent(615, "open", "t", "Fix the agents", "both answer", None, False)
        text = sb.handoff_markdown(issue, {"goal": "mine", "done so far": "a", "next steps": "b"})
        self.assertEqual(text, "## Handoff: ask 615\nGoal: Fix the agents (Done when: both answer)\n"
                               "Done so far: a\nNext steps: b\nWatch out for: nothing noted")
        bare = sb.IssueIntent(7, "open", "t", None, None, None, False)
        self.assertIn("Goal: no intent recorded\n", sb.handoff_markdown(bare, {"done so far": "a", "next steps": "b"}))


class TestHandoff(HandoffCase):
    def test_it_posts_the_brief_once_launches_the_subagent_and_prints_one_json_line(self):
        code, out, err = self.main()
        self.assertEqual(code, 0, err)
        (comment,) = self.comments()
        self.assertEqual(comment["issue"], 2)
        self.assertEqual(comment["body"], "## Handoff: ask 2\nGoal: Fix the agents (Done when: both answer)\n"
                         "Done so far: found that the staging config drops the project binding\n"
                         "Next steps: 1. patch the binding\n2. redeploy staging\nWatch out for: production is untouched"
                         "\n\n<!-- fleet-switchboard:from=cos -->")
        (posted,) = [c for c in self.gh.calls if "--method" in c]
        self.assertEqual(posted, [FAKE_GH, "api", "repos/%s/issues/2/comments" % FAKE_REPO,
                                  "--method", "POST", "--input", "-"])
        (line,) = out.splitlines()
        done = json.loads(line)
        self.assertEqual((done["name"], done["role"], done["reports_to"], done["issue"]), ("cos-2", "cos-subagent", "cos", 2))
        self.assertTrue(done["comment"].startswith("https://"))
        self.assertTrue({"session", "pane", "tab"} <= set(done))

    def test_the_subagent_is_a_fleet_agent_for_the_ask_reporting_to_the_caller_in_its_own_tab(self):
        _, out, _ = self.main()
        done = json.loads(out)
        session = self.world.v2.sessions[done["session"]]
        self.assertEqual(session["metadata"], {"fleet": {"name": "cos-2", "role": "cos-subagent",
                                                         "reports_to": "cos", "issue": 2}})
        self.assertEqual((session["agent"], session["directory"]), ("cos-subagent", str(self.work)))
        method, params = self.world.herdr.socket_calls[0]
        self.assertEqual((method, params["workspace_id"]), ("layout.apply", "w1"))
        self.assertEqual(params["root"]["command"], [FAKE_OPENCODE, "-s", done["session"]])
        self.assertNotIn("focus", json.dumps(self.world.herdr.socket_calls).lower())

    def test_the_subagent_is_briefed_with_the_brief_and_told_how_to_report(self):
        _, out, _ = self.main()
        session = self.world.v2.sessions[json.loads(out)["session"]]
        (prompt,) = [m for m in session["messages"] if m["type"] == "user"]
        self.assertEqual(prompt["metadata"], {"fleet": {"from": "switchboard", "brief": True}})
        self.assertIn("## Handoff: ask 2\nGoal: Fix the agents (Done when: both answer)", prompt["text"])
        self.assertIn('fleet-switchboard send cos --issue 2 "..."', prompt["text"])

    def test_the_record_comes_before_the_launch_and_every_write_is_audited(self):
        self.main()
        self.assertLess(self.order.index("gh"), self.order.index("session.create"))
        events = [(e["event"], e["phase"]) for e in self.world.audit() if e["event"].startswith(("github.", "v2.session"))]
        self.assertEqual(events[:2], [("github.comment", "intent"), ("github.comment", "result")])
        comment = [e for e in self.world.audit() if e["event"] == "github.comment"]
        self.assertEqual(comment[0]["detail"]["issue"], 2)
        self.assertNotIn("Next steps", json.dumps(comment), "the audit holds the size, not the brief")

    def test_nothing_is_typed(self):
        self.main()
        self.assertEqual(self.world.herdr.typing_attempts, [])
        for argv in self.world.herdr.calls:
            self.assertIn(argv[1:3], HERDR_ALLOWED)

    def test_the_goal_the_chief_of_staff_wrote_is_replaced_and_it_is_told(self):
        code, out, err = self.main("Goal: something else entirely\n" + self.BRIEF)
        self.assertEqual(code, 0)
        self.assertNotIn("something else entirely", self.comments()[0]["body"])
        self.assertIn("Goal line in your brief was replaced", err)
        self.assertNotIn("replaced_goal", out)

    def test_each_refusal_writes_nothing_at_all(self):
        refusals = [
            ("Next steps: x\n", {}, 2, "Done so far"),
            ("Done so far: x\n", {}, 2, "Next steps"),
            ("hello\n" + HandoffCase.BRIEF, {}, 2, "outside its sections"),
            (None, {"issue": "1"}, 2, "charter"),
            (None, {"issue": "99"}, 1, "not_found"),
            (None, {"extra": ("--name", "Not A Name")}, 2, "name must match"),
        ]
        for brief, kwargs, code, words in refusals:
            with self.subTest(words=words):
                extra = kwargs.get("extra", ())
                got, _, err = self.main(brief, *extra, issue=kwargs.get("issue", "2"))
                self.assertEqual((got, words in err), (code, True), err)
                self.assertNothingWritten()

    def test_a_closed_ask_and_a_name_in_use_are_refused_before_anything_is_written(self):
        self.gh.issues[2]["state"] = "closed"
        self.reader.invalidate(2)
        code, _, err = self.main()
        self.assertEqual((code, "closed" in err), (2, True))
        self.assertNothingWritten()
        self.gh.issues[2]["state"] = "open"
        self.reader.invalidate(2)
        self.world.add_agent("cos-2", fleet={"role": "cos-subagent", "issue": 2})
        before = len(self.world.v2.sessions)
        code, _, err = self.main()
        self.assertEqual((code, "already runs" in err), (2, True))
        self.assertEqual((self.comments(), len(self.world.v2.sessions)), ([], before))

    def test_without_an_ask_repo_it_says_what_to_set(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        code, _, err = self.main()
        self.assertEqual((code, "intent_repo" in err), (2, True))
        self.assertNothingWritten()

    def test_a_github_that_cannot_post_stops_before_any_subagent_exists(self):
        original = self.gh.post_comment
        self.gh.post_comment = lambda argv, kwargs: subprocess.CompletedProcess(argv, 1, "", "gh: boom\n")
        before = len(self.world.v2.sessions)
        code, _, err = self.main()
        self.gh.post_comment = original
        self.assertEqual(code, 1)
        self.assertIn("boom", err)
        self.assertEqual(len(self.world.v2.sessions), before)

    def test_a_launch_that_fails_after_the_comment_says_the_brief_was_posted(self):
        self.world.herdr.launch_mode = "shell"
        engine = self.world.new_engine("cli")
        with self.assertRaises(sb.LaunchError) as caught:
            sb.handoff_ask(engine, "cos", 2, self.BRIEF, directory=str(self.work), workspace="w1", patience=3,
                           sleep=lambda seconds: self.world.tick(seconds))
        self.assertIn("the brief was posted on ask #2", str(caught.exception))
        self.assertEqual(len(self.comments()), 1)
        self.assertEqual(len(self.world.herdr.closed), 1, "the pane it opened is closed again")

    def test_it_needs_a_caller_it_can_identify(self):
        os.environ.pop("HERDR_PANE_ID")
        code, _, err = self.main()
        self.assertEqual((code, "HERDR_PANE_ID" in err), (1, True))
        self.assertNothingWritten()

    def test_the_brief_can_come_from_standard_input(self):
        with mock.patch.object(sys, "stdin", io.StringIO(self.BRIEF)):
            with captured() as (out, err):
                code = sb.main(["handoff", "--issue", "2", "--brief-file", "-", "--dir", str(self.work),
                                "--workspace", "w1"], runner=self.route, now=self.world.clock.now,
                               socket_call=self.world.herdr.socket)
        self.assertEqual(code, 0, err.getvalue())
        self.assertEqual(len(self.comments()), 1)

    def test_an_empty_brief_is_refused(self):
        code, _, err = self.main("   \n")
        self.assertEqual((code, "empty" in err), (1, True))
        self.assertNothingWritten()

    def test_the_handoff_is_the_only_github_write_and_the_reader_stays_read_only(self):
        self.main()
        writes = [c for c in self.gh.calls if len(c) != 3]
        self.assertEqual(len(writes), 1)
        self.assertNotRegex(class_source("IntentReader"), r"\"(-X|-f|-F|--method|--input|--field)\"")
        source = SWITCHBOARD.read_text()
        # the handoff comment, (PR 17) `write_issue_body` and (PR 18) `_gh_write`: labels and comments
        self.assertEqual(source.count('"--method"'), 3)


class TestForegroundScenarios(Base):
    def test_the_pr8_catalog_is_present_with_its_tiers_and_controls(self):
        found = {s["id"]: s for s in map(sc.load, sc.scenario_files(sc.DEFAULT_DIR))}
        for sid, tiers in (("F1", {"offline", "lab-model"}), ("F2", {"offline", "lab-model"}),
                           ("F3", {"offline", "lab-model"}), ("F4", {"offline", "lab-scripted"})):
            with self.subTest(scenario=sid):
                self.assertEqual((set(found[sid]["tiers"]), found[sid]["since_pr"], found[sid]["problem"]), (tiers, 8, 2))
        for sid in ("F1", "F2", "F3"):
            self.assertEqual(found[sid]["config"], {"classifier_mode": "act"})
        self.assertEqual(found["F2"]["control"]["variant"], {"steps": {"1": {"text": "Also, can you look at the billing export?"}}})
        self.assertEqual({sid: found[sid]["control"].get("fault") for sid in ("F1", "F3", "F4")},
                         {"F1": "no-classify", "F3": "no-classify", "F4": "no-engagement-gate"})

    def test_the_scenarios_run_and_their_controls_fail_what_they_name(self):
        for sid, name in (("F1", "f1-unrelated-while-busy"), ("F2", "f2-current-work"),
                          ("F3", "f3-ask-with-an-owner"), ("F4", "f4-subagent-finishes")):
            with self.subTest(scenario=sid):
                report = run_scenario(self, sc.load(sc.DEFAULT_DIR / (name + ".json")))
                self.assertEqual(report["failures"], [])
                self.assertEqual(report["implicit"], [])
                self.assertEqual(report["proves_nothing"], [])
                self.assertEqual(sorted(r["label"] for r in report["control"] if not r["ok"]) != [], True)

    def test_f1_decorates_with_the_handoff_and_f3_names_the_owner(self):
        f1 = OfflineRun(self, sc.load(sc.DEFAULT_DIR / "f1-unrelated-while-busy.json"), "run").run()
        self.assertTrue(all(r["ok"] for r in f1.evaluate()))
        texts = _delivered_texts(f1, "cos")
        self.assertTrue(any("fleet-switchboard handoff --issue 610" in t for t in texts))
        f3 = OfflineRun(self, sc.load(sc.DEFAULT_DIR / "f3-ask-with-an-owner.json"), "run").run()
        self.assertTrue(all(r["ok"] for r in f3.evaluate()))
        self.assertTrue(any("fleet-switchboard send cos-615 --issue 615" in t for t in _delivered_texts(f3, "cos")))

    def test_f2_the_control_decorates_the_same_message_once_it_is_unrelated(self):
        f2 = sc.load(sc.DEFAULT_DIR / "f2-current-work.json")
        control, _ = control_play(self, f2)
        self.assertEqual(len(_delivered_texts(control, "cos")), 1)

    def test_f4_carries_the_asks_intent_lines_offline(self):
        f4 = sc.load(sc.DEFAULT_DIR / "f4-subagent-finishes.json")
        f4["expect"].append({"name": "intent-lines", "that": "message_has_intent", "to": "cos", "issue": 615})
        run = OfflineRun(self, f4, "run").run()
        results = {r["label"]: r for r in run.evaluate()}
        self.assertTrue(results["intent-lines"]["ok"], results["intent-lines"]["seen"])
        self.assertTrue(results["noted"]["ok"])

    def test_the_handoff_step_leaves_a_brief_and_a_subagent_and_without_it_nothing(self):
        f1 = sc.load(sc.DEFAULT_DIR / "f1-unrelated-while-busy.json")
        run = OfflineRun(self, f1, "run").run()
        self.assertTrue({r["label"]: r["ok"] for r in run.evaluate()}["handed-off"])
        without = copy.deepcopy(f1)
        without["steps"] = [s for s in without["steps"] if s["do"] != "handoff"]
        run = OfflineRun(self, without, "run").run()
        self.assertFalse({r["label"]: r["ok"] for r in run.evaluate()}["handed-off"])

    def test_the_vocabulary_knows_the_new_config_and_step(self):
        self.assertIn("handoff", sc.STEP_FIELDS)
        self.assertEqual(sc.STEP_ACTORS["handoff"], ("cast",))
        scenario = sc.load(sc.DEFAULT_DIR / "f2-current-work.json")
        scenario["config"] = {"classifier_mode": "enforce"}
        self.assertTrue([e for e in sc.validate(scenario) if "classifier_mode" in e])
        scenario["config"] = {"classifier_mode": "act", "batch_seconds": 5}
        self.assertEqual(sc.validate(scenario), [])
        scenario["config"] = {"colour": "red"}
        self.assertTrue([e for e in sc.validate(scenario) if "colour" in e])

    def test_j1_and_f5_still_run_in_shadow_mode(self):
        for name in ("j1-shadow-classifier.json", "f5-jev-unsure.json"):
            with self.subTest(scenario=name):
                scenario = sc.load(sc.DEFAULT_DIR / name)
                self.assertNotIn("classifier_mode", scenario.get("config", {}))
                report = run_scenario(self, scenario)
                self.assertEqual(report["failures"] + report["proves_nothing"], [])


class TestPR8Source(unittest.TestCase):
    def test_the_foreground_section_is_one_clearly_marked_block(self):
        source = SWITCHBOARD.read_text()
        self.assertEqual(source.count("\n# PR 8: foreground and background"), 1)

    def test_the_engine_still_never_types(self):
        self.assertEqual(herdr_typing_violations(switchboard_source()), [])

    def test_no_top_level_name_is_defined_twice_in_the_big_files(self):
        for name in ("fleet-switchboard", "test-switchboard", "fleet-scenario", "proof-switchboard"):
            seen = {}
            for node in ast.parse((BIN / name).read_text()).body:
                names = [node.name] if isinstance(node, (ast.FunctionDef, ast.ClassDef)) else [
                    t.id for t in getattr(node, "targets", []) if isinstance(t, ast.Name)]
                for each in names:
                    self.assertNotIn(each, seen, "%s defines %s twice (lines %s and %s)" % (name, each, seen.get(each), node.lineno))
                    seen[each] = node.lineno


class TestNoticeRace(ActingCase):
    """SF1: your message is consumed at the next step boundary T; the decoration must be in v2's inbox before it."""

    def start(self):
        self.work(lasts=10, steps=2)      # one step boundary, at EPOCH + 5
        self.world.tick(1)
        self.say("Also, the billing export?")
        self.yours = self.world.v2.sessions[self.cos]["inbox"][-1]["id"]

    def calls_with(self, message_id):
        return [c for c in self.world.model_calls("cos") if message_id in [i["id"] for i in c["inputs"]]]

    def test_your_message_is_seen_in_the_inbox_before_any_boundary(self):
        self.start()
        self.assertEqual([m for m in self.world.v2.sessions[self.cos]["messages"] if m["type"] == "user"][-1:][0]["text"],
                         "fleet task", "not yet in the transcript")
        self.world.clock.t = EPOCH + 1.2
        self.world.engine.run_pass()
        self.assertEqual(len(self.jev.calls), 1)
        self.assertEqual(len(self.decorations()), 1)

    def test_a_decoration_sent_0_2_s_before_the_boundary_arrives_with_your_message(self):
        self.start()
        self.world.clock.t = EPOCH + 4.8
        self.world.engine.run_pass()
        self.world.clock.t = EPOCH + 5
        self.world.v2.advance()
        (call,) = self.calls_with(self.yours)
        self.assertEqual(call["phase"], "between_steps")
        self.assertTrue(any(k.startswith("decoration:") for i in call["inputs"] for k in i["keys"]))
        self.assertEqual([e for e in self.world.audit() if e["event"] == "foreground.late"], [])

    def test_a_decoration_sent_after_the_boundary_is_late_and_audited(self):
        self.start()
        self.world.clock.t = EPOCH + 5
        self.world.v2.advance()
        self.world.clock.t = EPOCH + 5.2
        self.world.engine.run_pass()
        (call,) = self.calls_with(self.yours)
        self.assertFalse(any(i["keys"] for i in call["inputs"]), "the model saw the bare message first")
        (late,) = [e for e in self.world.audit() if e["event"] == "foreground.late"]
        self.assertEqual((late["detail"]["decoration"], late["detail"]["agent"]), ("handoff", "cos"))
        self.assertEqual(late["detail"]["message_id"], self.yours)

    def test_a_decoration_is_a_note_not_a_wake_even_while_your_message_waits_in_the_inbox(self):
        self.start()
        self.world.engine.run_pass()
        (note,) = self.decorations()
        self.assertEqual((note["resume"], note["delivery"]), (False, "steer"))

    def test_late_is_not_logged_when_nothing_is_decorated(self):
        self.answer = "current"
        self.start()
        self.world.tick(6)
        self.world.engine.run_pass()
        self.assertEqual([e for e in self.world.audit() if e["event"] == "foreground.late"], [])


class TestBusyPoll(ActingCase):
    def waits(self, passes=2):
        waits = []
        sb.run_daemon(self.world.engine, self.world.state, 5, lambda sock, t: waits.append(t), passes=passes)
        return waits

    def test_the_default_is_one_second_and_must_be_positive(self):
        self.assertEqual(sb.validate_config({})["busy_poll_seconds"], 1)
        for bad in (0, -1, "1", True):
            with self.subTest(bad=bad), self.assertRaises(sb.ConfigError):
                sb.validate_config({"busy_poll_seconds": bad})

    def test_the_daemon_polls_fast_only_while_a_chief_of_staff_works(self):
        self.assertEqual(self.waits(2), [5])  # the pass sees an idle fleet
        self.work()
        self.assertEqual(self.waits(2), [1])  # ... and a working Chief of Staff
        self.world.tick(120)
        self.assertEqual(self.waits(3), [5, 5])

    def test_a_busy_worker_or_orchestrator_does_not_speed_it_up(self):
        self.world.v2.start_turn(self.world.sessions["cos-2"], "fleet task", fleet=True, lasts=60, steps=6)
        self.assertEqual(self.waits(3), [5, 5])

    def test_shadow_mode_never_polls_fast(self):
        self.world.engine.config = dict(self.world.engine.config, classifier_mode="shadow")
        self.work()
        self.assertEqual(self.waits(3), [5, 5])


class TestNativeChildSession(Base):
    def test_a_pane_less_child_with_the_parents_fleet_metadata_is_not_a_second_agent(self):
        world = World(self, agents=("cos",))
        child = world.v2.create_session({"fleet": {"name": "cos", "role": "chief-of-staff"}})
        world.v2.sessions[child]["parentID"] = world.sessions["cos"]  # herdr shows no pane for it
        found = world.engine.discover(world.clock.now())
        self.assertEqual(list(found.agents), ["cos"])
        self.assertEqual((found.agents["cos"].session_id, found.agents["cos"].conflict), (world.sessions["cos"], []))
# ============================================================================
# PR 9: the tool-call policy judge, its plugin and scenarios P1 to P6
#
# One section, so the stack rebases cleanly: the offline runner learns the
# `tool-call` step and the `policy_outcome` oracle by attachment (as PR 4 and
# PR 5 did), then the tests. Nothing here reaches a real binary or a network:
# Jev is a replay file, a fake or a fake opener; v2 and GitHub are the fakes.
# ============================================================================
POLICY_REPLAY = REPO / "scenarios" / "jev" / "policy.json"
FLEET_HOOKS = REPO / "plugins" / "fleet-hooks"
NODE = shutil.which("node")  # found before each test narrows PATH


class PolicyCountingJev:
    """Wraps a decision model and counts how often it was asked."""

    def __init__(self, inner):
        self.inner, self.calls = inner, 0

    def decide(self, state, questions):
        self.calls += 1
        return self.inner.decide(state, questions)


def policy_raw_config(**policy):
    """A validated config with the judge on, answering from the replay file."""
    return sb.validate_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "gh": FAKE_GH,
                               "intent_repo": FAKE_REPO, "policy": {**LEGACY_POLICY, "enabled": True, **policy},
                               "jev": {"replay": str(POLICY_REPLAY)}})


class PolicyRig:
    """What a scenario's tool-call steps share: the judge, its Jev, and what each step answered."""

    def __init__(self, run):
        world = run.world
        self.config = policy_raw_config()
        self.config["cos_orders_file"] = run.cos_orders_path  # PR 18: the file this run's Chief of Staff has
        self.jev = PolicyCountingJev(sb.build_jev(self.config))
        self.judge = sb.PolicyJudge(self.config, world.engine.v2, getattr(world, "intents", None), self.jev,
                                    sb.AuditLog(world.audit_path), world.state, world.clock.now)
        self.results = {}


def _policy_stricter(reply_outcome, configured):
    order = sb.POLICY_REQUEST_OUTCOMES.index
    return order(reply_outcome) > order(configured)


def apply_tool_call(run, step, index=None):
    """`tool-call`: the plugin's JSON through `judge-tool`'s own path (parse, judge_request), against the fakes.

    An ask then blocks the agent as v2 would after the hook sets `ask`, with the
    judge's reason as the request's message, when the reply tightened the outcome.
    """
    world, name = run.world, step["actor"]
    rig = run.policy = getattr(run, "policy", None) or PolicyRig(run)
    if index is None:
        index = next(i for i, s in enumerate(run.scenario["steps"]) if s is step)
    configured = step.get("configured", "allow")
    request = sb.parse_policy_request(json.dumps({"sessionID": world.sessions[name], "tool": step["tool"],
                                                  "arguments": step["arguments"], "outcome": configured}))
    before, saved = rig.jev.calls, os.environ.get(sb.FAULT_ENV)
    os.environ[sb.FAULT_ENV] = ",".join(run.faults)
    try:
        reply, judge = sb.judge_request(request, rig.config, lambda: rig.judge)
    finally:
        os.environ[sb.FAULT_ENV] = saved or ""
    rig.results[index] = {"agent": name, "reply": reply, "jev_calls": rig.jev.calls - before}
    if reply["outcome"] == "ask":
        apply_worker_step(run, {"do": "permission", "actor": name})
        ask = world.v2.asks[world.sessions[name]][-1]
        ask.update(action=step["tool"], resources=[step["arguments"]])
        if _policy_stricter(reply["outcome"], configured):
            ask["message"] = reply["reason"]


def oracle_policy_outcome(self, e):
    rig = getattr(self, "policy", None)
    found = rig.results.get(e["step"]) if rig else None
    if found is None or found["agent"] != e["agent"]:
        return False, "step %d made no tool call by %s" % (e["step"], e["agent"])
    reply = found["reply"]
    wanted = [("outcome", e["outcome"]), ("judged", e.get("judged")), ("cached", e.get("cached")),
              ("jev_calls", e.get("jev_calls"))]
    got = dict(reply, jev_calls=found["jev_calls"])
    ok = all(want is None or got[key] == want for key, want in wanted)
    ok = ok and e.get("reason", "") in reply["reason"]
    return ok, "step %d: outcome %s, judged %s, cached %s, Jev asked %d time(s), reason %r" % (
        e["step"], reply["outcome"], reply["judged"], reply["cached"], found["jev_calls"], reply["reason"])


def _policy_extend_offline_run():
    original_apply = OfflineRun.apply

    def apply(self, step):
        if step["do"] == "tool-call":
            apply_tool_call(self, step)
        else:
            original_apply(self, step)

    OfflineRun.apply = apply
    OfflineRun.oracle_policy_outcome = oracle_policy_outcome


_policy_extend_offline_run()

STEP_EXAMPLES["tool-call"] = {"tool": "shell", "arguments": "git push --force", "configured": "ask"}
EXPECT_EXAMPLES["policy_outcome"] = {"agent": "coder", "step": 0, "outcome": "ask", "reason": "hard to reverse",
                                     "judged": True, "cached": False, "jev_calls": 1}


# ------------------------------------------------------------------- config

class TestPolicyConfig(Base):
    def test_off_by_default_with_documented_defaults(self):
        policy = sb.validate_config({})["policy"]
        self.assertEqual(policy, {"enabled": False, "budget_ms": 1500, "thresholds": sb.POLICY_DEFAULT_THRESHOLDS, "routine_filter": True, "cache_seconds": 300,
                                  "cache_entries": 200, "shadow": False})

    def check_rejected(self, policy, fragment, **extra):
        with self.assertRaises(sb.ConfigError) as caught:
            sb.validate_config(dict({"policy": policy}, **extra))
        self.assertIn(fragment, str(caught.exception))

    def test_unknown_subkeys_are_warned_about_by_name_and_ignored(self):
        for policy, name in (({"budgetms": 5}, "budgetms"), ({"enabled": False, "extra": 1}, "extra")):
            sb._WARNED_CONFIG.clear()
            err = io.StringIO()
            with contextlib.redirect_stderr(err):
                sb.validate_config({"policy": policy})
            self.assertIn(name, err.getvalue())

    def test_each_value_is_checked(self):
        for policy, fragment in (({"enabled": "yes"}, "policy.enabled"), ({"budget_ms": 0}, "policy.budget_ms"),
                                 ({"budget_ms": "9"}, "policy.budget_ms"), ({"budget_ms": True}, "policy.budget_ms"),
                                 ({"cache_seconds": -1}, "policy.cache_seconds"), ({"shadow": "yes"}, "policy.shadow"),
                                 ({"cache_entries": 0}, "policy.cache_entries"),
                                 ({"cache_entries": 99999}, "policy.cache_entries"),
                                 ({"thresholds": []}, "policy.thresholds"),
                                 ({"thresholds": {"outside_intent": 0}}, "policy.thresholds.outside_intent"),
                                 ({"thresholds": {"outside_intent": 1.5}}, "policy.thresholds.outside_intent"),
                                 ({"thresholds": {"nothing": 0.5}}, "names no question")):
            with self.subTest(policy=policy):
                self.check_rejected(policy, fragment)
        self.check_rejected("on", "must be an object")

    def test_enabling_needs_a_decision_model(self):
        self.check_rejected({"enabled": True}, "needs a 'jev' object")
        config = sb.validate_config({"policy": {"enabled": True, "budget_ms": 400, "thresholds": {"outside_scope": 0.8}},
                                     "jev": {}})
        self.assertEqual((config["policy"]["budget_ms"], config["policy"]["thresholds"]), (400, dict(sb.POLICY_DEFAULT_THRESHOLDS, outside_scope=0.8)))

    def test_the_fault_exists_and_works_only_in_the_lab(self):
        self.assertIn("no-policy-judge", sb.KNOWN_FAULTS)
        os.environ[sb.FAULT_ENV] = "no-policy-judge"
        os.environ.pop(sb.LAB_ENV, None)
        request = {"configured": "allow", "tool": "shell"}
        self.assertIsNone(sb.policy_unjudged_reason(policy_raw_config(), request))
        os.environ[sb.LAB_ENV] = "1"
        self.assertIn("no-policy-judge", sb.policy_unjudged_reason(policy_raw_config(), request))


# ------------------------------------------------------------------ request

class TestPolicyRequest(unittest.TestCase):
    GOOD = {"sessionID": "ses_0123abcd", "tool": "shell", "arguments": "git status", "outcome": "ask"}

    def parse(self, **change):
        return sb.parse_policy_request(json.dumps(dict(self.GOOD, **change)))

    def test_a_good_request(self):
        self.assertEqual(self.parse(), {"session": "ses_0123abcd", "tool": "shell", "arguments": "git status",
                                        "configured": "ask"})

    def test_arguments_may_be_missing_or_structured_and_are_bounded(self):
        self.assertEqual(self.parse(arguments=None)["arguments"], "")
        self.assertEqual(self.parse(arguments={"b": 1, "a": 2})["arguments"], '{"a":2,"b":1}')
        self.assertEqual(len(self.parse(arguments="x" * 99999)["arguments"]), sb.POLICY_ARG_LIMIT)

    def test_every_malformed_request_is_refused(self):
        bad = ["", "not json", "[]", "7", '"x"', "null", json.dumps({}),
               json.dumps(dict(self.GOOD, sessionID="x; rm -rf /")), json.dumps(dict(self.GOOD, sessionID="--help")),
               json.dumps(dict(self.GOOD, sessionID=7)), json.dumps(dict(self.GOOD, tool="rm")),
               json.dumps(dict(self.GOOD, tool=None)), json.dumps(dict(self.GOOD, outcome="hard-deny")),
               json.dumps(dict(self.GOOD, outcome="permit")), json.dumps({k: v for k, v in self.GOOD.items() if k != "outcome"})]
        for text in bad:
            with self.subTest(text=text[:50]):
                with self.assertRaises(sb.PolicyRequestError):
                    sb.parse_policy_request(text)

    def test_the_tool_names_are_the_documented_nine(self):
        self.assertEqual(sb.POLICY_TOOLS, ("shell", "edit", "webfetch", "subagent", "read", "glob", "grep", "skill", "other"))
        self.assertEqual(sb.POLICY_PASS_THROUGH, ("read", "glob", "grep", "skill"))


class TestPolicyRedaction(unittest.TestCase):
    def test_credential_shapes_are_removed(self):
        for secret, text in (
                ("sk-or-test-0123456789abcdef", "curl -H 'Authorization: Bearer sk-or-test-0123456789abcdef' x"),
                ("ghp_0123456789abcdefABCDEF", "git push https://ghp_0123456789abcdefABCDEF@host/r"),
                ("hunter2hunter2", "deploy --password hunter2hunter2"),
                ("s3cr3tvalue99", "API_TOKEN=s3cr3tvalue99 ./run"),
                ("AKIA0123456789ABCDEF", "aws --key AKIA0123456789ABCDEF s3 ls"),
                ("realpass", "git clone https://user:realpass@example.test/r.git")):
            with self.subTest(secret=secret):
                self.assertNotIn(secret, sb.redact_command_text(text))

    def test_a_known_key_is_removed_wherever_it_appears_and_ordinary_text_survives(self):
        self.assertNotIn("KEYVALUE", sb.redact_command_text("echo KEYVALUE", ["KEYVALUE"]))
        self.assertEqual(sb.redact_command_text("git log --oneline -5"), "git log --oneline -5")
        self.assertEqual(sb.redact_command_text(None), "")


# ------------------------------------------------------- standing authority

class TestStandingAuthority(unittest.TestCase):
    def test_the_line_in_the_charter_prose(self):
        body = "```yaml\norchestrator: platform\n```\n\nStanding authority: may merge green PRs\n\nMore.\n"
        self.assertEqual(sb.parse_standing_authority(body), "may merge green PRs")

    def test_forms_that_count(self):
        for line in ("standing authority: may merge", "- Standing authority: may merge", "**Standing authority:** may merge",
                     "  Standing Authority :   may merge  "):
            with self.subTest(line=line):
                self.assertEqual(sb.parse_standing_authority("text\n" + line + "\n"), "may merge")

    def test_absent_empty_none_or_fenced_is_none_stated(self):
        for body in (None, "", "no such line", "Standing authority:", "Standing authority: none",
                     "Standing authority: None stated.", "```\nStanding authority: may merge\n```\n",
                     "~~~\nStanding authority: may merge\n~~~\n", "A Standing authority: may merge (not at line start)"):
            with self.subTest(body=body):
                self.assertIsNone(sb.parse_standing_authority(body))

    def test_the_first_line_wins(self):
        self.assertEqual(sb.parse_standing_authority("Standing authority: one\nStanding authority: two\n"), "one")

    def test_the_skill_documents_it_in_one_short_paragraph(self):
        text = (REPO / "skills" / "fleet-charter" / "SKILL.md").read_text()
        self.assertEqual(text.count("Standing authority:"), 2)  # the syntax line and the example line
        self.assertIn("none stated", text)


# ------------------------------------------------------------------- caches

class TestPolicyCache(Base):
    def make(self, ttl=60, limit=3, name="c.json"):
        self.clock = SimClock()
        return sb.BoundedFileCache(self.home / name, self.clock.now, ttl, limit)

    def test_round_trip_expiry_and_privacy(self):
        cache = self.make()
        self.assertTrue(cache.put("k", {"answers": {"a": 0.1}}))
        self.assertEqual(cache.get("k"), {"answers": {"a": 0.1}})
        self.assertEqual(stat.S_IMODE(os.stat(str(self.home / "c.json")).st_mode), 0o600)
        self.clock.t += 59
        self.assertIsNotNone(cache.get("k"))
        self.clock.t += 2
        self.assertIsNone(cache.get("k"))

    def test_it_is_bounded_and_drops_the_oldest(self):
        cache = self.make(limit=3)
        for number in range(6):
            self.clock.t += 1
            cache.put("k%d" % number, number)
        data = json.loads((self.home / "c.json").read_text())["entries"]
        self.assertEqual(sorted(data), ["k3", "k4", "k5"])

    def test_expired_entries_are_not_kept_in_the_file(self):
        cache = self.make(ttl=10)
        cache.put("old", 1)
        self.clock.t += 11
        cache.put("new", 2)
        self.assertEqual(sorted(json.loads((self.home / "c.json").read_text())["entries"]), ["new"])

    def test_writes_are_atomic_and_leave_no_temp_file(self):
        cache = self.make()
        for number in range(5):
            cache.put("k%d" % number, number)
        self.assertEqual(sorted(p.name for p in self.home.glob("c.json*")), ["c.json"])

    def test_a_failed_write_is_not_an_error_and_cleans_up(self):
        cache = self.make(name="missing-dir/c.json")
        self.assertFalse(cache.put("k", 1))
        self.assertIsNone(cache.get("k"))

    def test_corrupt_oversized_or_wrongly_shaped_files_read_as_empty(self):
        cache = self.make()
        for text in ("{not json", "[]", '{"entries": []}', '{"entries": {"k": 5}}',
                     '{"entries": {"k": {"at": "x", "value": 1}}}', "x" * (sb.POLICY_CACHE_BYTES + 1)):
            with self.subTest(text=text[:30]):
                (self.home / "c.json").write_text(text)
                self.assertIsNone(cache.get("k"))
        self.assertTrue(cache.put("k", 1))  # and the next write replaces the bad file
        self.assertEqual(cache.get("k"), 1)

    def test_an_entry_from_the_future_is_not_trusted(self):
        cache = self.make()
        cache.put("k", 1)
        self.clock.t -= 1000
        self.assertIsNone(cache.get("k"))

    def test_a_ttl_of_zero_turns_it_off(self):
        cache = self.make(ttl=0)
        self.assertFalse(cache.put("k", 1))
        self.assertFalse((self.home / "c.json").exists())
        self.assertIsNone(cache.get("k"))


# ---------------------------------------------------------- the judge itself

def policy_replay_file(home, rules, name="replay.json"):
    path = Path(home) / name
    path.write_text(json.dumps({"rules": rules}))
    return str(path)


LOW = {"outside_intent": 0.0, "hard_to_reverse": 0.0, "speaks_for_you": 0.0, "outside_scope": 0.0}


class PolicyCase(IntentCase):
    """A world with a fake GitHub (charter 1, ask 2, work item 3), a configured judge, and the CLI wired to both."""

    ISSUES = dict(IntentCase.ISSUES, **{"1": {"intent": None, "authority": "may merge green PRs"}})

    def setUp(self):
        super().setUp()
        self.cos = self.world.add_agent("chief-of-staff", fleet={"role": "chief-of-staff"})
        self.orch = self.world.add_agent("orch", fleet={"role": "orchestrator", "charter": 1, "issue": 2,
                                                       "reports_to": "chief-of-staff"})
        self.coder = self.world.add_agent("worker", fleet={"role": "coder", "issue": 3, "reports_to": "orch"})
        self.plain = self.world.v2.create_session({})  # a session with no metadata.fleet
        self.configure()
        # The daemon's end of the judge socket, on the same fakes: judge-tool reaches Jev only through it.
        self.server = sb.JudgeServer(self.world.state, sb.make_judge_handler(self.route, self.world.clock.now)).start()
        self.addCleanup(self.server.stop)

    def configure(self, rules=None, **policy):
        replay = policy_replay_file(self.home, rules or [{"noul": LOW}])
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "gh": FAKE_GH, "intent_repo": FAKE_REPO,
                           "jev": {"replay": replay}, "policy": {**LEGACY_POLICY, "enabled": True, **policy}})

    def route(self, argv, **kwargs):
        if argv[0] == FAKE_GH:
            return self.gh(argv)
        return self.world.route(argv, **kwargs)

    def judge_tool(self, session, tool="shell", arguments="git status", outcome="allow", raw=None):
        text = raw if raw is not None else json.dumps({"sessionID": session, "tool": tool, "arguments": arguments,
                                                       "outcome": outcome})
        with mock.patch.object(sys, "stdin", io.StringIO(text)), captured() as (out, err):
            code = sb.main(["judge-tool"], runner=self.route, now=self.world.clock.now)
        lines = out.getvalue().splitlines()
        self.assertEqual(code, 0, err.getvalue())
        self.assertEqual(len(lines), 1, "exactly one line of output: %r" % out.getvalue())
        return json.loads(lines[0])

    def audit_events(self):
        return [e for e in self.world.audit() if e["event"] == "policy.judge"]

    def direct_judge(self, jev, **policy):
        config = policy_raw_config(**policy)
        return sb.PolicyJudge(config, self.world.engine.v2, self.reader, jev, sb.AuditLog(self.world.audit_path),
                              self.world.state, self.world.clock.now)


class TestRoutineLocal(unittest.TestCase):
    """Issue 87: the pre-filter that says a command is a read or a local reversible step, and nothing else."""

