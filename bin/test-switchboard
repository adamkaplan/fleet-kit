        self.gh.graphql_fault = "exit"
        self.go()
        self.gh.graphql_fault = None
        self.go()   # inside the back-off
        self.assertEqual(self.skipped()[-1], {"retry": 1, "reason": "retry"})

    def test_what_is_remembered_about_a_run_that_never_wakes_is_forgotten(self):
        self.add(1450, 550, names=["t"])
        self.gh.pulls[(self.REPO, 550)] = ("OPEN", True)
        self.go()
        memory = self.engine.queue_ejections
        self.assertEqual((len(memory["first"]), len(memory["held"])), (1, 1))
        self.world.tick(self.module.WAKE_WINDOW + self.module.LIST_SECONDS + 100)   # the run is history now
        self.go()
        self.assertEqual((len(memory["first"]), len(memory["held"])), (0, 0))

    def test_s3_a_skip_is_said_once_until_it_changes(self):
        self.add(1420, 520, names=["t"])
        self.gh.pulls[(self.REPO, 520)] = ("OPEN", True)
        for _ in range(3):
            self.go()
        self.assertEqual(self.skipped(), [{"queued": 1, "reason": "queued"}], "1 line in 3 passes")
        self.add(1421, 521, names=["t"])
        self.gh.pulls[(self.REPO, 521)] = ("OPEN", True)
        self.world.tick(self.module.LIST_SECONDS + 1)
        self.go()
        self.go()
        self.assertEqual(self.skipped()[-1], {"queued": 2, "reason": "queued"})
        self.assertEqual(len(self.skipped()), 2)

    def test_s4_the_line_that_settles_a_run_says_how_late_it_was_first_seen_and_why(self):
        self.chief("boss")
        self.engine.hub.owner = None
        self.add(1430, 530, names=["t"], age=1200)
        self.gh.pulls[(self.REPO, 530)] = ("OPEN", True)
        self.go()
        self.gh.pulls[(self.REPO, 530)] = ("OPEN", False)
        self.world.tick(self.module.RECHECK_SECONDS + 1)
        self.go()
        (line,) = [e for e in self.world.audit() if e["event"] == "queue_ejection.unowned_woke"]
        detail = line["detail"]
        self.assertTrue(1200 <= detail["seen_after"] <= 1260, detail)
        self.assertEqual((detail["why"], detail["held"]), ("first_list", {"queued": 1}))
        self.engine.hub.owner = "orch"
        self.add(1431, 531, names=["t"], age=1300)
        self.world.tick(self.module.LIST_SECONDS + 1)
        self.go()
        (late,) = [e for e in self.world.audit() if e["event"] == "queue_ejection.woke"]
        self.assertEqual(late["detail"]["why"], "list_interval")

    def test_the_daemons_pass_runs_it_and_a_failure_never_stops_the_pass(self):
        self.add(1501, 601, names=["t"])
        sb.publish_decisions(self.engine)
        self.assertEqual(len(self.sent), 1, "publish_decisions (the pass) runs it")
        with mock.patch.object(self.module, "run_pass", side_effect=RuntimeError("boom")):
            sb.publish_decisions(self.engine)
        self.assertTrue([e for e in self.world.audit() if e["event"] == "queue_ejection.error"])


def _zip_with(member, data):
    stream = io.BytesIO()
    with zipfile.ZipFile(stream, "w") as archive:
        archive.writestr(member, data)
    return stream.getvalue()


class TestScratchFileRule(unittest.TestCase):
    """Ask #653: the coordination skill tells coders to keep scratch files in a private mktemp -d directory."""

    RULE = 'Write scratch files (PR bodies, message bodies, notes) under a private directory made with mktemp -d, never under a fixed name in the shared temp folder: another agent may write the same name, and a body file is published as it stands.'

    def test_s1_the_skill_carries_the_scratch_rule_exactly_once(self):
        text = (REPO / "skills/fleet-coordination/SKILL.md").read_text()
        self.assertEqual(text.count(self.RULE), 1)

    def test_s2_it_is_never_inside_a_code_fence(self):
        inside = False
        for line in (REPO / "skills/fleet-coordination/SKILL.md").read_text().splitlines():
            if line.strip().startswith("```"):
                inside = not inside
            elif inside:
                self.assertNotIn("mktemp -d", line)


class TestDeployFromMainSentence(unittest.TestCase):
    SENTENCE = ("Production is deployed from the head of main only: never from a side branch, a cherry-pick or a revert off main; "
                "when main is not shippable, the fix goes into main (the owner's standing order).")

    def test_s2_the_coordination_skill_states_the_deploy_rule_once(self):
        text = (REPO / "skills" / "fleet-coordination" / "SKILL.md").read_text()
        self.assertEqual(text.count(self.SENTENCE), 1)


class TestPreflightPr(unittest.TestCase):
    """`preflight-pr` (#716): one PASS or FAIL line per CI-critical class, run under `heavy`; the runner is faked, nothing real runs."""
    SENTENCE = "`fleet-switchboard preflight-pr` runs the CI-critical focused classes"

    def run_preflight(self, changed, failing=(), timing_out=()):
        calls = []

        def runner(argv, **kwargs):
            calls.append((list(argv), kwargs))
            done = mock.Mock(returncode=0, stdout="", stderr="")
            if argv[:2] == ["git", "rev-parse"]:
                done.stdout = "/work/repo\n"
            elif argv[:2] == ["git", "merge-base"]:
                done.stdout = "abc123\n"
            elif argv[:2] == ["git", "diff"]:
                done.stdout = "\n".join(changed)
            elif "heavy" in argv:
                command = " ".join(argv[argv.index("--") + 1:])
                if any(word in command for word in timing_out):
                    raise subprocess.TimeoutExpired(argv, 1)
                done.returncode = 1 if any(word in command for word in failing) else 0
            return done
        out, err = io.StringIO(), io.StringIO()
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err), mock.patch.object(sb, "preflight_load", lambda: (0.0, 4)):
            code = sb.cmd_preflight_pr(None, runner, time.time)
        return code, out.getvalue().splitlines(), calls

    def test_s1_every_class_passing_prints_one_pass_line_each_and_exits_0(self):
        code, lines, calls = self.run_preflight(["bin/fleet-switchboard"])
        self.assertEqual(code, 0)
        self.assertEqual([l.split()[:2] for l in lines], [["PASS", "cli-surface"], ["PASS", "hygiene"], ["PASS", "public-names"]])
        self.assertEqual([c for c in calls if "heavy" in c[0] and "cloud" in " ".join(c[0])], [])

    def test_s2_a_failing_class_prints_fail_with_its_name_and_exits_1(self):
        code, lines, _ = self.run_preflight(["x"], failing=("check-public-names",))
        self.assertEqual(code, 1)
        self.assertEqual([l for l in lines if l.startswith("FAIL")].__len__(), 1)
        self.assertTrue([l for l in lines if l.startswith("FAIL")][0].startswith("FAIL public-names"))

    def test_a_slot_wait_is_never_a_timeout_and_the_ceiling_runs_inside_the_slot(self):
        calls = []

        def runner(argv, **kwargs):
            calls.append((list(argv), kwargs))
            done = mock.Mock(returncode=0, stdout="/work/repo\n" if argv[:2] == ["git", "rev-parse"] else "abc\n" if argv[:2] == ["git", "merge-base"] else "", stderr="")
            if "heavy" in argv:
                done.returncode = 75   # all slots held: heavy gave up waiting
            return done
        out, err = io.StringIO(), io.StringIO()
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
            code = sb.cmd_preflight_pr(None, runner, time.time)
        self.assertEqual(code, 1)
        self.assertNotIn("timed out", out.getvalue())
        self.assertIn("no heavy slot", out.getvalue())
        self.assertIn("waiting for a slot", err.getvalue())
        for argv, kwargs in calls:
            if "heavy" in argv:
                self.assertNotIn("timeout", kwargs)   # no outer clock around the queue
                self.assertIn("FLEET_HEAVY_MAX_SECONDS", kwargs["env"])

    def test_exit_124_from_the_heavy_watchdog_is_a_timeout_line_with_its_ceiling(self):
        code, lines, calls = self.run_preflight(["x"])
        self.assertEqual({c[1]["env"]["FLEET_HEAVY_MAX_SECONDS"] for c in calls if "heavy" in c[0]}, {"240", "60"})
        calls_124 = []

        def runner(argv, **kwargs):
            done = mock.Mock(returncode=124 if "heavy" in argv else 0, stdout="/r\n", stderr="")
            return done
        out = io.StringIO()
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(io.StringIO()), mock.patch.object(sb, "preflight_load", lambda: (4.0, 4)):
            code = sb.cmd_preflight_pr(None, runner, time.time)
        self.assertEqual(code, 1)
        self.assertIn("FAIL cli-surface", out.getvalue())
        self.assertIn("timed out after 480s running, its ceiling (load average 4.0 on 4 cores)", out.getvalue())   # S2: 240 * (1 + 4/4)

    def test_s1_the_ceiling_grows_with_the_load_and_never_passes_the_maximum(self):
        low, high, absurd = (sb.preflight_ceiling(600, load, 8) for load in (1, 60, 1000))
        self.assertGreater(high, low)
        self.assertLessEqual(max(low, high), sb.PREFLIGHT_CEILING_MAX)
        self.assertEqual(absurd, sb.PREFLIGHT_CEILING_MAX)   # S3
        self.assertEqual(sb.preflight_ceiling(600, 0, 8), 600)
        self.assertEqual(sb.preflight_ceiling(600, "x", 0), 600)

    def test_s2_a_class_over_its_ceiling_says_it_timed_out(self):
        code, lines, _ = self.run_preflight(["x"], timing_out=("TestHygiene",))
        self.assertEqual(code, 1)
        self.assertIn("timed out after", [l for l in lines if l.startswith("FAIL hygiene")][0])

    def test_s3_a_cloud_change_runs_the_cloud_suites_with_a_49_character_tmpdir(self):
        code, lines, calls = self.run_preflight(["cloud/worker/guard.py"])
        self.assertEqual(code, 0)
        self.assertEqual(len([l for l in lines if l.startswith("PASS cloud")]), 1)
        envs = [c[1]["env"] for c in calls if "heavy" in c[0] and "cloud" in " ".join(c[0])]
        self.assertEqual(len(envs), 3)
        for env in envs:
            self.assertEqual(len(os.path.basename(env["TMPDIR"])), 49)
        self.assertEqual(len([c for c in calls if "heavy" in c[0]]), 6)

    def test_s4_it_only_runs_git_reads_and_heavy_tests_and_leaves_no_scratch(self):
        _, _, calls = self.run_preflight(["cloud/x"])
        for argv, kwargs in calls:
            self.assertTrue(argv[0] == "git" and argv[1] in ("rev-parse", "merge-base", "diff") or "heavy" in argv, argv)
            self.assertNotIn("gh", argv[0])
        scratch = {os.path.dirname(c[1]["env"]["TMPDIR"]) for c in calls if "TMPDIR" in c[1].get("env", {}) and "cloud" in " ".join(c[0])}
        self.assertTrue(scratch and not any(os.path.exists(d) for d in scratch))

    @classmethod
    def sentence_count(cls, text):
        return " ".join(text.split()).count(cls.SENTENCE)

    def test_s5_the_coordination_skill_names_the_command_once_and_the_count_is_exact(self):
        text = (REPO / "skills" / "fleet-coordination" / "SKILL.md").read_text()
        self.assertEqual(self.sentence_count(text), 1)
        self.assertEqual(self.sentence_count(text.replace(self.SENTENCE, "")), 0)
        self.assertEqual(self.sentence_count(text + "\n" + self.SENTENCE), 2)

    def test_s6_the_class_list_is_one_table_with_each_class_once(self):
        source = SWITCHBOARD.read_text()
        self.assertEqual(source.count("PREFLIGHT_CLASSES = ("), 1)
        table = source.split("PREFLIGHT_CLASSES = (", 1)[1].split("\n)\n", 1)[0]
        names = [row[0] for row in sb.PREFLIGHT_CLASSES]
        self.assertEqual(len(names), 4)
        for name in names:
            self.assertEqual(table.count('("%s",' % name), 1)


class TestFocusedLocalRuns(unittest.TestCase):
    """#942: the documented default (focused runs, CI runs the whole suite), the refusal of a second full-suite job in a worktree and the preflight skip of a sub-check
    CI runs. Real slot files and queue in a temp state directory, a fake worktree function, a stub script as the command; nothing real is run. Each family is ONE table;
    each row has a test and a mutant (the defence swapped for a weaker one with mock.patch, and the attack then succeeds)."""
    DEFAULT = "Run the focused classes of what you changed through `heavy --short`; CI runs the whole suite."
    EXCEPTION = "Run the whole suite only for a change to the CI workflow itself or to a test CI cannot run; say which in the pull request."
    REFUSAL = "The heavy wrapper refuses a second full-suite job in a worktree while one is queued or running."
    FILES = ("skills/fleet-coordination/SKILL.md", "agents/opencode/coder.md", "agents/copilot/coder.agent.md", "docs/switchboard.md")
    A, B = "/work/a", "/work/b"

    def setUp(self):
        self.init()
        self.addCleanup(self.cleanup)

    def reset(self):
        self.cleanup()
        self.init()

    def init(self):
        self.hs = sb.load_heavy_slots()
        self.dir = tempfile.mkdtemp()
        self.state = os.path.join(self.dir, "state")
        os.mkdir(self.state)
        self.script = os.path.join(self.dir, "test-fake")   # a program that classifies as full
        Path(self.script).write_text("#!/bin/sh\nexit 0\n")
        os.chmod(self.script, 0o755)
        self.bin = os.path.join(self.dir, "bin")   # the only PATH the child gets: a fake `timeout` (macOS ships none, Ubuntu ships GNU's); no real program is needed
        os.mkdir(self.bin)
        os.symlink(shutil.which("sh"), os.path.join(self.bin, "sh"))   # `sh -c` is on both runners
        self.fake_timeout()
        self.children, self.fds = [], []

    def cleanup(self):
        for child in self.children:
            child.kill()
            child.wait()
        for fd in self.fds:
            os.close(fd)
        self.children, self.fds = [], []
        shutil.rmtree(self.dir, True)

    def fake_timeout(self):
        path = os.path.join(self.bin, "timeout")
        Path(path).write_text('#!/bin/sh\nshift\nexec "$@"\n')   # drops the duration, runs the rest
        os.chmod(path, 0o755)

    def environ(self):
        return {"PATH": self.bin, "FLEET_HEAVY_NAME": "second"}

    def start(self, command, worktree, short=False, wait_max=1):
        out = io.StringIO()
        code = self.hs.run(command, self.state, 3, wait_max, "second", environ=self.environ(), out=out, short=short, worktree=lambda cwd: worktree)
        return code, out.getvalue()

    def hold(self, worktree, kind="full"):
        """A job RUNNING in `worktree`: a slot whose lock is held, with the record a wrapper writes."""
        fd = self.hs._take(self.state, 3)[0]
        self.fds.append(fd)
        self.hs._record(fd, "first", os.getpid(), "timeout", time.time(), {"kind": kind, "worktree": worktree, "program": "test-switchboard"})

    def queue(self, worktree, kind="full"):
        """A job QUEUED in `worktree`: an entry of a live process (a sleeping child) in the waiting line."""
        child = subprocess.Popen(["sleep", "60"])
        self.children.append(child)
        line = self.hs.Line(self.state, "first", pid=child.pid, meta={"kind": kind, "worktree": worktree, "program": "test-switchboard", "since": int(time.time())})
        line.place()
        # every slot busy, so the entry stays in the line (a ticket never outlives the slot its owner took)

    def fill(self):
        for _ in range(3):
            fd = self.hs._take(self.state, 3)[0]
            os.ftruncate(fd, 0)   # a busy slot that has no record (yet)
            self.fds.append(fd)

    # ---- THE refusal table: (id, how the first job exists, its worktree, the second command, the second's worktree, refused?)
    FULL, FOCUSED, WRAPPED = ["{s}"], ["{s}", "-k", "x"], ["timeout", "900", "{s}"]
    ROWS = (
        ("running-same-worktree", "run", "/work/a", FULL, "/work/a", True),
        ("queued-same-worktree", "queue", "/work/a", FULL, "/work/a", True),
        ("wrapped-in-timeout", "run", "/work/a", WRAPPED, "/work/a", True),
        ("focused-not-refused", "run", "/work/a", FOCUSED, "/work/a", False),
        ("other-worktree-not-refused", "run", "/work/a", FULL, "/work/b", False),
        ("first-ended-not-refused", "none", "/work/a", FULL, "/work/a", False),
        ("first-is-focused-not-refused", "run-focused", "/work/a", FULL, "/work/a", False),
        ("worktree-unknown-not-refused", "run", "/work/a", FULL, None, False),
    )

    def attempt(self, row):
        _id, how, first_tree, command, second_tree, _refused = row
        if how == "run":
            self.hold(first_tree)
        elif how == "run-focused":
            self.hold(first_tree, kind="focused")
        elif how == "queue":
            self.fill()
            self.queue(first_tree)
        command = [self.script if word == "{s}" else word for word in command]
        if how == "queue":   # the queue entry exists; the second run must be refused before it waits (a refusal needs no slot)
            return self.start(command, second_tree, wait_max=0)
        return self.start(command, second_tree)

    def test_every_row_of_the_refusal_table(self):
        for row in self.ROWS:
            with self.subTest(row=row[0]):
                self.reset()
                code, text = self.attempt(row)
                if row[5]:
                    self.assertEqual(code, 64)
                    self.assertIn("heavy: refused: a full-suite job is already queued or running in this worktree (first, test-switchboard, pid ", text)
                    self.assertIn(", since ", text)
                    if row[1] == "run":
                        self.assertIn("pid %d" % os.getpid(), text)
                else:
                    self.assertEqual(code, 0, text)
                    self.assertNotIn("refused", text)

    def test_a_mutant_without_the_fake_timeout_fails_the_wrapped_row_as_command_not_found_on_every_os(self):
        row = [r for r in self.ROWS if r[0] == "wrapped-in-timeout"][0]
        os.unlink(os.path.join(self.bin, "timeout"))
        self.hold(self.A)
        code, text = self.attempt(row)
        self.assertEqual(code, 127, text)

    def test_a_mutant_that_never_refuses_lets_every_refused_row_run(self):
        for row in self.ROWS:
            if row[5]:
                with self.subTest(row=row[0]), mock.patch.object(self.hs, "second_job_notice", lambda *a, **k: None):
                    self.reset()
                    self.assertNotEqual(self.attempt(row)[0], 64)

    def test_a_mutant_that_always_refuses_stops_every_allowed_row(self):
        for row in self.ROWS:
            if not row[5]:
                with self.subTest(row=row[0]), mock.patch.object(self.hs, "second_job_notice", lambda *a, **k: "heavy: refused: x"):
                    self.reset()
                    code = self.attempt(row)[0]
                    if row[4] is not None and row[0] != "focused-not-refused":   # a focused run or an unknown worktree never asks
                        self.assertEqual(code, 64)
                    else:
                        self.assertEqual(code, 0)

    def test_the_table_covers_every_kind_of_the_one_classifier(self):
        kinds = {kind for kind, _s, _m in self.hs.KINDS}
        probes = {"full": [], "focused": ["-k", "x"], "e2e": ["playwright", "test"], "other": ["ls"]}
        self.assertEqual(set(probes), kinds, "a kind with no probe")
        for kind, rest in probes.items():
            with self.subTest(kind=kind):
                self.reset()
                command = [self.script] + rest if kind in ("full", "focused") else rest
                self.hold(self.A)   # a full job is running in worktree A
                code, text = self.start(command, self.A) if kind in ("full", "focused") else (None, "")
                self.assertEqual(self.hs.classify(command), kind)
                self.assertEqual(code == 64, kind == "full") if code is not None else None

    def test_every_other_kind_runs_while_a_full_job_holds_the_worktree(self):
        for kind, rest in (("focused", ["-k", "x"]), ("other", None), ("e2e", None)):
            with self.subTest(kind=kind):
                self.reset()
                self.hold(self.A)
                if rest is None:
                    with mock.patch.object(self.hs, "classify", lambda command, short=False, kind=kind: kind):
                        code, text = self.start([self.script], self.A)
                else:
                    code, text = self.start([self.script] + rest, self.A)
                self.assertEqual(code, 0, text)

    def test_the_wrapper_is_a_visible_holder_before_it_leaves_the_line(self):
        seen = []
        real = self.hs.Line.leave

        def leave(line):
            seen.extend(i for i in self.hs._held_records(self.state) if i.get("worktree") == self.A and i.get("kind") == "full")
            return real(line)
        with mock.patch.object(self.hs.Line, "leave", leave):
            self.assertEqual(self.start([self.script], self.A)[0], 0)
        self.assertTrue(seen, "no record naming the worktree when the line was left")

    def test_the_marker_preflight_looks_for_is_in_the_text_the_wrapper_writes(self):
        hs = sb.load_heavy_slots()
        text = hs.second_job_notice(self.state_for_marker(), "/work/a", [{"kind": "full", "worktree": "/work/a", "name": "n", "pid": 1, "since": 1}])
        source = SWITCHBOARD.read_text()
        literal = re.search(r'"(heavy: refused: [^"]+)" in \(done\.stderr', source).group(1)
        self.assertTrue(text.startswith(literal), text)

    def state_for_marker(self):
        directory = tempfile.mkdtemp()
        self.addCleanup(shutil.rmtree, directory, True)
        return directory

    def test_a_test_that_itself_exits_64_is_a_plain_failure_not_a_refusal(self):
        def runner(argv, **kwargs):
            return mock.Mock(returncode=64 if "heavy" in argv else 0, stdout="/r\n", stderr="usage error\n" if "heavy" in argv else "")
        out = io.StringIO()
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(io.StringIO()), mock.patch.object(sb, "preflight_load", lambda: (0.0, 4)):
            self.assertEqual(sb.cmd_preflight_pr(None, runner, time.time), 1)
        self.assertIn("FAIL cli-surface (", out.getvalue())
        self.assertIn("exit 64:", out.getvalue())
        self.assertNotIn("refused", out.getvalue())

    def test_preflight_reports_a_refused_sub_check_as_a_fail_that_says_so(self):
        def runner(argv, **kwargs):
            done = mock.Mock(returncode=64 if "heavy" in argv else 0, stdout="/r\n", stderr="heavy: refused: a full-suite job is already queued or running in this worktree (first, x, pid 1, since t)\n" if "heavy" in argv else "")
            return done
        out = io.StringIO()
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(io.StringIO()), mock.patch.object(sb, "preflight_load", lambda: (0.0, 4)):
            self.assertEqual(sb.cmd_preflight_pr(None, runner, time.time), 1)
        self.assertIn("FAIL cli-surface (", out.getvalue())
        self.assertIn("refused: a full-suite job is already queued or running", out.getvalue())

    def test_u2_the_refusal_reads_the_kind_from_the_one_classifier(self):
        self.hold(self.A)
        with mock.patch.object(self.hs, "classify", lambda command, short=False: "focused"):
            self.assertEqual(self.start([self.script], self.A)[0], 0)
        with mock.patch.object(self.hs, "classify", lambda command, short=False: "full"):
            self.assertEqual(self.start(["sh", "-c", "true"], self.A)[0], 64)

    def test_u1_a_run_that_is_not_refused_prints_nothing_new_and_a_full_house_still_exits_75(self):
        code, text = self.start([self.script], self.A)
        self.assertEqual((code, text), (0, ""))
        self.fill()
        code, text = self.start([self.script], self.A, wait_max=0)
        self.assertEqual(code, 75)
        self.assertTrue(text.startswith("heavy: no slot after 0 s (3 of 3 busy: "), text)
        self.assertNotIn("refused", text)

    def test_s7_the_only_ceilings_are_the_per_kind_table(self):
        self.assertEqual(self.hs.KIND_DEFAULTS, {"e2e": 3600, "focused": 1800, "full": 5400, "other": 3600})
        names = sorted(name for name in vars(self.hs) if re.search(r"(CEIL|SECONDS|MAX_SECONDS|HARD_MAX)", name) and name.isupper())
        self.assertEqual(names, ["DEFAULT_MAX_SECONDS", "EXPRESS_SECONDS", "HARD_MAX_SECONDS", "KILL_GRACE_SECONDS", "POLL_SECONDS", "SWEEP_SECONDS", "WAIT_REPORT_SECONDS", "WATCH_SECONDS"])

    def test_the_worktree_is_the_git_toplevel_by_real_path(self):
        def repo(name):
            path = os.path.join(self.dir, name)
            os.makedirs(os.path.join(path, "sub"))
            subprocess.run(["git", "init", "-q", path], check=True)
            return path
        one, two = repo("one"), repo("two")
        link = os.path.join(self.dir, "link")
        os.symlink(one, link)
        top = os.path.realpath(one)
        self.assertEqual(self.hs.worktree_of(one), top)
        self.assertEqual(self.hs.worktree_of(os.path.join(one, "sub")), top)
        self.assertEqual(self.hs.worktree_of(os.path.join(link, "sub")), top)
        self.assertNotEqual(self.hs.worktree_of(two), top)
        self.assertIsNone(self.hs.worktree_of(os.path.join(self.dir, "state")))   # no git tree here (a temp dir): nothing is refused
        self.assertIsNone(self.hs.worktree_of(os.path.join(self.dir, "missing")))

    # ---- the words, once each, the same in every file
    def test_s2_s8_each_sentence_is_in_each_file_once_and_the_same_words(self):
        for path in self.FILES:
            text = " ".join((REPO / path).read_text().split())
            for sentence in (self.DEFAULT, self.EXCEPTION, self.REFUSAL):
                with self.subTest(path=path, sentence=sentence[:30]):
                    self.assertEqual(text.count(sentence), 1)

    def sentences_once(self, text):
        text = " ".join(text.split())
        return all(text.count(sentence) == 1 for sentence in (self.DEFAULT, self.EXCEPTION, self.REFUSAL))

    def test_a_mutant_that_drops_the_exception_or_words_it_differently_fails_the_same_check(self):
        for path in self.FILES:
            text = (REPO / path).read_text()
            self.assertTrue(self.sentences_once(text), path)
            for name, mutant in (("dropped", text.replace(self.EXCEPTION, "")), ("reworded", text.replace("to a test CI cannot run", "to a slow test")),
                                 ("doubled", text + "\n" + self.EXCEPTION)):
                with self.subTest(path=path, mutant=name):
                    self.assertFalse(self.sentences_once(mutant))

    def write_record(self, record):
        """A slot held by this test with `record` written WHOLE (truncated first); read back as the dict meant, before anything is asserted of it."""
        fd = self.hs._take(self.state, 3)[0]
        self.fds.append(fd)
        os.ftruncate(fd, 0)
        os.pwrite(fd, json.dumps(record).encode(), 0)
        self.assertEqual(self.hs._read_info(fd), record)
        return fd

    def dead_pid(self):
        dead = subprocess.Popen(["true"])
        dead.wait()
        return dead.pid

    LIVE_CASES = (   # (id, record fields, refused?)
        ("both-dead", {"pid": "DEAD", "wrapper": "DEAD"}, False),
        ("command-alive", {"pid": "LIVE", "wrapper": "DEAD"}, True),
        ("wrapper-alive", {"pid": "DEAD", "wrapper": "LIVE"}, True),
        ("pid-reused-by-another-process", {"pid": "LIVE", "cstart": "Mon Jan  1 00:00:00 1990", "wrapper": "DEAD"}, False),
        ("wrapper-pid-reused", {"pid": "DEAD", "wrapper": "LIVE", "wstart": "Mon Jan  1 00:00:00 1990"}, False),
        ("pid-with-its-real-start", {"pid": "LIVE", "cstart": "REAL", "wrapper": "DEAD"}, True),
    )

    def case(self, fields):
        live, dead = os.getpid(), self.dead_pid()
        record = {"kind": "full", "worktree": self.A, "name": "ghost", "program": "x", "since": 1}
        for key, value in fields.items():
            record[key] = live if value == "LIVE" else dead if value == "DEAD" else self.hs._start_of(live) if value == "REAL" else value
        return record

    def test_a_held_lock_is_refused_only_for_a_holder_that_is_really_running(self):
        for name, fields, refused in self.LIVE_CASES:
            with self.subTest(case=name):
                self.reset()
                self.write_record(self.case(fields))
                self.assertEqual(self.hs.second_job_notice(self.state, self.A, []) is not None, refused)

    def test_mutants_of_the_liveness_rule_flip_a_case(self):
        flips = {}
        for label, patch in (("always-live", mock.patch.object(self.hs, "_pid_alive", lambda pid, start=None: True)),
                             ("pid-only", mock.patch.object(self.hs, "LIVE_KEYS", (("pid", ""), ("wrapper", "")))),
                             ("wrapper-half-dropped", mock.patch.object(self.hs, "LIVE_KEYS", (("pid", "cstart"),))),
                             ("command-half-dropped", mock.patch.object(self.hs, "LIVE_KEYS", (("wrapper", "wstart"),)))):
            with patch:
                flips[label] = []
                for name, fields, refused in self.LIVE_CASES:
                    self.reset()
                    self.write_record(self.case(fields))
                    if (self.hs.second_job_notice(self.state, self.A, []) is not None) != refused:
                        flips[label].append(name)
        self.assertEqual(flips, {"always-live": ["both-dead", "pid-reused-by-another-process", "wrapper-pid-reused"],
                                 "pid-only": ["pid-reused-by-another-process", "wrapper-pid-reused"],
                                 "wrapper-half-dropped": ["wrapper-alive"], "command-half-dropped": ["command-alive", "pid-with-its-real-start"]})

    def test_a_malformed_record_is_read_without_error(self):
        self.assertIsNone(self.hs.second_job_notice(self.state, self.A, [{"kind": "full", "worktree": "/elsewhere"}]))
        text = self.hs.second_job_notice(self.state, self.A, [{"kind": "full", "worktree": self.A, "name": "\x1b[31mq", "pid": "x", "since": "y"}])
        self.assertIn("pid unknown, since unknown time", text)
        self.assertNotIn("\x1b", text)
        fd = self.hs._take(self.state, 3)[0]
        self.fds.append(fd)
        os.ftruncate(fd, 0)
        os.pwrite(fd, b'{"kind": "full", "worktree"', 0)   # cut off: no record
        self.assertIsNone(self.hs.second_job_notice(self.state, self.A, []))

    def test_the_sentences_name_roles_never_agents_or_people(self):
        for sentence in (self.DEFAULT, self.EXCEPTION, self.REFUSAL):
            self.assertNotRegex(sentence, r"(?i)\b(coder\d|cos\b|fleet-upkeep|adam\b)")

    def test_s1_the_docs_state_the_measured_cause_before_the_default(self):
        text = " ".join((REPO / "docs" / "switchboard.md").read_text().split())
        section = text.split("**Focused by default, one full-suite job per worktree (#942).**", 1)[1]
        before = section.split(self.DEFAULT, 1)[0]
        for figure in ("19 full local runs", "14 worktrees", "Five of the 14 worktrees", "upper bound"):
            self.assertIn(figure, before)
        self.assertEqual(text.count("**Focused by default, one full-suite job per worktree (#942).**"), 1)

    # ---- preflight: THE table of workflow cases (name, workflow text, changed files, expected job or None)
    PR_ON = "on:\n  pull_request:\n  push:\n    branches: [main]\n"
    JOB = ("jobs:\n  test-cloud:\n    runs-on: ubuntu-latest\n    steps:\n      - name: launcher\n        if: ${{ !cancelled() }}\n        run: |\n"
           "          bin/test-cloud-launcher 2>&1 | tee out.txt\n")

    def cases(self):
        wf = self.PR_ON + self.JOB
        return (
            ("runs-on-pull-request", wf, ["cloud/x"], "test-cloud"),
            ("workflow-does-not-name-it", wf.replace("bin/test-cloud-launcher", "bin/test-other"), ["cloud/x"], None),
            ("workflow-unreadable", None, ["cloud/x"], None),
            ("branch-changes-the-workflow", wf, ["cloud/x", ".github/workflows/test.yml"], None),
            ("no-pull-request-trigger", wf.replace("pull_request:", "workflow_dispatch:"), ["cloud/x"], None),
            ("job-level-condition", wf.replace("    runs-on", "    if: github.ref == 'x'\n    runs-on"), ["cloud/x"], None),
            ("step-continue-on-error", wf.replace("        run: |", "        continue-on-error: true\n        run: |"), ["cloud/x"], None),
            ("step-condition-it-may-not-run", wf.replace("${{ !cancelled() }}", "${{ github.ref == 'x' }}"), ["cloud/x"], None),
            ("only-a-name-or-comment", wf.replace("          bin/test-cloud-launcher 2>&1 | tee out.txt", "          # bin/test-cloud-launcher\n          true"), ["cloud/x"], None),
            ("changed-files-unknown", wf, None, None),
            ("job-continue-on-error-true", wf.replace("    runs-on", "    continue-on-error: true\n    runs-on"), ["cloud/x"], None),
            ("job-continue-on-error-expression", wf.replace("    runs-on", "    continue-on-error: ${{ matrix.x }}\n    runs-on"), ["cloud/x"], None),
            ("job-continue-on-error-false-counts", wf.replace("    runs-on", "    continue-on-error: false\n    runs-on"), ["cloud/x"], "test-cloud"),
            ("step-continue-on-error-expression", wf.replace("        run: |", "        continue-on-error: ${{ true }}\n        run: |"), ["cloud/x"], None),
            ("run-only-echoes-the-name", wf.replace("          bin/test-cloud-launcher 2>&1 | tee out.txt", "          echo bin/test-cloud-launcher"), ["cloud/x"], None),
            ("single-line-run-echo", wf.replace("        run: |\n          bin/test-cloud-launcher 2>&1 | tee out.txt", "        run: echo bin/test-cloud-launcher"), ["cloud/x"], None),
            ("single-line-run-counts", wf.replace("        run: |\n          bin/test-cloud-launcher 2>&1 | tee out.txt", "        run: bin/test-cloud-launcher"), ["cloud/x"], "test-cloud"),
            ("failure-swallowed-with-or-true", wf.replace("tee out.txt", "tee out.txt || true"), ["cloud/x"], None),
            ("failure-swallowed-with-set-plus-e", wf.replace("          bin/test-cloud-launcher", "          set +e\n          bin/test-cloud-launcher"), ["cloud/x"], None),
            ("mentioned-after-another-command", wf.replace("          bin/test-cloud-launcher", "          true; bin/test-cloud-launcher"), ["cloud/x"], None),
            ("list-form-trigger", wf.replace("on:\n  pull_request:\n  push:\n    branches: [main]\n", "on: [push, pull_request]\n"), ["cloud/x"], "test-cloud"),
            ("trigger-with-paths-filter", wf.replace("  pull_request:\n", "  pull_request:\n    paths: ['docs/**']\n"), ["cloud/x"], None),
            ("trigger-with-branches-filter", wf.replace("  pull_request:\n", "  pull_request:\n    branches: [main]\n"), ["cloud/x"], None),
            ("pull-request-target-only", wf.replace("  pull_request:\n", "  pull_request_target:\n"), ["cloud/x"], None),
        )

    def preflight(self, workflow, changed):
        calls = []
        root = tempfile.mkdtemp()
        self.addCleanup(shutil.rmtree, root, True)
        if workflow is not None:
            os.makedirs(os.path.join(root, ".github", "workflows"))
            Path(root, ".github", "workflows", "test.yml").write_text(workflow)

        def runner(argv, **kwargs):
            calls.append(list(argv))
            done = mock.Mock(returncode=0, stdout="", stderr="")
            if argv[:2] == ["git", "rev-parse"]:
                done.stdout = root + "\n"
            elif argv[:2] == ["git", "merge-base"]:
                done.stdout = "abc123\n" if changed is not None else ""
                done.returncode = 0 if changed is not None else 1
            elif argv[:2] == ["git", "diff"]:
                done.stdout = "\n".join(changed or [])
            return done
        out, err = io.StringIO(), io.StringIO()
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err), mock.patch.object(sb, "preflight_load", lambda: (0.0, 4)):
            code = sb.cmd_preflight_pr(None, runner, time.time)
        self.assertEqual([c[:2] for c in calls if c[0] == "git"], [c[:2] for c in calls if c[0] == "git" and c[1] in ("rev-parse", "merge-base", "diff")])
        heavy = [" ".join(c[c.index("--") + 1:]) for c in calls if "heavy" in c]
        return code, out.getvalue(), heavy

    def test_s3_s4_every_workflow_case(self):
        for name, workflow, changed, job in self.cases():
            with self.subTest(case=name):
                code, out, heavy = self.preflight(workflow, changed)
                launcher = [c for c in heavy if "bin/test-cloud-launcher" in c]
                self.assertEqual(code, 0)
                if job:
                    self.assertEqual(launcher, [])
                    self.assertIn("preflight-pr: cloud launcher: skipped, CI runs it for this pull request (job %s)\n" % job, out)
                else:
                    self.assertEqual(len(launcher), 1)
                    self.assertNotIn("skipped", out)

    def test_every_job_level_key_that_can_hide_a_failure_is_refused_at_job_and_step_level(self):
        wf = self.PR_ON + self.JOB
        for key in sb.PREFLIGHT_JOB_KEYS_HIDING:
            value = "'x'" if key == "if" else "true"
            with self.subTest(key=key, level="job"):
                self.assertIsNone(sb.workflow_job_running(wf.replace("    runs-on", "    %s: %s\n    runs-on" % (key, value)), "bin/test-cloud-launcher"))
            with self.subTest(key=key, level="step"):
                text = wf.replace("        run: |", "        %s: %s\n        run: |" % (key, value)).replace("        if: ${{ !cancelled() }}\n", "", 1 if key == "if" else 0)
                self.assertIsNone(sb.workflow_job_running(text, "bin/test-cloud-launcher"))
        self.assertEqual(sb.workflow_job_running(wf, "bin/test-cloud-launcher"), "test-cloud")

    def test_a_mutant_that_forgets_a_job_level_key_skips_a_suite_ci_cannot_fail_on(self):
        wf = self.PR_ON + self.JOB.replace("    runs-on", "    continue-on-error: true\n    runs-on")
        with mock.patch.object(sb, "PREFLIGHT_JOB_KEYS_HIDING", ("if",)):
            self.assertEqual(sb.workflow_job_running(wf, "bin/test-cloud-launcher"), "test-cloud")   # the weakened rule would skip it
        self.assertIsNone(sb.workflow_job_running(wf, "bin/test-cloud-launcher"))

    def test_the_skip_leaves_the_other_cloud_suites_and_classes_as_they_were(self):
        code, out, heavy = self.preflight(self.PR_ON + self.JOB, ["cloud/x"])
        self.assertEqual([c for c in heavy if "cloud" in c], ["bin/test-cloud-worker", "cloud/tests/test-cloud"])
        self.assertEqual(len(heavy), 5)
        self.assertEqual([l.split()[:2] for l in out.splitlines() if l.startswith("PASS")], [["PASS", "cli-surface"], ["PASS", "hygiene"], ["PASS", "public-names"], ["PASS", "cloud"]])

    def test_every_sub_check_of_every_class_is_skipped_only_when_the_table_says_so(self):
        every = [" ".join(command) for _n, _c, commands, _u in sb.PREFLIGHT_CLASSES for command in commands]
        skippable = {command for command, _shown in sb.PREFLIGHT_CI_SKIPS}
        self.assertTrue(skippable <= set(every), "a skip row for a command no class runs")
        steps = "".join("      - run: %s\n" % command for command in every)
        workflow = self.PR_ON + "jobs:\n  everything:\n    steps:\n" + steps
        code, out, heavy = self.preflight(workflow, ["cloud/x"])
        for command in every:
            with self.subTest(command=command):
                self.assertEqual(command in heavy, command not in skippable)

    def test_a_mutant_that_always_runs_or_always_skips_the_sub_check_fails_a_case(self):
        with mock.patch.object(sb, "preflight_ci_runs", lambda *a, **k: None):
            self.assertIn("bin/test-cloud-launcher", self.preflight(self.PR_ON + self.JOB, ["cloud/x"])[2])
        with mock.patch.object(sb, "preflight_ci_runs", lambda *a, **k: "any-job"):
            self.assertNotIn("bin/test-cloud-launcher", self.preflight(None, ["cloud/x"])[2])


class TestItemVerdicts(unittest.TestCase):
    """#770 (plan fleet-kit#777): verdicts for a work item that has no pull request. Temp dirs and fakes only. Each attack has a test and a mutant: the
    mutant is the weakened defence swapped in with mock.patch, and the same attack then SUCCEEDS (the test would fail on it)."""

    REPO, N, ITEM = "acme-org/widget-service", 777, "acme-org/widget-service#777"
    PIN, MOVED = "a" * 40, "b" * 40
    T0 = 1_000_000

    def setUp(self):
        self.iv = sb.load_module("item_verdicts")
        self.dir = tempfile.mkdtemp()
        self.addCleanup(shutil.rmtree, self.dir, True)
        self.state = Path(self.dir)
        self.clock = [self.T0]
        self.audit = []
        self.sessions = {"orch": "ses_o", "t1": "ses_t1", "t2": "ses_t2", "c1": "ses_c1", "n1": "ses_n1"}
        self.fleets = {"orch": {"role": "orchestrator", "repo": self.REPO, "charter": 587},
                       "t1": {"role": "tester", "repo": self.REPO, "reports_to": "orch", "launched_by": "orch", "issue": self.N},
                       "t2": {"role": "tester", "repo": self.REPO, "reports_to": "orch", "launched_by": "orch", "issue": 778},
                       "c1": {"role": "coder", "repo": self.REPO, "reports_to": "orch", "launched_by": "orch", "issue": self.N},
                       "n1": {"role": "coder", "repo": self.REPO, "reports_to": "orch", "launched_by": "orch", "issue": 700}}
        self.scenarios = [{"id": "S1", "evaluator": "tester", "proof": "live", "claim": "pr"},
                          {"id": "S2", "evaluator": "ci", "proof": "test", "claim": "pr"},
                          {"id": "S3", "evaluator": "tester", "proof": "measure", "claim": "epic"},
                          {"id": "S4", "evaluator": "tester", "proof": "measure"}]
        self.plan = {"result": "pass", "defects": [], "scenarios_parsed": self.scenarios, "plan_hash": "sha256:p", "text": "", "source": "plan"}
        self.pages = {}

    def now(self):
        return self.clock[0]

    def entries(self):
        return sb.plan_ledger.read_ledger(self.state)[0]

    def register(self, tester="t1", item=None, head=None, orch="orch", session=None):
        item = item or self.ITEM
        return sb.plan_ledger.append_entry(self.state, {"kind": "item_tester", "pr": item, "item": item, "tester": tester, "session": session or self.sessions.get(tester),
                                                         "orchestrator": orch, "head": head or self.PIN, "plan_ref": None, "by": orch}, self.now())

    def ctx(self, author="human", own=True, item=None):
        item = item or self.ITEM
        number = int(item.rsplit("#", 1)[1])

        class Audit:
            def append(inner, actor, event, subject=None, detail=None, **extra):
                self.audit.append((event, subject, detail))
        intents = types.SimpleNamespace(_api=lambda path, repo=None: self.pages[path] if path in self.pages else (_ for _ in ()).throw(sb.IntentError("not_found", path)))
        engine = types.SimpleNamespace(intents=intents, audit=Audit(), actor="t", herdr=None, v2=None)
        return types.SimpleNamespace(engine=engine, state=self.state, config={"plan_gates": {"repos": {self.REPO: {"item_checks": [{"name": "build", "app": "github-actions"}]}}}},
                                     repo=self.REPO, number=number, pr=item, item=item, entries=self.entries(), problem=None, facts={}, unreadable=None, source="plan",
                                     plan=self.plan, plan_problem=None, issue={"author": author, "body": "", "state": "open", "parent": None}, plan_own=own)

    def args(self, **kw):
        base = dict(item=self.ITEM, pr=None, plan=None, ask=None, head=None, scenario="S1", all_scenarios=False, evaluator="tester", result="pass", evidence="ran it", command=None)
        base.update(kw)
        return types.SimpleNamespace(**base)

    def verdict(self, caller, retired=None, **kw):
        """Run the real cmd_item_verdict as `caller`; (exit, why) where why is the refusal sentence or None."""
        launch = sb.load_launch_testers().launched(self.fleets, self.sessions, self.REPO, lambda f: f.get("repo"), retired or {})
        item = kw.get("item_key") or self.ITEM
        with mock.patch.object(sb, "item_context", lambda a, r, n, w: self.ctx(item=item)), mock.patch.object(sb, "identify_caller", lambda *a: caller), \
                mock.patch.object(sb, "item_agents", lambda c: (launch, self.sessions, self.fleets)):
            try:
                return sb.cmd_item_verdict(self.args(**{k: v for k, v in kw.items() if k != "item_key"}), None, self.now), None
            except sb.LedgerCommandError as err:
                return None, str(err)

    def verdicts(self):
        return [e for e in self.entries() if e.get("kind") == "verdict"]

    # ---- S1 / DW-1: the registration and the verdict
    def test_s1_a_registered_tester_records_a_verdict_for_its_item(self):
        self.register()
        code, why = self.verdict("t1")
        self.assertEqual((code, why), (sb.EXIT_OK, None))
        got = self.verdicts()
        self.assertEqual([(v["pr"], v["by"], v["head"], v["evaluator"]) for v in got], [(self.ITEM, "t1", self.PIN, "tester")])

    def test_s1_launch_registers_the_tester_for_that_item_by_the_switchboard(self):
        self.pages.update({"repos/%s/issues/777" % self.REPO: {"user": {"login": "human"}, "body": "PLAN: https://github.com/acme-org/widget-service/issues/777#issuecomment-1",
                                                               "state": "open", "parent_issue_url": "https://api.github.com/repos/acme-org/widget-service/issues/770"},
                           "repos/%s/issues/770" % self.REPO: {"parent_issue_url": "https://api.github.com/repos/acme-org/widget-service/issues/587"},
                           "repos/%s" % self.REPO: {"default_branch": "main"}, "repos/%s/commits/main" % self.REPO: {"sha": self.PIN}})
        agents = {n: types.SimpleNamespace(fleet=f) for n, f in self.fleets.items()}
        ctx = self.ctx()
        ctx.engine.discover = lambda now: types.SimpleNamespace(agents=agents)
        ctx.engine.now = lambda: self.now()
        ctx.engine.config = {}
        args = types.SimpleNamespace(role="tester", issue=777, name="t1", reports_to="orch")
        sb.register_item_tester(ctx.engine, self.state, args, self.REPO, "orch", {"session": "ses_t1"}, self.now)
        reg = self.iv.registrations(self.entries(), self.ITEM)
        self.assertEqual([(e["tester"], e["session"], e["orchestrator"], e["head"]) for e in reg], [("t1", "ses_t1", "orch", self.PIN)])
        self.assertEqual([a[0] for a in self.audit], ["plan.item.register"])
        # a launch run by a coder (not the orchestrator) registers nothing, and says why
        sb.register_item_tester(ctx.engine, self.state, args, self.REPO, "c1", {"session": "ses_t1"}, self.now)
        self.assertEqual(len(self.iv.registrations(self.entries(), self.ITEM)), 1)
        self.assertEqual(self.audit[-1][0], "plan.item.refused")

    def test_s2_a_tester_registered_for_item_a_cannot_write_for_item_b(self):
        self.register("t1")
        other = "acme-org/widget-service#778"
        code, why = self.verdict("t1", item_key=other)
        self.assertIsNone(code)
        self.assertIn("not registered", why)
        self.assertEqual(self.verdicts(), [])
        self.register("t2", item=other)
        self.assertEqual(self.verdict("t1", item_key=other)[0], None)     # t2 is registered for B; t1 still is not

    def test_s2_mutant_matching_on_role_and_repo_only_lets_it_through(self):
        self.register("t1")
        other = "acme-org/widget-service#778"
        with mock.patch.object(self.iv, "registration_problem", lambda *a: None), mock.patch.object(self.iv, "pinned", lambda e, i: self.PIN):
            code, why = self.verdict("t1", item_key=other)
        self.assertEqual(code, sb.EXIT_OK, "the mutant (no per-item registration) records a verdict for item B")

    # ---- S10: a forged or handmade launch record
    def test_s10_a_handmade_launch_record_with_no_switchboard_entry_registers_nothing(self):
        code, why = self.verdict("t1")          # the launch record is perfect (launched_by the orchestrator) but no ledger entry exists
        self.assertIsNone(code)
        self.assertIn("not registered", why)
        self.assertEqual(self.verdicts(), [])

    def test_s10_mutant_trusting_the_launch_record_alone_accepts_it(self):
        with mock.patch.object(self.iv, "registration_problem", lambda *a: None), mock.patch.object(self.iv, "pinned", lambda e, i: self.PIN):
            self.assertEqual(self.verdict("t1")[0], sb.EXIT_OK)

    def test_s10_a_coder_launching_its_own_tester_is_refused_by_the_launch_record_and_writes_no_registration(self):
        self.fleets["t1"]["launched_by"] = "c1"; self.fleets["t1"]["reports_to"] = "c1"
        self.register("t1", orch="c1")      # even a ledger entry naming the coder as the orchestrator cannot make it a launched tester
        code, why = self.verdict("t1")
        self.assertIsNone(code)
        self.assertIn("not a tester launched", why)

    def test_s10_a_replayed_ledger_line_breaks_the_chain(self):
        self.register()
        self.verdict("t1")
        path = self.state / sb.plan_ledger.LEDGER_FILE
        lines = path.read_text().splitlines()
        path.write_text("\n".join(lines + [lines[-1]]) + "\n")      # the verdict line copied once more
        self.assertIsNotNone(sb.plan_ledger.read_ledger(self.state)[1])

    # ---- S5: the reference commit does not move under the verdict
    def test_s5_a_verdict_names_the_pinned_commit_and_no_other(self):
        self.register()
        code, why = self.verdict("t1", head=self.MOVED)
        self.assertIsNone(code)
        self.assertIn("reference commit", why)
        self.assertEqual(self.verdicts(), [])
        self.assertEqual(self.verdict("t1", head=self.PIN)[0], sb.EXIT_OK)
        self.assertEqual(self.verdicts()[0]["head"], self.PIN)

    def test_s5_mutant_reading_the_tip_at_verdict_time_accepts_a_moved_commit(self):
        self.register()
        with mock.patch.object(self.iv, "pinned", lambda e, i: self.MOVED):
            code, why = self.verdict("t1", head=self.MOVED)
        self.assertEqual(code, sb.EXIT_OK, "the mutant stamps whatever the tip is now")

    def test_s5_a_new_registration_voids_the_verdicts_at_the_old_commit(self):
        self.register()
        self.verdict("t1")
        self.clock[0] += 60
        self.register("t1", head=self.MOVED)
        report = sb.item_gates_report(self.ctx(), set())
        row = next(r for r in report["scenarios"] if r["id"] == "S1")
        self.assertEqual(row["status"], "missing")
        self.assertTrue(any("head moved" in v for v in row["void"]))

    # ---- S3/S4: CI verdicts of the repository's own checks
    RUN = {"name": "build", "status": "completed", "conclusion": "success", "app": {"slug": "github-actions"}}

    def ci(self, runs, on_branch=True, checks=True):
        self.register()
        self.pages.update({"repos/%s" % self.REPO: {"default_branch": "main"},
                           "repos/%s/compare/main...%s" % (self.REPO, self.PIN): {"status": "identical" if on_branch else "diverged"},
                           "repos/%s/commits/%s/check-runs?per_page=100" % (self.REPO, self.PIN): {"check_runs": runs}})
        ctx = self.ctx()
        if not checks:
            ctx.config = {"plan_gates": {"repos": {self.REPO: {}}}}
        with mock.patch.object(sb, "item_context", lambda a, r, n, w: ctx):
            try:
                return sb.cmd_item_ci_record(types.SimpleNamespace(rest=[self.ITEM], plan=None, ask=None), None, self.now), None
            except sb.LedgerCommandError as err:
                return None, str(err)

    def test_s3_every_listed_check_green_at_the_reference_commit_records_one_ci_verdict_by_the_recorder(self):
        self.assertEqual(self.ci([self.RUN])[0], sb.EXIT_OK)
        got = self.verdicts()
        self.assertEqual([(v["scenario"], v["by"], v["head"], v["evaluator"]) for v in got], [("S2", sb.plan_ledger.CI_RECORDER, self.PIN, "ci")])
        self.assertEqual([a[0] for a in self.audit if a[0] == "plan.item.ci_record"], ["plan.item.ci_record"])

    def test_s3_an_agent_cannot_type_a_ci_verdict_for_an_item(self):
        self.register()
        code, why = self.verdict("t1", scenario="S2", evaluator="ci")
        self.assertIsNone(code)
        self.assertIn("ci", why)
        self.assertEqual(self.verdicts(), [])

    def test_s4_nothing_configured_a_same_named_check_of_another_app_or_a_commit_off_the_branch_records_nothing(self):
        other = dict(self.RUN, app={"slug": "evil-workflow"})
        for runs, kwargs, reason in (([self.RUN], {"checks": False}, "no item_checks"), ([other], {}, "no run of build by github-actions"), ([self.RUN], {"on_branch": False}, "not on the default branch"),
                                     ([dict(self.RUN, conclusion="failure")], {}, "did not succeed"), ([dict(self.RUN, status="in_progress", conclusion=None)], {}, "not complete")):
            self.setUp()
            code, why = self.ci(runs, **kwargs)
            self.assertIsNone(code, (runs, kwargs))
            self.assertIn(reason, why)
            self.assertEqual(self.verdicts(), [], (runs, kwargs))

    def test_s4_mutant_matching_a_check_by_name_alone_records_the_faked_one(self):
        other = dict(self.RUN, app={"slug": "evil-workflow"})
        real = self.iv.ci_decision
        by_name = lambda runs, checks: real(runs, [dict(c, app=r["app"]["slug"]) for c in checks for r in runs[:1]] if runs else checks)
        with mock.patch.object(self.iv, "ci_decision", by_name):
            self.assertEqual(self.ci([other])[0], sb.EXIT_OK, "the mutant accepts the same-named run of another app")

    def test_s4_the_item_checks_key_is_validated_by_its_own_module_and_defaults_to_none(self):
        self.assertEqual(self.iv.validate_item_checks(None, "c"), [])
        self.assertEqual(self.iv.validate_item_checks([{"name": "build", "app": "github-actions"}], "c"), [{"name": "build", "app": "github-actions"}])
        for bad in ("build", [{"name": "build"}], [{"name": "", "app": "x"}], [{"name": "a", "app": "b", "x": 1}], [{"name": "a", "app": "b"}] * 2):
            with self.assertRaises(ValueError):
                self.iv.validate_item_checks(bad, "c")
        raw = {"repos": {self.REPO: {"item_checks": [{"name": "build", "app": "github-actions"}]}}}
        self.assertEqual(sb.plan_ledger.validate_plan_gates(raw, "c")["repos"][self.REPO]["item_checks"], raw["repos"][self.REPO]["item_checks"])
        self.assertNotIn("item_checks", sb.plan_ledger.validate_plan_gates({"repos": {self.REPO: {}}}, "c")["repos"][self.REPO])

    # ---- S6/S7: the item-level claim
    def test_s6_an_item_claims_only_pr_scenarios_never_an_ask_level_live_one(self):
        self.register()
        code, why = self.verdict("t1", all_scenarios=True, scenario=None, head=self.PIN)
        self.assertEqual(code, sb.EXIT_OK)
        self.assertEqual([v["scenario"] for v in self.verdicts()], ["S1"])        # S3 is claim: epic, S4 is tester + measure with no claim (read as epic)
        for sid in ("S3", "S4"):
            code, why = self.verdict("t1", scenario=sid)
            self.assertIsNone(code)
            self.assertIn("epic", why)
        self.assertEqual(len(self.verdicts()), 1)

    def test_s6_mutant_giving_the_item_every_scenario_claims_the_live_one(self):
        self.register()
        with mock.patch.object(sb.plan_ledger, "claim_of", lambda s: "pr"):
            self.verdict("t1", all_scenarios=True, scenario=None, head=self.PIN)
        self.assertIn("S3", [v["scenario"] for v in self.verdicts()])

    def test_s7_an_item_that_links_the_asks_plan_claims_only_what_is_sliced_to_it(self):
        self.register()
        self.scenarios[0]["slice"] = "#778"
        self.scenarios.append({"id": "S5", "evaluator": "tester", "proof": "live", "claim": "pr", "slice": "#777"})
        launch = sb.load_launch_testers().launched(self.fleets, self.sessions, self.REPO, lambda f: f.get("repo"), {})
        results = {}
        for sid in ("S1", "S5"):
            with mock.patch.object(sb, "item_context", lambda a, r, n, w: self.ctx(own=False)), mock.patch.object(sb, "identify_caller", lambda *a: "t1"), \
                    mock.patch.object(sb, "item_agents", lambda c: (launch, self.sessions, self.fleets)):
                try:
                    results[sid] = sb.cmd_item_verdict(self.args(scenario=sid), None, self.now)
                except sb.LedgerCommandError as err:
                    results[sid] = str(err)
        self.assertIn("not sliced", results["S1"])
        self.assertEqual(results["S5"], sb.EXIT_OK)
        self.assertEqual([v["scenario"] for v in self.verdicts()], ["S5"])

    # ---- S8: independence
    def test_s8_the_author_notifier_orchestrator_the_orchestrators_coder_and_a_coders_session_are_refused(self):
        self.register()
        self.fleets["nt"] = {"role": "tester", "repo": self.REPO, "reports_to": "orch", "launched_by": "orch", "issue": self.N}
        self.sessions["nt"] = self.sessions["c1"]            # a tester running in the session of the item's coder
        self.register("nt")
        self.fleets["human"] = {"role": "tester", "repo": self.REPO, "reports_to": "orch", "launched_by": "orch", "issue": self.N}
        self.sessions["human"] = "ses_h"
        self.register("human")                                # a tester that is also the issue's GitHub author
        self.fleets["wk"] = {"role": "coder", "repo": self.REPO, "reports_to": "orch", "launched_by": "orch", "issue": 700}   # the orchestrator's coder on ANOTHER item (the notifier)
        self.sessions["wk"] = "ses_wk"
        reasons = {}
        for who in ("human", "c1", "wk", "nt"):
            if who in ("c1", "wk"):
                self.register(who)
            code, why = self.verdict(who)
            self.assertIsNone(code, who)
            reasons[who] = why
        self.assertIn("wrote or runs", reasons["human"])        # the issue's author, a launched tester
        self.assertIn("wrote or runs", reasons["nt"])           # a launched tester in the session of the item's coder
        self.assertIn("not a tester launched", reasons["c1"])   # the coders are no launched testers at all
        self.assertIn("not a tester launched", reasons["wk"])
        self.assertEqual(self.verdicts(), [])
        writers = self.iv.excluded(self.ITEM, self.N, None, "human", self.entries(), self.fleets, self.sessions)
        self.assertTrue({"orch", "c1", "wk", "human", "nt"} <= writers)       # the exclusion itself, whatever else refuses first
        self.assertEqual(self.iv.verdict_problem(self.ITEM, "wk", self.entries(), writers, "ses_wk", self.now(), self.PIN)[:2], "wk")

    def test_s8_mutant_excluding_only_the_issue_author_records_the_others(self):
        for who in ("c1", "wk"):
            self.fleets[who] = dict(self.fleets.get(who, {}), role="tester", repo=self.REPO, reports_to="orch", launched_by="orch", issue=self.N)
            self.sessions.setdefault(who, "ses_" + who)
            self.register(who)
        with mock.patch.object(self.iv, "excluded", lambda item, number, ask, author, entries, fleets, sessions: {author}):
            codes = [self.verdict(who)[0] for who in ("c1",)]
        self.assertEqual(codes, [sb.EXIT_OK], "the mutant lets the orchestrator's other worker record")

    def test_s9_a_tester_that_later_proves_for_the_item_loses_its_verdicts_at_read_time(self):
        self.register()
        self.verdict("t1")
        before = sb.item_gates_report(self.ctx(), self.iv.excluded(self.ITEM, self.N, None, "human", self.entries(), self.fleets, self.sessions))
        self.assertEqual(next(r for r in before["scenarios"] if r["id"] == "S1")["verdict"]["by"], "t1")
        self.assertEqual(self.prove("t1")[0], sb.EXIT_OK)
        after = sb.item_gates_report(self.ctx(), self.iv.excluded(self.ITEM, self.N, None, "human", self.entries(), self.fleets, self.sessions))
        row = next(r for r in after["scenarios"] if r["id"] == "S1")
        self.assertEqual(row["status"], "missing")
        self.assertTrue(any("author" in m for m in row["missing"]))

    def test_s9_mutant_computing_the_writers_at_write_time_only_still_reads_ok(self):
        self.register()
        self.verdict("t1")
        self.assertEqual(self.prove("t1")[0], sb.EXIT_OK)
        report = sb.item_gates_report(self.ctx(), set())          # the mutant reads with no writers
        self.assertEqual(next(r for r in report["scenarios"] if r["id"] == "S1")["status"], "ok")

    def test_s17_a_registered_tester_that_reports_done_keeps_its_verdict_and_a_coders_report_excludes_the_coder(self):
        self.register()
        self.assertEqual(self.prove("c1")[0], sb.EXIT_OK)
        self.assertEqual(self.verdict("t1")[0], sb.EXIT_OK)
        writers = self.iv.excluded(self.ITEM, self.N, None, "human", self.entries(), self.fleets, self.sessions)   # a report by t1 adds nobody: reports are not read
        self.assertNotIn("t1", writers)
        self.assertIn("c1", writers)
        report = sb.item_gates_report(self.ctx(), writers)
        self.assertEqual(next(r for r in report["scenarios"] if r["id"] == "S1")["status"], "ok")
        self.register("c1")
        self.assertIsNone(self.verdict("c1")[0])

    def test_s18_a_registration_expires_after_24_hours_and_ends_with_the_session_or_retirement(self):
        self.register()
        self.clock[0] += 23 * 3600
        self.assertEqual(self.verdict("t1")[0], sb.EXIT_OK)
        self.clock[0] += 2 * 3600
        code, why = self.verdict("t1")
        self.assertIsNone(code)
        self.assertIn("registration expired", why)
        self.register()                                      # a fresh registration for ses_t1
        self.sessions["t1"] = "ses_other"                    # the tester now runs in another session
        code, why = self.verdict("t1")
        self.assertIsNone(code)
        self.assertIn("another session", why)
        self.sessions["t1"] = "ses_t1"
        code, why = self.verdict("t1", retired={"t1": {"session": None}})
        self.assertIsNone(code)
        self.assertIn("not a tester launched", why)

    def test_s18_mutant_never_expiring_records_at_25_hours(self):
        self.register()
        self.clock[0] += 25 * 3600
        with mock.patch.object(self.iv, "TTL", 10 ** 9):
            self.assertEqual(self.verdict("t1")[0], sb.EXIT_OK)

    def test_a_replayed_verdict_at_an_old_commit_is_refused_after_a_repin(self):
        self.register()
        self.clock[0] += 60
        self.register("t1", head=self.MOVED)
        code, why = self.verdict("t1", head=self.PIN)
        self.assertIsNone(code)
        self.assertIn("reference commit", why)

    # ---- S12: audit
    def test_s12_a_registration_a_verdict_and_a_refusal_are_audited_with_the_item_the_writer_and_the_reference_commit(self):
        self.register()
        self.verdict("t1")
        self.verdict("c1")
        self.verdict("t1", head=self.MOVED)
        events = {e: d for e, s, d in self.audit}
        self.assertEqual(events["plan.item.verdict"]["by"], "t1")
        self.assertEqual((events["plan.item.verdict"]["item"], events["plan.item.verdict"]["reference_commit"]), (self.ITEM, self.PIN))
        refused = [d for e, s, d in self.audit if e == "plan.item.refused"]
        self.assertEqual([r["item"] for r in refused], [self.ITEM] * 2)
        self.assertEqual(sorted(r["by"] for r in refused), ["c1", "t1"])
        self.assertTrue(all(r["reference_commit"] == self.PIN for r in refused))

    # ---- S13 to S15: the draft line
    def g4(self, **facts):
        report = sb.plan_ledger.evaluate_gates(None, [], None, dict({"head": "a" * 40}, **facts), "acme-org/widget-service#9")
        return next(r for r in report["gates"] if r["gate"] == "G4")["missing"]

    def test_s13_a_draft_pr_with_no_ci_says_the_draft_line(self):
        self.assertEqual(self.g4(ci="none", draft=True), ["draft: no CI run seen; this repo's workflow may skip drafts; mark ready, then wait"])

    def test_s14_a_ready_pr_with_a_failing_check_or_an_unknown_draft_flag_keeps_the_failing_line(self):
        line = ["CI is failing (needs green at the head, or a second agent's re-run)"]
        self.assertEqual(self.g4(ci="failing", draft=False), line)
        self.assertEqual(self.g4(ci="failing", draft=True), line)      # a draft that HAS runs and a failing check: the failing line
        self.assertEqual(self.g4(ci="failing"), line)
        self.assertEqual(self.g4(ci="failing", draft=None), line)

    def test_s15_the_draft_flag_comes_from_isdraft_not_from_the_title(self):
        data = {"title": "draft: x", "state": "OPEN", "headRefOid": "a" * 40, "isDraft": False}
        self.assertIs(sb.pr_facts_from(data)["draft"], False)
        self.assertIs(sb.pr_facts_from(dict(data, title="x", isDraft=True))["draft"], True)
        self.assertIn("isDraft", sb.PR_VIEW_FIELDS.split(","))

    # ---- U2 / U3
    def test_u2_a_pull_request_number_is_refused_on_the_item_path_and_nothing_changes_for_pr(self):
        self.pages["repos/%s/issues/9" % self.REPO] = {"pull_request": {"url": "x"}, "user": {"login": "a"}}
        engine = self.ctx().engine
        with self.assertRaises(sb.LedgerCommandError) as raised:
            sb.item_issue(engine, self.REPO, 9)
        self.assertIn("is a pull request", str(raised.exception))
        self.assertEqual(sb.plan_ledger.KINDS[:13], ("proof", "verdict", "consensus", "waiver", "round", "lane_session", "lane", "response", "escalation", "decision", "abandoned", "reminder", "review_record"))

    def test_u3_a_ledger_with_item_entries_reads_with_the_chain_intact_and_read_ledger_never_looks_at_kinds(self):
        self.register()
        self.verdict("t1")
        self.assertEqual(sb.plan_ledger.read_ledger(self.state)[1], None)
        tree = ast.parse(Path(sb.plan_ledger.__file__).read_text())
        func = next(n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name == "read_ledger")
        names = {n.id for n in ast.walk(func) if isinstance(n, ast.Name)}
        self.assertFalse(names & {"KINDS", "ITEM_KINDS", "EVIDENCE_KINDS"}, "read_ledger must not judge kinds: an older build must read a ledger with item entries")

    # ---- item-prove and the refusals of the registration
    def prove(self, caller, sid="S1", item_key=None):
        args = types.SimpleNamespace(item=item_key or self.ITEM, scenario=[sid], plan=None, ask=None, head=None, evidence="ran it", result="pass", command=None)
        with mock.patch.object(sb, "item_context", lambda a, r, n, w: self.ctx()), mock.patch.object(sb, "identify_caller", lambda *a: caller):
            try:
                return sb.cmd_item_prove(args, None, self.now), None
            except sb.LedgerCommandError as err:
                return None, str(err)

    def test_item_prove_records_at_the_reference_commit_audits_it_and_makes_its_author_an_excluded_writer(self):
        code, why = self.prove("c1")
        self.assertIsNone(code)
        self.assertIn("no reference commit", why)              # nothing is registered yet
        self.register()
        self.assertEqual(self.prove("c1")[0], sb.EXIT_OK)
        proofs = [e for e in self.entries() if e.get("kind") == "proof"]
        self.assertEqual([(e["pr"], e["by"], e["head"], e["scenario"]) for e in proofs], [(self.ITEM, "c1", self.PIN, "S1")])
        self.assertIn("plan.item.proof", [a[0] for a in self.audit])
        self.assertEqual(self.prove("t1", sid="S2")[0], sb.EXIT_OK)      # a tester that proves becomes an author: its verdict is then refused
        code, why = self.verdict("t1")
        self.assertIsNone(code)
        self.assertIn("wrote or runs", why)
        self.assertEqual(self.prove("c1", sid="S3")[0], sb.EXIT_PARTIAL)   # an epic-claimed scenario is not claimed by an item
        self.assertEqual(len([e for e in self.entries() if e.get("kind") == "proof"]), 2)    # c1's S1 and t1's S2; S3 recorded nothing

    def register_world(self, **page_changes):
        self.pages.update({"repos/%s/issues/777" % self.REPO: {"user": {"login": "human"}, "body": "", "state": "open", "parent_issue_url": "https://api.github.com/repos/acme-org/widget-service/issues/770"},
                           "repos/%s/issues/770" % self.REPO: {"parent_issue_url": "https://api.github.com/repos/acme-org/widget-service/issues/587"},
                           "repos/%s" % self.REPO: {"default_branch": "main"}, "repos/%s/commits/main" % self.REPO: {"sha": self.PIN}})
        self.pages.update(page_changes)
        agents = {n: types.SimpleNamespace(fleet=f) for n, f in self.fleets.items()}
        ctx = self.ctx()
        ctx.engine.discover = lambda now: types.SimpleNamespace(agents=agents)
        ctx.engine.now = lambda: self.now()
        ctx.engine.config = {}
        return ctx.engine

    def register_try(self, engine, launched_by="orch", reports_to="orch"):
        err = io.StringIO()
        with contextlib.redirect_stderr(err):
            sb.register_item_tester(engine, self.state, types.SimpleNamespace(role="tester", issue=777, name="t1", reports_to=reports_to), self.REPO, launched_by,
                                    {"session": "ses_t1"}, self.now)
        return len(self.iv.registrations(self.entries(), self.ITEM)), [a for a in self.audit if a[0].startswith("plan.item.")]

    def test_every_refusal_of_a_registration_writes_no_entry_and_audits_why(self):
        issue = "repos/%s/issues/777" % self.REPO
        base = {"user": {"login": "human"}, "body": "", "state": "open", "parent_issue_url": "https://api.github.com/repos/acme-org/widget-service/issues/770"}
        cases = (("is not open", dict(self.pages, **{issue: dict(base, state="closed")}), {}),
                 ("does not reach", {}, {"orch_charter": 999}),
                 ("could not be read", {"repos/%s/commits/main" % self.REPO: {"sha": "xyz"}}, {}),
                 ("not run by an orchestrator", {}, {"launched_by": "c1"}),
                 ("report to the orchestrator", {}, {"reports_to": "c1"}))
        for reason, changes, extra in cases:
            self.setUp()
            self.fleets["orch"]["charter"] = extra.get("orch_charter", 587)
            engine = self.register_world(**({issue: dict(base, state="closed")} if reason == "is not open" else changes))
            count, audit = self.register_try(engine, launched_by=extra.get("launched_by", "orch"), reports_to=extra.get("reports_to", "orch"))
            self.assertEqual(count, 0, reason)
            self.assertEqual([a[0] for a in audit], ["plan.item.refused"], reason)
            self.assertIn(reason, audit[0][2]["why"])
        self.setUp()                                           # a pull request number: this path does not apply, and says nothing
        engine = self.register_world(**{issue: {"pull_request": {"url": "x"}, "user": {"login": "a"}}})
        self.assertEqual(self.register_try(engine), (0, []))
        self.assertTrue(self.iv.lane_ok([777, 770, 587], 587))
        self.assertFalse(self.iv.lane_ok([777, 770], 587))
        self.assertFalse(self.iv.lane_ok([777], None))

    # ---- the pull request commands never write for an item; gates item reads only what the item path wrote; the read fails closed; the append re-checks
    def pr_path(self, command, caller="t2", picture=(None, "PLAN: acme-org/widget-service#777", [], "no pull request found"), **kw):
        """Run an ORDINARY pull request command (`prove`, `verdict`, `gates ci-record`, `waive`) with --pr naming the item's number."""
        args = types.SimpleNamespace(pr=self.ITEM, plan=None, ask=None, head=self.PIN, scenario="S1", all_scenarios=False, evaluator="tester", result="pass", evidence="x",
                                     command=None, gates="G1", reason="a long enough reason to waive")
        for k, v in kw.items():
            setattr(args, k, v)
        ctx = self.ctx()
        launch = sb.load_launch_testers().launched(self.fleets, self.sessions, self.REPO, lambda f: f.get("repo"), {})
        with mock.patch.object(sb, "build_engine", lambda *a, **k: (ctx.engine, self.state, {"intent_repo": self.REPO})), mock.patch.object(sb, "pr_picture", lambda *a: picture), \
                mock.patch.object(sb, "identify_caller", lambda *a: caller), mock.patch.object(sb, "checked_plan", lambda *a, **k: self.plan), \
                mock.patch.object(sb, "launched_testers_for", lambda c: (launch, self.sessions, self.fleets)), mock.patch.object(sb, "gates_caller_kind", lambda *a: ("agent", "x", "chief-of-staff")):
            try:
                return getattr(sb, command)(args, None, self.now), None
            except sb.LedgerCommandError as err:
                return None, str(err)

    def issue_page(self):
        self.pages["repos/%s/issues/777" % self.REPO] = {"user": {"login": "human"}, "body": "", "state": "open"}

    def test_a_pull_request_command_refuses_an_issue_number_and_writes_nothing(self):
        self.issue_page()
        self.register("t1")
        self.register("t2", item="acme-org/widget-service#778", head=self.MOVED)
        before = len(self.entries())
        for command in ("cmd_prove", "cmd_verdict", "cmd_gates_ci_record", "cmd_waive"):
            for caller in ("t2", "t1"):         # a tester registered for ANOTHER item, and the tester registered for this one
                code, why = self.pr_path(command, caller=caller, scenario=["S1"] if command == "cmd_prove" else "S1", pr=self.ITEM)
                self.assertIsNone(code, (command, caller))
                self.assertTrue("work item" in why or "is an issue" in why, (command, caller, why))
        self.assertEqual(len(self.entries()), before)           # nothing was written by any of them

    def test_a_pull_request_command_refuses_an_issue_number_that_has_no_registration_too(self):
        self.issue_page()
        for command in ("cmd_verdict", "cmd_prove"):
            code, why = self.pr_path(command, scenario=["S1"] if command == "cmd_prove" else "S1")
            self.assertIsNone(code)
            self.assertIn("is an issue, not a pull request", why)
        self.assertEqual(self.entries(), [])

    def test_mutant_without_the_refusal_the_pull_request_command_writes_the_item_verdict_around_every_defence(self):
        self.issue_page()
        sb.plan_ledger.append_entry(self.state, {"kind": "proof", "pr": self.ITEM, "scenario": "S9", "plan_hash": "sha256:p", "head": self.PIN, "result": "pass", "by": "c1"}, self.now())
        with mock.patch.object(sb, "item_entry_refusal", lambda *a: None):
            code, why = self.pr_path("cmd_verdict")              # t2 is registered for nothing, and there is no registration for the item
        self.assertEqual(code, sb.EXIT_OK, why)
        forged = [e for e in self.entries() if e.get("kind") == "verdict"]
        self.assertEqual([(e["by"], e["pr"]) for e in forged], [("t2", self.ITEM)])
        # and with the refusal in place the same call is refused (the real guard), while gates item would ignore the entry anyway
        self.assertIsNone(self.pr_path("cmd_verdict")[0])

    def test_a_real_pull_request_is_unaffected_by_the_refusal(self):
        self.issue_page()
        facts = {"head": self.PIN, "ci": "green"}
        ctx = self.ctx()
        ctx.engine.intents = types.SimpleNamespace(_api=lambda *a, **k: (_ for _ in ()).throw(AssertionError("a readable pull request must not be looked up as an issue")))
        with mock.patch.object(sb, "pr_picture", lambda *a: (facts, "", [], None)):
            args = types.SimpleNamespace(pr="acme-org/widget-service#9", plan=None, ask=None)
            got = sb._ledger_context(args, None, self.now, True, parts=(ctx.engine, self.state, {"intent_repo": self.REPO}))
        self.assertEqual((got.pr, got.facts["head"]), ("acme-org/widget-service#9", self.PIN))

    def test_gates_item_ignores_an_entry_it_cannot_tie_to_the_item_path(self):
        self.register("t1")
        entry = {"plan_hash": "sha256:p", "head": self.PIN, "result": "pass", "pr": self.ITEM, "scenario": "S1"}
        sb.plan_ledger.append_entry(self.state, dict(entry, kind="proof", by="c9"), self.now())
        sb.plan_ledger.append_entry(self.state, dict(entry, kind="verdict", by="t2", evaluator="tester"), self.now())       # what the pull request path used to write
        writers = self.iv.excluded(self.ITEM, self.N, None, "human", self.entries(), self.fleets, self.sessions)
        report = sb.item_gates_report(self.ctx(), writers)
        row = next(r for r in report["scenarios"] if r["id"] == "S1")
        self.assertEqual(row["status"], "missing")
        self.assertEqual((row["proof"], row["verdict"]), (None, None))
        with mock.patch.object(self.iv, "visible", lambda entries, item, recorder: entries):         # mutant: no tie to the item path
            row = next(r for r in sb.item_gates_report(self.ctx(), writers)["scenarios"] if r["id"] == "S1")
        self.assertEqual(row["status"], "ok")

    def test_a_tester_verdict_counts_only_for_a_tester_registered_when_it_wrote_it(self):
        self.register("t1")
        self.assertEqual(self.prove("c1")[0], sb.EXIT_OK)
        self.assertEqual(self.verdict("t1")[0], sb.EXIT_OK)
        good = next(e for e in self.entries() if e.get("kind") == "verdict")
        self.assertTrue(self.iv.tied(good, self.entries(), sb.plan_ledger.CI_RECORDER))
        self.clock[0] += 3 * 24 * 3600                                  # read long after the registration expired (a finished, retired tester keeps its verdicts)
        self.assertTrue(self.iv.tied(good, self.entries(), sb.plan_ledger.CI_RECORDER))
        for forged in (dict(good, session="ses_other"), dict(good, by="t2"), dict(good, via="pr"), dict(good, seq=1)):
            self.assertFalse(self.iv.tied(forged, self.entries(), sb.plan_ledger.CI_RECORDER), forged)
        stale = dict(good, ts=good["ts"] + self.iv.TTL + 1)             # written after the registration had expired
        self.assertFalse(self.iv.tied(stale, self.entries(), sb.plan_ledger.CI_RECORDER))

    def unreadable_world(self):
        self.register("t1")
        self.fleets["nt"] = {"role": "tester", "repo": self.REPO, "reports_to": "orch", "launched_by": "orch", "issue": self.N}
        self.sessions["nt"] = self.sessions["c1"]                       # a tester in the session of the item's coder
        self.register("nt")
        self.assertEqual(self.prove("c1")[0], sb.EXIT_OK)
        sb.plan_ledger.append_entry(self.state, {"kind": "verdict", "pr": self.ITEM, "scenario": "S1", "plan_ref": "plan", "plan_hash": "sha256:p", "head": self.PIN, "result": "pass",
                                                 "by": "nt", "evaluator": "tester", "evidence": "x", "via": "item", "session": self.sessions["c1"]}, self.now())

    def gates_item(self, agents):
        ctx = self.ctx()
        args = types.SimpleNamespace(rest=[self.ITEM], plan=None, ask=None, json=True, item=None)
        out = io.StringIO()
        with mock.patch.object(sb, "item_context", lambda a, r, n, w: ctx), mock.patch.object(sb, "item_agents", agents), contextlib.redirect_stdout(out):
            code = sb.cmd_item_gates(args, None, self.now)
        return code, json.loads(out.getvalue())

    def test_gates_item_fails_closed_when_the_running_agents_cannot_be_read(self):
        self.unreadable_world()
        launch = sb.load_launch_testers().launched(self.fleets, self.sessions, self.REPO, lambda f: f.get("repo"), {})
        code, report = self.gates_item(lambda c: (launch, self.sessions, self.fleets))
        self.assertEqual(next(r for r in report["scenarios"] if r["id"] == "S1")["status"], "missing")      # agents read: the session-mate of a coder is excluded

        def broken(ctx):
            raise sb.ItemAgentsUnreadable("the running agents cannot be read (OSError: down)")
        code, report = self.gates_item(broken)
        self.assertEqual((code, report["ready"], report["scenarios"]), (sb.EXIT_ERROR, False, []))
        self.assertIn("NOT READY", report["rows"][0]["missing"][0])
        code, report = self.gates_item(lambda c: ({}, {}, {}))         # mutant: fail open, the writer set shrinks to the author, the proofs and the registrar
        self.assertEqual(next(r for r in report["scenarios"] if r["id"] == "S1")["status"], "ok")

    def test_item_agents_raises_when_discovery_or_the_retired_list_fails(self):
        ctx = self.ctx()
        ctx.engine.now = lambda: self.now()
        ctx.engine.discover = lambda now: (_ for _ in ()).throw(OSError("herdr down"))
        with self.assertRaises(sb.ItemAgentsUnreadable):
            sb.item_agents(ctx)

    def test_the_append_rechecks_the_ledger_under_the_lock_and_refuses_a_replaced_registration(self):
        self.register()
        real = sb.plan_ledger.append_many_checked

        def racing(state, build, now):      # between the reads and the append another registration (a new pin) lands
            sb.plan_ledger.append_entry(state, {"kind": "item_tester", "pr": self.ITEM, "item": self.ITEM, "tester": "t1", "session": "ses_t1", "orchestrator": "orch", "head": self.MOVED,
                                                "plan_ref": None, "by": "orch"}, self.now())
            return real(state, build, now)
        with mock.patch.object(sb.plan_ledger, "append_many_checked", racing):
            code, why = self.verdict("t1")
        self.assertIsNone(code)
        self.assertIn("reference commit", why)
        self.assertEqual(self.verdicts(), [])
        self.assertEqual([a for e, s, a in self.audit if e == "plan.item.refused"][-1]["stage"], "append")
        self.audit.clear()
        self.setUp()
        self.register()

        def unchecked(state, build, now):   # mutant: the check made on the snapshot from BEFORE the race (what the old append amounted to)
            snapshot = sb.plan_ledger.read_ledger(state)[0]
            sb.plan_ledger.append_entry(state, {"kind": "item_tester", "pr": self.ITEM, "item": self.ITEM, "tester": "t1", "session": "ses_t1", "orchestrator": "orch", "head": self.MOVED,
                                                "plan_ref": None, "by": "orch"}, self.now())
            return sb.plan_ledger.append_many(state, build(snapshot), now)
        with mock.patch.object(sb.plan_ledger, "append_many_checked", unchecked):
            self.assertEqual(self.verdict("t1")[0], sb.EXIT_OK)         # without the re-check the verdict at the old pin is written

    def test_append_many_checked_refuses_with_the_ledger_unchanged(self):
        self.register()
        before = self.entries()

        def refuse(entries):
            raise sb.plan_ledger.LedgerError("no")
        with self.assertRaises(sb.plan_ledger.LedgerError):
            sb.plan_ledger.append_many_checked(self.state, refuse, self.now())
        self.assertEqual(self.entries(), before)
        got = sb.plan_ledger.append_many_checked(self.state, lambda have: [{"kind": "verdict", "pr": self.ITEM, "scenario": "S1", "result": "pass"}] * 2, self.now())
        self.assertEqual([e["seq"] for e in got], [len(before) + 1, len(before) + 2])
        self.assertIsNone(sb.plan_ledger.read_ledger(self.state)[1])

    def test_u1_the_pull_request_rules_are_untouched(self):
        import subprocess as sp
        for name in ("may_record_verdict", "scenario_state", "authors_of"):
            self.assertTrue(callable(getattr(sb.plan_ledger, name)))
        text = SWITCHBOARD.read_text()
        for name in ("ci_record_core", "launched_testers_for"):
            self.assertEqual(text.count("def %s(" % name), 1)


class TestBatchingDocs(unittest.TestCase):
    """#834 slice 1: the batching procedure, its body template and its owner decisions, each said once."""
    HEAD = "## Batching: the integration branch and the batch pull request (#834)"

    def section(self):
        text = (REPO / "docs" / "switchboard.md").read_text()
        self.assertEqual(text.count(self.HEAD), 1)
        return text.split(self.HEAD, 1)[1]  # the last section of the file; its template holds "## " lines, so no split on them

    def test_the_topics_are_each_a_heading_once(self):
        section = self.section()
        for topic in ("### What batches and what goes straight", "### The cadence and who keeps the batch", "### The freeze",
                      "### The sync", "### An ask whose change is only in `integration`", "### The steps a lane follows"):
            self.assertEqual(section.count(topic), 1, topic)

    def test_the_hold_rule_uses_the_matrix_terms_and_marks_the_delegation_a_target(self):
        section = self.section()
        for phrase in ("`owner_hold`", "Target, after #835 lands", "`delegated_clear`", "aggregated diff", "taken out of draft", "a planned follow-up (not built)",
                       "voids the owner's clear", "before the next change merges into `integration`", "delete head branch on merge"):
            self.assertEqual(section.count(phrase), 1, phrase)

    def test_the_batch_hold_sentence_is_in_the_rule_and_in_d1_and_in_the_skill(self):
        sentence = "until #835 lands, then only when a row is rated High"
        self.assertEqual(self.section().count(sentence), 2)  # the hold rule and decision D1
        self.assertEqual((REPO / "skills" / "fleet-coordination" / "SKILL.md").read_text().count(sentence), 1)

    def test_no_label_and_no_existing_audit_report_are_claimed(self):
        section = self.section()
        self.assertNotIn("batch-ready", section)
        self.assertNotIn("batch-ready", (REPO / "skills" / "fleet-coordination" / "SKILL.md").read_text())
        self.assertNotIn("audit report", section)

    def test_the_lane_steps_are_numbered_and_each_carries_a_command(self):
        steps = self.section().split("### The steps a lane follows", 1)[1].split("###", 1)[0].strip().splitlines()
        numbered = [l for l in steps if l[:2] in ("1.", "2.", "3.", "4.", "5.", "6.")]
        self.assertEqual(len(numbered), 6)
        for line in numbered:
            self.assertIn("`", line)

    def test_the_skill_names_the_batching_rules_in_one_paragraph(self):
        text = (REPO / "skills" / "fleet-coordination" / "SKILL.md").read_text()
        paragraphs = [p for p in text.split("\n\n") if "`integration` branch" in p]
        self.assertEqual(len(paragraphs), 1)
        for word in ("batch pull request", "freeze", "held"):
            self.assertIn(word, paragraphs[0])

    def test_the_template_has_the_v2_sections_a_four_column_header_and_one_example_row(self):
        block = self.section().split("```markdown\n", 1)[1].split("```", 1)[0]
        for heading in ("## Why this needs you", "## What changes for you", "## Example", "## Questions for you"):
            self.assertEqual(block.count(heading), 1, heading)
        self.assertIn("Recommendation:", block)
        rows = [l for l in block.splitlines() if l.startswith("| Change |")]
        self.assertEqual(rows, ["| Change | Impact | Hold reasons and who cleared them | Evidence |"])
        after = block.split(rows[0], 1)[1].split("\n\n", 1)[0].strip().splitlines()
        self.assertEqual(len(after), 2)  # the separator and one example row
        self.assertEqual(len(after[1].strip().strip("|").split("|")), 4)

    def test_each_owner_decision_is_once_with_its_recommendation_or_decision(self):
        decisions = self.section().split("### Owner decisions and follow-up asks", 1)[1]
        for key, word in (("**D1**", "decided"), ("**D2**", "Recommendation"), ("**D3**", "Recommendation")):
            lines = [l for l in decisions.splitlines() if l.startswith("- " + key)]
            self.assertEqual(len(lines), 1, key)
            self.assertIn(word, lines[0])

    def test_the_three_prohibitions_are_said_once_each(self):
        section = self.section()
        for phrase in ("a force push", "a rebase of a shared branch", "an agent changing a ruleset"):
            self.assertEqual(section.count(phrase), 1, phrase)


def write_lane_hours(state, lanes, hour=None):
    """The daemon's hourly record with `lanes` ({lane: {account: {endpoint class: n}}}) for the current hour (counting on, as the daemon makes it)."""
    start = int(time.time()) // 3600 * 3600 if hour is None else hour
    (Path(state) / "agent-calls-hours.json").write_text(json.dumps({"v": 1, "since": time.time() - 7200, "hours": {str(start): {"lanes": lanes}}}))


NO_CAP_WORDS = re.compile(r"(cap|quota|ceiling|allowance)", re.I)
AGENT_WORDS = re.compile(r"(agent|lane|caller|worker|spender)", re.I)


def per_agent_limits(path, text):
    """[name] of every identifier, attribute, dictionary key or constant string of the Python source `text` that names a limit per agent: a cap word together with an
    agent word (`agent_cap`, `lane_quota`, `max_calls_per_agent`), or a per-agent word alone. Names of the form `NOT_AGENTS` (the lanes a message never names) are not limits."""
    tree = ast.parse(text)
    found = set()
    for node in ast.walk(tree):
        names = []
        if isinstance(node, ast.Name):
            names.append(node.id)
        elif isinstance(node, ast.Attribute):
            names.append(node.attr)
        elif isinstance(node, ast.arg):
            names.append(node.arg)
        elif isinstance(node, ast.Constant) and isinstance(node.value, str) and len(node.value) < 60:
            names.append(node.value)
        for name in names:
            if re.search(r"max_?calls|calls_?per|per_?(agent|lane|caller)_?(cap|limit|quota|max|count|calls)", name, re.I) or (NO_CAP_WORDS.search(name) and AGENT_WORDS.search(name)):
                found.add(name)
    return sorted(found)


class TestShimTopSpender(Base):
    """#949: below the low-budget line the lane that spent most in the last hour is told once an hour (the switchboard builds and sends the message) and only that
    agent's reads that are not answered from the cache wait a bounded time; no cap, count or quota exists anywhere."""

    ACCOUNT = "acme-a"

    users = TestAgentShellCalls.users
    shim_module = TestAgentShellCalls.shim_module
    shim = TestAgentShellCalls.shim
    age = TestShimReadCache.age
    usage = TestShimReadCache.usage
    network = TestShimReadCache.network
    PATH = "repos/acme/app/issues/5"

    def setUp(self):
        TestShimReadCache.setUp(self)
        text = "#!/bin/sh\nif [ \"$1\" = whoami ]; then\n  [ \"$2\" = --json ] && echo x >> \"$FAKE_SB_LOG.who\"\n  if [ \"$2\" = --json ]; then echo '{\"name\": \"NAME\", \"repo\": \"acme/app\"}'; else echo NAME; fi; exit 0; fi\n" \
               "echo \"$@\" >> \"$FAKE_SB_LOG\"\n[ -n \"$FAKE_SB_SLEEP\" ] && sleep \"$FAKE_SB_SLEEP\"\nexit ${FAKE_SB_EXIT:-0}\n"
        self.sb.write_text(text.replace("NAME", "worker"))
        self.other.write_text(text.replace("NAME", "other"))
        self.sblog = self.home / "sb.log"
        self.usage(500)
        write_lane_hours(self.state, {"worker": {self.ACCOUNT: {"api issues/#": 90}}, "other": {self.ACCOUNT: {"api issues/#": 10}}})

    WRAPPER = ("import importlib.machinery, importlib.util, sys\n"
               "loader = importlib.machinery.SourceFileLoader('gh_shim_under_test', sys.argv[1])\n"
               "module = importlib.util.module_from_spec(importlib.util.spec_from_loader('gh_shim_under_test', loader))\n"
               "loader.exec_module(module)\n"
               "module.FIXED_STATE[0], module.FIXED_PROGRAM[0] = sys.argv[2], sys.argv[3]\n"
               "sys.exit(module.main(sys.argv[4:]))\n")

    def run_shim(self, *args, env=None, agent="worker"):
        """The shim as `agent` (the program that answers who-am-I, for the account lookup AND for the top-spender block, whose seams the wrapper sets in the same
        process: the environment cannot)."""
        program = str(self.sb if agent == "worker" else self.other)
        environ = {"PATH": "%s:%s:%s" % (SHIM.parent, self.bin, SAFE_PATH), "HOME": str(self.home), "FLEET_SWITCHBOARD_STATE": str(self.state),
                   "FLEET_SWITCHBOARD_BIN": program, "FLEET_SHIM_LOOKUP_SECONDS": SHIM_LOOKUP_SECONDS, "FAKE_LOG": str(self.log), "FAKE_SB_LOG": str(self.sblog)}
        environ.update(env or {})
        return subprocess.run([sys.executable, "-c", self.WRAPPER, str(SHIM), str(self.state), program, *args], capture_output=True, text=True, env=environ, timeout=60)

    def notices(self):
        return self.sblog.read_text().splitlines() if self.sblog.exists() else []

    def timed(self, *args, env=None, agent="worker"):
        start = time.monotonic()
        done = self.run_shim(*args, env=env, agent=agent)
        return done, time.monotonic() - start

    def test_s2_below_the_line_the_switchboard_is_asked_once_to_tell_the_top_spenders_orchestrator_and_a_fresh_claim_stops_a_second_ask(self):
        self.run_shim("api", self.PATH)
        self.assertEqual(self.notices(), ["budget-notice --account acme-a"], "the only thing passed is the account's name")
        sb.agent_calls.claim_notice(str(self.state), self.ACCOUNT, time.time())          # what the switchboard does when it sends
        self.run_shim("api", self.PATH.replace("5", "6"))
        self.assertEqual(len(self.notices()), 1, "no second ask within the hour")
        stamp = self.state / "gh-low-told"
        old = time.time() - 3700
        for name in os.listdir(stamp):
            os.utime(str(stamp / name), (old, old))
        for name in os.listdir(self.state / "gh-low-tried"):
            os.utime(str(self.state / "gh-low-tried" / name), (old, old))
        self.run_shim("api", self.PATH.replace("5", "7"))
        self.assertEqual(len(self.notices()), 2, "an hour later it asks again")

    def fake_world(self, who, notice_seconds, notice_rc=1):
        """A fake clock the fake switchboard and sleep advance, and a fake runner: returns (module, clock list, runs list). No wall time is measured anywhere."""
        module = self.shim_module()
        module.FIXED_STATE[0], module.FIXED_PROGRAM[0] = str(self.state), str(self.sb)
        clock, runs = [time.time()], []

        def run(argv, **kw):
            runs.append(argv[1])
            if argv[1] == "whoami":
                return subprocess.CompletedProcess(argv, 0 if who else 1, json.dumps({"name": who}) if who else "", "")
            clock[0] += notice_seconds
            return subprocess.CompletedProcess(argv, notice_rc, "", "")
        return module, clock, runs, run

    def call(self, module, clock, run, agent=None):
        """One READ through the block: how many FAKE seconds it took."""
        start = clock[0]
        with mock.patch.object(time, "time", lambda: clock[0]), mock.patch.object(time, "sleep", lambda n: clock.__setitem__(0, clock[0] + n)), \
                mock.patch.object(subprocess, "run", run):
            module.low_budget_read(agent)
        for d in ("gh-who", "gh-low-tried"):                              # files are stamped by the real filesystem: put their mtimes on the fake clock
            for name in os.listdir(self.state / d) if (self.state / d).exists() else []:
                os.utime(str(self.state / d / name), (clock[0], clock[0]))
        return clock[0] - start

    def test_s2b_rev4_in_fake_time_a_failing_or_slow_switchboard_costs_only_the_top_spender_one_attempt_per_try_every(self):
        for notice_seconds in (0, 8):                                      # failing fast, and slow up to the 8 s deadline
            for d in ("gh-who", "gh-low-tried", "gh-low-told"):
                shutil.rmtree(str(self.state / d), ignore_errors=True)
            module, clock, runs, run = self.fake_world("worker", notice_seconds)
            first = self.call(module, clock, run)
            self.assertEqual(first, notice_seconds + module.SLOW_SECONDS, "the top spender: the one attempt, then exactly the wait")
            second = self.call(module, clock, run)
            self.assertEqual(second, module.SLOW_SECONDS, "no new attempt within TRY_EVERY: the wait only")
            self.assertEqual(runs.count("budget-notice"), 1)
            self.assertEqual(runs.count("whoami"), 1, "the identity answer is remembered")
            clock[0] += module.TRY_EVERY + 1
            self.assertEqual(self.call(module, clock, run), notice_seconds + module.SLOW_SECONDS, "after TRY_EVERY it tries again")
            self.assertEqual(runs.count("budget-notice"), 2)

    def test_s2c_rev1_in_fake_time_a_non_top_or_unknown_caller_advances_no_time_and_runs_no_message_in_any_position(self):
        for who in ("other", None):                                        # a non-top agent; an identity that cannot be told (fail open)
            for notice_seconds in (0, 8):
                for d in ("gh-who", "gh-low-tried", "gh-low-told"):
                    shutil.rmtree(str(self.state / d), ignore_errors=True)
                module, clock, runs, run = self.fake_world(who, notice_seconds)
                for position in (1, 2, 3):
                    self.assertEqual(self.call(module, clock, run), 0, (who, notice_seconds, position))
                self.assertNotIn("budget-notice", runs, "only the top spender makes the attempt")
                self.assertLessEqual(runs.count("whoami"), 1, "asked once, remembered (an unknown answer too)")

    def test_s3b_the_wait_is_exactly_slow_seconds_once_and_is_pinned_without_sleeping(self):
        module = self.shim_module()
        module.FIXED_STATE[0], module.FIXED_PROGRAM[0] = str(self.state), str(self.sb)
        slept = []
        with mock.patch.object(time, "sleep", lambda n: slept.append(n)), mock.patch.object(subprocess, "run", lambda *a, **k: subprocess.CompletedProcess(a, 0, "", "")):
            module.low_budget_read("worker")
            module.low_budget_read("other")
        self.assertEqual(slept, [module.SLOW_SECONDS], "once, SLOW_SECONDS, for the top spender only")

    def test_s2_above_the_line_or_with_no_record_nobody_is_asked(self):
        self.usage(3000)
        self.run_shim("api", self.PATH)
        (self.state / "agent-calls-hours.json").write_text(json.dumps({"v": 1, "since": time.time() - 7200, "hours": {}}))
        self.usage(500)
        self.run_shim("api", self.PATH.replace("5", "6"))
        self.assertEqual(self.notices(), [])

    def test_s3_only_the_top_spenders_uncached_reads_wait_a_bounded_time_and_nothing_is_refused(self):
        slow, slow_took = self.timed("pr", "view", "3")                                   # an uncached read (not `gh api <path>`) by the top spender
        quiet, quiet_took = self.timed("pr", "view", "3", agent="other")
        self.assertEqual((slow.returncode, quiet.returncode, slow.stdout, quiet.stdout), (0, 0, quiet.stdout, quiet.stdout))
        self.assertGreaterEqual(slow_took - quiet_took, 1.5, "the top spender waited")
        self.assertLessEqual(slow_took - quiet_took, 4.5, "bounded: never more than SLOW_SECONDS plus the call")
        write, write_took = self.timed("issue", "edit", "5", "-t", "x")
        other_write, other_write_took = self.timed("issue", "edit", "5", "-t", "x", agent="other")
        self.assertEqual((write.returncode, other_write.returncode), (0, 0))
        self.assertLess(write_took - other_write_took, 1.0, "a write is never slowed")
        self.run_shim("api", self.PATH)                                                   # the top spender's first read spends (and waits): it fills the cache
        self.age(20)
        cached, cached_took = self.timed("api", self.PATH)
        self.assertEqual(cached.stdout, '{"n":1}')
        self.assertLess(cached_took, 1.5, "a cached read is not slowed")

    # Every environment name the shim reads, with a hostile value for it. DERIVED from the shim's own code (see `shim_environment_names`): a name the shim starts to read
    # and this table does not list fails the test below, so a new switch cannot appear unseen. SWITCH_OFF lists the names that can still make the caller wait less.
    HOSTILE = {"FLEET_REAL_GH": "/nonexistent/gh", "FLEET_SHIM_CACHE": "off", "FLEET_SHIM_GATE_SECONDS": "0.001", "FLEET_SHIM_LOOKUP_SECONDS": "0.001",
               "FLEET_SHIM_MERGE_GATE_SECONDS": "0.001", "FLEET_SWITCHBOARD_BIN": "OTHER", "FLEET_SWITCHBOARD_OWN_GH": "1", "FLEET_SWITCHBOARD_STATE": "EMPTY", "GH_HOST": "ghe.example", "GH_REPO": "other/repo",
               "PATH": "SAME", "XDG_CONFIG_HOME": "EMPTY", "XDG_STATE_HOME": "EMPTY", "HOME": "EMPTY"}
    SWITCH_OFF = frozenset()   # none: the block reads no variable; who the caller is comes from the switchboard's answer for its session (see the shim's comment)

    @staticmethod
    def shim_environment_names():
        names = set()
        for node in ast.walk(ast.parse(SHIM.read_text())):
            if isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute) and node.func.attr in ("get", "pop") and isinstance(node.func.value, ast.Attribute) \
                    and node.func.value.attr == "environ" and node.args and isinstance(node.args[0], ast.Constant):
                names.add(node.args[0].value)
            elif isinstance(node, ast.Subscript) and isinstance(node.value, ast.Attribute) and node.value.attr == "environ" and isinstance(node.slice, ast.Constant):
                names.add(node.slice.value)
        return names | {"HOME"}   # `expanduser("~")` reads it

    def test_s3_every_environment_name_the_shim_reads_is_classified_and_none_switches_the_wait_off_or_changes_whose_lane_it_is(self):
        self.assertEqual(self.shim_environment_names() - set(self.HOSTILE), set(), "the shim reads a name this table does not classify: add it with a hostile value")
        self.assertEqual(set(self.HOSTILE) - self.shim_environment_names(), set(), "this table names something the shim no longer reads")
        _, baseline = self.timed("pr", "view", "3", agent="other")
        empty = str(self.home / "empty-dir")
        os.makedirs(empty, exist_ok=True)
        hostile_dir = os.environ.get("PATH", "")
        switched_off = set()
        for name, value in sorted(self.HOSTILE.items()):
            value = {"OTHER": str(self.other), "EMPTY": empty, "SAME": "%s:%s:%s" % (SHIM.parent, self.bin, SAFE_PATH)}.get(value, value)
            _, took = self.timed("pr", "view", "3", env={name: value})
            if took - baseline < 1.5:
                switched_off.add(name)
        self.assertEqual(switched_off, set(self.SWITCH_OFF), "the names that switch the wait off are exactly the declared ones")

    def test_s3_an_uncached_cacheable_read_waits_and_one_served_from_the_cache_does_not(self):
        _, quiet = self.timed("api", self.PATH.replace("5", "9"), agent="other")                 # another agent's read, no entry: no wait
        first, took = self.timed("api", self.PATH)                                               # the top spender's read with NO cache entry: it spends, so it waits
        self.assertEqual(first.stdout, '{"n":1}')
        self.assertGreaterEqual(took - quiet, 1.5, "an uncached `gh api <path>` read by the top spender waits (the wait inside the cache path)")
        second, again = self.timed("api", self.PATH)                                             # now served from the cache: no request, no wait
        self.assertEqual(second.stdout, '{"n":1}')
        self.assertLess(again, 1.5, "a read served from the cache never waits")

    def test_s3_the_wait_ends_when_the_account_recovers_and_never_starts_above_the_line(self):
        self.usage(3000)
        _, took = self.timed("pr", "view", "3")
        _, baseline = self.timed("pr", "view", "3", agent="other")
        self.assertLess(took - baseline, 1.0, "above the line nobody waits")
        self.usage(500)
        _, took = self.timed("pr", "view", "3")
        self.assertGreaterEqual(took - baseline, 1.5)
        self.usage(3000)
        _, took = self.timed("pr", "view", "3")
        self.assertLess(took - baseline, 1.0, "the wait ended with the low budget")

    def test_s7_the_ranking_is_recomputed_and_follows_the_spending_and_nothing_per_agent_is_kept(self):
        shim = self.shim_module()
        now = time.time()
        for lanes, want in (({"a": {self.ACCOUNT: {"api issues/#": 5}}, "b": {self.ACCOUNT: {"api issues/#": 9}}}, "b"),
                            ({"a": {self.ACCOUNT: {"api issues/#": 9}}, "b": {self.ACCOUNT: {"api issues/#": 9}}}, "a"),          # a tie: the first name
                            ({"daemon": {self.ACCOUNT: {"api issues/#": 900}}, "unknown": {self.ACCOUNT: {"api issues/#": 800}}, "c": {self.ACCOUNT: {"api issues/#": 1}}}, "c"),
                            ({"a": {"acme-b": {"api issues/#": 50}}, "d": {self.ACCOUNT: {"api issues/#": 2}}}, "d")):                       # another account's spending does not count
            with self.subTest(want=want):
                write_lane_hours(self.state, lanes)
                in_shim, in_module = shim.top_spender(self.ACCOUNT, str(self.state)), sb.agent_calls.top_spender(str(self.state), self.ACCOUNT, now)
                self.assertEqual((in_shim[0], in_module[0]), (want, want))
                self.assertEqual(in_shim, in_module, "the shim and the daemon's module rank the same")
        write_lane_hours(self.state, {})
        self.assertIsNone(sb.agent_calls.top_spender(str(self.state), self.ACCOUNT, now))
        self.run_shim("pr", "view", "3")
        kept = sorted(os.listdir(str(self.state / "gh-low-told"))) if (self.state / "gh-low-told").exists() else []
        self.assertLessEqual(len(kept), 1, "at most one file per account, none per agent")

    def test_u1_above_the_line_or_with_an_unreadable_record_every_call_is_the_plain_call_and_a_failing_switchboard_changes_nothing(self):
        for label, arrange in (("above the line", lambda: self.usage(3000)),
                               ("a corrupt hourly record", lambda: (self.usage(500), (self.state / "agent-calls-hours.json").write_text("{not json"))),
                               ("a failing switchboard", lambda: (self.usage(500), write_lane_hours(self.state, {"worker": {self.ACCOUNT: {"api issues/#": 5}}})))):
            arrange()
            for args in (("api", self.PATH), ("issue", "edit", "5", "-t", "x"), ("pr", "view", "3")):
                with self.subTest(label=label, args=args):
                    plain = self.run_shim(*args, env={"FLEET_SHIM_CACHE": "off", "FLEET_SB_FAKE": "1", "FAKE_SB_EXIT": "9"})
                    now = self.run_shim(*args, env={"FAKE_SB_EXIT": "9"})
                    self.assertEqual((now.stdout, now.returncode), (plain.stdout, plain.returncode))

    def test_s4_no_per_agent_cap_count_or_quota_exists_in_the_shim_its_configuration_or_the_daemons_budget_code(self):
        sources = {"shims/gh": SHIM.read_text(), "bin/agent_calls.py": (BIN / "agent_calls.py").read_text()}
        config = ast.parse((BIN / "fleet-switchboard").read_text())
        defaults = next(n for n in config.body if isinstance(n, ast.Assign) and any(getattr(t, "id", "") == "DEFAULTS" for t in n.targets))
        sources["DEFAULTS"] = ast.unparse(defaults.value)
        for name, text in sorted(sources.items()):
            with self.subTest(source=name):
                self.assertEqual(per_agent_limits(name, text if name != "DEFAULTS" else "x = " + text), [], "%s names a limit per agent: the top spender is a ranking, never a cap" % name)
        self.assertEqual(per_agent_limits("seed", "AGENT_CALL_CAP = 100\n"), ["AGENT_CALL_CAP"])                      # the mutants: a cap added anywhere is found
        self.assertEqual(per_agent_limits("seed", "config = {'max_calls_per_agent': 5}\n"), ["max_calls_per_agent"])
        self.assertEqual(per_agent_limits("seed", "lane_quota = {}\n"), ["lane_quota"])

    def test_s5_status_shows_the_remaining_budget_of_each_account_and_marks_one_below_the_line(self):
        now = time.time()
        (self.state / "github-usage.json").write_text(json.dumps({"v": 1, "at": now, "accounts": {
            "acme-a": {"used": 4500, "remaining": 500, "limit": 5000, "reset": now + 900}, "acme-b": {"used": 1000, "remaining": 4000, "limit": 5000, "reset": now + 900}}}))
        lines = [l for l in sb.agent_calls.usage_lines(str(self.state), now)]
        self.assertEqual(len(lines), 2)
        self.assertIn("real usage acme-a: used 4500, remaining 500", lines[0])
        self.assertIn("below the low-budget line", lines[0])
        self.assertIn("real usage acme-b: used 1000, remaining 4000", lines[1])
        self.assertNotIn("below the low-budget line", lines[1])

    def test_s1_s6_the_documentation_states_the_finding_first_and_describes_the_message_the_wait_and_the_absence_of_a_cap_in_the_words_the_code_uses(self):
        text = (REPO / "docs" / "switchboard.md").read_text()
        start = text.index("**Low budget: the top spender (#949).**")
        section = text[start:text.index("\n\n", start)]
        case, record, stop, how = (section.find(m) for m in ("*The finding.*", "What the record showed afterwards", "What would have stopped it", "*How it works.*"))
        self.assertTrue(0 < case < record < stop < how, "the finding (the case, what the record showed, what would have stopped it) comes before the design")
        message = sb.agent_calls.notice_text("<account>", 1, 2, "<agent>", 3, 4)
        words = message.split(". ", 2)[2]                                                  # the sentence about the wait: fixed words, no figure
        self.assertIn(words, section, "the documentation quotes the message's own words")
        for phrase in ("nothing is refused", "no write and no other agent is slowed", "there is no cap", "the wait ends when the account recovers"):
            self.assertIn(phrase, section)
            self.assertIn(phrase, message)
        self.assertIn("2 seconds", section)
        self.assertEqual(sb.agent_calls.NOTICE_EVERY, 3600)
        self.assertIn("at most once an hour per account", section)
        self.assertEqual(self.shim_module().SLOW_SECONDS, 2.0)

    def test_s4_the_shims_line_and_the_daemons_are_one_number(self):
        shim = self.shim_module()
        self.assertEqual((shim.LOW_FRACTION, shim.NOTICE_EVERY, shim.USAGE_FRESH), (sb.agent_calls.LOW_FRACTION, sb.agent_calls.NOTICE_EVERY, sb.agent_calls.USAGE_FRESH))
        self.assertEqual(shim.NOT_AGENTS, sb.agent_calls.NOT_AGENTS)


class TestBudgetNotice(BaselineWorld):
    """#949: `budget-notice --account A` builds the one message itself (the budget, the ranking and the words come from the daemon's records) and sends it to the top
    spender's orchestrator once an hour."""

    ACCOUNT = "acme-a"

    def low(self, remaining=500, limit=5000, at=None):
        now = self.world.clock.now() if at is None else at
        (self.world.state / "github-usage.json").write_text(json.dumps({"v": 1, "at": now, "accounts": {self.ACCOUNT: {"used": limit - remaining, "remaining": remaining, "limit": limit, "reset": now + 900}}}))

    def hours(self, lanes):
        write_lane_hours(self.world.state, lanes, int(self.world.clock.now()) // 3600 * 3600)

    def told(self):
        return [r for r in sb.read_reminders(str(self.world.state)) if "Low GitHub budget" in r["text"]]

    def test_s2_the_top_spenders_orchestrator_gets_one_message_with_the_agent_and_the_numbers_and_a_second_call_sends_none(self):
        self.add_worker("w-top")
        self.add_worker("w-quiet")
        self.low()
        self.hours({"w-top": {self.ACCOUNT: {"api issues/#": 80}}, "w-quiet": {self.ACCOUNT: {"api issues/#": 20}}, "daemon": {self.ACCOUNT: {"api issues/#": 900}}})
        first = self.cmd("you", "budget-notice", "--account", self.ACCOUNT)
        self.assertEqual(first["code"], 0, first["err"])
        self.assertIn("told", first["out"], first)
        (item,) = self.told()
        self.assertEqual(item["to"], "api-orch", "the orchestrator the top spender reports to")
        for part in ("acme-a", "500 of 5000", "w-top (80 of 100 agent calls, 80%)", "nothing is refused", "there is no cap", "wait a few seconds"):
            self.assertIn(part, item["text"])
        self.assertNotIn("w-quiet", item["text"])
        again = self.cmd("you", "budget-notice", "--account", self.ACCOUNT)
        self.assertEqual((again["code"], len(self.told())), (0, 1), "one message an hour per account")
        self.assertIn("already went", again["out"])

    def test_s2_a_top_spender_with_no_orchestrator_tells_the_chief_of_staff_and_one_nobody_runs_tells_nobody(self):
        self.low()
        self.hours({"ghost": {self.ACCOUNT: {"api issues/#": 5}}})
        done = self.cmd("you", "budget-notice", "--account", self.ACCOUNT)
        self.assertEqual((done["code"], len(self.told())), (0, 1))
        self.assertEqual(self.told()[0]["to"], "cos")

    def test_s2_not_low_a_stale_reading_no_record_or_another_account_send_nothing_and_a_made_up_account_cannot_invent_one(self):
        self.add_worker("w-top")
        self.hours({"w-top": {self.ACCOUNT: {"api issues/#": 5}}})
        self.low(remaining=3000)
        self.assertEqual(self.cmd("you", "budget-notice", "--account", self.ACCOUNT)["code"], 0)
        self.low(at=self.world.clock.now() - 3600)
        self.assertEqual(self.cmd("you", "budget-notice", "--account", self.ACCOUNT)["code"], 0)
        self.low()
        self.assertEqual(self.cmd("you", "budget-notice", "--account", "some-other-account")["code"], 0)
        self.hours({})
        self.assertEqual(self.cmd("you", "budget-notice", "--account", self.ACCOUNT)["code"], 0)
        self.assertEqual(self.told(), [])
        self.assertFalse((self.world.state / "gh-low-told").exists() and os.listdir(str(self.world.state / "gh-low-told")), "nothing was claimed")

    def test_s8_the_message_and_the_claim_carry_only_the_account_the_agent_and_numbers(self):
        self.add_worker("w-top")
        self.low()
        self.hours({"w-top": {self.ACCOUNT: {"api issues/#": 7}}})
        self.cmd("you", "budget-notice", "--account", self.ACCOUNT)
        (item,) = self.told()
        files = [(self.world.state / "gh-low-told" / n).read_text() for n in os.listdir(str(self.world.state / "gh-low-told"))]
        blob = item["text"] + " " + " ".join(files)
        for forbidden in (r"ghp_[A-Za-z0-9]{6,}", r"gho_[A-Za-z0-9]{6,}", r"github_pat_", r"acme/[a-z-]+#?\d*", r"--body", r"Bearer "):
            self.assertIsNone(re.search(forbidden, blob), forbidden)
        self.assertEqual(files, ["1"])

    def test_s9_the_shim_change_is_held_for_the_owner_as_a_credentials_path(self):
        paths = sb.impact_floor.load_matrix()["owner_hold"]["top_tier_paths"]
        self.assertTrue(sb.impact_floor.matches("shims/gh", paths["credentials"]), "shims/gh is a top-tier credentials path: its pull request holds for the owner")


# ---------------------------------------------------------------------------------------------------------------- #962: the fleet's own merge queue

MG_TIP, MG_NEWTIP, MG_HEAD = "1" * 40, "2" * 40, "a" * 40


def mg_iso(epoch):
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(epoch))


class FakeMergeGitHub:
    """A fake GitHub for the merge gate: `fake(argv) -> (code, out, err)`. Reads and writes are logged apart; a close then reopen starts a new run on the
    CURRENT tip that finishes `rerun_after` seconds later with `rerun_result` (None: never). `sleep` moves the clock and finishes what is due."""

    def __init__(self, number=12, repo="acme-org/widget-service", start=1_800_000_000):
        self.number, self.repo, self.now = number, repo, start
        self.tip, self.head, self.base, self.default, self.state, self.labels = MG_TIP, MG_HEAD, "main", "main", "OPEN", []
        self.runs = [self.make_run(1, "ci", 10, "completed", "success", MG_TIP, start - 600)]
        self.branch_runs = [{"id": 90, "name": "ci", "workflow_id": 10, "head_sha": MG_TIP, "conclusion": "success", "status": "completed", "created_at": mg_iso(start - 900)}]
        self.jobs = {2: [{"name": "unit-tests", "conclusion": "failure"}, {"name": "lint", "conclusion": "success"}]}
        self.reads, self.writes, self.broken = [], [], set()
        self.merges, self.blocking_review, self.merge_own = [], False, []
        self.rerun_after, self.rerun_result, self.reopen_fails, self.due = 60, "success", False, []

    def clock(self):
        return self.now

    def sleep(self, seconds):
        self.now += seconds
        for run in list(self.due):
            if self.now >= run["_due"]:
                run.update(status="completed", conclusion=self.rerun_result)
                self.due.remove(run)

    def make_run(self, rid, name, workflow, status, conclusion, base, created):
        return {"id": rid, "name": name, "workflow_id": workflow, "status": status, "conclusion": conclusion, "head_sha": self.head if hasattr(self, "head") else MG_HEAD,
                "created_at": mg_iso(created), "pull_requests": [{"number": self.number, "base": {"sha": base, "ref": "main"}}]}

    def __call__(self, argv, own=True):
        if argv[0] == "api" and argv[1] == "-X":
            self.writes.append(list(argv))
            state = argv[-1].split("=", 1)[1]
            if state == "closed":
                self.state = "CLOSED"
            elif self.reopen_fails:
                return 1, "", "HTTP 502"
            else:
                self.state = "OPEN"
                run = self.make_run(2, "ci", 10, "in_progress", None, self.tip, self.now)
                run["_due"] = self.now + self.rerun_after
                if self.rerun_result is not None:
                    self.due.append(run)
                self.runs = [run]
            return 0, "{}", ""
        if argv[:2] == ["pr", "merge"]:
            self.merges.append(list(argv))
            self.merge_own.append(own)
            return 0, "", ""
        self.reads.append(list(argv))
        key = " ".join(argv)
        if any(word in key for word in self.broken):
            return 1, "", "HTTP 500 boom"
        if argv[:2] == ["pr", "view"]:
            reviews = [{"author": {"login": "reviewer-x"}, "state": "CHANGES_REQUESTED", "commit": {"oid": self.head}}] if self.blocking_review else []
            if "reviews" in key:
                return 0, json.dumps({"headRefOid": self.head, "reviews": reviews, "reviewDecision": ""}), ""
            return 0, json.dumps({"headRefOid": self.head, "baseRefName": self.base, "state": self.state, "isDraft": False, "labels": [{"name": n} for n in self.labels]}), ""
        path = argv[1]
        if path == "repos/%s" % self.repo:
            return 0, json.dumps({"default_branch": self.default}), ""
        if "/git/ref/heads/" in path:
            return 0, json.dumps({"object": {"sha": self.tip}}), ""
        if "event=pull_request" in path:
            return 0, json.dumps({"workflow_runs": [{k: v for k, v in r.items() if k != "_due"} for r in self.runs]}), ""
        if "event=push" in path:
            return 0, json.dumps({"workflow_runs": self.branch_runs}), ""
        found = re.search(r"/runs/(\d+)/jobs", path)
        if found:
            return 0, json.dumps({"jobs": self.jobs.get(int(found.group(1)), [])}), ""
        return 1, "", "HTTP 404"


class MergeGateBase(Base):
    def setUp(self):
        super().setUp()
        self.gate = sb.load_module("merge_gate")
        self.reading = sb.load_module("pr_reading")
        self.fake = FakeMergeGitHub()
        self.repo, self.n = self.fake.repo, self.fake.number
        self.state = self.home / "mg-state"
        self.state.mkdir()
        self.conf = self.gate.settings({"merge_gate": {"repos": {self.repo: {}}}})

    def facts(self):
        return self.gate.read_facts(self.reading, self.fake, self.repo, self.n, self.conf)

    def run_pass(self, who="coder-a", gate=None, **more):
        gate = gate or self.gate
        return gate.gate_pass(self.reading, self.fake, self.conf, self.state, self.repo, self.n, who, made_up_pid(), self.fake.clock, self.fake.sleep,
                              alive=lambda pid: True, **more)

    def check(self, caller="coder-a", person=False, waived=False, gate=None):
        gate = gate or self.gate
        return gate.check_merge(self.reading, self.fake, self.conf, self.state, self.repo, self.n, caller, person, lambda head: waived, self.fake.clock,
                                alive=lambda pid: True)

    def moved(self):
        self.fake.tip = MG_NEWTIP


class TestMergeGateDecision(MergeGateBase):
    """The read-only block and the decision (#962 clauses 2, 3, 6, 7)."""

    def tree(self):
        return sorted(str(p.relative_to(self.home)) for p in self.home.rglob("*"))

    def test_a_branch_that_has_not_moved_is_allowed_and_the_block_says_six_facts_and_writes_nothing(self):
        before = self.tree()
        facts = self.facts()
        allowed, reason, need = self.gate.decide(facts)
        text = self.gate.block(facts, allowed, reason)
        self.assertEqual((allowed, need), (True, None))
        for label in ("branch tip now:", "CI computed on tip:", "equal:", "CI result at head", "latest run on branch:", "merge allowed now:"):
            self.assertEqual(sum(1 for line in text.splitlines() if label in line), 1, label)
        self.assertIn("equal:                    yes", text)
        self.assertEqual((self.fake.writes, self.tree()), ([], before), "reading writes no file, label, comment or branch")

    def test_a_branch_that_moved_is_not_allowed_and_names_the_rerun_as_the_way_forward(self):
        self.moved()
        facts = self.facts()
        allowed, reason, need = self.gate.decide(facts)
        self.assertEqual((allowed, need), (False, "rerun"))
        self.assertIn("moved after the last green run", reason)
        self.assertIn("equal:                    no", self.gate.block(facts, allowed, reason))
        self.assertEqual(self.fake.writes, [], "the read-only command never re-runs anything")

    def test_unreadable_unknown_and_pending_runs_each_block_with_a_reason(self):
        cases = []
        for broken in ("actions/runs?head_sha", "git/ref/heads"):
            fake = FakeMergeGitHub()
            fake.broken = {broken}
            cases.append(fake)
        pending = FakeMergeGitHub()
        pending.runs[0].update(status="in_progress", conclusion=None)
        cases.append(pending)
        unknown = FakeMergeGitHub()
        unknown.runs[0].update(conclusion="startup_failure")
        cases.append(unknown)
        for fake in cases:
            with self.subTest(broken=sorted(fake.broken), runs=[r["conclusion"] for r in fake.runs]):
                facts = self.gate.read_facts(self.reading, fake, self.repo, self.n, self.conf)
                allowed, reason, _ = self.gate.decide(facts)
                self.assertFalse(allowed)
                self.assertTrue(reason)

    def test_a_red_pull_request_run_names_the_failing_job(self):
        self.fake.runs[0].update(id=2, conclusion="failure")
        allowed, reason, _ = self.gate.decide(self.facts())
        self.assertFalse(allowed)
        self.assertIn("ci / unit-tests", reason)
        self.assertNotIn("lint", reason)

    def test_a_red_latest_run_on_the_branch_blocks_every_merge_into_it(self):
        self.fake.branch_runs[0]["conclusion"] = "failure"
        allowed, reason, _ = self.gate.decide(self.facts())
        self.assertFalse(allowed)
        self.assertIn("latest completed run on main is red", reason)

    def test_a_cancelled_branch_run_is_a_superseded_run_not_a_red_branch(self):
        self.fake.branch_runs[0]["conclusion"] = "cancelled"
        self.assertTrue(self.gate.decide(self.facts())[0])

    def test_gated_branches_default_to_the_default_branch_and_the_integration_branch_only_when_listed(self):
        gate = self.gate
        none = gate.settings({"merge_gate": {"repos": {self.repo: {}}}})
        listed = gate.settings({"merge_gate": {"repos": {self.repo: {"branches": ["main", "integration"]}}}})
        other = gate.settings({"merge_gate": {"repos": {self.repo: {"branches": ["release"]}}}})
        self.assertEqual([gate.is_gated(c, self.repo, b, "main") for c in (none, listed, other) for b in ("main", "integration")],
                         [True, False, True, True, False, False])
        self.assertFalse(gate.is_gated(gate.settings({}), self.repo, "main", "main"), "a repository not listed is not enforced")

    def test_the_integration_branch_is_allowed_without_a_gate_pass_when_the_key_does_not_list_it(self):
        self.fake.base = "integration"
        self.moved()
        self.assertEqual(self.check(), (True, "branch integration is not gated", MG_HEAD), "the head is returned: the shim binds the merge to it")

    def test_the_configuration_key_is_validated(self):
        gate = self.gate
        gate.validate({"repos": {"acme-org/widget-service": {"branches": ["main"]}}, "wait_minutes": 45})
        for bad in ({"repos": []}, {"repos": {"nope": {}}}, {"repos": {self.repo: {"branches": []}}}, {"wait_minutes": 0}, {"other": 1}, []):
            with self.subTest(bad=bad), self.assertRaises(ValueError):
                gate.validate(bad)
        self.assertEqual(gate.settings({"merge_gate": {}})["wait"], 45 * 60, "the wait defaults to 45 minutes")


class TestMergeGateRerun(MergeGateBase):
    """The re-run on the current merge ref (clause 3, PC-2): head and labels untouched, wait, green allows, red or timeout blocks."""

    def baseline(self):
        return (self.fake.head, list(self.fake.labels))

    def test_a_moved_branch_is_rerun_without_a_change_of_head_or_labels_and_allowed_on_green(self):
        self.moved()
        before = self.baseline()
        ok, lines = self.run_pass()
        self.assertTrue(ok, lines)
        self.assertEqual(self.baseline(), before, "the head and the labels are identical to the baseline")
        self.assertEqual([w[-1] for w in self.fake.writes], ["state=closed", "state=open"], "the only writes: close and reopen the pull request")
        self.assertEqual(self.gate.read_pass(self.state, self.repo, self.n)["tip"], MG_NEWTIP)
        self.assertTrue(any("gate passed" in l for l in lines))

    def test_a_red_rerun_blocks_and_names_the_failing_job(self):
        self.moved()
        self.fake.rerun_result = "failure"
        ok, lines = self.run_pass()
        self.assertFalse(ok)
        self.assertIn("unit-tests", lines[-1])
        self.assertIsNone(self.gate.read_pass(self.state, self.repo, self.n))
        self.assertIsNone(self.gate.read_lock(self.state, self.repo, "main"))

    def test_a_rerun_that_does_not_finish_in_time_blocks_and_says_the_limit(self):
        self.moved()
        self.fake.rerun_result = None
        ok, lines = self.run_pass(wait_seconds=300)
        self.assertFalse(ok)
        self.assertIn("within 5 minutes", lines[-1])
        self.assertEqual(self.fake.writes[-1][-1], "state=open", "the pull request is open again")

    def test_a_held_pull_request_is_not_closed_by_the_gate_unless_told_to(self):
        self.moved()
        self.fake.labels = ["fleet:merge-captain"]
        ok, lines = self.run_pass()
        self.assertFalse(ok)
        self.assertEqual(self.fake.writes, [])
        self.assertIn("--rerun-held", lines[-1])
        ok, lines = self.run_pass(allow_held=True)
        self.assertTrue(ok, lines)
        self.assertEqual(self.fake.labels, ["fleet:merge-captain"])

    def test_a_reopen_that_fails_says_how_to_reopen(self):
        self.moved()
        self.fake.reopen_fails = True
        ok, lines = self.run_pass()
        self.assertFalse(ok)
        self.assertIn("gh pr reopen 12", lines[-1])

    def test_a_branch_that_moves_while_the_lock_is_taken_is_not_passed(self):
        real = self.gate.acquire

        def acquire_then_move(*a, **k):
            got = real(*a, **k)
            self.fake.tip = MG_NEWTIP   # the branch moves after the facts were read and before the tip is read again
            return got
        with mock.patch.object(self.gate, "acquire", acquire_then_move):
            ok, lines = self.run_pass()
        self.assertFalse(ok)
        self.assertIn("moved while the gate ran", lines[-1])
        self.assertIsNone(self.gate.read_pass(self.state, self.repo, self.n))
        self.assertIsNone(self.gate.read_lock(self.state, self.repo, "main"), "the lock is let go")

    def test_an_unmoved_branch_is_not_rerun(self):
        ok, lines = self.run_pass()
        self.assertTrue(ok, lines)
        self.assertEqual(self.fake.writes, [])


class TestMergeGateLock(MergeGateBase):
    """One merge into a branch at a time (clause 4)."""

    def take(self, who, now, pid=None, lease=1200, alive=lambda p: True):
        return self.gate.acquire(self.state, self.repo, "main", who, pid if pid is not None else made_up_pid(), "%s#%d" % (self.repo, self.n), now, lease, alive)

    def test_a_second_merger_is_told_who_holds_the_lock_and_when_to_retry(self):
        self.assertTrue(self.take("coder-a", 1000)[0])
        ok, lock, said = self.take("coder-b", 1100)
        self.assertFalse(ok)
        self.assertEqual(lock["holder"], "coder-a")
        self.assertIn("coder-a holds the merge lock on %s main since" % self.repo, said)
        self.assertIn("retry in about", said)

    def test_a_lock_whose_lease_ran_out_is_recovered(self):
        self.take("coder-a", 1000)
        ok, lock, said = self.take("coder-b", 1000 + 1201)
        self.assertTrue(ok)
        self.assertIn("recovered a stale lock of coder-a", said)
        self.assertEqual(self.gate.read_lock(self.state, self.repo, "main")["holder"], "coder-b")

    def test_a_lock_whose_holder_process_is_gone_is_recovered_after_the_grace(self):
        self.take("coder-a", 1000, pid=made_up_pid())
        self.assertFalse(self.take("coder-b", 1000 + 60, alive=lambda p: False)[0], "inside the grace the merge of the holder may still follow")
        ok, _, said = self.take("coder-b", 1000 + self.gate.HOLDER_GRACE + 5, alive=lambda p: False)
        self.assertTrue(ok)
        self.assertIn("its holder is gone", said)

    def test_a_lock_whose_holder_process_is_alive_is_not_recovered_past_the_grace(self):
        self.take("coder-a", 1000, pid=made_up_pid())
        ok, lock, said = self.take("coder-b", 1000 + self.gate.HOLDER_GRACE + 300, alive=lambda p: True)
        self.assertFalse(ok)
        self.assertEqual(lock["holder"], "coder-a")

    def test_only_the_holder_releases_and_the_same_holder_may_take_it_again(self):
        self.take("coder-a", 1000)
        self.assertFalse(self.gate.release(self.state, self.repo, "main", "coder-b"))
        self.assertTrue(self.take("coder-a", 1010)[0])
        self.assertTrue(self.gate.release(self.state, self.repo, "main", "coder-a"))
        self.assertIsNone(self.gate.read_lock(self.state, self.repo, "main"))

    def test_the_gate_pass_of_a_second_merger_is_blocked_by_the_lock_of_the_first(self):
        self.assertTrue(self.run_pass("coder-a")[0])
        ok, lines = self.run_pass("coder-b")
        self.assertFalse(ok)
        self.assertIn("coder-a holds the merge lock", lines[-1])


class TestMergeGateCheck(MergeGateBase):
    """What the shim asks before a merge (clause 5, 6): a pass for the exact head and tip, the lock held by the caller; two ways around."""

    def test_no_pass_is_a_refusal_in_one_line_naming_the_command(self):
        allowed, why, head = self.check()
        self.assertEqual((allowed, head), (False, None))
        self.assertNotIn("\n", why)
        self.assertIn("merge-gate acme-org/widget-service#12 --pass", why)

    def test_a_pass_for_this_head_and_tip_with_the_lock_held_by_the_caller_is_allowed_and_bound_to_the_head(self):
        self.assertTrue(self.run_pass()[0])
        allowed, why, head = self.check()
        self.assertEqual((allowed, head), (True, MG_HEAD))
        self.assertTrue(why.startswith(self.gate.GATE_PASSED))

    def test_a_pass_for_an_older_tip_or_head_is_refused(self):
        self.assertTrue(self.run_pass()[0])
        self.moved()
        self.assertIn("gate pass is stale", self.check()[1])
        self.fake.tip = MG_TIP
        self.assertTrue(self.check()[0])
        self.fake.head = "b" * 40
        self.assertFalse(self.check()[0])

    def test_the_lock_must_be_held_by_the_caller(self):
        self.assertTrue(self.run_pass("coder-a")[0])
        allowed, why, _ = self.check(caller="coder-b")
        self.assertFalse(allowed)
        self.assertIn("coder-a holds the merge lock", why)
        self.gate.release(self.state, self.repo, "main", "coder-a")
        self.assertIn("nobody holds the merge lock", self.check(caller="coder-a")[1])

    def test_the_owners_own_terminal_and_a_logged_waiver_are_the_two_ways_around(self):
        self.assertEqual(self.check(person=True)[:3:2], (True, MG_HEAD))
        allowed, why, head = self.check(waived=True)
        self.assertEqual((allowed, head), (True, MG_HEAD))
        self.assertIn("waiver", why)

    def test_a_red_branch_refuses_a_merge_even_with_a_pass_unless_a_waiver_names_it(self):
        self.assertTrue(self.run_pass()[0])
        self.fake.branch_runs[0]["conclusion"] = "failure"
        allowed, why, _ = self.check()
        self.assertFalse(allowed)
        self.assertIn("latest completed run on main is red", why)
        self.assertTrue(self.check(waived=True)[0], "the merge the waiver names goes in")

    def test_an_unreadable_pull_request_fails_closed_in_one_line(self):
        self.fake.broken = {"pr view"}
        allowed, why, _ = self.check()
        self.assertFalse(allowed)
        self.assertEqual(why.count("\n"), 0)

    def test_the_integration_branch_is_allowed_and_a_gated_one_is_not_without_a_pass(self):
        self.fake.base = "integration"
        self.assertTrue(self.check()[0])
        self.fake.base = "main"
        self.assertFalse(self.check()[0])


class TestMergeGatePassAndMerge(MergeGateBase):
    """`merge-gate --pass --merge` (the function `pass_and_merge`): the pass, the re-read and the merge in one process; a mismatch merges nothing."""

    def run_pm(self, gate=None, who="coder-a", after_pass=None, **more):
        gate = gate or self.gate
        real = gate.gate_pass

        def passing(*a, **k):
            got = real(*a, **k)
            if after_pass is not None:
                after_pass()
            return got
        gate.gate_pass = passing
        try:
            return gate.pass_and_merge(self.reading, self.fake, self.conf, self.state, self.repo, self.n, who, made_up_pid(), self.fake.clock, self.fake.sleep,
                                       alive=lambda pid: True, **more)
        finally:
            gate.gate_pass = real

    def locked(self):
        return self.gate.read_lock(self.state, self.repo, "main")

    def move_head(self):
        self.fake.head = "c" * 40
        self.fake.runs = [self.fake.make_run(1, "ci", 10, "completed", "success", MG_TIP, self.fake.now)]

    def scenario_clean(self, gate):
        code, lines, audit = self.run_pm(gate)
        self.assertEqual(code, 0, lines)
        self.assertEqual(self.fake.merges, [["pr", "merge", str(self.n), "-R", self.repo, "--squash", "--match-head-commit", MG_HEAD]])
        self.assertIsNone(self.locked())
        self.assertEqual(audit["outcome"], "merged")
        self.assertEqual(set(audit["reread"]), {"head", "labels", "gates", "branch", "reviews"})
        self.assertEqual(self.fake.merge_own, [False], "the merge call carries no own-call marker")

    def scenario_head_moved(self, gate):
        code, lines, audit = self.run_pm(gate, after_pass=self.move_head)
        self.assertEqual((code, self.fake.merges, self.locked()), (1, [], None))
        self.assertIn("the head moved", lines[-1])

    def scenario_label_added(self, gate):
        code, lines, audit = self.run_pm(gate, after_pass=lambda: self.fake.labels.append("needs-docs"))
        self.assertEqual((code, self.fake.merges, self.locked()), (1, [], None))
        self.assertIn("a label appeared", lines[-1])

    def scenario_blocking_review(self, gate):
        self.fake.blocking_review = True
        code, lines, audit = self.run_pm(gate)
        self.assertEqual((code, self.fake.merges, self.locked()), (10, [], None))
        self.assertIn("reviewer-x", lines[-1])

    def scenario_marker_off(self, gate):
        self.run_pm(gate)
        self.assertEqual(self.fake.merge_own, [False])

    def scenario_lock_kept(self, gate):
        self.run_pm(gate, after_pass=lambda: self.fake.labels.append("needs-docs"))
        self.assertIsNone(self.locked())

    def test_a_clean_pass_and_merge(self):
        self.scenario_clean(self.gate)

    def test_the_head_moved_after_the_pass(self):
        self.scenario_head_moved(self.gate)

    def test_a_label_added_after_the_pass(self):
        self.scenario_label_added(self.gate)

    def test_a_gate_no_longer_ready_after_the_pass(self):
        def break_ci():
            self.fake.runs = [self.fake.make_run(3, "ci", 10, "completed", "failure", MG_TIP, self.fake.now)]
        code, lines, audit = self.run_pm(after_pass=break_ci)
        self.assertEqual((code, self.fake.merges, self.locked()), (1, [], None))
        self.assertIn("a gate is no longer ready", lines[-1])

    def test_the_branch_moved_after_the_pass(self):
        code, lines, audit = self.run_pm(after_pass=self.moved)
        self.assertEqual((code, self.fake.merges, self.locked()), (1, [], None))
        self.assertTrue("moved after the pass" in lines[-1] or "a gate is no longer ready" in lines[-1], lines[-1])

    def test_a_blocking_review_is_refused_by_name_before_the_merge_and_the_lock_is_released(self):
        self.scenario_blocking_review(self.gate)

    def test_the_review_rule_equals_the_shims(self):
        import importlib.machinery, importlib.util
        loader = importlib.machinery.SourceFileLoader("gh_shim_parity", str(SHIM))
        shim = importlib.util.module_from_spec(importlib.util.spec_from_loader("gh_shim_parity", loader))
        loader.exec_module(shim)
        def review(who, state, oid): return {"author": {"login": who}, "state": state, "commit": {"oid": oid}}
        for reviews in ([review("a", "CHANGES_REQUESTED", "h1")], [review("a", "CHANGES_REQUESTED", "h0")], [review("a", "CHANGES_REQUESTED", "h1"), review("a", "APPROVED", "h1")],
                        [review("a", "CHANGES_REQUESTED", "h0"), review("b", "DISMISSED", "h1")], [review("a", "CHANGES_REQUESTED", "")], None, [5]):
            for head in ("h1", ""):
                for decision in ("", "CHANGES_REQUESTED"):
                    self.assertEqual(self.gate.review_blockers(reviews, head, decision), shim.review_blockers(reviews, head, decision))

    def test_a_held_pull_request_keeps_the_two_step_form(self):
        self.fake.labels.append("merge-captain")
        code, lines, audit = self.run_pm()
        self.assertEqual((code, self.fake.merges, self.locked()), (1, [], None))
        self.assertIn("two-step", lines[-1])

    def test_a_failed_pass_merges_nothing(self):
        self.fake.rerun_result = "failure"
        self.moved()
        code, lines, audit = self.run_pm()
        self.assertEqual((code, self.fake.merges), (1, []))

    MUTANTS = (("merges without re-reading the head", 'head == pass_head and head == before["head"]', "True", "scenario_head_moved"),
               ("keeps the lock after a mismatch", "if problem:\n        if locked:", "if problem:\n        if False:", "scenario_lock_kept"),
               ("bypasses the shim", 'MERGE_FLAGS = ("--squash",)', 'MERGE_FLAGS = ("--squash", "--admin")', "scenario_clean"),
               ("skips its own review read", "if blockers:\n        if locked:", "if False:\n        if locked:", "scenario_blocking_review"),
               ("puts the own-call marker back on the merge", '["--match-head-commit", head], own=False)', '["--match-head-commit", head], own=True)', "scenario_marker_off"),
               ("ignores a new label", "not added and not is_held", "True or not is_held", "scenario_label_added"))

    def mutant(self, old, new):
        source = (BIN / "merge_gate.py").read_text()
        self.assertEqual(source.count(old), 1, old)
        module = types.ModuleType("merge_gate_mutant")
        exec(compile(source.replace(old, new), "merge_gate_mutant.py", "exec"), module.__dict__)
        return module

    def test_each_mutant_fails_its_scenario(self):
        for label, old, new, name in self.MUTANTS:
            with self.subTest(mutant=label):
                self.setUp()
                with self.assertRaises(AssertionError):
                    getattr(self, name)(self.mutant(old, new))

    def test_the_real_module_passes_every_mutant_scenario(self):
        for _, _, _, name in self.MUTANTS:
            with self.subTest(scenario=name):
                self.setUp()
                getattr(self, name)(self.gate)


class TestMergeGateMutants(MergeGateBase):
    """Each rule is tested against a copy of the module with that rule removed: the test that guards it must fail (clause 8)."""

    def mutant(self, old, new):
        source = (BIN / "merge_gate.py").read_text()
        self.assertEqual(source.count(old), 1, "the mutation target must be in the module exactly once: " + old)
        module = types.ModuleType("merge_gate_mutant")
        exec(compile(source.replace(old, new), "merge_gate_mutant.py", "exec"), module.__dict__)
        return module

    def scenario_moved_branch_needs_a_rerun(self, gate):
        self.moved()
        allowed, reason, need = gate.decide(gate.read_facts(self.reading, self.fake, self.repo, self.n, self.conf))
        self.assertEqual((allowed, need), (False, "rerun"))

    def scenario_no_lock_no_merge(self, gate):
        self.assertTrue(self.run_pass("coder-a", gate=gate)[0])
        self.assertFalse(self.check(caller="coder-b", gate=gate)[0])

    def scenario_stale_pass_is_refused(self, gate):
        self.assertTrue(self.run_pass(gate=gate)[0])
        self.moved()
        self.assertFalse(self.check(gate=gate)[0])

    def scenario_the_branch_moving_under_the_lock_blocks_the_pass(self, gate):
        real = gate.acquire

        def acquire_then_move(*a, **k):
            got = real(*a, **k)
            self.fake.tip = MG_NEWTIP
            return got
        gate.acquire = acquire_then_move
        self.assertFalse(self.run_pass(gate=gate)[0])

    def scenario_a_live_holder_is_not_recovered(self, gate):
        gate.acquire(self.state, self.repo, "main", "coder-a", made_up_pid(), "x#1", 1000, 1200, lambda p: True)
        ok = gate.acquire(self.state, self.repo, "main", "coder-b", made_up_pid(), "x#2", 1000 + gate.HOLDER_GRACE + 300, 1200, lambda p: True)[0]
        self.assertFalse(ok)

    CASES = (("skip the base comparison", 'if facts["run_base"] != facts["tip"]:', "if False:", "scenario_moved_branch_needs_a_rerun"),
             ("skip the lock", 'if lock is None or stale or lock.get("holder") != caller:', "if False:", "scenario_no_lock_no_merge"),
             ("accept a stale gate pass", 'if got.get("head") != facts["head"] or got.get("branch") != facts["branch"] or got.get("tip") != facts["tip"]:',
              "if False:", "scenario_stale_pass_is_refused"),
             ("recover a lock whose holder is alive", "and now - since > HOLDER_GRACE and not alive(pid)", "and now - since > HOLDER_GRACE", "scenario_a_live_holder_is_not_recovered"),
             ("skip the re-read under the lock", 'if tip != facts["tip"] or head != facts["head"] or tip != facts["run_base"]:', "if False:",
              "scenario_the_branch_moving_under_the_lock_blocks_the_pass"))

    def test_the_unmutated_module_passes_every_scenario(self):
        for _, _, _, name in self.CASES:
            with self.subTest(scenario=name):
                self.setUp()
                getattr(self, name)(self.gate)

    def test_each_mutant_fails_its_scenario(self):
        for label, old, new, name in self.CASES:
            with self.subTest(mutant=label):
                self.setUp()
                with self.assertRaises(AssertionError):
                    getattr(self, name)(self.mutant(old, new))


class TestMergeGateCommand(LedgerBase):
    """The command itself: read-only by default, `--check` for the shim, the owner's terminal and the chief of staff's logged waiver (`waive --gates MG`)."""

    def setUp(self):
        super().setUp()
        self.fake = FakeMergeGitHub(number=9, repo="acme/app")
        self.world.add_agent("cos", fleet={"role": "chief-of-staff"})
        self.extra_config = {"merge_gate": {"repos": {"acme/app": {}}}, "plan_gates": {"repos": {"acme/app": {"mode": "enforce"}}}}
        self.configure()
        self.pr.update(headRefOid=MG_HEAD)

    def route(self, argv, **kwargs):
        if argv[0] != FAKE_GH:
            return self.world.route(argv, **kwargs)
        if argv[1:3] == ["pr", "view"] and "headRefOid,baseRefName,state,isDraft,labels" not in argv and "reviews,headRefOid,reviewDecision" not in argv:
            return subprocess.CompletedProcess(argv, 0, json.dumps(self.pr), "")
        code, out, err = self.fake(argv[1:])
        return subprocess.CompletedProcess(argv, code, out, err)

    def test_the_default_form_prints_one_block_and_writes_nothing(self):
        before = sorted(p.name for p in self.world.state.rglob("*"))
        code, out, err = self.run_as("coder", "merge-gate", self.PR)
        self.assertEqual(code, 0, err)
        self.assertEqual(sum(1 for l in out.splitlines() if l.startswith("merge-gate ")), 1)
        self.assertIn("merge allowed now:        yes", out)
        self.assertEqual((self.fake.writes, sorted(p.name for p in self.world.state.rglob("*"))), ([], before))

    def test_the_shim_question_refuses_an_agent_without_a_pass_and_passes_the_owners_terminal_and_a_waiver(self):
        code, out, err = self.run_as("coder", "merge-gate", self.PR, "--check", "--json")
        self.assertEqual(code, 10)
        self.assertFalse(json.loads(out)["allowed"])
        code, out, err = self.run_as(None, "merge-gate", self.PR, "--check", "--json")
        self.assertEqual((code, json.loads(out)["reason"]), (0, "the owner's own terminal"))
        self.assertEqual(self.run_as("cos", "waive", self.PR, "--gates", "MG", "--reason", "the merge that fixes the red branch on main")[0], 0)
        code, out, err = self.run_as("coder", "merge-gate", self.PR, "--check", "--json")
        self.assertEqual((code, json.loads(out)["allowed"]), (0, True))
        self.fake.head = "c" * 40
        self.pr.update(headRefOid="c" * 40)
        self.assertEqual(self.run_as("coder", "merge-gate", self.PR, "--check", "--json")[0], 10, "a waiver is for the head it was logged at")

    def test_pass_takes_the_lock_for_the_caller_and_the_check_then_allows_and_release_frees_it(self):
        code, out, err = self.run_as("coder", "merge-gate", self.PR, "--pass")
        self.assertEqual(code, 0, err)
        code, out, err = self.run_as("coder", "merge-gate", self.PR, "--check", "--json")
        payload = json.loads(out)
        self.assertEqual((code, payload["allowed"], payload["locked"], payload["head"]), (0, True, True, MG_HEAD))
        self.assertEqual(self.run_as("other", "merge-gate", self.PR, "--check", "--json")[0], 10)
        self.assertEqual(self.run_as("coder", "merge-gate", self.PR, "--release")[0], 0)
        self.assertEqual(self.run_as("coder", "merge-gate", self.PR, "--check", "--json")[0], 10)

    def audit_lines(self, event):
        return [e for e in self.world.audit() if e["event"] == event]

    def test_pass_merge_does_the_pass_the_reread_and_one_squash_merge_in_this_process(self):
        code, out, err = self.run_as("coder", "merge-gate", self.PR, "--pass", "--merge")
        self.assertEqual(code, 0, err + out)
        self.assertEqual(self.fake.merges, [["pr", "merge", "9", "-R", "acme/app", "--squash", "--match-head-commit", MG_HEAD]])
        (line,) = self.audit_lines("merge_gate.pass_merge")
        self.assertEqual((line["subject"], line["detail"]["head"], line["detail"]["outcome"], line["detail"]["pass"]), (self.PR, MG_HEAD, "merged", "ok"))
        self.assertEqual(sorted(line["detail"]["reread"]), ["branch", "gates", "head", "labels", "reviews"])
        self.assertEqual(self.audit_lines("merge_gate.pass"), [])
        self.assertEqual(self.run_as("coder", "merge-gate", self.PR, "--check", "--json")[0], 10, "the lock is released")

    def test_a_blocking_review_refuses_the_merge_exit_10_releases_the_lock_and_audits_once(self):
        self.fake.blocking_review = True
        code, out, err = self.run_as("coder", "merge-gate", self.PR, "--pass", "--merge")
        self.assertEqual(code, 10, err + out)
        self.assertEqual(self.fake.merges, [])
        self.assertIn("reviewer-x", out)
        (line,) = self.audit_lines("merge_gate.pass_merge")
        self.assertEqual(line["detail"]["outcome"], "refused: blocking review")
        self.assertEqual(self.run_as("other", "merge-gate", self.PR, "--pass")[0], 0, "nobody holds the lock any more")

    def test_pass_without_merge_never_merges_and_audits_as_before(self):
        code, out, err = self.run_as("coder", "merge-gate", self.PR, "--pass")
        self.assertEqual(code, 0, err)
        self.assertEqual(self.fake.merges, [])
        self.assertEqual((len(self.audit_lines("merge_gate.pass")), self.audit_lines("merge_gate.pass_merge")), (1, []))
        self.assertIn("gate passed for", out)

    def test_merge_without_pass_is_a_usage_error(self):
        self.assertNotEqual(self.run_as("coder", "merge-gate", self.PR, "--check", "--merge")[0], 0)
        self.assertEqual(self.fake.merges, [])

    def test_a_waiver_for_the_merge_gate_is_a_gate_the_waive_command_knows_and_gates_other_than_it_still_work(self):
        self.assertEqual(self.run_as("cos", "waive", self.PR, "--gates", "mg,G1", "--reason", "the merge that fixes the red branch on main")[0], 0)
        (entry,) = self.ledger()
        self.assertEqual(entry["gates"], ["MG", "G1"])


class TestGhShimMergeGate(Base):
    """The shim asks `merge-gate --check` before `gh pr merge` into a repository listed under `merge_gate.repos`; it fails closed there and nowhere else."""

    def setUp(self):
        super().setUp()
        self.bin = self.home / "realbin"
        self.bin.mkdir()
        self.log = self.home / "gh-log.json"
        fake = self.bin / "gh"
        fake.write_text("#!/usr/bin/env python3\nimport json,os,sys\n"
                        "if sys.argv[1:3] == ['repo', 'view']:\n    print(os.environ.get('FAKE_REPO') or ''); sys.exit(0)\n"
                        "if sys.argv[1:3] == ['pr', 'view']:\n    print('{\"reviews\": [], \"headRefOid\": \"' + 'a'*40 + '\"}'); sys.exit(0)\n"
                        "json.dump({'argv': sys.argv[1:]}, open(%r,'w'))\nsys.exit(0)\n" % str(self.log))
        fake.chmod(0o755)
        self.calls = self.home / "mg-calls.log"
        self.sb = self.home / "fakesb"
        self.ctl = self.home / "sb-control"   # what the fake switchboard is told to do goes in FILES: the shim runs it in a fixed environment, so a variable would never reach it
        self.ctl.mkdir()
        self.sb.write_text("#!/bin/sh\n"
                           "for n in FAKE_MG_JSON FAKE_MG_EXIT FAKE_MG_SLEEP FAKE_WHOAMI_JSON_FAIL; do [ -f %r/$n ] && eval \"$n=\\$(cat %r/$n)\"; done\n"
                           "echo \"$1|$2|$3|pyp=$PYTHONPATH|pyh=$PYTHONHOME|ldp=$LD_LIBRARY_PATH|dyl=$DYLD_LIBRARY_PATH|xdg=$XDG_STATE_HOME|fsb=$FLEET_SWITCHBOARD_STATE|mad=$MADE_UP_VARIABLE|path=$PATH|home=$HOME\" >> %r\n"
                           "if [ \"$1\" = whoami ] && [ \"$2\" = --json ] && [ -n \"$FAKE_WHOAMI_JSON_FAIL\" ]; then exit 2; fi\n"
                           "if [ \"$1\" = whoami ] && [ -z \"$2\" ]; then echo worker; exit 0; fi\n"
                           "if [ \"$1\" = whoami ]; then\n  echo '{\"name\": \"worker\", \"repo\": \"acme/app\"}'; exit 0; fi\n"
                           "if [ \"$1\" = gates-check ]; then echo '{\"verdict\": \"allow\", \"mode\": \"shadow\"}'; exit 0; fi\n"
                           "if [ \"$1\" = review ]; then exit 0; fi\n"
                           "if [ \"$1\" = merge-gate ]; then\n  echo \"$@ own=$FLEET_SWITCHBOARD_OWN_GH\" >> %r\n"
                           "  echo \"state=$XDG_STATE_HOME cfg=$XDG_CONFIG_HOME fsb=$FLEET_SWITCHBOARD_STATE bin=$FLEET_SWITCHBOARD_BIN home=$HOME\" >> %r\n"
                           "  [ -n \"$FAKE_MG_SLEEP\" ] && sleep $FAKE_MG_SLEEP\n  [ \"$3\" = --release ] && exit 0\n"
                           "  echo \"$FAKE_MG_JSON\"; exit ${FAKE_MG_EXIT:-0}\nfi\nexit 2\n" % (str(self.ctl), str(self.ctl), str(self.calls) + ".all", str(self.calls), str(self.calls) + ".env"))
        self.sb.chmod(0o755)
        subprocess.run([str(self.sb), "whoami"], capture_output=True, timeout=60)
        (self.home / ".config" / "fleet-switchboard").mkdir(parents=True)
        (self.home / ".config" / "fleet-switchboard" / "config.json").write_text(json.dumps({"merge_gate": {"repos": {"acme/app": {}}}, "plan_gates": {"repos": {"acme/app": {"mode": "shadow"}}}}))
        self.state = self.home / "state"
        self.state.mkdir()

    HEAD = "a" * 40

    shim_path = None   # a mutated copy of the shim a test runs instead (the shim's own directory stays first on PATH)

    def run_shim(self, *args, env=None, binary=True, linked=False):
        environ = {"PATH": "%s:%s:%s" % (SHIM.parent, self.bin, SAFE_PATH), "HOME": str(self.home), "FLEET_SWITCHBOARD_STATE": str(self.state),
                   "FLEET_SHIM_LOOKUP_SECONDS": SHIM_LOOKUP_SECONDS, "FLEET_SHIM_GATE_SECONDS": SHIM_LOOKUP_SECONDS, "FAKE_REPO": "acme/app"}
        if binary:
            environ["FLEET_SWITCHBOARD_BIN"] = str(self.sb)
        environ.update(env or {})
        for name in ("FAKE_MG_JSON", "FAKE_MG_EXIT", "FAKE_MG_SLEEP", "FAKE_WHOAMI_JSON_FAIL"):
            if name in environ:
                (self.ctl / name).write_text(environ[name])
            elif (self.ctl / name).exists():
                (self.ctl / name).unlink()
        if self.log.exists():
            self.log.unlink()
        runner = ("import importlib.util, importlib.machinery, sys\nloader = importlib.machinery.SourceFileLoader('gh', %r)\nspec = importlib.util.spec_from_loader('gh', loader)\n"
                  "m = importlib.util.module_from_spec(spec)\nloader.exec_module(m)\nm.__file__ = %r\nm.MG_HOME = %r\nm.MG_BINARY = %r\nsys.exit(m.main(sys.argv[1:]))\n"
                  % (str(self.shim_path or SHIM), str(SHIM), str(self.home), str(self.sb) if binary and not linked else None))   # the gate's home and program are module attributes, never environment
        done = subprocess.run([sys.executable, "-c", runner, *args], capture_output=True, text=True, env=environ, timeout=60)
        return done, (json.loads(self.log.read_text()) if self.log.exists() else None)

    def merge_calls(self):
        return self.calls.read_text().splitlines() if self.calls.exists() else []

    MERGE = ("pr", "merge", "12", "-R", "acme/app", "--squash")

    def allowed(self, locked=True):
        return {"FAKE_MG_JSON": json.dumps({"allowed": True, "reason": "x", "head": self.HEAD, "locked": locked})}

    def test_the_marker_mutant_fails_the_real_shim_test(self):
        source = (BIN / "merge_gate.py").read_text()
        old = '["--match-head-commit", head], own=False)'
        self.assertEqual(source.count(old), 1)
        mutant = types.ModuleType("merge_gate_mutant")
        exec(compile(source.replace(old, '["--match-head-commit", head], own=True)'), "merge_gate_mutant.py", "exec"), mutant.__dict__)
        with self.assertRaises(AssertionError):
            self.test_pass_and_merge_through_the_real_shim_refuses_a_blocking_review(mutant)

    def test_pass_and_merge_through_the_real_shim_refuses_a_blocking_review(self, module=None):
        """The merge call of `--pass --merge` runs the REAL shim (review_probe) over a fake real gh that reports a CHANGES_REQUESTED review at the head."""
        gate, reading = module or sb.load_module("merge_gate"), sb.load_module("pr_reading")
        fake = self.bin / "gh"
        fake.write_text("#!/usr/bin/env python3\nimport json,os,sys\n"
                        "if sys.argv[1:3] == ['repo', 'view']:\n    print('acme/app'); sys.exit(0)\n"
                        "if sys.argv[1:3] == ['pr', 'view']:\n    print(json.dumps({'headRefOid': 'a'*40, 'reviewDecision': 'CHANGES_REQUESTED', 'reviews': "
                        "[{'author': {'login': 'rev-y'}, 'state': 'CHANGES_REQUESTED', 'commit': {'oid': 'a'*40}}]})); sys.exit(0)\n"
                        "open(%r, 'a').write('REAL MERGE RAN\\n')\nsys.exit(0)\n" % str(self.home / "real-merge-ran"))
        shim_gh = self.home / "shimbin" / "gh"
        shim_gh.parent.mkdir()
        shim_gh.symlink_to(SHIM)
        (self.ctl / "FAKE_MG_JSON").write_text(self.allowed()["FAKE_MG_JSON"])

        class Fake(FakeMergeGitHub):
            """Everything but the merge is the fake GitHub's; the merge runs the real shim as a subprocess, with or without the marker."""
            def __init__(inner, own_marker):
                super().__init__(number=12, repo="acme/app")
                inner.own_marker, inner.shim_result = own_marker, None
                inner.head = TestGhShimMergeGate.HEAD
                inner.blocking_review = False   # the fake's own review read is clean: only the shim can refuse here

            def __call__(inner, argv, own=True):
                if argv[:2] != ["pr", "merge"]:
                    return super().__call__(argv, own)
                environ = {"PATH": "%s:%s:%s" % (self.home / "shimbin", self.bin, SAFE_PATH), "HOME": str(self.home), "FLEET_SWITCHBOARD_STATE": str(self.state),
                           "FLEET_SWITCHBOARD_BIN": str(self.sb), "FLEET_REAL_GH": str(fake), "FLEET_SHIM_LOOKUP_SECONDS": SHIM_LOOKUP_SECONDS,
                           "FLEET_SHIM_GATE_SECONDS": SHIM_LOOKUP_SECONDS}
                if inner.own_marker or own:
                    environ["FLEET_SWITCHBOARD_OWN_GH"] = "1"
                done = subprocess.run([str(shim_gh)] + argv, capture_output=True, text=True, env=environ, timeout=60)
                inner.merges.append(list(argv))
                return done.returncode, done.stdout, done.stderr

        def run(own_marker, module):
            ran = self.home / "real-merge-ran"
            if ran.exists():
                ran.unlink()
            fk = Fake(own_marker)
            fk.number = 12
            state = self.home / ("pm-state-%s" % own_marker)
            state.mkdir(exist_ok=True)
            conf = module.settings({"merge_gate": {"repos": {}}})
            # the module's own review read is skipped here so the SHIM is the only reader (the module's read is proved in TestMergeGatePassAndMerge)
            with mock.patch.object(module, "review_blockers", lambda *a, **k: []):   # restored on exit: the module is the shared, cached one
                got = module.pass_and_merge(reading, fk, conf, state, "acme/app", 12, "coder-a", 4242, fk.clock, fk.sleep, alive=lambda pid: True)
            return got, ran.exists()

        (code, lines, audit), ran = run(False, gate)
        self.assertEqual(code, 10, lines)
        self.assertFalse(ran, "the real merge never ran")
        self.assertEqual(audit["outcome"], "refused: merge exit 10")
        self.assertIsNone(gate.read_lock(self.home / "pm-state-False", "acme/app", "main"), "the lock is released")

    def test_a_refusal_is_one_line_and_the_real_gh_does_not_run(self):
        done, seen = self.run_shim(*self.MERGE, env={"FAKE_MG_EXIT": "10", "FAKE_MG_JSON": json.dumps(
            {"allowed": False, "reason": "merge of acme/app#12 refused: no gate pass recorded; run `fleet-switchboard merge-gate acme/app#12 --pass` first"})})
        self.assertEqual((done.returncode, seen), (10, None))
        self.assertEqual(len(done.stderr.strip().splitlines()), 1)
        self.assertIn("no gate pass recorded", done.stderr)
        self.assertEqual(self.merge_calls(), ["merge-gate acme/app#12 --check --json own=1"])

    def test_an_allowed_merge_is_bound_to_the_checked_head_and_releases_the_lock_when_it_returns(self):
        done, seen = self.run_shim(*self.MERGE, env=self.allowed())
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual(seen["argv"], list(self.MERGE) + ["--match-head-commit", self.HEAD])
        self.assertEqual(self.merge_calls()[-1], "merge-gate acme/app#12 --release own=1")

    def test_an_allowed_merge_without_the_lock_releases_nothing(self):
        done, seen = self.run_shim(*self.MERGE, env=self.allowed(locked=False))
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual(len(self.merge_calls()), 1)

    def test_the_lock_is_released_even_when_the_merge_fails(self):
        (self.bin / "gh").write_text((self.bin / "gh").read_text().replace("sys.exit(0)\n", "sys.exit(0)\n", 1).rsplit("sys.exit(0)", 1)[0] + "sys.exit(9)\n")
        done, seen = self.run_shim(*self.MERGE, env=self.allowed())
        self.assertEqual(done.returncode, 9)
        self.assertEqual(self.merge_calls()[-1], "merge-gate acme/app#12 --release own=1")

    def test_the_gate_fails_closed_without_a_switchboard_on_an_error_and_on_a_late_answer(self):
        done, seen = self.run_shim(*self.MERGE, binary=False)
        self.assertEqual((done.returncode, seen), (10, None))
        self.assertIn("cannot be asked", done.stderr)
        done, seen = self.run_shim(*self.MERGE, env={"FAKE_MG_EXIT": "1", "FAKE_MG_JSON": "{}"})
        self.assertEqual((done.returncode, seen), (10, None))
        self.assertIn("could not decide", done.stderr)
        done, seen = self.run_shim(*self.MERGE, env=dict(self.allowed(), FAKE_MG_SLEEP="5", FLEET_SHIM_MERGE_GATE_SECONDS="1"))
        self.assertEqual((done.returncode, seen), (10, None))
        self.assertIn("did not answer in time", done.stderr)

    def test_the_merge_gate_wait_variable_never_makes_a_merge_allowed_whatever_it_is_set_to(self):
        for value in ("0", "-5", "0.001", "nan", "garbage", "", "1e9", "inf"):
            with self.subTest(value=value, gate="refuses"):   # a gate that refuses refuses, however long or short the wait
                done, seen = self.run_shim(*self.MERGE, env={"FAKE_MG_EXIT": "10", "FAKE_MG_JSON": '{"allowed": false, "reason": "no gate pass"}', "FLEET_SHIM_MERGE_GATE_SECONDS": value})
                self.assertEqual((done.returncode, seen), (10, None))
        for value in ("0", "-5", "0.001", "nan"):
            with self.subTest(value=value, gate="slow"):   # a wait that clamps to the one-second floor expires before a slow gate answers: refused, the real gh never runs
                done, seen = self.run_shim(*self.MERGE, env=dict(self.allowed(), FAKE_MG_SLEEP="4", FLEET_SHIM_MERGE_GATE_SECONDS=value))
                self.assertEqual((done.returncode, seen), (10, None))
                self.assertIn("did not answer in time", done.stderr)

    def test_a_repository_that_is_not_listed_and_a_command_that_is_not_a_merge_are_not_asked(self):
        done, seen = self.run_shim("pr", "merge", "12", "-R", "acme/other", "--squash")
        self.assertEqual((done.returncode, self.merge_calls()), (0, []))
        done, seen = self.run_shim("pr", "ready", "12", "-R", "acme/app")
        self.assertEqual((done.returncode, self.merge_calls()), (0, []))

    def test_an_exit_zero_that_does_not_say_allowed_is_refused(self):
        for payload in ("{}", json.dumps({"allowed": False, "head": self.HEAD}), json.dumps({"allowed": "yes", "head": self.HEAD})):
            with self.subTest(payload=payload):
                done, seen = self.run_shim(*self.MERGE, env={"FAKE_MG_JSON": payload})
                self.assertEqual((done.returncode, seen), (10, None))
                self.assertIn("could not decide", done.stderr)

    def test_every_route_that_merges_is_asked_and_what_it_cannot_see_is_the_stated_limit(self):
        repo = "acme/app"
        refused = (("pr", "merge", "--", "12", "-R", repo), ("pr", "merge", "12", "-R", repo, "--no-such-flag"), ("pr", "merge", "12", "--admin", "-R", repo),
                   ("api", "-X", "PUT", "repos/%s/pulls/12/merge" % repo), ("api", "repos/%s/pulls/12/merge" % repo, "--method", "PUT", "-f", "merge_method=squash"),
                   ("api", "--method=PUT", "/repos/%s/pulls/12/merge" % repo), ("api", "repos/{owner}/{repo}/pulls/12/merge", "-X", "PUT"),
                   ("api", "repos/%s/pulls/$N/merge" % repo, "-X", "PUT"),
                   ("api", "graphql", "-f", "query=mutation{mergePullRequest(input:{pullRequestId:\"x\"}){clientMutationId}}"),
                   ("api", "graphql", "-f", "query=mutation{enablePullRequestAutoMerge(input:{pullRequestId:\"x\"}){clientMutationId}}"),
                   ("api", "graphql", "--input", "query.json"), ("api", "graphql", "-F", "query=@query.graphql"))
        for args in refused:
            with self.subTest(args=args):
                if self.calls.exists():
                    self.calls.unlink()
                done, seen = self.run_shim(*args, env={"FAKE_MG_EXIT": "10", "FAKE_MG_JSON": json.dumps({"allowed": False, "reason": "no gate pass recorded"})})
                self.assertEqual((done.returncode, seen), (10, None), done.stderr)
                self.assertTrue(done.stderr.strip().splitlines()[-1].startswith("gh: "), done.stderr)   # the refusal is the last line, in one line
        unlisted = (("pr", "merge", "--", "12", "-R", "acme/other"), ("api", "-X", "PUT", "repos/acme/other/pulls/12/merge"),
                    ("api", "repos/%s/pulls/12/merge" % repo), ("api", "repos/%s/pulls/12" % repo, "-X", "PATCH", "-f", "state=closed"),
                    ("api", "graphql", "-f", "query={viewer{login}}"), ("m", "12"))   # the last one is an alias the shim cannot see: the documented limit
        for args in unlisted:
            with self.subTest(args=args):
                done, seen = self.run_shim(*args, env={"FAKE_MG_EXIT": "10", "FAKE_MG_JSON": "{}"})
                self.assertEqual(done.returncode, 0, args)
                self.assertIsNotNone(seen)

    BASE_PATH = "repos/acme/app/pulls/12/merge"

    @classmethod
    def api_spellings(cls):
        """The matrix, GENERATED from the base path: each way a path can be written that GitHub reads as the same call."""
        base, out = cls.BASE_PATH, {"base": cls.BASE_PATH}
        out.update({"query": base + "?x=1", "empty query": base + "?", "fragment": base + "#a", "both": base + "/?a=b#c", "trailing slash": base + "/",
                    "leading slash": "/" + base, "leading double slash": "//" + base, "upper case": base.upper(), "mixed case": "Repos/Acme/App/Pulls/12/Merge",
                    "url form": "https://api.github.com/" + base, "owner placeholder": "repos/:owner/:repo/pulls/12/merge",
                    "brace placeholder": "repos/{owner}/{repo}/pulls/12/merge", "variable": "repos/acme/app/pulls/$N/merge", "encoded number": "repos/acme/app/pulls/%7Bn%7D/merge",
                    "pull as a name": "repos/acme/app/pulls/head/merge", "extra segment": base + "/extra"})
        for i in range(len(base)):
            if base[i] not in "/":   # percent-encode each character in turn
                out["encoded %d" % i] = base[:i] + "%%%02x" % ord(base[i]) + base[i + 1:]
        for i in range(len(base)):
            if base[i] == "/":
                out["double slash %d" % i] = base[:i] + "//" + base[i + 1:]
        out["double encoded"] = base.replace("/", "%252f")
        out.update({"nul": base + "%00", "space": base + "%20", "semicolon": base + ";x", "backslashes": base.replace("/", "\\"), "encoded backslashes": base.replace("/", "%5c"),
                    "tab": base + "%09", "suffix": base + "able"})
        out.update({"dot segment": "repos/acme/app/pulls/12/../12/merge", "dot once": "repos/acme/app/pulls/./12/merge", "dot at the end": base + "/.",
                    "dot-dot elsewhere": "repos/x/../acme/app/pulls/12/merge", "encoded dots": "repos/acme/app/pulls/12/%2e%2e/12/merge",
                    "encoded dot": "repos/acme/app/pulls/%2e/12/merge", "double-encoded dots": "repos/acme/app/pulls/12/%252e%252e/12/merge",
                    "dots, double slash and case": "REPOS/acme//app/PULLS/12/../12//MERGE", "climbs above repos": "repos/../repos/acme/app/pulls/12/merge",
                    "climbs from the start": "../repos/acme/app/pulls/12/merge", "climbs far": "repos/acme/app/pulls/12/../../../../x/pulls/1/merge"})
        return out

    API_SPELLINGS = ()   # kept for the mutant test below, filled from the generated matrix

    def refused_api(self, spelling, **more):
        done, seen = self.run_shim("api", "-X", "PUT", spelling, env={"FAKE_MG_EXIT": "10", "FAKE_MG_JSON": json.dumps({"allowed": False, "reason": "no gate pass recorded"})}, **more)
        return done.returncode == 10 and seen is None

    def test_every_spelling_of_the_api_merge_path_is_asked_or_refused(self):
        matrix = self.api_spellings()
        self.assertGreater(len(matrix), 40, "the matrix is derived from the base path, one entry per character and per slash")
        for name, spelling in matrix.items():
            with self.subTest(spelling=name):
                self.assertTrue(self.refused_api(spelling), spelling)

    def mutated_shim(self, old, new, count=1):
        """A copy of the shim with one edit (`old` -> `new`), or with several when `old` is a list of (old, new) pairs."""
        source = SHIM.read_text()
        for one, other in (old if isinstance(old, list) else [(old, new)]):
            self.assertEqual(source.count(one), count if not isinstance(old, list) else 1, one)
            source = source.replace(one, other)
        path = self.home / "gh-mutant"
        path.write_text(source)
        self.shim_path = path

    def test_each_mutant_of_the_route_matching_lets_a_spelling_through_and_the_tests_see_it(self):
        cases = (("a path is not percent-decoded", "decoded = urllib.parse.unquote(path)", "decoded = path"),
                 ("a path is matched case-sensitively", [('/merge$", re.I)', '/merge$")'), ('/merge", path, re.I)', '/merge", path)')], None),
                 ("repeated slashes are not collapsed", 're.sub(r"/{2,}", "/", ', "("),
                 ("a gh placeholder is read as a repository", r'[{}$<>:]', r'[{}$<>]'),
                 ("dot segments are not resolved", 'parts, climbed = resolve_dots(path.split("/"))', 'parts, climbed = path.split("/"), False'),
                 ("a merge path is only seen at the end of the argument", '(^|/)pulls/[^/]*/merge", path, re.I)', '(^|/)pulls/[^/]*/merge$", path, re.I)'))
        for label, old, new, *count in cases:
            with self.subTest(mutant=label):
                self.mutated_shim(old, new, *(count or [1]))
                self.assertFalse(all(self.refused_api(sp) for sp in self.api_spellings().values()), label)
        self.shim_path = None

    def call_shapes(self):
        """The invocations, GENERATED: each way of giving the repository (`-R r`, `-Rr`, `--repo r`, `--repo=r`, and the URL in place of the number) placed in every
        position between the words of `pr merge 12`, with a boolean flag and a flag that takes a value (`--hostname`) mixed in."""
        repo = "acme/app"
        forms = {"-R r": ["-R", repo], "-Rr": ["-R" + repo], "--repo r": ["--repo", repo], "--repo=r": ["--repo=" + repo]}
        shapes = {}
        for name, flag in forms.items():
            for extra_name, extra in (("", []), (" +squash", ["--squash"]), (" +hostname", ["--hostname", "github.com"])):
                for slot in range(4):   # before `pr`, between `pr` and `merge`, between `merge` and the number, after the number
                    words = [["pr"], ["merge"], ["12"], []]
                    placed = [w for i, ws in enumerate(words) for w in ((flag + extra) if i == slot else []) + ws]
                    shapes["%s%s at %d" % (name, extra_name, slot)] = placed
        shapes["url instead of the number"] = ["pr", "merge", "https://github.com/%s/pull/12" % repo]
        shapes["url, flag between"] = ["pr", "--squash", "merge", "https://github.com/%s/pull/12" % repo]
        shapes["number first"] = ["pr", "merge", "12", "-R", repo, "--squash"]
        return shapes

    def refused_call(self, args):
        if self.calls.exists():
            self.calls.unlink()
        done, seen = self.run_shim(*args, env={"FAKE_MG_EXIT": "10", "FAKE_MG_JSON": json.dumps({"allowed": False, "reason": "no gate pass recorded"})})
        asked = any(l.startswith("merge-gate acme/app#12 --check") for l in self.merge_calls()) or "--hostname" in args   # `pr merge` has no --hostname: refused as not understood
        return done.returncode == 10 and seen is None and asked

    def test_every_placement_of_the_persistent_flags_asks_the_gate(self):
        shapes = self.call_shapes()
        self.assertGreater(len(shapes), 40)
        for name, args in shapes.items():
            with self.subTest(shape=name):
                self.assertTrue(self.refused_call(args), args)

    def shim_module(self):
        """The shim (or the mutated copy a test runs) loaded from its SOURCE TEXT: no bytecode cache, so two mutants of the same size written in the same second are never mixed up."""
        path = self.shim_path or SHIM
        module = types.ModuleType("gh_shim_one_parser")
        module.__file__ = str(path)
        exec(compile(Path(path).read_text(), str(path), "exec"), module.__dict__)
        return module

    DECIDERS = ["canonical_pr_merge", "explicit_repo", "gate_bind_merge", "gate_parse", "gate_probe", "merge_route", "review_probe", "take_over_review"]

    def one_parser_problems(self):
        """[what went wrong] for each generated call shape: every probe of `run` must be handed the same canonical `pr merge`."""
        shim = self.shim_module()
        problems = []
        for name, args in self.call_shapes().items():
            seen = {}
            with mock.patch.object(shim, "real_gh", lambda: "/bin/true"), mock.patch.object(shim, "hold_probe", lambda a, *r: (seen.__setitem__("hold", list(a)), (None, None, None))[1]), \
                    mock.patch.object(shim, "review_probe", lambda a, *r, **k: seen.__setitem__("review", list(a))), \
                    mock.patch.object(shim, "gate_probe", lambda a, *r, **k: seen.__setitem__("gate", list(a))), \
                    mock.patch.object(shim, "merge_gate_probe", lambda a, *r, **k: seen.__setitem__("merge", list(a))), \
                    mock.patch.object(shim, "account_env", lambda *a, **k: None), mock.patch.object(shim.os, "execv", lambda *a: (_ for _ in ()).throw(SystemExit(0))), \
                    mock.patch.object(shim.os, "execve", lambda *a: (_ for _ in ()).throw(SystemExit(0))), mock.patch.object(shim, "Lookup", lambda **k: mock.Mock(identity=lambda: {})):
                try:
                    shim.run(list(args))
                except SystemExit:
                    pass
            if sorted(seen) != ["gate", "hold", "merge", "review"]:
                problems.append("%s: only %s were asked" % (name, sorted(seen)))
            problems += ["%s: %s was handed %s" % (name, label, got) for label, got in seen.items() if got[:2] != ["pr", "merge"]]
        return problems

    def test_the_functions_of_the_shim_that_decide_on_merge_are_counted_and_each_one_reads_the_one_canonical_form(self):
        """Derived: the functions of shims/gh that name `merge` are exactly DECIDERS (a new one fails here until it is read and added), and every probe of `run`,
        the hold check of gh_hold.py among them, is handed the SAME canonical `pr merge` for each generated call shape: the one parser runs once at the top of `run`."""
        import ast
        source = SHIM.read_text()
        named = sorted(n.name for n in ast.parse(source).body if isinstance(n, ast.FunctionDef) and ('"merge"' in ast.get_source_segment(source, n) or "'merge'" in ast.get_source_segment(source, n)))
        self.assertEqual(named, self.DECIDERS)
        self.assertEqual(self.one_parser_problems(), [])

    def test_a_shim_without_the_one_parser_at_the_top_of_run_fails_that_test(self):
        self.mutated_shim("    args = canonical_pr_merge(args)   # THE one parse", "    pass   # THE one parse")
        problems = self.one_parser_problems()
        self.shim_path = None
        self.assertTrue(problems, "the mutant that drops the one parser must be seen")

    def test_an_unknown_flag_before_the_verb_is_never_read_as_the_end_of_the_command(self):
        """The fallback of `canonical_pr_merge`: a word that is not a known verb, with `merge` after it, is read as a merge (an unknown flag's value was taken for the verb)."""
        for args in (["pr", "--no-such-flag", "value", "merge", "12", "-R", "acme/app"], ["pr", "--no-such-flag=1", "merge", "12", "-R", "acme/app"]):
            with self.subTest(args=args):
                if self.calls.exists():
                    self.calls.unlink()
                done, seen = self.run_shim(*args, env={"FAKE_MG_EXIT": "10", "FAKE_MG_JSON": json.dumps({"allowed": False, "reason": "no gate pass recorded"})})
                self.assertEqual((done.returncode, seen), (10, None), done.stderr)
        self.mutated_shim('merge = next((w for w in words[2:] if w[1] == "merge"), None)', "merge = None")
        done, seen = self.run_shim("pr", "--no-such-flag", "value", "merge", "12", "-R", "acme/app")
        self.assertEqual(done.returncode, 0, "without the fallback that spelling reaches the real gh: the test pins it")
        self.shim_path = None

    def test_a_shim_that_reads_only_the_second_word_misses_the_generated_shapes(self):
        self.mutated_shim("    words = command_word_positions(args)\n    if len(words) < 2 or words[0][1] != \"pr\":", "    return args\n    words = command_word_positions(args)\n    if len(words) < 2 or words[0][1] != \"pr\":")
        self.assertFalse(all(self.refused_call(a) for a in self.call_shapes().values()))
        self.shim_path = None

    def test_every_xdg_and_fleet_switchboard_name_the_switchboard_reads_is_dropped_from_its_environment_unless_listed(self):
        names = sorted(set(re.findall(r'"((?:XDG_|FLEET_SWITCHBOARD_)[A-Z_]+)"', (BIN / "fleet-switchboard").read_text())))
        self.assertGreater(len(names), 5)
        shim = self.shim_module()
        with mock.patch.dict(os.environ, {n: "x" for n in names}):
            seen = shim.sb_env(own=True)
        kept = sorted(n for n in names if n in seen)
        self.assertEqual(kept, sorted(set(shim.ENV_ALLOW + ("FLEET_SWITCHBOARD_OWN_GH",)) & set(names)), "only the identity names and the own-call marker survive")

    FAMILIES = {"PYTHONPATH": "/tmp/evil-py", "PYTHONHOME": "/tmp/evil-home", "PYTHONUSERBASE": "/tmp/evil-user", "PYTHONSTARTUP": "/tmp/evil-start", "LD_PRELOAD": "/tmp/evil.so",
                "LD_LIBRARY_PATH": "/tmp/evil-lib", "DYLD_INSERT_LIBRARIES": "/tmp/evil.dylib", "DYLD_LIBRARY_PATH": "/tmp/evil-dy", "XDG_STATE_HOME": "/tmp/evil-state",
                "FLEET_SWITCHBOARD_STATE": "/tmp/evil-fsb", "FLEET_SWITCHBOARD_BIN": "/tmp/evil-bin", "MADE_UP_VARIABLE": "1", "PATH": "/tmp/evil-path", "GH_TOKEN": "x"}
    DENY_LIST = '    env = {k: v for k, v in os.environ.items() if not k.startswith(("XDG_", "FLEET_SWITCHBOARD_"))}'
    ALLOW_LIST = '    env = {"PATH": ENV_PATH}\n    for name in ENV_ALLOW:\n        if name in os.environ:\n            env[name] = os.environ[name]'
    TAIL = '    if own:\n        env["FLEET_SWITCHBOARD_OWN_GH"] = "1"\n    return env'

    def family_problems(self):
        """Which hostile families reach a switchboard through `sb_env`: the names, or the PATH when it is the caller's."""
        shim = self.shim_module()
        with mock.patch.dict(os.environ, self.FAMILIES):
            env = shim.sb_env(own=True)
        reached = sorted(n for n in self.FAMILIES if n != "PATH" and n in env)
        return reached + (["PATH"] if env.get("PATH") == self.FAMILIES["PATH"] else [])

    def test_no_hostile_family_reaches_a_switchboard_and_the_environment_is_an_allow_list(self):
        self.assertEqual(self.family_problems(), [])
        shim = self.shim_module()
        with mock.patch.dict(os.environ, self.FAMILIES):
            env = shim.sb_env()
        self.assertLessEqual(set(env), set(shim.ENV_ALLOW) | {"PATH", "HOME"})
        self.assertEqual(env["PATH"], shim.ENV_PATH)

    def test_each_hostile_family_has_a_mutant_that_lets_it_through_and_the_family_test_sees_it(self):
        for name in self.FAMILIES:
            with self.subTest(variable=name):
                self.mutated_shim(self.TAIL, '    env[%r] = os.environ[%r]\n' % (name, name) + self.TAIL)
                problems = self.family_problems()
                self.shim_path = None
                self.assertIn(name, problems)

    def test_a_deny_list_in_place_of_the_allow_list_is_seen_by_the_family_test(self):
        self.mutated_shim(self.ALLOW_LIST, self.DENY_LIST)
        problems = self.family_problems()
        self.shim_path = None
        for family in ("PYTHONPATH", "LD_PRELOAD", "DYLD_INSERT_LIBRARIES", "MADE_UP_VARIABLE", "PATH"):
            self.assertIn(family, problems)

    IDENTITY_ROWS = {"LANG": "en_US.UTF-8", "LC_ALL": "C", "LC_CTYPE": "C", "TMPDIR": "/tmp/x", "TERM": "xterm", "HERDR_SOCKET_PATH": "/tmp/h.sock", "HERDR_PANE_ID": "p_1",
                     "HERDR_TAB_ID": "t_1", "HERDR_WORKSPACE_ID": "w_1", "OPENCODE_SESSION_ID": "ses_example", "FLEET_SWITCHBOARD_ROLE": "coder", "FLEET_SWITCHBOARD_REPO": "acme/app"}

    def allowed_names(self):
        """The names `sb_env` may pass, DERIVED from the code: the literal of `ENV_ALLOW` in the shim's source."""
        import ast
        for n in ast.parse(SHIM.read_text()).body:
            if isinstance(n, ast.Assign) and any(getattr(t, "id", "") == "ENV_ALLOW" for t in n.targets):
                return [e.value for e in n.value.elts]
        self.fail("ENV_ALLOW not found")

    def allow_problems(self):
        """[problem] per allow-list name that does not pass with its value when the caller sets it, and for HOME and the python."""
        shim = self.shim_module()
        problems = []
        for name, value in self.IDENTITY_ROWS.items():
            with mock.patch.dict(os.environ, {name: value}):
                if shim.sb_env().get(name) != value:
                    problems.append(name)
        with mock.patch.dict(os.environ, {"HOME": "/tmp/evil-home-dir"}):
            if shim.sb_env().get("HOME") != shim.mg_home():
                problems.append("HOME")
        hostile = self.home / "hostile-bin"
        hostile.mkdir(exist_ok=True)
        fake = hostile / "python3"
        fake.write_text("#!/bin/sh\nexit 0\n")
        fake.chmod(0o755)
        script = self.home / "pyprog"
        script.write_text("#!/usr/bin/env python3\nprint(1)\n")
        with mock.patch.dict(os.environ, {"PATH": "%s:%s" % (hostile, os.environ.get("PATH", ""))}):
            if shim.sb_argv(str(script), "x")[0] == str(fake):
                problems.append("python3")
        return problems

    def test_every_allow_listed_name_passes_when_set_and_has_a_row_and_home_and_python_come_from_the_fixed_places(self):
        self.assertEqual(sorted(self.allowed_names()), sorted(self.IDENTITY_ROWS), "a name added to ENV_ALLOW needs a row in IDENTITY_ROWS")
        self.assertEqual(self.allow_problems(), [])

    def test_a_mutant_of_each_allow_list_row_is_seen(self):
        for name in self.allowed_names():
            with self.subTest(name=name):
                self.mutated_shim('"%s"' % name, '"UNLISTED_%s"' % name, count=SHIM.read_text().count('"%s"' % name))
                problems = self.allow_problems()
                self.shim_path = None
                self.assertIn(name, problems)
        cases = (("HOME", 'env["HOME"] = home', 'env["HOME"] = os.environ.get("HOME", home)'),
                 ("python3", 'shutil.which("python3", path=ENV_PATH)', 'shutil.which("python3")'))
        for name, old, new in cases:
            with self.subTest(name=name):
                self.mutated_shim(old, new)
                problems = self.allow_problems()
                self.shim_path = None
                self.assertIn(name, problems)

    def start_calls(self):
        """The calls of shims/gh that start the switchboard, FOUND IN THE CODE: a call whose command is `sb_argv(binary, ...)`. Each: (the call node, its env keyword node)."""
        import ast
        out = []
        for n in ast.walk(ast.parse(SHIM.read_text())):
            if isinstance(n, ast.Call) and n.args and isinstance(n.args[0], ast.Call) and getattr(n.args[0].func, "id", "") == "sb_argv":
                out.append((n, next((k.value for k in n.keywords if k.arg == "env"), None)))
        return sorted(out, key=lambda item: item[0].lineno)

    def test_every_switchboard_the_shim_starts_is_started_with_the_fixed_environment_and_isolated(self):
        import ast
        calls = self.start_calls()
        self.assertEqual(len(calls), 6, "whoami --json, whoami, review blockers, gates-check, merge-gate check, merge-gate release")
        for call, env in calls:
            self.assertTrue(isinstance(env, ast.Call) and getattr(env.func, "id", "") == "sb_env")
        shim = self.shim_module()
        script = self.home / "pyscript"
        script.write_text("#!/usr/bin/env python3\nprint(1)\n")
        other = self.home / "shscript"
        other.write_text("#!/bin/sh\nexit 0\n")
        self.assertEqual(shim.sb_argv(str(script), "x")[1:], ["-I", str(script), "x"], "a Python program is started isolated, with the python of the FIXED path")
        self.assertEqual(shim.sb_argv(str(other), "x"), [str(other), "x"])

    SITES = ("whoami|--json", "whoami", "review|blockers|acme/app#12", "gates-check|acme/app#12|--for", "merge-gate|acme/app#12|--check", "merge-gate|acme/app#12|--release")
    HOSTILE_SITE = {"PYTHONPATH": "/tmp/evil-py", "LD_LIBRARY_PATH": "/tmp/evil-lib", "DYLD_LIBRARY_PATH": "/tmp/evil-dy",   # loader PATHS, not preloads: a bogus preload would stop the test's own shim process
                    "XDG_STATE_HOME": "/tmp/evil-state", "FLEET_SWITCHBOARD_STATE": "/tmp/evil-fsb", "MADE_UP_VARIABLE": "1"}

    def observe_sites(self):
        """{site: the row the switchboard logged for it} for the six calls, with the hostile families set in the shim's environment (two runs: the second makes
        `whoami --json` fail so the plain `whoami` is asked)."""
        log = Path(str(self.calls) + ".all")
        rows = {}
        for json_fails in (False, True):
            if log.exists():
                log.unlink()
            env = dict(self.allowed(), **self.HOSTILE_SITE)
            if json_fails:
                env["FAKE_WHOAMI_JSON_FAIL"] = "1"
            done, _ = self.run_shim(*self.MERGE, env=env)
            self.assertTrue(log.exists(), "the switchboard was never started: rc %s, %s" % (done.returncode, done.stderr[-300:]))
            for line in log.read_text().splitlines():
                head, _, tail = line.partition("|pyp=")
                rows.setdefault(head.rstrip("|"), "pyp=" + tail)
        return rows

    def leaks(self, row):
        """The hostile names in one logged row."""
        return [name for name, key in (("PYTHONPATH", "pyp"), ("LD_LIBRARY_PATH", "ldp"), ("DYLD_LIBRARY_PATH", "dyl"), ("XDG_STATE_HOME", "xdg"),
                                       ("FLEET_SWITCHBOARD_STATE", "fsb"), ("MADE_UP_VARIABLE", "mad")) if re.search(r"(^|\|)%s=[^|]" % key, row)]

    def test_the_environment_of_each_of_the_six_switchboard_calls_is_observed_and_clean(self):
        rows = self.observe_sites()
        self.assertEqual(sorted(rows), sorted(self.SITES), "one row per call site: a seventh call must be added to SITES")
        for site, row in rows.items():
            with self.subTest(site=site):
                self.assertEqual(self.leaks(row), [], row)
                self.assertIn("path=%s|" % self.shim_module().ENV_PATH, row)

    def test_a_call_site_that_passes_the_callers_environment_on_is_seen_by_its_own_row(self):
        """One mutant per call site, DERIVED from the code: its `env=` replaced by the caller's environment; exactly that site's row must then show a hostile name."""
        for index in range(len(self.start_calls())):
            with self.subTest(call=index):
                call, env = self.start_calls()[index]
                lines = SHIM.read_text().splitlines(True)
                line = lines[env.lineno - 1]
                lines[env.lineno - 1] = line[:env.col_offset] + "dict(os.environ)" + line[env.end_col_offset:]
                path = self.home / "gh-mutant"
                path.write_text("".join(lines))
                self.shim_path = path
                try:
                    rows = self.observe_sites()
                finally:
                    self.shim_path = None
                self.assertEqual(sum(1 for row in rows.values() if self.leaks(row)), 1, "exactly the mutated site leaks")

    def test_a_switchboard_python_script_cannot_be_given_a_library_through_the_environment(self):
        """The probe: a switchboard that is a Python program and says `allowed` only when a `sitecustomize` from the caller's PYTHONPATH ran in it."""
        evil = self.home / "evil-py"
        evil.mkdir()
        (evil / "sitecustomize.py").write_text("import builtins\nbuiltins.FORGED_BY_THE_CALLER = True\n")
        probe = self.home / "pysb"
        probe.write_text("#!%s\nimport builtins, json, sys\n"
                         "if sys.argv[1] == 'whoami': print(json.dumps({'name': 'worker', 'repo': 'acme/app'})); sys.exit(0)\n"
                         "if sys.argv[1] == 'merge-gate' and sys.argv[3] == '--check':\n"
                         "    if hasattr(builtins, 'FORGED_BY_THE_CALLER'): print(json.dumps({'allowed': True, 'head': %r, 'locked': False})); sys.exit(0)\n"
                         "    print(json.dumps({'allowed': False, 'reason': 'no gate pass recorded'})); sys.exit(10)\n" % (sys.executable, self.HEAD))
        probe.chmod(0o755)
        self.sb = probe
        refused, seen = self.run_shim(*self.MERGE, env={"PYTHONPATH": str(evil)})
        self.assertEqual((refused.returncode, seen), (10, None), refused.stderr)
        self.mutated_shim([(self.ALLOW_LIST, self.DENY_LIST), ('[python, "-I", binary]', "[python, binary]")], None)   # the two defences removed together
        try:
            leaked, seen = self.run_shim(*self.MERGE, env={"PYTHONPATH": str(evil)})
        finally:
            self.shim_path = None
        self.assertEqual(leaked.returncode, 0, "with neither the allow list nor -I the library reaches the switchboard and the real gh runs: the probe sees it")

    def test_the_net_under_the_merge_gate_probe_refuses_when_anything_unexpected_goes_wrong(self):
        for mutate in (False, True):
            if mutate:
                self.mutated_shim('        return mg_refuse("merge refused: the merge gate hit an unexpected error")', "        return None")
            shim = self.shim_module()
            self.shim_path = None
            with mock.patch.object(shim, "merge_gate_repos", lambda: {"acme/app"}), mock.patch.object(shim, "mg_binary", lambda: (_ for _ in ()).throw(RuntimeError("hostile"))):
                got = shim.merge_gate_probe(["pr", "merge", "12", "-R", "acme/app"], mock.Mock(), "/bin/true")
            if mutate:
                self.assertIsNone(got, "the mutant allows by default: the test above would have caught it")
            else:
                self.assertEqual(got[0], "refuse")

    def test_the_program_comes_from_the_account_home_and_never_from_the_environment_even_when_nothing_is_injected(self):
        liar = self.home / "liar"
        liar.write_text("#!/bin/sh\n[ \"$1\" = merge-gate ] && echo '{\"allowed\": true, \"head\": \"%s\"}'\n[ \"$1\" = whoami ] && echo '{\"name\": \"worker\", \"repo\": \"acme/app\"}'\nexit 0\n" % self.HEAD)
        liar.chmod(0o755)
        (self.home / ".local" / "bin").mkdir(parents=True)
        (self.home / ".local" / "bin" / "fleet-switchboard").symlink_to(self.sb)
        env = {"FAKE_MG_EXIT": "10", "FAKE_MG_JSON": json.dumps({"allowed": False, "reason": "no gate pass recorded"}), "FLEET_SWITCHBOARD_BIN": str(liar)}
        done, seen = self.run_shim(*self.MERGE, env=env, linked=True)
        self.assertEqual((done.returncode, seen), (10, None), done.stderr)
        self.mutated_shim('binary = os.path.realpath(os.path.join(home,', 'binary = os.environ.get("FLEET_SWITCHBOARD_BIN") or os.path.realpath(os.path.join(home,')
        done, seen = self.run_shim(*self.MERGE, env=env, linked=True)
        self.assertEqual(done.returncode, 0, "the mutant that reads the program from the environment is caught by this test")
        self.shim_path = None

    def test_an_allowed_api_merge_releases_the_lock_when_it_returns(self):
        done, seen = self.run_shim("api", "-X", "PUT", "repos/acme/app/pulls/12/merge", env=self.allowed())
        self.assertEqual((done.returncode, seen["argv"]), (0, ["api", "-X", "PUT", "repos/acme/app/pulls/12/merge"]))
        self.assertEqual(self.merge_calls()[-1], "merge-gate acme/app#12 --release own=1")

    def test_a_worker_cannot_switch_the_gate_off_or_point_it_elsewhere_through_its_environment(self):
        other = self.home / "elsewhere"
        (other / "empty").mkdir(parents=True)
        liar = self.home / "liar"
        liar.write_text("#!/bin/sh\n[ \"$1\" = merge-gate ] && echo '{\"allowed\": true, \"head\": \"%s\"}'\n[ \"$1\" = whoami ] && echo '{\"name\": \"worker\", \"repo\": \"acme/app\"}'\nexit 0\n" % self.HEAD)
        liar.chmod(0o755)
        refuse = {"FAKE_MG_EXIT": "10", "FAKE_MG_JSON": json.dumps({"allowed": False, "reason": "no gate pass recorded"})}
        for extra in ({"FLEET_SWITCHBOARD_OWN_GH": "1"}, {"XDG_CONFIG_HOME": str(other / "empty")}, {"HOME": str(other)}, {"FLEET_SWITCHBOARD_BIN": str(liar)}):
            with self.subTest(env=sorted(extra)):
                done, seen = self.run_shim(*self.MERGE, env=dict(refuse, **extra))
                self.assertEqual((done.returncode, seen), (10, None), done.stderr)

    def test_the_gate_reads_the_account_home_from_the_password_database_not_from_the_environment(self):
        loader = importlib.machinery.SourceFileLoader("gh_shim_home", str(SHIM))
        shim = importlib.util.module_from_spec(importlib.util.spec_from_loader("gh_shim_home", loader))
        loader.exec_module(shim)
        import pwd
        with mock.patch.dict(os.environ, {"HOME": str(self.home / "elsewhere"), "XDG_CONFIG_HOME": str(self.home / "elsewhere")}):
            self.assertEqual(shim.mg_home(), pwd.getpwuid(os.getuid()).pw_dir)

    def test_a_configuration_that_cannot_be_read_refuses_a_merge(self):
        (self.home / ".config" / "fleet-switchboard" / "config.json").write_text(json.dumps({"merge_gate": {"repos": "acme/app"}}))
        done, seen = self.run_shim(*self.MERGE, env=self.allowed())
        self.assertEqual((done.returncode, seen), (10, None))
        self.assertIn("could not be read", done.stderr)

    def test_auto_merge_is_refused_for_a_gated_repository(self):
        done, seen = self.run_shim(*self.MERGE, "--auto", env=self.allowed())
        self.assertEqual((done.returncode, seen), (10, None))
        self.assertIn("--auto", done.stderr)


class TestMergeGateDocs(unittest.TestCase):
    """Clause 9 and the neutral-names rule: the section says the gate, the lock, the waiver and that it is the fleet's own merge queue; neither it nor the
    new files hold a real pull request number or a private name."""

    def section(self):
        text = (REPO / "docs" / "switchboard.md").read_text()
        return text.split("## The merge gate and the merge lock", 1)[1].split("\n## ", 1)[0]

    def test_the_section_states_the_gate_the_lock_the_waiver_and_the_queue(self):
        section = self.section()
        self.assertIn("**It is the fleet's own merge queue.**", section)
        for statement in ("`fleet-switchboard merge-gate <repo#N>`** reads and writes nothing", "**The lock.**", "--gates MG"):
            self.assertEqual(section.count(statement), 1, statement)

    def test_the_section_states_pass_merge_and_why_a_held_pull_request_keeps_the_two_step_form(self):
        paragraphs = [p for p in self.section().split("\n\n") if "--pass --merge" in p and "held" in p.lower() and "two-step" in p]
        self.assertEqual(len(paragraphs), 1)

    def test_the_configuration_example_uses_neutral_names(self):
        section = self.section()
        self.assertIn("acme-org/widget-service", section)
        self.assertEqual(re.findall(r"#\d{3,}", section), ["#962", "#952"])


