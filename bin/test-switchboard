            self.assertIn("stays the owner's own clear", err, label)
            self.assertIn(paths[0] if review is None else "credentials", err, label)
            self.assertEqual([w for w in self.writes if w[0] == "DELETE"], [], label)

    def test_an_independent_review_class_that_is_authority_is_refused_even_when_the_paths_are_only_authority(self):
        self.delegate()
        self.files_of_pr("migrations/0002.sql")
        self.passes()
        for review in (("hold", "authority"), ("hold", "identity"), ("hold", None)):
            self.review = (review, None)
            code, out, err = self.under()
            self.assertEqual(code, 2, review)
            self.assertIn("independent review", err, review)
        self.review = (None, None)   # no review recorded at this head: unknown is refused
        code, out, err = self.under()
        self.assertEqual(code, 2)
        self.assertIn("no independent review is recorded", err)
        self.assertEqual([w for w in self.writes if w[0] == "DELETE"], [])

    def test_s4_the_clear_and_hold_machinery_files_and_a_change_to_the_clear_closure_are_refused_other_bin_edits_pass(self):
