        self.assertIn("PLAN GATES: the global kill file exists", status)

    def test_cos_and_a_person_may_change_a_mode_and_it_is_audited(self):
        self.world.add_agent("cos", fleet={"role": "chief-of-staff"})
        self.configure_ci_recorder()
        code, out, err = self.run_as("cos", "gates", "mode", "acme/app", "shadow")   # cos may set shadow and off
        self.assertEqual(code, 0, err)
        code, out, err = self.run_as(None, "gates", "mode", "acme/app", "enforce")   # only the owner, at a terminal, turns enforcement on
        self.assertEqual(code, 0, err)
        raw = json.loads(self.config_file.read_text())
        self.assertEqual(raw["plan_gates"]["repos"]["acme/app"], {"mode": "enforce", "enabled": True})
        self.assertEqual(raw["intent_repo"], "acme/app", "every other key is kept")
        code, out, err = self.run_as("cos", "gates", "mode", "acme/app", "off")
        self.assertEqual(code, 0, err)
        self.assertFalse(json.loads(self.config_file.read_text())["plan_gates"]["repos"]["acme/app"]["enabled"])
        self.assertEqual([(e["detail"]["by"], e["detail"]["mode"]) for e in self.events("gate.mode")],
                         [("cos", "shadow"), ("a person at a shell", "enforce"), ("cos", "off")])

    def test_the_command_itself_refuses_to_turn_enforcement_on_for_anyone_but_the_owner_at_a_terminal(self):
        """The decision depends only on WHO calls: a wrapper (`timeout N fleet-switchboard gates ...`, `env`, a pipe) does not change the caller."""
        self.world.add_agent("cos", fleet={"role": "chief-of-staff"})
        self.configure_ci_recorder()
        self.set_gates({"acme/app": {"mode": "shadow"}})
        before = self.config_file.read_text()
        for caller in ("cos", "coder"):
            for argv in (("mode", "acme/app", "enforce"), ("on",)):
                with self.subTest(caller=caller, argv=argv):
                    (self.world.state / "plan-gates.off").write_text("")
                    code, out, err = self.run_as(caller, "gates", *argv)
                    self.assertEqual(code, 2)
                    self.assertTrue("turns enforcement on" in err or "may not change gate modes" in err, err)
                    self.assertEqual(self.config_file.read_text(), before, "nothing was written")
                    self.assertTrue((self.world.state / "plan-gates.off").exists(), "the kill file stays")
        # an unknown session (an uncertain identity) is refused too, never read as the owner
        with mock.patch.dict(os.environ):
            os.environ["OPENCODE_SESSION_ID"] = "ses_nobody"
            code, out, err = self.run_as("cos", "gates", "mode", "acme/app", "enforce")
        self.assertEqual(code, 2)
        self.assertEqual(self.config_file.read_text(), before)
        self.assertIn("gate.mode.refused", [e["event"] for e in self.world.audit()])
        # the owner at a terminal may; the chief of staff may still turn gates OFF, set shadow and (separately tested) waive
        code, out, err = self.run_as(None, "gates", "on")
        self.assertEqual(code, 0, err)
        code, out, err = self.run_as(None, "gates", "mode", "acme/app", "enforce")
        self.assertEqual(code, 0, err)
        self.assertEqual(self.run_as("cos", "gates", "off")[0], 0)
        self.assertEqual(self.run_as("cos", "gates", "mode", "acme/app", "shadow")[0], 0)

    def configure_ci_recorder(self):
        self.configure()   # the default evaluators include a `ci` recorder

    def test_any_other_agent_is_refused_and_nothing_changes(self):
        before = self.config_file.read_text()
        for word in (("mode", "acme/app", "off"), ("off",)):
            code, out, err = self.run_as("coder", "gates", *word)
            self.assertEqual(code, 2)
            self.assertIn("may not change gate modes", err)
        self.assertEqual(self.config_file.read_text(), before)
        self.assertFalse((self.world.state / "plan-gates.off").exists())
        self.assertEqual(len(self.events("gate.mode.refused")), 2)

    def test_an_unknown_session_is_refused_not_read_as_a_person(self):
        before = self.config_file.read_text()
        os.environ["OPENCODE_SESSION_ID"] = "ses_nosuchsession"
        try:
            code, out, err = self.run_as(None, "gates", "mode", "acme/app", "off")
            code2, _, err2 = self.run_as(None, "gates", "off")
        finally:
            os.environ.pop("OPENCODE_SESSION_ID", None)
        self.assertEqual((code, code2), (2, 2))
        self.assertIn("uncertain identity is refused", err)
        self.assertEqual(self.config_file.read_text(), before)
        self.assertFalse((self.world.state / "plan-gates.off").exists())

    def test_a_known_session_that_is_not_a_fleet_agent_is_a_person(self):
        os.environ["OPENCODE_SESSION_ID"] = self.world.v2.create_session({})   # no metadata.fleet: a person's session
        try:
            self.assertEqual(self.run_as(None, "gates", "off")[0], 0)
        finally:
            os.environ.pop("OPENCODE_SESSION_ID", None)

    def test_enforce_set_by_hand_in_the_config_runs_as_shadow_until_the_preflight_passes(self):
        self.configure(evaluators={})   # no ci recorder
        self.extra_config = {"plan_gates": {"repos": {"acme/app": {"mode": "enforce"}}}}
        self.configure(evaluators={})
        for _ in range(2):
            code, out, err = self.check("ready")
            self.assertEqual((code, out["mode"]), (0, "shadow"), "a hand-edited enforce does not refuse")
            self.assertIn("enforce is not active", out["downgraded"])
        self.assertEqual(len(self.events("gate.enforce_downgraded")), 1, "logged once a day per repo")
        self.assertIn("gate.would_refuse", [e["event"] for e in self.world.audit()])
        text = self.run_as(None, "status")[1]
        self.assertIn("enforce REQUESTED but running as shadow", text)
        self.configure()   # the default evaluators include a ci recorder
        code, out, _ = self.check("ready")
        self.assertEqual((code, out["mode"], out.get("downgraded")), (10, "enforce", None))

    def test_gates_off_and_on_make_and_remove_the_kill_file(self):
        self.assertEqual(self.run_as(None, "gates", "off")[0], 0)
        self.assertTrue((self.world.state / "plan-gates.off").exists())
        self.assertEqual(self.run_as(None, "gates", "on")[0], 0)
        self.assertFalse((self.world.state / "plan-gates.off").exists())
        self.assertEqual(self.run_as(None, "gates", "on")[0], 0, "removing it twice is fine")

    def test_enforce_is_refused_until_a_ci_recorder_is_registered(self):
        self.configure(evaluators={"reviewer": ["rev"]})
        self.extra_config = {"plan_gates": {"repos": {"acme/app": {"mode": "shadow"}}}}
        self.configure(evaluators={"reviewer": ["rev"]})
        code, out, err = self.run_as(None, "gates", "mode", "acme/app", "enforce")
        self.assertEqual(code, 2)
        self.assertIn("plan_evaluators.ci", err)
        self.assertEqual(json.loads(self.config_file.read_text())["plan_gates"]["repos"]["acme/app"]["mode"], "shadow")
        code, out, err = self.run_as(None, "gates", "preflight", "acme/app")
        self.assertEqual(code, 1)
        self.assertIn("blocking:", out)
        self.assertIn("`tester`", out)

    def test_enforce_is_blocked_until_the_installed_cos_definition_allows_the_way_out(self):
        cos = self.home / "cos-definition.md"
        narrow = (("fleet-switchboard waive *", "allow"), ("fleet-switchboard gates mode * shadow", "allow"), ("fleet-switchboard gates off", "allow"))
        for text, lacks in ((None, "could not be read"), ("", "waive"), (COS_ALLOWING.replace("allow", "deny"), "waive"),
                            (cos_rules_text(("fleet-switchboard waive *", "allow"), *COS_GUARDS), "gates mode acme/app shadow"),   # no gates allow
                            (cos_rules_text(("fleet-switchboard gates *", "allow"), *COS_GUARDS), "waive acme/app#1"),             # no waive allow
                            (cos_rules_text(("fleet-switchboard gates *", "allow"), ("fleet-switchboard waive *", "allow")), "turning enforcement on"),  # no guards: cos could turn it ON
                            (cos_rules_text(("fleet-switchboard gates *", "allow"), ("fleet-switchboard waive *", "allow"), *COS_GUARDS[:3]), "waiving G6"),  # waive G6 open
                            (cos_rules_text(*narrow, shape="block"), "waiving G6"),                                                  # the older shape, waive * unguarded
                            (cos_rules_text(*narrow[:2]), "gates off")):                                                             # gates off missing
            with self.subTest(lacks=lacks):
                cos.unlink(missing_ok=True)
                if text is not None:
                    cos.write_text(text)
                self.set_gates({"acme/app": {"mode": "shadow"}})
                code, out, err = self.run_as(None, "gates", "preflight", "acme/app")
                self.assertIn("chief of staff cannot yet turn enforcement off", out + err)
                self.assertIn(lacks, out + err)
                self.assertNotEqual(code, 0)
                code, out, err = self.run_as(None, "gates", "mode", "acme/app", "enforce")
                self.assertNotEqual(code, 0, "the mode switch is refused")
                self.set_gates({"acme/app": {"mode": "enforce"}})
                code, out, err = self.run_as("coder", "gates-check", self.PR, "--for", "merge", "--json")
                self.assertEqual((code, json.loads(out)["mode"]), (0, "shadow"), "set by hand, it still runs as shadow")
        deny_first = cos_rules_text(*COS_GUARDS, ("fleet-switchboard gates *", "allow"), ("fleet-switchboard waive *", "allow"))   # v2: the LAST match wins, so a deny placed first loses
        cos.write_text(deny_first)
        self.assertIn("turning enforcement on", sb.plan_ledger.cos_lacking(deny_first))
        timeout_hole = cos_rules_text(("fleet-switchboard gates *", "allow"), ("fleet-switchboard waive *", "allow"), ("timeout ? fleet-switchboard *", "allow"), *COS_GUARDS)
        self.assertIn("timeout", sb.plan_ledger.cos_lacking(timeout_hole), "the bare guards do not cover the timeout wrapper: the check must say so")
        for good in (COS_ALLOWING_FULL, cos_rules_text(*narrow, *COS_GUARDS, shape="block")):
            cos.write_text(good)
            code, out, err = self.run_as(None, "gates", "preflight", "acme/app")
            self.assertNotIn("cannot yet turn enforcement off", out + err)

    def test_the_kits_own_chief_of_staff_definition_passes_the_cos_check_and_loses_it_without_its_guards(self):
        text = (REPO / "agents" / "opencode" / "chief-of-staff.md").read_text()
        self.assertEqual(sb.plan_ledger.cos_lacking(text), "")
        self.assertEqual(sb.plan_ledger.cos_lacking((REPO / "agents" / "opencode" / "cos-subagent.md").read_text()), "")
        # a hostile copy: the guards on turning gates ON are removed: the check must say so
        unguarded = "\n".join(l for l in text.splitlines() if not ("fleet-switchboard gates" in l and ("enforce" in l.lower() or "gates on" in l)))
        self.assertIn("turning enforcement on", sb.plan_ledger.cos_lacking(unguarded))
        # and one without the allow for waive
        no_waive = "\n".join(l for l in text.splitlines() if "fleet-switchboard waive *" not in l or "deny" in l)
        self.assertIn("does not allow", sb.plan_ledger.cos_lacking(no_waive))

    def test_the_cos_check_reads_only_the_front_matter_permissions_and_flags_a_name_key(self):
        rules = COS_ALLOWING_FULL
        front = "---\ndescription: x\nmode: primary\nmodel: m/m\npermissions:\n" + rules + "---\n"
        self.assertEqual(sb.plan_ledger.cos_lacking(front + "# body\n"), "")
        # a rule-shaped line in the BODY prose never counts: a definition with no allows but prose quoting them is still lacking
        bare = "---\ndescription: x\npermissions:\n  - {action: \"*\", resource: \"*\", effect: deny}\n---\n" + rules
        self.assertIn("does not allow", sb.plan_ledger.cos_lacking(bare))
        # a `name:` key makes v2 ignore the whole list
        named = "---\nname: chief-of-staff\ndescription: x\npermissions:\n" + rules + "---\n"
        self.assertIn("`name:` key", sb.plan_ledger.cos_lacking(named))

    def test_a_bad_mode_or_usage_is_refused(self):
        for argv in (("mode", "acme/app", "loud"), ("mode", "acme/app"), ("mode",)):
            with self.subTest(argv=argv):
                self.assertEqual(self.run_as(None, "gates", *argv)[0], 2)

    # -- config and status

    def test_the_plan_gates_config_is_checked(self):
        base = {"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR}
        self.assertNotIn("plan_gates", sb.validate_config(dict(base)))
        good = sb.validate_config(dict(base, plan_gates={"repos": {"a/b": {}}}))["plan_gates"]
        self.assertEqual(good["repos"]["a/b"], {"mode": "shadow", "enabled": True, "budget_ms": 3000,
                                                 "enforce_gates": ["G0a", "G1"]})
        self.assertEqual(sb.validate_config(dict(base, plan_gates={"repos": {"a/b": {"enforce_gates": ["G6", "G1"]}}}))
                         ["plan_gates"]["repos"]["a/b"]["enforce_gates"], ["G1", "G6"], "kept in gate order")
        for bad in ([], {"repo": {}}, {"repos": {"nope": {}}}, {"repos": {"a/b": {"mode": "off"}}}, {"repos": {"a/b": {"enabled": "yes"}}},
                    {"repos": {"a/b": {"budget_ms": 5}}}, {"repos": {"a/b": {"budget_ms": True}}}, {"repos": {"a/b": {"x": 1}}},
                    {"repos": {"a/b": "shadow"}}, {"repos": {"a/b": {"enforce_gates": []}}},
                    {"repos": {"a/b": {"enforce_gates": ["G2"]}}}, {"repos": {"a/b": {"enforce_gates": ["G1", "G1"]}}},
                    {"repos": {"a/b": {"enforce_gates": "G1"}}}):
            with self.subTest(bad=bad):
                with self.assertRaises(sb.ConfigError):
                    sb.validate_config(dict(base, plan_gates=bad))

    def test_status_shows_each_repos_mode_and_todays_counts(self):
        self.check("merge")
        self.gh_down = True
        self.check("merge")
        text = self.run_as(None, "status")[1]
        self.assertIn("plan gates acme/app: shadow; today 1 check(s), 0 refusal(s), 1 would-refuse, 1 fail-open(s)", text)

    def test_the_shim_only_probes_in_shadow_and_the_command_only_reads_github(self):
        self.assertNotIn("sys.exit(10)", (REPO / "shims" / "gh").read_text())   # the shim never refuses (slice 3b is shadow only)
        self.check("merge")   # the route refuses any write: the test passing is the proof
        self.assertNotIn("gates-check", sb.ENSURE_ON_USE_COMMANDS)


class TestLaunchGate(LedgerBase):
    """Slice 3c (E4): `launch` checks the brief's PLAN: link for a consensus record at the plan's current hash. SHADOW ONLY."""

    def setUp(self):
        super().setUp()
        self.work = self.home / "work"
        self.work.mkdir()
        self.extra_config = {"plan_gates": {"repos": {"acme/app": {"mode": "shadow"}}}}
        self.configure()

    def launch(self, brief="Do the thing.\nPLAN: acme/app#7\n", name="newcoder", *more):
        os.environ["HERDR_WORKSPACE_ID"] = "w1"
        os.environ.pop("HERDR_PANE_ID", None)
        argv = ["launch", name, "--agent", "coder", "--dir", str(self.work), "--role", "coder", "--reports-to", "own",
                "--issue", "7", "--brief-file", "-", "--terminal", *more]
        with captured() as (out, err), mock.patch.object(sys, "stdin", io.StringIO(brief)):
            code = sb.main(argv, runner=self.route, now=self.world.clock.now, socket_call=self.world.herdr.socket)
        return code, out.getvalue(), err.getvalue()

    def events(self, name):
        return [e for e in self.world.audit() if e["event"] == name]

    def plan_hash(self):
        ns = types.SimpleNamespace(source="acme/app#7", file=None, ask=None, done_when=None)
        with mock.patch.object(sb, "load_config", return_value=sb.load_config()):
            return sb.load_plan(ns, self.route, self.world.clock.now)[2]["plan_hash"]

    def record_consensus(self, plan_hash):
        sb.plan_ledger.append_entry(self.world.state, {"kind": "consensus", "result": "pass", "pr": "-", "scenario": "-",
                                                       "plan_hash": plan_hash, "by": "reviewer-engine"}, 5)

    def test_a_launch_without_consensus_is_recorded_as_would_refuse_and_still_launches(self):
        code, out, err = self.launch()
        self.assertEqual(code, 0, err)
        self.assertEqual(sorted(json.loads(out)), ["name", "pane", "session", "tab"], "the launch went ahead")
        (event,) = self.events("gate.would_refuse")
        self.assertEqual((event["subject"], event["detail"]["for"], event["detail"]["failed"]), ("launch:newcoder", "launch", ["G0b"]))
        self.assertIn("no consensus record", event["detail"]["reason"])
        self.assertIn("would be refused (shadow", err)

    def test_a_consensus_record_at_the_current_hash_makes_it_quiet(self):
        self.record_consensus(self.plan_hash())
        code, out, err = self.launch()
        self.assertEqual(code, 0, err)
        self.assertEqual(self.events("gate.would_refuse"), [])
        self.assertNotIn("would be refused", err)

    def test_editing_the_plan_voids_the_consensus(self):
        self.record_consensus(self.plan_hash())
        self.plan_issue["body"] = LEDGER_PLAN.replace("Commissioning works.", "Commissioning works, with a new constraint.")
        code, out, err = self.launch()
        self.assertEqual(code, 0, err)
        self.assertEqual(len(self.events("gate.would_refuse")), 1)

    def test_a_brief_with_no_plan_link_is_recorded_and_launches(self):
        code, out, err = self.launch(brief="Just do it, no plan\n")
        self.assertEqual(code, 0, err)
        (event,) = self.events("gate.would_refuse")
        self.assertIn("no `PLAN:` link", event["detail"]["reason"])

    def test_a_plan_that_fails_the_check_or_cannot_be_read_is_recorded(self):
        self.plan_issue["body"] = LEDGER_PLAN.replace('pass: the list call returns status 200 and exactly 1 agent named "alpha"', "pass: works")
        self.assertEqual(self.launch(name="c1")[0], 0)
        self.assertIn("fails `plan check`", self.events("gate.would_refuse")[-1]["detail"]["reason"])
        self.assertEqual(self.launch(brief="PLAN: acme/app#99\n", name="c2")[0], 0)
        self.assertIn("could not be read", self.events("gate.would_refuse")[-1]["detail"]["reason"])

    def test_it_never_refuses_even_in_enforce(self):
        self.extra_config = {"plan_gates": {"repos": {"acme/app": {"mode": "enforce"}}}}
        self.configure()
        code, out, err = self.launch()
        self.assertEqual(code, 0, err)
        self.assertEqual(self.events("gate.would_refuse")[0]["detail"]["mode"], "enforce")
        self.assertEqual(self.events("gate.refused"), [])

    def test_not_opted_in_disabled_and_the_kill_file_each_stay_quiet(self):
        for n, repos in enumerate(({}, {"acme/other": {"mode": "shadow"}}, {"acme/app": {"mode": "shadow", "enabled": False}})):
            with self.subTest(repos=repos):
                self.extra_config = {"plan_gates": {"repos": repos}} if repos else {}
                self.configure()
                self.assertEqual(self.launch(name="q%d" % n)[0], 0)
                self.assertEqual(self.events("gate.would_refuse"), [])
        self.extra_config = {"plan_gates": {"repos": {"acme/app": {"mode": "shadow"}}}}
        self.configure()
        (self.world.state / "plan-gates.off").write_text("")
        self.assertEqual(self.launch(name="c9")[0], 0)
        self.assertEqual(self.events("gate.would_refuse"), [])
        self.assertEqual(len(self.events("gate.killed")), 1)

    def test_trouble_is_a_fail_open_and_the_launch_goes_on(self):
        with mock.patch.object(sb.plan_ledger, "launch_findings", side_effect=ValueError("boom")):
            code, out, err = self.launch()
        self.assertEqual(code, 0, err)
        (event,) = self.events("gate.fail_open")
        self.assertEqual((event["detail"]["for"], event["detail"]["first_today"]), ("launch", True))
        self.assertIn("boom", event["detail"]["reason"])

    def test_a_check_that_outruns_its_budget_fails_open_and_does_not_hold_the_launch(self):
        self.extra_config = {"plan_gates": {"repos": {"acme/app": {"mode": "shadow", "budget_ms": 500}}}}
        self.configure()
        base = self.route

        def slow(argv, **kw):
            if argv[0] == FAKE_GH:
                time.sleep(1.5)
            return base(argv, **kw)
        self.route = slow
        started = time.time()
        code, out, err = self.launch()
        self.assertEqual(code, 0, err)
        self.assertIn("no answer within 500 ms", self.events("gate.fail_open")[0]["detail"]["reason"])
        self.assertLess(time.time() - started, 3.5)

    def test_a_resume_is_not_checked(self):
        session = self.world.sessions["coder"]
        os.environ["HERDR_WORKSPACE_ID"] = "w1"
        with captured() as (out, err):
            sb.main(["launch", "coder9", "--resume", session], runner=self.route, now=self.world.clock.now,
                    socket_call=self.world.herdr.socket)
        self.assertEqual(self.events("gate.would_refuse"), [])

    def test_a_consensus_entry_is_a_ledger_kind_and_counts_only_for_its_hash(self):
        self.record_consensus("sha256:" + "a" * 64)
        entries, problem = sb.plan_ledger.read_ledger(self.world.state)
        self.assertIsNone(problem)
        self.assertIsNotNone(sb.plan_ledger.consensus_at(entries, "sha256:" + "a" * 64))
        self.assertIsNone(sb.plan_ledger.consensus_at(entries, "sha256:" + "b" * 64))


class TestCiRecorder(LedgerBase):
    """The built-in `ci` recorder: `gates ci-record <pr>`, and the preflight that refuses the reserved name until it has worked."""

    def setUp(self):
        super().setUp()
        self.set_default_gates()

    def set_default_gates(self):
        self.extra_config = {"plan_gates": {"repos": {"acme/app": {"mode": "shadow"}}}}
        self.configure(evaluators={"ci": ["switchboard"], "reviewer": ["rev"], "tester": ["tst"]})

    def record(self, *more):
        return self.run_as(None, "gates", "ci-record", self.PR, *more)

    def events(self, name):
        return [e for e in self.world.audit() if e["event"] == name]

    def verdicts(self):
        return [(e["scenario"], e["by"], e["head"]) for e in self.ledger() if e["kind"] == "verdict"]

    def test_green_ci_records_a_ci_verdict_for_each_scenario_that_names_ci_at_the_head_and_plan_hash(self):
        code, out, err = self.record()
        self.assertEqual(code, 0, err)
        self.assertEqual(self.verdicts(), [("S1", "switchboard", LEDGER_HEAD), ("U1", "switchboard", LEDGER_HEAD)])
        entry = self.ledger()[0]
        self.assertEqual((entry["evaluator"], entry["result"]), ("ci", "pass"))
        self.assertRegex(entry["plan_hash"], r"^sha256:[0-9a-f]{64}$")
        (event,) = self.events("gate.ci_record")
        self.assertEqual((event["detail"]["ok"], event["detail"]["recorded"]), (True, ["S1", "U1"]))

    def test_it_records_nothing_for_a_failing_pending_or_missing_run(self):
        for rollup, word in (([{"conclusion": "FAILURE", "status": "COMPLETED"}], "failing"),
                             ([{"status": "IN_PROGRESS", "conclusion": ""}], "pending"), ([], "none")):
            with self.subTest(ci=word):
                self.pr["statusCheckRollup"] = rollup
                code, out, err = self.record()
                self.assertEqual(code, 2)
                self.assertIn("CI is %s" % word, err)
        self.assertEqual(self.verdicts(), [])
        self.assertTrue(all(e["detail"]["ok"] is False for e in self.events("gate.ci_record")))

    def test_it_is_bound_to_the_exact_head_and_a_push_voids_it(self):
        self.record()
        self.assertEqual(self.record()[0], 0)
        self.assertEqual(len(self.verdicts()), 2, "a second run records nothing twice")
        self.pr["headRefOid"] = LEDGER_NEW_HEAD
        self.assertEqual(self.record()[0], 0)
        self.assertEqual([v[2] for v in self.verdicts()], [LEDGER_HEAD] * 2 + [LEDGER_NEW_HEAD] * 2)

    def test_it_is_bound_to_the_plan_hash(self):
        self.record()
        self.plan_issue["body"] = LEDGER_PLAN.replace("exactly 1 agent named", "exactly 2 agents named")
        self.assertEqual(self.record()[0], 0)
        self.assertEqual(len({e["plan_hash"] for e in self.ledger()}), 2)

    def test_a_plan_with_no_ci_scenario_or_a_failing_plan_records_nothing(self):
        self.plan_issue["body"] = LEDGER_PLAN.replace("proof: test", "proof: live").replace("evaluator: ci", "evaluator: tester")
        code, out, err = self.record()
        self.assertEqual(code, 0)
        self.assertIn("nothing to record", out)
        self.assertEqual(self.verdicts(), [])
        self.plan_issue["body"] = LEDGER_PLAN.replace('pass: the list call returns status 200 and exactly 1 agent named "alpha"', "pass: works")
        self.assertEqual(self.record()[0], 2)

    def test_the_recorded_verdict_satisfies_g1_for_those_scenarios_and_no_agent_can_use_the_recorders_name(self):
        self.assertEqual(self.record()[0], 0)
        code, report, _ = self.gates_json()
        g1 = next(r for r in report["gates"] if r["gate"] == "G1")
        self.assertFalse(any("S1: ci verdict" in m or "U1: ci verdict" in m for m in g1["missing"]), g1["missing"])
        self.assertTrue(any(m.startswith("S2:") for m in g1["missing"]), "the tester and reviewer scenarios still need theirs")
        ok, why = sb.plan_ledger.may_record_verdict("ci", "switchboard", {"ci": ["switchboard"]}, set())
        self.assertFalse(ok)
        self.assertIn("built-in recorder's name", why)

    def gates_json(self):
        code, out, err = self.run_as("coder", "gates", self.PR, "--json")
        return code, json.loads(out), err

    # -- the preflight

    def test_the_reserved_name_is_refused_until_the_recorder_has_recorded(self):
        code, out, err = self.run_as(None, "gates", "mode", "acme/app", "enforce")
        self.assertEqual(code, 2)
        self.assertIn("has not recorded recently", err)
        self.assertIn("BLOCKED", self.run_as(None, "gates", "preflight", "acme/app")[1])
        self.assertEqual(self.record()[0], 0)
        code, out, err = self.run_as(None, "gates", "mode", "acme/app", "enforce")
        self.assertEqual(code, 0, err)

    def test_a_failed_record_does_not_prove_the_recorder(self):
        self.pr["statusCheckRollup"] = [{"conclusion": "FAILURE", "status": "COMPLETED"}]
        self.record()
        self.assertEqual(self.run_as(None, "gates", "mode", "acme/app", "enforce")[0], 2)

    def test_a_stale_record_does_not_prove_it(self):
        self.record()
        self.world.clock.t += sb.plan_ledger.CI_RECORD_FRESH_SECONDS + 3600
        self.assertEqual(self.run_as(None, "gates", "mode", "acme/app", "enforce")[0], 2)

    def test_a_hand_edited_enforce_runs_as_shadow_until_the_recorder_is_proven(self):
        self.extra_config = {"plan_gates": {"repos": {"acme/app": {"mode": "enforce"}}}}
        self.configure(evaluators={"ci": ["switchboard"]})
        code, out, err = self.run_as("coder", "gates-check", self.PR, "--for", "ready", "--json")
        self.assertEqual(code, 0)
        self.assertEqual(json.loads(out)["mode"], "shadow")
        self.assertIn("has not recorded recently", json.loads(out)["downgraded"])
        self.record()
        code, out, err = self.run_as("coder", "gates-check", self.PR, "--for", "ready", "--json")
        self.assertEqual((code, json.loads(out)["mode"]), (10, "enforce"))

    def test_an_agent_registered_for_ci_still_passes_the_preflight_and_none_does_not(self):
        self.configure(evaluators={"ci": ["cibot"]})
        self.assertEqual(self.run_as(None, "gates", "mode", "acme/app", "enforce")[0], 0)
        self.configure(evaluators={})
        self.assertEqual(self.run_as(None, "gates", "mode", "acme/app", "shadow")[0], 0)
        code, out, err = self.run_as(None, "gates", "mode", "acme/app", "enforce")
        self.assertEqual(code, 2)
        self.assertIn("no `ci` recorder is registered", err)

    def test_preflight_says_owner_verdicts_come_only_from_the_owners_terminal(self):
        self.assertIn("only from the owner's own terminal", self.run_as(None, "gates", "preflight", "acme/app")[1])


class TestOwnerTerminal(LedgerBase):
    """The owner's own terminal is established, not assumed: a controlling TTY and no agent process among the ancestors."""

    class Tty:
        def __init__(self, tty):
            self.tty = tty

        def isatty(self):
            return self.tty

    def chain(self, table):
        """A fake `ps`: {pid: (ppid, command)}; None for a pid it does not know."""
        return lambda pid: table.get(pid)

    def problem(self, table, start=100, tty=True, **kw):
        return sb.owner_terminal_problem(self.Tty(tty), self.Tty(tty), self.chain(table), start, **kw)

    def test_a_terminal_with_no_agent_ancestor_is_the_owners(self):
        table = {100: (90, "-zsh"), 90: (80, "/Applications/Term.app/Contents/MacOS/Term"), 80: (1, "/sbin/launchd")}
        self.assertIsNone(self.problem(table))

    def test_pipes_are_not_a_terminal(self):
        table = {100: (1, "-zsh")}
        for stdin, stdout in ((False, True), (True, False), (False, False)):
            with self.subTest(stdin=stdin, stdout=stdout):
                got = sb.owner_terminal_problem(self.Tty(stdin), self.Tty(stdout), self.chain(table), 100)
                self.assertIn("not a terminal", got)

    def test_an_agent_ancestor_anywhere_in_the_chain_refuses(self):
        for command in ("/home/u/.local/bin/opencode --agent coder", "/opt/bin/fleet-opencode -s ses_1", "node /opt/lib/opencode/cli.js run",
                        "/usr/local/bin/copilot --agent x"):
            with self.subTest(command=command):
                table = {100: (90, "-zsh"), 90: (80, "sh -c run"), 80: (70, command), 70: (1, "/sbin/launchd")}
                self.assertIn("an agent process is an ancestor", self.problem(table))

    def test_a_chain_that_cannot_be_read_or_does_not_end_refuses(self):
        self.assertIn("cannot be read", self.problem({100: (90, "-zsh")}))          # 90 is unknown
        loop = {n: (n + 1, "-zsh") for n in range(100, 140)}
        self.assertIn("deeper than 5", self.problem(loop, depth=5))
        self.assertIn("cannot be established", sb.owner_terminal_problem(object(), object(), self.chain({}), 100))

    def test_a_fake_ps_earlier_on_path_is_never_run(self):
        fake_dir = self.home / "fakebin"
        fake_dir.mkdir()
        marker = self.home / "fake-ps-ran"
        fake = fake_dir / "ps"
        fake.write_text("#!/bin/sh\ntouch %s\necho '1 -zsh'\n" % marker)
        fake.chmod(0o755)
        with mock.patch.dict(os.environ, {"PATH": "%s:/usr/bin:/bin" % fake_dir}):
            got = sb._ps_line(os.getpid())
        self.assertFalse(marker.exists(), "a ps found on PATH decided nothing")
        self.assertIsNotNone(got, "the fixed-path ps answered")

    def test_a_ps_that_is_not_the_expected_binary_is_refused(self):
        mine = self.home / "ps"
        mine.write_text("#!/bin/sh\necho '1 -zsh'\n")
        mine.chmod(0o755)   # owned by the test user, not root
        with mock.patch.object(sb, "PS_CANDIDATES", (str(mine), str(self.home / "nope"))):
            self.assertIsNone(sb._trusted_ps())
            self.assertIsNone(sb._ps_line(os.getpid()), "no trusted ps: the chain cannot be read, so the caller refuses")
            self.assertIn("cannot be read", sb.owner_terminal_problem(self.Tty(True), self.Tty(True), None, os.getpid()))

    def test_the_child_runs_with_a_scrubbed_environment(self):
        self.assertEqual(sb.PS_ENV["PATH"], "/usr/bin:/bin")
        self.assertNotIn("HOME", sb.PS_ENV)
        seen = {}
        real = subprocess.run

        def spy(argv, **kw):
            seen.update(argv=argv, env=kw.get("env"))
            return real(argv, **kw)
        with mock.patch.object(sb.subprocess, "run", spy):
            sb._ps_line(os.getpid())
        self.assertEqual(seen["env"], dict(sb.PS_ENV))
        self.assertIn(seen["argv"][0], sb.PS_CANDIDATES)

    def test_a_real_ps_unreadable_pid_is_refused_not_guessed(self):
        self.assertIsNone(sb._ps_line(2 ** 22 + 12345), "no such process: None, which the caller turns into a refusal")

    def test_an_agent_without_its_session_variables_is_refused_for_the_owner_verdict_and_the_reason_is_logged(self):
        self.plan_issue["body"] = LEDGER_PLAN.replace("    evaluator: reviewer", "    evaluator: owner")
        self.terminal_problem = "an agent process is an ancestor of this command (opencode)"
        code, out, err = self.run_as(None, "verdict", "S3", "--pr", self.PR, "--as", "owner", "--result", "pass", "--evidence", "x")
        self.assertEqual(code, 2)
        self.assertIn("not established as the owner's own terminal", err)
        self.assertIn("an agent process is an ancestor", err)
        (event,) = [e for e in self.world.audit() if e["event"] == "plan.verdict.refused"]
        self.assertIn("an agent process is an ancestor", event["detail"]["why"])
        self.assertEqual([e for e in self.ledger() if e["kind"] == "verdict"], [])

    def test_the_same_check_guards_mode_changes_and_the_kill_file(self):
        self.terminal_problem = "standard input and output are not a terminal (an agent's tool shell runs on pipes)"
        before = self.config_file.read_text()
        self.assertEqual(self.run_as(None, "gates", "off")[0], 2)
        self.assertEqual(self.run_as(None, "gates", "mode", "acme/app", "off")[0], 2)
        self.assertEqual(self.config_file.read_text(), before)
        self.terminal_problem = None
        self.assertEqual(self.run_as(None, "gates", "off")[0], 0)

    def test_the_terminal_check_is_one_function_used_by_every_owner_only_command(self):
        text = SWITCHBOARD.read_text()
        self.assertEqual(text.count("owner_terminal_problem()"), 1, "the check is called from exactly one place")
        for name in ("gates_caller_may_switch", "cmd_verdict"):
            self.assertIn("gates_caller_kind(", inspect.getsource(getattr(sb, name)), name)
        self.assertIn("THE ONE human-terminal check", inspect.getsource(sb.gates_caller_kind))

    def test_the_chief_of_staff_session_does_not_need_a_terminal(self):
        self.world.add_agent("cos", fleet={"role": "chief-of-staff"})
        self.terminal_problem = "not a terminal"
        self.assertEqual(self.run_as("cos", "gates", "off")[0], 0)


class FakeHub:
    """The daemon's GitHub reader, for the ci recorder's pass: `read_pages` answers a list of open PRs per repo and counts reads."""

    def __init__(self, prs):
        self.prs, self.reads, self.down = prs, [], False

    def read_pages(self, path, key=None, timeout=None, older=None, cap=None):
        self.reads.append(path)
        if self.down:
            raise sb.GitHubUnavailable("network unreachable")
        repo = re.match(r"repos/([^/]+/[^/]+)/pulls", path).group(1)
        return list(self.prs.get(repo, [])), False


IMPACT_TABLE = {   # the plan's table (S10): severity -> probability -> action; H hold, 2 second review, . none
    "Catastrophic": dict(zip(("Improbable", "Remote", "Occasional", "Probable", "Frequent"), "HHHHH")),
    "Critical": dict(zip(("Improbable", "Remote", "Occasional", "Probable", "Frequent"), "2HHHH")),
    "Marginal": dict(zip(("Improbable", "Remote", "Occasional", "Probable", "Frequent"), ".22HH")),
    "Negligible": dict(zip(("Improbable", "Remote", "Occasional", "Probable", "Frequent"), "...22")),
}
FLOOR_CONFIG = {"impact_floor": {"repos": {"acme/app": {"globs": ["migrations/**", "api/routes/**", "config/secrets*"],
                                                         "exclude": ["docs/**"]}}}}


class TestImpactFloorPure(unittest.TestCase):
    """#179 slice L3: the hold table, the rating's categories and the path-glob floor. Pure; synthetic paths."""

    def setUp(self):
        self.f = sb.load_impact_floor()
        self.matrix = self.f.load_matrix()

    MATRIX_REL = "docs/review-laws/impact-matrix.json"

    def _meaning_of(self, data):
        return data["owner_hold"]["delegated_clear"]["meaning"]

    def test_899_s1_the_meaning_says_which_refusal_applies_when_in_separate_sentences(self):
        m = self._meaning_of(self.matrix)
        sentences = [s.strip() for s in m.split(". ")]
        self.assertEqual(len([s for s in sentences if "`never_path_classes`" in s]), 1)
        self.assertEqual(len([s for s in sentences if "`top_tier_review_classes`" in s]), 1)
        self.assertEqual(len([s for s in sentences if "WITHOUT a `max_level`" in s]), 1)
        replaces = [s for s in sentences if "replaces" in s]
        self.assertEqual(len(replaces), 1)
        self.assertIn("WITH a `max_level`", replaces[0])
        self.assertIn("`score`", replaces[0])
        self.assertEqual(len([s for s in sentences if "either way" in s]), 1)
        either = [i for i, s in enumerate(sentences) if "either way" in s][0]
        self.assertIn("The refusals below apply either way", sentences[either])      # names the later group, not the replaced two
        self.assertGreater(either, max(i for i, s in enumerate(sentences) if "`top_tier_review_classes`" in s))
        self.assertLess(either, min(i for i, s in enumerate(sentences) if "`clear_code_paths`" in s))
        self.assertTrue(m.rstrip().endswith("."))

    def test_899_s2_every_key_the_meaning_names_exists_and_the_doc_says_the_same(self):
        m = self._meaning_of(self.matrix)
        keys = set(re.findall(r"`([a-z_]+)`", m))
        block = self.matrix["owner_hold"]["delegated_clear"]
        self.assertTrue({"never_path_classes", "top_tier_review_classes", "clear_code_paths", "new_file_globs", "closure_files",
                         "module_roots", "closure_roots", "clear_entry_points", "score", "max_level"} <= keys)
        for k in keys - {"max_level"}:                      # max_level is the owner's configuration key, not a matrix key
            self.assertIn(k, block, k)
        self.assertEqual((REPO / "docs/switchboard.md").read_text().count(m), 1)

    def test_the_twenty_cells_return_the_stored_actions_and_the_review_laws_table_equals_the_matrix(self):
        got = {sev: {pr: self.f.cell_action(self.matrix, sev, pr)[1] for pr in IMPACT_TABLE[sev]} for sev in IMPACT_TABLE}
        self.assertEqual(got, IMPACT_TABLE)                      # byte-identical to the fixture: 20 of 20
        text = (REPO / "docs" / "review-laws" / "REVIEW_LAWS.md").read_text()
        for sev, row in IMPACT_TABLE.items():
            line = [l for l in text.splitlines() if l.startswith("| %s |" % sev)][-1]   # the action table is the last one
            cells = [c.strip() for c in line.strip("|").split("|")][1:]
            self.assertEqual([c[-2] for c in cells], list(row.values()), sev)

    def test_the_rating_uses_the_standards_categories_and_an_eliminated_impact_is_not_rated(self):
        pairs = [(s, p) for s in IMPACT_TABLE for p in IMPACT_TABLE[s]]
        self.assertEqual(len(self.f.rate(self.matrix, pairs)), 20)                 # 4 of 4 severities x 5 of 5 probabilities
        self.assertEqual(self.f.rate(self.matrix, [("Catastrophic", "Eliminated")]), [])
        self.assertEqual(len(self.f.rate(self.matrix, [("Catastrophic", "Eliminated"), ("Marginal", "Remote")])), 1)

    def test_the_rating_can_add_a_hold_but_never_lower_the_floor(self):
        negligible = self.f.rate(self.matrix, [("Negligible", "Improbable")])
        self.assertEqual(self.f.decide(["migrations/1.sql"], negligible)[0], "hold")        # floor holds, rating negligible
        self.assertEqual(self.f.decide(["migrations/1.sql"], [])[0], "hold")                # floor holds, no rating at all
        self.assertEqual(self.f.decide([], self.f.rate(self.matrix, [("Critical", "Remote")]))[0], "hold")   # only the rating is serious
        self.assertEqual(self.f.decide([], self.f.rate(self.matrix, [("Marginal", "Remote")]))[0], "second-review")
        self.assertEqual(self.f.decide([], negligible)[0], "none")

    def test_the_floor_is_paths_only_a_deletion_inside_holds_outside_never_and_excluded_paths_never(self):
        globs, exclude = ["migrations/**", "api/routes/**", "config/secrets*"], ["docs/**"]
        hit = self.f.floor_paths(["migrations/0001.sql", "api/routes/a/b.py", "config/secrets.env", "tests/t.py", "docs/migrations/x.md",
                                  "src/app.py", "generated/api.json"], globs, exclude)
        self.assertEqual(hit, ["api/routes/a/b.py", "config/secrets.env", "migrations/0001.sql"])
        self.assertEqual(self.f.floor_paths(["tests/old_test.py", "docs/old.md"], globs, exclude), [])   # a deletion outside: no hold
        self.assertEqual(self.f.decide([], [])[0], "none")                                               # size is not an input at all

    def test_matching_is_case_insensitive_and_a_rename_counts_through_its_old_path(self):
        self.assertEqual(self.f.floor_paths(["SHIMS/x", "bin/Plan_ledger.py", "other/x"], ["shims/**", "bin/plan_ledger.py"]), ["SHIMS/x", "bin/Plan_ledger.py"])
        self.assertEqual(self.f.floor_paths(["other/x", "shims/x"], ["shims/**"]), ["shims/x"])   # new path other/x, old path shims/x

    def test_config_is_validated_a_string_where_a_list_belongs_fails_loudly(self):
        self.f.validate_config({"repos": {"acme/app": {"globs": ["bin/**"], "exclude": []}}, "enabled": True})
        for bad in ({"repos": {"acme/app": {"globs": "bin/**"}}}, {"repos": {"acme/app": {"globs": []}}}, {"repos": {"acme/app": {"globs": [1]}}},
                    {"repos": []}, {"enabled": "yes"}, {"when": 1}, {"repos": {"acme/app": {"globs": ["a"], "x": 1}}}):
            with self.subTest(bad=bad), self.assertRaises(ValueError):
                self.f.validate_config(bad)
        with self.assertRaises(sb.ConfigError):
            sb.validate_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "impact_floor": {"repos": {"acme/app": {"globs": "bin/**"}}}})

    def test_an_unknown_floor_holds(self):
        decision, reasons = self.f.decide([], [], unknown="GitHub listed 100 of 3000 changed files")
        self.assertEqual(decision, "hold")
        self.assertIn("floor unknown", reasons[0])

    def test_the_built_in_floor_for_this_repo_names_the_proposed_globs_and_excludes_definitions_and_docs(self):
        globs, exclude, force = self.f.floor_for("adamkaplan/fleet-kit")
        hit = self.f.floor_paths(["shims/gh", "plugins/fleet-hooks/a.js", "templates/u.service", "tools/cos-permissions-proof/x.py",
                                  "bin/plan_ledger.py", "agents/opencode/coder.md", "skills/x/SKILL.md", "docs/a.md", "AGENTS.md",
                                  "bin/fleet-switchboard", "bin/impact_floor.py", "docs/review-laws/impact-matrix.json", "docs/review-laws/REVIEW_LAWS.md"], globs, exclude, force)
        self.assertEqual(hit, ["bin/impact_floor.py", "bin/plan_ledger.py", "docs/review-laws/impact-matrix.json", "plugins/fleet-hooks/a.js", "shims/gh",
                               "templates/u.service", "tools/cos-permissions-proof/x.py"])
        self.assertEqual(self.f.floor_for("someone/else"), ([], [], []))


def top_tier_migrations(test):
    """(#451 slice 3) The impact hold labels by the OWNER-HOLD rule, which reads the matrix file's top tier paths. These classes' fixtures use a synthetic path
    (`migrations/**`) as their floor path: for them the matrix the decision loads gains that one path as a top tier path, so the fixtures keep their
    meaning: a change to a top tier path holds."""
    real = sb.impact_floor.load_matrix

    def loaded(path=None):
        matrix = real(path)
        matrix["owner_hold"]["top_tier_paths"]["authority"] = list(matrix["owner_hold"]["top_tier_paths"]["authority"]) + ["migrations/**"]
        return matrix
    test.top_tier_patcher = mock.patch.object(sb.impact_floor, "load_matrix", loaded)
    test.top_tier_patcher.start()
    test.addCleanup(test.top_tier_patcher.stop)


class TestImpactFloorOwnerDecision(LedgerBase):
    """#553: `impact floor` says what the daemon decides under the owner-hold rule (read from the same report), so a pull request the daemon holds never reads NONE. The REAL matrix file."""

    def setUp(self):
        super().setUp()
        self.extra_config = dict(FLOOR_CONFIG, plan_gates={"repos": {"acme/app": {"mode": "shadow"}}})
        self.configure()

    def files(self, *paths):
        self.pr.update({"changedFiles": len(paths), "files": [{"path": p, "additions": 1, "deletions": 0} for p in paths]})

    def floor(self, *extra):
        code, out, err = self.run_as("coder", "impact", "floor", self.PR, *extra)
        self.assertEqual(code, 0, err)
        return out

    def test_s1_a_credential_module_outside_the_old_globs_reads_hold_and_names_the_path_and_its_class(self):
        self.files("shims/gh")
        out = self.floor()
        self.assertEqual(out.count("HOLD for the owner"), 1, out)
        self.assertIn("top tier path (credentials): shims/gh", out)
        self.assertIn("path floor (older advisory, not the owner's rule): NONE", out, "the old decision is still shown, labelled")

    def test_s2_an_agent_definition_prose_edit_says_not_held_and_gives_the_reason(self):
        self.files("agents/opencode/coder.md")
        with mock.patch.object(sb, "agent_block_states", return_value={"agents/opencode/coder.md": "unchanged"}):
            out = self.floor()
        self.assertEqual(out.count("not held for the owner"), 1, out)
        self.assertIn("because: definition change without a permission block change", out)
        self.assertNotIn("HOLD for the owner", out)
        self.files("docs/switchboard.md")
        out = self.floor()
        self.assertIn("not held", out)
        self.assertIn("because: no changed path is a top tier path", out)

    def test_s3_the_json_equals_what_the_daemon_decides_for_five_fixtures(self):
        fixtures = (["shims/gh"], [".github/workflows/ci.yml"], ["api/routes/users.py"], ["agents/opencode/coder.md"], ["docs/switchboard.md"])
        for paths in fixtures:
            self.files(*paths)
            with mock.patch.object(sb, "agent_block_states", return_value={p: "unchanged" for p in paths}):
                shown = json.loads(self.floor("--json"))
                engine = self.world.new_engine("daemon")
                engine.gh_runner = self.route
                engine.config, engine.state_dir = sb.load_config(), self.world.state
                report = sb.pr_floor_report(engine, "acme/app", 9)
                what, _ = sb.impact_plan(engine, report, [], sb.read_impact_state(self.world.state)[0], {}, None)
            self.assertEqual((shown["owner_decision"], shown["owner_reasons"]), (report["owner_decision"], report["owner_reasons"]), paths)
            self.assertEqual(what in ("add", "held", "cleared"), shown["owner_decision"] == "hold", "the daemon's plan %s agrees with the command's %s for %s" % (what, shown["owner_decision"], paths))
            self.assertEqual(shown["owner_decision"], {"shims/gh": "hold", ".github/workflows/ci.yml": "hold", "api/routes/users.py": "second-review", "agents/opencode/coder.md": "second-review"}.get(paths[0], "none"), paths)

    def cut(self, *paths, total=3000):
        self.pr.update({"changedFiles": total, "files": [{"path": p, "additions": 1, "deletions": 0} for p in paths]})

    def test_a_complete_list_says_how_many_files_were_read_in_the_headline(self):
        self.files("docs/switchboard.md", "docs/plan-template.md")
        out = self.floor()
        self.assertIn("not held, 2 files read (advisory: nothing is written)", out)
        self.assertNotIn("CANNOT TELL", out)

    def test_a_cut_list_in_a_repo_with_no_floor_globs_never_reads_as_not_held(self):
        self.extra_config = {"plan_gates": {"repos": {"acme/app": {"mode": "shadow"}}}}   # no impact_floor globs for the repo
        self.configure()
        self.cut(*["docs/f%d.md" % n for n in range(100)])
        out = self.floor()
        self.assertIn("CANNOT TELL: only 100 of 3000 files were read", out)
        self.assertIn("(the daemon's decision for the files it read: not held)", out, "the daemon's own answer, printed as it is")
        self.assertIn("this is not a verdict of \"not held\"", out)
        self.assertNotIn("not held, ", out.split("\n")[0])
        shown = json.loads(self.floor("--json"))
        self.assertEqual((shown["owner_decision"], shown["complete"], shown["files_read"], shown["files_total"]), ("none", False, 100, 3000))

    def test_a_cut_list_with_a_top_tier_path_among_the_files_read_is_a_hold(self):
        self.cut("shims/gh", *["docs/f%d.md" % n for n in range(99)])
        out = self.floor()
        self.assertIn("HOLD for the owner, 100 files read", out.split("\n")[0])
        self.assertNotIn("CANNOT TELL", out)

    def test_a_cut_list_in_a_repo_with_floor_globs_is_held_on_purpose_as_the_daemon_holds_it(self):
        self.cut(*["docs/f%d.md" % n for n in range(100)])   # the repo of this class has floor globs
        out = self.floor()
        self.assertIn("HOLD for the owner, 100 files read", out.split("\n")[0])
        self.assertIn("floor unknown: GitHub listed 100 of 3000", out)

    def test_the_cut_list_fixtures_equal_what_the_daemon_decides_too(self):
        for globs in (True, False):
            self.extra_config = dict(FLOOR_CONFIG, plan_gates={"repos": {"acme/app": {"mode": "shadow"}}}) if globs else {"plan_gates": {"repos": {"acme/app": {"mode": "shadow"}}}}
            self.configure()
            self.cut("docs/a.md", *["docs/f%d.md" % n for n in range(99)])
            shown = json.loads(self.floor("--json"))
            engine = self.world.new_engine("daemon")
            engine.gh_runner = self.route
            engine.config, engine.state_dir = sb.load_config(), self.world.state
            report = sb.pr_floor_report(engine, "acme/app", 9)
            what, _ = sb.impact_plan(engine, report, [], sb.read_impact_state(self.world.state)[0], {}, None)
            self.assertEqual((shown["owner_decision"], shown["owner_reasons"]), (report["owner_decision"], report["owner_reasons"]), globs)
            self.assertEqual(what in ("add", "held", "cleared"), shown["owner_decision"] == "hold", (globs, what))

    def renamed(self, source=None):
        item = {"path": "docs/neutral.md", "additions": 0, "deletions": 0, "changeType": "RENAMED"}
        if source:
            item["previous_filename"] = source
        self.pr.update({"changedFiles": 1, "files": [item]})

    def daemon_agrees(self, shown):
        engine = self.world.new_engine("daemon")
        engine.gh_runner = self.route
        engine.config, engine.state_dir = sb.load_config(), self.world.state
        report = sb.pr_floor_report(engine, "acme/app", 9)
        what, _ = sb.impact_plan(engine, report, [], sb.read_impact_state(self.world.state)[0], {}, None)
        self.assertEqual((shown["owner_decision"], shown["owner_reasons"]), (report["owner_decision"], report["owner_reasons"]))
        self.assertEqual(what in ("add", "held", "cleared"), shown["owner_decision"] == "hold")

    def test_a_rename_out_of_a_top_tier_path_with_its_source_known_is_a_hold_naming_the_source_and_its_class(self):
        for globs in (True, False):
            self.extra_config = dict(FLOOR_CONFIG, plan_gates={"repos": {"acme/app": {"mode": "shadow"}}}) if globs else {"plan_gates": {"repos": {"acme/app": {"mode": "shadow"}}}}
            self.configure()
            self.renamed(source="shims/gh")
            out = self.floor()
            self.assertIn("HOLD for the owner, 1 file read", out.split("\n")[0], globs)
            self.assertIn("top tier path (credentials): shims/gh", out)
            self.daemon_agrees(json.loads(self.floor("--json")))

    def test_a_rename_whose_source_path_is_not_listed_never_reads_as_not_held_in_a_repo_with_no_floor_globs(self):
        self.extra_config = {"plan_gates": {"repos": {"acme/app": {"mode": "shadow"}}}}
        self.configure()
        self.renamed()
        out = self.floor()
        self.assertIn("CANNOT TELL: 1 renamed or copied file(s) with no source path (the daemon's decision for the paths it saw: not held)", out)
        self.assertIn("this is not a verdict of \"not held\"", out)
        self.assertNotIn("not held, ", out.split("\n")[0])
        shown = json.loads(self.floor("--json"))
        self.assertEqual((shown["owner_decision"], shown["renamed_no_source"]), ("none", ["docs/neutral.md"]), "the daemon reads it as none: said, not changed here")
        self.daemon_agrees(shown)

    def test_a_rename_whose_source_path_is_not_listed_is_held_in_a_repo_with_floor_globs_as_the_daemon_holds_it(self):
        self.renamed()   # the repo of this class has floor globs
        out = self.floor()
        self.assertIn("HOLD for the owner, 1 file read", out.split("\n")[0])
        self.assertIn("renamed or copied file(s) with no known source path", out)
        self.daemon_agrees(json.loads(self.floor("--json")))

    def test_s4_a_rule_file_that_cannot_be_read_is_held_on_purpose_with_the_reason_and_nothing_is_written(self):
        self.files("docs/switchboard.md")

        def broken(path=None):
            raise sb.impact_floor.MatrixError("the matrix file is not valid JSON")
        with mock.patch.object(sb.impact_floor, "load_matrix", broken):
            out = self.floor()
            shown = json.loads(self.floor("--json"))
        self.assertEqual(out.count("held on purpose"), 1, out)
        self.assertIn("not valid JSON", out)
        self.assertEqual((shown["owner_decision"], shown["decision"]), ("hold", "hold"))
        self.assertIn("held on purpose", shown["owner_reasons"][0])
        self.assertEqual(self.ledger(), [])
        self.assertEqual([e for e in self.world.audit() if e["event"].startswith(("gate.", "plan.", "impact."))], [])

    def test_s5_the_old_json_fields_are_still_there_next_to_the_owner_decision(self):
        self.files("shims/gh")
        shown = json.loads(self.floor("--json"))
        for field in ("decision", "reasons", "floor_paths", "globs"):
            self.assertIn(field, shown)
        for field in ("owner_decision", "owner_reasons"):
            self.assertIn(field, shown)

    def test_s6_the_command_reads_the_reports_owner_decision_and_holds_no_path_or_class_of_the_rule(self):
        import inspect
        source = inspect.getsource(sb.cmd_impact_floor)
        block = sb.impact_floor.load_matrix()["owner_hold"]
        literals = list(block["top_tier_classes"]) + [g for globs in block["top_tier_paths"].values() for g in globs]
        self.assertEqual([x for x in literals if '"%s"' % x in source or "'%s'" % x in source], [], "a path or class of the rule is written in the command")
        self.assertIn('report.get("owner_decision")', source)
        self.assertNotIn("owner_decide(", source, "no second copy of the rule")


class TestImpactFloorCommandAndPass(LedgerBase):
    """`impact floor <pr>` and the daemon's advisory `gate.would_hold`: both read, neither writes a label, comment or ledger entry."""

    def setUp(self):
        super().setUp()
        top_tier_migrations(self)
        self.extra_config = dict(FLOOR_CONFIG, plan_gates={"repos": {"acme/app": {"mode": "shadow"}}})
        self.configure()
        self.pr.update({"changedFiles": 2, "files": [{"path": "migrations/0002.sql", "additions": 1, "deletions": 0},
                                                       {"path": "tests/test_a.py", "additions": 50000, "deletions": 90000}]})

    def test_a_pr_that_touches_a_floor_path_would_hold_and_the_command_writes_nothing(self):
        code, out, err = self.run_as("coder", "impact", "floor", self.PR, "--json")
        self.assertEqual(code, 0, err)
        report = json.loads(out)
        self.assertEqual((report["decision"], report["floor_paths"], report["complete"]), ("hold", ["migrations/0002.sql"], True))
        self.assertEqual(self.ledger(), [])
        self.assertEqual([e for e in self.world.audit() if e["event"].startswith(("gate.", "plan."))], [])
        code, out, err = self.run_as("coder", "impact", "floor", self.PR)
        self.assertIn("HOLD for the owner, 2 files read (advisory: nothing is written)", out)   # #553: the headline is the owner decision and the files read (was "HOLD (advisory...")

    def test_a_huge_change_outside_the_floor_does_not_hold_and_a_rating_can_add_one(self):
        self.pr.update({"changedFiles": 1, "files": [{"path": "src/app.py", "additions": 100000, "deletions": 100000}]})
        self.assertEqual(json.loads(self.run_as("coder", "impact", "floor", self.PR, "--json")[1])["decision"], "none")
        got = json.loads(self.run_as("coder", "impact", "floor", self.PR, "--rating", "critical/remote", "--rating", "negligible/eliminated", "--json")[1])
        self.assertEqual((got["decision"], len(got["rated"])), ("hold", 1))

    def test_a_huge_diff_with_a_truncated_file_list_holds_as_unknown_and_the_daemon_records_it(self):
        self.pr.update({"changedFiles": 3000, "files": [{"path": "src/f%d.py" % n} for n in range(100)]})
        report = json.loads(self.run_as("coder", "impact", "floor", self.PR, "--json")[1])
        self.assertEqual((report["decision"], report["complete"], report["floor_paths"]), ("hold", False, []))
        self.assertIn("GitHub listed 100 of 3000", report["unknown"])
        self.assertIn("unknown floor, held on purpose", self.run_as("coder", "impact", "floor", self.PR)[1])
        hub = FakeHub({"acme/app": [{"number": 9, "head": {"sha": LEDGER_HEAD}, "body": "PLAN: acme/app#7", "draft": False}]})
        engine = self.world.new_engine("daemon")
        engine.hub, engine.gh_runner = hub, self.route
        engine.config, engine.state_dir = sb.load_config(), self.world.state
        sb.ci_record_pass(engine, 100000.0)
        sb.impact_would_hold_pass(engine, 100000.0)
        (event,) = [e for e in self.world.audit() if e["event"] == "gate.would_hold"]
        self.assertIn("GitHub listed 100 of 3000", event["detail"]["unknown"])

    def test_a_rename_out_of_a_floor_path_still_holds_with_or_without_the_old_path(self):
        self.pr.update({"changedFiles": 1, "files": [{"path": "elsewhere/0002.sql", "previous_filename": "migrations/0002.sql", "changeType": "RENAMED"}]})
        report = json.loads(self.run_as("coder", "impact", "floor", self.PR, "--json")[1])
        self.assertEqual((report["decision"], report["floor_paths"]), ("hold", ["migrations/0002.sql"]))
        self.pr["files"] = [{"path": "elsewhere/0002.sql", "changeType": "RENAMED"}]          # gh gave no source path
        report = json.loads(self.run_as("coder", "impact", "floor", self.PR, "--json")[1])
        self.assertEqual(report["decision"], "hold")
        self.assertIn("renamed or copied", report["unknown"])
        self.pr["files"] = [{"path": "elsewhere/a.py", "changeType": "MODIFIED"}]             # an ordinary change outside: still no hold
        self.assertEqual(json.loads(self.run_as("coder", "impact", "floor", self.PR, "--json")[1])["decision"], "none")

    def test_a_malformed_rating_names_the_valid_cells(self):
        code, out, err = self.run_as("coder", "impact", "floor", self.PR, "--rating", "huge/often")
        self.assertEqual(code, 2)
        self.assertIn("Catastrophic", err)
        self.assertIn("Improbable", err)

    def test_the_daemon_pass_audits_would_hold_once_per_head_and_writes_no_label(self):
        hub = FakeHub({"acme/app": [{"number": 9, "head": {"sha": LEDGER_HEAD}, "body": "PLAN: acme/app#7", "draft": False}]})
        engine = self.world.new_engine("daemon")
        engine.hub, engine.gh_runner = hub, self.route          # route raises on any write
        engine.config, engine.state_dir = sb.load_config(), self.world.state
        t = 100000.0
        sb.ci_record_pass(engine, t)
        sb.impact_would_hold_pass(engine, t)
        sb.impact_would_hold_pass(engine, t + 10)
        events = [e for e in self.world.audit() if e["event"] == "gate.would_hold"]
        self.assertEqual(len(events), 1)
        self.assertEqual((events[0]["subject"], events[0]["detail"]["floor_paths"], events[0]["detail"]["advisory"]),
                         ("acme/app#9", ["migrations/0002.sql"], True))
        self.pr["headRefOid"] = LEDGER_NEW_HEAD
        hub.prs["acme/app"] = [{"number": 9, "head": {"sha": LEDGER_NEW_HEAD}, "body": "PLAN: acme/app#7", "draft": False}]
        sb.ci_record_pass(engine, t + 400)
        sb.impact_would_hold_pass(engine, t + 400)
        self.assertEqual(len([e for e in self.world.audit() if e["event"] == "gate.would_hold"]), 2, "a new head is judged again")

    def test_an_unreadable_matrix_file_is_said_loudly_by_the_pass_and_the_command_never_read_as_no_floor(self):
        mod = sb.load_module("impact_floor")
        broken = mock.patch.object(mod, "floor_for", side_effect=mod.MatrixError("the impact matrix file cannot be read (OSError: gone)"))
        hub = FakeHub({"acme/app": [{"number": 9, "head": {"sha": LEDGER_HEAD}, "body": "PLAN: acme/app#7", "draft": False}]})
        engine = self.world.new_engine("daemon")
        engine.hub, engine.gh_runner = hub, self.route
        engine.config, engine.state_dir = sb.load_config(), self.world.state
        sb.ci_record_pass(engine, 100000.0)
        with broken:
            sb.impact_would_hold_pass(engine, 100000.0)
            code, out, err = self.run_as("coder", "impact", "hold", "--dry-run")
        self.assertEqual([e for e in self.world.audit() if e["event"] == "gate.would_hold"], [], "no judgement is made")
        errors = [e for e in self.world.audit() if e["event"] == "impact.error"]
        self.assertEqual([e["detail"].get("floor") for e in errors], ["unreadable"], "the pass says so, loudly")
        self.assertEqual(code, sb.EXIT_ERROR)
        self.assertEqual(len([line for line in err.splitlines() if line.strip()]), 1, err)
        self.assertIn("cannot be read", err)

    def test_the_floor_report_carries_the_owner_hold_tier_as_advisory_information(self):
        self.top_tier_patcher.stop()   # this test is about the REAL matrix: a floor path that is not a top tier path asks for a second review
        report = json.loads(self.run_as("coder", "impact", "floor", self.PR, "--json")[1])
        self.assertEqual(report["decision"], "hold", "the labels still follow the old decision")
        self.assertEqual(report["owner_decision"], "second-review", "a floor path outside the top tier: no owner clear")
        self.pr.update({"changedFiles": 1, "files": [{"path": "shims/gh", "additions": 1, "deletions": 0}]})
        report = json.loads(self.run_as("coder", "impact", "floor", self.PR, "--json")[1])
        self.assertEqual(report["owner_decision"], "hold")
        self.assertTrue(any("shims/gh" in reason for reason in report["owner_reasons"]), report["owner_reasons"])

    def test_the_pass_is_off_when_disabled_or_killed_and_unlisted_repos_are_not_read(self):
        for edit in ("disabled", "killed"):
            with self.subTest(edit=edit):
                hub = FakeHub({"acme/app": [{"number": 9, "head": {"sha": LEDGER_HEAD}, "body": "PLAN: acme/app#7", "draft": False}]})
                engine = self.world.new_engine("daemon")
                engine.hub, engine.gh_runner = hub, self.route
                engine.config, engine.state_dir = sb.load_config(), self.world.state
                if edit == "disabled":
                    engine.config = dict(engine.config, impact_floor=dict(engine.config["impact_floor"], enabled=False))
                else:
                    (self.world.state / "plan-gates.off").write_text("")
                sb.ci_record_pass(engine, 100000.0)
                sb.impact_would_hold_pass(engine, 100000.0)
                self.assertEqual([e for e in self.world.audit() if e["event"] == "gate.would_hold"], [])
        (self.world.state / "plan-gates.off").unlink(missing_ok=True)


class TestGateFloorFresh(LedgerBase):
    """#488: gate G6 reads the impact floor itself at the exact head, so a PR that touches a floor path is held from the moment it is
    ready, before the daemon has labelled it. Synthetic names; the route counts every `pr view`."""

    def setUp(self):
        super().setUp()
        self.extra_config = dict(FLOOR_CONFIG, plan_gates={"repos": {"acme/app": {"mode": "shadow"}}})
        self.configure()
        self.reads = 0
        self.pr.update({"changedFiles": 1, "files": [{"path": "shims/gh"}]})   # a top tier path of the matrix file: the owner-hold rule holds it

    def route(self, argv, **kwargs):
        if argv[0] == FAKE_GH and argv[1:3] == ["pr", "view"]:
            self.reads += 1
        return super().route(argv, **kwargs)

    def g6(self):
        code, report, err = self.gates()
        self.assertIsNotNone(report, err)
        return self.row(report, "G6")

    def clear(self, head):
        sb.write_impact_state(self.world.state, {"clears": {self.PR: {"head": head, "reason": "a false hold", "by": "own", "at": 1}}, "applied": {}})

    def test_a_floor_path_waits_with_no_label_and_names_the_path(self):                                      # S1
        self.assertEqual(self.pr["labels"], [])
        row = self.g6()
        self.assertEqual(row["status"], "waiting")
        self.assertIn("shims/gh", " ".join(row["missing"]))

    def test_the_owners_clear_passes_for_that_head_only(self):                                              # S2
        self.clear(LEDGER_HEAD)
        self.assertEqual(self.g6()["status"], "ok")
        self.pr["headRefOid"] = LEDGER_NEW_HEAD
        self.assertEqual(self.g6()["status"], "waiting")

    def test_an_unreadable_floor_does_not_pass(self):                                                      # S3
        self.pr["files"] = "not a list"
        self.pr["changedFiles"] = "many"
        with mock.patch.object(sb, "pr_floor_report", side_effect=sb.NoticeError("gh: network unreachable")):
            row = self.g6()
        self.assertEqual(row["status"], "waiting")
        self.assertEqual(" ".join(row["missing"]).count("could not be read"), 1)

    def test_a_matrix_error_does_not_pass(self):                                                           # S3b
        with mock.patch.object(sb.impact_floor, "load_matrix", side_effect=ValueError("matrix is broken")):
            row = self.g6()
        self.assertEqual(row["status"], "waiting")
        self.assertIn("could not be read", " ".join(row["missing"]))

    def test_a_corrupt_impact_state_does_not_pass(self):
        (self.world.state / "impact-hold.json").write_text("{not json")
        self.assertEqual(self.g6()["status"], "waiting")

    def test_a_head_that_moved_during_the_read_does_not_pass(self):
        real = sb.pr_floor_report
        with mock.patch.object(sb, "pr_floor_report", lambda *a, **k: dict(real(*a, **k), head=LEDGER_NEW_HEAD)):
            self.assertIn("could not be read", " ".join(self.g6()["missing"]))

    def test_the_gate_and_the_daemon_decide_alike_for_six_fixtures(self):                                  # S4
        fixtures = [["shims/gh"], ["docs/a.md"], ["src/a.py"], ["bin/plan_ledger.py", "docs/b.md"], ["plugins/fleet-hooks/a.js"], ["docs/c.md", "src/d.py"]]
        for paths in fixtures:
            with self.subTest(paths=paths):
                self.pr.update({"changedFiles": len(paths), "files": [{"path": p} for p in paths]})
                engine = self.world.new_engine("cli")
                engine.config, engine.state_dir, engine.gh_runner = sb.load_config(), self.world.state, self.route
                daemon = sb.pr_floor_report(engine, "acme/app", 9)["owner_decision"]   # the decision the daemon's labels follow
                fact = sb.gate_floor_fact(engine, self.world.state, "acme/app", 9, LEDGER_HEAD)
                self.assertEqual(fact["decision"], daemon)
                self.assertEqual(self.g6()["status"], "waiting" if daemon == "hold" else "ok")
        import re as _re
        code = (Path(__file__).resolve().parent / "plan_ledger.py").read_text()
        self.assertGreater(len(code), 1000)
        self.assertEqual(len(_re.findall(r"migrations|api/routes|shims/", code)), 0)

    def test_a_hold_label_still_waits_when_the_floor_would_not_hold(self):                                 # S5
        self.pr.update({"changedFiles": 1, "files": [{"path": "src/a.py"}], "labels": [{"name": "tester:merge-captain"}]})
        self.assertEqual(self.g6()["status"], "waiting")

    def test_a_docs_only_pr_passes_with_one_read_for_the_floor(self):                                      # S6
        self.pr.update({"changedFiles": 1, "files": [{"path": "docs/a.md"}]})
        code, report, err = self.gates()
        self.assertEqual(self.row(report, "G6")["status"], "ok")
        floor_reads = self.reads
        self.reads = 0
        self.gates()
        self.assertEqual(self.reads, floor_reads)
        self.assertEqual(self.reads - 1, 1, "one read for the picture, one for the floor")

    def test_a_waiver_cannot_lift_it(self):
        self.assertIn("G6", sb.plan_ledger.NEVER_WAIVABLE)


class TestImpactClassAndNarrowForm(LedgerBase):
    """#451 slice 2: the class in the impact reviewer's record, and an agent definition that holds only when its permission block changes. Synthetic
    names; the route answers the contents reads and counts them."""

    BASE = "c" * 40
    DEF = '---\ndescription: a helper\nmode: subagent\npermissions:\n  - {action: read, resource: "*", effect: allow}\n---\nProse about the job.\n'

    def setUp(self):
        super().setUp()
        self.extra_config = dict(FLOOR_CONFIG, plan_gates={"repos": {"acme/app": {"mode": "shadow"}}})
        self.configure()
        self.pr = dict(self.pr, baseRefOid=self.BASE)
        self.reads, self.contents = [], {}
        self.files(["docs/a.md"])

    def route(self, argv, **kwargs):
        if argv[0] == FAKE_GH and argv[1] == "api" and "/contents/" in argv[2]:
            self.reads.append(argv[2])
            match = re.search(r"/contents/([^?]+)\?ref=([0-9a-f]+)", argv[2])
            text = self.contents.get((match.group(1), match.group(2)))
            if text == "BROKEN":
                return subprocess.CompletedProcess(argv, 1, "", "gh: HTTP 502")
            if text is None:
                return subprocess.CompletedProcess(argv, 1, "", "gh: Not Found (HTTP 404)")
            return subprocess.CompletedProcess(argv, 0, json.dumps({"content": base64.b64encode(text.encode()).decode(), "encoding": "base64"}), "")
        return super().route(argv, **kwargs)

    def files(self, paths):
        self.pr.update({"changedFiles": len(paths), "files": [{"path": p, "additions": 1, "deletions": 0} for p in paths]})

    def definition(self, path, before, after):
        self.contents[(path, self.BASE)], self.contents[(path, LEDGER_HEAD)] = before, after

    def decide(self):
        code, out, err = self.run_as("coder", "impact", "floor", self.PR, "--json")
        self.assertEqual(code, 0, err)
        report = json.loads(out)
        return report["owner_decision"], report["owner_reasons"]

    def record_impact(self, action, *more):
        code, out, err = self.run_as("coder", "review", "record", self.PR, "--reviewer", "impact", "--verdict", "approve", "--impact-action", action, *more)
        return code, out, err

    def test_815_confirms_carry_is_stored_with_an_approve_and_refused_otherwise(self):
        code, out, err = self.run_as("coder", "review", "record", self.PR, "--reviewer", "code", "--verdict", "approve", "--confirms-carry")
        self.assertEqual(code, 0, err)
        self.assertEqual([e.get("carry_confirmed") for e in self.ledger() if e["kind"] == "review_record"], [True])
        for verdict, extra in (("request-changes", ("--blocks", "1")), ("comment", ()), ("incomplete", ())):
            code, out, err = self.run_as("coder", "review", "record", self.PR, "--reviewer", "code", "--verdict", verdict, "--confirms-carry", *extra)
            self.assertEqual(code, 2, verdict)
            self.assertIn("belongs to an approve", err)
        code, out, err = self.run_as("coder", "review", "record", self.PR, "--reviewer", "code", "--verdict", "approve")
        self.assertEqual(code, 0, err)
        self.assertEqual([e.get("carry_confirmed") for e in self.ledger() if e["kind"] == "review_record"], [True, None], "no flag: nothing stored, as before")

    # -- S1: the record

    def test_s1_the_record_keeps_its_class_refuses_a_bad_one_and_may_have_none(self):
        self.assertEqual(self.record_impact("hold", "--impact-class", "credentials")[0], 0)
        code, out, err = self.record_impact("hold", "--impact-class", "two words")
        self.assertEqual(code, 2)
        self.assertEqual(err.count("impact-class"), 1)
        self.assertEqual(self.record_impact("second-review")[0], 0)
        code, out, err = self.run_as("coder", "review", "record", self.PR, "--reviewer", "code", "--verdict", "approve", "--impact-class", "data")
        self.assertEqual(code, 2)
        self.assertIn("belongs to the impact reviewer", err)
        stored = [e.get("impact_class") for e in self.ledger() if e["kind"] == "review_record"]
        self.assertEqual(stored, ["credentials", None])
        self.assertEqual(self.run_as("coder", "review", "record", self.PR, "--reviewer", "impact", "--verdict", "approve", "--impact-action", "hold",
                                     "--block", "/nonexistent")[0], 2)

    def test_a_hold_with_no_class_is_refused_and_nothing_is_recorded(self):
        for more in ((), ("--impact-class", "")):
            code, out, err = self.record_impact("hold", *more)
            self.assertEqual(code, 2)
            self.assertIn("run the review again", err)
        self.assertEqual([e for e in self.ledger() if e["kind"] == "review_record"], [])
        self.assertEqual(self.record_impact("none")[0], 0)
        self.assertEqual(self.record_impact("hold", "--impact-class", "data")[0], 0)
        self.assertEqual(len([e for e in self.ledger() if e["kind"] == "review_record"]), 2)

    # -- #692: a hold names a class of the matrix file

    def hold_records(self):
        return [e for e in self.ledger() if e["kind"] == "review_record" and e.get("impact_action") == "hold"]

    def matrix_copy(self, edit):
        impact_floor = sb.load_impact_floor()
        matrix = json.loads(impact_floor.MATRIX_PATH.read_text())
        edit(matrix["owner_hold"])
        path = self.world.state / "matrix-copy.json"
        path.write_text(json.dumps(matrix))
        return impact_floor, path

    def test_692_s1_s7_an_unknown_class_is_refused_lists_the_classes_and_records_nothing(self):
        code, out, err = self.record_impact("hold", "--impact-class", "x")
        self.assertEqual(code, 2)
        rule = sb.load_impact_floor().owner_hold_rule(sb.load_impact_floor().load_matrix())
        self.assertEqual(len(rule[0] + rule[1]), 10)
        self.assertEqual([c for c in rule[0] + rule[1] if c not in err], [])
        self.assertIn("run the review again", err)
        self.assertEqual(self.hold_records(), [])
        self.assertEqual([e for e in self.ledger() if e["kind"] == "review_record"], [])
        block = "verdict: approve\nhead: %s\nimpact-action: hold\nimpact-class: x\nfindings:\n" % LEDGER_HEAD
        path = self.world.state / "block.txt"
        path.write_text(block)
        code, out, err = self.run_as("coder", "review", "record", self.PR, "--reviewer", "impact", "--block", str(path))
        self.assertEqual(code, 2)
        self.assertEqual([e for e in self.ledger() if e["kind"] == "review_record"], [])
        self.assertEqual(self.decide()[0], "none")

    def test_692_s2_none_is_refused_and_a_valid_class_in_another_case_is_recorded_lower_case(self):
        self.assertEqual(self.record_impact("hold", "--impact-class", "none")[0], 2)
        self.assertEqual(self.hold_records(), [])
        self.assertEqual(self.record_impact("hold", "--impact-class", " Credentials ")[0], 0)
        self.assertEqual([e["impact_class"] for e in self.hold_records()], ["credentials"])

    def test_692_s3_every_matrix_class_holds_and_other_actions_need_no_class(self):
        impact_floor = sb.load_impact_floor()
        rule = impact_floor.owner_hold_rule(impact_floor.load_matrix())
        for cls in rule[0] + rule[1]:
            self.assertEqual(self.record_impact("hold", "--impact-class", cls)[0], 0, cls)
        self.assertEqual(self.record_impact("second-review")[0], 0)
        self.assertEqual(self.record_impact("none")[0], 0)
        self.assertEqual(len([e for e in self.ledger() if e["kind"] == "review_record"]), 12)

    def test_692_s4_the_classes_come_from_the_matrix_file_not_the_code(self):
        impact_floor, path = self.matrix_copy(lambda b: (b["other_classes"].remove("cost"), b["other_classes"].append("novelty")))
        with mock.patch.object(impact_floor, "MATRIX_PATH", path):
            self.assertEqual(self.record_impact("hold", "--impact-class", "novelty")[0], 0)
            code, out, err = self.record_impact("hold", "--impact-class", "cost")
            self.assertEqual(code, 2)
            self.assertIn("run the review again", err)
        self.assertEqual([e["impact_class"] for e in self.hold_records()], ["novelty"])
        source = (REPO / "bin" / "fleet-switchboard").read_text()
        rule = impact_floor.owner_hold_rule(impact_floor.load_matrix())
        names = rule[0] + rule[1]   # no line of the code lists several of the classes (single words like "data" occur elsewhere)
        self.assertEqual([l for l in source.splitlines() if sum(1 for c in names if re.search(r"[\"']%s[\"']" % c, l)) >= 3], [])

    def test_692_s5_an_unreadable_matrix_refuses_the_hold_loudly(self):
        impact_floor = sb.load_impact_floor()
        for text in (None, "{not json"):
            path = self.world.state / "gone.json"
            if text is None:
                path.unlink(missing_ok=True)
            else:
                path.write_text(text)
            impact_floor._MATRIX_CACHE.clear()
            with mock.patch.object(impact_floor, "MATRIX_PATH", path):
                code, out, err = self.record_impact("hold", "--impact-class", "credentials")
            self.assertEqual(code, 2)
            self.assertIn("matrix file cannot be read", err)
            self.assertEqual(self.hold_records(), [])
        impact_floor._MATRIX_CACHE.clear()

    def test_the_block_form_carries_the_class_line(self):
        block = "verdict: approve\nhead: %s\nimpact-action: hold\nimpact-class: Data\nfindings:\n" % LEDGER_HEAD
        fields, problem = sb.parse_review_block(block)
        self.assertEqual((problem, fields["impact_class"]), (None, "data"))
        fields, problem = sb.parse_review_block(block.replace("Data", "two words"))
        self.assertIn("impact-class", problem)

    # -- S2: the decision by class

    def test_s2_a_hold_record_holds_for_the_owner_unless_its_class_is_not_top_tier(self):
        outcome = {}
        for label, more in (("credentials", ("--impact-class", "credentials")), ("performance", ("--impact-class", "performance")),
                            ("unknown", ("--impact-class", "gizmo")), ("missing", None)):
            if more is None or label == "unknown":   # a record already in the ledger without a class or with an unknown one (new recordings are refused): it keeps its top-tier reading
                entry = {"kind": "review_record", "pr": self.PR, "head": LEDGER_HEAD, "reviewer": "impact", "verdict": "approve",
                         "blocks": 0, "notes": 0, "by": "rev", "impact_action": "hold", "summary": "x"}
                if label == "unknown":
                    entry["impact_class"] = "gizmo"
                sb.plan_ledger.append_entry(self.world.state, entry, 1)
            else:
                self.assertEqual(self.record_impact("hold", *more)[0], 0)
            outcome[label] = self.decide()
        self.assertEqual({k: v[0] for k, v in outcome.items()},
                         {"credentials": "hold", "performance": "second-review", "unknown": "hold", "missing": "hold"})
        self.assertEqual(outcome["performance"][1][0].count("class performance"), 1)
        self.assertFalse([r for r in outcome["performance"][1] if "top tier" in r and "hold" in r.split(":")[0]])

    def test_a_non_hold_record_and_an_unreadable_ledger(self):
        self.assertEqual(self.record_impact("second-review")[0], 0)
        self.assertEqual(self.decide()[0], "none")
        (self.world.state / "plan-ledger.jsonl").write_text("{not json\n")
        self.assertEqual(self.decide()[0], "hold", "an unreadable ledger is an unknown rating: it holds")

    # -- S3: the prompt

    def test_s3_the_prompt_asks_for_the_class_and_names_every_class_of_the_matrix_file(self):
        text = (REPO / "agents" / "reviewers" / "reviewer-impact.md").read_text()
        rule = sb.load_impact_floor().owner_hold_rule(sb.load_impact_floor().load_matrix())
        classes = rule[0] + rule[1]
        self.assertEqual(len(classes), 10)
        self.assertEqual(text.count("impact-class: <class of the hold"), 1)   # the block's class line is said once (the --block table names the flag too, #895)
        self.assertIn("always names its class", text)
        self.assertIn("A hold without a class is rejected", text)
        self.assertNotIn("Leave the class line out", text)
        self.assertEqual([c for c in classes if "`%s`" % c not in text], [])

    # -- S4 to S6: the agent definitions

    def test_s4_only_a_change_to_the_permission_block_holds(self):
        path = "agents/x.md"
        self.files([path])
        tail = self.DEF.split("---\n", 2)[2]
        cases = {
            "prose": (self.DEF.replace("Prose about the job.", "Other prose.").replace("a helper", "a better helper"), "second-review"),
            "allow rule": (self.DEF.replace("allow}\n", "allow}\n  - {action: shell, resource: \"ls *\", effect: allow}\n"), "hold"),
            "mode": (self.DEF.replace("subagent", "primary"), "hold"),
            "unreadable after": ("no front matter here\n" + tail, "hold"),
        }
        for label, (after, want) in cases.items():
            with self.subTest(label):
                self.definition(path, self.DEF, after)
                got = self.decide()
                self.assertEqual(got[0], want, got)
        self.assertEqual(self.decide_prose_reason(), 1)
        with self.subTest("unreadable before"):
            self.definition(path, "no front matter\n", self.DEF)
            self.assertEqual(self.decide()[0], "hold")

    def decide_prose_reason(self):
        self.definition("agents/x.md", self.DEF, self.DEF.replace("Prose about the job.", "Other."))
        decision, reasons = self.decide()
        return len([r for r in reasons if "without a permission block change" in r]) if decision == "second-review" else -1

    def test_s5_an_added_or_removed_definition_holds(self):
        self.files(["agents/new.md"])
        self.contents[("agents/new.md", LEDGER_HEAD)] = self.DEF
        self.assertEqual((self.decide()[0], self.decide()[1][0].count("added")), ("hold", 1))
        self.files(["agents/old.md"])
        self.contents[("agents/old.md", self.BASE)] = self.DEF
        self.assertEqual((self.decide()[0], self.decide()[1][0].count("removed")), ("hold", 1))

    def test_s6_a_content_read_that_fails_holds_and_says_it_could_not_be_read(self):
        self.files(["agents/x.md"])
        self.definition("agents/x.md", self.DEF, "BROKEN")
        decision, reasons = self.decide()
        self.assertEqual(decision, "hold")
        self.assertEqual(" ".join(reasons).count("could not be read"), 1)
        self.pr.pop("baseRefOid")
        self.assertEqual(self.decide()[0], "hold", "an unknown base holds")

    def test_a_definition_missing_at_both_versions_and_a_mixed_change_hold(self):
        self.files(["agents/ghost.md"])
        decision, reasons = self.decide()
        self.assertEqual((decision, " ".join(reasons).count("could not be read")), ("hold", 1))
        self.files(["agents/x.md", "shims/gh"])
        self.definition("agents/x.md", self.DEF, self.DEF.replace("Prose about the job.", "Other."))
        decision, reasons = self.decide()
        self.assertEqual(decision, "hold", "an unchanged permission block does not lift another top tier path")
        self.assertIn("shims/gh", " ".join(reasons))

    # -- S7: the bound

    def test_s7_the_reads_are_none_four_and_none_and_more_than_the_limit_holds(self):
        self.files(["docs/a.md"])
        self.decide()
        self.assertEqual(len(self.reads), 0)
        for name in ("agents/a.md", "agents/b.md"):
            self.definition(name, self.DEF, self.DEF)
        self.files(["agents/a.md", "agents/b.md"])
        self.reads.clear()
        self.assertEqual(self.decide()[0], "second-review")
        self.assertEqual(len(self.reads), 4)
        names = ["agents/f%d.md" % n for n in range(9)]
        self.files(names)
        self.reads.clear()
        decision, reasons = self.decide()
        self.assertEqual((decision, len(self.reads)), ("hold", 0))
        self.assertIn("more than 8", " ".join(reasons))

    # -- S8 and S9: the rule is data

    def matrix_with(self, **narrow):
        matrix = json.loads(json.dumps(sb.load_impact_floor().load_matrix()))
        matrix["owner_hold"]["narrow_by_diff"].update(narrow)
        return matrix

    def test_s8_the_narrow_paths_come_from_the_matrix_file(self):
        self.files(["agents/x.md"])
        self.definition("agents/x.md", self.DEF, self.DEF.replace("Prose about the job.", "Other."))
        self.assertEqual(self.decide()[0], "second-review")
        with mock.patch.object(sb.impact_floor, "load_matrix", lambda *a, **k: self.matrix_with(paths=["skills/**"])):
            self.assertEqual(self.decide()[0], "hold", "no longer a narrow path: the whole top tier path holds")

    def test_s9_the_front_matter_keys_come_from_the_matrix_file_and_the_code_has_none(self):
        self.files(["agents/x.md"])
        self.definition("agents/x.md", self.DEF, self.DEF.replace("a helper", "a better helper"))
        self.assertEqual(self.decide()[0], "second-review")
        with mock.patch.object(sb.impact_floor, "load_matrix", lambda *a, **k: self.matrix_with(keys=["description"])):
            self.assertEqual(self.decide()[0], "hold", "description is the block now")
        source = (REPO / "bin" / "impact_floor.py").read_text()
        self.assertEqual(re.findall(r"agents/|[\"'](?:permissions|permission|mode|tools)[\"']", source), [])

    def test_a_malformed_narrow_block_is_no_narrow_rule_and_the_whole_path_holds(self):
        self.files(["agents/x.md"])
        self.definition("agents/x.md", self.DEF, self.DEF.replace("Prose about the job.", "Other."))
        for bad in ({"max_files": 0}, {"keys": []}, {"paths": "agents/**"}):
            with self.subTest(bad), mock.patch.object(sb.impact_floor, "load_matrix", lambda *a, _b=bad, **k: self.matrix_with(**_b)):
                self.assertEqual(self.decide()[0], "hold")

    def test_every_agent_definition_of_this_repository_is_parsable(self):
        f = sb.load_impact_floor()
        keys = f.narrow_rule(f.load_matrix())[1]
        unparsable = [str(p.relative_to(REPO)) for p in sorted((REPO / "agents").rglob("*.md")) if f.permission_block(p.read_text(), keys) is None]
        self.assertEqual(unparsable, [], "a definition the reader cannot parse would always hold: the narrow form would help nobody")

    def test_the_pure_block_reader(self):
        f = sb.load_impact_floor()
        keys = ["permissions", "mode"]
        self.assertEqual(f.permission_block("---\nmode: x\n# c\npermissions:\n  - a\n\nother: 1\n---\n", keys), {"mode": ["mode: x"], "permissions": ["permissions:", "  - a"]})
        self.assertIsNone(f.permission_block("mode: x\n", keys))
        self.assertIsNone(f.permission_block("---\nmode: x\n", keys))
        self.assertIsNone(f.permission_block("---\n---\n" + "x" * 300000, keys))
        self.assertEqual(f.block_state("---\nmode: x\n---\n", "---\r\nmode: x  \r\n---\r\nprose", keys), "unchanged")
        self.assertIsNone(f.permission_block('---\n"mode": x\n---\n', keys), "a quoted key cannot be judged: it holds")
        self.assertEqual(f.permission_block("---\npermissions:\n- a\n- b\nother: 1\n---\n", keys), {"permissions": ["permissions:", "- a", "- b"]})
        for label, text in (("a block scalar under a tracked key", "---\npermissions: |\n  # keep\n  x\n---\n"),
                            ("an anchor", "---\nx: &m subagent\nmode: *m\n---\n"), ("a tag", "---\nmode: !!str x\n---\n"),
                            ("a merge key", "---\n<<: *base\nmode: x\n---\n"), ("a repeated tracked key", "---\nmode: a\nmode: b\n---\n"),
                            ("a closing line that is indented", "---\nmode: x\n  ---\nmode: y\n---\n"),
                            ("a quoted scalar left open across lines", "---\ndescription: 'x\nmode: subagent\nother: y'\n---\n"),
                            ("a flow collection left open", "---\npermissions: {a: 1,\nmode: x}\n---\n"),
                            ("a double quoted scalar left open", '---\ndescription: "x\nmode: y\n---\n'),
                            ("a folded block scalar", "---\npermissions: >\n  x\n---\n"),
                            ("a comment hiding a closer in a flow collection", "---\ndescription: [a # ]\npermissions: [b]\nmode: subagent\nz: q]\n---\n"),
                            ("a comment hiding a closer in a flow mapping", "---\ndescription: {a: 1 # }\nmode: x\nz: q}\n---\n"),
                            ("a complex key opening a quote", '---\ndescription:\n  ? "x\nmode: subagent\n  y"\n---\n'),
                            ("a directive", "---\n%YAML 1.2\nmode: x\n---\n"), ("a document end marker", "---\nmode: x\n...\n---\n"),
                            ("a surplus closer", "---\npermissions: {a: 1}}\n---\n"), ("junk after a quoted value", '---\nmode: "x" y\n---\n'),
                            ("a plain value with a colon and a space", "---\ndescription: a: b\n---\n"), ("a nested sequence on one line", "---\npermissions:\n  - - a\n---\n"),
                            ("a Unicode line break", "---\ndescription: x\u2028mode: y\n---\n")):
            self.assertIsNone(f.permission_block(text, keys), label)
        self.assertEqual(f.permission_block("---\ndescription: \"say *\"\nnote: a!b\npermissions:\n  - {action: shell, resource: \"gh * view *\", effect: allow}\n---\n", keys),
                         {"permissions": ["permissions:", '  - {action: shell, resource: "gh * view *", effect: allow}']}, "quoted globs are not indirection")
        self.assertEqual(f.permission_block("---\ndescription: the Chief of Staff's helper, it's fine\nmode: x # a comment with ' in it\n---\n", keys), {"mode": ["mode: x # a comment with ' in it"]},
                         "an apostrophe inside a plain scalar or a comment is not a quote")
        self.assertEqual(f.permission_block("---\npermissions:\n  - {action: read, resource: 'it''s', effect: allow}\n---\n", keys)["permissions"][1].count("it''s"), 1)
        self.assertEqual(f.permission_block('---\ndescription: "say \\"x\\" # not a comment"  # a comment\nmode: "x\\""\n---\n', keys), {"mode": ['mode: "x\\""']},
                         "an escaped quote and a # inside quotes are read as they are")
        self.assertEqual(f.permission_block("---\ndescription: [a, b] # closed, then a comment\nmode: x\n---\n", keys), {"mode": ["mode: x"]})
        self.assertNotEqual(f.permission_block("---\npermissions:\n  # keep\n  - x\n---\n", keys), f.permission_block("---\npermissions:\n  # kept\n  - x\n---\n", keys),
                            "a # line inside a tracked block is content")


class TestBlockTable(LedgerBase):
    """#895: `review record --block`: one table of what goes with it, said the same in the help, the refusal and the agent definition; a record with no score says so on stderr."""

    def setUp(self):
        super().setUp()
        self.extra_config = dict(FLOOR_CONFIG, plan_gates={"repos": {"acme/app": {"mode": "shadow"}}})
        self.configure()
        self.pr = dict(self.pr, baseRefOid="c" * 40, changedFiles=1, files=[{"path": "docs/a.md", "additions": 1, "deletions": 0}])

    def block(self, extra="", action="impact-action: none\n"):
        path = self.world.state / "block.txt"
        path.write_text("verdict: approve\nhead: %s\n%s%sfiles-read:\n- docs/a.md | 5 | 5\nfindings:\n" % (LEDGER_HEAD, action, extra))
        return str(path)

    def records(self):
        return [e for e in self.ledger() if e["kind"] == "review_record"]

    def record(self, *more, reviewer="impact", extra=""):
        return self.run_as("coder", "review", "record", self.PR, "--reviewer", reviewer, "--block", self.block(extra, "impact-action: none\n" if reviewer == "impact" else ""), *more)

    ROW_FLAGS = {"--verdict": ("approve",), "--head": (LEDGER_HEAD,), "--blocks": ("1",), "--notes": ("1",), "--impact-action": ("none",),
                 "--impact-class": ("data",), "--impact-severity": ("Marginal",), "--impact-probability": ("Remote",), "--impact-reason": ("a reason",), "--summary": ("one line",),
                 "--confirms-carry": ()}   # (#815) a flag with no value: stored as True

    def test_the_table_has_every_record_flag_once(self):
        parser = sb.build_parser()
        sub = next(a for a in parser._actions if isinstance(a, argparse._SubParsersAction)).choices["review"]
        record = next(a for a in sub._actions if isinstance(a, argparse._SubParsersAction)).choices["record"]
        flags = {o for a in record._actions for o in a.option_strings if o.startswith("--") and o not in ("--help", "--block", "--block-file")}
        listed = [flag for flag, _, _ in sb.BLOCK_FLAG_TABLE]
        self.assertEqual(sorted(listed), sorted(set(listed)))
        self.assertEqual(set(listed), flags)
        self.assertEqual({mode for _, _, mode in sb.BLOCK_FLAG_TABLE} - {"refused", "accepted", "wins"}, set())
        self.assertEqual(sorted(self.ROW_FLAGS), sorted(set(listed) - {"--reviewer"}))

    def test_each_row_does_what_the_table_says(self):
        for flag, dest, mode in sb.BLOCK_FLAG_TABLE:
            if flag == "--reviewer":
                continue
            with self.subTest(flag=flag):
                before = len(self.records())
                pair = ("--impact-probability", "Remote") if flag == "--impact-severity" else ("--impact-severity", "Marginal") if flag == "--impact-probability" else ()
                code, out, err = self.record(flag, *self.ROW_FLAGS[flag], *pair)
                if mode == "refused":
                    self.assertEqual(code, 2)
                    self.assertIn(sb.BLOCK_TABLE_TEXT, err)
                    self.assertEqual(len(self.records()), before)
                else:
                    self.assertEqual(code, 0, err)
                    self.assertEqual(len(self.records()), before + 1)
                    if flag != "--summary":
                        self.assertEqual(self.records()[-1].get("carry_confirmed" if dest == "confirms_carry" else dest), (self.ROW_FLAGS[flag] or (True,))[0])
        code, out, err = self.record("--blocks", "0", "--notes", "0")
        self.assertEqual(code, 0, err)   # 0 is the default: cannot be told from absent

    WINNERS = (("--impact-class", "impact_class", "authority", "data"), ("--impact-severity", "impact_severity", "Critical", "Marginal"),
               ("--impact-probability", "impact_probability", "Occasional", "Remote"), ("--impact-reason", "impact_reason", "the flag's reason", "the block's reason"))

    def test_a_flag_wins_over_the_blocks_line_for_each_of_the_four_winning_rows(self):
        self.assertEqual({dest for _, dest, mode in sb.BLOCK_FLAG_TABLE if mode == "wins"}, {dest for _, dest, _, _ in self.WINNERS})   # derived: a new winning row must be added here
        block_lines = "impact-class: data\nimpact-severity: Marginal\nimpact-probability: Remote\nimpact-reason: the block's reason\n"
        for flag, dest, flag_value, block_value in self.WINNERS:
            with self.subTest(flag=flag):
                action = "impact-action: hold\n"   # a hold needs a class; the block's own class line is "data"
                path = self.world.state / "block.txt"
                path.write_text("verdict: approve\nhead: %s\n%s%sfiles-read:\n- docs/a.md | 5 | 5\nfindings:\n" % (LEDGER_HEAD, action, block_lines))
                code, out, err = self.run_as("coder", "review", "record", self.PR, "--reviewer", "impact", "--block", str(path), flag, flag_value)
                self.assertEqual(code, 0, err)
                entry = self.records()[-1]
                self.assertEqual(entry[dest], flag_value)
                for _, d, _, bv in self.WINNERS:
                    if d != dest:
                        self.assertEqual(entry[d], bv, d)   # the other three keep the block's own lines

    def test_the_table_is_said_the_same_in_the_help_the_refusal_and_the_definition(self):
        text = sb.BLOCK_TABLE_TEXT
        self.assertEqual(text, sb.block_table_text())
        sub = next(a for a in sb.build_parser()._actions if isinstance(a, argparse._SubParsersAction)).choices["review"]
        record = next(a for a in sub._actions if isinstance(a, argparse._SubParsersAction)).choices["record"]
        self.assertIn(text, next(a for a in record._actions if "--block" in a.option_strings).help)
        definition = (REPO / "agents" / "reviewers" / "reviewer-impact.md").read_text()
        self.assertEqual(definition.split("<!-- block-table:begin -->\n", 1)[1].split("\n<!-- block-table:end -->", 1)[0], text)
        self.assertEqual(self.record("--head", LEDGER_HEAD)[2].count(text), 1)
        self.assertEqual((REPO / "bin" / "fleet-switchboard").read_text().count('("--verdict", "verdict", "refused")'), 1)

    def test_the_definitions_example_block_parses_to_a_record_with_a_score(self):
        definition = (REPO / "agents" / "reviewers" / "reviewer-impact.md").read_text()
        example = definition.split("A full block, as you return it", 1)[1].split("```\n", 2)[1]
        example = example.replace("0123456789abcdef0123456789abcdef01234567", LEDGER_HEAD).replace("src/example.py", "docs/a.md")
        path = self.world.state / "example.txt"
        path.write_text(example)
        code, out, err = self.run_as("coder", "review", "record", self.PR, "--reviewer", "impact", "--block", str(path))
        self.assertEqual((code, err), (0, ""), err)
        entry = self.records()[-1]
        self.assertEqual((entry["impact_severity"], entry["impact_probability"]), ("Marginal", "Occasional"))
        self.assertTrue(entry["impact_reason"])

    def test_the_refusal_names_the_block_lines_that_carry_the_score(self):
        err = self.record("--head", LEDGER_HEAD)[2]
        for word in ("impact-severity:", "impact-probability:", "impact-reason:", "WITHOUT a score"):
            self.assertIn(word, err)

    def test_the_warning_with_and_without_a_score(self):
        scored = "impact-severity: Marginal\nimpact-probability: Remote\n"
        cases = ((dict(), True), (dict(extra=scored), False), (dict(extra="impact-reason: why\n"), True))
        for kwargs, warns in cases:
            with self.subTest(**kwargs):
                before = len(self.records())
                code, out, err = self.record(**kwargs)
                self.assertEqual(code, 0)
                self.assertEqual(len(self.records()), before + 1)
                self.assertTrue(out.startswith("recorded impact review"))
                if warns:
                    self.assertEqual(len(err.strip().splitlines()), 1)
                    for word in ("WITHOUT a score", "clears nothing by score", "--impact-severity", "--impact-probability"):
                        self.assertIn(word, err)
                else:
                    self.assertEqual(err, "")
        code, out, err = self.record("--impact-severity", "Marginal", "--impact-probability", "Remote")
        self.assertEqual((code, err), (0, ""))
        code, out, err = self.run_as("coder", "review", "record", self.PR, "--reviewer", "impact", "--verdict", "approve")
        self.assertEqual(code, 0)
        self.assertIn("WITHOUT a score", err)
        code, out, err = self.run_as("coder", "review", "record", self.PR, "--reviewer", "impact", "--verdict", "approve", "--impact-severity", "Marginal", "--impact-probability", "Remote")
        self.assertEqual((code, err), (0, ""))

    def test_other_reviewers_never_get_the_warning(self):
        for reviewer in ("code", "architecture", "security", "test"):
            with self.subTest(reviewer=reviewer):
                code, out, err = self.record(reviewer=reviewer)
                self.assertEqual((code, err), (0, ""))

    def test_the_family_of_only_x_refusals_says_what_it_accepts(self):
        code, out, err = self.run_as("coder", "review", "checkout", self.PR, "--remove", "somewhere")
        self.assertNotEqual(code, 0, err)   # refused (its own exit code, not changed here)
        self.assertIn("--remove takes only the directory", err)
        code, out, err = self.run_as("coder", "notice", "withdraw", self.PR, "a note")
        self.assertEqual(code, 2)
        self.assertIn("notice withdraw takes only the PR", err)


class TestAgentBlockCounts(TestBlockTable):
    """#901: an impact rating counts by score only when it carries the verdict block the agent returned. Every shape is driven through the real `review record`, then scored by the real `judge`."""

    SCORED = "impact-severity: Marginal\nimpact-probability: Remote\nimpact-reason: why\n"
    # shape -> (record command arguments builder, recorded, counts by score)
    SHAPES = {
        "block present": ("block", True, True),
        "block for another head": ("other-head", False, False),
        "malformed block": ("malformed", False, False),
        "flags only": ("flags", True, False),
        "block disagreeing with the flags": ("disagree", True, False),
        "block with no score lines": ("no-score", True, False),
        "old record (no block keys)": ("old", True, False),
    }

    def setUp(self):
        super().setUp()
        patcher = mock.patch.object(sb, "gates_caller_kind", return_value=("agent", "rev", "reviewer"))   # the recorded role of the session that records: the independent reviewer
        patcher.start()
        self.addCleanup(patcher.stop)

    def make(self, shape):
        base = ("review", "record", self.PR, "--reviewer", "impact")
        if shape == "block":
            return self.record(extra=self.SCORED)
        if shape == "other-head":
            path = self.world.state / "other.txt"
            path.write_text("verdict: approve\nhead: %s\nimpact-action: none\n%sfiles-read:\n- docs/a.md | 5 | 5\nfindings:\n" % ("b" * 40, self.SCORED))
            return self.run_as("coder", *base, "--block", str(path))
        if shape == "malformed":
            path = self.world.state / "bad.txt"
            path.write_text("nothing like a verdict block\n")
            return self.run_as("coder", *base, "--block", str(path))
        if shape == "flags":
            return self.run_as("coder", *base, "--verdict", "approve", "--impact-action", "none", "--impact-severity", "Marginal", "--impact-probability", "Remote")
        if shape == "disagree":
            return self.record("--impact-severity", "Critical", "--impact-probability", "Remote", extra=self.SCORED)
        if shape == "no-score":
            return self.record()
        if shape == "old":
            code = self.run_as("coder", *base, "--verdict", "approve", "--impact-action", "none", "--impact-severity", "Marginal", "--impact-probability", "Remote")
            return code

    def score(self, last=1):
        mod = sb.load_module("delegated_clear")
        entries = [e for e in self.ledger() if e["kind"] == "review_record"][-last:]
        return mod.judge(mod.score_block(), sb.impact_floor.load_matrix()["cells"], entries, {"pr": self.PR, "head": LEDGER_HEAD}, "Serious")

    def test_every_shape_records_as_the_table_says_and_counts_only_with_the_agents_block(self):
        for name, (shape, recorded, counts) in self.SHAPES.items():
            with self.subTest(shape=name):
                before = len([e for e in self.ledger() if e["kind"] == "review_record"])
                code, out, err = self.make(shape)
                self.assertEqual(code == 0, recorded, err)
                entries = [e for e in self.ledger() if e["kind"] == "review_record"]
                self.assertEqual(len(entries), before + (1 if recorded else 0))
                if not recorded:
                    continue
                if shape == "old":   # strip the block keys as an old record has none
                    entry = dict(entries[-1])
                    for key in [k for k in entry if k.startswith("block_")]:
                        del entry[key]
                    scored = sb.load_module("delegated_clear").judge(sb.load_module("delegated_clear").score_block(), sb.impact_floor.load_matrix()["cells"], [dict(entry, by_role="reviewer")], {"pr": self.PR, "head": LEDGER_HEAD}, "Serious")
                else:
                    scored = self.score()
                if counts:
                    self.assertEqual(scored["reasons"], [])
                    self.assertEqual(scored["level"], sb.impact_floor.load_matrix()["cells"]["Marginal"]["Remote"]["level"])
                else:
                    self.assertIsNone(scored["level"])
                    self.assertEqual(scored["reasons"], [sb.load_module("delegated_clear").NO_AGENT_BLOCK])

    # ---- #1126: the floor prints the exact mismatch; a rating is recorded from the verbatim block
    def block_file(self, sev="Marginal", prob="Remote", action="none", klass=""):
        path = self.world.state / "verbatim.txt"
        path.write_text("verdict: approve\nhead: %s\nimpact-action: %s\n%simpact-severity: %s\nimpact-probability: %s\nimpact-reason: why\nfiles-read:\n- docs/a.md | 5 | 5\nfindings:\n" % (
            LEDGER_HEAD, action, ("impact-class: %s\n" % klass) if klass else "", sev, prob))
        return str(path)

    def record_file(self, **kw):
        return self.run_as("coder", "review", "record", self.PR, "--reviewer", "impact", "--block-file", self.block_file(**kw))

    def floor_out(self):
        code, out, err = self.run_as("coder", "impact", "floor", self.PR)
        self.assertEqual(code, 0, err)
        return [l.strip() for l in out.splitlines() if "rating considered:" in l], out

    def test_the_block_file_records_the_blocks_four_values(self):
        code, out, err = self.record_file(sev="Critical", prob="Remote", action="hold", klass="data")
        self.assertEqual(code, 0, err)
        entry = self.records()[-1]
        self.assertEqual([entry[k] for k in ("impact_severity", "impact_probability", "impact_action", "impact_class")], ["Critical", "Remote", "hold", "data"])
        self.assertEqual(entry["record_form"], "block-file")
        lines, out = self.floor_out()
        self.assertEqual(len(lines), 1, out)
        self.assertIn("agrees", lines[0])
        self.assertNotIn("retyped-field", out)

    def refusals(self):
        good = self.block_file()
        bad = self.world.state / "bad1126.txt"
        bad.write_text("nothing like a verdict block\n")
        base = ("review", "record", self.PR, "--reviewer", "impact")
        return [("restated flag", base + ("--block-file", good, "--impact-severity", "Marginal")),
                ("unparseable", base + ("--block-file", str(bad))),
                ("file and flags", base + ("--block-file", good, "--verdict", "approve", "--impact-action", "none")),
                ("file and block", base + ("--block-file", good, "--block", good))]

    def check_refusals(self):
        for name, argv in self.refusals():
            before = self.ledger()
            code, out, err = self.run_as("coder", *argv)
            self.assertNotEqual(code, 0, name)
            self.assertEqual(self.ledger(), before, name)

    def test_each_refusal_records_nothing(self):
        self.check_refusals()

    def two_block_refusal(self):
        one = Path(self.block_file())
        two = self.world.state / "two1126.txt"
        two.write_text(one.read_text() + one.read_text().replace("Marginal", "Critical"))
        before = self.ledger()
        code, out, err = self.run_as("coder", "review", "record", self.PR, "--reviewer", "impact", "--block-file", str(two))
        self.assertNotEqual(code, 0)
        self.assertIn("the file holds 2 blocks: a block file is ONE block, the rater's own", out + err)
        self.assertEqual(self.ledger(), before)   # no row, no audit line

    def test_a_block_file_with_two_blocks_is_refused_and_one_block_records(self):
        self.two_block_refusal()
        code, out, err = self.record_file()
        self.assertEqual(code, 0, err)

    def test_the_mutant_that_accepts_a_two_block_file_fails(self):
        real = sb.parse_review_block
        def mutant(text):
            fields, why = real(text)
            if fields is not None:
                fields = dict(fields, block_count=0)
            return fields, why
        with mock.patch.object(sb, "parse_review_block", mutant):
            with self.assertRaises(AssertionError):
                self.two_block_refusal()

    ROW = dict(kind="review_record", reviewer="impact", pr="acme/app#7", head="a" * 40, impact_severity="Marginal", impact_probability="Remote", impact_action="none",
               block_sha256="f" * 64, block_impact_severity="Marginal", block_impact_probability="Remote", block_impact_action="none")

    def lines_for(self, row, head="a" * 40, func=None):
        with mock.patch.object(sb.plan_ledger, "read_ledger", return_value=([row], None)):
            return (func or sb.rating_mismatch_lines)("/nowhere", "acme/app#7", head)

    def check_mismatches(self, func=None):
        self.assertIn("agrees", self.lines_for(dict(self.ROW), func=func)[0])
        for field, change, head in (("severity", {"impact_severity": "Critical"}, "a" * 40), ("probability", {"impact_probability": "Frequent"}, "a" * 40),
                                    ("action", {"impact_action": "hold"}, "a" * 40), ("head", {}, "b" * 40)):
            (line,) = self.lines_for(dict(self.ROW, **change), head, func)   # no subTest: a mutant's failure must raise
            self.assertIn("differs first at %s" % field, line)
            self.assertNotIn("agrees", line)
            if field == "head":
                self.assertIn("is not the current head", line)
            else:
                self.assertIn("block Marginal", line)
        (line,) = self.lines_for({k: v for k, v in self.ROW.items() if not k.startswith("block_")}, func=func)
        self.assertIn(sb.RETYPED_FORM_TEXT, line)
        self.assertIn("no block to compare", line)
        self.assertNotIn("agrees", line)
        (line,) = self.lines_for(dict(self.ROW, impact_action="hold", block_impact_action=None), func=func)
        self.assertIn("differs first at action", line)
        self.assertNotIn("agrees", line)
        self.assertIn("agrees", self.lines_for(dict(self.ROW, block_impact_action=None), func=func)[0])
        self.assertNotIn(sb.RETYPED_FORM_TEXT, self.lines_for(dict(self.ROW), func=func)[0])

    def test_the_floor_names_the_first_differing_field_and_the_old_form(self):
        self.check_mismatches()

    def test_the_old_form_is_said_in_the_floor_output_and_a_block_file_record_is_not(self):
        self.assertEqual(self.run_as("coder", "review", "record", self.PR, "--reviewer", "impact", "--verdict", "approve", "--impact-action", "none",
                                     "--impact-severity", "Marginal", "--impact-probability", "Remote")[0], 0)
        lines, out = self.floor_out()
        self.assertEqual(out.count("retyped-field form"), 1, out)
        self.assertEqual(self.record_file()[0], 0)
        lines, out = self.floor_out()
        self.assertEqual(len(lines), 2)
        self.assertEqual(out.count("retyped-field form"), 1, out)

    def test_the_definition_the_skill_and_the_docs_name_the_block_file_form_and_the_mismatch_line(self):
        for path in ("agents/reviewers/reviewer-impact.md", "skills/fleet-review/SKILL.md"):
            self.assertIn("--block-file", (REPO / path).read_text(), path)
        docs = (REPO / "docs" / "switchboard.md").read_text()
        self.assertEqual(docs.count("rating considered: impact 1a2b3c4d: recorded Critical/Remote/hold; block Marginal/Remote/none; differs first at severity"), 1)

    def test_mutants_are_caught(self):
        real = sb.rating_mismatch_lines
        agrees_always = lambda *a: [l.split("; differs")[0] + "; agrees" if "differs" in l else l for l in real(*a)]
        ignores_head = lambda state, pr, head: real(state, pr, None)
        no_block_agrees = lambda *a: [l.replace("no block to compare", "agrees") for l in real(*a)]
        missing_action_agrees = lambda *a: [l.replace("differs first at action", "agrees").split(" (recorded hold, block none)")[0] if "block none/" not in l and "hold, block none)" in l else l for l in real(*a)]
        for name, mutant in (("agrees with a differing field", agrees_always), ("ignores the head", ignores_head),
                             ("no block agrees", no_block_agrees), ("missing block action agrees with hold", missing_action_agrees)):
            with self.subTest(mutant=name):
                with self.assertRaises(AssertionError):
                    self.check_mismatches(mutant)
        original = sb.rating_inputs
        def drops_flags(argv):
            got = original(argv)
            return {"block_file": got["block_file"]} if "block_file" in got else got
        with mock.patch.object(sb, "rating_inputs", drops_flags):
            with self.assertRaises(AssertionError):
                self.check_refusals()

    def verdict_lines(self, out):
        return [l for l in out.splitlines() if "rating considered:" not in l]

    def test_u1_agreeing_ratings_keep_the_floor_verdict(self):
        # the verdict part of the output is the same for a block-file record and for the same rating recorded with --block (the older, unchanged path)
        self.assertEqual(self.record_file()[0], 0)
        code, out1, err = self.run_as("coder", "impact", "floor", self.PR)
        self.assertEqual(code, 0, err)
        self.assertIn("agrees", "".join(l for l in out1.splitlines() if "rating considered:" in l))
        self.assertEqual(self.verdict_lines(out1), self.verdict_lines(self.run_as("coder", "impact", "floor", self.PR)[1]))
        self.assertEqual([l for l in self.verdict_lines(out1) if "differs first" in l], [])

    def test_u2_the_old_form_still_records(self):
        before = len(self.records())
        code, out, err = self.run_as("coder", "review", "record", self.PR, "--reviewer", "impact", "--verdict", "approve", "--impact-action", "none",
                                     "--impact-severity", "Marginal", "--impact-probability", "Remote")
        self.assertEqual(code, 0, err)
        entry = self.records()[-1]
        self.assertEqual(len(self.records()), before + 1)
        self.assertEqual([entry[k] for k in ("impact_severity", "impact_probability", "impact_action")], ["Marginal", "Remote", "none"])
        self.assertEqual(entry["block_sha256"], "none")

    def test_u3_a_refusal_writes_no_row_and_no_audit_line(self):
        before = self.ledger()
        for name, argv in self.refusals():
            code, out, err = self.run_as("coder", *argv)
            self.assertNotEqual(code, 0, name)
        self.assertEqual(self.ledger(), before)

    def test_the_shapes_table_covers_the_record_shapes_of_the_code(self):
        self.assertEqual(sorted(shape for shape, _, _ in self.SHAPES.values()), sorted(["block", "other-head", "malformed", "flags", "disagree", "no-score", "old"]))
        self.assertEqual(len(self.SHAPES), 7)

    def test_the_record_keeps_the_blocks_hash_and_size_and_marks_a_flags_only_record(self):
        path = self.world.state / "block.txt"
        self.assertEqual(self.record(extra=self.SCORED)[0], 0)
        entry = self.records()[-1]
        raw = path.read_bytes()
        self.assertEqual((entry["block_sha256"], entry["block_size"]), (hashlib.sha256(raw).hexdigest(), len(raw)))
        self.assertEqual((entry["block_impact_severity"], entry["block_impact_probability"]), ("Marginal", "Remote"))
        self.run_as("coder", "review", "record", self.PR, "--reviewer", "impact", "--verdict", "approve")
        self.assertEqual(self.records()[-1]["block_sha256"], "none")
        self.assertNotIn("block_size", self.records()[-1])
        self.run_as("coder", "review", "record", self.PR, "--reviewer", "code", "--verdict", "approve")
        self.assertNotIn("block_sha256", self.records()[-1])

    def test_a_malformed_hash_counts_for_nothing(self):
        mod = sb.load_module("delegated_clear")
        good = dict(kind="review_record", pr=self.PR, head=LEDGER_HEAD, reviewer="impact", by_role="reviewer", impact_severity="Marginal", impact_probability="Remote",
                    block_impact_severity="Marginal", block_impact_probability="Remote")
        self.assertTrue(mod.counts_by_block(dict(good, block_sha256="a" * 64)))
        for bad in ("", "a" * 63, 12345, None, "A" * 64, "none"):
            self.assertFalse(mod.counts_by_block(dict(good, block_sha256=bad)), bad)

    def test_floor_gates_and_the_clear_name_the_missing_block_in_the_same_words(self):
        line = sb.load_module("delegated_clear").NO_AGENT_BLOCK
        self.make("flags")
        code, out, err = self.run_as("coder", "impact", "floor", self.PR)
        self.assertEqual(out.count(line), 1, out)
        code, out, err = self.run_as("coder", "gates", self.PR)
        self.assertEqual(out.count(line), 1, out)
        self.assertIn(line, self.score()["reasons"])
        self.make("block")   # the newest record carries the agent's block: the line is gone
        code, out, err = self.run_as("coder", "impact", "floor", self.PR)
        self.assertNotIn("no agent block", out)
        code, out, err = self.run_as("coder", "gates", self.PR)
        self.assertNotIn("no agent block", out)

    VERDICT_BLOCKS = {"approve": "", "comment": "", "request-changes": "- R-CODE-1 | block | bin/x:1 | why | fix\n", "incomplete": ""}

    def test_only_an_incomplete_verdict_fails_to_count_and_says_so_in_its_own_line(self):
        mod = sb.load_module("delegated_clear")
        for verdict, finding in self.VERDICT_BLOCKS.items():
            with self.subTest(verdict=verdict):
                path = self.world.state / "v.txt"
                path.write_text("verdict: %s\nhead: %s\nimpact-action: none\n%sfiles-read:\n- docs/a.md | 5 | 5\nfindings:\n%s" % (verdict, LEDGER_HEAD, self.SCORED, finding))
                code, out, err = self.run_as("coder", "review", "record", self.PR, "--reviewer", "impact", "--block", str(path))
                self.assertEqual(code, 0, err)
                scored = self.score()
                if verdict == "incomplete":
                    self.assertIsNone(scored["level"])
                    self.assertEqual(scored["reasons"], [mod.INCOMPLETE_VERDICT])
                    self.assertNotEqual(mod.INCOMPLETE_VERDICT, mod.NO_AGENT_BLOCK)
                else:
                    self.assertEqual(scored["reasons"], [])
                    self.assertEqual(scored["level"], sb.impact_floor.load_matrix()["cells"]["Marginal"]["Remote"]["level"])
        self.assertEqual(sorted(self.VERDICT_BLOCKS), sorted(sb.plan_ledger.REVIEW_VERDICTS))   # derived: a new verdict word must be added here

    def test_floor_and_gates_say_the_incomplete_line_not_the_missing_block_line(self):
        mod = sb.load_module("delegated_clear")
        path = self.world.state / "v.txt"
        path.write_text("verdict: incomplete\nhead: %s\nimpact-action: none\n%sfindings:\n" % (LEDGER_HEAD, self.SCORED))
        self.assertEqual(self.run_as("coder", "review", "record", self.PR, "--reviewer", "impact", "--block", str(path))[0], 0)
        for argv in (("impact", "floor", self.PR), ("gates", self.PR)):
            out = self.run_as("coder", *argv)[1]
            self.assertEqual(out.count(mod.INCOMPLETE_VERDICT), 1, argv)
            self.assertEqual(out.count(mod.NO_AGENT_BLOCK), 0, argv)

    def test_the_definition_says_read_every_hunk_return_incomplete_and_where_the_matrix_words_come_from(self):
        text = (REPO / "agents" / "reviewers" / "reviewer-impact.md").read_text()
        for phrase in ("every line of the diff", "verdict: incomplete", "never prose", "impact matrix --for-rater"):
            self.assertIn(phrase, text.replace("EVERY", "every"))

    def state_files(self):
        return {str(p.relative_to(self.world.state)): p.read_bytes() for p in sorted(self.world.state.rglob("*")) if p.is_file()}

    def test_impact_matrix_prints_the_files_words_cell_by_cell_and_writes_nothing(self):
        before = self.state_files()
        code, out, err = self.run_as("coder", "impact", "matrix", "--json")
        self.assertEqual(code, 0, err)
        self.assertEqual(self.state_files(), before)
        printed = json.loads(out)
        file = json.loads((REPO / "docs" / "review-laws" / "impact-matrix.json").read_text())
        for severity, row in file["cells"].items():
            for probability, cell in row.items():
                self.assertEqual(printed["cells"][severity][probability], cell, (severity, probability))
        self.assertEqual(sum(len(r) for r in printed["cells"].values()), sum(len(r) for r in file["cells"].values()))
        rules = file["owner_hold"]["delegated_clear"]["score"]["floor"]["rules"]
        self.assertEqual(printed["floor_rules"], rules)
        self.assertEqual((printed["severities"], printed["probabilities"]), (file["severities"], file["probabilities"]))
        text = self.run_as("coder", "impact", "matrix")[1]
        for severity, row in file["cells"].items():
            for probability, cell in row.items():
                self.assertIn("cell %s / %s: level %s, action %s" % (severity, probability, cell["level"], cell["action"]), text)
        for rule_id, cls in rules.items():
            self.assertIn("floor rule %s: class %s" % (rule_id, cls), text)

    def test_impact_matrix_for_rater_prints_the_floor_reports_rule_ids_and_paths(self):
        paths = ["shims/gh", "docs/a.md"]
        self.pr = dict(self.pr, changedFiles=len(paths), files=[{"path": p, "additions": 1, "deletions": 0} for p in paths])
        before = self.state_files()
        code, out, err = self.run_as("coder", "impact", "matrix", "--for-rater", self.PR, "--json")
        self.assertEqual(code, 0, err)
        printed = json.loads(out)["for_rater"]
        report = json.loads(self.run_as("coder", "impact", "floor", self.PR, "--json")[1])
        rules = json.loads((REPO / "docs" / "review-laws" / "impact-matrix.json").read_text())["owner_hold"]["delegated_clear"]["score"]["floor"]["rules"]
        expected = {rule_id: sorted(report["top_tier_hits"][cls]) for rule_id, cls in rules.items() if report["top_tier_hits"].get(cls)}
        self.assertTrue(expected, "the fixture changes a floor path")
        self.assertEqual(printed["floor_hits"], expected)
        self.assertEqual(self.state_files(), before)
        text = self.run_as("coder", "impact", "matrix", "--for-rater", self.PR)[1]
        for rule_id, paths in expected.items():
            self.assertIn("floor hit %s: %s" % (rule_id, ", ".join(paths)), text)

    def test_an_incomplete_record_beside_a_complete_block_does_not_stop_the_complete_one_counting(self):
        mod = sb.load_module("delegated_clear")
        for verdict in ("incomplete", "approve"):
            path = self.world.state / "v.txt"
            path.write_text("verdict: %s\nhead: %s\nimpact-action: none\n%sfiles-read:\n- docs/a.md | 5 | 5\nfindings:\n" % (verdict, LEDGER_HEAD, self.SCORED))
            self.assertEqual(self.run_as("coder", "review", "record", self.PR, "--reviewer", "impact", "--block", str(path))[0], 0)
        scored = self.score(last=2)
        self.assertEqual(scored["reasons"], [])
        self.assertEqual(scored["level"], sb.impact_floor.load_matrix()["cells"]["Marginal"]["Remote"]["level"])

    def test_for_rater_with_no_floor_hit_says_none_and_an_unreadable_matrix_is_refused_in_a_line(self):
        out = self.run_as("coder", "impact", "matrix", "--for-rater", self.PR)[1]
        self.assertIn("floor hit: none", out)
        with mock.patch.object(sb.impact_floor, "load_matrix", side_effect=sb.impact_floor.MatrixError("unreadable")):
            code, out, err = self.run_as("coder", "impact", "matrix")
        self.assertEqual(code, 2)
        self.assertIn("impact matrix:", err)

    def test_a_file_name_with_control_characters_is_printed_safely_and_capped(self):
        self.assertEqual(sb._printable_path("shims/gh\x1b[2J\x07"), "shims/gh?[2J?")
        self.assertEqual(len(sb._printable_path("a" * 1000)), sb.IMPACT_MATRIX_PATH_LEN)
        paths = ["shims/gh"] + ["docs/%d.md" % n for n in range(3)]
        self.pr = dict(self.pr, changedFiles=len(paths), files=[{"path": p, "additions": 1, "deletions": 0} for p in paths])
        hits = json.loads(self.run_as("coder", "impact", "matrix", "--for-rater", self.PR, "--json")[1])["for_rater"]["floor_hits"]
        self.assertTrue(all(len(v) <= sb.IMPACT_MATRIX_PATHS_MAX and all(p.isprintable() for p in v) for v in hits.values()))

    def test_a_failure_to_make_the_rating_note_says_so(self):
        with mock.patch.object(sb, "load_module", side_effect=RuntimeError("x")):
            self.assertIn("no rating note", sb.rating_block_note([{"kind": "review_record"}], self.PR, LEDGER_HEAD))

    def test_an_uncounted_rating_that_is_higher_than_the_counted_one_refuses_and_a_lower_one_is_ignored(self):
        mod = sb.load_module("delegated_clear")
        cells = sb.impact_floor.load_matrix()["cells"]
        low = ("Negligible", "Improbable")
        high = ("Critical", "Frequent")
        base = dict(kind="review_record", pr=self.PR, head=LEDGER_HEAD, reviewer="impact", by_role="reviewer", verdict="approve")
        counted = dict(base, impact_severity=low[0], impact_probability=low[1], block_sha256="a" * 64, block_impact_severity=low[0], block_impact_probability=low[1])
        flags_high = dict(base, impact_severity=high[0], impact_probability=high[1], block_sha256="none")
        flags_low = dict(base, impact_severity=low[0], impact_probability=low[1], block_sha256="none")
        incomplete_high = dict(base, impact_severity=high[0], impact_probability=high[1], block_sha256="b" * 64, block_impact_severity=high[0], block_impact_probability=high[1], verdict="incomplete")
        report = {"pr": self.PR, "head": LEDGER_HEAD}
        judge = lambda entries: mod.judge(mod.score_block(), cells, entries, report, "Serious")
        # a record whose BLOCK says high but whose typed flags say low (a flag wins over the block's line, so it does not count): the block's own higher score is what refuses
        block_high_typed_low = dict(base, impact_severity=low[0], impact_probability=low[1], block_sha256="c" * 64, block_impact_severity=high[0], block_impact_probability=high[1])
        shapes = {"flags only, higher": flags_high, "incomplete, higher": incomplete_high, "block high, typed low": block_high_typed_low}
        self.assertEqual(sorted(shapes), sorted(["flags only, higher", "incomplete, higher", "block high, typed low"]))
        self.assertEqual(judge([counted])["reasons"], [])
        for label, others in ((l, [e]) for l, e in shapes.items()):
            for order in (lambda e: [counted] + e, lambda e: e + [counted]):
                with self.subTest(label=label):
                    self.assertEqual(judge(order(others))["reasons"], [mod.HIGHER_UNCOUNTED])
        self.assertEqual(judge([counted, flags_low])["reasons"], [])   # a lower or equal uncounted rating is ignored
        self.assertEqual(judge([counted, dict(flags_high, impact_probability=None)])["reasons"], [])   # a record with no readable score is ignored

    def test_the_rater_honesty_sentence_is_in_the_definition_and_in_the_docs(self):
        sentence = "Never adjust a rating to fit the floor: a rating below the floor is reported as it is and goes to the owner."
        for path in ("agents/reviewers/reviewer-impact.md", "docs/switchboard.md"):
            self.assertEqual((REPO / path).read_text().count(sentence), 1, path)

    def test_the_limit_is_said_in_the_docs_and_the_definition(self):
        for path in ("docs/switchboard.md", "agents/reviewers/reviewer-impact.md"):
            text = (REPO / path).read_text()
            self.assertIn("not that the agent produced it", text, path)
            self.assertIn("mistake-guard", text)

    def test_only_the_scorer_reads_the_score_fields(self):
        for name in ("impact_hold.py", "impact_floor.py", "plan_ledger.py"):   # the readers of a rating outside the scorer (the record's own warning is a writer)
            text = (REPO / "bin" / name).read_text().replace("block_impact", "")
            self.assertEqual(len(re.findall(r'get\("impact_(?:severity|probability)"\)', text)), 0, name)

class TestWholeRead(LedgerBase):
    """#1047: a rating is recorded only from a whole read of the pull request's changed files (read from GitHub), and a verdict is recorded exactly as given."""

    FILES = ("src/a.py", "docs/long.md", "docs/b.md")
    HEAD2 = "e" * 40

    def setUp(self):
        super().setUp()
        self.extra_config = dict(FLOOR_CONFIG, plan_gates={"repos": {"acme/app": {"mode": "shadow"}}})
        self.configure()
        self.pr = dict(self.pr, baseRefOid="c" * 40, changedFiles=3, files=[{"path": p, "additions": 1, "deletions": 0} for p in self.FILES])

    def records(self):
        return [e for e in self.ledger() if e["kind"] == "review_record"]

    def block(self, rows, verdict="approve", findings="", head=None, reviewer="impact"):
        path = self.world.state / "block.txt"
        head_line = "head: %s\n" % (head or LEDGER_HEAD)
        scored = "impact-action: none\nimpact-severity: Marginal\nimpact-probability: Remote\nimpact-reason: a reason\n" if reviewer == "impact" else ""
        path.write_text("verdict: %s\n%s%sfiles-read:\n%s\nfindings:\n%s" % (verdict, head_line, scored, "\n".join("- %s | %d | %d" % r for r in rows), findings))
        return str(path)

    def record(self, rows, reviewer="impact", **kw):
        return self.run_as("coder", "review", "record", self.PR, "--reviewer", reviewer, "--block", self.block(rows, reviewer=reviewer, **kw))

    WHOLE = (("src/a.py", 30, 30), ("docs/long.md", 900, 900), ("docs/b.md", 12, 12))

    def check_behaviour(self):
        """Every claim about the whole-read rule, as assertions over the real command (a mutant of the rule must fail at least one)."""
        before = len(self.records())
        code, out, err = self.record(self.WHOLE)
        self.assertEqual((code, len(self.records()) - before), (0, 1), err)
        self.assertEqual((self.records()[-1]["files_read"], self.records()[-1]["files_total"]), (3, 3))
        before = len(self.records())
        code, out, err = self.record((("src/a.py", 30, 30), ("docs/long.md", 280, 900), ("docs/b.md", 12, 12)))
        self.assertEqual((code, len(self.records()) - before), (2, 0))
        self.assertIn("docs/long.md", err)
        self.assertIn("line 281", err)
        code, out, err = self.record(self.WHOLE[:2])   # omits one changed file
        self.assertEqual((code, len(self.records()) - before), (2, 0))
        self.assertIn("docs/b.md", err)
        code, out, err = self.record(self.WHOLE[:2] + (("docs/other.md", 12, 12),))   # the right length, one wrong name
        self.assertEqual((code, len(self.records()) - before), (2, 0))
        self.assertIn("docs/b.md", err)
        self.pr = dict(self.pr, changedFiles=4, files=self.pr["files"] + [{"path": "src/only-github.py"}])   # GitHub lists a file the block omits
        code, out, err = self.record(self.WHOLE)
        self.assertEqual((code, len(self.records()) - before), (2, 0))
        self.assertIn("src/only-github.py", err)
        self.pr = dict(self.pr, changedFiles=9)   # GitHub's own list is cut
        code, out, err = self.record(self.WHOLE)
        self.assertEqual((code, len(self.records()) - before), (2, 0))
        self.assertIn("GitHub listed 4 of 9", err)

    def test_s3_s5_s7_s8_s9_the_whole_read_is_recorded_and_a_short_one_refused_naming_the_file_and_the_line(self):
        self.check_behaviour()

    def bound_rows(self, a, b):
        return (("src/a.py", a, b), ("docs/long.md", 900, 900), ("docs/b.md", 12, 12))

    def set_counts(self, counts):
        self.pr = dict(self.pr, files=[{"path": p, "additions": counts.get(p, 1), "deletions": 0} for p in self.FILES])

    def check_bound(self):
        """The bound: a row below GitHub's additions + deletions is refused (total and lines read both), met exactly is recorded, 0 | 0 only where the bound is 0."""
        self.set_counts({"src/a.py": 280})
        before = len(self.records())
        for rows in ((("src/a.py", 279, 279),) + self.WHOLE[1:], (("src/a.py", 0, 0),) + self.WHOLE[1:], (("src/a.py", 100, 100),) + self.WHOLE[1:], (("src/a.py", 100, 280),) + self.WHOLE[1:]):
            code, out, err = self.record(rows)
            self.assertEqual((code, len(self.records()) - before), (2, 0), rows)
            self.assertIn("src/a.py", err)
            self.assertIn("280", err)
        code, out, err = self.record((("src/a.py", 280, 279),) + self.WHOLE[1:])   # read below the bound while claiming a lower total
        self.assertEqual(code, 2)
        code, out, err = self.record(self.bound_rows(280, 280))   # met exactly
        self.assertEqual((code, len(self.records()) - before), (0, 1), err)
        self.set_counts({"src/a.py": 0})   # binary or renamed: 0 | 0 is honest
        code, out, err = self.record(self.bound_rows(0, 0))
        self.assertEqual(code, 0, err)
        self.set_counts({"src/a.py": 3})   # additions and deletions both count
        self.pr["files"][0]["deletions"] = 4
        code, out, err = self.record(self.bound_rows(6, 6))
        self.assertEqual(code, 2)
        code, out, err = self.record(self.bound_rows(7, 7))
        self.assertEqual(code, 0, err)

    def record_file_rows(self, rows):
        return self.run_as("coder", "review", "record", self.PR, "--reviewer", "impact", "--block-file", self.block(rows))

    def check_block_file_bound(self):
        """S9 (#1126): --block-file goes through the same whole-read check as --block."""
        self.set_counts({"src/a.py": 280})
        before = len(self.records())
        code, out, err = self.record_file_rows((("src/a.py", 279, 279),) + self.WHOLE[1:])
        self.assertEqual((code, len(self.records()) - before), (2, 0), err)
        self.assertIn("src/a.py", err)
        self.assertIn("280", err)
        code, out, err = self.record_file_rows(self.bound_rows(280, 280))
        self.assertEqual((code, len(self.records()) - before), (0, 1), err)

    def test_s9_block_file_is_refused_below_the_whole_read_bound_and_recorded_when_met(self):
        self.check_block_file_bound()

    def test_s9_a_mutant_that_bypasses_the_bound_for_block_file_fails(self):
        real = sb.whole_read_problem
        for name, mutant in (("no bound at all", lambda rows, listed, bounds=None: real(rows, listed, None)),
                             ("no check", lambda rows, listed, bounds=None: None)):
            with self.subTest(name), mock.patch.object(sb, "whole_read_problem", mutant):
                with self.assertRaises(AssertionError):
                    self.check_block_file_bound()
        self.assertEqual(sb.whole_read_problem, real)

    def test_the_bound_refuses_a_total_below_githubs_count_and_accepts_it_met_exactly(self):
        self.check_bound()

    def test_a_mutant_that_trusts_the_blocks_total_fails_the_bound_check(self):
        real = sb.whole_read_problem
        def trusts_total(rows, listed, bounds=None):
            return real(rows, listed, None)
        def ignores_read(rows, listed, bounds=None):   # checks the total only
            return real([(p, t, t) for p, r, t in rows], listed, bounds)
        def ignores_total(rows, listed, bounds=None):   # checks the lines read only
            return real([(p, r, r) for p, r, t in rows], listed, bounds)
        for name, mutant in (("trusts the block's total", trusts_total), ("ignores the lines read", ignores_read), ("ignores the total", ignores_total)):
            with self.subTest(name), mock.patch.object(sb, "whole_read_problem", mutant):
                with self.assertRaises(AssertionError):
                    self.check_bound()
        self.assertEqual(sb.whole_read_problem, real)

    def test_s10_each_mutant_of_the_rule_fails_the_behaviour_check(self):
        real_problem, real_paths = sb.whole_read_problem, sb.pr_changed_paths
        def accepts_short(rows, listed, bounds=None):
            return None
        def count_only(rows, listed, bounds=None):
            return None if len(rows) >= len(listed) else real_problem(rows, listed, bounds)
        def trusts_block(rows, listed, bounds=None):
            return real_problem(rows, [r[0] for r in rows], bounds)
        for name, mutant in (("accepts a short list", accepts_short), ("compares only the count", count_only), ("trusts the block's own list", trusts_block)):
            with self.subTest(name), mock.patch.object(sb, "whole_read_problem", mutant):
                with self.assertRaises(AssertionError):
                    self.check_behaviour()
        self.assertEqual(sb.whole_read_problem, real_problem)
        self.assertEqual(sb.pr_changed_paths, real_paths)

    def test_s4_an_incomplete_block_is_recorded_with_a_short_list_and_counts_for_nothing(self):
        code, out, err = self.record(self.WHOLE[:1], verdict="incomplete")
        self.assertEqual(code, 0, err)
        (entry,) = self.records()
        self.assertEqual((entry["verdict"], entry["files_read"], entry["files_total"]), ("incomplete", 1, 3))
        self.assertEqual(sb.plan_ledger.review_records_at(self.ledger(), self.PR, LEDGER_HEAD)["recorded"]["impact"], "incomplete")

    def test_1047_a_malformed_or_duplicate_files_read_row(self):
        path = self.world.state / "block.txt"
        for verdict, expect in (("approve", 2), ("incomplete", 0)):
            path.write_text("verdict: %s\nhead: %s\nimpact-action: none\nfiles-read:\n- src/a.py | many | 30\nfindings:\n" % (verdict, LEDGER_HEAD))
            code, out, err = self.run_as("coder", "review", "record", self.PR, "--reviewer", "impact", "--block", str(path))
            self.assertEqual(code, expect, err)
            if expect == 2:
                self.assertIn("is not `- <path>", err)
        self.assertIsNone(sb.whole_read_problem([("a", 5, 5), ("a", 3, 5)], ["a"]))   # the fuller of two rows for one path counts
        self.assertIn("line 4", sb.whole_read_problem([("a", 3, 5), ("a", 3, 5)], ["a"]))

    def test_1047_an_uncited_mark_is_replaced_by_a_later_record_and_shown_in_the_state_line(self):
        uncited = "- no rule here | block | src/a.py:4 | vague | fix it\n"
        self.assertEqual(self.record(self.WHOLE, verdict="request-changes", findings=uncited, reviewer="code")[0], 0)
        self.assertEqual(self.record(self.WHOLE, verdict="request-changes", findings=uncited, reviewer="code")[0], 0)
        self.assertEqual(sb.plan_ledger.review_records_at(self.ledger(), self.PR, LEDGER_HEAD)["uncited"], ["code"])
        view = {"pr": self.PR, "known": True, "state": "OPEN", "head": LEDGER_HEAD, "reviews": [{"reviewer": "code", "verdict": "request-changes", "uncited": True}], "checks": None,
                "gates": None, "labels": [], "age_seconds": 1, "examined_head": None, "examined_age_seconds": None}
        self.assertIn("code request-changes (names no rule, does not block)", sb.pr_state_line(view))
        self.assertEqual(self.record(self.WHOLE, verdict="approve", reviewer="code")[0], 0)
        self.assertEqual(sb.plan_ledger.review_records_at(self.ledger(), self.PR, LEDGER_HEAD)["uncited"], [])

    def test_s12_a_head_that_is_not_the_pull_requests_is_refused_naming_both_full_heads(self):
        for given in (self.HEAD2, LEDGER_HEAD[:7] + "f" * 33):
            code, out, err = self.record(self.WHOLE, head=given)
            self.assertEqual(code, 2)
            self.assertIn(given, err)
            self.assertIn(LEDGER_HEAD, err)
        self.assertEqual(self.records(), [])
        self.assertEqual(self.record(self.WHOLE, head=LEDGER_HEAD[:12])[0], 0)
        self.assertEqual(self.records()[-1]["head"], LEDGER_HEAD)

    def test_s13_u2_u5_a_verdict_is_recorded_as_given_and_an_uncited_request_changes_is_marked_and_does_not_block(self):
        cited = "- R-CODE-3 | block | src/a.py:4 | torn write | temp file\n"
        uncited = "- no rule here | block | src/a.py:4 | vague | fix it\n"
        for verdict, findings, mark in (("request-changes", cited, None), ("request-changes", uncited, True), ("approve", "", None), ("comment", uncited, None), ("incomplete", "", None)):
            with self.subTest(verdict=verdict, mark=mark):
                code, out, err = self.record(self.WHOLE, verdict=verdict, findings=findings, reviewer="code")
                self.assertEqual(code, 0, err)
                last = self.records()[-1]
                self.assertEqual((last["verdict"], last.get("uncited")), (verdict, mark))
        self.assertEqual(self.record(self.WHOLE, verdict="request-changes", findings=uncited, reviewer="code")[0], 0)
        code, out, err = self.run_as("coder", "gates", self.PR)
        self.assertIn("code request-changes (names no rule, does not block)", out)
        self.assertNotIn("blocking review(s)", out)
        code, out, err = self.run_as("coder", "review", "blockers", self.PR)
        self.assertIn("names no rule and does not block", out)

    def test_1047_the_blocking_decision_is_one_function_and_each_place_follows_it(self):
        cited = "- R-CODE-3 | block | src/a.py:4 | torn write | temp file\n"
        uncited = "- no rule here | block | src/a.py:4 | vague | fix it\n"
        plan_ledger = sb.plan_ledger
        with self.subTest("record says it does not block"):
            code, out, err = self.record(self.WHOLE, verdict="request-changes", findings=uncited, reviewer="code")
            self.assertEqual(code, 0, err)
            self.assertIn("does not block", out)
        with self.subTest("review_records_at"):
            got = plan_ledger.review_records_at(self.ledger(), self.PR, LEDGER_HEAD)
            self.assertEqual((got["uncited"], got["blocking"]), (["code"], []))
        with self.subTest("gates"):
            out = self.run_as("coder", "gates", self.PR)[1]
            self.assertIn("1 request-changes names no rule and does not block", out)
            self.assertNotIn("blocking review(s)", out)
        with self.subTest("review blockers lists it as not a blocker"):
            out = self.run_as("coder", "review", "blockers", self.PR)[1]
            self.assertIn("does not block (not a blocker)", out)
            self.assertNotIn("blocking finding(s)", out)
        with self.subTest("pr-state line"):
            view = {"pr": self.PR, "known": True, "state": "OPEN", "head": LEDGER_HEAD, "reviews": [{"reviewer": "code", "verdict": "request-changes", "uncited": True}], "checks": None,
                    "gates": None, "labels": [], "age_seconds": 1, "examined_head": None, "examined_age_seconds": None}
            self.assertIn("(names no rule, does not block)", sb.pr_state_line(view))
        with self.subTest("a cited request-changes still blocks everywhere"):
            self.assertEqual(self.record(self.WHOLE, verdict="request-changes", findings=cited, reviewer="code")[0], 0)
            got = plan_ledger.review_records_at(self.ledger(), self.PR, LEDGER_HEAD)
            self.assertEqual((got["uncited"], got["blocking"]), ([], ["code"]))
            self.assertIn("1 blocking review(s)", self.run_as("coder", "gates", self.PR)[1])
            self.assertIn("1 blocking finding(s)", self.run_as("coder", "review", "blockers", self.PR)[1])

    def test_1047_every_function_that_reads_the_uncited_mark_is_in_the_table(self):
        import ast
        found = set()
        for name in ("plan_ledger.py", "fleet-switchboard"):
            text = (REPO / "bin" / name).read_text()
            for node in ast.walk(ast.parse(text)):
                if isinstance(node, ast.FunctionDef):
                    inner = [n for n in ast.walk(node) if isinstance(n, ast.FunctionDef) and n is not node]
                    own = ast.get_source_segment(text, node)
                    if "uncited" in own and not any("uncited" in (ast.get_source_segment(text, n) or "") for n in inner):
                        found.add((name, node.name))
        self.assertEqual(found, set(sb.plan_ledger.UNCITED_CONSUMERS), "a reader of the uncited mark is not in plan_ledger.UNCITED_CONSUMERS (or one in it no longer reads it)")

    def test_s14_each_mutant_of_the_uncited_rule_fails_the_check(self):
        def check():
            count = len(self.records())
            self.run_as("coder", "review", "record", self.PR, "--reviewer", "code", "--block", self.block((), verdict="request-changes", findings="- no rule | block | a:1 | x | y\n", reviewer="code"))
            self.assertEqual(len(self.records()), count + 1, "recorded, not refused")
            last = self.records()[-1]
            self.assertEqual((last["verdict"], last.get("uncited")), ("request-changes", True))
            self.assertNotIn("blocking review(s)", self.run_as("coder", "gates", self.PR)[1], "an uncited request-changes does not block")
            self.assertNotIn("blocking finding(s)", self.run_as("coder", "review", "blockers", self.PR)[1])
        check()
        real = sb.parse_review_block
        def softened(text):
            fields, why = real(text)
            if fields and fields["verdict"] == "request-changes" and not fields["blocks"]:
                fields["verdict"] = "comment"
            return fields, why
        real_append = sb.plan_ledger.append_entry
        def refused(text):
            fields, why = real(text)
            return (None, "refused: needs a rule") if fields and fields["verdict"] == "request-changes" and not fields["blocks"] else (fields, why)
        for name, mutant in (("records it as a comment", softened), ("refuses it", refused)):
            with self.subTest(name), mock.patch.object(sb, "parse_review_block", mutant):
                with self.assertRaises(AssertionError):
                    check()
        with self.subTest("gates it as blocking"), mock.patch.object(sb.plan_ledger, "review_blocks", lambda entry: entry.get("verdict") == "request-changes"):
            with self.assertRaises(AssertionError):
                check()
        with self.subTest("drops the mark"), mock.patch.object(sb.plan_ledger, "append_entry", lambda state, entry, now: real_append(state, {k: v for k, v in entry.items() if k != "uncited"}, now)):
            with self.assertRaises(AssertionError):
                check()

    def test_u1_u3_a_refusal_writes_nothing_and_an_old_record_keeps_its_meaning(self):
        old = {"kind": "review_record", "pr": self.PR, "head": LEDGER_HEAD, "reviewer": "code", "verdict": "request-changes", "blocks": 1, "notes": 0, "by": "coder", "summary": ""}
        plan_ledger = sb.plan_ledger
        plan_ledger.append_entry(self.world.state, old, 1700000000)
        before = (self.world.state / "plan-ledger.jsonl").read_bytes() if (self.world.state / "plan-ledger.jsonl").exists() else None
        floor = self.run_as("coder", "impact", "floor", self.PR, "--json")[1]
        self.assertEqual(self.record(self.WHOLE[:1])[0], 2)
        self.assertEqual(self.run_as("coder", "impact", "floor", self.PR, "--json")[1], floor)
        if before is not None:
            self.assertEqual((self.world.state / "plan-ledger.jsonl").read_bytes(), before)
        self.assertIsNone(plan_ledger.read_ledger(self.world.state)[1])
        self.assertEqual(len(self.records()), 1)
        self.assertNotIn("uncited", self.records()[0])
        self.assertEqual(plan_ledger.review_records_at(self.ledger(), self.PR, LEDGER_HEAD)["uncited"], [])

    def test_s2_u4_the_chunk_size_is_one_constant_said_once_in_the_definition(self):
        text = (REPO / "agents" / "reviewers" / "reviewer-impact.md").read_text()
        region = text.split("<!-- chunk:begin -->", 1)[1].split("<!-- chunk:end -->", 1)[0]
        self.assertEqual(region, "RATER_CHUNK_LINES = %d" % sb.RATER_CHUNK_LINES)
        self.assertEqual(text.count("RATER_CHUNK_LINES"), 1)
        self.assertEqual(text.count(str(sb.RATER_CHUNK_LINES)), 1)
        self.assertEqual((REPO / "bin" / "fleet-switchboard").read_text().count("RATER_CHUNK_LINES = "), 1)
        self.assertIn("one changed file at a time", text)
        self.assertIn("in the changed-file order", text.replace("one each, in the changed-file order", "in the changed-file order"))

    def test_s15_the_rule_is_documented_in_the_docs_and_the_skill(self):
        for path in (REPO / "docs" / "switchboard.md", REPO / "skills" / "fleet-review" / "SKILL.md"):
            self.assertEqual(path.read_text().count("is recorded exactly as given"), 1, path.name)

    def test_s11_the_matrix_words_name_every_floor_rule_and_the_checkout_writes_them(self):
        words = "\n".join(sb.impact_matrix_lines(sb.impact_matrix_words()))
        self.assertEqual(sum(1 for line in words.splitlines() if line.startswith("floor rule ")), 3)
        for rule in ("floor-credentials", "floor-identity", "floor-authority"):
            self.assertIn("floor rule %s:" % rule, words)
        self.assertEqual(sb.impact_matrix_lines(sb.impact_matrix_words())[1].count(","), 3)
        self.assertEqual(sb.impact_matrix_lines(sb.impact_matrix_words())[2].count(","), 4)


class TestImpactRejudge(LedgerBase):
    """#451 slice 3: the daemon's hold labels follow the OWNER-HOLD rule; a hold it applied that no longer holds is taken off (only the labels it added);
    the list is posted once for each version of the rule; an unreadable matrix file changes nothing and says so once. A fake gh records every write."""

    def setUp(self):
        super().setUp()
        self.writes, self.view_reads, self.prs = [], [], {}
        self.t = 100000.0
        self.extra_config = dict(FLOOR_CONFIG, plan_gates={"repos": {"acme/app": {"mode": "shadow"}}}, impact_hold={"enabled": True})
        self.configure()
        self.names = sb.label_names(sb.load_config())
        self.cos = mock.patch.object(sb, "_impact_cos", lambda engine: "boss")
        self.cos.start()
        self.addCleanup(self.cos.stop)

    def route(self, argv, **kwargs):
        if argv[0] == FAKE_GH and argv[1:3] == ["pr", "view"]:
            number = int(argv[3])
            if is_floor_view(argv):
                self.view_reads.append(number)   # the floor's own read (the ci recorder and `review record`, which reads the files for a whole-read check #1047, are not counted)
            return subprocess.CompletedProcess(argv, 0, json.dumps(dict(self.pr, **self.prs.get(number, {}))), "")
        if argv[0] == FAKE_GH and "--method" in argv:
            method = argv[argv.index("--method") + 1]
            if method == "GET" and "/issues?state=open" in argv[2]:   # the open list, for the dry run
                items = [{"number": n, "pull_request": {"url": "x"}, "body": "PLAN: acme/app#7", "labels": [dict(l) for l in self.prs.get(n, {}).get("labels", [])],
                          "user": {"login": "shared"}} for n in sorted(self.prs)]
                return subprocess.CompletedProcess(argv, 0, json.dumps(items if "page=1" in argv[2] else []), "")
            if method == "GET":
                return subprocess.CompletedProcess(argv, 0, "{}", "")
            self.writes.append((method, argv[2], json.loads(kwargs["input"]) if kwargs.get("input") else None))
            return subprocess.CompletedProcess(argv, 0, "{}", "")
        return super().route(argv, **kwargs)

    def files(self, number, path, head=LEDGER_HEAD):
        self.prs[number] = {"headRefOid": head, "changedFiles": 1, "files": [{"path": path}]}

    def listed(self, number, labels=(), head=LEDGER_HEAD, draft=False):
        return {"number": number, "head": {"sha": head}, "body": "PLAN: acme/app#7", "draft": draft, "labels": [{"name": l} for l in labels]}

    def seed_applied(self, numbers, merge_label_added=True, head=LEDGER_HEAD, legacy=False, added=None, at=1):
        """impact-hold.json as the daemon wrote it: the labels it added are listed (`added`); `legacy` is the older record with `merge_label_added` only."""
        path = self.world.state / "impact-hold.json"
        names = [self.names["merge-captain"], self.names["hold-impact"]]
        listed = added if added is not None else (names if merge_label_added else [self.names["hold-impact"]])
        record = {"head": head, "merge_label_added": merge_label_added}
        if not legacy:
            record.update(added=listed, at=at)
        path.write_text(json.dumps({"clears": {}, "applied": {"acme/app#%d" % n: dict(record) for n in numbers}}))

    def passes(self, records, advance=0, live=None):
        self.t += advance
        for item in records:   # the pull request's labels as the live read sees them
            self.prs.setdefault(item["number"], {})["labels"] = [dict(l) for l in item["labels"]]
        for number, names in (live or {}).items():   # ... unless somebody changed them since the list was read
            self.prs.setdefault(number, {})["labels"] = [{"name": n} if isinstance(n, str) else n for n in names]   # a non-name entry is a cut read
        if not hasattr(self, "engine"):
            self.hub = FakeHub({"acme/app": records})
            self.engine = self.world.new_engine("daemon")
            self.engine.hub, self.engine.gh_runner = self.hub, self.route
            self.engine.config, self.engine.state_dir = sb.load_config(), self.world.state
        else:
            self.hub.prs["acme/app"] = records
        sb.ci_record_pass(self.engine, self.t)
        sb.impact_would_hold_pass(self.engine, self.t)

    def posts(self, number=None):
        return [w for w in self.writes if w[0] == "POST" and w[1].endswith("/labels") and (number is None or "/issues/%d/" % number in w[1])]

    def removals(self, number=None):
        return [w for w in self.writes if w[0] == "DELETE" and (number is None or "/issues/%d/" % number in w[1])]

    def events(self, name):
        return [e for e in self.world.audit() if e["event"] == name]

    def both(self):
        return [self.names["merge-captain"], self.names["hold-impact"]]

    # -- S1: the labels follow the owner decision

    def test_s1_only_a_pull_request_that_holds_for_the_owner_is_labelled(self):
        self.files(9, "migrations/0002.sql")   # a floor path that is not a top tier path
        self.files(10, "shims/gh")             # a top tier path
        self.passes([self.listed(9), self.listed(10)])
        self.assertEqual([(w[1], w[2]["labels"]) for w in self.posts()], [("repos/acme/app/issues/10/labels", self.both())])

    # -- S2, S3: the release

    def test_s2_a_hold_that_no_longer_applies_comes_off_and_one_that_still_applies_stays(self):
        self.files(9, "migrations/0002.sql")
        self.files(10, "shims/gh")
        self.seed_applied([9, 10])
        self.passes([self.listed(9, self.both()), self.listed(10, self.both())])
        self.assertEqual(sorted(w[1].rsplit("/", 1)[-1] for w in self.removals(9)), sorted(urllib.parse.quote(n, safe="") for n in self.both()))
        self.assertEqual((self.removals(10), self.posts(10)), ([], []), "the one that still holds keeps both labels and gets none again")
        (released,) = self.events("gate.hold_released")
        self.assertEqual((released["subject"], sorted(released["detail"]["removed"])), ("acme/app#9", sorted(self.both())))
        applied = json.loads((self.world.state / "impact-hold.json").read_text())["applied"]
        self.assertEqual(sorted(applied), ["acme/app#10"], "the record of the released one is gone")

    def test_s3_a_label_a_person_added_is_never_removed(self):
        self.files(9, "migrations/0002.sql")
        self.seed_applied([9], merge_label_added=False)   # the merge label was there before the daemon: only the hold label is ours
        self.passes([self.listed(9, self.both())])
        self.assertEqual([w[1].rsplit("/", 1)[-1] for w in self.removals(9)], [urllib.parse.quote(self.names["hold-impact"], safe="")])

    def test_a_pull_request_with_no_record_of_ours_or_a_corrupt_record_loses_nothing(self):
        self.files(9, "migrations/0002.sql")
        self.passes([self.listed(9, self.both())])                       # no record: the labels are a person's
        self.assertEqual(self.removals(), [])
        (self.world.state / "impact-hold.json").write_text("{not json")
        del self.engine
        self.view_reads.clear()
        self.passes([self.listed(9, self.both())])
        self.assertEqual(self.removals(), [], "a state file nobody can read removes nothing")

    def test_a_hold_label_a_person_added_first_is_not_removed_when_the_record_lists_only_the_merge_label(self):
        self.files(9, "migrations/0002.sql")
        self.seed_applied([9], added=[self.names["merge-captain"]])
        self.passes([self.listed(9, self.both())])
        self.assertEqual([w[1].rsplit("/", 1)[-1] for w in self.removals(9)], [urllib.parse.quote(self.names["merge-captain"], safe="")])

    def test_a_record_written_before_the_list_existed_is_read_as_both_labels_ours(self):
        self.files(9, "migrations/0002.sql")
        self.seed_applied([9], legacy=True)
        self.passes([self.listed(9, self.both())])
        self.assertEqual(len(self.removals(9)), 2)

    def test_after_the_owners_clear_a_record_of_ours_releases_nothing(self):
        self.files(9, "migrations/0002.sql")
        (self.world.state / "impact-hold.json").write_text(json.dumps({
            "clears": {"acme/app#9": {"head": LEDGER_HEAD, "reason": "a false hold", "by": "own", "at": 50}},
            "applied": {"acme/app#9": {"head": LEDGER_HEAD, "merge_label_added": True, "added": self.both(), "at": 10}}}))
        self.passes([self.listed(9, self.both())])   # a person put the labels back after the clear: they are not ours
        self.assertEqual(self.removals(), [])

    def test_the_live_labels_decide_not_the_listed_copy(self):
        self.files(9, "migrations/0002.sql")
        self.seed_applied([9])
        live = {"labels": [{"name": self.names["merge-captain"]}], "headRefOid": LEDGER_HEAD, "files": [{"path": "migrations/0002.sql"}], "changedFiles": 1}
        with mock.patch.object(sb, "read_pr_json", lambda engine, repo, number, extra="": dict(live)):   # the hold label was already taken off by somebody
            self.passes([self.listed(9, self.both())])
        self.assertEqual([w[1].rsplit("/", 1)[-1] for w in self.removals(9)], [urllib.parse.quote(self.names["merge-captain"], safe="")])

    def test_an_independent_hold_that_arrives_before_the_release_keeps_the_hold(self):
        self.files(9, "migrations/0002.sql")
        self.seed_applied([9])
        code, out, err = self.run_as("coder", "review", "record", "acme/app#9", "--reviewer", "impact", "--verdict", "approve", "--impact-action", "hold", "--impact-class", "credentials")
        self.assertEqual(code, 0, err)
        self.passes([self.listed(9, self.both())])
        self.assertEqual(self.removals(), [])

    def test_a_re_apply_adds_to_what_an_earlier_apply_recorded(self):
        self.files(10, "shims/gh")
        self.seed_applied([10], added=[self.names["hold-impact"]])
        self.passes([self.listed(10, [self.names["hold-impact"]])])   # the merge label is missing: the daemon adds only that one
        recorded = json.loads((self.world.state / "impact-hold.json").read_text())["applied"]["acme/app#10"]
        self.assertEqual(sorted(recorded["added"]), sorted(self.both()))

    def test_a_failed_write_backs_off_and_is_tried_again_after_the_wait(self):
        self.files(9, "docs/a.md")
        self.passes([self.listed(9)])
        code, out, err = self.run_as("coder", "review", "record", "acme/app#9", "--reviewer", "impact", "--verdict", "approve", "--impact-action", "hold", "--impact-class", "credentials")
        self.assertEqual(code, 0, err)
        calls = []
        boom = lambda *a, **k: calls.append(1) or (_ for _ in ()).throw(RuntimeError("gh is down"))
        with mock.patch.object(sb, "apply_impact_hold", boom):
            self.passes([self.listed(9)], advance=10)
            self.passes([self.listed(9)], advance=10)
            self.assertEqual(len(calls), 1, "inside the wait: not tried again")
            self.passes([self.listed(9)], advance=sb.IMPACT_RETRY_SECONDS + 10)
        self.assertEqual(len(calls), 2, "after the wait: tried again")

    def test_a_release_spends_its_removals_and_its_read_from_the_pass_budget(self):
        self.extra_config = dict(self.extra_config, impact_hold={"enabled": True, "calls_per_pass": 3})
        self.configure()
        self.files(9, "migrations/0002.sql")
        self.files(10, "migrations/0003.sql")
        self.seed_applied([9, 10])
        records = [self.listed(9, self.both()), self.listed(10, self.both())]
        self.passes(records)
        self.assertEqual(self.view_reads, [9], "1 read + 3 for the release (2 removals and its read) used the budget: the second waits")
        self.passes(records, advance=400)
        self.assertEqual(self.view_reads, [9, 10])

    def test_a_release_decided_a_moment_ago_does_not_outlive_a_hold_that_arrived_since(self):
        self.files(9, "migrations/0002.sql")
        self.seed_applied([9])
        engine = self.world.new_engine("daemon")
        engine.gh_runner, engine.config, engine.state_dir = self.route, sb.load_config(), self.world.state
        report = sb.pr_floor_report(engine, "acme/app", 9)
        self.assertEqual(report["owner_decision"], "second-review")
        code, out, err = self.run_as("coder", "review", "record", "acme/app#9", "--reviewer", "impact", "--verdict", "approve", "--impact-action", "hold", "--impact-class", "credentials")
        self.assertEqual(code, 0, err)
        self.assertEqual(sb.release_impact_hold(engine, "acme/app", 9, report, {"labels": [{"name": n} for n in self.both()]}), 0)
        self.assertEqual(self.removals(), [])

    def released_engine(self):
        self.files(9, "migrations/0002.sql")
        self.seed_applied([9])
        engine = self.world.new_engine("daemon")
        engine.gh_runner, engine.config, engine.state_dir = self.route, sb.load_config(), self.world.state
        return engine, sb.pr_floor_report(engine, "acme/app", 9)

    def test_a_push_since_the_decision_releases_nothing_and_the_same_head_does(self):
        engine, report = self.released_engine()
        self.prs[9]["labels"] = [{"name": n} for n in self.both()]   # the live labels
        self.prs[9]["headRefOid"] = LEDGER_NEW_HEAD          # a push since the decision (no independent hold is recorded)
        self.assertEqual((sb.release_impact_hold(engine, "acme/app", 9, report, {"labels": []}), self.removals()), (0, []))
        self.prs[9]["headRefOid"] = LEDGER_HEAD              # the control: the same call at the judged head removes the labels
        self.assertEqual(sb.release_impact_hold(engine, "acme/app", 9, report, {"labels": []}), 2)
        self.assertEqual(len(self.removals(9)), 2)

    def test_a_live_read_that_fails_inside_the_release_removes_nothing(self):
        engine, report = self.released_engine()
        with mock.patch.object(sb, "read_pr_json", side_effect=sb.NoticeError("gh is down")):
            with self.assertRaises(sb.NoticeError):
                sb.release_impact_hold(engine, "acme/app", 9, report, {"labels": []})
        self.assertEqual(self.removals(), [])
        self.assertIn("acme/app#9", json.loads((self.world.state / "impact-hold.json").read_text())["applied"], "the record stays: the release is tried again")

    def test_the_record_of_ours_is_read_strictly(self):
        names = self.names
        hold, merge = names["hold-impact"], names["merge-captain"]
        state = lambda **applied: {"clears": {}, "applied": {"p": applied}}
        self.assertEqual(sb._labels_ours(names, state(added=["x", hold, "bug"], at=1, head="h"), "p"), [hold], "only the two labels of ours are ever named")
        self.assertEqual(sb._labels_ours(names, state(added="oops", merge_label_added=True), "p"), [hold, merge], "a corrupt list falls back to the older form")
        self.assertEqual(sb._labels_ours(names, state(added="oops"), "p"), [hold])
        self.assertEqual(sb._labels_ours(names, {"clears": {}, "applied": {"p": "x"}}, "p"), [])
        late = {"clears": {"p": {"at": "soon"}}, "applied": {"p": {"added": [hold], "at": 1}}}
        self.assertEqual(sb._labels_ours(names, late, "p"), [], "a clear whose time cannot be read counts as after the record")

    def test_a_label_a_person_added_after_the_list_was_read_is_adopted_because_the_rule_holds_the_pull_request(self):   # #891: this was "never claimed" before adoption
        self.files(10, "shims/gh")
        self.passes([self.listed(10)], live={10: [self.names["merge-captain"]]})   # the list said no labels; by the write the person's merge label is there
        self.assertEqual([w[2]["labels"] for w in self.posts(10)], [[self.names["hold-impact"]]], "only the missing label is added")
        recorded = json.loads((self.world.state / "impact-hold.json").read_text())["applied"]["acme/app#10"]
        self.assertEqual((recorded["added"], recorded["merge_label_added"]), (sorted(self.both()), True), "the person's label is adopted: the rule holds this head")
        self.assertEqual([e["detail"]["label"] for e in self.events("gate.label_adopted")], [self.names["merge-captain"]])
        self.files(10, "docs/a.md")   # the pull request stops holding: the release takes off the daemon's labels, adopted ones included
        self.writes.clear()
        with mock.patch.object(sb.impact_floor, "rule_fingerprint", lambda: "version-two"):
            self.passes([self.listed(10, [self.names["hold-impact"], self.names["merge-captain"]])], advance=400,
                        live={10: [self.names["hold-impact"], self.names["merge-captain"]]})
        self.assertEqual(sorted(w[1].rsplit("/", 1)[-1] for w in self.removals(10)), sorted(urllib.parse.quote(n, safe="") for n in self.both()))

    def test_the_dry_run_and_the_daemon_make_the_same_decisions_over_the_same_pull_requests(self):
        names = self.names
        self.files(9, "migrations/0002.sql")        # no longer holds, labels are ours: released
        self.files(10, "shims/gh")                  # holds, no labels: both added
        self.files(11, "shims/gh")                  # holds, already labelled: nothing
        self.files(12, "migrations/0004.sql")       # a person's merge label, no record of ours: nothing
        self.files(13, "shims/gh")                  # holds but the owner cleared this head: nothing
        self.files(14, "shims/gh")                  # holds but it is a draft: the daemon never judges a draft, so neither does the dry run
        self.prs[14]["isDraft"] = True
        self.prs[9]["labels"] = [{"name": n} for n in self.both()]
        self.prs[11]["labels"] = [{"name": n} for n in self.both()]
        self.prs[12]["labels"] = [{"name": names["merge-captain"]}]
        self.prs[13]["labels"] = []
        path = self.world.state / "impact-hold.json"
        path.write_text(json.dumps({"clears": {"acme/app#13": {"head": LEDGER_HEAD, "reason": "x", "by": "own", "at": 5}},
                                    "applied": {"acme/app#9": {"head": LEDGER_HEAD, "merge_label_added": True, "added": self.both(), "at": 1},
                                                "acme/app#11": {"head": LEDGER_HEAD, "merge_label_added": True, "added": self.both(), "at": 1}}}))
        code, out, err = self.run_as("coder", "impact", "hold", "--dry-run", "--repo", "acme/app")
        self.assertEqual(code, 0, err)
        planned_add, planned_remove = {}, {}
        for line in out.splitlines():
            found = re.match(r"acme/app#(\d+)  would (add|remove) (.+?)(?: \(| {2}|$)", line)
            if found and found.group(2) == "add":
                planned_add[int(found.group(1))] = sorted(x.strip() for x in found.group(3).split(","))
            elif found:
                planned_remove[int(found.group(1))] = sorted(x.strip() for x in found.group(3).split(","))
        self.assertEqual(self.writes, [], "a dry run writes nothing")
        self.passes([self.listed(n, [l["name"] for l in self.prs[n].get("labels", [])], draft=n == 14) for n in (9, 10, 11, 12, 13, 14)])
        done_add = {int(re.search(r"/issues/(\d+)/", w[1]).group(1)): sorted(w[2]["labels"]) for w in self.posts()}
        done_remove = {}
        for w in self.removals():
            done_remove.setdefault(int(re.search(r"/issues/(\d+)/", w[1]).group(1)), []).append(urllib.parse.unquote(w[1].rsplit("/", 1)[-1]))
        done_remove = {k: sorted(v) for k, v in done_remove.items()}
        self.assertEqual((planned_add, planned_remove), (done_add, done_remove), "the dry run says exactly what the daemon did")
        self.assertEqual(sorted(done_add), [10])
        self.assertEqual(sorted(done_remove), [9])
        self.assertIn("1 PR(s) would have a hold released", out)

    def test_a_clear_carried_over_a_pure_merge_of_main_is_cleared_for_the_dry_run_and_the_daemon_alike(self):
        self.extra_config = dict(self.extra_config, impact_hold={"enabled": True, "carry_clear": True})
        self.configure()
        self.files(10, "shims/gh")
        (self.world.state / "impact-hold.json").write_text(json.dumps({
            "clears": {"acme/app#10": {"head": LEDGER_NEW_HEAD, "reason": "x", "by": "own", "at": 5}},
            "carried": {"acme/app#10": {"head": LEDGER_HEAD, "from": LEDGER_NEW_HEAD, "fingerprint": "f", "at": 6}}, "applied": {}}))
        code, out, err = self.run_as("coder", "impact", "hold", "--dry-run", "--repo", "acme/app")
        self.assertEqual(code, 0, err)
        self.assertIn("acme/app#10  cleared by the owner for this head: no label", out)
        self.passes([self.listed(10)])
        self.assertEqual(self.posts(10), [], "the daemon does not label a carried clear either")

    def revoke(self, number):
        code, out, err = self.run_as(None, "impact", "clear", "acme/app#%d" % number, "--revoke", "--reason", "taking the clear back: it was a mistake")
        self.assertEqual(code, 0, err)

    def seed_clear(self, number, clear_at, applied_at=10, legacy=False, applied=True):
        record = {"head": LEDGER_HEAD, "merge_label_added": True}
        if not legacy:
            record.update(added=self.both(), at=applied_at)
        (self.world.state / "impact-hold.json").write_text(json.dumps({
            "clears": {"acme/app#%d" % number: {"head": LEDGER_HEAD, "reason": "x", "by": "own", "at": clear_at}},
            "applied": {"acme/app#%d" % number: record} if applied else {}}))

    def test_a_revoked_clear_leaves_no_stale_record_that_a_release_could_read_as_ours(self):
        self.files(9, "migrations/0002.sql")          # the rule does not hold it: a release pass would run
        self.seed_clear(9, clear_at=50)                # the daemon's record (at 10) is older than the clear (at 50)
        self.revoke(9)
        state = json.loads((self.world.state / "impact-hold.json").read_text())
        self.assertEqual((state["clears"], state["applied"]), ({}, {}), "the stale record went with the revoke, in the same write")
        self.passes([self.listed(9, [self.names["hold-impact"]])])   # a person put the hold label on after the revoke
        self.assertEqual(self.removals(), [], "a person's label is never stripped on the strength of an old record")

    def test_a_legacy_record_and_a_revoke_release_nothing(self):
        self.files(9, "migrations/0002.sql")
        self.seed_clear(9, clear_at=50, legacy=True)
        self.revoke(9)
        self.passes([self.listed(9, self.both())])
        self.assertEqual(self.removals(), [])

    def test_after_a_revoke_the_daemons_own_new_record_releases_only_its_labels(self):
        self.files(9, "shims/gh")                      # holds again after the revoke
        self.seed_clear(9, clear_at=50)
        self.revoke(9)
        self.passes([self.listed(9)])                  # the daemon re-applies: a new record
        self.assertEqual(len(self.posts(9)), 1)
        recorded = json.loads((self.world.state / "impact-hold.json").read_text())["applied"]["acme/app#9"]
        self.assertEqual(sorted(recorded["added"]), sorted(self.both()))
        self.files(9, "docs/a.md")                     # and later it stops holding
        self.writes.clear()
        with mock.patch.object(sb.impact_floor, "rule_fingerprint", lambda: "version-two"):
            self.passes([self.listed(9, self.both() + ["bug"])], advance=400)
        self.assertEqual(sorted(urllib.parse.unquote(w[1].rsplit("/", 1)[-1]) for w in self.removals(9)), sorted(self.both()), "only the daemon's labels, not the person's `bug`")

    def test_the_record_is_consumed_by_a_new_clear_and_kept_when_it_is_newer_than_the_clear(self):
        state = {"clears": {}, "applied": {"p": {"added": ["x"], "at": 10, "head": "h"}}}
        sb._consume_record(state, "p", {"at": 5})
        self.assertIn("p", state["applied"], "applied after the clear: the daemon's")
        sb._consume_record(state, "p", {"at": 10})
        self.assertNotIn("p", state["applied"], "not newer than the clear: consumed")
        state["applied"]["p"] = {"added": ["x"], "at": 99}
        sb._consume_record(state, "p")
        self.assertNotIn("p", state["applied"], "a new clear always consumes it")
        sb._consume_record(state, "gone")

    # -- S4: when it judges again

    def test_s4_a_pull_request_is_judged_again_only_when_its_head_the_rule_or_its_record_changes(self):
        self.files(9, "migrations/0002.sql")
        self.passes([self.listed(9)])
        self.passes([self.listed(9)], advance=400)
        self.assertEqual(self.view_reads, [9], "unchanged: one read")
        with mock.patch.object(sb.impact_floor, "rule_fingerprint", lambda: "another-rule"):
            self.passes([self.listed(9)], advance=400)
        self.assertEqual(self.view_reads, [9, 9], "the rule changed: judged again")

    # -- S5: the posted list

    def test_s5_the_list_is_posted_once_for_a_version_of_the_rule(self):
        self.files(9, "migrations/0002.sql")
        self.files(10, "shims/gh")
        self.files(11, "plugins/fleet-hooks/a.js")
        self.seed_applied([9, 10, 11])
        records = [self.listed(n, self.both()) for n in (9, 10, 11)]
        self.passes(records)
        self.passes(records, advance=400)
        (line,) = self.events("impact.rejudged")
        self.assertEqual((line["detail"]["held"], line["detail"]["released"]), (["acme/app#10", "acme/app#11"], ["acme/app#9"]))
        notes = [r for r in sb.read_reminders(self.world.state) if r["to"] == "boss"]
        self.assertEqual(len(notes), 1)
        self.assertEqual([n for n in ("acme/app#9", "acme/app#10", "acme/app#11") if n in notes[0]["text"]], ["acme/app#9", "acme/app#10", "acme/app#11"])
        with mock.patch.object(sb.impact_floor, "rule_fingerprint", lambda: "version-two"):
            self.passes(records, advance=400)
        self.assertEqual(len(self.events("impact.rejudged")), 2, "a new version of the rule is posted again")

    # -- S6, S6b: an unreadable matrix file

    def test_s6_an_unreadable_matrix_changes_nothing_and_says_so_once_for_the_episode(self):
        self.files(9, "migrations/0002.sql")
        self.files(10, "shims/gh")
        self.seed_applied([9])
        broken = mock.patch.object(sb.impact_floor, "rule_fingerprint", side_effect=sb.impact_floor.MatrixError("the impact matrix file cannot be read (OSError: gone)"))
        wakes = lambda: [r for r in sb.read_reminders(self.world.state) if r["to"] == "boss" and "cannot be read" in r["text"]]
        with broken:
            for _ in range(3):
                self.passes([self.listed(9, self.both()), self.listed(10)], advance=400)
        self.assertEqual((self.writes, len(self.events("impact.error")), len(wakes())), ([], 1, 1))
        self.passes([self.listed(9, self.both()), self.listed(10)], advance=400)   # readable again
        self.assertEqual(len(self.events("impact.recovered")), 1)
        self.writes.clear()
        with broken:
            self.passes([self.listed(9, self.both()), self.listed(10)], advance=400)
        self.assertEqual((len(self.events("impact.error")), len(wakes())), (2, 2), "a new episode: said again")

    def test_s6b_an_unreadable_matrix_removes_no_label_that_the_rule_would_release(self):
        self.files(9, "migrations/0002.sql")
        self.seed_applied([9])
        with mock.patch.object(sb.impact_floor, "rule_fingerprint", side_effect=sb.impact_floor.MatrixError("gone")):
            self.passes([self.listed(9, self.both())])
        self.assertEqual(self.removals(), [])

    def test_a_floor_that_cannot_be_read_in_the_loop_is_the_same_episode(self):
        self.files(9, "migrations/0002.sql")
        with mock.patch.object(sb.impact_floor, "floor_for", side_effect=sb.impact_floor.MatrixError("gone")):
            self.passes([self.listed(9)])
            self.passes([self.listed(9)], advance=400)
        self.assertEqual((self.writes, len(self.events("impact.error"))), ([], 1))

    # -- S7: the class of an independent hold record

    def test_s7_an_independent_hold_labels_only_when_its_class_is_top_tier_or_missing(self):
        for number in (9, 10, 11):
            self.files(number, "docs/a.md")
        self.passes([self.listed(n) for n in (9, 10, 11)])
        self.assertEqual(self.posts(), [])
        reads = len(self.view_reads)
        for number, more in ((9, ("--impact-class", "performance")), (10, ("--impact-class", "credentials")), (11, None)):
            if more is None:   # a record already in the ledger without a class
                sb.plan_ledger.append_entry(self.world.state, {"kind": "review_record", "pr": "acme/app#%d" % number, "head": LEDGER_HEAD, "reviewer": "impact", "verdict": "approve",
                                                               "blocks": 0, "notes": 0, "by": "rev", "impact_action": "hold", "summary": "x"}, 1)
                continue
            code, out, err = self.run_as("coder", "review", "record", "acme/app#%d" % number, "--reviewer", "impact", "--verdict", "approve", "--impact-action", "hold", *more)
            self.assertEqual(code, 0, err)
        self.passes([self.listed(n) for n in (9, 10, 11)], advance=400)
        self.assertEqual(sorted(w[1] for w in self.posts()), ["repos/acme/app/issues/10/labels", "repos/acme/app/issues/11/labels"])
        self.assertEqual(len(self.view_reads), reads, "the record needed no new read")

    # -- S8: the owner's clear

    def test_s8_the_owners_clear_is_for_its_head_only_and_the_rule_does_not_override_it(self):
        self.files(10, "shims/gh")
        (self.world.state / "impact-hold.json").write_text(json.dumps({"clears": {"acme/app#10": {"head": LEDGER_HEAD, "reason": "a false hold", "by": "own", "at": 1}}, "applied": {}}))
        self.passes([self.listed(10)])
        self.assertEqual(self.posts(10), [], "cleared at this head: not labelled again")
        self.files(10, "shims/gh", head=LEDGER_NEW_HEAD)
        self.passes([self.listed(10, head=LEDGER_NEW_HEAD)], advance=400)
        self.assertEqual(len(self.posts(10)), 1, "a new head is held again")

    # -- #891: a hold label put on by hand is the daemon's own once the rule holds the pull request at its head

    ADOPT_HEAD_OTHER = "c" * 40
    ADOPT_ORDER = {"number": 5, "text": "the owner's standing order"}

    def adopt_labels(self):
        """Every hold label the daemon can add or clear, DERIVED from the code: the captain marker and each `hold-*` class (the key sets the clear and the label pass use)."""
        keys = ("merge-captain",) + tuple(sb.CAPTAIN_HOLD_LABELS)
        return [(key, self.names[key]) for key in keys]

    def adopt_state(self, **parts):
        state = {"clears": {}, "applied": {}}
        state.update(parts)
        (self.world.state / "impact-hold.json").write_text(json.dumps(state))

    def fresh_pass(self, records, live=None):
        """One more pass of the REAL daemon that re-judges every pull request (the rule's fingerprint is new, so the pass's own memory of a judged head does not skip it)."""
        self.fresh = getattr(self, "fresh", 0) + 1
        with mock.patch.object(sb.impact_floor, "rule_fingerprint", lambda k=self.fresh: "fresh-%d" % k):
            self.passes(records, advance=400, live=live)

    def adopted(self, number=10):
        return [e["detail"] for e in self.events("gate.label_adopted") if e["subject"] == "acme/app#%d" % number]

    def recorded(self, number=10):
        return sb.read_impact_state(self.world.state)[0]["applied"].get("acme/app#%d" % number)

    def rated_here(self, number=10, head=LEDGER_HEAD):
        sb.plan_ledger.append_entry(self.world.state, {"kind": "review_record", "pr": "acme/app#%d" % number, "head": head, "reviewer": "impact", "verdict": "approve",
                                                       "blocks": 0, "notes": 0, "by": "rev", "by_role": "reviewer", "impact_action": "second-review", "summary": "x"}, 1)

    def run_adopt_case(self, label, case):
        """One (label, case) cell of the table: drive the REAL pass (or the real re-hold function) and return nothing; the assertions are in the cell."""
        n = 10
        captain, impact = self.names["merge-captain"], self.names["hold-impact"]
        wanted_by_floor = label in (captain, impact)
        if case in ("hand_floor_holds", "daemon_present", "absent", "cleared_this_head", "cleared_other_head_floor_holds"):
            self.files(n, "shims/gh")
        else:
            self.files(n, "docs/a.md")
        on_pr = [] if case == "absent" else [label]
        if case == "daemon_present":
            self.adopt_state(applied={"acme/app#%d" % n: {"head": LEDGER_HEAD, "merge_label_added": label == captain, "added": [label], "at": 5}})
        elif case == "cleared_this_head":
            self.adopt_state(clears={"acme/app#%d" % n: {"head": LEDGER_HEAD, "reason": "x", "by": "own", "at": 1, "removed": [label]}})
        elif case in ("cleared_other_head_floor_holds", "hand_rehold_wants_it", "cleared_other_head_rated_here"):
            self.adopt_state(clears={"acme/app#%d" % n: {"head": self.ADOPT_HEAD_OTHER, "reason": "x", "by": "own", "at": 1, "removed": [label]}})
        if case == "cleared_other_head_rated_here":
            self.rated_here(n)
        if case == "hand_rehold_wants_it":
            self.passes([])   # the engine
            self.prs[n]["labels"] = [{"name": l} for l in on_pr]
            report = sb.pr_floor_report(self.engine, "acme/app", n)
            self.assertTrue(sb._impact_rehold_now(self.engine, "acme/app", n, "acme/app#%d" % n, report, {"labels": []}), "the re-hold path holds it again")
        else:
            self.passes([self.listed(n, on_pr)], live={n: on_pr})
        return wanted_by_floor

    def assert_adopt_cell(self, label, case):
        wanted_by_floor = self.run_adopt_case(label, case)
        got, record = self.adopted(), self.recorded()
        if case in ("hand_floor_holds", "cleared_other_head_floor_holds"):
            expected = [label] if wanted_by_floor else []   # `hold-owner` is not a label the rule writes: never adopted
        elif case == "hand_rehold_wants_it":
            expected = [] if label == self.names[sb.OWNER_HOLD_KEY] else [label]   # the owner's own hold is never the daemon's, a re-hold does not restore it
        else:
            expected = []
        self.assertEqual([d["label"] for d in got], expected, "%s / %s" % (label, case))
        self.assertTrue(all(d["head"] == (LEDGER_HEAD) for d in got))
        if expected:
            self.assertIn(label, record["added"], "an adopted label is in the record a daemon-added label is kept in")
            self.assertEqual(record["merge_label_added"], self.names["merge-captain"] in record["added"])
            rehold = case == "hand_rehold_wants_it"   # (#815) the record carries `rehold: True` ONLY when the pass was a re-hold (the sweep reads it); an adoption of any other case does not
            self.assertEqual(sorted(record), ["added", "at", "head", "merge_label_added"] + (["rehold"] if rehold else []), "the record keeps its shape")
            self.assertEqual(record.get("rehold"), True if rehold else None, "the re-hold mark is written for a re-hold and for nothing else")
        elif case in ("not_holds_by_hand", "cleared_this_head", "cleared_other_head_rated_here"):
            self.assertIsNone(record if case != "cleared_this_head" else None, "nothing was written")
        if case in ("hand_floor_holds", "cleared_other_head_floor_holds") and not wanted_by_floor:
            self.assertNotIn(label, [l for w in self.posts(10) for l in w[2]["labels"]], "a class the rule does not write is never written by it")

    def test_a_pull_request_that_moved_since_it_was_judged_gets_nothing_adopted_added_or_restored(self):   # #891 M1: every write below the fresh read is for the judged head only
        n = 10
        self.files(n, "shims/gh")
        self.passes([])
        report = sb.pr_floor_report(self.engine, "acme/app", n)   # judged at LEDGER_HEAD: the rule holds it
        self.assertEqual(report["head"], LEDGER_HEAD)
        cases = {"adopt": (self.both(), None), "add": ([], None), "restore": ([self.names["hold-credential"]], "re-hold")}
        for name, (labels, rehold) in cases.items():
            self.prs[n] = {"headRefOid": LEDGER_NEW_HEAD, "changedFiles": 1, "files": [{"path": "docs/a.md"}], "labels": [{"name": l} for l in labels]}   # moved: the rule no longer holds it
            self.adopt_state(clears={"acme/app#10": {"head": self.ADOPT_HEAD_OTHER, "reason": "x", "by": "own", "at": 1, "removed": [self.names["hold-credential"]]}} if rehold else {})
            self.writes.clear()
            spent = sb.apply_impact_hold(self.engine, "acme/app", n, dict(report, reasons=["x"], **({"rehold": "held again"} if rehold else {})), {})
            self.assertEqual((spent, self.writes, self.recorded(n), self.adopted(n)), (0, [], None, []), name)

    def test_every_consumer_of_the_hold_label_family_is_listed_with_what_it_does_with_the_owners_own_hold(self):   # #891 M2: derived from the code
        import glob
        refs = ("CAPTAIN_HOLD_LABELS", "OWNER_HOLD_KEY", "OTHER_HOLD_KEYS")
        found, uses_owner = {}, {}
        for path in sorted(glob.glob(str(Path(sb.KIT_ROOT) / "bin" / "*.py")) + [str(Path(sb.KIT_ROOT) / "bin" / "fleet-switchboard")]):
            tree = ast.parse(Path(path).read_text())
            for node in ast.walk(tree):
                if isinstance(node, ast.FunctionDef):
                    inside = list(ast.walk(node))
                    names_in = {x.id for x in inside if isinstance(x, ast.Name)} | {x.attr for x in inside if isinstance(x, ast.Attribute)}
                    if names_in & {"CAPTAIN_HOLD_LABELS", "OWNER_HOLD_KEY"} or any(isinstance(x, ast.Constant) and x.value == "hold-" for x in inside):
                        found[node.name] = Path(path).name
                        uses_owner[node.name] = "OWNER_HOLD_KEY" in names_in
        # name: does its code name the owner's hold key (an exclusion or a refusal)? and the reason
        table = {"fleet_labels": (True, "a remover: the merged cleanup never removes it"),
                 "run_pass": (True, "the merged cleanup audits that it merged against it"),
                 "_labels_ours": (True, "the record never lists it as ours"),
                 "_apply_impact_hold_locked": (True, "the rule never writes, restores or adopts it"),
                 "authors_hold_labels": (False, "the owner's plain clear lifts every fleet hold label, it included"),
                 "impact_clear_core": (True, "the delegated clear refuses it; the plain clear lifts it"),
                 "captain_escalation_leaves": (False, "a reader: a pull request carrying it is still held"),
                 "pr_hold_reasons": (False, "a reader: it is a hold reason"),
                 "label_hold_entries": (False, "a reader: it is a decision row"),
                 "sweep_read_repo": (False, "a reader: it is a held pull request"),
                 "sweep_verify": (False, "a reader: a closed unmerged pull request that carries it is still a finding")}
        self.assertEqual(set(found), set(table), "a new consumer of the hold label family must be added to this table with a decision about hold-owner")
        self.assertEqual({k: uses_owner[k] for k in table}, {k: v[0] for k, v in table.items()}, "a remover or an actor names the owner's key; a reader never filters it out")
        self.assertEqual(sb.pr_hold_reasons([{"name": self.names["hold-owner"]}]), ["owner"])
        self.assertIn(self.names["hold-owner"], sb.authors_hold_labels(self.names, {"labels": [self.names["hold-owner"]]}, []))

    ADOPT_CASES = ("hand_floor_holds", "hand_rehold_wants_it", "daemon_present", "absent", "not_holds_by_hand", "cleared_this_head",
                   "cleared_other_head_rated_here", "cleared_other_head_floor_holds")

    def test_the_adoption_table_is_the_labels_the_code_names_by_the_cases_and_every_cell_has_its_test(self):
        labels = [name for _, name in self.adopt_labels()]
        self.assertIn(self.names["hold-owner"], labels, "hold-owner is a member (no count is pinned: a later class is a new row by derivation)")
        from_specs = {self.names[key] for key, _, _ in sb.LABEL_SPECS if key.startswith("hold-")}
        self.assertEqual({n for k, n in self.adopt_labels() if k != "merge-captain"}, from_specs, "the label bootstrap creates exactly the hold classes the table names")
        cc = sb.load_module("chat_clear")
        self.assertEqual(set(cc.HOLD_KEYS + cc.OTHER_HOLD_KEYS), {k for k, _ in self.adopt_labels() if k != "merge-captain"}, "the chat clear names every hold class, offered or not")
        self.assertFalse(cc.is_offerable(self.names, [self.names["hold-impact"], self.names["hold-owner"]]), "a chat clear never offers the owner's own hold")
        self.assertEqual(sorted(labels), sorted(sb.authors_hold_labels(self.names, {"labels": list(self.names.values())}, [])),
                         "the table's labels are the labels the clear classes as the fleet's own holds (one derivation)")
        made = {name[len("test_adoption_cell_"):] for name in dir(type(self)) if name.startswith("test_adoption_cell_")}
        want = {"%s__%s" % (key.replace("-", "_"), case) for key, _ in self.adopt_labels() for case in self.ADOPT_CASES}
        self.assertEqual(made, want, "one test per label and case: a new class or case without one fails here")

    def test_a_hand_label_adopted_is_recorded_audited_once_and_the_delegated_clear_lifts_it(self):
        n = 10
        self.files(n, "shims/gh")
        self.passes([self.listed(n, self.both())], live={n: self.both()})
        self.assertEqual(sorted(d["label"] for d in self.adopted()), sorted(self.both()))
        self.assertEqual(self.posts(n), [], "nothing was written to GitHub: the labels were there")
        self.assertEqual((self.recorded()["added"], self.recorded()["merge_label_added"]), (sorted(self.both()), True))
        lines = sb.impact_clear_core(self.engine, self.route, "acme/app", n, "boss", "a judged false hold", head=LEDGER_HEAD, via="order:5", under_order=self.ADOPT_ORDER)
        self.assertTrue(lines[0].startswith("cleared the impact hold"), lines)
        self.assertEqual(sorted(w[1].rsplit("/", 1)[-1] for w in self.removals(n)), sorted(urllib.parse.quote(l, safe="") for l in self.both()))

    def test_the_owners_own_hold_is_refused_by_the_delegated_clear_whatever_the_score_with_its_own_reason_and_lifted_by_the_owners_plain_clear(self):
        n, owner = 10, self.names["hold-owner"]
        self.files(n, "shims/gh")
        everything = self.both() + [owner]
        self.passes([self.listed(n, everything)], live={n: everything})
        self.assertEqual(sorted(d["label"] for d in self.adopted()), sorted(self.both()), "adopted: the rule's labels, never the owner's own hold")
        self.assertNotIn(owner, self.recorded()["added"])
        for order in (dict(self.ADOPT_ORDER), dict(self.ADOPT_ORDER, threshold="High", score="Low")):
            with self.assertRaises(sb.NoticeError) as raised:
                sb.impact_clear_core(self.engine, self.route, "acme/app", n, "boss", "r", head=LEDGER_HEAD, via="order:5", under_order=order)
            self.assertIn("owner's own hold", str(raised.exception))
        self.assertEqual((self.removals(n), self.events("gate.hold_cleared")), ([], []))
        refused = [e for e in self.events("gate.hold_clear_refused")]
        self.assertEqual([(e["detail"]["owner_hold"], "owner's own hold" in e["detail"]["why"]) for e in refused], [(True, True)] * 2, "its own audited reason")
        sb.impact_clear_core(self.engine, self.route, "acme/app", n, "owner", "r", head=LEDGER_HEAD)   # the owner's PLAIN clear
        self.assertIn(urllib.parse.quote(owner, safe=""), [w[1].rsplit("/", 1)[-1] for w in self.removals(n)])

    def test_a_re_hold_never_puts_the_owners_own_hold_back_and_a_record_that_lists_it_does_not_make_it_ours(self):
        n, owner = 10, self.names["hold-owner"]
        self.files(n, "docs/a.md")
        self.adopt_state(clears={"acme/app#10": {"head": self.ADOPT_HEAD_OTHER, "reason": "x", "by": "own", "at": 1, "removed": [owner, self.names["hold-impact"]]}})
        self.passes([self.listed(n)], live={n: []})
        self.assertEqual([l for w in self.posts(n) for l in w[2]["labels"] if l == owner], [], "not restored")
        names = self.names
        listed = {"clears": {}, "applied": {"p": {"added": [owner, names["hold-impact"]], "at": 1, "head": "h", "merge_label_added": False}}}
        self.assertEqual(sb._labels_ours(names, listed, "p", wide=True), [names["hold-impact"]])

    def test_without_adoption_the_same_hand_label_is_refused_and_a_label_on_a_pull_request_the_rule_does_not_hold_stays_a_persons(self):
        n = 10
        self.files(n, "docs/a.md")   # the rule does not hold this one
        self.passes([self.listed(n, self.both())], live={n: self.both()})
        self.assertEqual((self.adopted(), self.recorded()), ([], None))
        with self.assertRaises(sb.NoticeError) as raised:
            sb.impact_clear_core(self.engine, self.route, "acme/app", n, "boss", "r", head=LEDGER_HEAD, via="order:5", under_order=self.ADOPT_ORDER)
        self.assertIn("a person's own hold", str(raised.exception))
        self.assertEqual(self.removals(n), [])
        self.assertEqual(self.events("gate.hold_cleared"), [])

    def test_adoption_is_once_across_passes_and_a_restart_and_a_clear_and_a_new_head_treat_it_as_the_daemons_own(self):
        n = 10
        self.files(n, "shims/gh")
        for _ in range(3):
            self.fresh_pass([self.listed(n, self.both())], live={n: self.both()})
        self.assertEqual(len(self.adopted()), 2, "2 labels, each audited once over 3 passes")
        del self.engine   # a restart: the engine is new, the state file is all that is left
        self.fresh_pass([self.listed(n, self.both())], live={n: self.both()})
        self.assertEqual(len(self.adopted()), 2, "a restart adopts and audits nothing more")
        sb.impact_clear_core(self.engine, self.route, "acme/app", n, "boss", "r", head=LEDGER_HEAD, via="order:5", under_order=self.ADOPT_ORDER)
        self.assertIsNone(self.recorded(), "a clear consumes the record exactly as for a daemon label")
        self.files(n, "shims/gh", head=LEDGER_NEW_HEAD)
        self.writes.clear()
        self.fresh_pass([self.listed(n, head=LEDGER_NEW_HEAD)], live={n: []})
        self.assertEqual(sorted(l for w in self.posts(n) for l in w[2]["labels"]), sorted(self.both()), "re-applied at the new head")
        self.assertEqual(self.recorded()["head"], LEDGER_NEW_HEAD)
        self.assertEqual(len(self.adopted()), 2, "re-applied labels are the daemon's, never adopted")

    def test_a_cut_label_read_or_a_state_noted_unreadable_adopts_nothing(self):
        n, captain = 10, self.names["merge-captain"]
        self.files(n, "shims/gh")
        self.passes([self.listed(n)], live={n: []})
        for cut in ([{"name": captain}, {"name": None}], [{"name": captain}, {}], [captain, 7]):
            self.adopt_state()
            self.prs[n]["labels"] = cut
            self.fresh_pass([self.listed(n)], live={n: cut})
            self.assertEqual(self.adopted(), [], repr(cut))
            self.assertNotIn(captain, (self.recorded(n) or {}).get("added", []), repr(cut))
        self.prs[n]["labels"] = [{"name": captain}]
        (self.world.state / "impact-hold.json").write_text("{not json")
        self.fresh_pass([self.listed(n)], live={n: [captain]})
        self.assertEqual(self.adopted(), [], "a state noted unreadable in this pass adopts nothing in it")
        report = sb.pr_floor_report(self.engine, "acme/app", n)
        self.adopt_state()
        self.prs[n]["labels"] = None   # the labels field is not a list at all: the apply raises, as before, and nothing is recorded
        with self.assertRaises(Exception):
            sb.apply_impact_hold(self.engine, "acme/app", n, dict(report, reasons=["x"]), {})
        self.assertEqual(self.adopted(), [])

    def test_a_pull_request_of_a_repository_the_daemon_does_not_watch_is_never_adopted_or_written(self):
        self.files(10, "shims/gh")
        self.passes([])
        other = self.listed(11, self.both())
        self.prs[11] = dict(self.prs.get(10), labels=[{"name": l} for l in self.both()])
        self.hub.prs["acme/other"] = [other]   # listed by the hub, but the repository is under neither plan_gates nor impact_floor
        before = len(self.writes)
        sb.ci_record_pass(self.engine, self.t + 400)
        sb.impact_would_hold_pass(self.engine, self.t + 400)
        self.assertEqual((self.adopted(11), len(self.writes) - before), ([], 0))
        self.assertIsNone(sb.read_impact_state(self.world.state)[0]["applied"].get("acme/other#11"))
        self.assertEqual([e for e in self.events("gate.label_adopted") if e["subject"].startswith("acme/other")], [])

    def test_an_adopting_pass_makes_no_extra_gh_call_and_the_dry_run_names_the_adoption(self):
        n = 10
        self.files(n, "shims/gh")
        self.passes([self.listed(n, self.both())], live={n: self.both()})
        self.assertEqual(self.view_reads, [n], "one floor read, as for any judged pull request")
        code, out, err = self.run_as("coder", "impact", "hold", "--dry-run", "--repo", "acme/app")
        self.assertEqual(code, 0, err)
        self.assertIn("already labelled", out, "after the adoption it is recorded: nothing more to adopt")
        del self.engine
        self.adopt_state()
        before = len(self.adopted())
        code, out, err = self.run_as("coder", "impact", "hold", "--dry-run", "--repo", "acme/app")
        self.assertIn("would adopt", out)
        self.assertEqual(len(self.adopted()), before, "the dry run writes and audits nothing")


def _adoption_cells():
    for _key in ("merge-captain",) + tuple(sb.CAPTAIN_HOLD_LABELS):
        for _case in TestImpactRejudge.ADOPT_CASES:
            def cell(self, _key=_key, _case=_case):
                self.assert_adopt_cell(self.names[_key], _case)
            setattr(TestImpactRejudge, "test_adoption_cell_%s__%s" % (_key.replace("-", "_"), _case), cell)


_adoption_cells()


class TestImpactHold(LedgerBase):
    """#179 slice L4: the switchboard WRITES the hold (two labels), only when `impact_hold.enabled`, only for repos under `plan_gates`, head-bound
    owner clear, kill switches, idempotent, bounded. A fake gh records every write."""

    def setUp(self):
        super().setUp()
        top_tier_migrations(self)
        self.writes = []
        self.hold_config = {"enabled": True}
        self.floor_pr()
        self.t = 100000.0
        self.reconfigure()
        self.names = sb.label_names(sb.load_config())

    def reconfigure(self):
        self.extra_config = dict(FLOOR_CONFIG, plan_gates={"repos": {"acme/app": {"mode": "shadow"}}}, impact_hold=self.hold_config)
        self.configure()
        if hasattr(self, "engine_cached"):
            del self.engine_cached

    def floor_pr(self, path="migrations/0002.sql", head=LEDGER_HEAD):
        self.pr.update({"headRefOid": head, "changedFiles": 1, "files": [{"path": path}]})

    def route(self, argv, **kwargs):
        if argv[0] == FAKE_GH and "--method" in argv:
            method = argv[argv.index("--method") + 1]
            if method == "GET" and "/issues?state=open" in argv[2]:                 # the open list, for the dry run
                items = [{"number": 9, "pull_request": {"url": "x"}, "body": "PLAN: acme/app#7", "labels": [], "user": {"login": "shared"}}]
                return subprocess.CompletedProcess(argv, 0, json.dumps(items if "page=1" in argv[2] else []), "")
            if method == "GET":
                return subprocess.CompletedProcess(argv, 0, "{}", "")            # a label that already exists
            self.writes.append((method, argv[2], json.loads(kwargs["input"]) if kwargs.get("input") else None))
            return subprocess.CompletedProcess(argv, 0, "{}", "")
        return super().route(argv, **kwargs)

    def listed(self, head=LEDGER_HEAD, labels=(), number=9, draft=False):
        return {"number": number, "head": {"sha": head}, "body": "PLAN: acme/app#7", "draft": draft, "labels": [{"name": l} for l in labels]}

    def passes(self, records=None, advance=0, hub=None):
        self.t += advance
        if not hasattr(self, "engine_cached"):
            self.hub = hub or FakeHub({"acme/app": records or [self.listed()]})
            engine = self.world.new_engine("daemon")
            engine.hub, engine.gh_runner = self.hub, self.route
            engine.config, engine.state_dir = sb.load_config(), self.world.state
            self.engine_cached = engine
        elif records is not None:
            self.hub.prs["acme/app"] = records
        for item in (records or []):   # the pull request's labels as the daemon's own live read sees them (#451 slice 3)
            self.pr["labels"] = [dict(l) for l in item["labels"]]
        sb.ci_record_pass(self.engine_cached, self.t)
        sb.impact_would_hold_pass(self.engine_cached, self.t)

    def label_writes(self):
        return [w for w in self.writes if w[1].endswith("/labels") and w[0] == "POST"]

    def events(self, name):
        return [e for e in self.world.audit() if e["event"] == name]

    def test_a_floor_path_is_labelled_within_one_pass_with_both_labels_and_the_reason_is_audited(self):
        self.passes()
        (write,) = self.label_writes()
        self.assertEqual(write[1], "repos/acme/app/issues/9/labels")
        self.assertEqual(write[2], {"labels": [self.names["merge-captain"], self.names["hold-impact"]]})
        (applied,) = self.events("gate.hold_applied")
        self.assertEqual((applied["detail"]["floor_paths"], applied["detail"]["labels"]), (["migrations/0002.sql"], write[2]["labels"]))
        self.assertTrue(applied["detail"]["globs"])
        self.assertEqual([w for w in self.writes if w[1].endswith("/comments")], [], "labels only: no comment")
        labelled = {"labels": [{"name": n} for n in write[2]["labels"]], "body": ""}
        self.assertTrue(sb.is_captain(labelled))                                          # the PR now behaves as a held PR

    def test_a_harmless_change_is_not_held_and_a_doc_path_never_is(self):
        self.floor_pr(path="src/app.py")
        self.passes()
        self.floor_pr(path="docs/migrations/x.md")
        self.passes(records=[self.listed(head=LEDGER_NEW_HEAD)], advance=400)
        self.assertEqual(self.writes, [])

    def test_it_is_off_by_default_and_a_per_repo_flag_and_the_global_off_file_stop_the_writes(self):
        for name, edit in (("default", None), ("repo", {"enabled": True, "repos": {"acme/app": {"enabled": False}}}), ("off", "file")):
            with self.subTest(name=name):
                self.writes.clear()
                (self.world.state / "plan-gates.off").unlink(missing_ok=True)
                self.hold_config = edit if isinstance(edit, dict) else {"enabled": True}
                if edit is None:
                    self.hold_config = {}
                if edit == "file":
                    (self.world.state / "plan-gates.off").write_text("")
                self.reconfigure()
                self.passes()
                self.assertEqual(self.writes, [])
        (self.world.state / "plan-gates.off").unlink(missing_ok=True)
        self.assertEqual(sb.impact_floor.hold_mode({}, "acme/app"), "off")

    def test_dry_run_mode_audits_what_it_would_do_and_writes_nothing(self):
        self.hold_config = {"enabled": True, "dry_run": True}
        self.reconfigure()
        self.passes()
        self.assertEqual(self.writes, [])
        (event,) = self.events("gate.would_hold")
        self.assertTrue(event["detail"]["advisory"])
        code, out, err = self.run_as("coder", "impact", "hold", "--dry-run", "--repo", "acme/app")
        self.assertEqual(code, 0, err)
        self.assertIn("acme/app#9  would add", out)
        self.assertIn("1 PR(s) would be held (a dry run: nothing was written", out)
        self.assertEqual(self.writes, [])
        self.assertEqual(self.run_as("coder", "impact", "hold")[0], 2, "by hand only --dry-run exists: the daemon writes")

    def test_it_never_flaps_labels_once_a_moved_head_is_judged_again_and_a_labelled_pr_is_not_written_twice(self):
        for n in range(5):
            self.passes(advance=n * 400)
        self.assertEqual(len(self.label_writes()), 1)
        self.assertEqual([w for w in self.writes if w[0] == "DELETE"], [], "the daemon never removes a label")
        self.floor_pr(head=LEDGER_NEW_HEAD)
        both = [self.names["merge-captain"], self.names["hold-impact"]]
        self.passes(records=[self.listed(head=LEDGER_NEW_HEAD, labels=both)], advance=2000)
        self.assertEqual(len(self.label_writes()), 1, "already labelled: nothing to add")
        self.floor_pr(head="c" * 40)
        self.passes(records=[self.listed(head="c" * 40)], advance=4000)           # labels gone from the fresh PR picture: added again
        self.assertEqual(len(self.label_writes()), 2)

    def test_only_the_missing_label_is_added(self):
        self.passes(records=[self.listed(labels=[self.names["merge-captain"]])])
        (write,) = self.label_writes()
        self.assertEqual(write[2], {"labels": [self.names["hold-impact"]]})
        (applied,) = self.events("gate.hold_applied")
        self.assertEqual(applied["detail"]["labels"], [self.names["hold-impact"]])

    def test_the_owner_clear_is_honoured_for_that_head_only_and_removes_what_the_switchboard_added(self):
        self.passes()
        code, out, err = self.run_as(None, "impact", "clear", self.PR, "--reason", "a false hold: the file is a fixture")
        self.assertEqual(code, 0, err)
        deletes = sorted(w[1].rsplit("/", 1)[1] for w in self.writes if w[0] == "DELETE")
        self.assertEqual(deletes, sorted(n.replace(":", "%3A") for n in (self.names["merge-captain"], self.names["hold-impact"])))
        self.assertEqual(len(self.events("gate.hold_cleared")), 1)
        before = len(self.label_writes())
        self.passes(advance=1000)
        self.passes(records=[self.listed()], advance=4000)
        self.assertEqual(len(self.label_writes()), before, "the same head: not re-added")
        self.floor_pr(head=LEDGER_NEW_HEAD)
        self.passes(records=[self.listed(head=LEDGER_NEW_HEAD)], advance=8000)
        self.assertEqual(len(self.label_writes()), before + 1, "a new head is held again")

    # -- #830: a cleared pull request is held again at a new head

    def cleared_at_a_then_pushed_to_b(self, path="src/app.py"):
        """The owner clears the floor hold at head A; the pull request is then pushed to head B, which no floor path holds and no rating rates. Returns the clear state."""
        self.passes()
        self.assertEqual(self.run_as(None, "impact", "clear", self.PR, "--reason", "a false hold: the file is a fixture")[0], 0)
        self.writes.clear()
        self.floor_pr(path=path, head=LEDGER_NEW_HEAD)
        state = sb.read_impact_state(self.world.state)[0]
        state["clears"][self.PR]["at"] = 1   # the fake world's clock is far in the future of the passes' own: the clear is older than the daemon's later records, as in life
        sb.write_impact_state(self.world.state, state)
        return state["clears"]

    def labelled(self):
        return [self.names["merge-captain"], self.names["hold-impact"]]

    def test_s1_a_clear_at_head_a_and_a_push_to_head_b_is_held_again_once_and_never_a_clear(self):
        before = self.cleared_at_a_then_pushed_to_b()
        self.passes(records=[self.listed(head=LEDGER_NEW_HEAD)], advance=2000)
        (write,) = self.label_writes()
        self.assertEqual(sorted(write[2]["labels"]), sorted(self.labelled()))
        self.passes(records=[self.listed(head=LEDGER_NEW_HEAD, labels=self.labelled())], advance=4000)
        self.passes(records=[self.listed(head=LEDGER_NEW_HEAD, labels=self.labelled())], advance=8000)
        self.assertEqual(len(self.label_writes()), 1, "once")
        (event,) = self.events("gate.hold_reapplied")
        self.assertEqual((event["detail"]["head"], event["detail"]["cleared_head"]), (LEDGER_NEW_HEAD, LEDGER_HEAD))
        self.assertEqual(sb.read_impact_state(self.world.state)[0]["clears"], before, "a hold is never a clear: the owner's record is untouched")
        self.assertEqual(len(self.events("gate.hold_cleared")), 1)
        self.assertEqual([w for w in self.writes if w[0] == "DELETE"], [], "nothing is released")

    def test_the_hold_labels_the_clear_took_off_are_put_back(self):
        self.passes(records=[self.listed(labels=[self.names["hold-credential"]])])
        self.assertEqual(self.run_as(None, "impact", "clear", self.PR, "--reason", "a false hold: the file is a fixture")[0], 0)
        self.writes.clear()
        self.floor_pr(path="src/app.py", head=LEDGER_NEW_HEAD)
        self.passes(records=[self.listed(head=LEDGER_NEW_HEAD)], advance=2000)
        (write,) = self.label_writes()
        self.assertEqual(sorted(write[2]["labels"]), sorted(self.labelled() + [self.names["hold-credential"]]))

    def test_a_clear_at_b_a_rating_at_b_and_a_never_cleared_pull_request_are_not_held_again(self):
        self.cleared_at_a_then_pushed_to_b()
        self.assertEqual(self.run_as(None, "impact", "clear", self.PR, "--reason", "a false hold: the file is a fixture")[0], 0)   # the owner clears head B too
        self.writes.clear()
        self.passes(records=[self.listed(head=LEDGER_NEW_HEAD)], advance=2000)
        self.assertEqual(self.label_writes(), [], "a clear at this head")
        self.assertEqual(self.events("gate.hold_reapplied"), [])

    def test_a_rating_at_the_new_head_recorded_as_not_held_ends_the_hold_again_and_releases_only_what_the_daemon_added(self):
        self.cleared_at_a_then_pushed_to_b()
        self.passes(records=[self.listed(head=LEDGER_NEW_HEAD)], advance=2000)
        self.assertEqual(len(self.label_writes()), 1)
        sb.plan_ledger.append_entry(self.world.state, {"kind": "review_record", "pr": self.PR, "head": LEDGER_NEW_HEAD, "reviewer": "impact", "verdict": "approve",
                                                       "blocks": 0, "notes": 0, "by": "rev", "impact_action": "second-review", "summary": "x"}, 1)
        self.passes(records=[self.listed(head=LEDGER_NEW_HEAD, labels=self.labelled())], advance=4000)
        self.assertEqual(sorted(w[1].rsplit("/", 1)[1] for w in self.writes if w[0] == "DELETE"), sorted(n.replace(":", "%3A") for n in self.labelled()))

    def test_a_pull_request_never_cleared_and_never_rated_is_unchanged(self):
        self.floor_pr(path="src/app.py")
        self.passes()
        self.floor_pr(path="src/app.py", head=LEDGER_NEW_HEAD)
        self.passes(records=[self.listed(head=LEDGER_NEW_HEAD)], advance=2000)
        self.assertEqual(self.writes, [])
        self.assertEqual(self.events("gate.hold_reapplied"), [])

    HELD_BODY = ("PLAN: acme/app#7\nMERGE: captain\ncanon: n/a internal rule\n\n## Why this needs you\nThis changes the hold rule, so it holds for you.\n\n"
                 "## What changes for you\n| Before | After |\n|---|---|\n| the hold lapsed at a new head | the hold stands at a new head |\n| a clear stood anywhere | a clear stands for its head |\n\n"
                 "## Example\nYou clear head one; a new commit lands; the labels come back.\n\n## Questions for you\n1. Is this wanted? Recommendation: yes.\n")

    def rating_record(self, kind):
        """The impact reviewer's record at head B: none, one with NO action, or one with an action that is not a hold."""
        if kind == "none":
            return
        entry = {"kind": "review_record", "pr": self.PR, "head": LEDGER_NEW_HEAD, "reviewer": "impact", "verdict": "approve", "blocks": 0, "notes": 0, "by": "rev", "summary": "x"}
        if kind == "with action":
            entry["impact_action"] = "second-review"
        sb.plan_ledger.append_entry(self.world.state, entry, 1)

    def readers(self, engine):
        """Every reader of "is this pull request held at head B", one callable each returning True when it reads HELD. Derived from the code by `test_the_reader_table_is_complete`."""
        def label_pass():
            self.pr["labels"] = []
            self.writes.clear()
            self.passes(records=[self.listed(head=LEDGER_NEW_HEAD)], advance=3000)
            return bool(self.label_writes())

        def release():
            state = sb.read_impact_state(self.world.state)[0]
            state["applied"][self.PR] = {"head": LEDGER_NEW_HEAD, "merge_label_added": True, "added": self.labelled(), "at": 2}
            sb.write_impact_state(self.world.state, state)
            self.pr["labels"] = [{"name": n} for n in self.labelled()]
            self.writes.clear()
            sb.release_impact_hold(engine, "acme/app", 9, sb.pr_floor_report(engine, "acme/app", 9), {})
            return not [w for w in self.writes if w[0] == "DELETE"]

        def gate(row):
            self.pr["labels"] = []
            self.pr["body"] = "PLAN: acme/app#7\n"
            return self.row(self.gates()[1], row)

        state = lambda: sb.read_impact_state(self.world.state)[0]
        return {
            "rehold_reason": lambda: bool(sb.rehold_reason(engine, state(), "acme/app", self.PR, LEDGER_NEW_HEAD)),
            "gate_floor_fact": lambda: bool(sb.gate_floor_fact(engine, self.world.state, "acme/app", 9, LEDGER_NEW_HEAD)["rehold"]),
            "impact_plan": lambda: sb.impact_plan(engine, sb.pr_floor_report(engine, "acme/app", 9), [], state(), {}, None)[0] in ("add", "held"),
            "release_impact_hold": release,
            "_impact_rehold_now": label_pass,
            "G6": lambda: gate("G6")["status"] == "waiting",
            "G6b": lambda: gate("G6b")["status"] != "n/a",
        }

    def test_every_reader_of_is_it_held_agrees_for_every_rating_state_at_head_b(self):
        for rating, held in (("none", True), ("no action", True), ("with action", False)):
            with self.subTest(rating=rating):
                self.setUp()
                self.cleared_at_a_then_pushed_to_b()
                self.rating_record(rating)
                engine = self.world.new_engine("daemon")
                engine.config, engine.state_dir, engine.gh_runner = sb.load_config(), self.world.state, self.route
                before = sb.read_impact_state(self.world.state)[0]["clears"]
                for name, reader in self.readers(engine).items():
                    with self.subTest(reader=name):
                        self.assertEqual(reader(), held, "%s reads %s for a rating state of %r" % (name, "held" if not held else "not held", rating))
                self.assertEqual(sb.read_impact_state(self.world.state)[0]["clears"], before, "no reader records a clear")

    def test_the_reader_table_is_complete(self):
        """The readers are DERIVED from the code: every function that calls `rehold_reason` (the one rule) is in the table, and the table holds nothing else but the two gate rows."""
        import ast
        callers = set()
        for path in (BIN / "fleet-switchboard", BIN / "impact_hold.py"):
            for node in ast.parse(path.read_text()).body:
                if isinstance(node, ast.FunctionDef) and any(isinstance(x, ast.Call) and getattr(x.func, "id", "") == "rehold_reason" for x in ast.walk(node)):
                    callers.add(node.name)
        engine = self.world.new_engine("daemon")
        self.assertEqual(callers, set(self.readers(engine)) - {"rehold_reason", "G6", "G6b"})
        plan_code = (BIN / "plan_ledger.py").read_text()
        self.assertEqual(plan_code.count('floor.get("rehold")'), 2, "G6 and G6b each read the gate fact's re-hold")

    def test_a_held_again_pull_request_must_still_explain_itself_in_gate_g6b(self):
        self.cleared_at_a_then_pushed_to_b()
        self.pr["labels"] = []
        self.pr["body"] = "PLAN: acme/app#7\n"
        row = self.row(self.gates()[1], "G6b")
        self.assertEqual(row["status"], "missing", "held again by the rule alone: the v2 body is checked")
        self.pr["body"] = self.HELD_BODY
        self.assertEqual(self.row(self.gates()[1], "G6b")["status"], "ok")

    def test_the_ledger_cannot_be_read_changes_nothing_and_the_gate_holds(self):
        self.cleared_at_a_then_pushed_to_b()
        engine = self.world.new_engine("daemon")
        engine.config, engine.state_dir, engine.gh_runner = sb.load_config(), self.world.state, self.route
        with mock.patch.object(sb.plan_ledger, "read_ledger", return_value=([], "the ledger is not valid JSON")):
            self.assertFalse(sb._impact_rehold_now(engine, "acme/app", 9, self.PR, {"head": LEDGER_NEW_HEAD}, {}), "no change from the pass")
            self.assertEqual(self.writes, [])
            self.assertTrue(sb.rehold_reason(engine, sb.read_impact_state(self.world.state)[0], "acme/app", self.PR, LEDGER_NEW_HEAD), "an unknown rating holds")

    def test_only_the_fleets_own_hold_labels_the_clear_removed_are_put_back_and_a_failed_write_backs_off(self):
        self.cleared_at_a_then_pushed_to_b()
        state = sb.read_impact_state(self.world.state)[0]
        state["clears"][self.PR]["removed"] = [self.names["hold-credential"], "bug", "other:hold-policy"]
        sb.write_impact_state(self.world.state, state)
        self.passes(records=[self.listed(head=LEDGER_NEW_HEAD)], advance=2000)
        (write,) = self.label_writes()
        self.assertEqual(sorted(write[2]["labels"]), sorted(self.labelled() + [self.names["hold-credential"]]), "a foreign label is never added")
        self.writes.clear()
        with mock.patch.object(sb, "change_issue_labels", side_effect=RuntimeError("gh: down")):
            self.floor_pr(path="src/app.py", head="c" * 40)   # a third head: judged afresh
            self.passes(records=[self.listed(head="c" * 40)], advance=4000)
        self.assertTrue(self.events("impact.error"), "a failed write is said and retried, never marked done")
        self.writes.clear()
        self.passes(records=[self.listed(head="c" * 40)], advance=10)   # inside the back-off: nothing is tried
        self.assertEqual(self.label_writes(), [])
        self.passes(records=[self.listed(head="c" * 40)], advance=2 * sb.IMPACT_RETRY_SECONDS)   # after it: the write is retried and lands
        self.assertEqual(len(self.label_writes()), 1)

    def test_not_whole_input_changes_nothing_and_an_unreadable_head_is_held(self):
        self.cleared_at_a_then_pushed_to_b()
        engine = self.world.new_engine("daemon")
        engine.config, engine.state_dir, engine.gh_runner = sb.load_config(), self.world.state, self.route
        state = sb.read_impact_state(self.world.state)[0]
        self.assertTrue(sb.rehold_reason(engine, state, "acme/app", self.PR, None), "an unreadable head is held")
        self.assertIsNone(sb.rehold_reason(engine, {"clears": {}, "applied": {}}, "acme/app", self.PR, None), "no recorded clear: this rule holds nothing")
        (self.world.state / "impact-hold.json").write_text("{not json")   # a corrupt state: no change from the re-hold, never a clear
        self.assertFalse(sb._impact_rehold_now(engine, "acme/app", 9, self.PR, {"head": LEDGER_NEW_HEAD}, {}))
        self.assertEqual(self.writes, [])

