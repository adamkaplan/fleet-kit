    def test_s6_not_enabled_in_three_shapes_is_refused(self):
        for label, value in (("no key", None), ("empty list", {"orders": [], "charter": 40}), ("false", False)):
            self.extra_config.pop("delegated_clear", None)
            if value is not None:
                self.extra_config["delegated_clear"] = value
            self.delegate(config=False)
            self.files_of_pr("migrations/0002.sql")
            self.passes()
            code, out, err = self.under()
            self.assertEqual(code, 2, label)
            self.assertIn("not enabled", err, label)
            self.assertEqual([w for w in self.writes if w[0] == "DELETE"], [], label)
        module = sb.load_module("delegated_clear")
        for malformed in ("yes", {"orders": "17", "charter": 40}, {"orders": [17], "charter": 40}, {"orders": [{"number": 17}], "charter": 40}, {"orders": [{"number": 17, "sha256": "zz"}], "charter": 40},
                          {"orders": [{"number": True, "sha256": "a" * 64}], "charter": 40}, {"orders": [{"number": 17, "sha256": "a" * 64}], "charter": 0}, 5):
            self.assertIsNone(module.settings({"delegated_clear": malformed}), malformed)
            if malformed != 5:
                with self.assertRaises(ValueError):
                    module.validate(malformed, "config")

