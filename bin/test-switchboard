        self.assertEqual(code, 0, err)
        self.assertIn("acme/app#9", out)
        self.assertIn("1 record(s) (1 by agents, 0 automatic): coder 1", out)
        code, out, err = self.run_as("coder", "gates", "stats", "--json")
        self.assertEqual(json.loads(out)["prs"][0]["pr"], "acme/app#9")
        self.pr.update({"state": "OPEN", "mergedAt": None})
        self.assertIn("1 gated PR(s) not merged yet", self.run_as("coder", "gates", "stats")[1])

    def test_a_failing_proof_or_verdict_is_not_ready(self):
