    def test_when_the_process_list_cannot_be_read_every_candidate_is_kept(self):
        victim = self.old("old-victim.txt")
        for code_, text in ((2, ""), (1, "")):
            self.lsof_code, self.lsof = code_, text
            code, out, err = self.run_cli("--apply")
            self.assertTrue(victim.exists(), code_)
            self.assertIn("cannot say whether anything is using it", out)
        for failure in (OSError("no lsof"), subprocess.TimeoutExpired(["lsof"], 30)):
            def boom(argv, **kwargs):
                if argv[0] == "lsof":
                    raise failure
                return self.world.route(argv, **kwargs)
            with captured() as (out, err):
                sb.main(["disk", "janitor", "--apply", "--i-reviewed", self.fingerprint_of(boom)], runner=boom, now=self.world.clock.now, socket_call=self.world.herdr.socket)
            self.assertTrue(victim.exists())
            self.assertIn("lsof did not run", out.getvalue())

    def test_a_process_list_past_its_cap_keeps_every_candidate(self):
