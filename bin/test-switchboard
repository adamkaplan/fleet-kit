    "toast": {"agent": "coder", "text": "held", "count": 1},
    "repo_watch": {"repo": "acme/web", "how": "polling"},  # PR 15
    "repo_membership": {"repo": "acme/web", "joined": True, "left": False},
    "status_says": {"text": "polling every"},
    "config_says": {"at": "90s", "text": "INVALID"},  # PR 16
    "launch_refused": {"agent": "coder", "text": "Acme Web"},
    "tool_outcome": {"agent": "coder", "tool": "shell", "outcome": "completed"},
    "judged": {"agent": "cos", "question": "Does it say plainly that the work failed?", "threshold": 0.8},
    "status_is": {"agent": "coder", "status": ["working", "blocked"], "at": "5s"},
    "metadata_roundtrip": {"agent": "coder", "of": "message", "text": "status?", "fleet": None},
    "pane_runs_v2": {"agent": "coder"},
    "no_typing": {"agent": "coder"},
    "message_shows": {"to": "platform", "text": "no intent recorded"},  # PR 6
    "intent_gap": {"issue": 2},
    "decisions": {"at": "30s", "count": 1, "text": "Which database?"},  # PR 14
    "decisions_say": {"at": "30s", "text": "not updating"},
    "status_first_line": {"text": "No decision-model key"},  # PR 16
    "bootstrap_says": {"step": 1, "text": "already runs"},
    "fleet_sessions": {"agent": "coder", "count": 1},
    "orders_on_github": {"charter": 1, "count": 1, "text": "approve deploys"},  # PR 17
    "orders_refused": {"agent": "coder", "count": 1},
}


class TestScenarioValidator(unittest.TestCase):
    def test_the_full_fixture_is_valid(self):
        self.assertEqual(sc.validate(copy.deepcopy(VALID)), [])

    def test_valid_alternatives(self):
        alternatives = [
            _set(["problem"], None),
            _set(["control"], {"baseline": "fleet-heartbeat", "fails": ["no_machine_turn"]}),
            _set(["control"], {"variant": {"steps": {"1": {"text": "x"}}, "expect": {"one-note": {"count": 2}}},
                               "fails": ["one-note"]}),
            _set(["steps"], []),
            _drop(["issues"]),
            _drop(["tags"]),
            _set(["tiers"], ["lab-model"]),
            _set(["tags"], ["spike"]),
        ]
        for change in alternatives:
            obj = mutate(change)
            with self.subTest(obj={k: obj.get(k) for k in ("problem", "control", "steps", "tiers")}):
                self.assertEqual(sc.validate(obj), [])

    def test_each_rule_rejects_its_fixture(self):
        for what, change, needle in REJECTED:
            with self.subTest(what=what):
                errors = sc.validate(mutate(change))
                self.assertTrue(errors, "accepted: %s" % what)
                self.assertTrue(any(needle in e for e in errors), "%s: %s" % (what, errors))

    def test_every_required_key_is_required(self):
        for key in sc.REQUIRED:
            with self.subTest(key=key):
                self.assertIn("%s: required" % key, sc.validate(mutate(_drop([key]))))

    def test_not_an_object(self):
        self.assertEqual(sc.validate([VALID]), ["scenario: must be a JSON object"])

    def test_every_documented_value_is_accepted(self):
        for do in sc.ACTIONS:
            for actor in sc.STEP_ACTORS[do]:
                step = {"at": "0s", "actor": "coder" if actor == "cast" else actor, "do": do, "why": "a comment"}
                step.update(STEP_EXAMPLES[do])
                if do == "permission" and actor == "cast":
                    step = {k: v for k, v in step.items() if k not in ("to", "decision")}
                self.assertEqual(sc.validate(mutate(_set(["steps", 0], step))), [], (do, actor))
        for that in sc.EXPECTATIONS:
            item = {"that": that, "why": "a comment"}
            item.update(EXPECT_EXAMPLES[that])
            self.assertEqual(sc.validate(mutate(_set(["expect", 2], item))), [], that)
        for name in DOC_FAULTS:
            self.assertEqual(sc.validate(mutate(_set(["control", "fault"], name))), [], name)

    def test_every_field_checked_kind_has_an_example(self):
        self.assertEqual(sorted(STEP_EXAMPLES), sorted(sc.STEP_FIELDS))
        self.assertEqual(sorted(EXPECT_EXAMPLES), sorted(sc.EXPECT_FIELDS))

    def test_every_tier_is_checked_field_by_field(self):
        # One vocabulary: a Lab-only scenario has no fields of its own.
        for tiers in (["offline"], ["lab-scripted"], ["lab-model"]):
            with self.subTest(tiers=tiers):
                errors = sc.validate(mutate(lambda o: (o.update(tiers=tiers),
                                                       o["steps"][0].update(script="sleep=5 reply=DONE"),
                                                       o["expect"][0].update(role="user"))))
                self.assertTrue(any("unknown field 'script'" in e for e in errors), errors)
                self.assertTrue(any("unknown field 'role'" in e for e in errors), errors)

    def test_a_variant_is_patched_in_and_the_result_checked(self):
        patched = sc.apply_variant(VALID, {"steps": {"1": {"text": "x"}}, "expect": {"one-note": {"count": 2},
                                                                                   "1": {"why": "w"}}})
        self.assertEqual((patched["steps"][1]["text"], patched["expect"][0]["count"], patched["expect"][1]["why"]),
                         ("x", 2, "w"))
        self.assertEqual(VALID["steps"][1]["text"], "status?", "the scenario itself is not changed")
        for variant, needle in (({"cast": {}}, "unknown key"), ({"steps": {"9": {"text": "x"}}}, "not the index"),
                                ({"steps": {"one": {"text": "x"}}}, "not the index"),
                                ({"expect": {"nobody": {"count": 2}}}, "matches no expectation"),
                                ({"steps": {"1": {}}}, "non-empty object"), ("x", "must be an object")):
            with self.subTest(variant=variant):
                with self.assertRaises(sc.VariantError) as caught:
                    sc.apply_variant(VALID, variant)
                self.assertIn(needle, str(caught.exception))

    def test_durations(self):
        self.assertEqual([sc.duration_seconds(t) for t in ("0s", "10s", "2m", "2h", "150s")],
                         [0, 10, 120, 7200, 150])
        for bad in ("", "1.5s", "-1s", "1 s", "1d", None, 3):
            self.assertIsNone(sc.duration_seconds(bad), bad)


class TestScenarioFiles(Base):
    def put(self, name, obj, directory=None):
        directory = directory or self.home / "scenarios"
        directory.mkdir(parents=True, exist_ok=True)
        path = directory / name
        path.write_text(obj if isinstance(obj, str) else json.dumps(obj))
        return path

    def test_load_and_load_dir(self):
        self.put("n1.json", VALID)
        self.put("w1.json", mutate(_set(["id"], "W1")))
        self.put("README.md", "not a scenario")
        self.assertEqual(sc.load(self.home / "scenarios" / "n1.json")["id"], "N1")
        self.assertEqual([s["id"] for s in sc.load_dir(self.home / "scenarios")], ["N1", "W1"])
        self.put("x1.json", mutate(_set(["id"], "x")))
        with self.assertRaises(sc.ScenarioError) as caught:
            sc.load_dir(self.home / "scenarios")
        self.assertIn("x1.json", str(caught.exception))

    def test_load_dir_refuses_a_repeated_id(self):
        self.put("a.json", VALID)
        self.put("b.json", VALID)
        with self.assertRaises(sc.ScenarioError):
            sc.load_dir(self.home / "scenarios")

    def test_load_refuses_bad_json(self):
        with self.assertRaises(sc.ScenarioError):
            sc.load(self.put("bad.json", "{"))

    def test_coverage_lists_every_problem(self):
        scenarios = [mutate(_set(["id"], "A%d" % n)) for n in range(3)]
        scenarios[1]["problem"] = 1
        scenarios[2]["problem"] = None
        self.assertEqual(sc.coverage(scenarios), {1: ["A1"], 2: [], 3: ["A0"], 4: []})

    def test_validate_cli_exit_codes(self):
        good = self.put("n1.json", VALID)
        self.assertEqual(self.run_cli(SCENARIO, "validate", str(good)).returncode, 0)
        self.assertEqual(self.run_cli(SCENARIO, "validate", str(good.parent)).returncode, 0)
        bad = self.put("bad.json", mutate(_set(["since_pr"], 0)), self.home / "bad")
        proc = self.run_cli(SCENARIO, "validate", str(bad))
        self.assertEqual(proc.returncode, 1)
        self.assertIn("since_pr", proc.stderr)
        self.assertNotIn("Traceback", proc.stderr)
        self.assertEqual(self.run_cli(SCENARIO, "validate", str(self.put("j.json", "{", self.home / "j"))).returncode, 1)
        self.assertEqual(self.run_cli(SCENARIO, "validate", str(self.home / "missing.json")).returncode, 1)
        empty = self.home / "empty"
        empty.mkdir()
        self.assertEqual(self.run_cli(SCENARIO, "validate", str(empty)).returncode, 0)
        self.assertEqual(self.run_cli(SCENARIO, "frobnicate").returncode, 2)

    def test_validate_cli_refuses_a_repeated_id_across_files(self):
        self.put("a.json", VALID, self.home / "dup")
        self.put("b.json", VALID, self.home / "dup")
        proc = self.run_cli(SCENARIO, "validate", str(self.home / "dup"))
        self.assertEqual(proc.returncode, 1)
        self.assertIn("also used by", proc.stderr)

    def test_validate_cli_defaults_to_the_repo_scenarios(self):
        proc = self.run_cli(SCENARIO, "validate")
        self.assertEqual(proc.returncode, 0, proc.stdout + proc.stderr)
        self.assertEqual(sc.DEFAULT_DIR, REPO / "scenarios" / "switchboard")

    def test_list_and_coverage_cli(self):
        directory = self.home / "scenarios"
        for n, problem in enumerate((1, 2, 3)):
            self.put("a%d.json" % n, mutate(lambda o, n=n, p=problem: (o.update(id="A%d" % n, problem=p))))
        listing = self.run_cli(SCENARIO, "list", "--dir", str(directory))
        self.assertEqual(listing.returncode, 0)
        self.assertIn("A2", listing.stdout)
        self.assertEqual(self.run_cli(SCENARIO, "coverage", "--dir", str(directory)).returncode, 0)
        enforced = self.run_cli(SCENARIO, "coverage", "--enforce", "--dir", str(directory))
        self.assertEqual(enforced.returncode, 1)
        self.assertIn("problem(s) 4", enforced.stderr)
        self.put("a3.json", mutate(lambda o: o.update(id="A3", problem=4)))
        self.assertEqual(self.run_cli(SCENARIO, "coverage", "--enforce", "--dir", str(directory)).returncode, 0)
        self.put("bad.json", "{")
        self.assertEqual(self.run_cli(SCENARIO, "list", "--dir", str(directory)).returncode, 1)


# --------------------------------------------------------------------- the CLI

def routed(v2=(0, '{"data": {"version": "2.0.22"}}', ""), herdr=(0, '{"result": {"agents": [{}, {}]}}', "")):
    """A runner that answers the configured v2 binary and herdr differently."""
    def route(argv):
        return v2 if argv[1:2] == ["api"] else herdr
    return FakeRunner(route=route)


class TestStatus(Base):
    def status(self, runner, *argv):
        with captured() as (out, err):
            code = sb.main(["status", *argv], runner=runner)
        return code, out.getvalue(), err.getvalue()

    def test_all_ok(self):
        self.write_config({"opencode": "/opt/lab/bin/opencode", "herdr": "/opt/herdr"})
        runner = routed()
        code, out, err = self.status(runner)
        self.assertEqual(code, 0, out)
        self.assertIn("version 2.0.22", out)
        self.assertIn("2 agent(s)", out)
        self.assertEqual(err, "")
        self.assertEqual([argv for argv, _ in runner.calls],
                         [["/opt/lab/bin/opencode", "api", "server.info"], ["/opt/herdr", "agent", "list"],
                          ["/opt/herdr", "plugin", "list"]])  # PR 16: whether herdr lists the plugin; read-only
        self.assertEqual(stat.S_IMODE(self.state_dir.stat().st_mode), 0o700)

    def test_an_unknown_config_key_is_shown_with_the_nearest_known_key(self):
        self.write_config({"opencode": "/opt/lab/bin/opencode", "herdr": "/opt/herdr", "batch_secs": 5, "policy": {"budgetms": 5}, "zzz_unrelated": 1})
        code, out, err = self.status(routed())
        self.assertEqual(code, 0, out)
        self.assertRegex(out, r"(?m)^WARN  config +batch_secs is not read by this tool \(did you mean batch_seconds\?\)$")
        self.assertRegex(out, r"(?m)^WARN  config +policy\.budgetms is not read by this tool \(did you mean budget_ms\?\)$")
        self.assertRegex(out, r"(?m)^WARN  config +zzz_unrelated is not read by this tool$")   # nothing close: no guess
        self.assertEqual(out.count("WARN  config"), 3)
        self.assertIn("batch_secs", err)   # and still on stderr

    def test_a_clean_config_shows_no_warning_even_after_an_earlier_load_saw_one(self):
        sb.warn_unknown_config("x", "", ["leftover"], ["opencode"])
        self.write_config({"opencode": "/opt/lab/bin/opencode", "herdr": "/opt/herdr"})
        code, out, err = self.status(routed())
        self.assertNotIn("WARN  config", out)

    def test_unconfigured_v2_is_reported_and_never_run(self):
        # A bare name would be resolved through PATH, which can find OpenCode v1.
        runner = routed()
        code, out, _ = self.status(runner)
        self.assertEqual(code, 1)
        self.assertRegex(out, r"(?m)^ERROR v2 +not configured: ")
        self.assertEqual([argv for argv, _ in runner.calls], [["herdr", "agent", "list"], ["herdr", "plugin", "list"]])
        self.assertNotIn("api", [argv[1] for argv, _ in runner.calls], "v2 is never run when it is not configured")

    def test_failures_are_one_line_each_and_exit_1(self):
        self.write_config({"opencode": "/opt/lab/bin/opencode"})
        runner = routed(v2=(1, '{"name":"ServiceUnavailable"}', "HTTP 503 Service Unavailable\n"),
                        herdr=FileNotFoundError(2, "No such file or directory"))
        code, out, err = self.status(runner)
        self.assertEqual(code, 1)
        self.assertRegex(out, r"(?m)^ERROR v2 +http 503: ")
        self.assertRegex(out, r"(?m)^ERROR herdr +unavailable: ")
        self.assertNotIn("Traceback", out + err)

    def test_json_report(self):
        self.write_config({"opencode": "/opt/lab/bin/opencode"})
        runner = routed(v2=subprocess.TimeoutExpired(["opencode"], 20), herdr=(0, "garbage", ""))
        code, out, _ = self.status(runner, "--json")
        self.assertEqual(code, 1)
        report = json.loads(out)
        self.assertFalse(report["ok"])
        self.assertIn("timeout", report["v2"]["error"])
        self.assertIn("bad_json", report["herdr"]["error"])
        self.assertTrue(report["config"]["ok"])
        self.assertTrue(report["state_dir"]["ok"])

    def test_an_unexpected_exception_is_still_one_line(self):
        self.write_config({"opencode": "/opt/lab/bin/opencode"})
        runner = routed(v2=RuntimeError("boom"))
        code, out, err = self.status(runner)
        self.assertEqual(code, 1)
        self.assertIn("unexpected RuntimeError: boom", out)
        self.assertNotIn("Traceback", out + err)

    def test_bad_config_skips_the_probes_and_says_why(self):
        self.write_config({"batch_seconds": "soon"})
        runner = routed()
        code, out, _ = self.status(runner)
        self.assertEqual(code, 1)
        self.assertIn("batch_seconds", out)
        self.assertIn("not checked: config unusable", out)
        self.assertEqual(runner.calls, [])

    def test_open_state_dir_and_bad_fault_are_reported(self):
        self.state_dir.mkdir(parents=True)
        os.chmod(str(self.state_dir), 0o755)
        os.environ[sb.FAULT_ENV] = "no-such-fault"
        code, out, _ = self.status(routed())
        self.assertEqual(code, 1)
        self.assertRegex(out, r"(?m)^ERROR state +state directory must be private")
        self.assertRegex(out, r"(?m)^ERROR lab +.*no-such-fault")

    def test_env_values_are_never_printed(self):
        self.write_config({"opencode_env": {"OPENCODE_SERVER_PASSWORD": "pw-value-123"}})
        for argv in ((), ("--json",)):
            _, out, err = self.status(routed(), *argv)
            self.assertNotIn("pw-value-123", out + err)
            self.assertIn("OPENCODE_SERVER_PASSWORD", out)

    def test_lab_faults_are_shown(self):
        self.write_config({"opencode": "/opt/lab/bin/opencode"})
        os.environ[sb.LAB_ENV] = "1"
        os.environ[sb.FAULT_ENV] = "no-batch"
        code, out, _ = self.status(routed())
        self.assertEqual(code, 0)
        self.assertIn("faults requested: no-batch", out)

    def test_real_process_with_failing_fakes_prints_no_traceback(self):
        opencode = self.fake_bin("opencode", "echo '{\"name\":\"Down\"}'\necho 'HTTP 502 Bad Gateway' >&2\nexit 1\n")
        herdr = self.fake_bin("herdr", "echo 'not json'\n")
        self.write_config({"opencode": str(opencode), "herdr": str(herdr), "call_timeout_seconds": 5})
        proc = self.run_cli(SWITCHBOARD, "status")
        self.assertEqual(proc.returncode, 1, proc.stdout + proc.stderr)
        self.assertRegex(proc.stdout, r"(?m)^ERROR v2 +http 502")
        self.assertRegex(proc.stdout, r"(?m)^ERROR herdr +bad_json")
        self.assertNotIn("Traceback", proc.stdout + proc.stderr)
        missing = self.home / "absent-binary"
        self.write_config({"opencode": str(missing), "herdr": str(missing)})
        proc = self.run_cli(SWITCHBOARD, "status", "--json")
        self.assertEqual(proc.returncode, 1)
        self.assertEqual(json.loads(proc.stdout)["v2"]["ok"], False)
        self.assertNotIn("Traceback", proc.stdout + proc.stderr)

    def test_real_process_with_working_fakes(self):
        opencode = self.fake_bin("opencode", "echo '{\"data\":{\"version\":\"2.0.22\"}}'\n")
        herdr = self.fake_bin("herdr", "echo '{\"result\":{\"agents\":[]}}'\n")
        self.write_config({"opencode": str(opencode), "herdr": str(herdr)})
        proc = self.run_cli(SWITCHBOARD, "status")
        self.assertEqual(proc.returncode, 0, proc.stdout + proc.stderr)

    def test_version_and_usage_exit_codes(self):
        proc = self.run_cli(SWITCHBOARD, "version")
        self.assertEqual(proc.returncode, 0)
        self.assertEqual(proc.stdout.strip(), "fleet-switchboard %s" % sb.VERSION)
        self.assertEqual(self.run_cli(SWITCHBOARD).returncode, 2)
        self.assertEqual(self.run_cli(SWITCHBOARD, "deliver").returncode, 2)
        self.assertEqual(self.run_cli(SWITCHBOARD, "status", "--bogus").returncode, 2)


# ------------------------------------------------- stateful fakes of v2 and herdr

EPOCH = 1800000000.0  # where every simulated clock starts
FAKE_OPENCODE = "/fake/bin/opencode"
FAKE_HERDR = "/fake/bin/herdr"


class SimClock:
    """Simulated time. Nothing in these tests sleeps."""

    def __init__(self, start=EPOCH):
        self.t = float(start)

    def now(self):
        return self.t

    def ms(self, at=None):
        return int(round((self.t if at is None else at) * 1000))


class FakeHTTP(Exception):
    def __init__(self, status, name, message):
        super().__init__(message)
        self.status, self.name, self.message = status, name, message


class Enveloped(list):
    """A list a fake operation returns with the rest of v2's answer beside `data`."""

    envelope = None


def _record_keys(record):
    """Keys of a transcript message (`metadata`) or an inbox item (`payload.metadata`)."""
    meta = record.get("metadata") or (record.get("payload") or {}).get("metadata") or {}
    keys = (meta.get("fleet") or {}).get("keys")
    return list(keys) if isinstance(keys, list) else []


class FakeV2:
    """`opencode api` with the spike-verified semantics (docs/switchboard.md, S2-S5).

    It is a runner, so the engine reaches it through V2Client._call exactly as
    it reaches the real binary. Oracles read its state directly: transcripts,
    the inbox, admissions and every model call.

    - A note (`resume` false, `steer`) on an idle session starts no turn and
      waits in the inbox; it reaches the model in the same call as the next
      turn's trigger, placed just before it.
    - A `steer` item on a busy session is injected at the next step of the turn,
      or, after the last step, delivered at the end with one more model call.
    - A `queue` item waits; it runs after the turn's final reply, never between
      steps, in the same busy span. `time.idle` is written once, at the end.
    - `resume` true on an idle session starts a turn at once.
    - inbox.update to `steer` on a waiting item starts a turn when idle; steer
      to steer is refused with 409.
    - A repeated message id is admitted once; the repeat returns the original.
      Ids are global, so a repeat aimed at another session is not admitted
      there either (the assumption the derived id is built around).

    Not modelled, and refused loudly: a fleet prompt to a busy session. (Yours is
    modelled in the transcript only: see human_prompt_while_busy.) A turn
    started by a wake lasts `wake_lasts` seconds (0 by default).
    """

    def __init__(self, clock):
        self.clock = clock
        self.sessions = {}
        self.admitted = {}     # message id -> admission, across sessions
        self.model_calls = []
        self.writes = []       # every write, with the audit line count at that moment
        self.calls = []
        self.down = False
        self.audit_path = None
        self.wake_lasts = 0
        self.before_synthetic = None   # a hook run as a synthetic arrives (the end-of-turn race)
        self.interrupts = []           # every session.interrupt: {"session", "resume", "was_busy", "at"}
        self._ids = 0

    def _id(self, prefix):
        self._ids += 1
        return "%s_fake%06d" % (prefix, self._ids)

    # -- the runner interface
    def __call__(self, argv, **kwargs):
        argv = list(argv)
        self.calls.append(argv)
        if self.down:
            return subprocess.CompletedProcess(argv, 1, "", "error: cannot reach the OpenCode service\n")
        if argv[1:2] != ["api"] or len(argv) < 3:
            return subprocess.CompletedProcess(argv, 2, "", "fake opencode: only `api` is modelled\n")
        if argv[2] == "GET":   # `opencode api GET /api/agent` (the registered agents): not modelled here, so the service reads as unreachable
            return subprocess.CompletedProcess(argv, 1, "", "fake opencode: GET is not modelled\n")
        op, params, body, rest = argv[2], {}, None, argv[3:]
        while rest:
            flag, value, rest = rest[0], rest[1], rest[2:]
            if flag == "--param":
                name, _, val = value.partition("=")
                params[name] = val
            elif flag == "-d":
                body = json.loads(value)
            else:
                raise AssertionError("fake opencode: unexpected argument %r" % flag)
        handler = getattr(self, "op_" + op.replace(".", "_"), None)
        if handler is None:
            return subprocess.CompletedProcess(argv, 1, '{"name":"NotFound"}', "HTTP 404 Not Found\n")
        try:
            data = handler(params, body)
        except FakeHTTP as err:
            return subprocess.CompletedProcess(
                argv, 1, json.dumps({"name": err.name, "message": err.message}),
                "HTTP %d %s\n" % (err.status, err.name))
        payload = {"data": data}
        payload.update(getattr(data, "envelope", None) or {})  # PR 8: a listing's cursor
        return subprocess.CompletedProcess(argv, 0, json.dumps(payload), "")

    # -- state helpers
    def create_session(self, metadata, title="fake", agent=None, directory=None):
        sid = self._id("ses")
        self.sessions[sid] = {"id": sid, "title": title, "metadata": copy.deepcopy(metadata),
                              "agent": agent, "directory": directory,
                              "created": self.clock.now(), "idle": None, "idle_writes": [], "outcome": None,
                              "messages": [], "inbox": [], "turn": None, "turns": 0}
        return sid

    def _session(self, params):
        session = self.sessions.get(params.get("sessionID"))
        if session is None:
            raise FakeHTTP(404, "NotFound", "no such session")
        return session

    def busy(self, sid):
        return self.sessions[sid]["turn"] is not None

    def _write(self, op, sid, ident):
        lines = 0
        if self.audit_path is not None and Path(self.audit_path).exists():
            lines = len(Path(self.audit_path).read_text().splitlines())
        self.writes.append({"op": op, "session": sid, "id": ident, "at": self.clock.now(), "audit_lines": lines})

    def _message(self, s, type_, text, metadata, at, mid=None):
        message = {"id": mid or self._id("msg"), "sessionID": s["id"], "type": type_, "text": text,
                   "time": {"created": self.clock.ms(at)}}
        if metadata is not None:
            message["metadata"] = copy.deepcopy(metadata)
        s["messages"].append(message)
        return message

    def _deliver(self, s, items, at):
        """Move inbox items into the transcript; they reach the model now."""
        delivered = []
        for item in items:
            s["inbox"].remove(item)
            delivered.append(self._message(s, item.get("type", "synthetic"), item["text"], item.get("metadata"), at, item["id"]))
            if item["id"] in self.admitted:  # your own prompt is not a switchboard admission
                self.admitted[item["id"]]["delivered_at"] = at
        return delivered

    def _model_call(self, s, phase, inputs, at):
        self.model_calls.append({"session": s["id"], "at": at, "phase": phase, "turn": s["turns"],
                                 "inputs": [{"id": m["id"], "type": m["type"], "keys": _record_keys(m)}
                                            for m in inputs]})

    def _start(self, s, at, lasts=0, steps=1, prompt=None, items=()):
        """A turn starts. Waiting notes ride in front of what started it (S3)."""
        s["turns"] += 1
        items = list(items)
        notes = [i for i in s["inbox"] if i["delivery"] == "steer" and i not in items]
        inputs = self._deliver(s, notes, at) + self._deliver(s, items, at)
        if prompt is not None:
            inputs.append(self._message(s, "user", prompt[0], prompt[1], at))
        self._model_call(s, "turn_start", inputs, at)
        s["turn"] = {"steps": [at + lasts * i / steps for i in range(1, steps)], "end": at + lasts}
        if lasts <= 0 and steps <= 1:
            self._finish(s, at)

    def _finish(self, s, at):
        """The final reply; then whatever waits runs in the same busy span (S3, S4)."""
        if s["idle"] is not None and at <= s["idle"]:
            at = s["idle"] + 0.001  # v2's time.idle only moves forward, even for a turn that takes no time
        self._message(s, "assistant", "reply", None, at)
        while s["inbox"]:
            steer = [i for i in s["inbox"] if i["delivery"] == "steer"]
            self._model_call(s, "after_reply", self._deliver(s, steer or s["inbox"][:1], at), at)
            self._message(s, "assistant", "reply", None, at)
        s["turn"] = None
        s["idle"] = at
        s["idle_writes"].append(at)
        s["outcome"] = "success"

    def advance(self):
        """Run every turn event due by now: steps, then the final reply."""
        now = self.clock.now()
        for s in self.sessions.values():
            while s["turn"] is not None:
                turn = s["turn"]
                if turn["steps"] and turn["steps"][0] <= now:
                    at = turn["steps"].pop(0)
                    steer = [i for i in s["inbox"] if i["delivery"] == "steer"]
                    self._model_call(s, "between_steps", self._deliver(s, steer, at), at)
                elif turn["end"] <= now:
                    self._finish(s, turn["end"])
                else:
                    break

    def start_turn(self, sid, text, fleet, lasts=0, steps=1, metadata=None):
        """A prompt: yours (no fleet metadata) or the fleet's, starting a turn of `steps` model calls."""
        s = self.sessions[sid]
        if s["turn"] is not None:
            if metadata is None and not fleet:  # PR 8: you type while it works
                return self.human_prompt_while_busy(sid, text)
            raise AssertionError("fake opencode: a prompt to a busy session is not modelled")
        if metadata is None and fleet:
            metadata = {"fleet": {"from": "fleet-task"}}
        self._start(s, self.clock.now(), lasts, steps, prompt=(text, metadata))

    def admissions(self, sid):
        return [a for a in self.admitted.values() if a["session"] == sid]

    def compact(self, sid, status="completed"):
        """PR 17: a compaction in the transcript, in the shape the Lab measured on v2 2.0.22 (docs/switchboard.md,
        "Standing orders", Lab proof): a message of type `compaction`, id `msg_...`, `time.created`, `status`
        running, completed or failed, a `reason`, `summary` and `recent` while running and when completed, an
        `error` when failed. It keeps its id as it goes from running to completed. Returns its id."""
        s = self.sessions[sid]
        message = self._message(s, "compaction", None, None, self.clock.now())
        del message["text"]
        message.update(status=status, reason="manual")
        if status == "failed":
            message["error"] = {"type": "compaction.failed", "message": "Compaction summary did not match the required template"}
        else:
            message.update(summary="## Objective\n- probe\n", recent="[User]: hi")
        return message["id"]

    def finish_compaction(self, sid, mid, status="completed"):
        for message in self.sessions[sid]["messages"]:
            if message["id"] == mid:
                message["status"] = status
                message.pop("error", None)

    def human_prompt_while_busy(self, sid, text):
        """PR 8: you send a message while the session works. It is in the transcript at once,
        as the TUI shows it, and the running turn goes on undisturbed. When the model first
        sees it, and how the TUI admits it, is spike SF1's question: nothing here says."""
        s = self.sessions[sid]
        at, mid = self.clock.now(), self._id("msg")
        item = {"id": mid, "sessionID": sid, "type": "user", "text": text, "metadata": None, "resume": False,
                "delivery": "steer", "time": {"created": self.clock.ms(at)}}
        s["inbox"].append(item)  # SF1: in the inbox at once, consumed at the next step boundary

    # -- operations
    def op_server_info(self, params, body):
        return {"version": "2.0.22-fake"}

    def op_session_create(self, params, body):
        return self._info(self.sessions[self.create_session(
            body.get("metadata") or {}, body.get("title"), body.get("agent"),
            (body.get("location") or {}).get("directory"))])

    def _info(self, s):
        stamps = [self.clock.ms(s["created"])] + [m["time"]["created"] for m in s["messages"] if isinstance(m.get("time"), dict) and "created" in m["time"]]
        if s["idle"] is not None:
            stamps.append(self.clock.ms(s["idle"]))
        return {"id": s["id"], "title": s["title"], "metadata": copy.deepcopy(s["metadata"]),
                "time": {"created": self.clock.ms(s["created"]), "updated": max(stamps),
                         "idle": None if s["idle"] is None else self.clock.ms(s["idle"])},
                "outcome": s["outcome"], "location": {"directory": s.get("directory")}}

    def op_session_get(self, params, body):
        return self._info(self._session(params))

    def op_session_active(self, params, body):
        return {sid: {"type": "busy"} for sid, s in self.sessions.items() if s["turn"] is not None}

    def op_session_message_list(self, params, body):
        s = self._session(params)
        messages = list(s["messages"]) if params.get("order") == "asc" else list(reversed(s["messages"]))
        if "type" in params:
            messages = [m for m in messages if m["type"] == params["type"]]
        if "limit" in params:
            return self.page_of(messages, params)
        return copy.deepcopy(messages)

    CURSOR_PREFIX = "cur_at_"

    def page_of(self, messages, params):
        """PR 8: a page and the cursor v2 returns beside it. A cursor token names the
        offset of the next page, in the listing's own order (newest first by default);
        `order` and `cursor` together are refused, as v2 says. `previous` points back."""
        start = 0
        if "cursor" in params:
            if "order" in params:
                raise FakeHTTP(400, "InvalidRequestError", "do not combine cursor with order")
            if not params["cursor"].startswith(self.CURSOR_PREFIX):
                raise FakeHTTP(400, "InvalidCursorError", "bad cursor")
            start = int(params["cursor"][len(self.CURSOR_PREFIX):])
        size = int(params["limit"])
        page = Enveloped(copy.deepcopy(messages[start:start + size]))
        more = start + size < len(messages)
        page.envelope = {"cursor": {"next": self.CURSOR_PREFIX + str(start + size) if more else None,
                                    "previous": self.CURSOR_PREFIX + str(max(0, start - size)) if start else None}}
        return page

    def op_session_interrupt(self, params, body):
        """VERIFIED in a throwaway v2 2.0.24 (steer probe): the running turn is cut at once (its in-flight tool
        call aborted), the session is idle with outcome interrupted, and a waiting steering input stays in the
        inbox unless `resume` is true, which runs it as a new turn. Idle: a no-op, {"interrupted": false}."""
        s = self._session(params)
        resume = params.get("resume") == "true"
        busy = s["turn"] is not None
        at = self.clock.now()
        self.interrupts.append({"session": s["id"], "resume": resume, "was_busy": busy, "at": at})
        self._write("session.interrupt", s["id"], None)
        if busy:
            s["turn"] = None
            s["idle"] = max(at, (s["idle"] or 0) + 0.001)
            s["idle_writes"].append(s["idle"])
            s["outcome"] = "interrupted"
            if resume and s["inbox"]:
                self._start(s, at, self.wake_lasts, 1, items=[i for i in s["inbox"] if i["delivery"] == "steer"])
        return {"interrupted": busy}

    def op_session_synthetic(self, params, body):
        if self.before_synthetic is not None:
            hook, self.before_synthetic = self.before_synthetic, None
            hook()
        s = self._session(params)
        mid = body["id"]
        if mid in self.admitted:  # admitted once; the repeat returns the original (S2)
            return copy.deepcopy(self.admitted[mid]["record"])
        at = self.clock.now()
        record = {"id": mid, "sessionID": s["id"], "type": "synthetic"}
        item = {"id": mid, "sessionID": s["id"], "text": body["text"], "metadata": copy.deepcopy(body.get("metadata")),
                "resume": body["resume"], "delivery": body["delivery"], "time": {"created": self.clock.ms(at)}}
        fleet = (body.get("metadata") or {}).get("fleet") or {}
        self.admitted[mid] = {"id": mid, "session": s["id"], "resume": body["resume"], "delivery": body["delivery"],
                              "at": at, "delivered_at": None, "keys": list(fleet.get("keys") or []),
                              "from": fleet.get("from"), "text": body["text"], "record": record,
                              "description": body.get("description")}
        self._write("session.synthetic", s["id"], mid)
        s["inbox"].append(item)
        if s["turn"] is None and body["resume"]:
            self._start(s, at, self.wake_lasts, 1, items=[item])
        return copy.deepcopy(record)

    def op_session_prompt(self, params, body):
        s = self._session(params)
        self.start_turn(s["id"], body["text"], fleet=bool((body.get("metadata") or {}).get("fleet")),
                        metadata=body.get("metadata"))
        return {"id": s["messages"][-1]["id"]}

    @staticmethod
    def _inbox_record(item):
        """An inbox item as v2 2.0.22 returns it: text and metadata under
        `payload`, and no `resume` (S3, S5)."""
        return {"id": item["id"], "sessionID": item["sessionID"], "time": copy.deepcopy(item["time"]),
                "type": item.get("type", "synthetic"), "payload": {"text": item["text"], "metadata": copy.deepcopy(item.get("metadata"))},
                "delivery": item["delivery"]}

    def op_session_inbox_list(self, params, body):
        return [self._inbox_record(item) for item in self._session(params)["inbox"]]

    def op_session_inbox_update(self, params, body):
        s = self._session(params)
        item = next((i for i in s["inbox"] if i["id"] == params.get("inboxID")), None)
        if item is None:
            raise FakeHTTP(404, "NotFound", "no such pending input")
        if body["delivery"] == "steer" and item["delivery"] == "steer":
            raise FakeHTTP(409, "Conflict", "Pending input cannot change to steer")
        self._write("session.inbox.update", s["id"], item["id"])
        item["delivery"] = body["delivery"]
        if body["delivery"] == "steer" and s["turn"] is None:
            self._start(s, self.clock.now(), self.wake_lasts, 1, items=[item])
        return self._inbox_record(item)


HERDR_ALLOWED = (["agent", "list"], ["agent", "get"], ["pane", "report-metadata"], ["notification", "show"],
                 ["pane", "process-info"], ["pane", "close"], ["workspace", "list"], ["workspace", "create"],
                 ["plugin", "list"], ["pane", "get"], ["pane", "read"], ["tab", "close"], ["tab", "get"], ["tab", "list"])  # PR 16; #973: the bell migration reads the tab labels once; the control plane reads a pane and closes a stale tab: `status` reads herdr's plugin list; `bootstrap` makes a workspace
SOCKET_ALLOWED = ("layout.apply",)
TYPING_VERBS = (["agent", "prompt"], ["agent", "send-keys"], ["agent", "start"], ["pane", "send-text"],
                ["pane", "send-keys"], ["pane", "run"])
TOKEN_NAME = re.compile(r"^[A-Za-z0-9_-]{1,32}$")


def _usage(argv, text):
    return subprocess.CompletedProcess(argv, 2, "", "error: %s\n" % text)


def parse_flags(args, valued, bare=()):
    """(positionals, flags) of a herdr subcommand, strictly: an unknown flag, a
    flag without its value, or a repeated flag is a usage error, as in clap."""
    positional, flags, i = [], {}, 0
    while i < len(args):
        arg = args[i]
        if arg.startswith("--"):
            if arg in bare:
                flags[arg] = True
            elif arg in valued and i + 1 < len(args):
                flags.setdefault(arg, []).append(args[i + 1])
                i += 1
            else:
                raise ValueError("unexpected argument %r" % arg)
        else:
            positional.append(arg)
        i += 1
    return positional, flags


class FakeHerdr:
    """herdr 0.9.3's CLI and socket, for what the switchboard uses, as strict
    as the real one: the pane id of `report-metadata` and the title of
    `notification show` are positional, and a wrong shape is a usage error
    (exit 2), never a quiet success. Status follows the fake v2 session
    (working while a turn runs, `done` after one) unless a test pins it.

    Typing is refused (exit 2) and recorded in `typing_attempts`, except for
    the one scenario baseline, where the runner sets `allow_typing`: then
    `agent prompt` does what the TUI does, putting the text after what is in
    the input box and submitting the lot.

    Toasts follow herdr's rules: one a second, server-wide, none queued. A test
    can script other answers with `toast_replies`. A pane opened by
    `layout.apply` runs its command's argv, as a pane without a shell does.
    `launch_mode` makes the launched pane misbehave: "shell" (a shell, not the
    program), "other-session", "undetected" (herdr never names an agent).
    """

    def __init__(self, v2):
        self.v2 = v2
        self.panes = {}
        self.calls = []
        self.socket_calls = []
        self.typing_attempts = []
        self.toasts = []            # every toast shown: {"title", "body", "at"}
        self.toast_replies = []     # scripted reasons for the next notification calls
        self.closed = []
        self.input_box = {}         # pane -> the text typed in its input box
        self.allow_typing = False
        self.launch_mode = "ok"
        self.down = False
        self.socket_down = False
        self._pane_n = 0
        self._last_toast = None
        self.workspaces = {"w1": {"workspace_id": "w1", "label": "Switchboard Lab", "number": 1}}  # PR 16
        self.shell_panes = set()    # PR 16: the empty shell pane a new workspace opens with

    def new_pane_id(self, workspace="w1"):
        self._pane_n += 1
        return "%s:p%d" % (workspace, self._pane_n)

    def add(self, pane, session, status=None, program=None):
        self.panes[pane] = {"session": session, "status": status, "tokens": {},
                            "program": program or "%s -s %s" % (FAKE_OPENCODE, session)}

    def status(self, pane):
        entry = self.panes[pane]
        if entry["status"]:
            return entry["status"]
        session = self.v2.sessions.get(entry["session"])
        if session is None:
            return "unknown"
        if session["turn"] is not None:
            return "working"
        return "done" if session["idle"] is not None else "idle"

    def agent(self, pane):
        # herdr 0.9's shape: the session is an object, not a string (S6).
        entry = self.panes[pane]
        body = {"pane_id": pane, "agent": "opencode", "agent_status": self.status(pane),
                "workspace_id": pane.split(":")[0], "tab_id": self.tab_of(pane)}
        if entry["session"] and not entry.get("undetected"):
            body["agent_session"] = {"agent": "opencode", "kind": "id", "source": "herdr:opencode",
                                     "value": entry["session"]}
        if entry.get("tokens"):
            body["tokens"] = dict(entry["tokens"])  # values are strings, as in herdr
        return body

    # -- the CLI
    def __call__(self, argv, **kwargs):
        argv = list(argv)
        self.calls.append(argv)
        args = argv[1:]
        if self.down:
            return subprocess.CompletedProcess(argv, 1, "", "error: no herdr server\n")
        if args[:2] in TYPING_VERBS and not (self.allow_typing and args[:2] == ["agent", "prompt"]):
            self.typing_attempts.append(args)
            return _usage(argv, "fake herdr: typing refused: %r" % args)
        handler = {("agent", "list"): self._agent_list, ("agent", "get"): self._agent_get,
                   ("agent", "prompt"): self._agent_prompt, ("pane", "report-metadata"): self._report_metadata,
                   ("notification", "show"): self._notification_show, ("pane", "process-info"): self._process_info,
                   ("pane", "close"): self._pane_close, ("workspace", "list"): self._workspace_list,
                   ("workspace", "create"): self._workspace_create, ("pane", "get"): self._pane_get, ("pane", "list"): self._pane_list,
                   ("tab", "close"): self._tab_close, ("tab", "get"): self._tab_get, ("tab", "list"): self._tab_list}.get(tuple(args[:2]))
        if tuple(args[:2]) == ("pane", "read"):
            positional, flags = parse_flags(args[2:], ("--source", "--lines", "--format"))
            if positional[0] not in self.panes:
                return subprocess.CompletedProcess(argv, 1, "", "error: pane %s not found\n" % positional[0])
            entry = self.panes[positional[0]]
            if entry.get("read_fails"):
                return subprocess.CompletedProcess(argv, 1, "", "error: read timed out\n")
            return subprocess.CompletedProcess(argv, 0, entry.get("screen") or "  Build auto · model\n", "")
        if handler is None:
            return _usage(argv, "fake herdr: refused %r" % args)
        try:
            body = handler(args[2:])
        except ValueError as err:
            return _usage(argv, str(err))
        except LookupError as err:
            return subprocess.CompletedProcess(argv, 1, "", "error: %s\n" % err)
        return subprocess.CompletedProcess(argv, 0, json.dumps(body) if body is not None else "", "")

    def _pane(self, pane):
        if pane not in self.panes:
            raise LookupError("no agent in pane %s" % pane)
        return pane

    def _pane_list(self, rest):
        """Every pane: the agent panes and `plain_terminals` (a list of {"pane_id", "cwd", "foreground_cwd"}), as `herdr pane list` shows them."""
        parse_flags(rest, ())
        panes = []
        for pane in sorted(self.panes):
            entry = self.panes[pane]
            panes.append({"pane_id": pane, "cwd": entry.get("cwd") or "/tmp", "foreground_cwd": entry.get("foreground_cwd") or entry.get("cwd") or "/tmp",
                          **({"revision": entry["revision"]} if "revision" in entry else {})})
        panes.extend(getattr(self, "plain_terminals", []))
        return {"result": {"type": "pane_list", "panes": panes}}

    def _agent_list(self, rest):
        parse_flags(rest, ())
        return {"result": {"type": "agent_list", "agents": [self.agent(p) for p in sorted(self.panes)]}}

    def _agent_get(self, rest):
        positional, _ = parse_flags(rest, ())
        if len(positional) != 1:
            raise ValueError("agent get takes one target")
        return {"result": {"type": "agent_info", "agent": self.agent(self._pane(positional[0]))}}

    def _agent_prompt(self, rest):
        positional, _ = parse_flags(rest, ())
        pane, text = self._pane(positional[0]), " ".join(positional[1:])
        draft = self.input_box.pop(pane, "")
        self.v2.start_turn(self.panes[pane]["session"], (draft + " " + text).strip(), fleet=False)
        return {"result": {"type": "ok"}}

    def _report_metadata(self, rest):
        positional, flags = parse_flags(rest, ("--source", "--token", "--clear-token", "--seq", "--ttl-ms"))
        if len(positional) != 1:
            raise ValueError("pane report-metadata takes the pane id as its one positional argument")
        pane = self._pane(positional[0])
        source = (flags.get("--source") or [""])[0]
        if not re.match(r"^[A-Za-z0-9:._-]{1,80}$", source):
            raise ValueError("--source is required: 1-80 of [A-Za-z0-9:._-]")
        sets, clears = flags.get("--token", []), flags.get("--clear-token", [])
        if not sets and not clears:
            raise ValueError("report-metadata needs --token or --clear-token")
        tokens = self.panes[pane].setdefault("tokens", {})
        for item in sets:
            name, _, value = item.partition("=")
            if not TOKEN_NAME.match(name) or not value.strip() or len(value) > 80:
                raise ValueError("bad token %r" % item)
            tokens[name] = value
        for name in clears:
            if not TOKEN_NAME.match(name):
                raise ValueError("bad token name %r" % name)
            tokens.pop(name, None)
        return None

    def _notification_show(self, rest):
        positional, flags = parse_flags(rest, ("--body", "--sound"))
        if len(positional) != 1 or not positional[0].strip():
            raise ValueError("notification show takes the title as its one positional argument")
        title, now = positional[0], self.v2.clock.now()
        if len(title) > 80:
            raise ValueError("fake herdr: title over 80 characters")
        reason = self.toast_replies.pop(0) if self.toast_replies else None
        if reason is None and self._last_toast is not None and now - self._last_toast < 1:
            reason = "rate_limited"
        if reason is None:
            self._last_toast = now
            self.toasts.append({"title": title, "body": (flags.get("--body") or [None])[0], "at": now})
        return {"result": {"type": "notification_show", "shown": reason is None, "reason": reason or "shown"}}

    @property
    def shell_pid(self):
        """The shell process number the fake reports for a pane: made up (a number no live process has), the same for the life of this fake."""
        if "_shell_pid" not in self.__dict__:
            self.__dict__["_shell_pid"] = made_up_pid()
        return self.__dict__["_shell_pid"]

    def _plain(self, pane):
        return next((t for t in getattr(self, "plain_terminals", []) if t["pane_id"] == pane), None)

    def _process_info(self, rest):
        positional, flags = parse_flags(rest, ("--pane",))
        if positional or len(flags.get("--pane", [])) != 1:
            raise ValueError("pane process-info takes --pane <ID>")
        plain = self._plain(flags["--pane"][0])
        if plain is not None and plain.get("process_fails"):
            raise LookupError("process info of %s cannot be read" % plain["pane_id"])
        if plain is not None:   # a terminal with no agent: its foreground processes are what the test says (default: a bare shell)
            return {"result": {"type": "pane_process_info", "process_info": {"pane_id": plain["pane_id"], "shell_pid": 1,
                                                                              "foreground_processes": [{"cmdline": n, "name": n, "pid": 1} for n in plain.get("processes", ["zsh"])]}}}
        pane = self._pane(flags["--pane"][0])
        program = self.panes[pane].get("program")
        processes = [{"cmdline": program, "name": program.split(" ")[0].rsplit("/", 1)[-1], "pid": self.shell_pid}] if program else []
        return {"result": {"type": "pane_process_info", "process_info": {
            "pane_id": pane, "foreground_processes": processes, "shell_pid": self.shell_pid}}}

    def tab_of(self, pane):
        return "%s:t%s" % (pane.split(":")[0], pane.split("p")[-1])

    def _pane_get(self, rest):
        positional, _ = parse_flags(rest, ())
        pane = positional[0]
        if pane not in self.panes:
            raise LookupError("pane %s not found" % pane)
        entry = self.panes[pane]
        session = self.v2.sessions.get(entry["session"]) or {}
        name = (((session.get("metadata") or {}).get("fleet")) or {}).get("name") or "opencode"
        title = entry.get("title") if entry.get("title") is not None else "OC | %s" % name
        body = {"pane_id": pane, "workspace_id": pane.split(":")[0], "tab_id": self.tab_of(pane), "cwd": entry.get("cwd") or "/tmp",
                "agent_status": self.status(pane), "terminal_title_stripped": title}
        return {"result": {"type": "pane_info", "pane": body}}

    def _tab_list(self, rest):
        parse_flags(rest, ())
        return {"result": {"type": "tab_list", "tabs": [{"tab_id": self.tab_of(p), "workspace_id": p.split(":")[0], "label": self.panes[p].get("tab_label", "")} for p in sorted(self.panes)]}}

    def _tab_get(self, rest):
        positional, _ = parse_flags(rest, ())
        members = [p for p in self.panes if self.tab_of(p) == positional[0]]
        if not members:
            raise LookupError("tab %s not found" % positional[0])
        return {"result": {"type": "tab_info", "tab": {"tab_id": positional[0], "pane_count": len(members) + len(self.extra_panes.get(positional[0], []))}}}

    extra_panes = {}

    def _tab_close(self, rest):
        positional, _ = parse_flags(rest, ())
        for pane in list(self.panes):
            if self.tab_of(pane) == positional[0]:
                self.closed.append(pane)
                del self.panes[pane]
                return {"result": {"type": "ok"}}
        raise LookupError("tab %s not found" % positional[0])

    def _pane_close(self, rest):
        positional, _ = parse_flags(rest, ())
        if len(positional) != 1:
            raise ValueError("pane close takes one pane id")
        plain = self._plain(positional[0])
        if plain is not None:
            self.plain_terminals.remove(plain)
            self.closed.append(positional[0])
            return {"result": {"type": "ok"}}
        if positional[0] in self.shell_panes:
            self.shell_panes.discard(positional[0])
            self.closed.append(positional[0])
            return {"result": {"type": "ok"}}
        self.closed.append(self._pane(positional[0]))
        del self.panes[positional[0]]
        return {"result": {"type": "ok"}}

    def _workspace_list(self, rest):
        parse_flags(rest, ())
        return {"result": {"type": "workspace_list", "workspaces": [dict(w) for w in self.workspaces.values()]}}

    def _workspace_create(self, rest):
        """PR 16: `herdr workspace create [--cwd P] [--label T] [--focus|--no-focus]`: one workspace with one empty shell pane."""
        positional, flags = parse_flags(rest, ("--cwd", "--label", "--env"), bare=("--focus", "--no-focus"))
        if positional:
            raise ValueError("workspace create takes no positional argument")
        if "--focus" in flags and "--no-focus" in flags:
            raise ValueError("--focus and --no-focus conflict")
        self._workspace_n = getattr(self, "_workspace_n", len(self.workspaces)) + 1
        number = self._workspace_n
        wid = "w%d" % number
        label = (flags.get("--label") or ["%d" % number])[0]
        self.workspaces[wid] = {"workspace_id": wid, "label": label, "number": number}
        self.created_workspaces = getattr(self, "created_workspaces", []) + [{"id": wid, "cwd": (flags.get("--cwd") or [None])[0],
                                                                                "label": label, "argv": list(rest), "focus": "--focus" in flags and "--no-focus" not in flags}]
        root = self.new_pane_id(wid)
        self.shell_panes.add(root)
        return {"result": {"type": "workspace_created", "workspace": dict(self.workspaces[wid]),
                           "root_pane": {"pane_id": root, "workspace_id": wid}}}

    # -- the socket
    def socket(self, path, method, params, timeout):
        self.socket_calls.append((method, copy.deepcopy(params)))
        if self.socket_down:
            raise sb.HerdrError("unavailable", "cannot reach herdr's socket %s" % path)
        if method != "layout.apply":
            return {"error": {"code": "unknown_method", "message": method}}
        return self._layout_apply(params)

    def _layout_apply(self, params):
        root = params.get("root") or {}
        if set(params) - {"workspace_id", "tab_label", "root"} or set(root) - {"type", "label", "cwd", "command", "env"}:
            return {"error": {"code": "invalid_request", "message": "unknown field"}}
        command = root.get("command")
        if root.get("type") != "pane" or not (isinstance(command, list) and command) \
                or not os.path.isabs(root.get("cwd") or "") or not isinstance(root.get("env"), dict) \
                or not all(isinstance(v, str) for v in root["env"].values()):
            return {"error": {"code": "invalid_request", "message": "bad layout"}}
        workspace = params["workspace_id"]
        pane = self.new_pane_id(workspace)
        session = command[2] if len(command) > 2 and command[1] == "-s" else None
        self.add(pane, session, program=" ".join(command))
        entry = self.panes[pane]
        entry["env"], entry["cwd"], entry["argv"] = dict(root["env"]), root["cwd"], list(command)
        if self.launch_mode == "shell":
            entry["program"] = "-zsh"
        elif self.launch_mode == "other-session":
            entry["session"] = next(iter(self.v2.sessions))
        elif self.launch_mode == "undetected":
            entry["undetected"] = True
        return {"id": "x", "result": {"type": "layout_apply", "layout": {
            "workspace_id": workspace, "tab_id": "%s:t%s" % (workspace, pane.split("p")[-1]),
            "root": {"type": "pane", "pane_id": pane, "label": root["label"], "cwd": root["cwd"],
                     "command": command}}}}


class World:
    """Fake v2, fake herdr and a simulated clock, and an engine on the real clients."""

    def __init__(self, test, agents=("platform", "coder"), config=None, state=None):
        os.environ[sb.LAB_ENV] = "1"  # lab facts are the event source in these tests
        patch = mock.patch.object(sb, "memory_sleep", lambda seconds: None)   # a new launch's memory test (#779) never waits 30 s here
        patch.start()
        test.addCleanup(patch.stop)
        self.clock = SimClock()
        self.v2 = FakeV2(self.clock)
        self.herdr = FakeHerdr(self.v2)
        self.state = sb.ensure_state_dir(state)
        self.audit_path = self.state / "audit.jsonl"
        self.v2.audit_path = self.audit_path
        self.sessions, self.panes = {}, {}
        for name in agents:
            self.add_agent(name)
        empty_log = self.state / "herdr-server.log"   # #1030: the pane-exit pass reads herdr's log; a world must never read the real one, nor note a missing one
        empty_log.write_text("")
        raw = {"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "herdr_log": str(empty_log),
               "v2_cache_seconds": getattr(test, "V2_CACHE", 0)}   # the scenarios of old read the world afresh every pass; TestV2ReadVolume and the *WithTheMemoryOn classes turn it on
        raw.update(config or {})
        self.config = sb.validate_config(raw)
        self.engine = self.new_engine()

    def add_agent(self, name, status=None, fleet=None):
        meta = {"name": name, "role": "coder"}
        meta.update(fleet or {})
        sid = self.v2.create_session({"fleet": meta})
        pane = self.herdr.new_pane_id()
        self.herdr.add(pane, sid, status)
        self.sessions[name], self.panes[name] = sid, pane
        if meta.get("role") == "orchestrator" and isinstance(meta.get("charter"), int):   # #969: the registry is the record of a charter; a first-seen agent takes its launch value (as the pass does)
            sb.load_module("registry").upsert(self.state, name, {"session": sid, "pane": pane, "role": "orchestrator", "charter": meta["charter"], "repo": meta.get("repo")})
        return sid

    def new_engine(self, actor="daemon", writable=True):
        return sb.Switchboard(self.config, sb.V2Client(FAKE_OPENCODE, {}, self.v2, 5),
                              sb.HerdrClient(FAKE_HERDR, self.herdr, socket_call=self.herdr.socket),
                              sb.AuditLog(self.audit_path) if writable else None,
                              sb.fact_sources(self.state), self.clock.now, actor,
                              intents=getattr(self, "intents", None), state_dir=self.state)

    def route(self, argv, **kwargs):
        """One runner for the CLI: each fake answers its own binary; nothing else runs."""
        if argv[0] == FAKE_OPENCODE:
            return self.v2(argv, **kwargs)
        if argv[0] == FAKE_HERDR:
            return self.herdr(argv, **kwargs)
        if argv[0] in sb.MEMORY_PROBES.values():   # a healthy, flat machine: the memory test of a new launch (#779) passes
            return subprocess.CompletedProcess(argv, 0, "System-wide memory free percentage: 80%\n" if argv[0].endswith("memory_pressure") else "Swapouts:  5.\n", "")
        raise AssertionError("a test reached for a real binary: %r" % argv[0])

    def fact(self, to, key, summary="something happened", **extra):
        line = {"key": key, "recipient": to, "kind": extra.pop("kind", "lab.fact"), "summary": summary,
                "created": self.clock.now()}
        line.update(extra)
        with open(str(self.state / sb.LAB_FACTS), "a") as handle:
            handle.write(json.dumps(line) + "\n")

    def tick(self, seconds=1):
        for _ in range(int(seconds)):
            self.clock.t += 1
            self.v2.advance()

    def you(self, name, text="what is new?"):
        self.v2.start_turn(self.sessions[name], text, fleet=False)

    def admissions(self, name):
        return self.v2.admissions(self.sessions[name])

    def audit(self):
        if not self.audit_path.exists():
            return []
        return [json.loads(line) for line in self.audit_path.read_text().splitlines()]

    def model_calls(self, name, phase=None):
        return [c for c in self.v2.model_calls
                if c["session"] == self.sessions[name] and (phase is None or c["phase"] == phase)]


def fact(key, created=EPOCH, recipient="platform", **extra):
    return sb.Fact(key, recipient, extra.pop("kind", "lab.fact"), extra.pop("summary", "s %s" % key), created, **extra)


def observation(status="idle", human=None, **extra):
    return sb.Observation("platform", "ses_1", "w1:p1", status, {"name": "platform"},
                          last_human_prompt=human, **extra)


class TestFakeV2(Base):
    """The fakes are only worth what their fidelity to the spikes is worth."""

    def setUp(self):
        super().setUp()
        self.world = World(self, agents=("platform",))
        self.client = sb.V2Client(FAKE_OPENCODE, {}, self.world.v2, 5)
        self.sid = self.world.sessions["platform"]

    def synthetic(self, key, resume, delivery):
        return self.client.synthetic(self.sid, "item %s" % key, {"fleet": {"keys": [key], "from": "switchboard"}},
                                     resume, delivery, sb.derive_message_id(self.sid, [key]))

    def test_a_note_on_an_idle_session_starts_nothing_and_rides_the_next_prompt(self):
        self.synthetic("n1", False, "steer")
        self.assertEqual(self.world.model_calls("platform"), [])
        self.assertEqual([_record_keys(i) for i in self.client.inbox_list(self.sid)], [["n1"]])
        self.world.tick(30)
        self.world.you("platform", "hello")
        start = self.world.model_calls("platform")
        self.assertEqual([[i["type"] for i in c["inputs"]] for c in start], [["synthetic", "user"]])
        oldest_first = list(reversed(self.client.message_list(self.sid)))
        self.assertEqual([m["type"] for m in oldest_first[:2]], ["synthetic", "user"])

    def test_a_queued_note_comes_after_the_reply_with_a_model_call_of_its_own(self):
        self.synthetic("q1", False, "queue")
        self.world.you("platform")
        phases = [(c["phase"], [i["keys"] for i in c["inputs"]]) for c in self.world.model_calls("platform")]
        self.assertEqual(phases, [("turn_start", [[]]), ("after_reply", [["q1"]])])

    def test_a_wake_starts_an_idle_session_at_once(self):
        self.synthetic("w1", True, "queue")
        self.assertEqual([c["phase"] for c in self.world.model_calls("platform")], ["turn_start"])
        self.assertEqual(self.client.inbox_list(self.sid), [])

    def test_a_busy_wake_runs_after_the_final_reply_in_one_busy_span(self):
        self.world.v2.start_turn(self.sid, "task", fleet=True, lasts=60, steps=3)
        self.world.tick(5)
        self.synthetic("w2", True, "queue")
        self.world.tick(60)
        calls = [(c["phase"], c["at"] - EPOCH, [i["keys"] for i in c["inputs"]])
                 for c in self.world.model_calls("platform")]
        self.assertEqual(calls, [("turn_start", 0, [[]]), ("between_steps", 20, []), ("between_steps", 40, []),
                                 ("after_reply", 60, [["w2"]])])
        self.assertEqual(self.world.v2.sessions[self.sid]["idle_writes"], [EPOCH + 60])

    def test_steer_on_a_busy_session_is_injected_between_steps(self):
        self.world.v2.start_turn(self.sid, "task", fleet=True, lasts=60, steps=3)
        self.world.tick(5)
        self.synthetic("s1", True, "steer")
        self.world.tick(60)
        between = self.world.model_calls("platform", "between_steps")
        self.assertEqual([[i["keys"] for i in c["inputs"]] for c in between], [[["s1"]], []])

    def test_steer_during_a_one_step_turn_comes_at_the_end_with_another_call(self):
        self.world.v2.start_turn(self.sid, "task", fleet=True, lasts=30)
        self.world.tick(5)
        self.synthetic("s2", False, "steer")
        self.world.tick(30)
        self.assertEqual([c["phase"] for c in self.world.model_calls("platform")], ["turn_start", "after_reply"])

    def test_a_repeated_id_is_admitted_once_and_returns_the_original(self):
        first = self.synthetic("r1", True, "queue")
        again = self.synthetic("r1", True, "queue")
        self.assertEqual(first, again)
        self.assertEqual(len(self.world.admissions("platform")), 1)
        self.assertEqual(len(self.world.model_calls("platform")), 1)

    def test_a_waiting_steer_note_cannot_be_updated_to_steer(self):
        record = self.synthetic("n2", False, "steer")
        with self.assertRaises(sb.V2Error) as caught:
            self.client.inbox_update(self.sid, record["id"], "steer")
        self.assertEqual(caught.exception.status, 409)
        self.client.inbox_update(self.sid, record["id"], "queue")
        self.assertEqual(self.world.model_calls("platform"), [])
        self.client.inbox_update(self.sid, record["id"], "steer")
        self.assertEqual([c["phase"] for c in self.world.model_calls("platform")], ["turn_start"])

    def test_reads_newest_first_with_a_limit_and_metadata_intact(self):
        self.world.you("platform", "one")
        self.world.tick()
        self.world.v2.start_turn(self.sid, "two", fleet=True)
        page = self.client.message_list(self.sid, limit=2)
        self.assertEqual([m["type"] for m in page], ["assistant", "user"])
        self.assertEqual(page[1]["metadata"], {"fleet": {"from": "fleet-task"}})
        info = self.client.session_get(self.sid)
        self.assertEqual(info["metadata"]["fleet"]["name"], "platform")
        self.assertEqual(info["time"]["idle"], self.world.clock.ms())


# ------------------------------------------------------------------ the facts

class TestFacts(Base):
    def test_round_trip_and_defaults(self):
        made = sb.Fact.from_json({"key": "lab.fact:1", "recipient": "platform", "kind": "review",
                                  "summary": "s", "created": EPOCH})
        self.assertEqual(made.to_json(), {"key": "lab.fact:1", "recipient": "platform", "kind": "review",
                                          "summary": "s", "created": EPOCH, "issue": None, "batch": True,
                                          "from": None, "rider": False, "orders": False})

    def test_bad_facts_are_refused_with_the_field_named(self):
        good = {"key": "k", "recipient": "platform", "kind": "x", "summary": "s", "created": EPOCH}
        for change, needle in (({"key": ""}, "key"), ({"recipient": None}, "recipient"),
                               ({"created": "now"}, "created"),
                               ({"issue": 0}, "issue"), ({"batch": "yes"}, "batch"), ({"from": 3}, "from"),
                               ({"summary": None}, "summary"), ({"extra": 1}, "extra")):
            with self.subTest(change=change):
                with self.assertRaises(sb.FactError) as caught:
                    sb.Fact.from_json(dict(good, **change))
                self.assertIn(needle, str(caught.exception))
        with self.assertRaises(sb.FactError):
            sb.Fact.from_json({"key": "k"})

    def test_the_lab_source_reads_only_in_the_lab(self):
        world = World(self)
        world.fact("platform", "lab.fact:1")
        source = sb.lab_fact_source(world.state)
        self.assertEqual([f.key for f in source()], ["lab.fact:1"])
        os.environ[sb.LAB_ENV] = "0"
        self.assertEqual(source(), [])
        os.environ.pop(sb.LAB_ENV)
        self.assertEqual(source(), [])

    def test_a_bad_lab_line_fails_the_source_loudly(self):
        world = World(self)
        world.fact("platform", "lab.fact:1")
        with open(str(world.state / sb.LAB_FACTS), "a") as handle:
            handle.write('{"key": "lab.fact:2"}\n')
        with self.assertRaises(sb.FactError) as caught:
            sb.lab_fact_source(world.state)()
        self.assertIn(":2:", str(caught.exception))

    def test_the_registration_point_lists_the_lab_source(self):
        self.assertEqual([s.__name__ for s in sb.fact_sources(self.home)],
                         ["lab_facts", "worker_facts", "reminder_facts", "report_rider_facts", "foreground_facts",
                          "orders_facts", "sweep_facts", "triage_facts", "plan_wake_facts", "alert_wake_facts", "job_facts", "pane_facts", "pane_exit_facts", "headless_restart_facts", "disk_facts", "cpu_facts", "spotlight_facts", "docker_reap_facts", "temp_janitor_facts", "heavy_orphan_facts"])

    def test_every_fact_source_class_in_the_module_is_registered(self):   # #1030: derived, so a new source cannot be left out
        registered = {type(s).__name__ for s in sb.fact_sources(self.home)}
        classes = {n for n, v in vars(sb).items() if isinstance(v, type) and n.endswith("Facts") and v.__module__ == sb.__name__}
        self.assertEqual(classes - registered, set(), "a *Facts class is not in fact_sources (list it, or rename it)")


# ---------------------------------------------------------------- observing

class TestDiscovery(Base):
    def test_fleet_agents_are_herdr_agents_whose_session_names_them(self):
        world = World(self, agents=("platform",))
        stranger = world.v2.create_session({"other": True})
        world.herdr.add("w9:p1", stranger)
        world.herdr.panes["w9:p2"] = {"session": None, "status": "idle"}
        found = world.engine.discover(world.clock.now())
        self.assertEqual(sorted(found.agents), ["platform"])
        seen = found.agents["platform"]
        self.assertEqual((seen.session_id, seen.pane, seen.status), (world.sessions["platform"], "w1:p1", "idle"))
        self.assertEqual(seen.fleet, {"name": "platform", "role": "coder"})

    def test_inbox_items_carry_their_metadata_under_payload(self):
        # session.inbox.list in v2 2.0.22 (checked in the Lab): no top-level metadata.
        item = {"id": "msg_1", "type": "synthetic", "delivery": "queue",
                "payload": {"text": "t", "metadata": {"fleet": {"keys": ["k1"], "from": "switchboard"}}}}
        self.assertEqual(sb._fleet_keys(item), ["k1"])
        self.assertEqual(sb._fleet_meta(item)["from"], "switchboard")
        self.assertEqual(sb._fleet_keys({"metadata": {"fleet": {"keys": ["k2"]}}}), ["k2"])

    def test_a_wake_waiting_behind_a_busy_turn_is_not_sent_again(self):
        world = World(self, agents=("platform",))
        world.v2.start_turn(world.sessions["platform"], "fleet task", fleet=True, lasts=600, steps=1)
        world.fact("platform", "lab.fact:busy")
        world.tick(100)
        world.engine.run_pass()
        for _ in range(5):
            world.tick(5)
            world.engine.run_pass()
        sends = [argv for argv in world.v2.calls if argv[2:3] == ["session.synthetic"]]
        self.assertEqual(len(sends), 1, "the waiting item's keys are read from v2's inbox, so it is sent once")
        self.assertEqual(len(world.admissions("platform")), 1)

    def test_herdr_names_the_session_as_an_object_or_a_string(self):
        # herdr 0.9.3's `agent list` gives {"kind": "id", "value": "ses_..."} (S6).
        for entry, expected in (({"agent_session": {"kind": "id", "source": "herdr:opencode", "value": "ses_1"}}, "ses_1"),
                                ({"agent_session": {"value": "ses_2"}}, "ses_2"),
                                ({"agent_session": "ses_3"}, "ses_3"),
                                ({"agent_session": {"kind": "path", "value": "/tmp/x"}}, None),
                                ({"agent_session": {"kind": "id", "value": ""}}, None),
                                ({"agent_session": None}, None), ({}, None), ("ses_4", None)):
            with self.subTest(entry=entry):
                self.assertEqual(sb.agent_session(entry), expected)

    def test_status_comes_from_herdr(self):
        world = World(self, agents=())
        for herdr_status, expected in (("working", "working"), ("idle", "idle"), ("done", "idle"),
                                       ("blocked", "blocked"), ("unknown", "unknown"), ("weird", "unknown")):
            world.add_agent("a-" + herdr_status, status=herdr_status)
        found = world.engine.discover(world.clock.now()).agents
        self.assertEqual({name: o.status for name, o in found.items()},
                         {"a-working": "working", "a-idle": "idle", "a-done": "idle", "a-blocked": "blocked",
                          "a-unknown": "unknown", "a-weird": "unknown"})

    def test_idle_at_outcome_and_your_last_prompt(self):
        world = World(self, agents=("platform",))
        sid = world.sessions["platform"]
        world.you("platform", "hi")                       # yours, at 0
        world.tick(30)
        world.v2.start_turn(sid, "fleet task", fleet=True)  # the fleet's, at 30
        world.tick(10)
        seen = world.engine.discover(world.clock.now()).agents["platform"]
        self.assertEqual(seen.last_human_prompt, EPOCH)
        self.assertEqual((seen.idle_at, seen.outcome), (EPOCH + 30, "success"))
        self.assertTrue(seen.engaged(world.clock.now(), 600))

    def test_a_prompt_older_than_the_window_is_not_engagement(self):
        world = World(self, agents=("platform",))
        world.you("platform")
        world.tick(601)
        seen = world.engine.discover(world.clock.now()).agents["platform"]
        self.assertIsNone(seen.last_human_prompt)
        self.assertFalse(seen.engaged(world.clock.now(), 600))
        argv = [a for a in world.v2.calls if a[2] == "session.message.list"][-1]
        self.assertIn("limit=%d" % sb.V2Reads.PROMPT_READ, argv)   # a small read of the newest user messages, not a 200-message page
        self.assertIn("type=user", argv)

    def test_two_sessions_with_one_name_are_a_conflict(self):
        world = World(self, agents=("platform",))
        world.add_agent("platform")
        seen = world.engine.discover(world.clock.now()).agents["platform"]
        self.assertEqual(len(seen.conflict), 1)
        self.assertIn("more than one session", sb.hold_reason(seen))

    def test_herdr_or_v2_down_is_a_reason_not_a_crash(self):
        world = World(self, agents=("platform",))
        world.herdr.down = True
        found = world.engine.discover(world.clock.now())
        self.assertEqual(found.agents, {})
        self.assertIn("herdr unreachable", found.missing("platform"))
        world.herdr.down, world.v2.down = False, True
        self.assertIn("v2 unreachable", world.engine.discover(world.clock.now()).missing("platform"))

    def test_a_session_v2_no_longer_has_is_skipped(self):
        world = World(self, agents=("platform",))
        del world.v2.sessions[world.sessions["platform"]]
        found = world.engine.discover(world.clock.now())
        self.assertEqual((found.agents, found.problems), ({}, []))


# ------------------------------------------------------------------ deriving

class TestDerive(Base):
    def setUp(self):
        super().setUp()
        self.world = World(self, agents=("platform",))
        self.sid = self.world.sessions["platform"]
        self.client = sb.V2Client(FAKE_OPENCODE, {}, self.world.v2, 5)

    def send(self, keys, resume, delivery="queue"):
        self.client.synthetic(self.sid, "x", {"fleet": {"keys": keys, "from": "switchboard"}}, resume, delivery,
                              sb.derive_message_id(self.sid, keys))

    def plan(self, facts):
        engine = self.world.engine
        return engine.plan("platform", facts, engine.discover(self.world.clock.now()), self.world.clock.now())

    def test_keys_in_the_transcript_and_the_inbox_are_delivered(self):
        self.send(["a"], True)            # a wake: in the transcript
        self.send(["b"], False, "steer")  # a note: still in the inbox
        keys, complete = self.world.engine.delivered_keys(self.sid, EPOCH - 60)
        self.assertEqual((keys, complete), ({"a", "b"}, True))
        self.world.tick(200)
        plan = self.plan([fact("a"), fact("b"), fact("c")])
        self.assertEqual([f.key for f in plan.pending], ["c"])

    def test_nothing_pending_means_no_plan(self):
        self.send(["a"], True)
        self.world.tick(200)
        self.assertIsNone(self.plan([fact("a")]))

    def test_the_read_stops_at_the_oldest_fact(self):
        self.send(["old"], True)
        self.world.tick(600)
        keys, complete = self.world.engine.delivered_keys(self.sid, EPOCH + 300)
        self.assertEqual((keys, complete), (set(), True))

    def test_a_read_that_cannot_reach_back_holds(self):
        for n in range(3):
            self.send(["k%d" % n], True)
            self.world.tick(100)
        # PR 8 reads further pages, so the read is bounded to one page here: this test is about
        # the bound (more pages than MAX_READ_PAGES also holds: see TestMessagePaging).
        with mock.patch.object(sb, "SYNTHETIC_PAGE", 2), mock.patch.object(sb, "MAX_READ_PAGES", 1):
            _, complete = self.world.engine.delivered_keys(self.sid, EPOCH - 60)
            self.assertFalse(complete)
            plan = self.plan([fact("new")])
        self.assertEqual(plan.action, "hold")
        self.assertIn("unknown", plan.reason)

    def test_no_dedupe_ignores_what_was_delivered(self):
        self.send(["a"], True)
        self.world.tick(200)
        os.environ[sb.FAULT_ENV] = "no-dedupe"
        self.assertEqual([f.key for f in self.plan([fact("a")]).pending], ["a"])


# ------------------------------------------------------------------ deciding

class TestDecide(Base):
    def decide(self, pending, seen, now=EPOCH + 100, missing=None):
        return sb.decide("platform", pending, seen, now, 90, 600, missing)

    def test_every_branch(self):
        cases = [
            # (what, pending, observation, now, action, reason contains)
            ("young batch waits", [fact("a", EPOCH + 50)], observation(), EPOCH + 100, "wait", "batching until"),
            ("ripe batch goes", [fact("a", EPOCH), fact("b", EPOCH + 50)], observation(), EPOCH + 90, "wake", ""),
            ("send skips the batch", [fact("a", EPOCH + 99, batch=False)], observation(), EPOCH + 100, "wake", ""),
            ("send carries the batch with it", [fact("a", EPOCH + 99), fact("b", EPOCH + 99, batch=False)],
             observation(), EPOCH + 100, "wake", ""),
            ("not found holds", [fact("a")], None, EPOCH + 100, "hold", "not found"),
            ("blocked holds", [fact("a")], observation("blocked"), EPOCH + 100, "hold", "blocked"),
            ("unknown holds", [fact("a")], observation("unknown"), EPOCH + 100, "hold", "status unknown"),
            ("unreadable holds", [fact("a")], observation(problem="cannot read"), EPOCH + 100, "hold", "cannot read"),
            ("working still wakes", [fact("a")], observation("working"), EPOCH + 100, "wake", ""),
            ("engaged gets a note", [fact("a")], observation(human=EPOCH + 40), EPOCH + 100, "note", "you prompted"),
            ("engagement lapses", [fact("a")], observation(human=EPOCH - 600), EPOCH + 100, "wake", ""),
        ]
        for what, pending, seen, now, action, needle in cases:
            with self.subTest(what=what):
                plan = self.decide(pending, seen, now)
                self.assertEqual(plan.action, action, plan.reason)
                self.assertIn(needle, plan.reason)
        self.assertIsNone(self.decide([], observation()))
        self.assertEqual(self.decide([fact("a")], None, missing="herdr unreachable").reason, "herdr unreachable")

    def test_faults_switch_one_safeguard_each_only_in_the_lab(self):
        young = [fact("a", EPOCH + 99)]
        engaged = observation(human=EPOCH + 90)
        os.environ[sb.FAULT_ENV] = "no-batch,no-engagement-gate"
        self.assertEqual(self.decide(young, engaged).action, "wait")  # not in the Lab: no effect
        os.environ[sb.LAB_ENV] = "1"
        os.environ[sb.FAULT_ENV] = "no-batch"
        self.assertEqual(self.decide(young, engaged).action, "note")
        os.environ[sb.FAULT_ENV] = "no-engagement-gate"
        self.assertEqual(self.decide([fact("a")], engaged).action, "wake")


# ------------------------------------------------------------------ composing

class TestCompose(unittest.TestCase):
    def test_header_then_each_item_in_full(self):
        text, carried = sb.compose("platform", [
            fact("b", EPOCH + 1, summary="Second\nwith detail", kind="review", sender="coder", issue=7),
            fact("a", EPOCH, summary="First thing"),
        ])
        self.assertEqual(text.splitlines(), [
            "[switchboard] 2 for platform: First thing",
            "- lab.fact from the fleet: First thing",
            "- review from coder (issue #7): Second",
            "  with detail",
        ])
        self.assertEqual([f.key for f in carried], ["a", "b"])

    def test_the_cap_leaves_the_rest_pending_and_says_so(self):
        facts = [fact("k%02d" % n, EPOCH + n, summary="x" * 300) for n in range(30)]
        text, carried = sb.compose("platform", facts, cap=1000)
        self.assertLessEqual(len(text), 1000)
        self.assertEqual(len(carried), 2)
        self.assertTrue(text.endswith("\u2026 and 28 more: run fleet-switchboard pending platform"))
        self.assertEqual([f.key for f in carried], ["k00", "k01"])

    def test_one_item_longer_than_the_cap_is_cut_and_says_so(self):
        text, carried = sb.compose("platform", [fact("big", summary="y" * 5000)], cap=500)
        self.assertEqual(len(text), 500)
        self.assertTrue(text.endswith("[cut at 500 characters]"))
        self.assertEqual(len(carried), 1)


# ------------------------------------------------------------------ delivering

class TestDeliver(Base):
    def setUp(self):
        super().setUp()
        self.world = World(self, agents=("platform", "coder"))

    def pass_(self):
        return self.world.engine.run_pass()

    def test_a_ripe_batch_becomes_one_wake_with_keys_and_audit_around_it(self):
        self.world.fact("platform", "lab.fact:1", "First")
        self.world.tick(30)
        self.world.fact("platform", "lab.fact:2", "Second")
        self.assertEqual(self.pass_()["waiting"], ["platform"])
        self.world.tick(60)
        report = self.pass_()
        self.assertEqual([s["keys"] for s in report["sent"]], [["lab.fact:1", "lab.fact:2"]])
        (admitted,) = self.world.admissions("platform")
        sid = self.world.sessions["platform"]
        self.assertEqual((admitted["resume"], admitted["delivery"]), (True, "queue"))
        self.assertEqual(admitted["id"], sb.derive_message_id(sid, ["lab.fact:1", "lab.fact:2"]))
        self.assertEqual(admitted["from"], "switchboard")
        self.assertRegex(admitted["text"].splitlines()[0], r"^\[switchboard\] 2 for platform \(sent \d\d:\d\dZ(-\d\d:\d\dZ)?, delivered \d\d:\d\dZ\): First")
        intent, result = [e for e in self.world.audit() if e["event"] == "v2.synthetic"]
        self.assertEqual((intent["phase"], result["phase"], result["ok"]), ("intent", "result", True))
        self.assertEqual(intent["detail"]["message_id"], admitted["id"])
        (write,) = self.world.v2.writes
        self.assertEqual(write["audit_lines"], len(self.world.audit()) - 1)  # the intent was on disk first
        self.world.tick(5)
        self.assertEqual(self.pass_()["sent"], [])  # delivered keys are never sent again

    def test_engaged_means_a_note_that_starts_no_turn(self):
        self.world.you("platform")
        self.world.fact("platform", "lab.fact:1")
        self.world.tick(90)
        before = len(self.world.model_calls("platform"))
        self.pass_()
        (admitted,) = self.world.admissions("platform")
        self.assertEqual((admitted["resume"], admitted["delivery"]), (False, "steer"))
        self.assertEqual(len(self.world.model_calls("platform")), before)
        self.world.tick(5)
        self.assertEqual(self.pass_()["sent"], [])  # waiting in the inbox counts as delivered

    def test_steer_not_queue_makes_wakes_steer(self):
        os.environ[sb.FAULT_ENV] = "steer-not-queue"
        self.world.fact("platform", "lab.fact:1")
        self.world.tick(90)
        self.pass_()
        (admitted,) = self.world.admissions("platform")
        self.assertEqual((admitted["resume"], admitted["delivery"]), (True, "steer"))

    def test_the_recheck_sends_nothing_when_the_agent_changed(self):
        self.world.fact("platform", "lab.fact:1")
        self.world.tick(90)
        engine = self.world.engine
        plan = engine.plan("platform", engine.collect_facts()[0], engine.discover(self.world.clock.now()),
                           self.world.clock.now())
        self.assertEqual(plan.action, "wake")
        self.world.herdr.panes[self.world.panes["platform"]]["status"] = "blocked"
        outcome = engine.deliver(plan)
        self.assertEqual((outcome["sent"], outcome["action"]), (False, "hold"))
        self.assertEqual(self.world.admissions("platform"), [])
        (recheck,) = [e for e in self.world.audit() if e["event"] == "recheck"]
        self.assertEqual((recheck["detail"]["was"], recheck["detail"]["now"]), ("wake", "hold"))
        os.environ[sb.FAULT_ENV] = "no-recheck"
        self.assertTrue(engine.deliver(plan)["sent"])

    def test_the_recheck_follows_a_pane_that_now_shows_another_session(self):
        self.world.fact("platform", "lab.fact:1")
        self.world.tick(90)
        engine = self.world.engine
        plan = engine.plan("platform", engine.collect_facts()[0], engine.discover(self.world.clock.now()),
                           self.world.clock.now())
        self.world.herdr.panes[self.world.panes["platform"]]["session"] = self.world.sessions["coder"]
        outcome = engine.deliver(plan)
        self.assertFalse(outcome["sent"])
        self.assertIn("no longer shows", outcome["reason"])

    def test_holds_are_audited_once_per_reason_and_send_nothing(self):
        self.world.herdr.panes[self.world.panes["platform"]]["status"] = "blocked"
        self.world.fact("platform", "lab.fact:1")
        self.world.tick(90)
        for _ in range(3):
            report = self.pass_()
            self.world.tick(5)
        self.assertEqual(report["held"][0]["recipient"], "platform")
        self.assertEqual(len([e for e in self.world.audit() if e["event"] == "hold"]), 1)
        self.assertEqual(self.world.v2.writes, [])
        self.world.fact("ghost", "lab.fact:2")
        self.world.tick(90)
        held = {h["recipient"]: h["reason"] for h in self.pass_()["held"]}
        self.assertIn("not found", held["ghost"])

    def test_v2_down_holds_everything(self):
        self.world.fact("platform", "lab.fact:1")
        self.world.tick(90)
        self.world.v2.down = True
        report = self.pass_()
        self.assertIn("v2 unreachable", report["held"][0]["reason"])

    def test_the_same_keys_always_derive_the_same_id(self):
        os.environ[sb.FAULT_ENV] = "no-dedupe"
        self.world.fact("platform", "lab.fact:1")
        self.world.tick(90)
        first = self.pass_()["sent"][0]["message_id"]
        self.world.tick(5)
        second = self.pass_()["sent"][0]["message_id"]
        self.assertEqual(first, second)
        self.assertEqual(len(self.world.admissions("platform")), 1)

    def test_crash_after_send_leaves_an_intent_and_the_next_pass_sends_nothing(self):
        self.world.fact("platform", "lab.fact:1")
        self.world.tick(90)
        os.environ[sb.FAULT_ENV] = "crash-after-send"
        with self.assertRaises(sb.SimulatedCrash):
            self.pass_()
        events = [(e["event"], e.get("phase")) for e in self.world.audit()]
        self.assertEqual(events, [("v2.synthetic", "intent")])
        os.environ[sb.FAULT_ENV] = ""
        self.world.engine = self.world.new_engine()
        self.world.tick(5)
        self.assertEqual(self.pass_()["sent"], [])
        self.assertEqual(len(self.world.admissions("platform")), 1)

    def test_one_agents_failure_never_stops_the_others(self):
        self.world.fact("platform", "lab.fact:1")
        self.world.fact("coder", "lab.fact:2")
        self.world.tick(90)
        real = self.world.v2.op_session_synthetic

        def flaky(params, body):
            if params["sessionID"] == self.world.sessions["coder"]:
                raise FakeHTTP(500, "InternalError", "boom")
            return real(params, body)

        self.world.v2.op_session_synthetic = flaky
        report = self.pass_()
        self.assertEqual([s["recipient"] for s in report["sent"]], ["platform"])
        self.assertEqual([e["subject"] for e in report["errors"]], ["coder"])
        failed = [e for e in self.world.audit() if e["event"] == "v2.synthetic" and e["subject"] == "coder"]
        self.assertEqual([(e["phase"], e.get("ok")) for e in failed], [("intent", None), ("result", False)])
        self.assertTrue(any(e["event"] == "error" and e["subject"] == "coder" for e in self.world.audit()))

    def test_a_failing_source_is_audited_and_the_rest_still_run(self):
        def broken():
            raise RuntimeError("source down")
        engine = self.world.engine
        engine.sources.insert(0, broken)
        self.world.fact("platform", "lab.fact:1")
        self.world.tick(90)
        self.assertEqual(len(engine.run_pass()["sent"]), 1)
        self.assertTrue(any(e["event"] == "source.error" for e in self.world.audit()))

    def test_overflow_goes_in_the_next_message(self):
        for n in range(30):
            self.world.fact("platform", "lab.fact:%02d" % n, "z" * 400)
        self.world.tick(90)
        first = self.pass_()["sent"][0]
        self.assertGreater(first["left"], 0)
        self.world.tick(5)
        second = self.pass_()["sent"][0]
        self.assertTrue(set(first["keys"]).isdisjoint(second["keys"]))

    def test_a_read_only_engine_refuses_to_write(self):
        self.world.fact("platform", "lab.fact:1")
        self.world.tick(90)
        engine = self.world.new_engine(writable=False)
        plan = engine.plan("platform", engine.collect_facts()[0], engine.discover(self.world.clock.now()),
                           self.world.clock.now())
        with self.assertRaises(RuntimeError):
            engine.deliver(plan)
        self.assertEqual(self.world.v2.writes, [])


class TestConversion(Base):
    def setUp(self):
        super().setUp()
        self.world = World(self, agents=("platform",))
        self.world.you("platform")
        self.world.fact("platform", "lab.fact:1")
        self.world.tick(90)
        self.world.engine.run_pass()
        (self.note,) = self.world.admissions("platform")
        self.assertFalse(self.note["resume"])

    def test_a_note_waits_while_you_are_engaged(self):
        self.world.tick(400)
        self.assertEqual(self.world.engine.run_pass()["converted"], [])
        self.assertIsNone(self.note["delivered_at"])

    def test_a_note_that_outlives_engagement_becomes_a_wake(self):
        self.world.tick(600 - 90)
        report = self.world.engine.run_pass()
        self.assertEqual(report["converted"], [self.note["id"]])
        self.assertIsNotNone(self.note["delivered_at"])
        updates = [w for w in self.world.v2.writes if w["op"] == "session.inbox.update"]
        self.assertEqual(len(updates), 2)
        audited = [(e["detail"]["delivery"], e["phase"]) for e in self.world.audit() if e["event"] == "v2.inbox.update"]
        self.assertEqual(audited, [("queue", "intent"), ("queue", "result"), ("steer", "intent"), ("steer", "result")])
        self.assertEqual(self.world.model_calls("platform", "turn_start")[-1]["inputs"][0]["keys"], ["lab.fact:1"])

    def test_a_blocked_agent_keeps_its_note(self):
        self.world.herdr.panes[self.world.panes["platform"]]["status"] = "blocked"
        self.world.tick(600)
        self.assertEqual(self.world.engine.run_pass()["converted"], [])


# ------------------------------------------------------------------ steer into a working agent

class TestSteerToWorking(Base):
    """A boss's `send` to a working agent is steered into its turn (probe: lands after the in-flight tool call,
    before the next model request); an idle agent is woken; an engaged one gets the note; `send --interrupt`
    is the explicit stop."""

    def setUp(self):
        super().setUp()
        self.build({})

    def build(self, config):
        self.world = World(self, agents=("cos",), config=config)
        self.sid = self.world.add_agent("platform", fleet={"role": "orchestrator", "reports_to": "cos"})
        self.world.add_agent("coder", fleet={"role": "coder", "reports_to": "platform", "issue": 2})
        self.write_config(dict({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR}, **config))

    def work(self, lasts=60, steps=3):
        self.world.v2.start_turn(self.sid, "task", fleet=True, lasts=lasts, steps=steps)
        self.world.tick(5)

    def send(self, sender="cos", to="platform", interrupt=False):
        return self.world.engine.send(sender, to, "answer: use plan B", interrupt=interrupt)

    def admission(self):
        (admitted,) = self.world.admissions("platform")
        return admitted

    def test_a_boss_send_to_a_working_agent_is_steered_and_lands_before_its_turn_ends(self):
        self.work()
        self.assertTrue(self.send()["sent"])
        admitted = self.admission()
        self.assertEqual((admitted["delivery"], admitted["resume"]), ("steer", True))
        self.world.tick(60)
        self.assertEqual(admitted["delivered_at"], EPOCH + 20)  # the next step boundary, not the end (EPOCH + 60)
        between = self.world.model_calls("platform", "between_steps")
        self.assertEqual([[i["keys"] for i in c["inputs"]] for c in between][0], [admitted["keys"]])
        intent = [e for e in self.world.audit() if e["event"] == "v2.synthetic" and e["phase"] == "intent"][0]
        self.assertEqual((intent["detail"]["delivery"], intent["detail"]["busy"]), ("steer", True))
        self.assertEqual(self.world.v2.interrupts, [])  # a steer never interrupts

    def test_an_idle_agent_is_still_woken(self):
        self.assertTrue(self.send()["sent"])
        admitted = self.admission()
        self.assertEqual((admitted["delivery"], admitted["resume"]), ("queue", True))
        self.assertEqual([c["phase"] for c in self.world.model_calls("platform")], ["turn_start"])
        intent = [e for e in self.world.audit() if e["event"] == "v2.synthetic" and e["phase"] == "intent"][0]
        self.assertNotIn("busy", intent["detail"])

    def test_an_engaged_agent_gets_the_note_even_while_working(self):
        self.world.you("platform")
        self.work()
        self.assertTrue(self.send()["sent"])
        admitted = self.admission()
        self.assertEqual((admitted["delivery"], admitted["resume"]), ("steer", False))

    def test_the_queue_setting_restores_the_old_behaviour(self):
        self.build({"send_to_working": "queue"})
        self.work()
        self.assertTrue(self.send()["sent"])
        admitted = self.admission()
        self.assertEqual((admitted["delivery"], admitted["resume"]), ("queue", True))
        self.world.tick(60)
        self.assertEqual(admitted["delivered_at"], EPOCH + 60)  # after the final reply

    def test_only_a_send_from_its_own_boss_is_steered(self):
        self.work()
        self.assertTrue(self.send(sender="coder")["sent"])  # a worker's message to its boss's boss's peer: not a boss
        admitted = self.admission()
        self.assertEqual((admitted["delivery"], admitted["resume"]), ("queue", True))

    def test_a_steer_that_meets_a_finished_turn_wakes_the_agent_and_is_not_lost(self):
        self.work()
        # the turn ends between the engine's fresh look and the write
        self.world.v2.before_synthetic = lambda: (setattr(self.world.clock, "t", EPOCH + 61), self.world.v2.advance())
        self.assertTrue(self.send()["sent"])
        admitted = self.admission()
        self.assertEqual((admitted["delivery"], admitted["resume"]), ("steer", True))
        self.assertIsNotNone(admitted["delivered_at"])
        self.assertEqual(self.world.v2.sessions[self.sid]["inbox"], [])
        self.assertEqual(self.world.model_calls("platform", "turn_start")[-1]["inputs"][-1]["keys"], admitted["keys"])

    def test_the_setting_is_validated(self):
        for bad in ("steer ", "now", True, None, 1):
            with self.assertRaises(sb.ConfigError):
                sb.validate_config({"send_to_working": bad})
        self.assertEqual(sb.validate_config({})["send_to_working"], "steer")
        self.assertEqual(sb.validate_config({"send_to_working": "queue"})["send_to_working"], "queue")

    # -- send --interrupt

    def test_an_interrupt_cuts_the_turn_then_delivers_a_wake_in_that_order(self):
        self.work()
        outcome = self.send(interrupt=True)
        self.assertTrue(outcome["sent"])
        self.assertEqual([w["op"] for w in self.world.v2.writes], ["session.interrupt", "session.synthetic"])
        self.assertEqual(self.world.v2.interrupts, [{"session": self.sid, "resume": False, "was_busy": True,
                                                     "at": EPOCH + 5}])
        admitted = self.admission()
        self.assertEqual((admitted["delivery"], admitted["resume"]), ("queue", True))
        self.assertEqual(self.world.model_calls("platform", "turn_start")[-1]["inputs"][-1]["keys"], admitted["keys"])
        audit = [(e["event"], e["phase"]) for e in self.world.audit() if e["event"] in ("v2.interrupt", "v2.synthetic")]
        self.assertEqual(audit, [("v2.interrupt", "intent"), ("v2.interrupt", "result"),
                                 ("v2.synthetic", "intent"), ("v2.synthetic", "result")])
        result = [e for e in self.world.audit() if e["event"] == "v2.interrupt" and e["phase"] == "result"][0]
        self.assertTrue(result["detail"]["interrupted"])

    def test_an_interrupt_to_an_engaged_agent_is_still_a_wake(self):
        self.world.you("platform")
        self.work()
        self.assertTrue(self.send(interrupt=True)["sent"])
        self.assertEqual((self.admission()["delivery"], self.admission()["resume"]), ("queue", True))

    def test_an_interrupt_is_refused_unless_the_sender_is_the_recipients_boss(self):
        self.work()
        for sender, to in (("coder", "platform"), ("platform", "cos"), ("cos", "coder"), ("cos", "nobody")):
            with self.assertRaises(sb.InterruptRefused):
                self.send(sender=sender, to=to, interrupt=True)
        self.assertEqual(self.world.v2.interrupts, [])
        self.assertEqual(self.world.v2.writes, [])
        refused = [e for e in self.world.audit() if e["event"] == "interrupt.refused"]
        self.assertEqual([(e["subject"], e["detail"]["from"]) for e in refused],
                         [("platform", "coder"), ("cos", "platform"), ("coder", "cos"), ("nobody", "cos")])

    def test_a_held_interrupt_cuts_nothing(self):
        self.work()
        self.world.herdr.panes[self.world.panes["platform"]]["status"] = "blocked"
        self.assertFalse(self.send(interrupt=True)["sent"])
        self.assertEqual(self.world.v2.interrupts, [])

    def test_the_cli_flag_interrupts_and_a_stranger_is_refused(self):
        self.work()

        def main(*argv):
            with captured() as (out, err):
                code = sb.main(list(argv), runner=self.world.route, now=self.world.clock.now,
                               wait=lambda sock, seconds: False, socket_call=self.world.herdr.socket)
            return code, out.getvalue(), err.getvalue()
        code, _, err = main("send", "--interrupt", "--from", "coder", "platform", "stop")
        self.assertEqual(code, sb.EXIT_USAGE)
        self.assertIn("does not report to coder", err)
        self.assertEqual(self.world.v2.interrupts, [])
        code, _, err = main("send", "--interrupt", "--from", "cos", "platform", "stop", "now")
        self.assertEqual(code, 0, err)
        self.assertEqual(len(self.world.v2.interrupts), 1)
        self.assertIn("stop now", self.admission()["text"])
        self.world.tick(1)
        code, _, err = main("send", "--from", "cos", "platform", "plain")
        self.assertEqual(code, 0, err)
        self.assertEqual(len(self.world.v2.interrupts), 1)  # a plain send never interrupts

    def test_send_to_the_role_name_reaches_the_one_agent_with_that_role(self):
        self.world = World(self, agents=())
        self.world.add_agent("cos", fleet={"role": "chief-of-staff"})
        self.world.add_agent("platform", fleet={"role": "orchestrator", "reports_to": "chief-of-staff"})
        outcome = self.world.engine.send("platform", "chief-of-staff", "a question")
        self.assertTrue(outcome["sent"], outcome)
        self.assertEqual(len(self.world.admissions("cos")), 1)
        again = self.world.engine.send("platform", "cos", "by name still works")        # the registered name is unchanged
        self.assertIn("sent", again)
        self.world.add_agent("cos2", fleet={"role": "chief-of-staff"})                    # two chiefs: the alias is ambiguous, taken literally
        held = self.world.engine.send("platform", "chief-of-staff", "which one?")
        self.assertFalse(held["sent"])
        self.assertIn("no herdr pane shows a v2 session named chief-of-staff", held["reason"])

    def test_the_alias_with_no_chief_of_staff_is_taken_literally_and_an_interrupt_through_it_is_still_refused_to_a_non_boss(self):
        held = self.send(sender="coder", to="chief-of-staff")
        self.assertEqual(held["sent"], False)
        self.assertIn("named chief-of-staff", held["reason"])
        self.world.add_agent("chief", fleet={"role": "chief-of-staff"})
        with self.assertRaises(sb.InterruptRefused):
            self.world.engine.send("coder", "chief-of-staff", "stop", interrupt=True)
        self.assertEqual(self.world.v2.interrupts, [])

    def cli_send(self, *argv, to="platform"):
        with captured() as (out, err):
            code = sb.main(["send", "--from", "cos", to] + list(argv), runner=self.world.route, now=self.world.clock.now,
                           wait=lambda sock, seconds: False, socket_call=self.world.herdr.socket)
        return code, out.getvalue(), err.getvalue()

    # ---- #1131: the send path asks the registry's route (baseline of the pane route, endpoint route, mutants)
    BASELINE = REPO / "bin" / "send-route-baseline.json"

    def local_send_outcome(self):
        self.work()
        code, out, err = self.cli_send("hello", "there")
        return {"code": code, "stdout": re.sub(r"\S+", "<id>", out.strip()), "stderr": err, "admitted": self.admission()["text"]}

    def test_a_local_agent_with_a_pane_is_routed_exactly_as_before_a_stored_baseline(self):
        got = self.local_send_outcome()
        if os.environ.get("WRITE_SEND_BASELINE"):
            self.BASELINE.write_text(json.dumps(got, indent=1, sort_keys=True) + "\n")
        self.assertEqual(got, json.loads(self.BASELINE.read_text()))

    def endpoint_world(self, state="idle", endpoint="https://pod.example.invalid/channel"):
        self.work()
        self.registry = sb.load_module("registry")
        row = {"session": None, "kind": "orchestrator", "role": "orchestrator", "endpoint": endpoint}
        if state:
            row["state"] = state
        self.registry.upsert(self.world.state, "cloudy", row, now=1)
        self.posts = []

        def fake_deliver(client, url, sender, name, text, post=None, **kw):
            self.posts.append((url, sender, name, text))
            return True, ""
        patch = mock.patch.object(sb.load_module("endpoint_send"), "deliver", fake_deliver)
        patch.start()
        self.addCleanup(patch.stop)

    def test_an_agent_with_an_endpoint_and_no_pane_is_sent_to_its_registry_endpoint(self):
        self.endpoint_world()
        code, out, err = self.cli_send("ping", to="cloudy")
        self.assertEqual(code, 0, err)
        self.assertEqual(self.posts, [("https://pod.example.invalid/channel", "cos", "cloudy", "ping")])   # a send that ignores the endpoint (the old path) never posts
        self.assertEqual(self.world.admissions("platform"), [])

    def test_the_endpoint_route_holds_while_blocked_and_keeps_the_sender_identity(self):
        self.endpoint_world(state="blocked")
        code, _, err = self.cli_send("ping", to="cloudy")
        self.assertEqual(code, sb.EXIT_HELD)
        self.assertIn("blocked on a permission request", err)
        self.assertEqual(self.posts, [])
        self.registry.upsert(self.world.state, "cloudy", {"session": None, "kind": "orchestrator", "role": "orchestrator",
                                                          "endpoint": "https://pod.example.invalid/channel", "state": "idle"}, now=2)
        code, _, err = self.cli_send("ping", to="cloudy")
        self.assertEqual(self.posts[-1][1], "cos")   # the sender is the caller's identity, as on the pane route
        with captured() as (out, err2):
            os.environ.pop(sb.LAB_ENV, None)
            code = sb.main(["send", "--from", "someone", "cloudy", "x"], runner=self.world.route, now=self.world.clock.now,
                           wait=lambda sock, seconds: False, socket_call=self.world.herdr.socket)
        self.assertEqual(code, sb.EXIT_USAGE)   # --from outside the Lab is refused here as on the pane route

    def test_an_unknown_agent_and_a_half_read_send_nothing_and_say_why(self):
        self.endpoint_world()
        code, _, err = self.cli_send("ping", to="nobody")
        self.assertNotEqual(code, 0)
        self.assertIn("not found", err)
        self.assertEqual(self.posts, [])
        registry = sb.load_module("registry")
        real = registry.read
        half = lambda d: dict(real(d), whole=False)
        with mock.patch.object(registry, "read", half):
            code, _, err = self.cli_send("ping", to="cloudy")
        self.assertEqual(code, sb.EXIT_HELD)
        self.assertIn("only partly read", err)
        self.assertEqual(self.posts, [])

    def known_endpoint_half_send(self):
        registry = sb.load_module("registry")
        real = registry.read
        # a real torn registry.json reads whole False with no agents; this synthetic half read still carries the recipient's endpoint row
        with mock.patch.object(registry, "read", lambda d: dict(real(d), whole=False)):
            return self.cli_send("ping", to="cloudy")

    def test_a_known_endpoint_row_on_a_half_read_is_refused_with_a_named_reason_and_nothing_is_sent(self):
        self.endpoint_world()
        code, _, err = self.known_endpoint_half_send()
        self.assertEqual(code, sb.EXIT_HELD)
        self.assertIn("not sent", err)
        self.assertIn("only partly read", err)
        self.assertEqual(self.posts, [])
        self.assertEqual(self.world.admissions("platform"), [])

    def test_the_mutant_that_always_falls_through_on_a_half_read_fails_the_known_endpoint_test(self):
        self.endpoint_world()
        es = sb.load_module("endpoint_send")
        real_route = es.route

        def mutant(registry, state_dir, name):
            found = real_route(registry, state_dir, name)
            return found[:2] + (False,) if found[0] == "half" else found
        with mock.patch.object(es, "route", mutant):
            code, _, err = self.known_endpoint_half_send()
        self.assertNotEqual((code, "only partly read" in err), (sb.EXIT_HELD, True))   # the mutant no longer refuses: the test above would fail on it

    def test_a_redirect_is_refused_and_the_second_port_gets_no_request(self):
        import threading, http.server
        es, client = sb.load_module("endpoint_send"), sb.load_module("cloud_client")
        hits = {"a": 0, "b": 0}

        class B(http.server.BaseHTTPRequestHandler):
            def do_POST(h):
                hits["b"] += 1
                h.send_response(200); h.end_headers()
            do_GET = do_POST
            def log_message(h, *a): pass
        srv_b = http.server.HTTPServer(("127.0.0.1", 0), B)

        class A(B):
            def do_POST(h):
                hits["a"] += 1
                h.send_response(302)
                h.send_header("Location", "http://127.0.0.1:%d/x" % srv_b.server_address[1])
                h.end_headers()
        srv_a = http.server.HTTPServer(("127.0.0.1", 0), A)
        for srv in (srv_a, srv_b):
            threading.Thread(target=srv.serve_forever, daemon=True).start()
            self.addCleanup(srv.server_close)
            self.addCleanup(srv.shutdown)
        token = self.home / "agent-token"
        token.write_text("tok.en-1")
        post = es.http_post("http://127.0.0.1:%d/" % srv_a.server_address[1])
        ok, line = client.send("cos", "cloudy", "ping", post, token_path=str(token), retries=1)
        self.assertFalse(ok)
        self.assertIn("the endpoint answered with a redirect", line)
        self.assertEqual(hits, {"a": 1, "b": 0})

    def test_a_half_read_still_delivers_to_a_pane_agent_by_the_old_path(self):
        self.work()
        registry = sb.load_module("registry")
        with mock.patch.object(registry, "read", side_effect=OSError("unreadable")):
            code, out, err = self.cli_send("hello", "there")
        self.assertEqual(code, 0, err)
        self.assertEqual(len(self.world.admissions("platform")), 1)
        real = registry.read
        with mock.patch.object(registry, "read", lambda d: dict(real(d), whole=False)):
            code, out, err = self.cli_send("hello", "again")
        self.assertEqual(code, 0, err)

    def test_the_endpoint_scheme_and_size_rules(self):
        es, client = sb.load_module("endpoint_send"), sb.load_module("cloud_client")
        for url, want in (("https://x.example.com/c", True), ("http://x.example.com/c", False), ("http://hub.cw.svc:80", True),
                          ("http://hub.cw.svc.cluster.local/", True), ("http://hub:8443", True), ("ftp://hub", False), ("http://", False)):
            self.assertEqual(es.endpoint_ok(url), want, url)
        token = self.home / "agent-token"
        token.write_text("tok.en-1")
        seen = []
        post = lambda request: seen.append(request) or {"status": 200}
        ok, line = es.deliver(client, "https://x.example.com", "cos", "c", "x" * (16 * 1024 + 1), post=post, token_path=str(token))
        self.assertFalse(ok)
        self.assertIn("over 16384 bytes", line)
        self.assertEqual(seen, [])
        ok, _ = es.deliver(client, "https://x.example.com", "cos", "c", "x" * 16 * 1024, post=post, token_path=str(token))
        self.assertTrue(ok)

    def test_mutants_that_follow_redirects_or_refuse_the_half_case_are_caught(self):
        import urllib.request
        es = sb.load_module("endpoint_send")
        # a default-redirect handler would follow: the real handler must refuse
        h = es._NoRedirect()
        req = urllib.request.Request("https://a.example.com", data=b"{}", headers={"Authorization": "Bearer t"})
        self.assertIsNone(h.redirect_request(req, None, 302, "Found", {}, "https://b.example.com"))
        self.assertIs(es._NoRedirect.redirect_request is urllib.request.HTTPRedirectHandler.redirect_request, False)
        # the half case for a pane agent must not be refused by the real route
        self.work()
        registry = sb.load_module("registry")
        real = registry.read
        with mock.patch.object(registry, "read", lambda d: dict(real(d), whole=False)):
            found = es.route(registry, self.world.state, "platform")
        self.assertEqual(found[0], "half")
        self.assertFalse(found[2])

    def test_the_endpoint_is_an_address_only_and_the_bearer_comes_from_the_clients_token_file(self):
        es, client = sb.load_module("endpoint_send"), sb.load_module("cloud_client")
        token = self.home / "agent-token"
        token.write_text("tok.en-1")
        seen = []
        post = lambda request: seen.append(request) or {"status": 200}
        ok, line = es.deliver(client, "http://cloud-hub.cw.svc:8443", "cos", "cloudy", "ping", post=post, token_path=str(token))
        self.assertTrue(ok, line)
        self.assertEqual(seen[0]["authorization"], "Bearer tok.en-1")
        self.assertEqual({k: seen[0]["body"][k] for k in ("sender", "recipient", "text")}, {"sender": "cos", "recipient": "cloudy", "text": "ping"})
        self.assertNotIn("tok.en-1", "http://cloud-hub.cw.svc:8443")
        ok, line = es.deliver(client, "file:///etc/passwd", "cos", "cloudy", "ping", post=post)
        self.assertFalse(ok)

    def test_the_docs_say_the_send_path_uses_the_route_function(self):
        text = (REPO / "docs" / "agent-registry.md").read_text()
        self.assertIn("The send path uses it", text)
        self.assertNotIn("not yet used by send", text)

    def test_a_send_that_hangs_ends_with_a_clear_line_not_a_silent_wait(self):
        import threading
        self.work()
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "send_timeout_seconds": 0.05})
        release = threading.Event()
        self.addCleanup(release.set)

        def stuck(args, runner, now):
            release.wait(30)                                  # a delivery that does not finish until the test lets it
            return 0
        with mock.patch.object(sb, "_cmd_send", stuck):
            code, out, err = self.cli_send("hi")
        self.assertEqual(code, sb.EXIT_ERROR)
        self.assertIn("did not finish within 0.05 s", err)
        self.assertIn("state is unknown", err)
        self.assertIn("pending platform", err)
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "send_timeout_seconds": 0.05})
        with mock.patch.object(sb, "_cmd_send", stuck):
            code, out, err = self.cli_send("hi", to="plat\x1b[31mform")
        self.assertNotIn("\x1b", err)

    def test_a_fast_send_is_unchanged_and_the_bound_has_a_default_and_is_validated(self):
        self.work()
        code, out, err = self.cli_send("ok")
        self.assertEqual(code, 0, err)
        self.assertRegex(out.strip(), r"^msg_[0-9a-f]+$")                      # the message id, as before
        self.assertIn("delivered to platform", err)

    def test_the_bound_has_a_default_and_is_validated(self):
        self.assertEqual(sb.DEFAULTS["send_timeout_seconds"], 60)
        for bad in (0, -1, "x"):
            with self.subTest(bad=bad), self.assertRaises(sb.ConfigError):
                sb.validate_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "send_timeout_seconds": bad})

    def test_run_bounded_hands_back_a_result_and_re_raises_the_workers_own_error(self):
        self.assertEqual(sb.run_bounded(lambda: 7, 5), (True, 7))
        with self.assertRaises(sb.InterruptRefused):
            sb.run_bounded(lambda: (_ for _ in ()).throw(sb.InterruptRefused("no")), 5)

    def test_a_broken_config_is_said_and_the_default_bound_applies(self):
        self.work()
        self.config_file.write_text("{not json")
        with mock.patch.object(sb, "_cmd_send", lambda a, r, n: 0):
            code, out, err = self.cli_send("hi")
        self.assertIn("the config could not be read", err)
        self.assertIn("default send bound of 60 s", err)

    def test_a_message_that_would_be_cut_is_refused_with_the_allowed_length_and_nothing_is_delivered(self):
        self.work()

        def send(*argv):
            with captured() as (out, err):
                code = sb.main(["send", "--from", "cos", "platform"] + list(argv), runner=self.world.route,
                               now=self.world.clock.now, wait=lambda sock, seconds: False, socket_call=self.world.herdr.socket)
            return code, out.getvalue(), err.getvalue()
        before = len(self.world.v2.__dict__.get("sent", [])) if hasattr(self.world.v2, "sent") else 0
        code, out, err = send("x" * 6000)
        self.assertEqual(code, sb.EXIT_USAGE)
        self.assertIn("message is 6000 characters", err)
        self.assertIn("nothing was sent", err)
        self.assertEqual(out, "")
        allowed = int(re.search(r"allowed text for this message is (\d+) characters", err).group(1))
        self.assertTrue(0 < allowed < sb.MESSAGE_CAP)
        self.assertNotIn("xxxx", json.dumps(self.world.v2.__dict__, default=str))   # nothing reached the recipient
        code, _, err = send("x" * (allowed + 1))                                   # one over the stated length is refused
        self.assertEqual(code, sb.EXIT_USAGE)
        self.world.tick(1)
        code, _, err = send("y" * allowed)                                         # exactly the stated length is delivered whole
        self.assertEqual(code, 0, err)
        self.world.tick(1)
        code, _, err = send("short")
        self.assertEqual(code, 0, err)


# ------------------------------------------------------------------- the CLI

class TestEngineCLI(Base):
    def setUp(self):
        super().setUp()
        self.world = World(self, agents=("platform", "coder"))
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})

    def main(self, *argv):
        with captured() as (out, err):
            code = sb.main(list(argv), runner=self.world.route, now=self.world.clock.now,
                           wait=lambda sock, seconds: False, socket_call=self.world.herdr.socket)
        return code, out.getvalue(), err.getvalue()

    def test_send_identifies_the_caller_by_its_pane_and_delivers_at_once(self):
        os.environ["HERDR_PANE_ID"] = self.world.panes["coder"]
        code, out, err = self.main("send", "platform", "--issue", "7", "PR", "is", "up")
        self.assertEqual(code, 0, err)
        (admitted,) = self.world.admissions("platform")
        self.assertEqual(out.strip(), admitted["id"])
        (key,) = admitted["keys"]
        self.assertTrue(key.startswith("send:coder:"), key)
        self.assertIn("- send from coder (issue #7): PR is up", admitted["text"])
        self.assertTrue(admitted["resume"])
        cli = [e for e in self.world.audit() if e["event"] == "v2.synthetic"]
        self.assertEqual({e["actor"] for e in cli}, {"cli"})

    def test_send_is_a_note_while_you_talk_to_the_recipient(self):
        self.world.you("platform")
        os.environ["HERDR_PANE_ID"] = self.world.panes["coder"]
        self.assertEqual(self.main("send", "platform", "hi")[0], 0)
        self.assertFalse(self.world.admissions("platform")[0]["resume"])

    def test_send_without_a_known_caller_is_refused(self):
        code, _, err = self.main("send", "platform", "hi")
        self.assertEqual(code, 1)
        self.assertIn("HERDR_PANE_ID", err)
        stranger = self.world.v2.create_session({})
        self.world.herdr.add("w5:p5", stranger)
        os.environ["HERDR_PANE_ID"] = "w5:p5"
        code, _, err = self.main("send", "platform", "hi")
        self.assertEqual(code, 1)
        self.assertIn("not a fleet agent", err)
        self.assertEqual(self.world.v2.writes, [])

    def test_from_is_only_for_the_lab(self):
        os.environ.pop(sb.LAB_ENV)
        code, _, err = self.main("send", "platform", "--from", "coder", "hi")
        self.assertEqual(code, 2)
        self.assertIn("only for the Lab", err)
        os.environ[sb.LAB_ENV] = "1"
        self.assertEqual(self.main("send", "platform", "--from", "coder", "hi")[0], 0)

    def test_a_held_send_says_why_and_sends_nothing(self):
        self.world.herdr.panes[self.world.panes["platform"]]["status"] = "blocked"
        code, out, err = self.main("send", "platform", "--from", "coder", "hi")
        self.assertEqual((code, out), (sb.EXIT_HELD, ""))
        self.assertIn("blocked", err)
        self.assertEqual(self.world.v2.writes, [])
        self.assertEqual(self.main("send", "nobody", "--from", "coder", "hi")[0], sb.EXIT_HELD)

    def test_pending_is_read_only_and_says_why(self):
        self.world.fact("platform", "lab.fact:1", "First")
        self.world.tick(10)
        code, out, _ = self.main("pending", "platform")
        self.assertEqual(code, 0)
        self.assertIn("lab.fact:1", out)
        self.assertIn("wait (batching until", out)
        code, out, _ = self.main("pending", "platform", "--json")
        self.assertEqual(json.loads(out)["plan"]["action"], "wait")
        self.assertEqual(self.world.v2.writes, [])
        self.assertEqual(self.world.audit(), [])

    def test_status_lists_the_fleet(self):
        self.world.fact("ghost", "lab.fact:9")
        code, out, _ = self.main("status")
        self.assertEqual(code, 0, out)
        self.assertIn("2 fleet agent(s)", out)
        self.assertRegex(out, r"platform +idle +ses_")
        self.assertRegex(out, r"ghost +\(not found\) +1 pending: wait")
        report = json.loads(self.main("status", "--json")[1])
        self.assertEqual([a["name"] for a in report["agents"]["list"]], ["coder", "ghost", "platform"])
        self.assertEqual(self.world.v2.writes, [])

    def test_run_once_delivers_and_reports(self):
        self.world.fact("platform", "lab.fact:1")
        self.world.tick(90)
        code, out, _ = self.main("run", "--once", "--json")
        self.assertEqual(code, 0, out)
        self.assertEqual(len(json.loads(out)["sent"]), 1)
        self.assertEqual(len(self.world.admissions("platform")), 1)

    def test_run_once_under_crash_after_send_exits_like_a_crash(self):
        self.world.fact("platform", "lab.fact:1")
        self.world.tick(90)
        os.environ[sb.FAULT_ENV] = "crash-after-send"
        code, _, err = self.main("run", "--once")
        self.assertEqual(code, sb.EXIT_CRASH)
        self.assertIn("crashed", err)

    def test_an_unconfigured_v2_is_refused_before_anything_runs(self):
        self.write_config({"herdr": FAKE_HERDR})
        for argv in (("run", "--once"), ("send", "platform", "--from", "coder", "x"), ("pending", "platform")):
            code, _, err = self.main(*argv)
            self.assertEqual(code, 1, argv)
            self.assertIn("'opencode' is not configured", err)
        self.assertEqual(self.world.v2.calls + self.world.herdr.calls, [])

    def test_real_processes_answer_in_one_line_when_v2_is_down(self):
        opencode = self.fake_bin("opencode", "echo '{\"name\":\"Down\"}'\necho 'HTTP 503 Service Unavailable' >&2\nexit 1\n")
        agent = '{"pane_id":"w1:p1","agent_status":"idle","agent_session":"ses_1"}'
        herdr = self.fake_bin("herdr", "echo '{\"result\":{\"agents\":[%s],\"agent\":%s}}'\n" % (agent, agent))
        self.write_config({"opencode": str(opencode), "herdr": str(herdr), "call_timeout_seconds": 5})
        os.environ["HERDR_PANE_ID"] = "w1:p1"
        for argv, code in ((("run", "--once"), 0), (("pending", "platform"), 0), (("send", "platform", "hi"), 1)):
            with self.subTest(argv=argv):
                proc = self.run_cli(SWITCHBOARD, *argv)
                self.assertEqual(proc.returncode, code, proc.stdout + proc.stderr)
                self.assertNotIn("Traceback", proc.stdout + proc.stderr)
        self.assertIn("v2 unreachable: http 503", self.run_cli(SWITCHBOARD, "pending", "platform").stdout)


class TestDaemon(Base):
    def setUp(self):
        super().setUp()
        self.world = World(self, agents=("platform",))

    def test_a_forgotten_fake_cannot_reach_a_real_binary(self):
        # Every test runs with PATH pinned; default clients find nothing to run.
        self.assertIsNone(shutil.which("herdr"))
        self.assertIsNone(shutil.which("opencode"))
        with self.assertRaises(sb.HerdrError) as caught:
            sb.HerdrClient(sb.DEFAULTS["herdr"]).agent_list()
        self.assertEqual(caught.exception.reason, "unavailable")

    def test_the_lock_admits_one_run(self):
        with sb.single_instance(self.world.state):
            with self.assertRaises(sb.LockError) as caught:
                with sb.single_instance(self.world.state):
                    pass
            self.assertIn("pid %d" % os.getpid(), str(caught.exception))
        with sb.single_instance(self.world.state):
            pass  # released when the holder ended
        self.assertEqual(stat.S_IMODE((self.world.state / "run.lock").stat().st_mode), 0o600)

    def test_run_refuses_while_another_holds_the_lock(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        with sb.single_instance(self.world.state):
            with captured() as (_, err):
                code = sb.main(["run", "--once"], runner=self.world.route, now=self.world.clock.now)
        self.assertEqual(code, 1)
        self.assertIn("holds", err.getvalue())

    def test_the_loop_passes_every_poll_and_survives_a_failing_pass(self):
        sleeps = []
        engine = self.world.engine
        real = engine.run_pass
        calls = []

        def run_pass():
            calls.append(1)
            if len(calls) == 2:
                raise RuntimeError("one bad pass")
            return real()

        engine.run_pass = run_pass
        self.assertEqual(sb.run_daemon(engine, self.world.state, 5, lambda sock, t: sleeps.append(t), passes=3), 3)
        self.assertEqual(sleeps, [5, 5])
        self.assertTrue(any(e["event"] == "error" and e["detail"]["step"] == "pass" for e in self.world.audit()))

    def test_run_without_once_stops_cleanly_on_interrupt(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "poll_seconds": 7})
        sleeps = []

        def wait(sock, seconds):
            sleeps.append(seconds)
            if len(sleeps) == 2:
                raise KeyboardInterrupt

        code = sb.main(["run"], runner=self.world.route, now=self.world.clock.now, wait=wait)
        self.assertEqual((code, sleeps), (0, [7, 7]))


# -------------------------------------------------- the poke socket, ensure, the plugin

class TestPoke(Base):
    def setUp(self):
        super().setUp()
        self.state = sb.ensure_state_dir()

    def test_a_poke_reaches_the_daemons_socket_and_a_burst_drains_at_once(self):
        sock = sb.open_poke_socket(self.state)
        self.addCleanup(sock.close)
        self.assertFalse(sb.wait_for_poke(sock, 0.01))
        for _ in range(3):
            self.assertTrue(sb.send_poke(self.state))
        self.assertTrue(sb.wait_for_poke(sock, 1))
        self.assertEqual(sb.drain_pokes(sock), 3)
        self.assertFalse(sb.wait_for_poke(sock, 0.05))
        self.assertEqual(stat.S_IMODE((self.state / sb.POKE_SOCKET).stat().st_mode), 0o600)

    def test_a_poke_with_no_daemon_is_false_not_an_error(self):
        self.assertFalse(sb.send_poke(self.state))  # no socket file
        self.assertFalse(sb.send_poke(self.home / "nowhere"))  # no state dir
        (self.state / sb.POKE_SOCKET).write_text("a stale file")
        self.assertFalse(sb.send_poke(self.state))  # a file nobody listens on

    def test_a_stale_socket_is_replaced(self):
        old = sb.open_poke_socket(self.state)
        old.close()  # the file stays, as after a crash
        self.assertTrue((self.state / sb.POKE_SOCKET).exists())
        new = sb.open_poke_socket(self.state)
        self.addCleanup(new.close)
        self.assertTrue(sb.send_poke(self.state))
        self.assertTrue(sb.wait_for_poke(new, 1))

    def test_the_state_dir_path_length_does_not_matter(self):
        deep = self.home
        while len(str(deep / sb.POKE_SOCKET)) < 150:
            deep = deep / "a-directory-with-a-long-name"
        deep.mkdir(parents=True)
        sock = sb.open_poke_socket(deep)
        self.addCleanup(sock.close)
        self.assertTrue(sb.send_poke(deep))
        self.assertTrue(sb.wait_for_poke(sock, 1))

    def test_the_working_directory_is_restored(self):
        before = os.getcwd()
        sb.send_poke(self.state)
        sock = sb.open_poke_socket(self.state)
        sock.close()
        self.assertEqual(os.getcwd(), before)

    def test_a_poke_to_a_full_socket_gives_up_instead_of_blocking(self):
        sock = sb.open_poke_socket(self.state)
        self.addCleanup(sock.close)
        started = time.time()
        results = [sb.send_poke(self.state) for _ in range(20000)]
        self.assertIn(False, results)  # the socket filled; the poke was dropped, not waited for
        self.assertLess(time.time() - started, 20)

    def test_the_poke_command_is_silent_and_always_exits_zero(self):
        # Its speed is the alarm's job (test_a_poke_is_bounded_by_its_alarm), not a wall clock around a process start.
        for setup in ("no state dir", "a daemon"):
            if setup == "a daemon":
                sock = sb.open_poke_socket(self.state)
                self.addCleanup(sock.close)
            result = self.run_cli(SWITCHBOARD, "poke")
            with self.subTest(setup=setup):
                self.assertEqual((result.returncode, result.stdout, result.stderr), (0, "", ""))
        self.assertTrue(sb.wait_for_poke(sock, 1))  # and the one to a daemon arrived

    def test_a_poke_is_bounded_by_its_alarm(self):
        self.assertLessEqual(sb.POKE_ALARM, 2)
        for raises in (False, True):
            events = []

            def send(*a, **k):
                events.append("send")
                if raises:
                    raise OSError("down")

            with self.subTest(raises=raises), mock.patch.object(sb.signal, "alarm", side_effect=lambda n: events.append(("alarm", n)) or 0), \
                    mock.patch.object(sb, "send_poke", side_effect=send):
                sb.cmd_poke(None)
            self.assertEqual(events, [("alarm", sb.POKE_ALARM), "send", ("alarm", 0)])

    def test_poke_never_calls_herdr_or_v2_and_needs_no_config(self):
        def boom(argv, **kwargs):
            raise AssertionError("poke ran %r" % argv)

        with captured() as (out, err):
            code = sb.main(["poke"], runner=boom)
        self.assertEqual((code, out.getvalue(), err.getvalue()), (0, "", ""))
        self.assertFalse(self.config_file.exists())

    def test_a_poke_arms_an_alarm_that_is_disarmed_after(self):
        sb.cmd_poke(None)
        self.assertEqual(signal.alarm(0), 0)  # nothing left armed in this process


class TestDaemonWaits(Base):
    def setUp(self):
        super().setUp()
        self.world = World(self, agents=("platform",))

    def counted(self, on_pass=None):
        passes = []
        real = self.world.engine.run_pass

        def run_pass():
            passes.append(time.time())
            if on_pass:
                on_pass(len(passes))
            return real()

        self.world.engine.run_pass = run_pass
        return passes

    def test_a_poke_makes_a_pass_at_once_not_after_the_poll(self):
        passes = self.counted()
        thread = threading.Thread(target=sb.run_daemon, args=(self.world.engine, self.world.state, 30, None, 2))
        thread.start()
        deadline = time.time() + 5
        while not passes and time.time() < deadline:
            time.sleep(0.01)
        self.assertTrue(passes)
        started = time.time()
        while not sb.send_poke(self.world.state) and time.time() < deadline:
            time.sleep(0.01)  # the socket is bound just after the lock is taken
        thread.join(8)
        self.assertFalse(thread.is_alive(), "30 s poll: the poke did not wake the daemon")
        self.assertEqual(len(passes), 2)
        self.assertLess(time.time() - started, 5)

    def test_every_poke_waiting_is_drained_before_the_next_pass(self):
        def burst(number):
            if number == 1:  # three events arrive during the first pass
                for _ in range(3):
                    sb.send_poke(self.world.state)

        passes = self.counted(burst)
        sb.run_daemon(self.world.engine, self.world.state, 0.6, None, passes=3)
        # pass 2 follows the burst at once; the burst made no pass 3 of its own,
        # so pass 3 waited out the poll.
        self.assertLess(passes[1] - passes[0], 0.4)
        self.assertGreaterEqual(passes[2] - passes[1], 0.5)

    def test_the_socket_is_closed_when_the_daemon_stops(self):
        sb.run_daemon(self.world.engine, self.world.state, 5, lambda sock, t: None, passes=1)
        self.assertFalse(sb.send_poke(self.world.state))

    def test_a_socket_that_cannot_be_bound_costs_only_the_wakeups(self):
        with mock.patch.object(sb, "open_poke_socket", side_effect=OSError(48, "Address already in use")):
            waits = []
            done = sb.run_daemon(self.world.engine, self.world.state, 5, lambda sock, t: waits.append(sock),
                                 passes=2)
        self.assertEqual((done, waits), (2, [None]))
        self.assertTrue(any(e["event"] == "poke.unavailable" for e in self.world.audit()))


class TestEnsure(Base):
    def setUp(self):
        super().setUp()
        self.state = sb.ensure_state_dir()
        self.spawned = []
        self.holders = []

    def spawn(self, argv, **kwargs):
        """Stands in for Popen: records the call and, like a daemon, takes the lock."""
        self.spawned.append((argv, kwargs))
        fd = os.open(str(self.state / "run.lock"), os.O_RDWR | os.O_CREAT)
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        self.holders.append(fd)
        self.addCleanup(os.close, fd)

    def test_it_starts_a_daemon_that_shares_nothing_with_the_hook(self):
        with mock.patch.dict(os.environ, {"HERDR_PLUGIN_ID": "x", "HERDR_PLUGIN_EVENT": "startup",
                                          "HERDR_PANE_ID": "w1:p1", "HERDR_TAB_ID": "w1:t1",
                                          "HERDR_WORKSPACE_ID": "w1", "HERDR_SOCKET_PATH": "/s/h.sock"}):
            outcome = sb.ensure_daemon(self.state, self.spawn)
        self.assertEqual(outcome, "started")
        argv, kwargs = self.spawned[0]
        self.assertEqual(argv, [sys.executable, str(SWITCHBOARD.resolve()), "run"])
        self.assertEqual(kwargs["stdin"], subprocess.DEVNULL)
        self.assertIs(kwargs["close_fds"], True)
        self.assertIs(kwargs["start_new_session"], True)
        self.assertEqual(kwargs["cwd"], str(self.state))
        env = kwargs["env"]
        self.assertEqual("HERDR_SOCKET_PATH" in env, True)
        for name in ("HERDR_PLUGIN_ID", "HERDR_PLUGIN_EVENT", "HERDR_PANE_ID", "HERDR_TAB_ID", "HERDR_WORKSPACE_ID"):
            self.assertNotIn(name, env)
        self.assertEqual(stat.S_IMODE((self.state / "daemon.log").stat().st_mode), 0o600)
        self.assertNotIn(kwargs["stdout"], (subprocess.PIPE, None, sys.stdout.fileno()))
        self.assertEqual(kwargs["stdout"], kwargs["stderr"])

    def test_a_running_daemon_is_left_alone(self):
        self.spawn([], )
        self.spawned.clear()
        self.assertEqual(sb.ensure_daemon(self.state, self.spawn), "running")
        self.assertEqual(self.spawned, [])

    def test_a_daemon_that_never_takes_its_lock_is_an_error_after_the_patience(self):
        waited = []
        with self.assertRaises(sb.LockError) as caught:
            sb.ensure_daemon(self.state, lambda argv, **kw: None, patience=0.3, sleep=waited.append)
        self.assertIn("daemon.log", str(caught.exception))
        self.assertGreaterEqual(len(waited), 5)

    def test_two_ensures_are_serialised_so_only_one_starts_a_daemon(self):
        starts = []

        def slow_spawn(argv, **kwargs):
            starts.append(1)
            time.sleep(0.3)
            self.spawn(argv, **kwargs)

        threads = [threading.Thread(target=sb.ensure_daemon, args=(self.state, slow_spawn)) for _ in range(2)]
        for thread in threads:
            thread.start()
        for thread in threads:
            thread.join(10)
        self.assertEqual(len(starts), 1)

    def test_the_daemon_environment_drops_the_hooks_pane_and_plugin_variables(self):
        env = sb.daemon_environment({"HERDR_PLUGIN_ROOT": "/p", "HERDR_PLUGIN_CONTEXT_JSON": "{}",
                                     "HERDR_PANE_ID": "w1:p1", "HERDR_TAB_ID": "t", "HERDR_WORKSPACE_ID": "w",
                                     "HERDR_SOCKET_PATH": "/s", "HERDR_BIN_PATH": "/b", "HOME": "/h"})
        self.assertEqual(sorted(env), ["HERDR_BIN_PATH", "HERDR_SOCKET_PATH", "HOME"])

    def test_a_real_ensure_returns_with_pipes_open_and_a_real_poke_wakes_the_real_daemon(self):
        log = self.home / "herdr-calls.log"
        herdr = self.fake_bin("herdr", 'echo "pane=[$HERDR_PANE_ID] plugin=[$HERDR_PLUGIN_ID]" >> %s\n'
                                       'echo \'{"result":{"agents":[]}}\'\n' % log)
        opencode = self.fake_bin("opencode", "exit 1\n")
        self.write_config({"opencode": str(opencode), "herdr": str(herdr), "poll_seconds": 3600})
        env = dict(os.environ, HERDR_PANE_ID="w9:p9", HERDR_PLUGIN_ID="fleet-switchboard")
        started = time.time()
        # capture_output reads to EOF: a daemon that inherited the pipes would hang this call.
        result = subprocess.run([sys.executable, "-B", str(SWITCHBOARD), "ensure"], capture_output=True,
                                text=True, env=env, timeout=20)
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(result.stdout.strip(), "daemon started")
        self.assertLess(time.time() - started, 5)
        pid = int((self.state / "run.lock").read_text())
        self.addCleanup(self._stop_daemon, pid)
        self.assertNotEqual(os.getsid(pid), os.getsid(0), "the daemon must have a session of its own")
        self.assertEqual(sb.ensure_daemon(self.state), "running")
        self.assertTrue(self._wait_for(lambda: log.exists() and len(log.read_text().splitlines()) >= 1))
        self.assertEqual(log.read_text().splitlines()[0], "pane=[] plugin=[]")  # the hook's identity is scrubbed
        before = len(log.read_text().splitlines())
        self.assertEqual(self.run_cli(SWITCHBOARD, "poke").returncode, 0)
        self.assertTrue(self._wait_for(lambda: len(log.read_text().splitlines()) > before),
                        "the poke did not make the daemon pass (poll is an hour)")

    def _stop_daemon(self, pid):
        """Stop the daemon this test started and wait until it is gone: it writes into the temporary state
        directory, and the directory is removed right after (a daemon still writing made that removal fail)."""
        if _alive(pid):
            os.kill(pid, signal.SIGTERM)
        if not self._wait_for(lambda: not _alive(pid), seconds=10) and _alive(pid):
            os.kill(pid, signal.SIGKILL)
            self._wait_for(lambda: not _alive(pid), seconds=5)

    @staticmethod
    def _wait_for(condition, seconds=10):
        deadline = time.time() + seconds
        while time.time() < deadline:
            if condition():
                return True
            time.sleep(0.05)
        return False


def _alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def parse_plugin_manifest(text):
    """Just enough TOML for herdr/herdr-plugin.toml: `key = "string"`, `key = ["a", "b"]`,
    and `[[table]]` headers. Anything else raises, so the file cannot drift
    past what this reads."""
    manifest, table = {}, None
    for number, raw in enumerate(text.splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        header = re.match(r"^\[\[([a-z]+)\]\]$", line)
        if header:
            table = {}
            manifest.setdefault(header.group(1), []).append(table)
            continue
        pair = re.match(r'^([a-z_]+) = (.+)$', line)
        if not pair:
            raise ValueError("line %d is not understood: %r" % (number, raw))
        try:
            value = json.loads(pair.group(2))  # these strings and arrays are valid JSON too
        except ValueError:
            value = None
        if not (isinstance(value, str) or (isinstance(value, list) and all(isinstance(v, str) for v in value))):
            raise ValueError("line %d: value is not a string or a list of strings: %r" % (number, raw))
        (table if table is not None else manifest)[pair.group(1)] = value
    return manifest


class TestPluginManifest(Base):
    PATH = REPO / "herdr" / "herdr-plugin.toml"
    EVENTS = ("pane.agent_status_changed", "pane.created", "pane.closed", "pane.exited", "pane.agent_detected")

    def manifest(self):
        return parse_plugin_manifest(self.PATH.read_text())

    def test_the_manifest_names_the_plugin_and_the_herdr_it_needs(self):
        m = self.manifest()
        self.assertEqual((m["id"], m["min_herdr_version"]), ("fleet-switchboard", "0.9.3"))
        for key in ("name", "version", "description", "platforms"):
            self.assertIn(key, m)

    def test_startup_ensures_and_every_event_pokes(self):
        m = self.manifest()
        self.assertEqual([t["command"] for t in m["startup"]], [["../bin/fleet-switchboard", "ensure"]])
        self.assertEqual(sorted(t["on"] for t in m["events"]), sorted(self.EVENTS))
        for event in m["events"]:
            self.assertEqual(event["command"], ["../bin/fleet-switchboard", "poke"], event["on"])

    def test_every_command_resolves_from_the_plugin_root_to_an_executable_subcommand(self):
        m = self.manifest()
        root = self.PATH.parent  # herdr runs hooks with the manifest's directory as cwd
        commands = [t["command"] for t in m["startup"] + m["events"]]
        choices = set(sb.build_parser()._subparsers._group_actions[0].choices)
        for command in commands:
            program = (root / command[0]).resolve()
            with self.subTest(command=command):
                self.assertEqual(program, SWITCHBOARD.resolve())
                self.assertTrue(os.access(str(program), os.X_OK))
                self.assertIn("/", command[0])  # herdr joins only a path with a slash to the root
                self.assertIn(command[1], choices)
                self.assertEqual(len(command), 2)  # no shell, no arguments to quote

    def test_the_reader_refuses_what_it_does_not_understand(self):
        for text in ('x = 1\n', 'key: "v"\n', '[table]\n', 'command = [a, b]\n'):
            with self.subTest(text=text), self.assertRaises(ValueError):
                parse_plugin_manifest(text)
        planted = self.PATH.read_text().replace("../bin/fleet-switchboard", "../bin/nowhere", 1)
        root = self.PATH.parent
        self.assertFalse((root / parse_plugin_manifest(planted)["startup"][0]["command"][0]).exists())


# --------------------------------------------------------- the restart hazard

class TestRestartGuard(Base):
    """After a herdr restart a pane can come back as a shell, and herdr resumes
    the agent by typing `opencode` into it, which may start another OpenCode.
    Nothing is delivered to a pane that does not run the configured v2."""

    def setUp(self):
        super().setUp()
        self.world = World(self, agents=("platform",))
        self.pane = self.world.panes["platform"]

    def wrong_program(self, program="/opt/homebrew/bin/opencode --session ses_x"):
        self.world.herdr.panes[self.pane]["program"] = program

    def test_runs_program_means_the_executable_alone_or_with_arguments(self):
        exe = "/v2/bin/opencode"
        for cmdline, expected in ((exe, True), (exe + " -s ses_1", True), (exe + "-v1 -s x", False),
                                  ("/opt/homebrew/bin/opencode", False), ("-zsh", False), (None, False)):
            with self.subTest(cmdline=cmdline):
                self.assertEqual(sb.runs_program(cmdline, exe), expected)

    def test_a_pane_on_another_program_is_held_and_nothing_is_written(self):
        self.wrong_program()
        self.world.fact("platform", "lab.fact:1", batch=False)
        report = self.world.engine.run_pass()
        self.assertEqual(self.world.v2.writes, [])
        self.assertEqual(report["sent"], [])
        self.assertIn("different opencode", report["held"][0]["reason"])
        self.assertTrue(any(e["event"] == "hold" and "different opencode" in e["detail"]["reason"]
                            for e in self.world.audit()))

    def test_the_guard_is_audited_even_when_nothing_is_pending(self):
        self.wrong_program()
        self.world.engine.run_pass()
        self.world.engine.run_pass()  # a steady state is audited once, not every pass
        guards = [e for e in self.world.audit() if e["event"] == "program.guard"]
        self.assertEqual(len(guards), 1)
        self.assertEqual(guards[0]["subject"], "platform")

    def test_it_is_toasted_once_and_the_hold_ends_when_the_pane_is_right(self):
        self.wrong_program("-zsh")
        self.world.fact("platform", "lab.fact:1", batch=False)
        self.world.engine.run_pass()
        self.world.tick(5)
        self.world.engine.run_pass()
        self.assertEqual([t["title"] for t in self.world.herdr.toasts], ["platform: pane runs a different opencode"])
        self.wrong_program("%s -s %s" % (FAKE_OPENCODE, self.world.sessions["platform"]))
        self.world.tick(5)
        report = self.world.engine.run_pass()
        self.assertEqual(len(report["sent"]), 1)

    def test_the_recheck_before_a_write_sees_a_pane_that_changed_meanwhile(self):
        self.world.fact("platform", "lab.fact:1", batch=False)
        engine = self.world.engine
        discovery = engine.discover(self.world.clock.now())
        facts, _ = engine.collect_facts()
        plan = engine.plan("platform", facts, discovery, self.world.clock.now())
        self.assertEqual(plan.action, "wake")
        self.wrong_program()
        outcome = engine.deliver(plan)
        self.assertFalse(outcome["sent"])
        self.assertEqual(outcome["action"], "hold")
        self.assertEqual(self.world.v2.writes, [])

    def test_send_is_refused_for_such_a_pane(self):
        self.wrong_program()
        outcome = self.world.new_engine("cli").send("coder", "platform", "hi")
        self.assertEqual(outcome["action"], "hold")
        self.assertEqual(self.world.v2.writes, [])

    def test_a_pane_that_cannot_be_read_is_held_not_assumed_fine(self):
        self.world.herdr.panes[self.pane]["program"] = None
        original = self.world.herdr._process_info

        def failing(rest):
            raise LookupError("no such pane")

        self.world.herdr._process_info = failing
        self.world.fact("platform", "lab.fact:1", batch=False)
        report = self.world.engine.run_pass()
        self.assertEqual(report["sent"], [])
        self.assertIn("cannot read what pane", report["held"][0]["reason"])
        self.world.herdr._process_info = original

    def test_a_wrapper_is_checked_by_the_executable_it_runs(self):
        world = World(self, agents=("platform",), config={
            "opencode": "/fake/bin/wrapper", "opencode_executable": FAKE_OPENCODE})
        world.fact("platform", "lab.fact:1", batch=False)
        self.assertEqual(len(world.engine.run_pass()["sent"]), 1)  # the pane runs FAKE_OPENCODE
        other = World(self, agents=("platform",), config={
            "opencode": "/fake/bin/wrapper", "opencode_executable": "/fake/bin/the-real-one"},
            state=self.home / "other")
        other.fact("platform", "lab.fact:1", batch=False)
        self.assertEqual(other.engine.run_pass()["sent"], [])

    def test_a_relative_executable_is_a_config_error(self):
        with self.assertRaises(sb.ConfigError):
            sb.validate_config({"opencode_executable": "opencode"})
        with self.assertRaises(sb.ConfigError):
            sb.validate_config({"launch_env": {"A": 1}})


# --------------------------------------------------------- the render step

class TestRender(Base):
    def setUp(self):
        super().setUp()
        self.world = World(self, agents=("platform", "coder"))
        self.engine = self.world.engine

    def pane(self, name="platform"):
        return self.world.herdr.panes[self.world.panes[name]]

    def block(self, name="platform"):
        self.pane(name)["status"] = "blocked"

    def badge_writes(self):
        return [a for a in self.world.herdr.calls if a[2:3] == ["report-metadata"]]

    def test_held_items_are_the_badge_and_it_is_written_only_when_it_changes(self):
        self.block()
        self.world.fact("platform", "lab.fact:1", batch=False)
        self.world.fact("platform", "lab.fact:2", batch=False)
        report = self.engine.run_pass()
        self.assertEqual(report["badges"], [{"agent": "platform", "count": 2}])
        self.assertEqual(self.pane()["tokens"], {"unread": "2"})
        self.assertEqual(len(self.badge_writes()), 1)
        self.world.tick(5)
        self.engine.run_pass()
        self.assertEqual(len(self.badge_writes()), 1)  # the agent list already shows 2

    def test_the_badge_is_restored_after_herdr_forgets_its_tokens(self):
        self.block()
        self.world.fact("platform", "lab.fact:1", batch=False)
        self.engine.run_pass()
        self.pane()["tokens"] = {}  # a herdr restart
        self.engine.run_pass()
        self.assertEqual(self.pane()["tokens"], {"unread": "1"})

    def test_it_clears_when_nothing_is_unread_and_not_before(self):
        self.engine.run_pass()
        self.assertEqual(self.badge_writes(), [])  # nothing unread, no token: no write
        self.block()
        self.world.fact("platform", "lab.fact:1", batch=False)
        self.engine.run_pass()
        self.pane()["status"] = None
        self.world.tick(5)
        self.engine.run_pass()  # unblocked: the item is delivered as a wake
        self.assertEqual(self.pane()["tokens"], {})
        self.assertEqual(self.badge_writes()[-1][2:], ["report-metadata", self.world.panes["platform"],
                                                      "--source", "fleet-switchboard", "--clear-token", "unread"])

    def test_a_note_is_unread_until_a_turn_carries_it(self):
        self.world.you("platform")  # you are engaged: the next item is a note
        self.world.tick(1)
        self.world.fact("platform", "lab.fact:1", batch=False)
        self.world.fact("platform", "lab.fact:2", batch=False)
        self.engine.run_pass()
        self.assertEqual(len(self.world.v2.sessions[self.world.sessions["platform"]]["inbox"]), 1)
        self.assertEqual(self.pane()["tokens"], {"unread": "2"})  # one note, two facts
        self.world.tick(5)
        self.engine.run_pass()
        self.assertEqual(self.pane()["tokens"], {"unread": "2"})
        self.world.you("platform", "and next?")  # a turn starts and carries the note
        self.world.tick(5)
        self.engine.run_pass()
        self.assertEqual(self.pane()["tokens"], {})

    def test_a_wake_is_never_unread(self):
        self.world.fact("platform", "lab.fact:1", batch=False)
        self.engine.run_pass()
        self.assertEqual(self.pane()["tokens"], {})

    def test_badge_writes_are_audited_before_and_after(self):
        self.block()
        self.world.fact("platform", "lab.fact:1", batch=False)
        self.engine.run_pass()
        entries = [e for e in self.world.audit() if e["event"] == "herdr.badge"]
        self.assertEqual([e["phase"] for e in entries], ["intent", "result"])
        self.assertEqual((entries[0]["detail"]["count"], entries[0]["detail"]["was"]), (1, None))

    def test_a_blocked_agent_is_toasted_once_until_the_reason_changes(self):
        self.block()
        for _ in range(3):
            self.engine.run_pass()
            self.world.tick(5)
        self.assertEqual([t["title"] for t in self.world.herdr.toasts], ["platform is blocked"])
        self.pane()["status"] = None
        self.engine.run_pass()
        self.world.tick(5)
        self.block()  # blocked again: a new reason after the old one cleared
        self.engine.run_pass()
        self.assertEqual(len(self.world.herdr.toasts), 2)

    def test_an_item_held_fifteen_minutes_is_toasted_and_not_before(self):
        self.world.fact("ghost", "lab.fact:1", batch=False)
        self.engine.run_pass()
        self.world.tick(14 * 60)
        self.engine.run_pass()
        self.assertEqual(self.world.herdr.toasts, [])
        self.world.tick(61)
        self.engine.run_pass()
        self.assertEqual([t["title"] for t in self.world.herdr.toasts], ["ghost: 1 item(s) held"])
        self.assertIn("ghost not found", self.world.herdr.toasts[0]["body"])
        self.world.tick(5)
        self.engine.run_pass()
        self.assertEqual(len(self.world.herdr.toasts), 1)

    def test_a_changed_hold_reason_is_a_new_toast(self):
        self.world.fact("platform", "lab.fact:1", batch=False)
        self.world.herdr.panes[self.world.panes["platform"]]["status"] = "unknown"
        self.engine.run_pass()
        self.world.tick(16 * 60)
        self.engine.run_pass()
        self.assertEqual(len(self.world.herdr.toasts), 1)
        self.block()
        self.world.tick(5)
        self.engine.run_pass()
        self.assertEqual([t["title"] for t in self.world.herdr.toasts],
                         ["platform: 1 item(s) held", "platform is blocked"])

    def test_one_notification_call_per_pass_even_with_two_reasons(self):
        self.block("platform")
        self.block("coder")
        self.engine.run_pass()
        calls = [a for a in self.world.herdr.calls if a[1] == "notification"]
        self.assertEqual(len(calls), 1)
        self.world.tick(5)
        self.engine.run_pass()
        self.assertEqual(sorted(t["title"] for t in self.world.herdr.toasts),
                         ["coder is blocked", "platform is blocked"])

    def test_rate_limited_busy_and_no_client_are_owed_and_retried_next_pass(self):
        self.block()
        self.world.herdr.toast_replies = ["rate_limited", "busy", "no_foreground_client"]
        for expected in (0, 0, 0, 1):
            report = self.engine.run_pass()
            self.assertEqual(len(self.world.herdr.toasts), expected)
            self.world.tick(5)
        self.assertEqual([t["why"] for t in report["toasts"]], ["shown"])

    def test_disabled_is_final_and_not_retried(self):
        self.block()
        self.world.herdr.toast_replies = ["disabled"]
        for _ in range(3):
            self.engine.run_pass()
            self.world.tick(5)
        self.assertEqual(len([a for a in self.world.herdr.calls if a[1] == "notification"]), 1)

    def test_the_reply_is_audited(self):
        self.block()
        self.world.herdr.toast_replies = ["rate_limited"]
        self.engine.run_pass()
        entries = [e for e in self.world.audit() if e["event"] == "herdr.notification"]
        self.assertEqual([e["phase"] for e in entries], ["intent", "result"])
        self.assertEqual(entries[1]["detail"]["reply"], {"shown": False, "reason": "rate_limited"})

    def test_a_failing_toast_never_stops_a_delivery(self):
        self.block("coder")
        self.world.fact("platform", "lab.fact:1", batch=False)
        self.world.herdr.toast_replies = []
        real = self.world.herdr._notification_show
        self.world.herdr._notification_show = lambda rest: (_ for _ in ()).throw(LookupError("herdr broke"))
        report = self.engine.run_pass()
        self.world.herdr._notification_show = real
        self.assertEqual(len(report["sent"]), 1)
        self.assertEqual([e["step"] for e in report["errors"]] if False else
                         [e["subject"] for e in report["errors"]], [None])

    def test_a_read_only_engine_renders_nothing(self):
        self.block()
        self.world.fact("platform", "lab.fact:1", batch=False)
        self.world.new_engine(writable=False).run_pass()
        self.assertEqual(self.badge_writes(), [])
        self.assertEqual(self.world.herdr.toasts, [])


# ------------------------------------------------------------------- launching

class TestLaunch(StandInPids, Base):
    def setUp(self):
        super().setUp()
        self.world = World(self, agents=("platform",))
        self.work = self.home / "work"
        self.work.mkdir()
        self.order = []
        v2, herdr = self.world.v2, self.world.herdr

        def tracing(label, fake):
            def run(argv, **kwargs):
                self.order.append((label, argv[1:4] if label == "herdr" else argv[2:3]))
                return fake(argv, **kwargs)
            return run

        def socket_call(*args):
            self.order.append(("socket", list(args[1:2])))
            return herdr.socket(*args)

        config = dict(self.world.config, opencode_env={"XDG_CONFIG_HOME": "/lab/config"},
                      launch_env={"FLEET_SWITCHBOARD_LAB_PANE": "1"})
        self.engine = sb.Switchboard(config, sb.V2Client(FAKE_OPENCODE, {}, tracing("v2", v2), 5),
                                     sb.HerdrClient(FAKE_HERDR, tracing("herdr", herdr), socket_call=socket_call),
                                     sb.AuditLog(self.world.audit_path), sb.fact_sources(self.world.state),
                                     self.world.clock.now, "cli")
        self.sleeps = []
        patch = mock.patch.object(sb, "PANE_SETTLE_SECONDS", 0)       # the two looks before a close are instant in tests
        patch.start()
        self.addCleanup(patch.stop)
        self.terminal_problem = None                                  # None: the test shell is the operator's own terminal; a test sets a string to say it is not
        term = mock.patch.object(sb, "owner_terminal_problem", lambda *a, **k: self.terminal_problem)
        term.start()
        self.addCleanup(term.stop)
        env = mock.patch.dict(os.environ, {}, clear=False)            # restores HERDR_PANE_ID and the workspace even when an assertion fails
        env.start()
        self.addCleanup(env.stop)

    def sleep(self, seconds):
        self.sleeps.append(seconds)
        self.world.tick(seconds)

    def launch(self, **overrides):
        args = dict(name="coder", agent="coder", directory=str(self.work), workspace="w1", role="coder",
                    reports_to="platform", issue=7, brief="Add a health check", patience=5, sleep=self.sleep)
        args.update(overrides)
        return sb.launch_agent(self.engine, **args)

    def new_session(self, done):
        return self.world.v2.sessions[done["session"]]

    def test_it_creates_the_session_opens_the_tab_verifies_and_only_then_briefs(self):
        done = self.launch()
        session = self.new_session(done)
        self.assertEqual(session["metadata"], {"fleet": {"name": "coder", "role": "coder",
                                                         "reports_to": "platform", "issue": 7}})
        self.assertEqual((session["agent"], session["directory"], session["title"]),
                         ("coder", str(self.work), "coder"))
        method, params = self.world.herdr.socket_calls[0]
        self.assertEqual(method, "layout.apply")
        self.assertEqual(params["workspace_id"], "w1")
        self.assertEqual(params["root"]["command"], [FAKE_OPENCODE, "-s", done["session"]])
        self.assertEqual(params["root"]["env"], {"XDG_CONFIG_HOME": "/lab/config", "FLEET_SWITCHBOARD_LAB_PANE": "1",
                                                     "FLEET_SWITCHBOARD_ROLE": "coder", "FLEET_SWITCHBOARD_OWN_GH": "", **sb.NO_CREDENTIAL_DIALOG_ENV})  # PR 18: who this pane is; the switchboard's own-gh marker is blanked
        self.assertEqual(done["pane"], "w1:p%d" % self.world.herdr._pane_n)
        brief = [m for m in session["messages"] if m["type"] == "user"]
        self.assertEqual([(m["text"], m["metadata"]) for m in brief],
                         [("Add a health check", {"fleet": {"from": "switchboard", "brief": True}})])
        opened = self.order.index(("socket", ["layout.apply"]))
        prompt = self.order.index(("v2", ["session.prompt"]))
        between = self.order[opened:prompt]  # after the tab opens and before the brief: the checks
        self.assertIn(("herdr", ["agent", "get", done["pane"]]), between)
        self.assertIn(("herdr", ["pane", "process-info", "--pane"]), between)

    def test_an_orchestrators_charter_is_recorded_so_the_chief_of_staff_can_find_its_asks(self):
        done = self.launch(name="platform2", role="orchestrator", issue=1, charter=1)
        self.assertEqual(self.new_session(done)["metadata"]["fleet"]["charter"], 1)
        self.assertNotIn("charter", self.new_session(self.launch(name="coder2"))["metadata"]["fleet"])

    def test_a_charter_must_be_an_issue_number(self):
        for bad in (0, -3, "1", True):
            with self.subTest(charter=bad), self.assertRaises(sb.LaunchError):
                self.launch(name="orch", role="orchestrator", charter=bad)

    # --- #767: each launched agent has its own private TMPDIR
    def wrapper_world(self):
        """Panes 'run through the wrapper': the temp root is a directory of this test (the fake v2 checks the program path, so the config is not changed)."""
        root = self.home / "profile-tmp"
        patch = mock.patch.object(sb, "agent_tmp_root", lambda config: root)
        patch.start()
        self.addCleanup(patch.stop)
        return root

    def test_s1_two_agents_on_one_profile_get_two_private_directories(self):
        root = self.wrapper_world()
        first, second = self.launch(name="coder"), self.launch(name="coder2")
        seen = []
        for done, name in ((first, "coder"), (second, "coder2")):
            env = [c[1]["root"]["env"] for c in self.world.herdr.socket_calls if c[1]["root"]["label"] == name][0]
            seen.append(env["FLEET_AGENT_TMPDIR"])
        self.assertEqual(seen, [str(root / "coder"), str(root / "coder2")])
        self.assertNotEqual(seen[0], seen[1])
        for path in seen:
            self.assertEqual(stat.S_IMODE(os.stat(path).st_mode), 0o700)

    def test_s2_a_directory_that_cannot_be_made_fails_the_launch_and_starts_nothing(self):
        root = self.wrapper_world()
        root.write_text("a file where the temp root should be")   # mkdir under it fails
        before = set(self.world.v2.sessions)
        with self.assertRaises(sb.LaunchError) as caught:
            self.launch()
        self.assertIn(str(root / "coder"), str(caught.exception))
        self.assertEqual(self.world.herdr.socket_calls, [])
        self.assertEqual(set(self.world.v2.sessions), before)

    def test_the_chief_of_staff_and_review_lanes_keep_the_shared_directory(self):
        root = self.wrapper_world()
        for name in ("cos", "planrev-a"):
            self.assertEqual(sb.agent_tmp_env(self.engine, name), {})
        self.assertFalse(root.exists())
        with self.assertRaises(sb.LaunchError):
            sb.agent_tmp_env(self.engine, "Bad/Name")

    def test_a_path_that_is_not_our_directory_fails_the_launch(self):
        root = self.wrapper_world()
        root.mkdir(parents=True)
        (root / "coder").symlink_to(self.home)
        with self.assertRaises(sb.LaunchError):
            self.launch()
        self.assertIn("not a plain directory", sb.reclaim_agent_tmp(self.engine, "coder")[0])

    def test_the_launch_environment_is_otherwise_unchanged(self):
        self.wrapper_world()
        self.launch()
        env = dict(self.world.herdr.socket_calls[0][1]["root"]["env"])
        del env["FLEET_AGENT_TMPDIR"]
        self.assertEqual(env, {"XDG_CONFIG_HOME": "/lab/config", "FLEET_SWITCHBOARD_LAB_PANE": "1", "FLEET_SWITCHBOARD_ROLE": "coder", "FLEET_SWITCHBOARD_OWN_GH": "", **sb.NO_CREDENTIAL_DIALOG_ENV})

    def test_retire_removes_an_empty_private_directory_and_keeps_one_with_files(self):
        root = self.wrapper_world()
        self.launch(name="coder")
        self.launch(name="coder2")
        (root / "coder2" / "body.md").write_text("x")
        self.assertEqual(sb.reclaim_agent_tmp(self.engine, "coder"), ["%s: removed (empty)" % (root / "coder")])
        self.assertFalse((root / "coder").exists())
        line = sb.reclaim_agent_tmp(self.engine, "coder2")[0]
        self.assertIn("kept (1 file(s)", line)
        self.assertTrue((root / "coder2" / "body.md").exists())

    # --- #846: a headless worker's private TMPDIR (made by the fleet-hooks plugin) is retired by the same rule
    def test_s5_retire_of_a_headless_workers_directory_removes_only_an_empty_one_inside_the_root(self):
        data = self.home / "xdg-data-846"
        root = data / sb.PROG / "profile" / "tmp"
        with mock.patch.dict(os.environ, {"XDG_DATA_HOME": str(data)}):
            self.assertEqual(sb.headless_tmp_root(), root)
            self.assertEqual(sb.reclaim_agent_tmp(self.engine, "coder"), [])   # a pane agent on a shared profile: not touched
            self.assertEqual(sb.reclaim_agent_tmp(self.engine, "coder", headless=True), [])   # no directory: nothing to say
            (root / "empty").mkdir(parents=True)
            (root / "full").mkdir()
            (root / "full" / "keep.txt").write_text("x")
            outside = self.home / "outside-846"
            outside.mkdir()
            (outside / "f").write_text("x")
            (root / "link").symlink_to(outside)
            self.assertEqual(sb.reclaim_agent_tmp(self.engine, "empty", headless=True), ["%s: removed (empty)" % (root / "empty")])
            self.assertFalse((root / "empty").exists())
            line = sb.reclaim_agent_tmp(self.engine, "full", headless=True)[0]
            self.assertIn("kept (1 file(s)", line)
            self.assertTrue((root / "full" / "keep.txt").exists())
            self.assertIn("not a plain directory", sb.reclaim_agent_tmp(self.engine, "link", headless=True)[0])
            self.assertTrue((outside / "f").exists())
            for hostile in ("../outside-846", "a/b", "..", "A\x00b", "x" * 80, "cos", "planrev-a"):
                self.assertEqual(sb.reclaim_agent_tmp(self.engine, hostile, headless=True), [], hostile)
            self.assertTrue(outside.exists())

    def test_the_temp_root_is_the_profiles_only_when_panes_run_through_the_wrapper(self):
        data = self.home / "xdg-data"
        with mock.patch.dict(os.environ, {"XDG_DATA_HOME": str(data)}):
            wrapper = str(data / sb.PROG / "bin" / sb.WRAPPER_NAME)
            self.assertEqual(sb.agent_tmp_root({"opencode": wrapper}), data / sb.PROG / "profile" / "tmp")
            self.assertIsNone(sb.agent_tmp_root({"opencode": "/some/other/opencode"}))

    def test_the_wrapper_takes_its_agents_directory(self):
        self.assertIn('export TMPDIR="${{FLEET_AGENT_TMPDIR:-$PROFILE/tmp}}"', sb.PRIVATE_WRAPPER_TEXT)
        self.assertIn('export TMPDIR="${FLEET_AGENT_TMPDIR:-$PROFILE/tmp}"', sb.PRIVATE_WRAPPER_TEXT.format(**{k: "x" for k in ("profile", "gh_config", "gh", "gh_user_flag", "fleet_bin", "state", "shims", "kit_bin", "key_pattern", "pane_env", "v2")}))

    # --- #947: files under an OS-cleaned temp area vanish after 3 days unread; durable scratch lives where the OS never looks
    @staticmethod
    def os_tmp_clean(top, now, days=3):
        """The operating system's rule, simulated on a directory of this test (never the real /tmp): a regular file whose access, modification AND change
        times are all older than `days` whole days is deleted (`find -atime +3 -mtime +3 -ctime +3 -delete`, the daily /tmp cleaner). Returns the removed names."""
        gone = []
        for dirpath, _dirs, files in os.walk(str(top)):
            for name in files:
                path = os.path.join(dirpath, name)
                info = os.lstat(path)
                if all(int((now - t) // 86400) > days for t in (info.st_atime, info.st_mtime, info.st_ctime)):
                    os.unlink(path)
                    gone.append(name)
        return sorted(gone)

    CLEANED_AREAS = ("/tmp", "/private/tmp", "/var/tmp", "/private/var/tmp", "/var/folders", "/private/var/folders")

    def durable_roots(self):
        """Every durable scratch root the docs section names, computed with XDG_DATA_HOME a PLAIN STRING under no cleaned area (the root functions touch no file):
        the pane's wrapper root, the headless root, and the wrapper's own fallback `$PROFILE/tmp` (for the Chief of Staff and the lanes). Returns (data, {name: root})."""
        data = "/home/user/.local/share"
        with mock.patch.dict(os.environ, {"XDG_DATA_HOME": data}):
            wrapper = "%s/%s/bin/%s" % (data, sb.PROG, sb.WRAPPER_NAME)
            text = sb.PRIVATE_WRAPPER_TEXT.format(**dict({k: "x" for k in ("gh_config", "gh", "gh_user_flag", "fleet_bin", "state", "shims", "kit_bin", "key_pattern", "pane_env", "v2")},
                                                         profile="%s/%s/profile" % (data, sb.PROG)))
            fallback = re.search(r'FLEET_AGENT_TMPDIR:-\$PROFILE/tmp', text)
            profile = re.search(r"^PROFILE=(\S+)$", text, re.M).group(1)
            return data, {"pane": str(sb.agent_tmp_root({"opencode": wrapper})), "headless": str(sb.headless_tmp_root()),
                          "fallback": (profile + "/tmp") if fallback else "missing"}

    def test_s3_a_file_unread_for_three_days_is_gone_in_a_cleaned_area(self):
        cleaned = self.home / "os-temp" / "agent-scratch"
        cleaned.mkdir(parents=True)
        for name in ("tool.sh", "fresh.sh"):
            (cleaned / name).write_text("echo hi\n")
        now = time.time()
        os.utime(str(cleaned / "tool.sh"), (now - 10 * 86400, now - 10 * 86400))
        later = now + 5 * 86400   # the cleaner's clock: a change time cannot be set back, so the clock moves forward instead
        self.assertEqual(self.os_tmp_clean(cleaned, later), ["fresh.sh", "tool.sh"])   # the reproduction: a file unread for 3 days is gone

    def check_durable_roots(self):
        data, roots = self.durable_roots()
        self.assertEqual(set(roots), {"pane", "headless", "fallback"})
        away = [os.path.realpath(a) for a in self.CLEANED_AREAS] + [os.path.realpath(tempfile.gettempdir()), tempfile.gettempdir()]
        for name, root in roots.items():
            self.assertTrue(root.startswith(data + "/"), (name, root))
            for area in away:
                self.assertFalse(root == area or root.startswith(area.rstrip("/") + "/"), (name, root, area))

    def test_s3_every_durable_root_is_under_the_data_directory_and_under_no_cleaned_area(self):
        self.check_durable_roots()

    def test_s3_a_root_moved_into_the_per_user_temp_area_fails_the_check(self):
        for target in ("agent_tmp_root", "headless_tmp_root"):
            with self.subTest(mutant=target):
                moved = Path(tempfile.gettempdir()) / sb.PROG / "profile" / "tmp"
                with mock.patch.object(sb, target, (lambda config: moved) if target == "agent_tmp_root" else (lambda: moved)):
                    with self.assertRaises(AssertionError):
                        self.check_durable_roots()

    def test_s3_a_wrapper_fallback_into_the_shared_temp_area_fails_the_check(self):
        mutant = sb.PRIVATE_WRAPPER_TEXT.replace("$PROFILE/tmp", "/tmp")
        self.assertNotEqual(mutant, sb.PRIVATE_WRAPPER_TEXT)
        with mock.patch.object(sb, "PRIVATE_WRAPPER_TEXT", mutant), self.assertRaises(AssertionError):
            self.check_durable_roots()

    def test_u1_a_retire_still_removes_an_empty_private_dir_and_keeps_a_non_empty_one(self):
        root = self.wrapper_world()
        (root / "coder").mkdir(parents=True)
        self.assertEqual(sb.reclaim_agent_tmp(self.engine, "coder"), ["%s: removed (empty)" % (root / "coder")])
        (root / "coder2").mkdir()
        (root / "coder2" / "note").write_text("x")
        self.assertIn("kept", sb.reclaim_agent_tmp(self.engine, "coder2")[0])   # a non-empty one is kept: nothing empties it
        self.assertTrue((root / "coder2" / "note").exists())

    def test_s4_the_shared_name_agents_take_the_profile_root_not_an_os_cleaned_area(self):
        # the wrapper exports FLEET_AGENT_TMPDIR when set, else the profile's tmp: so the Chief of Staff and the lanes (skipped by name) still land under the profile
        self.assertIn('export TMPDIR="${{FLEET_AGENT_TMPDIR:-$PROFILE/tmp}}"', sb.PRIVATE_WRAPPER_TEXT)
        doc = (Path(__file__).resolve().parent.parent / "docs" / "switchboard.md").read_text()
        section = doc.split("### What may delete under agent scratch", 1)[1].split("\n### ", 1)[0]
        may, never = section.split("**What may delete under agent scratch**", 1)[1].split("**What never deletes**", 1)
        for word in ("the OS cleaners", "the temp janitor", "**EMPTY**", "removing its own files"):
            self.assertIn(word, may)
        for word in ("worktree removal", "**non-empty**", "other agents' files", "docker reaper"):
            self.assertIn(word, never)

    def test_nothing_is_typed_and_focus_is_never_asked_for(self):
        self.launch()
        self.assertEqual(self.world.herdr.typing_attempts, [])
        for argv in self.world.herdr.calls:
            self.assertIn(argv[1:3], HERDR_ALLOWED)
        self.assertNotIn("focus", json.dumps(self.world.herdr.socket_calls).lower())

    def test_each_write_is_audited_before_and_after(self):
        self.launch()
        entries = [(e["event"], e["phase"]) for e in self.world.audit() if e["event"].startswith(("v2.", "herdr."))]
        self.assertEqual(entries, [("v2.session.create", "intent"), ("v2.session.create", "result"),
                                   ("herdr.layout.apply", "intent"), ("herdr.layout.apply", "result"),
                                   ("v2.session.prompt", "intent"), ("v2.session.prompt", "result")])
        layout = [e for e in self.world.audit() if e["event"] == "herdr.layout.apply"]
        self.assertEqual(layout[0]["detail"]["env_names"],
                         ["FLEET_SWITCHBOARD_LAB_PANE", "FLEET_SWITCHBOARD_ROLE"] + sorted(sb.NO_CREDENTIAL_DIALOG_ENV) + ["XDG_CONFIG_HOME"])
        self.assertNotIn("/lab/config", json.dumps(layout))  # names, never values
        self.assertEqual(layout[1]["detail"]["pane"], self.world.herdr.panes and layout[1]["detail"]["pane"])

    def test_no_brief_means_no_prompt(self):
        done = self.launch(brief=None)
        self.assertEqual([m for m in self.new_session(done)["messages"] if m["type"] == "user"], [])
        self.assertNotIn(("v2", ["session.prompt"]), self.order)

    def test_a_pane_that_is_not_the_configured_program_is_refused_and_closed(self):
        for mode in ("shell", "other-session", "undetected"):
            with self.subTest(mode=mode):
                world = World(self, agents=("platform",), state=self.home / ("state-" + mode))
                world.herdr.launch_mode = mode
                engine = sb.Switchboard(world.config, sb.V2Client(FAKE_OPENCODE, {}, world.v2, 5),
                                        sb.HerdrClient(FAKE_HERDR, world.herdr, socket_call=world.herdr.socket),
                                        sb.AuditLog(world.audit_path), [], world.clock.now, "cli")
                before = set(world.herdr.panes)
                with self.assertRaises(sb.LaunchError) as caught:
                    sb.launch_agent(engine, "coder", "coder", str(self.work), "w1", "coder", brief="hello",
                                    patience=3, sleep=lambda s: world.tick(s))
                new = set(world.herdr.panes) - before
                self.assertEqual(new, set(), "the pane this launch opened must be closed")
                self.assertEqual(len(world.herdr.closed), 1)
                self.assertIn("could not verify", str(caught.exception))
                self.assertIn("session ses_", str(caught.exception))
                users = [m for s in world.v2.sessions.values() for m in s["messages"]
                         if m["type"] == "user" and m["text"] == "hello"]
                self.assertEqual(users, [], "the brief must not be sent to an unverified pane")
                self.assertTrue(any(e["event"] == "herdr.pane.close" and e["phase"] == "result"
                                    for e in world.audit()))

    def test_verification_waits_for_herdr_to_name_the_session(self):
        world = World(self, agents=("platform",), state=self.home / "late")
        world.herdr.launch_mode = "undetected"
        engine = sb.Switchboard(world.config, sb.V2Client(FAKE_OPENCODE, {}, world.v2, 5),
                                sb.HerdrClient(FAKE_HERDR, world.herdr, socket_call=world.herdr.socket),
                                sb.AuditLog(world.audit_path), [], world.clock.now, "cli")
        sleeps = []

        def sleep(seconds):
            sleeps.append(seconds)
            world.tick(seconds)
            for entry in world.herdr.panes.values():
                if sleeps and len(sleeps) == 2:
                    entry.pop("undetected", None)

        done = sb.launch_agent(engine, "coder", "coder", str(self.work), "w1", brief="hello", patience=10, sleep=sleep)
        self.assertEqual(len(sleeps), 2)
        self.assertEqual(world.herdr.closed, [])
        self.assertTrue(done["pane"])

    def test_only_the_pane_it_opened_is_ever_closed(self):
        self.world.herdr.launch_mode = "shell"
        before = dict(self.world.herdr.panes)
        with self.assertRaises(sb.LaunchError):
            self.launch(patience=2)
        self.assertEqual(self.world.herdr.panes, before)  # platform's pane untouched
        self.assertEqual(len(self.world.herdr.closed), 1)
        self.assertNotIn(self.world.herdr.closed[0], before)

    def test_a_failed_layout_closes_nothing(self):
        self.world.herdr.socket_down = True
        with self.assertRaises(sb.LaunchError) as caught:
            self.launch()
        self.assertEqual(self.world.herdr.closed, [])
        self.assertIn("no pane was opened", str(caught.exception))

    def test_a_name_already_in_use_is_refused_before_anything_is_created(self):
        before = len(self.world.v2.sessions)
        with self.assertRaises(sb.LaunchError) as caught:
            self.launch(name="platform")
        self.assertIn("already runs", str(caught.exception))
        self.assertEqual((len(self.world.v2.sessions), self.world.herdr.socket_calls), (before, []))

    def test_bad_arguments_are_refused_before_anything_is_created(self):
        cases = [dict(name="Bad Name"), dict(name=""), dict(directory="relative/dir"),
                 dict(directory=str(self.home / "missing")), dict(workspace=None), dict(agent=""), dict(issue=0)]
        for overrides in cases:
            with self.subTest(overrides=overrides), self.assertRaises(sb.LaunchError):
                self.launch(**overrides)
        self.assertEqual((self.world.v2.calls, self.world.herdr.socket_calls), ([], []))

    # -- the control plane: a detached pane is found, and `reattach` repairs it without a prompt

    def detach(self, name="platform", screen="  Build auto · model\n"):
        """The pane is up, but shows a fresh Build screen: herdr's agent_session still names the old session (it is stale), the title does not."""
        pane = self.world.panes[name]
        self.world.herdr.panes[pane]["title"] = "OpenCode"
        self.world.herdr.panes[pane]["screen"] = screen
        self.world.herdr.panes[pane]["program"] = FAKE_OPENCODE            # a fresh opencode: no `-s <session>` (a stale screen)
        self.world.v2.sessions[self.world.sessions[name]]["directory"] = str(self.work)
        return pane

    def health(self, offset=0):
        self.engine.state_dir = self.world.state
        self.engine.discover(self.world.clock.now())
        sb.pane_health_pass(self.engine, self.world.clock.now() + offset)

    # -- #973: the daemon's own call of the migration (the pass), not the function alone

    class LiveBells:
        """A herdr client whose live lists carry tab ids and labels: delegates everything else to the real fake."""
        def __init__(self, real, agents, tabs):
            self.real, self.agents, self.tabs = real, agents, tabs

        def __getattr__(self, name):
            return getattr(self.real, name)

        def agent_list(self):
            return self.agents

        def tab_list(self):
            return self.tabs

    def recorded_world(self, agents, tabs):
        registry = sb.load_module("registry")
        pane, sid = self.world.panes["platform"], self.world.sessions["platform"]
        registry.upsert(self.world.state, "platform", {"pane": pane, "session": sid, "role": "worker"}, now=1)
        self.engine.herdr = self.LiveBells(self.engine.herdr, [dict(a, pane_id=pane) for a in agents], tabs)
        return registry, pane

    def test_the_pass_runs_the_migration_a_belled_pane_gets_bell_true_and_the_marker_exists(self):
        registry, pane = self.recorded_world([{"tab_id": "t1"}], [{"tab_id": "t1", "label": "\U0001f514 lead"}])
        self.health()
        self.assertIs(registry.read(self.world.state)["agents"]["platform"]["bell"], True)
        self.assertTrue(registry.bell_migrated(self.world.state))

    def test_the_mutant_that_drops_the_call_from_the_pass_fails_the_check_above(self):
        registry, pane = self.recorded_world([{"tab_id": "t1"}], [{"tab_id": "t1", "label": "\U0001f514 lead"}])
        with mock.patch.object(sb, "bell_migration", lambda *a, **k: None):
            self.health()
        self.assertIsNone(registry.read(self.world.state)["agents"]["platform"].get("bell"))   # the pass-level test would fail: no field, no marker
        self.assertFalse(registry.bell_migrated(self.world.state))

    def test_a_whole_but_empty_live_list_writes_no_marker_while_agents_are_recorded(self):
        registry, pane = self.recorded_world([], [])
        self.health()
        self.assertFalse(registry.bell_migrated(self.world.state))
        self.assertIsNone(registry.read(self.world.state)["agents"]["platform"].get("bell"))
        self.assertTrue([e for e in self.world.audit() if e["event"] == "fleetpane.error" and "pending" in json.dumps(e)])
        self.engine.herdr = self.LiveBells(self.engine.herdr.real, [{"pane_id": pane, "tab_id": "t1"}], [{"tab_id": "t1", "label": "plain"}])
        self.health()   # herdr answers again: it runs, and the agent is not belled
        self.assertIs(registry.read(self.world.state)["agents"]["platform"]["bell"], False)
        self.assertTrue(registry.bell_migrated(self.world.state))

    def state(self, name="platform"):
        obs = self.engine.discover(self.world.clock.now()).agents[name]
        return sb.pane_state(self.engine, name, obs.session_id, obs.pane, ["platform", "coder"], [])[0]

    def test_an_attached_pane_is_attached_a_fresh_screen_with_a_stale_session_value_is_detached_and_a_missing_pane_is_dead(self):
        self.assertEqual(self.state(), sb.PANE_ATTACHED)                   # the title names the agent
        pane = self.detach()
        self.assertEqual(self.state(), sb.PANE_DETACHED)                   # herdr still lists the session, yet nothing on screen names it
        self.world.herdr.panes[pane]["title"] = "opencode -s %s" % self.world.sessions["platform"]
        self.assertEqual(self.state(), sb.PANE_ATTACHED)                   # the session id in the title is enough
        obs = self.engine.discover(self.world.clock.now()).agents["platform"]
        self.world.herdr.panes.pop(pane)
        self.assertEqual(sb.pane_state(self.engine, "platform", obs.session_id, pane)[0], sb.PANE_DEAD)
        self.world.herdr.down = True
        self.assertEqual(sb.pane_state(self.engine, "platform", obs.session_id, pane)[0], sb.PANE_UNKNOWN, "unreachable herdr is never a verdict")

    def test_the_daemon_pass_audits_a_detached_pane_once_wakes_the_chief_of_staff_and_status_shows_it(self):
        self.world.add_agent("cos", fleet={"role": "chief-of-staff"})
        self.detach()
        self.health()
        self.health(1)
        events = [e for e in self.world.audit() if e["event"] == "fleetpane.detached"]
        self.assertEqual(len(events), 1)
        facts = [f for f in sb.PaneFacts.__call__(self.fact_source())]
        self.assertEqual([(f.recipient, f.kind) for f in facts], [("cos", "pane")])
        self.assertIn("platform is DETACHED", facts[0].summary)
        self.assertIn("reattach platform", facts[0].summary)
        self.assertEqual(facts[0].key.split(":")[:3], ["pane", "platform", "detached"])
        lines = sb.pane_health_status_lines(self.world.state)
        self.assertIn("platform DETACHED", lines[0])

    def fact_source(self):
        source = sb.PaneFacts()
        source.bind(self.engine)
        return source

    def test_reattach_releases_a_stale_fresh_screen_opens_a_tab_on_the_same_session_and_sends_no_prompt(self):
        pane = self.detach()
        session = self.world.sessions["platform"]
        sessions, messages = set(self.world.v2.sessions), len(self.world.v2.sessions[session]["messages"])
        os.environ["HERDR_WORKSPACE_ID"] = "w1"
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        with captured() as (out, err):
            code = sb.main(["reattach", "platform"], runner=self.world.route, now=self.world.clock.now, socket_call=self.world.herdr.socket)
        self.assertEqual(code, 0, err.getvalue())
        done = json.loads(out.getvalue())
        self.assertEqual(done["session"], session)
        self.assertIn("closed", done["released"][0])
        self.assertNotIn(pane, self.world.herdr.panes)                     # the stale tab is gone
        self.assertIn(done["pane"], self.world.herdr.panes)
        self.assertEqual(set(self.world.v2.sessions), sessions)
        self.assertEqual(len(self.world.v2.sessions[session]["messages"]), messages, "no prompt, no brief")
        self.assertEqual(self.world.herdr.typing_attempts, [])
        self.assertEqual(len([e for e in self.world.audit() if e["event"] == "fleetpane.reattached"]), 1)
        self.assertEqual(self.engine.discover(self.world.clock.now()).agents["platform"].pane, done["pane"])

    def test_reattach_refuses_a_pane_that_is_really_running_the_agent_and_one_showing_another_agent(self):
        os.environ["HERDR_WORKSPACE_ID"] = "w1"
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.world.v2.sessions[self.world.sessions["platform"]]["directory"] = str(self.work)
        with captured() as (out, err):
            code = sb.main(["reattach", "platform"], runner=self.world.route, now=self.world.clock.now, socket_call=self.world.herdr.socket)
        self.assertNotEqual(code, 0)
        self.assertIn("already runs", err.getvalue())
        self.assertEqual(self.world.herdr.closed, [])
        self.world.add_agent("coder")                                       # a second fleet agent whose name is on that screen
        pane = self.detach(screen="  coder auto\n")                         # a screen that shows ANOTHER fleet agent is somebody's: not stale
        with captured() as (out, err):
            code = sb.main(["reattach", "platform"], runner=self.world.route, now=self.world.clock.now, socket_call=self.world.herdr.socket)
        self.assertNotEqual(code, 0)
        self.assertIn("shows another fleet agent", err.getvalue())
        self.assertIn(pane, self.world.herdr.panes)
        self.assertEqual(self.world.herdr.closed, [])

    def test_a_resume_takes_repo_and_account_from_the_sessions_stored_metadata_and_refuses_a_different_caller_repo(self):
        self.world.add_agent("ops", fleet={"role": "orchestrator", "repo": "acme-ops/service", "reports_to": "cos", "charter": 5})
        session = self.world.sessions["ops"]
        self.world.v2.sessions[session]["directory"] = str(self.work)
        del self.world.herdr.panes[self.world.panes["ops"]]
        self.engine.accounts = sb.GhAccounts({"gh": "gh", "call_timeout_seconds": 5, "gh_users": {"acme-ops/service": "acct-ops"}},
                                             lambda argv, **kw: subprocess.CompletedProcess(argv, 0, "tok-ops\n", ""), lambda: 1.0, {"PATH": "/bin"})
        done = sb.resume_agent(self.engine, "ops", session, "w1", patience=5, sleep=self.sleep)
        env = self.world.herdr.panes[done["pane"]]["env"]
        self.assertEqual((env["FLEET_SWITCHBOARD_REPO"], env["FLEET_SWITCHBOARD_ROLE"], env["GH_TOKEN"]), ("acme-ops/service", "orchestrator", "tok-ops"))
        os.environ["HERDR_WORKSPACE_ID"] = "w1"
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        del self.world.herdr.panes[done["pane"]]
        for argv in (["launch", "ops", "--resume", session, "--repo", "acme/other"], ["reattach", "ops", "--session", session, "--repo", "acme/other"]):
            with captured() as (out, err):
                code = sb.main(argv, runner=self.world.route, now=self.world.clock.now, socket_call=self.world.herdr.socket)
            self.assertNotEqual(code, 0)
            self.assertIn("differs from the session's stored repo acme-ops/service", err.getvalue())

    def test_replace_closes_a_live_pane_with_the_wrong_account_under_the_same_guards_and_all_detached_walks_the_list(self):
        os.environ["HERDR_WORKSPACE_ID"] = "w1"
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        pane = self.world.panes["platform"]
        session = self.world.sessions["platform"]
        self.world.v2.sessions[session]["directory"] = str(self.work)
        herdr = self.world.herdr
        # an idle pane that RUNS `opencode -s <the agent's session>` is live and attached: never closed, with or without --replace
        for extra in ([], ["--replace"]):
            with captured() as (out, err):
                code = sb.main(["reattach", "platform"] + extra, runner=self.world.route, now=self.world.clock.now, socket_call=herdr.socket)
            self.assertNotEqual(code, 0)
            self.assertIn("runs its own live session", err.getvalue())
            self.assertEqual((herdr.closed, pane in herdr.panes), ([], True))
        # a plain title makes no difference
        herdr.panes[pane]["title"] = "OpenCode"
        with captured() as (out, err):
            code = sb.main(["reattach", "platform", "--replace"], runner=self.world.route, now=self.world.clock.now, socket_call=herdr.socket)
        self.assertNotEqual(code, 0)
        self.assertEqual(herdr.closed, [])
        # an opencode on ANOTHER session (named by its title) is not this agent's: without --replace it still "runs the agent" by title, with --replace it goes
        herdr.panes[pane]["program"] = "%s -s ses_someone_else" % FAKE_OPENCODE
        herdr.panes[pane]["title"] = "OC | platform"
        with captured() as (out, err):
            code = sb.main(["reattach", "platform"], runner=self.world.route, now=self.world.clock.now, socket_call=herdr.socket)
        self.assertNotEqual(code, 0)
        self.assertIn("--replace", err.getvalue())
        self.world.herdr.panes[pane]["status"] = "working"                  # a working pane is never replaced
        with captured() as (out, err):
            code = sb.main(["reattach", "platform", "--replace"], runner=self.world.route, now=self.world.clock.now, socket_call=self.world.herdr.socket)
        self.assertNotEqual(code, 0)
        self.assertEqual(self.world.herdr.closed, [])
        self.world.herdr.panes[pane]["status"] = None
        with captured() as (out, err):
            code = sb.main(["reattach", "platform", "--replace"], runner=self.world.route, now=self.world.clock.now, socket_call=self.world.herdr.socket)
        self.assertEqual(code, 0, err.getvalue())
        self.assertEqual(self.world.herdr.closed, [pane])
        herdr.closed.clear()
        with captured() as (out, err):
            code = sb.main(["reattach", "--all-detached"], runner=self.world.route, now=self.world.clock.now, socket_call=self.world.herdr.socket)
        self.assertEqual((code, out.getvalue().strip()), (0, "no agent is detached or dead"))

    def test_all_detached_walks_a_non_empty_list_says_each_failure_and_continues_and_the_account_warning_reaches_the_command(self):
        os.environ["HERDR_WORKSPACE_ID"] = "w1"
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.world.add_agent("ops", fleet={"role": "coder", "repo": "acme-ops/service"})
        for name in ("platform", "ops"):
            self.world.v2.sessions[self.world.sessions[name]]["directory"] = str(self.work)
        self.detach("platform")
        self.detach("ops")
        reg = sb.load_module("registry")   # the agent list reattach --all-detached walks is the registry's
        for name, row in (("platform", {"session": self.world.sessions["platform"], "pane": self.world.panes["platform"], "state": "detached"}),
                          ("ops", {"session": self.world.sessions["ops"], "pane": self.world.panes["ops"], "state": "detached"}),
                          ("ghost", {"session": "ses_gone", "pane": "w1:p99", "state": "dead"})):
            reg.upsert(str(self.world.state), name, row)
        base = self.world.route

        def wrong_login(argv, **kw):
            if argv[0] == "gh":
                return subprocess.CompletedProcess(argv, 0, "default-work\n", "")
            return base(argv, **kw)
        with captured() as (out, err):
            code = sb.main(["reattach", "--all-detached"], runner=wrong_login, now=self.world.clock.now, socket_call=self.world.herdr.socket)
        self.assertEqual(code, 1)                                           # one failed (the ghost), so the exit says so
        self.assertIn("ghost", err.getvalue())
        self.assertEqual(len([e for e in self.world.audit() if e["event"] == "fleetpane.reattached"]), 2, "the two repairable agents were both done")
        self.assertEqual(len(self.world.herdr.closed), 2)

    def test_replace_still_refuses_a_tab_with_a_second_pane(self):
        os.environ["HERDR_WORKSPACE_ID"] = "w1"
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        pane = self.world.panes["platform"]
        self.world.v2.sessions[self.world.sessions["platform"]]["directory"] = str(self.work)
        self.world.herdr.panes[pane]["program"] = "-zsh"                   # not running the agent's session, so --replace may judge it
        self.world.herdr.panes[pane]["title"] = "OC | platform"
        self.world.herdr.extra_panes = {self.world.herdr.tab_of(pane): ["a person's shell"]}
        with captured() as (out, err):
            code = sb.main(["reattach", "platform", "--replace"], runner=self.world.route, now=self.world.clock.now, socket_call=self.world.herdr.socket)
        self.assertNotEqual(code, 0)
        self.assertIn("holds 2 panes", err.getvalue())
        self.assertEqual(self.world.herdr.closed, [])
        self.world.herdr.extra_panes = {}

    def test_verify_account_failure_paths_say_a_fixed_line(self):
        engine = self.engine
        engine.accounts = sb.GhAccounts({"gh": "gh", "call_timeout_seconds": 5, "gh_users": {"acme-ops/service": "acct-ops"}},
                                        lambda argv, **kw: subprocess.CompletedProcess(argv, 0, "tok\n", ""), lambda: 1.0, {"PATH": "/bin"})
        fleet = {"repo": "acme-ops/service"}
        self.assertIn("could not be verified", sb.verify_account(engine, lambda a, **k: subprocess.CompletedProcess(a, 1, "", "x"), fleet))
        self.assertIn("could not be verified", sb.verify_account(engine, lambda a, **k: subprocess.CompletedProcess(a, 0, "\n", ""), fleet))
        def boom(a, **k):
            raise OSError("secret-token-text")
        line = sb.verify_account(engine, boom, fleet)
        self.assertIn("could not be verified", line)
        self.assertNotIn("secret", line)
        self.assertIsNone(sb.verify_account(engine, boom, {"repo": "acme/unmapped"}))

    def test_the_account_is_verified_after_a_reattach_and_a_mismatch_is_said(self):
        engine = self.engine
        engine.accounts = sb.GhAccounts({"gh": "gh", "call_timeout_seconds": 5, "gh_users": {"acme-ops/service": "acct-ops"}},
                                        lambda argv, **kw: subprocess.CompletedProcess(argv, 0, "tok\n", ""), lambda: 1.0, {"PATH": "/bin"})
        ok = lambda argv, **kw: subprocess.CompletedProcess(argv, 0, "acct-ops\n", "")
        bad = lambda argv, **kw: subprocess.CompletedProcess(argv, 0, "default-work\n", "")
        fleet = {"repo": "acme-ops/service"}
        self.assertIsNone(sb.verify_account(engine, ok, fleet))
        self.assertIn("default-work but acme-ops/service maps to acct-ops", sb.verify_account(engine, bad, fleet))
        self.assertIsNone(sb.verify_account(engine, bad, {}))

    def test_a_pane_active_between_the_two_looks_or_blocked_or_unreadable_is_never_closed_even_with_replace(self):
        os.environ["HERDR_WORKSPACE_ID"] = "w1"
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        pane = self.detach()
        herdr = self.world.herdr

        def run(*extra):
            with captured() as (out, err):
                code = sb.main(["reattach", "platform"] + list(extra), runner=self.world.route, now=self.world.clock.now, socket_call=herdr.socket)
            return code, err.getvalue()
        shows = iter(["  Build — typing a new line\n"])
        with mock.patch.object(sb.time, "sleep", lambda s: herdr.panes[pane].__setitem__("screen", next(shows))):
            herdr.panes[pane]["screen"] = "  Build\n"
            code, err = run()
        self.assertNotEqual(code, 0)
        self.assertIn("showed activity", err)
        self.assertEqual(herdr.closed, [])
        herdr.panes[pane]["screen"] = "  Build\n"
        herdr.panes[pane]["status"] = "blocked"
        code, err = run()
        self.assertIn("is blocked", err)
        self.assertEqual(herdr.closed, [])
        herdr.panes[pane]["status"] = None
        herdr.panes[pane]["read_fails"] = True
        code, err = run("--replace")
        self.assertNotEqual(code, 0)
        self.assertEqual((herdr.closed, pane in herdr.panes), ([], True))
        herdr.panes[pane]["read_fails"] = False
        code, err = run()                                                   # two agreeing, quiet looks: the close is allowed
        self.assertEqual(code, 0, err)
        self.assertEqual(herdr.closed, [pane])

    def test_only_the_operator_the_chief_of_staff_or_the_agents_own_boss_may_reattach_and_a_refusal_is_audited(self):
        os.environ["HERDR_WORKSPACE_ID"] = "w1"
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.world.add_agent("cos", fleet={"role": "chief-of-staff"})
        self.world.add_agent("boss", fleet={"role": "orchestrator"})
        self.world.add_agent("stranger", fleet={"role": "coder"})
        self.world.v2.sessions[self.world.sessions["platform"]]["metadata"]["fleet"]["reports_to"] = "boss"
        pane = self.detach()
        for who, ok in (("stranger", False), ("cos", True)):
            os.environ["HERDR_PANE_ID"] = self.world.panes[who]
            with captured() as (out, err):
                code = sb.main(["reattach", "platform"], runner=self.world.route, now=self.world.clock.now, socket_call=self.world.herdr.socket)
            self.assertEqual(code == 0, ok, (who, err.getvalue()))
            if not ok:
                self.assertIn("may not reattach platform", err.getvalue())
                self.assertIn(pane, self.world.herdr.panes)
            else:
                self.assertNotIn(pane, self.world.herdr.panes)
        os.environ.pop("HERDR_PANE_ID", None)
        refused = [e for e in self.world.audit() if e["event"] == "fleetpane.reattach_refused"]
        self.assertEqual(len(refused), 1)
        self.assertEqual((refused[0]["subject"], refused[0]["detail"]["why"].startswith("stranger may not reattach platform")), ("platform", True))
        # no pane id and away from the owner's terminal: refused too; and an orchestrator who is NOT its boss
        self.terminal_problem = "stdin is not a terminal"
        os.environ.pop("HERDR_PANE_ID", None)
        self.world.panes["platform"] = self.engine.discover(self.world.clock.now()).agents["platform"].pane
        pane2 = self.detach()
        with captured() as (out, err):
            code = sb.main(["reattach", "platform"], runner=self.world.route, now=self.world.clock.now, socket_call=self.world.herdr.socket)
        self.assertNotEqual(code, 0)
        self.assertEqual(self.world.herdr.closed.count(pane2), 0)
        self.world.add_agent("other-orch", fleet={"role": "orchestrator"})
        os.environ["HERDR_PANE_ID"] = self.world.panes["other-orch"]
        with captured() as (out, err):
            code = sb.main(["reattach", "platform"], runner=self.world.route, now=self.world.clock.now, socket_call=self.world.herdr.socket)
        self.assertNotEqual(code, 0)
        self.assertIn("may not reattach platform", err.getvalue())
        self.assertIn(pane2, self.world.herdr.panes)
        self.terminal_problem = None
        os.environ.pop("HERDR_PANE_ID", None)
        self.world.panes["platform"] = self.engine.discover(self.world.clock.now()).agents["platform"].pane   # the pane the cos reattach opened
        pane = self.detach()                                                # a boss of the agent may
        os.environ["HERDR_PANE_ID"] = self.world.panes["boss"]
        with captured() as (out, err):
            code = sb.main(["reattach", "platform"], runner=self.world.route, now=self.world.clock.now, socket_call=self.world.herdr.socket)
        os.environ.pop("HERDR_PANE_ID", None)
        self.assertEqual(code, 0, err.getvalue())

    def test_two_concurrent_reattaches_of_one_agent_open_one_tab_the_second_is_told_and_another_agent_is_not_blocked(self):
        os.environ["HERDR_WORKSPACE_ID"] = "w1"
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.detach()
        before = len(self.world.herdr.socket_calls)
        with sb.agent_lock(self.world.state, "platform"), mock.patch.object(sb, "AGENT_LOCK_SECONDS", 0):   # a first reattach is running
            with captured() as (out, err):
                code = sb.main(["reattach", "platform"], runner=self.world.route, now=self.world.clock.now, socket_call=self.world.herdr.socket)
            self.assertNotEqual(code, 0)
            self.assertIn("another reattach of platform is running", err.getvalue())
            with captured() as (out, err):                                  # the same lock guards `launch --resume`
                code = sb.main(["launch", "platform", "--resume", self.world.sessions["platform"]], runner=self.world.route,
                               now=self.world.clock.now, socket_call=self.world.herdr.socket)
            self.assertNotEqual(code, 0)
            self.assertEqual((len(self.world.herdr.socket_calls), self.world.herdr.closed), (before, []))
            self.world.add_agent("ops")                                      # another agent's lock is a different file
            self.world.v2.sessions[self.world.sessions["ops"]]["directory"] = str(self.work)
            self.detach("ops")
            with captured() as (out, err):
                code = sb.main(["reattach", "ops"], runner=self.world.route, now=self.world.clock.now, socket_call=self.world.herdr.socket)
            self.assertEqual(code, 0, err.getvalue())
        with captured() as (out, err):
            code = sb.main(["reattach", "platform"], runner=self.world.route, now=self.world.clock.now, socket_call=self.world.herdr.socket)
        self.assertEqual(code, 0, err.getvalue())

    def test_launch_resume_by_a_stranger_closes_nothing_and_the_boss_of_a_dead_agent_may_reattach_it(self):
        os.environ["HERDR_WORKSPACE_ID"] = "w1"
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.world.add_agent("boss", fleet={"role": "coder"})
        self.world.add_agent("stranger", fleet={"role": "coder"})
        self.world.v2.sessions[self.world.sessions["platform"]]["metadata"]["fleet"]["reports_to"] = "boss"
        pane = self.detach()
        os.environ["HERDR_PANE_ID"] = self.world.panes["stranger"]
        with captured() as (out, err):
            code = sb.main(["launch", "platform", "--resume", self.world.sessions["platform"]], runner=self.world.route,
                           now=self.world.clock.now, socket_call=self.world.herdr.socket)
        self.assertNotEqual(code, 0)
        self.assertEqual((self.world.herdr.closed, pane in self.world.herdr.panes), ([], True))
        self.assertTrue([e for e in self.world.audit() if e["event"] == "fleetpane.reattach_refused" and e["detail"].get("via") == "launch --resume"])
        self.health()                                                      # the daemon remembers it, then its pane dies
        del self.world.herdr.panes[pane]
        os.environ["HERDR_PANE_ID"] = self.world.panes["boss"]
        with captured() as (out, err):
            code = sb.main(["reattach", "platform"], runner=self.world.route, now=self.world.clock.now, socket_call=self.world.herdr.socket)
        self.assertEqual(code, 0, err.getvalue())

    def test_a_shell_pane_is_closed_after_two_quiet_looks_and_an_unreadable_process_list_closes_nothing(self):
        os.environ["HERDR_WORKSPACE_ID"] = "w1"
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        pane = self.detach()
        herdr = self.world.herdr
        herdr.panes[pane]["program"] = "-zsh"                              # a shell, not opencode
        self.assertEqual(self.state(), sb.PANE_DETACHED)
        base = self.world.route

        def no_process_info(argv, **kw):
            if argv[0] == FAKE_HERDR and argv[1:3] == ["pane", "process-info"]:
                return subprocess.CompletedProcess(argv, 1, "", "error: timed out\n")
            return base(argv, **kw)
        with captured() as (out, err):
            code = sb.main(["reattach", "platform"], runner=no_process_info, now=self.world.clock.now, socket_call=herdr.socket)
        self.assertNotEqual(code, 0)
        self.assertEqual((herdr.closed, pane in herdr.panes), ([], True))
        with captured() as (out, err):
            code = sb.main(["reattach", "platform"], runner=self.world.route, now=self.world.clock.now, socket_call=herdr.socket)
        self.assertEqual(code, 0, err.getvalue())
        self.assertEqual(herdr.closed, [pane])

    def test_the_session_match_is_exact_and_covers_both_flag_spellings(self):
        sid = "ses_abc123"
        for cmd, want in (("opencode -s ses_abc123", True), ("opencode --session ses_abc123", True), ("opencode --session=ses_abc123", True),
                          ("opencode -s ses_abc1234", False), ("opencode -s ses_other", False), ("opencode", False), ("-zsh", False),
                          ("echo ses_abc123", False)):
            self.assertEqual(sb.runs_session([{"cmdline": cmd}], sid), want, cmd)

    def worker(self, reports_to="boss"):
        self.world.add_agent("boss", fleet={"role": "orchestrator"})
        self.world.add_agent("worker", fleet={"role": "coder", "reports_to": reports_to})
        self.world.v2.sessions[self.world.sessions["worker"]]["directory"] = str(self.work)
        self.engine.state_dir = self.world.state

    def as_(self, who):
        os.environ["HERDR_PANE_ID"] = self.world.panes[who]

    def run_cli(self, *argv):
        with captured() as (out, err):
            code = sb.main(list(argv), runner=self.world.route, now=self.world.clock.now, socket_call=self.world.herdr.socket)
        return code, out.getvalue(), err.getvalue()

    def kill(self, name):
        del self.world.herdr.panes[self.world.panes[name]]

    def dead_worker(self, entry="absent"):
        """A DEAD worker (its pane is gone) under a boss, with the given last-reports.json entry; a chief of staff to be woken."""
        self.world.add_agent("cos", fleet={"role": "chief-of-staff"})
        self.worker()
        if entry != "absent":
            (self.world.state / sb.LAST_REPORT_FILE).write_text(json.dumps({"worker": entry}) if entry is not None else "{not json")
        self.health()
        self.kill("worker")
        for n in range(sb.PANE_MISSING_PASSES):
            self.health(n)
        self.assertEqual(sb.read_pane_health(self.world.state)["states"]["worker"]["state"], "dead")

    def test_dead_hint_s1_status_says_the_last_report_and_both_hints(self):
        now = self.world.clock.now()
        self.dead_worker({"state": "working", "at": now - 3 * 3600})
        lines = "\n".join(sb.pane_health_status_lines(self.world.state, now))
        self.assertNotIn("DEAD", lines)   # the registry holds it dead: a view never draws a dead agent (S10); collect_status reconciles first and removes the provably dead one (#919)
        text = sb.dead_hint.hint("worker", {"state": "working", "at": now - 3 * 3600}, now)
        self.assertIn("last report: working 3h ago", text)   # a final done would have retired it already
        self.assertIn("fleet-switchboard retire worker", text)
        self.assertIn("fleet-switchboard reattach worker", text)

    def test_dead_hint_s1b_the_view_never_draws_a_dead_agent_and_says_when_the_registry_is_unreadable(self):
        now = self.world.clock.now()
        self.dead_worker({"state": "working", "at": now - 3 * 3600})
        path = self.world.state / "registry.json"
        reg = sb.load_module("registry")
        pane = sb.read_pane_health(self.world.state)["agents"]["worker"]
        reg.upsert(self.world.state, "worker", {"session": pane["session"], "pane": pane["pane"], "role": "coder", "workspace": "w1"})
        doc = json.loads(path.read_text())
        doc["agents"]["worker"]["state"] = "dead"
        path.write_text(json.dumps(doc))
        self.assertNotIn("worker", "\n".join(sb.pane_health_status_lines(self.world.state, now)))   # held dead: not drawn
        for label, text, want in (("empty registry", json.dumps({"version": 1, "agents": {}, "retired": {}}), None),
                                  ("torn file", "{torn", "could not be read"),
                                  ("only another agent", json.dumps({"version": 1, "agents": {"other": {"state": "idle", "session": "ses_x"}}, "retired": {}}), None),
                                  ("the agent recorded live", json.dumps({"version": 1, "agents": {"worker": {"state": "idle", "session": pane["session"]}}, "retired": {}}), None)):
            with self.subTest(registry=label):
                path.write_text(text)
                lines = "\n".join(sb.pane_health_status_lines(self.world.state, now))
                self.assertNotIn("DEAD", lines)   # the registry is the only record: an agent it does not hold has no row, and no copy brings one back
                if want:
                    self.assertIn(want, lines)

    def test_reading_status_removes_a_dead_agent_through_the_registry_once_with_one_audit_line(self):
        """S3 through the real status path: `collect_status` over a registry holding a dead agent whose pane herdr no longer has."""
        self.dead_worker()
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        reg = sb.load_module("registry")
        pane = sb.read_pane_health(self.world.state)["agents"]["worker"]
        reg.upsert(self.world.state, "worker", {"session": pane["session"], "pane": pane["pane"], "role": "coder", "workspace": "w1"})
        path = self.world.state / "registry.json"
        doc = json.loads(path.read_text())
        doc["agents"]["worker"]["state"] = "dead"
        path.write_text(json.dumps(doc))
        sb.collect_status(self.world.route, self.world.clock.now)
        self.assertNotIn("worker", reg.read(self.world.state)["agents"])
        audit = [json.loads(l) for l in (self.world.state / "registry-audit.jsonl").read_text().splitlines()]
        self.assertEqual(len([l for l in audit if l.get("event") == "reconcile_remove"]), 1)

    def test_dead_hint_s2_the_wake_says_no_report_since_launch_and_both_hints(self):
        self.dead_worker()
        facts = [f for f in sb.PaneFacts.__call__(self.fact_source()) if "worker is DEAD" in f.summary]
        self.assertEqual(len(facts), 1)
        for text in ("no report since launch", "fleet-switchboard retire worker", "fleet-switchboard reattach worker"):
            self.assertIn(text, facts[0].summary)

    def test_dead_hint_s3_the_newer_of_a_report_and_a_send_to_the_boss_is_shown(self):
        now = self.world.clock.now()
        sign = sb.dead_hint.hint("worker", {"state": "working", "at": now - 7200, "send_to": {"boss": now - 300, "other": now - 10}}, now, "boss")
        self.assertIn("last report: a message sent 5m ago", sign)
        self.assertNotIn("working", sign)
        self.assertIn("working 2h ago", sb.dead_hint.hint("worker", {"state": "working", "at": now - 7200, "send_to": {"boss": now + 9999}}, now, "boss"))

    def test_dead_hint_s4_detached_and_other_lines_do_not_change(self):
        self.world.add_agent("cos", fleet={"role": "chief-of-staff"})
        self.detach()
        self.health()
        self.health(1)
        lines = sb.pane_health_status_lines(self.world.state)
        self.assertEqual(len(lines), 2)
        self.assertIn("platform DETACHED", lines[0])
        self.assertEqual(lines[1], "        run `fleet-switchboard reattach <name>`")
        self.assertNotIn("last report", "\n".join(lines))
        facts = [f for f in sb.PaneFacts.__call__(self.fact_source())]
        self.assertNotIn("last report", facts[0].summary)

    def test_dead_hint_s5_both_cases_carry_both_hints_within_the_bound(self):
        now = self.world.clock.now()
        for entry in ({"state": "done", "at": now - 60}, None):
            text = sb.dead_hint.hint("alpha", entry, now)
            self.assertIn("fleet-switchboard retire alpha", text)
            self.assertIn("fleet-switchboard reattach alpha", text)
            self.assertLessEqual(len(text), 240)

    def test_dead_hint_s6_a_corrupt_file_says_no_report_since_launch(self):
        self.dead_worker(None)
        facts = [f for f in sb.PaneFacts.__call__(self.fact_source()) if "worker is DEAD" in f.summary]
        self.assertIn("no report since launch", facts[0].summary)   # the wake says it; status does not draw a dead agent the registry holds (#919)

    def test_dead_hint_s7_nothing_is_written(self):
        now = self.world.clock.now()
        self.dead_worker({"state": "working", "at": now - 3 * 3600})
        before = {p.name: p.read_bytes() for p in self.world.state.iterdir() if p.is_file()}
        sb.pane_health_status_lines(self.world.state, now)
        list(sb.PaneFacts.__call__(self.fact_source()))
        self.assertEqual({p.name: p.read_bytes() for p in self.world.state.iterdir() if p.is_file()}, before)

    def test_dead_hint_agrees_with_the_reminder_wakes_last_report_and_edge_paths(self):
        """One rule for 'the newest sign of life': the hint's and the reminder wake's must give the same time for the same entry."""
        now = self.world.clock.now()
        source = sb.ReminderFacts(self.world.state)
        source.bind(self.engine)
        entries = [{"state": "working", "at": now - 500}, {"state": "working", "at": now - 500, "send_to": {"boss": now - 20, "other": now - 5}},
                   {"state": "working", "at": now + 9999}, {"send_to": {"boss": now - 90}}, {"state": "x", "at": "late"}, {}]
        for number, entry in enumerate(entries):
            (self.world.state / sb.LAST_REPORT_FILE).write_text(json.dumps({"worker": entry}))
            sign = sb.dead_hint.last_sign(entry, now, "boss")
            self.assertEqual(source.last_report("worker", "boss"), sign[1] if sign else None, number)
        # the paths `status` takes: no boss known (a send to anyone counts), and a report dated far ahead counts for nothing
        self.assertIn("a message sent 5s ago", sb.dead_hint.hint("w", {"send_to": {"x": now - 5}}, now))
        self.assertIn("no report since launch", sb.dead_hint.hint("w", {"state": "done", "at": now + 3600}, now))

    def test_dead_hint_s8_a_500_character_state_or_name_is_bounded(self):
        now = self.world.clock.now()
        text = sb.dead_hint.hint("n" * 500, {"state": "s" * 500, "at": now - 60}, now)
        self.assertLessEqual(len(text), 240)
        text = sb.dead_hint.hint("n" * 500, {"state": "s" * 500, "at": now - 60}, now)
        self.assertIn("retire", text)       # the name is cut short, so the commands survive
        self.assertIn("reattach", text)

    def test_retire_stops_dead_and_detached_reports_and_all_detached_skips_it_and_undo_brings_it_back(self):
        os.environ["HERDR_WORKSPACE_ID"] = "w1"
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.worker()
        self.health()
        self.kill("worker")
        for n in range(sb.PANE_MISSING_PASSES):
            self.health(n)
        self.assertEqual(sb.read_pane_health(self.world.state)["states"]["worker"]["state"], "dead")      # no report: still DEAD
        self.as_("boss")
        code, out, err = self.run_cli("retire", "worker", "--reason", "the factory run is finished")
        self.assertEqual(code, 0, err)
        self.assertIn("worker is retired", out)
        self.assertNotIn("worker", sb.read_pane_health(self.world.state)["states"])
        self.health(100)
        self.assertEqual(getattr(self.engine, "pane_alerts", {}), {})
        lines = sb.pane_health_status_lines(self.world.state, self.world.clock.now())
        self.assertTrue(any("retired" in l and "worker" in l for l in lines))
        self.assertFalse(any("DEAD" in l for l in lines))
        code, out, err = self.run_cli("reattach", "--all-detached")
        self.assertEqual((code, out.strip()), (0, "no agent is detached or dead"))
        code, out, err = self.run_cli("reattach", "worker")
        self.assertNotEqual(code, 0)
        self.assertIn("is retired", err)
        self.assertEqual((self.world.herdr.closed, [e for e in self.world.audit() if e["event"] == "fleetpane.retired"][0]["detail"]["by"]), ([], "boss"))
        code, out, err = self.run_cli("retire", "--undo", "worker")
        self.assertIn("no longer retired", out)
        self.health(200)
        self.health(300)
        self.assertEqual(sb.read_pane_health(self.world.state)["states"].get("worker", {}).get("state"), None)   # gone from the list, so it is `missing` again
        for n in range(sb.PANE_MISSING_PASSES):
            self.health(400 + n)
        self.assertEqual(sb.read_pane_health(self.world.state)["states"]["worker"]["state"], "dead")      # watched again
        self.assertTrue([e for e in self.world.audit() if e["event"] == "fleetpane.unretired"])

    def test_only_the_boss_the_chief_of_staff_or_the_operator_may_retire_and_a_refusal_is_audited(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.worker()
        self.world.add_agent("cos", fleet={"role": "chief-of-staff"})
        self.world.add_agent("stranger", fleet={"role": "coder"})
        self.as_("stranger")
        code, out, err = self.run_cli("retire", "worker")
        self.assertNotEqual(code, 0)
        self.assertIn("may not reattach worker", err)
        self.assertEqual(sb.read_retired(self.world.state), {})
        self.assertEqual(len([e for e in self.world.audit() if e["event"] == "fleetpane.retire_refused"]), 1)
        for who in ("cos", "boss"):
            self.as_(who)
            self.assertEqual(self.run_cli("retire", "worker")[0], 0, who)
            self.run_cli("retire", "--undo", "worker")
        os.environ.pop("HERDR_PANE_ID", None)                                   # the operator at their own terminal
        self.assertEqual(self.run_cli("retire", "worker")[0], 0)
        self.assertEqual(sb.read_retired(self.world.state)["worker"]["by"], "the operator")

    def test_a_worker_whose_pane_closed_after_its_final_done_report_is_retired_automatically_and_one_closed_while_working_is_dead(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.worker()
        self.world.add_agent("busy", fleet={"role": "coder", "reports_to": "boss"})
        self.world.v2.sessions[self.world.sessions["busy"]]["directory"] = str(self.work)
        self.health()
        now = self.world.clock.now()
        sb.record_last_report(self.world.state, "worker", "done", now)
        sb.record_last_report(self.world.state, "busy", "working", now)           # a progress report is not a final one
        self.kill("worker")
        self.kill("busy")
        for n in range(sb.PANE_MISSING_PASSES):
            self.health(n)
        states = sb.read_pane_health(self.world.state)["states"]
        self.assertNotIn("worker", states)
        self.assertEqual(sb.read_retired(self.world.state)["worker"]["auto"], True)
        self.assertIn("final done report", sb.read_retired(self.world.state)["worker"]["reason"])
        self.assertEqual(states["busy"]["state"], "dead")
        self.assertEqual(sorted(getattr(self.engine, "pane_alerts", {})), ["busy"])
        self.assertTrue([e for e in self.world.audit() if e["event"] == "fleetpane.retired" and e["detail"]["auto"]])

    def test_an_old_final_report_beyond_the_lookback_does_not_retire_and_report_records_the_last_state(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.worker()
        self.health()
        self.world.new_engine("cli").report("worker", "done", "all finished")
        self.assertEqual(sb._read_small(self.world.state, sb.LAST_REPORT_FILE)["worker"]["state"], "done")
        self.world.new_engine("cli").report("worker", "working", "one more thing")          # a rider: still recorded
        self.assertEqual(sb._read_small(self.world.state, sb.LAST_REPORT_FILE)["worker"]["state"], "working")
        sb.record_last_report(self.world.state, "worker", "failed", self.world.clock.now() - 3 * 86400)
        self.kill("worker")
        for n in range(sb.PANE_MISSING_PASSES):
            self.health(n)
        self.assertEqual(sb.read_pane_health(self.world.state)["states"]["worker"]["state"], "dead")
        self.assertEqual(sb.read_retired(self.world.state), {})

    def test_a_retired_listing_is_dropped_from_status_after_the_show_days(self):
        day = 86400
        set_retired(self.world.state, {"fresh": {"at": 1000, "by": "x", "reason": "y", "session": "s", "auto": False},
                                                            "stale": {"at": 1000 - 1, "by": "x", "reason": "y", "session": "s", "auto": False}})
        inside = sb.pane_health_status_lines(self.world.state, 1000 + sb.RETIRED_SHOW_DAYS * day)          # fresh is exactly at the edge, stale just past it
        self.assertTrue(inside and "fresh" in inside[0] and "stale" not in inside[0])
        self.assertEqual(sb.pane_health_status_lines(self.world.state, 1000 + sb.RETIRED_SHOW_DAYS * day + 1), [])

    def test_retire_on_an_unknown_name_is_refused_a_repeat_is_harmless_and_a_failed_report_record_is_noted(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.worker()
        os.environ.pop("HERDR_PANE_ID", None)                                  # the operator
        code, out, err = self.run_cli("retire", "nobody-here")
        self.assertNotEqual(code, 0)
        self.assertIn("not a fleet agent", err)
        self.as_("boss")
        self.health()
        self.assertEqual(self.run_cli("retire", "worker")[0], 0)
        self.assertEqual(self.run_cli("retire", "worker")[0], 0)
        self.assertEqual(len(sb.read_retired(self.world.state)), 1)
        self.assertEqual(self.run_cli("retire", "--undo", "worker")[0], 0)
        self.assertIn("is not retired", self.run_cli("retire", "--undo", "worker")[1])
        with mock.patch.object(sb, "record_last_report", return_value=False):
            self.world.new_engine("cli").report("worker", "done", "finished")
        self.assertTrue([e for e in self.world.audit() if e["event"] == "fleetpane.error" and "last-reports.json" in e["detail"]["error"]])
        with mock.patch.object(sb, "_write_small", side_effect=OSError(28, "No space")):
            self.assertFalse(sb.record_last_report(self.world.state, "worker", "done", 1))

    def test_a_failed_progress_record_drops_a_stale_done_the_cap_prunes_and_a_write_failure_is_a_line_not_a_traceback(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.worker()
        sb.record_last_report(self.world.state, "worker", "done", 1000)
        real = sb._write_small
        calls = []

        def fail_first(state_dir, name, data):
            calls.append(name)
            if len(calls) == 1:
                raise OSError(28, "No space left")
            return real(state_dir, name, data)
        with mock.patch.object(sb, "_write_small", fail_first):
            self.assertFalse(sb.record_last_report(self.world.state, "worker", "working", 2000))
        self.assertNotIn("worker", sb._read_small(self.world.state, sb.LAST_REPORT_FILE), "the stale done must not stand when the newer state could not be saved")
        old = {"x": {"at": 1}, "y": {"at": 10 ** 9}}
        self.assertEqual(sorted(sb.prune_retired(old, 10 ** 9 + 5)), ["y"])
        self.as_("boss")
        self.health()
        with mock.patch.object(sb.load_module("registry"), "_write_atomic", side_effect=OSError(28, "No space left")):
            code, out, err = self.run_cli("retire", "worker")
        self.assertNotEqual(code, 0)
        self.assertIn("was not retired, try again", err)
        self.assertNotIn("Traceback", err)

    def test_a_relaunched_worker_with_a_new_session_is_not_hidden_by_an_old_retirement(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.worker()
        self.health()
        set_retired(self.world.state, {"worker": {"at": int(self.world.clock.now()), "by": "x", "reason": "y", "session": "ses_an_old_one", "auto": False}})
        self.kill("worker")
        for n in range(sb.PANE_MISSING_PASSES):
            self.health(n)
        self.assertEqual(sb.read_pane_health(self.world.state)["states"]["worker"]["state"], "dead")

    # -- the worktree lifecycle (#321): launch registers, retire / a done report / `disk reclaim-worktrees` reclaim only what is clean and pushed

    GIT_ENV = {"GIT_AUTHOR_NAME": "t", "GIT_AUTHOR_EMAIL": "t@example.com", "GIT_COMMITTER_NAME": "t", "GIT_COMMITTER_EMAIL": "t@example.com",
               "GIT_CONFIG_GLOBAL": "/dev/null", "GIT_CONFIG_SYSTEM": "/dev/null"}

    def git(self, cwd, *args):
        with mock.patch.dict(os.environ, self.GIT_ENV):
            done = subprocess.run(["git", "-C", str(cwd)] + list(args), capture_output=True, text=True)
        self.assertEqual(done.returncode, 0, "git %s: %s" % (args, done.stderr))
        return done.stdout

    def make_repo(self):
        """A main checkout with a bare remote, one pushed commit on main, and a helper to add linked worktrees."""
        root = Path(os.path.realpath(str(self.home))) / "repos"
        root.mkdir(exist_ok=True)
        remote, main = root / "remote.git", root / "main"
        subprocess.run(["git", "init", "-q", "--bare", str(remote)], check=True)
        subprocess.run(["git", "init", "-q", "-b", "main", str(main)], check=True)
        (main / "a.txt").write_text("a\n")
        self.git(main, "add", ".")
        self.git(main, "commit", "-qm", "first")
        self.git(main, "remote", "add", "origin", str(remote))
        self.git(main, "push", "-q", "origin", "main")
        self.repo_main = main
        return main

    def add_worktree(self, name, push=True, dirty=False, unpushed=False):
        main = self.repo_main
        path = main.parent / name
        self.git(main, "worktree", "add", "-q", "-b", name, str(path))
        if push:
            self.git(path, "push", "-q", "origin", name)
        if unpushed:
            (path / "new.txt").write_text("x\n")
            self.git(path, "add", ".")
            self.git(path, "commit", "-qm", "local only")
        if dirty:
            (path / "scratch.txt").write_text("edit\n")
        return path

    def registered(self):
        return sb.read_worktrees(self.world.state)

    def test_launch_into_a_linked_worktree_registers_it_and_a_plain_or_main_directory_is_never_registered(self):
        self.make_repo()
        wt = self.add_worktree("feat-a")
        self.engine.state_dir = self.world.state
        done = self.launch(name="coder", directory=str(wt), brief=None)
        (entry,) = self.registered().items()
        self.assertEqual((entry[0], entry[1]["agent"], entry[1]["branch"]), (str(wt), "coder", "feat-a"))
        self.assertTrue([e for e in self.world.audit() if e["event"] == "worktree.registered" and e["detail"]["by"] == "launch"])
        self.assertEqual(oct(os.stat(self.world.state / sb.WORKTREES_FILE).st_mode & 0o777), "0o600")
        self.world.herdr.panes.clear()
        self.world.add_agent("coder2")
        self.launch(name="coder9", directory=str(self.work), brief=None)                      # a plain directory
        self.launch(name="coder8", directory=str(self.repo_main), brief=None)                 # a main checkout
        self.assertEqual(list(self.registered()), [str(wt)])

    def retire_as_operator(self, name):
        os.environ.pop("HERDR_PANE_ID", None)
        return self.run_cli("retire", name)

    def test_retire_removes_a_clean_pushed_worktree_and_keeps_the_dirty_and_the_unpushed_ones_saying_why_and_never_touches_an_unregistered_one(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.make_repo()
        self.worker()
        clean, dirty, unpushed = self.add_worktree("w-clean"), self.add_worktree("w-dirty", dirty=True), self.add_worktree("w-unpushed", unpushed=True)
        stranger = self.add_worktree("w-unregistered")
        for wt in (clean, dirty, unpushed):
            self.assertTrue(sb.register_worktree(self.world.state, str(wt), "worker", None, wt.name, 1))
        self.health()
        code, out, err = self.retire_as_operator("worker")
        self.assertEqual(code, 0, err)
        self.assertFalse(clean.exists())
        self.assertTrue(dirty.exists() and unpushed.exists() and stranger.exists())
        self.assertRegex(out, r"w-dirty: kept: uncommitted changes \(1 file")
        self.assertRegex(out, r"w-unpushed: kept: unpushed")
        self.assertNotIn("w-unregistered", out)
        self.assertEqual(sorted(Path(p).name for p in self.registered()), ["w-dirty", "w-unpushed"], "the removed one left the registry; the kept ones stay")
        self.assertEqual(len([e for e in self.world.audit() if e["event"] == "worktree.removed"]), 1)
        self.assertEqual(len([e for e in self.world.audit() if e["event"] == "worktree.kept"]), 2)
        self.assertIn("w-clean", self.git(self.repo_main, "branch", "--list", "w-clean"), "the branch is never deleted")

    def retire_close_with_worktree(self, wt):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.make_repo()
        self.worker()
        wt = wt()
        self.assertTrue(sb.register_worktree(self.world.state, str(wt), "worker", None, wt.name, 1))
        self.world.herdr.panes[self.world.panes["worker"]]["status"] = "idle"
        os.environ.pop("HERDR_PANE_ID", None)
        code, out, err = self.run_cli("retire", "worker", "--close")
        self.assertEqual(code, 0, err)
        return wt, out

    def test_retire_reports_the_private_tmpdir_removed_or_kept_and_survives_a_failure(self):
        root = self.home / "profile-tmp"
        for kept in (False, True):
            with self.subTest(kept=kept):
                self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
                self.worker()
                (root / "worker").mkdir(parents=True, exist_ok=True)
                if kept:
                    (root / "worker" / "f").write_text("x")
                self.world.herdr.panes[self.world.panes["worker"]]["status"] = "idle"
                os.environ.pop("HERDR_PANE_ID", None)
                with mock.patch.object(sb, "agent_tmp_root", lambda config: root):
                    code, out, err = self.run_cli("retire", "worker")
                self.assertEqual(code, 0, err)
                if kept:
                    self.assertRegex(out, r"tmpdir: .*worker: kept \(1 file\(s\)")
                    self.assertTrue((root / "worker" / "f").exists())
                else:
                    self.assertRegex(out, r"tmpdir: .*worker: removed \(empty\)")
                    self.assertFalse((root / "worker").exists())
                self.run_cli("retire", "--undo", "worker")
        with mock.patch.object(sb, "reclaim_agent_tmp", side_effect=RuntimeError("boom")):
            code, out, err = self.run_cli("retire", "worker")
        self.assertEqual(code, 0)
        self.assertIn("private temp directory not handled", err)

    def test_retire_close_keeps_a_worktree_with_an_unpushed_commit_and_says_so(self):
        wt, out = self.retire_close_with_worktree(lambda: self.add_worktree("w-unpushed-close", unpushed=True))
        self.assertTrue(wt.exists())
        self.assertRegex(out, r"worktree: .*w-unpushed-close: kept: unpushed")
        self.assertNotIn("cannot be resumed", out)
        self.assertIn(str(wt), self.registered())

    def test_retire_close_keeps_a_worktree_with_uncommitted_changes_and_says_so(self):
        wt, out = self.retire_close_with_worktree(lambda: self.add_worktree("w-dirty-close", dirty=True))
        self.assertTrue(wt.exists())
        self.assertRegex(out, r"worktree: .*w-dirty-close: kept: uncommitted changes")
        self.assertNotIn("cannot be resumed", out)

    def test_retire_close_removes_a_clean_pushed_worktree_and_says_the_session_cannot_be_resumed(self):
        wt, out = self.retire_close_with_worktree(lambda: self.add_worktree("w-clean-close"))
        self.assertFalse(wt.exists())
        self.assertRegex(out, r"worktree: .*w-clean-close: removed")
        self.assertIn("cannot be resumed from that directory", out)
        self.assertRegex(out, r"fresh launch under a new name")

    def test_retire_close_of_a_worker_with_no_worktree_prints_no_worktree_line_or_resume_warning(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.make_repo()
        self.worker()
        self.world.herdr.panes[self.world.panes["worker"]]["status"] = "idle"
        os.environ.pop("HERDR_PANE_ID", None)
        code, out, err = self.run_cli("retire", "worker", "--close")
        self.assertEqual(code, 0, err)
        self.assertNotIn("worktree:", out)
        self.assertNotIn("cannot be resumed", out)

    def test_a_done_report_only_says_the_worktree_is_reclaimable_and_removes_nothing_so_a_worker_that_goes_on_keeps_it(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.make_repo()
        self.worker()
        wt = self.add_worktree("w-done")
        sb.register_worktree(self.world.state, str(wt), "worker", None, "w-done", 1)
        for config in ({"worktree_reclaim": {"on_done": False}}, {"worktree_reclaim": {"enabled": False}}, {}):
            self.world.config.pop("worktree_reclaim", None)
            self.world.config.update(config)
            outcome = self.world.new_engine("cli").report("worker", "done", "all finished")
            self.assertTrue(wt.exists(), "a done report never removes a worktree: %s" % config)
            text = " ".join(outcome.get("worktrees", []))
            if config.get("worktree_reclaim") == {"on_done": False}:
                self.assertNotIn("worktrees", outcome)
            elif config.get("worktree_reclaim") == {"enabled": False}:
                self.assertIn("switched off", text)
            else:
                self.assertIn("reclaimable", text)
        self.assertEqual(list(self.registered()), [str(wt)], "still registered: retire removes it")
        self.assertEqual([e for e in self.world.audit() if e["event"] == "worktree.removed"], [])

    def test_the_sweep_is_a_dry_run_by_default_only_considers_retired_agents_and_apply_is_the_operators_or_cos(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.make_repo()
        self.worker()
        self.world.add_agent("cos", fleet={"role": "chief-of-staff"})
        self.world.add_agent("stranger", fleet={"role": "coder"})
        done_wt, live_wt, gone_wt = self.add_worktree("w-retired"), self.add_worktree("w-live"), self.add_worktree("w-gone")
        sb.register_worktree(self.world.state, str(done_wt), "worker", None, "w-retired", 1)
        sb.register_worktree(self.world.state, str(live_wt), "boss", None, "w-live", 1)            # an agent that is NOT retired
        sb.register_worktree(self.world.state, str(gone_wt), "worker", None, "w-gone", 1)
        self.git(self.repo_main, "worktree", "remove", str(gone_wt))                                # already deleted by hand
        set_retired(self.world.state, {"worker": {"at": int(self.world.clock.now()), "by": "x", "reason": "y", "session": "s", "auto": False}})
        os.environ["HERDR_PANE_ID"] = self.world.panes["stranger"]
        code, out, err = self.run_cli("disk", "reclaim-worktrees")
        self.assertEqual(code, 0, err)
        self.assertIn("w-retired: would remove", out)
        self.assertIn("w-gone: already gone", out)
        self.assertRegex(out, r"2 registered worktree\(s\) of retired agents: 2 would be removed, 0 kept")
        self.assertTrue(done_wt.exists() and live_wt.exists(), "a dry run changes nothing")
        code, out, err = self.run_cli("disk", "reclaim-worktrees", "--apply")                       # a stranger may not apply
        self.assertNotEqual(code, 0)
        self.assertIn("only the operator or the Chief of Staff", err)
        self.assertTrue(done_wt.exists())
        os.environ["HERDR_PANE_ID"] = self.world.panes["cos"]
        code, out, err = self.run_cli("disk", "reclaim-worktrees", "--apply")
        self.assertEqual(code, 0, err)
        self.assertFalse(done_wt.exists())
        self.assertTrue(live_wt.exists(), "a worktree of an agent that is not retired is left alone")
        self.assertEqual([Path(p).name for p in self.registered()], ["w-live"])

    def test_a_main_checkout_registered_by_mistake_is_refused_and_register_worktree_needs_a_linked_worktree_and_the_caller_rule(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.make_repo()
        self.worker()
        os.environ.pop("HERDR_PANE_ID", None)
        code, out, err = self.run_cli("disk", "register-worktree", str(self.repo_main), "--agent", "worker")
        self.assertNotEqual(code, 0)
        self.assertIn("not a linked git worktree", err)
        wt = self.add_worktree("w-reg")
        self.assertEqual(self.run_cli("disk", "register-worktree", str(wt), "--agent", "worker")[0], 0)
        self.assertEqual(list(self.registered()), [str(wt)])
        self.world.add_agent("stranger", fleet={"role": "coder"})
        os.environ["HERDR_PANE_ID"] = self.world.panes["stranger"]
        self.assertNotEqual(self.run_cli("disk", "register-worktree", str(wt), "--agent", "worker")[0], 0)
        # a forged registry entry for a main checkout: the reclaim refuses it and removes nothing
        sb.register_worktree(self.world.state, str(self.repo_main), "worker", None, "main", 1)
        engine = self.world.new_engine("cli")
        status, line = sb.reclaim_worktree(engine, subprocess.run, str(self.repo_main), {"agent": "worker"}, True)
        self.assertEqual(status, "refused")
        self.assertTrue(self.repo_main.exists())

    def test_an_ignored_local_file_keeps_the_worktree_but_known_build_output_does_not_and_a_bad_entry_or_a_git_refusal_removes_nothing(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.make_repo()
        self.worker()
        (self.repo_main / ".gitignore").write_text(".env\nnode_modules/\n")
        self.git(self.repo_main, "add", ".")
        self.git(self.repo_main, "commit", "-qm", "ignore")
        self.git(self.repo_main, "push", "-q", "origin", "main")
        secret, build = self.add_worktree("w-env"), self.add_worktree("w-build")
        (secret / ".env").write_text("TOKEN=x\n")
        (build / "node_modules").mkdir()
        (build / "node_modules" / "m.js").write_text("1\n")
        engine = self.world.new_engine("cli")
        status, line = sb.reclaim_worktree(engine, subprocess.run, str(secret), {"agent": "worker"}, True)
        self.assertEqual(status, "kept")
        self.assertIn("ignored local file", line)
        self.assertTrue(secret.exists())
        status, line = sb.reclaim_worktree(engine, subprocess.run, str(build), {"agent": "worker"}, True)
        self.assertEqual(status, "removed", line)
        for bad in ("relative/path", "-rf", 5):
            self.assertEqual(sb.reclaim_worktree(engine, subprocess.run, bad, {"agent": "worker"}, True)[0], "refused")
        self.assertEqual(sb.reclaim_worktree(engine, subprocess.run, str(secret), "not-a-dict", True)[0], "refused")
        calm = self.add_worktree("w-git-refuses")
        self.git(self.repo_main, "worktree", "lock", str(calm))        # git itself refuses to remove a locked worktree
        status, line = sb.reclaim_worktree(engine, subprocess.run, str(calm), {"agent": "worker"}, True)
        self.assertEqual((status, calm.exists()), ("kept", True))
        self.assertIn("git refused", line)

    def test_a_second_claim_never_takes_the_owner_over_and_the_cap_is_said(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.make_repo()
        self.worker()
        self.world.add_agent("other", fleet={"role": "coder"})
        wt = self.add_worktree("w-shared")
        self.assertIs(sb.register_worktree(self.world.state, str(wt), "worker", None, "w-shared", 1), True)
        self.assertEqual(sb.register_worktree(self.world.state, str(wt), "other", None, "w-shared", 2), "worker")
        self.assertEqual(self.registered()[str(wt)]["agent"], "worker")
        os.environ.pop("HERDR_PANE_ID", None)
        code, out, err = self.run_cli("disk", "register-worktree", str(wt), "--agent", "other")
        self.assertNotEqual(code, 0)
        self.assertIn("already registered to worker", err)
        self.engine.state_dir = self.world.state
        self.launch(name="other2", directory=str(wt), brief=None)     # a launch into it does not claim it either
        self.assertEqual(self.registered()[str(wt)]["agent"], "worker")
        self.assertFalse([e for e in self.world.audit() if e["event"] == "worktree.registered" and e["subject"] == "other2"])
        for n in range(sb.WORKTREE_RECLAIM_MAX + 2):    # the cap is said, not silent
            sb.register_worktree(self.world.state, "/nonexistent/w%02d" % n, "worker", None, "b", 1)
        lines = sb.reclaim_for_agent(self.world.new_engine("cli"), subprocess.run, "worker", True)
        self.assertTrue(any("handled (cap %d)" % sb.WORKTREE_RECLAIM_MAX in l for l in lines), lines)

    def test_a_worktree_a_herdr_pane_is_working_in_is_kept_until_that_pane_is_closed(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.make_repo()
        self.worker()
        self.world.add_agent("neighbour", fleet={"role": "coder"})
        wt = self.add_worktree("w-busy")
        sb.register_worktree(self.world.state, str(wt), "worker", None, "w-busy", 1)
        self.world.herdr.panes[self.world.panes["neighbour"]]["cwd"] = str(wt / "sub")
        engine = self.world.new_engine("cli")
        status, line = sb.reclaim_worktree(engine, subprocess.run, str(wt), {"agent": "worker"}, True)
        self.assertEqual((status, wt.exists()), ("kept", True))
        self.assertIn("is working in it", line)
        self.world.herdr.panes[self.world.panes["neighbour"]]["cwd"] = "/tmp"
        status, line = sb.reclaim_worktree(engine, subprocess.run, str(wt), {"agent": "worker"}, True)
        self.assertEqual((status, wt.exists()), ("removed", False), line)
        sibling, root = self.add_worktree("w-busy2"), self.add_worktree("w-busy3")
        self.world.herdr.panes[self.world.panes["neighbour"]]["cwd"] = str(root)   # exactly the root of a worktree
        self.assertIn("is working in it", sb.reclaim_worktree(engine, subprocess.run, str(root), {"agent": "worker"}, True)[1])
        self.assertEqual(sb.reclaim_worktree(engine, subprocess.run, str(sibling), {"agent": "worker"}, True)[0], "removed",
                         "a path that only shares a name prefix is not inside it")
        with mock.patch.object(sb.HerdrClient, "pane_list", side_effect=sb.HerdrError("unavailable", "down")):
            status, line = sb.reclaim_worktree(engine, subprocess.run, str(root), {"agent": "worker"}, True)
        self.assertEqual((status, root.exists()), ("kept", True))
        self.assertIn("herdr cannot say", line)

    def test_an_automatic_retire_through_the_health_pass_removes_a_clean_pushed_worktree_keeps_a_dirty_one_and_stops_with_the_kill_switch(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.make_repo()
        self.worker()
        self.world.v2.sessions[self.world.sessions["worker"]]["directory"] = str(self.work)
        self.health()
        clean, dirty = self.add_worktree("w-auto-clean"), self.add_worktree("w-auto-dirty", dirty=True)
        for wt in (clean, dirty):
            sb.register_worktree(self.world.state, str(wt), "worker", None, wt.name, 1)
        sb.record_last_report(self.world.state, "worker", "done", self.world.clock.now())
        self.kill("worker")
        for n in range(sb.PANE_MISSING_PASSES):
            self.health(n)
        self.assertEqual(sb.read_retired(self.world.state)["worker"]["auto"], True)
        self.assertFalse(clean.exists(), "the automatic retire reclaims a clean, pushed worktree")
        self.assertTrue(dirty.exists())
        self.assertEqual([Path(p).name for p in self.registered()], ["w-auto-dirty"])

    def test_the_kill_switch_stops_an_automatic_retire_from_removing_a_worktree(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.world.config["worktree_reclaim"] = self.engine.config["worktree_reclaim"] = {"enabled": False}
        self.make_repo()
        self.worker()
        self.world.v2.sessions[self.world.sessions["worker"]]["directory"] = str(self.work)
        self.health()
        clean = self.add_worktree("w-auto-off")
        sb.register_worktree(self.world.state, str(clean), "worker", None, "w-auto-off", 1)
        sb.record_last_report(self.world.state, "worker", "done", self.world.clock.now())
        self.kill("worker")
        for n in range(sb.PANE_MISSING_PASSES):
            self.health(n)
        self.assertTrue(clean.exists())

    def test_a_plain_terminal_or_a_foreground_process_in_the_worktree_blocks_removal_and_an_unreadable_pane_list_keeps_it(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.make_repo()
        self.worker()
        wt = self.add_worktree("w-term")
        engine = self.world.new_engine("cli")
        self.assertIsNone(sb.worktree_in_use(engine, str(wt)))
        self.world.herdr.plain_terminals = [{"pane_id": "w1:p9", "cwd": str(wt / "src"), "foreground_cwd": "/tmp"}]      # a terminal with no agent
        self.assertIn("w1:p9", sb.worktree_in_use(engine, str(wt)))
        status, line = sb.reclaim_worktree(engine, subprocess.run, str(wt), {"agent": "worker"}, True)
        self.assertEqual((status, wt.exists()), ("kept", True), line)
        self.world.herdr.plain_terminals = [{"pane_id": "w1:p9", "cwd": "/tmp", "foreground_cwd": str(wt)}]               # only its foreground process is there
        self.assertIn("foreground_cwd", sb.worktree_in_use(engine, str(wt)))
        self.world.herdr.plain_terminals = [{"pane_id": "w1:p9", "cwd": str(wt) + "2", "foreground_cwd": "/tmp"}]         # a sibling sharing a name prefix
        self.assertIsNone(sb.worktree_in_use(engine, str(wt)))
        self.world.herdr.plain_terminals = [{"pane_id": "w1:p%d" % n, "cwd": "/tmp"} for n in range(60)] + [{"pane_id": "w1:p99", "cwd": str(wt)}]
        self.assertIn("w1:p99", sb.worktree_in_use(engine, str(wt)), "no row cap: the 61st pane is read too")
        with mock.patch.object(sb.HerdrClient, "pane_list", side_effect=sb.HerdrError("unavailable", "down")):
            self.assertIn("herdr cannot say", sb.worktree_in_use(engine, str(wt)))
        with mock.patch.object(sb.HerdrClient, "pane_list", return_value=["not-a-dict"]):
            self.assertIn("cannot say none works in it", sb.worktree_in_use(engine, str(wt)))

    def test_a_worktree_that_is_the_session_directory_of_a_non_retired_agent_is_kept_though_its_pane_sits_elsewhere(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.make_repo()
        self.worker()
        self.world.add_agent("elsewhere", fleet={"role": "coder"})
        wt = self.add_worktree("w-session")
        sb.register_worktree(self.world.state, str(wt), "worker", None, "w-session", 1)
        self.world.v2.sessions[self.world.sessions["elsewhere"]]["directory"] = str(wt / "sub")      # its pane's cwd stays /tmp
        engine = self.world.new_engine("cli")
        engine.discover(self.world.clock.now())
        self.assertIn("the session of elsewhere", sb.worktree_in_use(engine, str(wt)))
        status, line = sb.reclaim_worktree(engine, subprocess.run, str(wt), {"agent": "worker"}, True)
        self.assertEqual((status, wt.exists()), ("kept", True), line)
        self.assertIn("runs in it", line)
        set_retired(self.world.state, {"elsewhere": {"at": int(self.world.clock.now()), "by": "x", "reason": "y", "session": "s", "auto": False}})
        self.assertIsNone(sb.worktree_in_use(engine, str(wt)), "a retired agent's session no longer holds it")
        set_retired(self.world.state, {})
        self.world.v2.sessions[self.world.sessions["elsewhere"]]["directory"] = str(wt) + "2"        # a sibling sharing a name prefix
        self.assertIsNone(sb.worktree_in_use(engine, str(wt)))
        with mock.patch.object(sb.V2Client, "session_list_page", side_effect=sb.V2Error("timeout", None, "slow")):
            self.assertIn("cannot read the session list", sb.worktree_in_use(engine, str(wt)))
        sid = self.world.sessions["elsewhere"]
        self.world.v2.sessions[self.world.sessions["elsewhere"]]["directory"] = str(wt / "sub")
        with mock.patch.object(sb.V2Client, "session_list_page", return_value=([], None)):          # a complete list that HIDES a session session.get can read
            self.assertIn("runs in it", sb.worktree_in_use(engine, str(wt)))
        self.world.v2.sessions[self.world.sessions["elsewhere"]]["directory"] = str(wt) + "2"
        with mock.patch.object(sb.V2Client, "session_list_page", return_value=([], None)), \
                mock.patch.object(sb.V2Client, "session_get", side_effect=sb.V2Error("http", 404, "gone")):   # missing from both: gone
            self.assertIsNone(sb.worktree_in_use(engine, str(wt)))
        with mock.patch.object(sb, "WORKTREE_SESSION_PAGES", 1), mock.patch.object(sb.V2Client, "session_list_page", return_value=([], "more")):
            self.assertIn("cannot say it does not run in it", sb.worktree_in_use(engine, str(wt)))     # an incomplete list
        with mock.patch.object(sb.V2Client, "session_list_page", wraps=engine.v2.session_list_page) as listed:   # ONE list for a whole sweep
            self.world.v2.sessions[sid]["directory"] = str(wt) + "2"
            engine._wt_sweep = True
            for _ in range(3):
                self.assertIsNone(sb.worktree_in_use(engine, str(wt)))
            engine._wt_sweep, engine._wt_session_index = False, None
            self.assertEqual(listed.call_count, 1)

    def test_retiring_the_agent_whose_session_runs_in_its_worktree_still_removes_it_because_it_is_retired_first(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.make_repo()
        self.worker()
        wt = self.add_worktree("w-own-session")
        sb.register_worktree(self.world.state, str(wt), "worker", None, "w-own-session", 1)
        self.world.v2.sessions[self.world.sessions["worker"]]["directory"] = str(wt)
        self.health()
        code, out, err = self.retire_as_operator("worker")
        self.assertEqual(code, 0, err)
        self.assertFalse(wt.exists(), out)

    def orphan_rows(self):
        tmp = Path(os.path.realpath(str(self.home)))
        fake = str(tmp / "host-mctx-1" / "fake-agent.py")
        helper = os.path.expanduser("~/Code/fleet-kit.wt/sb-x/tools/helper.py")
        me = os.getuid()
        H = 3600
        return [
            (self.px[4001], 1, me, 7 * H, "/usr/bin/python3 %s --serve" % fake),                    # due: a fake agent in a temp host-mctx dir
            (self.px[4002], 1, me, 9 * H, "node --test %s/t/a.test.js" % tmp),                      # due: a node test runner naming a temp path
            (self.px[4003], 1, me, 8 * H, "python3 %s" % helper),                                   # due: a python helper in a fleet worktree
            (self.px[4004], 1, me, 1 * H, "/usr/bin/python3 %s" % fake),                            # younger than the grace
            (self.px[4005], self.px[777], me, 9 * H, "node --test"),                                         # its parent is alive: not an orphan
            (self.px[4006], 1, me + 1, 9 * H, "node --test"),                                       # another user's
            (os.getpid(), 1, me, 9 * H, "node --test"),                                    # this process
            (self.px[4007], 1, me, 9 * H, "node --test /x/opencode/test.js"),                       # names opencode
            (self.px[4008], 1, me, 9 * H, "/usr/bin/python3 /opt/checkout/bin/x.py"),   # a main checkout script: not on the allow-list
            (self.px[4009], 1, me, 9 * H, "sleep 1000"),                                            # not on the allow-list
            (self.px[4010], 1, me, 9 * H, "node --test"),                                           # a bare node --test: no path to place it
            (self.px[4011], 1, me, 9 * H, "node --test %s/ssh/t.js" % tmp),                         # names ssh
            (self.px[4012], 1, me, 9 * H, "/usr/bin/python3 %s/../etc/x.py" % tmp),                 # a .. in the script path
            (self.px[4013], 1, me, 9 * H, "/usr/bin/python3 relative/x.py"),                        # a relative script
            (self.px[4014], 1, me, 9 * H, "/usr/bin/python3 %s/other/fake-agent.py" % tmp),         # a fake-agent.py outside host-mctx (still a temp python helper)
            (self.px[4015], 1, me, 9 * H, "/usr/bin/python3 %s/herdr/x.py" % tmp),                  # names herdr
            (1, 0, 0, 99 * H, "/sbin/launchd"),
        ]

    def test_the_orphan_allow_list_picks_only_exact_matches_of_this_user_past_the_grace_and_never_a_protected_target(self):
        rows = self.orphan_rows()
        due, young = sb.orphan_reap_candidates(lambda: rows, {})
        self.assertEqual(sorted((pid, kind) for pid, kind, _, _ in due), sorted([(self.px[4001], "fake-agent"), (self.px[4002], "node-test"), (self.px[4003], "python-helper"), (self.px[4014], "python-helper")]))
        self.assertEqual([pid for pid, *_ in young], [self.px[4004]])
        due, _ = sb.orphan_reap_candidates(lambda: rows, {"orphan_reaper": {"grace_hours": 8}})
        self.assertEqual(sorted(pid for pid, *_ in due), sorted([self.px[4002], self.px[4003], self.px[4014]]), "the grace is configurable")
        line = sb.orphan_status_line({}, lambda: rows)
        self.assertRegex(line, r"^4: .*%d.*past 6 h" % self.px[4001])
        self.assertIsNone(sb.orphan_status_line({"orphan_reaper": {"enabled": False}}, lambda: rows))
        self.assertIsNone(sb.orphan_status_line({}, lambda: rows[3:4]))

    def test_the_reap_is_a_dry_run_by_default_signals_term_then_kill_audited_and_refuses_a_stranger_and_the_kill_switch(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.worker()
        self.world.add_agent("stranger", fleet={"role": "coder"})
        alive = {r[0]: r for r in self.orphan_rows()}
        sent = []

        def fake_kill(pid, sig):
            sent.append((pid, sig))
            if sig == signal.SIGTERM and pid != self.px[4002]:       # 4002 ignores SIGTERM
                alive.pop(pid, None)
            if sig == signal.SIGKILL:
                alive.pop(pid, None)

        with mock.patch.object(sb, "ps_table", lambda: list(alive.values())), mock.patch.object(os, "kill", fake_kill), mock.patch.object(time, "sleep", lambda s: None):
            os.environ.pop("HERDR_PANE_ID", None)
            code, out, err = self.run_cli("disk", "reap-orphans")
            self.assertEqual((code, sent), (0, []), err)
            self.assertIn("4 orphan(s) past 6 h (a dry run: add --apply); 1 younger left alone", out)
            os.environ["HERDR_PANE_ID"] = self.world.panes["stranger"]
            code, out, err = self.run_cli("disk", "reap-orphans", "--apply")
            self.assertNotEqual(code, 0)
            self.assertIn("refused: only the operator or the Chief of Staff", err)
            self.assertEqual(sent, [])
            os.environ.pop("HERDR_PANE_ID", None)
            self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "orphan_reaper": {"enabled": False}})
            code, out, err = self.run_cli("disk", "reap-orphans", "--apply")
            self.assertNotEqual(code, 0)
            self.assertIn("switched off", err)
            self.assertEqual(sent, [])
            self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
            code, out, err = self.run_cli("disk", "reap-orphans", "--apply")
            self.assertEqual(code, 0, err)
        self.assertEqual(sorted(sent), sorted([(self.px[4001], signal.SIGTERM), (self.px[4002], signal.SIGTERM), (self.px[4002], signal.SIGKILL), (self.px[4003], signal.SIGTERM), (self.px[4014], signal.SIGTERM)]))
        self.assertIn("%d fake-agent: terminated" % self.px[4001], out)
        self.assertIn("%d node-test: killed" % self.px[4002], out)
        events = [e["event"] for e in self.world.audit() if e["event"].startswith("orphan.")]
        self.assertEqual(sorted(events), ["orphan.kill", "orphan.term", "orphan.term", "orphan.term", "orphan.term"])
        self.assertTrue(all(e["detail"]["by"] for e in self.world.audit() if e["event"].startswith("orphan.")), "the audit says who applied it")
        self.assertIn(self.px[4004], alive, "a younger process and every protected one are left")
        self.assertTrue({self.px[4005], self.px[4006], self.px[4007], self.px[4008], self.px[4009], self.px[4010], self.px[4011], self.px[4012], self.px[4013], self.px[4015], 1} <= set(alive))

    def test_a_kill_that_fails_or_a_process_already_gone_is_said_the_cap_is_said_and_no_audit_means_no_signal(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        me, tmp = os.getuid(), Path(os.path.realpath(str(self.home)))
        rows = [(self.px[5000 + n], 1, me, 9 * 3600, "node --test %s/t%d.test.js" % (tmp, n)) for n in range(sb.ORPHAN_MAX_PER_RUN + 2)]
        engine = self.world.new_engine("cli")
        outcomes = iter([ProcessLookupError(), PermissionError(1, "nope")])

        def kill(pid, sig):
            nxt = next(outcomes, None)
            if nxt:
                raise nxt

        with mock.patch.object(sb, "orphan_roots", lambda: ({str(tmp) + "/"}, set())):
            out = sb.reap_orphans(engine, True, lambda: rows, kill=kill, sleep=lambda s: None)
            self.assertEqual(out["results"][0][2], "already gone")
            self.assertTrue(out["results"][1][2].startswith("failed"))
            self.assertIn("22 of 22".replace("22 of 22", "%d of %d" % (sb.ORPHAN_MAX_PER_RUN, len(rows))), out["results"][-1][2])
            self.assertEqual(len(out["results"]), sb.ORPHAN_MAX_PER_RUN + 1)
            silent = self.world.new_engine("cli", writable=False)
            with self.assertRaises(sb.LaunchError):
                sb.reap_orphans(silent, True, lambda: rows, kill=lambda pid, sig: self.fail("signalled without an audit log"), sleep=lambda s: None)

    def test_a_pid_whose_command_changed_before_the_signal_is_not_signalled_and_the_orphan_config_is_validated(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        rows = self.orphan_rows()
        reads = {"n": 0}

        def table():
            reads["n"] += 1
            if reads["n"] == 1:
                return rows
            return [r if r[0] != self.px[4002] else (self.px[4002], 1, r[2], r[3], "node server.js") for r in rows]     # the pid now names something else

        sent = []
        engine = self.world.new_engine("cli")
        out = sb.reap_orphans(engine, True, table, kill=lambda pid, sig: sent.append((pid, sig)), sleep=lambda s: None)
        self.assertNotIn(self.px[4002], [pid for pid, _ in sent])
        self.assertIn((self.px[4002], "node-test", "changed: not signalled"), out["results"])
        self.assertTrue({(self.px[4001], signal.SIGTERM), (self.px[4003], signal.SIGTERM)} <= set(sent), "the unchanged ones are still signalled")
        younger = lambda: [(r[0], r[1], r[2], 5, r[4]) if r[0] == self.px[4003] else r for r in rows]       # a reused pid restarts at age 0
        reads["n"], sent[:] = 0, []
        out = sb.reap_orphans(engine, True, lambda: rows if reads.__setitem__("n", reads["n"] + 1) or reads["n"] == 1 else younger(), kill=lambda pid, sig: sent.append((pid, sig)), sleep=lambda s: None)
        self.assertNotIn(self.px[4003], [pid for pid, _ in sent], "a process that is now younger is another process")
        parent = lambda: [(r[0], 2, r[2], r[3], r[4]) if r[0] == self.px[4001] else r for r in rows]          # re-parented: no longer an orphan
        reads["n"], sent[:] = 0, []
        sb.reap_orphans(engine, True, lambda: rows if reads.__setitem__("n", reads["n"] + 1) or reads["n"] == 1 else parent(), kill=lambda pid, sig: sent.append((pid, sig)), sleep=lambda s: None)
        self.assertNotIn(self.px[4001], [pid for pid, _ in sent])
        for bad in ({"enabled": "no"}, {"grace_hours": 0}, {"grace_hours": True}, {"x": 1}, "yes"):
            with self.assertRaises(sb.ConfigError):
                sb.validate_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "orphan_reaper": bad})
        sb.validate_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "orphan_reaper": {"enabled": False, "grace_hours": 12}})

    def test_a_retire_sweep_over_two_worktrees_reads_the_session_list_once(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.make_repo()
        self.worker()
        self.world.add_agent("elsewhere", fleet={"role": "coder"})
        wts = [self.add_worktree("w-sweep-a"), self.add_worktree("w-sweep-b")]
        for wt in wts:
            sb.register_worktree(self.world.state, str(wt), "worker", None, wt.name, 1)
        engine = self.world.new_engine("cli")
        engine.discover(self.world.clock.now())
        with mock.patch.object(sb.V2Client, "session_list_page", wraps=engine.v2.session_list_page) as listed:
            lines = sb.reclaim_for_agent(engine, subprocess.run, "worker", True)
        self.assertEqual(listed.call_count, 1, lines)
        self.assertFalse(any(wt.exists() for wt in wts))
        self.assertFalse(engine._wt_sweep, "the sweep cache is dropped afterwards")

    def close_world(self, status="idle"):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.worker()
        self.world.add_agent("stranger", fleet={"role": "coder", "reports_to": "someone-else"})
        self.world.add_agent("cos", fleet={"role": "chief-of-staff"})
        self.world.herdr.panes[self.world.panes["worker"]]["status"] = status
        self.health()
        self.world.herdr.closed.clear()

    def close_audit(self, event=None):
        rows = [e for e in self.world.audit() if e["event"].startswith("fleetpane.close")]
        return [e for e in rows if event is None or e["event"] == event]

    def test_retire_close_retires_and_closes_the_idle_workers_pane_when_its_boss_asks(self):
        self.close_world()
        pane = self.world.panes["worker"]
        self.as_("boss")
        code, out, err = self.run_cli("retire", "worker", "--close")
        self.assertEqual(code, 0, err)
        self.assertIn("closed pane %s" % pane, out)
        self.assertEqual(self.world.herdr.closed, [pane], "exactly one pane close, for that pane")
        self.assertIn("worker", sb.read_retired(self.world.state))
        (row,) = self.close_audit("fleetpane.closed")
        self.assertEqual((row["subject"], row["detail"]["pane"]), ("worker", pane))
        self.assertNotIn("command", json.dumps(row))

    def test_retire_close_refuses_a_pane_that_no_longer_holds_the_agents_session_and_closes_nothing(self):
        self.close_world()
        other = self.world.add_agent("newcomer", fleet={"role": "coder"})
        stale = self.world.panes["worker"]
        self.health()
        # a herdr restart renumbered the panes: the id the switchboard had for `worker` now holds another session
        discovery = self.engine.discover(self.world.clock.now())
        self.world.herdr.panes[stale]["session"] = other
        self.as_("boss")
        with mock.patch.object(sb.Switchboard, "discover", return_value=discovery):
            code, out, err = self.run_cli("retire", "worker", "--close")
        self.assertEqual(code, 1)
        self.assertEqual(self.world.herdr.closed, [])
        self.assertEqual(err.count("no longer holds worker's session"), 1, err)
        self.assertNotIn("worker", sb.read_retired(self.world.state), "a refused close retires nothing")
        (row,) = self.close_audit("fleetpane.close_refused")
        self.assertEqual((row["subject"], row["detail"]["pane"]), ("worker", stale))
        self.assertIn("no longer holds", row["detail"]["why"])

    def test_retire_close_never_closes_the_callers_own_pane_or_its_own_agent(self):
        self.close_world()
        engine = self.world.new_engine("cli")
        discovery = engine.discover(self.world.clock.now())
        worker = discovery.agents["worker"]
        with mock.patch.object(sb, "gates_caller_kind", return_value=("agent", "worker", "coder")):       # an agent naming ITSELF
            pane, why = sb.retire_close_problem(engine, subprocess.run, self.world.clock.now, discovery, "worker", worker, False)
        self.assertEqual((pane, why), (None, "an agent cannot close its own pane"))
        with mock.patch.object(sb, "gates_caller_kind", return_value=("person", "the operator")), mock.patch.dict(os.environ, {"HERDR_PANE_ID": worker.pane}):
            pane, why = sb.retire_close_problem(engine, subprocess.run, self.world.clock.now, discovery, "worker", worker, False)
        self.assertEqual(pane, None)
        self.assertIn("the one you are in", why)
        self.as_("worker")
        code, out, err = self.run_cli("retire", "worker", "--close")
        self.assertEqual((code, self.world.herdr.closed), (1, []))
        self.world.add_agent("boss2", fleet={"role": "orchestrator"})
        self.world.add_agent("kid", fleet={"role": "coder", "reports_to": "boss2"})
        self.world.herdr.panes[self.world.panes["kid"]]["status"] = "idle"
        self.health()
        os.environ["HERDR_PANE_ID"] = self.world.panes["kid"]
        os.environ[sb.SESSION_ENV] = self.world.sessions["boss2"]       # a caller that is boss2 but sits in kid's pane
        code, out, err = self.run_cli("retire", "kid", "--close")
        os.environ.pop(sb.SESSION_ENV, None)
        self.assertEqual((code, self.world.herdr.closed), (1, []))
        self.assertIn("the one you are in", err)
        self.assertEqual(len(self.close_audit("fleetpane.close_refused")), 1)

    def test_a_blocked_agent_needs_force_and_the_close_judges_everything_again_just_before_closing(self):
        self.close_world(status="blocked")
        self.as_("boss")
        code, out, err = self.run_cli("retire", "worker", "--close")
        self.assertEqual((code, self.world.herdr.closed), (1, []))
        self.assertIn("is blocked: pass --force", err)
        self.assertEqual(len(self.close_audit("fleetpane.close_refused")), 1)
        self.world.herdr.panes[self.world.panes["worker"]]["status"] = "idle"
        real = sb.retire_close_problem
        calls = []

        def second_look_finds_it_working(engine, runner, now, discovery, name, seen, force):
            calls.append(1)
            if len(calls) == 2:                                           # the agent resumed work after the first judgment
                self.world.herdr.panes[self.world.panes["worker"]]["status"] = "working"
            return real(engine, runner, now, discovery, name, seen, force)

        with mock.patch.object(sb, "retire_close_problem", second_look_finds_it_working):
            code, out, err = self.run_cli("retire", "worker", "--close")
        self.assertEqual(len(calls), 2, "judged before the retirement and again just before the close")
        self.assertEqual(code, 0, err)
        self.assertEqual(self.world.herdr.closed, [], "it was working at the second look: not closed")
        self.assertIn("was not closed", out)
        self.assertIn("worker", sb.read_retired(self.world.state))
        self.assertEqual(len(self.close_audit("fleetpane.close_failed")), 1)

    def test_retire_close_is_refused_for_a_stranger_audited_and_allowed_for_the_boss_cos_for_a_direct_report_and_the_operator(self):
        self.close_world()
        self.world.add_agent("boss3", fleet={"role": "orchestrator", "reports_to": "cos"})
        self.world.add_agent("direct", fleet={"role": "coder", "reports_to": "cos"})
        self.world.add_agent("deep", fleet={"role": "coder", "reports_to": "boss3"})
        for n in ("direct", "deep"):
            self.world.herdr.panes[self.world.panes[n]]["status"] = "idle"
        self.health()
        self.world.herdr.closed.clear()
        self.as_("stranger")
        code, out, err = self.run_cli("retire", "worker", "--close")
        self.assertEqual((code, self.world.herdr.closed), (1, []))
        self.assertTrue([e for e in self.world.audit() if e["event"] == "fleetpane.retire_refused"], "a stranger is refused by the retire caller rule, audited")
        self.as_("cos")
        code, out, err = self.run_cli("retire", "deep", "--close")               # cos is not deep's boss: a retire is allowed, a close is not
        self.assertEqual((code, self.world.herdr.closed), (1, []), err)
        self.assertIn("may not close deep's pane", err)
        self.assertEqual(len(self.close_audit("fleetpane.close_refused")), 1)
        code, out, err = self.run_cli("retire", "direct", "--close")             # cos IS its boss
        self.assertEqual(code, 0, err)
        self.assertEqual(self.world.herdr.closed, [self.world.panes["direct"]])
        self.as_("boss3")
        self.assertEqual(self.run_cli("retire", "deep", "--close")[0], 0)
        os.environ.pop("HERDR_PANE_ID", None)
        self.assertEqual(self.run_cli("retire", "worker", "--close")[0], 0, "the operator may close any")
        self.assertEqual(len(self.close_audit("fleetpane.closed")), 3)

    def test_a_working_agent_needs_force_and_force_is_refused_with_unpushed_work(self):
        self.close_world(status="working")
        self.make_repo()
        wt = self.add_worktree("w-busy-close", unpushed=True)
        sb.register_worktree(self.world.state, str(wt), "worker", None, "w-busy-close", 1)
        self.as_("boss")
        code, out, err = self.run_cli("retire", "worker", "--close")
        self.assertEqual((code, self.world.herdr.closed), (1, []))
        self.assertIn("pass --force", err)
        code, out, err = self.run_cli("retire", "worker", "--close", "--force")
        self.assertEqual((code, self.world.herdr.closed), (1, []), "unpushed work: --force refused")
        self.assertIn("unpushed", err)
        self.assertEqual(len(self.close_audit("fleetpane.close_refused")), 2)
        clean = self.add_worktree("w-clean-close")
        sb._write_small(self.world.state, sb.WORKTREES_FILE, {str(clean): {"agent": "worker", "repo": None, "branch": "w-clean-close", "created": 1}})
        code, out, err = self.run_cli("retire", "worker", "--close", "--force")
        self.assertEqual(code, 0, err)
        self.assertEqual(self.world.herdr.closed, [self.world.panes["worker"]])

    def idle_session(self, ago, turn=None):
        sid = self.world.sessions["worker"]
        self.world.v2.sessions[sid]["idle"] = self.world.clock.now() - ago
        self.world.v2.sessions[sid]["turn"] = turn
        return sid

    def refused_close(self, *extra):
        self.as_("boss")
        code, out, err = self.run_cli("retire", "worker", "--close", *extra)
        self.assertEqual((code, self.world.herdr.closed), (1, []), err)
        return err

    def test_a_working_pane_with_an_idle_session_is_closed_without_force_and_the_evidence_is_named_and_audited(self):   # S1 S6 S8
        self.close_world(status="working")
        self.idle_session(27 * 3600)
        self.as_("boss")
        with mock.patch.object(sb.V2Client, "session_active", autospec=True, side_effect=sb.V2Client.session_active) as read:
            code, out, err = self.run_cli("retire", "worker", "--close")
        self.assertEqual(code, 0, err)
        self.assertEqual(self.world.herdr.closed, [self.world.panes["worker"]])
        self.assertIn("herdr says working; the session has been idle 1 d 3 h and has no turn: treated as idle", out)
        (row,) = self.close_audit("fleetpane.closed")
        self.assertIn("idle 1 d 3 h and has no turn", row["detail"]["evidence"])
        self.assertEqual(read.call_count, 2, "one session read per judgment: before the retirement and again just before the close")

    def test_a_working_pane_is_still_refused_for_a_turn_recent_activity_or_a_state_that_is_unreadable_or_odd(self):   # S2 S3 S4
        self.close_world(status="working")
        self.idle_session(86400, turn={"id": "t"})
        self.assertIn("pass --force", self.refused_close())
        self.idle_session(120)
        self.assertIn("pass --force", self.refused_close())
        self.idle_session(86400)
        with mock.patch.object(sb.V2Client, "session_active", side_effect=sb.V2Error("http", "down")):
            self.assertIn("pass --force", self.refused_close())
        with mock.patch.object(sb.V2Client, "session_active", return_value=["x"]):
            self.assertIn("pass --force", self.refused_close())
        self.world.v2.sessions[self.world.sessions["worker"]]["idle"] = None   # no last activity known
        self.assertIn("pass --force", self.refused_close())

    def test_a_turn_that_begins_between_the_two_judgments_stops_the_close_and_a_refusal_reads_once(self):   # S8
        self.close_world(status="working")
        sid = self.idle_session(86400)
        real, calls = sb.retire_close_problem, []

        def turn_begins(engine, runner, now, discovery, name, seen, force):
            calls.append(1)
            if len(calls) == 2:
                self.world.v2.sessions[sid]["turn"] = {"id": "t"}
            return real(engine, runner, now, discovery, name, seen, force)

        self.as_("boss")
        with mock.patch.object(sb, "retire_close_problem", turn_begins):
            code, out, err = self.run_cli("retire", "worker", "--close")
        self.assertEqual(self.world.herdr.closed, [], out)
        self.assertIn("was not closed", out)
        self.idle_session(86400, turn={"id": "t"})
        with mock.patch.object(sb.V2Client, "session_active", autospec=True, side_effect=sb.V2Client.session_active) as read:
            self.refused_close()
        self.assertEqual(read.call_count, 1, "refused at the first judgment: one read")

    def test_a_last_turn_exactly_the_window_ago_is_idle(self):
        self.close_world(status="working")
        self.idle_session(10 * 60)
        self.as_("boss")
        self.assertEqual(self.run_cli("retire", "worker", "--close")[0], 0, "exactly the window is idle")

    def test_a_last_turn_dated_in_the_future_is_not_idle(self):
        self.close_world(status="working")
        self.idle_session(-3600)
        self.as_("boss")
        code, out, err = self.run_cli("retire", "worker", "--close")
        self.assertEqual((code, self.world.herdr.closed), (1, []), err)
        self.assertIn("pass --force", err)

    def test_an_entry_of_any_shape_for_the_session_in_session_active_is_unknown_never_idle(self):
        self.close_world(status="working")
        sid = self.idle_session(86400)
        for entry in ({}, None, {"type": "idle"}, 0):
            with mock.patch.object(sb.V2Client, "session_active", return_value={sid: entry}):
                self.assertIn("pass --force", self.refused_close(), repr(entry))
                self.assertIn("session state unknown", self.close_audit("fleetpane.close_refused")[-1]["detail"]["why"])

    def test_a_window_that_is_not_a_finite_number_in_range_refuses_at_use(self):
        self.close_world(status="working")
        self.idle_session(86400)
        for bad in (float("nan"), float("inf"), -1, True, "10", 0):
            self.engine.config["retire_idle_minutes"] = bad
            seen = self.engine.discover(self.world.clock.now()).agents["worker"]
            self.assertIsNone(sb.retire_idle_evidence(self.engine, self.world.clock.now, "worker", seen, "working"), repr(bad))
        self.engine.config["retire_idle_minutes"] = 10
        seen = self.engine.discover(self.world.clock.now()).agents["worker"]
        self.assertIn("idle 1 d 0 h", sb.retire_idle_evidence(self.engine, self.world.clock.now, "worker", seen, "working"))

    def test_a_blocked_pane_is_never_treated_as_idle_whatever_its_last_activity(self):   # S5
        self.close_world(status="blocked")
        self.idle_session(86400)
        self.assertIn("is blocked: pass --force", self.refused_close())

    def test_an_idle_session_does_not_lift_the_unpushed_work_refusal(self):   # S7
        self.close_world(status="working")
        self.make_repo()
        wt = self.add_worktree("w-idle-unpushed", unpushed=True)
        sb.register_worktree(self.world.state, str(wt), "worker", None, "w-idle-unpushed", 1)
        self.idle_session(86400)
        self.assertIn("unpushed", self.refused_close())

    def test_retire_idle_minutes_is_validated_and_sets_the_window(self):
        base = {"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR}
        self.assertEqual(sb.validate_config(dict(base))["retire_idle_minutes"], 10)
        for bad in (0, 0.5, -1, "10", True, None, float("nan"), float("inf"), 10081):
            with self.assertRaises(sb.ConfigError):
                sb.validate_config(dict(base, retire_idle_minutes=bad))

    def test_retire_without_close_closes_nothing_and_a_close_that_fails_is_audited_and_the_agent_stays_retired(self):
        self.close_world()
        self.as_("boss")
        self.assertEqual(self.run_cli("retire", "worker")[0], 0)
        self.assertEqual(self.world.herdr.closed, [])
        self.assertEqual(self.close_audit(), [])
        self.run_cli("retire", "--undo", "worker")
        with mock.patch.object(sb.HerdrClient, "pane_close", side_effect=sb.HerdrError("exit", "pane busy")):
            code, out, err = self.run_cli("retire", "worker", "--close")
        self.assertEqual(code, 0, err)
        self.assertIn("was not closed", out)
        self.assertIn("worker", sb.read_retired(self.world.state))
        (row,) = self.close_audit("fleetpane.close_failed")
        self.assertEqual(row["detail"]["pane"], self.world.panes["worker"])

    def test_the_worktree_reclaim_config_is_validated(self):
        base = {"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR}
        sb.validate_config(dict(base, worktree_reclaim={"enabled": True, "on_done": False}))
        for bad in ({"enabled": "no"}, {"when": True}, [], {"on_done": 1}):
            with self.subTest(bad=bad), self.assertRaises(sb.ConfigError):
                sb.validate_config(dict(base, worktree_reclaim=bad))

    def test_a_screen_that_cannot_be_read_is_unknown_never_detached_and_nothing_is_closed(self):
        pane = self.detach()
        self.world.herdr.panes[pane]["read_fails"] = True
        state, why, _ = sb.pane_state(self.engine, "platform", self.world.sessions["platform"], pane)
        self.assertEqual(state, sb.PANE_UNKNOWN)
        self.assertIn("could not be read", why)
        os.environ["HERDR_WORKSPACE_ID"] = "w1"
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        with captured() as (out, err):
            code = sb.main(["reattach", "platform"], runner=self.world.route, now=self.world.clock.now, socket_call=self.world.herdr.socket)
        self.assertNotEqual(code, 0)
        self.assertEqual((self.world.herdr.closed, pane in self.world.herdr.panes), ([], True))
        self.world.herdr.panes[pane]["title"] = "OC | platform"                    # a title that names the agent needs no screen at all
        self.assertEqual(sb.pane_state(self.engine, "platform", self.world.sessions["platform"], pane)[0], sb.PANE_ATTACHED)

    def test_a_tab_with_a_second_pane_or_a_working_pane_is_never_closed_and_names_match_whole_words_only(self):
        os.environ["HERDR_WORKSPACE_ID"] = "w1"
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        pane = self.detach()
        self.world.herdr.extra_panes = {self.world.herdr.tab_of(pane): ["a person's shell"]}
        with captured() as (out, err):
            code = sb.main(["reattach", "platform"], runner=self.world.route, now=self.world.clock.now, socket_call=self.world.herdr.socket)
        self.assertNotEqual(code, 0)
        self.assertIn("holds 2 panes", err.getvalue())
        self.world.herdr.extra_panes = {}
        self.world.herdr.panes[pane]["status"] = "working"
        with captured() as (out, err):
            code = sb.main(["reattach", "platform"], runner=self.world.route, now=self.world.clock.now, socket_call=self.world.herdr.socket)
        self.assertIn("is working", err.getvalue())
        self.assertEqual(self.world.herdr.closed, [])
        self.assertFalse(sb._names_agent("across the board", "cos", None))
        self.assertTrue(sb._names_agent("OC | cos", "cos", None))
        self.assertFalse(sb._names_agent("OpenCode", "build", None))

    def test_the_second_pass_after_the_recheck_window_does_not_repeat_the_audit_and_a_recovery_is_audited(self):
        pane = self.detach()
        self.health()
        self.health(sb.PANE_CHECK_SECONDS + 1)
        self.assertEqual(len([e for e in self.world.audit() if e["event"] == "fleetpane.detached"]), 1)
        self.world.herdr.panes[pane]["title"] = "OC | platform"
        self.health(2 * sb.PANE_CHECK_SECONDS + 5)
        self.assertEqual(len([e for e in self.world.audit() if e["event"] == "fleetpane.recovered"]), 1)

    def test_every_guard_before_the_close_refuses_a_pane_that_changes_a_tab_that_cannot_be_read_and_another_agents_session(self):
        os.environ["HERDR_WORKSPACE_ID"] = "w1"
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        pane = self.detach()
        herdr = self.world.herdr
        reads = []
        real = sb.pane_state

        def flipping(engine, name, session, p, names=(), sessions=()):
            reads.append(1)
            if len(reads) >= 2:                         # the re-judgement just before the close: the pane has changed under us
                herdr.panes[pane]["title"] = "OC | platform"
            return real(engine, name, session, p, names, sessions)
        with mock.patch.object(sb, "pane_state", flipping):
            with captured() as (out, err):
                code = sb.main(["reattach", "platform"], runner=self.world.route, now=self.world.clock.now, socket_call=herdr.socket)
        self.assertNotEqual(code, 0)
        self.assertIn("changed while it was being judged", err.getvalue())
        self.assertEqual((herdr.closed, pane in herdr.panes), ([], True))
        herdr.panes[pane]["title"] = "OpenCode"
        base = self.world.route

        def tab_get_fails(argv, **kw):
            if argv[0] == FAKE_HERDR and argv[1:3] == ["tab", "get"]:
                return subprocess.CompletedProcess(argv, 1, "", "error: timed out\n")
            return base(argv, **kw)
        with captured() as (out, err):
            code = sb.main(["reattach", "platform"], runner=tab_get_fails, now=self.world.clock.now, socket_call=herdr.socket)
        self.assertNotEqual(code, 0)
        self.assertIn("cannot say what tab", err.getvalue())
        self.assertEqual(herdr.closed, [])
        other = self.world.add_agent("coder")
        with captured() as (out, err):
            code = sb.main(["reattach", "platform", "--session", other], runner=self.world.route, now=self.world.clock.now, socket_call=herdr.socket)
        self.assertNotEqual(code, 0)
        self.assertIn("belongs to", err.getvalue())
        self.assertEqual(herdr.closed, [])

    def test_a_state_file_that_cannot_be_written_is_reported_by_the_pass_and_by_reattach_and_a_pane_with_no_tab_is_refused(self):
        self.engine.state_dir = self.world.state
        self.engine.discover(self.world.clock.now())
        with mock.patch.object(sb, "write_pane_health", side_effect=OSError(28, "No space left")):
            sb.pane_health_pass(self.engine, self.world.clock.now())
        self.assertTrue([e for e in self.world.audit() if e["event"] == "fleetpane.error"])
        self.detach()
        taken = self.engine.discover(self.world.clock.now()).agents["platform"]
        with mock.patch.object(sb, "pane_state", return_value=(sb.PANE_DETACHED, "x", {"tab": None})):
            with self.assertRaises(sb.LaunchError) as caught:
                sb.release_stale_binding(self.engine, "platform", taken, taken.session_id)
        self.assertIn("names no tab", str(caught.exception))

        os.environ["HERDR_WORKSPACE_ID"] = "w1"
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.detach()
        with mock.patch.object(sb, "write_pane_health", side_effect=OSError(28, "No space left")):
            with captured() as (out, err):
                code = sb.main(["reattach", "platform"], runner=self.world.route, now=self.world.clock.now, socket_call=self.world.herdr.socket)
        self.assertEqual(code, 0, err.getvalue())
        self.assertIn("pane-health.json was not updated", err.getvalue())

    def test_a_pass_checks_at_most_the_budget_of_panes(self):
        for n in range(sb.PANE_CHECKS_PER_PASS + 5):
            self.world.add_agent("w%d" % n)
        self.engine.state_dir = self.world.state
        self.engine.discover(self.world.clock.now())
        calls = []
        real = sb.pane_state
        with mock.patch.object(sb, "pane_state", lambda *a, **k: calls.append(1) or real(*a, **k)):
            sb.pane_health_pass(self.engine, self.world.clock.now())
        self.assertEqual(len(calls), sb.PANE_CHECKS_PER_PASS)

    def test_a_dead_agent_for_three_days_leaves_the_registry_only_at_a_view_read_never_on_a_pass(self):
        """#919: the pane pass forgets the old pane-health row (it stops waking cos) but removes nothing from the registry; the next view read does."""
        self.engine.state_dir = self.world.state
        reg = sb.load_module("registry")
        reg.upsert(self.world.state, "gone", {"pane": "w1:p9", "session": "ses_x", "role": "coder", "workspace": "w1"})
        path = self.world.state / "registry.json"
        doc = json.loads(path.read_text())
        doc["agents"]["gone"]["state"] = "dead"
        path.write_text(json.dumps(doc))
        sb.write_pane_health(self.world.state, {"agents": {"gone": {"pane": "w1:p9", "session": "ses_x"}}, "missing": {"gone": 9},
                                                "states": {"gone": {"state": "dead", "at": 1, "pane": "w1:p9", "session": "ses_x"}}})
        self.engine.discover(self.world.clock.now())
        sb.pane_health_pass(self.engine, 1 + sb.PANE_FORGET_SECONDS + 5)
        self.assertNotIn("gone", sb.read_pane_health(self.world.state)["agents"])   # forgotten here (stops waking cos)
        self.assertIn("gone", reg.read(self.world.state)["agents"])                 # but the registry keeps it: no removal on a pass
        audit = self.world.state / "registry-audit.jsonl"
        self.assertEqual([l for l in (audit.read_text().splitlines() if audit.exists() else []) if "reconcile_remove" in l], [])
        self.assertEqual(sb.reconcile_agents_on_read(self.world.state, self.engine.herdr), ["gone"])   # the view read removes it
        self.assertNotIn("gone", reg.read(self.world.state)["agents"])

    def test_a_forgotten_dead_agent_stops_waking_and_the_charter_pane_line_is_rewritten_only_when_present(self):
        self.engine.state_dir = self.world.state
        sb.write_pane_health(self.world.state, {"agents": {"gone": {"pane": "w1:p9", "session": "ses_x"}}, "missing": {"gone": 9},
                                                "states": {"gone": {"state": "dead", "at": 1, "pane": "w1:p9", "session": "ses_x"}}})
        self.engine.discover(self.world.clock.now())
        sb.pane_health_pass(self.engine, 1 + sb.PANE_FORGET_SECONDS + 5)
        self.assertEqual(sb.read_pane_health(self.world.state)["agents"], {"platform": sb.read_pane_health(self.world.state)["agents"]["platform"]})
        body = {"text": "Charter\npane: w1:p1\nowner: x\n"}
        patches = []

        def gh(argv, **kw):
            if "--method" in argv and argv[argv.index("--method") + 1] == "PATCH":
                patches.append(json.loads(kw["input"]))
                return subprocess.CompletedProcess(argv, 0, "{}", "")
            return subprocess.CompletedProcess(argv, 0, json.dumps({"body": body["text"]}), "")
        self.engine.config = dict(self.engine.config, gh="gh")
        note = sb.charter_pane_update(self.engine, gh, {"charter": 5, "repo": "acme/app"}, "w1:p7")
        self.assertIn("now says pane: w1:p7", note)
        self.assertEqual(patches[0]["body"], "Charter\npane: w1:p7\nowner: x\n")
        body["text"] = "no pane line here\n"
        self.assertIn("no `pane:` line", sb.charter_pane_update(self.engine, gh, {"charter": 5, "repo": "acme/app"}, "w1:p8"))
        self.assertEqual(len(patches), 1)

    # -- a retired or closed agent leaves pane-health.json (the record the workspace health pane draws from), on whole reads only

    def retired_entry(self, session, **extra):
        return dict({"at": int(self.world.clock.now()), "by": "x", "reason": "finished", "session": session, "auto": False}, **extra)

    def test_s1_s7_s5_a_pass_prunes_retired_agents_and_keeps_a_live_a_relaunched_and_a_detached_one(self):
        self.engine.state_dir = self.world.state
        self.world.add_agent("coder", fleet={"role": "coder"})
        self.detach("coder")
        self.health()                                                   # platform (live) and coder (detached) are recorded
        row = lambda ses, role: {"session": ses, "pane": "w1:p9", "role": role, "workspace": "w9"}
        data = sb.read_pane_health(self.world.state)
        for n in ("r1", "r2", "r3"):
            data["agents"][n] = row("ses_" + n, "orchestrator")
            data["states"][n] = {"state": "unknown", "session": "ses_" + n}
        data["agents"]["relaunch"] = row("ses_new", "orchestrator")      # retired under an OLD session, running again under a new one
        sb.write_pane_health(self.world.state, data)
        reg = sb.load_module("registry")                                 # the agent list is the registry's: the rows and the retirements go there
        for n in ("r1", "r2", "r3"):
            reg.upsert(self.world.state, n, data["agents"][n], now=int(self.world.clock.now()))
            reg.retire(self.world.state, n, "x", "finished", now=int(self.world.clock.now()))
        reg.upsert(self.world.state, "relaunch", {"session": "ses_old", "pane": "w1:p9"}, now=int(self.world.clock.now()))
        reg.retire(self.world.state, "relaunch", "x", "finished", now=int(self.world.clock.now()))
        reg.upsert(self.world.state, "relaunch", data["agents"]["relaunch"], now=int(self.world.clock.now()))
        self.health(1)
        agents = sb.read_pane_health(self.world.state)
        self.assertEqual(sorted(agents["agents"]), ["coder", "platform", "relaunch"])
        set_retired(self.world.state, {"platform": self.retired_entry(None), "coder": self.retired_entry(None)})   # a record with NO session covers nothing
        self.health(2)
        self.assertEqual(sorted(sb.read_pane_health(self.world.state)["agents"]), ["coder", "platform", "relaunch"])
        self.assertFalse(sb.retired_agent({"x": {"session": None}}, "x", None))
        self.assertNotIn("r1", agents["states"])
        self.assertEqual(agents["states"]["coder"]["state"], sb.PANE_DETACHED)

    def test_s5_a_pane_closed_after_the_final_report_is_pruned_with_its_auto_retire(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.worker()
        self.health()
        self.assertIn("worker", sb.read_pane_health(self.world.state)["agents"])
        sb.record_last_report(self.world.state, "worker", "done", self.world.clock.now())
        self.kill("worker")
        for n in range(sb.PANE_MISSING_PASSES):
            self.health(n)
        self.assertEqual(sb.read_retired(self.world.state)["worker"]["auto"], True)
        self.assertNotIn("worker", sb.read_pane_health(self.world.state)["agents"])

    def test_s3_s6_a_half_read_prunes_nothing(self):
        self.engine.state_dir = self.world.state
        self.health()
        data = sb.read_pane_health(self.world.state)
        data["agents"]["old"] = {"session": "ses_old", "pane": "w1:p9", "role": "orchestrator", "workspace": "w9"}
        sb.write_pane_health(self.world.state, data)
        sb.load_module("registry").upsert(self.world.state, "old", data["agents"]["old"])
        set_retired(self.world.state, {"old": self.retired_entry("ses_old")})
        path = self.world.state / sb.PANE_HEALTH_FILE
        before = path.read_bytes()
        discovery = self.engine.discover(self.world.clock.now())
        discovery.problems = ["list not whole"]                         # the agent list is a half-read
        sb.pane_health_pass(self.engine, self.world.clock.now() + 1)
        self.assertEqual(path.read_bytes(), before)
        reg = sb.load_module("registry")
        with mock.patch.object(reg, "read", return_value=reg._empty(False, "half")):   # the registry read is not whole: the pass acts on nothing
            self.health(2)
        self.assertIn("old", sb.read_pane_health(self.world.state)["agents"])
        self.health(3)                                                   # a whole read prunes it
        self.assertNotIn("old", sb.read_pane_health(self.world.state)["agents"])

    def test_s8_a_pruned_retired_agent_is_still_found_by_the_retire_undo_reattach_and_the_boss_lookup(self):
        for key in [k for k in os.environ if k.startswith(("HERDR_", "OPENCODE_")) and k != "HERDR_PANE_ID"]:
            self.addCleanup(os.environ.__setitem__, key, os.environ[key])
            del os.environ[key]                                           # a clean environment: nothing masks a record the prune dropped
        self.addCleanup(os.environ.pop, "HERDR_WORKSPACE_ID", None)
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.worker()
        self.health()
        session = self.world.sessions["worker"]
        self.as_("boss")
        before = dict(sb.read_pane_health(self.world.state)["agents"]["worker"])
        self.assertTrue(before.get("workspace"), "the pass records the workspace")
        code, out, err = self.run_cli("retire", "worker", "--reason", "done")
        self.assertEqual(code, 0, err)
        self.assertNotIn("worker", sb.read_pane_health(self.world.state)["agents"])     # pruned in the same step as the retire
        kept = sb.known_agent(self.world.state, "worker")
        for field in set(before) - {"seen"}:                              # every field of the pane record but `seen` survives the prune (a null one is the same as none)
            self.assertEqual(kept.get(field), before[field], field)
        self.assertEqual(set(before) - {"seen", "session"}, set(sb.RETIRED_RECORD_FIELDS), "a field the pass records that the retirement does not keep")
        self.assertEqual(sb.read_retired(self.world.state)["worker"]["session"], session)
        self.assertEqual(sb.known_session(self.world.state, "worker", {}), session)
        self.kill("worker")
        self.health(1)
        self.assertNotIn("worker", sb.read_pane_health(self.world.state)["agents"])
        discovery = self.engine.discover(self.world.clock.now())
        self.assertIsNone(sb.reattach_caller_problem(self.engine, self.world.route, self.world.clock.now, discovery, "worker", None))   # boss lookup, session from retired.json
        code, out, err = self.run_cli("retire", "worker", "--reason", "again")           # retiring a pruned agent again still works
        self.assertEqual(code, 0, err)
        code, out, err = self.run_cli("reattach", "worker")                                # a retired agent is refused until undone, as before
        self.assertNotEqual(code, 0)
        code, out, err = self.run_cli("retire", "--undo", "worker")                       # the boss and session come from retired.json
        self.assertEqual(code, 0, err)
        code, out, err = self.run_cli("reattach", "worker")
        self.assertEqual(code, 0, err)
        self.assertEqual(json.loads(out)["session"], session)
        self.assertEqual(sb.read_pane_health(self.world.state)["agents"].get("worker", {}).get("workspace"), before["workspace"])   # --undo put the whole record back

    def test_the_pass_drops_the_state_of_an_orphan_and_keeps_a_listed_undiscovered_a_discovered_unlisted_and_a_cloud_name(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.engine.state_dir = self.world.state
        self.health()
        now, reg = int(self.world.clock.now()), sb.load_module("registry")
        reg.upsert(self.world.state, "gone", {"session": "ses_gone", "pane": "w1:p9", "state": "dead"}, now=now)            # listed, not discovered: a dead agent's alert
        reg.upsert(self.world.state, "pod1", {"session": "ses_pod", "kind": "cloud", "run_id": "run_example"}, now=now)    # a cloud row: no pane state
        data = sb.read_pane_health(self.world.state)
        for name in ("orphan", "gone", "nodisc"):
            data["states"][name] = {"state": sb.PANE_DEAD, "why": "x", "pane": "w1:p9", "session": "ses_" + name, "at": now}
        data["missing"]["orphan"] = 2
        sb.write_pane_health(self.world.state, data)
        self.engine.discover(self.world.clock.now())
        self.engine.discovery.agents["nodisc"] = sb.Observation("nodisc", "ses_nodisc", None, "idle", {"role": "coder"})   # discovered, with no pane: never listed by the pass
        sb.pane_health_pass(self.engine, self.world.clock.now() + 1)
        health = sb.read_pane_health(self.world.state)
        self.assertNotIn("orphan", health["states"])                    # in neither the registry nor discovery: dropped, with its missing count
        self.assertNotIn("orphan", health["missing"])
        self.assertEqual(health["states"]["gone"]["state"], sb.PANE_DEAD)   # the dead agent's state stays: its alert is read from it
        self.assertIn("gone", self.engine.pane_alerts)
        self.assertIn("nodisc", health["states"])                       # discovered: kept
        self.assertNotIn("pod1", health["states"])                      # a cloud row has no pane state, and the registry keeps it
        self.assertEqual(reg.get(self.world.state, "pod1")["run_id"], "run_example")

    def test_s5_the_registry_gives_reattach_retire_undo_and_the_cloud_log_read_the_same_results_with_a_clean_environment(self):
        for key in [k for k in os.environ if k.startswith(("HERDR_", "OPENCODE_")) and k != "HERDR_PANE_ID"]:
            self.addCleanup(os.environ.__setitem__, key, os.environ[key])
            del os.environ[key]
        self.addCleanup(os.environ.pop, "HERDR_WORKSPACE_ID", None)
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.worker()
        self.health()
        session = self.world.sessions["worker"]
        reg = sb.load_module("registry")
        self.assertEqual(reg.get(self.world.state, "worker")["session"], session)            # the pass registered it
        self.assertEqual(reg.get(self.world.state, "worker")["workspace"], sb.read_pane_health(self.world.state)["agents"]["worker"]["workspace"])
        self.as_("boss")
        self.assertEqual(self.run_cli("retire", "worker", "--reason", "done")[0], 0)
        self.assertNotIn("worker", reg.read(self.world.state)["agents"])
        self.assertEqual(sb.known_agent(self.world.state, "worker")["session"], session)   # what the cloud log read finds
        self.kill("worker")
        self.health(1)
        self.assertEqual(self.run_cli("retire", "--undo", "worker")[0], 0)
        self.assertEqual(reg.get(self.world.state, "worker")["session"], session)
        code, out, err = self.run_cli("reattach", "worker")
        self.assertEqual(code, 0, err)
        self.assertEqual(json.loads(out)["session"], session)

    def test_a_registry_that_is_not_whole_makes_reattach_retire_and_the_close_guard_change_nothing(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.worker()
        self.health()
        text = json.dumps({"version": 7, "agents": {}, "retired": {}})
        (self.world.state / "registry.json").write_text(text)
        self.as_("boss")
        for argv in (("retire", "worker"), ("reattach", "worker"), ("retire", "worker", "--close")):
            with self.subTest(argv=argv):
                code, out, err = self.run_cli(*argv)
                self.assertNotEqual(code, 0)
                self.assertIn("registry", err)
        discovery = self.engine.discover(self.world.clock.now())
        pane, why = sb.retire_close_problem(self.engine, self.world.route, self.world.clock.now, discovery, "worker", discovery.agents["worker"], False)
        self.assertEqual(pane, None)
        self.assertIn("registry cannot be read", why)
        before = (self.world.state / "pane-health.json").read_bytes()
        self.health(5)                                                       # the pass acts on nothing either
        self.assertEqual((self.world.state / "registry.json").read_text(), text)
        self.assertEqual((self.world.state / "pane-health.json").read_bytes(), before)

    def test_a_cloud_worker_in_the_registry_is_never_judged_by_the_pane_pass(self):
