class CallBound(AssertionError):
    pass


class BoundedList(list):
    """A list of recorded calls that refuses the 10001st: a mutant that never leaves its loop fails fast instead of growing until the machine is out of memory."""
    BOUND = 10000

    def append(self, item):
        if len(self) >= self.BOUND:
            raise CallBound("call bound of %d recorded calls passed: a loop that never ends" % self.BOUND)
        super().append(item)


class BoundedOut(io.StringIO):
    """The wrapper's output in a test: refuses more than 1 MB, or more than 10000 writes, for the same reason."""
    LIMIT = 1024 * 1024

    def __init__(self):
        super().__init__()
        self.writes = 0

    def write(self, text):
        self.writes += 1
        if self.writes > BoundedList.BOUND or self.tell() + len(text) > self.LIMIT:
            raise CallBound("call bound passed: the output holds %d bytes after %d writes" % (self.tell(), self.writes))
        return super().write(text)


class TestMadeUpPids(unittest.TestCase):
    """The helper of made-up process numbers (#886) and the tests that stand in for a process."""

    def test_s3_a_number_that_is_alive_is_never_returned_and_none_is_self_parent_or_live(self):
        child = subprocess.Popen(["sleep", "30"])
        self.addCleanup(child.kill)
        self.addCleanup(child.wait)
        module, proofs, real = sys.modules[__name__], {}, _pid_alive
        spy = lambda pid: proofs.__setitem__(pid, real(pid)) or proofs[pid]           # the proof the helper made for each number it looked at
        with mock.patch.object(module, "_MADE_UP_NEXT", [child.pid]), mock.patch.object(module, "_MADE_UP_GIVEN", set()), mock.patch.object(module, "_pid_alive", spy), \
                mock.patch.object(module, "_MADE_UP_BLOCK", [0]):
            numbers = [made_up_pid() for _ in range(50)]
        self.assertEqual(len(set(numbers)), 50)
        self.assertNotIn(child.pid, numbers)                          # the live number it started at is skipped
        self.assertTrue(proofs[child.pid])
        self.assertEqual([n for n in numbers if proofs.get(n) is not False or n in (os.getpid(), os.getppid(), child.pid)], [])

    def test_s3_the_helper_skips_every_number_the_proof_says_is_alive_even_the_one_it_would_start_at(self):
        with mock.patch.object(sys.modules[__name__], "_MADE_UP_NEXT", [5000]), mock.patch.object(sys.modules[__name__], "_MADE_UP_GIVEN", set()), \
                mock.patch.object(sys.modules[__name__], "_pid_alive", lambda pid: pid in (5000, 5001, 5003)):
            got = [made_up_pid() for _ in range(3)]
        self.assertEqual(got, [5002, 5004, 5005])

    def test_s6_no_number_is_given_twice_in_a_hundred_and_a_restarted_base_does_not_repeat(self):
        numbers = [made_up_pid() for _ in range(100)]
        self.assertEqual(len(set(numbers)), 100)
        with mock.patch.object(sys.modules[__name__], "_MADE_UP_NEXT", [numbers[0]]):
            self.assertNotIn(made_up_pid(), numbers)    # the base went back to the first number: it is not handed out again

    def test_the_table_gives_one_number_per_key_inside_a_test_and_other_numbers_to_other_tests(self):
        class Case(StandInPids):
            pass
        one, other = Case(), Case()
        self.assertEqual(one.px[4242], one.px[4242])
        self.assertNotEqual(one.px[4242], one.px[4243])
        self.assertNotEqual(one.px[4242], other.px[4242])

    def test_s2_the_guard_refuses_the_real_parent_and_this_process_and_signals_nothing(self):
        self.assertIn("this command or its parent", sb.daemon_pid_refusal(os.getppid()))
        self.assertIn("this command or its parent", sb.daemon_pid_refusal(os.getpid()))
        self.assertIsNone(sb.daemon_pid_refusal(made_up_pid()))

    def test_the_liveness_proof_pins_every_answer_of_the_system(self):
        module = sys.modules[__name__]
        for error, alive in ((ProcessLookupError(), False), (PermissionError(), True), (OSError(errno.EIO, "x"), True)):
            with self.subTest(error=type(error).__name__), mock.patch.object(os, "kill", side_effect=error):
                self.assertIs(module._pid_alive(5), alive)
        with mock.patch.object(os, "kill", return_value=None):
            self.assertTrue(module._pid_alive(5))

    def test_the_helper_never_returns_this_process_its_parent_or_its_grandparent(self):
        module = sys.modules[__name__]
        first = [None]
        with mock.patch.object(module, "_MADE_UP_GIVEN", set()), mock.patch.object(module, "_pid_alive", lambda pid: False), mock.patch.object(module, "_MADE_UP_NEXT", [6000]):
            with mock.patch.object(module, "_ancestors", lambda: {6000, 6001, 6002}), mock.patch.object(os, "getppid", lambda: 6003), mock.patch.object(os, "getpid", lambda: 6004):
                got = [made_up_pid() for _ in range(3)]
        self.assertEqual(got, [6005, 6006, 6007])
        self.assertTrue({os.getpid(), os.getppid()} & set(module._ancestors()))

    # -- the completeness scan: no integer literal stands in for a process anywhere in this file but through the helper

    @staticmethod
    def pid_literals(source, skip=("TestMadeUpPids",)):
        """[(line, number, where)]: every integer literal above 1 in a position that names a process: a `pid=`, `ppid=`, `pgid=` or `*_pid=` keyword, a dict key
        of that kind, an assignment or default for a name of that kind, a comparison with one, and the first two numbers of a process-table row (a tuple of
        4 or 5 whose first two are integers, inside a list). A number from `self.px[...]`, the helper, is not a literal."""
        tree = ast.parse(source)
        parents = {child: node for node in ast.walk(tree) for child in ast.iter_child_nodes(node)}
        skipped = {id(inner) for node in tree.body if isinstance(node, ast.ClassDef) and node.name in skip for inner in ast.walk(node)}
        isint = lambda n: isinstance(n, ast.Constant) and type(n.value) is int
        named = lambda name: any(name == k or name.endswith("_" + k) or name.startswith(k + "_") for k in ("pid", "ppid", "pgid", "pgrp"))
        hits = []

        def add(node, why):
            if isint(node) and node.value > 1 and id(node) not in skipped:
                hits.append((node.lineno, node.value, why))
        for node in ast.walk(tree):
            if isinstance(node, ast.keyword) and node.arg and named(node.arg):
                add(node.value, "keyword " + node.arg)
            elif isinstance(node, ast.Dict):
                for key, value in zip(node.keys, node.values):
                    if isinstance(key, ast.Constant) and isinstance(key.value, str) and named(key.value):
                        add(value, "dict " + key.value)
            elif isinstance(node, ast.Assign):
                for target in node.targets:
                    base = target.value if isinstance(target, ast.Subscript) else target
                    name = getattr(base, "attr", None) or getattr(base, "id", None)
                    if name and named(name):
                        add(node.value, "assign " + name)
                        for element in (node.value.elts if isinstance(node.value, (ast.List, ast.Tuple, ast.Set)) else []):
                            add(element, "assign " + name)
            elif isinstance(node, ast.arguments):
                for arg, default in zip(node.args[len(node.args) - len(node.defaults):], node.defaults):
                    if named(arg.arg):
                        add(default, "default " + arg.arg)
            elif isinstance(node, ast.Compare):
                sides = [node.left] + node.comparators
                if any(isinstance(side, ast.Name) and named(side.id) for side in sides):
                    for side in sides:
                        add(side, "compare")
            elif isinstance(node, ast.Tuple) and 4 <= len(node.elts) <= 5 and isinstance(parents.get(node), (ast.List, ast.ListComp)) \
                    and all(isint(e) or isinstance(e, (ast.Subscript, ast.Name, ast.Attribute, ast.Call)) for e in node.elts[:2]):
                add(node.elts[0], "row pid")
                add(node.elts[1], "row ppid")
                if isint(node.elts[2]):
                    add(node.elts[2], "row pgid")
        return sorted(set(hits))

    def test_no_integer_literal_stands_in_for_a_process_anywhere_in_the_test_file(self):
        self.assertEqual(self.pid_literals(Path(__file__).read_text()), [])

    def test_the_scan_catches_each_position_a_hard_coded_number_can_take(self):
        mutants = ('rows = [(4001, 1, self.p, 7, "x")]', 'rows = [(self.px[1], 4001, self.p, 7)]', 'call(pid=4001)', 'call(shell_pid=4001)', 'x = {"pid": 4001}',
                   'self.job_pid = 4001', 'self.pid[0] = 4001', 'def f(pid=4001): pass', 'if pid != 4001: pass', 'self.alive_pid = [4001]')
        for source in mutants:
            with self.subTest(source=source):
                self.assertEqual([h[1] for h in self.pid_literals(source)], [4001])
        for clean in ('rows = [(self.px[4001], 1, self.p, 7)]', 'call(pid=self.px[4001])', 'x = {"pid": 1}', 'for mode in (1, 2, 3, 4): pass', 'self.assertEqual(got, (5, 6, 7, 9))'):
            with self.subTest(clean=clean):
                self.assertEqual(self.pid_literals(clean), [])

    @staticmethod
    def all_subclasses(base):
        found = []
        for cls in base.__subclasses__():
            found += [cls] + TestMadeUpPids.all_subclasses(cls)
        return list(dict.fromkeys(found))

    @staticmethod
    def stand_in_tests_of(cls):
        """The tests of `cls` that ask for a made-up number, found from the code: a test whose source, or the source of `setUp` or of a method of the class it
        calls (followed through, as far as it goes), mentions `self.px` or `made_up_pid`. A class whose `setUp` asks makes every test of it one."""
        def mentions(name, seen):
            if name in seen:
                return False
            seen.add(name)
            member = getattr(cls, name, None)
            if member is None or not callable(member):
                return False
            try:
                source = inspect.getsource(member)
            except (OSError, TypeError):
                return False
            if "self.px" in source or "made_up_pid" in source:
                return True
            return any(mentions(called, seen) for called in set(re.findall(r"self\.(\w+)\(", source)) if hasattr(cls, called))
        return [n for n in dir(cls) if n.startswith("test") and callable(getattr(cls, n)) and (mentions("setUp", set()) or mentions(n, {"setUp"}))]

    def stand_in_groups(self):
        module = sys.modules[__name__]
        real_parent = ("test_odd_file_names_in_the_state_directory_are_left_alone_and_never_stop_the_wrapper",)   # it uses the REAL parent as its live process
        return {cls.__name__: [n for n in self.stand_in_tests_of(cls) if n not in real_parent] for cls in self.all_subclasses(StandInPids)
                if cls is not TestMadeUpPids and cls.__module__ == module.__name__}

    def run_groups(self, groups, bases):
        """Each group with 4243 and 4242 as the real parent and grandparent, once per base. [(group, base, tests run, failures, numbers handed out, wrapped)]."""
        module, runs = sys.modules[__name__], []
        for group, names in groups.items():
            cls = getattr(module, group)
            for base in bases:
                suite, result = unittest.TestSuite(cls(n) for n in names), unittest.TestResult()   # a suite empties itself when it runs: one per base
                given = set(_MADE_UP_GIVEN)
                with mock.patch.object(os, "getppid", lambda: 4243), mock.patch.object(module, "_ancestors", lambda: {os.getpid(), 4243, 4242}), \
                        mock.patch.object(module, "_MADE_UP_NEXT", [base]):
                    suite.run(result)
                handed = sorted(_MADE_UP_GIVEN - given)
                runs.append((group, base, result.testsRun, [str(e[0]) for e in result.failures + result.errors], len(handed), bool(handed) and handed[0] < base))
        return runs

    def assert_wrapped(self, runs, groups):
        """The run from the top of the range happened and the helper wrapped in it, for every group that asked for more numbers than fit above the base."""
        top = _pid_limit() - 2
        for group, names in groups.items():
            mine = [r for r in runs if r[0] == group and r[1] == top]
            self.assertEqual(len(mine), 1, "no run from the top of the range for %s" % group)
            if mine[0][4] > 3:
                self.assertTrue(mine[0][5], "the helper asked for %d numbers from the top and never wrapped for %s" % (mine[0][4], group))
        self.assertTrue(any(r[5] for r in runs), "no group wrapped at all")

    def test_every_class_that_stands_in_for_a_process_passes_when_its_old_numbers_are_the_real_parent_and_grandparent_from_both_ends_of_the_range(self):
        """Derived, not listed: every subclass of StandInPids, every test of it that asks for a made-up number, with the old numbers as the real parent and
        grandparent, from base 4240 and from the top of the range (where the helper wraps to small numbers, so no test may depend on the order of numbers)."""
        groups = {g: names for g, names in self.stand_in_groups().items() if names}
        self.assertGreaterEqual(len(groups), 5)
        runs = self.run_groups(groups, (4240, _pid_limit() - 2))
        for group, base, ran, failed, handed, wrapped in runs:
            with self.subTest(group=group, base=base):
                self.assertGreater(ran, 0)
                self.assertEqual(failed, [])
        self.assert_wrapped(runs, groups)

    def test_dropping_the_run_from_the_top_of_the_range_fails_the_wrap_assertion(self):
        groups = {"TestHeavyWatchdog": ["test_s10_only_the_group_or_tree_the_wrapper_started_is_signalled_never_another_process"]}   # it asks for more than 3 numbers
        with self.assertRaises(AssertionError):
            self.assert_wrapped(self.run_groups(groups, (4240,)), groups)                        # the mutant: only the low base
        self.assert_wrapped(self.run_groups(groups, (4240, _pid_limit() - 2)), groups)           # the real thing passes

    def test_the_fake_herdrs_pane_shell_number_is_made_up_from_either_end_of_the_range(self):
        module = sys.modules[__name__]
        for base in (4240, _pid_limit() - 2):
            with mock.patch.object(module, "_MADE_UP_NEXT", [base]), mock.patch.object(module, "_ancestors", lambda: {os.getpid(), 4243, 4242}), \
                    mock.patch.object(os, "getppid", lambda: 4243):
                herdr = FakeHerdr(mock.Mock())
                self.assertEqual(herdr.shell_pid, herdr.shell_pid)
                self.assertNotIn(herdr.shell_pid, (os.getpid(), 4243, 4242))
                self.assertFalse(_pid_alive(herdr.shell_pid))

    def test_a_wrap_never_happens_inside_one_test_and_a_test_that_needs_more_numbers_than_fit_raises(self):
        module = sys.modules[__name__]
        top = _pid_limit()
        with mock.patch.object(module, "_MADE_UP_GIVEN", set()), mock.patch.object(module, "_pid_alive", lambda pid: False), mock.patch.object(module, "_ancestors", lambda: set()), \
                mock.patch.object(module, "_MADE_UP_FRESH", [False]), mock.patch.object(module, "_MADE_UP_NEXT", [top - 1]):
            self.assertEqual([made_up_pid(), made_up_pid()], [top - 1, top])
            with self.assertRaises(AssertionError):
                made_up_pid()                                  # the next number would have to wrap: inside a test that is refused, never done

    def test_a_wrap_happens_between_tests_and_inside_each_test_the_numbers_ascend_from_any_base(self):
        module = sys.modules[__name__]

        class Asks(unittest.TestCase):
            numbers = []

            def test_a(self):
                Asks.numbers.append([made_up_pid() for _ in range(5)])

            test_b = test_a

        for base in (4240, _pid_limit() - 2, _pid_limit() - 70, _pid_limit() - 63):
            Asks.numbers.clear()
            with mock.patch.object(module, "_MADE_UP_NEXT", [base]), mock.patch.object(module, "_ancestors", lambda: set()):
                result = unittest.TestResult()
                unittest.TestSuite([Asks("test_a"), Asks("test_b")]).run(result)
            with self.subTest(base=base):
                self.assertEqual([str(e[0]) for e in result.failures + result.errors], [])
                self.assertEqual(len(Asks.numbers), 2)
                for got in Asks.numbers:
                    self.assertEqual(got, sorted(got))
                    self.assertEqual(len(set(got)), 5)
                if base > _pid_limit() - _MADE_UP_BLOCK[0] - 1:
                    self.assertLess(Asks.numbers[0][0], base)   # it wrapped, and before the first number of the test

    def test_no_test_asks_for_more_numbers_than_the_reserve_and_the_hungriest_one_passes_from_any_base(self):
        """The reserve is at least what any test asks (checked over every request recorded so far, by any caller), and the test that asks for the most, run from
        bases inside and outside the last stretch of the range, passes: a test cannot run out of numbers because of where the machine's pids stand."""
        module = sys.modules[__name__]
        for _ in range(100):
            made_up_pid()                                  # its own ask, so it never depends on which tests ran before it (alone, the registry holds just this)
        hungriest = max(_MADE_UP_BY_TEST, key=lambda test: len(_MADE_UP_BY_TEST[test]))
        self.assertLessEqual(len(_MADE_UP_BY_TEST[hungriest]), _MADE_UP_BLOCK[0], hungriest)
        name = "test_s6_no_number_is_given_twice_in_a_hundred_and_a_restarted_base_does_not_repeat"
        self.assertGreaterEqual(len(_MADE_UP_BY_TEST.get("%s.%s.%s" % (__name__, type(self).__name__, name), [0] * 100)), 100)
        for base in (200, _pid_limit() - 98, _pid_limit() - 68, _pid_limit() - 2, _pid_limit() - 1023, _pid_limit() - 1025):
            result = unittest.TestResult()
            with mock.patch.object(module, "_MADE_UP_NEXT", [base]):
                type(self)(name).run(result)
            with self.subTest(base=base):
                self.assertEqual([str(e[0]) for e in result.failures + result.errors], [])

    def test_every_test_that_has_asked_for_numbers_so_far_in_this_process_was_given_them_in_ascending_order(self):
        """Recorded WHERE THE HELPER IS CALLED, by any caller (a fixture, a fake, a mixin): the registry holds every test that asked, with its numbers."""
        for _ in range(5):
            made_up_pid()                                  # its own ask, so it never depends on which tests ran before it
        self.assertIn(self.id(), _MADE_UP_BY_TEST)
        self.assertEqual([test for test, got in _MADE_UP_BY_TEST.items() if got != sorted(got) or len(set(got)) != len(got)], [])

    def test_the_old_numbers_are_never_handed_out_when_they_are_the_parent_and_grandparent(self):
        module = sys.modules[__name__]
        with mock.patch.object(os, "getppid", lambda: 4243), mock.patch.object(module, "_ancestors", lambda: {os.getpid(), 4243, 4242}), \
                mock.patch.object(module, "_MADE_UP_NEXT", [4240]), mock.patch.object(module, "_pid_alive", lambda pid: False):
            got = [made_up_pid() for _ in range(5)]
        self.assertFalse({4242, 4243} & set(got), got)


class TestHeavyQueueLogic(StandInPids, unittest.TestCase):
    """The queueing logic of `heavy_slots.run`, in one process: the lock attempt, the holder list, the clock, the sleep and the command's start are all injected, so no race
    between real processes decides anything (TestHeavySlots keeps the real-process integration check)."""

    def setUp(self):
        self.hs = sb.load_heavy_slots()
        self.out, self.attempts, self.sleeps, self.started, self.now = BoundedOut(), BoundedList(), BoundedList(), BoundedList(), [1000.0]
        self.clock_calls = BoundedList()
        self.fd = os.open(os.devnull, os.O_RDWR)
        self.addCleanup(lambda: os.close(self.fd) if self.fd is not None else None)
        self.held = [{"slot": i, "name": "who-%s" % c, "pid": 10 + i, "command": "sh", "since": 1} for i, c in enumerate("abc")]

    def patched(self, take, step):
        def clock():
            self.clock_calls.append(1)
            self.now[0] += step
            return self.now[0]

        def sleep(seconds):
            self.sleeps.append(seconds)

        class FakeChild:
            pid = self.px[4242]

            def __init__(child, argv, **kwargs):
                self.started.append(argv)

            def wait(child):
                return 0

        for patcher in (mock.patch.object(self.hs, "_take", take), mock.patch.object(self.hs, "holders", lambda state, slots=3: self.held),
                        mock.patch.object(self.hs.subprocess, "Popen", FakeChild)):
            patcher.start()
            self.addCleanup(patcher.stop)
        return clock, sleep

    def run_heavy(self, take, step, wait_max=1800, report="25"):
        clock, sleep = self.patched(take, step)
        environ = {"PATH": os.environ["PATH"], "FLEET_HEAVY_REPORT_SECONDS": report}
        return self.hs.run(["sh", "-c", "true"], "/state", 3, wait_max, "who-d", environ=environ, out=self.out, clock=clock, sleep=sleep)

    def test_s1_a_busy_queue_waits_says_so_once_and_takes_the_freed_slot(self):
        def take(state, slots):
            self.attempts.append(1)
            return (None, None) if len(self.attempts) <= 5 else (self.fd, 0)
        code = self.run_heavy(take, 10.0)
        self.fd = None   # run closed it
        self.assertEqual(code, 0)
        self.assertEqual(len(self.attempts), 6)
        self.assertEqual(len(self.started), 1, "the command ran once")
        self.assertEqual(self.out.getvalue().count("waiting for a slot (3 of 3 busy"), 1, self.out.getvalue())
        self.assertEqual(len(self.sleeps), 5, "it slept (through the fake) once for each busy attempt")

    def test_s2_past_the_wait_limit_it_gives_up_and_does_not_run_the_command(self):
        code = self.run_heavy(lambda state, slots: (None, None), 100.0, wait_max=250)
        self.assertEqual(code, 75)
        self.assertIn("no slot after", self.out.getvalue())
        self.assertEqual(self.started, [])

    def scripted(self, nows):
        """A clock that reads 1000.0 first (when the wait starts), then each of `nows` (seconds since the start) for the clock reads of the wait, then the last again."""
        values = iter([1000.0] + [1000.0 + n for n in nows])
        last = [1000.0]

        def clock():
            last[0] = next(values, last[0])
            return last[0]
        return clock

    def at(self, limit, elapsed, free_after=None):
        """run() with a wait limit of `limit` seconds, whose first check of the clock says `elapsed` seconds have passed; a slot comes free on the attempt numbered `free_after`."""
        attempts = BoundedList()

        def take(state, slots):
            attempts.append(1)
            return (self.fd, 0) if free_after is not None and len(attempts) >= free_after else (None, None)
        self.patched(take, 1.0)
        environ = {"PATH": os.environ["PATH"], "FLEET_HEAVY_REPORT_SECONDS": "100000"}
        code = self.hs.run(["sh", "-c", "true"], "/state", 3, limit, "who-d", environ=environ, out=self.out, clock=self.scripted([elapsed]), sleep=lambda seconds: None)
        if free_after is not None:
            self.fd = None
        return code, len(attempts)

    def test_the_wait_limit_is_pinned_at_its_boundary_for_the_stated_and_the_default_limit(self):
        for limit in (250, self.hs.DEFAULT_WAIT_MAX):
            for elapsed, rule in ((limit - 1, "one second before the limit it still waits and takes the slot that frees"),
                                  (limit, "at exactly the limit it gives up (the rule is `elapsed >= limit`)"),
                                  (limit + 1, "past the limit it gives up")):
                with self.subTest(limit=limit, elapsed=elapsed, rule=rule):
                    self.out, self.started = BoundedOut(), BoundedList()
                    self.fd = os.open(os.devnull, os.O_RDWR)
                    code, attempts = self.at(limit, elapsed, free_after=2)
                    if elapsed < limit:
                        self.assertEqual((code, attempts, len(self.started)), (0, 2, 1), rule)
                        self.assertNotIn("no slot after", self.out.getvalue())
                    else:
                        self.assertEqual((code, attempts, self.started), (75, 1, []), rule)
                        self.assertIn("no slot after %d s (3 of 3 busy" % elapsed, self.out.getvalue())
                    for patcher_stop in (os.close,):
                        if self.fd is not None:
                            patcher_stop(self.fd)
                            self.fd = None

    def test_s3_a_state_that_cannot_be_used_runs_the_command_without_a_slot_and_says_so(self):
        def take(state, slots):
            raise OSError(13, "Permission denied")
        code = self.run_heavy(take, 1.0)
        self.assertEqual(code, 0)
        self.assertEqual(len(self.started), 1)
        self.assertIn("heavy: no slot (Permission denied): running without one", self.out.getvalue())

    def test_s7_these_queue_tests_start_no_process_and_do_not_sleep(self):
        source = "".join(inspect.getsource(getattr(self, name)) for name in (
            "test_s1_a_busy_queue_waits_says_so_once_and_takes_the_freed_slot", "test_s2_past_the_wait_limit_it_gives_up_and_does_not_run_the_command",
            "test_s3_a_state_that_cannot_be_used_runs_the_command_without_a_slot_and_says_so")) + inspect.getsource(self.patched) + inspect.getsource(self.run_heavy)
        self.assertEqual((source.count("time" + ".sleep"), source.count("subprocess" + ".Popen(")), (0, 0))


class TestHeavyWatchdog(StandInPids, unittest.TestCase):
    """The runaway guard of the heavy wrapper (ask #598): a memory and a time ceiling on the command it started, stopping only what it started. The process table, the
    clock, the pauses and the signals are injected, so nothing here is timed by the machine; every loop is bounded."""

    def setUp(self):
        self.hs = sb.load_heavy_slots()
        self.out, self.signals, self.table_reads, self.started = BoundedOut(), BoundedList(), BoundedList(), BoundedList()
        self.exited = threading.Event()
        self.now = [1000.0]

    def run_watched(self, rows_for, environ_extra=None, status=0, ignore_term=True, rounds=20, step=0.0, lives=True, grace=0.001):
        """run() of `sh -c true` whose command is a fake that lives until it is sent a KILL (or, if `ignore_term` is false, any signal); the watchdog is driven by
        `rows_for(read number)` and a clock that moves `step` seconds per read. Returns the wrapper's exit status."""
        test = self

        def clock():
            test.now[0] += step
            return test.now[0]

        class FakeChild:
            pid = self.px[4242]

            def __init__(child, argv, **kwargs):
                test.started.append(argv)

            def wait(child):
                if not lives:
                    return status   # the command just ends
                if not test.exited.wait(30):
                    raise AssertionError("the fake command was never stopped")
                return -9

        def read_table():
            test.table_reads.append(1)
            if len(test.table_reads) > rounds:
                test.exited.set()   # the bound: a watchdog that never decides ends the test, which then fails its assertions
            return [] if test.exited.is_set() else rows_for(len(test.table_reads))   # what was stopped is gone from the table

        def record(number, sig):
            self.signals.append((number, sig))
            if sig == signal.SIGKILL or not ignore_term:
                self.exited.set()

        environ = {"PATH": os.environ["PATH"], "FLEET_HEAVY": "off"}
        environ.update(environ_extra or {})
        dog = {"read_table": read_table, "pause": lambda seconds: self.stopping.wait(0.001), "killpg": record, "kill": record, "every": 0.001, "grace": grace, "sweep_pause": lambda seconds: None}
        with mock.patch.object(self.hs.subprocess, "Popen", FakeChild):
            return self.hs.run(["sh", "-c", "sleep 1000"], None, 3, 1, "who", environ=environ, out=self.out, clock=clock, sleep=lambda s: None, watchdog=dog)

    def test_s1_a_tree_past_the_memory_ceiling_is_stopped_politely_then_forced_with_137(self):
        rows = lambda n: [(self.px[4242], 1, self.px[4242], 20000 * 1024)]
        self.stopping = threading.Event()
        code = self.run_watched(rows)
        self.assertEqual(code, 137)
        self.assertEqual([sig for _p, sig in self.signals], [signal.SIGTERM, signal.SIGKILL])
        text = self.out.getvalue()
        self.assertEqual(text.count("memory ceiling of 16384 MB"), 1, text)
        self.assertEqual(text.count("peak 20000 MB"), 1, text)
        self.assertIn("sh -c sleep 1000", text)

    def test_s1_a_child_of_the_command_that_grows_is_counted_and_stopped_with_the_command(self):
        """rev-wake's run: the command itself is small, its CHILD is the one that grows."""
        rows = lambda n: [(self.px[4242], self.px[100], self.px[4242], 2 * 1024), (self.px[4300], self.px[4242], self.px[4242], 9000 * 1024), (self.px[4301], self.px[4300], self.px[4242], 9000 * 1024), (self.px[999], 1, self.px[999], 1024)]
        self.stopping = threading.Event()
        code = self.run_watched(rows)
        self.assertEqual(code, 137)
        self.assertIn("peak 18002 MB", self.out.getvalue())
        self.assertEqual({p for p, _s in self.signals}, {self.px[4242]}, "its own group, once: the child is in it")

    def test_s2_a_small_command_is_left_alone_and_keeps_its_own_status(self):
        for status in (0, 7):
            with self.subTest(status=status):
                self.signals, self.table_reads = BoundedList(), BoundedList()
                self.stopping = threading.Event()
                self.assertEqual(self.run_watched(lambda n: [(self.px[4242], 1, self.px[4242], 3000 * 1024)], status=status, lives=False), status)
                self.assertEqual(list(self.signals), [])

    def test_s3_past_the_time_ceiling_by_the_clock_it_is_stopped_with_124(self):
        self.stopping = threading.Event()
        code = self.run_watched(lambda n: [(self.px[4242], 1, self.px[4242], 1024)], {"FLEET_HEAVY_MAX_SECONDS": "100"}, step=60.0)
        self.assertEqual(code, 124)
        self.assertEqual(self.out.getvalue().count("time ceiling of 100 s"), 1, self.out.getvalue())
        self.assertEqual(len(self.signals), 2)

    def test_s3_the_time_stop_covers_the_tree_even_with_the_memory_ceiling_off(self):
        self.stopping = threading.Event()
        rows = lambda n: [(self.px[4242], 1, os.getpgrp(), 1), (self.px[4243], self.px[4242], os.getpgrp(), 1), (self.px[777], 1, self.px[777], 1)]
        code = self.run_watched(rows, {"FLEET_HEAVY_MAX_SECONDS": "100", "FLEET_HEAVY_MEM_MB": "0"}, step=60.0)
        self.assertEqual(code, 124)
        self.assertEqual({p for p, _s in self.signals}, {self.px[4242], self.px[4243]}, "the child goes too, the stranger does not")

    def test_s1_a_command_that_ends_on_the_polite_stop_gets_no_forced_one(self):
        self.stopping = threading.Event()
        code = self.run_watched(lambda n: [(self.px[4242], 1, self.px[4242], 20000 * 1024)], ignore_term=False, grace=5)
        self.assertEqual(code, 137)
        self.assertEqual([sig for _p, sig in self.signals], [signal.SIGTERM])

    def test_s11_a_process_that_survives_every_round_is_named_in_the_survivors_line(self):
        rows = [(self.px[4242], 1, self.px[4242], 10, "t0")]
        sent = BoundedList()
        record = lambda target, number: sent.append((target, number))
        dog = self.hs.Watchdog(self.px[4242], ["x"], 16384, 0, self.out, 0.0, read_table=lambda: rows, killpg=record, kill=record, rounds=3, sweep_pause=lambda s: None,
                               me=(self.px[9001], self.px[9002], self.px[9003]))
        dog.sample()
        dog.sweep()
        self.assertEqual(dog.survivors, [self.px[4242]])
        self.assertEqual(self.out.getvalue().count("survivors after the stop: %d" % self.px[4242]), 1, self.out.getvalue())
        self.assertEqual(sum(1 for _t, n in sent if n == signal.SIGKILL), 3, "each of 3 rounds: the group once, no member twice")

    def test_s11_an_unreadable_table_at_the_sweep_still_kills_the_command_itself(self):
        sent = BoundedList()
        record = lambda target, number: sent.append((target, number))

        def unreadable():
            raise OSError("ps failed")
        dog = self.hs.Watchdog(self.px[4242], ["x"], 16384, 0, self.out, 0.0, read_table=unreadable, killpg=record, kill=record, me=(self.px[9001], self.px[9002], self.px[9003]))
        dog.sweep()
        self.assertEqual(list(sent), [(self.px[4242], signal.SIGKILL)])

    def test_s4_an_unreadable_process_table_stops_nothing_and_says_so_once(self):
        def unreadable():
            raise OSError("ps failed")
        self.stopping = threading.Event()
        self.stopping.set()
        dog = self.hs.Watchdog(self.px[4242], ["x"], 16384, 0, self.out, 0.0, read_table=unreadable, killpg=self.signals.append, kill=self.signals.append)
        for _ in range(5):
            self.assertEqual(dog.sample()[0], None)
        self.assertEqual(list(self.signals), [])
        self.assertEqual(self.out.getvalue().count("cannot read the process table"), 1, self.out.getvalue())

    def test_s5_the_ceilings_read_the_defaults_a_value_and_off(self):
        self.assertEqual(self.hs.ceilings({}), (16384, 7200))
        self.assertEqual(self.hs.ceilings({"FLEET_HEAVY_MEM_MB": "8192", "FLEET_HEAVY_MAX_SECONDS": "60"}), (8192, 60))
        self.assertEqual(self.hs.ceilings({"FLEET_HEAVY_MEM_MB": "0", "FLEET_HEAVY_MAX_SECONDS": "0"}), (0, 0))
        self.assertEqual(self.hs.ceilings({"FLEET_HEAVY_MEM_MB": "lots", "FLEET_HEAVY_MAX_SECONDS": "-5"}), (16384, 7200), "a typo never turns the guard off")

    def test_s10_only_the_group_or_tree_the_wrapper_started_is_signalled_never_another_process(self):
        # (a) the command has its own group: one killpg to that group
        rows = lambda n: [(self.px[4242], 1, self.px[4242], 20000 * 1024), (self.px[777], 1, self.px[777], 30000 * 1024)]
        self.stopping = threading.Event()
        self.assertEqual(self.run_watched(rows), 137)
        self.assertEqual({p for p, _s in self.signals}, {self.px[4242]})
        # (b) it shares the wrapper's group: its descendants one by one, never the group, never the 30000 MB stranger
        self.signals, self.table_reads, self.stopping = BoundedList(), BoundedList(), threading.Event()
        self.exited = threading.Event()
        rows = lambda n: [(self.px[4242], 1, os.getpgrp(), 20000 * 1024), (self.px[4243], self.px[4242], os.getpgrp(), 1), (self.px[777], 1, self.px[777], 30000 * 1024), (self.px[778], 1, os.getpgrp(), 1)]
        self.assertEqual(self.run_watched(rows), 137)
        self.assertEqual({p for p, _s in self.signals}, {self.px[4242], self.px[4243]})

    PROBE = (
        "import os,sys,time,signal\n"
        "mode,d=sys.argv[1],sys.argv[2]\n"
        "def note(n): open(os.path.join(d,n),'w').write(str(os.getpid()))\n"
        "def grow():\n"
        "    x=bytearray(120*1024*1024)\n"
        "    for i in range(0,len(x),4096): x[i]=1\n"
        "    time.sleep(60)\n"
        "if os.fork()==0:\n"
        "    if mode=='early':\n"
        "        if os.fork()==0:\n"
        "            note('b'); time.sleep(2.0); grow(); os._exit(0)\n"
        "        os._exit(0)\n"
        "    if mode=='orphan':\n"
        "        if os.fork()==0:\n"
        "            note('b'); time.sleep(4.0); grow(); os._exit(0)\n"
        "        time.sleep(3.0); os._exit(0)\n"
        "    if mode=='ignore': signal.signal(signal.SIGTERM, signal.SIG_IGN)\n"
        "    if mode=='setsid': os.setsid()\n"
        "    note('b'); time.sleep(0.5); grow(); os._exit(0)\n"
        "time.sleep(60)\n")

    def real_probe(self, mode, slot=False):
        """Real small processes: a 120 MB child under a 60 MB ceiling. Returns (status, output, pid of the child); the child is always killed at the end of the test."""
        directory = Path(tempfile.mkdtemp())
        self.addCleanup(shutil.rmtree, str(directory), True)
        probe = directory / "probe.py"
        probe.write_text(self.PROBE)

        def reap():
            for name in ("b",):
                try:
                    os.kill(int((directory / name).read_text()), signal.SIGKILL)
                except (OSError, ValueError):
                    pass
        self.addCleanup(reap)
        out = io.StringIO()
        environ = {"PATH": os.environ["PATH"], "FLEET_HEAVY_MEM_MB": "60", "FLEET_HEAVY_MAX_SECONDS": "40"}
        if not slot:
            environ["FLEET_HEAVY"] = "off"
        status = self.hs.run(["python3", str(probe), mode, str(directory)], str(directory) if slot else None, 3, 1, "who", out=out, environ=environ,
                             watchdog={"every": 0.1, "grace": 1, "sweep_every": 0.2})
        try:
            pid = int((directory / "b").read_text())
        except (OSError, ValueError):
            self.fail("the child never started: %s" % out.getvalue())
        return status, out.getvalue(), pid

    def dead_within(self, pid, seconds=5):
        end = time.time() + seconds
        while time.time() < end:
            state = subprocess.run(["ps", "-o", "stat=", "-p", str(pid)], capture_output=True, text=True).stdout.strip()
            if not state or state.startswith("Z"):
                return True
            time.sleep(0.1)
        return False

    def test_s11_a_double_forked_orphan_that_grows_is_stopped_too(self):
        status, text, pid = self.real_probe("orphan")
        self.assertEqual(status, 137, text)
        self.assertTrue(self.dead_within(pid), "the orphan %d is still alive: %s" % (pid, text))

    def test_s15_a_double_fork_whose_parent_exits_at_once_is_found_by_the_slot_lock_it_holds(self):
        if not shutil.which("lsof"):
            self.skipTest("lsof is not installed here")
        status, text, pid = self.real_probe("early", slot=True)
        self.assertEqual(status, 137, text)
        self.assertTrue(self.dead_within(pid), "the grandchild %d is still alive: %s" % (pid, text))

    def test_s15_a_process_that_only_touched_the_lock_file_once_is_never_stopped_and_a_holder_seen_twice_is(self):
        sent = BoundedList()
        record = lambda target, number: sent.append((target, number))
        rows = [(self.px[4242], 1, self.px[4242], 10, "c"), (self.px[5000], 1, self.px[5000], 10, "orphan"), (self.px[5001], 1, self.px[5001], 10, "prober")]
        holders = iter([{self.px[5000], self.px[5001]}, {self.px[5000]}, {self.px[5000]}])   # 5001 had the file open at one look only
        dog = self.hs.Watchdog(self.px[4242], ["x"], 16384, 0, self.out, 0.0, read_table=lambda: rows, killpg=record, kill=record, me=(self.px[9001], self.px[9002], self.px[9003]),
                               lock_path="/state/heavy-slot-0.lock", lsof=lambda path: next(holders))
        dog.sample()
        dog.sample()
        live = dog.look()
        dog.signal(signal.SIGKILL, live)
        self.assertEqual(sorted({target for target, _n in sent}), sorted([self.px[4242], self.px[5000]]), "the orphan that holds the lock goes; the one-look prober does not")

    def test_s15_a_holder_seen_at_two_looks_with_a_gap_between_is_not_stopped(self):
        sent = BoundedList()
        record = lambda target, number: sent.append((target, number))
        rows = [(self.px[4242], 1, self.px[4242], 10, "c"), (self.px[5000], 1, self.px[5000], 10, "a waiting wrapper")]
        holders = iter([{self.px[5000]}, set(), {self.px[5000]}, set()])   # there at the 1st and 3rd look, not in between: never two in a row
        dog = self.hs.Watchdog(self.px[4242], ["x"], 16384, 0, self.out, 0.0, read_table=lambda: rows, killpg=record, kill=record, me=(self.px[9001], self.px[9002], self.px[9003]),
                               lock_path="/state/heavy-slot-0.lock", lsof=lambda path: next(holders))
        dog.sample()
        dog.sample()
        dog.sample()
        dog.signal(signal.SIGKILL, dog.look())
        self.assertEqual(sorted(set(target for target, _n in sent)), [self.px[4242]])
        self.assertLessEqual(len(dog.candidates), 1)

    def test_s15_two_concurrent_runs_never_signal_each_others_lock_holders(self):
        sent_a, sent_b = BoundedList(), BoundedList()
        rows = [(self.px[4242], 1, self.px[4242], 10, "a"), (self.px[4343], 1, self.px[4343], 10, "b"), (self.px[5000], 1, self.px[5000], 10, "holds a's lock"), (self.px[6000], 1, self.px[6000], 10, "holds b's lock")]
        who = {"/state/heavy-slot-0.lock": {self.px[5000]}, "/state/heavy-slot-1.lock": {self.px[6000]}}
        make = lambda pid, lock, sent: self.hs.Watchdog(pid, ["x"], 16384, 0, self.out, 0.0, read_table=lambda: rows, me=(self.px[9001], self.px[9002], self.px[9003]), lock_path=lock,
                                                        lsof=lambda path: who[path], killpg=lambda t, n: sent.append(t), kill=lambda t, n: sent.append(t))
        a, b = make(self.px[4242], "/state/heavy-slot-0.lock", sent_a), make(self.px[4343], "/state/heavy-slot-1.lock", sent_b)
        for dog in (a, b):
            dog.sample()
            dog.signal(signal.SIGKILL, dog.look())
        self.assertEqual(sorted(set(sent_a)), sorted([self.px[4242], self.px[5000]]))
        self.assertEqual(sorted(set(sent_b)), sorted([self.px[4343], self.px[6000]]))

    def test_the_lock_holder_list_is_for_the_same_user_only(self):
        self.assertIn("os.getuid()", inspect.getsource(self.hs.read_lock_holders))

    def test_s15_a_lsof_that_cannot_run_changes_nothing_and_is_said_once(self):
        def broken(path):
            raise OSError("lsof missing")
        dog = self.hs.Watchdog(self.px[4242], ["x"], 16384, 0, self.out, 0.0, read_table=lambda: [(self.px[4242], 1, self.px[4242], 10, "c")], killpg=lambda *a: None, kill=lambda *a: None,
                               me=(self.px[9001], self.px[9002], self.px[9003]), lock_path="/state/x.lock", lsof=broken)
        for _ in range(3):
            dog.sample()
        self.assertEqual(self.out.getvalue().count("cannot list who holds the slot lock"), 1, self.out.getvalue())

    def test_the_documents_do_not_claim_that_every_orphan_is_stopped_and_name_the_hole(self):
        text = (Path(__file__).resolve().parent.parent / "docs" / "switchboard.md").read_text()
        self.assertNotIn("an orphan, a child that ignores", text)
        self.assertIn("closes the slot lock", text)
        self.assertIn("FLEET_HEAVY=off", text.split("A runaway is stopped (#598)")[1].split("\n\n")[0], "the no-lock case is named")

    def test_s12_a_child_that_ignores_the_polite_stop_is_killed_by_the_forced_stop_and_sweep(self):
        status, text, pid = self.real_probe("ignore")
        self.assertEqual(status, 137, text)
        self.assertTrue(self.dead_within(pid), "the child %d is still alive: %s" % (pid, text))

    def test_s13_a_child_that_started_its_own_session_is_stopped_too(self):
        status, text, pid = self.real_probe("setsid")
        self.assertEqual(status, 137, text)
        self.assertTrue(self.dead_within(pid), "the session leader %d is still alive: %s" % (pid, text))

    def test_s14_a_reused_pid_the_wrapper_its_parent_and_its_group_are_never_signalled(self):
        sent = BoundedList()
        record = lambda target, number: sent.append((target, number))
        first = [(self.px[4242], 1, self.px[4242], 10, "t0"), (self.px[4300], self.px[4242], self.px[4242], 10, "A")]
        tables = iter([first, [(self.px[4300], 1, self.px[4300], 10, "B")]])   # the second: pid 4300 now belongs to another process (different start time)
        dog = self.hs.Watchdog(self.px[4242], ["x"], 16384, 0, self.out, 0.0, read_table=lambda: next(tables), killpg=record, kill=record, me=(self.px[9001], self.px[9002], self.px[9003]))
        self.assertEqual(dog.sample()[0], None)
        live = dog.look()
        self.assertEqual(live, set(), "the process that now holds pid %d is not the one that was seen" % self.px[4300])
        dog.signal(signal.SIGKILL, live)
        self.assertEqual(list(sent), [], "nothing signalled for a pid with another start time")
        # the wrapper (9001), its parent (9002) and its group (9003) as members of the tree or of the command's group
        rows = [(self.px[4242], 1, self.px[9003], 10, "t0"), (self.px[9001], self.px[4242], self.px[9003], 10, "w"), (self.px[9002], self.px[9001], self.px[9003], 10, "p"), (self.px[4300], self.px[4242], self.px[9003], 10, "A")]
        dog = self.hs.Watchdog(self.px[4242], ["x"], 16384, 0, self.out, 0.0, read_table=lambda: rows, killpg=record, kill=record, me=(self.px[9001], self.px[9002], self.px[9003]))
        dog.signal(signal.SIGKILL, dog.look())
        self.assertEqual(sorted(target for target, _n in sent), sorted([self.px[4242], self.px[4300]]), "never the wrapper, its parent, nor its group")

    def test_s6_a_run_whose_parent_is_gone_exits_with_143(self):
        parents = iter([500, 500, 1])
        exits = BoundedList()
        thread = watch_parent(getppid=lambda: next(parents, 1), exit_fn=exits.append, pause=lambda s: None, rounds=10)
        thread.join(5)
        self.assertEqual(list(exits), [143])

    def test_s6_a_parent_that_stays_does_not_end_the_run_and_init_as_parent_is_not_watched(self):
        exits = BoundedList()
        thread = watch_parent(getppid=lambda: 500, exit_fn=exits.append, pause=lambda s: None, rounds=50)
        thread.join(5)
        self.assertEqual(list(exits), [])
        self.assertIsNone(watch_parent(getppid=lambda: 1, exit_fn=exits.append))

    def test_s7_a_mutant_loop_that_never_ends_fails_at_the_call_bound(self):
        logic = TestHeavyQueueLogic("test_s1_a_busy_queue_waits_says_so_once_and_takes_the_freed_slot")
        logic.setUp()
        self.addCleanup(logic.doCleanups)   # stops the patches the queue fakes start (a leaked Popen fake breaks later tests)
        logic.attempts = BoundedList()
        with self.assertRaises(AssertionError) as caught:
            logic.run_heavy(lambda state, slots: (None, None), 0.001, wait_max=10 ** 12)
        self.assertIn("call bound", str(caught.exception))
        for recorded in (logic.attempts, logic.sleeps, logic.clock_calls):
            self.assertLessEqual(len(recorded), 10000)
        with self.assertRaises(AssertionError) as caught:   # the output the loop fills is capped too (1 MB)
            for _ in range(2000):
                logic.out.write("y" * 1000)
        self.assertIn("call bound", str(caught.exception))
        self.assertLessEqual(logic.out.tell(), BoundedOut.LIMIT)


class TestHeavyCeilings(StandInPids, unittest.TestCase):
    """Ask #930: a time ceiling per KIND of heavy run, read from the command. The clock, the process table, the signals, the sender and the audit are injected, so nothing
    waits for a real hour; the one real-process case (a wrapper killed with SIGKILL) is in TestHeavySlots."""

    # THE family table of the test: the kind, a command of that kind, the default ceiling. Derived completeness: a kind in the code with no row here fails.
    FAMILY = (
        ("full", ["bin/test-switchboard"], 5400),
        ("focused", ["bin/test-switchboard", "-k", "x"], 1800),
        ("e2e", ["playwright", "test"], 3600),
        ("other", ["ls"], 3600),
    )
    RUNNABLE = {"full": ["python3", "/nowhere/test-fake"], "focused": ["python3", "/nowhere/test-fake", "-k", "x"], "e2e": ["sh", "-c", "true", "e2e"], "other": ["sh", "-c", "true"]}   # commands that exist, for run()
    CLASSIFY = (
        (["bin/test-switchboard"], "full"), (["bin/test-switchboard", "-k", "x"], "focused"), (["tests/test_a.py"], "focused"),
        (["python3", "-m", "unittest", "a.b"], "focused"), (["playwright", "test"], "e2e"), (["bin/run-e2e.sh"], "e2e"),
        (["timeout", "60", "bin/test-switchboard"], "full"), (["ls"], "other"), (["sh", "x"], "other"),
    )

    def setUp(self):
        self.hs = sb.load_heavy_slots()
        self.now = [1000.0]
        self.signals, self.out = BoundedList(), BoundedOut()
        self.exited = threading.Event()
        self.reads = BoundedList()

    def drive(self, command, schedule, environ_extra=None, ceiling=None, config=None, short=False, on_stop=None, name="holder"):
        """run() of `command` whose child is fake; the watchdog's reads move the clock to start + schedule[n] (seconds); returns (exit status, signals seen at each read)."""
        test, seen = self, []
        base = test.now[0]

        class FakeChild:
            pid = self.px[4242]

            def __init__(child, argv, **kwargs):
                pass

            def wait(child):
                if not test.exited.wait(30):
                    raise AssertionError("the fake command was never stopped")
                return -9

        def read_table():
            seen.append(len(test.signals))
            if test.exited.is_set() or len(seen) > len(schedule):
                test.exited.set()
                return []
            test.now[0] = base + schedule[len(seen) - 1]
            return [(self.px[4242], 1, os.getpgrp(), 1), (self.px[4243], self.px[4242], os.getpgrp(), 1), (self.px[777], 1, self.px[777], 1)]   # a child and a grandchild of the run, and a stranger

        def record(number, sig):
            test.signals.append((number, sig))
            if sig == signal.SIGKILL:
                test.exited.set()

        environ = {"PATH": os.environ["PATH"], "FLEET_HEAVY": "off"}
        environ.update(environ_extra or {})
        dog = {"read_table": read_table, "pause": lambda seconds: False, "killpg": record, "kill": record, "every": 0.0, "grace": 0.001, "sweep_pause": lambda s: None}
        with mock.patch.object(self.hs.subprocess, "Popen", FakeChild):
            code = self.hs.run(command, None, 3, 1, name, environ=environ, out=self.out, clock=lambda: test.now[0], sleep=lambda s: None, watchdog=dog,
                               short=short, ceiling=ceiling, ceiling_config=config, on_stop=on_stop)
        return code, seen

    def test_s2_every_command_reads_as_its_kind_and_every_kind_has_a_row(self):
        for command, kind in self.CLASSIFY:
            with self.subTest(command=command):
                self.assertEqual(self.hs.classify(command), kind)
        self.assertEqual(self.hs.classify(["bin/test-switchboard"], short=True), "focused", "--short declares a short run")
        self.assertEqual({row[0] for row in self.FAMILY}, {kind for kind, _s, _m in self.hs.KINDS}, "a kind with no row here, or a row with no kind")
        self.assertEqual({kind for _c, kind in self.CLASSIFY}, {kind for kind, _s, _m in self.hs.KINDS}, "a kind no command above reads as")
        for kind, command, _default in self.FAMILY:
            self.assertEqual(self.hs.classify(command), kind)
            self.assertEqual(self.hs.classify(self.RUNNABLE[kind]), kind)

    def test_m2_a_word_that_only_contains_a_kind_name_never_changes_the_kind(self):
        """One case per matcher: a path, a filter value and a shell string that contain each kind's word; the kind stays that of the PROGRAM and its whole option words."""
        words = [w for w in self.hs.E2E_WORDS if not w.startswith("-")]
        self.assertTrue(words)
        for word in words:
            with self.subTest(word=word):
                self.assertEqual(self.hs.classify(["bin/test-switchboard", "-k", "test_%s_tabs" % word]), "focused")
                self.assertEqual(self.hs.classify(["bin/test-switchboard", "-k", word]), "focused", "a filter VALUE is not read")
                self.assertEqual(self.hs.classify(["bin/test-switchboard", "/work/repo-%s/file" % word]), "full", "a path argument")
                self.assertEqual(self.hs.classify(["sh", "-c", "cd /x/%s-app && bin/test-switchboard" % word]), "other", "a shell string is not read")
                self.assertEqual(self.hs.classify(["cat", "/tmp/%s.txt" % word]), "other")
                self.assertEqual(self.hs.classify(["python3", "/home/user/%s-notes/run.py" % word]), "other")
                self.assertEqual(self.hs.classify(["bin/test-switchboard", "--name", word]), "full", "the VALUE of an option the table does not list")
                self.assertEqual(self.hs.classify(["bin/test-switchboard", "--name=%s" % word]), "full")
                self.assertEqual(self.hs.classify(["bin/test-switchboard", "-v", "tests/test_x.py"]), "focused", "a test file after a flag still counts")
                self.assertEqual(self.hs.classify(["bin/test-switchboard", "tests/test_%s.py" % word]), "focused", "a test file argument is a focused run, whatever its name")
                self.assertEqual(self.hs.classify(["python3", "-m", word]), "e2e", "the program itself, or a whole word, is read")
                self.assertEqual(self.hs.classify(["npx", word, "test"]), "e2e")
                self.assertEqual(self.hs.classify(["timeout", "60", "bin/%s-runner" % word]), "e2e", "the program's own name")
        self.assertEqual(self.hs.classify(["bin/test-switchboard", "--browser"]), "e2e", "a whole option word")
        self.assertEqual(self.hs.classify(["python3", "-m", "unittest", "discover"]), "full", "a whole suite")
        self.assertEqual(self.hs.classify(["python3", "-m", "unittest"]), "full")
        self.assertEqual(self.hs.classify(["python3", "-m", "unittest", "-v", "a.b"]), "focused")
        self.assertEqual(self.hs.classify(["pytest", "a/b.py::t"]), "focused")
        self.assertEqual(self.hs.classify(["pytest"]), "full")
        for command in (["make", "test"], ["npm", "test"], ["go", "test"]):
            self.assertEqual(self.hs.classify(command), "full")
        self.assertEqual(self.hs.classify([]), "other")

    def test_the_configured_ceilings_never_pass_the_hard_maximum(self):
        for key in ("full", "focused", "e2e", "other", "max"):
            with self.subTest(key=key), self.assertRaises(self.hs.HeavyError):
                self.hs.settings({"ceilings": {key: 14401}})
        table = self.hs.ceiling_table({"ceilings": {"full": 99999999, "max": 99999999}})   # a config that was not validated reads as the default, never above the maximum
        self.assertEqual(table["max"], 14400)
        self.assertLessEqual(max(table.values()), 14400)
        self.assertEqual(self.hs.resolve_ceiling("full", {}, "99999", {"ceilings": {"full": 14401}}), 14400)

    def test_s3_each_kind_has_its_default_and_a_configured_value_replaces_only_its_own(self):
        for kind, command, default in self.FAMILY:
            with self.subTest(kind=kind):
                self.assertEqual(self.hs.resolve_ceiling(kind, {}), default)
                other = {"ceilings": {kind: 900}}
                self.assertEqual(self.hs.resolve_ceiling(kind, {}, config=other), 900)
                for rest, _c, rest_default in self.FAMILY:
                    if rest != kind:
                        self.assertEqual(self.hs.resolve_ceiling(rest, {}, config=other), rest_default)
        self.assertEqual(self.hs.ceiling_table(None)["max"], 14400)
        self.assertEqual(self.hs.resolve_ceiling("full", {}, "99999", {"ceilings": {"max": 7000}}), 7000, "the maximum is configurable")
        self.assertGreaterEqual(min(d for _k, _c, d in self.FAMILY), 1800, "no default is below the repository's longest CI step limit")

    def test_s4_an_unreadable_value_is_the_default_or_the_maximum_never_off(self):
        for kind, _command, default in self.FAMILY:
            for bad in ("lots", "-5", "1e3", "", " ", "5 s", None):
                with self.subTest(kind=kind, value=bad):
                    for got in (self.hs.resolve_ceiling(kind, {"FLEET_HEAVY_MAX_SECONDS": bad} if bad is not None else {}), self.hs.resolve_ceiling(kind, {}, bad)):
                        self.assertEqual(got, default)
            self.assertEqual(self.hs.resolve_ceiling(kind, {"FLEET_HEAVY_MAX_SECONDS": "99999999999999"}), 14400)
            for bad in ("lots", 0, -1, True, 1.5, None):   # an unreadable configured value is the default
                self.assertEqual(self.hs.resolve_ceiling(kind, {}, config={"ceilings": {kind: bad}}), default)

    def test_s5_a_higher_request_is_honoured_up_to_the_maximum_and_zero_is_the_maximum(self):
        for kind, _command, _default in self.FAMILY:
            with self.subTest(kind=kind):
                self.assertEqual(self.hs.resolve_ceiling(kind, {"FLEET_HEAVY_MAX_SECONDS": "10800"}), 10800)
                self.assertEqual(self.hs.resolve_ceiling(kind, {}, "10800"), 10800)
                self.assertEqual(self.hs.resolve_ceiling(kind, {}, "10800", None), 10800)
                for big in ("16200", "99999999"):
                    self.assertEqual(self.hs.resolve_ceiling(kind, {"FLEET_HEAVY_MAX_SECONDS": big}), 14400)
                self.assertEqual(self.hs.resolve_ceiling(kind, {"FLEET_HEAVY_MAX_SECONDS": "0"}), 14400)
                self.assertEqual(self.hs.resolve_ceiling(kind, {}, "0"), 14400)
                self.assertEqual(self.hs.resolve_ceiling(kind, {"FLEET_HEAVY_MAX_SECONDS": "60"}), 60, "a request may be lower (preflight-pr)")
                self.assertEqual(self.hs.resolve_ceiling(kind, {"FLEET_HEAVY_MAX_SECONDS": "60"}, "120"), 120, "--ceiling wins over the environment")

    def test_s6_each_kind_runs_on_one_second_before_its_ceiling_and_is_stopped_past_it_with_124(self):
        for kind, command, default in self.FAMILY:
            with self.subTest(kind=kind, at="ceiling-1"):
                self.signals, self.exited, self.out = BoundedList(), threading.Event(), BoundedOut()
                code, seen = self.drive(self.RUNNABLE[kind], [default - 1, default + 1])
                self.assertEqual(seen[:2], [0, 0], "before the ceiling nothing is signalled (the second read is the one at ceiling-1)")
                self.assertEqual(code, 124)
                self.assertEqual({p for p, _s in self.signals}, {self.px[4242], self.px[4243]}, "the child and the grandchild go, the stranger does not")
                self.assertIn("time ceiling of %d s" % default, self.out.getvalue())
            with self.subTest(kind=kind, at="exactly the ceiling"):
                self.signals, self.exited, self.out = BoundedList(), threading.Event(), BoundedOut()
                code, seen = self.drive(self.RUNNABLE[kind], [default, default + 1])
                self.assertEqual(seen[1], 0, "at the ceiling itself the run still goes on (stopped past it)")
                self.assertEqual(code, 124)

    def test_u1_a_run_under_its_ceiling_prints_nothing_new_and_keeps_its_exit_status(self):
        for status in (0, 3):
            with self.subTest(status=status):
                code = self.hs.run(["sh", "-c", "exit %d" % status], None, 3, 1, "who", environ={"PATH": os.environ["PATH"], "FLEET_HEAVY": "off"}, out=(out := BoundedOut()))
                self.assertEqual((code, out.getvalue()), (status, ""))
        out = BoundedOut()
        self.assertEqual(self.hs.run(["no-such-command-930"], None, 3, 1, "who", environ={"PATH": os.environ["PATH"]}, out=out), 127)
        self.assertEqual(out.getvalue(), "heavy: no-such-command-930: command not found\n")

    def test_u2_the_old_configuration_stays_valid_and_unknown_keys_are_refused(self):
        self.assertEqual(self.hs.settings(None), 3)
        self.assertEqual(self.hs.settings({"slots": 2}), 2)
        self.assertEqual(self.hs.settings({"slots": 2, "ceilings": {"full": 3600, "max": 7200}}), 2)
        for bad in ({"slotz": 2}, {"ceilings": {"huge": 5}}, {"ceilings": {"full": 0}}, {"ceilings": {"full": "x"}}, {"ceilings": 5}):
            with self.subTest(bad=bad), self.assertRaises(self.hs.HeavyError):
                self.hs.settings(bad)

    def canary(self):
        return "".join(["sk", "-", "canary", "-", "930", "-", "abcdef"])   # built at run time: no secret-shaped literal in the file

    def hooks(self, sent, audited, answer="sent", audit_fails=False, order=None):
        """The two-phase on_stop of the product, built from the REAL record_stop and tell_lane with a recording sender and audit."""
        def send(lane, text):
            sent.append((lane, text))
            if isinstance(answer, Exception):
                raise answer
            return answer

        def audit(*a):
            if order is not None:
                order.append(("audit", len(self.signals)))   # how many signals had been sent when the line was written
            if audit_fails:
                raise OSError("the audit sink is full")
            audited.append(a)
        note = self.out.write

        def on_stop(phase, info, holder, lane):
            if phase == "decided":
                self.hs.record_stop(info, holder, audit, note)
            else:
                self.hs.tell_lane(info, holder, lane, send, audit, 14400, note)
        return on_stop

    def reported(self, command, **kw):
        """A time stop through the real hooks; returns (exit status, sent, audited, secret, order)."""
        sent, audited, order = BoundedList(), BoundedList(), BoundedList()
        stop = self.hooks(sent, audited, kw.pop("answer", "sent"), kw.pop("audit_fails", False), order)
        secret = self.canary()
        code, _seen = self.drive(command + [secret], [5401], environ_extra={"FLEET_HEAVY_SECRET_930": secret, "FLEET_HEAVY_NAME": "lane-x"}, on_stop=stop, name="holder-x", **kw)
        return code, sent, audited, secret, order

    def test_s7_the_audit_lines_have_exactly_their_fields_and_no_argument_or_environment(self):
        for kind, command, default in self.FAMILY:
            with self.subTest(kind=kind):
                self.signals, self.exited, self.out = BoundedList(), threading.Event(), BoundedOut()
                code, sent, audited, secret, order = self.reported(self.RUNNABLE[kind], ceiling=str(default))
                self.assertEqual(code, 124)
                self.assertEqual([a[0] for a in audited], ["heavy.stopped", "heavy.lane_told"], "the stop is audited first, the message after")
                (event, subject, detail), (_e2, _s2, told) = audited
                self.assertEqual(subject, "holder-x")
                self.assertEqual(set(detail), {"kind", "ran_seconds", "ceiling_seconds", "pid", "reason", "source"})
                self.assertEqual((detail["kind"], detail["ceiling_seconds"], detail["pid"], detail["source"], detail["reason"]), (kind, default, self.px[4242], "wrapper", "time"))
                self.assertGreater(detail["ran_seconds"], default)
                self.assertEqual(told, {"pid": self.px[4242], "source": "wrapper", "lane_told": "sent"})
                self.assertEqual(order[0], ("audit", 0), "the heavy.stopped line is written before the first signal")
                line = json.dumps(list(audited))
                for text in (secret, "FLEET_HEAVY_SECRET_930", "PATH"):
                    self.assertNotIn(text, line)

    def test_s8_the_lane_is_told_once_with_fixed_words_and_an_unknown_name_is_said_in_the_audit(self):
        for answer in ("sent", "unknown name", "failed", KeyError("the sender is broken")):
            with self.subTest(answer=answer):
                self.signals, self.exited, self.out = BoundedList(), threading.Event(), BoundedOut()
                code, sent, audited, secret, order = self.reported(self.RUNNABLE["full"], answer=answer)
                self.assertEqual(code, 124, "a message that fails never changes the exit status")
                self.assertEqual(len(sent), 1, "told once, no retry")
                self.assertEqual(sent[0][0], "lane-x", "the recorded lane, not the holder's name")
                self.assertEqual(audited[1][2]["lane_told"], answer if isinstance(answer, str) else "failed")
                self.assertRegex(sent[0][1], r"^heavy: your full run \(pid %d\) was stopped after \d+ s; its ceiling was 5400 s \(FLEET_HEAVY_MAX_SECONDS or heavy --ceiling asks for more, up to 14400\)$" % self.px[4242])

    def test_m3_an_audit_sink_that_fails_never_prevents_the_stop_and_the_failure_is_on_the_record(self):
        self.signals, self.exited, self.out = BoundedList(), threading.Event(), BoundedOut()
        code, sent, audited, secret, order = self.reported(self.RUNNABLE["full"], audit_fails=True)
        self.assertEqual(code, 124)
        self.assertTrue(self.signals, "the run was stopped")
        self.assertEqual(list(audited), [])
        self.assertIn("could not write the audit line heavy.stopped (OSError: the audit sink is full): the run is stopped all the same", self.out.getvalue())
        self.assertEqual(len(sent), 1, "the lane is still told")

    @staticmethod
    def broken_sender(lane, text):
        raise KeyError("the sender is broken")

    def test_the_express_slot_keeps_its_120_s_ceiling_whatever_the_kind(self):
        tmp = tempfile.mkdtemp()
        self.addCleanup(shutil.rmtree, tmp, True)
        for index in range(3):   # the three ordinary slots are busy: a --short run takes the express one
            fd = os.open(os.path.join(tmp, "heavy-slot-%d.lock" % index), os.O_RDWR | os.O_CREAT, 0o600)
            self.addCleanup(os.close, fd)
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        test = self

        class FakeChild:
            pid = self.px[4242]

            def __init__(child, argv, **kwargs):
                pass

            def wait(child):
                test.exited.wait(30)
                return -9
        reads = BoundedList()

        def table():
            reads.append(1)
            if len(reads) > 2 or self.exited.is_set():
                self.exited.set()
                return []
            self.now[0] += 121
            return [(self.px[4242], 1, os.getpgrp(), 1)]
        dog = {"read_table": table, "pause": lambda s: False, "killpg": lambda n, g: self.exited.set(), "kill": lambda n, g: self.exited.set(), "lsof": lambda path: set(), "every": 0.0, "grace": 0.001, "sweep_pause": lambda s: None}
        with mock.patch.object(self.hs.subprocess, "Popen", FakeChild):
            code = self.hs.run(self.RUNNABLE["full"], tmp, 3, 5, "w", environ={"PATH": os.environ["PATH"]}, out=self.out, clock=lambda: self.now[0], sleep=lambda s: None,
                               watchdog=dog, short=True, ceiling="99999", line={"start_of": lambda pid: "t0", "alive": lambda pid, start: True})
        self.assertEqual(code, 124)
        self.assertIn("time ceiling of 120 s", self.out.getvalue())

    def test_s13_neither_the_message_nor_the_line_carries_a_canary_in_any_of_three_forms(self):
        secret = self.canary()
        for form, command, environ in (("argument", self.RUNNABLE["full"] + [secret], {}), ("environment", self.RUNNABLE["full"], {"FLEET_HEAVY_SECRET_930": secret}),
                                       ("both", self.RUNNABLE["full"] + [secret], {"FLEET_HEAVY_SECRET_930": secret})):
            with self.subTest(form=form):
                self.signals, self.exited = BoundedList(), threading.Event()
                sent, audited = BoundedList(), BoundedList()
                self.signals, self.exited, self.out = BoundedList(), threading.Event(), BoundedOut()
                self.drive(command, [5401], environ_extra=environ, on_stop=self.hooks(sent, audited))
                blob = json.dumps(list(sent) + list(audited))
                for forbidden in (secret, "FLEET_HEAVY_SECRET_930", "PATH", "nowhere"):
                    self.assertNotIn(forbidden, blob)

    def test_the_switchboard_sends_only_to_a_known_agent_and_says_so_for_an_unknown_name(self):
        calls = []
        engine = types.SimpleNamespace(now=lambda: 1.0, discover=lambda now: types.SimpleNamespace(agents={"coder-a": object()}), send=lambda *a, **k: calls.append(a) or {"sent": True})
        self.assertEqual(sb.heavy_stop_send(engine, "coder-a", "text"), "sent")
        self.assertEqual(sb.heavy_stop_send(engine, "nobody", "text"), "unknown name")
        self.assertEqual(len(calls), 1, "nothing is sent for an unknown name")
        engine.send = lambda *a, **k: {"sent": False}
        self.assertEqual(sb.heavy_stop_send(engine, "coder-a", "text"), "failed")

    # ---- the orphan: the slot is really locked, the clock, the table, the signals and the lock listing are injected

    def orphan_rig(self, record, rows=None, alive=lambda pid, start: False, held_by=None, survivor=False):
        held_by = held_by or (self.px[4242], self.px[4243])
        tmp = tempfile.mkdtemp()
        self.addCleanup(shutil.rmtree, tmp, True)
        path = os.path.join(tmp, "heavy-slot-0.lock")
        fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o600)
        self.addCleanup(os.close, fd)
        os.write(fd, json.dumps(record).encode())
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)   # the "run" holds the slot
        gone = threading.Event()
        signals = BoundedList()

        def record_signal(number, sig):
            signals.append((number, sig))
            if sig == signal.SIGKILL and not survivor:
                gone.set()
        table = rows or [(self.px[4242], 1, self.px[4242], 1, "t"), (self.px[4243], self.px[4242], self.px[4242], 1, "t"), (self.px[999], 1, self.px[999], 1, "t"), (self.px[555], 1, self.px[555], 1, "t")]
        dog = {"read_table": lambda: [] if gone.is_set() else table, "kill": record_signal, "killpg": record_signal, "lsof": lambda p: set(held_by), "grace": 0.001,
               "sweep_pause": lambda s: None, "pause": lambda s: False, "me": (os.getpid(), os.getppid(), os.getpgrp()), "rounds": 1}
        return tmp, dog, signals, alive

    @property
    def RECORD(self):
        return {"name": "h", "pid": self.px[4242], "wrapper": self.px[31337], "command": "x", "since": 1000, "kind": "full", "ceiling": 5400, "lane": "lane-x", "wstart": "w0", "cstart": "c0"}

    def orphan(self, ran, record=None, start_of=lambda pid: "c0", **rig):
        record = record or dict(self.RECORD)
        tmp, dog, signals, alive = self.orphan_rig(record, **rig)
        told = BoundedList()

        def on_stop(phase, info, holder, lane):
            told.append((phase, info, holder, lane, len(signals)))
        stopped = self.hs.check_orphans(tmp, 3, None, lambda: 1000.0 + ran, on_stop, BoundedOut(), alive=alive, watchdog=dog, start_of=start_of)
        self.orphan_args = (tmp, dog, alive, on_stop, start_of)
        return stopped, told, signals

    def test_s9_an_orphan_is_left_alone_at_its_ceiling_and_stopped_past_it_measured_from_the_slot_start(self):
        stopped, told, signals = self.orphan(5400)
        self.assertEqual((stopped, list(signals)), ([], []), "at the ceiling nothing is signalled")
        stopped, told, signals = self.orphan(5401)
        self.assertTrue({self.px[4242]} <= {p for p, _s in signals} <= {self.px[4242], self.px[4243]}, "the run's group or tree, nothing else (self.px[999] and self.px[555] are strangers)")
        self.assertEqual(len(stopped), 1)
        self.assertEqual([(t[0], t[4] == 0) for t in told[:1]], [("decided", True)], "the audit phase runs before the first signal")
        self.assertEqual([t[0] for t in told], ["decided", "told"])
        phase, info, holder, lane, _n = told[1]
        self.assertEqual((info["source"], info["kind"], info["ceiling_seconds"], info["pid"], info["ran_seconds"], holder, lane), ("orphan", "full", 5400, self.px[4242], 5401, "h", "lane-x"))
        stopped, told, signals = self.orphan(99999, alive=lambda pid, start: True)
        self.assertEqual((stopped, list(signals)), ([], []), "a live wrapper's run is never touched by the orphan check")

    def test_s10_an_old_record_reads_as_other_and_a_reused_wrapper_pid_is_an_orphan(self):
        old = {"name": "h", "pid": self.px[4242], "wrapper": self.px[31337], "command": "x", "since": 1000}
        self.assertEqual(self.orphan(3600, old)[0], [])
        stopped, told, signals = self.orphan(3601, old)
        self.assertEqual((stopped[0]["kind"], stopped[0]["ceiling_seconds"]), ("other", 3600))
        seen = []
        stopped, told, signals = self.orphan(6000, alive=lambda pid, start: seen.append((pid, start)) or False)   # the start time recorded is the one asked for
        self.assertEqual(seen, [(self.px[31337], "w0")])
        self.assertEqual(len(stopped), 1, "a pid reused by another process (another start time) is judged gone")

    def test_u3_an_orphan_stop_signals_only_the_runs_own_processes(self):
        stopped, told, signals = self.orphan(9000, held_by=(self.px[4242], os.getpid(), os.getppid(), 1))
        self.assertTrue({p for p, _s in signals} <= {self.px[4242], self.px[4243]}, signals)
        self.assertFalse({os.getpid(), os.getppid(), 1, self.px[999], self.px[555]} & {p for p, _s in signals})

    def test_m1_a_pid_from_the_record_is_a_root_only_with_its_recorded_start_time(self):
        """The run's command has exited, a descendant (self.px[4300]) keeps the lock, and the recorded command pid self.px[4242] now belongs to a bystander."""
        rows = [(self.px[4242], 1, self.px[4242], 1, "bystander"), (self.px[4300], 1, self.px[4300], 1, "t"), (self.px[555], 1, self.px[555], 1, "t")]
        base = dict(self.RECORD)
        cases = (("another process has the pid", base, lambda pid: "someone-else"),
                 ("an older record without the start time", {k: v for k, v in base.items() if k != "cstart"}, lambda pid: "c0"),
                 ("an empty start time", dict(base, cstart=""), lambda pid: "c0"),
                 ("the start time cannot be read", base, lambda pid: ""))
        for name, record, start_of in cases:
            with self.subTest(name):
                stopped, told, signals = self.orphan(9000, record, start_of=start_of, rows=rows, held_by=(self.px[4300],))
                self.assertEqual(len(stopped), 1)
                self.assertEqual({p for p, _s in signals}, {self.px[4300]}, "only the lock holder is signalled: not the pid of the record, not a stranger")
        for pid in (1, 0, os.getpid(), os.getppid()):
            with self.subTest(pid=pid):
                stopped, told, signals = self.orphan(9000, dict(base, pid=pid), start_of=lambda p: "c0", rows=rows + [(pid, 1, pid, 1, "t")] if pid > 1 else rows, held_by=(self.px[4300],))
                self.assertFalse({1, os.getpid(), os.getppid(), os.getpgrp()} & {p for p, _s in signals}, "pid 1, the checker, its parent and its group are never signalled")

    def test_m1_with_the_matching_start_time_the_recorded_pid_is_still_stopped(self):
        stopped, told, signals = self.orphan(9000, start_of=lambda pid: "c0")
        self.assertIn(self.px[4242], {p for p, _s in signals})

    def test_m3_a_report_hook_that_fails_before_the_stop_is_said_and_the_run_is_stopped_all_the_same(self):
        self.signals, self.exited, self.out = BoundedList(), threading.Event(), BoundedOut()

        def broken(phase, info, holder, lane):
            raise RuntimeError("the hook is broken")
        code, _seen = self.drive(self.RUNNABLE["full"], [5401], on_stop=broken)
        self.assertEqual(code, 124)
        self.assertTrue(self.signals)
        self.assertEqual(self.out.getvalue().count("the stop report failed (RuntimeError: the hook is broken)"), 2, "said for the decided phase and for the told phase")

    def test_a_tick_that_does_not_stop_marks_nothing_and_the_next_stop_audits_and_tells_once(self):
        """The two checkers (the daemon and a waiting wrapper) meet: a tick whose stop does not happen must leave the run unreported."""
        for case in ("the orphan lock is busy", "the holders are not seen twice", "the slot changed hands"):
            with self.subTest(case):
                holders = [self.px[4242], self.px[4243]]
                base = {k: v for k, v in self.RECORD.items() if k != "cstart" or case != "the holders are not seen twice"}   # no recorded start: only lock holders are roots
                tmp, dog, signals, alive = self.orphan_rig(dict(base), held_by=holders)
                gate = os.open(os.path.join(tmp, self.hs.ORPHAN_LOCK), os.O_RDWR | os.O_CREAT, 0o600)
                self.addCleanup(os.close, gate)
                slot = os.path.join(tmp, "heavy-slot-0.lock")
                real = dict(base)
                told = BoundedList()
                on_stop = lambda phase, info, holder, lane: told.append(phase)
                state = {"swap": False}

                def lsof(path):
                    if state["swap"]:   # the slot is taken by a newer run while the look is made
                        with open(path, "r+b") as handle:
                            handle.truncate(0)
                            handle.write(json.dumps(dict(real, since=5000)).encode())
                    return set(holders)
                dog["lsof"] = lsof
                if case == "the orphan lock is busy":
                    fcntl.flock(gate, fcntl.LOCK_EX | fcntl.LOCK_NB)
                elif case == "the holders are not seen twice":
                    holders[:] = []
                else:
                    state["swap"] = True
                check = lambda: self.hs.check_orphans(tmp, 3, None, lambda: 1000.0 + 9000, on_stop, BoundedOut(), alive=alive, watchdog=dog, start_of=lambda p: "c0")
                self.assertEqual((check(), list(told), list(signals)), ([], [], []), "tick 1: no stop, nothing reported")
                self.assertFalse(os.path.exists(os.path.join(tmp, "heavy-told-0.json")), "tick 1 marks nothing")
                if case == "the orphan lock is busy":
                    fcntl.flock(gate, fcntl.LOCK_UN)
                elif case == "the holders are not seen twice":
                    holders[:] = [self.px[4242], self.px[4243]]
                else:
                    state["swap"] = False
                    with open(slot, "r+b") as handle:
                        handle.truncate(0)
                        handle.write(json.dumps(real).encode())
                self.assertEqual(len(check()), 1, "tick 2 stops the run")
                self.assertEqual(list(told), ["decided", "told"], "audited once and told once")
                self.assertTrue(os.path.exists(os.path.join(tmp, "heavy-told-0.json")))

    def test_the_lane_is_told_once_for_a_run_that_survives_the_stop_and_is_stopped_again(self):
        stopped, told, signals = self.orphan(9000, survivor=True)
        tmp, dog, alive, on_stop, start_of = self.orphan_args
        first = len(signals)
        again = self.hs.check_orphans(tmp, 3, None, lambda: 1000.0 + 9100, on_stop, BoundedOut(), alive=alive, watchdog=dog, start_of=start_of)
        self.assertEqual(len(again), 1, "the survivor is stopped again")
        self.assertGreater(len(signals), first)
        self.assertEqual([t[0] for t in told], ["decided", "told"], "reported once for the same run")

    def test_a_slot_that_changed_hands_during_the_stop_is_not_stopped(self):
        tmp, dog, signals, alive = self.orphan_rig({"name": "h", "pid": self.px[4242], "wrapper": self.px[31337], "command": "x", "since": 1000})
        newer = [0]

        def lsof(path):   # the look finds the holders, and the slot is then taken by a newer run: its record has another start
            with open(path, "r+b") as handle:
                handle.truncate(0)
                handle.write(json.dumps({"name": "n", "pid": self.px[4242], "wrapper": self.px[31337], "since": 5000}).encode())
            return {self.px[4242]}
        dog["lsof"] = lsof
        stopped = self.hs.check_orphans(tmp, 3, None, lambda: 20000.0, None, BoundedOut(), alive=alive, watchdog=dog, start_of=lambda p: "c0")
        self.assertEqual((stopped, list(signals)), ([], []))

    def test_two_checkers_never_stop_and_report_the_same_orphan(self):
        tmp, dog, signals, alive = self.orphan_rig({"name": "h", "pid": self.px[4242], "wrapper": self.px[31337], "command": "x", "since": 1000})
        gate = os.open(os.path.join(tmp, self.hs.ORPHAN_LOCK), os.O_RDWR | os.O_CREAT, 0o600)   # another checker is at it
        self.addCleanup(os.close, gate)
        fcntl.flock(gate, fcntl.LOCK_EX | fcntl.LOCK_NB)
        self.assertEqual(self.hs.check_orphans(tmp, 3, None, lambda: 20000.0, None, BoundedOut(), alive=alive, watchdog=dog), [])
        self.assertEqual(list(signals), [])

    def test_the_orphan_check_reports_nothing_and_stops_nothing_for_a_free_slot(self):
        tmp = tempfile.mkdtemp()
        self.addCleanup(shutil.rmtree, tmp, True)
        with open(os.path.join(tmp, "heavy-slot-0.lock"), "w") as handle:
            handle.write(json.dumps({"name": "h", "pid": self.px[4242], "wrapper": self.px[31337], "since": 1}))
        self.assertEqual(self.hs.check_orphans(tmp, 3, None, lambda: 10 ** 9, None, BoundedOut(), alive=lambda p, s: False), [])

    def test_s11_every_case_named_in_the_ask_has_a_test(self):
        names = {n for n in dir(type(self)) if n.startswith("test_")}
        for case in ("test_s2_", "test_s3_", "test_s4_", "test_s5_", "test_s6_", "test_s7_", "test_s8_", "test_s9_", "test_s10_", "test_s13_", "test_u1_", "test_u2_", "test_u3_", "test_m1_", "test_m2_", "test_m3_"):
            self.assertTrue(any(n.startswith(case) for n in names), "no test for %s" % case)
        slots_tests = {n for n in dir(TestHeavySlots) if n.startswith("test_")}
        self.assertIn("test_s9_a_wrapper_killed_with_sigkill_leaves_a_run_that_the_orphan_bound_stops_and_audits", slots_tests)

    def test_s1_s12_the_docs_state_the_cause_the_measured_table_the_ceilings_and_how_to_raise_one(self):
        text = (REPO / "docs" / "switchboard.md").read_text()
        start = text.index("### `heavy`: CPU slots")
        section = text[start:text.index("\n### ", start + 10)]
        for needle in ("measured from the slot start", "7200", "heavy.stopped", "--ceiling", "FLEET_HEAVY_MAX_SECONDS", "0 no longer means off", "is read afresh by every `heavy` run"):
            self.assertIn(needle, section)
        for kind, _c, default in self.FAMILY:
            self.assertRegex(section, r"\| *%s *\|[^\n]*\b%d\b" % (kind, default), "a table row for the kind %s with its default" % kind)
            self.assertRegex(section, r"\| *%s *\|[^\n]*\| *[0-9]+ (runs|jobs|samples|holders)?" % kind)
        self.assertIn("14400", section)
        self.assertNotIn("default 7200", section)


class TestHeavyFifo(StandInPids, unittest.TestCase):
    """Heavy slots in arrival order and the express slot (ask #620). The order file, the lock files and the process table are real or injected, the clock never
    moves on its own, the command is a fake, and every list is bounded; no test waits on a real slot."""

    def setUp(self):
        self.hs = sb.load_heavy_slots()
        self.dir = Path(tempfile.mkdtemp())
        self.addCleanup(shutil.rmtree, str(self.dir), True)
        self.out, self.takes, self.started, self.clock_calls = BoundedOut(), BoundedList(), BoundedList(), BoundedList()
        self.now = [1000.0]
        self.alive = {self.px[1001], self.px[1002], self.px[1003], self.px[1004], self.px[1005]}

    def seed(self, pids):
        (self.dir / "heavy-queue.json").write_text(json.dumps({"entries": [{"pid": pid, "start": "t", "name": "w%d" % pid, "short": False} for pid in pids]}))

    def entries(self):
        return [entry["pid"] for entry in json.loads((self.dir / "heavy-queue.json").read_text())["entries"]]

    def run_as(self, pid, take=None, step=10.0, wait_max=15, short=False, report="100000", on_child=None, environ_extra=None, watchdog=None, held=None):
        """One caller's run(): `pid` is its place in the line, `take(state, slots)` the ordinary slots (default: all busy)."""
        test = self

        def clock():
            test.clock_calls.append(1)
            test.now[0] += step
            return test.now[0]

        def ordinary(state, slots):
            test.takes.append(pid)
            return take(state, slots) if take else (None, None)

        class FakeChild:
            pid = self.px[4242]

            def __init__(child, argv, **kwargs):
                test.started.append(pid)

            def wait(child):
                return on_child() if on_child else 0
        environ = {"PATH": os.environ["PATH"], "FLEET_HEAVY_REPORT_SECONDS": report}
        environ.update(environ_extra or {})
        slot_records = [{"slot": i, "name": "who-%s" % c, "pid": 10 + i, "command": "sh", "since": 1} for i, c in enumerate("abc")]
        with mock.patch.object(self.hs, "_take", ordinary), mock.patch.object(self.hs, "holders", lambda state, slots=3: slot_records), \
                mock.patch.object(self.hs.subprocess, "Popen", FakeChild):
            return self.hs.run(["sh", "-c", "true"], str(self.dir), 3, wait_max, "w%d" % pid, environ=environ, out=self.out, clock=clock, sleep=lambda s: None,
                               short=short, watchdog=watchdog, line={"pid": pid, "alive": lambda p, st: p in self.alive, "start_of": lambda p: "t", "held": (lambda: held or set())})

    def free(self):
        fd = os.open(os.devnull, os.O_RDWR)
        return lambda state, slots: (fd, 0)

    def test_s1_slots_go_to_the_callers_in_the_order_they_arrived(self):
        self.seed([self.px[1001], self.px[1002], self.px[1003], self.px[1004]])
        self.assertEqual(self.run_as(self.px[1004], self.free()), 75, "D arrived last: it never gets a slot while A B C wait")
        self.assertEqual(list(self.takes), [], "and it did not even try one")
        self.assertEqual(self.entries(), [self.px[1001], self.px[1002], self.px[1003]], "it left the line when it gave up; the others kept their places")
        order = []
        for pid in (self.px[1001], self.px[1002], self.px[1003]):
            self.assertEqual(self.run_as(pid, self.free()), 0)
            order.append(self.started[-1])
        self.assertEqual(order, [self.px[1001], self.px[1002], self.px[1003]])
        self.assertEqual(self.entries(), [], "each left the line when it took its slot")
        self.assertEqual(self.run_as(self.px[1004], self.free()), 0)

    def test_s2_a_new_caller_polling_at_the_instant_a_slot_frees_does_not_take_it_from_an_earlier_waiter(self):
        self.seed([self.px[1001]])
        self.assertEqual(self.run_as(self.px[1002], self.free(), wait_max=5), 75)
        self.assertEqual(list(self.started), [])
        self.assertEqual(self.entries(), [self.px[1001]], "it also left the line when it gave up")
        self.assertEqual(self.run_as(self.px[1001], self.free()), 0)

    def test_s3_a_waiter_at_the_head_that_died_does_not_block_the_one_behind_it(self):
        self.seed([self.px[1001], self.px[1002]])
        self.alive.discard(self.px[1001])
        self.assertEqual(self.run_as(self.px[1002], self.free()), 0)
        self.assertEqual(list(self.takes), [self.px[1002]], "it took the slot at its first look, with no wait for the wait limit")
        self.assertEqual(list(self.started), [self.px[1002]])

    def test_s4_a_short_command_runs_in_the_express_slot_when_the_ordinary_ones_are_busy_and_a_second_waits_for_it_only(self):
        second = {}

        def while_first_runs():
            second["status"] = self.run_as(self.px[1002], short=True, wait_max=15)
            return 0
        self.assertEqual(self.run_as(self.px[1001], short=True, on_child=while_first_runs), 0)
        self.assertEqual(second["status"], 75, "the express slot was held: the second one waited and gave up")
        self.assertEqual(list(self.started), [self.px[1001]])

    def test_s5_a_short_command_past_120_seconds_is_stopped_with_124_and_frees_the_express_slot(self):
        stopped = threading.Event()
        signals = BoundedList()

        def record(target, number):
            signals.append((target, number))
            stopped.set()
        rows = [(self.px[4242], 1, os.getpgrp(), 10, "c")]
        dog = {"read_table": lambda: [] if stopped.is_set() else rows, "pause": lambda seconds: stopped.wait(0.001), "killpg": record, "kill": record, "every": 0.001,
               "grace": 0.001, "sweep_pause": lambda s: None, "me": (self.px[9001], self.px[9002], self.px[9003]), "lsof": lambda path: set()}
        code = self.run_as(self.px[1001], short=True, step=60.0, on_child=lambda: (stopped.wait(30), -9)[1], watchdog=dog)
        self.assertEqual(code, 124)
        self.assertIn("time ceiling of 120 s", self.out.getvalue())
        fd = self.hs._take_express(str(self.dir))
        self.assertIsNotNone(fd, "the express slot is free again")
        os.close(fd)

    def test_s6_the_waiting_line_says_the_place_in_the_order_and_names_the_holders(self):
        self.seed([self.px[1001], self.px[1002], self.px[1003]])
        self.assertEqual(self.run_as(self.px[1003], report="5"), 75)
        text = self.out.getvalue()
        self.assertEqual(text.count("place 3 in line (2 ahead)"), 1, text)
        for name in ("who-a", "who-b", "who-c"):
            self.assertIn(name, text)

    def test_s7_a_corrupt_order_file_and_one_that_cannot_be_used_fall_back_to_the_present_behaviour_and_say_so_once(self):
        for label in ("corrupt", "unusable"):
            with self.subTest(label):
                self.out = BoundedOut()
                self.takes, self.started = BoundedList(), BoundedList()
                for name in ("heavy-queue.json", "heavy-queue.lock"):
                    target = self.dir / name
                    if target.is_dir():
                        shutil.rmtree(str(target))
                    elif target.exists():
                        target.unlink()
                if label == "corrupt":
                    (self.dir / "heavy-queue.json").write_text("{not json")
                else:
                    (self.dir / "heavy-queue.lock").mkdir()
                attempts = BoundedList()

                def take(state, slots):
                    attempts.append(1)
                    return self.free()(state, slots) if len(attempts) >= 2 else (None, None)
                self.assertEqual(self.run_as(self.px[1002], take), 0)
                self.assertEqual(self.out.getvalue().count("no waiting order"), 1, self.out.getvalue())
                self.assertEqual(len(attempts), 2)

    def test_s8_the_defaults_and_the_exit_status_of_giving_up_are_as_before(self):
        self.assertEqual((self.hs.DEFAULT_SLOTS, self.hs.DEFAULT_WAIT_MAX, self.hs.EXIT_TEMPFAIL), (3, 1800, 75))
        self.assertEqual(self.hs.settings(None), 3)
        self.assertEqual(self.run_as(self.px[1001], wait_max=15), 75, "nobody waiting, no slot: gives up as before")
        self.assertIs(inspect.signature(self.hs.run).parameters["short"].default, False)

    def test_s10_entries_of_processes_that_are_gone_are_dropped_and_the_live_one_keeps_its_place(self):
        self.seed([self.px[1001], self.px[1002], self.px[1003]])
        self.alive -= {self.px[1001], self.px[1003]}
        line = self.hs.Line(str(self.dir), "w", pid=self.px[1002], alive=lambda p, st: p in self.alive, start_of=lambda p: "t")
        self.assertEqual(line.place(), 1)
        self.assertEqual(self.entries(), [self.px[1002]])

    def test_s11_the_express_slot_has_its_own_lock_file_and_the_ordinary_ones_are_untouched(self):
        seen = {}

        def while_running():
            def locked(path):
                fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o600)
                try:
                    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    return False
                except OSError:
                    return True
                finally:
                    os.close(fd)
            seen["express"] = locked(str(self.dir / "heavy-slot-express.lock"))
            seen["ordinary"] = [locked(str(self.dir / ("heavy-slot-%d.lock" % i))) for i in range(3)]
            return 0
        self.assertEqual(self.run_as(self.px[1001], short=True, on_child=while_running), 0)
        self.assertEqual(seen, {"express": True, "ordinary": [False, False, False]})

    def test_a_dead_waiters_pid_reused_by_another_process_is_not_that_waiter(self):
        """The real `_alive` with a mocked start-time reader: the pid exists (this process) but its start time is not the one the entry recorded."""
        with mock.patch.object(self.hs, "_process_start", lambda pid: "Tue Jan  2 00:00:00 2024"):
            self.assertFalse(self.hs._alive(os.getpid(), "Mon Jan  1 00:00:00 2024"), "another process now has the pid")
            self.assertTrue(self.hs._alive(os.getpid(), "Tue Jan  2 00:00:00 2024"), "the same process")
            self.assertTrue(self.hs._alive(os.getpid(), ""), "an entry with no recorded start time is judged by the pid alone")
        gone = subprocess.Popen(["true"])
        gone.wait()
        self.assertFalse(self.hs._alive(gone.pid, ""), "a pid that is gone is not alive")

    def test_a_short_write_never_leaves_a_half_written_order_file_or_a_temporary_file(self):
        line = self.hs.Line(str(self.dir), "w", pid=self.px[1001], alive=lambda p, st: True, start_of=lambda p: "t")
        line.place()
        before = (self.dir / "heavy-queue.json").read_text()
        with mock.patch.object(self.hs.os, "fsync", side_effect=OSError(5, "disk")):
            with self.assertRaises(self.hs.QueueUnusable):
                self.hs.Line(str(self.dir), "w", pid=self.px[1002], alive=lambda p, st: True, start_of=lambda p: "t").place()
        self.assertEqual((self.dir / "heavy-queue.json").read_text(), before, "the file is as it was")
        self.assertEqual([p.name for p in self.dir.iterdir() if p.name.endswith(".tmp")], [], "no temporary file is left")


    def test_a_caller_that_fell_back_after_joining_leaves_no_entry_behind(self):
        real = self.hs.Line.place
        calls = []

        def once_then_fail(line):
            calls.append(1)
            if len(calls) > 1:
                raise self.hs.QueueUnusable("the order file is corrupt")
            return real(line)
        with mock.patch.object(self.hs.Line, "place", once_then_fail):
            self.assertEqual(self.run_as(self.px[1001], wait_max=25), 75)
        self.assertEqual(self.entries(), [], "it joined, then fell back, and is not in the line any more")

    def test_a_caller_that_is_not_short_never_uses_the_express_slot(self):
        self.assertEqual(self.run_as(self.px[1001], short=False, wait_max=15), 75)
        self.assertEqual(list(self.started), [])
        self.assertFalse((self.dir / "heavy-slot-express.lock").exists(), "the express slot was not even opened")

    def test_the_short_flag_of_the_command_reaches_the_wrapper(self):
        seen = {}
        args = types.SimpleNamespace(command=["--", "true"], slots=None, wait_max=None, name=None, short=True)
        with mock.patch.object(sb.load_heavy_slots(), "run", lambda *a, **k: seen.update(k) or 0), mock.patch.object(sb, "ensure_state_dir", lambda: str(self.dir)), \
                mock.patch.object(sb, "config_path", lambda: self.dir / "no-config"):
            self.assertEqual(sb.cmd_heavy(args), 0)
        self.assertIs(seen.get("short"), True)

    def test_an_oversize_file_a_bad_entry_and_a_lock_that_stays_held_are_unusable_not_trusted(self):
        make = lambda: self.hs.Line(str(self.dir), "w", pid=self.px[1001], alive=lambda p, st: True, start_of=lambda p: "t", lock_tries=2, lock_pause=0.001)
        (self.dir / "heavy-queue.json").write_text(" " * (self.hs.QUEUE_BYTES + 10))
        with self.assertRaises(self.hs.QueueUnusable):
            make().place()
        (self.dir / "heavy-queue.json").write_text(json.dumps({"entries": [{"pid": "x", "start": 1}]}))
        with self.assertRaises(self.hs.QueueUnusable):
            make().place()
        (self.dir / "heavy-queue.json").write_text(json.dumps({"entries": [{"pid": 1, "start": "t"}] * (self.hs.QUEUE_MAX + 1)}))
        with self.assertRaises(self.hs.QueueUnusable):
            make().place()
        (self.dir / "heavy-queue.json").unlink()
        holder = os.open(str(self.dir / "heavy-queue.lock"), os.O_RDWR | os.O_CREAT, 0o600)
        self.addCleanup(os.close, holder)
        fcntl.flock(holder, fcntl.LOCK_EX)
        with self.assertRaises(self.hs.QueueUnusable):
            make().place()


    def test_a_ticket_whose_owner_holds_a_slot_is_dropped_so_a_ghost_never_blocks_the_line(self):
        self.seed([self.px[1001], self.px[1002]])
        line = self.hs.Line(str(self.dir), "w", pid=self.px[1002], alive=lambda p, st: True, start_of=lambda p: "t", held=lambda: {self.px[1001]})
        self.assertEqual(line.place(), 1, "self.px[1001] holds a slot: its ticket is not a place in the line")
        self.assertEqual(self.entries(), [self.px[1002]])

    def test_a_caller_whose_ticket_could_not_be_removed_says_so_and_the_waiter_behind_it_still_gets_the_next_slot(self):
        self.seed([self.px[1001], self.px[1002]])
        attempts = []
        with mock.patch.object(self.hs.Line, "leave", lambda line: attempts.append(1) and False):
            self.assertEqual(self.run_as(self.px[1001], self.free()), 0)
        self.assertGreaterEqual(len(attempts), 2, "it tried to leave again before saying so")
        self.assertEqual(self.out.getvalue().count("could not leave the waiting order"), 1, self.out.getvalue())
        self.assertEqual(self.entries(), [self.px[1001], self.px[1002]], "the ghost is still in the file")
        self.out, self.takes, self.started = BoundedOut(), BoundedList(), BoundedList()
        self.assertEqual(self.run_as(self.px[1002], self.free(), held={self.px[1001]}), 0, "the waiter behind the ghost still takes the next free slot")
        self.assertEqual(list(self.started), [self.px[1002]])

    def test_the_slot_record_names_the_wrapper_and_held_by_lists_it_with_the_express_holder(self):
        fd = os.open(str(self.dir / "heavy-slot-1.lock"), os.O_RDWR | os.O_CREAT, 0o600)
        self.addCleanup(os.close, fd)
        fcntl.flock(fd, fcntl.LOCK_EX)
        self.hs._record(fd, "w", self.px[4242], "sh", 1000.0)
        express = self.hs._take_express(str(self.dir))
        self.addCleanup(os.close, express)
        self.hs._record(express, "w", self.px[4343], "sh", 1000.0)
        self.assertEqual(self.hs.held_by(str(self.dir), 3), {self.px[4242], self.px[4343], os.getpid()})
        self.assertFalse((self.dir / "heavy-slot-0.lock").exists(), "looking creates no lock file")

    def test_a_process_that_died_and_was_not_reaped_is_gone(self):
        with mock.patch.object(self.hs, "_is_zombie", lambda pid: True), mock.patch.object(self.hs, "_process_start", lambda pid: "t"):
            self.assertFalse(self.hs._alive(os.getpid(), "t"))
        with mock.patch.object(self.hs, "_is_zombie", lambda pid: False), mock.patch.object(self.hs, "_process_start", lambda pid: "t"):
            self.assertTrue(self.hs._alive(os.getpid(), "t"))
        done = subprocess.Popen(["true"])
        while subprocess.run(["ps", "-o", "stat=", "-p", str(done.pid)], capture_output=True, text=True).stdout.strip()[:1] not in ("Z", ""):
            time.sleep(0.01)   # (bounded by the test timeout: a process that exits at once)
        if subprocess.run(["ps", "-o", "stat=", "-p", str(done.pid)], capture_output=True, text=True).stdout.strip().startswith("Z"):
            self.assertFalse(self.hs._alive(done.pid, ""), "a real zombie")
        done.wait()

    def test_the_temporary_files_of_processes_that_are_gone_are_swept_when_the_order_is_rewritten(self):
        gone = subprocess.Popen(["true"])
        gone.wait()
        stale = self.dir / ("heavy-queue.json.%d.tmp" % gone.pid)
        mine = self.dir / ("heavy-queue.json.%d.tmp" % os.getpid())
        other = self.dir / "unrelated.tmp"
        for path in (stale, other):
            path.write_text("x")
        self.hs.Line(str(self.dir), "w", pid=self.px[1001], alive=lambda p, st: True, start_of=lambda p: "t", held=lambda: set()).place()
        self.assertFalse(stale.exists(), "the dead process's temporary file is gone")
        self.assertTrue(other.exists(), "nothing else is touched")
        self.assertFalse(mine.exists(), "and its own was renamed into place")


    def test_odd_file_names_in_the_state_directory_are_left_alone_and_never_stop_the_wrapper(self):
        gone = subprocess.Popen(["true"])
        gone.wait()
        live = os.getppid()
        stray = ["heavy-queue.json.%s.tmp" % ("9" * 23), "heavy-queue.json.\u00b23.tmp", "heavy-queue.json.0.tmp", "heavy-queue.json.1.tmp", "heavy-queue.json.-1.tmp",
                 "heavy-queue.json..tmp", "heavy-queue.json.%d.tmp.bak" % gone.pid, "heavy-queue.json.\u0663.tmp", "heavy-queue.json.%d.tmp" % (2 ** 22 + 1)]
        for name in stray:
            (self.dir / name).write_text("x")
        (self.dir / ("heavy-queue.json.%d.tmp" % live)).write_text("x")           # a live process's: not deleted
        (self.dir / ("heavy-queue.json.%d.tmp" % gone.pid)).write_text("x")       # a dead process's: deleted
        folder = self.dir / ("heavy-queue.json.%d.tmp" % (gone.pid + 1 if gone.pid < 2 ** 22 - 2 else 2))
        folder.mkdir()                                                            # a directory with such a name: left alone
        target = self.dir / "target.txt"
        target.write_text("keep")
        link = self.dir / ("heavy-queue.json.%d.tmp" % (gone.pid + 2 if gone.pid < 2 ** 22 - 3 else 3))
        os.symlink(str(target), str(link))                                        # a symlink: never followed, left alone
        notes = BoundedList()
        self.hs.Line(str(self.dir), "w", pid=self.px[1001], alive=lambda p, st: True, start_of=lambda p: "t", held=lambda: set(), note=notes.append).place()
        for name in stray:
            self.assertTrue((self.dir / name).exists(), "left alone: %r" % name)
        self.assertTrue((self.dir / ("heavy-queue.json.%d.tmp" % live)).exists())
        self.assertFalse((self.dir / ("heavy-queue.json.%d.tmp" % gone.pid)).exists())
        self.assertTrue(folder.is_dir() and link.is_symlink() and target.read_text() == "keep")
        self.assertEqual(list(notes), [], "none of it was an error")

    def test_a_sweep_that_raises_never_stops_the_command_and_says_so_once(self):
        with mock.patch.object(self.hs.os, "listdir", side_effect=RuntimeError("boom")):
            self.assertEqual(self.run_as(self.px[1001], self.free()), 0)
        self.assertEqual(list(self.started), [self.px[1001]], "the command still ran")
        self.assertEqual(self.out.getvalue().count("queue sweep failed: RuntimeError"), 1, self.out.getvalue())

    def test_the_numbers_read_from_files_and_ps_are_ascii_digits_only(self):
        self.assertNotIn("isdigit", inspect.getsource(self.hs), "str.isdigit() accepts a superscript: int() then raises")

class TestHeavySlots(Base):
    """`fleet-switchboard heavy` (ask #34): a flock slot semaphore in the state directory; the COMMAND holds the lock; the queue, the kill, the exit status, taskpolicy
    or nice, the holder list, the wait limit and the no-shell guarantee are each run for real with small commands."""

    def setUp(self):
        super().setUp()
        self.hs = sb.load_heavy_slots()
        self.dir = self.home / "slots"
        self.dir.mkdir()
        self.procs = []
        self.addCleanup(self.cleanup)

    def cleanup(self):
        for proc in self.procs:
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except (OSError, ProcessLookupError):
                pass
            try:
                proc.wait(timeout=90)
            except Exception:
                pass

    def env(self, **more):
        env = dict(os.environ, XDG_STATE_HOME=str(self.dir), FLEET_HEAVY_REPORT_SECONDS="0.3", PATH=os.environ["PATH"])
        for key in ("FLEET_HEAVY_SLOT", "FLEET_HEAVY", "CI"):   # the suite may itself run in a slot, under FLEET_HEAVY=off, or in CI: these tests are about the slots
            env.pop(key, None)
        env.update(more)
        return env

    def state(self):
        path = self.dir / "fleet-switchboard"
        path.mkdir(mode=0o700, exist_ok=True)
        return path

    def start(self, *words, slots=3, wait_max=None, name="t", env=None, new_session=True, **popen):
        argv = [sys.executable, str(SWITCHBOARD), "heavy", "--slots", str(slots), "--name", name]
        if wait_max is not None:
            argv += ["--wait-max", str(wait_max)]
        argv = argv + ["--"] + list(words)
        if self.START_DELAY:   # a holder slow to write its record: the real wrapper holds its lock at once but its record (os.pwrite) lands START_DELAY seconds late
            runner = ("import os, sys, time, runpy; real, delay = os.pwrite, float(sys.argv[1]); os.pwrite = lambda *a: (time.sleep(delay), real(*a))[1]; "
                      "script = sys.argv[2]; sys.argv = [script] + sys.argv[3:]; runpy.run_path(script, run_name='__main__')")
            argv = [sys.executable, "-c", runner, str(self.START_DELAY), str(SWITCHBOARD)] + argv[2:]
        proc = subprocess.Popen(argv, env=env or self.env(), start_new_session=new_session, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                stdin=popen.pop("stdin", subprocess.DEVNULL), text=True, **popen)
        self.procs.append(proc)
        return proc

    def waiter(self, tag):
        """A command that says it started and runs until its release file exists."""
        script = 'touch "%s/started.%s"; while [ ! -e "%s/release.%s" ]; do sleep 0.05; done' % (self.home, tag, self.home, tag)
        return ["sh", "-c", script]

    HOLD_CEILING_SECONDS = 300   # the integration test's preconditions: a bound that costs nothing when they hold, on the slowest runner

    def drain(self, proc):
        """What a wrapper has written to its stderr so far, without waiting for more."""
        got = b""
        while proc.stderr is not None and select.select([proc.stderr], [], [], 0)[0]:
            chunk = os.read(proc.stderr.fileno(), 65536)
            if not chunk:
                break
            got += chunk
        return got.decode("utf-8", "replace")

    def why(self, wrappers):
        """The message of a failed precondition: who holds a slot, which commands started, and for each wrapper its exit status (or still running) and its stderr, so a
        slow runner and a wrapper that ran its command WITHOUT a slot (`heavy: no slot (...)`) can be told apart."""
        lines = ["holders: %s" % self.hs.holders(self.dir / "fleet-switchboard", 3), "started: %s" % self.started()]   # the path as it is: never made here, so a refused one is shown as it is
        for tag, proc in wrappers.items():
            code = proc.poll()
            lines.append("wrapper %s (pid %d): %s; stderr: %r" % (tag, proc.pid, "exit %d" % code if code is not None else "still running", self.drain(proc)))
        return "\n".join(lines)

    def until(self, test, seconds=90):
        end = time.time() + seconds
        while time.time() < end:
            if test():
                return True
            time.sleep(0.05)
        return False

    def started(self):
        return sorted(p.name for p in self.home.glob("started.*"))

    READY_TRIES = 600    # the readiness helper: 600 reads of the holder record, 0.1 s apart (60 s: a bound for a hang, not a delay: a healthy holder is ready in milliseconds), unless a test names its own bound
    READY_PAUSE = 0.1
    START_DELAY = 0      # seconds a holder is made slow to start (the injected-delay class sets it)

    @staticmethod
    def holders_ready(found, count, name=None, wrapper_pids=()):
        """The readiness decision, from what `holders` listed: `count` holders, each with a real name and command (the record is written) and, for the real-process
        tests, a pid that is NOT its wrapper's. The wrapper writes the record TWICE: first its own pid, then (a moment later, after truncating the file first) the
        command's pid: the first record is not the holder's final one, and a read between the second truncate and the second write shows '?'. Ready is the final record."""
        known = [h for h in found if h["name"] != "?" and h["command"] != "?" and h["pid"] is not None and h["pid"] not in set(wrapper_pids)
                 and (name is None or h["name"] == name)]
        return len(found) == count and len(known) == count

    def ready_holders(self, count, slots=3, name=None, seconds=None, state=None, wrappers=()):
        """Wait until `count` holders are READY, then return them. Ready is read from the record the product itself reads (`holders`), never from a timer and never
        from the lock alone: the lock is taken first and the record written after, so a held lock is not ready. `wrappers` are the heavy wrapper processes started for
        the holders: a holder is ready only once its record shows the COMMAND's pid (see holders_ready). Bounded: READY_TRIES reads (or `seconds` / READY_PAUSE); when
        it runs out it fails and says which holder was expected and what was missing."""
        tries = int(seconds / self.READY_PAUSE) if seconds is not None else self.READY_TRIES
        state = state or self.state()
        pids = [w.pid for w in wrappers]
        found = []
        for attempt in range(max(1, tries)):
            found = self.hs.holders(state, slots)
            if self.holders_ready(found, count, name, pids):
                return found
            time.sleep(self.READY_PAUSE)
        self.fail("holder %r not ready after %d reads of its record (%.1f s): expected %d ready holder(s) with the command's pid (not the wrapper pids %s), found %s (a '?' is a held lock whose record is not written yet)" % (
            name, max(1, tries), max(1, tries) * self.READY_PAUSE, count, pids, found))

    def test_s9_a_wrapper_killed_with_sigkill_leaves_a_run_that_the_orphan_bound_stops_and_audits(self):
        """The 2 h 13 min case for real: the watchdog lives in the wrapper, the wrapper is killed, the run keeps the slot; the orphan bound (clock moved past the ceiling)
        stops the sleeping run and reports it with source orphan. A run whose wrapper is alive is not touched by the same check."""
        found = shutil.which("lsof", path=os.environ["PATH"] + os.pathsep + "/usr/sbin" + os.pathsep + "/usr/bin")
        if found is None:
            self.skipTest("lsof is needed to find what holds the slot")
        patch = mock.patch.dict(os.environ, {"PATH": os.environ["PATH"] + os.pathsep + os.path.dirname(found)})   # a runner's PATH may lack /usr/sbin
        patch.start()
        self.addCleanup(patch.stop)
        wrapper = self.start("sleep", "300", name="orphan-lane")
        self.assertTrue(self.until(lambda: any(h["pid"] and h["pid"] != wrapper.pid and h["name"] != "?" for h in self.hs.holders(self.state(), 3)), 120), self.why({"w": wrapper}))
        held = self.hs.holders(self.state(), 3)[0]
        later = lambda: time.time() + 4000   # past kind "other" (3600 s)
        self.assertEqual(self.hs.check_orphans(self.state(), 3, None, later, None, io.StringIO()), [], "the wrapper is alive: its run is not an orphan")
        os.kill(wrapper.pid, signal.SIGKILL)
        wrapper.wait(timeout=30)
        self.assertEqual([h["pid"] for h in self.hs.holders(self.state(), 3)], [held["pid"]], "the run still holds the slot")
        told = []
        self.assertEqual(self.hs.check_orphans(self.state(), 3, None, lambda: time.time() + 100, lambda *a: told.append(a), io.StringIO()), [], "under the ceiling: left alone")
        stopped = self.hs.check_orphans(self.state(), 3, None, later, lambda *a: told.append(a), io.StringIO())
        self.assertEqual([(s["source"], s["kind"], s["pid"]) for s in stopped], [("orphan", "other", held["pid"])])
        self.assertEqual((told[0][2], told[0][3]), ("orphan-lane", os.environ.get("FLEET_HEAVY_NAME") or os.environ.get("OPENCODE_SESSION_ID") or os.environ.get("USER") or os.environ.get("LOGNAME") or "unknown"))
        self.assertEqual([t[0] for t in told], ["decided", "told"])
        self.assertTrue(self.until(lambda: not self.hs.holders(self.state(), 3), 30), "the slot is free: the run is gone")

    def test_s1_four_callers_of_three_slots_queue_and_the_fourth_runs_when_one_frees(self):
        """The integration check with real processes (the queue logic itself is tested deterministically in TestHeavyQueueLogic)."""
        procs = {tag: self.start(*self.waiter(tag), name="who-%s" % tag) for tag in "abcd"[:3]}
        ok = self.until(lambda: len(self.started()) == 3, self.HOLD_CEILING_SECONDS)
        self.assertTrue(ok, "3 commands started\n" + (self.why(procs) if not ok else ""))
        # the three locks are really held now (the kernel's own answer, not a file): the fourth cannot take one, whatever the machine's speed
        try:
            self.ready_holders(3, seconds=self.HOLD_CEILING_SECONDS, wrappers=list(procs.values()))   # the three locks held AND their records written (the kernel's own answer, not a timer)
        except AssertionError as err:
            self.fail("3 of 3 slots held before the fourth starts\n%s\n%s" % (err, self.why(procs)))
        fourth = self.start(*self.waiter("d"), name="who-d")
        lines, queued = [], threading.Event()

        def pump():   # event driven: the wrapper's stderr is read as it arrives, so no poll interval or start-up time decides anything
            for line in fourth.stderr:
                lines.append(line)
                if "waiting for a slot" in line:
                    queued.set()
        reader = threading.Thread(target=pump, daemon=True)
        reader.start()
        self.assertTrue(queued.wait(self.HOLD_CEILING_SECONDS), "the fourth wrapper (exit %r) never said it was waiting; holders: %s; started: %s" % (
            fourth.poll(), self.hs.holders(self.state(), 3), self.started()))
        self.assertEqual(len(self.started()), 3, "at most 3 run at once")
        (self.home / "release.a").write_text("")
        self.assertTrue(self.until(lambda: "started.d" in self.started()), "the fourth runs once a slot is free")
        for tag in "bcd":
            (self.home / ("release." + tag)).write_text("")
        for proc in list(procs.values()) + [fourth]:
            proc.wait(timeout=90)
        reader.join(timeout=90)
        err = "".join(lines)
        self.assertIn("heavy: waiting for a slot (3 of 3 busy", err)
        self.assertRegex(err, r"who-[abc] sh")

    def test_the_diagnosis_of_a_failed_precondition_shows_a_wrapper_that_ran_without_a_slot(self):
        """A wrapper whose state directory is refused runs its command with NO slot (`heavy: no slot (...)`): the command starts, no slot is held."""
        (self.dir / "fleet-switchboard").write_text("a file where the state directory should be")
        proc = self.start("sh", "-c", 'touch "%s/started.z"' % self.home, name="who-z")
        self.assertEqual(proc.wait(timeout=self.HOLD_CEILING_SECONDS), 0)
        message = self.why({"z": proc}).replace(str(self.dir), "<dir>")
        self.assertEqual(message.count("heavy: no slot"), 1, message)
        self.assertEqual(message.count("exit 0"), 1, message)
        self.assertEqual(message.count("holders: []"), 1, message)
        self.assertEqual(message.count("started: ['started.z']"), 1, message)

    def test_the_ceiling_of_the_integration_preconditions_is_300_seconds(self):
        self.assertEqual(self.HOLD_CEILING_SECONDS, 300)
        source = inspect.getsource(self.test_s1_four_callers_of_three_slots_queue_and_the_fourth_runs_when_one_frees)
        self.assertEqual(source.count("self.HOLD_CEILING_SECONDS"), 3, "both preconditions and the queued wait use it")

    def test_s2_a_holder_killed_with_its_whole_group_frees_its_slot_by_itself(self):
        holder = self.start(*self.waiter("h"), slots=1, name="doomed")
        self.assertTrue(self.until(lambda: "started.h" in self.started()))
        self.assertEqual([h["name"] for h in self.ready_holders(1, slots=1, name="doomed", wrappers=[holder])], ["doomed"])
        os.killpg(holder.pid, signal.SIGKILL)
        holder.wait(timeout=90)
        waiter = self.start("sh", "-c", 'touch "%s/second"' % self.home, slots=1)
        self.assertEqual(waiter.wait(timeout=90), 0)
        self.assertTrue((self.home / "second").exists(), "no cleanup was needed")
        self.assertEqual(self.hs.holders(self.state(), 1), [])

    def test_s3_stdin_stdout_and_the_exit_status_pass_through_and_a_signal_reaches_the_command(self):
        proc = self.start("sh", "-c", "cat; exit 3", stdin=subprocess.PIPE)
        out, err = proc.communicate("some data\n", timeout=90)
        self.assertEqual((out, proc.returncode), ("some data\n", 3))
        pidfile = self.home / "pid"
        proc = self.start("sh", "-c", 'echo $$ > "%s"; exec sleep 60' % pidfile)
        self.assertTrue(self.until(pidfile.exists))
        child = int(pidfile.read_text())
        self.assertTrue(self.until(lambda: any(h["pid"] == child for h in self.hs.holders(self.state(), 3))), "the wrapper has recorded its command")
        proc.send_signal(signal.SIGTERM)   # to the wrapper alone: it forwards it
        self.assertEqual(proc.wait(timeout=90), 128 + signal.SIGTERM)
        self.assertTrue(self.until(lambda: not self.alive(child)), "the command was stopped and reaped: nothing is left behind")

    @staticmethod
    def alive(pid):
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            return False
        except PermissionError:
            return True
        try:
            done, _ = os.waitpid(pid, os.WNOHANG)   # a zombie of ours would still answer kill(0)
            return done == 0
        except ChildProcessError:
            return True

    def test_s3_the_wrapper_reaps_its_child_and_leaves_no_zombie(self):
        """In this very process (so the wrapper IS the parent): when `run` returns, its child has already been waited for, not left a zombie."""
        pidfile = self.home / "short-pid"
        err = io.StringIO()
        status = self.hs.run(["sh", "-c", 'echo $$ > "%s"' % pidfile], self.state(), 1, 10, name="inproc", environ=self.env(), out=err)
        self.assertEqual(status, 0, err.getvalue())
        pid = int(pidfile.read_text())
        with self.assertRaises(ChildProcessError):
            os.waitpid(pid, os.WNOHANG)   # nothing of ours is left to reap: a zombie would answer here

    @staticmethod
    def state_of(pid):
        out = subprocess.run(["ps", "-o", "stat=", "-p", str(pid)], capture_output=True, text=True).stdout.strip()
        return out or None

    def test_s4_the_command_runs_under_taskpolicy_when_it_exists_and_nice_when_it_does_not(self):
        fake = self.home / "fakebin"
        fake.mkdir()
        record = self.home / "record"
        (fake / "taskpolicy").write_text('#!/bin/sh\necho "$1" > "%s"\nshift\nexec "$@"\n' % record)
        os.chmod(str(fake / "taskpolicy"), 0o755)
        env = self.env(PATH="%s:%s" % (fake, os.environ["PATH"]))
        self.assertEqual(self.start("true", env=env).wait(timeout=90), 0)
        self.assertEqual(record.read_text().strip(), "-b", "run as taskpolicy -b <command>")
        self.assertEqual(self.hs.command_prefix(lambda n: "/x/taskpolicy" if n == "taskpolicy" else "/x/nice"), ["/x/taskpolicy", "-b"])
        self.assertEqual(self.hs.command_prefix(lambda n: "/x/nice" if n == "nice" else None), ["/x/nice", "-n", "10"])
        self.assertEqual(self.hs.command_prefix(lambda n: None), [])
        # and with no taskpolicy the real nice runs it at a lower priority
        stub = self.home / "nobin"
        stub.mkdir()
        for tool in ("nice", "sh", "ps"):
            found = shutil.which(tool)
            if found:
                os.symlink(found, str(stub / tool))
        out = self.home / "niceness"
        proc = self.start("sh", "-c", 'ps -o nice= -p $$ > "%s"' % out, env=self.env(PATH=str(stub)))
        self.assertEqual(proc.wait(timeout=90), 0, proc.stderr.read())
        self.assertEqual(int(out.read_text().strip()), min(20, os.nice(0) + 10), "ten above this process's own niceness")

    def test_s5_the_holder_list_names_who_holds_a_slot_and_a_free_slot_says_nothing(self):
        proc = self.start("sleep", "5", slots=2, name="the-coder")
        (entry,) = self.ready_holders(1, slots=2, name="the-coder", wrappers=[proc])
        self.assertEqual((entry["name"], entry["command"]), ("the-coder", "sleep"))
        self.assertIsInstance(entry["pid"], int)
        self.assertLessEqual(abs(entry["since"] - time.time()), 30)
        os.killpg(proc.pid, signal.SIGKILL)
        proc.wait(timeout=90)
        self.assertTrue(self.until(lambda: self.hs.holders(self.state(), 2) == []))
        mode = os.stat(str(self.state() / "heavy-slot-0.lock")).st_mode & 0o777
        self.assertEqual(mode, 0o600)

    def test_s6_past_the_wait_limit_it_exits_75_and_does_not_run_the_command(self):
        holder = self.start("sleep", "30", slots=1, name="busy-one")
        self.ready_holders(1, slots=1, name="busy-one", wrappers=[holder])
        marker = self.home / "marker"
        late = self.start("touch", str(marker), slots=1, wait_max=1)
        self.assertEqual(late.wait(timeout=90), 75)
        self.assertIn("heavy: no slot after", late.stderr.read())
        self.assertFalse(marker.exists())

    def test_s7_the_suite_takes_a_slot_unless_it_is_off_inside_one_or_in_ci(self):
        self.assertEqual(self.hs.should_take_slot({}), "taken")
        self.assertEqual(self.hs.should_take_slot({"FLEET_HEAVY": "off"}), "off")
        self.assertEqual(self.hs.should_take_slot({"CI": "true"}), "off")
        self.assertEqual(self.hs.should_take_slot({"FLEET_HEAVY_SLOT": "1"}), "inside")
        env = {"XDG_STATE_HOME": str(self.dir)}
        wrapped = self.hs.wrap_argv(["TestX"], env, "/py", "/sw", "/dir/test-switchboard")
        self.assertEqual(wrapped, ["/py", "/sw", "heavy", "--name", "test-switchboard", "--", "/py", "/dir/test-switchboard", "TestX"])
        self.assertIsNone(self.hs.wrap_argv([], dict(env, FLEET_HEAVY="off"), "/py", "/sw", "/s"))
        self.assertIsNone(self.hs.wrap_argv([], dict(env, FLEET_HEAVY_SLOT="0"), "/py", "/sw", "/s"))

    def test_s7_a_state_directory_that_cannot_be_written_runs_the_suite_unslotted_with_one_line(self):
        blocked = self.home / "blocked"
        blocked.write_text("a file, so no directory can be made under it")
        err = io.StringIO()
        self.assertIsNone(self.hs.wrap_argv([], {"XDG_STATE_HOME": str(blocked)}, "/py", "/sw", "/s", err=err))
        self.assertEqual(err.getvalue().count("\n"), 1)
        self.assertIn("running without a slot", err.getvalue())

    def test_u1_a_wrapper_killed_alone_leaves_the_slot_busy_exactly_while_its_command_runs(self):
        pidfile = self.home / "orphan-pid"
        wrapper = self.start("sh", "-c", 'echo $$ > "%s"; while [ ! -e "%s/orphan-release" ]; do sleep 0.05; done' % (pidfile, self.home), slots=1)
        self.assertTrue(self.until(pidfile.exists))
        self.assertTrue(self.until(lambda: any(h["pid"] == int(pidfile.read_text()) for h in self.hs.holders(self.state(), 1))))
        os.kill(wrapper.pid, signal.SIGKILL)   # the wrapper only: the command goes on
        wrapper.wait(timeout=90)
        self.assertEqual(len(self.hs.holders(self.state(), 1)), 1, "busy while the command runs")
        (self.home / "orphan-release").write_text("")
        self.assertTrue(self.until(lambda: self.hs.holders(self.state(), 1) == [], 90), "free once it ends")

    def test_u2_the_command_is_not_run_through_a_shell_and_keeps_its_environment_and_directory(self):
        work = self.home / "cwd"
        work.mkdir()
        proc = self.start(sys.executable, "-c", "import sys, os; print(sys.argv[1:], os.environ['X_MARK'], os.getcwd())", "a b;c", "$HOME",
                          env=self.env(X_MARK="kept"), cwd=str(work))
        out, err = proc.communicate(timeout=90)
        self.assertEqual(proc.returncode, 0, err)
        self.assertEqual(out.strip(), "['a b;c', '$HOME'] kept %s" % os.path.realpath(str(work)))

    def test_a_signal_while_waiting_a_zero_wait_limit_and_a_command_that_cannot_start(self):
        holder = self.start("sleep", "30", slots=1)
        self.ready_holders(1, slots=1, name="t", wrappers=[holder])
        waiting = self.start("true", slots=1)
        seen = ""
        end = time.time() + 90
        while "waiting for a slot" not in seen and time.time() < end:   # the wrapper says so once it is queued
            if select.select([waiting.stderr], [], [], 0.2)[0]:
                seen += os.read(waiting.stderr.fileno(), 4096).decode()
        self.assertIn("waiting for a slot", seen)
        waiting.send_signal(signal.SIGTERM)
        self.assertEqual(waiting.wait(timeout=90), 128 + signal.SIGTERM, "a wrapper that is still waiting just ends")
        zero = self.start("true", slots=1, wait_max=0)
        self.assertEqual(zero.wait(timeout=90), 75)
        not_executable = self.home / "notexec"
        not_executable.write_text("#!/bin/sh\n")   # present, not executable
        self.assertEqual(self.start(str(not_executable), slots=2).wait(timeout=90), 127)

    def test_what_is_shown_about_a_holder_never_carries_a_terminal_escape(self):
        state = self.state()
        (state / "heavy-slot-0.lock").write_text(json.dumps({"name": "\x1b[2Jevil\x9b31m", "command": "a\nb", "pid": 1, "since": 1}))
        fd = os.open(str(state / "heavy-slot-0.lock"), os.O_RDWR)
        import fcntl
        fcntl.flock(fd, fcntl.LOCK_EX)
        try:
            (entry,) = self.hs.holders(state, 1)
        finally:
            os.close(fd)
        shown = entry["name"] + entry["command"]
        self.assertEqual([c for c in shown if ord(c) < 32 or 0x7f <= ord(c) <= 0x9f], [])
        self.assertIn("evil", shown)
        self.assertEqual(self.hs.holder_name({"FLEET_HEAVY_NAME": "x\x1b[0my"}), "x [0my")

    def test_a_bad_report_interval_falls_back_to_the_default(self):
        out = self.start("true", env=self.env(FLEET_HEAVY_REPORT_SECONDS="soon"))
        self.assertEqual(out.wait(timeout=90), 0)

    def test_a_missing_or_unwritable_state_directory_runs_the_command_without_a_slot_with_one_line(self):
        marker = self.home / "ran"
        blocked = self.home / "blocked"
        blocked.write_text("a file: no directory can be made under it")
        proc = self.start("sh", "-c", 'touch "%s"' % marker, env=self.env(XDG_STATE_HOME=str(blocked)))
        out, err = proc.communicate(timeout=90)
        self.assertEqual(proc.returncode, 0, err)
        self.assertTrue(marker.exists(), "the command ran")
        self.assertEqual(err.count("heavy: no slot ("), 1, err)
        self.assertNotIn("Traceback", err)
        marker.unlink()
        readonly = self.home / "readonly"
        readonly.mkdir()
        os.chmod(str(readonly), 0o500)
        self.addCleanup(os.chmod, str(readonly), 0o700)
        proc = self.start("sh", "-c", 'touch "%s"' % marker, env=self.env(XDG_STATE_HOME=str(readonly)))
        out, err = proc.communicate(timeout=90)
        self.assertEqual(proc.returncode, 0, err)
        self.assertTrue(marker.exists())
        self.assertNotIn("Traceback", err)
        # and in process: a directory that does not exist at all
        errors = io.StringIO()
        self.assertEqual(self.hs.run(["true"], str(self.home / "no" / "such" / "dir"), 1, 5, environ=self.env(), out=errors), 0)
        self.assertEqual(errors.getvalue().count("heavy: no slot ("), 1)

    def test_nested_heavy_inside_a_slot_takes_no_second_slot_so_four_levels_of_three_slots_finish(self):
        inner = ['"%s"' % sys.executable, '"%s"' % SWITCHBOARD, "heavy", "--slots", "3", "--wait-max", "20", "--"]
        script = "echo level-4"
        for level in (3, 2, 1):
            script = " ".join(inner) + " sh -c '%s'" % script.replace("'", "'\\''")
        proc = self.start("sh", "-c", script, slots=3, wait_max=20)
        out, err = proc.communicate(timeout=90)
        self.assertEqual((proc.returncode, out.strip()), (0, "level-4"), err)
        self.assertEqual(err.count("already inside a slot"), 3)
        self.assertNotIn("no slot after", err)

    def test_heavy_off_runs_the_command_directly_with_no_slot_and_no_line(self):
        out = self.home / "off-out"
        proc = self.start("sh", "-c", 'echo "$FLEET_HEAVY_SLOT" > "%s"' % out, env=self.env(FLEET_HEAVY="off"))
        stdout, err = proc.communicate(timeout=90)
        self.assertEqual((proc.returncode, err), (0, ""))
        self.assertEqual(out.read_text().strip(), "", "no slot variable: it ran as it is")
        self.assertFalse(list(self.state().glob("heavy-slot-*.lock")), "no slot file was even made")

    def test_the_cpu_line_shows_the_slots_in_use_through_the_real_heavy_module(self):
        cg = sb.load_cpu_guard()
        self.assertEqual(cg.slots_text({}, self.state()), "heavy slots 0/3")
        holder = self.start("sleep", "30", name="the-coder")
        self.ready_holders(1, name="the-coder", wrappers=[holder])
        line = cg.slots_text({}, self.state())
        self.assertRegex(line, r"^heavy slots 1/3 \(the-coder sleep \d+[ms]\)$")
        self.assertEqual(cg.slots_text({"heavy": {"slots": 5}}, self.state())[:15], "heavy slots 1/5")
        os.killpg(holder.pid, signal.SIGKILL)
        holder.wait(timeout=90)
        self.assertTrue(self.until(lambda: cg.slots_text({}, self.state()) == "heavy slots 0/3"), "a killed holder is not shown")

    def test_a_missing_command_and_misuse_are_said_plainly(self):
        self.assertEqual(self.start("no-such-command-here").wait(timeout=90), 127)
        for words in ([], ["--slots", "0", "--", "true"], ["--slots", "x", "--", "true"], ["--wait-max", "-1", "--", "true"]):
            proc = subprocess.Popen([sys.executable, str(SWITCHBOARD), "heavy"] + words, env=self.env(), stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
            proc.communicate(timeout=90)
            self.assertEqual(proc.returncode, sb.EXIT_USAGE, words)

    def test_the_config_key_is_validated(self):
        for ok in (None, {}, {"slots": 1}, {"slots": 8}):
            self.hs.settings(ok)
        for bad in (3, {"slots": 0}, {"slots": "3"}, {"slots": True}, {"slots": 100}, {"cores": 2}):
            with self.assertRaises(self.hs.HeavyError):
                self.hs.settings(bad)
        self.assertEqual(self.hs.settings(None), 3)
        with self.assertRaises(sb.ConfigError):
            sb.validate_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "heavy": {"slots": 0}})

    def test_the_documents_name_the_command_and_the_agent_definitions_say_it_once(self):
        text = (REPO / "docs" / "switchboard.md").read_text()
        self.assertIn("fleet-switchboard heavy", text)
        line = "full suites and browser/e2e runs go through `fleet-switchboard heavy -- <cmd>`"
        for path in ("agents/opencode/coder.md", "agents/opencode/orchestrator.md", "skills/fleet-coordination/SKILL.md"):
            found = (REPO / path).read_text()
            self.assertEqual(found.lower().count(line), 1, path)


class TestHeavySlotsReadiness(StandInPids, TestHeavySlots):
    """#688: the readiness helper of TestHeavySlots. Its own checks run here (the inherited tests below are removed: they run once, in TestHeavySlots, and the three
    that failed in CI run again in TestHeavySlotsSlowStart)."""

    def test_the_helper_reads_the_holder_record_the_product_reads_and_the_class_has_no_bare_sleep_wait(self):
        helper = inspect.getsource(TestHeavySlots.ready_holders)
        self.assertIn("self.hs.holders(", helper)
        source = inspect.getsource(TestHeavySlots)
        self.assertEqual(source.count("            time.sleep("), 2, "only the two bounded waits (until, ready_holders) sleep: no test waits by a bare sleep")
        self.assertEqual(TestHeavySlots.READY_TRIES * TestHeavySlots.READY_PAUSE, 60.0)

    def test_a_holder_whose_lock_is_held_but_record_is_not_written_is_not_ready_and_a_never_ready_holder_fails_within_the_bound_naming_it(self):
        import fcntl
        state = self.state()
        fd = os.open(str(state / "heavy-slot-0.lock"), os.O_RDWR | os.O_CREAT, 0o600)   # held, with no record: what the product lists as '?'
        self.addCleanup(os.close, fd)
        fcntl.flock(fd, fcntl.LOCK_EX)
        self.assertEqual([h["name"] for h in self.hs.holders(state, 3)], ["?"])
        begun = time.time()
        with self.assertRaises(AssertionError) as caught:
            self.ready_holders(1, name="slow-one", seconds=1)
        self.assertLess(time.time() - begun, 2.5)
        self.assertIn("slow-one", str(caught.exception))
        self.assertIn("not ready", str(caught.exception))
        self.assertIn("'?'", str(caught.exception))
        os.ftruncate(fd, 0)
        os.write(fd, json.dumps({"name": "slow-one", "command": "sleep", "pid": 1, "since": time.time()}).encode())
        (entry,) = self.ready_holders(1, name="slow-one", seconds=1)
        self.assertEqual((entry["name"], entry["command"]), ("slow-one", "sleep"))

    def test_the_readiness_decision_is_the_final_record_not_the_lock_and_not_the_wrappers_first_record(self):
        """Deterministic: no process, no clock. The cases a lock-only (or first-record) readiness would accept and this one must not."""
        def held(name, command, pid):
            return {"slot": 0, "name": name, "command": command, "pid": pid, "since": 1}
        ready = self.holders_ready
        self.assertFalse(ready([held("?", "?", None)], 1, "the-coder", [self.px[100]]), "the lock is held, no record yet")
        self.assertFalse(ready([held("the-coder", "sleep", self.px[100])], 1, "the-coder", [self.px[100]]), "the wrapper's own first record: the second write (truncate, then the command's pid) is still to come")
        self.assertFalse(ready([held("?", "?", None)], 1, None, []), "a '?' holder is never ready, with or without a name asked for")
        self.assertFalse(ready([held("other", "sleep", self.px[200])], 1, "the-coder", [self.px[100]]), "the wrong holder")
        self.assertFalse(ready([], 1, "the-coder", [self.px[100]]), "no holder")
        self.assertFalse(ready([held("the-coder", "sleep", self.px[200]), held("?", "?", None)], 2, None, [self.px[100]]), "one of two is not ready")
        self.assertTrue(ready([held("the-coder", "sleep", self.px[200])], 1, "the-coder", [self.px[100]]), "the command's pid: the final record")

    def test_the_helper_waits_through_the_wrappers_first_record_until_the_second_is_written(self):
        """The product's own two records, in order and with a deterministic gap: the helper returns only after the second."""
        import fcntl
        state = self.state()
        fd = os.open(str(state / "heavy-slot-0.lock"), os.O_RDWR | os.O_CREAT, 0o600)
        self.addCleanup(os.close, fd)
        fcntl.flock(fd, fcntl.LOCK_EX)
        self.hs._record(fd, "the-coder", self.px[100], "sleep", time.time())   # the wrapper's first record: pid 100 is the wrapper
        wrapper = mock.Mock(pid=self.px[100])
        with self.assertRaises(AssertionError) as caught:
            self.ready_holders(1, name="the-coder", seconds=0.5, wrappers=[wrapper])
        self.assertIn("not ready", str(caught.exception))
        self.hs._record(fd, "the-coder", self.px[200], "sleep", time.time())   # the second: the command's pid
        (entry,) = self.ready_holders(1, name="the-coder", seconds=0.5, wrappers=[wrapper])
        self.assertEqual(entry["pid"], self.px[200])


class TestHeavySlotsSlowStart(TestHeavySlots):
    """#688: the three tests that failed in CI, run again with every holder one second slow to write its record (its lock is held at once)."""
    START_DELAY = 1


_KEEP_SLOW = ("test_s5_the_holder_list_names_who_holds_a_slot_and_a_free_slot_says_nothing", "test_the_cpu_line_shows_the_slots_in_use_through_the_real_heavy_module",
              "test_s1_four_callers_of_three_slots_queue_and_the_fourth_runs_when_one_frees")
for _name in dir(TestHeavySlots):
    if _name.startswith("test"):
        if _name not in _KEEP_SLOW:
            setattr(TestHeavySlotsSlowStart, _name, None)
        setattr(TestHeavySlotsReadiness, _name, None)


def _artifact_zip(names, complete=True, run=1, head="a" * 40):
    stream = io.BytesIO()
    with zipfile.ZipFile(stream, "w") as archive:
        archive.writestr("failing-tests.json", json.dumps({"v": 1, "run": run, "head": head, "complete": complete, "failed": names}))
    return stream.getvalue()


class FakeActions:
    """A fake GitHub for `reds`: a pull request, runs per event, an artifact list and artifact zips. Records every path it is asked (all GETs)."""

    REPO = "acme/widget"

    def __init__(self):
        self.calls, self.argvs, self.runs, self.artifacts, self.zips = [], [], {}, {}, {}
        self.pull = {"head": {"sha": "b" * 40}, "base": {"repo": {"default_branch": "main"}}}
        self.fail_paths = set()
        self.next_id = 100

    WORKFLOWS = {"A": (11, ".github/workflows/a-ci.yml"), "B": (22, ".github/workflows/b-style.yml")}

    def pr_run(self, names, complete=True, artifact=True, workflow="A", created="2027-01-15T08:00:00Z", **more):
        return self.add_run("pull_request", "feature", names, complete, created, artifact, sha="b" * 40, workflow=workflow, **more)

    def add_run(self, event, branch, names, complete=True, created="2027-01-15T07:00:00Z", artifact=True, sha=None, expired=False, raw=None, workflow="A", no_workflow_id=False):
        self.next_id += 1
        wid, path = self.WORKFLOWS[workflow]
        run = {"id": self.next_id, "event": event, "head_branch": branch, "head_sha": sha or ("%07d" % self.next_id) + "c" * 33, "created_at": created, "status": "completed",
               "workflow_id": wid, "name": "Workflow " + workflow, "path": path}
        if no_workflow_id:
            del run["workflow_id"]
        self.runs.setdefault(event, []).append(run)
        if artifact:
            self.zips[self.next_id + 5000] = raw if raw is not None else _artifact_zip(names, complete, self.next_id)
            self.artifacts[self.next_id] = {"id": self.next_id + 5000, "expired": expired, "workflow_run": {"id": self.next_id}, "size_in_bytes": len(self.zips[self.next_id + 5000])}
        return self.next_id

    def __call__(self, argv, **kwargs):
        argv = list(argv)
        path = argv[-1]
        self.calls.append(path)
        self.argvs.append(argv)
        if len(argv) != 3 or argv[1] != "api" or any(a.startswith("-") for a in argv[2:]):
            raise AssertionError("fake github serves `gh api <path>`, a plain GET; got %r" % argv)
        done = lambda text, code=0, err="": subprocess.CompletedProcess(argv, code, text, err)
        if any(bad in path for bad in self.fail_paths):
            return done("", 1, "gh: HTTP 500")
        base = "repos/%s/" % self.REPO
        if path == base + "pulls/12":
            return done(json.dumps(self.pull))
        query = urllib.parse.parse_qs(urllib.parse.urlparse(path).query)
        found = re.fullmatch(re.escape(base) + r"actions/workflows/([^/?]+)/runs", urllib.parse.urlparse(path).path)
        if found:   # one workflow's own runs, by id or by file name
            which = urllib.parse.unquote(found.group(1))
            event = query["event"][0]
            runs = [r for r in self.runs.get(event, []) if (getattr(self, "leak_foreign", False) or str(r.get("workflow_id")) == which or r["path"].endswith("/" + which)) and ("branch" not in query or r["head_branch"] == query["branch"][0])]
            return done(json.dumps({"workflow_runs": sorted(runs, key=lambda r: r["created_at"], reverse=True)[:int(query.get("per_page", ["30"])[0])]}))
        if path.startswith(base + "actions/runs?"):
            if "head_sha" not in query:
                raise AssertionError("reds must not list the repo's runs by event alone: that was the defect (%r)" % path)
            event = query["event"][0]
            runs = [r for r in self.runs.get(event, []) if ("head_sha" not in query or r["head_sha"] == query["head_sha"][0]) and ("branch" not in query or r["head_branch"] == query["branch"][0])]
            return done(json.dumps({"workflow_runs": sorted(runs, key=lambda r: r["created_at"], reverse=True)[:int(query.get("per_page", ["30"])[0])]}))
        if path.startswith(base + "actions/artifacts?"):
            return done(json.dumps({"artifacts": list(self.artifacts.values())}))
        found = re.fullmatch(re.escape(base) + r"actions/artifacts/(\d+)/zip", path)
        if found:
            return subprocess.CompletedProcess(argv, 0, self.zips[int(found.group(1))], b"")
        raise AssertionError("fake github: no route for %r" % path)


class TestReds(Base):
    """`reds OWNER/REPO#N` (ask #342): classify from failing-tests artifacts: main's latest run, flaky (2 of main's last 5 usable runs), or new."""

    def setUp(self):
        super().setUp()
        self.hs = sb.load_reds()
        self.fake = FakeActions()
        self.state = self.home / "reds-state"
        self.state.mkdir(mode=0o700)
        self.clock = [1_800_000_000.0]

    def now(self):
        return self.clock[0]

    def created(self, minutes_ago):
        return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(self.clock[0] - minutes_ago * 60))

    class Reader:
        def __init__(self, runner, repo):
            self.runner, self.repo = runner, repo

        def json(self, path):
            done = self.runner(["gh", "api", path])
            if done.returncode != 0:
                raise sb.load_reds().RedsError(done.stderr)
            return json.loads(done.stdout)

        def zip(self, path):
            done = self.runner(["gh", "api", path])
            if done.returncode != 0:
                raise sb.load_reds().RedsError(done.stderr)
            return done.stdout

    def run_reds(self, events=("push",), cache=True, workflow=None):
        out = io.StringIO()
        code = self.hs.run(self.Reader(self.fake, FakeActions.REPO), FakeActions.REPO, 12, list(events), self.state if cache else None, self.now, out, workflow)
        return code, out.getvalue()

    def main_runs(self, histories, event="push", branch="main"):
        """histories: failing-name lists, newest first."""
        for position, names in enumerate(histories):
            self.fake.add_run(event, branch, names, created=self.created(10 + position * 60))

    def test_s1_a_name_on_main_s_latest_run_is_main_two_of_five_is_flaky_and_the_rest_is_new(self):
        self.fake.pr_run(["t/a.test::a", "t/b.test::b", "t/c.test::c"])
        self.main_runs([["t/a.test::a"], ["t/b.test::b"], [], ["t/b.test::b"], []])
        code, out = self.run_reds()
        self.assertEqual(code, 0, out)
        lines = out.splitlines()
        self.assertEqual(len([l for l in lines if l.startswith("    t/a.test::a")]), 1)
        self.assertIn("also failing on main (1):\n    t/a.test::a (1 of 5 main runs)", out)
        self.assertIn("flaky on main (1):\n    t/b.test::b (2 of 5 main runs)", out)
        self.assertIn("new (1):\n    t/c.test::c", out)
        self.assertRegex(out, r"main's latest run: push [0-9c]{7} \d+m ago \(workflow Workflow A; reference events: push\)")

    def test_s2_one_failure_in_five_is_not_flaky_two_is(self):
        self.fake.pr_run(["x::once", "y::twice"])
        self.main_runs([[], ["x::once", "y::twice"], [], ["y::twice"], []])
        code, out = self.run_reds()
        self.assertIn("flaky on main (1):\n    y::twice (2 of 5 main runs)", out)
        self.assertIn("new (1):\n    x::once (1 of 5 main runs)", out)

    def test_s3_runs_without_an_artifact_incomplete_or_expired_are_unknown_and_never_passing(self):
        self.fake.pr_run(["f::flaky-one"])
        self.fake.add_run("push", "main", ["f::flaky-one"], created=self.created(10))
        self.fake.add_run("push", "main", ["f::flaky-one"], created=self.created(70))
        self.fake.add_run("push", "main", [], created=self.created(130), artifact=False)
        self.fake.add_run("push", "main", ["f::flaky-one"], complete=False, created=self.created(190))
        self.fake.add_run("push", "main", ["f::flaky-one"], created=self.created(250), expired=True)
        code, out = self.run_reds()
        self.assertEqual(code, 0, out)
        self.assertIn("main runs: 5 listed (workflow Workflow A), 2 usable, 3 unknown", out)
        self.assertIn("flaky on main", out)
        self.assertNotIn("flaky-one (2 of 5", out)
        self.assertIn("(2 of 2 main runs)", out)

    def test_s3_an_unknown_latest_run_means_failing_on_main_cannot_be_said(self):
        self.fake.pr_run(["a::fails"])
        self.fake.add_run("push", "main", ["a::fails"], created=self.created(10), artifact=False)
        self.fake.add_run("push", "main", ["a::fails"], created=self.created(70))
        code, out = self.run_reds()
        self.assertIn('UNKNOWN (no artifact), so "failing on main" cannot be said', out)
        self.assertNotIn("also failing on main (1)", out)

    def test_s4_names_are_stripped_bounded_and_at_most_two_thousand_are_read(self):
        names = ["bad\x1b[2Jname\x9b\u2028::x", "L" * 500] + ["n%d" % i for i in range(3000)]
        self.fake.pr_run(names)
        self.main_runs([[]])
        code, out = self.run_reds()
        self.assertEqual([c for c in out if (ord(c) < 32 and c != "\n") or 0x7f <= ord(c) <= 0x9f or c in "\u2028\u2029"], [])
        self.assertLessEqual(max(len(line) for line in out.splitlines()), 240)
        self.assertIn("2000 failing in the pull request's run", out)

    def test_s5_cold_and_warm_calls_stay_within_the_limits_and_nothing_is_written(self):
        self.fake.pr_run(["a::t"])
        self.main_runs([["a::t"], [], ["a::t"], [], ["a::t"]])
        self.run_reds()
        cold = len(self.fake.calls)
        self.assertLessEqual(cold, 12, self.fake.calls)
        del self.fake.calls[:]
        self.run_reds()
        self.assertLessEqual(len(self.fake.calls), 3, self.fake.calls)
        self.assertTrue(self.fake.argvs and all(a[1] == "api" and len(a) == 3 for a in self.fake.argvs), "every call is a plain `gh api <path>` GET")
        # two reference events: 14 and 4
        second = FakeActions()
        second.pr_run(["a::t"])
        for position in range(3):
            second.add_run("merge_group", "gh-readonly-queue/main/pr-%d-abc" % position, ["a::t"], created=self.created(10 + position * 60))
        for position in range(2):
            second.add_run("schedule", "main", ["a::t"], created=self.created(40 + position * 60))
        shutil.rmtree(str(self.state))
        self.state.mkdir(mode=0o700)
        self.fake = second
        self.run_reds(events=("merge_group", "schedule"))
        self.assertLessEqual(len(second.calls), 14, second.calls)
        del second.calls[:]
        self.run_reds(events=("merge_group", "schedule"))
        self.assertLessEqual(len(second.calls), 4, second.calls)

    def test_s5_without_a_cache_every_call_is_made_again(self):
        self.fake.pr_run(["a::t"])
        self.main_runs([["a::t"]] * 5)
        self.run_reds(cache=False)
        first = len(self.fake.calls)
        self.run_reds(cache=False)
        self.assertEqual(len(self.fake.calls), 2 * first)

    def test_s6_a_repo_with_only_merge_group_and_schedule_runs_uses_them_and_the_default_uses_push(self):
        self.fake.pr_run(["a::t", "b::u"])
        self.fake.add_run("merge_group", "gh-readonly-queue/main/pr-9-aaa", ["a::t"], created=self.created(10))
        self.fake.add_run("merge_group", "gh-readonly-queue/release/pr-9-aaa", ["b::u"], created=self.created(5))   # another branch's queue: not main
        self.fake.add_run("schedule", "main", ["b::u"], created=self.created(70))
        self.fake.add_run("schedule", "feature", ["b::u"], created=self.created(1))
        code, out = self.run_reds(events=("merge_group", "schedule"))
        self.assertIn("main runs: 2 listed (workflow Workflow A), 2 usable, 0 unknown", out)
        self.assertRegex(out, r"main's latest run: merge_group [0-9c]{7} ")
        self.assertIn("also failing on main (1):\n    a::t", out)
        code, out = self.run_reds(events=("push",))
        self.assertIn("main's latest run: none found", out)
        self.assertEqual(self.hs.DEFAULT_EVENTS, ["push"])

    def test_s7_full_name_first_then_a_unique_leaf_marked_and_a_duplicate_leaf_is_never_guessed(self):
        self.fake.pr_run(["a/x.test::exact", "p/y.test::renamed", "q/z.test::dup", "m::lonely"])
        self.main_runs([["a/x.test::exact", "other/y.test::renamed", "r/one.test::dup", "s/two.test::dup", "lonely"]])
        code, out = self.run_reds()
        self.assertIn("a/x.test::exact (1 of 1 main runs)\n", out)
        self.assertIn("p/y.test::renamed (1 of 1 main runs); matched by name only", out)
        self.assertIn("m::lonely (1 of 1 main runs); matched by name only", out)
        self.assertIn("new (1):\n    q/z.test::dup\n", out, "a leaf that is not unique stays unmatched")

    def test_s8_the_prs_own_incomplete_flag_never_judges_main(self):
        self.fake.pr_run(["a::t"], complete=False)
        self.main_runs([["a::t"], []])
        code, out = self.run_reds()
        self.assertIn("its list is INCOMPLETE", out)
        self.assertIn("main runs: 2 listed (workflow Workflow A), 2 usable, 0 unknown", out)
        self.assertIn("also failing on main (1)", out)

    def test_u1_a_failed_read_says_so_classifies_nothing_and_exits_1(self):
        self.fake.pr_run(["a::t"])
        self.main_runs([["a::t"]])
        for bad in ("pulls/12", "actions/runs?head_sha", "actions/workflows/11/runs", "actions/artifacts?name"):
            fake = self.fake
            fake.fail_paths = {bad}
            code, out = self.run_reds(cache=False)
            self.assertEqual(code, 1, bad)
            self.assertIn("nothing was classified", out)
            self.assertNotIn("also failing on main", out)
        self.fake.fail_paths = set()

    def test_a_garbage_artifact_a_pr_without_a_run_and_a_pr_without_an_artifact_are_said(self):
        self.fake.pr_run(["a::t"], artifact=False)
        code, out = self.run_reds()
        self.assertEqual(code, 3, "unknown, not classified")
        self.assertIn("no failing-tests artifact on the pull request's run", out)
        shutil.rmtree(str(self.state / "reds-cache"), ignore_errors=True)   # the fakes reuse run ids
        broken = FakeActions()
        broken.add_run("pull_request", "feature", [], created=self.created(1), sha="b" * 40, raw=b"not a zip")
        self.fake = broken
        code, out = self.run_reds()
        self.assertIn("unknown, nothing was classified", out)
        shutil.rmtree(str(self.state / "reds-cache"), ignore_errors=True)
        empty = FakeActions()
        self.fake = empty
        code, out = self.run_reds()
        self.assertIn("no completed pull_request run", out)

    def unknown_case(self, build):
        self.fake = FakeActions()
        shutil.rmtree(str(self.state / "reds-cache"), ignore_errors=True)
        self.fake.pr_run(["a::t", "b::u"])
        build(self.fake)
        return self.run_reds()

    def assert_cannot_classify(self, code, out, why):
        self.assertEqual(code, self.hs.EXIT_UNKNOWN, out)
        self.assertIn("no usable reference run (%s): cannot classify" % why, out)
        self.assertIn("unknown (2):\n    a::t\n    b::u", out)
        self.assertNotIn("new (", out, "a red is never called new on no evidence")
        self.assertNotIn("also failing on main", out)
        self.assertNotIn("flaky on main", out)

    def test_with_no_usable_reference_run_the_reds_are_unknown_never_new(self):
        code, out = self.unknown_case(lambda fake: None)
        self.assert_cannot_classify(code, out, "none found")
        code, out = self.unknown_case(lambda fake: [fake.add_run("push", "main", ["a::t"], created=self.created(10 + n * 60), expired=True) for n in range(3)])
        self.assert_cannot_classify(code, out, "no artifact: expired or never uploaded")
        code, out = self.unknown_case(lambda fake: [fake.add_run("push", "main", ["a::t"], complete=False, created=self.created(10 + n * 60)) for n in range(3)])
        self.assert_cannot_classify(code, out, "incomplete: not all tests ran")
        code, out = self.unknown_case(lambda fake: fake.add_run("push", "main", [], created=self.created(10), raw=b"not a zip"))
        self.assert_cannot_classify(code, out, "unreadable: the artifact is not a zip")
        code, out = self.unknown_case(lambda fake: (fake.add_run("push", "main", [], created=self.created(10), artifact=False),
                                                    fake.add_run("push", "main", ["a::t"], complete=False, created=self.created(70))))
        self.assert_cannot_classify(code, out, "incomplete: not all tests ran; no artifact: expired or never uploaded")

    def test_an_unknown_latest_run_with_older_complete_runs_classifies_by_those_alone_and_says_so(self):
        def build(fake):
            fake.add_run("push", "main", ["a::t"], complete=False, created=self.created(10))   # latest: incomplete
            fake.add_run("push", "main", ["a::t"], created=self.created(70))
            fake.add_run("push", "main", ["a::t"], created=self.created(130))
        code, out = self.unknown_case(build)
        self.assertEqual(code, 0, out)
        self.assertIn("main's latest run is unknown: classified by the 2 older complete run(s) only; \"failing on main\" is not said", out)
        self.assertIn("flaky on main (1):\n    a::t (2 of 2 main runs)", out)
        self.assertIn("new (1):\n    b::u\n", out, "absent from every COMPLETE run: new is allowed here")
        self.assertNotIn("also failing on main (1)", out)

    def test_a_mix_of_unknown_and_one_complete_run_classifies_from_the_complete_one(self):
        def build(fake):
            fake.add_run("push", "main", [], created=self.created(10), artifact=False)
            fake.add_run("push", "main", ["a::t"], complete=False, created=self.created(70))
            fake.add_run("push", "main", ["a::t"], created=self.created(130))
        code, out = self.unknown_case(build)
        self.assertEqual(code, 0, out)
        self.assertIn("1 older complete run(s) only", out)
        self.assertIn("new (2):\n    a::t (1 of 1 main runs)\n    b::u\n", out)
        self.assertIn("main runs: 3 listed (workflow Workflow A), 1 usable, 2 unknown", out)

    # -- the workflow of the artifact (fix to #342: main's runs are the runs of the workflow that holds the pull request's artifact)

    def test_s1_only_the_artifact_workflow_s_main_runs_are_listed_and_another_workflow_is_never_unknown(self):
        self.fake.pr_run(["a::t", "b::u"])
        for position in range(5):
            self.fake.add_run("push", "main", ["a::t"] if position % 2 == 0 else [], created=self.created(10 + position * 60), workflow="A")
            self.fake.add_run("push", "main", [], created=self.created(5 + position * 60), workflow="B", artifact=False)
        code, out = self.run_reds()
        self.assertEqual(code, 0, out)
        self.assertIn("main runs: 5 listed (workflow Workflow A), 5 usable, 0 unknown", out)
        self.assertIn("workflow Workflow A; reference events: push", out)
        listed = [c for c in self.fake.calls if "actions/workflows/" in c]
        self.assertEqual(len(listed), 1)
        self.assertIn("workflows/11/runs", listed[0])

    def test_s1b_a_missing_artifact_of_the_chosen_workflow_is_unknown_and_another_workflow_never_is(self):
        self.fake.pr_run(["a::t"])
        self.fake.add_run("push", "main", ["a::t"], created=self.created(10), workflow="A")
        self.fake.add_run("push", "main", [], created=self.created(20), workflow="A", artifact=False)       # A without its artifact: unknown, as before
        self.fake.add_run("push", "main", [], created=self.created(5), workflow="B", artifact=False)        # B: never listed
        code, out = self.run_reds()
        self.assertIn("main runs: 2 listed (workflow Workflow A), 1 usable, 1 unknown", out)

    def test_s2_the_newest_pull_request_run_that_holds_the_artifact_is_the_pull_request_s_run_and_the_workflow_is_named(self):
        self.fake.pr_run([], artifact=False, workflow="B", created="2027-01-15T09:00:00Z")   # the newest run, another workflow, no artifact
        self.fake.pr_run(["a::t"], workflow="A", created="2027-01-15T08:00:00Z")
        self.fake.add_run("push", "main", ["a::t"], created=self.created(10), workflow="A")
        code, out = self.run_reds()
        self.assertEqual(code, 0, out)
        self.assertIn("1 failing in the pull request's run of workflow Workflow A", out)
        self.assertIn("also failing on main (1)", out)
        self.assertNotIn("workflows hold a failing-tests artifact", out)

    def test_s2b_when_two_workflows_hold_an_artifact_it_says_so_in_one_line_and_names_the_one_used(self):
        self.fake.pr_run(["a::t"], workflow="B", created="2027-01-15T09:00:00Z")
        self.fake.pr_run(["a::t"], workflow="A", created="2027-01-15T08:00:00Z")
        self.fake.add_run("push", "main", ["a::t"], created=self.created(10), workflow="B")
        code, out = self.run_reds()
        self.assertEqual(len([l for l in out.splitlines() if "workflows hold a failing-tests artifact" in l]), 1)
        self.assertIn("2 workflows hold a failing-tests artifact on this pull request (Workflow A, Workflow B): the newest run's workflow, Workflow B, was used", out)
        self.assertIn("(workflow Workflow B;", out)

    def test_s3_a_pull_request_none_of_whose_runs_holds_an_artifact_cannot_be_classified_and_main_is_not_listed(self):
        self.fake.pr_run([], artifact=False, workflow="A")
        self.fake.pr_run([], artifact=False, workflow="B", created="2027-01-15T07:30:00Z")
        self.fake.add_run("push", "main", ["a::t"], created=self.created(10), workflow="A")
        code, out = self.run_reds()
        self.assertEqual(code, 3, out)
        self.assertEqual(len([l for l in out.splitlines() if l.startswith("no failing-tests artifact on the pull request's run")]), 1)
        self.assertFalse([c for c in self.fake.calls if "actions/workflows/" in c], "no main run of any workflow was listed")

    def test_s4_the_messages_name_the_workflow_and_say_how_many_of_its_runs_were_looked_at(self):
        self.fake.pr_run(["a::t"])
        for position in range(5):
            self.fake.add_run("push", "main", [], created=self.created(10 + position * 60), workflow="A", artifact=False)
        code, out = self.run_reds()
        self.assertEqual(code, 3, out)
        self.assertEqual(len([l for l in out.splitlines() if l == "no failing-tests artifact in the newest 5 runs of workflow Workflow A"]), 1)
        self.assertIn("main runs: 5 listed (workflow Workflow A), 0 usable, 5 unknown", out)

    def test_s5_the_call_counts_with_two_reference_events_stay_within_14_cold_and_4_warm(self):
        self.fake.pr_run(["a::t"])
        for position in range(3):
            self.fake.add_run("merge_group", "gh-readonly-queue/main/pr-%d-abc" % position, ["a::t"], created=self.created(10 + position * 60), workflow="A")
        for position in range(2):
            self.fake.add_run("schedule", "main", ["a::t"], created=self.created(40 + position * 60), workflow="A")
            self.fake.add_run("schedule", "main", [], created=self.created(41 + position * 60), workflow="B", artifact=False)
        self.run_reds(events=("merge_group", "schedule"))
        self.assertLessEqual(len(self.fake.calls), 14, self.fake.calls)
        cold = len(self.fake.calls)
        del self.fake.calls[:]
        self.run_reds(events=("merge_group", "schedule"))
        self.assertLessEqual(len(self.fake.calls), 4, self.fake.calls)
        self.assertTrue(all(len(a) == 3 for a in self.fake.argvs), "plain GETs only")

    def test_s6_the_workflow_override_picks_the_pull_request_s_run_of_that_file_and_lists_its_runs(self):
        self.fake.pr_run(["a::t"], workflow="B", created="2027-01-15T09:00:00Z")     # newer, with an artifact, but not the configured one
        self.fake.pr_run(["a::t"], workflow="A", created="2027-01-15T08:00:00Z")
        self.fake.add_run("push", "main", ["a::t"], created=self.created(10), workflow="A")
        self.fake.add_run("push", "main", ["a::t"], created=self.created(5), workflow="B")
        code, out = self.run_reds(workflow="a-ci.yml")
        self.assertEqual(code, 0, out)
        self.assertIn("in the pull request's run of workflow Workflow A", out)
        self.assertIn("main runs: 1 listed (workflow Workflow A)", out)
        listed = [c for c in self.fake.calls if "actions/workflows/" in c]
        self.assertIn("workflows/a-ci.yml/runs", listed[0])
        code, out = self.run_reds(workflow="nothing.yml")
        self.assertEqual(code, 3)
        self.assertIn("no completed run of workflow nothing.yml", out)

    def test_s6_the_override_setting_is_strict_a_file_name_only(self):
        self.assertEqual(self.hs.workflows({"workflow": {"acme/widget": "ci.yml"}}), {"acme/widget": "ci.yml"})
        for bad in ("../ci.yml", ".github/workflows/ci.yml", "https://x/ci.yml", "ci", "ci.yml?x=1", "", 5, None, "ci.yml\n"):
            with self.assertRaises(ValueError, msg=repr(bad)):
                self.hs.workflows({"workflow": {"acme/widget": bad}})
        for bad in ({"workflow": []}, {"workflow": {"nope": "ci.yml"}}):
            with self.assertRaises(ValueError):
                self.hs.workflows(bad)
        with self.assertRaises(sb.ConfigError):
            sb.validate_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "reds": {"workflow": {"acme/widget": "../x.yml"}}})

    def test_a_run_with_no_workflow_id_says_workflow_unknown_and_never_lists_by_event_alone(self):
        self.fake.pr_run(["a::t"], no_workflow_id=True)
        self.fake.add_run("push", "main", ["a::t"], created=self.created(10), workflow="A")
        code, out = self.run_reds()
        self.assertEqual(code, 3, out)
        self.assertIn("names no workflow (workflow unknown): cannot classify", out)
        self.assertFalse([c for c in self.fake.calls if "actions/workflows/" in c or ("actions/runs?" in c and "head_sha" not in c)])

    def test_a_non_positive_workflow_id_is_unknown_and_a_foreign_workflow_run_in_a_listing_is_skipped(self):
        for bad in (0, -3, True):
            with self.subTest(bad=bad):
                self.fake = FakeActions()
                shutil.rmtree(str(self.state / "reds-cache"), ignore_errors=True)
                self.fake.pr_run(["a::t"])
                self.fake.runs["pull_request"][-1]["workflow_id"] = bad
                code, out = self.run_reds()
                self.assertEqual(code, 3, out)
                self.assertIn("workflow unknown", out)
        shutil.rmtree(str(self.state / "reds-cache"), ignore_errors=True)
        self.fake = FakeActions()
        self.fake.pr_run(["a::t"])
        own = self.fake.add_run("push", "main", ["a::t"], created=self.created(10), workflow="A")
        foreign = self.fake.add_run("push", "main", ["a::t"], created=self.created(5), workflow="A")
        for run in self.fake.runs["push"]:
            if run["id"] == foreign:
                run["workflow_id"] = 22   # a listing that hands back another workflow's run: skipped, defensively
        self.fake.leak_foreign = True
        code, out = self.run_reds()
        self.assertIn("main runs: 1 listed (workflow Workflow A), 1 usable, 0 unknown", out)

    def test_the_real_command_reads_through_the_real_reader_with_the_configured_events_and_exits_1_on_a_failed_read(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "gh": "gh", "reds": {"reference_events": {"acme/widget": ["merge_group", "schedule"]}}})
        self.fake.pr_run(["a::t", "b::u"])
        self.fake.add_run("merge_group", "gh-readonly-queue/main/pr-1-x", ["a::t"], created=self.created(10))
        self.fake.add_run("schedule", "main", ["b::u"], created=self.created(70))
        self.fake.add_run("push", "main", ["b::u"], created=self.created(5))   # a push run: not a reference event of this repo
        with captured() as (out, err):
            code = sb.main(["reds", "acme/widget#12"], runner=self.fake, now=self.now)
        self.assertEqual(code, 0, out.getvalue() + err.getvalue())
        self.assertIn("main runs: 2 listed (workflow Workflow A), 2 usable, 0 unknown", out.getvalue())
        self.assertIn("reference events: merge_group, schedule)", out.getvalue())
        self.assertTrue(any("event=merge_group" in c for c in self.fake.calls) and not any("event=push" in c for c in self.fake.calls))
        self.fake.fail_paths = {"actions/artifacts?name"}
        shutil.rmtree(str(sb.state_dir_path() / "reds-cache"), ignore_errors=True)
        with captured() as (out, err):
            code = sb.main(["reds", "acme/widget#12"], runner=self.fake, now=self.now)
        self.assertEqual(code, 1)
        self.assertIn("nothing was classified", out.getvalue())
        self.assertNotIn("also failing on main", out.getvalue())

    def test_an_oversized_or_unsized_artifact_is_refused_before_the_download_and_a_full_artifact_page_is_said(self):
        self.fake.pr_run(["a::t"])
        run = self.fake.add_run("push", "main", ["a::t"], created=self.created(10))
        self.fake.artifacts[run]["size_in_bytes"] = self.hs.ZIP_MAX + 1
        code, out = self.run_reds()
        self.assertIn("main runs: 1 listed (workflow Workflow A), 0 usable, 1 unknown; run %d: artifact too large" % run, out)
        self.assertFalse([c for c in self.fake.calls if c.endswith("/zip") and str(self.fake.artifacts[run]["id"]) in c], "never downloaded")
        del self.fake.artifacts[run]["size_in_bytes"]
        shutil.rmtree(str(self.state / "reds-cache"))
        code, out = self.run_reds()
        self.assertIn("artifact too large or of unknown size", out)
        # a full page: a run missing from it may be older than the page
        self.fake.artifacts.update({10_000 + n: {"id": 20_000 + n, "expired": False, "workflow_run": {"id": 10_000 + n}, "size_in_bytes": 10} for n in range(100)})
        missing = self.fake.add_run("push", "main", ["a::t"], created=self.created(5), artifact=False)
        shutil.rmtree(str(self.state / "reds-cache"))
        code, out = self.run_reds()
        self.assertIn("run %d: no artifact in the newest 100" % missing, out)

    def test_main_s_artifacts_are_capped_too_and_a_corrupt_cache_entry_is_a_miss(self):
        self.fake.pr_run(["n1"])
        self.main_runs([["n%d" % i for i in range(3000)]])
        code, out = self.run_reds()
        self.assertIn("n1 (1 of 1 main runs)", out)
        cached = sorted((self.state / "reds-cache" / "acme_widget").glob("*.json"))
        for path in cached:
            body = json.loads(path.read_text())
            self.assertLessEqual(len(body.get("failed", [])), self.hs.NAMES_MAX)
            path.write_text("{garbage")
        del self.fake.calls[:]
        code, out = self.run_reds()
        self.assertEqual(code, 0, "a corrupt cache entry is read again, not trusted")
        self.assertGreater(len(self.fake.calls), 4)

    def test_the_age_is_right_in_any_time_zone(self):
        stamp = calendar.timegm((2027, 1, 15, 8, 0, 0))
        for zone in ("UTC", "America/New_York", "Asia/Kolkata"):
            with mock.patch.dict(os.environ, {"TZ": zone}):
                time.tzset()
                self.assertEqual(self.hs._when("2027-01-15T07:00:00Z", stamp), 3600)
        time.tzset()

    def test_the_artifact_reader_is_bounded_and_strict(self):
        for raw in (b"x" * (self.hs.ZIP_MAX + 1), b"PK not really", ):
            with self.assertRaises(self.hs.RedsError):
                self.hs.read_zip(raw)
        with self.assertRaises(self.hs.RedsError):
            self.hs.read_zip("a text, not bytes")
        for body in ('{"v": 2, "complete": true, "failed": []}', '{"v": 1, "complete": "yes", "failed": []}', "[1]", "nope"):
            with self.assertRaises(self.hs.RedsError):
                self.hs.parse_artifact(body)

    def test_the_cache_is_private_bounded_and_remembers_a_missing_artifact_only_for_a_while(self):
        self.fake.pr_run(["a::t"])
        self.main_runs([["a::t"]])
        self.run_reds()
        files = list((self.state / "reds-cache" / "acme_widget").glob("*.json"))
        self.assertEqual(len(files), 2)
        self.assertEqual({f.stat().st_mode & 0o777 for f in files}, {0o600})
        cache = self.hs.Cache(self.state, "acme/widget", self.now)
        cache.put(5, {"unknown": "no artifact"})
        self.assertEqual(cache.get(5)["unknown"], "no artifact")
        self.clock[0] += self.hs.UNKNOWN_TTL + 1
        self.assertIsNone(cache.get(5), "a missing artifact is looked for again later")

    def test_the_config_key_is_validated_and_the_command_takes_only_owner_repo_n(self):
        self.assertEqual(self.hs.settings({"reference_events": {"acme/widget": ["merge_group", "schedule"]}}), {"acme/widget": ["merge_group", "schedule"]})
        for bad in (3, {"x": 1}, {"reference_events": []}, {"reference_events": {"nope": ["push"]}}, {"reference_events": {"a/b": []}},
                    {"reference_events": {"a/b": ["pushh"]}}, {"reference_events": {"a/b": ["push", "push"]}}):
            with self.assertRaises(ValueError):
                self.hs.settings(bad)
        with self.assertRaises(sb.ConfigError):
            sb.validate_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "reds": {"reference_events": {"a": ["push"]}}})
        with captured() as (out, err):
            self.assertEqual(sb.main(["reds", "no-hash"], runner=self.fake, now=self.now), sb.EXIT_USAGE)


class TestDockerReaper(Base):
    """The docker reaper (ask #321): only EXPIRED objects carrying both labels, dry run by default, one audit line per removal, no sudo."""

    NOW = 1_800_000_000

    def setUp(self):
        super().setUp()
        self.world = World(self, agents=("coder",), config={})
        self.docker_path = self.home / "docker"
        self.docker_path.write_text("#!/bin/sh\nexit 0\n")
        os.chmod(str(self.docker_path), 0o755)

    def world_docker(self):
        old, live = self.NOW - 100, self.NOW + 100
        return FakeDocker(
            containers=[("c_old", "exited", old, "agent-a"), ("c_live", "running", live, "agent-a"), ("c_none", "running", "", "")],
            networks=[("n_old", "", old, "agent-a"), ("n_live", "", live, "agent-b"), ("n_nolabel", "", "", "")],
            volumes=[("v_old", "", old, "agent-a"), ("v_mounted", "", old, "agent-a"), ("v_none", "", "", "")],
            running_mounts=["v_mounted"])

    def run_cli(self, docker, *argv):
        with captured() as (out, err):
            code = sb.main(["disk", "reap-docker", "--docker", str(self.docker_path), *argv], runner=docker, now=lambda: self.NOW)
        return code, out.getvalue(), err.getvalue()

    def audits(self):
        return [e for e in self.world.audit() if e["event"] == "docker.reaped"]

    def test_s4_only_the_expired_labelled_objects_are_removed(self):
        docker = self.world_docker()
        code, out, err = self.run_cli(docker, "--apply")
        self.assertEqual(code, 0, err)
        self.assertEqual(docker.removals(), [["rm", "-f", "--", hex_id("c_old")], ["network", "rm", "--", hex_id("n_old")], ["volume", "rm", "--", "v_old"]])
        self.assertIn("kept volume v_mounted: a running container mounts it", out)
        for argv in docker.removals():
            self.assertNotIn("-v", argv)
            self.assertNotIn("prune", argv)

    def test_s11_a_dry_run_removes_nothing_and_an_applied_run_audits_each_removal(self):
        docker = self.world_docker()
        code, out, err = self.run_cli(docker)
        self.assertEqual((code, docker.removals(), self.audits()), (0, [], []))
        self.assertIn("dry run", out)
        self.assertIn("container " + hex_id("c_old"), out)
        self.run_cli(docker, "--apply")
        entries = self.audits()
        self.assertEqual([(e["detail"]["kind"], e["subject"]) for e in entries], [("container", hex_id("c_old")), ("network", hex_id("n_old")), ("volume", "v_old")])
        self.assertEqual(entries[0]["detail"]["owner"], "agent-a")

    def test_s11_the_kill_switch_removes_nothing_even_with_apply(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "docker_reaper": False})
        docker = self.world_docker()
        code, out, err = self.run_cli(docker, "--apply")
        self.assertEqual((code, docker.calls), (sb.EXIT_USAGE, []))
        self.assertIn("docker_reaper is false", err)

    def test_s12_no_sudo_in_any_command(self):
        docker = self.world_docker()
        self.run_cli(docker, "--apply")
        self.run_cli(docker)
        self.assertEqual([c for c in docker.calls if any("sudo" in part for part in c)], [])

    def test_u1_a_machine_with_nothing_eligible_loses_nothing(self):
        docker = FakeDocker()
        code, out, err = self.run_cli(docker, "--apply")
        self.assertEqual((code, docker.removals()), (0, []))
        self.assertIn("removed: 0", out)

    def test_a_label_that_is_not_an_epoch_and_an_unlabelled_object_are_never_removed(self):
        docker = FakeDocker(containers=[("c1", "exited", "soon", "agent-a"), ("c2", "exited", "-5", "agent-a"), ("c3", "exited", self.NOW - 1, ""),
                                        ("c4", "exited", "1" * 20, "agent-a"), ("c5", "exited", "5", "agent-a")])   # c5: an expiry before 2001 is no plan
        self.run_cli(docker, "--apply")
        self.assertEqual(docker.removals(), [])

    def test_a_failed_listing_ends_the_run_before_anything_is_removed(self):
        docker = self.world_docker()
        real = docker.__call__

        def runner(argv, **kwargs):
            if argv[1:3] == ["volume", "ls"]:
                return subprocess.CompletedProcess(argv, 1, "", "daemon not running")   # the third listing fails: the first two were fine
            return real(argv, **kwargs)
        code, out, err = self.run_cli(runner, "--apply")
        self.assertEqual(code, sb.EXIT_ERROR)
        self.assertEqual(docker.removals(), [])
        self.assertIn("daemon not running", out)

    def test_a_removal_that_fails_is_said_and_not_audited_and_the_rest_go_on(self):
        docker = self.world_docker()
        docker.fail.add("c_old")
        code, out, err = self.run_cli(docker, "--apply")
        self.assertEqual(code, sb.EXIT_ERROR)
        self.assertEqual([e["subject"] for e in self.audits()], [hex_id("n_old"), "v_old"])
        self.assertIn("in use", out)

    def test_an_audit_that_fails_after_a_removal_is_an_error_and_the_rest_go_on(self):
        docker = self.world_docker()

        class Broken:
            def append(self, *a, **k):
                raise ValueError("audit full")
        result = sb.docker_reap("docker", docker, self.NOW, True, Broken())
        self.assertEqual(len(result["removed"]), 3, "all three were removed and counted")
        self.assertEqual(len(result["errors"]), 3)
        self.assertIn("audit of", result["errors"][0])

    def test_a_missing_docker_is_tried_again_in_an_hour_by_the_daemon(self):
        docker = self.world_docker()
        engine, source = self.daily(docker)
        engine.now = lambda: self.NOW
        with mock.patch.object(sb, "_docker_executable", lambda name: None):
            source()
            source.thread.join(10)
        self.assertEqual(docker.calls, [])
        stamp = json.loads((self.world.state / sb.DOCKER_REAP_FILE).read_text())["at"]
        self.assertEqual(stamp + sb.DOCKER_REAP_INTERVAL, self.NOW + sb.DOCKER_REAP_RETRY)

    def test_the_docker_option_runs_only_a_docker_binary_it_can_trust_in_every_disk_command(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        os.chmod(str(self.home), 0o755)
        for target in ("/bin/sh", "/bin/ls", "/usr/bin/env"):
            for argv in (["disk", "prune", "--dry-run", "--docker", target], ["disk", "reap-docker", "--docker", target], ["disk", "report", "--docker", target],
                         ["disk", "prune", "--dry-run", "--docker=" + target], ["disk", "--docker", target, "report"]):
                with self.subTest(argv=argv):
                    err, calls = io.StringIO(), []
                    with mock.patch.object(sys, "stderr", err), mock.patch.object(sys, "stdout", io.StringIO()) as out, \
                            mock.patch.object(subprocess, "run", side_effect=AssertionError("ran an executable that is not docker")):
                        code = sb.main(argv, runner=lambda a, **k: calls.append(a) or subprocess.CompletedProcess(a, 0, "", ""), now=self.world.clock.now)
                    self.assertIn("refused", err.getvalue() + out.getvalue())
                    self.assertFalse([c for c in calls if c and os.path.basename(str(c[0])) in ("sh", "ls", "env")], "nothing was run")
                    if argv[1] != "report" and argv[1] != "--docker":
                        self.assertEqual(code, sb.EXIT_USAGE)
        for abbreviated in ("--dock", "--doc", "--do"):                                          # an abbreviation of the option is not accepted
            err = io.StringIO()
            try:
                with mock.patch.object(sys, "stderr", err), mock.patch.object(sys, "stdout", io.StringIO()), \
                        mock.patch.object(subprocess, "run", side_effect=AssertionError("ran an executable")):
                    code = sb.main(["disk", "prune", abbreviated, "/bin/sh"], runner=FakePruneDocker(), now=self.world.clock.now)
            except SystemExit as stop:
                code = stop.code
            self.assertNotEqual(code, 0, abbreviated)
            self.assertIn("unrecognized arguments", err.getvalue(), abbreviated)
        good = self.home / "docker"
        good.write_text("#!/bin/sh\nexit 0\n")
        os.chmod(str(good), 0o755)
        good = str(good)
        self.assertEqual(sb._docker_problem(good), (os.path.realpath(good), None))
        dest = self.home / "real"
        dest.mkdir()
        (dest / "docker").write_text("#!/bin/sh\nexit 0\n")
        os.chmod(str(dest / "docker"), 0o755)
        sub = self.home / "viaLink"
        sub.mkdir()
        os.symlink(str(dest / "docker"), str(sub / "docker"))
        self.assertEqual(sb._docker_problem(str(sub / "docker")), (os.path.realpath(str(dest / "docker")), None), "a link named docker to a file named docker is fine")
        other = self.home / "tool"
        other.write_text("#!/bin/sh\nexit 0\n")
        os.chmod(str(other), 0o755)
        bad = self.home / "sub" / "docker"
        bad.parent.mkdir()
        os.symlink(str(other), str(bad))
        self.assertIn("not a docker binary", sb._docker_problem(str(bad))[1])        # a link named docker that points at another tool
        loose = self.home / "loose" / "docker"
        loose.parent.mkdir()
        loose.write_text("#!/bin/sh\nexit 0\n")
        os.chmod(str(loose), 0o775)
        self.assertIn("writable by group or other", sb._docker_problem(str(loose))[1])
        open_dir = self.home / "open" / "docker"
        open_dir.parent.mkdir()
        open_dir.write_text("#!/bin/sh\nexit 0\n")
        os.chmod(str(open_dir), 0o755)
        os.chmod(str(open_dir.parent), 0o777)
        self.assertIn("others can change", sb._docker_problem(str(open_dir))[1])
        os.chmod(str(open_dir.parent), 0o1777)
        self.assertEqual(sb._docker_problem(str(open_dir))[1], None, "a sticky directory is fine")
        # a standard install sits under a root-owned, group-writable ancestor (/Applications): fine; a group-writable ancestor of another owner is not
        real_stat, ancestor = os.stat, os.path.realpath(str(self.home.parent))

        def fake_stat(path, *a, **k):
            info = real_stat(path, *a, **k)
            if os.path.realpath(str(path)) == ancestor:
                return types.SimpleNamespace(st_mode=0o40775, st_uid=owner[0])
            return info

        owner = [0]
        with mock.patch.object(sb.os, "stat", fake_stat):
            self.assertEqual(sb._docker_problem(good)[1], None, "a root-owned group-writable ancestor is the operating system's own")
            owner[0] = os.getuid() + 1
            self.assertIn("others can change", sb._docker_problem(good)[1])
        plain = self.home / "plain" / "docker"
        plain.parent.mkdir()
        plain.write_text("#!/bin/sh\nexit 0\n")
        os.chmod(str(plain), 0o644)
        self.assertIn("not an executable file", sb._docker_problem(str(plain))[1])
        self.assertIn("not installed", sb._docker_problem("/nonexistent/docker")[1])
        self.assertIn("not a usable", sb._docker_problem("--help")[1])
        self.assertIn("not a docker binary", sb._docker_problem("/bin/sh")[1])
        for p in (str(self.home / "open"), str(self.home / "loose")):
            os.chmod(p, 0o755)

    def test_without_docker_it_refuses_and_runs_nothing(self):
        docker = self.world_docker()
        with captured() as (out, err):
            code = sb.main(["disk", "reap-docker", "--docker", "/nonexistent/docker", "--apply"], runner=docker, now=lambda: self.NOW)
        self.assertEqual((code, docker.calls), (sb.EXIT_USAGE, []))

    def test_a_hostile_owner_label_reaches_the_terminal_as_plain_text(self):
        docker = FakeDocker(containers=[("c1", "exited", self.NOW - 1, "\x1b[2Jevil\x9b31m")])
        code, out, err = self.run_cli(docker)
        self.assertEqual([c for c in out if (ord(c) < 32 and c != "\n") or 0x7f <= ord(c) <= 0x9f], [])
        self.assertIn("evil", out)

    def test_a_label_that_forges_a_listing_line_removes_nothing_it_does_not_own(self):
        victim = FakeDocker(containers=[("c_forger", "exited", self.NOW - 1, "x\n%s|exited|1|a" % hex_id("c_victim")), ("c_victim", "running", "", "")])
        self.run_cli(victim, "--apply")
        self.assertEqual([hex_id("c_victim") in c for c in victim.removals()], [False], "only the forger itself, which carries both labels")
        option = FakeDocker(volumes=[("-rf", "", self.NOW - 1, "agent-a"), ("ok", "", self.NOW - 1, "agent-a")])
        self.run_cli(option, "--apply")
        self.assertEqual(option.removals(), [["volume", "rm", "--", "ok"]], "a name that looks like an option is never passed")

    def test_the_labels_are_read_from_inspect_at_removal_time_not_from_the_listing(self):
        docker = FakeDocker(containers=[("c1", "exited", self.NOW - 1, "agent-a")])
        docker.labels_override["c1"] = {"fleet.owner": "agent-a", "fleet.expires": str(self.NOW + 500)}   # relabelled live
        self.run_cli(docker, "--apply")
        self.assertEqual(docker.removals(), [])

    def test_the_config_key_must_be_a_boolean(self):
        for bad in ("yes", None, 1, {}):
            with self.subTest(bad=bad):
                with self.assertRaises(sb.ConfigError):
                    sb.validate_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "docker_reaper": bad})

    # -- the daemon's daily run

    def daily(self, runner, config=None):
        engine = self.world.engine
        engine.config = dict(engine.config, **(config or {}))
        engine.docker_reap_runner = runner
        source = [src for src in engine.sources if getattr(src, "__name__", "") == "docker_reap_facts"][0]
        return engine, source

    def test_the_daemon_reaps_once_a_day_on_a_thread_and_a_restart_does_not_repeat_it(self):
        docker = self.world_docker()
        engine, source = self.daily(docker)
        engine.now = lambda: self.NOW
        with mock.patch.object(sb, "_docker_executable", lambda name: "docker"):
            self.assertEqual(source(), [])
            source.thread.join(10)
            self.assertEqual(len(docker.removals()), 3)
            self.assertEqual(len(self.audits()), 3)
            source(), (source.thread.join(10) if source.thread else None)
            self.assertEqual(len(docker.removals()), 3, "not again within a day")
            again = self.world.new_engine("daemon")
            again.docker_reap_runner = docker
            again.now = lambda: self.NOW + 60
            fresh = [src for src in again.sources if getattr(src, "__name__", "") == "docker_reap_facts"][0]
            fresh()
            self.assertIsNone(fresh.thread, "a restarted daemon reads docker-reap.json and does not run again")
            engine.now = lambda: self.NOW + sb.DOCKER_REAP_INTERVAL + 1
            source()
            source.thread.join(10)
            self.assertGreater(len(docker.calls), 9, "a day later it lists again")

    def test_a_failed_run_is_tried_again_in_an_hour_and_a_damaged_stamp_means_run(self):
        docker = self.world_docker()
        real = docker.__call__
        broken = [True]

        def runner(argv, **kwargs):
            if broken[0]:
                return subprocess.CompletedProcess(argv, 1, "", "daemon not running")
            return real(argv, **kwargs)
        engine, source = self.daily(runner)
        engine.now = lambda: self.NOW
        with mock.patch.object(sb, "_docker_executable", lambda name: "docker"):
            source()
            source.thread.join(10)
            self.assertEqual(docker.removals(), [])
            broken[0] = False
            engine.now = lambda: self.NOW + 1800
            source()
            source.thread.join(10)
            self.assertEqual(docker.removals(), [], "half an hour later: not yet")
            engine.now = lambda: self.NOW + sb.DOCKER_REAP_RETRY + 5
            source()
            source.thread.join(10)
            self.assertIn(["volume", "rm", "--", "v_old"], docker.removals(), "an hour later it ran (and by then the 100-second objects had expired too)")
            (self.world.state / sb.DOCKER_REAP_FILE).write_text("{garbage")
            self.assertIsNone(source._last(self.world.state))

    def test_an_engine_that_is_not_the_daemon_and_the_kill_switch_never_reap(self):
        docker = self.world_docker()
        engine, source = self.daily(None)
        engine.now = lambda: self.NOW
        source()
        self.assertEqual(docker.calls, [])
        engine, source = self.daily(docker, {"docker_reaper": False})
        with mock.patch.object(sb, "_docker_executable", lambda name: "docker"):
            source()
        self.assertEqual(docker.calls, [])
        self.assertIsNone(source.thread)


class TestJanitorLiveKeeps(Base):
    """Ask #932: the janitor keeps what a live agent owns, uses or touched (the registry, the access time, a file a live process holds open), and every doubt
    keeps. Fixture directories and fakes for the registry, the clock and the open-file check only: the real temp directory is never read. Each entry here is one
    the old rule (modification and change time only) would have removed."""

    def setUp(self):
        super().setUp()
        self.world = World(self, agents=("coder",), config={})
        self.jan = sb.load_disk_janitor()
        self.temp = self.home / "jtmp"
        self.temp.mkdir()
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "temp_janitor": {"dir": str(self.temp)}})
        self.world.clock.t = time.time() + 10 * 86400   # a change time cannot be set back: the clock moves forward instead
        self.now = self.world.clock.now()
        (self.world.state / "state-marker.json").write_text("{}")
        self.open_paths = []
        self.open_timeouts = []
        self.lsof_code = 0
        self.lsof_error = None
        self.world.add_agent("cos", fleet={"role": "chief-of-staff"})
        os.environ["HERDR_PANE_ID"] = self.world.panes["cos"]

    def routed(self, argv, **kwargs):
        if argv[0] == "lsof":
            if "-d" in argv:
                return subprocess.CompletedProcess(argv, 0, "p1\nfcwd\nn/\n", "")
            self.open_timeouts.append(kwargs.get("timeout"))
            if self.lsof_error:
                raise self.lsof_error
            if self.lsof_code:
                return subprocess.CompletedProcess(argv, self.lsof_code, "", "")
            return subprocess.CompletedProcess(argv, 0, "p1\n" + "".join("fx\nn%s\n" % p for p in self.open_paths), "")
        return self.world.route(argv, **kwargs)

    def old(self, name, days=10, directory=False, atime_days=None):
        path = self.temp / name
        if directory:
            path.mkdir()
            (path / "inner.txt").write_text("x")
        else:
            path.write_text("x")
        stamp = self.now - days * 86400
        read = self.now - (days if atime_days is None else atime_days) * 86400
        for p in ([path / "inner.txt"] if directory else []) + [path]:
            os.utime(str(p), (read, stamp))
        return path

    def apply(self):
        with captured() as (out, err):
            code = sb.main(janitor_review(self, ["--apply"]), runner=self.routed, now=self.world.clock.now, socket_call=self.world.herdr.socket)
        self.assertEqual(code, 0, err.getvalue())
        return out.getvalue()

    def registry(self, agents=None, retired=None):
        (self.world.state / sb.PANE_HEALTH_FILE).write_text(json.dumps({"agents": agents or {}, "states": {}, "missing": {}}))
        (self.world.state / sb.RETIRED_FILE).write_text(json.dumps(retired or {}))

    def test_s1_an_entry_a_live_or_recently_retired_agent_owns_is_kept(self):
        tmpdir = self.old("live", directory=True)              # the agent's own TMPDIR
        holds = self.old("holds-a-cwd", directory=True)                # it contains the agent's working directory
        (holds / "work").mkdir()
        recent = self.old("retired-recently", directory=True)          # a retired agent's working directory, retired 2 days ago
        stale = self.old("retired-long-ago", directory=True)           # retired 20 days ago: the registry no longer holds it
        self.registry({"live": {"cwd": str(holds / "work"), "session": "ses_a"}},
                      {"gone": {"at": self.now - 2 * 86400, "session": "ses_b", "record": {"cwd": str(recent)}},
                       "older": {"at": self.now - 20 * 86400, "session": "ses_c", "record": {"cwd": str(stale)}}})
        with mock.patch.object(sb, "agent_tmp_root", lambda config: self.temp):
            out = self.apply()
        for kept in (tmpdir, holds, recent):
            self.assertTrue(kept.exists(), kept.name)
        names = [n for n, _ in sb.janitor_agent_roots(self.world.engine, self.now, 7)]
        self.assertIn("gone", names)
        self.assertNotIn("older", names, "retired past the janitor's own day limit: no longer held by the registry")
        self.assertIn("kept live: it is, holds or sits inside", out)
        # an entry that sits INSIDE an agent's directory
        inside = self.old("sits-inside", directory=True)
        self.registry({"live": {"cwd": str(self.temp), "session": "ses_a"}})
        self.apply()
        self.assertTrue(inside.exists())

    def test_s1_the_one_function_is_the_only_reader_of_the_agent_list(self):
        entry = self.old("owned-by-the-fake", directory=True)
        seen = []

        def fake(engine, now, days):
            seen.append(days)
            return [("fake-agent", str(entry))]
        with mock.patch.object(sb, "janitor_agent_roots", fake):
            self.apply()
        self.assertTrue(entry.exists())
        self.assertEqual(seen[0], 7)

    def test_s2_a_read_keeps_an_entry_and_a_clock_decides(self):
        read = self.old("read-yesterday.log", atime_days=1)
        untouched = self.old("untouched.log")
        self.apply()
        self.assertTrue(read.exists(), "10 days by modification, 1 day by access")
        self.assertFalse(untouched.exists())
        directory = self.old("dir-read-yesterday", directory=True, atime_days=1)
        self.apply()
        self.assertTrue(directory.exists(), "a file read inside a directory keeps the directory")

    def test_s2_a_directorys_own_access_time_is_not_counted(self):
        plain = self.old("listed-only", directory=True)
        os.utime(str(plain), (self.now, self.now - 10 * 86400))   # only the directory's own access time is new (listing it does that)
        (plain / "inner.txt").touch()
        os.utime(str(plain / "inner.txt"), (self.now - 10 * 86400,) * 2)
        self.apply()
        self.assertFalse(plain.exists())

    def test_s3_a_file_a_live_process_has_open_keeps_its_entry(self):
        held = self.old("held-open", directory=True)
        free = self.old("not-open", directory=True)
        self.open_paths = [str(held / "inner.txt"), "/somewhere/else"]
        out = self.apply()
        self.assertTrue(held.exists())
        self.assertFalse(free.exists())
        self.assertIn("kept held-open: a live process has a file of it open", out)

    def test_s7_every_doubt_keeps_and_the_pass_ends_in_time(self):
        unreadable_registry = self.old("registry-doubt", directory=True)
        (self.world.state / sb.PANE_HEALTH_FILE).write_text("{not json")
        out = self.apply()
        self.assertTrue(unreadable_registry.exists())
        self.assertIn("pane-health.json cannot be read", out)
        self.registry()
        atime = self.old("atime-doubt")
        with mock.patch.object(self.jan, "_atime", side_effect=OSError("no atime")):
            self.apply()
        self.assertTrue(atime.exists())
        timeout = self.old("open-check-timeout", directory=True)
        self.lsof_error = subprocess.TimeoutExpired(["lsof"], 30)
        out = self.apply()
        self.assertTrue(timeout.exists())
        self.assertIn("did not finish", out)
        self.lsof_error = None
        self.apply()
        self.assertFalse(timeout.exists(), "with every source readable and nothing holding it, the same entry goes")

    def test_s7_a_registry_that_raises_anything_keeps_the_entry(self):
        entry = self.old("registry-raises", directory=True)
        with mock.patch.object(sb, "janitor_agent_roots", side_effect=RuntimeError("boom")):
            out = self.apply()
        self.assertTrue(entry.exists())
        self.assertIn("agent registry cannot be read", out)

    def test_s7_the_open_file_check_is_bounded_and_every_failure_of_it_keeps(self):
        entry = self.old("open-check-fails", directory=True)
        self.lsof_code = 2
        out = self.apply()
        self.assertTrue(entry.exists())
        self.assertIn("the open-file check failed", out)
        self.assertEqual(set(self.open_timeouts), {sb.JANITOR_OPEN_SECONDS})
        self.lsof_code = 0
        with mock.patch.object(sb, "JANITOR_OPEN_SECONDS", -1):   # the resolving of the list is bounded too
            self.open_paths = ["/x"]
            out = self.apply()
        self.assertTrue(entry.exists())
        self.assertIn("resolving the open-file list took longer", out)

    def test_s7_an_access_time_that_cannot_be_read_inside_a_directory_keeps_it(self):
        entry = self.old("inner-atime-doubt", directory=True)
        real = self.jan._atime
        with mock.patch.object(self.jan, "_atime", lambda info: (_ for _ in ()).throw(OSError("x")) if info.st_size == 1 and info.st_mode & 0o100000 else real(info)):
            self.apply()
        self.assertTrue(entry.exists())

    def test_s7_a_retired_entry_with_a_time_that_cannot_be_read_counts_as_recent(self):
        self.registry({}, {"odd": {"at": "yesterday", "session": "ses_x", "record": {"cwd": str(self.temp / "odd-cwd")}}})
        self.assertIn("odd", [n for n, _ in sb.janitor_agent_roots(self.world.engine, self.now, 7)])

    def test_s4_the_records_in_doubt_are_read_as_doubt(self):
        for text in ("{" , json.dumps({"rule": ["not", "scalar"]}), json.dumps({"rule": "x" * 5000})):
            (self.world.state / sb.TEMP_JANITOR_GATE_FILE).write_text(text)
            self.assertEqual(sb.read_janitor_record(self.world.state, sb.TEMP_JANITOR_GATE_FILE), (False, {}))
        self.assertEqual(sb.janitor_apply_allowed(self.world.state, "r")[1], "unreadable")

    def test_a_links_own_access_time_is_not_a_read(self):
        link = self.temp / "old-link"
        os.symlink(str(self.home), str(link))
        os.utime(str(link), (self.now, self.now - 10 * 86400), follow_symlinks=False)   # only the link's access time is new
        self.apply()
        self.assertFalse(os.path.lexists(str(link)))

    def test_the_fingerprint_covers_every_setting_that_changes_what_is_selected(self):
        keys = set(self.jan.DEFAULTS)
        self.assertEqual(keys, set(self.jan.SELECTION_KEYS) | set(self.jan.OTHER_KEYS), "every setting is classified as selecting or not")
        self.assertFalse(set(self.jan.SELECTION_KEYS) & set(self.jan.OTHER_KEYS))
        base = {"days": 7, "keep": [], "dir": str(self.temp)}
        other = {"days": 8, "keep": ["x"], "dir": str(self.home)}
        for key in self.jan.SELECTION_KEYS:
            with self.subTest(key=key):
                self.assertNotEqual(self.jan.rule_fingerprint(base), self.jan.rule_fingerprint(dict(base, **{key: other[key]})))
        for key in self.jan.OTHER_KEYS:
            with self.subTest(key=key):
                self.assertEqual(self.jan.rule_fingerprint(base), self.jan.rule_fingerprint(dict(base, **{key: 123})))

    def test_each_of_is_contains_and_sits_inside_keeps_on_its_own(self):
        entry = self.old("the-entry", directory=True)
        (entry / "work").mkdir()
        for label, root in (("is", entry), ("contains", entry / "work"), ("sits inside", self.temp)):
            with self.subTest(label), mock.patch.object(sb, "janitor_agent_roots", lambda e, n, d, root=root: [("fake", str(root))]):
                self.assertTrue(sb.janitor_busy_function(self.world.engine, self.routed, self.jan)(str(entry)), label)
        with mock.patch.object(sb, "janitor_agent_roots", lambda e, n, d: [("fake", str(self.home / "elsewhere"))]):
            self.assertIsNone(sb.janitor_busy_function(self.world.engine, self.routed, self.jan)(str(entry)))

    def test_a_process_working_in_an_entry_and_a_file_open_in_it_each_keep_it_on_their_own(self):
        entry = self.old("the-entry", directory=True)
        busy_for = lambda: sb.janitor_busy_function(self.world.engine, self.routed, self.jan)
        with mock.patch.object(sb, "janitor_agent_roots", lambda e, n, d: []):
            self.assertIsNone(busy_for()(str(entry)))
            self.open_paths = [str(entry)]
            self.assertIn("file of it open", busy_for()(str(entry)))
            self.open_paths = [str(entry).upper()]   # a case-insensitive volume may spell it otherwise
            self.assertIn("file of it open", busy_for()(str(entry)))
            self.open_paths = []
            real = self.routed
            cwd = lambda argv, **kw: subprocess.CompletedProcess(argv, 0, "p1\nfcwd\nn%s\n" % entry, "") if "-d" in argv else real(argv, **kw)
            self.assertIn("working directory", sb.janitor_busy_function(self.world.engine, cwd, self.jan)(str(entry)))
            upper = lambda argv, **kw: subprocess.CompletedProcess(argv, 0, "p1\nfcwd\nn%s\n" % str(entry).upper(), "") if "-d" in argv else real(argv, **kw)
            self.assertIn("working directory", sb.janitor_busy_function(self.world.engine, upper, self.jan)(str(entry)))

    def test_s7_a_retired_list_that_cannot_be_read_keeps_everything(self):
        entry = self.old("retired-doubt", directory=True)
        (self.world.state / sb.PANE_HEALTH_FILE).write_text(json.dumps({"agents": {}, "states": {}, "missing": {}}))
        (self.world.state / "registry.json").write_text("[1, 2")   # the registry is the one source of retirements (#929); retired.json is derived and never read
        out = self.apply()
        self.assertTrue(entry.exists())
        self.assertIn("cannot read the agent registry", out)

    def test_u1_an_entry_nothing_owns_uses_or_touched_is_removed_as_before(self):
        gone = [self.old("old-%d.log" % n) for n in range(2)] + [self.old("old-dir", directory=True)]
        self.registry({"live": {"cwd": str(self.home / "elsewhere")}})
        self.apply()
        self.assertEqual([p.exists() for p in gone], [False, False, False])

    def test_the_janitors_own_preview_does_not_keep_the_entries_it_lists(self):
        listed = self.old("listed-in-the-preview.log")
        other = self.old("named-by-another-event.log")
        lines = [{"event": "janitor.would_remove", "detail": {"names": ["listed-in-the-preview.log"]}},
                 {"event": "temp.removed", "subject": "listed-in-the-preview.log"},
                 {"event": "launched", "subject": "coder", "detail": {"note": "see named-by-another-event.log"}}]
        (self.world.state / "audit.jsonl").write_text("".join(json.dumps(l) + "\n" for l in lines))
        self.apply()
        self.assertFalse(listed.exists())
        self.assertTrue(other.exists(), "a record by anything else still names it")

    def test_the_rule_fingerprint_follows_the_rule_and_never_a_name(self):
        base = self.jan.rule_fingerprint({"days": 7, "keep": ["a"]})
        self.assertNotEqual(base, self.jan.rule_fingerprint({"days": 7, "keep": ["a"], "dir": "/x/y"}), "another directory is another rule")
        self.assertNotEqual(base, self.jan.rule_fingerprint({"days": 8, "keep": ["a"]}))
        self.assertNotEqual(base, self.jan.rule_fingerprint({"days": 7, "keep": ["b"]}))
        with mock.patch.object(self.jan, "RULE_VERSION", "3"):
            self.assertNotEqual(base, self.jan.rule_fingerprint({"days": 7, "keep": ["a"]}))
        self.assertNotEqual(self.jan.preview_fingerprint(base, ["a"]), self.jan.preview_fingerprint(base, ["b"]))


class TestDaemonTempJanitor(Base):
    """Ask #762: the daemon applies the weekly temp janitor itself (the Docker reaper's path), on the janitor's own rule, dry until `daemon_apply` is on.
    Fixture directories and fakes only: the real temp directory is never read or written."""

    def setUp(self):
        super().setUp()
        self.world = World(self, agents=("coder",), config={})
        self.jan = sb.load_disk_janitor()
        self.temp = self.home / "jtmp"
        self.temp.mkdir()
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "temp_janitor": {"dir": str(self.temp), "keep": ["keepme-*"]}})
        self.world.clock.t = time.time() + 10 * 86400
        self.now = self.world.clock.now()
        (self.world.state / "state-marker.json").write_text("{}")
        self.calls = []
        self.world.add_agent("cos", fleet={"role": "chief-of-staff"})

    def routed(self, argv, **kwargs):
        self.calls.append(list(argv))
        if argv[0] == "lsof":
            return subprocess.CompletedProcess(argv, 0, "p1\nfcwd\nn/\n", "")
        return self.world.route(argv, **kwargs)

    def old(self, name, days=10, directory=False):
        path = self.temp / name
        if directory:
            path.mkdir()
            (path / "inner.txt").write_text("x")
        else:
            path.write_text("x")
        stamp = self.now - days * 86400
        for p in ([path / "inner.txt"] if directory else []) + [path]:
            os.utime(str(p), (stamp, stamp))
        return path

    def fixture(self):
        gone = self.old("scratch-old-unnamed.log")
        named = self.old("named-by-the-records.txt")
        (self.world.state / "reminders.json").write_text(json.dumps({"r": "see named-by-the-records.txt"}))
        marked = self.old("marked-dir", directory=True)
        (marked / ".fleet-keep").write_text("")
        link = self.temp / "a-link-to-elsewhere"
        elsewhere = self.home / "elsewhere"
        elsewhere.mkdir()
        os.symlink(str(elsewhere), str(link))
        os.utime(str(link), (self.now - 10 * 86400,) * 2, follow_symlinks=False)
        return gone, [named, marked, self.old("recent.txt", days=1), elsewhere]

    def ack(self, cfg):
        """The preview was sent and the yes recorded, for the rule `cfg` makes (the state a daemon that has been cleared is in)."""
        rule = self.jan.rule_fingerprint(self.jan.settings(cfg))
        (self.world.state / sb.TEMP_JANITOR_GATE_FILE).write_text(json.dumps({"rule": rule, "preview": "p" * 16, "sent": True, "count": 0, "nonce": "n1"}))
        (self.world.state / sb.TEMP_JANITOR_ACK_FILE).write_text(json.dumps({"rule": rule, "preview": "p" * 16, "nonce": "n1", "by": "cos", "at": 1}))

    def daemon(self, temp_janitor=None, runner=True, acked=True):
        engine = self.world.engine
        cfg = {"dir": str(self.temp), "keep": ["keepme-*"]}
        cfg.update(temp_janitor or {})
        if acked and cfg.get("daemon_apply"):
            self.ack(cfg)
        engine.config = dict(engine.config, temp_janitor=cfg)
        engine.temp_janitor_runner = self.routed if runner else None
        engine.now = lambda: self.now
        source = [s for s in engine.sources if getattr(s, "__name__", "") == "temp_janitor_facts"][0]
        return engine, source

    def go(self, source):
        source()
        if source.thread:
            source.thread.join(20)

    def events(self, name):
        return [e for e in self.world.audit() if e["event"] == name]

    def test_s1_s2_the_daemon_applies_only_the_dry_runs_selection(self):
        gone, kept = self.fixture()
        engine, source = self.daemon({"daemon_apply": True})
        before = self.jan.scan(self.temp, self.world.state, self.now, self.jan.settings({"keep": ["keepme-*"]}), busy=lambda p: None)
        listed = sorted(r["name"] for r in before if r["action"] == "remove")
        self.assertEqual(listed, ["a-link-to-elsewhere", "scratch-old-unnamed.log"])
        self.go(source)
        self.assertFalse(gone.exists())
        self.assertFalse(os.path.lexists(str(self.temp / "a-link-to-elsewhere")), "a link is removed as a link")
        for path in kept:
            self.assertTrue(path.exists(), path.name)
        self.assertEqual(sorted(e["subject"] for e in self.events("temp.removed")), listed, "the names the daemon removed are the dry run's")

    def test_s5_one_summary_with_count_bytes_names_only_and_the_budget(self):
        self.old("a-old-one.txt")
        self.old("b-old-two.txt")
        engine, source = self.daemon({"daemon_apply": True, "weekly_scan_seconds": 300})
        self.go(source)
        self.assertEqual(len(self.events("temp.removed")), 2)
        summary = self.events("janitor.summary")
        self.assertEqual(len(summary), 1)
        detail = summary[0]["detail"]
        self.assertEqual((detail["count"], detail["bytes"], detail["names"], detail["budget_seconds"]), (2, 2, ["a-old-one.txt", "b-old-two.txt"], 300))
        self.assertIn("used_seconds", detail)
        self.assertNotIn(str(self.temp), json.dumps(detail["names"]))

    def test_s7_the_default_is_a_dry_run_audited_with_the_list_and_nothing_moves(self):
        gone, kept = self.fixture()
        engine, source = self.daemon()
        self.go(source)
        self.assertTrue(gone.exists())
        self.assertEqual(self.events("temp.removed"), [])
        self.assertEqual(self.events("janitor.summary"), [])
        dry = self.events("janitor.would_remove")
        self.assertEqual(len(dry), 1)
        self.assertEqual(dry[0]["detail"]["names"], ["a-link-to-elsewhere", "scratch-old-unnamed.log"])
        self.assertFalse((self.world.state / self.jan.CURSOR_FILE).exists(), "a dry run does not move the cursor")

    def test_s8_the_switch_is_a_boolean(self):
        with self.assertRaises(ValueError):
            self.jan.validate({"daemon_apply": "yes"})
        self.assertIsNone(self.jan.validate({"daemon_apply": True}))
        self.assertIs(self.jan.settings(None)["daemon_apply"], False)

    def test_s3_the_command_line_still_refuses_an_agent_and_an_unknown_caller(self):
        victim = self.old("old-file.txt")
        engine, source = self.daemon({"daemon_apply": True})   # the switch does not open the command line
        for who in ("coder", None):
            if who:
                os.environ["HERDR_PANE_ID"] = self.world.panes[who]
            else:
                os.environ["HERDR_PANE_ID"] = "p_unknown_pane"
            with captured() as (out, err):
                code = sb.main(janitor_review(self, ["--apply"]), runner=self.routed, now=self.world.clock.now, socket_call=self.world.herdr.socket)
            self.assertEqual(code, 1)
            self.assertIn("only the operator or the Chief of Staff may --apply the temp janitor", err.getvalue())
            self.assertTrue(victim.exists())

    def test_s4_an_engine_that_is_not_the_daemon_never_runs_whatever_the_environment_holds(self):
        victim = self.old("old-file.txt")
        engine, source = self.daemon({"daemon_apply": True}, runner=False)
        with mock.patch.dict(os.environ, {"FLEET_TEMP_JANITOR_APPLY": "1", "FLEET_DAEMON": "1", "TEMP_JANITOR_DAEMON_APPLY": "true"}):
            self.go(source)
        self.assertTrue(victim.exists())
        self.assertIsNone(source.thread)
        self.assertEqual([e for e in self.world.audit() if e["event"].startswith(("temp.", "janitor."))], [])
        self.assertEqual(self.calls, [])

    def test_the_kill_switch_runs_nothing(self):
        victim = self.old("old-file.txt")
        engine, source = self.daemon({"daemon_apply": True, "enabled": False})
        self.go(source)
        self.assertTrue(victim.exists())
        self.assertIsNone(source.thread)

    def test_s6_every_doubt_keeps_the_entry_and_says_so(self):
        # an unreadable state file: the janitor judges nothing
        victim = self.old("old-file.txt")
        (self.world.state / "broken.json").write_text("x")
        os.chmod(str(self.world.state / "broken.json"), 0)
        self.addCleanup(os.chmod, str(self.world.state / "broken.json"), 0o600)
        engine, source = self.daemon({"daemon_apply": True})
        self.go(source)
        self.assertTrue(victim.exists())
        self.assertEqual(self.events("temp.removed"), [])
        self.assertTrue(any("not be read" in n or "not judged" in n or "nothing was judged" in n for n in self.events("janitor.summary")[0]["detail"]["notes"]))

    def test_s6_a_scan_over_the_budget_and_an_entry_changed_after_the_scan_are_kept(self):
        a, b = self.old("a-old.txt"), self.old("b-old.txt")
        ticks = [0.0]

        def clock():
            ticks[0] += 100.0
            return ticks[0]
        real_run = self.jan.run
        engine, source = self.daemon({"daemon_apply": True, "weekly_scan_seconds": 150, "scan_seconds": 86400})
        with mock.patch.object(self.jan, "run", lambda *a_, **k: real_run(*a_, clock=clock, **k)):
            self.go(source)
        self.assertEqual([a.exists(), b.exists()].count(False), 1, "exactly one entry was reached; the one the budget did not reach is never removed")
        self.assertTrue(any("not judged" in n for n in self.events("janitor.summary")[0]["detail"]["notes"]))
        # changed between the scan and the removal: the second judgement of the same entry sees a newer file
        for path in self.temp.iterdir():
            path.unlink()
        c = self.old("c-old.txt")
        real, seen = self.jan.judge, [0]

        def judge(path, *args, **kwargs):
            seen[0] += 1
            if seen[0] == 2:
                os.utime(str(c), (self.now, self.now))
            return real(path, *args, **kwargs)
        (self.world.state / sb.TEMP_JANITOR_FILE).unlink()
        before = len(self.events("temp.removed"))
        engine, source = self.daemon({"daemon_apply": True})
        with mock.patch.object(self.jan, "judge", judge):
            self.go(source)
        self.assertGreaterEqual(seen[0], 2)
        self.assertTrue(c.exists())
        self.assertEqual(len(self.events("temp.removed")), before)

    def test_s9_the_weekly_gate(self):
        victim = self.old("old-file.txt")
        stamp = self.world.state / sb.TEMP_JANITOR_FILE
        engine, source = self.daemon({"daemon_apply": False})
        stamp.write_text(json.dumps({"at": self.now - 2 * 86400}))
        self.go(source)
        self.assertEqual(self.events("janitor.would_remove"), [], "2 days ago: not yet")
        stamp.write_text(json.dumps({"at": self.now - 6 * 86400 - 60}))
        self.go(source)
        self.assertEqual(len(self.events("janitor.would_remove")), 1)
        self.assertEqual(json.loads(stamp.read_text())["at"], self.now)
        self.go(source)
        self.assertEqual(len(self.events("janitor.would_remove")), 1, "never twice within 6 days")
        stamp.write_text("{garbage")
        engine.now = lambda: self.now + 30 * 86400
        self.go(source)
        self.assertEqual(len(self.events("janitor.would_remove")), 1, "a stamp that cannot be read means do not run")
        self.assertEqual(len(self.events("janitor.state_unreadable")), 1)
        self.assertTrue(victim.exists())
        stamp.write_text(json.dumps({"at": 0}))   # a stamp that cannot be read (permission) is the same doubt
        os.chmod(str(stamp), 0)
        self.addCleanup(os.chmod, str(stamp), 0o600)
        self.go(source)
        self.assertEqual(len(self.events("janitor.would_remove")), 1)

    # -- ask #932: a changed selection rule makes one preview and applies nothing until the yes to that exact preview is recorded

    def preview_facts(self, engine, source):
        engine.discover(self.now)
        return [f for f in source() if f.kind == "janitor"]

    def week(self, engine):
        self.now += 7 * 86400
        engine.now = lambda: self.now

    def record_ack(self, preview):
        os.environ["HERDR_PANE_ID"] = self.world.panes["cos"]
        with captured() as (out, err):
            code = sb.main(["disk", "janitor-ack", preview], runner=self.routed, now=self.world.clock.now, socket_call=self.world.herdr.socket)
        return code, err.getvalue()

    def test_958_the_commands_fingerprint_equals_the_daemons_preview_for_the_same_rule_and_names(self):
        self.old("scratch-old-unnamed.log")
        engine, source = self.daemon({"daemon_apply": True}, acked=False)
        self.go(source)
        preview = json.loads((self.world.state / sb.TEMP_JANITOR_GATE_FILE).read_text())["preview"]
        os.environ["HERDR_PANE_ID"] = self.world.panes["cos"]
        with captured() as (out, err):
            sb.main(["disk", "janitor", "--weekly"], runner=self.routed, now=self.world.clock.now, socket_call=self.world.herdr.socket)
        self.assertIn("preview fingerprint: %s" % preview, out.getvalue())

    def test_s4_one_preview_then_nothing_is_applied_until_the_yes_to_that_exact_preview(self):
        victim = self.old("scratch-old-unnamed.log")
        engine, source = self.daemon({"daemon_apply": True}, acked=False)
        self.go(source)
        self.assertTrue(victim.exists(), "no yes: nothing is removed")
        self.assertEqual(self.events("temp.removed"), [])
        facts = self.preview_facts(engine, source)
        self.assertEqual(len(facts), 1, "ONE preview message")
        self.assertEqual(facts[0].recipient, "cos")
        preview = json.loads((self.world.state / sb.TEMP_JANITOR_GATE_FILE).read_text())["preview"]
        self.assertIn("scratch-old-unnamed.log", facts[0].summary)
        self.assertIn("janitor-ack %s" % preview, facts[0].summary)
        # a week later: still no yes, still no second message, still nothing removed
        self.week(engine)
        self.go(source)
        self.assertEqual(self.preview_facts(engine, source), [])
        self.assertTrue(victim.exists())
        self.assertEqual(self.events("temp.removed"), [])
        # a yes for an older preview is refused and records nothing
        code, err = self.record_ack("0" * 16)
        self.assertEqual(code, 1)
        self.assertIn("no pending temp janitor preview", err)
        self.assertFalse((self.world.state / sb.TEMP_JANITOR_ACK_FILE).exists())
        self.week(engine)
        self.go(source)
        self.assertTrue(victim.exists())
        # the yes to the exact preview: the next weekly run applies
        code, err = self.record_ack(preview)
        self.assertEqual(code, 0, err)
        self.assertEqual(len(self.events("janitor.ack")), 1)
        self.week(engine)
        self.go(source)
        self.assertFalse(victim.exists())
        self.assertEqual([e["subject"] for e in self.events("temp.removed")], ["scratch-old-unnamed.log"])

    def test_s4_a_changed_rule_needs_a_new_preview_and_a_new_yes(self):
        engine, source = self.daemon({"daemon_apply": True}, acked=False)
        self.old("first-old.log")
        self.go(source)
        self.preview_facts(engine, source)
        first = json.loads((self.world.state / sb.TEMP_JANITOR_GATE_FILE).read_text())["preview"]
        self.assertEqual(self.record_ack(first)[0], 0)
        second_victim = self.old("second-old.log")
        engine, source = self.daemon({"daemon_apply": True, "days": 8}, acked=False)   # the rule changed: days 7 -> 8
        self.week(engine)
        self.go(source)
        self.assertTrue(second_victim.exists(), "the yes was for the old rule")
        self.assertEqual(self.events("temp.removed"), [])
        facts = self.preview_facts(engine, source)
        self.assertEqual(len(facts), 1, "a new preview")
        newest = json.loads((self.world.state / sb.TEMP_JANITOR_GATE_FILE).read_text())["preview"]
        self.assertNotEqual(first, newest)
        self.week(engine)
        self.go(source)
        self.assertTrue(second_victim.exists(), "the old yes does not carry over")
        self.assertEqual(self.record_ack(newest)[0], 0)
        self.week(engine)
        self.go(source)
        self.assertFalse(second_victim.exists())

    def test_s4_a_record_in_doubt_applies_nothing(self):
        victim = self.old("scratch-old-unnamed.log")
        engine, source = self.daemon({"daemon_apply": True}, acked=True)
        (self.world.state / sb.TEMP_JANITOR_ACK_FILE).write_text("{broken")
        self.go(source)
        self.assertTrue(victim.exists())
        self.assertEqual(self.events("janitor.would_remove")[0]["detail"]["gate"], "unreadable")

    def test_s4_a_yes_recorded_under_another_rule_applies_nothing(self):
        victim = self.old("scratch-old-unnamed.log")
        engine, source = self.daemon({"daemon_apply": True}, acked=True)
        ack = self.world.state / sb.TEMP_JANITOR_ACK_FILE
        ack.write_text(json.dumps(dict(json.loads(ack.read_text()), rule="another-rule")))
        self.go(source)
        self.assertTrue(victim.exists())

    def test_s4_an_ordinary_agent_and_an_unknown_caller_cannot_record_the_yes(self):
        self.old("scratch-old-unnamed.log")
        engine, source = self.daemon({"daemon_apply": True}, acked=False)
        self.go(source)
        self.preview_facts(engine, source)
        preview = json.loads((self.world.state / sb.TEMP_JANITOR_GATE_FILE).read_text())["preview"]
        for pane in (self.world.panes["coder"], "p_unknown_pane"):
            os.environ["HERDR_PANE_ID"] = pane
            with captured() as (out, err):
                code = sb.main(["disk", "janitor-ack", preview], runner=self.routed, now=self.world.clock.now, socket_call=self.world.herdr.socket)
            self.assertEqual(code, 1)
            self.assertIn("only the operator or the Chief of Staff", err.getvalue())
            self.assertFalse((self.world.state / sb.TEMP_JANITOR_ACK_FILE).exists())

    def test_s4_with_no_chief_of_staff_running_the_preview_waits_and_is_then_sent_once(self):
        self.old("scratch-old-unnamed.log")
        engine, source = self.daemon({"daemon_apply": True}, acked=False)
        self.go(source)
        found = engine.discover(self.now)
        with mock.patch.object(engine, "discovery", type("D", (), {"agents": {}, "problems": []})()):
            self.assertEqual([f for f in source() if f.kind == "janitor"], [])
        self.assertFalse(json.loads((self.world.state / sb.TEMP_JANITOR_GATE_FILE).read_text())["sent"])
        self.assertEqual(len(self.preview_facts(engine, source)), 1)
        self.assertTrue(json.loads((self.world.state / sb.TEMP_JANITOR_GATE_FILE).read_text())["sent"])

    def test_s4_a_gate_that_moved_before_delivery_sends_nothing_stale(self):
        self.old("scratch-old-unnamed.log")
        engine, source = self.daemon({"daemon_apply": True}, acked=False)
        self.go(source)
        gate = self.world.state / sb.TEMP_JANITOR_GATE_FILE
        gate.write_text(json.dumps(dict(json.loads(gate.read_text()), preview="another-preview")))
        self.assertEqual(self.preview_facts(engine, source), [])
        self.assertFalse(json.loads(gate.read_text()).get("sent"))

    def test_s4_a_gate_that_cannot_be_marked_sent_is_retried(self):
        self.old("scratch-old-unnamed.log")
        engine, source = self.daemon({"daemon_apply": True}, acked=False)
        self.go(source)
        with mock.patch.object(sb, "_write_small", side_effect=OSError("full")):
            self.assertEqual(self.preview_facts(engine, source), [])
        self.assertEqual(len(self.preview_facts(engine, source)), 1)

    def test_s4_every_comparison_of_the_gate_is_pinned(self):
        state = self.world.state
        gate = {"rule": "r1", "preview": "p1", "sent": True, "count": 1, "nonce": "n1"}
        ack = {"rule": "r1", "preview": "p1", "nonce": "n1", "by": "cos", "at": 1}

        def allowed(gate_changes=None, ack_changes=None, rule="r1"):
            (state / sb.TEMP_JANITOR_GATE_FILE).write_text(json.dumps(dict(gate, **(gate_changes or {}))))
            (state / sb.TEMP_JANITOR_ACK_FILE).write_text(json.dumps(dict(ack, **(ack_changes or {}))))
            return sb.janitor_apply_allowed(state, rule)[0]
        self.assertTrue(allowed())
        self.assertFalse(allowed(rule="r2"), "another rule")
        self.assertFalse(allowed(ack_changes={"rule": "r2"}), "a yes under another rule")
        self.assertFalse(allowed(ack_changes={"preview": "p0"}), "a yes to another preview")
        self.assertFalse(allowed(gate_changes={"sent": False}), "a preview nobody was told")
        self.assertFalse(allowed(ack_changes={"nonce": "n0"}), "a yes given to an earlier preview")
        self.assertFalse(allowed(gate_changes={"nonce": ""}, ack_changes={"nonce": ""}), "no nonce at all")

    def test_s4_the_daemons_apply_follows_each_comparison_of_the_gate(self):
        cases = {"all match": ({}, {}, True), "ack under another rule": ({}, {"rule": "other"}, False), "ack to another preview": ({}, {"preview": "other"}, False),
                 "preview never sent": ({"sent": False}, {}, False), "ack to an earlier preview (nonce)": ({}, {"nonce": "old"}, False)}
        for label, (gate_changes, ack_changes, applies) in cases.items():
            with self.subTest(label):
                for p in self.temp.iterdir():
                    p.unlink()
                victim = self.old("scratch-old-unnamed.log")
                (self.world.state / sb.TEMP_JANITOR_FILE).unlink(missing_ok=True)
                engine, source = self.daemon({"daemon_apply": True}, acked=True)
                gate_path, ack_path = self.world.state / sb.TEMP_JANITOR_GATE_FILE, self.world.state / sb.TEMP_JANITOR_ACK_FILE
                gate_path.write_text(json.dumps(dict(json.loads(gate_path.read_text()), **gate_changes)))
                ack_path.write_text(json.dumps(dict(json.loads(ack_path.read_text()), **ack_changes)))
                self.go(source)
                self.assertEqual(not victim.exists(), applies, label)
                self.now += 7 * 86400
                engine.now = lambda: self.now

    def test_s4_two_previews_under_one_rule_carry_different_nonces(self):
        self.old("scratch-old-unnamed.log")
        engine, source = self.daemon({"daemon_apply": True}, acked=False)
        gate = self.world.state / sb.TEMP_JANITOR_GATE_FILE
        self.go(source)
        first = json.loads(gate.read_text())
        self.week(engine)
        self.go(source)   # the first preview was never handed over: a second one is made under the same rule
        second = json.loads(gate.read_text())
        self.assertEqual(first["rule"], second["rule"])
        self.assertNotEqual(first["nonce"], second["nonce"])
        self.assertTrue(first["nonce"] and second["nonce"])

    def test_s4_a_yes_cannot_be_recorded_for_a_preview_nobody_was_told_of(self):
        self.old("scratch-old-unnamed.log")
        engine, source = self.daemon({"daemon_apply": True}, acked=False)
        self.go(source)   # the gate exists with sent false: the message was never handed over
        gate = json.loads((self.world.state / sb.TEMP_JANITOR_GATE_FILE).read_text())
        self.assertFalse(gate["sent"])
        code, err = self.record_ack(gate["preview"])
        self.assertEqual(code, 1)
        self.assertFalse((self.world.state / sb.TEMP_JANITOR_ACK_FILE).exists())

    def test_s4_a_rule_that_changes_and_comes_back_needs_a_new_yes(self):
        victim = self.old("scratch-old-unnamed.log")
        engine, source = self.daemon({"daemon_apply": True}, acked=False)
        self.go(source)
        self.preview_facts(engine, source)
        first = json.loads((self.world.state / sb.TEMP_JANITOR_GATE_FILE).read_text())["preview"]
        self.assertEqual(self.record_ack(first)[0], 0)
        engine, source = self.daemon({"daemon_apply": True, "days": 8}, acked=False)   # the rule moves to B
        self.week(engine)
        self.go(source)
        self.assertFalse((self.world.state / sb.TEMP_JANITOR_ACK_FILE).exists(), "a new preview ends the earlier yes")
        self.preview_facts(engine, source)
        engine, source = self.daemon({"daemon_apply": True}, acked=False)   # and back to A, same names
        self.week(engine)
        self.go(source)
        self.preview_facts(engine, source)
        self.week(engine)
        self.go(source)
        self.assertTrue(victim.exists(), "the old yes does not unlock it again")
        self.assertEqual(self.events("temp.removed"), [])

    def test_s8_a_name_is_only_in_the_private_audit_and_the_message(self):
        engine, source = self.daemon({"daemon_apply": True}, acked=False)
        self.old("distinctive-fixture-name.log")
        self.go(source)
        facts = self.preview_facts(engine, source)
        self.assertIn("distinctive-fixture-name.log", facts[0].summary)
        for event in ("janitor.preview",):
            self.assertEqual(len(self.events(event)), 1)
        public = json.dumps([e for e in self.world.audit() if e["event"] in ("janitor.preview", "janitor.ack")])
        public += (self.world.state / sb.TEMP_JANITOR_GATE_FILE).read_text()
        self.assertNotIn("distinctive-fixture-name", public)

    def test_a_failure_inside_the_run_is_one_janitor_error_and_removes_nothing(self):
        victim = self.old("old-file.txt")
        engine, source = self.daemon({"daemon_apply": True})
        with mock.patch.object(self.jan, "run", side_effect=RuntimeError("boom")):
            self.go(source)
        self.assertTrue(victim.exists())
        self.assertEqual(len(self.events("janitor.error")), 1)

    def test_s12_the_janitors_sweep_state_is_its_own_and_never_the_main_threads(self):
        engine, source = self.daemon({"daemon_apply": True})
        inside, leave, seen = threading.Event(), threading.Event(), {}

        def janitor_thread():
            with sb.worktree_sweep(engine):
                seen["own"] = engine._wt_sweep
                inside.set()
                leave.wait(10)
            seen["after"] = engine._wt_sweep
        worker = threading.Thread(target=janitor_thread)
        worker.start()
        self.assertTrue(inside.wait(10))
        try:
            self.assertFalse(engine._wt_sweep, "the main thread is not in a sweep because another thread is")
            self.assertTrue(seen["own"])
            engine._wt_session_index = ({"x": "/elsewhere"}, True)   # the main thread's own state
        finally:
            leave.set()
            worker.join(10)
        self.assertFalse(seen["after"])
        self.assertEqual(engine._wt_session_index, ({"x": "/elsewhere"}, True), "the janitor leaving its sweep did not clear the main thread's cache")
        engine._wt_session_index = None
        with mock.patch.object(sb.V2Client, "session_list_page", wraps=engine.v2.session_list_page) as listed:   # a main-thread check reads the current list
            sb.worktree_session_index(engine)
            sb.worktree_session_index(engine)
        self.assertEqual(listed.call_count, 2)

    def test_s13_a_session_started_in_an_entry_after_the_scan_keeps_it(self):
        victim = self.old("old-file-dir", directory=True)
        engine, source = self.daemon({"daemon_apply": True})
        engine.discover(self.now)
        sid = self.world.sessions["coder"]
        self.world.v2.sessions[sid]["directory"] = str(self.home)
        real, calls = self.jan.judge, [0]

        def judge(path, *args, **kwargs):
            calls[0] += 1
            if calls[0] == 2:   # after the scan judged it, before the removal re-judges it
                self.world.v2.sessions[sid]["directory"] = str(victim)
            return real(path, *args, **kwargs)
        with mock.patch.object(self.jan, "judge", judge):
            self.go(source)
        self.assertGreaterEqual(calls[0], 2)
        self.assertTrue(victim.exists())
        self.assertEqual(self.events("temp.removed"), [])
        self.assertIn("kept old-file-dir: it changed since the scan", self.events("janitor.summary")[0]["detail"]["notes"])

    def test_s10_no_gh_and_no_network(self):
        self.old("old-file.txt")
        engine, source = self.daemon({"daemon_apply": True})
        self.go(source)
        self.assertTrue(self.calls)
        for argv in self.calls:
            self.assertNotIn(os.path.basename(argv[0]), ("gh", "curl", "git", "ssh"))
            self.assertNotIn("api", argv[:2] if os.path.basename(argv[0]) == "gh" else [])

    def test_s11_the_docs_name_the_one_apply_path_and_the_plist_example_has_no_janitor(self):
        text = (Path(sb.__file__).resolve().parent.parent / "docs" / "switchboard.md").read_text()
        self.assertIn("There is one apply path (#958)", text)
        self.assertIn("<string>/home/user/.local/bin/fleet-switchboard disk prune</string></array>", text)


class TestWeeklyJobRewrite(Base):
    """Ask #958: the installer drops the janitor from a weekly job installed from the old documentation snippet, and only from that."""
    PROG = "/home/user/.local/bin/fleet-switchboard"
    OLD = "%s disk prune; %s disk janitor --apply --weekly" % (PROG, PROG)

    def setUp(self):
        super().setUp()
        self.agents = Path.home() / "Library" / "LaunchAgents"
        self.agents.mkdir(parents=True, exist_ok=True)
        self.assertTrue(str(self.agents).startswith(str(self.home)), "the test must never touch a real LaunchAgents")

    def plist(self, command, name="com.example.fleet-disk-prune.plist", extra=""):
        text = ('<?xml version="1.0" encoding="UTF-8"?>\n<plist version="1.0">\n<dict>\n  <key>Label</key><string>com.example.fleet-disk-prune</string>\n'
                '  <key>ProgramArguments</key>\n  <array><string>/bin/sh</string><string>-c</string><string>%s</string></array>\n%s</dict>\n</plist>\n' % (command, extra))
        (self.agents / name).write_text(text)
        return self.agents / name, text

    def step(self, platform="darwin", dry=False):
        out = io.StringIO()
        sb.Installer(subprocess.run, subprocess.Popen, lambda: 1700000000.0, platform, REPO, out=out, dry_run=dry).step_janitor_job()
        return out.getvalue()

    def backups(self):
        return sorted(p.name for p in self.agents.iterdir() if ".bak-" in p.name)

    def test_958_an_exact_match_is_backed_up_and_rewritten_and_the_prune_part_is_byte_identical(self):
        path, text = self.plist(self.OLD)
        out = self.step()
        self.assertIn("done", out)
        self.assertEqual(len(self.backups()), 1)
        self.assertEqual((self.agents / self.backups()[0]).read_text(), text)
        self.assertEqual(path.read_text(), text.replace(self.OLD, "%s disk prune" % self.PROG))
        self.assertNotIn("disk janitor", path.read_text())
        self.assertIn("%s disk prune" % self.PROG, path.read_text())   # the Docker prune command, unchanged
        self.assertIn("already done", self.step())   # a second run changes nothing
        self.assertEqual(len(self.backups()), 1)

    def test_958_a_job_that_differs_by_one_character_is_reported_and_left_byte_identical(self):
        for command in (self.OLD + " ", self.OLD.replace("--weekly", "--weekl"), self.OLD.replace("; ", ";  "),
                        "%s disk prune; /other/fleet-switchboard disk janitor --apply --weekly" % self.PROG,
                        self.OLD + "; echo hi"):
            for old in self.agents.iterdir():
                old.unlink()
            path, text = self.plist(command)
            before = hashlib.sha256(path.read_bytes()).hexdigest()
            out = self.step()
            self.assertEqual(hashlib.sha256(path.read_bytes()).hexdigest(), before, command)
            self.assertEqual(self.backups(), [], command)
            self.assertIn("nothing was changed", out)

    def test_958_no_job_changes_nothing_and_a_dry_run_writes_nothing(self):
        self.assertIn("already done", self.step())
        self.assertEqual(list(self.agents.iterdir()), [])
        path, text = self.plist(self.OLD)
        self.assertIn("would be done", self.step(dry=True))
        self.assertEqual(path.read_text(), text)
        self.assertEqual(self.backups(), [])
        self.assertIn("skipped", self.step(platform="linux"))

    def test_958_s11_unreadable_symlink_none_and_a_second_run_change_nothing_and_the_first_backup_survives(self):
        original = self.plist(self.OLD, "real.plist")[1]
        os.symlink(str(self.agents / "real.plist"), str(self.agents / "link.plist"))
        (self.agents / "real.plist").rename(self.agents / "real.txt")
        before = {p.name: p.read_bytes() for p in self.agents.iterdir() if not p.is_symlink()}
        locked, locked_text = self.plist(self.OLD, "locked.plist")
        os.chmod(str(locked), 0)
        try:
            self.step()
        finally:
            os.chmod(str(locked), 0o644)
        self.assertEqual(self.backups(), [])
        self.assertEqual(locked.read_text(), locked_text, "an unreadable file is left as it is")
        self.assertEqual({p.name: p.read_bytes() for p in self.agents.iterdir() if not p.is_symlink() and p.name != "locked.plist"}, before)
        for p in list(self.agents.iterdir()):
            p.unlink()
        path, text = self.plist(self.OLD)
        self.step()
        first = (self.agents / self.backups()[0]).read_bytes()
        self.step()
        self.step()
        self.assertEqual(len(self.backups()), 1)
        self.assertEqual((self.agents / self.backups()[0]).read_bytes(), first)
        self.assertEqual(first, text.encode())

    def test_958_backup_collision_and_a_doubled_command_leave_the_file_alone(self):
        path, text = self.plist(self.OLD)
        taken = path.with_name(path.name + ".bak-1700000000")
        taken.write_text("earlier backup")
        out = self.step()
        self.assertIn("exists", out)
        self.assertEqual(path.read_text(), text)
        self.assertEqual(taken.read_text(), "earlier backup")
        taken.unlink()
        twice = self.plist(self.OLD, "twice.plist", extra="  <key>Note</key><string>%s</string>\n" % self.OLD)
        out = self.step()
        self.assertEqual(twice[0].read_text(), twice[1])
        self.assertIn("nothing was changed", out)

    def test_958_each_part_of_the_exactness_rule_is_pinned_by_its_own_row(self):
        """The rule has four parts: the program list's shape, the shell, the command's equality and the single occurrence. One row for each, and a plist plus
        the old command in a second key for the count."""
        prog = self.PROG
        rows = {
            "shell is zsh": ("/bin/zsh", "-c", self.OLD, None),
            "shell is bash": ("/bin/bash", "-c", self.OLD, None),
            "flag is -lc": ("/bin/sh", "-lc", self.OLD, None),
            "flag is -e": ("/bin/sh", "-e", self.OLD, None),
            "list has a fourth word": ("/bin/sh", "-c", self.OLD, "<string>extra</string>"),
            "janitor flag differs": ("/bin/sh", "-c", self.OLD.replace("--apply", "--apply "), None),
            "second program differs": ("/bin/sh", "-c", "%s disk prune; /elsewhere/fleet-switchboard disk janitor --apply --weekly" % prog, None),
            "text after the command": ("/bin/sh", "-c", self.OLD + "; true", None),
        }
        for label, (shell, flag, command, more) in rows.items():
            for old in self.agents.iterdir():
                old.unlink()
            path = self.agents / "job.plist"
            path.write_text('<?xml version="1.0" encoding="UTF-8"?>\n<plist version="1.0">\n<dict>\n  <key>ProgramArguments</key>\n  <array><string>%s</string><string>%s</string>'
                            '<string>%s</string>%s</array>\n</dict>\n</plist>\n' % (shell, flag, command, more or ""))
            before = hashlib.sha256(path.read_bytes()).hexdigest()
            out = self.step()
            self.assertEqual(hashlib.sha256(path.read_bytes()).hexdigest(), before, label)
            self.assertEqual(self.backups(), [], label)
            self.assertIn("nothing was changed", out, label)
        for old in self.agents.iterdir():
            old.unlink()
        path, text = self.plist(self.OLD, extra="  <key>Note</key><string>%s</string>\n" % self.OLD)   # the single occurrence
        self.step()
        self.assertEqual(path.read_text(), text)
        self.assertEqual(self.backups(), [])

    def test_958_a_symlinked_job_is_never_rewritten_through_the_link(self):
        real = self.agents.parent / "real-job.plist"
        real.write_text(self.plist(self.OLD, "tmp.plist")[1])
        (self.agents / "tmp.plist").unlink()
        os.symlink(str(real), str(self.agents / "job.plist"))
        before = real.read_bytes()
        try:
            self.step()
        except sb.InstallError:
            pass   # the write check refuses the link: the install stops rather than writing through it
        self.assertEqual(real.read_bytes(), before)
        self.assertEqual([n for n in self.backups()], [])

    def test_958_s7_the_documentation_snippet_is_what_the_installer_produces(self):
        docs = (Path(sb.__file__).resolve().parent.parent / "docs" / "switchboard.md").read_text()
        start = docs.index("<?xml version", docs.index("com.example.fleet-disk-prune.plist"))
        snippet = docs[start:docs.index("```", start)]
        self.assertIn("%s disk prune</string>" % self.PROG, snippet)
        old = snippet.replace("%s disk prune</string>" % self.PROG, "%s</string>" % self.OLD)
        (self.agents / "x.plist").write_text(old)
        self.step()
        self.assertEqual((self.agents / "x.plist").read_text(), snippet)
        self.assertIn("`--i-reviewed", docs)

    def test_958_every_old_snippet_command_the_docs_ever_showed_has_no_janitor_apply_now(self):
        docs = (Path(sb.__file__).resolve().parent.parent / "docs" / "switchboard.md").read_text()
        snippet = docs[docs.index("<key>Label</key><string>com.example.fleet-disk-prune</string>"):]
        snippet = snippet[:snippet.index("</plist>")]
        self.assertEqual(snippet.count("disk janitor --apply"), 0)
        self.assertIn("--i-reviewed", docs)


class TestComposeTrap(Base):
    """`tools/fleet-compose-trap.sh`: the compose project is brought down WITH its volumes once, on a normal exit and on an interrupt."""

    def run_harness(self, how):
        log = self.home / "docker.log"
        fake = self.home / "bin"
        fake.mkdir(exist_ok=True)
        (fake / "docker").write_text("#!/bin/sh\necho \"$@\" >> %s\n" % log)
        os.chmod(str(fake / "docker"), 0o755)
        script = self.home / "harness.sh"
        script.write_text("#!/usr/bin/env bash\n. %s\nfleet_compose_trap -p proj -f compose.test.yml\n%s\n" % (
            REPO / "tools" / "fleet-compose-trap.sh", "exit 0" if how == "exit" else "sleep 30 &\ntouch %s\nwait" % (self.home / "ready")))
        env = dict(os.environ, PATH="%s:%s" % (fake, os.environ["PATH"]))
        proc = subprocess.Popen(["bash", str(script)], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                preexec_fn=lambda: signal.signal(signal.SIGINT, signal.SIG_DFL))   # a suite started in the background inherits SIGINT ignored, which no trap can undo
        if how != "exit":
            for _ in range(200):   # the child says when its trap is set and it waits
                if (self.home / "ready").exists():
                    break
                time.sleep(0.05)
            else:
                proc.kill()
                self.fail("the harness never got ready")
            proc.send_signal(signal.SIGINT if how == "interrupt" else signal.SIGTERM)
        proc.wait(timeout=20)
        return log.read_text().splitlines() if log.exists() else []

    def test_s5_a_normal_exit_runs_down_with_volumes_once(self):
        self.assertEqual(self.run_harness("exit"), ["compose -p proj -f compose.test.yml down -v --remove-orphans"])

    def test_s5_an_interrupt_and_a_termination_run_it_once_each(self):
        for how in ("interrupt", "terminate"):
            with self.subTest(how=how):
                (self.home / "docker.log").unlink(missing_ok=True)
                (self.home / "ready").unlink(missing_ok=True)
                self.assertEqual(self.run_harness(how), ["compose -p proj -f compose.test.yml down -v --remove-orphans"])

    def test_the_helper_never_uses_sudo(self):
        self.assertNotIn("sudo", (REPO / "tools" / "fleet-compose-trap.sh").read_text().replace("Never uses sudo.", ""))


class TestDaemonPriority(Base):
    """P0 CPU item C: the daemon's LaunchAgent asks for the Interactive process class, with no root; ensure's own start is unchanged."""

    def template(self):
        import plistlib
        return plistlib.loads((REPO / "templates" / "com.fleet-kit.switchboard.plist").read_bytes())

    def test_s1_the_template_asks_for_the_interactive_class_and_nothing_that_needs_root(self):
        plist = self.template()
        self.assertEqual(plist["ProcessType"], "Interactive")
        for key in ("UserName", "GroupName", "Nice", "SessionCreate"):
            self.assertNotIn(key, plist)
        self.assertEqual(plist["Label"], "com.fleet-kit.switchboard")
        self.assertEqual(plist["ProgramArguments"][-2:], ["run", "--standby"])

    def test_s2_what_install_writes_parses_and_says_the_same(self):
        import plistlib
        values = sb.service_values(REPO, sb.service_path_dirs(REPO, []))
        written = plistlib.loads(sb.render_service("launchd", values, REPO).encode())
        self.assertEqual(written["ProcessType"], "Interactive")
        self.assertEqual(written["ProgramArguments"][-2:], ["run", "--standby"])
        self.assertEqual(written["ProgramArguments"][0], values["__PYTHON__"])
        self.assertIsNone(re.search(r"__[A-Z_]+__", json.dumps(written)), "every placeholder is filled")

    def test_s3_ensures_own_start_is_unchanged(self):
        seen = []
        shell = {"PATH": "/usr/bin", "HERDR_PANE_ID": "w1:p1", "FLEET_SWITCHBOARD_ROLE": "coder", "HERDR_SOCKET_PATH": "/s"}
        with mock.patch.dict(os.environ, shell, clear=True):
            sb.spawn_daemon(self.world_state(), spawn=lambda argv, **kw: seen.append((argv, kw)))
        argv, kw = seen[0]
        self.assertEqual(argv[-1], "run")
        self.assertTrue(kw["start_new_session"])
        self.assertEqual(kw["cwd"], str(self.world_state()))
        self.assertNotIn("HERDR_PANE_ID", kw["env"])
        self.assertNotIn("FLEET_SWITCHBOARD_ROLE", kw["env"])
        self.assertFalse({"launchctl", "taskpolicy", "nice", "sudo"} & {os.path.basename(a) for a in argv}, "no wrapper around the start, by name or by path")

    def world_state(self):
        path = self.home / "state"
        path.mkdir(exist_ok=True)
        return path

    def test_s4_the_docs_say_how_to_opt_in_check_and_go_back(self):
        text = (REPO / "docs" / "switchboard.md").read_text()
        section = text[text.index("### The daemon's priority under load"):]
        section = section[:section.index("\n### ", 10)] if "\n### " in section[10:] else section
        for needle in ("ProcessType", "Interactive", "opt-in", "launchctl print", "no sudo", "fleet-switchboard install", "--uninstall"):
            self.assertIn(needle, section)


class TestCpuGuard(Base):
    """The CPU guard (P0 CPU item D): one os.getloadavg per pass, a status line, one wake per episode, no process in a normal pass."""

    PS = "  60.0 /usr/local/bin/node\n  25.5 /Applications/Docker.app/Contents/MacOS/com.docker.backend\n  12.0 /usr/bin/python3\n  2.0 /bin/zsh\n  garbage\n"

    def setUp(self):
        super().setUp()
        self.load = [86.0]    # the five-minute average (what the alarm reads)
        self.load1 = [None]   # the one-minute average; None = the same
        self.cores = 14
        self.loads_read = []
        self.world = World(self, agents=("coder",), config={})
        self.world.add_agent("cos", fleet={"role": "chief-of-staff"})
        self.engine = self.world.engine
        self.engine.discover(self.world.clock.now())
        self.cg = sb.load_cpu_guard()
        self.ps_calls = []

        def getloadavg():
            self.loads_read.append(self.load[0])
            return (self.load1[0] if self.load1[0] is not None else self.load[0], self.load[0], self.load[0])
        patcher = mock.patch.object(os, "getloadavg", getloadavg)
        patcher.start()
        self.addCleanup(patcher.stop)
        patcher2 = mock.patch.object(os, "cpu_count", lambda: self.cores)
        patcher2.start()
        self.addCleanup(patcher2.stop)

        def ps(argv, **kwargs):
            self.ps_calls.append(list(argv))
            return subprocess.CompletedProcess(argv, 0, self.PS, "")
        self.engine.cpu_ps_runner = ps

    def settle(self, engine=None):
        """Wait for the ps thread of the engine's CPU source (it runs off the pass)."""
        for source in (engine or self.engine).sources:
            if isinstance(source, sb.CpuFacts) and source.thread is not None:
                source.thread.join(10)

    def facts(self, engine=None):
        engine = engine or self.engine
        found, problems = engine.collect_facts()
        self.assertEqual(problems, [])
        return [f for f in found if f.kind == "cpu"]

    def audits(self, name):
        return [e for e in self.world.audit() if e["event"] == name]

    def run_for(self, minutes, step=30, engine=None):
        """Passes every `step` seconds for `minutes`; returns the facts of the last pass."""
        last = []
        for _ in range(int(minutes * 60 / step)):
            self.world.tick(step)
            last = self.facts(engine)
        return last

    def test_s1_the_status_line_reads_load_cores_and_ratio_marks_high_only_above_the_guard_and_starts_no_process(self):
        cfg = self.cg.settings(None)
        self.load1[0] = None
        with mock.patch.object(subprocess, "run", side_effect=AssertionError("a process was started")), \
                mock.patch.object(subprocess, "Popen", side_effect=AssertionError("a process was started")):
            self.assertEqual(self.cg.status_line(cfg, self.cg.reading()), "load 86 on 14 cores (6.1x) [HIGH]")
            self.load[0] = 4.0
            self.assertEqual(self.cg.status_line(cfg, self.cg.reading()), "load 4 on 14 cores (0.3x)")
            self.load[0] = 42.0
            self.assertEqual(self.cg.status_line(cfg, self.cg.reading()), "load 42 on 14 cores (3.0x)", "exactly at the guard is not above it")
            self.world.tick(60)
            self.facts()   # a daemon pass with a normal load
        self.assertEqual(self.ps_calls, [])

    def test_s1_status_shows_the_cpu_line(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.assertIn("cpu        load 86 on 14 cores (6.1x) [HIGH]", sb.format_status(sb.collect_status(self.world.route, self.world.clock.now)))

    def test_s2_one_wake_per_episode_after_the_minutes_and_one_bounded_ps(self):
        self.assertEqual(self.run_for(4), [], "4 minutes above the guard: not yet")
        self.assertEqual(self.ps_calls, [])
        keys = set()
        for _ in range(40):
            for fact in self.run_for(0.5):
                keys.add(fact.key)
        self.assertEqual(len(keys), 1, "the same key on every later pass")
        self.settle()
        (fact,) = self.facts()
        self.assertIn("cpu high: load 86 on 14 cores (6.1x over five minutes", fact.summary)
        self.assertIn("top: node 60%", fact.summary)
        self.assertEqual(len(self.audits("cpu.high")), 1)
        self.assertEqual(self.ps_calls, [self.cg.PS_ARGV], "exactly one ps in the whole episode")
        self.assertNotIn("/Applications", fact.summary, "only base names")

    def test_s3_the_episode_ends_below_two_thirds_of_the_guard_and_a_second_rise_is_a_second_episode(self):
        self.run_for(6)
        self.settle()
        (first,) = self.facts()
        self.load[0] = 35.0   # 2.5x: between the re-arm ratio and the guard
        self.assertEqual([f.key for f in self.run_for(1)], [first.key])
        self.assertEqual(self.audits("cpu.recovered"), [])
        self.load[0] = 20.0   # 1.4x
        self.assertEqual(self.run_for(1), [])
        self.assertEqual(len(self.audits("cpu.recovered")), 1)
        self.load[0] = 90.0
        self.run_for(6)
        self.settle()
        (second,) = self.facts()
        self.assertNotEqual(second.key, first.key)
        self.assertEqual(len(self.audits("cpu.high")), 2)
        self.assertEqual(len(self.ps_calls), 2, "one ps per episode")

    def test_a_dip_below_the_guard_before_the_minutes_resets_the_clock(self):
        self.run_for(4)
        self.load[0] = 10.0
        self.run_for(1)
        self.load[0] = 86.0
        self.assertEqual(self.run_for(4), [])
        self.assertEqual(self.audits("cpu.high"), [])

    def test_s4_a_restart_does_not_begin_a_second_episode(self):
        self.run_for(6)
        self.settle()
        (first,) = self.facts()
        restarted = self.world.new_engine("daemon")
        restarted.discover(self.world.clock.now())
        restarted.cpu_ps_runner = self.engine.cpu_ps_runner
        facts = self.run_for(2, engine=restarted)
        self.assertEqual([f.key for f in facts], [first.key])
        self.assertEqual(len(self.audits("cpu.high")), 1)
        self.assertEqual(len(self.ps_calls), 1)

    def test_s5_false_turns_everything_off_and_the_load_is_not_read(self):
        self.engine.config["cpu_guard"] = False
        self.assertEqual(self.run_for(10), [])
        self.assertEqual(self.loads_read, [])
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "cpu_guard": False})
        self.assertNotIn("cpu        ", sb.format_status(sb.collect_status(self.world.route, self.world.clock.now)))
        self.assertEqual(self.loads_read, [])

    def test_s6_the_line_adds_the_heavy_slots_only_from_a_working_heavy_slots_module(self):
        cfg = self.cg.settings(None)
        read = self.cg.reading()
        plain = "load 86 on 14 cores (6.1x) [HIGH]"
        module = self.home / "heavy_slots.py"
        with mock.patch.object(self.cg, "HEAVY_SLOTS_PATH", str(self.home / "absent.py")):
            self.assertIsNone(self.cg.slots_text({}, self.world.state), "no heavy module yet: no slots text")
        good = ("def settings(raw):\n    return (raw or {}).get('slots', 3)\n"
                "def holders(state_dir, maximum):\n    return [{'slot': 1, 'name': 'coder-live', 'pid': 7, 'command': 'make test', 'since': 1000.0}, "
                "{'slot': 2, 'name': 'coder\\x1b[2J', 'pid': 8, 'command': 'npm', 'since': 'soon'}]\n")
        for label, body, want in (("a good module", good, "heavy slots 2/3 (coder-live make test 6m, coder??2J npm)"),
                                  ("no holders", "def settings(raw):\n    return 3\ndef holders(state_dir, maximum):\n    return []\n", "heavy slots 0/3"),
                                  ("a raising module", "def settings(raw):\n    raise RuntimeError('x')\ndef holders(state_dir, maximum):\n    return []\n", None),
                                  ("bad types", "def settings(raw):\n    return 'three'\ndef holders(state_dir, maximum):\n    return []\n", None),
                                  ("a module that does not parse", "def settings(:\n", None)):
            with self.subTest(label):
                module.write_text(body)
                with mock.patch.object(self.cg, "HEAVY_SLOTS_PATH", str(module)):
                    text = self.cg.slots_text({}, self.world.state, now=1000.0 + 360)
                self.assertEqual(text, want)
                self.assertEqual(self.cg.status_line(cfg, read, text), plain + ("; " + want if want else ""))
        module.write_text(good)
        with mock.patch.object(self.cg, "HEAVY_SLOTS_PATH", str(module)):
            self.assertIn("heavy slots 2/5", self.cg.slots_text({"heavy": {"slots": 5}}, self.world.state, now=1500.0), "the module's own settings read the config's heavy section")

    def test_a_one_minute_spike_never_wakes_anyone_only_the_five_minute_average_does(self):
        self.load[0] = 10.0        # the five-minute average is fine
        self.load1[0] = 200.0      # the one-minute average is a spike
        self.assertEqual(self.run_for(20), [])
        self.assertEqual(self.audits("cpu.high"), [])
        self.assertIn("[HIGH]", self.cg.status_line(self.cg.settings(None), self.cg.reading()), "the displayed one-minute load still shows it")

    def test_the_ps_runs_off_the_pass_so_a_hung_ps_never_delays_it(self):
        release, entered = threading.Event(), threading.Event()

        def hung(argv, **kwargs):
            entered.set()
            release.wait(30)
            return subprocess.CompletedProcess(argv, 0, self.PS, "")
        self.engine.cpu_ps_runner = hung
        self.run_for(6)   # the passes return while the ps is still blocked: if a pass waited for it, this would not come back until `release` (30 s)
        self.assertTrue(entered.wait(10))
        self.assertFalse(release.is_set())
        (fact,) = self.facts()
        self.assertNotIn("top:", fact.summary, "the categories are not there yet")
        release.set()
        self.settle()
        (fact,) = self.facts()
        self.assertIn("top: node 60%", fact.summary)

    def test_a_slow_ps_of_an_earlier_episode_never_overwrites_a_later_ones_text(self):
        self.run_for(6)
        self.settle()
        stale = threading.Event()
        gate = threading.Event()

        def slow(argv, **kwargs):
            gate.wait(30)
            return subprocess.CompletedProcess(argv, 0, "  99.0 /usr/bin/stale\n", "")
        self.engine.cpu_ps_runner = slow
        self.load[0] = 20.0
        self.run_for(1)   # the first episode ends
        self.load[0] = 90.0
        self.run_for(6)   # a second begins; its ps is blocked
        self.engine.cpu_ps_runner = self.engine.cpu_ps_runner
        source = [s for s in self.engine.sources if isinstance(s, sb.CpuFacts)][0]
        old_thread = source.thread
        source.thread = None   # the engine's view of the episode moves on
        gate.set()
        old_thread.join(10)
        self.assertEqual(source.detail, "", "a thread that is no longer the current one wrote nothing")

    def test_no_chief_of_staff_means_no_episode_until_one_is_running(self):
        self.engine.discovery.agents.pop("cos", None)
        self.assertEqual(self.run_for(7), [])
        self.assertEqual(self.audits("cpu.high"), [])
        self.world.add_agent("cos2", fleet={"role": "chief-of-staff"})
        self.engine.discover(self.world.clock.now())
        facts = self.run_for(6)
        self.assertEqual(len({fact.key for fact in facts}), 1, "the episode begins once a Chief of Staff exists, with one key")
        self.assertTrue(facts)
        self.assertEqual(len(self.audits("cpu.high")), 1)

    def test_the_episode_file_is_atomic_0600_bounded_and_a_failed_save_is_said_and_tried_again(self):
        self.run_for(6)
        path = self.world.state / self.cg.STATE_FILE
        self.assertEqual(oct(path.stat().st_mode & 0o777), "0o600")
        self.assertEqual(list(self.world.state.glob(self.cg.STATE_FILE + ".*.tmp")), [])
        for bad in ("not json", "[]", "x" * 10000, json.dumps({"episode": "soon"})):
            path.write_text(bad)
            self.assertIsNone(self.cg.load_episode(self.world.state), bad[:12])
        self.load[0] = 20.0
        with mock.patch.object(self.cg.os, "replace", side_effect=OSError("disk full")):
            self.run_for(1)   # the episode ends but the file cannot be written
        self.assertEqual(len([e for e in self.world.audit() if e["event"] == "cpu.guard_file"]), 1)
        self.assertEqual(list(self.world.state.glob(self.cg.STATE_FILE + ".*.tmp")), [])
        self.run_for(1)   # the next pass tries again, and now it works
        self.assertEqual(self.cg.load_episode(self.world.state), None)

    def test_a_ps_that_fails_or_a_runaway_holders_list_changes_nothing_but_the_text(self):
        self.engine.cpu_ps_runner = lambda argv, **kw: subprocess.CompletedProcess(argv, 1, "", "no")
        self.run_for(6)
        self.settle()
        (fact,) = self.facts()
        self.assertNotIn("top:", fact.summary)
        module = self.home / "heavy_slots.py"
        module.write_text("def settings(raw):\n    return 1000\ndef holders(state_dir, maximum):\n    return range(10 ** 9)\n")
        with mock.patch.object(self.cg, "HEAVY_SLOTS_PATH", str(module)):
            self.assertEqual(self.cg.slots_text({}, self.world.state), "heavy slots 1001/1000", "the count is cut at one past the cap, never walked")
        module.write_text("import sys\nsys.exit(3)\n")
        with mock.patch.object(self.cg, "HEAVY_SLOTS_PATH", str(module)):
            self.assertIsNone(self.cg.slots_text({}, self.world.state), "a module that exits takes nobody down")

    def test_bad_inputs_are_said_and_never_guessed_a_missing_core_count_is_not_one_core(self):
        cfg = self.cg.settings(None)
        for label, cores, want in (("no core count", None, "load 20, cores unknown"), ("zero cores", 0, "load 20, cores unknown"), ("negative cores", -3, "load 20, cores unknown"),
                                   ("a core count that is not a number", "many", "load 20, cores unknown")):
            with self.subTest(label):
                self.cores, self.load[0] = cores, 20.0
                self.assertEqual(self.cg.status_line(cfg, self.cg.reading()), want, "no ratio and no marker: never one core")
                self.assertEqual(self.run_for(10), [], "a normal load on an unknown core count wakes nobody")
                self.assertEqual(self.audits("cpu.high"), [])
        self.cores = 14
        for label, value, reason in (("nan", float("nan"), "not a finite number"), ("inf", float("inf"), "not a finite number"), ("negative", -1.0, "not a finite number")):
            with self.subTest(label):
                self.load[0] = value
                line = self.cg.status_line(cfg, self.cg.reading())
                self.assertEqual(line, "unreadable: the load average is not a finite number of at least 0")
                self.assertEqual(self.run_for(10), [], "a bad load wakes nobody and raises nothing")
        self.load[0] = 86.0
        with mock.patch.object(os, "getloadavg", side_effect=OSError("no load average")):
            self.assertEqual(self.cg.status_line(cfg, self.cg.reading()), "unreadable: OSError: no load average")
        with mock.patch.object(os, "getloadavg", return_value=()):
            self.assertEqual(self.cg.status_line(cfg, self.cg.reading()), "unreadable: IndexError: tuple index out of range")
        self.assertEqual(self.cg.status_line(cfg, self.cg.reading()), "load 86 on 14 cores (6.1x) [HIGH]", "and a good reading is as before")

    def test_status_says_when_the_load_or_the_cores_are_unknown_instead_of_leaving_the_line_out(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.load[0] = float("nan")
        self.assertIn("cpu        unreadable: the load average is not a finite number", sb.format_status(sb.collect_status(self.world.route, self.world.clock.now)))
        self.load[0], self.cores = 20.0, None
        self.assertIn("cpu        load 20, cores unknown", sb.format_status(sb.collect_status(self.world.route, self.world.clock.now)))

    def test_s7_the_config_key_is_validated(self):
        for ok in (None, False, {}, {"high_ratio": 4.5, "minutes": 10}, {"minutes": 1}):
            sb.validate_config(dict({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR}, cpu_guard=ok), "t")
        self.assertEqual({k: v for k, v in self.cg.settings(None).items() if k != "rearm_ratio"}, {"high_ratio": 3.0, "minutes": 5})
        self.assertIsNone(self.cg.settings(False))
        got = self.cg.settings({"high_ratio": 4.5, "minutes": 10})
        self.assertEqual((got["high_ratio"], got["minutes"], got["rearm_ratio"]), (4.5, 10, 3.0))
        for bad in (True, 5, [], {"high_ratio": 0}, {"high_ratio": -1}, {"high_ratio": "3"}, {"minutes": 0}, {"minutes": 500}, {"nope": 1}):
            with self.subTest(bad=bad):
                with self.assertRaises(sb.ConfigError):
                    sb.validate_config(dict({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR}, cpu_guard=bad), "t")

    def test_an_unreadable_load_says_nothing_and_a_failing_ps_still_wakes(self):
        with mock.patch.object(os, "getloadavg", side_effect=OSError("no")):
            self.assertEqual(self.run_for(7), [])
            self.assertTrue(self.cg.status_line(self.cg.settings(None), self.cg.reading()).startswith("unreadable: OSError"))
        self.settle()
        self.engine.cpu_ps_runner = lambda argv, **kw: (_ for _ in ()).throw(OSError("no ps"))
        self.run_for(6)
        self.settle()
        (fact,) = self.facts()
        self.assertNotIn("top:", fact.summary)
        self.assertIn("cpu high", fact.summary)

    def test_the_categories_are_summed_by_base_name_and_hostile_names_are_cleaned(self):
        cats = self.cg.categories("  10 /a/node\n  5 /b/node\n  3 \x1b[2Jevil\n  1 /c/x y\n")
        self.assertEqual(cats[0], ("node", 15.0))
        self.assertNotIn("\x1b", self.cg.detail(cats))


class TestGithubWritingRule(unittest.TestCase):
    """Ask #401, slice 1: the same one-sentence writing rule for GitHub text in the two skills, the coder and orchestrator definitions of both runtimes and the
    pull request template."""

    RULE = ('Write GitHub text so a person can read it: short paragraphs, real Markdown lists with one item per line, headings for sections, '
            'never an inline "(1) ... (2) ..." chain, and code and commands in code spans or blocks.')
    FILES = ("skills/fleet-charter/SKILL.md", "skills/fleet-coordination/SKILL.md", "agents/opencode/coder.md", "agents/opencode/orchestrator.md",
             "agents/copilot/coder.agent.md", "agents/copilot/orchestrator.agent.md", ".github/pull_request_template.md")

    def test_s1_every_file_carries_the_rule_sentence_exactly(self):
        for rel in self.FILES:
            with self.subTest(file=rel):
                self.assertIn(self.RULE, (REPO / rel).read_text())

    def test_s2_it_is_one_sentence_everywhere_and_never_inside_a_code_fence(self):
        found = set()
        for rel in self.FILES:
            text = (REPO / rel).read_text()
            for line in text.splitlines():
                at = line.find("Write GitHub text so a person can read it")
                if at >= 0:
                    found.add(line[at:].replace(" -->", "").rstrip())
            inside, fenced = False, False
            for line in text.splitlines():
                if line.strip().startswith("```"):
                    inside = not inside
                elif inside and "Write GitHub text so a person can read it" in line:
                    fenced = True
            self.assertFalse(fenced, "%s: the rule sits inside a code fence" % rel)
        self.assertEqual(found, {self.RULE})

    def test_the_rule_is_not_in_the_front_matter_of_a_definition(self):
        for rel in self.FILES[2:6]:
            text = (REPO / rel).read_text()
            head = text.split("\n---\n", 1)[0]
            self.assertNotIn("Write GitHub text", head, rel)
            self.assertTrue(text.startswith("---\n"), rel)


_CG = sb.load_cpu_guard()
ORIGINAL_MEMORY_READING, ORIGINAL_PROCESS_TABLE = _CG.memory_reading, _CG.process_table   # the real readers, kept before a test patches them


class TestCpuConsumersAndMemory(Base):
    """Ask #420: the cpu alarm names its consumers by program and lane (a late answer is one follow-up note), and a mem line and alarm that read the kernel's
    counters and process table without starting a process."""

    PS3 = ("  101  60.0 /usr/local/bin/node --token=SECRET123\n  102  25.0 /Applications/Docker.app/Contents/MacOS/com.docker.backend\n"
           "  103  12.0 /usr/bin/python3\n  104   2.0 /bin/zsh\n  garbage\n")
    GB = 10 ** 9

    def setUp(self):
        super().setUp()
        self.load = [86.0]
        self.world = World(self, agents=("coder",), config={})
        self.world.add_agent("cos", fleet={"role": "chief-of-staff"})
        self.engine = self.world.engine
        self.engine.discover(self.world.clock.now())
        self.cg = sb.load_cpu_guard()
        self.mem = [self.cg.Memory(1 * self.GB, 10 * self.GB, 3 * self.GB)]
        self.table = [{"opencode": (62, 18000 * 10 ** 6), "node": (3, 900 * 10 ** 6)}]
        self.calls = []
        self.ps_text = [self.PS3]
        self.lsof_text = ["p101\nfcwd\nn/work/acme.wt/sb-one/src\np102\nfcwd\nn/elsewhere/x\np103\nfcwd\nn/work/acme.wt/sb-two\n"]
        self.block = [None]
        self.ps_error = [None]
        for target, name, value in ((os, "getloadavg", lambda: (self.load[0],) * 3), (os, "cpu_count", lambda: 14)):
            patcher = mock.patch.object(target, name, value)
            patcher.start()
            self.addCleanup(patcher.stop)
        for name, value in (("memory_reading", lambda: self.mem[0]), ("process_table", lambda *a, **k: self.table[0])):
            patcher = mock.patch.object(self.cg, name, value)
            patcher.start()
            self.addCleanup(patcher.stop)

        def runner(argv, **kwargs):
            self.calls.append(list(argv))
            if self.block[0] is not None:
                self.block[0].wait(30)
            if self.ps_error[0] is not None:
                raise self.ps_error[0]
            text = self.lsof_text[0] if argv[0] == "lsof" else self.ps_text[0]
            return subprocess.CompletedProcess(argv, 0, text, "")
        self.engine.cpu_ps_runner = runner
        sb.register_worktree(self.world.state, "/work/acme.wt/sb-one", "coder-live", None, "b1", 1)

    def facts(self, kinds=("cpu", "cpu-top", "mem"), engine=None):
        found, problems = (engine or self.engine).collect_facts()
        self.assertEqual(problems, [])
        return [f for f in found if f.kind in kinds]

    def audits(self, name):
        return [e for e in self.world.audit() if e["event"] == name]

    def run_for(self, minutes, step=30, kinds=("cpu", "cpu-top", "mem")):
        last = []
        for _ in range(int(minutes * 60 / step)):
            self.world.tick(step)
            if self.block[0] is None:
                self.settle()   # the consumers thread has finished before the next pass: no race with the clock
            last = self.facts(kinds)
        return last

    def settle(self):
        for source in self.engine.sources:
            if isinstance(source, sb.CpuFacts) and source.thread is not None:
                source.thread.join(10)

    def test_s1_the_wake_names_the_top_programs_and_their_lanes_and_copies_no_command_line(self):
        self.run_for(6, kinds=("cpu",))
        self.settle()
        (fact,) = self.run_for(0.5, kinds=("cpu",))
        self.assertIn("top: node 60% (coder-live)", fact.summary)
        self.assertIn("com.docker.backend 25%", fact.summary)
        self.assertIn("python3 12% (sb-two)", fact.summary, "a worktree no agent is registered for is named by its directory")
        self.assertNotIn("SECRET123", fact.summary)
        self.assertNotIn("--token", fact.summary)
        self.assertEqual([c[0] for c in self.calls], ["ps", "lsof"], "one ps and one lsof for the whole episode")
        self.assertEqual(self.calls[1][-1], "101,102,103,104")

    def test_s2_a_late_answer_is_one_follow_up_note_and_the_wake_says_it_is_coming(self):
        gate = threading.Event()
        self.block[0] = gate
        self.run_for(6, kinds=("cpu",))
        (wake,) = self.run_for(0.5, kinds=("cpu",))
        self.assertIn("Consumers not read within", wake.summary)
        self.assertNotIn("top:", wake.summary)
        self.assertEqual(self.run_for(0.5, kinds=("cpu-top",)), [])
        gate.set()
        self.settle()
        notes = self.run_for(1, kinds=("cpu-top",))
        self.assertEqual(len({f.key for f in notes}), 1)
        self.assertIn("top: node 60% (coder-live)", notes[0].summary)
        keys = {f.key for _ in range(6) for f in self.run_for(0.5, kinds=("cpu-top",))}
        self.assertEqual(keys, {notes[0].key}, "the same key on every later pass: delivered once, never a second note")

    def test_s3_a_ps_that_never_answers_or_fails_is_said_once_and_sends_no_follow_up(self):
        gate = threading.Event()
        self.block[0] = gate
        self.run_for(6, kinds=("cpu",))
        wakes = {(f.key, f.summary) for _ in range(3) for f in self.run_for(0.5, kinds=("cpu",))}
        self.assertEqual(len({k for k, _ in wakes}), 1)
        self.assertTrue(all("not read within" in text for _, text in wakes))
        self.assertEqual(self.run_for(2, kinds=("cpu-top",)), [], "nothing came, so there is no follow-up")
        gate.set()
        self.settle()

    def test_a_ps_that_fails_says_the_consumers_could_not_be_read(self):
        self.ps_error[0] = OSError("no ps")
        self.run_for(6, kinds=("cpu",))
        self.settle()
        (fact,) = self.run_for(0.5, kinds=("cpu",))
        self.assertIn("Consumers could not be read.", fact.summary)
        self.assertEqual(self.run_for(1, kinds=("cpu-top",)), [])

    def test_a_failing_lsof_still_names_the_programs_without_lanes(self):
        self.lsof_text[0] = ""
        self.run_for(6, kinds=("cpu",))
        self.settle()
        (fact,) = self.run_for(0.5, kinds=("cpu",))
        self.assertIn("top: node 60%", fact.summary)
        self.assertNotIn("(coder-live)", fact.summary)

    def test_s4_the_mem_line_shows_swap_free_and_the_biggest_holders_and_starts_no_process(self):
        self.mem[0] = self.cg.Memory(int(9.1 * self.GB), int(10.2 * self.GB), int(0.9 * self.GB))
        expected = "swap 9.1 of 10.2 GB (89%), free 0.9 GB; opencode 62 procs 18000 MB, node 3 procs 900 MB"
        with mock.patch.object(subprocess, "run", side_effect=AssertionError("a process was started")), \
                mock.patch.object(subprocess, "Popen", side_effect=AssertionError("a process was started")):
            self.assertEqual(self.cg.mem_status_line(self.cg.memory_reading(), self.cg.biggest_holders(self.cg.process_table())), expected)
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.assertIn("mem        " + expected, sb.format_status(sb.collect_status(self.world.route, self.world.clock.now)))

    def test_s5_swap_above_the_guard_for_the_minutes_wakes_once_and_recovers_below_it(self):
        self.mem[0] = self.cg.Memory(int(9.5 * self.GB), 10 * self.GB, 1 * self.GB)
        self.load[0] = 5.0
        self.assertEqual(self.run_for(4, kinds=("mem",)), [], "4 minutes: not yet")
        keys = {f.key for f in self.run_for(1.5, kinds=("mem",))}
        self.assertEqual(len(keys), 1)
        (fact,) = self.run_for(0.5, kinds=("mem",))
        self.assertIn("memory high: swap 9.5 of 10.0 GB (95%; above 90% for 5 minutes)", fact.summary)
        self.assertIn("opencode 62 procs 18000 MB", fact.summary)
        self.assertEqual(len({f.key for _ in range(10) for f in self.run_for(0.5, kinds=("mem",))}), 1, "while it stays high: no second wake")
        self.assertEqual(len(self.audits("mem.high")), 1)
        self.mem[0] = self.cg.Memory(5 * self.GB, 10 * self.GB, 4 * self.GB)
        self.assertEqual(self.run_for(1, kinds=("mem",)), [])
        self.assertEqual(len(self.audits("mem.recovered")), 1)

    def test_a_restart_does_not_begin_a_second_memory_episode(self):
        self.mem[0] = self.cg.Memory(int(9.5 * self.GB), 10 * self.GB, 1 * self.GB)
        self.load[0] = 5.0
        self.run_for(6, kinds=("mem",))
        (first,) = self.run_for(0.5, kinds=("mem",))
        restarted = self.world.new_engine("daemon")
        restarted.discover(self.world.clock.now())
        for _ in range(4):
            self.world.tick(30)
            facts = self.facts(("mem",), engine=restarted)
        self.assertEqual([f.key for f in facts], [first.key])
        self.assertEqual(len(self.audits("mem.high")), 1)
        self.assertEqual(oct((self.world.state / self.cg.MEM_STATE_FILE).stat().st_mode & 0o777), "0o600")

    def test_s6_an_unreadable_memory_figure_says_so_and_is_never_a_zero(self):
        self.mem[0] = self.cg.Memory(problem="vm.swapusage cannot be read")
        self.assertEqual(self.cg.mem_status_line(self.mem[0]), "unreadable: vm.swapusage cannot be read")
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        text = sb.format_status(sb.collect_status(self.world.route, self.world.clock.now))
        self.assertIn("mem        unreadable: vm.swapusage cannot be read", text)
        self.assertNotIn("0.0 GB", self.cg.mem_status_line(self.mem[0]))
        self.load[0] = 5.0
        self.assertEqual(self.run_for(10, kinds=("mem",)), [], "an unreadable figure wakes nobody")
        self.assertEqual(self.cg.mem_status_line(self.cg.Memory(1 * self.GB, 10 * self.GB, None)), "swap 1.0 of 10.0 GB (10%), free memory unreadable")
        self.assertEqual(self.cg.mem_status_line(self.cg.Memory(0, 0, 2 * self.GB)), "no swap, free 2.0 GB")

    def test_s7_a_normal_pass_starts_no_process(self):
        self.load[0] = 5.0
        with mock.patch.object(subprocess, "run", side_effect=AssertionError("a process was started")), \
                mock.patch.object(subprocess, "Popen", side_effect=AssertionError("a process was started")):
            self.assertEqual(self.run_for(10), [])
        self.assertEqual(self.calls, [])

    def test_s8_nothing_of_a_command_line_reaches_the_wake_or_the_follow_up(self):
        self.ps_text[0] = "  101  60.0 /x/tool --password=hunter2 --token=SECRET123\n  102 10.0 /y/runner secret=abc\n"
        self.run_for(6)
        self.settle()
        texts = " ".join(f.summary for f in self.run_for(1))
        self.assertIn("tool 60%", texts)
        for needle in ("hunter2", "SECRET123", "secret=abc", "--password"):
            self.assertNotIn(needle, texts)

    def test_the_lane_is_the_owning_agent_then_the_worktree_name_then_nothing(self):
        registry = {"/work/acme.wt/sb-one": "coder-live", "/work/acme.wt/sb-one/deep": "inner-agent"}
        self.assertEqual(self.cg.lane_of("/work/acme.wt/sb-one/src", registry), "coder-live")
        self.assertEqual(self.cg.lane_of("/work/acme.wt/sb-one/deep/x", registry), "inner-agent", "the longest registered path wins")
        self.assertEqual(self.cg.lane_of("/work/acme.wt/sb-two/a", registry), "sb-two")
        self.assertIsNone(self.cg.lane_of("/home/user/notes", registry))
        self.assertEqual(self.cg.lane_of("/work/acme.wt/x", {"/work/acme.wt/x": "bad\x1b[2Jname"}), "bad??2Jname")

    def test_the_swap_settings_are_validated_and_false_turns_the_memory_guard_off(self):
        for ok in ({"swap_percent": 95}, {"swap_minutes": 10}, {"swap_percent": 80, "swap_minutes": 2, "high_ratio": 4}):
            sb.validate_config(dict({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR}, cpu_guard=ok), "t")
        for bad in ({"swap_percent": 5}, {"swap_percent": 101}, {"swap_percent": "90"}, {"swap_minutes": 0}, {"swap_minutes": 500}):
            with self.subTest(bad=bad):
                with self.assertRaises(sb.ConfigError):
                    sb.validate_config(dict({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR}, cpu_guard=bad), "t")
        self.assertEqual(self.cg.mem_settings(None), {"high_ratio": 90, "minutes": 5, "rearm_ratio": 80})
        self.assertEqual(self.cg.mem_settings({"swap_percent": 95, "swap_minutes": 2})["minutes"], 2)
        self.assertIsNone(self.cg.mem_settings(False))
        self.mem[0] = self.cg.Memory(int(9.9 * self.GB), 10 * self.GB, 1 * self.GB)
        self.engine.config["cpu_guard"] = False
        self.assertEqual(self.run_for(10), [])

    def test_the_parsers_and_the_linux_readers_are_tested_directly(self):
        self.assertEqual(self.cg.parse_lsof("p7\nfcwd\nn/a/b\np8\nfcwd\nn/c\nn/ignored-second\nxjunk\n"), {7: "/a/b", 8: "/c"})
        self.assertEqual(self.cg.parse_lsof(""), {})
        rows = self.cg.process_rows("  12  3.5 /bin/a\n 7.0 /bin/b c\n bad line\n  9  nan /x\n  8 -1 /y\n")
        self.assertEqual([(p, c) for p, c, _ in rows], [(12, 3.5), (None, 7.0)], "a non-finite or negative pcpu and a malformed line are dropped")
        self.assertEqual(self.cg.top_pids([(1, 5.0, "a"), (None, 9.0, "b"), (2, 7.0, "c"), (3, 1.0, "d")], limit=2), [2, 1])
        meminfo = "MemTotal: 1000 kB\nMemAvailable:    2048 kB\nSwapTotal:   10240 kB\nSwapFree:     4096 kB\n"
        real = sb.load_cpu_guard()
        with mock.patch.object(real.sys, "platform", "linux"), mock.patch("builtins.open", mock.mock_open(read_data=meminfo)):
            got = ORIGINAL_MEMORY_READING()
        self.assertEqual((got.swap_used, got.swap_total, got.free, got.problem), (6144 * 1024, 10240 * 1024, 2048 * 1024, None))
        with mock.patch.object(real.sys, "platform", "linux"), mock.patch("builtins.open", mock.mock_open(read_data="MemTotal: 1 kB\n")):
            self.assertIn("no swap figures", ORIGINAL_MEMORY_READING().problem)
        with mock.patch.object(real.sys, "platform", "plan9"):
            self.assertIn("no memory counters", ORIGINAL_MEMORY_READING().problem)
        with mock.patch.object(real.sys, "platform", "linux"), mock.patch("builtins.open", side_effect=OSError("denied")):
            self.assertEqual(ORIGINAL_MEMORY_READING().problem, "OSError: denied")
        with mock.patch.object(real.sys, "platform", "plan9"):
            self.assertIsNone(ORIGINAL_PROCESS_TABLE())

    def test_the_real_counters_and_process_table_start_no_process(self):
        if sys.platform not in ("darwin",) and not sys.platform.startswith("linux"):
            self.skipTest("no kernel counters on this platform")
        with mock.patch.object(subprocess, "run", side_effect=AssertionError("a process was started")), \
                mock.patch.object(subprocess, "Popen", side_effect=AssertionError("a process was started")):
            mem = ORIGINAL_MEMORY_READING()
            table = ORIGINAL_PROCESS_TABLE()
        self.assertIsNone(mem.problem, "the kernel's counters could not be read here")
        self.assertTrue(mem.swap_total >= 0 and mem.swap_used <= max(mem.swap_total, mem.swap_used))
        self.assertTrue(table and all(count >= 1 and resident >= 0 for count, resident in table.values()))
        self.assertLessEqual(len(table), self.cg.PROGRAMS_MAX)

    def test_the_process_table_walk_stops_at_its_deadline(self):
        if sys.platform != "darwin" and not sys.platform.startswith("linux"):
            self.skipTest("no kernel counters on this platform")
        ticks = iter(range(0, 10 ** 6, 10))
        table = ORIGINAL_PROCESS_TABLE(limit_seconds=5, clock=lambda: next(ticks))   # the clock jumps past the deadline at once
        self.assertLessEqual(sum(count for count, _ in (table or {}).values()), 1)

    def test_the_process_table_ranking_and_a_missing_table_are_handled(self):
        self.assertEqual(self.cg.biggest_holders(None), [])
        self.assertEqual(self.cg.biggest_holders({}), [])
        self.assertEqual(self.cg.biggest_holders({"a": (1, 5 * 10 ** 6), "b": (2, 9 * 10 ** 6)}), [("b", 2, 9), ("a", 1, 5)])


class TestDiskGuard(Base):
    """The disk guard: one stat of the state directory's volume per pass; the Chief of Staff is told once per episode below disk_guard.min_free_gb; `status`
    says how much is free; `disk prune` runs exactly two docker commands and refuses without docker."""

    GB = 10 ** 9

    def setUp(self):
        super().setUp()
        self.free = [200 * self.GB]
        self.stats = []
        self.world = World(self, agents=("coder",), config={})
        self.world.add_agent("cos", fleet={"role": "chief-of-staff"})
        self.engine = self.world.engine
        self.engine.discover(self.world.clock.now())

        self.after_prune = None

        def usage(path):
            self.stats.append(str(path))
            free = self.after_prune if self.after_prune is not None and len(self.stats) > 1 else self.free[0]
            return collections.namedtuple("usage", "total used free")(1000 * self.GB, 1000 * self.GB - free, free)
        patcher = mock.patch.object(sb.shutil, "disk_usage", usage)
        patcher.start()
        self.addCleanup(patcher.stop)

    def facts(self, engine=None):
        engine = engine or self.engine
        found, problems = engine.collect_facts()
        self.assertEqual(problems, [])
        return [f for f in found if f.kind == "disk"]

    def audits(self, name):
        return [e for e in self.world.audit() if e["event"] == name]

    def test_the_config_key_is_validated_and_off_means_off(self):
        for ok in (None, False, {}, {"min_free_gb": 80}, {"min_free_gb": 80, "hard_free_gb": 20}, {"hard_free_gb": 0}):
            sb.validate_disk_guard(ok, "t")
        for bad in (True, 5, [], {"min_free_gb": -1}, {"min_free_gb": "50"}, {"nope": 1}, {"min_free_gb": 5, "hard_free_gb": 10}, {"hard_free_gb": 60}):
            with self.subTest(bad=bad):
                with self.assertRaises(sb.ConfigError):
                    sb.validate_disk_guard(bad, "t")
        self.assertEqual(sb.disk_guard_settings({}), {"min_free_gb": 50, "hard_free_gb": 10})
        self.assertIsNone(sb.disk_guard_settings({"disk_guard": False}))

    def test_the_status_line_says_how_much_is_free_and_when_it_is_low(self):
        self.free[0] = 238 * self.GB
        self.assertEqual(sb.disk_status_line({}, self.world.state), "238 GB free (24%)")   # 238 of the 1000 GB the stand-in volume has, 23.8%
        self.free[0] = 30 * self.GB
        self.assertEqual(sb.disk_status_line({}, self.world.state), "30 GB free (3%): LOW (below 50 GB; hard line 10 GB)")
        self.free[0] = 5 * self.GB
        self.assertIn("VERY LOW", sb.disk_status_line({}, self.world.state))
        self.assertIn("below 80 GB", sb.disk_status_line({"disk_guard": {"min_free_gb": 80}}, self.world.state))

    def test_status_shows_the_disk_line_and_not_when_the_guard_is_off(self):
        self.free[0] = 238 * self.GB
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.assertIn("disk       238 GB free", sb.format_status(sb.collect_status(self.world.route, self.world.clock.now)))
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "disk_guard": False})
        self.assertNotIn("disk       ", sb.format_status(sb.collect_status(self.world.route, self.world.clock.now)))

    def test_one_stat_per_pass_and_nothing_while_the_disk_is_fine(self):
        for _ in range(5):
            self.assertEqual(self.facts(), [])
        self.assertEqual(len(self.stats), 5, "one disk_usage per collection: no walk")
        self.assertEqual(self.audits("disk.low"), [])

    def test_the_chief_of_staff_is_told_once_per_episode_and_the_episode_ends_above_the_threshold_plus_ten_percent(self):
        self.free[0] = 40 * self.GB
        (first,) = self.facts()
        self.assertEqual((first.recipient, first.kind, first.sender), ("cos", "disk", "switchboard"))
        self.assertIn("disk low: 40 GB free", first.summary)
        for free in (38, 30, 52, 54):                       # lower, and back up but not above 55
            self.free[0] = free * self.GB
            self.world.tick(30)
            (again,) = self.facts()
            self.assertEqual(again.key, first.key, "the same episode: the same key, so it is delivered once")
        self.assertEqual(len(self.audits("disk.low")), 1, "audited once")
        self.free[0] = 56 * self.GB                         # above 50 + 10%
        self.assertEqual(self.facts(), [])
        self.assertEqual(len(self.audits("disk.recovered")), 1)
        self.world.tick(100)
        self.free[0] = 45 * self.GB
        (second,) = self.facts()
        self.assertNotEqual(second.key, first.key, "a new episode: a new fact")
        self.assertEqual(len(self.audits("disk.low")), 2)

    def test_two_episodes_that_recover_at_the_same_figure_are_both_audited(self):
        for episode in range(2):
            self.free[0] = 40 * self.GB
            self.world.tick(100)
            self.facts()
            self.free[0] = 60 * self.GB   # the same figure each time
            self.facts()
        self.assertEqual(len(self.audits("disk.low")), 2)
        self.assertEqual(len(self.audits("disk.recovered")), 2, "not swallowed as a repeat of the same detail")

    def test_a_restart_does_not_begin_a_second_episode_and_a_hard_line_is_said_once(self):
        self.free[0] = 40 * self.GB
        (first,) = self.facts()
        self.assertEqual(json.loads((self.world.state / sb.DISK_GUARD_FILE).read_text())["low"], True)
        self.assertEqual(stat.S_IMODE(os.stat(str(self.world.state / sb.DISK_GUARD_FILE)).st_mode), 0o600)
        self.world.tick(60)
        restarted = self.world.new_engine("daemon")
        restarted.discover(self.world.clock.now())
        (again,) = self.facts(restarted)
        self.assertEqual(again.key, first.key)
        self.assertEqual(len(self.audits("disk.low")), 1)
        self.free[0] = 8 * self.GB
        self.facts(restarted)
        self.facts(restarted)
        self.assertEqual(len(self.audits("disk.hard")), 1, "worse inside the episode: said once, not a second wake")

    def test_the_config_key_is_checked_by_validate_config_too(self):
        sb.validate_config({"opencode": FAKE_OPENCODE, "disk_guard": {"min_free_gb": 80}})
        for bad in ("yes", {"hard_free_gb": 99}):
            with self.assertRaises(sb.ConfigError):
                sb.validate_config({"opencode": FAKE_OPENCODE, "disk_guard": bad})

    def test_with_no_chief_of_staff_no_episode_begins_until_there_is_one_and_an_unreadable_volume_is_audited_once(self):
        solo = World(self, agents=("coder",), config={})
        solo.engine.discover(solo.clock.now())
        self.free[0] = 5 * self.GB
        found, _ = solo.engine.collect_facts()
        self.assertEqual([f for f in found if f.kind == "disk"], [])
        self.assertFalse((solo.state / sb.DISK_GUARD_FILE).exists(), "no episode was opened: nobody to tell")
        solo.add_agent("cos", fleet={"role": "chief-of-staff"})
        solo.engine.discover(solo.clock.now())
        found, _ = solo.engine.collect_facts()
        self.assertEqual(len([f for f in found if f.kind == "disk"]), 1, "the first pass with a Chief of Staff tells it")
        with mock.patch.object(sb.shutil, "disk_usage", side_effect=OSError("gone")):
            self.facts()
            self.facts()
        self.assertEqual(len(self.audits("disk.unreadable")), 1)

    def test_an_episode_that_starts_below_the_hard_line_and_a_zero_size_volume(self):
        self.free[0] = 4 * self.GB
        (fact,) = self.facts()
        self.assertEqual(len(self.audits("disk.low")), 1)
        self.assertTrue(self.audits("disk.low")[0]["detail"]["hard"])
        self.assertEqual(self.audits("disk.hard"), [], "it began hard: nothing worse to say")
        with mock.patch.object(sb.shutil, "disk_usage", lambda path: collections.namedtuple("u", "total used free")(0, 0, 7 * self.GB)):
            self.assertEqual(sb.disk_status_line({}, self.world.state), "7 GB free: VERY LOW (below 50 GB; hard line 10 GB)")

    def test_a_failed_save_of_the_episode_is_said_and_leaves_no_temp_file(self):
        self.free[0] = 40 * self.GB
        with mock.patch.object(sb.os, "replace", side_effect=OSError("disk full")):
            self.assertEqual(len(self.facts()), 1, "the guard still works in memory")
        self.assertEqual(list(self.world.state.glob("disk-guard.json.*.tmp")), [])
        self.assertEqual(len(self.audits("disk.guard_file")), 1)

    def test_a_guard_that_is_off_or_a_volume_that_cannot_be_read_tells_nobody(self):
        self.free[0] = 1 * self.GB
        self.engine.config["disk_guard"] = False
        self.assertEqual(self.facts(), [])
        self.engine.config["disk_guard"] = None
        with mock.patch.object(sb.shutil, "disk_usage", side_effect=OSError("gone")):
            self.assertEqual(self.facts(), [])
            self.assertIsNone(sb.disk_status_line({}, self.world.state))

    # -- disk prune

    def fake_docker(self, name="docker"):
        path = self.home / name
        path.write_text("#!/bin/sh\nexit 0\n")
        os.chmod(str(path), 0o755)
        return str(path)

    def prune(self, *argv, exits=(0, 0, 0), outputs=("Total reclaimed space: 1.2GB", "Total reclaimed space: 300MB", "Total reclaimed space: 5MB"), docker=None, fake=None):
        fake = fake or FakePruneDocker(exits=exits, outputs=outputs)
        path = docker or self.fake_docker()
        with mock.patch.dict(os.environ), captured() as (out, err):
            os.environ.pop("DOCKER_API_VERSION", None)   # a developer's own pin must not decide a test
            code = sb.main(["disk", "prune", "--docker", path, *argv], runner=fake, now=self.world.clock.now)
        self.last_fake = fake
        return code, out.getvalue(), err.getvalue(), [[path] + c for c in fake.prune_calls]

    def test_prune_runs_exactly_the_three_docker_commands_and_prints_what_was_reclaimed(self):
        docker = self.fake_docker()
        self.after_prune = 215 * self.GB   # the second reading of the volume, after the prune
        code, out, err, calls = self.prune(docker=docker)
        self.assertEqual(code, 0, err)
        self.assertEqual(calls, [[docker, "builder", "prune", "-f", "--filter", "until=168h"], [docker, "image", "prune", "-a", "-f", "--filter", "until=168h"],
                                 [docker, "volume", "prune", "-f"]])
        for argv in calls:
            self.assertFalse({"system", "container", "--volumes", "--all"} & set(argv), "never a container or a system prune")
        self.assertEqual([a for a in calls if "volume" in a][0].count("-a"), 0, "the volume prune never passes -a")
        self.assertIn("builder prune: reclaimed 1.2GB", out)
        self.assertIn("image prune: reclaimed 300MB", out)
        self.assertIn("volume prune: reclaimed 5MB", out)
        self.assertRegex(out, r"disk: 200 GB free before, 215 GB after")

    def test_a_dry_run_prints_the_commands_and_runs_none(self):
        code, out, err, calls = self.prune("--dry-run")
        self.assertEqual((code, calls), (0, []))
        self.assertIn("builder prune -f --filter until=168h", out)
        self.assertIn("image prune -a -f --filter until=168h", out)

    VOLUMES = (("anon1", True, True, "1.5MB"), ("anon2", True, True, "1.5MB"), ("named", False, True, "9MB"), ("inuse", True, False, "4MB"), ("bad name\x1b[2J", True, True, "1MB"))

    def test_a_dry_run_lists_the_candidate_anonymous_volumes_and_runs_no_prune(self):
        fake = FakePruneDocker(volumes=self.VOLUMES)
        code, out, err, calls = self.prune("--dry-run", fake=fake)
        self.assertEqual((code, fake.prune_calls), (0, []))
        self.assertIn("candidate anonymous volumes: 2 (3.0 MB)", out)
        self.assertIn("  anon1", out)
        self.assertNotIn("named", out)
        self.assertNotIn("inuse", out)
        self.assertNotIn("\x1b", out)
        self.assertIn("would run docker volume prune -f (never -a)", out)

    def test_an_unsafe_or_unreadable_server_refuses_the_volume_prune_and_the_other_two_still_run(self):
        cases = (("22.0.1", {"server_api": "1.41", "client_api": "1.41"}, sb.EXIT_OK), ("", {"version_code": 1}, sb.EXIT_ERROR),
                 ("29.7.2", {"client_api": "1.41"}, sb.EXIT_OK),                       # a new server reached by an old-API client
                 ("29.7.2", {"platform": "podman 5.1"}, sb.EXIT_OK))                  # a compatible program, not Docker
        for version, extra, want in cases:
            with self.subTest(version=version, extra=extra):
                fake = FakePruneDocker(version=version or "29.7.2", exits=(0, 0), outputs=("", ""), **extra)
                code, out, err, calls = self.prune(fake=fake)
                self.assertEqual([c[1:3] for c in calls], [["builder", "prune"], ["image", "prune"]])
                self.assertIn("volume prune: refused", out)
                self.assertEqual(code, want)
        with mock.patch.dict(os.environ, {"DOCKER_API_VERSION": "1.41"}):
            fake = FakePruneDocker(exits=(0, 0), outputs=("", ""))
            with captured() as (out_, err_):
                sb.main(["disk", "prune", "--docker", self.fake_docker()], runner=fake, now=self.world.clock.now)
            out, calls = out_.getvalue(), fake.prune_calls
        self.assertEqual(len(calls), 2)
        self.assertIn("DOCKER_API_VERSION=1.41", out)
        fake = FakePruneDocker(version="23.0.0", server_api="1.42", client_api="1.42", exits=(0, 0, 0), outputs=("", "", ""))
        self.assertEqual(len(self.prune(fake=fake)[3]), 3, "23.0 and API 1.42 are the first that run it")

    def test_a_dry_run_on_an_unsafe_server_says_refused_and_does_not_say_it_would_run(self):
        code, out, err, calls = self.prune("--dry-run", fake=FakePruneDocker(version="22.0.1", server_api="1.41", client_api="1.41"))
        self.assertIn("volume prune: refused", out)
        self.assertIn("the other two would still run", out)
        self.assertNotIn("would run docker volume prune", out)
        self.assertNotIn("the other two ran", out)

    def test_a_dry_run_caps_its_list_counts_past_the_examine_limit_and_says_when_a_size_or_list_is_unreadable(self):
        many = tuple(("v%03d" % i, True, True, "1MB") for i in range(25))
        code, out, err, calls = self.prune("--dry-run", fake=FakePruneDocker(volumes=many))
        self.assertIn("candidate anonymous volumes: 25 (25.0 MB)", out)
        self.assertIn("5 more", out)
        with mock.patch.object(sb, "DISK_VOLUME_LIMIT", 10):
            code, out, err, calls = self.prune("--dry-run", fake=FakePruneDocker(volumes=many))
        self.assertIn("candidate anonymous volumes: >=10 ", out)
        code, out, err, calls = self.prune("--dry-run", fake=FakePruneDocker(volumes=many, df_fails=True))
        self.assertIn("25 (size not read)", out)

    def test_a_dry_run_whose_volume_list_is_unreadable_says_so_and_still_names_the_command(self):
        real = FakePruneDocker()

        def runner(argv, **kwargs):
            if argv[1:3] == ["volume", "ls"]:
                return subprocess.CompletedProcess(argv, 1, "", "daemon down")
            return real(argv, **kwargs)
        with captured() as (out, err):
            code = sb.main(["disk", "prune", "--dry-run", "--docker", self.fake_docker()], runner=runner, now=self.world.clock.now)
        self.assertIn("candidate anonymous volumes: not readable", out.getvalue())
        self.assertIn("would run docker volume prune -f", out.getvalue())

    def test_a_failing_or_raising_volume_prune_is_said_exits_with_an_error_and_the_first_two_still_ran(self):
        fake = FakePruneDocker(exits=(0, 0, 1), outputs=("", "", ""))
        code, out, err, calls = self.prune(fake=fake)
        self.assertEqual((code, len(calls)), (sb.EXIT_ERROR, 3))
        self.assertIn("volume prune: failed (exit 1)", out)
        real = FakePruneDocker()

        def runner(argv, **kwargs):
            if argv[1:3] == ["volume", "prune"]:
                raise subprocess.TimeoutExpired(argv, 600)
            return real(argv, **kwargs)
        with captured() as (out, err):
            code = sb.main(["disk", "prune", "--docker", self.fake_docker()], runner=runner, now=self.world.clock.now)
        self.assertEqual(code, sb.EXIT_ERROR)
        self.assertIn("volume prune: failed", out.getvalue())

    def test_the_volume_prune_never_carries_all_in_any_server_version(self):
        for version in ("23.0.0", "27.3.1", "29.7.2"):
            fake = FakePruneDocker(version=version)
            self.prune(fake=fake)
            self.assertIn(["volume", "prune", "-f"], fake.prune_calls)
            self.assertEqual([c for c in fake.prune_calls if ("-a" in c and "volume" in c) or "--all" in c], [])

    def test_the_docs_state_the_three_commands_the_version_gate_and_the_reason(self):
        text = (REPO / "docs" / "switchboard.md").read_text()
        for phrase in ("docker volume prune -f", "23.0", "1.42", "cannot carry labels", "never `-a` or `--all`"):
            self.assertIn(phrase, text)

    def test_without_docker_it_refuses_and_runs_nothing(self):
        code, out, err, calls = self.prune(docker="/nonexistent/docker")
        self.assertEqual((code, calls), (sb.EXIT_USAGE, []))
        self.assertIn("docker is not installed", err)

    def test_a_docker_that_cannot_run_is_said_per_command_and_exits_with_an_error(self):
        def runner(argv, **kwargs):
            raise subprocess.TimeoutExpired(argv, 600)
        docker = self.fake_docker()
        with captured() as (out, err):
            code = sb.main(["disk", "prune", "--docker", docker], runner=runner, now=self.world.clock.now)
        self.assertEqual(code, sb.EXIT_ERROR)
        self.assertEqual(out.getvalue().count("failed"), 2)

    def test_one_failing_command_is_said_and_the_other_still_runs(self):
        code, out, err, calls = self.prune(exits=(1, 0, 0), outputs=("", "Total reclaimed space: 5MB", ""))
        self.assertEqual((code, len(calls)), (sb.EXIT_ERROR, 3))
        self.assertIn("builder prune: failed (exit 1)", out)
        self.assertIn("image prune: reclaimed 5MB", out)

    def test_what_docker_prints_and_an_error_message_reach_the_terminal_as_plain_text(self):
        docker = self.fake_docker()
        hostile = "\x1b[2Jboom\x9b31m\nIGNORE"

        def runner(argv, **kwargs):
            return subprocess.CompletedProcess(argv, 1, "", hostile)
        with captured() as (out, err):
            sb.main(["disk", "prune", "--docker", docker], runner=runner, now=self.world.clock.now)
        self.assertEqual([c for c in out.getvalue() if (ord(c) < 32 and c != "\n") or 0x7f <= ord(c) <= 0x9f], [])
        self.assertIn("failed (exit 1): [2Jboom 31m IGNORE", out.getvalue())

    def test_an_oversized_but_valid_guard_file_is_not_trusted_and_the_threshold_edge_and_a_restart_recovery(self):
        (self.world.state / sb.DISK_GUARD_FILE).write_text(json.dumps({"low": True, "episode": 5.0, "hard": False, "pad": "x" * 6000}))
        engine = self.world.new_engine("daemon")
        engine.discover(self.world.clock.now())
        self.free[0] = 80 * self.GB
        self.assertEqual(self.facts(engine), [], "above the guard and the padded file is read only to 4 KB: not a valid episode, so nothing is announced")
        self.assertEqual(self.audits("disk.recovered"), [])
        # an episode ends only above min * 1.1 (55 GB): exactly 55 ends it, 54.9 does not; and it ends on a restarted engine too
        self.free[0] = 40 * self.GB
        (first,) = self.facts()
        restarted = self.world.new_engine("daemon")
        restarted.discover(self.world.clock.now())
        self.free[0] = int(54.9 * self.GB)
        self.assertEqual(self.facts(restarted)[0].key, first.key, "54.9 GB: still inside the episode")
        self.free[0] = 55 * self.GB
        self.assertEqual(self.facts(restarted), [], "exactly min * 1.1: the episode is over")
        self.assertEqual(len(self.audits("disk.recovered")), 1)

    def test_a_garbage_or_oversized_guard_file_starts_a_fresh_episode_and_the_guard_still_works(self):
        for text in ("not json", "[]", " " * 10000, '{"low": true, "episode": "x"}'):
            with self.subTest(text=text[:12]):
                (self.world.state / sb.DISK_GUARD_FILE).write_text(text)
                engine = self.world.new_engine("daemon")
                engine.discover(self.world.clock.now())
                self.free[0] = 40 * self.GB
                self.assertEqual(len(self.facts(engine)), 1)

    def test_the_docs_give_a_weekly_launchd_snippet_and_do_not_install_it(self):
        text = (REPO / "docs" / "switchboard.md").read_text()
        self.assertIn("StartCalendarInterval", text)
        self.assertIn("disk prune", text)
        self.assertIn("not installed", text)


class LightProbe:
    """Makes `Switchboard.light` observable: every read of it records the source line that asked, and a chosen set of lines is told `False` (the guard removed there)
    while every other line is told `True`. It changes no code: the same engine, the same fake source, one guard at a time."""

    FILE = str(SWITCHBOARD)

    def __init__(self, flip=()):
        self.flip, self.hits = set(flip), collections.Counter()

    def __enter__(self):
        probe = self

        def get(engine):
            frame = sys._getframe(1)
            if frame.f_code.co_filename == probe.FILE:
                probe.hits[frame.f_lineno] += 1
                if any(lo <= frame.f_lineno <= hi for lo, hi in probe.flip):
                    return False
            return engine.__dict__["light"]

        def put(engine, value):
            engine.__dict__["light"] = value
        self.patch = mock.patch.object(sb.Switchboard, "light", property(get, put), create=True)
        self.patch.start()
        return self

    def __exit__(self, *exc):
        self.patch.stop()

    def touched(self, lo, hi):
        return sum(n for line, n in self.hits.items() if lo <= line <= hi)


def light_guard_sites():
    """Every READ of `engine.light` in bin/fleet-switchboard, derived from the code: (qualified function, ordinal in it) -> (first line, last line)."""
    tree, found, counts = ast.parse(Path(SWITCHBOARD).read_text()), {}, collections.Counter()

    def walk(node, stack):
        for child in ast.iter_child_nodes(node):
            inner = stack + [child.name] if isinstance(child, (ast.FunctionDef, ast.ClassDef)) else stack
            asked = isinstance(child, ast.Attribute) and child.attr == "light" and isinstance(child.ctx, ast.Load)
            asked = asked or (isinstance(child, ast.Call) and isinstance(child.func, ast.Name) and child.func.id == "getattr" and len(child.args) >= 2
                              and isinstance(child.args[1], ast.Constant) and child.args[1].value == "light")
            if asked:
                owner = ".".join(stack)
                counts[owner] += 1
                found[(owner, counts[owner])] = (child.lineno, child.end_lineno)
            walk(child, inner)
    walk(tree, [])
    return found


class TestV2LightGuards(Base):
    """#977, rev-1: what `v2_light` keeps OFF is pinned at the GUARDS, through the code that asks, not through the inner reader. Every read of `engine.light` in bin/fleet-switchboard
    is derived from the code (an AST walk), each must have a row in SITES, and each row that is a read guard names the real caller (a pass, or the function that holds the guard) that
    makes the read when the guard is gone. The probe tells exactly one guard (and the ones under it) `False`: the same engine, the same fake source, one guard removed. The case
    passes only when the guarded run makes NO session read beyond the allowed write-gate read, the site was reached, and the run with the guard removed makes MORE calls.

    A member that has two guards in a row (the caller's and the reader's) is defended twice: removing one alone is masked by the other, so its row removes the pair."""

    FORBIDDEN = ("session.message.list", "session.inbox.list", "session.list")
    ALLOWED = {("session.message.list", "type=user")}   # the engagement gate's one small read just before a write (the person's last prompt)

    # (function, ordinal) -> (member index of V2_LIGHT_OFF or a kind, scenario that drives the real caller, the other guards removed with it)
    SITES = {
        ("feed_tick", 1): ("covered", "the feed's own test: test_the_owners_light_switch_means_the_feed_makes_no_read_of_session_history", ()),
        ("V2Reads.human_prompts_newest", 1): (0, "newest", ()),
        ("V2Reads._list_due", 1): ("list", "stale", (("V2Reads.listed", 1),)),
        ("V2Reads.listed", 1): ("list", "idle", ()),
        ("V2Reads.human_prompt", 1): (0, "person", (("V2Reads.human_prompts_newest", 1),)),
        ("V2Reads.inbox", 1): (2, "idle", (("Switchboard.unread_count", 1), ("Switchboard.convert_lapsed_notes", 1))),
        ("V2Reads.compaction_page", 1): (1, "compact", ()),
        ("Switchboard.__init__", 1): ("ledger", "the sent-keys ledger exists only under light: not a read", ()),
        ("Switchboard.delivered_keys", 1): (4, "person", ()),
        ("Switchboard._plan_pending", 1): ("allowed", "the write gate's one read: it ADDS the read before a delivery, so removing it removes a read", ()),
        ("Switchboard.deliver", 1): ("ledger", "the sent-keys ledger reserves before a write: not a read", ()),
        ("Switchboard.deliver", 2): ("ledger", "the sent-keys ledger: not a read", ()),
        ("Switchboard.deliver", 3): ("ledger", "the sent-keys ledger: not a read", ()),
        ("Switchboard.waiting_earlier", 1): (2, "waiting", (("V2Reads.inbox", 1),)),
        ("Switchboard.convert_lapsed_notes", 1): (2, "idle", (("V2Reads.inbox", 1),)),
        ("Switchboard.unread_count", 1): (2, "idle", (("V2Reads.inbox", 1),)),
        ("Switchboard.send", 1): ("no-read", "whether a folded question keeps its issue: nothing is read", ()),
        ("Switchboard.report", 1): ("no-read", "reads the daemon's own last-reports.json (a state file), never a session", ()),
        ("brief_in_transcript", 1): (6, "brief", ()),
        ("inbox_human_prompts", 1): (0, "newest", ()),
        ("WorkerFacts.last_reply", 1): (3, "stop", ()),
        ("triage_stop", 1): (3, "stop", ()),
        ("synthetic_lines", 1): (5, "lines", (("transcript_lines", 1),)),
        ("transcript_lines", 1): (5, "transcript", ()),
        ("chat_clear_live_now", 1): ("chat", "the live decision: shadow under light; pinned by TestChatClearHook test_light_live_route_* and test_light_live_every_route_*", ()),
        ("chat_clear_prompts", 1): ("chat", "the ONE allowed read: pinned by TestChatClearHook (S1 to S4)", ()),
    }

    def world(self, **config):
        world = World(self, agents=("platform", "coder", "cos"), config=dict({"v2_cache_seconds": 900, "v2_light": True}, **config))
        world.v2.sessions[world.sessions["cos"]]["metadata"]["fleet"]["role"] = "chief-of-staff"
        return world

    @staticmethod
    def passes(world, n=3, gap=30):
        for _ in range(n):
            world.engine.run_pass()
            world.tick(gap)

    def drive(self, name, world):
        engine, sid = world.engine, world.sessions["platform"]
        now = world.clock.now()
        if name == "idle":
            self.passes(world)
        elif name == "stale":   # remembered answers have gone stale and the pass's read budget is one: the shared list is what would refill them
            self.passes(world, 4, 200)
        elif name == "person":
            world.you("platform", "hello")
            world.tick(5)
            self.passes(world)
        elif name == "compact":
            world.v2.compact(sid)
            self.passes(world)
        elif name == "stop":
            world.v2.start_turn(world.sessions["coder"], "work", fleet=True, lasts=10)
            world.tick(30)
            self.passes(world, 4, 60)
        elif name == "report":
            world.v2.sessions[world.sessions["coder"]]["metadata"]["fleet"]["reports_to"] = "cos"
            world.tick(5)
            world.new_engine("cli").report("coder", "question", "which one?")
            self.passes(world, 2)
        elif name == "newest":
            sb.newest_prompts(engine, world.sessions["cos"])
        elif name == "waiting":
            discovery = engine.discover(now)
            engine.waiting_earlier(discovery, "platform", "coder", "acme/app", 5, now)
        elif name == "brief":
            sb.brief_in_transcript(engine, sid)
        elif name == "lines":
            sb.synthetic_lines(engine, sid, 0, waiting=True)
        elif name == "transcript":
            sb.transcript_lines(engine, sid, 0)
        else:
            raise AssertionError(name)

    def forbidden(self, world):
        out = collections.Counter()
        for call in world.v2.calls:
            if len(call) > 2 and call[1] == "api" and call[2] in self.FORBIDDEN:
                kind = [a for a in call if str(a).startswith("type=")]
                out[(call[2], kind[0] if kind else "")] += 1
        return out

    def scenario(self, name, flip=()):
        world = self.world(**({"v2_cache_seconds": 60, "v2_reads_per_pass": 1} if name == "stale" else {}))
        with LightProbe(flip) as probe:
            self.drive(name, world)
        return world, probe

    def test_every_read_of_the_light_switch_has_a_row_and_every_row_a_read(self):
        found = light_guard_sites()
        self.assertEqual(sorted(found), sorted(self.SITES), "a guard site without a row (or a row without a site): add or drop it, with its caller case")

    def test_every_member_of_v2_light_off_is_reached_by_a_guard_row_and_every_off_row_names_a_member(self):
        members = {row[0] for row in self.SITES.values() if isinstance(row[0], int)}
        self.assertEqual(members, set(range(len(sb.V2_LIGHT_OFF))), "the seven members of V2_LIGHT_OFF, each with at least one guard")

    def test_the_rows_that_are_no_read_make_no_session_read_when_their_guard_is_removed(self):
        found = light_guard_sites()
        for key in (("Switchboard.report", 1),):   # (send#1 only decides whether a folded question keeps its issue number: no call in it at all)
            with self.subTest(guard="%s#%d" % key):
                world, probe = self.scenario("report")
                self.assertGreater(probe.touched(*found[key]), 0, "the case never reached this guard")
                flipped, _ = self.scenario("report", flip=[found[key]])
                self.assertEqual(self.forbidden(flipped) - self.forbidden(world), collections.Counter(), "a guard classed as no-read made a session read")

    def test_each_guard_is_reached_holds_and_is_the_one_that_stops_the_read(self):
        found = light_guard_sites()
        for key, (member, driver, together) in sorted(self.SITES.items()):
            if not isinstance(member, int) and member not in ("list",):
                continue
            with self.subTest(guard="%s#%d" % key, member=sb.V2_LIGHT_OFF[member] if isinstance(member, int) else member):
                world, probe = self.scenario(driver)
                base = self.forbidden(world)
                self.assertEqual(set(base) - self.ALLOWED, set(), "under light no session read but the write gate's: %s" % dict(base))
                flipped_world, flipped = self.scenario(driver, flip=[found[key]] + [found[t] for t in together])
                # a reader's guard sits behind its caller's: it is reached only once the caller's is gone, so a pair is reached in the removed run
                self.assertGreater((flipped if together else probe).touched(*found[key]), 0, "the case never reached this guard")
                extra = self.forbidden(flipped_world) - base
                self.assertTrue(extra, "the guard removed (with %s) must make a session read, and did not" % (list(together),))

class TestV2Light(Base):
    """v2_light (the owner's hotfix switch): every optional read of session history is OFF; a send is still delivered, once; the daemon
    still finds its agents. A 20-agent idle fleet costs a handful of calls a minute."""

    AGENTS = tuple("agent%d" % n for n in range(20))
    HISTORY = ("session.message.list", "session.inbox.list")

    def world(self, agents=None, **config):
        config.setdefault("v2_cache_seconds", 900)
        config.setdefault("v2_light", True)
        return World(self, agents=agents or self.AGENTS, config=config)

    @staticmethod
    def ops(world, since=0):
        return dict(collections.Counter(c[2] for c in world.v2.calls[since:] if len(c) > 2 and c[1] == "api"))

    def test_the_default_is_off_and_it_must_be_a_boolean(self):
        self.assertIs(sb.DEFAULTS["v2_light"], False)
        with self.assertRaises(sb.ConfigError):
            sb.validate_config({"opencode": FAKE_OPENCODE, "v2_light": "yes"})

    def test_an_idle_fleet_of_twenty_makes_at_most_ten_calls_a_minute_and_reads_no_history(self):
        world = self.world()
        for _ in range(2):   # the first passes find the agents
            world.engine.run_pass()
            world.tick(30)
        mark = len(world.v2.calls)
        for _ in range(20):   # ten minutes at a 30 s poll
            world.engine.run_pass()
            world.tick(30)
        found = self.ops(world, mark)
        print("v2_light idle: %d calls in 10 minutes: %s" % (sum(found.values()), found))
        self.assertLessEqual(sum(found.values()), 100, found)
        for op in self.HISTORY:
            self.assertEqual(self.ops(world).get(op, 0), 0, "%s is a history read: %s" % (op, self.ops(world)))

    def test_without_the_switch_the_same_fleet_reads_history(self):
        world = self.world(v2_light=False, v2_cache_seconds=0)
        for _ in range(4):
            world.engine.run_pass()
            world.tick(30)
        self.assertGreater(sum(self.ops(world).get(op, 0) for op in self.HISTORY), 20, self.ops(world))

    def test_a_send_is_delivered_once_and_a_restart_does_not_deliver_it_again(self):
        world = self.world(agents=("platform", "coder"))
        world.fact("platform", "lab.fact:1", "First")
        world.tick(90)
        report = world.engine.run_pass()
        self.assertEqual([s["keys"] for s in report["sent"]], [["lab.fact:1"]])
        self.assertEqual(self.ops(world).get("session.inbox.list", 0), 0, self.ops(world))
        self.assertLessEqual(self.ops(world).get("session.message.list", 0), 2, "the engagement gate's read before the write, nothing else")
        world.tick(5)
        self.assertEqual(world.engine.run_pass()["sent"], [], "delivered on the send's own success: not sent again")
        mode = (world.state / sb.SENT_KEYS_FILE).stat().st_mode & 0o777
        self.assertEqual(mode, 0o600)
        world.engine = world.new_engine()   # a restart
        world.tick(5)
        self.assertEqual(world.engine.run_pass()["sent"], [], "the ledger survives a restart")
        self.assertEqual(len(world.admissions("platform")), 1)

    def test_a_person_typing_still_holds_the_wake_back_as_a_note_with_the_switch_on(self):
        world = self.world(agents=("platform", "coder"))
        world.you("platform")
        world.fact("platform", "lab.fact:1")
        world.tick(90)
        mark = len(world.v2.calls)
        world.engine.run_pass()
        (admitted,) = world.admissions("platform")
        self.assertEqual((admitted["resume"], admitted["delivery"]), (False, "steer"), "a note for an engaged person, not a wake")
        self.assertTrue(any(len(c) > 2 and c[2] == "session.message.list" for c in world.v2.calls[mark:]), "the read just before the write is made")
        mark = len(world.v2.calls)
        world.tick(5)
        world.engine.run_pass()
        self.assertEqual(self.ops(world, mark).get("session.message.list", 0), 0, "and only then: nothing pending, no read")

    def test_two_writers_do_not_lose_each_others_keys(self):
        world = self.world(agents=("platform",))
        first, second = sb.SentLedger(world.state), sb.SentLedger(world.state)
        first.confirm("ses_example", ["k1"], 1.0)
        second.confirm("ses_example", ["k2"], 2.0)   # the second never saw k1 in memory
        first.confirm("ses_example", ["k3"], 3.0)
        self.assertEqual(sorted(sb.SentLedger(world.state).keys["ses_example"]), ["k1", "k2", "k3"])
        self.assertEqual(sorted(second.known("ses_example", 0)), ["k1", "k2", "k3"], "a read sees what another process wrote")

    def test_a_crash_between_the_write_and_the_record_is_at_most_once_and_says_so(self):
        world = self.world(agents=("platform",))
        world.fact("platform", "lab.fact:1")
        world.tick(90)
        self.addCleanup(os.environ.__setitem__, sb.FAULT_ENV, "")
        os.environ[sb.FAULT_ENV] = "crash-after-send"
        with self.assertRaises(sb.SimulatedCrash):
            world.engine.run_pass()
        os.environ[sb.FAULT_ENV] = ""
        ledger = sb.SentLedger(world.state)
        self.assertEqual(ledger.unknown_count(), 1)
        world.engine = world.new_engine()   # a restart
        world.tick(5)
        self.assertEqual(world.engine.run_pass()["sent"], [], "unknown fate counts as delivered: never blindly re-sent")
        self.assertEqual(len(world.admissions("platform")), 1)

    def test_the_ledger_is_bounded(self):
        world = self.world(agents=("platform",))
        ledger = world.engine.sent
        for n in range(sb.SENT_PER_SESSION + 50):
            ledger.reserve("ses_example", ["k%d" % n], float(n))
            ledger.confirm("ses_example", ["k%d" % n], float(n))
        self.assertEqual(len(ledger.keys["ses_example"]), sb.SENT_PER_SESSION)
        self.assertIn("k%d" % (sb.SENT_PER_SESSION + 49), ledger.keys["ses_example"])
        for n in range(sb.SENT_SESSIONS + 20):
            ledger.confirm("ses_%d" % n, ["k"], float(1000 + n))
        self.assertEqual(len(ledger.keys), sb.SENT_SESSIONS)

    def test_a_missing_ledger_is_empty_but_a_corrupt_one_stops_the_sends_and_is_not_overwritten(self):
        world = self.world(agents=("platform",))
        self.assertEqual(sb.SentLedger(world.state).keys, {})
        path = world.state / sb.SENT_KEYS_FILE
        path.write_text('{"sessions": {"ses_example": {"k": "not a time"}}}')
        with self.assertRaises(sb.V2Error):
            sb.SentLedger(world.state).known("ses_example", 0)
        path.write_text("not json")
        with self.assertRaises(sb.V2Error):
            sb.SentLedger(world.state).known("ses_example", 0)
        with self.assertRaises(sb.V2Error):
            sb.SentLedger(world.state).reserve("ses_example", ["k"], 1.0)
        self.assertEqual(path.read_text(), "not json", "the evidence is kept")
        world.fact("platform", "lab.fact:1")
        world.tick(90)
        report = world.engine.run_pass()
        self.assertEqual(report["sent"], [], "nothing is sent on a ledger that cannot be trusted")
        self.assertEqual(len(world.admissions("platform")), 0)

    def test_a_ledger_that_cannot_be_written_refuses_the_send(self):
        world = self.world(agents=("platform",))
        world.fact("platform", "lab.fact:1")
        world.tick(90)
        (world.state / (sb.SENT_KEYS_FILE + ".lock")).mkdir()   # a directory where the lock file goes: it cannot be opened
        report = world.engine.run_pass()
        self.assertEqual(report["sent"], [])
        self.assertEqual(len(world.admissions("platform")), 0, "no ledger, no write")
        self.assertTrue(report["errors"])

    def refuse_with(self, world, error):
        def refuse(params, body):
            raise error
        real = world.v2.op_session_synthetic
        world.v2.op_session_synthetic = refuse
        return real

    def test_a_definite_refusal_is_released_and_goes_next_pass(self):
        world = self.world(agents=("platform",))
        world.fact("platform", "lab.fact:1")
        world.tick(90)
        real = self.refuse_with(world, FakeHTTP(400, "BadRequest", "no"))
        self.assertEqual(world.engine.run_pass()["sent"], [])
        self.assertEqual(sb.SentLedger(world.state).unknown_count(), 0, "released: not left unknown")
        self.assertEqual(sorted(sb.SentLedger(world.state).known(world.sessions["platform"], 0)), [])
        world.v2.op_session_synthetic = real
        world.tick(5)
        self.assertEqual([s["keys"] for s in world.engine.run_pass()["sent"]], [["lab.fact:1"]])

    def test_a_key_another_sender_holds_is_not_sent_again(self):
        world = self.world(agents=("platform",))
        sid = world.sessions["platform"]
        self.assertTrue(sb.SentLedger(world.state).reserve(sid, ["lab.fact:1"], 1.0))
        self.assertFalse(sb.SentLedger(world.state).reserve(sid, ["lab.fact:1"], 2.0), "the second sender is refused")
        world.fact("platform", "lab.fact:1")
        world.tick(90)
        self.assertEqual(world.engine.run_pass()["sent"], [])
        self.assertEqual(len(world.admissions("platform")), 0)

    def test_a_ripe_delivery_reads_the_prompt_once_and_a_waiting_or_held_plan_reads_nothing(self):
        world = self.world(agents=("platform",))
        world.fact("platform", "lab.fact:1")
        world.tick(5)   # inside the batch window: a plan that waits
        mark = len(world.v2.calls)
        report = world.engine.run_pass()
        self.assertEqual(report["waiting"], ["platform"])
        self.assertEqual(self.ops(world, mark).get("session.message.list", 0), 0, "waiting: no read")
        world.tick(90)
        mark = len(world.v2.calls)
        world.engine.run_pass()
        reads = self.ops(world, mark).get("session.message.list", 0)
        self.assertTrue(1 <= reads <= 2, "ripe: the read that decides note or wake, and the one before the write (%d)" % reads)

    def test_a_stop_a_summary_and_a_lapsed_note_read_nothing_and_say_nothing(self):
        world = self.world(agents=("platform",))
        engine, sid = world.engine, world.sessions["platform"]
        world.v2._message(world.v2.sessions[sid], "assistant", "all done", None, world.clock.now())
        source = sb.WorkerFacts()
        source.bind(engine)
        observation = sb.Observation("platform", sid, world.panes["platform"], "idle", {"name": "platform", "reports_to": "boss"},
                                     idle_at=world.clock.now() - 10, outcome="ok")
        mark = list(world.v2.calls)
        self.assertEqual(source.last_reply(sid, 1), "", "no summary is read")
        self.assertIsNone(sb.triage_stop(engine, source, observation, "boss", 1, ""), "a stop is only its idle rider")
        self.assertEqual(engine.convert_lapsed_notes(observation, world.clock.now()), [])
        self.assertEqual(world.v2.calls, mark, "none of the three made a call")

    def test_an_oversized_or_unreadable_ledger_stops_the_sends_and_is_kept(self):
        world = self.world(agents=("platform",))
        path = world.state / sb.SENT_KEYS_FILE
        path.write_text(" " * (sb.SENT_FILE_MAX + 1))
        with self.assertRaises(sb.V2Error):
            sb.SentLedger(world.state).known("ses_example", 0)
        with self.assertRaises(sb.V2Error):
            sb.SentLedger(world.state).reserve("ses_example", ["k"], 1.0)
        self.assertEqual(len(path.read_text()), sb.SENT_FILE_MAX + 1, "kept as it was")
        path.unlink()
        path.mkdir()   # a directory where the file goes: not missing, not readable
        with self.assertRaises(sb.V2Error):
            sb.SentLedger(world.state).known("ses_example", 0)

    def test_a_call_that_never_ran_is_released_and_unknown_reservations_are_never_trimmed(self):
        for error in (sb.V2Error("unavailable", None, "cannot run"), sb.V2Error("refused", None, "no")):
            with self.subTest(reason=error.reason):
                world = self.world(agents=("platform",))
                world.fact("platform", "lab.fact:1")
                world.tick(90)
                self.refuse_with(world, error)
                world.engine.run_pass()
                self.assertEqual(sb.SentLedger(world.state).unknown_count(), 0, "released")
        ledger = sb.SentLedger(world.state)
        ledger.reserve("ses_example", ["old"], 1.0)
        for n in range(sb.SENT_PER_SESSION + 20):
            ledger.confirm("ses_example", ["k%d" % n], float(10 + n))
        self.assertIn("old", ledger.known("ses_example", 0), "an unknown-fate reservation outlives the trim")

    def test_a_timeout_or_unreadable_reply_keeps_the_reservation_and_is_not_sent_again(self):
        for error in (sb.V2Error("timeout", None, "no answer"), sb.V2Error("bad_json", None, "garbage"), sb.V2Error("http", 500, "boom"),
                      sb.V2Error("http", 504, "gateway"), sb.V2Error("http", 408, "slow")):
            with self.subTest(reason=error.reason, status=error.status):
                world = self.world(agents=("platform",))
                world.fact("platform", "lab.fact:1")
                world.tick(90)
                real = self.refuse_with(world, error)
                world.engine.run_pass()
                self.assertEqual(sb.SentLedger(world.state).unknown_count(), 1, "fate unknown: reserved")
                world.v2.op_session_synthetic = real
                world.tick(5)
                self.assertEqual(world.engine.run_pass()["sent"], [], "counts as delivered: at most once")
                self.assertEqual(len(world.admissions("platform")), 0)

    def test_a_409_is_delivered(self):
        world = self.world(agents=("platform",))
        world.fact("platform", "lab.fact:1")
        world.tick(90)
        self.refuse_with(world, FakeHTTP(409, "Conflict", "exists"))
        report = world.engine.run_pass()
        self.assertEqual([s["keys"] for s in report["sent"]], [["lab.fact:1"]])
        self.assertEqual(sb.SentLedger(world.state).unknown_count(), 0)
        self.assertEqual(sorted(sb.SentLedger(world.state).known(world.sessions["platform"], 0)), ["lab.fact:1"])

    def test_concurrent_writers_lose_nothing(self):
        world = self.world(agents=("platform",))
        barrier = threading.Barrier(4)

        def write(n):
            ledger = sb.SentLedger(world.state)
            barrier.wait()
            for i in range(15):
                ledger.confirm("ses_example", ["w%d-%d" % (n, i)], float(n * 100 + i))
        threads = [threading.Thread(target=write, args=(n,)) for n in range(4)]
        for t in threads:
            t.start()
        for t in threads:
            t.join()
        self.assertEqual(len(sb.SentLedger(world.state).keys["ses_example"]), 60)

    def test_status_says_what_is_off_and_how_many_sends_are_of_unknown_fate(self):
        world = self.world(agents=("platform",))
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "v2_light": True})
        sb.SentLedger(world.state).reserve("ses_example", ["k1"], 1.0)
        report = sb.collect_status(world.route, world.clock.now)
        self.assertIn("ON (features off:", report["v2_light"])
        self.assertIn("compactions", report["v2_light"])
        self.assertIn("1 send(s) of unknown fate", report["v2_light"])
        self.assertIn("v2_light", sb.format_status(report))
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.assertNotIn("v2_light", sb.collect_status(world.route, world.clock.now))

    def test_status_on_a_corrupt_ledger_says_so_and_exits_zero(self):
        world = self.world(agents=("platform",))
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "v2_light": True})
        (world.state / sb.SENT_KEYS_FILE).write_text("not json")
        report = sb.collect_status(world.route, world.clock.now)
        self.assertIn("sent-keys ledger: UNREADABLE (sends stopped: fail closed)", report["v2_light"])
        self.assertIn("UNREADABLE", sb.format_status(report))
        with captured() as (out, err):
            code = sb.main(["status"], runner=world.route, now=world.clock.now)
        self.assertEqual(code, 0, err.getvalue())
        self.assertIn("sent-keys ledger: UNREADABLE (sends stopped: fail closed)", out.getvalue())

    def test_each_optional_read_is_off_and_answers_what_it_did_not_see(self):
        world = self.world(agents=("platform",))
        engine, sid = world.engine, world.sessions["platform"]
        world.you("platform", "hello")
        mark = list(world.v2.calls)
        self.assertTrue(sb.brief_in_transcript(engine, sid), "no scan: taken to hold the brief, never sent twice")
        self.assertEqual(engine.reads.compaction_page(sid, 5, world.clock.now()), [])
        self.assertEqual(engine.reads.human_prompts_newest(sid), [])
        self.assertEqual(sb.inbox_human_prompts(engine, sid), [])
        self.assertEqual(sb.transcript_lines(engine, sid, 0), [])
        self.assertEqual(sb.synthetic_lines(engine, sid, 0, waiting=True), [])
        self.assertEqual(engine.reads.inbox(sid, world.clock.now()), [])
        self.assertEqual(world.v2.calls, mark, "none of them made a call")
        self.assertTrue(engine.reads.human_prompts_newest(sid, fresh=True), "the read before a write is still made")

class TestDeliverWithTheMemoryOn(TestDeliver):
    """The delivery tests again, with the daemon's memory of its v2 reads ON (default 120 s): the decisions are the same."""
    V2_CACHE = 120


class TestWorkerDeliveryWithTheMemoryOn(TestWorkerDelivery):
    """Worker facts and their delivery again, with the memory on."""
    V2_CACHE = 120


class TestV2ReadCorrectness(Base):
    """The remembered reads never make the daemon act on a stale world: keys, prompts, compactions, the budget."""

    def world(self, **config):
        config.setdefault("v2_cache_seconds", 120)
        return World(self, agents=("coder", "platform"), config=config)

    def synthetic(self, world, sid, key, text="note"):
        world.v2._message(world.v2.sessions[sid], "synthetic", text, {"fleet": {"keys": [key], "from": "switchboard"}}, world.clock.now())

    @staticmethod
    def count(world, op, since=0):
        return len([c for c in world.v2.calls[since:] if len(c) > 2 and c[2] == op])

    def test_a_synthetic_message_that_lands_after_the_probe_is_found_and_the_pages_are_read_again(self):
        world = self.world()
        sid, engine = world.sessions["coder"], world.engine
        self.synthetic(world, sid, "k1")
        since = world.clock.now() - 100
        first, complete = engine.delivered_keys(sid, since)
        self.assertEqual((sorted(first), complete), (["k1"], True))
        mark = len(world.v2.calls)
        again, _ = engine.delivered_keys(sid, since)
        self.assertEqual(sorted(again), ["k1"])
        self.assertEqual(self.count(world, "session.message.list", mark), 1, "nothing changed: the probe alone")
        world.tick(3)
        self.synthetic(world, sid, "k2")
        mark = len(world.v2.calls)
        later, _ = engine.delivered_keys(sid, since)
        self.assertEqual(sorted(later), ["k1", "k2"], "the new key is found, not served from memory")
        self.assertGreater(self.count(world, "session.message.list", mark), 1, "the pages were read again")

    def test_an_earlier_since_than_the_remembered_one_reads_the_pages_again(self):
        world = self.world()
        sid, engine = world.sessions["coder"], world.engine
        self.synthetic(world, sid, "old")
        world.tick(500)
        self.synthetic(world, sid, "new")
        recent, _ = engine.delivered_keys(sid, world.clock.now() - 100)
        self.assertEqual(sorted(recent), ["new"])
        older, _ = engine.delivered_keys(sid, world.clock.now() - 1000)
        self.assertEqual(sorted(older), ["new", "old"], "a longer look-back is a new read, not the remembered short one")

    def test_a_person_s_prompt_behind_more_than_ten_fleet_messages_is_still_seen(self):
        world = self.world()
        sid = world.sessions["coder"]
        session = world.v2.sessions[sid]
        world.v2._message(session, "user", "please stop", None, world.clock.now())          # a person
        for n in range(15):
            world.tick(1)
            world.v2._message(session, "user", "task %d" % n, {"fleet": {"from": "fleet-task"}}, world.clock.now())
        prompts = world.engine.reads.human_prompts_newest(sid)
        self.assertEqual([m["text"] for m in prompts], ["please stop"])
        for n in range(60):
            world.tick(1)
            world.v2._message(session, "user", "more %d" % n, {"fleet": {"from": "fleet-task"}}, world.clock.now())
        self.assertEqual(world.engine.reads.human_prompts_newest(sid), [], "buried under more than the wide read covers: said in the docstring, and a write is re-checked")

    def test_compactions_are_remembered_for_the_memory_but_never_more_than_thirty_seconds_and_a_write_forgets_them(self):
        world = self.world(v2_cache_seconds=300)
        sid, engine = world.sessions["coder"], world.engine
        engine.reads.compaction_page(sid, 5, world.clock.now())
        mark = len(world.v2.calls)
        engine.reads.compaction_page(sid, 5, world.clock.now() + 29)
        self.assertEqual(self.count(world, "session.message.list", mark), 0)
        engine.reads.compaction_page(sid, 5, world.clock.now() + 31)
        self.assertEqual(self.count(world, "session.message.list", mark), 1, "at most 30 s, whatever v2_cache_seconds says")
        engine.reads.forget(sid)
        engine.reads.compaction_page(sid, 5, world.clock.now() + 32)
        self.assertEqual(self.count(world, "session.message.list", mark), 2, "a write to the session forgets it")

    def test_a_prompt_is_read_again_only_when_the_session_moved_and_forget_clears_it(self):
        world = self.world()
        sid, engine = world.sessions["coder"], world.engine
        info = world.v2.op_session_get({"sessionID": sid}, None)
        engine.reads.human_prompt(sid, info, world.clock.now())
        mark = len(world.v2.calls)
        engine.reads.human_prompt(sid, info, world.clock.now())
        self.assertEqual(self.count(world, "session.message.list", mark), 0, "time.updated did not move")
        engine.reads.forget(sid)
        engine.reads.human_prompt(sid, info, world.clock.now())
        self.assertEqual(self.count(world, "session.message.list", mark), 1, "forgotten: read again")

    def test_a_prompt_read_past_the_budget_returns_what_is_remembered(self):
        world = self.world(v2_reads_per_pass=0)
        sid, engine = world.sessions["coder"], world.engine
        info = world.v2.op_session_get({"sessionID": sid}, None)
        engine.reads.human_prompt(sid, info, world.clock.now())   # the first read is always made
        moved = dict(info, time=dict(info["time"], updated=info["time"]["updated"] + 5000))
        mark = len(world.v2.calls)
        engine.reads.begin_pass()
        engine.reads.human_prompt(sid, moved, world.clock.now())
        self.assertEqual(self.count(world, "session.message.list", mark), 0, "no budget: the remembered prompt stands")
        self.assertEqual(engine.reads.deferred, 1)

    def test_the_brief_a_launch_sends_forgets_what_was_remembered(self):
        world = self.world()
        sid = world.sessions["coder"]
        info = world.v2.op_session_get({"sessionID": sid}, None)
        world.engine.reads.inbox(sid, world.clock.now())
        world.engine.reads.human_prompt(sid, info, world.clock.now())
        self.assertTrue(sid in world.engine.reads.inboxes and sid in world.engine.reads.prompts)
        world.v2.prompt = lambda *args, **kwargs: None   # the fake takes no brief: what matters is what the daemon forgets afterwards
        sb.send_brief(world.engine, "coder", sid, "Do the thing")
        self.assertFalse(sid in world.engine.reads.inboxes or sid in world.engine.reads.prompts or sid in world.engine.reads.sessions)

    def test_the_delivered_keys_memory_drops_its_oldest_entry_not_all_of_them(self):
        world = self.world()
        engine = world.engine
        engine._delivered = {"ses_%d" % n: (None, 0, sb.KeyTimes()) for n in range(201)}
        sid = world.sessions["coder"]
        engine.delivered_keys(sid, world.clock.now() - 100)
        self.assertEqual(len(engine._delivered), 201, "one in, the oldest out")
        self.assertNotIn("ses_0", engine._delivered)
        self.assertIn("ses_200", engine._delivered)


class TestAgentsVerify(unittest.TestCase):
    """`agents verify`: the running service's registered agents against the rules each kit definition declares (not a count: the service adds default
    rules of its own and their number changes between versions)."""

    DEFAULTS_10 = [{"action": "read", "resource": "*.env", "effect": "ask"}, {"action": "*", "resource": "*", "effect": "allow"}] + [
        {"action": "default%d" % n, "resource": "*", "effect": "allow"} for n in range(8)]
    DEFAULTS_5 = DEFAULTS_10[:5]

    @staticmethod
    def rows_of(name, drop=(), flip=()):
        rules = [r for r in sb.agent_definition_rules(name) if r not in drop]
        return [{"action": a, "resource": res, "effect": ({"allow": "deny", "deny": "allow", "ask": "allow"}[e] if (a, res, e) in flip else e)}
                for a, res, e in rules]

    def listing(self, defaults=None, **changes):
        """The service's answer: each agent of ours with its own rules (as `agents verify` reads them) plus `defaults`; `changes` {name: (mode, rows)}."""
        defaults = self.DEFAULTS_10 if defaults is None else defaults
        rows = {name: (mode, self.rows_of(name) + defaults) for name, mode in sb.EXPECTED_AGENTS.items()}
        rows.update(changes)
        rows["build"] = ("primary", list(defaults))   # not ours: ignored
        return json.dumps({"location": {}, "data": [{"id": n, "mode": m, "permissions": r} for n, (m, r) in rows.items()]})

    def run_verify(self, stdout="", returncode=0, raises=None, drop=()):
        def runner(argv, **kwargs):
            self.assertEqual(argv, ["opencode", "api", "GET", "/api/agent"])
            self.assertIn("timeout", kwargs)
            if raises:
                raise raises
            return subprocess.CompletedProcess(argv, returncode, stdout, "boom" if returncode else "")
        out, err = io.StringIO(), io.StringIO()
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err), unittest.mock.patch.dict(os.environ):   # main() sets a variable for its own process
            code = sb.main(["agents", "verify"], runner=runner)
        return code, out.getvalue(), err.getvalue()

    def test_every_agent_registered_as_written_passes_under_a_ten_rule_and_a_five_rule_default(self):
        for defaults in (self.DEFAULTS_10, self.DEFAULTS_5, []):
            with self.subTest(defaults=len(defaults)):
                code, out, err = self.run_verify(self.listing(defaults))
                self.assertEqual((code, err), (0, ""))
                self.assertIn("agents: PASS (9 of 9", out)

    def test_a_reviewer_registered_as_a_primary_with_default_rules_fails_and_is_named(self):
        code, out, err = self.run_verify(self.listing(**{"reviewer-code": ("primary", list(self.DEFAULTS_10))}))
        self.assertEqual(code, 1)
        self.assertIn("FAIL  reviewer-code: registered as primary, expected subagent", out)
        self.assertEqual(out.count("FAIL"), 1)

    def test_a_default_agent_with_none_of_our_rules_fails_whatever_its_default_count(self):
        """The parse failure: OpenCode registers a default primary agent. For the coder that is the mode it should have, so the rules decide."""
        for defaults in (self.DEFAULTS_10, self.DEFAULTS_5):
            with self.subTest(defaults=len(defaults)):
                code, out, err = self.run_verify(self.listing(**{"coder": ("primary", list(defaults))}))
                self.assertEqual(code, 1)
                self.assertRegex(out, r"FAIL  coder: \d+ of its \d+ rules \(from .*coder.md\) are not registered as written")

    def test_a_missing_rule_and_a_rule_with_another_effect_fail_and_a_missing_agent_too(self):
        coder = sb.agent_definition_rules("coder")
        listing = self.listing(**{"coder": ("primary", self.rows_of("coder", drop=[coder[-1]]) + self.DEFAULTS_5),
                                  "orchestrator": ("primary", self.rows_of("orchestrator", flip=[sb.agent_definition_rules("orchestrator")[0]]) + self.DEFAULTS_5)})
        code, out, err = self.run_verify(listing.replace('"id": "reviewer-impact"', '"id": "someone-else"'))
        self.assertEqual(code, 1)
        self.assertRegex(out, r"coder: 1 of its %d rules \(from .*coder.md\) are not registered as written" % len(coder))
        self.assertRegex(out, r"orchestrator: 1 of its \d+ rules \(from .*orchestrator.md\)")
        self.assertIn("reviewer-impact: not registered", out)

    def test_the_order_of_the_registered_rules_does_not_matter(self):
        rows = list(reversed(self.rows_of("coder") + self.DEFAULTS_5))
        code, out, err = self.run_verify(self.listing(**{"coder": ("primary", rows)}))
        self.assertEqual((code, err), (0, ""))

    def test_every_shipped_definition_is_read_whole_no_line_of_its_permission_block_is_skipped(self):
        for name in sb.EXPECTED_AGENTS:
            rules, unread, path = sb.agent_definition(name)
            self.assertEqual(unread, 0, "%s: %d lines of its permission block are not in a form the check reads" % (name, unread))
            self.assertTrue(rules, name)

    def test_a_malformed_quoted_rule_is_unread_not_a_traceback(self):
        with tempfile.TemporaryDirectory() as root:
            folder = Path(root) / "opencode"
            folder.mkdir()
            (folder / "coder.md").write_text('---\nname: coder\nmode: primary\npermissions:\n  - {action: edit, resource: "a\\qb", effect: allow}\n'
                                             '  - {action: read, resource: "*", effect: allow}\n---\nbody\n')
            rules, unread, _ = sb.agent_definition("coder", root)
            self.assertEqual((rules, unread), ([("read", "*", "allow")], 1))
            found = {"coder": ("primary", {("read", "*", "allow")})}
            self.assertRegex("\n".join(sb.agents_problems(found, {"coder": "primary"}, root)), r"coder: 1 lines of the permission block in .*coder.md are not in a form")

    def run_main_verify(self, *argv, definitions=True):
        """`agents verify` through main() with a service answering from the shipped definitions, and (definitions False) none found beside the binary."""
        listing = self.listing()

        def runner(argv_, **kwargs):
            return subprocess.CompletedProcess(argv_, 0, listing, "")
        out, err = io.StringIO(), io.StringIO()
        patched = unittest.mock.patch.object(sb, "agent_definition", lambda name, root=None: None) if not definitions else contextlib.nullcontext()
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err), unittest.mock.patch.dict(os.environ), patched:
            code = sb.main(["agents", "verify", *argv], runner=runner)
        return code, out.getvalue(), err.getvalue()

    def test_with_no_definitions_beside_the_binary_the_pass_says_mode_only_and_strict_exits_one(self):
        code, out, err = self.run_main_verify(definitions=False)
        self.assertEqual(code, 0, err)
        self.assertIn("agents: PASS on mode only for 9 of 9", out)
        self.assertIn("their rules were not compared", out)
        code, out, err = self.run_main_verify("--strict", definitions=False)
        self.assertEqual(code, 1)
        self.assertIn("PASS on mode only", out)
        code, out, err = self.run_main_verify("--strict")   # definitions present: a full PASS, strict or not
        self.assertEqual((code, err), (0, ""))
        self.assertIn("agents: PASS (9 of 9", out)

    def test_a_line_the_check_cannot_read_and_a_definition_that_is_not_there_are_said_not_passed(self):
        with tempfile.TemporaryDirectory() as root:
            folder = Path(root) / "opencode"
            folder.mkdir()
            (folder / "coder.md").write_text("---\nname: coder\nmode: primary\npermission:\n  edit: allow\n  bash:\n    git *: allow\n---\nbody\n")
            found = {"coder": ("primary", {("edit", "*", "allow")})}
            self.assertRegex("\n".join(sb.agents_problems(found, {"coder": "primary"}, root)), r"coder: 2 lines of the permission block in .*coder.md are not in a form")
            unchecked = []
            self.assertEqual(sb.agents_problems(found, {"coder": "primary"}, root + "/none", unchecked), [])
            self.assertEqual(unchecked, ["coder"], "the rules were not compared: said, not passed")
            self.assertEqual(sb.agents_problems({"coder": ("subagent", set())}, {"coder": "primary"}, root + "/none"), [
                "coder: registered as subagent, expected primary (its front matter probably failed to parse: quote any description with a colon)"], "the mode is still checked")

    def test_the_definitions_are_read_as_the_service_registers_them(self):
        """A permission map entry `edit: allow` is action edit, resource `*`; `bash` is action `shell`. A list entry keeps its action, resource and effect."""
        rules = sb.agent_definition_rules("coder")
        self.assertIn(("edit", "*", "allow"), rules)
        self.assertIn(("shell", "*", "allow"), rules)
        self.assertIn(("external_directory", "*", "allow"), rules)
        self.assertNotIn(("bash", "*", "allow"), rules)
        self.assertIn(("*", "*", "deny"), sb.agent_definition_rules("reviewer-code"))
        self.assertIn(("shell", "fleet-switchboard review laws *", "allow"), sb.agent_definition_rules("reviewer-code"))
        self.assertIsNone(sb.agent_definition_rules("nobody"))

    def test_a_service_that_is_not_running_is_said_and_is_not_a_failure(self):
        for kwargs in ({"raises": subprocess.TimeoutExpired("opencode", 20)}, {"raises": FileNotFoundError(2, "No such file")}, {"returncode": 1}):
            with self.subTest(kwargs=sorted(kwargs)):
                code, out, err = self.run_verify(**kwargs)
                self.assertEqual(code, 0)
                self.assertIn("not running or not reachable, so nothing was checked", out)

    def test_strict_makes_a_service_that_is_not_running_a_failure(self):
        out, err = io.StringIO(), io.StringIO()
        def down(argv, **kwargs):
            raise FileNotFoundError(2, "No such file")
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err), unittest.mock.patch.dict(os.environ):
            self.assertEqual(sb.main(["agents", "verify", "--strict"], runner=down), 1)
            self.assertEqual(sb.main(["agents", "verify"], runner=down), 0)
        self.assertEqual(out.getvalue().count("nothing was checked"), 2)

    def test_an_answer_that_is_not_the_agent_list_fails(self):
        code, out, err = self.run_verify("<html>not json</html>")
        self.assertEqual(code, 1)
        self.assertIn("not the agent list", err)

    def test_the_table_names_every_agent_the_kit_installs_and_each_definition_declares_rules_and_the_mode(self):
        self.assertEqual(set(sb.EXPECTED_AGENTS), set(sb.KIT_AGENTS))
        for name, mode in sb.EXPECTED_AGENTS.items():
            folder = "reviewers" if name.startswith("reviewer-") else "opencode"
            text = (REPO / "agents" / folder / (name + ".md")).read_text()
            self.assertRegex(text, r"(?m)^mode: %s$" % mode if mode == "subagent" else r"(?m)^description:")
            self.assertTrue(sb.agent_definition_rules(name), "%s declares no rules the check can read: its permission block would not be verified" % name)
        self.assertIn("agents verify", (REPO / "INSTALL.md").read_text())
        self.assertIn("agents verify", (REPO / "docs" / "switchboard.md").read_text())
        self.assertIn("--strict", (REPO / "INSTALL.md").read_text())



STRUCTURAL_RULE = ("When a function decides from text (an error message, a substring, a pattern, a name list), the first-round finding asks for an allow-list, "
                   "a structured field or exact equality, and for a completeness test derived from the code, with one mutant per member, so the class is closed in one "
                   "round and not found one instance at a time.")


def structural_rule_homes(root):
    """Every file that must carry STRUCTURAL_RULE, derived from the tree: each reviewer definition found in the directory (no count), the review skill, the rule's own page in the review laws' documentation."""
    root = Path(root)
    return sorted((root / "agents" / "reviewers").glob("*.md")) + [root / "skills" / "fleet-review" / "SKILL.md", root / "docs" / "review-laws" / "structural-rule.md"]


def structural_rule_problems(root):
    """[(file name, why)] for every home that does not hold the sentence exactly once, or holds a second near copy of it."""
    out = []
    for path in structural_rule_homes(root):
        text = " ".join(path.read_text().split())
        if text.count(STRUCTURAL_RULE) != 1:
            out.append((path.name, "the shared sentence appears %d times, not once" % text.count(STRUCTURAL_RULE)))
        elif text.count("decides from text") != 1:
            out.append((path.name, "a second wording of the rule"))
    return out


class TestStructuralRuleInReviewing(unittest.TestCase):
    """The rule "when a function decides from text, ask for the class in round one" is one sentence in every reviewer definition, the review skill and the laws, and
    `agents verify` says when an installed definition is out of date."""

    def tree(self, root):
        for path in structural_rule_homes(REPO):
            target = Path(root) / path.relative_to(REPO)
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_text(path.read_text())

    def test_the_sentence_is_in_every_definition_found_in_the_directory_and_in_the_skill_and_the_laws_once(self):
        homes = structural_rule_homes(REPO)
        self.assertGreaterEqual(len([h for h in homes if h.parent.name == "reviewers"]), 1)
        self.assertEqual(structural_rule_problems(REPO), [])

    def test_removing_the_sentence_from_any_one_file_fails_and_names_that_file(self):
        for victim in structural_rule_homes(REPO):
            with self.subTest(mutant=victim.name), tempfile.TemporaryDirectory() as root:
                self.tree(root)
                target = Path(root) / victim.relative_to(REPO)
                target.write_text(target.read_text().replace(STRUCTURAL_RULE, ""))
                self.assertEqual([name for name, _ in structural_rule_problems(root)], [victim.name])

    def test_a_definition_added_to_the_directory_without_the_sentence_fails_with_no_edit_to_the_test(self):
        with tempfile.TemporaryDirectory() as root:
            self.tree(root)
            (Path(root) / "agents" / "reviewers" / "reviewer-zz.md").write_text("---\nname: reviewer-zz\n---\nbody\n")
            self.assertEqual([name for name, _ in structural_rule_problems(root)], ["reviewer-zz.md"])

    def test_a_second_wording_in_one_file_is_caught_too(self):
        for victim in structural_rule_homes(REPO):
            with self.subTest(mutant=victim.name), tempfile.TemporaryDirectory() as root:
                self.tree(root)
                target = Path(root) / victim.relative_to(REPO)
                target.write_text(target.read_text() + "\n" + STRUCTURAL_RULE.replace("an allow-list", "a list of allowed values") + "\n")
                self.assertEqual([name for name, _ in structural_rule_problems(root)], [victim.name])

    def test_the_rule_page_carries_one_example_with_neutral_names(self):
        text = (REPO / "docs" / "review-laws" / "structural-rule.md").read_text()
        example = text.split("Example (neutral names).", 1)[1].split("\n\n", 1)[0]
        self.assertEqual(text.count("Example (neutral names)."), 1)
        for word in ("acme/", "`list`", "table of the allowed commands", "one mutant per row"):
            self.assertIn(word, example)

    FRONT_MATTER_SHA256 = {   # the front matter (permissions, mode, steps, model) of each definition, as a literal: this change moved none of it
        "reviewer-architecture.md": "6ba86e43d65158f32f23a484ef5ecc37dd931c5c64838a4408914b8a64cdada9",
        "reviewer-code.md": "780c9e18932f04f922a0a87d25bf31a2e1c7ea1f702bcee8406744d76219e913",
        "reviewer-impact.md": "f94f58e5ae55912c10ed936118320e90d280a73f00657113df0ab7439192fa79",
        "reviewer-security.md": "f10e5a595f25d6690bb7f92f7b5006ed39f3b1ce2a70967880151680e0d3c477",
        "reviewer-test.md": "c1ef1b6c4bbd3dc43026d77cef875f32ac9d706a5ffa862b0c22b325433e932d",
    }

    def test_the_rule_is_in_the_body_never_in_the_front_matter_of_a_definition(self):
        paths = sorted((REPO / "agents" / "reviewers").glob("*.md"))
        self.assertEqual([p.name for p in paths], sorted(self.FRONT_MATTER_SHA256), "a definition added or removed: pin its front matter here")
        for path in paths:
            with self.subTest(definition=path.name):
                front, body = path.read_text().split("\n---\n", 1)
                self.assertNotIn("decides from text", front)
                self.assertIn(STRUCTURAL_RULE, " ".join(body.split()))
                self.assertEqual(hashlib.sha256(front.encode()).hexdigest(), self.FRONT_MATTER_SHA256[path.name], "the front matter changed")

    def test_the_default_installed_folder_is_none_under_the_suite_and_the_install_folder_outside_it(self):
        self.assertEqual(os.environ.get(sb.UNDER_TEST_ENV), "1")
        self.assertIsNone(sb.default_installed_agents_dir())
        with tempfile.TemporaryDirectory() as data, unittest.mock.patch.dict(os.environ, {"XDG_DATA_HOME": data}):
            os.environ.pop(sb.UNDER_TEST_ENV, None)
            self.assertEqual(sb.default_installed_agents_dir(), Path(data) / sb.PROG / "profile" / "config" / "opencode" / "agents")

    def test_verify_with_no_folder_named_reads_no_installed_file_under_the_suite(self):
        listing = TestAgentsVerify("listing").listing()
        with unittest.mock.patch.object(sb, "stale_installed_agents", wraps=sb.stale_installed_agents) as spy, \
                contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
            sb.main(["agents", "verify"], runner=lambda argv, **kw: subprocess.CompletedProcess(argv, 0, listing, ""))
        self.assertEqual(spy.call_args.args[0], None)

    def verify(self, installed_dir):
        listing = TestAgentsVerify("listing").listing()
        out, err = io.StringIO(), io.StringIO()
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err), unittest.mock.patch.dict(os.environ):
            code = sb.main(["agents", "verify", "--installed-dir", str(installed_dir)],
                           runner=lambda argv, **kw: subprocess.CompletedProcess(argv, 0, listing, ""))
        return code, out.getvalue()

    def test_a_stale_installed_body_is_out_of_date_by_name_and_install_makes_verify_pass(self):
        for name in sb.EXPECTED_AGENTS:
            with self.subTest(agent=name), tempfile.TemporaryDirectory() as root:
                sb.install_agents(root)
                installed = Path(root) / "agents" / (name + ".md")
                installed.write_text(installed.read_text().replace(STRUCTURAL_RULE, "", 1) if STRUCTURAL_RULE in installed.read_text() else installed.read_text() + "\nold wording\n")
                code, out = self.verify(Path(root) / "agents")
                self.assertEqual(code, 1)
                lines = [l for l in out.splitlines() if "out of date" in l]
                self.assertEqual(len(lines), 1, out)
                self.assertTrue(lines[0].startswith("FAIL  %s: out of date" % name), lines[0])
                self.assertIn("fleet-switchboard install", lines[0])
                sb.install_agents(root)
                code, out = self.verify(Path(root) / "agents")
                self.assertEqual(code, 0, out)
                self.assertIn("agents: PASS", out)

    def test_an_installed_copy_that_differs_only_in_its_model_line_passes(self):
        with tempfile.TemporaryDirectory() as root:
            sb.install_agents(root, model="acme-llm/other-model")
            code, out = self.verify(Path(root) / "agents")
            self.assertEqual(code, 0, out)

    def test_an_installed_file_that_cannot_be_read_is_said_not_passed_over(self):
        with tempfile.TemporaryDirectory() as root:
            sb.install_agents(root)
            installed = Path(root) / "agents" / "coder.md"
            installed.unlink()
            installed.mkdir()   # there, but not a file that can be read
            code, out = self.verify(Path(root) / "agents")
            self.assertEqual(code, 1)
            self.assertIn("FAIL  coder: out of date", out)

    def test_an_agent_with_no_installed_file_is_not_called_out_of_date(self):
        with tempfile.TemporaryDirectory() as root:
            code, out = self.verify(root)
            self.assertEqual(code, 0, out)

class TestOwnReviewLaws(unittest.TestCase):
    """fleet-kit's own laws at its root: installed from the starter set, so `review laws` works on fleet-kit itself."""

    FILES = ("REVIEW_LAWS.md", "CODING_STANDARDS.md", "SECURITY_STANDARDS.md", "TEST_STANDARDS.md")
    ID = re.compile(r"\bR-(?:LAW|CODE|SEC|TEST)-[0-9]+\b")

    def test_the_four_files_exist_at_the_root_and_open_with_the_extends_line(self):
        version = (REPO / "docs" / "review-laws" / "VERSION").read_text().strip()
        for name in self.FILES:
            with self.subTest(name=name):
                self.assertTrue((REPO / name).is_file(), name)
                self.assertEqual((REPO / name).read_text().splitlines()[0], "extends: fleet-kit-review-laws @ %s" % version)

    def test_the_root_rules_are_byte_identical_to_the_starter_set_until_a_pr_says_otherwise(self):
        for name in self.FILES:
            with self.subTest(name=name):
                root = (REPO / name).read_text().split("\n## This repository")[0]
                starter = (REPO / "docs" / "review-laws" / name).read_text()
                self.assertEqual(root.strip(), starter.strip(), "a deliberate edit of a standard changes this test in the same PR")

    def test_the_root_copy_starts_as_the_starter_set_no_rule_id_added_or_dropped(self):
        for name in self.FILES:
            with self.subTest(name=name):
                root = set(self.ID.findall((REPO / name).read_text().split("\n## This repository")[0]))
                starter = set(self.ID.findall((REPO / "docs" / "review-laws" / name).read_text()))
                self.assertEqual((root - starter, starter - root), (set(), set()))


class TestReviewLawsStarterSet(Base):
    """#179 slice L1: the generic review laws and standards starter set (docs/review-laws/) and `review-laws install`."""

    DIR = REPO / "docs" / "review-laws"
    FILES = ("REVIEW_LAWS.md", "CODING_STANDARDS.md", "SECURITY_STANDARDS.md", "TEST_STANDARDS.md")
    PREFIX = {"REVIEW_LAWS.md": "LAW", "CODING_STANDARDS.md": "CODE", "SECURITY_STANDARDS.md": "SEC", "TEST_STANDARDS.md": "TEST"}
    RULE = re.compile(r"^- \*\*R-(LAW|CODE|SEC|TEST)-([0-9]+) [^*]+\*\* .+$")

    def rules(self, name):
        text = (self.DIR / name).read_text()
        body = text.split("\n## Rules\n", 1)[1]
        lines = []
        for line in body.splitlines():
            if line.startswith("## "):
                break
            if line.strip():
                lines.append(line)
        return lines

    def install(self, *argv):
        with captured() as (out, err):
            code = sb.main(["review-laws", "install", *argv], runner=lambda *a, **k: None, now=lambda: 0)
        return code, out.getvalue(), err.getvalue()

    def test_every_file_opens_with_the_extends_line_naming_the_version(self):
        version = (self.DIR / "VERSION").read_text().strip()
        self.assertRegex(version, r"^review-laws-[0-9]+$")
        for name in self.FILES:
            self.assertEqual((self.DIR / name).read_text().splitlines()[0], "extends: fleet-kit-review-laws @ %s" % version, name)

    def test_every_rule_is_a_numbered_citable_line_with_a_unique_sequential_id(self):
        for name in self.FILES:
            with self.subTest(name=name):
                lines = self.rules(name)
                self.assertGreaterEqual(len(lines), 10)
                numbers = []
                for line in lines:
                    match = self.RULE.match(line)
                    self.assertIsNotNone(match, "a rules line that is not a numbered rule: %r" % line[:80])
                    self.assertEqual(match.group(1), self.PREFIX[name])
                    numbers.append(int(match.group(2)))
                self.assertEqual(numbers, list(range(1, len(numbers) + 1)), "ids are sequential and unique")

    def test_the_standards_stay_short_enough_for_a_reviewer_to_carry(self):
        for name in self.FILES[1:]:
            self.assertLess(len((self.DIR / name).read_bytes()), 6144, name)
        self.assertLess(len((self.DIR / "REVIEW_LAWS.md").read_bytes()), 10240)

    def test_review_laws_cite_mil_std_882e_with_software_definitions_the_matrix_and_the_one_likelihood_sentence(self):
        text = (self.DIR / "REVIEW_LAWS.md").read_text()
        self.assertIn("MIL-STD-882E", text)
        for word in ("Catastrophic", "Critical", "Marginal", "Negligible", "Frequent", "Probable", "Occasional", "Remote", "Improbable",
                     "Eliminated", "High", "Serious", "Medium", "Low"):
            self.assertIn(word, text)
        self.assertIn("not rated", text)
        self.assertEqual(text.count("Judge likelihood at the scale the change will run"), 1)
        self.assertNotIn("fleet-wide", text, "the single-item versus fleet-wide split is not adopted")
        rows = [l for l in text.splitlines() if re.match(r"^\| (Catastrophic|Critical|Marginal|Negligible) \| (Serious|High|Medium|Low) \(", l)]
        self.assertEqual(len(rows), 4)
        cells = {}
        for row in rows:
            parts = [c.strip() for c in row.strip("|").split("|")]
            self.assertEqual(len(parts), 6, row)
            for cell in parts[1:]:
                self.assertRegex(cell, r"^(High|Serious|Medium|Low) \([H2.]\)$")
            cells[parts[0]] = parts[1:]
        # the hold bands are exactly serious and high; medium asks for a second review; low does nothing
        for severity, row in cells.items():
            for cell in row:
                level, action = re.match(r"^(\w+) \((.)\)$", cell).groups()
                self.assertEqual(action, {"High": "H", "Serious": "H", "Medium": "2", "Low": "."}[level], cell)
        self.assertEqual(cells["Catastrophic"], ["Serious (H)", "High (H)", "High (H)", "High (H)", "High (H)"])

    def test_the_matrix_fixture_is_the_single_source_and_the_laws_table_equals_it(self):
        fixture = json.loads((self.DIR / "impact-matrix.json").read_text())
        self.assertEqual(fixture["severities"], ["Catastrophic", "Critical", "Marginal", "Negligible"])
        self.assertEqual(fixture["probabilities"], ["Improbable", "Remote", "Occasional", "Probable", "Frequent"])
        self.assertEqual(fixture["not_rated"], ["Eliminated"])
        self.assertEqual(sorted(set(fixture["actions"].values())), sorted(["H", "2", "."]))
        cells = fixture["cells"]
        self.assertEqual(sum(len(row) for row in cells.values()), 20)
        text = (self.DIR / "REVIEW_LAWS.md").read_text()
        for severity in fixture["severities"]:
            row = next(l for l in text.splitlines() if l.startswith("| %s | " % severity) and "(" in l)
            parts = [c.strip() for c in row.strip("|").split("|")]
            want = ["%s (%s)" % (cells[severity][p]["level"], cells[severity][p]["action"]) for p in fixture["probabilities"]]
            self.assertEqual(parts[1:], want, severity)
        for severity, row in cells.items():
            for probability, cell in row.items():
                self.assertEqual(cell["action"], fixture["actions"][cell["level"]], "%s/%s" % (severity, probability))
        self.assertIn("impact-matrix.json", text, "the laws name their single source")

    def test_the_laws_state_the_rules_the_plan_requires(self):
        text = (self.DIR / "REVIEW_LAWS.md").read_text()
        for needle in ("50 turns", "`incomplete`", "never builds, runs or tests", "base branch", "A finding that cites none is a proposal",
                       "must not contradict the repository's `AGENTS.md`", "untrusted text"):
            self.assertIn(needle, text)

    def test_the_scope_of_the_read_only_rule_and_the_floor_as_the_matrixs_companion_are_stated(self):
        text = (self.DIR / "REVIEW_LAWS.md").read_text()
        rule2 = next(l for l in text.splitlines() if l.startswith("- **R-LAW-2 "))
        self.assertIn("reviewer agent bound by these laws", rule2)
        self.assertIn("independent verification agent", rule2)
        self.assertIn("may run the repository's named checks", rule2)
        self.assertIn("says so in its own copy", rule2)
        rules = {l.split(" ", 2)[1].strip("*"): l for l in text.splitlines() if l.startswith("- **R-LAW-")}
        self.assertIn("The floor is the matrix's companion", rules["R-LAW-13"])
        self.assertIn("its authority is the matrix (R-LAW-11)", rules["R-LAW-13"])
        self.assertIn("the impact matrix below", rules["R-LAW-11"])
        self.assertNotIn("also holds changes", text, "the floor is a numbered rule, not an uncited aside")

    def test_r_law_16_and_17_are_in_both_copies_after_r_law_15_and_the_version_is_bumped(self):
        docs = (self.DIR / "REVIEW_LAWS.md").read_text()
        root = (REPO / "REVIEW_LAWS.md").read_text()
        self.assertEqual(docs, root, "the repository's own copy equals the starter set")
        for name in self.FILES:   # the repository's own copies may carry a section of their own; they open with the same version line
            self.assertEqual((self.DIR / name).read_text().splitlines()[0], (REPO / name).read_text().splitlines()[0], name)
        ids = [l.split(" ", 2)[1].strip("*") for l in docs.splitlines() if l.startswith("- **R-LAW-")]
        self.assertEqual(ids[ids.index("R-LAW-15") + 1:ids.index("R-LAW-15") + 3], ["R-LAW-16", "R-LAW-17"])
        self.assertEqual((self.DIR / "VERSION").read_text().strip(), "review-laws-2")
        rules = {l.split(" ", 2)[1].strip("*"): l for l in docs.splitlines() if l.startswith("- **R-LAW-")}
        for needle in ("A block about behaviour names its check", "check result not read", "stays at most a note", "it never blocks (R-LAW-14)", "reading the head's check results is reading"):
            self.assertIn(needle, rules["R-LAW-16"])
        self.assertNotIn("is a proposal and does not block", rules["R-LAW-16"])
        for needle in ("never the author's to chase", "once per head", "never by the author of the change", "counts for nothing in place of the missing one"):
            self.assertIn(needle, rules["R-LAW-17"])

    def test_owner_evaluators_are_rare_and_the_laws_say_so(self):
        text = (self.DIR / "REVIEW_LAWS.md").read_text()
        rule = next(l for l in text.splitlines() if l.startswith("- **R-LAW-15 "))
        for needle in ("Owner evaluators are rare", "own eyes are the test", "once at the epic's integrated head", "never waits on the owner", "claim: epic"):
            self.assertIn(needle, rule)

    def test_every_rule_says_how_it_is_checked_and_a_note_only_rule_never_blocks_alone(self):
        kinds = set()
        for name in self.FILES:
            for line in self.rules(name):
                match = re.search(r"_check: (diff|test|search|note only): [^_]+_$", line)
                self.assertIsNotNone(match, "no check hint: %r" % line[:90])
                kinds.add(match.group(1))
        self.assertEqual(kinds, {"diff", "test", "search", "note only"})
        text = (self.DIR / "REVIEW_LAWS.md").read_text()
        rule14 = next(l for l in text.splitlines() if l.startswith("- **R-LAW-14 "))
        self.assertIn("note only", rule14)
        self.assertIn("never blocks by itself", rule14)
        for rule in ("R-CODE-9", "R-CODE-10", "R-TEST-8"):
            line = next(l for name in self.FILES for l in self.rules(name) if l.startswith("- **%s " % rule))
            self.assertIn("check: note only", line, rule)

    def test_the_standards_carry_the_review_findings_that_recur(self):
        coding = "\n".join(self.rules("CODING_STANDARDS.md")).lower()
        security = "\n".join(self.rules("SECURITY_STANDARDS.md")).lower()
        for needle in ("fail open", "atomic", "check and act", "public-safe"):
            self.assertIn(needle, coding)
        for needle in ("identify the actor", "secret never becomes text", "untrusted text is data", "guardrail is not a boundary"):
            self.assertIn(needle, security)

    def test_the_starter_set_holds_no_private_name(self):
        names = os.environ.get("FLEET_PRIVATE_NAMES_FILE")
        script = REPO / "bin" / "check-public-names"
        done = subprocess.run([sys.executable, str(script), "--root", str(self.DIR)] + (["--names-file", names] if names else []),
                              capture_output=True, text=True)
        self.assertEqual(done.returncode, 0, done.stdout + done.stderr)

    def test_install_copies_exactly_the_four_files_each_opening_with_the_extends_line_and_says_what_to_edit(self):
        target = self.home / "acme-widget"
        target.mkdir()
        code, out, err = self.install(str(target))
        self.assertEqual(code, 0, err)
        self.assertEqual(sorted(p.name for p in target.iterdir()), sorted(self.FILES), "nothing else is written, no stray temp file")
        version = (self.DIR / "VERSION").read_text().strip()
        for name in self.FILES:
            self.assertEqual((target / name).read_text(), (self.DIR / name).read_text())
            self.assertEqual((target / name).read_text().splitlines()[0], "extends: fleet-kit-review-laws @ %s" % version)
            self.assertIn(name, out)
        self.assertIn("What to edit", out)
        self.assertIn("never loosen", out)

    def test_install_never_overwrites_a_repositorys_own_copy_unless_forced_and_leaves_agents_md_alone(self):
        target = self.home / "acme-widget"
        target.mkdir()
        (target / "CODING_STANDARDS.md").write_text("our own rules\n")
        (target / "AGENTS.md").write_text("build with make\n")
        code, out, err = self.install(str(target))
        self.assertEqual(code, 2)
        self.assertIn("already has CODING_STANDARDS.md", err)
        self.assertEqual((target / "CODING_STANDARDS.md").read_text(), "our own rules\n")
        self.assertFalse((target / "REVIEW_LAWS.md").exists(), "nothing was written")
        code, out, err = self.install(str(target), "--force")
        self.assertEqual(code, 0, err)
        self.assertEqual((target / "CODING_STANDARDS.md").read_text(), (self.DIR / "CODING_STANDARDS.md").read_text())
        self.assertEqual((target / "AGENTS.md").read_text(), "build with make\n")
        self.assertIn("AGENTS.md: it was not touched", out)

    def test_install_never_follows_a_symlink_even_a_dangling_one_and_not_with_force(self):
        target = self.home / "acme-widget"
        target.mkdir()
        elsewhere = self.home / "elsewhere.md"
        (target / "REVIEW_LAWS.md").symlink_to(elsewhere)   # dangling: the file it points at does not exist
        for argv in ((str(target),), (str(target), "--force")):
            code, out, err = self.install(*argv)
            self.assertEqual(code, 2)
            self.assertIn("symbolic link", err)
            self.assertFalse(elsewhere.exists(), "nothing was written through the link")
            self.assertTrue((target / "REVIEW_LAWS.md").is_symlink())
            self.assertFalse((target / "CODING_STANDARDS.md").exists())

    def test_install_says_the_version_once(self):
        target = self.home / "acme-widget"
        target.mkdir()
        code, out, err = self.install(str(target))
        self.assertNotIn("vreview-laws", out)
        self.assertIn("(review-laws-2)", out)

    def test_install_refuses_a_path_that_is_not_a_directory(self):
        code, out, err = self.install(str(self.home / "nowhere"))
        self.assertEqual(code, 2)
        self.assertIn("is not a directory", err)

    def test_the_install_stays_in_step_with_the_starter_set(self):
        # a starter set whose header differs from VERSION is refused by the command (it never copies an inconsistent set)
        real = sb.review_laws_source
        copy = self.home / "set"
        shutil.copytree(self.DIR, copy)
        (copy / "VERSION").write_text("2\n")
        target = self.home / "t"
        target.mkdir()
        with mock.patch.object(sb, "review_laws_source", lambda: copy):
            code, out, err = self.install(str(target))
        self.assertEqual(code, 2)
        self.assertIn("inconsistent", err)
        self.assertEqual(list(target.iterdir()), [])

    def test_the_docs_name_the_command(self):
        self.assertIn("review-laws install", (REPO / "docs" / "switchboard.md").read_text())



class TestReviewerSubagents(LedgerBase):
    """#179 slice L2: the four reviewer agents, `review laws` (from the base commit) and `review record` with its shadow line in `gates`."""

    BASE = "b" * 40
    ROLES = ("code", "architecture", "security", "impact", "test")
    LAW_FILES = ("REVIEW_LAWS.md", "CODING_STANDARDS.md", "SECURITY_STANDARDS.md", "TEST_STANDARDS.md", "REVIEW_OVERLAY.md")

    def setUp(self):
        super().setUp()
        self.pr = dict(self.pr, baseRefOid=self.BASE, baseRefName="main", files=[], changedFiles=0)   # (#1047) a change with no files: an empty files-read list is whole
        self.contents_calls = []
        self.list_calls = []
        self.merged_prs = []
        self.contents = {(name, self.BASE): "base text of %s: rule R-CODE-3\n" % name for name in self.LAW_FILES[:4]}
        self.contents[("REVIEW_LAWS.md", LEDGER_HEAD)] = "EDITED BY THE PR HEAD\n"

    def route(self, argv, **kwargs):
        if argv[0] == FAKE_GH and argv[1] == "api" and "/contents/" in argv[2]:
            self.contents_calls.append(argv[2])
            match = re.search(r"/contents/([^?]+)\?ref=([0-9a-f]+)", argv[2])
            text = self.contents.get((match.group(1), match.group(2)))
            if text is None:
                return subprocess.CompletedProcess(argv, 1, "", "gh: Not Found (HTTP 404)")
            body = {"content": base64.b64encode(text.encode()).decode(), "encoding": "base64"}
            return subprocess.CompletedProcess(argv, 0, json.dumps(body), "")
        if argv[0] == FAKE_GH and argv[1:3] == ["pr", "list"]:
            self.list_calls.append(argv)
            return subprocess.CompletedProcess(argv, 0, json.dumps(self.merged_prs), "")
        return super().route(argv, **kwargs)

    def review(self, who, *argv):
        return self.run_as(who, "review", *argv)

    def record(self, who, reviewer, verdict="approve", *more, head=None):
        argv = ["record", self.PR, "--reviewer", reviewer, "--verdict", verdict, *more]
        if head:
            argv += ["--head", head]
        return self.review(who, *argv)

    def front(self, role):
        text = (REPO / "agents" / "reviewers" / ("reviewer-%s.md" % role)).read_text()
        head = text.split("---\n")[1]
        perms = [(m.group(1), m.group(2), m.group(3)) for m in re.finditer(r'- \{action: "?([^,"]+)"?, resource: "([^"]+)", effect: (allow|deny)\}', head)]
        return text, head, perms

    # -- the definitions

    def test_each_reviewer_is_a_read_only_subagent_with_a_50_turn_limit_and_no_build_or_test_command(self):
        for role in self.ROLES:
            with self.subTest(role=role):
                text, head, perms = self.front(role)
                self.assertRegex(head, r"(?m)^mode: subagent$")
                self.assertRegex(head, r"(?m)^steps: 50$")
                self.assertRegex(head, r"(?m)^model: __PROVIDER__/__MODEL_ID__$")
                self.assertNotRegex(head, r"(?m)^name:", "a name key makes v2 ignore the whole list")
                self.assertEqual(perms[0], ("*", "*", "deny"), "deny by default")
                allows = [(a, r) for a, r, e in perms if e == "allow"]
                self.assertEqual(sorted(allows), sorted([("read", "*"), ("glob", "*"), ("grep", "*"),
                                                         ("shell", "fleet-switchboard review laws *"),
                                                         ("shell", "git diff *"), ("shell", "git log *"), ("shell", "git show *"),
                                                         ("shell", "gh pr diff *"), ("shell", "gh pr view *"), ("shell", "gh pr checks *")]))
                self.assertIn(("edit", "*", "deny"), perms)
                for word in ("make", "pytest", "python", "node", "npm", "cargo", "go", "bin/test"):
                    self.assertFalse([1 for a, r, e in perms if e == "allow" and a == "shell" and r.startswith(word)], word)   # not allowed: default deny covers it
                for verb in ("record", "send", "report", "launch", "waive", "gates", "plan", "verdict", "prove", "comment", "edit", "push", "commit"):
                    self.assertFalse([1 for a, r, e in perms if e == "allow" and verb in r.split()], "no write command: " + verb)
                self.assertLessEqual(len(head.rstrip("\n").splitlines()), 40, "a short, hand-readable permission block")
                last_allow = max(i for i, p in enumerate(perms) if p[2] == "allow")
                self.assertTrue(all(p[2] == "deny" for p in perms[last_allow + 1:]), "the denies come last: last match wins")

    def test_the_test_reviewer_judges_by_the_test_standards_and_cannot_run_what_it_reads(self):
        text, head, perms = self.front("test")
        self.assertIn("R-TEST", text)
        self.assertIn("TEST_STANDARDS.md", text)
        self.assertNotIn("SECURITY_STANDARDS.md and REVIEW_LAWS", text)
        shells = [r for a, r, e in perms if a == "shell" and e == "allow"]
        self.assertFalse([r for r in shells if r.split()[0] not in ("fleet-switchboard", "git", "gh")], shells)
        self.assertFalse([r for r in shells if "record" in r or "test" in r.split()[1:2] or "pytest" in r])

    @staticmethod
    def merged(number, merged, title="a change", body="", commits=("2026-01-01T10:00:00Z",), green="2026-01-01T10:30:00Z", lines=(10, 5)):
        return {"number": number, "title": title, "body": body, "createdAt": commits[0], "mergedAt": merged, "additions": lines[0], "deletions": lines[1],
                "commits": [{"committedDate": c} for c in commits],
                "statusCheckRollup": [{"conclusion": "SUCCESS", "completedAt": green}, {"conclusion": "FAILURE", "completedAt": "2026-01-02T00:00:00Z"}]}

    def test_review_measure_computes_each_column_and_the_two_groups_without_writing_anything(self):
        self.merged_prs = [self.merged(1, "2026-01-01T12:00:00Z"), self.merged(2, "2026-01-02T12:00:00Z", lines=(100, 100)),
                           self.merged(3, "2026-01-03T12:00:00Z", green="2026-01-03T10:10:00Z", commits=("2026-01-03T10:00:00Z",)),
                           self.merged(4, "2026-01-04T12:00:00Z", title="Fix the thing from #2", body="")]
        self.merged_prs[2]["commits"] = [{"committedDate": "2026-01-03T10:00:00Z"}]
        self.merged_prs[2]["createdAt"] = "2026-01-03T10:00:00Z"
        code, out, err = self.review("coder", "measure", "acme/app", "--count", "2", "--split", "3", "--json")
        self.assertEqual(code, 0, err)
        data = json.loads(out)
        self.assertEqual([r["pr"] for r in data["baseline"]], [1, 2])
        self.assertEqual([r["pr"] for r in data["after"]], [3, 4])
        by = {r["pr"]: r for r in data["baseline"] + data["after"]}
        self.assertEqual(by[1]["to_green_min"], 30.0)
        self.assertEqual(by[3]["to_green_min"], 10.0)
        self.assertEqual((by[2]["lines"], by[2]["escaped"], by[1]["escaped"]), (200, 1, 0), "the fix naming #2 within 14 days marks #2 only")
        self.assertEqual(by[1]["rounds"], None, "no recorded review: blank, not zero")
        self.assertEqual(self.list_calls[0][self.list_calls[0].index("--state") + 1], "merged")
        code, out, err = self.review("coder", "measure", "acme/app", "--count", "2", "--split", "3")
        self.assertEqual(code, 0, err)
        self.assertIn("BASELINE (2 PRs", out)
        self.assertIn("AFTER (2 PRs", out)
        self.assertIn("median", out)

    def test_review_measure_counts_recorded_review_heads_and_findings_and_refuses_bad_bounds_and_unknown_split(self):
        self.merged_prs = [self.merged(7, "2026-01-01T12:00:00Z")]
        entries = [{"kind": "review_record", "pr": "acme/app#7", "head": "a" * 40, "reviewer": "code", "blocks": 1, "notes": 2},
                   {"kind": "review_record", "pr": "acme/app#7", "head": "b" * 40, "reviewer": "code", "blocks": 0, "notes": 1},
                   {"kind": "review_record", "pr": "other/app#7", "head": "c" * 40, "reviewer": "code", "blocks": 9, "notes": 9}]
        row = sb.measure_row(self.merged_prs[0], entries, self.merged_prs, "acme/app")
        self.assertEqual((row["rounds"], row["blocks"], row["notes"]), (2, 1, 3))
        for bad in (("--count", "0"), ("--count", "51"), ("--scan", "41"), ("--count", "10", "--scan", "5")):
            with self.subTest(bad=bad):
                code, out, err = self.review("coder", "measure", "acme/app", *bad)
                self.assertEqual(code, sb.EXIT_USAGE)
                self.assertIn("review measure", err)
        code, out, err = self.review("coder", "measure", "acme/app", "--split", "999")
        self.assertEqual(code, sb.EXIT_USAGE)
        self.assertIn("#999", err)

    def test_review_measure_strips_terminal_escapes_from_titles_and_reports_every_way_gh_can_fail(self):
        self.merged_prs = [self.merged(1, "2026-01-01T12:00:00Z", title="evil \x1b[31mred\x07 title")]
        code, out, err = self.review("coder", "measure", "acme/app", "--count", "1")
        self.assertEqual(code, 0, err)
        self.assertNotRegex(out, r"[\x00-\x08\x0b-\x1f\x7f-\x9f]")
        self.assertIn("evil", out)
        real = self.route
        for answer, why in ((subprocess.CompletedProcess([], 1, "", "gh: boom"), "failed"), (subprocess.CompletedProcess([], 0, "not json", ""), "JSON"),
                            (subprocess.CompletedProcess([], 0, "{}", ""), "not a list")):
            with self.subTest(why=why):
                self.route = lambda argv, answer=answer, **kw: answer if argv[1:3] == ["pr", "list"] else real(argv, **kw)
                code, out, err = self.review("coder", "measure", "acme/app")
                self.assertEqual(code, sb.EXIT_USAGE)
                self.assertIn(why, err)

    def test_review_measure_edges_the_escape_window_the_number_match_missing_checks_and_no_split(self):
        base = self.merged(2, "2026-01-01T12:00:00Z")
        for title, merged, body, expect in (("Fix it", "2026-01-16T12:00:01Z", "for #2", 0), ("Fix it", "2025-12-31T12:00:00Z", "for #2", 0),
                                            ("Update things", "2026-01-02T12:00:00Z", "for #2", 0), ("Fix it", "2026-01-02T12:00:00Z", "for #20", 0),
                                            ("Revert it", "2026-01-15T12:00:00Z", "reverts #2", 1)):
            with self.subTest(title=title, merged=merged, body=body):
                other = self.merged(9, merged, title=title, body=body)
                self.assertEqual(sb.measure_row(base, [], [base, other], "acme/app")["escaped"], expect)
        none_green = dict(base, statusCheckRollup=[{"conclusion": "FAILURE", "completedAt": "2026-01-01T11:00:00Z"}])
        self.assertIsNone(sb.measure_row(none_green, [], [none_green], "acme/app")["to_green_min"])
        early = dict(base, statusCheckRollup=[{"conclusion": "SUCCESS", "completedAt": "2025-01-01T00:00:00Z"}])
        self.assertIsNone(sb.measure_row(early, [], [early], "acme/app")["to_green_min"])
        self.assertEqual(sb._median([1, 2, 3, 10]), 2.5)
        self.merged_prs = [self.merged(n, "2026-01-0%dT12:00:00Z" % n) for n in (1, 2, 3)]
        code, out, err = self.review("coder", "measure", "acme/app", "--count", "2")
        self.assertEqual(code, 0, err)
        self.assertIn("BASELINE (2 PRs", out)
        self.assertNotIn("AFTER", out)
        row = out.split("\n")[2].split()
        self.assertEqual(row[-4:-1], ["-", "-", "-"], "no recorded review: rounds, blocks and notes print as dashes")

    def test_review_measure_warns_loudly_and_carries_on_when_the_ledger_chain_is_damaged(self):
        self.merged_prs = [self.merged(9, "2026-01-01T12:00:00Z")]
        with mock.patch.object(sb.plan_ledger, "read_ledger", return_value=([], "line 3: the chain breaks")):
            code, out, err = self.review("coder", "measure", "acme/app", "--count", "1", "--json")
        self.assertEqual(code, 0, err)
        self.assertIn("review ledger is damaged (line 3: the chain breaks)", err)
        self.assertIsNone(json.loads(out)["baseline"][0]["rounds"])

    def test_review_measure_reads_the_ledger_for_this_repository_only(self):
        self.merged_prs = [self.merged(9, "2026-01-01T12:00:00Z")]
        code, out, err = self.record("coder", "code", "approve", "--blocks", "0", "--notes", "2")
        self.assertEqual(code, 0, err)
        for repo, expect in (("acme/app", (1, 2)), ("other/app", (None, None))):
            with self.subTest(repo=repo):
                code, out, err = self.review("coder", "measure", repo, "--count", "1", "--json")
