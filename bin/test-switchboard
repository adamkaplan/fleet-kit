    def test_awaiting_live_label_silences_t3_t9_and_t12_and_only_that_label(self):
        self.charter()
        self.add(90, created=9, updated=4, parent=1, labels=["kind", "bot:awaiting-live"])    # an ask quiet 4d, waiting on a live event
        self.add(91, created=9, updated=4, parent=1, labels=["kind"])                         # the same ask without the label
        self.add(92, created=20, updated=4, assignees=["bot"], labels=["kind", "bot:awaiting-live"])
        self.add(93, created=20, updated=4, assignees=["bot"], labels=["kind"], body="Next: go")
        self.add(94, created=20, updated=4, assignees=["bot"], labels=["kind", "bot:awaiting-live"], body="Next: go")
        self.merged_pr(250, "Part of #93. Part of #94.")
        for n in (90, 92, 94):
            self.timeline(n, label_days=1)                                          # a fresh label (#576): quiet
        self.go()
        self.assertEqual(self.only("T3"), ["acme/api#91"])                  # T3 skips any awaiting label (pinned)
        self.assertNotIn(("T3", "acme/api#90"), self.found())
        self.assertNotIn(("T3", "acme/api#92"), self.found())
        self.assertEqual(self.only("T9"), [])                               # #90 is skipped; #91 is T3, which takes precedence
        self.assertEqual(self.only("T12"), ["acme/api#93"])                 # #94 waits on a live event

    def test_t9_fires_for_a_silent_ask_with_a_next_step_only_without_the_awaiting_live_label(self):
        self.charter()
        self.add(95, created=9, updated=4, parent=1, labels=["kind", "bot:awaiting-live"], body="Next: x")
        self.add(96, created=9, updated=4, parent=1, labels=["kind"], body="Next: x")
        self.timeline(95, label_days=1)
        self.go()
        self.assertEqual(self.only("T9"), ["acme/api#96"])

    def test_awaiting_live_expiry_a_fresh_label_or_one_with_a_newer_comment_is_quiet_an_old_one_is_t9(self):
        self.charter()
        self.add(110, created=30, updated=3, assignees=["bot"], labels=["kind", self.LIVE], body="Next: go")   # label 14d + 1h old, no comment
        self.add(111, created=30, updated=3, assignees=["bot"], labels=["kind", self.LIVE], body="Next: go")   # label 13d old
        self.add(112, created=30, updated=3, assignees=["bot"], labels=["kind", self.LIVE], body="Next: go")   # label 15d old, a comment after it
        self.timeline(110, label_days=14 + 1 / 24)
        self.timeline(111, label_days=13)
        self.timeline(112, label_days=15, comment_days=2)
        self.go(passes=1)
        self.assertEqual(self.only("T9"), ["acme/api#110"])
        row = [e for e in self.world.audit() if e["event"] == "triage.finding" and e["detail"]["rule"] == "T9"][0]
        self.assertEqual(row["detail"]["evidence"]["reason"], "awaiting-live expired")
        self.assertEqual(self.only("T12"), [])

    def test_awaiting_live_expiry_the_limit_is_the_configured_key_and_a_re_added_label_resets_the_age(self):
        self.charter()
        self.add(113, created=30, updated=3, assignees=["bot"], labels=["kind", self.LIVE], body="Next: go")
        self.add(114, created=30, updated=3, assignees=["bot"], labels=["kind", self.LIVE], body="Next: go")
        old = {"id": 1, "event": "labeled", "label": {"name": self.LIVE}, "created_at": sb.iso(self.now - 20 * 86400)}
        gone = {"id": 2, "event": "unlabeled", "label": {"name": self.LIVE}, "created_at": sb.iso(self.now - 19 * 86400)}
        self.timeline(113, label_days=1, extra=[old, gone])                      # set 20d ago, removed, set again 1d ago: the latest event counts
        self.timeline(114, label_days=5)
        self.engine.config["awaiting_live_days"] = 4                             # the module-declared key
        self.go(passes=1)
        self.assertEqual(self.only("T9"), ["acme/api#114"])

    def test_awaiting_live_expiry_an_unreadable_or_cut_timeline_is_visible_as_age_unknown_never_quiet(self):
        self.charter()
        self.add(115, created=30, updated=3, assignees=["bot"], labels=["kind", self.LIVE], body="Next: go")   # the read fails
        self.add(116, created=30, updated=3, assignees=["bot"], labels=["kind", self.LIVE], body="Next: go")   # the page is not the whole timeline
        self.add(117, created=30, updated=3, assignees=["bot"], labels=["kind", self.LIVE], body="Next: go")   # no label event in it
        self.timeline(116, label_days=30)
        self.hub.cut.add(116)
        self.timeline(117)
        self.go(passes=1)
        self.assertEqual(self.only("T9"), ["acme/api#115", "acme/api#116", "acme/api#117"])
        reasons = {e["detail"]["ref"]: e["detail"]["evidence"]["reason"] for e in self.world.audit() if e["event"] == "triage.finding" and e["detail"]["rule"] == "T9"}
        self.assertEqual(set(reasons.values()), {"awaiting-live age unknown"})
        for e in self.world.audit():
            if e["event"] == "triage.finding" and e["detail"]["rule"] == "T9":
                self.assertNotIn("label_days", e["detail"]["evidence"])             # an unknown age claims no age

    def test_awaiting_live_expiry_edges_an_older_comment_does_not_count_just_inside_the_limit_is_quiet_and_a_failed_read_is_retried(self):
        self.charter()
        self.add(130, created=30, updated=3, assignees=["bot"], labels=["kind", self.LIVE], body="Next: go")   # a comment BEFORE the label: still expires
        self.add(131, created=30, updated=3, assignees=["bot"], labels=["kind", self.LIVE], body="Next: go")   # just inside 14 days: not yet
        self.add(132, created=30, updated=3, assignees=["bot"], labels=["kind", self.LIVE], body="Next: go")   # the read fails now, works later
        self.timeline(130, label_days=15, comment_days=16)
        self.timeline(131, label_days=14 - 0.0005)                                  # a minute inside the limit (the pass ticks the clock)
        self.go(passes=1)
        self.assertEqual(self.only("T9"), ["acme/api#130", "acme/api#132"])     # 132: age unknown
        self.timeline(132, label_days=1)
        self.go(passes=1)
        self.assertEqual(self.only("T9"), ["acme/api#130", "acme/api#132"])     # inside the retry wait: still the unknown finding, no new read
        self.assertEqual(len([c for c in self.hub.calls if "/issues/132/timeline" in c]), 1)
        self.world.tick(sb.TRIAGE_TTL + 5)
        self.go(passes=1)
        self.assertEqual(len([c for c in self.hub.calls if "/issues/132/timeline" in c]), 2)   # read again after the wait
        self.assertIsNotNone(sb.triage_state(self.engine).live[("acme/api", 132)]["info"])      # now read: its age is known and fresh

    def test_awaiting_live_days_falls_back_to_the_default_for_an_unusable_value_and_t12_stays_exempt_for_a_fresh_label(self):
        module = sb.load_module("awaiting_live")
        for bad in (None, 0, -3, True, "x", 4000):
            self.assertEqual(module.days_of({"awaiting_live_days": bad}), 14)
        self.assertEqual(module.days_of({"awaiting_live_days": 2.5}), 2.5)
        self.charter()
        self.add(133, created=60, updated=3, assignees=["bot"], labels=["kind", self.LIVE], body="Next: go")
        self.timeline(133, label_days=1)
        self.merged_pr(260, "Part of #133")
        self.go(passes=1)
        self.assertEqual(self.only("T12"), [])                                  # its PR merged, yet the fresh label keeps T12 quiet
        self.assertEqual(self.only("T9"), [])

    def test_awaiting_live_expiry_an_issue_without_the_label_is_never_read_and_judged_as_before(self):
