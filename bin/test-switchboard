        self.assertIn("termworker", engine.pane_alerts)

    def test_the_status_command_lists_a_headless_worker_it_reads_the_records_from_the_state_directory(self):
        sid = self.headless()
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        report = sb.collect_status(self.world.route, self.world.clock.now)
        rows = {row["name"]: row for row in report["agents"]["list"]}
        self.assertIn("hw", rows, "status never listed a worker with no terminal: it built its engine with no state directory")
        self.assertEqual((rows["hw"]["observation"]["session"], rows["hw"]["observation"]["status"]), (sid, "idle"))
        self.assertTrue(rows["hw"]["observation"]["headless"])

    def test_a_discovery_that_did_not_scan_the_records_judges_nothing_lost(self):
        self.world.add_agent("cos", fleet={"role": "chief-of-staff"})
        sid = self.headless()
        engine = self.world.new_engine("cli")
        engine.discover(self.world.clock.now())
        del self.world.v2.sessions[sid]
        engine.discovery.headless_records = None                          # this look did not scan (or the scan failed)
        self.assertEqual([f for f in engine.collect_facts()[0] if f.kind in ("headless.lost", "headless.restarted")], [])
        engine.discover(self.world.clock.now())                           # the next look scans, sees the record, finds the session gone
        self.assertEqual(len([f for f in engine.collect_facts()[0] if f.kind == "headless.lost"]), 1)

    def test_the_status_command_writes_nothing_in_the_state_directory(self):
        self.headless()
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        state, writes = str(self.world.state), []
        real = {"replace": os.replace, "rename": os.rename, "open": os.open, "builtin": open}
        def note(path):
            if str(path).startswith(state) and not str(path).endswith(".lock"):
                writes.append(str(path))
        def replace(src, dst, *a, **k):
            note(dst); return real["replace"](src, dst, *a, **k)
        def rename(src, dst, *a, **k):
            note(dst); return real["rename"](src, dst, *a, **k)
        def os_open(path, flags, *a, **k):
            if flags & (os.O_WRONLY | os.O_RDWR | os.O_CREAT | os.O_TRUNC | os.O_APPEND):
                note(path)
            return real["open"](path, flags, *a, **k)
        def builtin_open(file, mode="r", *a, **k):
            if isinstance(file, (str, os.PathLike)) and any(c in str(mode) for c in "wax+"):
                note(file)
            return real["builtin"](file, mode, *a, **k)
        with mock.patch.object(os, "replace", replace), mock.patch.object(os, "rename", rename), \
                mock.patch.object(os, "open", os_open), mock.patch("builtins.open", builtin_open):
            report = sb.collect_status(self.world.route, self.world.clock.now)
        self.assertIn("hw", [row["name"] for row in report["agents"]["list"]], "the worker is listed (the premise of the check)")
        self.assertEqual(writes, [], "status wrote nothing in the state directory (lock files excepted: every command makes them)")

    def test_a_status_engine_given_a_real_state_directory_would_write_so_the_check_above_bites(self):
        """The mutation the writes test must catch: the same status engine with `state_dir` set records the remembered bosses."""
        self.headless()
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        real, wrote = sb.Switchboard.__init__, []
        def with_state_dir(engine, config, v2, herdr, audit, sources=(), now=None, actor="daemon", intents=None, state_dir=None):
            real(engine, config, v2, herdr, audit, sources, now, actor, intents, state_dir=self.world.state)
        original_write = sb._write_small
        with mock.patch.object(sb.Switchboard, "__init__", with_state_dir), \
                mock.patch.object(sb, "_write_small", lambda state, name, data: wrote.append(name) or original_write(state, name, data)):
            sb.collect_status(self.world.route, self.world.clock.now)
        self.assertIn(sb.HEADLESS_SERVICE_FILE, wrote, "with a state directory the engine writes: this is what the status engine must never be given")

    def test_a_reassigned_boss_is_shown_for_a_headless_worker_in_status_and_in_the_daemon_and_a_terminal_workers_row_is_unchanged(self):
        sid = self.headless()
        terminal = self.world.add_agent("termworker", fleet={"role": "coder", "reports_to": "boss"})
        reassign = sb.load_module("reassign")
        reassign.write_overrides(self.world.state, {
            "hw": {"boss": "boss2", "was": "boss", "original": "boss", "session": sid, "by": "operator", "at": self.world.clock.now()},
            "termworker": {"boss": "boss2", "was": "boss", "original": "boss", "session": self.world.sessions["termworker"], "by": "operator", "at": self.world.clock.now()}})
        daemon = self.world.new_engine("cli").discover(self.world.clock.now()).agents
        self.assertEqual((daemon["hw"].fleet["reports_to"], daemon["termworker"].fleet["reports_to"]), ("boss2", "boss2"), "the daemon follows the reassignment for both")
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        rows = {row["name"]: row["observation"] for row in sb.collect_status(self.world.route, self.world.clock.now)["agents"]["list"] if row.get("observation")}
        self.assertEqual(rows["hw"]["fleet"]["reports_to"], "boss2", "status shows the headless worker's reassigned boss")
        self.assertEqual(rows["termworker"]["fleet"]["reports_to"], "boss", "a terminal worker's status row is exactly as before (the status engine has no state directory)")

    def test_a_worker_launched_during_a_pass_is_never_reported_lost_by_that_pass(self):
        """The daemon discovers, THEN the fact sources run; a launch that lands between the two wrote its record after discovery looked."""
        self.world.add_agent("cos", fleet={"role": "chief-of-staff"})    # a lost report with no remembered boss goes to the Chiefs of Staff
        engine = self.world.new_engine("cli")
        engine.discover(self.world.clock.now())                           # the pass's discovery: no headless record yet
        sid = self.headless()                                             # the launch lands now: the session AND its record
        facts = [f for f in engine.collect_facts()[0] if f.kind == "headless.lost"]
        self.assertEqual(facts, [], "a record discovery never saw is not a lost session")
        self.assertEqual(self.discover().agents["hw"].session_id, sid)   # the next pass finds it
        self.assertEqual([f for f in engine.collect_facts()[0] if f.kind == "headless.lost"], [])

    def test_status_lists_it_with_the_pane_headless(self):
        self.headless()
        line = sb._agent_line({"name": "hw", "observation": self.discover().agents["hw"].to_json(), "plan": None})
        self.assertIn("(headless)", line)
        self.assertIn("idle", line)

    def test_the_record_is_private_and_only_a_loopback_local_worker_is_accepted(self):
        sid = self.headless(register=False)
        body = self.ap.save_record(self.world.state, "hw", sid, self.url, now=5)
        self.assertEqual((body["kind"], body["worker"], body["session"], body["url"]), ("local", "hw", sid, self.url))
        path = Path(self.world.state) / "headless" / "hw.json"
        self.assertEqual(oct(path.stat().st_mode & 0o777), "0o600")
        self.assertEqual(oct((Path(self.world.state) / "headless").stat().st_mode & 0o777), "0o700")
        for bad in ("https://example.test:443", "http://example.test:80", "http://127.0.0.1", "http://127.0.0.1:49374/x", "ftp://127.0.0.1:1"):
            with self.assertRaises(ValueError, msg=bad):
                self.ap.save_record(self.world.state, "hw", sid, bad)
        with self.assertRaises(ValueError):
            self.ap.save_record(self.world.state, "../escape", sid, self.url)
        with self.assertRaises(ValueError):
            self.ap.save_record(self.world.state, "hw", "not-a-session", self.url)
        path.chmod(0o644)
        self.assertIsNone(self.ap.load_record(self.world.state, "hw"), "a record anyone can write is not trusted")
        path.chmod(0o600)
        self.assertEqual(self.ap.load_record(self.world.state, "hw")["session"], sid)
        path.write_text("{not json")
        self.assertIsNone(self.ap.load_record(self.world.state, "hw"))
        self.assertEqual(self.ap.list_records(self.world.state), [])

    def test_an_unusable_record_is_said_in_discovery_one_line_each_and_reading_never_creates_the_directory(self):
        state = Path(self.world.state)
        self.assertEqual(self.discover().problems, [], "no directory, no records: silent")
        self.assertFalse((state / "headless").exists(), "a read creates nothing")
        sid = self.headless()
        (state / "headless" / "hw.json").chmod(0o644)
        (state / "headless" / "bad.json").write_text("{not json")
        (state / "headless" / "bad.json").chmod(0o600)
        problems = self.discover().problems
        self.assertEqual(len([p for p in problems if "headless record" in p]), 2, problems)
        self.assertTrue(any("hw" in p and "not private" in p for p in problems), problems)
        self.assertTrue(any("bad" in p and "not readable JSON" in p for p in problems), problems)
        self.assertNotIn("hw", self.discover().agents, "an untrusted record is not a worker")
        self.assertEqual(self.ap.read_record(self.world.state, "nobody"), (None, None))

    def test_the_scan_says_a_cap_a_misnamed_file_and_a_symlinked_directory_and_removing_creates_nothing(self):
        state = Path(self.world.state)
        self.assertFalse(self.ap.remove_record(self.world.state, "hw"))
        self.assertFalse((state / "headless").exists(), "removing a record that is not there makes no directory")
        sid = self.headless(register=False)
        for n in range(self.ap.MAX_RECORDS + 3):
            self.ap.save_record(self.world.state, "w%03d" % n, sid, self.url)
        (state / "headless" / "Bad Name.json").write_text("{}")
        records, problems = self.ap.scan_records(self.world.state)
        self.assertEqual(len(records), self.ap.MAX_RECORDS)
        self.assertTrue(any("more than %d headless records" % self.ap.MAX_RECORDS in p for p in problems), problems)
        self.assertTrue(any("Bad Name.json" in p and "not named for a worker" in p for p in problems), problems)
        real = state / "headless"
        moved = state / "headless-real"
        real.rename(moved)
        os.symlink(str(moved), str(real))
        records, problems = self.ap.scan_records(self.world.state)
        self.assertEqual(records, [])
        self.assertEqual(len(problems), 1)
        self.assertIn("not the user's own real directory", problems[0])
        self.assertIsNone(self.ap.load_record(self.world.state, "w000"))

    def launch_hl(self, **overrides):
        args = dict(name="hw", agent="coder", directory=str(self.home), role="coder", reports_to="boss", issue=9, brief="Add a health check")
        args.update(overrides)
        return sb.launch_headless(self.engine, **args)

    def test_a_headless_launch_records_who_ran_it_so_a_headless_tester_can_count_for_its_orchestrator(self):
        done = self.launch_hl(name="hw-tst", role="tester", launched_by="boss")
        fleet = self.world.v2.sessions[done["session"]]["metadata"]["fleet"]
        self.assertEqual((fleet["role"], fleet["reports_to"], fleet.get("launched_by")), ("tester", "boss", "boss"))
        plain = self.launch_hl(name="hw-plain", role="tester")                       # launched from a plain shell: nobody, so it never counts
        self.assertNotIn("launched_by", self.world.v2.sessions[plain["session"]]["metadata"]["fleet"])

    def test_launch_headless_creates_the_session_and_its_record_sends_the_brief_and_opens_no_terminal(self):
        panes_before, calls_before, sessions_before = dict(self.world.herdr.panes), list(self.world.herdr.socket_calls), set(self.world.v2.sessions)
        done = self.launch_hl()
        self.assertEqual(set(self.world.v2.sessions) - sessions_before, {done["session"]}, "exactly one new session")
        self.assertEqual((done["name"], done["pane"], done["tab"], done["headless"]), ("hw", None, None, True))
        session = self.world.v2.sessions[done["session"]]
        self.assertEqual(session["metadata"]["fleet"], {"name": "hw", "role": "coder", "reports_to": "boss", "issue": 9, "headless": True})
        self.assertEqual((session["agent"], session["directory"], session["title"]), ("coder", str(self.home), "hw"))
        self.assertEqual(self.world.herdr.panes, panes_before, "no pane appeared")
        self.assertEqual(self.world.herdr.socket_calls, calls_before, "herdr was asked for no layout, tab or pane")
        brief = [m for m in session["messages"] if m["type"] == "user"]
        self.assertEqual([(m["text"], m["metadata"]) for m in brief], [("Add a health check", {"fleet": {"from": "switchboard", "brief": True}})])
        record = self.ap.load_record(self.world.state, "hw")
        self.assertEqual((record["worker"], record["session"], record["kind"]), ("hw", done["session"], "local"))
        found = self.discover().agents["hw"]
        self.assertEqual((found.headless, found.pane, found.session_id), (True, None, done["session"]))
        self.assertTrue([e for e in self.world.audit() if e["event"] == "headless.launched" and e["subject"] == "hw"])

    def test_send_report_and_retire_work_for_a_headless_worker_unchanged(self):
        done = self.launch_hl()
        self.assertTrue(self.engine.send("boss", "hw", "second thought", None, None)["sent"])
        report = self.world.new_engine("cli").report("hw", "done", "finished the health check")
        self.assertTrue(report.get("sent"), report)
        boss_texts = [m.get("text", "") for m in self.world.v2.sessions[self.world.sessions["boss"]]["messages"] if m["type"] in ("user", "synthetic")]
        self.assertTrue(any("finished the health check" in t for t in boss_texts), boss_texts)
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        os.environ["HERDR_PANE_ID"] = self.world.panes["boss"]
        code, out, err = self.run_cli("retire", "hw", "--close")
        self.assertEqual(code, 0, err)
        self.assertIn("hw is retired", out)
        self.assertIn("nothing to close", out)
        self.assertEqual(self.world.herdr.closed, [], "no pane was closed")
        self.assertIn("hw", sb.read_retired(self.world.state))

    def test_a_headless_launch_refuses_a_taken_name_bad_arguments_and_a_terminal_option_and_a_failed_brief_is_undone_and_says_what_was_cleaned(self):
        self.launch_hl()
        with self.assertRaises(sb.LaunchError) as raised:
            self.launch_hl()
        self.assertIn("already exists (headless)", str(raised.exception))
        self.world.add_agent("termworker", fleet={"role": "coder", "reports_to": "boss"})
        with self.assertRaises(sb.LaunchError) as raised:
            self.launch_hl(name="termworker")
        self.assertIn("in pane", str(raised.exception))
        for bad, fragment in ((dict(name="Bad Name"), "name must match"), (dict(directory="relative/dir"), "--dir must be an absolute path"),
                              (dict(agent=""), "--agent is required"), (dict(name="switchboard"), "is reserved")):
            with self.assertRaises(sb.LaunchError, msg=bad) as raised:
                self.launch_hl(**dict(bad, name=bad.get("name", "other")))
            self.assertIn(fragment, str(raised.exception), bad)
        self.assertEqual(sorted(p.stem for p in (Path(self.world.state) / "headless").glob("*.json")), ["hw"], "a refused launch writes no record")
        real_prompt = sb.V2Client.prompt

        def rejecting(self_, session_id, text, metadata=None, delivery=None, resume=None):
            raise sb.V2Error("exit", None, "the service refused the prompt")

        with mock.patch.object(sb.V2Client, "prompt", rejecting):
            with self.assertRaises(sb.LaunchError) as raised:
                self.launch_hl(name="halfway")
        text = str(raised.exception)
        self.assertIn("launch failed; session ses_", text)
        self.assertIn("was deleted", text)
        self.assertIn("its record was removed", text)
        self.assertIsNone(self.ap.load_record(self.world.state, "halfway"), "no record is left for a worker that was never handed over")
        self.assertEqual([s for s in self.world.v2.sessions.values() if s["metadata"].get("fleet", {}).get("name") == "halfway"], [], "no orphan session")
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        code, out, err = self.run_cli("launch", "again", "--agent", "coder", "--dir", str(self.home), "--headless", "--workspace", "w1")
        self.assertNotEqual(code, 0)
        self.assertIn("--headless opens no terminal", err)

    def test_a_failed_launch_after_the_session_exists_deletes_it_and_says_exactly_what_was_cleaned_and_what_remains(self):
        sessions_before = set(self.world.v2.sessions)
        with mock.patch.object(self.ap, "save_record", side_effect=OSError("disk full")):
            with self.assertRaises(sb.LaunchError) as raised:
                self.launch_hl(name="nosave")
        text = str(raised.exception)
        self.assertIn("disk full", text)
        self.assertRegex(text, r"session ses_\w+ was deleted")
        self.assertNotIn("record kept", text)
        self.assertEqual(set(self.world.v2.sessions), sessions_before, "the session created for the launch is gone: no orphan")
        self.assertIsNone(self.ap.load_record(self.world.state, "nosave"))
        events = [e for e in self.world.audit() if e["event"] == "headless.launch_undone" and e["subject"] == "nosave"]
        self.assertEqual(len(events), 1)
        self.world.v2.remove_fails = True       # the service cannot delete: the session remains and the message says so
        with mock.patch.object(self.ap, "save_record", side_effect=OSError("disk full")):
            with self.assertRaises(sb.LaunchError) as raised:
                self.launch_hl(name="nodel")
        text = str(raised.exception)
        self.assertRegex(text, r"session ses_\w+ could NOT be deleted")
        self.assertIn("it has no record", text)
        self.world.v2.remove_fails = False
        with mock.patch.object(sb.V2Client, "prompt", side_effect=sb.V2Error("exit", None, "refused")):
            self.world.v2.remove_fails = True
            with self.assertRaises(sb.LaunchError) as raised:
                self.launch_hl(name="keeps")
        text = str(raised.exception)
        self.assertIn("could NOT be deleted", text)
        self.assertIn("its record was kept", text, "a session that remains keeps its record so status shows it")
        self.assertIsNotNone(self.ap.load_record(self.world.state, "keeps"))

    def test_a_headless_launch_into_a_repo_with_a_named_gh_account_is_refused_and_any_other_says_what_identity_it_has(self):
        self.engine.accounts = sb.GhAccounts({"gh": "gh", "call_timeout_seconds": 5, "gh_users": {"acme/*": "acct-ops"}}, self.world.route, self.world.clock.now, environ={})
        sessions_before = set(self.world.v2.sessions)
        with self.assertRaises(sb.LaunchError) as raised:
            self.launch_hl(name="pinned", repo="acme/widget")
        text = str(raised.exception)
        self.assertIn("acct-ops", text)
        self.assertIn("Use a terminal launch", text)
        self.assertEqual(set(self.world.v2.sessions), sessions_before, "refused before anything was created")
        self.assertIsNone(self.ap.load_record(self.world.state, "pinned"))
        done = self.launch_hl(name="plain", repo="other/thing")
        self.assertIn("acts as the OpenCode service environment's own gh account", done["identity"])
        self.assertIn("other/thing", done["identity"])
        self.assertIn("it has no repo", self.launch_hl(name="norepo")["identity"])

    def mapped_route(self, check=None):
        self.engine.accounts = sb.GhAccounts({"gh": "gh", "call_timeout_seconds": 5, "gh_users": {"acme-org/*": "acme-bot"}}, self.world.route, self.world.clock.now,
                                             environ={"GH_TOKEN": "tok-FAKE-9f3a"})
        self.engine.route_check = check if check is not None else (lambda: None)

    def test_a_headless_launch_for_a_mapped_repo_is_accepted_when_the_route_is_proved_and_no_token_is_kept_anywhere(self):
        self.mapped_route()
        done = self.launch_hl(name="mapped", repo="acme-org/widget-api")
        self.assertIn("set up to act as the gh account acme-bot", done["identity"])
        self.assertIn("record resolves to that repo", done["identity"], "the line that only the proof returns, so a launch that never proved fails")
        self.assertIn("NOT checked", done["identity"])
        self.assertEqual(self.world.v2.sessions[done["session"]]["metadata"]["fleet"]["repo"], "acme-org/widget-api")
        self.assertEqual(len([m for m in self.world.v2.sessions[done["session"]]["messages"] if m["type"] == "user"]), 1, "the brief was sent")
        blob = json.dumps([done, self.world.v2.sessions[done["session"]], self.ap.load_record(self.world.state, "mapped")], default=str)
        for path in Path(self.world.state).rglob("*"):
            if path.is_file():
                blob += path.read_text(errors="replace")
        self.assertNotIn("tok-FAKE-9f3a", blob)

    def test_a_headless_launch_for_a_mapped_repo_is_refused_with_no_session_when_the_route_cannot_be_proved(self):
        before = set(self.world.v2.sessions)
        self.mapped_route(check=lambda: "the gh shim is not in place")
        with self.assertRaises(sb.LaunchError) as raised:
            self.launch_hl(name="nopath", repo="acme-org/widget-api")
        self.assertIn("the gh shim is not in place", str(raised.exception))
        self.assertEqual(set(self.world.v2.sessions), before)
        self.mapped_route()
        real_get = self.engine.v2.session_get
        self.engine.v2.session_get = lambda sid: ({"id": sid, "metadata": {"fleet": {"name": "norepo"}}} if sid not in before and self.world.v2.sessions[sid]["title"] == "norepo" else real_get(sid))
        with self.assertRaises(sb.LaunchError) as raised:
            self.launch_hl(name="norepo", repo="acme-org/widget-api")
        self.assertIn("names none as its repo", str(raised.exception))
        self.assertEqual(set(self.world.v2.sessions) - before, set(), "the session was deleted again")
        self.assertIsNone(self.ap.load_record(self.world.state, "norepo"))
        self.mapped_route()
        def down(sid):
            raise sb.V2Error("unreachable", None)
        self.engine.v2.session_get = down
        with self.assertRaises(sb.LaunchError) as raised:
            self.launch_hl(name="down", repo="acme-org/widget-api")
        self.assertIn("was deleted", str(raised.exception))
        self.engine.v2.session_get = real_get
        self.assertEqual(set(self.world.v2.sessions) - before, set())

    def test_the_route_proof_reads_the_session_record_and_no_per_session_environment_so_nothing_depends_on_service_memory(self):
        self.mapped_route()
        done = self.launch_hl(name="again", repo="acme-org/widget-api")
        for _ in range(2):   # the second read stands for the answer of a new service process: the record, never a per-session environment
            self.assertIn("acme-bot", sb.prove_headless_route(self.engine, done["session"], "again", "acme-org/widget-api", "acme-bot"))
        self.assertNotIn("environment", self.world.v2.sessions[done["session"]])
        self.world.v2.sessions[done["session"]]["metadata"]["fleet"]["repo"] = "other-org/thing"   # a record that maps to no (or another) account
        with self.assertRaises(sb.LaunchError) as raised:
            sb.prove_headless_route(self.engine, done["session"], "again", "acme-org/widget-api", "acme-bot")
        self.assertIn("other-org/thing", str(raised.exception))

    def test_a_mapped_repo_with_no_route_check_keeps_the_shipped_refusal_and_the_shim_check_names_what_is_missing(self):
        self.engine.accounts = sb.GhAccounts({"gh": "gh", "call_timeout_seconds": 5, "gh_users": {"acme-org/*": "acme-bot"}}, self.world.route, self.world.clock.now, environ={})
        self.engine.route_check = None
        before = set(self.world.v2.sessions)
        with self.assertRaises(sb.LaunchError) as raised:
            self.launch_hl(name="old", repo="acme-org/widget-api")
        self.assertIn("cannot be pinned to an account", str(raised.exception))
        self.assertEqual(set(self.world.v2.sessions), before)
        with tempfile.TemporaryDirectory() as d:
            self.assertIn("gh shim", sb.shim_route_problem({"FLEET_SWITCHBOARD_SHIMS": d}))
            for tool in ("gh", "git"):
                (Path(d) / tool).write_text("#!/bin/sh\n"); os.chmod(Path(d) / tool, 0o755)
            with tempfile.TemporaryDirectory() as cfg:
                (Path(cfg) / "plugins").mkdir()
                (Path(cfg) / "plugins" / "fleet-hooks.js").write_bytes((Path(sb.KIT_ROOT) / "plugins" / "fleet-hooks" / "index.js").read_bytes())
                self.assertIsNone(sb.shim_route_problem({"FLEET_SWITCHBOARD_SHIMS": d}, config_dir=cfg))
        with tempfile.TemporaryDirectory() as d:
            (Path(d) / "gh").write_text("#!/bin/sh\n"); os.chmod(Path(d) / "gh", 0o755)
            (Path(d) / "git").write_text("#!/bin/sh\n"); os.chmod(Path(d) / "git", 0o644)   # present, not executable
            self.assertIn("git shim", sb.shim_route_problem({"FLEET_SWITCHBOARD_SHIMS": d}))
        self.assertIn("absolute", sb.shim_route_problem({"FLEET_SWITCHBOARD_SHIMS": "rel"}))

    def test_the_launch_refuses_a_mapped_repo_when_the_plugin_file_is_not_installed_or_differs_from_this_checkout(self):
        with tempfile.TemporaryDirectory() as shims, tempfile.TemporaryDirectory() as cfg, tempfile.TemporaryDirectory() as kit:
            for tool in ("gh", "git"):
                (Path(shims) / tool).write_text("#!/bin/sh\n"); os.chmod(Path(shims) / tool, 0o755)
            (Path(kit) / "plugins" / "fleet-hooks").mkdir(parents=True)
            (Path(kit) / "plugins" / "fleet-hooks" / "index.js").write_text("export const a = 1\n")
            check = lambda: sb.shim_route_problem({"FLEET_SWITCHBOARD_SHIMS": shims}, config_dir=cfg, kit_root=kit)
            self.mapped_route(check=check)
            before = set(self.world.v2.sessions)
            for state in ("missing", "differs"):
                if state == "differs":
                    (Path(cfg) / "plugins").mkdir(parents=True)
                    (Path(cfg) / "plugins" / "fleet-hooks.js").write_text("export const a = 2\n")
                with self.assertRaises(sb.LaunchError, msg=state) as raised:
                    self.launch_hl(name="plug", repo="acme-org/widget-api")
                self.assertIn("fleet-hooks.js", str(raised.exception), state)
                self.assertEqual(set(self.world.v2.sessions), before, state)
            (Path(cfg) / "plugins" / "fleet-hooks.js").write_text("export const a = 1\n")
            self.assertIsNone(check())
            self.assertIn("acme-bot", self.launch_hl(name="plug", repo="acme-org/widget-api")["identity"])

    def test_each_comparison_of_the_route_proof_refuses_and_leaves_no_session_or_record(self):
        self.engine.accounts = sb.GhAccounts({"gh": "gh", "call_timeout_seconds": 5, "gh_users": {"acme-org/*": "acme-bot", "other-org/*": "other-bot"}}, self.world.route,
                                             self.world.clock.now, environ={})
        self.engine.route_check = lambda: None
        before = set(self.world.v2.sessions)
        real = self.engine.v2.session_get
        cases = {"another name": {"name": "someone-else", "repo": "acme-org/widget-api"}, "no repo": {"name": "cmp"},
                 "another account": {"name": "cmp", "repo": "other-org/thing"}, "another repo, same account": {"name": "cmp", "repo": "acme-org/other-api"}}
        for label, fleet in cases.items():
            self.engine.v2.session_get = lambda sid, fleet=fleet: {"id": sid, "metadata": {"fleet": fleet}}
            with self.assertRaises(sb.LaunchError, msg="direct " + label):   # the proof's own comparison, whatever the launcher checked before it
                sb.prove_headless_route(self.engine, "ses_x", "cmp", "acme-org/widget-api", "acme-bot")
            with self.assertRaises(sb.LaunchError, msg=label):
                self.launch_hl(name="cmp", repo="acme-org/widget-api")
            self.engine.v2.session_get = real
            self.assertEqual(set(self.world.v2.sessions) - before, set(), label)
            self.assertIsNone(self.ap.load_record(self.world.state, "cmp"), label)
        self.engine.v2.session_get = lambda sid: {"id": sid, "metadata": {"fleet": {"name": "cmp", "repo": "acme-org/widget-api"}}}
        with self.assertRaises(sb.LaunchError, msg="the map gives another account than the one launched for"):
            sb.prove_headless_route(self.engine, "ses_x", "cmp", "acme-org/widget-api", "other-bot")
        self.engine.v2.session_get = real

    def test_the_launch_output_and_the_docs_call_the_route_a_mistake_guard_and_a_terminal_launch_the_pane_environment_pin(self):
        self.mapped_route()
        line = self.launch_hl(name="words", repo="acme-org/widget-api")["identity"]
        self.assertIn("pins the account in the pane's environment", line)
        self.assertIn("mistake-guard", line)
        docs = (Path(sb.KIT_ROOT) / "docs" / "switchboard.md").read_text()
        paragraph = docs[docs.index("What differs from a terminal worker"):][:6000]
        for text in (line, paragraph):
            self.assertNotIn("is the boundary", text)
        self.assertIn("OPENCODE_SESSION_ID", paragraph)
        self.assertIn("mistake-guard", paragraph)

    def test_the_named_account_refusal_holds_for_every_spelling_of_a_mapped_repo_exact_and_wildcard_with_a_default_token_set(self):
        users = {"acme/widget": "acct-ops", "wild-org/*": "acct-ops"}
        self.engine.accounts = sb.GhAccounts({"gh": "gh", "call_timeout_seconds": 5, "gh_users": users}, self.world.route, self.world.clock.now, environ={"GH_TOKEN": "x"})
        sessions_before = set(self.world.v2.sessions)
        for spelling in ("acme/widget", "Acme/Widget", "ACME/WIDGET", " acme/widget ", "acme/widget.git", "acme/widget/", "wild-org/any", "WILD-ORG/any", "Wild-Org/Any.git"):
            with self.assertRaises(sb.LaunchError, msg=spelling) as raised:
                self.launch_hl(name="pin", repo=spelling)
            self.assertIn("Use a terminal launch", str(raised.exception), spelling)
        self.assertEqual(set(self.world.v2.sessions), sessions_before, "nothing was created for any spelling")
        mixed = {"Acme/Widget": "acct-ops", "WILD-ORG/*": "acct-ops"}   # the keys are spelled differently too
        self.engine.accounts = sb.GhAccounts({"gh": "gh", "call_timeout_seconds": 5, "gh_users": mixed}, self.world.route, self.world.clock.now, environ={"GH_TOKEN": "x"})
        for spelling in ("acme/widget", "ACME/WIDGET", "wild-org/any"):
            with self.assertRaises(sb.LaunchError, msg=spelling):
                self.launch_hl(name="pin", repo=spelling)
        done = self.launch_hl(name="free", repo="Other-Org/Thing")   # an unmapped repo still launches, whatever its case
        self.assertIn("gh_users has no entry for Other-Org/Thing", done["identity"])
        self.assertIn("it has no repo", self.launch_hl(name="norepo")["identity"], "no repo: nothing to map, so it acts as the service's own account, and says so")
        with self.assertRaises(sb.ConfigError) as raised:   # two spellings of one repo may not name two accounts: refused when the config loads
            sb.validate_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "gh_users": {"Acme/Widget": "acct-ops", "acme/widget": "acct-two"}})
        sb.validate_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "gh_users": {"Acme/Widget": "acct-ops", "acme/widget": "ACCT-OPS"}})   # the same account twice is fine
        self.assertIn("the same repo, with different accounts", str(raised.exception))
        accounts = self.engine.accounts
        self.assertEqual([accounts.account_for(r) for r in ("ACME/Widget", "acme/widget.git", "x/y", None, 5)], ["acct-ops", "acct-ops", None, None, None])

    def test_the_plugin_and_the_switchboard_agree_on_the_headless_temp_root_and_name_rule(self):
        node = REAL_NODE
        if node is None:
            self.skipTest("no node")
        plugin = Path(__file__).resolve().parent.parent / "plugins" / "fleet-hooks" / "index.js"
        data = self.home / "xdg-data-cross"
        script = 'import(%r).then(m => { console.log(JSON.stringify([m.tmpRootOf({XDG_DATA_HOME: %r}, "/h"), m.AGENT_NAME_RE.source, m.LANE_PREFIX, m.RECORD_NAME_RE.source, m.RECORD_MAX])); })' % (plugin.as_uri(), str(data))
        out = subprocess.run([node, "-e", script], capture_output=True, text=True, timeout=30)
        self.assertEqual(out.returncode, 0, out.stderr)
        root, source, lane, record_name, record_max = json.loads(out.stdout)
        with mock.patch.dict(os.environ, {"XDG_DATA_HOME": str(data)}):
            self.assertEqual(root, str(sb.headless_tmp_root()))
        self.assertEqual(source, sb.NAME_RE.pattern)
        self.assertEqual(lane, sb.LANE_NAME_PREFIX)
        self.assertTrue(sb.agent_tmp_shared_name("cos") and sb.agent_tmp_shared_name(lane + "x") and not sb.agent_tmp_shared_name("coder"))
        presence = self.ap
        self.assertEqual(record_name, presence.NAME_RE.pattern)
        self.assertEqual(record_max, presence.RECORD_MAX)
        self.assertIsNone(sb.reclaim_agent_tmp(self.engine, "coder\n", headless=True) or None)   # a trailing newline is not a name

    def test_s5_retire_of_a_headless_worker_handles_its_private_tmpdir_from_the_plugin(self):
        data = self.home / "xdg-data-846b"
        root = data / sb.PROG / "profile" / "tmp"
        self.launch_hl()
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        os.environ["HERDR_PANE_ID"] = self.world.panes["boss"]
        (root / "hw").mkdir(parents=True)
        with mock.patch.dict(os.environ, {"XDG_DATA_HOME": str(data)}):
            code, out, err = self.run_cli("retire", "hw")
        self.assertEqual(code, 0, err)
        self.assertRegex(out, r"tmpdir: .*hw: removed \(empty\)")
        self.assertFalse((root / "hw").exists())

    def test_retire_frees_the_name_of_a_headless_worker_and_undo_restores_the_record_unless_the_name_was_taken(self):
        done = self.launch_hl()
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        os.environ["HERDR_PANE_ID"] = self.world.panes["boss"]
        code, out, err = self.run_cli("retire", "hw")
        self.assertEqual(code, 0, err)
        self.assertIn("its headless record was removed, so the name is free", out)
        self.assertIsNone(self.ap.load_record(self.world.state, "hw"))
        self.assertIn(done["session"], self.world.v2.sessions, "the session itself keeps running: only the watching stopped")
        again = self.launch_hl()   # the name is free: a new worker can use it
        self.assertNotEqual(again["session"], done["session"])
        code, out, err = self.run_cli("retire", "--undo", "hw")
        self.assertEqual(code, 0, err)
        self.assertIn("a worker named hw exists again, so its old headless record was NOT restored", out)
        self.assertEqual(self.ap.load_record(self.world.state, "hw")["session"], again["session"], "the newer record is untouched")
        code, out, err = self.run_cli("retire", "hw")
        self.assertEqual(code, 0, err)
        code, out, err = self.run_cli("retire", "--undo", "hw")
        self.assertEqual(code, 0, err)
        self.assertIn("its headless record was restored", out)
        self.assertEqual(self.ap.load_record(self.world.state, "hw")["session"], again["session"])
        self.assertEqual(self.discover().agents["hw"].session_id, again["session"])

    def test_the_failure_branches_of_the_undo_and_of_retire_and_undo_each_say_one_line_and_the_cli_prints_the_identity(self):
        with mock.patch.object(sb.V2Client, "interrupt", side_effect=sb.V2Error("exit", None, "no")), \
                mock.patch.object(sb.V2Client, "prompt", side_effect=sb.V2Error("exit", None, "refused")):
            with self.assertRaises(sb.LaunchError) as raised:
                self.launch_hl(name="noint")
        self.assertIn("was deleted", str(raised.exception), "a failed interrupt does not stop the deletion")
        real_remove = sb.V2Client.session_remove
        with mock.patch.object(sb.V2Client, "session_remove", side_effect=sb.V2Error("http", 404, "gone")), \
                mock.patch.object(sb.V2Client, "prompt", side_effect=sb.V2Error("exit", None, "refused")):
            with self.assertRaises(sb.LaunchError) as raised:
                self.launch_hl(name="gone")
        self.assertIn("was already gone", str(raised.exception))
        self.assertIn("its record was removed", str(raised.exception))
        self.world.v2.remove_fails = True
        with mock.patch.object(sb.V2Client, "interrupt", side_effect=sb.V2Error("exit", None, "no")), \
                mock.patch.object(sb.V2Client, "prompt", side_effect=sb.V2Error("exit", None, "refused")):
            with self.assertRaises(sb.LaunchError) as raised:
                self.launch_hl(name="stuck")
        self.assertIn("may still be running", str(raised.exception))
        self.world.v2.remove_fails = False
        with mock.patch.object(sb, "agent_lock", side_effect=sb.ImpactStateBusy("busy")), self.assertRaises(sb.LaunchError) as raised:
            self.launch_hl(name="locked")
        self.assertIn("is running", str(raised.exception))
        self.launch_hl()
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        os.environ["HERDR_PANE_ID"] = self.world.panes["boss"]
        with mock.patch.object(self.ap, "remove_record", side_effect=OSError("read-only")):
            code, out, err = self.run_cli("retire", "hw")
        self.assertEqual(code, 0, err)
        self.assertIn("its headless record could NOT be removed (read-only): the name stays taken until it is", out)
        self.assertIn("hw", sb.read_retired(self.world.state), "the retirement is written anyway")
        code, out, err = self.run_cli("retire", "hw")   # this one frees the record
        self.assertEqual(code, 0, err)
        self.assertIsNone(self.ap.load_record(self.world.state, "hw"))
        code, out, err = self.run_cli("retire", "hw")   # retiring again: the worker is no longer seen, so it is refused and the first retirement is untouched
        self.assertEqual(code, 1)
        self.assertIn("session", sb.read_retired(self.world.state)["hw"].get("headless", {}))
        with mock.patch.object(self.ap, "save_record", side_effect=OSError("read-only")):
            code, out, err = self.run_cli("retire", "--undo", "hw")
        self.assertEqual(code, 1)
        self.assertIn("its headless record could NOT be restored (read-only)", err)
        self.assertIn("the retirement stays", err)
        self.assertIn("hw", sb.read_retired(self.world.state), "a failed restore changed nothing: the undo can be tried again")
        self.assertIsNone(self.ap.load_record(self.world.state, "hw"))
        real_lock = sb.agent_lock

        def busy_for_hw(state, name, *a, **k):
            if name == "hw":   # a launch of this name is in its locked step
                raise sb.ImpactStateBusy("busy")
            return real_lock(state, name, *a, **k)

        with mock.patch.object(sb, "agent_lock", busy_for_hw):
            code, out, err = self.run_cli("retire", "--undo", "hw")
        self.assertEqual(code, 1)
        self.assertIn("is running, so its old headless record was NOT restored", err)
        self.assertIsNone(self.ap.load_record(self.world.state, "hw"), "nothing was written while the launch held the name")
        code, out, err = self.run_cli("retire", "--undo", "hw")
        self.assertEqual(code, 0, err)
        self.assertIn("its headless record was restored", out)
        code, out, err = self.run_cli("launch", "viacli", "--agent", "coder", "--dir", str(self.home), "--headless")
        self.assertEqual(code, 0, err)
        self.assertIn("acts as the OpenCode service environment's own gh account (it has no repo)", err)

    def test_a_session_the_service_does_not_show_under_the_name_removes_the_record_and_two_launches_of_one_name_cannot_both_pass(self):
        real_get = sb.V2Client.session_get
        with mock.patch.object(sb.V2Client, "session_get", lambda self_, sid: dict(real_get(self_, sid), metadata={"fleet": {"name": "someone-else"}})):
            with self.assertRaises(sb.LaunchError) as raised:
                self.launch_hl(name="mismatch")
        self.assertIn("does not show the new session as mismatch", str(raised.exception))
        self.assertIn("its record was removed", str(raised.exception))
        self.assertIn("was deleted", str(raised.exception))
        self.assertIsNone(self.ap.load_record(self.world.state, "mismatch"))
        with sb.agent_lock(self.world.state, "busy", seconds=1):          # another launch of this name is in its locked step
            with mock.patch.object(sb, "AGENT_LOCK_SECONDS", 0.2), self.assertRaises(sb.LaunchError) as raised:
                inner = sb.agent_lock(self.world.state, "busy", seconds=0.2)
                with mock.patch.object(sb, "agent_lock", lambda state, name: inner):
                    self.launch_hl(name="busy")
        self.assertIn("another launch or reattach of busy is running", str(raised.exception))
        self.assertIsNone(self.ap.load_record(self.world.state, "busy"))

    def watch_cli(self, name="hw", *extra):
        os.environ["HERDR_WORKSPACE_ID"] = "w1"
        os.environ["HERDR_PANE_ID"] = self.world.panes["boss"]                      # the worker's own boss may watch it
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        return self.run_cli("watch", name, *extra)

    def test_watch_opens_one_terminal_on_the_existing_session_and_closing_it_leaves_the_worker_as_it_was(self):
        sid = self.headless()
        record_before = (Path(self.world.state) / "headless" / "hw.json").read_bytes()
        sessions, messages = set(self.world.v2.sessions), len(self.world.v2.sessions[sid]["messages"])
        panes = set(self.world.herdr.panes)
        code, out, err = self.watch_cli()
        self.assertEqual(code, 0, err)
        done = json.loads(out)
        self.assertEqual((done["name"], done["session"]), ("hw", sid))
        self.assertEqual(set(self.world.herdr.panes) - panes, {done["pane"]}, "exactly one terminal opened")
        self.assertEqual(set(self.world.v2.sessions), sessions, "no second session")
        self.assertEqual(len(self.world.v2.sessions[sid]["messages"]), messages, "no prompt was sent")
        self.assertEqual(self.discover().agents["hw"].pane, done["pane"], "the terminal now shows the worker")
        self.assertTrue([e for e in self.world.audit() if e["event"] == "headless.watched" and e["subject"] == "hw"])
        self.world.herdr.panes.pop(done["pane"])                                    # the person closes the terminal
        after = self.discover().agents["hw"]
        self.assertEqual((after.headless, after.session_id), (True, sid), "the worker is a headless worker again, on the same session")
        self.assertEqual(set(self.world.v2.sessions), sessions)
        self.assertEqual((Path(self.world.state) / "headless" / "hw.json").read_bytes(), record_before, "the record is untouched")
        self.assertFalse([m for m in self.world.v2.sessions[sid]["messages"] if m.get("type") == "user" and "abort" in str(m).lower()])

    def test_watch_refuses_a_worker_with_a_terminal_an_unknown_name_and_a_retired_worker_and_opens_nothing(self):
        self.headless()
        self.world.add_agent("termworker", fleet={"role": "coder", "reports_to": "boss"})
        panes = dict(self.world.herdr.panes)
        code, out, err = self.watch_cli("termworker")
        self.assertEqual(code, 1)
        self.assertIn("already has a terminal (pane %s)" % self.world.panes["termworker"], err)
        code, out, err = self.watch_cli("nobody")
        self.assertEqual(code, 1)
        self.assertIn("nobody", err)
        self.watch_cli("nobody")                                                    # sets the caller's environment for the retire below
        self.assertEqual(self.run_cli("retire", "hw")[0], 0)
        code, out, err = self.watch_cli("hw")
        self.assertEqual(code, 1)
        self.assertIn("retired", err)
        self.assertEqual(self.world.herdr.panes, panes, "no terminal was opened")
        self.assertEqual(len([e for e in self.world.audit() if e["event"] == "headless.watch_refused"]), 3, "the terminal and the unknown name (twice) are audited; the retired one is said without a record")

    def test_watch_is_refused_for_a_caller_who_is_not_the_boss_and_while_another_watch_holds_the_lock(self):
        self.headless()
        self.world.add_agent("other", fleet={"role": "coder", "reports_to": "boss"})
        panes = dict(self.world.herdr.panes)
        self.watch_cli("hw")                                                         # sets the environment; then the caller is a peer, not the boss
        os.environ["HERDR_PANE_ID"] = self.world.panes["other"]
        self.world.herdr.panes.clear(); self.world.herdr.panes.update(panes)
        code, out, err = self.run_cli("watch", "hw")
        self.assertEqual(code, 1)
        self.assertIn("may not reattach hw", err)
        self.assertEqual(self.world.herdr.panes, panes, "no terminal was opened")
        os.environ["HERDR_PANE_ID"] = self.world.panes["boss"]
        with sb.agent_lock(self.world.state, "hw", seconds=1), mock.patch.object(sb, "AGENT_LOCK_SECONDS", 0.2):
            inner = sb.agent_lock(self.world.state, "hw", seconds=0.2)
            with mock.patch.object(sb, "agent_lock", lambda state, name: inner):
                code, out, err = self.run_cli("watch", "hw")
        self.assertEqual(code, 1)
        self.assertIn("another watch or reattach of hw is running", err)

    def test_watch_without_a_workspace_or_with_a_terminal_that_cannot_open_fails_with_the_reason_and_leaves_the_worker_untouched(self):
        sid = self.headless()
        record_before = (Path(self.world.state) / "headless" / "hw.json").read_bytes()
        os.environ.pop("HERDR_WORKSPACE_ID", None)
        os.environ["HERDR_PANE_ID"] = self.world.panes["boss"]
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        code, out, err = self.run_cli("watch", "hw")
        self.assertEqual(code, 1)
        self.assertIn("--workspace", err)
        with mock.patch.object(sb.HerdrClient, "open_tab_running", side_effect=sb.HerdrError("exit", "no room")):
            code, out, err = self.watch_cli()
        self.assertEqual(code, 1)
        self.assertIn("no room", err)
        self.assertEqual((Path(self.world.state) / "headless" / "hw.json").read_bytes(), record_before)
        self.assertTrue(self.discover().agents["hw"].headless)
        self.assertFalse([e for e in self.world.audit() if e["event"] == "headless.watched"])

    def test_the_service_url_is_read_from_a_private_service_file_and_never_includes_the_password(self):
        service = self.home / "service" / "service.json"
        service.parent.mkdir(mode=0o700)
        service.write_text(json.dumps({"url": "http://127.0.0.1:49374", "password": "s3cret-value", "pid": os.getpid()}))
        service.chmod(0o600)
        http = sb.V2Http(service, 5)
        self.assertEqual(http.base_url(), "http://127.0.0.1:49374")
        self.assertNotIn("s3cret", http.base_url())
        service.chmod(0o644)
        self.assertIsNone(sb.V2Http(service, 5).base_url(), "a service file others can read is not trusted: no url")
        self.assertIsNone(sb.V2Http(self.home / "nowhere.json", 5).base_url())

    def test_the_headless_service_url_is_recorded_when_the_service_file_is_readable_and_never_a_password(self):
        with mock.patch.object(sb.V2Client, "service_url", lambda self_: "http://127.0.0.1:49374"):
            self.launch_hl()
        record = self.ap.load_record(self.world.state, "hw")
        self.assertEqual(record["url"], "http://127.0.0.1:49374")
        self.assertNotIn("password", json.dumps(record))
        self.assertIsNone(sb.V2Client(FAKE_OPENCODE, {}, self.world.v2, 5).service_url(), "no HTTP transport: no url, and the record says none")

    def test_remove_record_deletes_it_once_and_says_so(self):
        sid = self.headless()
        path = Path(self.world.state) / "headless" / "hw.json"
        self.assertTrue(path.exists())
        self.assertTrue(self.ap.remove_record(self.world.state, "hw"))
        self.assertFalse(path.exists())
        self.assertFalse(self.ap.remove_record(self.world.state, "hw"))
        self.assertFalse(self.ap.remove_record(self.world.state, "../x"))


class TestNoMultiplexer(Base):
    """#1072: `no_multiplexer` on: discovery reads the records only. A multiplexer that RAISES on any call proves none is made."""

    class Raising:
        def __init__(self):
            self.calls = []
        def __getattr__(self, name):
            if name.startswith("__"):
                raise AttributeError(name)
            def call(*args, **kwargs):
                self.calls.append(name)
                raise sb.HerdrError("no multiplexer here: %s" % name)
            return call

    def setUp(self):
        super().setUp()
        self.world = World(self, agents=("boss",))
        self.ap = sb.load_agent_presence()
        self.engine = self.world.new_engine("cli")
        self.url = "http://127.0.0.1:49374"
        self.headless = lambda: TestHeadlessPresence.headless(self)
        self.discover = lambda: TestHeadlessPresence.discover(self)
        self.sid = self.headless()
        self.fake = self.Raising()
        self.engine.herdr = self.fake

    def test_s2_the_switch_on_never_calls_agent_list_and_leaves_no_problem_and_the_agents_input_whole(self):
        self.engine.config = dict(self.engine.config, no_multiplexer=True)
        found = self.discover()
        self.assertEqual(self.fake.calls.count("agent_list"), 0)
        self.assertEqual([p for p in found.problems if "herdr unreachable" in p], [])
        self.assertEqual(found.problems, [])
        self.assertTrue(sb.whole(self.engine, "agents")[0])
        self.assertIn("hw", found.agents)

    def test_s3_pane_less_agents_get_no_badge_and_no_pane_call_and_no_error(self):
        self.engine.config = dict(self.engine.config, no_multiplexer=True)
        found = self.discover()
        report = {"badges": [], "errors": []}
        self.engine.render_badges(found, set(), report)
        self.assertEqual(self.fake.calls, [])
        self.assertEqual((report["badges"], report["errors"]), ([], []))

    def test_s2_a_whole_pass_with_the_switch_on_makes_no_multiplexer_call(self):
        self.engine.config = dict(self.engine.config, no_multiplexer=True)
        self.engine.audit = self.engine.audit
        self.engine.run_pass()
        self.assertEqual(self.fake.calls, [])
        self.assertEqual(self.engine.discovery.problems, [])

    def test_u1_the_switch_off_still_reports_herdr_unreachable_and_the_input_not_whole(self):
        self.assertFalse(self.engine.config["no_multiplexer"])
        found = self.discover()
        self.assertEqual(self.fake.calls, ["agent_list"])
        self.assertTrue(any(p.startswith("herdr unreachable: ") for p in found.problems))
        self.assertFalse(sb.whole(self.engine, "agents")[0])

    def test_the_key_must_be_a_boolean(self):
        with self.assertRaises(sb.ConfigError):
            sb.validate_config({"no_multiplexer": "yes"})

    def _owed_toast(self):
        found = self.discover()
        return found, mock.patch.object(sb.Switchboard, "toast_candidates", lambda *a: [("hw", "blocked", "hw is blocked", "waiting")])

    def test_s3_a_toast_owed_to_a_pane_less_agent_makes_no_multiplexer_call_and_no_failure_with_the_switch_on(self):
        self.engine.config = dict(self.engine.config, no_multiplexer=True)
        found, patch = self._owed_toast()
        report = {"toasts": [], "errors": []}
        with patch:
            self.engine.render_toast(found, {}, 0, report)
        self.assertEqual((self.fake.calls, report["toasts"], report["errors"]), ([], [], []))

    def test_s3_every_pane_call_site_is_guarded_or_unreachable_with_the_switch_on(self):
        """One row per pane-assuming path: badge and toast (guarded by the switch), check_program and observe (only fed by herdr entries, which the switch
        never lists), reread (no pane -> a stated refusal before any call), the pane sweep (skips an agent with no pane), close and release (need a listed pane)."""
        self.engine.config = dict(self.engine.config, no_multiplexer=True)
        found = self.discover()
        obs = found.agents["hw"]
        self.assertFalse(obs.pane)
        self.assertEqual(found.entries, [])
        self.engine.render_badges(found, set(), {"badges": [], "errors": []})
        self.assertEqual(self.fake.calls, [])
        obs.pane = "p1"   # an agent WITH a pane while the switch is on (a stale record): still no badge write, no toast
        report = {"badges": [], "errors": [], "toasts": []}
        self.engine.render_badges(found, set(), report)
        self.assertEqual((self.fake.calls, report["badges"], report["errors"]), ([], [], []))
        with mock.patch.object(sb.Switchboard, "toast_candidates", lambda *a: [("hw", "blocked", "t", "b")]):
            self.engine.render_toast(found, {}, 0, report)
        self.assertEqual((self.fake.calls, report["toasts"]), ([], []))

    def test_u1_the_switch_off_renders_badges_and_toasts_through_the_multiplexer_as_before(self):
        found = self.discover()
        found.agents["hw"].pane = "p1"
        report = {"badges": [], "errors": [], "toasts": []}
        with mock.patch.object(sb.Switchboard, "unread_count", lambda *a: 3):
            self.engine.render_badges(found, set(), report)
        self.assertTrue([c for c in self.fake.calls if c != "agent_list"], "the badge path reached the multiplexer with the switch off")
        self.fake.calls.clear()
        with mock.patch.object(sb.Switchboard, "toast_candidates", lambda *a: [("hw", "blocked", "t", "b")]):
            try:
                self.engine.render_toast(found, {}, 0, report)
            except sb.HerdrError:
                pass   # the double refuses the call; the call is what is counted
        self.assertEqual(self.fake.calls, ["notification_show"])

    # -- #1072 R-TEST-4: each mutant removes ONE guard from the REAL function (its source, with the guard's condition replaced), never wraps the double

    GUARD = '(getattr(self, "config", None) or {}).get("no_multiplexer") is True'

    @staticmethod
    def without_guard(owner, name, old, new="False"):
        """The REAL function `owner.name`, recompiled from its own source with the one guard condition `old` replaced by `new`."""
        source = textwrap.dedent(inspect.getsource(getattr(owner, name)))
        assert source.count(old) == 1, "the guard moved: %s.%s" % (owner.__name__, name)
        scratch = {}
        exec(compile(source.replace(old, new), "<mutant %s>" % name, "exec"), vars(sb), scratch)
        return scratch[name]

    def test_each_guard_removed_from_the_real_function_fails_the_test_that_names_it(self):
        engine_guard = self.GUARD
        rows = (
            ("discovery switch", sb.Switchboard, "_discover", engine_guard, "test_s2_the_switch_on_never_calls_agent_list_and_leaves_no_problem_and_the_agents_input_whole"),
            ("badge guard", sb.Switchboard, "render_badges", engine_guard, "test_s3_every_pane_call_site_is_guarded_or_unreachable_with_the_switch_on"),
            ("toast guard", sb.Switchboard, "render_toast", engine_guard, "test_s3_a_toast_owed_to_a_pane_less_agent_makes_no_multiplexer_call_and_no_failure_with_the_switch_on"),
        )
        for label, owner, name, old, named in rows:
            with self.subTest(mutant=label):
                self.setUp()   # a fresh world for each: the real function first, then the mutant
                getattr(self, named)()   # the real function: the named test holds
                self.setUp()
                with mock.patch.object(owner, name, self.without_guard(owner, name, old)):
                    with self.assertRaises((AssertionError, sb.HerdrError), msg="the %s removed from the real function passed %s" % (label, named)):
                        getattr(self, named)()

    def test_the_discovery_switch_always_on_fails_the_u1_test_that_names_it(self):
        """U1: the guard that holds whatever the switch says (the switch off behaves as on) fails the switch-off test."""
        self.test_u1_the_switch_off_still_reports_herdr_unreachable_and_the_input_not_whole()
        self.setUp()
        with mock.patch.object(sb.Switchboard, "_discover", self.without_guard(sb.Switchboard, "_discover", self.GUARD, "True")):
            with self.assertRaises(AssertionError):
                self.test_u1_the_switch_off_still_reports_herdr_unreachable_and_the_input_not_whole()


class TestSelfRegisteringCli(unittest.TestCase):
    """The front door (#179 follow-up): commands register and dispatch BY NAME, so a new command edits no shared list. What must not change: the set of
    subcommands and each one's help, the function each runs and what it is given, the daemon start, the error mapping; and a hostile name never runs
    an arbitrary function."""
    SURFACE_DIR = REPO / "scenarios" / "switchboard" / "cli-surface" / "commands"   # ONE file per command: two PRs adding different commands never touch the same file

    @classmethod
    def read_surface(cls):
        """{"commands": [sorted names], "help": {name: help}} read from the per-command files; a file whose name and `command` disagree is an error."""
        found = {}
        for path in sorted(cls.SURFACE_DIR.glob("*.json")):
            entry = json.loads(path.read_text())
            if entry.get("command") != path.stem:
                raise AssertionError("%s describes %r: a snapshot file is named for its command" % (path.name, entry.get("command")))
            found[path.stem] = entry["help"]
        return {"commands": sorted(found), "help": found}
    # Written from the OLD dispatch chain, not derived from the new code: action -> (function, the arguments it was called with)
    OLD = {
        "status": ("cmd_status", ("args", "runner", "now")), "poke": ("cmd_poke", ("args",)), "policy-report": ("cmd_policy_report", ("args", "runner", "now")),
        "agents": ("cmd_agents", ("args", "runner", "now")), "job": ("cmd_job", ("args", "runner", "now", "spawn")), "review-laws": ("cmd_review_laws", ("args", "runner", "now")), "review": ("cmd_review", ("args", "runner", "now")), "pr-explain": ("cmd_pr_explain", ("args", "runner", "now")), "disk": ("cmd_disk", ("args", "runner", "now")), "pr-state": ("cmd_pr_state", ("args", "runner", "now")),
        "reattach": ("cmd_reattach", ("args", "runner", "now", "socket_call")),
        "retire": ("cmd_retire", ("args", "runner", "now")),
        "impact": ("cmd_impact", ("args", "runner", "now")), "judge-tool": ("cmd_judge_tool", ("args", "runner", "now")),
        "ensure": ("cmd_ensure", ("args", "spawn")), "install": ("cmd_install", ("args", "runner", "now", "spawn")), "key": ("cmd_key", ("args", "runner", "now")),
        "restart": ("cmd_restart", ("args", "runner", "spawn")), "bootstrap": ("cmd_bootstrap", ("args", "runner", "now", "socket_call")),
        "launch": ("cmd_launch", ("args", "runner", "now", "socket_call")), "handoff": ("cmd_handoff", ("args", "runner", "now", "socket_call")),
        "run": ("cmd_run", ("args", "runner", "now", "wait")), "send": ("cmd_send", ("args", "runner", "now")), "report": ("cmd_report", ("args", "runner", "now")),
        "notice": ("cmd_notice", ("args", "runner", "now")), "prove": ("cmd_prove", ("args", "runner", "now")), "verdict": ("cmd_verdict", ("args", "runner", "now")),
        "waive": ("cmd_waive", ("args", "runner", "now")), "gates": ("cmd_gates", ("args", "runner", "now")), "gates-check": ("cmd_gates_check", ("args", "runner", "now")),
        "decisions": ("cmd_decisions", ("args", "runner", "now")), "comment": ("cmd_comment", ("args", "runner", "now")), "whoami": ("cmd_whoami", ("args", "runner", "now")),
        "pending": ("cmd_pending", ("args", "runner", "now")), "remind": ("cmd_remind", ("args", "runner", "now")), "intent": ("cmd_intent", ("args", "runner", "now")),
        "intents": ("cmd_intents", ("args", "runner", "now")), "import-v1": ("cmd_import_v1", ("args", "runner", "now")), "orders": ("cmd_orders", ("args", "runner", "now")),
        "load-replay": ("cmd_load_replay", ("args", "runner", "now")), "labels": ("cmd_labels", ("args", "runner", "now")), "plan": ("cmd_plan", ("args", "runner", "now", "socket_call")),
        "triage": ("cmd_triage", ("args", "runner", "now"))}
    OLD_ENSURE_ON_USE = ("send", "report", "notice", "launch", "handoff", "comment", "remind", "decisions", "intent", "bootstrap")
    OLD_DIRECT = ("status", "poke", "policy-report", "review-laws", "review", "pr-explain", "impact", "plan", "judge-tool")
    OLD_LEDGER = ("prove", "verdict", "waive", "gates", "gates-check")

    @staticmethod
    def plain(text):
        """Help text as words: the wrapping and the section name differ between Python versions and terminal widths, the content must not."""
        return " ".join(text.replace("optional arguments:", "options:").split())

    @staticmethod
    def commands():
        parser = sb.build_parser()
        (action,) = [a for a in parser._actions if a.__class__.__name__ == "_SubParsersAction"]
        return parser, action.choices

    def test_every_subcommand_of_the_snapshot_still_exists_with_the_same_help(self):
        _, choices = self.commands()
        if os.environ.get("CLI_SURFACE_UPDATE") == "1":
            self.SURFACE_DIR.mkdir(parents=True, exist_ok=True)
            for stale in self.SURFACE_DIR.glob("*.json"):
                stale.unlink()
            for name in sorted(choices):
                (self.SURFACE_DIR / ("%s.json" % name)).write_text(json.dumps({"command": name, "help": self.plain(choices[name].format_help())}, indent=1, sort_keys=True) + "\n")
        failure = self.snapshot_failure(self.SURFACE_DIR)
        self.assertIsNone(failure, failure)
        snap = self.read_surface()
        for name in snap["commands"]:
            with self.subTest(command=name):
                self.assertEqual(self.plain(choices[name].format_help()), snap["help"][name])

    def snapshot_failure(self, surface_dir):
        """The message of the REAL surface comparison (the body of test_every_subcommand_of_the_snapshot...) run against `surface_dir`, or None when it passes."""
        _, choices = self.commands()
        try:
            with mock.patch.object(self.__class__, "SURFACE_DIR", surface_dir):
                snap = self.read_surface()
            self.assertEqual(sorted(choices), snap["commands"], "the set of subcommands changed: only in the code %s, only in the snapshot %s" % (
                sorted(set(choices) - set(snap["commands"])), sorted(set(snap["commands"]) - set(choices))))
        except AssertionError as err:
            return str(err)
        return None

    def test_a_command_without_a_snapshot_file_and_a_file_without_a_command_each_fail_and_name_it(self):
        with tempfile.TemporaryDirectory() as work:
            copy = Path(work)
            for source in self.SURFACE_DIR.glob("*.json"):
                (copy / source.name).write_text(source.read_text())
            self.assertIsNone(self.snapshot_failure(copy), "a complete copy passes")
            (copy / "status.json").unlink()                                              # a command with no snapshot file
            message = self.snapshot_failure(copy)
            self.assertIsNotNone(message)
            self.assertIn("only in the code ['status']", message)
            (copy / "status.json").write_text((self.SURFACE_DIR / "status.json").read_text())
            (copy / "ghost-command.json").write_text(json.dumps({"command": "ghost-command", "help": "x"}))    # a file with no command
            message = self.snapshot_failure(copy)
            self.assertIsNotNone(message)
            self.assertIn("only in the snapshot ['ghost-command']", message)
            (copy / "ghost-command.json").unlink()
            (copy / "alpha.json").write_text(json.dumps({"command": "beta", "help": "x"}))                     # a file named for one command, describing another
            message = self.snapshot_failure(copy)
            self.assertIn("alpha.json", message)

    def test_the_snapshot_is_one_file_per_command_with_a_full_help_text(self):
        files = sorted(self.SURFACE_DIR.glob("*.json"))
        self.assertGreater(len(files), 40)
        self.assertFalse((self.SURFACE_DIR.parent / "commands.json").exists(), "the old single shared file is gone")
        for path in files:
            entry = json.loads(path.read_text())
            self.assertEqual(sorted(entry), ["command", "help"], path.name)
            self.assertTrue(entry["help"].startswith("usage: fleet-switchboard " + path.stem), path.name)

    def test_a_new_command_edits_no_shared_table_it_registers_says_its_group_beside_itself_and_dispatches(self):
        calls, ensured = [], []

        def add_fixture_parsers(sub):
            sub.add_parser("fixture", help="a command added with no shared edit")

        def cmd_fixture(args, runner, now):
            calls.append("fixture")
            raise sb.LedgerCommandError("a ledger error is a usage error")

        cmd_fixture.ledger = True
        cmd_fixture.ensure_on_use = True
        names = {"add_fixture_parsers": add_fixture_parsers, "cmd_fixture": cmd_fixture}
        before = (sb.DIRECT_ACTIONS, sb.LEDGER_ACTIONS, sb.ENSURE_ON_USE_COMMANDS)
        with mock.patch.dict(sb.__dict__, names), mock.patch.object(sb, "ensure_on_use", lambda spawn=None: ensured.append("ensured")):
            parser = sb.build_parser()
            self.assertIn("fixture", parser.commands)
            code = sb.dispatch(types.SimpleNamespace(action="fixture"), parser.commands, runner="R", now="N")
            sb.derive_action_groups()
            self.assertIn("fixture", sb.LEDGER_ACTIONS)
            self.assertIn("fixture", sb.ENSURE_ON_USE_COMMANDS)
            self.assertNotIn("fixture", sb.DIRECT_ACTIONS)
        sb.derive_action_groups()
        self.assertEqual((sb.DIRECT_ACTIONS, sb.LEDGER_ACTIONS, sb.ENSURE_ON_USE_COMMANDS), before, "the groups return to what the module defines")
        self.assertEqual((calls, ensured, code), (["fixture"], ["ensured"], sb.EXIT_USAGE), "it ran, the daemon was ensured first, the ledger error mapped to a usage error")

    def test_two_branches_that_add_different_commands_touch_no_common_file_and_merge_cleanly(self):
        with tempfile.TemporaryDirectory() as work:
            env = dict(os.environ, GIT_AUTHOR_NAME="t", GIT_AUTHOR_EMAIL="t@example.test", GIT_COMMITTER_NAME="t", GIT_COMMITTER_EMAIL="t@example.test",
                       GIT_CONFIG_GLOBAL="/dev/null", GIT_CONFIG_SYSTEM="/dev/null")

            def git(*args):
                done = subprocess.run(["git", "-C", work] + list(args), capture_output=True, text=True, env=env)
                self.assertEqual(done.returncode, 0, "git %s: %s%s" % (args, done.stdout, done.stderr))
                return done.stdout

            git("init", "-q", "-b", "main")
            target = Path(work) / "scenarios" / "switchboard" / "cli-surface" / "commands"
            target.mkdir(parents=True)
            for existing in self.SURFACE_DIR.glob("*.json"):
                (target / existing.name).write_text(existing.read_text())
            git("add", ".")
            git("commit", "-qm", "base")
            touched = []
            for branch, name in (("one", "alpha-cmd"), ("two", "beta-cmd")):
                git("checkout", "-q", "-b", branch, "main")
                (target / ("%s.json" % name)).write_text(json.dumps({"command": name, "help": "usage: fleet-switchboard %s" % name}))
                git("add", ".")
                git("commit", "-qm", name)
                touched.append(set(git("diff", "--name-only", "main", branch).split()))
            self.assertEqual(touched[0] & touched[1], set(), "0 files changed by both branches")
            git("checkout", "-q", "one")
            git("merge", "--no-edit", "two")
            self.assertTrue((target / "alpha-cmd.json").exists() and (target / "beta-cmd.json").exists())

    def test_the_old_dispatch_table_is_still_registered_and_every_registered_command_has_a_handler(self):
        """OLD is the table of the ORIGINAL commands and never grows: a new command adds no row here. What must hold for every command, old or new, is
        derived: it is registered, and `resolve_command` finds its `cmd_<action>` function."""
        parser, choices = self.commands()
        self.assertTrue(set(self.OLD) <= set(choices), "an original command is gone: %s" % sorted(set(self.OLD) - set(choices)))
        self.assertEqual(parser.commands, frozenset(choices))
        for action in sorted(set(choices) - {"version"}):
            with self.subTest(action=action):
                handler = sb.resolve_command(action, parser.commands)
                self.assertTrue(callable(handler), "%s has no cmd_ function" % action)
                required = [n for n, p in inspect.signature(handler).parameters.items() if p.default is p.empty and p.kind in (p.POSITIONAL_OR_KEYWORD, p.KEYWORD_ONLY)]
                self.assertTrue(set(required) <= set(sb.COMMAND_ARGUMENTS), "%s asks for %s, which a command is never given" % (action, sorted(set(required) - set(sb.COMMAND_ARGUMENTS))))

    def run_dispatch(self, action, **namespace):
        """dispatch() for `action` with every function replaced by a recorder that keeps the real signature: (return value, calls, ensure calls)."""
        calls, ensured = [], []
        fakes = {}
        for name in (set(fn for fn, _ in self.OLD.values()) - {"cmd_plan"}) | {"cmd_plan_check", "cmd_plan_review"}:   # cmd_plan stays real: it chooses between the two
            real = getattr(sb, name)

            def make(real=real, name=name):
                signature = inspect.signature(real)

                def fake(*a, **kw):
                    calls.append((name, dict(signature.bind(*a, **kw).arguments)))   # by parameter name, whether it was called by position or by keyword
                    return 17
                fake.__signature__ = inspect.signature(real)
                fake.__name__ = name
                return fake
            fakes[name] = make()
        args = types.SimpleNamespace(action=action, plan_action=namespace.get("plan_action"))
        with mock.patch.multiple(sb, **fakes), mock.patch.object(sb, "ensure_on_use", lambda spawn=None: ensured.append(action)):
            code = sb.dispatch(args, self.commands()[0].commands, runner="R", now="N", wait="W", spawn="S", socket_call="C")
        return code, calls, ensured

    def test_every_command_runs_the_same_function_with_the_same_arguments_as_before(self):
        values = {"args": None, "runner": "R", "now": "N", "spawn": "S", "socket_call": "C", "wait": "W"}
        for action, (function, given) in self.OLD.items():
            with self.subTest(action=action):
                code, calls, ensured = self.run_dispatch(action)
                if action == "plan":   # `plan check` is the default and, as before, was given no socket
                    function, given = "cmd_plan_check", ("args", "runner", "now")
                self.assertEqual(code, 17)
                self.assertEqual([c[0] for c in calls], [function], "exactly the old function, once")
                self.assertEqual(sorted(calls[0][1]), sorted(given), "given exactly what it was given before")
                for name in given:
                    if name != "args":
                        self.assertEqual(calls[0][1][name], values[name])
                self.assertEqual(ensured, [action] if action in self.OLD_ENSURE_ON_USE else [], "the daemon is started for the same commands")

    def test_plan_review_is_the_one_subcommand_that_chooses_a_second_function(self):
        code, calls, _ = self.run_dispatch("plan", plan_action="review")
        self.assertEqual([c[0] for c in calls], ["cmd_plan_review"])
        self.assertEqual(sorted(calls[0][1]), ["args", "now", "runner", "socket_call"])

    def test_version_prints_and_runs_nothing(self):
        with captured() as (out, err):
            code, calls, ensured = self.run_dispatch("version")
        self.assertEqual((code, calls, ensured), (0, [], []))
        self.assertIn(sb.VERSION, out.getvalue())

    @staticmethod
    def declared_groups():
        """{group: set(actions)} read from the SOURCE: every module-level `cmd_x.<group> = True` of bin/fleet-switchboard, for a command the parser
        registers. This is what each command says beside itself: the expected sets are DERIVED from it, never kept as a list in a test."""
        declared = {"direct": set(), "ledger": set(), "ensure_on_use": set()}
        registered = TestSelfRegisteringCli.commands()[0].commands
        tree = ast.parse(switchboard_source())
        plain = {id(node) for node in tree.body}
        for node in ast.walk(tree):    # a declaration written any other way would be invisible to the scan AND to the views: refuse it
            if isinstance(node, ast.Assign) and any(isinstance(x, ast.Attribute) and x.attr in declared and isinstance(x.value, ast.Name)
                                                    and x.value.id.startswith("cmd_") for x in node.targets):
                if id(node) not in plain or not (isinstance(node.value, ast.Constant) and node.value.value is True):
                    raise AssertionError("line %d declares a command's dispatch group in a form the guard cannot read: write `cmd_x.<group> = True` at module level" % node.lineno)
        for node in tree.body:
            if isinstance(node, ast.Assign) and len(node.targets) == 1 and isinstance(node.targets[0], ast.Attribute) \
                    and isinstance(node.targets[0].value, ast.Name) and node.targets[0].attr in declared \
                    and isinstance(node.value, ast.Constant) and node.value.value is True and node.targets[0].value.id.startswith("cmd_"):
                action = node.targets[0].value.id[4:].replace("_", "-")
                if action in registered:
                    declared[node.targets[0].attr].add(action)
        return declared

    def group_problems(self):
        """One line per group whose effective set differs from what the commands declare, naming the commands."""
        declared, problems = self.declared_groups(), []
        for name, effective, key in (("DIRECT_ACTIONS", sb.DIRECT_ACTIONS, "direct"), ("LEDGER_ACTIONS", sb.LEDGER_ACTIONS, "ledger"),
                                     ("ENSURE_ON_USE_COMMANDS", sb.ENSURE_ON_USE_COMMANDS, "ensure_on_use")):
            if set(effective) != declared[key]:
                problems.append("%s differs from what the commands declare: missing %s, extra %s" % (name, sorted(declared[key] - set(effective)), sorted(set(effective) - declared[key])))
        return problems

    def test_the_error_mapping_and_the_special_groups_are_what_they_were(self):
        # The effective groups (the module's views) must equal what the commands DECLARE (read from the source), exactly: a command whose declared
        # group differs from its effective one fails loudly. And the pure-move guarantee stays: every original member is still in its group.
        self.assertEqual(self.group_problems(), [])
        with mock.patch.object(sb, "LEDGER_ACTIONS", frozenset(set(sb.LEDGER_ACTIONS) - {"gates"})):       # the guard fails loudly and names the command
            self.assertEqual(self.group_problems(), ["LEDGER_ACTIONS differs from what the commands declare: missing ['gates'], extra []"])
        with mock.patch.object(sb, "DIRECT_ACTIONS", frozenset(set(sb.DIRECT_ACTIONS) | {"send"})):
            self.assertEqual(self.group_problems(), ["DIRECT_ACTIONS differs from what the commands declare: missing [], extra ['send']"])
        self.assertTrue(set(self.OLD_DIRECT) <= set(sb.DIRECT_ACTIONS))
        self.assertTrue(set(self.OLD_LEDGER) <= set(sb.LEDGER_ACTIONS))
        self.assertTrue(set(self.OLD_ENSURE_ON_USE) <= set(sb.ENSURE_ON_USE_COMMANDS))
        self.assertNotIn("judge-tool", sb.ENSURE_ON_USE_COMMANDS, "judge-tool runs inside v2 on every tool call: it never starts the daemon")
        known = self.commands()[0].commands

        def raising(error):
            def fake(args, runner, now, **kw):
                raise error
            return fake
        args = lambda action: types.SimpleNamespace(action=action, plan_action=None)
        with mock.patch.object(sb, "ensure_on_use", lambda spawn=None: None):
            with mock.patch.object(sb, "cmd_send", raising(sb.V2Error("down"))), captured() as (out, err):   # a mapped command: its error is EXIT_ERROR with the message
                self.assertEqual(sb.dispatch(args("send"), known), sb.EXIT_ERROR)
                self.assertIn("down", err.getvalue())
            with mock.patch.object(sb, "cmd_status", raising(sb.V2Error("down"))):   # a direct command: the error is its own, not mapped
                with self.assertRaises(sb.V2Error):
                    sb.dispatch(args("status"), known)
            with mock.patch.object(sb, "cmd_gates", raising(sb.LedgerCommandError("bad ledger"))), captured() as (out, err):   # ledger commands: a usage error
                self.assertEqual(sb.dispatch(args("gates"), known), sb.EXIT_USAGE)
                self.assertIn("gates: bad ledger", err.getvalue())
            with mock.patch.object(sb, "cmd_send", raising(sb.LedgerCommandError("x"))):   # elsewhere that error is not mapped (as before)
                with self.assertRaises(sb.LedgerCommandError):
                    sb.dispatch(args("send"), known)
            with mock.patch.object(sb, "cmd_send", raising(sb.SimulatedCrash("boom"))), captured() as (out, err):
                self.assertEqual(sb.dispatch(args("send"), known), sb.EXIT_CRASH)

    def test_a_hostile_or_unknown_name_cannot_run_an_arbitrary_function(self):
        known = self.commands()[0].commands
        ran = []
        with mock.patch.object(sb, "cmd_gates_stats", lambda *a, **k: ran.append("gates_stats")), mock.patch.object(sb, "cmd_decision_write", lambda *a, **k: ran.append("write")), \
                mock.patch.object(sb, "ensure_on_use", lambda spawn=None: ran.append("ensure")):
            for name in (None, 5, "", "Status", "status ", " status", "status;x", "../status", "gates-stats", "gates_stats", "decision-write", "cmd-status", "cmd_status",
                         "__import__", "__class__", "build-parser", "build_parser", "dispatch", "main", "resolve-command", "os.system", "sb", "x" * 500, "status\x00", "STATUS"):
                with self.subTest(name=name):
                    self.assertIsNone(sb.resolve_command(name, known))
                    with captured() as (out, err):
                        code = sb.dispatch(types.SimpleNamespace(action=name, plan_action=None), known)
                    self.assertEqual(code, sb.EXIT_USAGE)
                    self.assertIn("unknown command", err.getvalue())
        self.assertEqual(ran, [], "nothing ran, not even the daemon start")
        for action in known:   # a registered command resolves to its OWN cmd_ function and to nothing else
            if action != "version":
                self.assertEqual(sb.resolve_command(action, known).__name__, "cmd_" + action.replace("-", "_"))
        with mock.patch.dict(sb.__dict__, {"cmd_zzz": 5}):   # a cmd_ name that is not callable is not a command
            self.assertIsNone(sb.resolve_command("zzz", frozenset({"zzz"})))

    def test_a_new_command_is_two_functions_and_no_shared_edit(self):
        seen = []

        def add_synthetic_parsers(sub):
            sub.add_parser("synthetic", help="a command added by name only").add_argument("--x")

        def cmd_synthetic(args, runner, now):
            seen.append((args.x, runner, now))
            return 7

        def add_not_a_registrar_parser(sub):   # the registrar name rule: `add_<name>_parsers` only
            raise AssertionError("must not be collected")
        with mock.patch.dict(sb.__dict__, {"add_synthetic_parsers": add_synthetic_parsers, "cmd_synthetic": cmd_synthetic, "add_not_a_registrar_parser": add_not_a_registrar_parser}):
            self.assertIn("add_synthetic_parsers", [r.__name__ for r in sb.command_registrars()])
            self.assertNotIn("add_not_a_registrar_parser", [r.__name__ for r in sb.command_registrars()])
            self.assertEqual(sb.main(["synthetic", "--x", "1"], runner="R", now="N"), 7)
        self.assertEqual(seen, [("1", "R", "N")])
        with captured() as (out, err):
            self.assertEqual(sb.main(["synthetic"], runner="R", now="N"), sb.EXIT_USAGE, "outside the patch the command does not exist")

    def test_a_new_command_can_say_it_is_direct_next_to_its_own_definition(self):
        def add_direct_demo_parsers(sub):
            sub.add_parser("direct-demo")

        def cmd_direct_demo(args, runner, now):
            raise sb.V2Error("its own error")
        cmd_direct_demo.direct = True
        with mock.patch.dict(sb.__dict__, {"add_direct_demo_parsers": add_direct_demo_parsers, "cmd_direct_demo": cmd_direct_demo}):
            with self.assertRaises(sb.V2Error):   # direct: the error is not mapped (a mapped command would return EXIT_ERROR)
                sb.main(["direct-demo"])

    def test_a_command_may_ask_only_for_the_arguments_a_command_is_given(self):
        _, choices = self.commands()
        for action in choices:
            if action == "version":
                continue
            handler = sb.resolve_command(action, frozenset(choices))
            with self.subTest(action=action):
                required = [n for n, p in inspect.signature(handler).parameters.items() if p.default is p.empty]
                self.assertTrue(set(required) <= set(sb.COMMAND_ARGUMENTS), required)

        def greedy(args, secrets):
            return 0
        with self.assertRaises(TypeError) as caught:
            sb.call_command(greedy, args=1, runner=2)
        self.assertIn("secrets", str(caught.exception))
        self.assertEqual(sb.call_command(lambda args, now=None: (args, now), args=1, runner=2, now=3), (1, 3), "only what it names, from what is available")

    def test_help_order_is_the_registration_order_and_the_docs_say_so(self):
        _, choices = self.commands()
        registered = [n for n in choices if n not in ("status", "run", "send", "report", "notice", "ensure", "poke", "launch", "pending", "remind", "whoami", "comment", "handoff", "version")]
        self.assertEqual(registered[0], "agents")
        self.assertIn("alphabetical by function name", (REPO / "docs" / "switchboard.md").read_text())


class TestOwnMeasurementTester(unittest.TestCase):
    """An orchestrator that measured a scenario itself re-measures through a tester of its lane, never a waiver."""
    PLANNING = "**Own measurement:** launch a tester of your lane (`--role tester --repo <the pull request's repo> --reports-to <you>`, headless) to re-measure and record; never record as yourself."
    COORDINATION = "When a scenario's evidence is your own measurement, from your own pane launch a tester of your lane (`--role tester --repo <the pull request's repo> --reports-to <you>`, headless is enough) to re-measure and record the verdict: never record as yourself, and do not ask for a waiver."

    def test_each_text_is_in_its_skill_exactly_once(self):
        for skill, text in (("fleet-planning", self.PLANNING), ("fleet-coordination", self.COORDINATION)):
            with self.subTest(skill=skill):
                self.assertEqual((REPO / "skills" / skill / "SKILL.md").read_text().count(text), 1)

    def test_the_texts_name_roles_never_agents_or_people(self):
        for text in (self.PLANNING, self.COORDINATION):
            self.assertNotRegex(text, r"(?i)\b(coder\d|cos\b|fleet-upkeep|adam\b)")


class TestWorkerRulesInSkills(unittest.TestCase):
    """#719: the message cap, the daemon-recorded ci verdict and the plan check wordings, each said once."""
    CAP = "`send` messages are capped (about 3000 characters in practice, 4000 hard): put long text in a file made under `mktemp -d` and pass it as `\"$(cat <file>)\"`."
    CI = "The daemon records the `ci` verdict itself about five minutes after CI is green at the head, so read `fleet-switchboard gates <pr>` and do not ask for `gates ci-record`, which stays for a hurry."
    LIST = "## Wordings `plan check` accepts"
    SHAPES = ("every declared `DW`/`PC` is covered by a scenario", "`discriminates` names a concrete wrong build (a stub that returns an empty list)",
              "`pass` has an observable number or status", "the declared clauses joined equal the ask's Done-when", "check a slice with `--ask <its own work item>`")

    def read(self, skill):
        return (REPO / "skills" / skill / "SKILL.md").read_text()

    def test_the_message_cap_sentence_is_in_the_coordination_skill_once(self):
        self.assertEqual(self.read("fleet-coordination").count(self.CAP), 1)

    def test_the_ci_verdict_sentence_is_in_the_skills_once_overall(self):
        self.assertEqual(sum(self.read(s).count(self.CI) for s in ("fleet-coordination", "fleet-planning")), 1)

    def test_the_plan_check_wording_list_is_in_the_planning_skill_once_with_its_five_shapes(self):
        text = self.read("fleet-planning")
        self.assertEqual(text.count(self.LIST), 1)
        section = text.split(self.LIST, 1)[1].split("\n## ", 1)[0]
        for shape in self.SHAPES:
            self.assertEqual(section.count(shape), 1, shape)

    RERUN = "`gh run rerun --failed` reuses the run's old merge ref, so a fix that landed on the base branch afterwards does not reach the pull request; closing and reopening it (head unchanged) recomputes the merge ref and starts fresh CI, and for a held pull request the orchestrator that owns it says so first, because the owner's clear is bound to the head, which does not change. A run's logs may be readable while it is in progress, once a job has uploaded its logs, through the jobs logs API (`gh api repos/<repo>/actions/jobs/<id>/logs`, add `--allow-escape-sequences`; it answers 404 before that), because `gh run view --log-failed` waits for the run to end."

    def test_the_rerun_and_in_progress_logs_paragraph_is_in_the_coordination_skill_exactly_once(self):
        self.assertEqual(self.read("fleet-coordination").count(self.RERUN), 1)
        skill = self.read("fleet-coordination")
        for word in ("rerun --failed", "old merge ref", "reopening", "bound to the head", "actions/jobs", "log-failed"):
            self.assertIn(word, skill)

    def test_the_rerun_paragraph_names_roles_never_agents_or_people(self):
        self.assertNotRegex(self.read("fleet-coordination").split("`gh run rerun --failed`",1)[1].split("\n\n",1)[0], r"(?i)\b(coder\d|cos\b|fleet-upkeep|adam\b)")

    def test_the_texts_name_roles_never_agents_or_people(self):
        for text in (self.CAP, self.CI, self.LIST) + self.SHAPES:
            self.assertNotRegex(text, r"(?i)\b(coder\d|cos\b|fleet-upkeep|adam\b)")


class TestChecklistAndFamilyTexts(unittest.TestCase):
    """#814: the deleter/alert checklist and the whole-family sentence, each said once in each of two skills."""
    LINES = ("- Drive the real code path in the tests, never a copied helper.\n"
             "- Derive every set of kinds from one table, with a completeness test that fails when a kind is missing from it.\n"
             "- Read the sibling kinds and the consumers yourself.\n")
    FAMILY = ("When a review finding names a gap in one member of a table, list, set or rule family (a row, a kind, an input, a rule), the fix covers every member in the same head: "
              "derive the set from the code, never a hand-listed copy, parametrise the tests over it with one mutant per member, and say in the PR body which members were checked; "
              "reviewers name the class, not only the instance.")
    SKILLS = ("fleet-coordination", "fleet-review")

    def read(self, skill):
        return (REPO / "skills" / skill / "SKILL.md").read_text()

    def test_each_text_is_in_each_skill_exactly_once_and_the_checklist_has_three_lines(self):
        for skill in self.SKILLS:
            text = self.read(skill)
            self.assertEqual(text.count(self.LINES), 1, skill)
            intro = text.split(self.LINES, 1)[0].rstrip("\n").splitlines()[-1]
            self.assertIn("deletes something or raises an alert", intro, skill)
            after = text.split(self.LINES, 1)[1].lstrip("\n").splitlines()[0]
            self.assertFalse(after.startswith("- "), skill)  # exactly 3 bullets follow the intro
            self.assertEqual(text.count(self.FAMILY), 1, skill)

    def test_the_texts_name_roles_never_agents_or_people(self):
        for text in (self.LINES, self.FAMILY):
            self.assertNotRegex(text, r"(?i)\b(coder\d|cos\b|fleet-upkeep|adam\b)")


class TestIntegrationBranchVerdictText(unittest.TestCase):
    """#776: what plan a PR into an integration branch must link, said once in the docs and once in the coordination skill."""
    DOC = ("The ledger never uses the pull request's base branch to choose or relax a plan: a pull request, including one into an integration branch, is gated by the plan its body links with a `PLAN:` line (or `--plan`), "
           "and `verdict --all` refuses with \"no per-PR scenario of this plan is judged by reviewer\" (naming the evaluator you passed) when the linked plan has no per-PR scenario naming that evaluator.")
    SKILL = ("For a PR into an integration branch, link the epic's plan or a plan of its own with at least one scenario judged by `reviewer` (a scenario with no `claim` is per pull request), "
             "or put the line `per-pr scenarios: none because <reason of at least 20 characters>` in the plan (then G1 reads n/a and there is no reviewer verdict to record).")

    DRAFT = ("Some repositories' workflows skip draft pull requests (a coder lost four hours reading that as a failing CI): when a draft shows no CI runs, "
             "look at the workflow's draft filter and mark the PR ready before waiting for CI (if there is no filter, the cause is elsewhere).")

    def test_the_draft_sentence_is_present_once(self):
        self.assertEqual((REPO / "skills" / "fleet-coordination" / "SKILL.md").read_text().count(self.DRAFT), 1)

    def test_the_doc_passage_is_present_once(self):
        self.assertEqual((REPO / "docs" / "switchboard.md").read_text().count(self.DOC), 1)

    def test_the_skill_sentence_is_present_once(self):
        self.assertEqual((REPO / "skills" / "fleet-coordination" / "SKILL.md").read_text().count(self.SKILL), 1)

    def test_the_refusal_wording_is_the_one_the_command_prints(self):
        self.assertIn("no per-PR scenario of this plan is judged by %s", (REPO / "bin" / "fleet-switchboard").read_text())

    def test_the_texts_name_roles_never_agents_or_people(self):
        for text in (self.DOC, self.SKILL):
            self.assertNotRegex(text, r"(?i)\b(coder\d|cos\b|fleet-upkeep|adam\b)")


class TestLaunchMemoryTest(unittest.TestCase):
    """#758: the launch memory test is said once in the coordination skill; no swap-used percentage rule anywhere."""
    SENTENCE = "Launch a new worker or tester only when `memory_pressure` reports a free percentage of at least 40 and the `Swapouts` counter of `vm_stat` is unchanged between two reads 30 seconds apart (swap used is sticky on macOS and is not the test); launch applies it itself; `--memory-ok <reason>` overrides."

    def test_the_sentence_is_in_the_coordination_skill_exactly_once(self):
        self.assertEqual((REPO / "skills" / "fleet-coordination" / "SKILL.md").read_text().count(self.SENTENCE), 1)

    def test_no_skill_or_definition_states_a_swap_used_percentage_rule(self):
        files = list(REPO.glob("skills/*/SKILL.md")) + list(REPO.glob("agents/opencode/*.md")) + list(REPO.glob("agents/copilot/*.agent.md"))
        self.assertTrue(files)
        for f in files:
            self.assertNotRegex(f.read_text(), r"(?i)swap[^.\n]{0,40}\d+\s*(%|percent)", f.name)

    def test_the_sentence_names_roles_never_agents_or_people(self):
        skill = (REPO / "skills" / "fleet-coordination" / "SKILL.md").read_text()
        sentence = skill[skill.index("Launch a new worker or tester only when"):].split("\n", 1)[0]
        self.assertNotRegex(sentence, r"(?i)\b(coder\d|cos\b|fleet-upkeep|adam\b)")


class TestPlanningSkill(unittest.TestCase):
    """skills/fleet-planning: short, installed like the other skills, and its own example passes `plan check`."""
    SKILL = REPO / "skills" / "fleet-planning" / "SKILL.md"

    def test_it_is_a_short_skill_with_the_frontmatter_the_others_have(self):
        text = self.SKILL.read_text()
        self.assertTrue(text.startswith("---\nname: fleet-planning\ndescription: "))
        self.assertLessEqual(len(text.split()), 1100, "the skill must be cheap to load")
        for phrase in ("PLAN: <link>", "fleet-switchboard plan check", "plan review", "docs/plan-template.md", "discriminates", "What the reviewers attack"):
            self.assertIn(phrase, text)
        self.assertIn("not built yet", text)  # the review engine is part 2: said plainly
        self.assertNotIn("--tier", text)  # no command signature for a command that does not exist yet
        self.assertIn("computed from the ask or epic", text)
        self.assertIn("name the integration branch in the plan", text)

    def test_it_is_installed_with_the_kits_other_skills_and_named_in_the_install_guide(self):
        self.assertIn("fleet-planning", sb.kit_skill_names(REPO))
        self.assertIn('ln -s "$PWD/skills/fleet-planning"', (REPO / "INSTALL.md").read_text())

    def test_its_example_passes_the_check_it_teaches(self):
        text = self.SKILL.read_text()
        block = re.search(r"```yaml\n(scenarios:.*?)```", text, re.S).group(1)
        done = "(1) a project with no agents lists none, and after commissioning lists exactly one"
        plan = "## Plan\n\nDone when: %s\n\nPC-1: existing projects keep their listing\n\n```yaml\n%s```\n" % (done, block)
        with tempfile.TemporaryDirectory() as tmp:
            path = Path(tmp) / "plan.md"
            path.write_text(plan)
            out = subprocess.run([sys.executable, str(REPO / "bin" / "fleet-switchboard"), "plan", "check", "--file", str(path), "--done-when", done],
                                 capture_output=True, text=True)
        self.assertEqual(out.returncode, 0, out.stdout + out.stderr)
        self.assertIn("plan check: PASS", out.stdout)


class TestAgentDefinitions(unittest.TestCase):
    def test_there_are_eight_role_files(self):
        self.assertEqual(sorted(role_of(p) for p in AGENT_FILES),
                         sorted(["coder", "orchestrator", "chief-of-staff", "cos-subagent"] * 2))

    def test_each_has_a_short_maxims_block_with_its_roles_phrases(self):
        for path in AGENT_FILES:
            with self.subTest(file=str(path.relative_to(REPO))):
                block = maxims_block(path.read_text())
                self.assertTrue(block, "no ## Maxims block")
                self.assertLessEqual(len([line for line in block.splitlines() if line.strip()]), 12)
                role = role_of(path)
                for phrase in SHARED_MAXIMS:
                    # `Say it failed` lives in CODING_STANDARDS.md (R-CODE-1); the coder keeps a pointer, not the text. Chesterton's fence and cut the root stay in EVERY definition: Copilot coders and other installs load no global AGENTS.md
                    if role == "coder" and phrase in HYGIENE_MAXIMS:
                        self.assertNotIn(phrase, block)
                    else:
                        self.assertIn(phrase, block)
                self.assertEqual("CODING_STANDARDS.md" in block, role == "coder")
                self.assertEqual("Trust, but verify" in block, role not in WORKER_ROLES)
                for phrase in COS_ONLY_MAXIMS:
                    self.assertEqual(phrase in block, role == "chief-of-staff", phrase)

    def test_the_maxims_come_before_the_rest_of_the_body(self):
        for path in AGENT_FILES:
            with self.subTest(file=path.name):
                headings = re.findall(r"^## (.*)$", path.read_text(), re.M)
                self.assertEqual(headings[0], "Maxims")

    def test_chief_of_staff_and_orchestrator_carry_the_rubric(self):
        for path in AGENT_FILES:
            text = path.read_text()
            with self.subTest(file=path.name):
                for phrase in RUBRIC:
                    self.assertEqual(phrase in text, role_of(path) not in WORKER_ROLES, phrase)

    def test_each_explains_a_switchboard_message_and_forbids_typing_into_a_pane(self):
        for path in AGENT_FILES:
            text = path.read_text()
            with self.subTest(file=path.name):
                self.assertIn("[switchboard]", text)
                self.assertIn("fleet-switchboard send", text)
                self.assertRegex(text, r"never by typing")
        for path in AGENT_FILES:
            if role_of(path) == "chief-of-staff":
                self.assertIn("Done when", path.read_text())

    def test_every_role_is_told_its_github_comments_are_signed_for_it_so_plain_gh_is_fine(self):
        """Agents share the user's GitHub account; an unsigned comment comes back to its author as a wake. The
        harness's gh shim signs, so nothing depends on an agent remembering a special command."""
        for path in AGENT_FILES:
            with self.subTest(file=path.name):
                text = " ".join(path.read_text().split())
                self.assertIn("Your comments on GitHub are signed for you", text)
                self.assertIn("use plain `gh`", text)
                self.assertNotIn("not `gh issue comment`", text)
        skill = " ".join((REPO / "skills" / "fleet-charter" / "SKILL.md").read_text().split())
        self.assertIn("Use plain `gh` for what you say on GitHub", skill)

    def test_a_switchboard_wake_is_never_told_to_run_heartbeat_ack(self):
        """The trial found the Chief of Staff running `heartbeat-ack` after a [switchboard] wake, against a
        state directory that does not exist there. Only a `Heartbeat` message may send an agent to it."""
        for path in AGENT_FILES:
            if role_of(path) not in ("chief-of-staff", "orchestrator"):
                continue
            text = path.read_text()
            section = " ".join(text.split("## Wake protocol", 1)[1].split("\n## ", 1)[0].split())
            with self.subTest(file=path.name):
                self.assertIn("[switchboard]", section)
                self.assertIn("does not apply to you", section)
                self.assertIn("starting `Heartbeat`", section)
                self.assertNotIn("heartbeat-ack --pane", text, "no unconditional ack command in the role file")
                self.assertNotIn("You run under the heartbeat service", text)

    def test_the_role_files_keep_their_frontmatter_and_placeholders(self):
        for path in AGENT_FILES:
            text = path.read_text()
            with self.subTest(file=path.name):
                self.assertTrue(text.startswith("---\n"))
                if role_of(path) in ("chief-of-staff", "cos-subagent") and path.parent.name == "opencode":
                    self.assertNotRegex(text.split("\n---\n")[0], r"(?m)^name:")  # v2: a named agent loses its `permissions:` list
                else:
                    self.assertRegex(text.split("\n---\n")[0], r"(?m)^name: %s$" % role_of(path))
                self.assertRegex(text, r"(?m)^model: __(PROVIDER__/__MODEL_ID|MODEL_ID)__$")

    def test_the_coder_and_the_orchestrator_say_never_poll_github_in_a_shell_loop_and_name_pr_state(self):
        sentence = "Never poll GitHub in a shell loop; wait with `fleet-switchboard remind` and read with `fleet-switchboard pr-state <owner/repo#N>`."
        found = [p for p in AGENT_FILES if role_of(p) in ("coder", "orchestrator")]
        self.assertEqual(len(found), 4, "coder and orchestrator, opencode and copilot")
        for path in found:
            with self.subTest(file=path.name):
                self.assertEqual(path.read_text().count(sentence), 1)

    def test_the_role_files_do_not_grow(self):
        for path in AGENT_FILES:
            text = path.read_text()
            if role_of(path) in ("chief-of-staff", "cos-subagent") and path.parent.name == "opencode":
                text = text.split("\n---\n", 1)[1]  # the permissions list is configuration, not prompt: only the body counts
            role = role_of(path)
            with self.subTest(file=path.name):
                self.assertLessEqual(len(text.splitlines()), ROLE_LINE_LIMITS[role])
                self.assertLessEqual(len(text.encode("utf-8")), ROLE_BYTE_LIMITS[role])

    def test_the_skills_carry_the_ask_level(self):
        charter = (REPO / "skills" / "fleet-charter" / "SKILL.md").read_text()
        for phrase in ("## Intent", "Done when:", "ask", "work item", "never widen"):
            self.assertIn(phrase, charter, phrase)
        coordination = (REPO / "skills" / "fleet-coordination" / "SKILL.md").read_text()
        for phrase in ("ASK:", "fleet-switchboard intent"):
            self.assertIn(phrase, coordination, phrase)


class TestIntentScenarios(Base):
    def test_a_variant_may_patch_the_issues(self):
        i2 = sc.load(sc.DEFAULT_DIR / "i2-no-intent-recorded.json")
        patched = sc.apply_variant(i2, i2["control"]["variant"])
        self.assertEqual(patched["issues"]["2"]["intent"], "Add a health check")
        self.assertIsNone(i2["issues"]["2"]["intent"])
        with self.assertRaises(sc.VariantError):
            sc.apply_variant(i2, {"issues": {"2": {}}})

    def test_the_pr6_catalog_is_present(self):
        found = {s["id"]: s for s in map(sc.load, sc.scenario_files(sc.DEFAULT_DIR))}
        for sid, tiers in (("I1", {"offline", "lab-model"}), ("I2", {"offline"}),  # the Lab runner cannot yet play
                           ("I3", {"offline"}),  # `message_shows` and `edit-intent`
                           ("I4", {"lab-model"}),
                           ("K1", {"lab-model"}), ("K2", {"lab-model"})):
            with self.subTest(scenario=sid):
                self.assertIn(sid, found)
                self.assertEqual(set(found[sid]["tiers"]), tiers)
                self.assertEqual(found[sid]["since_pr"], 6)
        for sid in ("K1", "K2", "I4"):
            self.assertEqual(found[sid]["control"]["fault"], "no-maxims")
        self.assertEqual(found["I1"]["control"]["fault"], "no-intent-header")

    def test_i3_surfaces_the_change_and_its_control_does_not(self):
        report = run_scenario(self, sc.load(sc.DEFAULT_DIR / "i3-intent-edited.json"))
        self.assertEqual([r["label"] for r in report["control"] if r["ok"]], [])
        self.assertEqual(report["failures"], [])

    def test_the_offline_runner_does_not_pass_judged_off_as_a_control_failure(self):
        report = run_scenario(self, sc.load(sc.DEFAULT_DIR / "i1-report-carries-intent.json"))
        judged = [r for r in report["run"] if r["that"] == "judged"]
        self.assertEqual(len(judged), 1)
        self.assertIn("not evaluated offline", judged[0]["seen"])
        self.assertNotIn("flags-divergence", report["proves_nothing"])
