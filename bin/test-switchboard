    def test_s9_the_same_clear_notice_goes_out_naming_the_chief_of_staff_and_the_order(self):
        self.delegate()
        self.world.add_agent("orch-a", fleet={"role": "orchestrator", "repo": "acme/app", "issue": 7})
        self.files_of_pr("migrations/0002.sql")
        self.passes()
        sb.record_pr_notice(self.world.state, "acme/app", 9, "orch-a", "ready", self.world.clock.now())
        self.assertEqual(self.under()[0], 0)
        (event,) = self.events("gate.clear_notified")
        self.assertIn("chief-of-staff", event["detail"]["sent"])
        texts = [a["text"] for name in ("cos", "orch-a") for a in self.world.admissions(name) if "standing order 17" in a["text"]]
        self.assertTrue(texts and all("cos cleared acme/app#9" in t for t in texts), texts)

    # ---- #835: the Chief of Staff clears by the SCORE of the independent rating, up to the owner's max_level

    def score_config(self, level="Serious", number=17, extra=None):
        entry = dict(self.bound(number), max_level=level) if level is not None else self.bound(number)
        self.extra_config["delegated_clear"] = {"orders": [dict(entry, **(extra or {}))], "charter": 40}
        self.delegate(config=False)

    def ledger_reset(self):
        self.twin_runs = None
        for name in (sb.plan_ledger.LEDGER_FILE, sb.plan_ledger.HEAD_FILE):
            self.world.state.joinpath(name).unlink(missing_ok=True)

    def rate(self, severity, probability, reason="", role="reviewer", head=LEDGER_HEAD, pr="acme/app#9", action="auto", with_block=True, by="rev", digest=None):
        """Record a rating. `action` "auto" is the action of the cell (a helper that only emits VALID shapes: it hides a bad state, so every bad-shape test passes an explicit action or builds the raw record), None omits it."""
        entry = {"kind": "review_record", "pr": pr, "head": head, "reviewer": "impact", "verdict": "approve", "blocks": 0, "notes": 0, "by": by, "by_role": role,
                 "impact_severity": severity, "impact_probability": probability, "impact_reason": reason}
        if with_block:   # #901: the rating carries the agent's block (its hash and its own rating lines), as `review record --block` keeps them
            self.hash_count = getattr(self, "hash_count", 0) + 1
            entry.update(block_sha256=digest or "%064x" % self.hash_count, block_size=200, block_impact_severity=severity, block_impact_probability=probability)
        else:
            entry["block_sha256"] = "none"
        cell = (sb.impact_floor.load_matrix()["cells"].get(severity) or {}).get(probability)
        if action == "auto" and cell:   # the action the reviewer would record for that cell (a record with no action rates nothing: #830's one reading)
            entry["impact_action"] = {"H": "hold", "2": "second-review", ".": "none"}[cell["action"]]
        elif action != "auto" and action is not None:
            entry["impact_action"] = action
        stored = sb.plan_ledger.append_entry(self.world.state, entry, self.world.clock.now())
        if self.TWIN and with_block and by == "rev" and role == "reviewer" and head == LEDGER_HEAD:   # #972: a clear by score needs a second counted run from another session: the earlier fixtures get one beside the first, same cell (a test of the two-run rule itself sets TWIN False)
            self.hash_count += 1
            twin = sb.plan_ledger.append_entry(self.world.state, dict(entry, by="rev2", block_sha256="%064x" % self.hash_count), self.world.clock.now())
            level = (sb.impact_floor.load_matrix()["cells"].get(severity) or {}).get(probability, {}).get("level")
            if level:
                self.twin_runs = (self.twin_runs or []) + [(stored["seq"], "rev", level), (twin["seq"], "rev2", level)]
        return stored

    def cell_of(self, level):
        cells = sb.impact_floor.load_matrix()["cells"]
        return next((s, p) for s in cells for p in cells[s] if cells[s][p]["level"] == level)

    def scored_pr(self, path="docs/notes.md"):
        self.floor_pr(path=path)
        self.files_of_pr(path)
        self.passes()

    def deletes(self):
        return [w for w in self.writes if w[0] == "DELETE"]

    def block(self):
        return sb.impact_floor.load_matrix()["owner_hold"]["delegated_clear"]["score"]

    def floor_rule(self, cls):
        return next(r for r, c in self.block()["floor"]["rules"].items() if c == cls)

    def test_s1_s3_every_level_of_the_ladder_clears_at_or_below_the_threshold_and_high_never(self):
        ladder = self.block()["ladder"]
        for threshold in self.block()["delegable_levels"]:
            for level in ladder:
                with self.subTest(threshold=threshold, level=level):
                    self.writes.clear()
                    self.score_config(threshold)
                    self.scored_pr()
                    self.rate(*self.cell_of(level), role="reviewer")
                    code, out, err = self.under()
                    if level == "High" or ladder.index(level) > ladder.index(threshold):
                        self.assertEqual(code, 2, (level, threshold))
                        self.assertEqual(self.deletes(), [])
                        self.assertIn(level, err)
                        self.assertTrue(("owner's" in err) if level == "High" else (threshold in err), err)
                    else:
                        self.assertEqual(code, 0, err)
                        self.assertTrue(self.deletes())
                    self.ledger_reset()

    def test_s4_a_judgement_under_ten_characters_is_refused_and_nothing_is_written(self):
        self.score_config()
        self.scored_pr()
        self.rate(*self.cell_of("Low"))
        code, out, err = self.under(reason="too short")
        self.assertEqual(code, 2)
        self.assertEqual((self.deletes(), self.events("gate.hold_cleared")), ([], []))

    def test_s5_s6_a_floor_class_sets_the_lowest_score_and_the_rating_must_name_the_rule(self):
        for cls in self.block()["floor"]["rules"].values():
            rule = self.floor_rule(cls)
            owner_hold = sb.impact_floor.load_matrix()["owner_hold"]
            path = next(g for g in owner_hold["top_tier_paths"][cls] if "*" not in g and not sb.impact_floor.matches(g, owner_hold["delegated_clear"]["clear_code_paths"]))   # a floor path of the class that is not machinery (a machinery path is the owner's whatever the score)
            for label, (level, reason, ok) in {"low": ("Low", rule, False), "medium": ("Medium", rule, False), "serious": ("Serious", rule, True), "high": ("High", rule, False),
                                              "serious-empty-reason": ("Serious", "", False), "serious-other-rule": ("Serious", "floor-nothing", False), "serious-free-text": ("Serious", "touches a floor path", False),
                                              "serious-substring": ("Serious", "x" + rule + "y", False)}.items():
                with self.subTest(cls=cls, case=label):
                    self.writes.clear()
                    self.score_config("Serious")
                    self.scored_pr(path)
                    self.rate(*self.cell_of(level), reason=reason)
                    code, out, err = self.under()
                    self.assertEqual(code == 0, ok, err)
                    if label in ("low", "medium"):
                        self.assertIn("below the floor", err)
                        self.assertNotIn("score Serious", err)
                    if label.startswith("serious-") and not ok:
                        self.assertIn("not named", err)
                    self.ledger_reset()

    def test_s5_a_serious_floor_rating_is_refused_at_a_lower_threshold(self):
        self.score_config("Medium")
        self.scored_pr("bin/reassign.py")
        self.rate(*self.cell_of("Serious"), reason=self.floor_rule("authority"))
        code, out, err = self.under()
        self.assertEqual(code, 2)
        self.assertIn("above the threshold Medium", err)

    # ---- #972: a clear by score rests on two independent runs at the head

    def two(self, a, b, by=("rev", "rev2"), blocks=(True, True), heads=(LEDGER_HEAD, LEDGER_HEAD), digests=(None, None)):
        """Two ratings (levels `a`, `b`); returns the reason naming both runs by ledger id and cell."""
        self.TWIN = False
        ids = [self.rate(*self.cell_of(level), by=who, with_block=blk, head=h, digest=d)["seq"] for level, who, blk, h, d in zip((a, b), by, blocks, heads, digests)]
        return "both runs agree on it: #%d=%s, #%d=%s" % (ids[0], a, ids[1], b)

    def refused(self, code, err, *words):
        self.assertEqual(code, 2, err)
        self.assertEqual((self.deletes(), self.events("gate.hold_cleared")), ([], []))
        self.assertEqual(len(self.events("gate.hold_clear_refused")), 1)
        for w in words:
            self.assertIn(w, err)

    def test_972_one_counted_run_is_refused_naming_the_count(self):
        self.score_config("Serious")
        self.scored_pr()
        self.TWIN = False
        self.rate(*self.cell_of("Low"))
        code, out, err = self.under(reason="the one run says it is low: #1=Low")
        self.refused(code, err, "1 counted", "2 required", LEDGER_HEAD[:8])

    def test_972_two_runs_from_one_session_are_refused(self):
        self.score_config("Serious")
        self.scored_pr()
        reason = self.two("Low", "Low", by=("rev", "rev"))
        code, out, err = self.under(reason=reason)
        self.refused(code, err, "1 session", "2 required")

    def test_972_one_run_under_two_identities_is_refused_for_each_variant(self):
        same = "c" * 64
        for label, by, digests, words in (("same block hash, two names", ("rev", "rev2"), (same, same), "1 independent run"),
                                          ("case variant of one name", ("rev", "REV"), (None, None), "1 session"),
                                          ("space variant of one name", ("rev", " rev "), (None, None), "1 session"),
                                          ("same name, same hash", ("rev", "rev"), (same, same), "1 session")):
            with self.subTest(label):
                self.writes.clear()
                self.score_config("Serious")
                self.scored_pr()
                reason = self.two("Low", "Low", by=by, digests=digests)
                code, out, err = self.under(reason=reason)
                self.assertEqual((code, self.deletes()), (2, []), err)
                self.assertIn(words, err)
                self.ledger_reset()
        self.writes.clear()
        self.score_config("Serious")
        self.scored_pr()
        reason = self.two("Low", "Low", by=("rev", "other"), digests=("d" * 64, "e" * 64))
        code, out, err = self.under(reason=reason)
        self.assertEqual(code, 0, (reason, err))

    def test_972_pick_runs_skips_a_second_record_of_the_same_session(self):
        module = sb.load_module("delegated_clear")
        def rec(seq, by, digest):
            return {"seq": seq, "by": by, "block_sha256": digest * 64}
        counted = [(3, "Serious", rec(1, "a", "1")), (3, "Serious", rec(2, "a", "2")), (2, "Medium", rec(3, "b", "3"))]
        runs = module.pick_runs(counted)
        self.assertEqual([(r["id"], r["by"], r["cell"]) for r in runs], [(1, "a", "Serious"), (3, "b", "Medium")])
        self.assertEqual([r["id"] for r in module.pick_runs([(3, "S", rec(1, "a", "1")), (3, "S", rec(2, "A ", "2")), (2, "M", rec(3, "b", "1")), (1, "L", rec(4, "c", "4"))])], [1, 4])
        self.assertEqual(module.pick_runs([(1, "L", {"by": "a", "block_sha256": "1" * 64}), (1, "L", rec(5, "b", "2"))])[0]["id"], 5, "a record with no ledger id is never named")

    def test_972_reason_problems_refuses_unless_exactly_the_required_independent_runs_are_given(self):
        module = sb.load_module("delegated_clear")
        one = {"id": 1, "by": "a", "hash": "1" * 64, "cell": "Low"}
        two = {"id": 2, "by": "b", "hash": "2" * 64, "cell": "Low"}
        ok = "#1=Low, #2=Low"
        self.assertEqual(module.reason_problems(ok, [one, two]), [])
        for label, runs in (("none", []), ("not a list", None), ("one", [one]), ("three", [one, two, dict(two, id=3, by="c", hash="3" * 64)]),
                            ("same hash", [one, dict(two, hash=one["hash"])]), ("name variant", [one, dict(two, by=" A ")]), ("no id", [one, dict(two, id=None)]), ("no hash", [one, dict(two, hash=None)])):
            self.assertTrue(module.reason_problems(ok, runs), label)
        self.assertEqual(module.reason_problems("anything", []) != [], True)
        for contradiction in ("#1=Low, a=Medium, #2=Low", "a=Low, #1=Medium, #2=Low", "#1=Low, #2=Low, b=Serious"):
            self.assertTrue(any("wrong cell" in p for p in module.reason_problems(contradiction, [one, two])), contradiction)

    def test_972_a_record_without_a_block_is_not_counted(self):
        self.score_config("Serious")
        self.scored_pr()
        reason = self.two("Low", "Low", blocks=(True, False))
        code, out, err = self.under(reason=reason)
        self.refused(code, err, "1 counted")

    def test_972_a_run_at_another_head_is_not_counted(self):
        self.score_config("Serious")
        self.scored_pr()
        reason = self.two("Low", "Low", heads=(LEDGER_HEAD, LEDGER_NEW_HEAD))
