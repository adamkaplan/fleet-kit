        for record in data["person"] + data["fleet"]:
            body = record["text"].replace("[switchboard] ", "")
            self.assertEqual(body.replace(data["filler"], "").strip(), "", record["id"])

    def test_s8_shadow_with_v2_light_on_a_clear_verdict_is_audited_and_nothing_is_cleared(self):
