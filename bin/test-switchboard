        self.assertEqual(removed, 0)
        self.assertTrue(victim.exists())

    def test_a_scan_that_spends_its_time_budget_keeps_the_rest_and_judges_those_before_it(self):
        self.old("a-old.txt")
        self.old("b-old.txt")
        t = [0]
        real = self.jan.judge

        def judge_then_pass_the_budget(*a, **k):
            row = real(*a, **k)
            t[0] += 1000   # the first entry's judging takes longer than the whole budget
            return row
        with mock.patch.object(self.jan, "judge", judge_then_pass_the_budget):
            rows = self.jan.scan(self.temp, self.world.state, self.now, self.jan.settings({}), clock=lambda: t[0])
        self.assertEqual(rows[0]["action"], "remove", "the entry reached before the budget ran out is judged")
        self.assertIn("time budget was spent", rows[1]["why"])
        self.assertEqual(rows[1]["action"], "keep")

    def test_a_hostile_name_is_printed_as_plain_text(self):
