    def test_an_unreadable_repo_is_reported_once_and_gives_no_findings(self):
        self.engine.config["triage"]["repos"] = ["acme/api", "acme/gone"]
        self.hub.unreadable = {"acme/gone"}
        self.add(130, created=3, labels=["kind"])
        self.go(passes=15)
        self.assertEqual([r for _, r in self.found() if r.startswith("acme/gone")], [])
        unread = [e for e in self.world.audit() if e["event"] == "triage.unreadable"]
        self.assertEqual([e["detail"]["repo"] for e in unread], ["acme/gone"])
        self.assertEqual(sb.triage_summary(self.world.state)["unreadable"], ["acme/gone"])
        self.assertIn("unreadable repo(s)", "\n".join(sb.triage_status_lines(sb.triage_summary(self.world.state))))

    def test_the_call_budget_per_pass_holds_and_every_repo_is_reached(self):
        repos = ["acme/r%d" % i for i in range(5)]
        for repo in repos:
            self.hub.open[repo] = {}
        self.engine.config["triage"]["repos"] = repos
        worst = 0
        for _ in range(30):
            before = len(self.hub.calls)
            self.world.tick(1)
            sb.triage_pass(self.engine, [], self.world.clock.now(), ())
            worst = max(worst, len(self.hub.calls) - before)
        self.assertLessEqual(worst, sb.TRIAGE_CALLS_PER_PASS)
        self.assertEqual({r for r, u in self.engine.triage.units if u == "issues"}, set(repos))
        quiet = len(self.hub.calls)
        sb.triage_pass(self.engine, [], self.world.clock.now(), ())
        self.assertEqual(len(self.hub.calls), quiet)                  # the cache answers

    def test_shadow_wakes_nobody_and_enabled_adds_only_one_batched_fact_with_a_debounce(self):
        self.charter()
        for n in (140, 141, 142):
            self.add(n, created=3, updated=0.2, labels=["kind"])
        self.go()
        self.assertEqual(self.engine.triage.facts, {})                                      # shadow: nobody woken
        self.assertEqual(sb.triage_summary(self.world.state)["enabled"], False)
        self.go(enabled=True)
        ((key, (summary, _)),) = [(k, v) for k, v in self.engine.triage.facts.items() if "summary" not in k]
        self.assertTrue(summary.startswith("triage: 3 findings: "))
        self.assertEqual(summary.count("acme/api#14"), 3)
        self.assertIn("changes nothing on GitHub", summary)
        fact = [f for f in sb.TriageFacts.__call__(self.bound()) if f.kind == "triage" and "summary" not in f.key]
        self.assertEqual((fact[0].recipient, fact[0].sender), ("cos", "switchboard"))
        self.go(passes=3)
        self.assertEqual(len([k for k in self.engine.triage.facts if "summary" not in k]), 1)   # debounced
        self.world.tick(25 * 3600)
        self.engine.triage.confirmed.clear()
        self.engine.triage.units.clear()
        for n in (140, 141, 142):
            self.hub.open["acme/api"][n] = tri_issue(self.world.clock.now(), n, created=4, updated=0.2, labels=["kind"])
        self.go()
        self.assertEqual(len([k for k in self.engine.triage.facts if "summary" not in k]), 2)   # re-alarmed after a day

    def bound(self):
        source = sb.TriageFacts()
        source.bind(self.engine)
        return source

    def test_the_daily_summary_is_audited_once_a_day_and_sent_only_when_enabled(self):
        self.charter()
        self.add(150, created=3, updated=0.2, labels=["kind"])
        self.go()
        summaries = [e for e in self.world.audit() if e["event"] == "triage.summary"]
        self.assertEqual(len(summaries), 1)
        self.assertIn("triage summary: found 1 (T1 1)", summaries[0]["detail"]["text"])
        self.assertEqual([k for k in self.engine.triage.facts if "summary" in k], [])
        self.world.tick(86400 + 5)
        self.go(passes=2, enabled=True)
        self.assertEqual(len([e for e in self.world.audit() if e["event"] == "triage.summary"]), 2)
        self.assertEqual(len([k for k in self.engine.triage.facts if "summary" in k]), 1)

