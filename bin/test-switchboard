        self.assertEqual(len([e for e in self.world.audit() if e["event"] == "queue_ejection.read_failed"]), 1)

    def chief(self, *names):
        """Discovery that holds Chief of Staff agents, found by their metadata role (the name carries nothing)."""
        self.engine.discovery.agents = {n: types.SimpleNamespace(fleet={"role": "chief-of-staff"}) for n in names}
        self.engine.discovery.agents["worker"] = types.SimpleNamespace(fleet={"role": "coder"})

    def skipped(self):
        return [e["detail"] for e in self.world.audit() if e["event"] == "queue_ejection.skipped"]

    def test_s5_a_pull_request_nobody_owns_wakes_the_chief_of_staff_once_with_facts_and_no_names(self):
        self.engine.hub.owner = None
        self.chief("boss")
        self.add(1401, 501, names=["tests/t.py::boom", "tests/t.py::bang"])
        self.go()
        self.go()
        self.engine.__dict__.pop("queue_ejections")   # a restart
        self.go()
        (to, line), = self.sent
        self.assertEqual(to, "boss")
        for needle in ("%s#501" % self.REPO, "1401", "2 failing tests", "Kind: tests", "No orchestrator owns", "https://github.com/%s/actions/runs/1401" % self.REPO):
            self.assertIn(needle, line)
        self.assertEqual([n for n in ("boom", "bang", "tests/t.py") if n in line], [], "no name from the artifact reaches the Chief of Staff")
        self.assertEqual([e["event"] for e in self.world.audit() if e["event"].startswith("queue_ejection.") and e["event"] != "queue_ejection.skipped"], ["queue_ejection.unowned_woke"])

    def test_s6_an_owned_pull_request_wakes_only_its_owner_and_the_chief_line_holds_no_outsider_text(self):
        self.chief("boss")
        self.add(1402, 502, names=["t"])
        self.go()
        self.assertEqual([to for to, _ in self.sent], ["orch"])
        self.assertIn('"t"', self.sent[0][1], "the owner still gets the names")
        self.engine.hub.owner = None
        self.world.tick(self.module.LIST_SECONDS + 1)
        self.add(1403, 503, names=["@all /deploy https://x.example/p ghp_" + "Ab1" * 10])
        self.go()
        to, line = self.sent[1]
        self.assertEqual(to, "boss")
        self.assertEqual([t for t in ("@", "://x.example", "/deploy", "deploy", "ghp_", "Ab1") if t in line], [])
        self.assertEqual(len(self.sent), 2)

    def test_s8_a_pull_request_whose_named_orchestrator_is_not_running_says_so_and_never_that_nobody_owns_it(self):
