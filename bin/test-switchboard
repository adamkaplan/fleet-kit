    def test_another_persons_issue_is_only_ever_a_flag_never_our_violation(self):
        self.charter()
        self.add(120, created=40, updated=40, author="stranger", labels=[])        # would be T1, T2 and T3 (T11 yields to T1)
        self.go(required_labels={"acme/api": ["kind"]})
        self.assertEqual([f for f in self.found() if f[1] == "acme/api#120"], [("OO", "acme/api#120")])
        row = [e for e in self.world.audit() if e["event"] == "triage.finding" and e["detail"]["rule"] == "OO"][0]
        self.assertEqual(row["detail"]["evidence"]["would_be"], ["T1", "T2", "T3"])

    # #849: `woken` says a wake was queued; a restart does not re-log. Driven through the REAL triage_pass, with the finding
    # source (triage_findings) and its fresh re-read (triage_verify) fixed to one finding of the rule under test, so every
    # member of TRIAGE_KINDS (the table the code loops over) gets the same cases. An OO flag is never a wake of its own.
    def one_rule(self, rule):
        ref = "acme/api#%d" % (50 + sorted(sb.TRIAGE_KINDS).index(rule))
        return ref, mock.patch.multiple(sb, triage_findings=lambda *a, **k: ([(rule, ref, {})], {}, []),
                                        triage_verify=lambda *a, **k: True)

    def tlines(self, ref):
        return [e["detail"] for e in self.world.audit() if e["event"] == "triage.finding" and e["detail"]["ref"] == ref]

    def pass_now(self):
        sb.triage_pass(self.engine, [], self.world.clock.now(), ())

    def aligned(self):
        """Tick to one minute before UTC midnight: a pass now and one two minutes later are on different days, inside the window."""
        self.world.tick(86400 - self.world.clock.now() % 86400 - 60)

    def test_849_the_audit_cases_run_over_every_rule_of_the_table(self):
        self.assertEqual(set(sb.TRIAGE_KINDS), {"T%d" % n for n in (1, 2, 3, 5, 6, 7, 8, 9, 10, 11, 12)} | {"OO"})

    def test_849_a_due_finding_is_woken_and_a_logged_one_not_due_reads_woken_false(self):
        for rule in sorted(sb.TRIAGE_KINDS):
            with self.subTest(rule=rule):
                self.setUp()
                self.engine.config["triage"]["enabled"] = True
                ref, patch = self.one_rule(rule)
                with patch:
                    self.aligned()
                    self.pass_now()
                    self.world.tick(120)                                             # the next day, inside the window
                    self.pass_now()
                    # an OO flag is never woken, so its second line is the first one again (the audit writes a repeat once)
                    self.assertEqual([d["woken"] for d in self.tlines(ref)], [False] if rule == "OO" else [True, False])
                    self.assertEqual(len([k for k in self.engine.triage.facts if k.startswith("triage:")]), 0 if rule == "OO" else 1)

    def test_849_a_finding_listed_before_a_restart_is_not_logged_again(self):
        for rule in sorted(set(sb.TRIAGE_KINDS) - {"OO"}):   # an OO flag is never listed in the memory
            with self.subTest(rule=rule):
                self.setUp()
                self.engine.config["triage"]["enabled"] = True
                ref, patch = self.one_rule(rule)
                with patch:
                    self.aligned()
                    self.pass_now()
                    self.assertEqual([d["woken"] for d in self.tlines(ref)], [True])
                    self.engine.triage, self.engine._last = None, {}                 # the daemon restarts: memory only is gone, the audit's repeat filter too
                    self.world.tick(120)
                    self.pass_now()
                    self.assertEqual(len(self.tlines(ref)), 1)                       # not logged again
                    self.engine.triage, self.engine._last = None, {}
                    self.world.tick(2 * 86400)                                       # past the back-off: due again, logged once more, woken
                    self.pass_now()
                    self.assertEqual([d["woken"] for d in self.tlines(ref)], [True, rule != "T5"])   # a T5 is listed once, then only rolled up

    def test_849_a_finding_changed_since_the_restart_is_due_and_logged_woken(self):
        for rule in sorted(set(sb.TRIAGE_KINDS) - {"OO", "T5"}):
            with self.subTest(rule=rule):
                self.setUp()
                self.engine.config["triage"]["enabled"] = True
                self.engine.config["triage"]["digest_interval_minutes"] = 0
                ref, patch = self.one_rule(rule)
                with patch:
                    self.aligned()
                    self.pass_now()
                    seen = Path(self.world.state) / sb.triage_digest.SEEN_FILE
                    raw = json.loads(seen.read_text())
                    raw["items"]["%s %s" % (rule, ref)]["sig"] = "an older state"   # the item changed while the daemon was down
                    seen.write_text(json.dumps(raw))
                    self.engine.triage, self.engine._last = None, {}
                    self.world.tick(120)
                    self.pass_now()
                    self.assertEqual([d["woken"] for d in self.tlines(ref)], [True, True])

    def test_849_a_wake_queued_later_the_same_day_is_logged_once_more_as_woken(self):
        for rule in sorted(set(sb.TRIAGE_KINDS) - {"OO"}):
            with self.subTest(rule=rule):
                self.setUp()
                ref, patch = self.one_rule(rule)
                with patch:
                    self.pass_now()                                                   # shadow: audited, nobody woken
                    self.engine.config["triage"]["enabled"] = True
                    self.pass_now()
                    self.pass_now()
                    self.assertEqual([d["woken"] for d in self.tlines(ref)], [False, True])

    def test_849_an_overflow_beyond_the_digest_cap_is_not_woken_and_stays_due(self):
        rules, refs = ["T1", "T2"], ["acme/api#%d" % (60 + n) for n in range(2)]
        self.engine.config["triage"].update(enabled=True, max_findings=1, digest_interval_minutes=0)
        with mock.patch.multiple(sb, triage_findings=lambda *a, **k: ([(r, ref, {}) for r, ref in zip(rules, refs)], {}, []),
                                 triage_verify=lambda *a, **k: True):
            self.pass_now()
            (summary, _), = [v for k, v in self.engine.triage.facts.items() if k.startswith("triage:")]
            woken = [ref for ref in refs if self.tlines(ref)[0]["woken"]]
            self.assertEqual(len(woken), 1)
            self.assertIn(woken[0], summary)                                     # the one read woken is the one the digest named
            self.assertEqual(sum(ref in summary for ref in refs), 1)             # the other is not carried at all
            other = [ref for ref in refs if ref != woken[0]][0]
            self.world.tick(120)                                                 # it stays due: the next digest carries it
            self.pass_now()
            self.assertEqual([d["woken"] for d in self.tlines(other)], [False, True])

    def test_849_an_other_owner_flag_riding_along_with_a_wake_reads_woken_and_alone_reads_false(self):
        ref_t, ref_oo = "acme/api#60", "acme/api#61"
        self.engine.config["triage"]["enabled"] = True
        with mock.patch.multiple(sb, triage_findings=lambda *a, **k: ([("OO", ref_oo, {})], {}, []), triage_verify=lambda *a, **k: True):
            self.pass_now()
            self.assertEqual([d["woken"] for d in self.tlines(ref_oo)], [False])   # never a wake of its own
        self.setUp()
        self.engine.config["triage"]["enabled"] = True
        with mock.patch.multiple(sb, triage_findings=lambda *a, **k: ([("T1", ref_t, {}), ("OO", ref_oo, {})], {}, []), triage_verify=lambda *a, **k: True):
            self.pass_now()
            self.assertEqual([d["woken"] for d in self.tlines(ref_oo)], [True])    # counted in the digest's text and remembered
            self.assertEqual([d["woken"] for d in self.tlines(ref_t)], [True])

    def test_849_a_held_due_finding_is_not_suppressed_by_the_seed_and_is_logged_when_its_wake_goes(self):
        for rule in sorted(set(sb.TRIAGE_KINDS) - {"OO", "T5"}):
            with self.subTest(rule=rule):
                self.setUp()
                self.engine.config["triage"]["enabled"] = True                     # the 60 minute digest cadence holds the second digest
                ref, patch = self.one_rule(rule)
                with patch:
                    self.aligned()
                    self.pass_now()
                    seen = Path(self.world.state) / sb.triage_digest.SEEN_FILE
                    raw = json.loads(seen.read_text())
                    raw["items"]["%s %s" % (rule, ref)]["sig"] = "an older state"   # changed while down: due, but the digest is held
                    seen.write_text(json.dumps(raw))
                    self.engine.triage, self.engine._last = None, {}
                    self.world.tick(120)
                    self.pass_now()
                    self.assertEqual([d["woken"] for d in self.tlines(ref)], [True, False])   # due and held: logged, not woken
                    self.world.tick(3600)
                    self.pass_now()
                    self.assertEqual([d["woken"] for d in self.tlines(ref)], [True, False, True])   # the wake goes: logged once more

    def test_849_shadow_mode_logs_woken_false_for_every_rule(self):
        for rule in sorted(sb.TRIAGE_KINDS):
            with self.subTest(rule=rule):
                self.setUp()
                ref, patch = self.one_rule(rule)
                with patch:
                    self.pass_now()
                    self.assertEqual([d["woken"] for d in self.tlines(ref)], [False])
                    self.assertEqual(self.engine.triage.facts, {})

    def merged_pr(self, number, body, hours_ago=2.0, merged=True, author="bot"):
        record = {"number": number, "body": body, "user": {"login": author}, "html_url": "https://evil.example/\x1b[31m%d" % number,
                  "merged_at": sb.iso(self.world.clock.now() - hours_ago * 3600) if merged else None, "state": "closed"}
        self.hub.pulls.setdefault("acme/api", []).append(record)

    MISSING = object()

    def branch_pr(self, number, body, base="main", head="feature-x", default="main", hours_ago=2.0):
        """A merged pull request record with its branches (#921): `base` / `head` are branch names, None, a non-string, or MISSING (the key is absent)."""
        record = {"number": number, "body": body, "user": {"login": "bot"}, "merged_at": sb.iso(self.world.clock.now() - hours_ago * 3600), "state": "closed",
                  "head": {"ref": head}, "base": {"ref": base, "repo": {"default_branch": default}}}
        if base is self.MISSING:
            record["base"] = {"repo": {"default_branch": default}}
        if default is self.MISSING:   # the record carries no base.repo at all: the default cannot be read
            record["base"].pop("repo")
        self.hub.pulls.setdefault("acme/api", []).append(record)

    def waiting(self):
        return self.engine.triage.current["waiting_for_batch"]

    def batch_cases(self):
        """(case, member base, integration setting, extra batch record or None, T12 expected, waiting expected): one table for S1, S3 to S6 and the batch's own base, head, time and readability."""
        batch = dict(number=900, body="Batch.", base="main", head="stage", hours_ago=1.0)   # merged AFTER the member (1 h ago against 2 h)
        old_batch = dict(batch, hours_ago=3.0)                                              # merged BEFORE the member: not its batch
        return [
            ("merged into the integration branch", "stage", "stage", None, 0, 1),
            ("merged into the default branch", "main", "stage", None, 1, 0),
            ("merged into another branch", "topic", "stage", None, 1, 0),
            ("base key missing", self.MISSING, "stage", None, 1, 0),
            ("base null", None, "stage", None, 1, 0),
            ("base not a string", 7, "stage", None, 1, 0),
            ("base empty string", "", "stage", None, 1, 0),
            ("batch reached the default branch", "stage", "stage", batch, 1, 0),
            ("a batch merged before the member does not count", "stage", "stage", old_batch, 0, 1),
            ("a merged PR from the same head into another base is no batch", "stage", "stage", dict(batch, base="topic"), 0, 1),
            ("a base that contains the branch is not the branch", "stage-2", "stage", None, 1, 0),
            ("a base that contains the branch, as a suffix", "upstage", "stage", None, 1, 0),
            ("a base the branch contains", "sta", "stage", None, 1, 0),
            ("a merged PR from another head into the default branch is no batch", "stage", "stage", dict(batch, head="feature-y"), 0, 1),
            ("a batch from a head that contains the branch is no batch", "stage", "stage", dict(batch, head="stage-2"), 0, 1),
            ("a batch at the same second as the member counts (at or after)", "stage", "stage", dict(batch, hours_ago=2.0), 1, 0),
            ("a batch just before the member does not count", "stage", "stage", dict(batch, hours_ago=2.01), 0, 1),
            ("the batch record has no base.repo: it still counts", "stage", "stage", dict(batch, default=self.MISSING), 1, 0),
            ("no base.repo and a base of the integration branch: no batch", "stage", "stage", dict(batch, base="stage", default=self.MISSING), 0, 1),
            ("no base.repo and no base: a doubt, still waiting", "stage", "stage", dict(batch, base=None, default=self.MISSING), 0, 1),
            ("no base.repo and another head: no batch", "stage", "stage", dict(batch, head="feature-y", default=self.MISSING), 0, 1),
            ("a default that differs from the batch base: no batch", "stage", "stage", dict(batch, base="topic", default="main"), 0, 1),
            ("integration not configured", "stage", None, None, 1, 0),
            ("integration name that matches nothing", "stage", "rollup-x", None, 1, 0),
            ("integration set to a non-string", "stage", 7, None, 1, 0),
            ("integration set to an empty string", "stage", "", None, 1, 0),
            ("an unusual name follows the configuration only", "rollup-x", "rollup-x", None, 0, 1),
        ]

    def test_t12_waits_for_the_batch_by_the_configured_integration_branch_over_every_case(self):
        for label, base, integration, batch, t12, waiting in self.batch_cases():
            with self.subTest(case=label):
                self.setUp()
                self.charter()
                self.add(130, created=60, labels=["kind"])
                self.branch_pr(200, "Part of #130.", base=base, head="feature-x")
                if batch:
                    self.branch_pr(**batch)
                self.go(passes=3, integration_branch=integration)
                self.assertEqual(len(self.only("T12")), t12)
                self.assertEqual(self.waiting(), waiting)
                self.assertEqual((self.only("T1"), self.only("T11")), ([], []))   # as before: an issue with a merged PR is never "no owner"

    def test_t12_the_family_of_rules_that_read_merged_all_stay_quiet_for_a_batch_waiting_issue_and_come_back_with_the_batch(self):
        family = sorted(rule for rule, inputs in sb.TRIAGE_RULE_INPUTS.items() if "merged" in inputs)
        self.assertEqual(family, ["T1", "T11", "T12"])                             # completeness: a new rule that reads merged must join this table
        issue = {"T1": 110, "T11": 111, "T12": 112}
        self.assertEqual(sorted(issue), family)
        for rule in family:
            for state in ("control: no merged record", "waiting for the batch", "the batch reached the default branch"):
                with self.subTest(rule=rule, state=state):
                    self.setUp()
                    self.charter()
                    self.world.add_agent("coder", fleet={"role": "coder", "issue": 111, "repo": "acme/api"})
                    self.engine.discover(self.world.clock.now())
                    self.add(issue[rule], created=60, labels=["kind"], assignees=["bot"] if rule == "T12" else [])
                    if state != "control: no merged record":
                        self.branch_pr(200, "Part of #%d." % issue[rule], base="stage")
                    if state == "the batch reached the default branch":
                        self.branch_pr(900, "Batch.", base="main", head="stage", hours_ago=1.0)
                    self.go(passes=3, integration_branch="stage")
                    fired = "acme/api#%d" % issue[rule] in self.only(rule)
                    if state == "waiting for the batch":
                        self.assertEqual([r for r in family if self.only(r)], [])    # none of T1, T11, T12 fires for it
                        self.assertEqual(self.waiting(), 1)
                    elif state == "control: no merged record":
                        self.assertEqual(self.only("T12"), [])                       # no merged record: T12 cannot fire
                        self.assertEqual(fired, rule != "T12")                       # T1 and T11 fire on their own conditions
                    else:
                        self.assertEqual(fired, rule == "T12")                       # the batch merged: T12 fires for its issue and gives T1 and T11 their usual way
                        self.assertEqual(self.only("T12"), ["acme/api#%d" % issue[rule]])
                        self.assertEqual(self.waiting(), 0)

    def test_t12_a_charter_or_an_ask_is_never_waiting_for_the_batch_and_its_t1_t11_are_not_quieted(self):
        # The pass: a charter and its ask whose part merged into the integration branch are never counted as waiting.
        self.add(1, created=30, updated=10, labels=["x:orchestrator", "kind"], body="## Decision required\nx")
        self.add(2, created=20, updated=10, parent=1, labels=["kind"], body="Next: go")
        self.branch_pr(200, "Part of #1.", base="stage")
        self.branch_pr(201, "Part of #2.", base="stage")
        self.go(passes=3, integration_branch="stage")
        self.assertEqual(self.waiting(), 0)
        # The rule itself (the real function): the quieting of T1 and T11 is for a work item only, never a charter or an ask.
        now = self.world.clock.now()
        for kind in ("charters", "asks", None):
            ctx = {"charters": set(), "asks": set(), "chain": set(), "owned": set(), "unresolved": set()}
            if kind:
                ctx[kind] = {5}
            item = sb.triage_norm(tri_issue(now, 5, created=10, updated=10, labels=["kind"]))
            for waiting in (None, {5}):
                with self.subTest(kind=kind, waiting=bool(waiting)):
                    found, _ = sb.triage_rules(item, [], ctx, sb.triage_sla(self.engine.config["triage"], "acme/api"), now, {"bot"}, [], set(), waiting=waiting)
                    quiet = kind is None and waiting
                    self.assertEqual("T1" in found or "T11" in found, not quiet)

    def test_t12_the_integration_branch_setting_is_known_to_the_loader_and_defaults_to_none(self):
        self.assertIsNone(sb.TRIAGE_DEFAULTS["integration_branch"])
        with mock.patch.object(sb, "warn_unknown_config") as warn:
            sb.validate_triage_config({"triage": {"integration_branch": "stage"}}, "cfg")
            sb.validate_triage_config({"triage": {"integration_branch": None}}, "cfg")
            sb.validate_triage_config({"triage": {}}, "cfg")
        warn.assert_not_called()
        for bad in (7, ["stage"], "", True):
            with self.subTest(bad=bad), self.assertRaises(sb.ConfigError):
                sb.validate_triage_config({"triage": {"integration_branch": bad}}, "cfg")

    def test_t12_nothing_is_written_for_a_waiting_issue_and_the_totals_name_it_apart(self):
