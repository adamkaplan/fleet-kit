    def test_972_the_judge_counts_what_the_block_rule_counts(self):
        module = sb.load_module("delegated_clear")
        block, cells = self.block(), sb.impact_floor.load_matrix()["cells"]
        s, p = self.cell_of("Low")
        good = {"kind": "review_record", "pr": "acme/app#9", "head": LEDGER_HEAD, "reviewer": "impact", "by_role": "reviewer", "impact_severity": s, "impact_probability": p,
                "block_sha256": "a" * 64, "block_impact_severity": s, "block_impact_probability": p, "seq": 1, "by": "x"}
        report = {"pr": "acme/app#9", "head": LEDGER_HEAD}
        for label, other in (("no block", dict(good, block_sha256="none")), ("a block that disagrees", dict(good, block_impact_probability="zzz"))):
            entries = [good, dict(other, seq=2, by="y")]
            got = module.judge(block, cells, entries, report, "Serious", module.RUNS_REQUIRED)
            self.assertEqual(len([e for e in entries if module.counts_by_block(e)]), 1, label)
            self.assertTrue(any("1 counted" in r for r in got["reasons"]), (label, got))
        two = module.judge(block, cells, [good, dict(good, seq=2, by="y", block_sha256="b" * 64)], report, "Serious", module.RUNS_REQUIRED)
        self.assertEqual((two["reasons"], len(two["runs"])), ([], 2))
        self.assertEqual(module.judge(block, cells, [good], report, "Serious")["reasons"], [], "the default asks one run: the pure judge's old contract")

    def test_972_the_rule_is_stated_once_in_the_docs_and_once_in_the_rater_brief_and_the_cause_comes_first(self):
        module = sb.load_module("delegated_clear")
        root = Path(sb.__file__).parent.parent
        docs = (root / "docs" / "switchboard.md").read_text()
        brief = (root / "agents" / "reviewers" / "reviewer-impact.md").read_text()
        self.assertEqual((docs.count(module.TWO_RUN_RULE), brief.count(module.TWO_RUN_RULE)), (1, 1))
        section = docs.split("#### Two independent runs for a clear by score (#972)", 1)[1].split("\n#### ", 1)[0]
        cause, rule = section.split("##### The rule", 1)
        self.assertEqual(cause.count("```text"), 2)
        self.assertIn("cell: Medium", cause)
        self.assertIn("cell: Serious", cause)
        self.assertIn("depends on a draw", cause)
        self.assertIn(module.TWO_RUN_RULE, rule)

    def test_s7_the_floor_is_data_the_clear_module_holds_none_and_the_brief_and_matrix_agree(self):
        matrix = sb.impact_floor.load_matrix()["owner_hold"]
        rules = self.block()["floor"]["rules"]
        self.assertEqual(sorted(rules.values()), sorted(matrix["top_tier_classes"]), "every top tier class has exactly one rule id")
        source = (Path(sb.__file__).parent / "delegated_clear.py").read_text()
        brief = (Path(sb.__file__).parent.parent / "agents" / "reviewers" / "reviewer-impact.md").read_text()
        for rule_id, cls in rules.items():
            self.assertNotIn(rule_id, source, "the clear module holds no rule id")
            self.assertIn(rule_id, brief, "the rater's brief names the rule id")
            self.assertNotIn('"%s"' % cls, source, "the clear module holds no class")
        self.assertNotIn("Serious", source)
        self.assertIn("never rate below Serious", brief)
        for removed in rules:   # one mutant for each rule: with the rule gone from the data, the floor class no longer needs its id and the code reads that from the data only
            block = json.loads(json.dumps(self.block()))
            del block["floor"]["rules"][removed]
            cls = rules[removed]
            report = {"pr": "acme/app#9", "head": LEDGER_HEAD, "top_tier_hits": {cls: ["x"]}}
            entries = [{"kind": "review_record", "pr": "acme/app#9", "head": LEDGER_HEAD, "reviewer": "impact", "by_role": "reviewer", "impact_severity": self.cell_of("Medium")[0], "impact_probability": self.cell_of("Medium")[1],
                        "block_sha256": "a" * 64, "block_impact_severity": self.cell_of("Medium")[0], "block_impact_probability": self.cell_of("Medium")[1]}]
            mod = sb.load_module("delegated_clear")
            self.assertEqual(mod.judge(block, sb.impact_floor.load_matrix()["cells"], entries, report, "Serious")["reasons"], [], "the floor of %s lives in the data only" % cls)
            self.assertTrue(mod.judge(self.block(), sb.impact_floor.load_matrix()["cells"], entries, report, "Serious")["reasons"])

    def test_s8_a_missing_empty_or_malformed_max_level_clears_nothing_and_the_validation_names_the_key(self):
        module = sb.load_module("delegated_clear")
        base = {"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR}
        for bad in (5, "high", "Critical", "High", ["Serious"], "", None, True, "serious "):
            with self.subTest(bad=bad):
                config = {"orders": [dict(self.bound(17), max_level=bad)], "charter": 40}
                with self.assertRaises(ValueError) as caught:
                    module.validate(config, "config")
                self.assertIn("max_level", str(caught.exception))
                with self.assertRaises(sb.ConfigError):
                    sb.validate_config(dict(base, delegated_clear=config))
                self.assertIsNone(module.settings({"delegated_clear": config}), "the delegation clears nothing")
        self.score_config(None)   # no max_level at all: the old rules (this fixture's class rules), never a clear by score
        self.scored_pr()
        self.rate(*self.cell_of("Low"))
        sb.validate_config(dict(base, delegated_clear={"orders": [self.bound(17)], "charter": 40}))
        self.assertEqual(self.deletes(), [])

    def test_s9_a_threshold_in_the_repository_or_the_environment_is_never_read(self):
        self.score_config(None)
        self.scored_pr()
        self.rate(*self.cell_of("Low"))
        with mock.patch.dict(os.environ, {"MAX_LEVEL": "Medium", "FLEET_MAX_LEVEL": "Medium", "DELEGATED_CLEAR_MAX_LEVEL": "Medium"}):
            self.listing_extra = None
            code, out, err = self.under()
        self.assertEqual(self.deletes() != [], code == 0)
        source = (Path(sb.__file__).parent / "impact_hold.py").read_text() + (Path(sb.__file__).parent / "delegated_clear.py").read_text()
        self.assertNotIn("os.environ", source)
        self.assertEqual(len(re.findall(r"max_level", (Path(sb.__file__)).read_text())), 0, "the daemon file never reads or writes a threshold")

    def test_s8b_s14_the_order_must_be_named_exist_and_be_unedited_whatever_the_threshold(self):
        self.score_config("Serious")
        self.scored_pr()
        self.rate(*self.cell_of("Low"))
        self.assertEqual(self.under(order=18)[0], 2)   # not listed
        for label, orders in (("edited", ["order one"] + ["order %d" % n for n in range(2, 17)] + [self.ORDER_TEXT + " also"]),
                              ("inserted before", ["new"] + list(self.orders_of_charter)), ("removed after", list(self.orders_of_charter)[:16]), ("missing", list(self.orders_of_charter)[:5])):
            with self.subTest(label):
                self.orders_of_charter = orders
                code, out, err = self.under()
                self.assertEqual(code, 2)
                self.assertTrue("no longer the one" in err or "does not exist" in err, err)
        self.assertEqual(self.deletes(), [])

    def owner_file(self, lines, text=None):
        path = self.world.state / "owner-orders.md"
        path.write_text(text if text is not None else "\n".join(lines) + "\n")
        return path

    FILE_LINE = "- The Chief of Staff may clear held pull requests in any repository whose rating at the head is Serious or lower, on her own judgement; High stays the owner's."

    def file_config(self, path, line=None):
        sha = sb.load_module("delegated_clear").line_hash(line if line is not None else self.FILE_LINE)
        self.extra_config.update({"cos_orders_file": str(path), "delegated_clear": {"orders": [{"number": 5, "sha256": sha, "source": "owner-file", "max_level": "Serious"}]}})
        self.delegate(config=False)

    def test_s8d_the_owners_file_line_turns_the_key_on_only_when_it_is_there_exactly_once(self):
        cases = {"exact": ("- a\n" + self.FILE_LINE + "\n- b\n", True), "crlf": ("- a\r\n" + self.FILE_LINE + "\r\n", True), "deleted": ("- a\n- b\n", False),
                 "edited by one character": ("- a\n" + self.FILE_LINE.replace("Serious", "Serioux") + "\n", False), "case changed": (self.FILE_LINE.lower() + "\n", False),
                 "duplicated": (self.FILE_LINE + "\n" + self.FILE_LINE + "\n", False), "substring of a longer line": (self.FILE_LINE + " But not on Tuesdays.\n", False),
                 "as a prefix of a longer line": ("see " + self.FILE_LINE + "\n", False), "inside a comment": ("<!--\n" + self.FILE_LINE + "\n-->\n", False)}
        for label, (text, ok) in cases.items():
            with self.subTest(label):
                self.writes.clear()
                path = self.owner_file(None, text)
                self.file_config(path)
                self.scored_pr()
                self.rate(*self.cell_of("Medium"))
                code, out, err = self.under(order=5)
                self.assertEqual(code == 0, ok, err)
                self.assertEqual(bool(self.deletes()), ok)
                self.ledger_reset()
        path = self.world.state / "missing.md"
        self.file_config(path)
        self.scored_pr()
        self.rate(*self.cell_of("Medium"))
        self.assertEqual(self.under(order=5)[0], 2)
        path.write_text("x" * (sb.COS_ORDERS_MAX_BYTES + 1))   # over its size cap: not read in full
        self.assertEqual(self.under(order=5)[0], 2)

    def test_s8e_the_clear_code_never_writes_the_owners_file_and_a_charter_line_is_not_a_file_line(self):
        for name in ("impact_hold.py", "delegated_clear.py"):
            source = (Path(sb.__file__).parent / name).read_text()
            self.assertFalse(re.search(r"cos_orders_path|COS_ORDERS_NAME|write_text|open\([^)]*orders", source), name)
        self.score_config("Serious")   # an entry bound to charter text is read from the charter, never from the owner's file even when a line of it matches
        path = self.owner_file(None, self.ORDER_TEXT + "\n")
        self.extra_config["cos_orders_file"] = str(path)
        self.orders_of_charter = ["x"] * 16 + ["something else"]
        self.scored_pr()
        self.rate(*self.cell_of("Low"))
        self.assertEqual(self.under()[0], 2)

