        self.gh.artifact_name = "failures"
        self.go()
        self.assertEqual(len(self.sent), 1)
        self.assertIn("failures artifact", self.sent[0][1])
        self.engine.config = dict(self.engine.config, queue_ejections=None)
        self.gh.artifact_name = "failing-tests"
        self.add(1202, 302, name="ci", names=["t"])
        self.world.tick(self.module.LIST_SECONDS + 1)
        self.go()
        self.assertEqual(len(self.sent), 2, "the defaults ci and failing-tests")

    def test_the_configuration_key_is_declared_and_validated(self):
        self.assertIn("queue_ejections", sb.config_declarations())
        self.assertIsNone(sb.validate_config({}).get("queue_ejections"))
        self.assertEqual(sb.validate_config({"queue_ejections": {"workflow": "ci"}})["queue_ejections"], {"workflow": "ci"})
        for bad in ("ci", {"workflow": 1}, {"other": "x"}, {"artifact": "../x"}):
            with self.assertRaises(sb.ConfigError, msg=repr(bad)):
                sb.validate_config({"queue_ejections": bad})

    def test_a_read_that_fails_is_said_once_and_after_three_tries_the_line_says_unreadable(self):
        self.add(1301, 401, names=["t"])
