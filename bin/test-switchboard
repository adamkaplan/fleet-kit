    def test_t7_a_review_that_is_not_approving_is_not_a_review(self):
        self.charter()
        for n, text in ((330, "not approved"), (331, "changes requested"), (332, "needs changes"), (333, "approved"), (334, "lgtm")):
            self.add(n, created=0.4, pr=True)
            self.describe_pr(n, comments=[("reviewer", "review of %s: %s %s" % (TRI_HEAD_A[:7], text, TRI_HEAD_A))])
        self.go()
        self.assertEqual(self.only("T7"), ["acme/api#330", "acme/api#331", "acme/api#332"])

    def verdict_prs(self, cases, start):
        """One PR of ours per (state, body) case, each with a formal review from the author's own account ("bot")."""
        for n, (state, body) in enumerate(cases, start):
            self.add(n, created=0.4, pr=True)
            self.describe_pr(n, reviews=[("bot", state, TRI_HEAD_A, body)])
        self.go()
        return ["acme/api#%d" % n for n in range(start, start + len(cases))]

    def test_t7_a_verdict_review_from_the_authors_account_counts_approve_or_changes_requested(self):
        self.charter()
        self.verdict_prs([("COMMENTED", "Review of %s: APPROVE" % TRI_HEAD_A), ("COMMENTED", "Review of %s: CHANGES REQUESTED\nx" % TRI_HEAD_A)], 340)
        self.assertEqual(self.only("T7"), [])

    def test_t7_a_review_that_does_not_name_this_head_or_start_with_the_phrase_is_not_counted(self):
        self.charter()
        refs = self.verdict_prs([("COMMENTED", "Review of %s: APPROVE" % TRI_HEAD_B), ("COMMENTED", "looks fine"),
                                 ("COMMENTED", ""), ("COMMENTED", "see: Review of %s: APPROVE" % TRI_HEAD_A),
                                 ("PENDING", "Review of %s: APPROVE" % TRI_HEAD_A), ("DISMISSED", "Review of %s: APPROVE" % TRI_HEAD_A),
                                 ("COMMENTED", "Review of %s: LGTM" % TRI_HEAD_A)], 350)
        self.assertEqual(self.only("T7"), refs)

    def test_t7_the_sha_is_a_whole_token_of_at_least_seven_characters_of_the_head(self):
        self.charter()
        refs = self.verdict_prs([("COMMENTED", "Review of %s: APPROVE" % TRI_HEAD_A[:7]), ("COMMENTED", "Review of %s: APPROVE" % TRI_HEAD_A[:6]),
                                 ("COMMENTED", "Review of %s: APPROVE" % TRI_HEAD_B[:7]), ("COMMENTED", "Review of %sc: APPROVE" % TRI_HEAD_A[:7])], 360)
        self.assertEqual(self.only("T7"), refs[1:])

    def test_a_verdict_review_from_the_authors_account_is_not_a_review_for_the_gates_the_hold_or_the_captain_evidence(self):
        data = captain_pr(head=TRI_HEAD_A, reviews=[("bot", "COMMENTED", TRI_HEAD_A, "Review of %s: APPROVE" % TRI_HEAD_A)], author="bot")
        data = json.loads(data) if isinstance(data, str) else data
        facts = sb.pr_facts_from(data)
        self.assertTrue(facts["verdict_review"])
        self.assertEqual(sb.pr_reviews_at(data["reviews"], TRI_HEAD_A, "bot"), [])
        self.assertEqual(facts["reviews"], [])
        self.assertEqual(sb.captain_evidence(facts, set()), None if facts["signed"] is None else [])

    def test_t10_waits_ten_minutes_after_the_close(self):
        self.charter()
        fresh = dict(tri_issue(self.now, 101, created=9, labels=[self.USER, "kind"], state="closed"), closed_at=sb.iso(self.now - 240))
        stale = dict(tri_issue(self.now, 102, created=9, labels=[self.USER, "kind"], state="closed"), closed_at=sb.iso(self.now - 1200))
        self.hub.closed["acme/api"] = {self.USER: [fresh, stale]}
        self.go(passes=2)
        self.assertEqual(self.only("T10"), ["acme/api#102"])

    def test_t10_a_close_by_one_of_ours_gets_no_grace_and_one_by_another_or_unnamed_keeps_it(self):
        self.charter()
        cases = {103: {"login": "bot"}, 104: {"login": "someone-else"}, 105: None}   # ours, another's, not named
        issues = []
        for n, closer in cases.items():
            record = dict(tri_issue(self.now, n, created=9, labels=[self.USER, "kind"], state="closed"), closed_at=sb.iso(self.now - 240))
            if closer:
                record["closed_by"] = closer
            issues.append(record)
        self.hub.closed["acme/api"] = {self.USER: issues}
        self.go(passes=2)
        self.assertEqual(self.only("T10"), ["acme/api#103"])
        for record in issues[1:]:   # after the grace the others are findings too
            record["closed_at"] = sb.iso(self.now - 1200)
        self.engine.triage.units.clear()
        self.world.tick(sb.TRIAGE_TTL + 5)
        self.go(passes=2)
        self.assertEqual(self.only("T10"), ["acme/api#103", "acme/api#104", "acme/api#105"])

    def test_t10_a_closed_issue_still_labelled_awaiting_is_immediate(self):
        self.charter()
        closed = tri_issue(self.now, 100, created=9, labels=[self.USER, "kind"], state="closed")
        self.hub.closed["acme/api"] = {self.USER: [closed]}
        self.go()
        self.assertEqual(self.only("T10"), ["acme/api#100"])
        self.hub.closed["acme/api"] = {self.USER: [closed]}
        self.hub.live["acme/api"] = {100: dict(closed, labels=[{"name": "kind"}])}   # the label was removed since the list read
        self.engine.triage.confirmed.clear()
        self.engine.triage.logged.clear()
        self.world.tick(sb.TRIAGE_TTL + 5)
        self.go()
        self.assertTrue([e for e in self.world.audit() if e["event"] == "triage.dismissed"])

    def test_t11_an_orphan_is_flag_only_and_never_with_t1(self):
        self.charter()
        self.add(110, created=60, labels=["kind"])                  # unowned and old: T1 only
        self.go()
        self.assertEqual((self.only("T1"), self.only("T11")), (["acme/api#110"], []))
