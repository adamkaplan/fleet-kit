        self.assertEqual((self.writes, self.events("gate.hold_cleared"), self.cos_texts()), ([], [], []))

    def test_s9_the_switches_are_the_owners_and_a_pass_changes_neither(self):
        self.assertIs(sb.DEFAULTS["v2_light"], False)
        self.assertEqual(sb.chat_clear_config({}), {"enabled": True, "live": False})
