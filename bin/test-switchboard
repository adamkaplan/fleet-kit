            with self.assertRaises(sb.ConfigError, msg=bad):
                sb.validate_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "chat_clear": bad})

    # ---- #977 defect: live=true AND v2_light=true is SHADOW, on every route that could write

    def light_live(self):
        self.live = True
        self.build(live=True, extra={"v2_light": True})
        self.assertTrue(self.engine.light)
        self.assertEqual(sb.chat_clear_live_now(self.engine), (False, "v2_light"))

    def assert_all_shadow(self):
        self.assertEqual(self.writes, [], "no label, no comment")
        self.assertEqual(self.cos_texts(), [], "nothing sent")
        self.assertEqual(self.events("gate.hold_cleared"), [])
        self.assertEqual(self.events("chat_clear.failed"), [])
        verdicts = self.events("chat_clear.verdict")
        self.assertTrue(verdicts)
        self.assertTrue(all(v["detail"]["live"] is False and "v2_light" in (v["detail"]["shadow"] or "") for v in verdicts), verdicts)
        self.assertIn("v2_light", self.events("chat_clear.mode")[-1]["detail"]["why"])

    def test_light_live_route_clear_core_comment_and_confirmation_write_nothing(self):
        self.light_live()
        self.shown_then_say("9 is good to go")
        self.assertEqual(self.events("chat_clear.verdict")[-1]["detail"]["action"], "clear", "the judge would clear: only the switch stops it")
        self.assert_all_shadow()

    def test_light_live_route_the_question_to_the_chief_of_staff_and_the_shown_offer_write_nothing(self):
        self.light_live()
        self.hook()
        offers = sb.load_module("chat_clear").read_offers(self.world.state)
        self.say("9 is good to go")
        self.hook(self.decisions(head=self.H2))   # the head moved: the live answer would be a question
        self.assertEqual(self.events("chat_clear.verdict")[-1]["detail"]["action"], "ask")
        self.assert_all_shadow()
        self.assertEqual(sb.load_module("chat_clear").read_offers(self.world.state)[self.PR]["head"], offers[self.PR]["head"], "nothing was shown to him: the offer's shown head is kept")

    def test_light_live_every_route_that_can_write_is_behind_the_one_live_decision(self):
        import ast
        tree = ast.parse(Path(sb.__file__).read_text())
        fns = {n.name: n for n in ast.walk(tree) if isinstance(n, ast.FunctionDef)}
        derived = set()
        for name in ("_chat_clear_act", "chat_clear_apply"):
            for c in ast.walk(fns[name]):
                if isinstance(c, ast.Call) and any(isinstance(x, ast.Name) and x.id in ("engine", "runner") for x in ast.walk(c)):   # every call that is handed the engine or the gh runner: a route to the world
                    derived.add(ast.unparse(c.func))
        cases = {"chat_clear_apply": "test_light_live_route_clear_core_comment_and_confirmation_write_nothing", "impact_clear_core": "test_light_live_route_clear_core_comment_and_confirmation_write_nothing",
                 "comment_as": "test_light_live_route_clear_core_comment_and_confirmation_write_nothing", "engine.send": "test_light_live_route_the_question_to_the_chief_of_staff_and_the_shown_offer_write_nothing",
                 "cc.show": "test_light_live_route_the_question_to_the_chief_of_staff_and_the_shown_offer_write_nothing",
                 "engine.audit.append": "assert_all_shadow (the audit is the shadow's own record)", "read_pr_json": "a read: only reached after the live check", "label_names": "a read of the config", "getattr": "a read of the runner"}
        self.assertEqual(derived, set(cases), "a new call that reaches the world has no case: write its test and add its row here")
        for case in cases.values():
            if case.startswith("test_"):
                self.assertTrue(hasattr(type(self), case), case)

    # ---- #977: the one allowed session read under v2_light

    FIXTURE = Path(__file__).resolve().parent.parent / "scenarios" / "chat-clear" / "owner-prompt-records.json"

    def light(self, **extra):
        self.build(extra=dict({"v2_light": True}, **extra))
        self.assertTrue(self.engine.light)

    def run_pass_only(self, decisions=None):
        """Only the chat clear's own pass (the discovery is done): returns the calls it made."""
        self.engine.discover(self.world.clock.now())
        sb.decisions_from_notices(self.engine, self.world.clock.now())
        mark = len(self.world.v2.calls)
        sb.chat_clear_pass(self.engine, self.decisions() if decisions is None else decisions, self.world.clock.now())
        return [c for c in self.world.v2.calls[mark:] if len(c) > 2 and c[1] == "api"]

    def test_s1_under_v2_light_the_pass_reads_the_chief_of_staffs_session_once_and_judges_both_new_messages(self):
        self.light()
        self.hook()                                  # the offer is recorded
        self.say("9 is good to go")
        self.say("9 is fine, go ahead")
        calls = self.run_pass_only()
        reads = [c for c in calls if c[2] == "session.message.list"]
        self.assertEqual(len(reads), 1, calls)
        self.assertIn("sessionID=" + self.world.sessions["cos"], reads[0])
        self.assertEqual(len(self.events("chat_clear.verdict")), 2)
        read = self.events("chat_clear.read")[-1]   # one line per change: the empty page first, then the two
        self.assertEqual((read["detail"]["records"], read["detail"]["light"]), (2, True), "the cost line the body promises: records and bytes")
        self.assertGreater(read["detail"]["bytes"], 0)

    def test_s2_under_v2_light_no_other_session_and_no_inbox_compaction_or_list_call_is_made(self):
        self.light()
        self.hook()
        self.say("9 is good to go")
        self.world.v2.start_turn(self.world.sessions["coder"], "a prompt in another session", fleet=False)
        calls = self.run_pass_only()
        other = [c for c in calls if c[2] != "session.message.list" or "sessionID=" + self.world.sessions["cos"] not in c]
        self.assertEqual(other, [], "nothing but the one read of the Chief of Staff's session: %s" % other)
        (read,) = calls
        self.assertIn("type=user", read)
        self.assertIn("limit=%d" % sb.CHAT_CLEAR_LIGHT_LIMIT, read)

    def test_s3_only_the_unseen_messages_are_judged_and_without_an_offer_nothing_is_read(self):
        self.light()
        self.say("9 is good to go")
        self.assertEqual(self.run_pass_only(decisions=[]), [], "no offer: no read of his messages")
        self.hook()
        self.say("9 is fine")
        self.hook()
        self.assertEqual(len(self.events("chat_clear.verdict")), 2)
        before = len(self.events("chat_clear.verdict"))
        self.hook()
        self.assertEqual(len(self.events("chat_clear.verdict")), before, "a message already seen is not judged again")

    def test_s4_a_page_over_the_bound_is_read_for_nothing_and_the_audit_says_why(self):
        self.light()
        self.hook()
        self.say("9 is good to go")
        with mock.patch.object(sb, "CHAT_CLEAR_LIGHT_BYTES", 100):
            self.hook()
        self.assertEqual(self.events("chat_clear.verdict"), [])
        (refused,) = self.events("chat_clear.read_refused")
        self.assertIn("over the bound of 100", refused["detail"]["why"])
        self.assertEqual(self.cc_seen(), {}, "nothing was marked seen: the message waits")
        self.hook()
        self.assertEqual(len(self.events("chat_clear.verdict")), 1, "within the bound again: judged")

    def cc_seen(self):
        return sb.load_module("chat_clear").read_seen(self.world.state)

    def test_s4b_a_failed_read_is_audited_and_judges_nothing(self):
        self.light()
        self.hook()
        self.say("9 is good to go")
        with mock.patch.object(self.engine.v2, "message_list", side_effect=sb.V2Error("timeout", None, "slow")):
            self.hook()
            self.hook()   # the same fault again: said once, not once per pass
        self.assertEqual((self.events("chat_clear.verdict"), len(self.events("chat_clear.read_refused"))), ([], 1))
        self.assertIn("the read failed", self.events("chat_clear.read_refused")[0]["detail"]["why"])

        self.assertEqual(self.cc_seen(), {})

    def test_s4c_a_reply_that_is_not_a_list_judges_nothing_and_marks_nothing_seen(self):
        self.light()
        self.hook()
        self.say("9 is good to go")
        with mock.patch.object(self.engine.v2, "message_list", return_value=None):
            self.hook()
        self.assertEqual(self.events("chat_clear.verdict"), [])
        self.assertEqual(self.cc_seen(), {})

    def fixture(self):
        return json.loads(self.FIXTURE.read_text())

    def test_s6_the_real_record_shape_is_still_read_as_the_persons_and_the_fleets_are_not(self):
        data, cc = self.fixture(), sb.load_module("chat_clear")
        self.assertEqual(len(data["person"]), 3)
        for record in data["person"]:
            self.assertEqual(cc.persons_text(record), record["text"], "the extraction no longer matches the recorded shape")
        for record in data["fleet"]:
            self.assertIsNone(cc.persons_text(record))
        self.assertEqual(sorted(data["person"][0]), ["agents", "files", "id", "text", "time", "type"], "the recorded key set")

    def test_s6b_the_recorded_shape_goes_through_the_real_pass_and_is_judged(self):
        self.light()
        self.hook()
        now_ms = self.world.clock.ms(self.world.clock.now())
        for n, record in enumerate(self.fixture()["person"] + self.fixture()["fleet"]):
            record = dict(record, time={"created": now_ms - 1000 * (10 - n)}, sessionID=self.world.sessions["cos"])
            self.world.v2.sessions[self.world.sessions["cos"]]["messages"].append(record)
        kept = sb.chat_clear_prompts(self.engine, self.world.sessions["cos"], self.world.clock.now())
        self.assertEqual(sorted(m["id"] for m in kept), ["msg_fixture01", "msg_fixture02", "msg_fixture03"], "the fleet's own records are dropped at the read itself")
        self.hook()
        ids = sorted(e["detail"]["message_id"] for e in self.events("chat_clear.verdict"))
        self.assertEqual(ids, ["msg_fixture01", "msg_fixture02", "msg_fixture03"], "the three person records, never the two the fleet wrote")

    def test_s7_the_fixture_holds_no_message_text_but_the_filler(self):
