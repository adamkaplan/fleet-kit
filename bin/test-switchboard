    def test_a_failed_write_is_retried_later_not_marked_done(self):
        base = self.route
        fail = {"on": True}

        def flaky(argv, **kw):
            if fail["on"] and argv[0] == FAKE_GH and "--method" in argv and argv[argv.index("--method") + 1] == "POST":
                return subprocess.CompletedProcess(argv, 1, "", "HTTP 502")
            return base(argv, **kw)
        self.route = flaky
        self.passes()
        self.assertEqual(self.label_writes(), [])
        self.assertTrue(self.events("impact.error"))
        fail["on"] = False
        self.passes(advance=sb.IMPACT_RETRY_SECONDS + 1)
        self.assertEqual(len(self.label_writes()), 1)

    def clear_engine(self):
        engine = self.world.new_engine("cli")
        engine.config, engine.state_dir, engine.gh_runner = sb.load_config(), self.world.state, self.route
        return engine

    def test_an_owner_clear_cannot_interleave_with_the_daemons_write_and_is_never_lost(self):
        refused = []
        base = self.route

        def watching(argv, **kw):
            if argv[0] == FAKE_GH and "--method" in argv and argv[argv.index("--method") + 1] == "POST" and argv[2].endswith("/labels"):
                with mock.patch.object(sb, "IMPACT_LOCK_SECONDS", 0):     # the owner's clear arrives while the daemon holds the lock
                    try:
                        sb.impact_clear_core(self.clear_engine(), self.route, "acme/app", 9, "the owner", "a false hold: the file is a fixture")
                    except sb.ImpactStateBusy as err:
                        refused.append(str(err))
            return base(argv, **kw)
        self.route = watching
        self.passes()
        self.assertEqual(len(refused), 1)
        self.assertIn("locked", refused[0])
        self.assertEqual(sb.read_impact_state(self.world.state)[0]["clears"], {}, "the interleaved clear recorded nothing: it cannot be half done")
        sb.impact_clear_core(self.clear_engine(), self.route, "acme/app", 9, "the owner", "a false hold: the file is a fixture")   # lock free now
        state, problem = sb.read_impact_state(self.world.state)
        self.assertIsNone(problem)
        self.assertEqual(state["clears"]["acme/app#9"]["head"], LEDGER_HEAD)
        self.assertNotIn("acme/app#9", state["applied"], "the daemon's record is consumed with the clear (in the same write): the clear is recorded and no stale claim stays")
        before = len(self.label_writes())
        self.passes(advance=sb.IMPACT_RETRY_SECONDS + 1000)
        self.assertEqual(len(self.label_writes()), before, "a cleared hold is not re-added")

    def test_a_write_that_cannot_take_the_lock_is_retried_later_never_done_unlocked(self):
        with sb.impact_state_lock(self.world.state):
            with mock.patch.object(sb, "IMPACT_LOCK_SECONDS", 0):
                self.passes()
        self.assertEqual(self.writes, [])
        self.assertTrue([e for e in self.events("impact.error") if "locked" in e["detail"]["error"]])
        self.passes(advance=sb.IMPACT_RETRY_SECONDS + 1)
        self.assertEqual(len(self.label_writes()), 1)

    def test_the_clear_command_says_one_line_when_the_lock_is_held_and_changes_nothing(self):
        self.passes()
        before = list(self.writes)
        with sb.impact_state_lock(self.world.state), mock.patch.object(sb, "IMPACT_LOCK_SECONDS", 0):
            code, out, err = self.run_as(None, "impact", "clear", self.PR, "--reason", "a false hold: the file is a fixture")
        self.assertEqual(code, 1)
        self.assertIn("locked by another process", err)
        self.assertIn("try again", err)
        self.assertNotIn("Traceback", err)
        self.assertEqual((self.writes, sb.read_impact_state(self.world.state)[0]["clears"]), (before, {}))

    def test_a_clear_is_logged_inside_the_lock_and_refused_with_no_audit_sink(self):
        self.passes()
        engine = self.clear_engine()
        seen = []
        real = engine.audit.append

        def checking(*a, **k):
            if a[1] == "gate.hold_cleared":
                with mock.patch.object(sb, "IMPACT_LOCK_SECONDS", 0):
                    try:
                        with sb.impact_state_lock(self.world.state):
                            seen.append("lock was free")
                    except RuntimeError:
                        seen.append("lock held")
            return real(*a, **k)
        engine.audit.append = checking
        sb.impact_clear_core(engine, self.route, "acme/app", 9, "the owner", "a false hold: the file is a fixture")
        self.assertEqual(seen, ["lock held"])
        silent = self.clear_engine()
        silent.audit = None
        writes = list(self.writes)
        with self.assertRaises(RuntimeError) as caught:
            sb.impact_clear_core(silent, self.route, "acme/app", 9, "the owner", "a false hold: the file is a fixture")
        self.assertIn("no audit sink", str(caught.exception))
        self.assertEqual(self.writes, writes, "refused before anything changed")

    def test_a_ledger_that_cannot_be_read_fails_toward_hold_and_says_so(self):
        self.floor_pr(path="src/app.py")                       # a clean floor: only the unknown rating can hold it
        (self.world.state / "plan-ledger.jsonl").write_text("this is not a ledger\n")
        self.passes()
        (write,) = self.label_writes()
        self.assertEqual(len(write[2]["labels"]), 2)
        self.assertIn("independent rating is unknown", " ".join(self.events("gate.hold_applied")[0]["detail"]["reasons"]))
        (event,) = self.events("impact.ledger_unreadable")
        self.assertEqual(event["detail"]["fails"], "toward hold")
        hold, why = sb.impact_review_hold(self.world.state, self.PR, LEDGER_HEAD)
        self.assertEqual((hold, bool(why)), (True, True))

    def test_the_owner_clear_still_works_while_the_ledger_is_down_and_the_cleared_head_stays_cleared(self):
        self.floor_pr(path="src/app.py")
        (self.world.state / "plan-ledger.jsonl").write_text("this is not a ledger\n")
        self.passes()                                                      # held only because the rating is unknown
        self.assertEqual(len(self.label_writes()), 1)
        code, out, err = self.run_as(None, "impact", "clear", self.PR, "--reason", "a false hold: the ledger is down, the change is a fixture")
        self.assertEqual(code, 0, err)
        self.assertEqual(len([w for w in self.writes if w[0] == "DELETE"]), 2)
        self.assertEqual(len(self.events("gate.hold_cleared")), 1)
        self.passes(advance=sb.IMPACT_RETRY_SECONDS + 1000)
        self.passes(records=[self.listed()], advance=4000)
        self.assertEqual(len(self.label_writes()), 1, "still down, same head: not re-added")
        self.floor_pr(path="src/app.py", head=LEDGER_NEW_HEAD)
        self.passes(records=[self.listed(head=LEDGER_NEW_HEAD)], advance=9000)
        self.assertEqual(len(self.label_writes()), 2, "a new head is judged again, and the unknown rating holds it")

    def test_a_corrupt_oversized_or_non_object_state_file_is_reported_and_quarantined_never_overwritten(self):
        path = self.world.state / sb.IMPACT_STATE_FILE
        self.assertEqual(sb.read_impact_state(self.world.state)[1], None)                  # missing is fine
        for text, word in (("{not json", "not valid JSON"), ("[1, 2]", "not an object"), ("x" * (sb.IMPACT_STATE_MAX_BYTES + 5), "over")):
            path.write_text(text)
            state, problem = sb.read_impact_state(self.world.state)
            self.assertEqual(state, {"clears": {}, "applied": {}})
            self.assertIn(word, problem)
        path.write_text("{not json, with another PR's clear in it")
        self.passes()                                          # fails toward hold, the bad file is set aside, and the problem is audited
        self.assertEqual(len(self.label_writes()), 1)
        (event,) = self.events("impact.state_unreadable")
        aside = self.world.state / event["detail"]["quarantined"]
        self.assertTrue(aside.name.startswith(sb.IMPACT_STATE_FILE + ".corrupt-"))
        self.assertEqual(aside.read_text(), "{not json, with another PR's clear in it", "the original is kept, not overwritten")
        state, problem = sb.read_impact_state(self.world.state)
        self.assertIsNone(problem)
        self.assertIn("acme/app#9", state["applied"], "and a fresh, valid state file was written")

    def test_a_second_corruption_never_replaces_an_earlier_quarantined_copy_and_a_failed_rename_writes_nothing(self):
        path = self.world.state / sb.IMPACT_STATE_FILE
        asides = []
        for text in ("{first bad", "{second bad"):
            path.write_text(text)
            engine = self.clear_engine()
            with sb.impact_state_lock(self.world.state):
                sb._impact_state_noted(engine, "bad")
            asides = sorted(self.world.state.glob(sb.IMPACT_STATE_FILE + ".corrupt-*"))
        self.assertEqual(sorted(a.read_text() for a in asides), ["{first bad", "{second bad"], "both kept, same second or not")
        path.write_text("{third bad")
        with mock.patch.object(os, "rename", side_effect=OSError(13, "Permission denied")):
            with self.assertRaises(RuntimeError) as caught, sb.impact_state_lock(self.world.state):
                sb._impact_state_noted(self.clear_engine(), "bad")
        self.assertIn("could not be set aside", str(caught.exception))
        self.assertEqual(path.read_text(), "{third bad", "the corrupt file is untouched when it cannot be set aside")
        (event,) = [e for e in self.events("impact.state_unreadable") if e["detail"].get("quarantine_failed")]
        self.assertIn("Permission denied", event["detail"]["quarantine_failed"])

    def test_every_kind_of_bad_state_file_goes_through_a_pass_and_a_bad_budget_is_refused(self):
        path = self.world.state / sb.IMPACT_STATE_FILE
        for text in ("[1, 2]", "x" * (sb.IMPACT_STATE_MAX_BYTES + 5)):
            path.write_text(text)
            self.passes()
            self.assertEqual(len(list(self.world.state.glob(sb.IMPACT_STATE_FILE + ".corrupt-*"))) >= 1, True)
            for aside in self.world.state.glob(sb.IMPACT_STATE_FILE + ".corrupt-*"):
                aside.unlink()
            path.unlink(missing_ok=True)
            del self.engine_cached
        base = {"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR}
        for bad in (-1, True, "3", 1.5):
            with self.subTest(bad=bad), self.assertRaises(sb.ConfigError):
                sb.validate_config(dict(base, impact_hold={"enabled": True, "calls_per_pass": bad}))

    def test_a_missing_ledger_file_is_no_hold_not_unreadable(self):
        """A regression guard: the read of a missing ledger is an empty ledger, so a clean floor is never held by the unknown-rating rule."""
        self.floor_pr(path="src/app.py")
        (self.world.state / "plan-ledger.jsonl").unlink(missing_ok=True)
        (self.world.state / "plan-ledger.head").unlink(missing_ok=True)
        self.assertEqual(sb.impact_review_hold(self.world.state, self.PR, LEDGER_HEAD), (False, None))
        self.passes()
        self.assertEqual(self.writes, [])
        self.assertEqual(self.events("impact.ledger_unreadable"), [])

    def test_impact_hold_calls_per_pass_is_accepted_and_bounds_the_pass(self):
        base = {"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR}
        sb.validate_config(dict(base, impact_hold={"enabled": True, "calls_per_pass": 3}))
        self.hold_config = {"enabled": True, "calls_per_pass": 0}
        self.reconfigure()
        self.passes()
        self.assertEqual(self.writes, [], "a budget of 0 reads and writes nothing")
        self.hold_config = {"enabled": True, "calls_per_pass": 30}
        self.reconfigure()
        self.passes(advance=sb.IMPACT_RETRY_SECONDS + 1)
        self.assertEqual(len(self.label_writes()), 1)

    def test_control_characters_in_the_clear_reason_never_reach_the_record_or_the_log(self):
        self.passes()
        code, out, err = self.run_as(None, "impact", "clear", self.PR, "--reason", "a false hold\x1b[31m: the\nfile\x07 is a fixture")
        self.assertEqual(code, 0, err)
        recorded = sb.read_impact_state(self.world.state)[0]["clears"]["acme/app#9"]["reason"]
        self.assertEqual(recorded, "a false hold [31m: the file is a fixture")
        self.assertEqual(self.events("gate.hold_cleared")[0]["detail"]["reason"], "a false hold [31m: the file is a fixture")
        self.assertNotIn("\x1b", self.events("gate.hold_cleared")[0]["detail"]["reason"])

    def test_the_hold_config_is_validated_and_the_label_is_in_the_held_set(self):
        base = {"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR}
        for bad in ({"enabled": "yes"}, {"dry_run": 1}, {"when": 1}, {"repos": {"acme/app": {"enabled": "no"}}}, {"calls_per_pass": -1}, []):
            with self.subTest(bad=bad), self.assertRaises(sb.ConfigError):
                sb.validate_config(dict(base, impact_hold=bad))
        sb.validate_config(dict(base, impact_hold={"enabled": True, "dry_run": False, "repos": {"acme/app": {"enabled": False}}}))
        self.assertIn("hold-impact", sb.CAPTAIN_HOLD_LABELS)
        self.assertIn("hold-impact", [k for k, _, _ in sb.LABEL_SPECS])


    # ---- #661: the Chief of Staff's clear under the owner's standing order

    ORDER_TEXT = "The Chief of Staff may clear held pull requests whose review confirms no change to credentials, identity or permissions, and tell the owner after."

    def bound(self, number, text=None):
        return {"number": number, "sha256": sb.load_module("delegated_clear").order_hash(text if text is not None else (self.ORDER_TEXT if number == 17 else "order %d" % number))}

    def delegate(self, orders=(17,), charter=40, config=True, orders_of_charter=None):
        if config:
            self.extra_config["delegated_clear"] = {"orders": [self.bound(n) for n in orders], "charter": charter}
        self.configure()
        self.world.add_agent("cos", fleet={"role": "chief-of-staff"}) if "cos" not in self.world.sessions else None
        self.review = (("none", None), None)   # an independent review is recorded at this head (no hold, no class); a test overrides it
        patcher = mock.patch.object(sb, "impact_review_record", lambda state, pr, head: self.review)
        patcher.start()
        self.addCleanup(patcher.stop)
        self.orders_of_charter = orders_of_charter or (["order one"] + ["order %d" % n for n in range(2, 17)] + [self.ORDER_TEXT])
        for target, value in (("fetch_orders", lambda reader, charter, repo: self.orders_of_charter), ("_intent_reader", lambda runner, now: object())):
            patcher = mock.patch.object(sb, target, value)
            patcher.start()
            self.addCleanup(patcher.stop)

    def files_of_pr(self, *paths, patch="@@ -1 +1 @@\n-a\n+b", status="modified", mapped=None):
        self.mapped = [] if mapped is None else mapped
        patcher = mock.patch.object(sb, "delegated_clear_map", lambda engine, runner, repo, item, base_sha, rule: (self.map_bases.append(base_sha), self.mapped)[1])
        self.map_bases = []
        patcher.start()
        self.addCleanup(patcher.stop)
        listing = [{"filename": p, "patch": patch, "status": status, "sha": "e" * 40} for p in paths]
        patcher = mock.patch.object(sb, "impact_carry_get", lambda engine, runner, repo: (lambda path: (listing if "page=1" in path else []) if "/files" in path else {"merge_base_commit": {"sha": "m" * 40}} if "/compare/" in path else {"head": {"sha": self.pr["headRefOid"]}, "base": {"sha": "b" * 40}}))
        patcher.start()
        self.addCleanup(patcher.stop)

    TWIN = True
    twin_runs = None

    def under(self, who="cos", order=17, reason="the review confirms nothing touches credentials nor identity"):
        if self.twin_runs and reason in ("the review confirms nothing touches credentials nor identity", "the review is clean and the change is a note"):   # #972: the judgement names the runs of the fixture
            reason += ": %s" % ", ".join("#%d=%s" % (seq, level) for seq, _, level in self.twin_runs)
        return self.run_as(who, "impact", "clear", self.PR, "--under-order", str(order), "--reason", reason)

    def test_s1_the_chief_of_staff_clears_under_a_listed_order_and_it_is_recorded_as_her_act_under_that_order(self):
        self.delegate()
        self.floor_pr(path="migrations/0002.sql")   # an authority path (the fixture's top tier path), no credentials, no identity
        self.files_of_pr("migrations/0002.sql")
        self.passes()
        code, out, err = self.under()
        self.assertEqual(code, 0, err)
        deletes = sorted(w[1].rsplit("/", 1)[1] for w in self.writes if w[0] == "DELETE")
        self.assertTrue(deletes, "the same labels are removed")
        (cleared,) = self.events("gate.hold_cleared")
        detail = cleared["detail"]
        self.assertEqual((detail["by"], detail["under_order"], detail["head"], detail["via"]), ("cos", 17, LEDGER_HEAD, "order:17"))
        self.assertIn("may clear held pull requests", detail["order"])
        self.assertIn("nothing touches credentials", detail["reason"])
        self.assertNotEqual(detail["by"], "owner")

    def test_the_modules_the_clear_loads_or_runs_are_all_judged_and_the_list_is_derived_from_what_runs(self):
        import sys, os, ast
        rule = sb.impact_floor.load_matrix()["owner_hold"]["delegated_clear"]
        roots = rule["module_roots"]
        self.delegate(); self.floor_pr(path="migrations/0002.sql"); self.files_of_pr("migrations/0002.sql"); self.passes()
        seen = set()
        def prof(frame, event, arg):
            if event == "call" and os.path.dirname(frame.f_code.co_filename) == str(BIN) and not frame.f_code.co_name.startswith("<"):
                seen.add(("bin/" + os.path.basename(frame.f_code.co_filename), frame.f_code.co_name))
        sys.setprofile(prof)
        try:
            code, out, err = self.under()
        finally:
            sys.setprofile(None)
        self.assertEqual(code, 0, err)
        matches = sb.impact_floor.matches
        missing = sorted("%s:%s" % (f, n) for f, n in seen if f.endswith(".py") and not matches(f, rule["clear_code_paths"]) and n not in (roots.get(f) or []))
        self.assertEqual(missing, [], "a function the real clear ran in a module that is not refused whole is not in module_roots")
        self.assertTrue(seen, "the profile saw the clear run")
        # every module's config readers run at config load (a key set or not): its validate and settings are roots
        for path in sorted(BIN.glob("*.py")):
            tree = ast.parse(path.read_text())
            readers = [n.name for n in tree.body if isinstance(n, ast.FunctionDef) and n.name in ("validate", "settings")]
            if readers and not matches("bin/" + path.name, rule["clear_code_paths"]):
                self.assertTrue(set(readers) <= set(roots.get("bin/" + path.name) or []), "%s has a config reader (%s) that is not a root" % (path.name, readers))
        # the modules the clear loads or runs, DERIVED: every loader of the daemon (a `load_module("x")` call, a name in HELPER_MODULES, a function that returns one) is enumerated by ast; a module
        # is judged when the clear reaches its loader, the daemon loads it at import, it has a config reader, or the recorded run executed it; every other loaded module is listed with its reason
        daemon, hold = ast.parse((BIN / "fleet-switchboard").read_text()), ast.parse((BIN / "impact_hold.py").read_text())
        names = {p.stem for p in BIN.glob("*.py")}
        helper = next(ast.literal_eval(n.value) for n in daemon.body if isinstance(n, ast.Assign) and any(getattr(t, "id", "") == "HELPER_MODULES" for t in n.targets))
        defs = {n.name: n for n in daemon.body if isinstance(n, (ast.FunctionDef, ast.ClassDef))}
        direct = lambda node: {x.args[0].value for x in ast.walk(node) if isinstance(x, ast.Call) and getattr(x.func, "id", "") == "load_module" and x.args and isinstance(x.args[0], ast.Constant)}
        loaders = {name: direct(node) for name, node in defs.items() if direct(node)}
        def modules_of(node):
            found = direct(node)
            for x in ast.walk(node):
                if isinstance(x, ast.Name):
                    found |= ({helper[x.id]} if x.id in helper else set()) | loaders.get(x.id, set())
            return found
        clear_functions = [n for n in hold.body if isinstance(n, ast.FunctionDef)]
        wanted_roots = sorted({x.id for f in clear_functions for x in ast.walk(f) if isinstance(x, ast.Name)} & set(sb.load_module("delegated_clear")._index(daemon)[0]) | {x.id for f in clear_functions for x in ast.walk(f) if isinstance(x, ast.Name)} & set(sb.load_module("delegated_clear")._index(daemon)[1]))
        self.assertEqual(sorted(rule["closure_roots"]), sorted(set(wanted_roots) | {"HELPER_MODULES", "_make_loader"}), "closure_roots is every daemon name the moved clear code reads (bin/impact_hold.py), and the table that generates the daemon's loaders")
        reach = sb.load_module("delegated_clear").closure(daemon, rule["closure_roots"])[0]
        reached = set()
        for name in reach:
            reached |= modules_of(defs[name])
        for f in clear_functions:
            reached |= modules_of(f)
        at_load = set()
        for node in daemon.body:
            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
                continue
            for x in ast.walk(node):
                if isinstance(x, ast.Import):
                    at_load |= {a.name for a in x.names}
                elif isinstance(x, ast.ImportFrom) and x.module:
                    at_load.add(x.module)
                elif isinstance(x, ast.Call):
                    f = getattr(x.func, "id", "")
                    if f == "load_module" and x.args and isinstance(x.args[0], ast.Constant):
                        at_load.add(x.args[0].value)
                    at_load |= ({helper[f]} if f in helper else set()) | loaders.get(f, set())
        with_reader = {p.stem for p in BIN.glob("*.py") if any(isinstance(n, ast.FunctionDef) and n.name in ("validate", "settings") for n in ast.parse(p.read_text()).body)}
        profiled = {f[len("bin/"):-3] for f, _ in seen if f.endswith(".py")}
        named = lambda m: matches("bin/%s.py" % m, rule["clear_code_paths"])
        judged = {m for m in (reached | at_load | with_reader | profiled) if m in names and not named(m)}
        listed = {f[len("bin/"):-3] for f in rule["closure_files"] if f.endswith(".py")}
        self.assertEqual(sorted(judged ^ listed), [], "closure_files is the set of modules the clear loads or runs, derived (a module in one and not the other)")
        every_loaded = {m for m in (set(helper.values()) | set().union(*loaders.values()) | set().union(*[direct(f) for f in clear_functions])) if m in names and not named(m)}
        exempt = {"bin/%s.py" % m for m in every_loaded - judged}
        self.assertEqual(sorted(exempt), sorted(rule["closure_exempt"]), "every loaded module is judged or listed, with its reason, as one the clear cannot reach")
        self.assertTrue(all(isinstance(why, str) and len(why) > 20 for why in rule["closure_exempt"].values()))
        for module_name in reached & names:   # a module whose loader the clear reaches must say which of its functions run
            if not named(module_name):
                self.assertIn("bin/%s.py" % module_name, roots, "%s is loaded by the clear's own code: its roots are named (`*` for every function)" % module_name)
        for dropped in ("agent_presence", "ci_runs"):
            self.assertIn("bin/%s.py" % dropped, rule["closure_files"])
        self.assertNotIn("bin/lanes.py", rule["closure_files"])
        import collections, difflib
        counts = collections.Counter(n.name for n in hold.body if isinstance(n, ast.FunctionDef))
        self.assertEqual([k for k, v in counts.items() if v > 1], [], "each function of the moved clear code is defined once (a later copy would silently replace the first)")
        for pinned in ("impact_carry_get", "fetch_orders", "read_pr_json", "HELPER_MODULES", "_make_loader"):
            self.assertIn(pinned, rule["closure_roots"])
        table = (BIN / "fleet-switchboard").read_text().split("\n")
        k = next(i for i, l in enumerate(table) if l.strip().startswith('"load_agent_presence":'))
        mutated = list(table)
        mutated[k] = mutated[k].replace('"agent_presence"', '"lanes"')
        diff = "\n".join(list(difflib.unified_diff(table, mutated, lineterm="", n=1))[2:])
        self.assertTrue(sb.load_module("delegated_clear").closure_refusals("\n".join(table), "\n".join(mutated), diff, rule["closure_roots"], set(rule["clear_entry_points"])), "a HELPER_MODULES value changed")
        self.assertTrue(rule["closure_files"] and "bin/lanes.py" not in rule["closure_files"], "lanes.py is not judged, so the same edit to it is not refused")
        # the way in a strict review found: the notice path runs agent_presence through a generated loader; a change to it is refused, and to a module the clear does not load it is not
        import difflib
        presence = (BIN / "agent_presence.py").read_text().split("\n")
        k = next(i for i, l in enumerate(presence) if l.startswith("def ") and i + 1 < len(presence))
        j = next(i for i in range(k, len(presence)) if presence[i].rstrip().endswith(":") and not presence[i].startswith("def ") or presence[i].startswith("    ") and i > k)
        edited = list(presence)
        edited[j] = edited[j] + "  # touched"
        diff = "\n".join(list(difflib.unified_diff(presence, edited, lineterm="", n=1))[2:])
        self.assertTrue(sb.load_module("delegated_clear").closure_refusals("\n".join(presence), "\n".join(edited), diff, rule["module_roots"]["bin/agent_presence.py"], set(), True), "a change to agent_presence.py is refused")
        self.assertIn("one_line", roots["bin/decision_core.py"])
        # a module is judged on its import-time code too, and a function the clear does not run stays allowed
        module = sb.load_module("delegated_clear")
        import difflib
        def judge(base, head, roots_of):
            diff = "\n".join(list(difflib.unified_diff(base.split("\n"), head.split("\n"), lineterm="", n=1))[2:])
            return module.closure_refusals(base, head, diff, roots_of, set(), True)
        mod = "import os\nLIMIT = 3\n\ndef one_line(x):\n    return x\n\ndef ordinary(x):\n    return x\n"
        self.assertTrue(judge(mod, mod.replace("LIMIT = 3", "LIMIT = 4"), ["one_line"]), "an import-time binding")
        self.assertTrue(judge(mod, mod.replace("import os", "import sys"), ["one_line"]), "an import")
        self.assertTrue(judge(mod, mod.replace("def one_line(x):\n    return x", "def one_line(x):\n    return 1"), ["one_line"]), "a function the clear runs")
        self.assertEqual(judge(mod, mod.replace("def ordinary(x):\n    return x", "def ordinary(x):\n    return 2"), ["one_line"]), [], "an ordinary function")
        more = mod + "\nclass Thing:\n    LIMIT = 1\n\n    def method(self):\n        return 1\n"
        self.assertTrue(judge(more, more.replace("LIMIT = 1", "LIMIT = 2"), ["one_line"]), "a class body runs at import")
        self.assertEqual(judge(more, more.replace("        return 1", "        return 7"), ["one_line"]), [], "a method body does not")
        self.assertTrue(judge(mod, mod.replace("def ordinary(x):", "def ordinary(x=print(1)):"), ["one_line"]), "a default runs at import")
        self.assertTrue(judge(mod, mod.replace("def ordinary(x):", "@hook\ndef ordinary(x):"), ["one_line"]), "a decorator runs at import")
        self.assertTrue(judge(mod, mod.replace("def ordinary(x):", "def ordinary(x: make() = 1):"), ["one_line"]), "an annotation that calls runs at import")
        self.assertTrue(judge(mod, mod.replace("def ordinary(x):", "def ordinary(x=lambda: 1):"), ["one_line"]), "a lambda default")
        self.assertEqual(judge(mod, mod.replace("def ordinary(x):", "def ordinary(x: int):"), ["one_line"]), [], "a plain annotation only binds")
        self.assertEqual(judge(mod, mod.replace("def ordinary(x):", "def ordinary(\n        x):"), ["one_line"]), [], "a plain signature only binds a name")
        self.assertEqual(judge(mod, mod.replace("def ordinary(x):", "def ordinary(x, y=1):"), ["one_line"]), [], "a constant default only binds")
        self.assertEqual(judge(mod, mod + "\ndef added(a, b=None):\n    return a\n", ["one_line"]), [], "a new function with a plain signature")
        one = mod + "\ndef short(a=1): return a\n\ndef split(a=1,\n          b=2): return a\n"
        self.assertTrue(judge(one, one.replace("def short(a=1)", "def short(a=print())"), ["one_line"]), "a one-line def: the default shares the line with the body")
        self.assertTrue(judge(one, one.replace("b=2)", "b=print())"), ["one_line"]), "a split signature whose last line carries the body")
        self.assertTrue(judge(one, one.replace("def short(a=1):", "def short(a=1) -> print():"), ["one_line"]), "a return annotation")

    def test_the_blobs_are_read_at_the_merge_base_not_the_branch_tip(self):
