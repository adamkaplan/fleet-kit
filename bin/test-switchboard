    def test_s3_a_credentials_path_an_identity_path_and_a_credentials_review_class_are_refused_and_named(self):
        self.delegate()
        for label, paths, review in (("credentials path", ("shims/gh",), None), ("identity path", ("bin/switchboard-trial",), None), ("review class", ("migrations/0002.sql",), ("hold", "credentials"))):
            self.writes.clear()
            self.floor_pr(path=paths[0])
            self.files_of_pr(*paths)
            self.passes()
            self.review = (review or ("none", None), None)
            code, out, err = self.under()
