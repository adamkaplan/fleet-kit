        self.assertEqual(json.dumps(self.engine.config, sort_keys=True, default=str), config)
        self.assertFalse(sb.chat_clear_live_now(self.engine)[0])

    def test_u3_the_fake_session_source_is_no_more_generous_than_the_real_one(self):
        self.light()
        cos, coder = self.world.sessions["cos"], self.world.sessions["coder"]
        for n in range(15):
            self.say("message %d" % n)
        self.world.v2.start_turn(coder, "elsewhere", fleet=False)
        page = self.engine.v2.message_list(cos, limit=10, type="user")
        self.assertEqual(len(page), 10, "it honours limit")
        self.assertTrue(all(m["type"] == "user" for m in page), "it honours type")
        self.assertEqual([m["text"] for m in page][:2], ["message 14", "message 13"], "newest first")
        self.assertTrue(all(m["sessionID"] == cos for m in page), "it returns nothing of another session")

    def test_the_seen_file_is_private_bounded_and_empty_when_damaged(self):
        cc = sb.load_module("chat_clear")
        state = self.world.state
        path = Path(state) / cc.SEEN_FILE
        self.assertEqual(cc.read_seen(state), {})
        cc.mark_seen(state, "m1", 100)
        self.assertEqual(oct(path.stat().st_mode & 0o777), "0o600")
        self.assertEqual(cc.read_seen(state), {"m1": 100})
        for body in ("{not json", json.dumps([1]), json.dumps({"seen": 5}), " " * (cc.SEEN_MAX_BYTES + 1)):
            path.write_text(body)
            self.assertEqual(cc.read_seen(state), {}, body[:12])
        path.write_text(json.dumps({"seen": {"ok": 5, "bool": True, "str": "x", "": 1, "x" * 300: 2, "neg": None}}))
        self.assertEqual(cc.read_seen(state), {"ok": 5}, "a bad entry is dropped on its own")
        for n in range(cc.SEEN_MAX + 20):
            cc.mark_seen(state, "id%d" % n, 1000 + n)
        kept = cc.read_seen(state)
        self.assertEqual(len(kept), cc.SEEN_MAX)
        self.assertIn("id%d" % (cc.SEEN_MAX + 19), kept)
        self.assertNotIn("id0", kept, "the oldest go first")
        self.assertEqual(sorted(p.name for p in Path(state).iterdir() if p.name.startswith(cc.SEEN_FILE + ".")), [], "no temporary file is left")

    def test_u1_the_existing_clear_without_the_new_arguments_is_what_it_was(self):
        self.build(live=True)
        lines = sb.impact_clear_core(self.engine, self.route, self.REPO, 9, "the owner", "a false hold: the file is a fixture")
