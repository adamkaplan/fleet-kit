@adds_to(TestLaunch)
def test_the_chief_of_staff_is_told_its_role_by_bootstrap_and_a_resume_keeps_it(self):
    world = World(self, agents=())
    done = sb.bootstrap_cos(world.new_engine("cli"), directory=str(self.work), patience=5,
                            sleep=lambda seconds: setattr(world.clock, "t", world.clock.t + seconds))
    env = [p for m, p in world.herdr.socket_calls if m == "layout.apply"][-1]["root"]["env"]
    self.assertEqual(env["FLEET_SWITCHBOARD_ROLE"], "chief-of-staff")
    self.assertNotIn("FLEET_SWITCHBOARD_REPO", env)
    del world.herdr.panes[done["pane"]]
    sb.bootstrap_cos(world.new_engine("cli"), directory=str(self.work), patience=5,
                     sleep=lambda seconds: setattr(world.clock, "t", world.clock.t + seconds))
    env = [p for m, p in world.herdr.socket_calls if m == "layout.apply"][-1]["root"]["env"]
    self.assertEqual(env["FLEET_SWITCHBOARD_ROLE"], "chief-of-staff")


