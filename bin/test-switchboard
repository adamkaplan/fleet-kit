        self.go()
        self.assertEqual(self.only("T1"), ["acme/api#303", "acme/api#304", "acme/api#305", "acme/api#306", "acme/api#307"])

    def test_t7_with_no_notice_a_signed_comment_that_says_review_at_the_head_counts_and_the_authors_own_does_not(self):
        self.charter()
        for n in (310, 311, 312, 313):
            self.add(n, created=0.4, pr=True)
        self.describe_pr(310, comments=[("reviewer", "review of %s: clean" % TRI_HEAD_A[:7] + " " + TRI_HEAD_A)])   # an agent's review comment
        self.describe_pr(311, comments=[("bot", "review of %s: clean %s" % (TRI_HEAD_A[:7], TRI_HEAD_A))])           # the author's own
        self.describe_pr(312, comments=[("reviewer", "review of %s: clean" % TRI_HEAD_B[:7] + " " + TRI_HEAD_B)])   # an older head
        self.describe_pr(313, comments=[("reviewer", "pushed " + TRI_HEAD_A)])                                      # names the head, not a review
        self.go()
        self.assertEqual(self.only("T7"), ["acme/api#311", "acme/api#312", "acme/api#313"])

    def test_t1_a_placeholder_owner_is_not_an_owner(self):
