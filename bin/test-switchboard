class TestLedgerReadRace(unittest.TestCase):
    """A ledger read that races an append is not a cut-off (#673); a real cut-off or rewrite is still reported."""

    def setUp(self):
        self.dir = tempfile.mkdtemp()
        self.addCleanup(shutil.rmtree, self.dir, True)
        self.now = 1767225600
        for n in (1, 2):
            self.append(n)

    def append(self, n):
        return sb.plan_ledger.append_entry(self.dir, {"kind": "proof", "pr": "acme/api#1", "scenario": "S%d" % n, "result": "pass"}, self.now)

    def read_with_append_after_file_read(self):
        """Read the ledger; the moment its file has been read, a writer completes an append (entry and head pointer)."""
        real, fired = Path.read_text, []

        def hooked(path, *a, **kw):
            text = real(path, *a, **kw)
            if path.name == sb.plan_ledger.LEDGER_FILE and not fired:
                fired.append(1)
                self.append(3)
            return text
        with mock.patch.object(Path, "read_text", hooked):
            result = sb.plan_ledger.read_ledger(self.dir)
        self.assertTrue(fired, "the interleaving hook ran")
        return result

    def test_s1_a_read_that_races_an_append_reports_no_break(self):
        entries, problem = self.read_with_append_after_file_read()
        self.assertIsNone(problem)
        self.assertEqual(len(entries), 2)
        self.assertEqual(len(sb.plan_ledger.read_ledger(self.dir)[0]), 3)

    def test_s4_a_racing_read_of_a_long_ledger_answers_like_a_quiet_read(self):
        sb.plan_ledger.append_many(self.dir, [{"kind": "proof", "pr": "acme/api#1", "scenario": "S%d" % n, "result": "pass"}
                                              for n in range(3, 1103)], self.now)
        quiet = sb.plan_ledger.read_ledger(self.dir)
        self.assertEqual((len(quiet[0]), quiet[1]), (1102, None))
        self.append(1103)
        # the same interleaving, on 1000+ entries: an append completes right after the file was read
        real, fired = Path.read_text, []

        def hooked(path, *a, **kw):
            text = real(path, *a, **kw)
            if path.name == sb.plan_ledger.LEDGER_FILE and not fired:
                fired.append(1)
                self.append(1104)
            return text
        with mock.patch.object(Path, "read_text", hooked):
            raced = sb.plan_ledger.read_ledger(self.dir)
        self.assertEqual((len(raced[0]), raced[1]), (1103, None))

    def test_s2_a_cut_off_ledger_still_reports_the_break(self):
        self.append(3)
        path = Path(self.dir) / sb.plan_ledger.LEDGER_FILE
        path.write_text("".join(path.read_text().splitlines(True)[:2]))
        self.assertIn("ends before entry 3", sb.plan_ledger.read_ledger(self.dir)[1])

    def test_s5_a_rewritten_middle_entry_is_reported_with_the_same_message(self):
        self.append(3)
        path = Path(self.dir) / sb.plan_ledger.LEDGER_FILE
        lines = path.read_text().splitlines()
        lines[1] = json.dumps(dict(json.loads(lines[1]), result="fail"), sort_keys=True)
        path.write_text("\n".join(lines) + "\n")
        self.assertEqual(sb.plan_ledger.read_ledger(self.dir)[1], "entry 2 does not follow from the one before it: the ledger was edited")

    def test_s3_a_rewritten_ledger_still_reports_the_break(self):
        path = Path(self.dir) / sb.plan_ledger.LEDGER_FILE
        forged = dict(json.loads(path.read_text().splitlines()[0]), result="fail")
        forged["hash"] = sb.plan_ledger.entry_hash(forged)
        path.write_text(json.dumps(forged, sort_keys=True) + "\n")
        self.assertIsNotNone(sb.plan_ledger.read_ledger(self.dir)[1])


class TestWaive(LedgerBase):
    """`waive`: the chief of staff's logged override of G0 to G5 for one PR at its head. Never G6, G7, G8, never a writer, never
    an unknown session; it expires; a waived gate reads `waived`, not passed. Neutral names."""

    REASON = "hotfix for a broken release: the plan follows within a day"

    def setUp(self):
        super().setUp()
        self.world.add_agent("cos", fleet={"role": "chief-of-staff"})
        self.extra_config = {"plan_gates": {"repos": {"acme/app": {"mode": "enforce"}}}}
        self.configure()

    def waive(self, who="cos", gates="G1", reason=None, *more):
        return self.run_as(who, "waive", self.PR, "--gates", gates, "--reason", self.REASON if reason is None else reason, *more)

    def check(self, kind="merge"):
        code, out, err = self.run_as("coder", "gates-check", self.PR, "--for", kind, "--json")
        return code, json.loads(out), err

    def events(self, name):
        return [e for e in self.world.audit() if e["event"] == name]

    def test_without_a_waiver_the_missing_proof_refuses_and_the_chief_of_staffs_waiver_lets_it_through_for_that_head(self):
        code, payload, _ = self.check()
        self.assertEqual((code, payload["verdict"], [f["gate"] for f in payload["failed"]]), (10, "refuse", ["G1"]))
        code, out, err = self.waive()
        self.assertEqual(code, 0, err)
        self.assertIn("waived, not passed", out)
        code, payload, _ = self.check()
        self.assertEqual((code, payload["verdict"]), (0, "allow"))
        report = self.gates()[1]
        row = self.row(report, "G1")
        self.assertEqual(row["status"], "waived")                                  # not "ok": it did not pass
        self.assertIn("waived (by cos, %s, due " % self.REASON, row["detail"])
        self.assertEqual(report["waived"], ["G1"])
        self.assertTrue(report["ready"])
        text = "\n".join(sb.plan_ledger.render_gates(report, self.PR))
        self.assertIn("WAIVED (not passed): G1", text)

    def test_the_entry_is_hash_chained_with_who_why_pr_head_and_expiry_and_audited(self):
        self.waive(gates="G1,G4")
        (entry,) = self.ledger()
        self.assertEqual((entry["kind"], entry["pr"], entry["head"], entry["gates"], entry["by"], entry["reason"]),
                         ("waiver", self.PR, LEDGER_HEAD, ["G1", "G4"], "cos", self.REASON))
        self.assertEqual(entry["expires"] - entry["ts"], sb.plan_ledger.WAIVER_SECONDS)
        entries, problem = sb.plan_ledger.read_ledger(self.world.state)
        self.assertIsNone(problem)                                                  # the chain verifies with the waiver in it
        (event,) = self.events("plan.waiver")
        self.assertEqual((event["detail"]["by"], event["detail"]["head"], event["detail"]["gates"]), ("cos", LEDGER_HEAD, ["G1", "G4"]))
        self.assertEqual(event["detail"]["chain"], entry["hash"])

    def test_a_push_after_the_waiver_or_its_expiry_or_another_pr_does_nothing(self):
        self.waive()
        self.assertEqual(self.check()[0], 0)
        self.pr["headRefOid"] = LEDGER_NEW_HEAD                                     # a push: the waiver covered the old head only
        self.assertEqual(self.check()[0], 10)
        self.assertEqual(self.row(self.gates()[1], "G1")["status"], "missing")
        self.pr["headRefOid"] = LEDGER_HEAD
        self.assertEqual(self.check()[0], 0)
        self.world.clock.t += sb.plan_ledger.WAIVER_SECONDS + 1                     # past the due date
        self.assertEqual(self.check()[0], 10)
        self.world.clock.t -= sb.plan_ledger.WAIVER_SECONDS + 1
        entries, _ = sb.plan_ledger.read_ledger(self.world.state)
        self.assertEqual(sb.plan_ledger.valid_waivers(entries, "acme/app#10", LEDGER_HEAD, self.world.clock.now()), {})   # another PR

    def test_g6_g7_g8_and_unknown_gates_are_never_waived_and_nothing_is_recorded(self):
        for gates, fragment in (("G6", "never waived"), ("G8", "never waived"), ("G7", "never waived"), ("G1,G6", "never waived"),
                                ("G9", "not a gate that can be waived"), ("", "name the gates"), ("nonsense", "not a gate")):
            with self.subTest(gates=gates):
                code, out, err = self.waive(gates=gates)
                self.assertEqual(code, 2)
                self.assertIn(fragment, err)
        self.assertEqual(self.ledger(), [])
        self.assertEqual(len(self.events("gate.waiver.refused")), 7)

    def test_a_forged_ledger_entry_cannot_waive_g6_either(self):
        self.pr["body"] = "MERGE: captain\nPLAN: acme/app#7\ncanon: updated the docs"
        forged = {"kind": "waiver", "pr": self.PR, "head": LEDGER_HEAD, "gates": ["G6", "G1"], "reason": "x" * 30, "by": "cos",
                  "result": "pass", "expires": self.world.clock.now() + 3600}
        sb.plan_ledger.append_entry(self.world.state, forged, self.world.clock.now())
        report = self.gates()[1]
        self.assertEqual(self.row(report, "G6")["status"], "waiting")               # the owner's hold stands
        self.assertEqual(self.row(report, "G1")["status"], "waived")
        code, payload, _ = self.check()
        self.assertEqual([f["gate"] for f in payload["failed"]], ["G6", "G6b"])      # still failing (reported: a repo lists G6 to enforce it)
        self.assertEqual(self.run_as("coder", "gates-check", self.PR, "--for", "merge")[0], 0)   # G6 is not in this repo's enforced list

    def test_a_short_reason_is_refused(self):
        code, out, err = self.waive(reason="too short")
        self.assertEqual(code, 2)
        self.assertIn("at least %d characters" % sb.plan_ledger.WAIVER_REASON_MIN, err)
        self.assertEqual(self.ledger(), [])

    def test_only_the_chief_of_staff_or_a_person_and_an_unknown_session_is_refused(self):
        for who in ("coder", "rev", "own"):
            code, out, err = self.waive(who=who)
            self.assertEqual(code, 2)
            self.assertIn("may not waive gates", err)
        self.assertEqual(self.ledger(), [])
        os.environ["OPENCODE_SESSION_ID"] = "ses_nosuchsession"
        try:
            code, out, err = self.run_as(None, "waive", self.PR, "--gates", "G1", "--reason", self.REASON)
        finally:
            os.environ.pop("OPENCODE_SESSION_ID", None)
        self.assertEqual(code, 2)
        self.assertIn("uncertain identity is refused", err)
        self.assertEqual(self.ledger(), [])
        code, out, err = self.waive(who=None)                                       # a person at a shell
        self.assertEqual(code, 0, err)
        self.assertEqual(self.ledger()[0]["by"], "a person at a shell")

    def test_an_agent_that_unsets_its_session_variables_on_a_pipe_is_not_a_person_and_cannot_waive(self):
        # `env -u OPENCODE_SESSION_ID -u HERDR_PANE_ID fleet-switchboard waive ...` from an agent's tool shell: no session, no pane,
        # but standard input and output are pipes (and an agent process is an ancestor): the shared check refuses
        for problem in ("standard input and output are not a terminal (an agent's tool shell runs on pipes)",
                        "an agent process is an ancestor of this command (opencode)",
                        "the process chain cannot be read (process 1234): refused, not guessed"):
            with self.subTest(problem=problem):
                self.terminal_problem = problem
                code, out, err = self.waive(who=None)
                self.assertEqual(code, 2)
                self.assertIn("not established as the owner's own terminal", err)
                self.assertEqual(self.ledger(), [])
        self.assertEqual(len(self.events("gate.waiver.refused")), 3)
        self.terminal_problem = "not a terminal"
        self.assertEqual(self.waive(who="cos")[0], 0)                                # the chief of staff is a session, not this path
        self.terminal_problem = None
        self.assertEqual(self.waive(who=None)[0], 0)                                 # the owner's own terminal still may

    def test_waive_asks_the_one_shared_terminal_check_and_has_no_copy_of_it(self):
        text = (REPO / "bin" / "fleet-switchboard").read_text()
        body = text[text.index("def cmd_waive"):text.index("def cmd_gates(args")]
        self.assertIn("gates_caller_kind(", body)
        self.assertNotIn("isatty", body)
        self.assertNotIn("owner_terminal_problem(", body)
        self.assertEqual(text.count("owner_terminal_problem()"), 1, "the check is called from exactly one place")

    def test_a_writer_of_the_pr_cannot_waive_its_own_gates(self):
        sb.record_pr_notice(self.world.state, "acme/app", 9, "cos", "", self.world.clock.now())
        code, out, err = self.waive()
        self.assertEqual(code, 2)
        self.assertIn("a writer cannot waive its own gates", err)
        self.assertEqual(self.ledger(), [])

    def test_a_broken_ledger_takes_no_waiver_and_honours_none(self):
        self.waive()
        path = self.world.state / "plan-ledger.jsonl"
        path.write_text(path.read_text().replace('"G1"', '"G4"'))                    # edited by hand
        code, out, err = self.waive(gates="G4")
        self.assertEqual(code, 2)
        self.assertIn("not trustworthy", err)
        self.assertEqual(self.row(self.gates()[1], "G1")["status"], "missing")      # no waiver is honoured from a broken ledger

    def test_the_head_must_be_the_prs_and_the_gate_g1_missing_only_becomes_waived(self):
        code, out, err = self.waive("cos", "G1", self.REASON, "--head", "c" * 40)
        self.assertEqual(code, 2)
        self.assertIn("is not the PR's head", err)
        self.waive(gates="G1,G5")
        report = self.gates()[1]
        self.assertEqual(self.row(report, "G5")["status"], "ok")                    # a gate that passes stays ok, not waived
        self.assertEqual(report["waived"], ["G1"])

    def test_help_and_docs_name_the_command(self):
        with captured() as (out, _):
            with self.assertRaises(SystemExit):
                sb.build_parser().parse_args(["waive", "--help"])
        flat = " ".join(out.getvalue().split())
        for word in ("--gates", "--reason", "never G6, G7 or G8"):
            self.assertIn(word, flat)


class TestPrSharesFiles(LedgerBase):
    """#818: `gates` may print `shares <file> with #N`, and `decisions` a merge order among held pull requests that share files. Information only. Synthetic data."""

    def setUp(self):
        super().setUp()
        self.open_prs = []
        self.list_calls = []
        self.list_fails = False
        base = self.route

        def route(argv, **kw):
            if argv[0] == FAKE_GH and argv[1:3] == ["pr", "list"]:
                self.list_calls.append(list(argv))
                if self.list_fails:
                    return subprocess.CompletedProcess(argv, 1, "", "gh: boom")
                return subprocess.CompletedProcess(argv, 0, json.dumps(self.open_prs), "")
            return base(argv, **kw)
        self.route = route

    @staticmethod
    def pr_of(number, *paths, total=None):
        return {"number": number, "files": [{"path": p} for p in paths], "changedFiles": len(paths) if total is None else total}

    def gates_text(self):
        code, out, err = self.run_as("coder", "gates", self.PR)
        return code, out

    def shares(self, out):
        return [l for l in out.splitlines() if l.startswith("shares ")]

    def test_S1_an_overlap_prints_one_line_naming_the_files_and_the_pull_request(self):
        self.open_prs = [self.pr_of(9, "bin/x", "bin/y", "bin/own"), self.pr_of(12, "bin/x", "bin/y", "z")]
        base_code, _ = self.gates_text()
        self.assertEqual(self.shares(self.gates_text()[1]), ["shares bin/x, bin/y with #12"])
        self.open_prs = []
        self.assertEqual(self.gates_text()[0], base_code, "the exit status does not depend on the line")

    def test_S2_no_common_file_prints_no_line(self):
        self.open_prs = [self.pr_of(9, "bin/x"), self.pr_of(12, "bin/xy"), self.pr_of(13, "docs/x")]
        code, out = self.gates_text()
        self.assertEqual(self.shares(out), [])

    def test_S3_three_files_five_pull_requests_ascending_and_one_capped_read(self):
        files = ["f%d" % i for i in range(5)]
        self.open_prs = [self.pr_of(n, *files) for n in (9, 31, 20, 22, 21, 40, 8, 25)]   # 7 others share 5 files
        line = self.shares(self.gates_text()[1])
        self.assertEqual(line, ["shares f0, f1, f2 with #8, #20, #21, #22, #25"])
        self.assertEqual(len(self.list_calls), 1)
        argv = self.list_calls[0]
        self.assertEqual(argv[argv.index("--limit") + 1], "50")
        self.assertEqual(argv[argv.index("--state") + 1], "open")

    def test_S4_held_pull_requests_get_a_merge_order_by_waiting_time(self):
        self.open_prs = [self.pr_of(1, "a"), self.pr_of(2, "a", "b"), self.pr_of(3, "zzz")]
        t = 1_000_000
        held = lambda n, since: {"kind": "captain", "repo": "acme/app", "number": n, "since": sb.iso(since)}
        decisions = [held(1, t + 500), held(2, t), held(3, t - 900)]   # #3 waited longest but shares nothing; #2 waited longer than #1
        hints = sb.held_merge_order_hints(decisions, self.route, self.world.clock.now)
        self.assertEqual(hints, ["merge order: #2, then #1 (shared files)"])
        self.assertNotIn("#3", " ".join(hints))
        self.assertEqual(len(self.list_calls), 1)

    def test_S4_one_held_pull_request_makes_no_read_and_no_hint(self):
        decisions = [{"kind": "captain", "repo": "acme/app", "number": 1, "since": sb.iso(5)}, {"kind": "notice", "repo": "acme/app", "number": 2, "since": sb.iso(1)}]
        self.assertEqual(sb.held_merge_order_hints(decisions, self.route, self.world.clock.now), [])
        self.assertEqual(self.list_calls, [])

    def test_S5_the_words_are_shares_never_conflicts_and_the_exit_status_is_unchanged(self):
        self.all_proven()
        self.open_prs = []
        quiet = self.run_as("coder", "gates", self.PR)
        self.open_prs = [self.pr_of(9, "a"), self.pr_of(12, "a")]
        loud = self.run_as("coder", "gates", self.PR)
        self.assertEqual(self.shares(loud[1]), ["shares a with #12"])
        self.assertEqual(loud[0], quiet[0])
        self.assertNotIn("conflict", loud[1].lower())
        self.assertNotIn("conflict", "".join(inspect.getsource(f) for f in (sb.overlap_shares_line, sb.overlap_waiting_order)).lower())
        hints = sb.held_merge_order_hints([{"kind": "captain", "repo": "acme/app", "number": n, "since": sb.iso(n)} for n in (9, 12)], self.route, self.world.clock.now)
        self.assertTrue(hints and "conflict" not in hints[0].lower())

    def test_S6_unreadable_and_truncated_pull_requests_are_left_out_the_readable_one_is_named(self):
        self.open_prs = [self.pr_of(9, "a", "b"), self.pr_of(12, "a"), self.pr_of(13, "a", "b", total=5),   # truncated
                         {"number": 14, "files": None, "changedFiles": 1}, {"number": 15, "changedFiles": 1},          # unreadable
                         self.pr_of(16, *["p%d" % i for i in range(101)], "a")]                                          # over the 100-file cap
        code, out = self.gates_text()
        self.assertEqual(self.shares(out), ["shares a with #12"])

    def test_a_path_with_a_control_character_or_over_300_characters_leaves_that_pull_request_out(self):
        self.open_prs = [self.pr_of(9, "a"), self.pr_of(12, "a", "b\x1b[2Jc"), self.pr_of(13, "a", "x" * 301), self.pr_of(14, "a")]
        self.assertEqual(self.shares(self.gates_text()[1]), ["shares a with #14"])

    def test_S6_a_failed_or_garbled_read_gives_no_line_and_the_same_exit_status(self):
        self.open_prs = [self.pr_of(9, "a"), self.pr_of(12, "a")]
        want = self.gates_text()[0]
        self.list_fails = True
        code, out = self.gates_text()
        self.assertEqual((code, self.shares(out)), (want, []))
        self.list_fails = False
        self.open_prs = "not a list"
        self.assertEqual(self.shares(self.gates_text()[1]), [])

    def test_S7_the_daemon_passes_make_no_read_for_this(self):
        self.open_prs = [self.pr_of(1, "a"), self.pr_of(2, "a")]
        self.world.engine.discover(self.world.clock.now())
        self.world.engine.collect_facts()
        sb.derive_decisions(self.world.engine, self.world.clock.now())
        self.assertEqual(self.list_calls, [])

    def test_gates_json_carries_the_shares_line_only_when_there_is_one(self):
        self.open_prs = [self.pr_of(9, "a"), self.pr_of(12, "a")]
        self.assertEqual(self.gates()[1]["shares"], "shares a with #12")
        self.open_prs = []
        self.assertNotIn("shares", self.gates()[1])

    def held_report(self, stale=False):
        t = 1_000_000
        held = lambda n, since: {"id": "pr:app#%d" % n, "title": "t%d" % n, "kind": "captain", "tier": "human", "repo": "acme/app", "number": n, "since": sb.iso(since), "agent": None}
        return {"stale": stale, "message": "stale" if stale else None, "age_seconds": 0, "written_at": sb.iso(t), "generation": None, "errors": [],
                "decisions": [held(1, t + 500), held(2, t), held(3, t - 900)]}

    def decisions_cli(self, *more, stale=False):
        os.environ["HERDR_PANE_ID"] = self.world.panes["own"]
        with captured() as (out, err), mock.patch.object(sb, "decisions_report", lambda *a, **k: self.held_report(stale)):
            code = sb.main(["decisions", *more], runner=self.route, now=self.world.clock.now, wait=lambda sock, seconds: False, socket_call=self.world.herdr.socket)
        return code, out.getvalue(), err.getvalue()

    def test_the_decisions_command_prints_the_merge_order_and_json_carries_it(self):
        self.open_prs = [self.pr_of(1, "a"), self.pr_of(2, "a"), self.pr_of(3, "z")]
        code, out, err = self.decisions_cli()
        self.assertIn("merge order: #2, then #1 (shared files)", out.splitlines())
        code, out, err = self.decisions_cli("--json")
        self.assertEqual(json.loads(out)["merge_order"], ["merge order: #2, then #1 (shared files)"])
        self.open_prs = [self.pr_of(1, "a"), self.pr_of(2, "b")]
        self.assertNotIn("merge_order", json.loads(self.decisions_cli("--json")[1]))

    def test_a_stale_decisions_report_makes_no_read_and_no_hint(self):
        self.open_prs = [self.pr_of(1, "a"), self.pr_of(2, "a")]
        code, out, err = self.decisions_cli(stale=True)
        self.assertNotIn("merge order", out)
        self.assertEqual(self.list_calls, [])

    def test_merge_order_groups_transitively_caps_and_breaks_ties_by_number(self):
        chain = {1: ["a"], 2: ["a", "b"], 3: ["b"], 7: ["x"], 8: ["x"], 9: ["q"]}   # 1-2-3 linked through 2; 7-8 another group; 9 alone
        hints = sb.overlap_waiting_order(chain, [(1, 50), (2, 40), (3, 30), (7, 10), (8, 10), (9, 1)])
        self.assertEqual(hints, ["merge order: #3, then #2, then #1 (shared files)", "merge order: #7, then #8 (shared files)"])
        many = {n: ["s"] for n in range(1, 9)}
        (hint,) = sb.overlap_waiting_order(many, [(n, 100 - n) for n in many])
        self.assertEqual(hint.count("#"), 5)

    def test_two_repos_prefix_each_hint_and_a_failed_read_gives_none(self):
        held = lambda repo, n, s: {"kind": "captain", "repo": repo, "number": n, "since": sb.iso(s)}
        ds = [held("acme/app", 1, 5), held("acme/app", 2, 6), held("acme/b", 3, 5)]
        self.open_prs = [self.pr_of(1, "a"), self.pr_of(2, "a")]
        self.assertEqual(sb.held_merge_order_hints(ds, self.route, self.world.clock.now), ["acme/app: merge order: #1, then #2 (shared files)"])
        self.list_fails = True
        self.assertEqual(sb.held_merge_order_hints(ds, self.route, self.world.clock.now), [])

    def test_S8_an_unreadable_own_list_gives_no_line(self):
        self.open_prs = [{"number": 9, "files": None, "changedFiles": 2}, self.pr_of(12, "a")]
        before = self.gates_text()
        self.assertEqual(self.shares(before[1]), [])
        self.open_prs = [self.pr_of(12, "a")]   # this pull request is not in the listing at all
        self.assertEqual(self.shares(self.gates_text()[1]), [])
        self.assertEqual(before[0], self.gates_text()[0])


class TestPlanGatesCheck(LedgerBase):
    """#107 slice 3a: `gates-check`, the per-repo mode, the kill switches and the role guard. Nothing enforces: no shim calls it."""

    def setUp(self):
        super().setUp()
        self.set_gates({"acme/app": {"mode": "shadow"}})

    def set_gates(self, repos):
        self.extra_config = {"plan_gates": {"repos": repos}}
        self.configure()

    def check(self, kind="merge", *more, who="coder", pr=None):
        code, out, err = self.run_as(who, "gates-check", pr or self.PR, "--for", kind, "--json", *more)
        return code, (json.loads(out) if out.strip().startswith("{") else None), err

    def events(self, name):
        return [e for e in self.world.audit() if e["event"] == name]

    # -- the decision

    def test_a_repo_not_listed_is_not_checked_and_says_nothing(self):
        self.set_gates({"acme/other": {"mode": "enforce"}})
        code, out, err = self.check()
        self.assertEqual((code, out["verdict"], out["reason"]), (0, "allow", "not opted in"))
        self.assertEqual(self.events("gate.would_refuse") + self.events("gate.refused"), [])

    def test_shadow_allows_and_records_what_enforcement_would_refuse(self):
        code, out, err = self.check("merge")
        self.assertEqual((code, out["verdict"], out["mode"]), (0, "allow", "shadow"))
        self.assertTrue(out["failed"])
        (event,) = self.events("gate.would_refuse")
        self.assertIn("G1", event["detail"]["failed"])
        self.assertEqual(self.events("gate.refused"), [])

    def test_enforce_refuses_with_exit_10_and_names_the_gates(self):
        self.set_gates({"acme/app": {"mode": "enforce"}})
        code, out, err = self.check("ready")
        self.assertEqual((code, out["verdict"]), (10, "refuse"))
        self.assertEqual([f["gate"] for f in out["failed"]], ["G1"])
        self.assertIn("ready of acme/app#9 refused: missing G1", out["message"])   # the shim prints exactly this line
        self.assertIn("logged waiver", out["message"])
        self.assertEqual(len(out["message"].splitlines()), 1)
        self.assertIn("gate.refused", [e["event"] for e in self.world.audit()])
        code, text, err = self.run_as("coder", "gates-check", self.PR, "--for", "ready")
        self.assertEqual(code, 10)
        self.assertIn("ready of acme/app#9 refused: missing G1", err)

    def test_enforce_allows_when_the_gates_it_needs_are_satisfied(self):
        self.all_proven()
        self.set_gates({"acme/app": {"mode": "enforce"}})
        for kind in ("ready", "merge"):
            code, out, err = self.check(kind)
            self.assertEqual((code, out["verdict"], out["failed"]), (0, "allow", []), kind)

    def test_each_check_requires_its_own_gates(self):
        self.all_proven()
        self.pr["statusCheckRollup"] = [{"conclusion": "FAILURE", "status": "COMPLETED"}]
        self.set_gates({"acme/app": {"mode": "enforce", "enforce_gates": ["G0a", "G1", "G4", "G6"]}})
        self.assertEqual(self.check("ready")[0], 0, "CI is not a ready gate")
        code, out, _ = self.check("merge")
        self.assertEqual((code, [f["gate"] for f in out["failed"]]), (10, ["G4"]))
        self.pr["labels"] = [{"name": "tester:merge-captain"}]
        self.pr["statusCheckRollup"] = [{"conclusion": "SUCCESS", "status": "COMPLETED"}]
        code, out, _ = self.check("merge")
        self.assertEqual((code, [f["gate"] for f in out["failed"]]), (10, ["G6", "G6b"]))
        self.set_gates({"acme/app": {"mode": "enforce"}})
        code, out, _ = self.check("merge")
        self.assertEqual(code, 0, "G4 and G6 are enforced only when listed")
        self.assertEqual([(f["gate"], f["enforced"]) for f in out["failed"]], [("G6", False), ("G6b", False)])

    def test_a_repo_in_enforce_with_the_default_list_reports_g4_and_g6_but_never_refuses_on_them(self):
        self.all_proven()
        self.pr["statusCheckRollup"] = [{"conclusion": "FAILURE", "status": "COMPLETED"}]   # G4 fails
        self.pr["labels"] = [{"name": "tester:merge-captain"}]                              # G6 waits
        self.set_gates({"acme/app": {"mode": "enforce"}})
        code, out, err = self.check("merge")
        self.assertEqual((code, out["verdict"]), (0, "allow"))
        self.assertEqual(sorted((f["gate"], f["enforced"]) for f in out["failed"]), [("G4", False), ("G6", False), ("G6b", False)])
        self.assertIn("reported, not enforced", out["reason"])
        (event,) = self.events("gate.reported")
        self.assertEqual((event["detail"]["failed"], event["detail"]["enforced"]), (["G4", "G6", "G6b"], []))
        self.assertEqual(self.events("gate.refused") + self.events("gate.would_refuse"), [])
        self.set_gates({"acme/app": {"mode": "enforce", "enforce_gates": ["G0a", "G1", "G4"]}})
        code, out, _ = self.check("merge")
        self.assertEqual(code, 10)
        self.assertEqual([f["gate"] for f in out["failed"] if f["enforced"]], ["G4"], "G6 is still only reported")

    def test_a_g1_failure_still_refuses_with_the_default_list_and_shadow_records_every_gate(self):
        self.pr["statusCheckRollup"] = [{"conclusion": "FAILURE", "status": "COMPLETED"}]
        self.set_gates({"acme/app": {"mode": "enforce"}})
        code, out, _ = self.check("merge")
        self.assertEqual(code, 10)
        self.assertIn("G1", [f["gate"] for f in out["failed"] if f["enforced"]])
        self.assertIn("G4", [f["gate"] for f in out["failed"] if not f["enforced"]])
        self.set_gates({"acme/app": {"mode": "shadow"}})
        code, out, _ = self.check("merge")
        self.assertEqual(code, 0)
        (event,) = self.events("gate.would_refuse")
        self.assertIn("G4", event["detail"]["failed"], "shadow records would-refuse for all gates")

    def test_the_refusal_is_one_line_naming_the_gates_and_the_way_out(self):
        self.set_gates({"acme/app": {"mode": "enforce"}})
        code, text, err = self.run_as("coder", "gates-check", self.PR, "--for", "merge")
        self.assertEqual(code, 10)
        lines = [l for l in err.splitlines() if l.strip()]
        self.assertEqual(len(lines), 1, err)
        for fragment in ("merge of acme/app#9 refused: missing G1", "logged waiver", "never for G6 or G8", "waive acme/app#9",
                         "gates mode acme/app shadow"):
            self.assertIn(fragment, lines[0])
        self.assertNotIn("G4", lines[0].split("Way out")[0], "a gate that is only reported is not named as the reason")

    def test_preflight_gates_mode_and_status_show_the_enforced_gates(self):
        self.set_gates({"acme/app": {"mode": "enforce", "enforce_gates": ["G0a", "G1", "G4"]}})
        self.assertIn("enforced gates: G0a, G1, G4", self.run_as(None, "gates", "preflight", "acme/app")[1])
        self.assertIn("enforce on G0a, G1, G4;", self.run_as(None, "status")[1])
        self.set_gates({"acme/app": {"mode": "shadow"}})
        code, out, err = self.run_as(None, "gates", "mode", "acme/app", "enforce")
        self.assertEqual(code, 0, err)
        self.assertIn("refuses on G0a, G1 (others are reported)", out)

    def test_untracked_gates_never_refuse(self):
        self.all_proven()
        self.set_gates({"acme/app": {"mode": "enforce"}})
        code, out, _ = self.check("merge")
        self.assertEqual(code, 0)   # G0b, G0c and G2/G3 are untracked: they cannot block

    def test_the_repo_matches_without_regard_to_case(self):
        self.set_gates({"Acme/App": {"mode": "enforce"}})
        self.assertEqual(self.check("ready")[0], 10)
        with self.assertRaises(sb.ConfigError):
            sb.validate_config({"opencode": FAKE_OPENCODE, "plan_gates": {"repos": {"a/b": {}, "A/B": {}}}})

    def test_a_plan_with_nothing_claimed_per_pr_does_not_pass_g1_without_a_reasoned_statement(self):
        scenario_block = LEDGER_PLAN[LEDGER_PLAN.index("```yaml"):].replace("    claim: epic\n", "")
        epic_plan = re.sub(r"(    evaluator: \w+)\n", r"\1\n    claim: epic\n", scenario_block)
        head = LEDGER_PLAN[:LEDGER_PLAN.index("```yaml")]
        self.plan_issue["body"] = head + epic_plan
        self.set_gates({"acme/app": {"mode": "enforce"}})
        code, out, _ = self.check("ready")
        self.assertEqual(code, 10)
        self.assertIn("claimed per PR", out["reason"])
        self.plan_issue["body"] = head + epic_plan + "\nper-pr scenarios: none because the whole change is proven at the epic head\n"
        code, out, _ = self.check("ready")
        self.assertEqual(code, 0, out)
        self.plan_issue["body"] = head + epic_plan + "\nper-pr scenarios: none because short\n"
        self.assertEqual(self.check("ready")[0], 10, "the reason is at least 20 characters")

    # -- fail-open

    def test_only_exit_10_refuses_and_every_failure_is_a_fail_open_with_a_record(self):
        self.set_gates({"acme/app": {"mode": "enforce"}})
        self.gh_down = True
        code, out, err = self.check("merge")
        self.assertEqual((code, out["verdict"]), (3, "fail-open"))
        self.assertNotEqual(code, 10)
        self.assertEqual(len(self.events("gate.fail_open")), 1)
        self.assertEqual(self.events("gate.refused"), [], "a fail-open is not recorded as a refusal")

    def test_a_crash_inside_the_check_is_a_fail_open_not_a_refusal(self):
        self.set_gates({"acme/app": {"mode": "enforce"}})
        with mock.patch.object(sb.plan_ledger, "evaluate_gates", side_effect=ValueError("boom")):
            code, out, err = self.check("merge")
        self.assertEqual((code, out["verdict"]), (3, "fail-open"))
        self.assertIn("boom", out["reason"])

    def test_a_check_that_outruns_its_budget_fails_open(self):
        self.set_gates({"acme/app": {"mode": "enforce", "budget_ms": 500}})
        base = self.route

        def slow(argv, **kw):
            time.sleep(1.5)
            return base(argv, **kw)
        self.route = slow
        started = time.time()
        code, out, _ = self.check("merge")
        self.assertEqual((code, out["verdict"]), (3, "fail-open"))
        self.assertIn("no answer within 500 ms", out["reason"])
        self.assertLess(time.time() - started, 1.4, "the caller is not held past the budget")

    def test_a_broken_ledger_refuses_g1_in_enforce_and_alarms_once_a_day(self):
        self.all_proven()
        path = self.world.state / "plan-ledger.jsonl"
        path.write_text(path.read_text().replace('"result": "pass"', '"result": "fail"', 1))
        self.set_gates({"acme/app": {"mode": "enforce"}})
        for _ in range(3):
            code, out, _ = self.check("ready")
            self.assertEqual(code, 10)
        self.assertEqual(len(self.events("gate.ledger_broken")), 1, "one alarm a day per repo, not one per command")
        self.set_gates({"acme/app": {"mode": "shadow"}})
        self.assertEqual(self.check("ready")[0], 0)

    def test_the_first_fail_open_of_a_kind_per_repo_per_day_is_marked(self):
        self.gh_down = True
        self.check("merge")
        self.check("merge")
        firsts = [e["detail"]["first_today"] for e in self.events("gate.fail_open")]
        self.assertEqual(firsts, [True, False])

    def test_a_fail_open_and_a_refusal_are_distinguishable_in_the_log(self):
        self.set_gates({"acme/app": {"mode": "enforce"}})
        self.check("ready")
        self.gh_down = True
        self.check("ready")
        names = [e["event"] for e in self.world.audit() if e["event"].startswith("gate.")]
        self.assertEqual(names, ["gate.refused", "gate.fail_open"])

