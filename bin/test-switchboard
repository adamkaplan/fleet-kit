        self.assertEqual(code, 0, err)
        self.assertIn("R-CODE-1", out)
        self.assertIn("R-TEST-1", out)
        self.assertNotIn("none of", out)

    def test_every_agent_definition_has_front_matter_that_a_yaml_parser_reads_as_written(self):
        # An unquoted `description: ... : ...` fails to parse and OpenCode v2 then silently registers the file as a default primary agent.
        for path in sorted((REPO / "agents").glob("*/*.md")):
            with self.subTest(path=path.name):
                parts = path.read_text().split("---\n")
                self.assertGreaterEqual(len(parts), 3, "front matter is fenced by ---")
                for line in parts[1].split("\n"):
                    m = re.match(r"^([A-Za-z_][\w-]*):\s+(.*)$", line)
                    if not m:
                        continue
                    value = m.group(2)
                    if value[:1] in "\"'[{|>":
                        continue
                    self.assertNotIn(": ", value, "%s: quote the value (a ': ' inside an unquoted scalar breaks the parse)" % m.group(1))
                    self.assertNotIn(" #", value, "%s: quote the value (' #' starts a comment)" % m.group(1))
                    self.assertFalse(value.endswith(":"), m.group(1))

    def test_each_reviewer_is_told_how_to_read_the_heads_checks_and_the_skill_mentions_it(self):
        for role in self.ROLES:
            text = self.front(role)[0]
            self.assertIn("gh pr checks <pr> --repo <owner/repo>", text, role)
            self.assertIn("bare, no pipes", text, role)
            self.assertIn("check result not read", text, role)
        skill = " ".join((REPO / "skills" / "fleet-review" / "SKILL.md").read_text().split())
        for needle in ("gh pr checks <pr> --repo <owner/repo>", "R-LAW-16", "`--web`, `-w` and `--watch` are refused"):
            self.assertIn(needle, skill)

    def test_each_reviewer_parses_as_a_subagent_with_a_quoted_description_and_enough_rules(self):
        for role in self.ROLES:
            with self.subTest(role=role):
                text, head, perms = self.front(role)
                self.assertRegex(head, r'(?m)^description: ".+"$')
                self.assertNotIn("review record", re.search(r'(?m)^description: (.*)$', head).group(1), "the description must not claim a write it no longer has")
                self.assertRegex(head, r"(?m)^mode: subagent$")
                self.assertGreaterEqual(len(perms), 30, "a reviewer has its short permission block, not the default's few rules")

    def test_the_skill_and_the_docs_say_how_to_verify_an_installed_agent(self):
        for rel in ("skills/fleet-review/SKILL.md", "docs/switchboard.md"):
            self.assertIn("opencode api GET /api/agent", (REPO / rel).read_text(), rel)

    @staticmethod
    def verdict(perms, action, command):
        """The effect of the LAST rule that matches (deny by default first, the denies last), as the permission list reads."""
        import fnmatch
        effect = None
        for a, r, e in perms:
            if a in ("*", action) and fnmatch.fnmatchcase(command, r):
                effect = e
        return effect

    BARE = ("fleet-switchboard review laws acme/app#9", "gh pr diff 9", "gh pr diff 9 --repo acme/app", "gh pr view 9 --json files", "git diff abc..def", "git log -5", "git show abc",
            "gh pr checks 1 --repo a/b")
    REFUSED = ("fleet-switchboard review laws 230 2>&1", "gh pr diff 230 2>&1", "git diff abc > out.txt", "gh pr view 9 >> out", "git diff abc..def --output=out", "gh pr view 9 --web",
               "gh pr checks 1 --web", "gh pr checks 1 -w", "gh pr checks 1 --watch", "gh pr checks -w 1", "gh pr checks --watch 1", "gh pr checks --web 1", "gh pr checks 1 --repo a/b > out", "gh pr checks 1 2>&1")

    def test_the_documented_bare_commands_are_allowed_and_the_redirect_forms_refused_for_every_reviewer(self):
        for role in self.ROLES:
            with self.subTest(role=role):
                text, head, perms = self.front(role)
                for command in self.BARE:
                    self.assertEqual(self.verdict(perms, "shell", command), "allow", command)
                for command in self.REFUSED:
                    self.assertEqual(self.verdict(perms, "shell", command), "deny", command)
                self.assertIn("**bare**", text)
                self.assertIn("no pipe", text)
                self.assertIn("2>&1", text)
        skill = (REPO / "skills" / "fleet-review" / "SKILL.md").read_text()
        self.assertIn("**bare**", skill)
        self.assertIn("2>&1", skill)

    def test_the_skill_says_to_run_the_panel_at_the_head_and_to_give_the_full_command_forms(self):
        skill = " ".join((REPO / "skills" / "fleet-review" / "SKILL.md").read_text().split())
        self.assertIn("Run it from a checkout at the pull request's head", skill)
        self.assertIn("fleet-switchboard review laws owner/repo#N", skill)
        self.assertIn("gh pr diff N --repo owner/repo", skill)
        self.assertIn("a bare number is refused", skill)

    def test_the_reviewers_cannot_write_files_open_a_browser_run_an_external_program_or_read_credentials(self):
        for role in self.ROLES:
            with self.subTest(role=role):
                text, head, perms = self.front(role)
                denies = {(a, r) for a, r, e in perms if e == "deny"}
                for resource in ("git *--output*", "git *--ext-diff*", "git *--textconv*", "git *--no-index*", "gh pr view *--web*", "gh pr checks *--w*", "gh pr checks * -w*", "gh pr checks -w*", "*>*", "*>>*"):
                    self.assertIn(("shell", resource), denies, resource)
                self.assertIn(("external_directory", "*"), denies, "reads outside the checkout are denied")
                import fnmatch
                for probe in (">/tmp/x", "2>/tmp/x", "&>x", "gh pr view 1 >/tmp/zz", "gh pr view 1 > /tmp/zz", "git diff >>x"):
                    self.assertTrue(any(fnmatch.fnmatchcase(probe, r) for a, r in denies if a == "shell"), probe)
                for allowed in ("gh pr view 1", "git diff abc..def", "git log -5"):
                    self.assertFalse(any(fnmatch.fnmatchcase(allowed, r) for a, r in denies if a == "shell"), allowed)
                for resource in ("**/.env*", "**/*.pem", "**/*.key", "**/id_rsa*", "**/.ssh/**", "**/.aws/**", "**/.netrc", "**/.config/**",
                                 "**/*secret*", "**/*credential*"):
                    self.assertIn(("read", resource), denies, resource)
                last_allow = max(i for i, p in enumerate(perms) if p[2] == "allow")
                self.assertTrue(all(p[2] == "deny" for p in perms[last_allow + 1:]), "every one of these denies comes after the allows")
                self.assertNotIn("Read-only by construction", text)
                self.assertIn("holds no write command", head + text)

    def test_each_reviewer_states_the_budget_the_base_ref_rule_and_the_never_run_rule(self):
        for role in self.ROLES:
            with self.subTest(role=role):
                text = self.front(role)[0]
                for needle in ("**50 turns**", "about **35 tool calls**", "Past **40**", "`verdict: incomplete`", "Never approve when incomplete",
                               "from the pull request's base commit", "never build, run or test", "untrusted text", "cites none is a proposal",
                               "you return your verdict as text", "the coder session records it"):
                    self.assertIn(needle, text)
                self.assertNotIn("review record", text.split("\n---\n", 1)[1].replace("the coder session records it", ""), "the agent never runs the record command")
                self.assertIn("never the copies in the change under review", text)
        impact = self.front("impact")[0]
        for needle in ("the matrix of REVIEW_LAWS.md", "impact-action:", "Judge likelihood at the scale the change will run", "never apply a label"):
            self.assertIn(needle, impact)

    def test_the_installer_installs_the_four_reviewers_with_the_model_filled_in(self):
        self.assertEqual([n for n in sb.KIT_AGENTS if n.startswith("reviewer-")], ["reviewer-%s" % r for r in self.ROLES])
        config = self.home / "profile"
        sb.install_agents(config, sb.STANDARD_MODEL, REPO)
        for role in self.ROLES:
            text = (config / "agents" / ("reviewer-%s.md" % role)).read_text()
            self.assertIn("model: " + sb.STANDARD_MODEL, text)
            self.assertNotIn("__PROVIDER__", text)

    def test_the_review_skill_tells_the_coder_to_run_the_reviewers_before_offering_the_pr(self):
        self.assertIn("fleet-review", sb.kit_skill_names(REPO))
        text = (REPO / "skills" / "fleet-review" / "SKILL.md").read_text()
        head = text.split("---\n")[1]
        self.assertRegex(head, r"(?m)^name: fleet-review$")
        self.assertRegex(head, r"(?m)^description: .*about to mark it ready")
        for role in self.ROLES:
            self.assertIn("reviewer-" + role, text)
        for needle in ("--block", "returns its verdict as text", "You record what they returned", "before you offer it", "from the pull request's base commit", "never builds, runs or tests",
                       "never replaces the independent review agent's verdict", "a push voids the earlier records"):
            self.assertIn(needle, text)

    # -- review laws: the base commit, never the head

    def test_the_laws_come_from_the_base_commit_and_never_the_pr_head(self):
        code, out, err = self.review("coder", "laws", self.PR)
        self.assertEqual(code, 0, err)
        self.assertIn("base text of REVIEW_LAWS.md", out)
        self.assertNotIn("EDITED BY THE PR HEAD", out)
        self.assertIn("at the base commit %s" % self.BASE[:12], out)
        self.assertTrue(self.contents_calls)
        self.assertTrue(all(c.endswith("ref=" + self.BASE) for c in self.contents_calls), self.contents_calls)
        self.assertNotIn("REVIEW_OVERLAY.md", out, "no overlay in the repository: none shown")
        self.assertIn("not at the base commit: REVIEW_OVERLAY.md", err)

    def test_a_repository_overlay_and_a_local_overlay_are_shown_after_the_laws(self):
        self.contents[("REVIEW_OVERLAY.md", self.BASE)] = "extra law: no new dependencies\n"
        overlay = self.home / "xdg-config" / "fleet-switchboard" / "review-overlay"
        overlay.mkdir(parents=True)
        (overlay / "acme__app.md").write_text("operator note: be strict on migrations\n")
        code, out, err = self.review("coder", "laws", self.PR)
        self.assertEqual(code, 0, err)
        self.assertLess(out.index("base text of REVIEW_LAWS.md"), out.index("extra law: no new dependencies"))
        self.assertLess(out.index("extra law: no new dependencies"), out.index("operator note: be strict on migrations"))
        self.assertIn("local overlay for acme/app (kept outside the repository)", out)

    def test_no_laws_at_the_base_or_an_unknown_base_is_refused_with_the_way_out(self):
        self.contents = {}
        code, out, err = self.review("coder", "laws", self.PR)
        self.assertEqual(code, 2)
        self.assertIn("review-laws install", err)
        self.pr.pop("baseRefOid")
        code, out, err = self.review("coder", "laws", self.PR)
        self.assertEqual(code, 2)
        self.assertIn("base commit is unknown", err)

    # -- review laws: a bare pull request number (#1124)

    def in_clone(self, url):
        """chdir to a fresh git directory whose origin is `url` (None: no remote at all)."""
        root = Path(tempfile.mkdtemp())
        self.addCleanup(shutil.rmtree, root, True)
        subprocess.run(["git", "init", "-q", str(root)], check=True)
        if url:
            subprocess.run(["git", "-C", str(root), "config", "remote.origin.url", url], check=True)
        old = os.getcwd()
        os.chdir(root)
        self.addCleanup(os.chdir, old)

    def laws_repos(self, ref):
        """(code, err, the repositories the law files were read from) for `review laws <ref>`."""
        del self.contents_calls[:]
        code, out, err = self.review("coder", "laws", ref)
        return code, err, sorted({c.split("/contents/")[0] for c in self.contents_calls})

    def test_review_laws_takes_a_bare_number_hash_number_short_form_and_url_alike(self):
        self.in_clone("https://github.com/acme-org/widget-service.git")
        for ref in ("1234", "#1234", "acme-org/widget-service#1234", "https://github.com/acme-org/widget-service/pull/1234"):
            with self.subTest(ref=ref):
                code, err, repos = self.laws_repos(ref)
                self.assertEqual((code, repos), (0, ["repos/acme-org/widget-service"]), err)

    def test_a_bare_number_resolves_against_the_working_directory_remote_never_the_configured_default(self):
        self.in_clone("git@github.com:acme-org/widget-service.git")
        self.assertEqual(sb.load_config(self.world.config_path)["intent_repo"] if hasattr(self.world, "config_path") else "acme/app", "acme/app")
        with mock.patch.object(sb, "origin_repository", wraps=sb.origin_repository) as origin:
            code, err, repos = self.laws_repos("1234")
        self.assertEqual((code, repos), (0, ["repos/acme-org/widget-service"]), err)
        self.assertNotIn("repos/acme/app", repos)
        self.assertEqual(origin.call_count, 1)

    def test_a_bare_number_with_no_remote_or_naming_no_pull_request_is_refused_saying_what_to_pass(self):
        self.in_clone(None)
        code, err, repos = self.laws_repos("1234")
        self.assertEqual((code, repos), (2, []))
        self.assertIn("owner/repo#N", err)
        self.in_clone("https://github.com/acme-org/widget-service")
        real = self.route
        def none_found(argv, **kw):
            if argv[0] == FAKE_GH and argv[1:3] == ["pr", "view"]:
                return subprocess.CompletedProcess(argv, 1, "", "GraphQL: Could not resolve to a PullRequest with the number of 1234. (repository.pullRequest)")
            return real(argv, **kw)
        self.route = none_found
        code, err, repos = self.laws_repos("1234")
        self.assertNotEqual(code, 0)
        self.assertIn("owner/repo#N", err)

    def test_text_that_is_not_a_number_is_not_taken_for_one(self):
        self.in_clone("https://github.com/acme-org/widget-service")
        for ref in ("12abc", "0", "#", "1234 5", "pull/1234"):
            with self.subTest(ref=ref):
                code, err, repos = self.laws_repos(ref)
                self.assertEqual((code, repos), (2, []), err)
                self.assertIn("owner/repo#N", err)

    def test_the_long_forms_print_what_they_always_did(self):
        self.in_clone(None)
        outs = []
        for ref in ("acme/app#9", "https://github.com/acme/app/pull/9"):
            code, out, err = self.review("coder", "laws", ref)
            self.assertEqual(code, 0, err)
            outs.append(out)
        self.assertEqual(outs[0], outs[1])
        self.assertIn("at the base commit %s" % self.BASE[:12], outs[0])
        self.assertIn("base text of REVIEW_LAWS.md", outs[0])

    def test_every_agent_that_names_review_laws_shows_the_bare_form_and_the_docs_list_the_four_forms(self):
        named = [p for p in (REPO / "agents").rglob("*.md") if "review laws <" in p.read_text()]
        self.assertTrue(named)
        self.assertEqual([p.name for p in named if "review laws <pr number>" not in p.read_text()], [])
        docs = (REPO / "docs" / "switchboard.md").read_text()
        self.assertEqual(docs.count("`review laws` takes four forms"), 1)

    def test_mutants_of_the_bare_number_parser_are_caught(self):
        good = sb.parse_bare_pr_ref
        self.in_clone("https://github.com/acme-org/widget-service")
        def rejects(text, directory=None):
            raise sb.NoticeError("rejected")
        def wrong_repo(text, directory=None):
            return "acme/app", int(text.lstrip("#"))
        def any_text(text, directory=None):
            return "acme-org/widget-service", int("".join(c for c in text if c.isdigit()) or 1)
        for name, mutant in (("rejects", rejects), ("wrong repository", wrong_repo), ("any text", any_text)):
            with self.subTest(mutant=name):
                failed = 0
                with mock.patch.object(sb, "parse_bare_pr_ref", mutant):
                    for case in ("test_review_laws_takes_a_bare_number_hash_number_short_form_and_url_alike",
                                 "test_a_bare_number_resolves_against_the_working_directory_remote_never_the_configured_default",
                                 "test_text_that_is_not_a_number_is_not_taken_for_one"):
                        result = unittest.TestResult()
                        type(self)(case).run(result)
                        failed += 0 if result.wasSuccessful() else 1
                self.assertGreaterEqual(failed, 1)
        self.assertIs(sb.parse_bare_pr_ref, good)

    def test_a_law_file_over_the_size_limit_is_cut_and_says_so(self):
        self.contents[("CODING_STANDARDS.md", self.BASE)] = "x" * (sb.REVIEW_FILE_MAX + 500)
        code, out, err = self.review("coder", "laws", self.PR)
        self.assertEqual(code, 0, err)
        self.assertIn("[cut at %d bytes]" % sb.REVIEW_FILE_MAX, out)

    # -- review record

    def test_a_reviewer_records_one_chained_entry_at_the_current_head(self):
        code, out, err = self.record("coder", "code", "request-changes", "--blocks", "2", "--notes", "1", "--summary", "a write can be torn")
        self.assertEqual(code, 0, err)
        self.assertIn("1 of 5 reviewers recorded", out)
        (entry,) = [e for e in self.ledger() if e["kind"] == "review_record"]
        self.assertEqual((entry["pr"], entry["head"], entry["reviewer"], entry["verdict"], entry["blocks"], entry["notes"], entry["by"]),
                         (self.PR, LEDGER_HEAD, "code", "request-changes", 2, 1, "coder"))
        self.assertNotIn("result", entry)
        self.assertIsNone(sb.plan_ledger.read_ledger(self.world.state)[1])
        self.assertTrue([e for e in self.world.audit() if e["event"] == "review.record"])

    def test_a_record_for_a_stale_head_a_bad_reviewer_or_an_inconsistent_verdict_is_refused_and_writes_nothing(self):
        cases = (("code", "approve", ("--head", "d" * 40), "is not the PR's head"),
                 ("code", "approve", ("--head", "abc"), "is not the PR's head"),
                 ("tester", "approve", (), "--reviewer must be one of"),
                 ("code", "yes", (), "--verdict must be one of"),
                 ("code", "approve", ("--blocks", "1"), "cannot carry blocking findings"),
                 ("code", "approve", ("--impact-action", "hold"), "belongs to the impact reviewer"),
                 ("code", "approve", ("--blocks", "999"), "from 0 to 200"))
        for reviewer, verdict, more, needle in cases:
            with self.subTest(more=more, needle=needle):
                code, out, err = self.review("coder", "record", self.PR, "--reviewer", reviewer, "--verdict", verdict, *more)
                self.assertEqual(code, 2)
                self.assertIn(needle, err)
        self.assertEqual([e for e in self.ledger() if e["kind"] == "review_record"], [])

    def test_the_impact_reviewer_records_its_action_and_an_unknown_identity_is_refused(self):
        code, out, err = self.record("coder", "impact", "comment", "--impact-action", "second-review", "--notes", "1")
        self.assertEqual(code, 0, err)
        self.assertEqual([e for e in self.ledger() if e["kind"] == "review_record"][0]["impact_action"], "second-review")
        with mock.patch.object(sb, "gates_caller_kind", lambda *a, **k: ("unknown", "an uncertain identity")):
            code, out, err = self.record("coder", "code")
        self.assertEqual(code, 2)
        self.assertIn("uncertain identity", err)

    def test_the_latest_record_per_reviewer_at_the_head_counts(self):
        self.record("coder", "code", "request-changes", "--blocks", "1")
        self.record("coder", "code", "approve")
        got = sb.plan_ledger.review_records_at(self.ledger(), self.PR, LEDGER_HEAD)
        self.assertEqual((got["recorded"], got["missing"]), ({"code": "approve"}, ["architecture", "security", "impact", "test"]))

    def blockers(self, *more, head=None):
        with captured() as (out, err):
            code = sb.main(["review", "blockers", self.PR] + (["--head", head] if head else []) + list(more), runner=self.route,
                           now=self.world.clock.now, wait=lambda sock, seconds: False, socket_call=self.world.herdr.socket)
        return code, out.getvalue(), err.getvalue()

    def test_review_blockers_lists_only_the_reviewers_whose_latest_record_at_the_head_is_request_changes(self):
        self.record("coder", "code", "request-changes", "--blocks", "2")
        self.record("coder", "security", "request-changes", "--blocks", "1")
        self.record("coder", "security", "approve")                          # supersedes its own earlier block
        self.record("coder", "test", "request-changes", "--blocks", "1", "--head", LEDGER_HEAD)
        sb.plan_ledger.append_entry(self.world.state, {"kind": "review_record", "pr": self.PR, "head": LEDGER_NEW_HEAD, "reviewer": "architecture",
                                                       "verdict": "request-changes", "blocks": 1, "notes": 0, "by": "coder", "summary": "x"}, 1)
        sb.plan_ledger.append_entry(self.world.state, {"kind": "review_record", "pr": "acme/app#99", "head": LEDGER_HEAD, "reviewer": "impact",
                                                       "verdict": "request-changes", "blocks": 1, "notes": 0, "by": "coder", "summary": "x"}, 2)
        code, out, err = self.blockers()
        self.assertEqual(code, 0, err)
        self.assertEqual(out.splitlines(), ["code recorded request-changes (2 blocking finding(s)) at " + LEDGER_HEAD[:8],
                                            "test recorded request-changes (1 blocking finding(s)) at " + LEDGER_HEAD[:8]])
        code, out, err = self.blockers(head=LEDGER_NEW_HEAD)                  # another head: only what was recorded for THAT head
        self.assertEqual(out.splitlines(), ["architecture recorded request-changes (1 blocking finding(s)) at " + LEDGER_NEW_HEAD[:8]])

    def test_review_blockers_prints_nothing_for_a_clean_pr_and_refuses_an_untrustworthy_ledger_and_writes_nothing(self):
        ledger = self.world.state / "plan-ledger.jsonl"
        code, out, err = self.blockers()
        self.assertEqual((code, out), (0, ""))
        self.record("coder", "code", "request-changes", "--blocks", "1")
        before = ledger.read_text()
        code, out, err = self.blockers()                                       # the happy path wrote nothing
        self.assertEqual(code, 0)
        self.assertEqual(ledger.read_text(), before)
        ledger.write_text(before.replace("request-changes", "approve-ish"))   # tampered: the chain breaks
        tampered = ledger.read_text()
        code, out, err = self.blockers()
        self.assertEqual(code, 2)
        self.assertIn("ledger is not trustworthy", err)
        self.assertEqual(ledger.read_text(), tampered, "the refused path wrote nothing either")

    # -- the coder session records what a reviewer returned

    def block_text(self, verdict="request-changes", head=None, extra="", findings=("R-CODE-3 | block | src/q.py:4 | a write can be torn | use a temp file",
                                                                                   "R-TEST-2 | note | tests/t.py:9 | asserts nothing | assert the value")):
        return ("review done\n```\nverdict: %s\nhead: %s\n%sfindings:\n%s\n```\n" % (
            verdict, head or LEDGER_HEAD, extra, "\n".join("- " + f for f in findings)))

    def record_block(self, who, reviewer, text, *more):
        os.environ["HERDR_PANE_ID"] = self.world.panes[who]
        with captured() as (out, err), mock.patch.object(sb, "owner_terminal_problem", lambda *a, **k: None), \
                mock.patch.object(sys, "stdin", io.StringIO(text)):
            code = sb.main(["review", "record", self.PR, "--reviewer", reviewer, "--block", "-", *more], runner=self.route,
                           now=self.world.clock.now, wait=lambda sock, seconds: False, socket_call=self.world.herdr.socket)
        return code, out.getvalue(), err.getvalue()

    def test_the_coder_records_a_returned_block_and_the_counts_come_from_its_findings(self):
        code, out, err = self.record_block("coder", "code", self.block_text())
        self.assertEqual(code, 0, err)
        (entry,) = [e for e in self.ledger() if e["kind"] == "review_record"]
        self.assertEqual((entry["reviewer"], entry["verdict"], entry["blocks"], entry["notes"], entry["head"], entry["by"]),
                         ("code", "request-changes", 1, 1, LEDGER_HEAD, "coder"))

    def test_a_blocking_finding_that_cites_no_rule_counts_as_a_note_and_the_verdict_is_recorded_as_given_marked_uncited(self):
        code, out, err = self.record_block("coder", "code", self.block_text("request-changes", findings=("no rule here | block | a.py:1 | vague | fix it",)))
        self.assertEqual(code, 0, err)
        (entry,) = [e for e in self.ledger() if e["kind"] == "review_record"]
        self.assertEqual((entry["verdict"], entry["blocks"], entry.get("uncited")), ("request-changes", 0, True))
        code, out, err = self.record_block("coder", "code", self.block_text("comment", findings=("no rule here | block | a.py:1 | vague | fix it",)))
        self.assertEqual(code, 0, err)
        self.assertEqual([(e["blocks"], e["notes"]) for e in self.ledger() if e["kind"] == "review_record"], [(0, 1), (0, 1)])

    def test_the_impact_block_carries_its_action_and_a_block_for_another_head_or_a_malformed_one_is_refused(self):
        code, out, err = self.record_block("coder", "impact", self.block_text("comment", extra="impact-action: hold\n", findings=()))
        self.assertEqual(code, 2)
        self.assertIn("run the review again", err)
        self.assertEqual([e for e in self.ledger() if e["kind"] == "review_record"], [])
        code, out, err = self.record_block("coder", "impact", self.block_text("comment", extra="impact-action: hold\nimpact-class: data\n", findings=()))
        self.assertEqual(code, 0, err)
        self.assertEqual([e["impact_action"] for e in self.ledger() if e["kind"] == "review_record"], ["hold"])
        cases = ((self.block_text(head="d" * 40), "is not the PR's head"),
                 ("no block at all", "no `verdict:` line"),
                 (self.block_text("maybe"), "no `verdict:` line"),
                 ("verdict: approve\nfindings:\n", "no `head: <sha>` line"),
                 (self.block_text("comment", extra="impact-action: sideways\n"), "impact-action"),
                 ("", "no verdict block"))
        for text, needle in cases:
            with self.subTest(needle=needle):
                code, out, err = self.record_block("coder", "impact", text)
                self.assertEqual(code, 2)
                self.assertIn(needle, err)
        code, out, err = self.record_block("coder", "code", self.block_text("comment", extra="impact-action: hold\n"))
        self.assertIn("belongs to the impact reviewer", err)
        self.assertEqual(len([e for e in self.ledger() if e["kind"] == "review_record"]), 1)

    def test_block_takes_nothing_else_and_the_flag_form_is_still_there(self):
        code, out, err = self.record_block("coder", "code", self.block_text(), "--verdict", "approve")
        self.assertEqual(code, 2)
        self.assertIn(sb.BLOCK_TABLE_TEXT, err)
        self.assertEqual(self.record("coder", "code", "approve")[0], 0)

    # -- the shadow line

    def gates_text(self):
        code, out, err = self.run_as("coder", "gates", self.PR)
        self.assertIn(code, (0, 1), err)   # 1 is NOT READY: the shadow line is shown either way
        return out

    def test_gates_shows_how_many_of_the_five_recorded_at_the_head_and_a_push_voids_them(self):
        self.assertIn("reviewers (plan-review panel verdicts: shadow, not counted by any gate): 0 of 5 recorded at %s; missing code, architecture, security, impact, test" % LEDGER_HEAD[:8], self.gates_text())
        for role in self.ROLES:
            self.assertEqual(self.record("coder", role)[0], 0)
        self.assertIn("not counted by any gate): 5 of 5 recorded at %s: architecture approve, code approve, impact approve, security approve, test approve" % LEDGER_HEAD[:8], self.gates_text())
        self.pr["headRefOid"] = "c" * 40   # a push
        self.assertIn("not counted by any gate): 0 of 5 recorded at cccccccc", self.gates_text())

    # -- #892: the caption is true of the panel line alone, and the impact rating has its own line

    def rate_at_head(self, level, role, head=LEDGER_HEAD):
        cells = sb.impact_floor.load_matrix()["cells"]
        severity, probability = next((s, p) for s in cells for p in cells[s] if cells[s][p]["level"] == level)
        entry = {"kind": "review_record", "pr": self.PR, "head": head, "reviewer": "impact", "verdict": "approve", "blocks": 0, "notes": 0, "by": "rev", "by_role": role,
                 "impact_severity": severity, "impact_probability": probability, "impact_action": "none",
                 "block_sha256": "a" * 64, "block_size": 200, "block_impact_severity": severity, "block_impact_probability": probability}   # #901: the rating carries the agent's block, so the block scores it
        sb.plan_ledger.append_entry(self.world.state, entry, self.world.clock.now())

    def rating_lines(self):
        return [line.strip() for line in self.gates_text().splitlines() if "impact rating at" in line]

    def test_s1_the_shadow_caption_says_what_the_panel_line_is_and_nothing_about_the_independent_rating(self):
        self.record("coder", "code")
        text = self.gates_text()
        shadow = [line for line in text.splitlines() if line.strip().startswith("reviewers (")]
        self.assertEqual(len(shadow), 1)
        self.assertIn("plan-review panel verdicts: shadow, not counted by any gate", shadow[0])
        self.assertNotIn("not independent", text)

    def test_s2_a_counted_rating_is_named_with_its_level_and_that_its_role_counts(self):
        self.rate_at_head("Medium", "reviewer")
        lines = self.rating_lines()
        self.assertEqual(len(lines), 1)
        self.assertIn("Medium", lines[0])
        self.assertIn("counts", lines[0])
        self.assertNotIn("not counted", lines[0])

    def test_s3_s6_a_rating_by_a_role_that_does_not_count_is_recorded_not_counted_and_no_rating_is_said(self):
        self.assertEqual(self.rating_lines(), ["impact rating at %s: no impact rating recorded" % LEDGER_HEAD[:8]])
        self.rate_at_head("High", "coder")
        lines = self.rating_lines()
        self.assertEqual(len(lines), 1)
        self.assertIn("not counted", lines[0])
        self.assertNotIn("counts", lines[0])
        self.rate_at_head("Low", "reviewer", head="d" * 40)   # another head's rating is not this head's
        self.assertIn("not counted", self.rating_lines()[0])

    def rate_unscored(self, role, severity="Huge", probability="Remote"):
        entry = {"kind": "review_record", "pr": self.PR, "head": LEDGER_HEAD, "reviewer": "impact", "verdict": "approve", "blocks": 0, "notes": 0, "by": "rev", "by_role": role,
                 "impact_severity": severity, "impact_probability": probability, "impact_action": "none"}
        sb.plan_ledger.append_entry(self.world.state, entry, self.world.clock.now())

    def test_s3_a_counting_role_with_no_usable_score_is_not_told_as_a_role_that_does_not_count(self):
        self.rate_unscored("reviewer")   # an unknown cell: the role counts, the score does not
        line = self.rating_lines()[0]
        self.assertIn("recorded role counts", line)
        self.assertIn("no usable score", line)
        self.assertNotIn("not counted", line)

    def test_s3_the_four_shapes_read_differently_and_a_failed_read_is_unknown(self):
        said = {}
        said["none"] = self.rating_lines()[0]
        self.rate_unscored("coder", "Marginal", "Remote")   # a valid cell by a role that does not count
        said["not-role"] = self.rating_lines()[0]
        self.assertEqual(len(set(said.values())), 2)
        self.assertIn("not counted", said["not-role"])
        with mock.patch.object(sb.plan_ledger, "impact_rating_fact", side_effect=RuntimeError("boom")):
            self.assertIn("unknown", self.rating_lines()[0])   # a failure inside the reading is said as unknown, never raised out of `gates`
        with mock.patch.object(sb.impact_floor, "_matrix_cached", side_effect=RuntimeError("no matrix")):
            self.assertIn("unknown", self.rating_lines()[0])   # an exception never escapes `gates`

    def test_s3_every_unreadable_branch_says_unknown_and_never_no_rating_while_a_record_exists(self):
        self.rate_at_head("Medium", "reviewer")
        module = sb.load_module("delegated_clear")
        cases = {"the score block cannot be read": mock.patch.object(module, "score_block", return_value=None),
                 "the matrix has no cells": mock.patch.object(sb.impact_floor, "_matrix_cached", return_value={"cells": {}}),
                 "the matrix cannot be read": mock.patch.object(sb.impact_floor, "_matrix_cached", side_effect=RuntimeError("no matrix")),
                 "the scoring raises": mock.patch.object(module, "judge", side_effect=RuntimeError("boom")),
                 "the shaping raises": mock.patch.object(sb.plan_ledger, "impact_rating_fact", side_effect=RuntimeError("boom"))}
        for label, patch in cases.items():
            with self.subTest(branch=label), patch:
                lines = self.rating_lines()
                self.assertEqual(len(lines), 1, label)
                self.assertIn("unknown", lines[0], label)
                self.assertNotIn("no impact rating recorded", lines[0], label)
                self.assertNotIn("not counted", lines[0], label)

    def test_s4_s5_the_line_changes_no_gate_and_is_the_engines_own_reading(self):
        def gates():
            code, out, err = self.run_as("coder", "gates", self.PR, "--json")
            body = json.loads(out)
            return code, body["ready"], [(g["gate"], g["status"]) for g in body["gates"]], body["impact_rating"]
        before = gates()
        self.assertEqual(before[3], {"recorded": False})
        self.rate_at_head("Medium", "reviewer")
        after = gates()
        self.assertEqual(before[:3], after[:3])   # no exit code, readiness or gate status moved
        entries, _ = sb.impact_rating_entries(self.world.state, self.PR, LEDGER_HEAD)
        cells = sb.impact_floor.load_matrix()["cells"]
        top = entries[-1]
        self.assertEqual(after[3], {"recorded": True, "role_counts": True, "scored": True, "level": cells[top["impact_severity"]][top["impact_probability"]]["level"]})

    def test_the_shadow_line_never_changes_whether_the_pr_is_ready(self):
        def ready():
            code, out, err = self.run_as("coder", "gates", self.PR, "--json")
            body = json.loads(out)
            return body["ready"], body["reviews"]
        before, reviews = ready()
        self.assertEqual(reviews["recorded"], {})
        for role in self.ROLES:
            self.record("coder", role, "request-changes", "--blocks", "1")   # even five requests for changes
        after, reviews = ready()
        self.assertEqual(before, after)
        self.assertEqual(len(reviews["recorded"]), 5)

    def test_the_docs_name_the_commands_and_the_agents(self):
        text = (REPO / "docs" / "switchboard.md").read_text()
        for needle in ("review laws", "review record", "reviewer-code", "reviewer-impact", "shadow"):
            self.assertIn(needle, text)

plan_review = _load("t_plan_review", BIN / "plan_review.py")


class TestReviewCheckout(LedgerBase):
    """#721: `review checkout` writes the PR's exact head tree, diff and base copies into .review/<head sha>, read-only; `--remove` undoes it;
    hostile trees (a symlink, `..`, a NUL, an absolute path, a huge file or tree) write nothing outside and leave nothing behind."""

    BASE = "b" * 40
    OLD_TIP = "c" * 40

    def setUp(self):
        super().setUp()
        self.pr = dict(self.pr, baseRefOid=self.BASE, baseRefName="main")
        self.rc = sb.load_module("review_checkout")
        self.work = Path(tempfile.mkdtemp())
        self.addCleanup(lambda: self.rc.remove_tree(str(self.work), force=True))
        self.outside = self.work / "outside"
        self.outside.mkdir()
        self.cwd = self.work / "cwd"
        self.cwd.mkdir()
        previous = os.getcwd()
        os.chdir(self.cwd)
        self.addCleanup(os.chdir, previous)
        self.blobs, self.trees, self.fetched = {}, {}, []
        self.base_tree = {"a.txt": "one\n", "b.txt": "two\n", "same.txt": "same\n"}
        self.head_tree = {"a.txt": "one changed\n", "b.txt": "two\n", "same.txt": "same\n", "new.txt": "new file\n"}
        self.extra_members, self.extra_entries, self.hidden, self.altered, self.truncated = [], [], set(), {}, False
        self.tip_tree = {"tip.txt": "the branch moved\n"}

    TOP = "acme-widget-" + LEDGER_HEAD[:7]

    def archive(self, tree, extra=(), top=None, gz=True):
        """A tarball like GitHub's: one top directory, then the files; `extra` are hostile members (name, kind, data, linkname)."""
        top = self.TOP if top is None else top
        buffer = io.BytesIO()
        with tarfile.open(fileobj=buffer, mode="w:gz" if gz else "w") as tar:
            def add(name, kind=tarfile.REGTYPE, data=b"", linkname=""):
                info = tarfile.TarInfo(name)
                info.type, info.linkname, info.size = kind, linkname, (len(data) if kind == tarfile.REGTYPE else 0)
                info.mode = 0o644
                tar.addfile(info, io.BytesIO(data) if kind == tarfile.REGTYPE else None)
            add(top + "/", tarfile.DIRTYPE)
            for path, text in tree.items():
                add(top + "/" + path, data=text.encode() if isinstance(text, str) else text)
            for name, kind, data, linkname in extra:
                add(name[1:] if name.startswith("=") else name if name.startswith(("/", "../")) else top + "/" + name, kind, data, linkname)
        return buffer.getvalue()

    def member(self, name, kind=tarfile.REGTYPE, data=b"x", linkname=""):
        return (name, kind, data, linkname)

    def entries(self, tree):
        out = []
        for path, text in tree.items():
            sha = hashlib.sha1(b"blob %d\x00" % len(text.encode()) + text.encode()).hexdigest()
            self.blobs[sha] = text
            out.append({"path": path, "type": "blob", "mode": "100644", "sha": sha, "size": len(text.encode())})
        return out

    def route(self, argv, **kwargs):
        if argv[0] == FAKE_GH and argv[1] == "api":
            path = argv[2]
            self.fetched.append(path)
            if "/compare/" in path:
                return subprocess.CompletedProcess(argv, 0, json.dumps({"merge_base_commit": {"sha": self.BASE}}), "")
            ball = re.search(r"/tarball/([0-9a-f]+)", path)
            if ball:
                table = {LEDGER_HEAD: self.head_tree, self.OLD_TIP: self.tip_tree}[ball.group(1)]
                if ball.group(1) == LEDGER_HEAD:   # what the tarball holds: export-ignore hides files, export-subst alters them
                    table = {k: self.altered.get(k, v) for k, v in table.items() if k not in self.hidden}
                return subprocess.CompletedProcess(argv, 0, self.archive(table, self.extra_members), b"")
            tree = re.search(r"/git/trees/([0-9a-f]+)", path)
            if tree:
                sha = tree.group(1)
                table = {self.BASE: self.base_tree, self.OLD_TIP: self.tip_tree, LEDGER_HEAD: self.head_tree}[sha]
                body = {"tree": self.entries(table) + (self.extra_entries if sha == LEDGER_HEAD else []), "truncated": sha == LEDGER_HEAD and self.truncated}
                return subprocess.CompletedProcess(argv, 0, json.dumps(body), "")
            blob = re.search(r"/git/blobs/([0-9a-f]+)", path)
            if blob:
                text = self.blobs[blob.group(1)]
                return subprocess.CompletedProcess(argv, 0, json.dumps({"encoding": "base64", "content": base64.b64encode(text.encode()).decode()}), "")
        return super().route(argv, **kwargs)

    def checkout(self, *more):
        return self.run_as("coder", "review", "checkout", self.PR, *more)

    def files(self, root):
        return sorted(str(p.relative_to(root)) for p in Path(root).rglob("*") if p.is_file())

    def made_nothing(self):
        self.assertEqual(os.listdir(self.cwd), [], "nothing left behind")

    def test_s1_the_directory_holds_the_head_files_the_diff_and_the_base_copies(self):
        code, out, err = self.checkout()
        self.assertEqual(code, 0, err)
        lines = out.strip().splitlines()
        self.assertEqual(len(lines), 1)
        root = Path(lines[0])
        self.assertEqual(root.name, LEDGER_HEAD[:12])
        self.assertEqual(root.parent.name, ".review")
        self.assertEqual(self.files(root / "head"), ["a.txt", "b.txt", "new.txt", "same.txt"])
        self.assertEqual(self.files(root / "base"), ["a.txt"], "the base copy of each touched file that existed there")
        self.assertEqual((root / "head" / "a.txt").read_text(), "one changed\n")
        diff = (root / "pr.diff").read_text()
        self.assertIn("-one\n+one changed", diff)
        self.assertIn("+++ b/new.txt", diff)
        self.assertNotIn("same.txt", diff)

    def test_1047_the_directory_holds_one_diff_per_changed_file_and_the_matrix_words(self):
        code, out, err = self.checkout()
        self.assertEqual(code, 0, err)
        root = Path(out.strip())
        self.assertEqual(self.files(root / "diffs"), ["a.txt.diff", "new.txt.diff"])
        self.assertIn("-one\n+one changed", (root / "diffs" / "a.txt.diff").read_text())
        self.assertEqual((root / "impact-matrix.txt").read_text(), "\n".join(sb.impact_matrix_lines(sb.impact_matrix_words())) + "\n")

    def test_1047_an_unreadable_matrix_leaves_the_checkout_without_the_matrix_file(self):
        with mock.patch.object(sb, "impact_matrix_words", side_effect=sb.impact_floor.MatrixError("unreadable")):
            code, out, err = self.checkout()
        self.assertEqual(code, 0, err)
        self.assertFalse((Path(out.strip()) / "impact-matrix.txt").exists())
        self.assertIn("impact matrix cannot be read", err)

    @unittest.skipIf(os.geteuid() == 0, "root can write anything")
    def test_s2_every_file_and_directory_is_read_only(self):
        code, out, err = self.checkout()
        self.assertEqual(code, 0, err)
        root = Path(out.strip())
        for name in ("head/a.txt", "head/new.txt", "pr.diff"):
            with self.subTest(name=name), self.assertRaises(PermissionError):
                open(root / name, "w")
        with self.assertRaises(PermissionError):
            (root / "head" / "x").write_text("x")

    def test_s3_remove_removes_its_own_directory_and_refuses_a_foreign_one(self):
        code, out, err = self.checkout()
        self.assertEqual(code, 0, err)
        root = out.strip()
        code, out, err = self.run_as("coder", "review", "checkout", "--remove", root)
        self.assertEqual(code, 0, err)
        self.assertFalse(os.path.exists(root))
        foreign = self.cwd / ".review" / ("d" * 12)
        foreign.mkdir(parents=True)
        (foreign / "keep.txt").write_text("mine")
        other = self.cwd / "other"
        other.mkdir()
        for target in (foreign, other, self.cwd):
            with self.subTest(target=str(target)):
                code, out, err = self.run_as("coder", "review", "checkout", "--remove", str(target))
                self.assertEqual(code, 1)
                self.assertTrue(target.is_dir())
        self.assertEqual((foreign / "keep.txt").read_text(), "mine")

    def test_s8_remove_restores_the_permissions_it_set_and_leaves_nothing(self):
        code, out, err = self.checkout()
        self.assertEqual(code, 0, err)
        root = Path(out.strip())
        self.assertEqual(stat.S_IMODE(root.stat().st_mode), 0o555)
        code, out, err = self.run_as("coder", "review", "checkout", "--remove", str(root))
        self.assertEqual(code, 0, err)
        self.made_nothing()

    def test_s4_a_symlink_is_skipped_and_the_hostile_paths_are_refused_by_name(self):
        secret = self.outside / "secret.txt"
        secret.write_text("outside")
        link = self.member("link", tarfile.SYMTYPE, linkname=str(secret))
        hard = self.member("hard", tarfile.LNKTYPE, linkname="a.txt")
        self.extra_members = [link, hard]
        code, out, err = self.checkout()
        self.assertEqual(code, 0, err)
        root = Path(out.strip())
        self.assertIn("'link'", err)
        self.assertIn("'hard'", err)
        self.assertFalse(any(p.is_symlink() for p in root.rglob("*")), "0 symlinks created")
        self.assertFalse((root / "head" / "link").exists() or (root / "head" / "hard").exists())
        self.run_as("coder", "review", "checkout", "--remove", str(root))
        hostile = ["../up.txt", "/abs.txt", "a/../../b.txt"]
        self.extra_members = [link] + [self.member(p) for p in hostile]
        code, out, err = self.checkout()
        self.assertEqual(code, 1)
        for name in ("up.txt", "abs.txt", "b.txt"):
            self.assertIn(name, err)
        self.assertIn("'link'", err)
        self.made_nothing()
        self.assertEqual(os.listdir(self.outside), ["secret.txt"])
        self.assertEqual(secret.read_text(), "outside")
        self.assertFalse((self.cwd.parent / "up.txt").exists() or (self.cwd / "up.txt").exists())

    def test_a_nul_in_a_member_name_is_refused(self):
        self.assertIn("NUL", self.rc.bad_path("nul\x00.txt"))
        buffer = io.BytesIO()
        with tarfile.open(fileobj=buffer, mode="w:gz", format=tarfile.PAX_FORMAT) as tar:
            top = tarfile.TarInfo(self.TOP)
            top.type = tarfile.DIRTYPE
            tar.addfile(top)
            info = tarfile.TarInfo(self.TOP + "/nul.txt")
            info.size = 1
            info.pax_headers = {"path": self.TOP + "/nul\x00.txt"}
            tar.addfile(info, io.BytesIO(b"x"))
        plain = self.route
        self.route = lambda argv, **kw: (subprocess.CompletedProcess(argv, 0, buffer.getvalue(), b"") if "/tarball/" in " ".join(argv) else plain(argv, **kw))
        code, out, err = self.checkout()
        self.assertEqual(os.listdir(self.outside), [])
        self.assertEqual(code, 1, err)
        self.assertIn("NUL", err)
        self.made_nothing()

    def test_s9_a_tree_whose_only_path_escapes_writes_no_file_outside(self):
        self.head_tree, self.base_tree = {}, {}
        self.extra_members = [self.member("../escape")]
        code, out, err = self.checkout()
        self.assertEqual(code, 1)
        self.assertFalse((self.cwd.parent / "escape").exists())
        self.assertFalse((self.cwd / "escape").exists())
        self.made_nothing()

    def test_s4_the_head_tree_is_one_archive_call_and_no_blob_call_per_file(self):
        self.head_tree = {"dir%d/f%d.txt" % (i % 5, i): "content %d\n" % i for i in range(50)}
        self.base_tree = dict(self.head_tree)
        code, out, err = self.checkout()
        self.assertEqual(code, 0, err)
        root = Path(out.strip())
        self.assertEqual(len([p for p in self.fetched if "/tarball/" in p]), 1)
        self.assertEqual([p for p in self.fetched if "/git/blobs/" in p], [])
        self.assertEqual(len(self.files(root / "head")), 50)
        for path, text in self.head_tree.items():
            self.assertEqual((root / "head" / path).read_text(), text)

    def test_export_ignore_and_export_subst_never_make_the_checkout_fewer_or_different_from_the_tree(self):
        self.head_tree = {"keep%d.txt" % i: "k%d\n" % i for i in range(16)}
        self.head_tree.update({"hidden%d.sh" % i: "evil %d\n" % i for i in range(25)})   # 41 files in the tree
        self.base_tree = {}
        self.hidden = {"hidden%d.sh" % i for i in range(25)}   # only 16 in the tarball
        self.altered = {"keep3.txt": "$Format:%H$ expanded\n"}
        code, out, err = self.checkout()
        self.assertEqual(code, 0, err)
        root = Path(out.strip())
        self.assertEqual(len(self.files(root / "head")), 41)
        self.assertEqual((root / "head" / "hidden7.sh").read_text(), "evil 7\n")
        self.assertEqual((root / "head" / "keep3.txt").read_text(), "k3\n", "the tree's blob, not the substituted text")
        self.assertIn("26 of 41 files were not in the archive", err)
        marker = json.loads((root / ".fleet-review-checkout").read_text())
        self.assertEqual(len(marker["from_blob_api"]), 26)
        self.assertEqual(marker["altered_in_archive"], ["keep3.txt"])

    def test_a_file_in_the_archive_that_the_tree_does_not_list_is_refused(self):
        self.extra_members = [self.member("planted.sh")]
        code, out, err = self.checkout()
        self.assertEqual(code, 1)
        self.assertIn("does not list", err)
        self.made_nothing()

    def test_a_truncated_tree_is_refused_with_the_limit(self):
        self.truncated = True
        code, out, err = self.checkout()
        self.assertEqual(code, 2, err)
        self.assertIn("too large", err)
        self.made_nothing()

    def test_a_hostile_archive_is_refused_by_shape_and_writes_nothing_outside(self):
        big = b"y" * 100
        shapes = {
            "dot git": ([self.member(n) for n in (".git/config", ".GIT/config", ".Git/hooks/x", "a/.gIt/config")], 1, ".git component"),
            "oversize member": ([self.member("huge.bin", data=big)], 2, "bytes for one file"),
            "too many members": ([self.member("m%d" % i) for i in range(30)], 2, "files"),
            "duplicate names": ([self.member("dup.txt"), self.member("dup.txt")], 1, "twice"),
            "outside the top directory": ([self.member("=other-top/x.txt")], 1, "single top directory"),
        }
        for label, (members, want, snippet) in shapes.items():
            with self.subTest(label), mock.patch.object(self.rc, "MAX_FILE_BYTES", 50 if "oversize" in label else 5 * 1024 * 1024), \
                    mock.patch.object(self.rc, "MAX_FILES", 20 if "many" in label else 5000):
                self.extra_members = members
                code, out, err = self.checkout()
                self.assertEqual(code, want, err)
                self.assertIn(snippet, err)
                self.made_nothing()
                self.assertEqual(os.listdir(self.outside), [])

    def test_a_bomb_is_stopped_by_its_header_before_any_byte_is_written(self):
        written = []
        real = self.rc.write_file
        self.extra_members = [self.member("bomb.bin", data=b"\x00" * (6 * 1024 * 1024))]   # compresses to a few KB; its header says 6 MiB
        reads = []
        real_extract = tarfile.TarFile.extractfile
        with mock.patch.object(self.rc, "write_file", lambda root, rel, data: written.append(rel) or real(root, rel, data)), \
                mock.patch.object(tarfile.TarFile, "extractfile", lambda tf, m: reads.append(m.name) or real_extract(tf, m)):
            code, out, err = self.checkout()
        self.assertEqual(code, 2, err)
        self.assertNotIn("bomb.bin", reads, "the body is never read once the header is over the bound")
        self.assertNotIn("bomb.bin", [w for w in written])
        self.made_nothing()

    def test_a_skipped_member_with_a_huge_declared_size_is_still_bounded(self):
        self.extra_members = [self.member("fifo", tarfile.FIFOTYPE), self.member("sparse-ish.bin", data=b"\x00" * 400)]
        with mock.patch.object(self.rc, "MAX_TOTAL_BYTES", 100):
            plain = self.route
            self.route = lambda argv, **kw: plain(argv, **kw)
            self.head_tree, self.base_tree = {}, {}
            code, out, err = self.checkout()
        self.assertEqual(code, 2, err)
        self.assertIn("in total", err)
        self.made_nothing()

    def test_the_marker_is_written_first_and_a_kill_after_the_first_file_leaves_a_removable_directory(self):
        order = []
        real = self.rc.write_file

        def spy(root, rel, data):
            order.append(rel)
            if rel == "a.txt":   # the first tree file is on disk, then the process dies
                real(root, rel, data)
                raise KeyboardInterrupt
            return real(root, rel, data)
        with mock.patch.object(self.rc, "write_file", spy):
            with self.assertRaises(KeyboardInterrupt):
                self.checkout()
        self.assertEqual(order[0], self.rc.MARKER)
        self.assertEqual(self.rc.MARKER, ".fleet-review-checkout")
        # a hard kill leaves what was on disk at that moment: marker plus one file; --remove takes it
        d = Path(os.path.realpath(self.cwd)) / ".review" / LEDGER_HEAD[:12]
        d.mkdir(parents=True)
        (d / ".fleet-review-checkout").write_text(json.dumps({"tool": "fleet-switchboard review checkout", "head": LEDGER_HEAD}))
        (d / "head").mkdir()
        (d / "head" / "a.txt").write_text("one")
        code, out, err = self.run_as("coder", "review", "checkout", "--remove", str(d))
        self.assertEqual(code, 0, err)
        self.assertEqual(self.files(self.cwd), [])

    def test_a_failure_on_the_first_file_leaves_nothing_or_a_marker_only_directory(self):
        real = self.rc.write_file

        def boom(root, rel, data):
            if rel != self.rc.MARKER:
                raise self.rc.Unsafe("first file fails")
            return real(root, rel, data)
        with mock.patch.object(self.rc, "write_file", boom):
            code, out, err = self.checkout()
        self.assertEqual(code, 1)
        self.made_nothing()   # the failure path removes everything it made, marker included

    def test_an_interrupted_checkout_removes_what_it_made(self):
        real = self.rc.write_file

        def die_after_first(root, rel, data):
            real(root, rel, data)
            if rel == "a.txt":
                raise KeyboardInterrupt
        with mock.patch.object(self.rc, "write_file", die_after_first), self.assertRaises(KeyboardInterrupt):
            self.checkout()
        self.made_nothing()

    def test_an_unreadable_archive_a_failed_gh_and_an_oversize_archive_leave_nothing(self):
        plain = self.route
        for label, answer in (("garbage", subprocess.CompletedProcess([], 0, b"not a tarball", b"")),
                              ("truncated", subprocess.CompletedProcess([], 0, self.archive(self.head_tree)[:60], b"")),
                              ("gh failed", subprocess.CompletedProcess([], 1, b"", b"gh: boom")),
                              ("not found", subprocess.CompletedProcess([], 1, b"", b"gh: Not Found (HTTP 404)"))):
            with self.subTest(label):
                self.route = lambda argv, answer=answer, **kw: (answer if "/tarball/" in " ".join(argv) else plain(argv, **kw))
                code, out, err = self.checkout()
                self.assertEqual(code, 1, err)
                self.made_nothing()
        self.route = plain
        with mock.patch.object(self.rc, "MAX_TOTAL_BYTES", -16 * 1024 * 1024):   # the archive limit is then 0 bytes: any archive is over it
            code, out, err = self.checkout()
        self.assertIn(code, (1, 2), err)
        self.made_nothing()

    def test_the_writer_refuses_a_symlinked_directory_in_the_way(self):
        root = self.work / "root"
        root.mkdir()
        os.symlink(str(self.outside), str(root / "dir"))
        with self.assertRaises(self.rc.Unsafe):
            self.rc.write_file(str(root), "dir/file.txt", b"x")
        self.assertEqual(os.listdir(self.outside), [])

    def test_s5_a_file_over_the_size_bound_and_a_tree_over_the_count_bound_are_refused_with_the_limit(self):
        for name, value, snippet in (("MAX_FILE_BYTES", 5, "limit of 5 bytes"), ("MAX_FILES", 2, "limit of 2 files")):
            with self.subTest(bound=name), mock.patch.object(self.rc, name, value):
                code, out, err = self.checkout()
                self.assertEqual(code, 2, err)
                self.assertIn(snippet, err)
                self.assertRegex(err, r"\d+ (bytes|files)")
                self.made_nothing()
        with mock.patch.object(self.rc, "MAX_TOTAL_BYTES", 10):
            code, out, err = self.checkout()
            self.assertEqual(code, 2)
            self.assertIn("limit of 10 bytes in total", err)
            self.made_nothing()

    def test_s6_the_tree_is_the_head_asked_for_and_never_the_branch_tip(self):
        self.pr = dict(self.pr, headRefOid=self.OLD_TIP)   # the branch moved after the sha was given
        code, out, err = self.checkout("--head", LEDGER_HEAD)
        self.assertEqual(code, 0, err)
        root = Path(out.strip())
        self.assertEqual(root.name, LEDGER_HEAD[:12])
        self.assertEqual((root / "head" / "a.txt").read_text(), "one changed\n")
        self.assertFalse((root / "head" / "tip.txt").exists())
        self.assertFalse(any(self.OLD_TIP in p for p in self.fetched if "/git/trees/" in p or "/compare/" in p))

    def test_a_failed_compare_falls_back_to_the_base_commit_aloud_and_in_the_marker(self):
        plain = self.route
        self.route = lambda argv, **kw: (subprocess.CompletedProcess(argv, 1, "", "gh: boom") if "/compare/" in " ".join(argv) else plain(argv, **kw))
        code, out, err = self.checkout()
        self.assertEqual(code, 0, err)
        self.assertIn("merge base could not be read", err)
        marker = json.loads((Path(out.strip()) / ".fleet-review-checkout").read_text())
        self.assertTrue(marker["merge_base_fallback"])

    def test_remove_refuses_a_marker_that_is_malformed_or_names_another_head(self):
        for text in ("{not json", json.dumps({"tool": "fleet-switchboard review checkout", "head": 5}),
                     json.dumps({"tool": "fleet-switchboard review checkout", "head": "9" * 40})):
            with self.subTest(marker=text[:20]):
                d = self.cwd / ".review" / LEDGER_HEAD[:12]
                d.mkdir(parents=True)
                (d / ".fleet-review-checkout").write_text(text)
                code, out, err = self.run_as("coder", "review", "checkout", "--remove", str(d))
                self.assertEqual(code, 1)
                self.assertTrue(d.is_dir())
                shutil.rmtree(d)

    def test_a_dot_git_component_in_any_case_is_refused_and_nothing_is_written(self):
        for path in (".git/config", ".GIT/config", ".Git/hooks/x", "a/.git/config", ".git", "a/.GiT", ".git.", ".git ", ".g\u200bit/config", "GIT~1/config"):
            with self.subTest(path=path):
                self.extra_members = [self.member(path)]
                code, out, err = self.checkout()
                self.assertEqual(code, 1)
                self.assertIn(".git component", err)
                self.made_nothing()
        self.extra_members = []
        self.head_tree[".gitignore"] = "x"
        self.assertEqual(self.checkout()[0], 0, ".gitignore is not a .git component")

    def test_a_huge_file_skips_its_line_diff_fast_and_says_so_and_the_deadline_bounds_the_whole(self):
        self.base_tree = {"big.txt": "x\n" * 3}
        self.head_tree = {"big.txt": "y\n" * 1000000}
        started = time.monotonic()
        code, out, err = self.checkout()
        self.assertEqual(code, 0, err)
        self.assertLess(time.monotonic() - started, 20)
        self.assertIn("diff skipped: too large to compare here (1000000 lines)", (Path(out.strip()) / "pr.diff").read_text())
        self.run_as("coder", "review", "checkout", "--remove", out.strip())
        self.base_tree = {"c.txt": "".join("old %d\n" % i for i in range(3900))}   # just under the cap, every line different
        self.head_tree = {"c.txt": "".join("new %d\n" % i for i in range(3900))}
        started = time.monotonic()
        code, out, err = self.checkout()
        self.assertEqual(code, 0, err)
        self.assertLess(time.monotonic() - started, 10, "a diff just under the line cap stays fast")
        self.run_as("coder", "review", "checkout", "--remove", out.strip())
        with mock.patch.object(self.rc, "DIFF_SECONDS", -1):   # the time budget is spent: every file says so
            code, out, err = self.checkout()
            self.assertEqual(code, 0, err)
            self.assertIn("diff skipped", (Path(out.strip()) / "pr.diff").read_text())
        self.run_as("coder", "review", "checkout", "--remove", out.strip())
        with mock.patch.object(self.rc, "DEADLINE_SECONDS", -1):
            code, out, err = self.checkout()
            self.assertEqual(code, 2)
            self.assertIn("time limit", err)
            self.made_nothing()

    def test_a_directory_that_exists_is_not_overwritten(self):
        self.assertEqual(self.checkout()[0], 0)
        code, out, err = self.checkout()
        self.assertEqual(code, 1)
        self.assertIn("exists already", err)
        self.assertEqual(len(os.listdir(self.cwd / ".review")), 1)

    def test_s7_the_panel_brief_tells_reviewers_to_read_the_printed_directory_exactly_once(self):
        sentence = "tell each reviewer to read the directory it prints"
        text = (REPO / "skills" / "fleet-review" / "SKILL.md").read_text()
        self.assertEqual(text.count(sentence), 1)


class TestPlanReviewCore(unittest.TestCase):
    """#109 part 2, slice R1: the pure core of the plan review engine (docs/plan-review-engine-design.md). No I/O, no commands."""

    HELD = ["shims/**", "plugins/fleet-hooks/**", "bin/plan_ledger.py"]
    H1, H2 = "sha256:" + "a" * 64, "sha256:" + "b" * 64

    def lane(self, lane, verdict, plan_hash, objections=(), review="r1"):
        return {"kind": "lane", "review": review, "lane": lane, "verdict": verdict, "plan_hash": plan_hash,
                "objections": [dict(o) for o in objections]}

    def obj(self, oid, state="open", severity="blocking"):
        return {"id": oid, "severity": severity, "state": state, "text": "t"}

    # -- the tier

    def test_the_module_is_pure(self):
        tree = ast.parse((BIN / "plan_review.py").read_text())
        imported = {a.name for n in ast.walk(tree) if isinstance(n, ast.Import) for a in n.names}
        imported |= {n.module for n in ast.walk(tree) if isinstance(n, ast.ImportFrom)}
        self.assertEqual(imported, {"re", "unicodedata"}, "no file, network, clock or GitHub access in the pure core (unicodedata is a table lookup)")

    def test_an_ask_epic_or_cos_ask_is_always_full_and_a_request_only_raises(self):
        for kind in ("ask", "epic", "cos_ask"):
            self.assertEqual(plan_review.compute_tier(kind, [], self.HELD, tiny_under_reviewed=True)[0], "full")
        self.assertEqual(plan_review.compute_tier("work_item", [], self.HELD, ask_has_consensus=True)[0], "normal")
        self.assertEqual(plan_review.compute_tier("work_item", [], self.HELD, requested="full", ask_has_consensus=True)[0], "full")
        self.assertEqual(plan_review.compute_tier("work_item", [], self.HELD, requested="light", ask_has_consensus=True)[0], "normal")
        self.assertEqual(plan_review.compute_tier("ask", [], self.HELD, requested="light")[0], "full")

    def test_light_needs_a_tiny_item_under_a_reviewed_section_and_no_held_path(self):
        ok = dict(tiny_under_reviewed=True, ask_has_consensus=True)
        self.assertEqual(plan_review.compute_tier("work_item", ["docs/x.md"], self.HELD, **ok)[0], "light")
        self.assertEqual(plan_review.compute_tier("work_item", ["shims/gh"], self.HELD, **ok)[0], "full")
        self.assertEqual(plan_review.compute_tier("work_item", ["docs/x.md"], self.HELD, held_labels=True, **ok)[0], "full")

    def test_a_work_item_under_an_ask_with_no_consensus_inherits_the_asks_full_review(self):
        tier, why = plan_review.compute_tier("work_item", ["docs/x.md"], self.HELD, tiny_under_reviewed=True)
        self.assertEqual(tier, "full")
        self.assertIn("ask's own plan has no consensus", why)
        self.assertEqual(plan_review.compute_tier("work_item", ["docs/x.md"], self.HELD, ask_has_consensus=True)[0], "normal")

    def test_the_held_area_is_computed_from_paths_so_a_prose_claim_changes_nothing_and_splitting_hides_nothing(self):
        # the unit is every work item under one ask: one item names a held path, so the whole unit is full
        unit = ["docs/a.md"] + ["bin/plan_ledger.py"] + ["docs/b.md"]
        self.assertEqual(plan_review.compute_tier("work_item", unit, self.HELD, ask_has_consensus=True)[0], "full")
        self.assertEqual(plan_review.path_hits(["./shims/gh", "shims/x/y", "docs/shims.md", "plugins/fleet-hooks/a/b.js"], self.HELD),
                         ["./shims/gh", "plugins/fleet-hooks/a/b.js", "shims/x/y"])
        self.assertEqual(plan_review.path_hits(["bin/plan_ledger.pyc", "bin/x/plan_ledger.py"], self.HELD), [])
        dots = [".github/workflows/ci.yml", ".env", ".opencode/agents/x.md", "./.env", "/.github/a", "github/workflows/x", "docs/.env.md"]
        self.assertEqual(plan_review.path_hits(dots, [".github/**", ".env", ".opencode/**"]),
                         sorted(["./.env", "/.github/a", ".env", ".github/workflows/ci.yml", ".opencode/agents/x.md"]))
        self.assertEqual(plan_review.path_hits(["a/.github/x", ".hidden"], ["**/.github/**", ".hidden"]), [".hidden", "a/.github/x"])
        self.assertNotIn("areas", inspect.signature(plan_review.compute_tier).parameters, "no parameter for the planner's prose")

    def test_the_tier_is_rechecked_against_the_paths_actually_changed(self):
        self.assertEqual(plan_review.tier_mismatch("normal", ["shims/gh", "docs/a.md"], self.HELD), ["shims/gh"])
        self.assertEqual(plan_review.tier_mismatch("full", ["shims/gh"], self.HELD), [])
        self.assertEqual(plan_review.tier_mismatch("light", ["docs/a.md"], self.HELD), [])

    def test_the_lanes_of_each_tier(self):
        self.assertEqual(plan_review.lanes_for_tier("light"), ["L1", "L2"])
        self.assertEqual(plan_review.lanes_for_tier("normal"), ["L1", "L2", "L4"])
        self.assertEqual(plan_review.lanes_for_tier("normal", held_area=True), ["L1", "L2", "L3", "L4"])
        self.assertEqual(plan_review.lanes_for_tier("full"), ["L1", "L2", "L3", "L4", "L5", "L6"])

    # -- the lineage and the cap

    def rounds(self, count, closing=False):
        return [{"kind": "round", "review": "r%d" % i, "closing": closing} for i in range(count)]

    def test_the_lineage_key_is_the_ask_not_the_plan_source(self):
        self.assertEqual(plan_review.lineage_key("Acme/App", 7), "acme/app#7")

    def test_a_second_start_continues_the_count_and_cannot_reset_it(self):
        state = plan_review.lineage_state(self.rounds(2))
        state["open_review"] = False
        self.assertEqual(state["rounds"], 2)
        self.assertEqual(plan_review.may_start(state, self.H2), (True, None))
        state = plan_review.lineage_state(self.rounds(3))
        state["open_review"] = False
        ok, why = plan_review.may_start(state, self.H2)
        self.assertFalse(ok)
        self.assertIn("rounds are spent", why)

    def test_start_is_refused_for_an_open_review_an_undecided_escalation_and_a_plan_at_consensus(self):
        open_review = plan_review.lineage_state(self.rounds(1))
        self.assertIn("already open", plan_review.may_start(open_review, self.H1)[1])
        entries = self.rounds(3) + [{"kind": "escalation", "objection": "O1"}]
        escalated = plan_review.lineage_state(entries)
        escalated["open_review"] = False
        self.assertIn("undecided escalation", plan_review.may_start(escalated, self.H1)[1])
        done = plan_review.lineage_state([{"kind": "consensus", "plan_hash": self.H1}], self.H1)
        self.assertIn("consensus at its current hash", plan_review.may_start(done, self.H1)[1])

    def test_the_cap_is_three_a_closing_round_is_outside_it_and_a_fourth_is_refused(self):
        state = plan_review.lineage_state(self.rounds(3))
        self.assertEqual(plan_review.may_open_round(state), (False, "the rounds are spent"))
        self.assertEqual(plan_review.may_open_round(state, closing=True), (True, None))
        self.assertEqual(plan_review.lineage_state(self.rounds(5, closing=True))["rounds"], 0)
        self.assertEqual(plan_review.may_open_round(plan_review.lineage_state(self.rounds(2))), (True, None))

    def test_after_an_escalation_two_more_rounds_then_the_owner_decides(self):
        base = self.rounds(3) + [{"kind": "escalation", "objection": "O1"}]
        undecided = plan_review.lineage_state(base)
        self.assertFalse(plan_review.may_open_round(undecided)[0])
        decided = base + [{"kind": "decision", "objection": "O1", "action": "accept"}]
        self.assertEqual(plan_review.may_open_round(plan_review.lineage_state(decided)), (True, None))
        one = plan_review.lineage_state(decided + self.rounds(1))
        self.assertEqual((one["post_escalation_rounds"], plan_review.may_open_round(one)), (1, (True, None)))
        two = plan_review.lineage_state(decided + self.rounds(2))
        self.assertFalse(plan_review.may_open_round(two)[0])
        self.assertEqual(plan_review.may_open_round(two, closing=True), (True, None), "a closing round after an accept is outside the count")

    def test_only_lanes_with_blocking_objections_run_again_plus_l1_when_the_scenarios_changed(self):
        previous = [self.lane("L2", "iterate", self.H1, [self.obj("O1")]), self.lane("L3", "approve", self.H1),
                    self.lane("L4", "iterate", self.H1, [self.obj("O2", state="resolved")])]
        tier = plan_review.lanes_for_tier("full")
        self.assertEqual(plan_review.next_round_lanes(previous, tier, False), ["L2"])
        self.assertEqual(plan_review.next_round_lanes(previous, tier, True), ["L1", "L2"])
        self.assertEqual(plan_review.next_round_lanes(previous, ["L1", "L3"], False), [])

    def test_the_session_and_daily_budgets(self):
        self.assertTrue(plan_review.session_budget_ok(18, 6, 24))
        self.assertFalse(plan_review.session_budget_ok(19, 6, 24))
        self.assertTrue(plan_review.starts_today_ok(2, 3))
        self.assertFalse(plan_review.starts_today_ok(3, 3))

    # -- the tally

    def test_consensus_needs_an_approve_at_the_final_hash_from_every_lane_of_the_tier(self):
        lanes = plan_review.lanes_for_tier("normal")
        entries = [self.lane(l, "approve", self.H1) for l in lanes]
        self.assertEqual(plan_review.decide_consensus(entries, lanes, self.H1, rounds_left=True)[0], "consensus")
        self.assertEqual(plan_review.decide_consensus(entries[:-1], lanes, self.H1, rounds_left=True)[0], "pending")

    def test_a_revision_changed_after_a_lane_approved_gets_no_consensus_and_no_closing_round_means_none(self):
        lanes = ["L1", "L2"]
        earlier = [self.lane("L1", "approve", self.H1), self.lane("L2", "approve", self.H1)]
        verdict, why = plan_review.decide_consensus(earlier, lanes, self.H2, rounds_left=True)
        self.assertEqual(verdict, "pending")
        self.assertIn("no closing round, no consensus", why)
        closing = earlier + [self.lane("L1", "approve", self.H2)]
        self.assertEqual(plan_review.decide_consensus(closing, lanes, self.H2, rounds_left=True)[0], "pending")
        closing.append(self.lane("L2", "approve", self.H2))
        self.assertEqual(plan_review.decide_consensus(closing, lanes, self.H2, rounds_left=True)[0], "consensus")

    def test_a_blocking_objection_on_the_final_text_escalates_it_cannot_start_another_round(self):
        lanes = ["L1", "L2"]
        entries = [self.lane("L1", "approve", self.H2), self.lane("L2", "iterate", self.H2, [self.obj("O9")])]
        verdict, why = plan_review.decide_consensus(entries, lanes, self.H2, rounds_left=True)
        self.assertEqual(verdict, "escalate")
        self.assertIn("L2", why)

    def test_a_lane_wide_approve_is_silent_about_ids_it_does_not_mention_so_they_stay_open(self):
        lanes = ["L1", "L2"]
        entries = [self.lane("L2", "iterate", self.H1, [self.obj("O1")]), self.lane("L1", "approve", self.H2),
                   self.lane("L2", "approve", self.H2)]   # L2 approves round 2 without mentioning O1
        verdict, why = plan_review.decide_consensus(entries, lanes, self.H2, rounds_left=True)
        self.assertEqual(verdict, "pending")
        self.assertIn("L2/O1", why)
        entries.append(self.lane("L2", "approve", self.H2, [self.obj("O1", state="resolved")]))
        self.assertEqual(plan_review.decide_consensus(entries, lanes, self.H2, rounds_left=True)[0], "consensus")
        self.assertEqual(plan_review.survivors(entries[:1]), [("L2", "O1")])

    def test_each_objection_ends_in_an_explicit_state_a_rejection_must_be_accepted_by_its_lane(self):
        lanes = ["L1"]
        rejected = [self.lane("L1", "iterate", self.H1, [self.obj("O1")]), self.lane("L1", "approve", self.H2)]
        self.assertEqual(plan_review.decide_consensus(rejected, lanes, self.H2, rounds_left=True)[0], "pending")
        rejected.append(self.lane("L1", "approve", self.H2, [self.obj("O1", state="rejection_accepted")]))
        self.assertEqual(plan_review.decide_consensus(rejected, lanes, self.H2, rounds_left=True)[0], "consensus")

    def test_an_advisory_objection_never_blocks(self):
        entries = [self.lane("L1", "approve", self.H1, [self.obj("O1", severity="advisory")])]
        self.assertEqual(plan_review.decide_consensus(entries, ["L1"], self.H1, rounds_left=True)[0], "consensus")

    def test_who_may_override(self):
        person, boss = "person", "agent"
        self.assertEqual(plan_review.can_override("L3", False, person, False), (True, None))
        self.assertFalse(plan_review.can_override("L3", False, boss, True)[0], "the risk and security lane: only the owner")
        self.assertFalse(plan_review.can_override("L2", True, boss, True)[0], "a held-PR area: only the owner")
        self.assertEqual(plan_review.can_override("L2", False, boss, True), (True, None))
        self.assertFalse(plan_review.can_override("L2", False, boss, False)[0])


    # -- the review's repairs (#185 review)

    def test_after_a_consensus_an_edited_plan_can_be_reviewed_again_with_a_fresh_bounded_count(self):
        entries = self.rounds(3) + [{"kind": "consensus", "plan_hash": self.H1}]
        state = plan_review.lineage_state(entries, self.H2)
        self.assertEqual((state["rounds"], state["open_review"]), (0, False))
        self.assertEqual(plan_review.may_start(state, self.H2), (True, None))
        after = plan_review.lineage_state(entries + self.rounds(3), self.H2)
        after["open_review"] = False
        self.assertFalse(plan_review.may_start(after, self.H2)[0], "still bounded: 3 rounds since the consensus")
        self.assertEqual(plan_review.lineage_state(self.rounds(1) + [{"kind": "consensus", "plan_hash": self.H1}])["rounds"], 0)

    def test_an_unresolved_escalation_survives_only_until_a_consensus_and_open_objections_do_not_carry_past_one(self):
        entries = (self.rounds(3) + [self.lane("L2", "iterate", self.H1, [self.obj("O1")]), {"kind": "escalation", "objection": "L2/O1"}]
                   + [{"kind": "decision", "objection": "L2/O1", "action": "override"}, {"kind": "consensus", "plan_hash": self.H1,
                                                                                         "overridden_by": "owner"}])
        state = plan_review.lineage_state(entries)
        self.assertEqual((state["open_blocking"], state["undecided"], state["escalated"]), ([], [], False))
        self.assertEqual(state["overridden"], {self.H1: "owner"})
        undecided = plan_review.lineage_state(self.rounds(3) + [self.lane("L2", "iterate", self.H1, [self.obj("O1")]),
                                                                {"kind": "escalation", "objection": "L2/O1"}])
        self.assertEqual((undecided["open_blocking"], undecided["undecided"]), (["L2/O1"], ["L2/O1"]))

    def test_a_closing_round_is_bounded_once_per_hash_and_never_with_open_objections_or_an_undecided_escalation(self):
        clean = plan_review.lineage_state([{"kind": "round", "closing": False}])
        self.assertEqual(plan_review.may_open_round(clean, closing=True, plan_hash=self.H1), (True, None))
        once = plan_review.lineage_state([{"kind": "round", "closing": True, "plan_hash": self.H1}])
        self.assertIn("already ran", plan_review.may_open_round(once, closing=True, plan_hash=self.H1)[1])
        self.assertEqual(plan_review.may_open_round(once, closing=True, plan_hash=self.H2), (True, None))
        many = plan_review.lineage_state([{"kind": "round", "closing": True, "plan_hash": "sha256:%064d" % i} for i in range(3)])
        self.assertIn("closing rounds allowed", plan_review.may_open_round(many, closing=True, plan_hash=self.H2)[1])
        blocking = plan_review.lineage_state([self.lane("L2", "iterate", self.H1, [self.obj("O1")])])
        self.assertIn("still open", plan_review.may_open_round(blocking, closing=True, plan_hash=self.H2)[1])
        escalated = plan_review.lineage_state([{"kind": "escalation", "objection": "L2/O1"}])
        self.assertIn("undecided", plan_review.may_open_round(escalated, closing=True, plan_hash=self.H2)[1])
        done = plan_review.lineage_state([{"kind": "consensus", "plan_hash": self.H1}], self.H1)
        self.assertIn("already has a consensus", plan_review.may_open_round(done, closing=True, plan_hash=self.H1)[1])

    def test_an_objection_that_survives_the_last_round_escalates_it_is_never_left_pending(self):
        lanes = ["L1", "L2"]
        entries = [self.lane("L2", "iterate", self.H1, [self.obj("O1")]), self.lane("L1", "approve", self.H2),
                   self.lane("L2", "approve", self.H2)]   # an old-hash objection, then a silent lane-wide approve
        self.assertEqual(plan_review.decide_consensus(entries, lanes, self.H2, rounds_left=True)[0], "pending", "with rounds left it waits")
        verdict, why = plan_review.decide_consensus(entries, lanes, self.H2, rounds_left=False)
        self.assertEqual(verdict, "escalate")
        self.assertIn("L2/O1", why)
        verdict, why = plan_review.decide_consensus([self.lane("L1", "approve", self.H2)], lanes, self.H2, rounds_left=False)
        self.assertEqual(verdict, "pending", "a lane that has not answered yet is not a dissent: a closing round is how it is asked")
        verdict, why = plan_review.decide_consensus([self.lane("L1", "approve", self.H2), self.lane("L2", "reject", self.H2,
                                                    [self.obj("O2", severity="advisory")])], lanes, self.H2, rounds_left=False)
        self.assertEqual(verdict, "escalate")
        self.assertIn("L2", why)

    def test_a_consensus_never_clears_an_undecided_escalation_and_rounds_left_must_be_given(self):
        entries = (self.rounds(3) + [self.lane("L2", "iterate", self.H1, [self.obj("O1")]), {"kind": "escalation", "objection": "L2/O1"},
                                     {"kind": "consensus", "plan_hash": self.H2}])
        state = plan_review.lineage_state(entries)
        self.assertEqual((state["undecided"], state["escalated"], state["open_blocking"]), (["L2/O1"], True, ["L2/O1"]))
        self.assertFalse(plan_review.may_start(state, self.H1)[0])
        with self.assertRaises(TypeError):
            plan_review.decide_consensus([], ["L1"], self.H1)   # no default: an unknown is not read as "rounds remain"

    def test_a_lanes_latest_entry_at_the_final_hash_counts_a_later_reject_undoes_an_approve(self):
        entries = [self.lane("L1", "approve", self.H1), self.lane("L1", "reject", self.H1, [self.obj("O1", severity="advisory")])]
        self.assertEqual(plan_review.decide_consensus(entries, ["L1"], self.H1, rounds_left=True)[0], "pending")
        entries.append(self.lane("L1", "approve", self.H1))
        self.assertEqual(plan_review.decide_consensus(entries, ["L1"], self.H1, rounds_left=True)[0], "consensus")

    def test_an_abandoned_review_clears_the_open_review_and_the_count_continues(self):
        entries = self.rounds(2) + [{"kind": "abandoned", "by": "cos", "reason": "the ask was withdrawn"}]
        state = plan_review.lineage_state(entries)
        self.assertEqual((state["open_review"], state["rounds"]), (False, 2))
        self.assertEqual(plan_review.may_start(state, self.H1), (True, None))
        full = plan_review.lineage_state(self.rounds(3) + [{"kind": "abandoned", "by": "cos", "reason": "x"}])
        self.assertFalse(plan_review.may_start(full, self.H1)[0], "abandoning does not buy fresh rounds")

    def test_the_escalation_message_cuts_long_texts(self):
        text = plan_review.escalation_message("x#1", {"id": "O1", "lane": "L1", "text": "o" * 5000}, "r" * 5000)
        self.assertLess(len(text), 1800)
        self.assertIn("\u2026", text)

    def test_a_verdict_with_nothing_to_resolve_is_refused(self):
        for verdict in ("iterate", "reject"):
            text = "```verdict\nlane: L2\nplan_hash: %s\nverdict: %s\n```\n" % (self.H1, verdict)
            got, why = plan_review.parse_verdict_block(text, self.H1, "L2")
            self.assertIsNone(got)
            self.assertIn("at least 1 objection", why)
        text = "```verdict\nlane: L2\nplan_hash: %s\nverdict: approve\n```\n" % self.H1
        self.assertEqual(plan_review.parse_verdict_block(text, self.H1, "L2")[0]["verdict"], "approve")

    def test_an_objection_escalated_again_after_an_accepted_round_is_undecided_again(self):
        entries = [{"kind": "escalation", "objection": "L2/O1"}, {"kind": "decision", "objection": "L2/O1", "action": "accept"}]
        self.assertEqual(plan_review.lineage_state(entries)["undecided"], [])
        entries.append({"kind": "escalation", "objection": "L2/O1"})
        self.assertEqual(plan_review.lineage_state(entries)["undecided"], ["L2/O1"])

    def test_stuck_lanes_and_reminders(self):
        self.assertEqual(plan_review.stuck_lanes(["L1", "L2", "L3"], {"L1": 100, "L2": 900}, {"L1"}, 1100, 600), {})
        self.assertEqual(plan_review.stuck_lanes(["L1", "L2", "L3"], {"L1": 100, "L2": 400}, set(), 1100, 600), {"L1": 100, "L2": 400})
        self.assertEqual(plan_review.stuck_lanes(["L1", "L2"], {"L1": 100, "L2": 400}, {"L1"}, 1100, 600), {"L2": 400})
        self.assertFalse(plan_review.reminder_due(0, None, 23 * 3600, 24))
        self.assertTrue(plan_review.reminder_due(0, None, 25 * 3600, 24))
        self.assertFalse(plan_review.reminder_due(0, 24 * 3600, 30 * 3600, 24))
        self.assertTrue(plan_review.reminder_due(0, 24 * 3600, 49 * 3600, 24))

    def test_who_may_decide_an_escalation(self):
        ok = plan_review.decision_allowed
        self.assertEqual(ok("accept", "L2", False, False, "agent", True), (True, None))
        self.assertFalse(ok("accept", "L2", False, False, "agent", False)[0])
        self.assertEqual(ok("override", "L2", False, False, "agent", True), (True, None))
        self.assertFalse(ok("override", "L3", False, False, "agent", True)[0])
        self.assertFalse(ok("override", "L2", True, False, "agent", True)[0])
        self.assertFalse(ok("accept", "L2", False, True, "agent", True)[0], "owner-only: not even the boss")
        self.assertEqual(ok("override", "L3", True, True, "person", False), (True, None))
        self.assertFalse(ok("maybe", "L2", False, False, "person", True)[0])

    # -- the strict verdict block

    def block(self, lane="L2", plan_hash=None, verdict="iterate", lines=("- id: O1; severity: blocking; state: open; text: a stub passes",)):
        return "review done\n```verdict\nlane: %s\nplan_hash: %s\nverdict: %s\n%s\n```\n" % (
            lane, plan_hash or self.H1, verdict, "\n".join(lines))

    def test_a_valid_block_parses(self):
        got, why = plan_review.parse_verdict_block(self.block(), self.H1, "L2")
        self.assertIsNone(why)
        self.assertEqual((got["verdict"], got["objections"][0]["id"], got["objections"][0]["severity"]), ("iterate", "O1", "blocking"))

    def test_a_block_that_does_not_echo_the_hash_names_another_lane_or_is_loose_is_refused(self):
        bad = {
            "a stale hash": self.block(plan_hash=self.H2),
            "another lane": self.block(lane="L3"),
            "no block": "I approve this plan. verdict: approve",
            "two blocks": self.block() + self.block(),
            "a bad verdict": self.block(verdict="maybe"),
            "an approve with an open blocking objection": self.block(verdict="approve"),
            "a duplicate id": self.block(lines=("- id: O1; severity: blocking; state: open; text: a",
                                                "- id: O1; severity: advisory; state: open; text: b")),
            "a loose objection line": self.block(lines=("- the plan is bad",)),
            "an extra header line": self.block().replace("verdict: iterate", "verdict: iterate\nnote: x"),
        }
        for name, text in bad.items():
            with self.subTest(name=name):
                self.assertIsNone(plan_review.parse_verdict_block(text, self.H1, "L2")[0])
        self.assertIsNone(plan_review.parse_verdict_block(None, self.H1, "L2")[0])
        ok = self.block(verdict="approve", lines=("- id: O1; severity: blocking; state: resolved; text: fixed",))
        self.assertEqual(plan_review.parse_verdict_block(ok, self.H1, "L2")[0]["verdict"], "approve")

    # -- the texts

    def test_a_lane_brief_carries_the_snapshot_the_charter_and_the_untrusted_warning_and_takes_no_planner_reasoning(self):
        brief = plan_review.lane_brief("L2", "acme/app#9", self.H1, "THE PLAN TEXT", "an intent", "a done when",
                                       carried=[{"id": "O1", "lane": "L2", "text": "carried one"}, {"id": "O7", "lane": "L3", "text": "another lanes words"}], closing=True)
        for needle in ("lane L2", "UNTRUSTED", self.H1, "THE PLAN TEXT", "an intent", "a done when", "bad build that passes",
                       "CLOSING", "- O1: carried one", "plan_hash: " + self.H1):
            self.assertIn(needle, brief)
        self.assertNotIn("another lanes words", brief, "never another lane's output")
        names = set(inspect.signature(plan_review.lane_brief).parameters)
        self.assertEqual(names, {"lane", "plan_ref", "plan_hash", "plan_text", "intent", "done_when", "carried", "closing"},
                         "no parameter for the planner's reasoning or another lane's output")

    def test_the_escalation_message_shows_both_sides(self):
        text = plan_review.escalation_message("acme/app#7", {"id": "O3", "lane": "L3", "text": "no rollback"}, "rejected: out of scope")
        for needle in ("acme/app#7", "O3", "L3", "no rollback", "rejected: out of scope"):
            self.assertIn(needle, text)
        self.assertIn("(none recorded)", plan_review.escalation_message("x#1", {"id": "O1", "lane": "L1"}, None))


# ---- the v2 transport: HTTP to the service with a CLI fallback, and the backpressure breaker (an owner order)

class FakeOpenCodeService:
    """The OpenCode service, in memory: no socket, no thread, no sleep. It answers like the service (Basic auth `opencode:<password>`, the paths of
    the operation table); `connect` is the connection factory a test gives V2Http. Knobs: `up`, `delay` (a delay longer than the client's timeout
    is a timeout), `drop` (the service closes without a reply after receiving the request), `big` (bytes in a transcript reply), `password`."""

    def __init__(self, password="pw-secret-1"):
        self.password, self.up, self.delay, self.drop, self.big = password, True, 0.0, False, 0
        self.requests, self.connections = [], 0
        self.stream = []           # lines GET /api/event streams; a None is a quiet stretch (a read timeout); the stream then closes
        self.stream_status = 200

    def answer(self, method, path, body, authorization):
        token = base64.b64encode(("opencode:" + self.password).encode()).decode()
        if authorization != "Basic " + token:
            return 401, {"error": "unauthorized"}
        if path == "/api/event":
            self.requests.append((method, path, body))
            return self.stream_status, "STREAM"
        self.requests.append((method, path, body))
        if path.startswith("/api/session/ses_a/message"):
            return 200, {"data": [{"id": "msg_%d" % i, "pad": "x" * (self.big or 1)} for i in range(1 if self.big else 2)], "cursor": {"next": None}}
        if path == "/api/info":
            return 200, {"version": "2.0.24"}
        if path == "/api/session/active":
            return 200, {"ses_a": {"status": "idle"}}
        if path.startswith("/api/session/ses_a/synthetic") and method == "POST":
            return 200, {"ok": True}
        if path == "/api/session/ses_missing":
            return 404, {"_tag": "SessionNotFoundError"}
        return 404, {"error": "no such path"}

    def connect(self, host, port, timeout=None):
        return FakeServiceConnection(self, timeout)

    def write_service_file(self, path, url="http://127.0.0.1:49374", pid=None, mode=0o600):
        Path(path).parent.mkdir(parents=True, exist_ok=True)
        Path(path).write_text(json.dumps({"id": "x", "version": "2.0.24", "url": url, "pid": pid or os.getpid(), "password": self.password}))
        os.chmod(str(path), mode)


class FakeServiceResponse:
    def __init__(self, status, raw):
        self.status, self._raw, self.will_close = status, raw, False
        self.on_read = None   # a test hook: called before each read (to advance a fake clock)

    def read(self, amount=None):
        if self.on_read is not None:
            self.on_read()
        if amount is None:
            raw, self._raw = self._raw, b""
        else:
            raw, self._raw = self._raw[:amount], self._raw[amount:]
        return raw


class FakeStreamResponse:
    """An event stream response: readline gives the scripted lines, a None raises the read timeout, the end is b""."""

    def __init__(self, status, lines):
        self.status, self.lines, self.will_close = status, lines, True

    def readline(self, limit=-1):
        if not self.lines:
            return b""
        line = self.lines.pop(0)
        if line is None:
            raise socket.timeout("timed out")
        raw = (line + "\n").encode()
        return raw[:limit] if limit and limit > 0 else raw

    def read(self, amount=None):
        return b"{}"


class FakeServiceConnection:
    """What http.client.HTTPConnection gives V2Http, over the in-memory service."""

    def __init__(self, service, timeout):
        self.service, self.timeout, self.sock, self.pending, self.broken = service, timeout, None, None, False

    def connect(self):
        if not self.service.up:
            raise ConnectionRefusedError(61, "Connection refused")
        self.sock = object()
        self.service.connections += 1

    def request(self, method, target, body=None, headers=None):
        if self.broken or not self.service.up:
            raise BrokenPipeError(32, "Broken pipe")
        self.pending = (method, target, body or b"", (headers or {}).get("Authorization"))

    def getresponse(self):
        method, target, body, auth = self.pending
        status, obj = self.service.answer(method, target, body, auth)
        if obj == "STREAM":
            return FakeStreamResponse(status, list(self.service.stream))
        if self.service.drop:
            self.broken = True
            raise http.client.RemoteDisconnected("Remote end closed connection without response")
        if self.service.delay > (self.timeout or 1e9):
            raise socket.timeout("timed out")
        return FakeServiceResponse(status, json.dumps(obj).encode())

    def close(self):
        self.sock = None


class V2TransportBase(Base):
    def setUp(self):
        super().setUp()
        self.service = FakeOpenCodeService()
        self.service_file = self.home / "opencode" / "service.json"
        self.service.write_service_file(self.service_file)
        self.cli_calls = []

    def runner(self, argv, **kwargs):
        self.cli_calls.append(argv)
        return subprocess.CompletedProcess(argv, 0, json.dumps({"data": {"via": "cli"}}), "")

    def write_private(self, text):
        """A service file that is private to the user (0600), so that only its content or size can be what is wrong with it."""
        self.service_file.write_text(text)
        os.chmod(str(self.service_file), 0o600)

    def route(self, timeout=5, alive=None):
        return sb.V2Http(self.service_file, timeout, alive=alive or (lambda pid: True), connect=self.service.connect)

    def client(self, timeout=5, **kwargs):
        return sb.V2Client("/fake/bin/opencode", {}, self.runner, timeout, http=self.route(timeout), **kwargs)


class TestV2Http(StandInPids, V2TransportBase):
    def test_a_read_goes_over_http_with_the_operations_own_path_and_query_and_the_same_decoded_result(self):
        client = self.client()
        self.assertEqual(client.server_info(), {"version": "2.0.24"})
        page, cursor = client.message_page("ses_a", 5, "synthetic", None)
        self.assertEqual([m["id"] for m in page], ["msg_0", "msg_1"])
        self.assertEqual(cursor, {"next": None})
        self.assertEqual(client.message_list("ses_a", limit=900), [{"id": "msg_0", "pad": "x"}, {"id": "msg_1", "pad": "x"}])
        self.assertEqual(self.cli_calls, [], "no process was started")
        paths = [p for _, p, _ in self.service.requests]
        self.assertEqual(paths[0], "/api/info")
        self.assertEqual(paths[1], "/api/session/ses_a/message?limit=5&type=synthetic")
        self.assertEqual(paths[2], "/api/session/ses_a/message?limit=%d" % sb.V2_READ_LIMIT_MAX, "a page is never larger than the cap")
        self.assertEqual(client.calls_by_transport(), {"http": 3}, "one record: every call, with the way it travelled")
        self.assertEqual(client.calls_by_operation(), {"server.info": 1, "session.message.list": 2})

    def test_a_write_carries_its_json_body_and_a_session_id_is_quoted(self):
        client = self.client()
        client._call("session.synthetic", {"sessionID": "ses_a"}, {"id": "msg_1", "text": "hi"})
        method, path, body = self.service.requests[-1]
        self.assertEqual((method, path, json.loads(body)), ("POST", "/api/session/ses_a/synthetic", {"id": "msg_1", "text": "hi"}))
        self.assertIsNone(sb.V2Client._target(sb.V2_HTTP_OPERATIONS["session.get"], {"sessionID": "a b/c", "extra": "x"}), "an unknown parameter goes to the CLI")
        self.assertEqual(sb.V2Client._target(sb.V2_HTTP_OPERATIONS["session.get"], {"sessionID": "a b/c"}), "/api/session/a%20b%2Fc")

    def test_reads_share_one_keep_alive_connection_and_a_write_uses_its_own(self):
        client = self.client()
        for _ in range(20):
            client.session_active()
        self.assertEqual((len(self.service.requests), self.service.connections), (20, 1))
        client._call("session.synthetic", {"sessionID": "ses_a"}, {"id": "msg_1", "text": "hi"})
        self.assertEqual(self.service.connections, 2)

    def test_an_http_error_is_a_v2_error_with_the_status_and_the_body_like_the_cli(self):
        client = self.client()
        with self.assertRaises(sb.V2Error) as caught:
            client.session_get("ses_missing")
        self.assertEqual((caught.exception.reason, caught.exception.status), ("http", 404))
        self.assertIn("SessionNotFoundError", str(caught.exception))
        self.assertEqual(self.cli_calls, [], "a service answer is never retried through the CLI")

    def test_a_new_password_after_a_service_restart_is_read_again_once(self):
        client = self.client()
        client.session_active()
        self.service.up = False
        self.service.password = "pw-secret-2"
        self.service.up = True
        self.service.write_service_file(self.service_file)
        self.assertEqual(client.session_active(), {"ses_a": {"status": "idle"}}, "the restart is survived mid-run")
        self.assertEqual((self.cli_calls, client.calls_by_transport()), ([], {"http": 2}))

    def test_a_dead_keep_alive_connection_is_replaced_and_the_read_goes_on(self):
        client = self.client()
        client.session_active()
        self.service.up = False
        client.http._conn.sock = object()    # the connection looks open to the client
        self.service.up = True
        client.http._conn.broken = True
        self.assertEqual(client.session_active(), {"ses_a": {"status": "idle"}})
        self.assertEqual(self.cli_calls, [])

    def test_a_wrong_password_twice_falls_back_to_the_cli_and_never_loops(self):
        client = self.client()
        self.service.password = "changed-and-the-file-is-stale"
        self.assertEqual(client.session_active(), {"via": "cli"})
        self.assertEqual((len(self.cli_calls), client.calls_by_transport()), (1, {"cli-fallback": 1}), "a fallback counts once, as the CLI call that served it")

    def test_a_bad_service_file_uses_the_cli_and_the_service_is_not_contacted(self):
        cases = (("none", lambda: None), ("stale pid", lambda: self.service.write_service_file(self.service_file, pid=self.px[99999999])),
                 ("remote", lambda: self.service.write_service_file(self.service_file, url="http://203.0.113.9:80")),
                 ("a name, not a literal address", lambda: self.service.write_service_file(self.service_file, url="http://localhost:49374")),
                 ("world readable", lambda: self.service.write_service_file(self.service_file, mode=0o644)),
                 ("garbage", lambda: self.write_private("{not json")),
                 ("huge", lambda: self.write_private(" " * 10000)),
                 ("huge but valid JSON up front", lambda: self.write_private(json.dumps({"url": "http://127.0.0.1:49374", "password": self.service.password}) + " " * 10000)))
        for name, writer in cases:
            with self.subTest(name=name):
                self.service_file.exists() and self.service_file.unlink()
                writer()
                self.cli_calls.clear()
                before = len(self.service.requests)
                client = sb.V2Client("/fake/bin/opencode", {}, self.runner, 5, http=self.route(alive=lambda pid: pid != self.px[99999999]))
                self.assertEqual(client.session_active(), {"via": "cli"})
                self.assertEqual(len(self.service.requests), before, "the service was not contacted")
        for good in ("http://127.0.0.1:49374", "http://[::1]:49374"):
            with self.subTest(good=good):
                self.service.write_service_file(self.service_file, url=good)
                self.assertEqual(self.client().session_active(), {"ses_a": {"status": "idle"}})

    def test_a_connection_refused_falls_back_to_the_cli_which_may_start_the_service(self):
        client = self.client()
        self.service.up = False
        self.assertEqual(client.session_active(), {"via": "cli"})
        self.assertEqual(client.calls_by_transport(), {"cli-fallback": 1})

    def test_a_slow_service_is_a_timeout_error_and_is_not_asked_again_through_the_cli(self):
        client = self.client(timeout=5)
        self.service.delay = 6
        with self.assertRaises(sb.V2Error) as caught:
            client.session_active()
        self.assertEqual(caught.exception.reason, "timeout")
        self.assertEqual((self.cli_calls, client.calls_by_transport()), ([], {"http": 1}), "it reached the service: counted, and not repeated")

    def test_a_reply_that_trickles_in_is_cut_at_the_total_deadline_not_per_socket_operation(self):
        now = [100.0]

        class Trickle:
            def __init__(trickle):
                trickle.reads = 0

            def read(trickle, amount=None):
                trickle.reads += 1
                now[0] += 2.0   # one byte, 2 s later: every socket operation is within its own timeout
                return b"x"
        trickle = Trickle()
        with mock.patch.object(sb.time, "monotonic", lambda: now[0]):
            with self.assertRaises(socket.timeout):
                sb.V2Http._read_body(trickle, types.SimpleNamespace(sock=None), now[0] + 5.0)
        self.assertEqual(trickle.reads, 3, "stopped at the total deadline (5 s), not after the whole reply")
        sock = types.SimpleNamespace(timeouts=[], settimeout=lambda seconds: sock.timeouts.append(round(seconds, 1)))
        conn = types.SimpleNamespace(sock=sock)
        with mock.patch.object(sb.time, "monotonic", lambda: 100.0):
            sb.V2Http._budget(conn, 103.0)
            with self.assertRaises(socket.timeout):
                sb.V2Http._budget(conn, 100.0)
        self.assertEqual(sock.timeouts, [3.0], "the socket gets what is left of the total time: connect, send, headers and body share it")
        done = type("Done", (), {"read": lambda self, amount=None, _b=[b"abc", b""]: _b.pop(0)})()
        self.assertEqual(sb.V2Http._read_body(done, types.SimpleNamespace(sock=None), time.monotonic() + 5), b"abc")

    def test_a_symlinked_service_file_and_an_open_directory_are_refused_and_the_service_not_contacted(self):
        real = self.home / "opencode" / "real.json"
        self.service_file.rename(real)
        self.service_file.symlink_to(real)
        before = len(self.service.requests)
        self.assertEqual(self.client().session_active(), {"via": "cli"}, "a symlink is refused, not followed")
        self.service_file.unlink()
        real.rename(self.service_file)
        os.chmod(str(self.service_file.parent), 0o777)
        self.assertEqual(self.client().session_active(), {"via": "cli"}, "a directory others can write to cannot be trusted")
        os.chmod(str(self.service_file.parent), 0o755)
        self.assertEqual(len(self.service.requests), before)
        self.assertEqual(self.client().session_active(), {"ses_a": {"status": "idle"}}, "and the same file in a closed directory is accepted")

    def test_a_reply_over_the_cap_is_refused_not_buffered(self):
        client = self.client()
        self.service.big = 5000
        with mock.patch.object(sb, "V2_HTTP_MAX_BODY", 1000):
            with self.assertRaises(sb.V2Error) as caught:
                client.message_list("ses_a", limit=5)
        self.assertEqual(caught.exception.reason, "too_large")

    def test_a_write_that_may_have_been_received_is_never_replayed_or_sent_again_through_the_cli(self):
        client = self.client()
        self.service.drop = True
        with self.assertRaises(sb.V2Error) as caught:
            client._call("session.synthetic", {"sessionID": "ses_a"}, {"id": "msg_9", "text": "once"})
        self.assertEqual(caught.exception.reason, "unavailable")
        self.assertEqual((len(self.service.requests), self.cli_calls), (1, []), "received once, not repeated, not sent through the CLI")

    def test_a_write_the_service_refused_twice_for_its_password_goes_through_the_cli_once_because_it_was_never_received(self):
        client = self.client()
        self.service.password = "rotated-and-the-file-is-stale"
        result = client._call("session.synthetic", {"sessionID": "ses_a"}, {"id": "msg_9", "text": "x"})
        self.assertEqual(result, {"via": "cli"})
        self.assertEqual((len(self.cli_calls), self.service.requests), (1, []), "the service never processed it, so the CLI (which authenticates itself) is safe")
        self.assertEqual(client.calls_by_transport(), {"cli-fallback": 1})

    def test_a_probe_that_raises_something_other_than_a_v2_error_does_not_leave_optional_reads_waiting_for_ever(self):
        now = [0.0]
        client = sb.V2Client("/fake/bin/opencode", {}, self.runner, 5, http=self.route(), monotonic=lambda: now[0])
        for _ in range(sb.V2_TIMEOUT_STREAK):
            client.breaker.record(20, True)
        now[0] += sb.V2_BACKOFF_BASE + 1
        with mock.patch.object(client, "_transport", side_effect=KeyError("a bug")):
            with self.assertRaises(KeyError):
                client.session_active()   # it was the probe
        self.assertEqual(client.session_active(), {"ses_a": {"status": "idle"}}, "the next optional read is the next probe, not a skipped read")

    def test_a_refused_password_on_a_write_is_retried_once_because_the_service_never_saw_it(self):
        client = self.client()
        client.session_active()
        self.service.password = "rotated"
        self.service.write_service_file(self.service_file)
        client._call("session.synthetic", {"sessionID": "ses_a"}, {"id": "msg_9", "text": "x"})
        self.assertEqual([m for m, _, _ in self.service.requests].count("POST"), 1)
        self.assertEqual(self.cli_calls, [])

    def test_the_password_is_in_no_error_no_status_file_and_no_audit_event(self):
        world = World(self, agents=("platform",))
        engine = world.new_engine()
        engine.v2 = client = self.client()
        engine.v2.on_event = lambda name, detail: engine._note(name, "v2", detail)
        client.state_dir = world.state
        self.service.drop = True
        with self.assertRaises(sb.V2Error) as caught:
            client._call("session.synthetic", {"sessionID": "ses_a"}, {"id": "msg_9", "text": "x"})
        self.service.drop = False
        for _ in range(sb.V2_TIMEOUT_STREAK):
            self.service.delay = 99
            with self.assertRaises(sb.V2Error):
                client.session_active()
        client._write_link(True)
        everything = str(caught.exception) + (world.state / sb.V2_LINK_STATUS_FILE).read_text() + (world.state / "audit.jsonl").read_text()
        self.assertIn("v2.backoff", everything, "the audit has the episode")
        self.assertNotIn(self.service.password, everything)
        self.assertNotIn("Basic ", everything)

    def test_under_the_test_suite_a_real_run_is_refused_before_the_http_route_or_the_cli_is_reached(self):
        client = sb.V2Client("/fake/bin/opencode", {}, subprocess.run, 5, http=self.route())
        with self.assertRaises(sb.V2Error) as caught:
            client.session_active()
        self.assertEqual(caught.exception.reason, "refused")
        self.assertEqual((self.service.requests, client.calls_by_transport()), ([], {}), "nothing was sent and nothing was counted")

    def test_the_config_key_forces_the_cli_route_and_a_bad_value_is_refused(self):
        with mock.patch.dict(os.environ):
            os.environ.pop("FLEET_SWITCHBOARD_V2_CLI", None)
            self.assertIsNotNone(sb.V2Client(sys.executable, {}, subprocess.run, 5, transport="auto").http)
        self.assertIsNone(sb.V2Client(sys.executable, {}, subprocess.run, 5, transport="cli").http, "the kill switch: always `opencode api`")
        base = {"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR}
        self.assertEqual(sb.validate_config(dict(base))["v2_transport"], "auto")
        self.assertEqual(sb.validate_config(dict(base, v2_transport="cli"))["v2_transport"], "cli")
        for bad in ("http", "", None, 1, True):
            with self.subTest(bad=bad), self.assertRaises(sb.ConfigError):
                sb.validate_config(dict(base, v2_transport=bad))

    def test_every_real_client_construction_passes_the_kill_switch(self):
        sources = [switchboard_source(), (REPO / "bin" / "judge-eval").read_text()]
        sites = [line for text in sources for line in text.splitlines() if re.search(r"\bV2Client\(", line) and "class V2Client" not in line]
        self.assertGreaterEqual(len(sites), 5)
        for line in sites:
            with self.subTest(line=line.strip()[:80]):
                self.assertIn('transport=config["v2_transport"]', line, "a construction that omits it would ignore the kill switch")

    def test_a_fake_runner_or_the_cli_switch_means_no_http_route_at_all(self):
        self.assertIsNone(sb.V2Client("/fake/bin/opencode", {}, self.runner, 5).http)
        with mock.patch.dict(os.environ, {"FLEET_SWITCHBOARD_V2_CLI": "1"}):
            self.assertIsNone(sb.V2Client(sys.executable, {}, subprocess.run, 5).http)
        self.assertIsNotNone(sb.V2Client(sys.executable, {}, subprocess.run, 5).http, "a real run with a real binary uses the route")


class TestDeliveryDuringABackoff(PR4Base):
    """rev-wake's Medium: while the breaker is open a wake must still be delivered (the person-is-typing read every observation makes is essential)."""

    def open_the_breaker(self):
        breaker = self.world.engine.v2.breaker
        for _ in range(sb.V2_TIMEOUT_STREAK):
            breaker.record(20, True)
        self.assertEqual(breaker.state, "open")
        return breaker

    def test_the_person_is_typing_read_is_essential_and_an_ordinary_transcript_read_is_not(self):
        client = self.world.engine.v2
        self.assertTrue(client._is_essential("session.message.list", {"type": "user", "limit": 10}))
        self.assertTrue(client._is_essential("session.message.list", {"type": "synthetic", "limit": 1}))
        self.assertFalse(client._is_essential("session.message.list", {"type": "assistant", "limit": 1}))
        self.assertFalse(client._is_essential("session.active"))

    def test_a_pending_send_is_delivered_while_the_breaker_is_open(self):
        breaker = self.open_the_breaker()
        sb.add_reminder(self.world.state, "platform", self.world.clock.now() + 1, self.world.clock.now(), "look at the build")
        self.world.tick(5)
        self.world.engine.run_pass()
        self.assertEqual(len(self.world.admissions("platform")), 1, "delivered during the backoff")
        self.assertEqual(breaker.state, "open", "and the breaker was not what let it through: optional reads stayed skipped")
        with self.assertRaises(sb.V2Error):
            self.world.engine.v2.session_active()

    def test_with_the_user_read_optional_the_same_delivery_would_be_held(self):
        self.open_the_breaker()
        real = sb.V2Client._is_essential
        with mock.patch.object(sb.V2Client, "_is_essential", lambda self_, op, params=None: False if op == "session.message.list" and (params or {}).get("type") == "user" else real(self_, op, params)):
            sb.add_reminder(self.world.state, "platform", self.world.clock.now() + 1, self.world.clock.now(), "look at the build")
            self.world.tick(5)
            self.world.engine.run_pass()
        self.assertEqual(self.world.admissions("platform"), [], "the failure rev-wake found: held while the person read is skipped")


class TestV2Breaker(Base):
    """The breaker with a fake clock: slow or timing-out calls open it, optional reads are skipped, essential calls go on, it resumes gradually."""

    def setUp(self):
        super().setUp()
        self.now = [1000.0]
        self.breaker = sb.V2Breaker(lambda: self.now[0])

    def slow(self, n, seconds=sb.V2_SLOW_SECONDS + 1, timed_out=False):
        events = []
        for _ in range(n):
            event = self.breaker.record(seconds, timed_out)
            if event:
                events.append(event)
        return events

    def test_it_stays_closed_while_calls_are_fast_and_while_there_are_too_few_samples(self):
        self.assertEqual(self.slow(30, 0.05), [])
        self.assertTrue(self.breaker.allows(False))
        fresh = sb.V2Breaker(lambda: self.now[0])
        self.assertEqual([fresh.record(60, False) for _ in range(sb.V2_SLOW_MIN_SAMPLES - 1)], [None] * (sb.V2_SLOW_MIN_SAMPLES - 1))

    def test_a_slow_p95_opens_it_once_per_episode_and_optional_reads_are_skipped_but_essential_calls_go_on(self):
        events = self.slow(sb.V2_SLOW_MIN_SAMPLES)
        self.assertEqual([e["event"] for e in events], ["v2.backoff"])
        self.assertIn("p95", events[0]["reason"])
        self.assertEqual(self.slow(5), [], "no second v2.backoff while the same episode goes on")
        self.assertFalse(self.breaker.allows(False))
        self.assertTrue(self.breaker.allows(True), "a wake or delivery is never skipped")
        self.assertEqual(self.breaker.skipped, 1)

    def test_timeouts_in_a_row_open_it_even_with_few_samples(self):
        events = self.slow(sb.V2_TIMEOUT_STREAK, 20, True)
        self.assertEqual(len(events), 1)
        self.assertIn("timed out", events[0]["reason"])

    def test_after_the_backoff_one_probe_at_a_time_a_slow_probe_doubles_the_wait_and_good_probes_close_it(self):
        self.slow(sb.V2_TIMEOUT_STREAK, 20, True)
        self.now[0] += sb.V2_BACKOFF_BASE - 1
        self.assertFalse(self.breaker.allows(False), "still inside the backoff")
        self.now[0] += 2
        self.assertTrue(self.breaker.allows(False), "the first probe")
        self.assertFalse(self.breaker.allows(False), "only one probe at a time")
        event = self.breaker.record(20, True, probe=True)
        self.assertEqual((event["event"], event["seconds"]), ("v2.backoff", int(sb.V2_BACKOFF_BASE * 2)))
        self.assertEqual(event["episode"], 1, "a failed probe is the same episode")
        self.now[0] += sb.V2_BACKOFF_BASE * 2 + 1
        closed = None
        for _ in range(sb.V2_RECOVER_OK):
            self.assertEqual(self.breaker.allows(False), "probe")
            closed = self.breaker.record(0.05, False, probe=True)
        self.assertEqual(closed, {"event": "v2.resume", "episode": 1})
        self.assertEqual(self.breaker.state, "closed")
        self.assertTrue(self.breaker.allows(False))

    def test_the_wait_is_capped_and_a_new_episode_gets_a_new_number(self):
        self.breaker.level = 40
        self.assertEqual(self.breaker._wait(), sb.V2_BACKOFF_MAX)
        self.slow(sb.V2_TIMEOUT_STREAK, 20, True)
        self.now[0] += sb.V2_BACKOFF_BASE + 1
        self.breaker.allows(False)
        for _ in range(sb.V2_RECOVER_OK):
            self.breaker.record(0.05, False, probe=True)
            self.breaker.allows(False)
        again = self.slow(sb.V2_TIMEOUT_STREAK, 20, True)
        self.assertEqual([e["episode"] for e in again], [2])


class SlowProbeBreaker(sb.V2Breaker):
    """A breaker whose `probe_out` hands the processor to another thread between being read and being written (no wait): an unguarded
    check-then-set shows itself at once."""

    @property
    def probe_out(self):
        seen = self._probe_out
        time.sleep(0)
        return seen

    @probe_out.setter
    def probe_out(self, value):
        self._probe_out = value


class TestV2BreakerEdges(Base):
    def setUp(self):
        super().setUp()
        self.now = [1000.0]
        self.breaker = sb.V2Breaker(lambda: self.now[0])

    def open_it(self):
        for _ in range(sb.V2_TIMEOUT_STREAK):
            self.breaker.record(20, True)
        self.now[0] += sb.V2_BACKOFF_BASE + 1

    def test_exactly_the_slow_threshold_is_not_slow_and_one_hair_over_is(self):
        fresh = sb.V2Breaker(lambda: self.now[0])
        self.assertEqual([fresh.record(sb.V2_SLOW_SECONDS, False) for _ in range(sb.V2_SLOW_MIN_SAMPLES + 2)], [None] * (sb.V2_SLOW_MIN_SAMPLES + 2))
        over = sb.V2Breaker(lambda: self.now[0])
        events = [over.record(sb.V2_SLOW_SECONDS + 0.001, False) for _ in range(sb.V2_SLOW_MIN_SAMPLES)]
        self.assertEqual([e["event"] for e in events if e], ["v2.backoff"])

    def test_an_essential_call_finishing_during_a_probe_is_not_the_probes_result(self):
        self.open_it()
        self.assertEqual(self.breaker.allows(False), "probe")
        self.assertIsNone(self.breaker.record(99, True), "a slow essential call: it is not the probe")
        self.assertEqual((self.breaker.state, self.breaker.level, self.breaker.probe_out), ("probing", 0, True))
        self.assertIsNone(self.breaker.record(0.01, False))
        self.assertEqual(self.breaker.good, 0, "a fast essential call is not a good probe either")

    def test_a_probe_that_ends_in_no_answer_frees_the_slot_instead_of_blocking_optional_reads_for_ever(self):
        self.open_it()
        self.assertEqual(self.breaker.allows(False), "probe")
        self.assertFalse(self.breaker.allows(False))
        self.breaker.abandon()
        self.assertEqual(self.breaker.allows(False), "probe")

    def test_threads_asking_at_once_get_exactly_one_probe_each_round(self):
        previous = sys.getswitchinterval()
        sys.setswitchinterval(1e-6)   # threads switch as often as Python allows, so an unguarded check-then-set shows itself
        self.addCleanup(sys.setswitchinterval, previous)
        for round_number in range(40):
            breaker = SlowProbeBreaker(lambda: self.now[0])
            for _ in range(sb.V2_TIMEOUT_STREAK):
                breaker.record(20, True)
            got, barrier = [], threading.Barrier(8)

            def ask():
                barrier.wait()
                got.append(breaker.allows(False))

            threads = [threading.Thread(target=ask) for _ in range(8)]
            self.now[0] += sb.V2_BACKOFF_BASE + 1
            for t in threads:
                t.start()
            for t in threads:
                t.join()
            self.assertEqual(sorted(map(str, got)), ["False"] * 7 + ["probe"], "round %d" % round_number)
            self.now[0] = 1000.0


class TestV2ClientBackpressure(Base):
    """The client over a latency-injecting fake CLI: the breaker's effect on real calls, the audit once per episode, the status line."""

    def setUp(self):
        super().setUp()
        self.clock = [0.0]
        self.calls = []
        self.delay = 0.1
        self.timeout = False

    def runner(self, argv, **kwargs):
        self.calls.append(argv[2])
        self.clock[0] += self.delay
        if self.timeout:
            raise subprocess.TimeoutExpired(argv, 1)
        return subprocess.CompletedProcess(argv, 0, json.dumps({"data": []}), "")

    def client(self):
        return sb.V2Client("/fake/bin/opencode", {}, self.runner, 1, monotonic=lambda: self.clock[0])

    def test_after_timeouts_an_optional_read_fails_fast_without_a_process_and_a_write_still_goes(self):
        client = self.client()
        self.timeout = True
        for _ in range(sb.V2_TIMEOUT_STREAK):
            with self.assertRaises(sb.V2Error):
                client.session_active()
        self.timeout = False
        before = len(self.calls)
        with self.assertRaises(sb.V2Error) as caught:
            client.session_active()
        self.assertEqual(caught.exception.reason, "backoff")
        self.assertEqual(len(self.calls), before, "no process was started for a skipped read")
        client._call("session.synthetic", {"sessionID": "ses_a"}, {"id": "msg_1", "text": "wake"})
        client.session_get("ses_a")   # discovery and the re-check before a write: a delivery cannot go without it
        client.inbox_list("ses_a")
        client.message_page("ses_a", 10, "synthetic")
        self.assertEqual(len(self.calls), before + 4, "a write, the session read, the inbox and the delivery key read all went through")
        self.assertEqual(client.breaker.skipped, 1, "the one skipped read is counted once, in one place")
        with self.assertRaises(sb.V2Error):
            client.message_list("ses_a", limit=5)   # an ordinary transcript read is optional

    def test_it_resumes_by_itself_once_the_service_answers_quickly_again(self):
        client = self.client()
        self.timeout = True
        for _ in range(sb.V2_TIMEOUT_STREAK):
            with self.assertRaises(sb.V2Error):
                client.session_active()
        self.timeout = False
        self.clock[0] += sb.V2_BACKOFF_BASE + 1
        for _ in range(sb.V2_RECOVER_OK):
            client.session_active()
        self.assertEqual(client.breaker.state, "closed")
        client.session_get("ses_a")

    def test_the_engine_audits_one_v2_backoff_per_episode_and_the_daemons_link_status_says_so(self):
        world = World(self, agents=("platform",))
        engine = world.new_engine()
        client = engine.v2
        client.monotonic = lambda: self.clock[0]
        client.breaker.clock = client.monotonic
        client.state_dir = world.state
        world.v2.fail_with = None
        real = client.runner

        def slow(argv, **kwargs):
            self.clock[0] += 30
            return real(argv, **kwargs)
        client.runner = slow
        for _ in range(sb.V2_SLOW_MIN_SAMPLES + 4):
            try:
                client.session_active()
            except sb.V2Error:
                pass
        events = [e for e in world.audit() if e["event"] in ("v2.backoff", "v2.resume")]
        self.assertEqual([e["event"] for e in events], ["v2.backoff"], "one line for the episode, not one per skipped read")
        self.assertEqual(events[0]["detail"]["episode"], 1)
        line = sb.v2_link_status_line(world.state, time.time())
        self.assertIn("OPEN", line)
        self.assertIn("v2.backoff", line)
        self.assertEqual(stat.S_IMODE((world.state / sb.V2_LINK_STATUS_FILE).stat().st_mode), 0o600)

    def test_a_status_line_is_only_shown_for_a_written_file_and_reads_closed_when_healthy(self):
        self.assertIsNone(sb.v2_link_status_line(self.home, time.time()))
        client = self.client()
        client.state_dir = self.home
        client.session_active()
        line = sb.v2_link_status_line(self.home, time.time())
        self.assertIn("breaker CLOSED", line)
        self.assertIn("fell back to the CLI", line)


# ---- the event feed (#290 slice 2)

def feed_line(kind, session="ses_w", created=None, **data):
    body = {"id": "evt_%s" % kind, "type": kind, "data": dict({"sessionID": session}, **data)}
    if created is not None:
        body["created"] = created
    return "data: " + json.dumps(body)


class TestEventFeedLines(unittest.TestCase):
    def test_only_the_wanted_events_are_kept_and_no_text_is_ever_kept(self):
        feed = sb.EventFeed(None)
        for line in ("event: x", "data: not json", "data: []", feed_line("session.tool.success", assistantMessageID="msg_t", content="x" * 5000),
                     feed_line("session.text.ended", assistantMessageID="msg_a", ordinal=0, text="SECRET-TEXT"),
                     feed_line("session.execution.succeeded", created=5000)):
            feed.handle(line)
        self.assertEqual(feed.status()["events"], 2, "the tool output and the junk were not kept")
        self.assertEqual(feed.seen["ses_w"], {"assistant": "msg_a", "idle_ms": 5000, "read": None, "event_at": feed.seen["ses_w"]["event_at"]})
        self.assertNotIn("SECRET-TEXT", repr(feed.seen), "an event's text can be partial or stale: it is never kept")

    def test_the_step_ended_and_failed_and_interrupted_branches_and_a_line_without_a_session(self):
        feed = sb.EventFeed(None)
        feed.handle(feed_line("session.step.ended", assistantMessageID="msg_s"))
        self.assertEqual(feed.seen["ses_w"]["assistant"], "msg_s")
        for kind in ("session.execution.failed", "session.execution.interrupted"):
            feed.handle(feed_line(kind, created=7000))
            self.assertEqual(feed.seen["ses_w"]["idle_ms"], 7000)
        feed.handle('data: {"type": "session.text.ended", "data": {"text": "t"}}')
        self.assertEqual(feed.status()["sessions"], 1)

    def test_the_sessions_kept_are_bounded(self):
        feed = sb.EventFeed(None)
        with mock.patch.object(sb, "FEED_SESSIONS_MAX", 3):
            for n in range(10):
                feed.handle(feed_line("session.execution.succeeded", session="ses_%d" % n, created=1))
        self.assertEqual(feed.status()["sessions"], 3)

    def test_a_session_is_touched_when_an_event_named_it_after_it_was_last_read(self):
        feed = sb.EventFeed(None, now=lambda: 100.0)
        self.assertTrue(feed.touched_since_read("ses_w"), "never read")
        feed.seen["ses_w"] = {"assistant": None, "idle_ms": None, "read": 100.0, "event_at": None}
        self.assertFalse(feed.touched_since_read("ses_w"))
        feed.now = lambda: 101.0
        feed.handle(feed_line("session.step.ended", assistantMessageID="msg_s"))
        self.assertTrue(feed.touched_since_read("ses_w"))


class TestEventFeedRun(V2TransportBase):
    def setUp(self):
        super().setUp()
        self.service.stream = []

    def test_the_feed_marks_a_gap_on_every_opened_connection_and_reconnects_with_growing_waits(self):
        sleeps, feed = [], None

        def sleep(seconds):
            sleeps.append(seconds)
            if len(sleeps) == 4:
                feed.stop()
        feed = sb.EventFeed(self.route(5), None, sleep=sleep)
        self.service.stream = [feed_line("session.step.ended", assistantMessageID="msg_a"), feed_line("session.execution.succeeded", created=7)]
        feed.needs_resync = False
        feed.run()
        self.assertEqual(sleeps, [1, 2, 4, 8], "a stream that ends is a gap: reconnect, waiting longer each time")
        self.assertEqual(feed.status()["connects"], 4)
        self.assertTrue(feed.needs_resync)

    def test_a_connection_that_lived_starts_the_wait_over_and_the_wait_is_capped(self):
        clock, sleeps, feed = [0.0], [], None

        def sleep(seconds):
            sleeps.append(seconds)
            clock[0] += sb.FEED_STABLE_SECONDS + 1 if len(sleeps) == 3 else 0.1
            if len(sleeps) == 5:
                feed.stop()
        feed = sb.EventFeed(self.route(5), None, now=lambda: clock[0], sleep=sleep)
        self.service.stream = []
        feed.run()
        self.assertEqual(sleeps[:2], [1, 2])
        with mock.patch.object(sb, "FEED_BACKOFF_MAX", 2):
            capped, feed2 = [], None

            def sleep2(seconds):
                capped.append(seconds)
                if len(capped) == 4:
                    feed2.stop()
            feed2 = sb.EventFeed(self.route(5), None, sleep=sleep2)
            feed2.run()
        self.assertEqual(capped, [1, 2, 2, 2])

    def test_a_service_that_stays_down_costs_nothing_no_gap_no_resync_no_read_no_audit_line(self):
        world = World(self, agents=("platform", "coder"))
        engine = world.new_engine()
        self.service.up = False
        waits = []
        engine.feed = feed = sb.EventFeed(self.route(5), engine.audit, world.clock.now, sleep=lambda s: (waits.append(s), len(waits) >= 5 and feed.stop()))
        feed.run()
        engine.discover(world.clock.now())
        before = len(world.v2.calls)
        for _ in range(3):
            sb.feed_tick(engine)
        self.assertEqual((feed.status()["connects"], feed.status()["errors"]), (0, 5))
        self.assertEqual(len(world.v2.calls), before, "no read at all while the service is down")
        self.assertEqual([e for e in world.audit() if e["event"] in ("event.resync", "event.missed")], [])

    def test_the_password_is_in_no_feed_state_no_audit_line_and_no_status_file(self):
        world = World(self, agents=("platform", "coder"))
        engine = world.new_engine()
        engine.feed = feed = sb.EventFeed(self.route(5), engine.audit, world.clock.now, sleep=lambda s: feed.stop())
        feed.need("test")
        self.service.password = "wrong"
        feed.run()
        self.service.password = "pw-secret-1"
        self.service.write_service_file(self.service_file)
        feed.stop_event.clear()
        feed.sleep = lambda s: feed.stop()
        self.service.stream = [feed_line("session.step.ended", assistantMessageID="msg_a")]
        feed.run()
        engine.discover(world.clock.now())
        feed.connected = True
        sb.feed_tick(engine)
        sb.record_v2_calls(engine)
        everything = json.dumps(feed.status()) + (world.state / "audit.jsonl").read_text() + (world.state / sb.V2_CALLS_FILE).read_text()
        self.assertIn("event.resync", everything)
        self.assertNotIn(self.service.password, everything)
        self.assertNotIn("Basic ", everything)
        self.assertNotIn("wrong", everything)


class TestEventFeedStreamEdges(V2TransportBase):
    """V2Http.stream_lines: the limits and error paths the feed relies on."""

    def test_a_service_file_that_moved_is_read_again_after_a_refused_connection(self):
        route = self.route(5)
        self.service.up = False
        with self.assertRaises(sb.V2Unreachable):
            list(route.stream_lines("/api/event"))
        self.assertIsNone(route._info, "the address may have changed: the file is read again")
        self.service.up = True
        self.assertIs(next(route.stream_lines("/api/event")), sb.STREAM_OPENED)

    def test_a_non_finite_time_or_any_surprise_never_kills_the_reader_thread(self):
        feed = sb.EventFeed(None)
        for created in ("NaN", "Infinity", "-Infinity"):
            feed.handle('data: {"type": "session.execution.succeeded", "created": %s, "data": {"sessionID": "ses_w"}}' % created)
            self.assertIsInstance(feed.seen["ses_w"]["idle_ms"], int)
        class Boom:
            def stream_lines(self, path):
                raise RuntimeError("anything")
        sleeps = []
        crashing = sb.EventFeed(Boom(), None, sleep=lambda s: (sleeps.append(s), crashing.stop()))
        crashing.run()
        self.assertEqual((crashing.status()["errors"], crashing.status()["down"]), (1, "RuntimeError"), "counted, and the loop goes on instead of dying")

    def test_a_read_timeout_yields_the_idle_marker_and_any_other_error_does_not(self):
        self.service.stream = [feed_line("session.step.ended", assistantMessageID="m"), None]
        got = list(self.route(5).stream_lines("/api/event"))
        self.assertIs(got[0], sb.STREAM_OPENED)
        self.assertIs(got[-1], sb.STREAM_IDLE, "quiet for the whole idle time: ours to end")
        conn_class = type(self.service.connect("h", 1, timeout=5))
        real_get = conn_class.getresponse

        def broken(conn):
            response = real_get(conn)
            response.readline = lambda limit=-1: (_ for _ in ()).throw(OSError("connection reset"))
            return response
        with mock.patch.object(conn_class, "getresponse", broken):
            got = list(self.route(5).stream_lines("/api/event"))
        self.assertEqual(got, [sb.STREAM_OPENED], "a reset is not the idle end: the next open is a gap")

    def test_a_non_200_answer_is_an_error_and_no_gap_is_marked(self):
        self.service.stream_status = 500
        feed = sb.EventFeed(self.route(5), None, sleep=lambda s: feed.stop())
        feed.needs_resync = False
        feed.run()
        self.assertEqual((feed.status()["errors"], feed.status()["connects"], feed.needs_resync), (1, 0, False))

    def test_an_oversized_line_is_refused_and_counted(self):
        self.service.stream = ["data: " + "x" * 5000]
        with mock.patch.object(sb, "V2_STREAM_LINE_MAX", 1000):
            feed = sb.EventFeed(self.route(5), None, sleep=lambda s: feed.stop())
            feed.run()
        self.assertEqual(feed.status()["errors"], 1)

    def test_a_quiet_stretch_ends_the_connection_and_the_feed_reconnects_never_reading_on_after_the_timeout(self):
        self.service.stream = [feed_line("session.step.ended", assistantMessageID="msg_a"), None, feed_line("session.step.ended", assistantMessageID="msg_never")]
        sleeps, feed = [], None

        def sleep(seconds):
            sleeps.append(seconds)
            if len(sleeps) == 2:
                feed.stop()
        feed = sb.EventFeed(self.route(5), None, sleep=sleep)
        feed.needs_resync = False
        feed.run()
        self.assertEqual(feed.status()["connects"], 2, "ended, then reconnected")
        self.assertEqual(feed.seen["ses_w"]["assistant"], "msg_a", "the line after the timeout was never read on that connection")

    def test_a_refused_password_is_unreachable_and_counted_not_a_crash(self):
        self.service.password = "rotated-and-stale"
        feed = sb.EventFeed(self.route(5), None, sleep=lambda s: feed.stop())
        feed.run()
        self.assertEqual((feed.status()["errors"], feed.status()["down"]), (1, "V2Unreachable"))

    def test_the_wiring_creates_the_feed_only_for_auto_with_an_http_route(self):
        engine = types.SimpleNamespace(v2=types.SimpleNamespace(http=object()), audit=None)
        with mock.patch.object(sb.EventFeed, "start"):
            self.assertIsNotNone(sb.start_event_feed(engine, {"v2_events": "auto"}, time.time))
            self.assertIsNone(sb.start_event_feed(types.SimpleNamespace(v2=types.SimpleNamespace(http=object()), audit=None), {"v2_events": "off"}, time.time))
            self.assertIsNone(sb.start_event_feed(types.SimpleNamespace(v2=types.SimpleNamespace(http=None), audit=None), {"v2_events": "auto"}, time.time), "no HTTP route: no feed")
        self.assertIsNone(sb.start_event_feed(types.SimpleNamespace(v2=types.SimpleNamespace(), audit=None), {"v2_events": "auto"}, time.time))
        with self.assertRaises(sb.ConfigError):
            sb.validate_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "v2_events": "bogus"})


class TestPluginPush(unittest.TestCase):
    """#290 slice 6: the plugin's pushes. The receiver only MARKS a session; the pass thread makes the one bounded read."""
    SESSION = "ses_alpha"

    class Stub:
        def __init__(self):
            self.calls = []

        def message_list(self, session, limit=None, order=None, type=None, cursor=None):
            self.calls.append((session, limit, type))
            return []

        def __getattr__(self, name):   # any other call (a write, a send) is a failure of the test
            raise AssertionError("the push must cause no call but a bounded read: %s" % name)

    def setUp(self):
        self.now, self.audits = [1000.0], []
        audit = types.SimpleNamespace(append=lambda actor, name, subject, detail: self.audits.append((name, detail)))
        self.feed = sb.EventFeed(None, audit, lambda: self.now[0])
        self.feed.connected, self.feed.needs_resync = True, False
        self.receiver = sb.EventReceiver(self.feed, audit, lambda: self.now[0], known=lambda: {self.SESSION, "ses_beta"})

    def message(self, **fields):
        body = {"v": 1, "kind": "event", "event": "prompt", "sessionID": self.SESSION, "at": 1000000}
        body.update(fields)
        return json.dumps(body).encode()

    def test_s9_a_good_message_marks_only_that_session_and_the_next_pass_reads_it_once(self):
        engine = types.SimpleNamespace(v2=self.Stub())
        self.assertTrue(self.receiver.handle(self.message()))
        self.assertEqual(engine.v2.calls, [], "the receiver reads nothing")
        self.assertEqual(list(self.feed.seen), [self.SESSION])
        self.feed.tick(engine, [self.SESSION, "ses_beta"])
        self.assertEqual(engine.v2.calls, [(self.SESSION, sb.FEED_PAGE, "assistant")], "one bounded read, for that session only")
        self.feed.tick(engine, [self.SESSION, "ses_beta"])
        self.assertEqual(len(engine.v2.calls), 1, "read once: nothing new was pushed")

    def test_s10_seven_kinds_of_bad_message_touch_nothing_and_are_counted(self):
        bad = [self.message(pad="x" * 3000), self.message(v=2), self.message(event="nonsense"), self.message(sessionID="not a session"),
               self.message(text="a prompt"), b"this is not json", bytes(range(128, 200))]
        for raw in bad:
            self.assertFalse(self.receiver.handle(raw))
        self.assertEqual((self.feed.seen, self.receiver.status()["ignored"]), ({}, 7))
        self.assertFalse(self.receiver.handle(self.message(sessionID="ses_stranger")), "a valid id of no agent of this fleet proves nothing")

    def test_s11_a_burst_is_limited_counted_audited_once_and_never_queued(self):
        for _ in range(100):
            self.receiver.handle(self.message())
        status = self.receiver.status()
        self.assertEqual((status["accepted"], status["rate_limited"]), (sb.PLUGIN_SESSION_PER_SECOND, 100 - sb.PLUGIN_SESSION_PER_SECOND))
        self.assertEqual([n for n, _ in self.audits].count("event.rate_limited"), 1)
        self.now[0] += 2
        self.assertTrue(self.receiver.handle(self.message()), "the next second starts clean: nothing was queued")

    def test_s15_an_event_limited_away_is_still_found_by_the_reconciliation_and_said_to_be_missed(self):
        engine = types.SimpleNamespace(v2=types.SimpleNamespace(calls=[], message_list=lambda *a, **k: [{"id": "msg_new"}]))
        self.feed.need("test")
        self.feed.handle(feed_line("session.step.ended", session=self.SESSION, assistantMessageID="msg_old"))
        for _ in range(sb.PLUGIN_SESSION_PER_SECOND + 5):
            self.receiver.handle(self.message())
        self.assertEqual(self.receiver.status()["rate_limited"], 5, "the last pushes were limited away")
        self.feed.seen[self.SESSION]["read"] = self.now[0] + 1   # the pushed read already happened: only the reconciliation is left to find it
        self.now[0] += sb.FEED_RECONCILE_SECONDS + 2
        self.feed.tick(engine, [self.SESSION])
        self.assertEqual([n for n, _ in self.audits].count("event.missed"), 1)

    def test_a_push_is_read_while_the_stream_is_down_at_most_four_sessions_a_pass_and_a_failed_read_is_tried_again(self):
        sessions = ["ses_%02d" % n for n in range(6)]
        self.receiver.known = lambda: set(sessions)
        self.feed.connected = False   # the stream is down and nobody registered as a consumer
        for session in sessions:
            self.receiver.handle(self.message(sessionID=session))
        engine = types.SimpleNamespace(v2=self.Stub())
        self.feed.tick(engine, sessions)
        self.assertEqual(len(engine.v2.calls), sb.FEED_PUSHED_PER_PASS)
        self.feed.tick(engine, sessions)
        self.assertEqual(sorted(c[0] for c in engine.v2.calls), sessions, "the other two the next pass; none twice")

        class Failing:
            calls = 0

            def message_list(self, *a, **k):
                Failing.calls += 1
                raise sb.V2Error("backoff", None, "skipped")
        self.now[0] += 1
        self.receiver.handle(self.message(sessionID="ses_00"))
        self.feed.tick(types.SimpleNamespace(v2=Failing()), sessions)
        self.feed.tick(types.SimpleNamespace(v2=Failing()), sessions)
        self.assertEqual(Failing.calls, 2, "a failed read is tried again, and counted")
        self.assertEqual(self.feed.status()["read_errors"], 2)

    def test_under_v2_light_a_push_causes_no_read(self):
        engine = types.SimpleNamespace(v2=self.Stub(), light=True, feed=self.feed, discovery=types.SimpleNamespace(agents={"a": types.SimpleNamespace(session_id=self.SESSION)}))
        self.receiver.handle(self.message())
        sb.feed_tick(engine)
        self.assertEqual(engine.v2.calls, [], "the owner's hotfix switch stops every optional history read, a pushed one too")

    def test_s16_with_no_pushes_ten_simulated_minutes_for_twenty_idle_agents_cost_at_most_fifty_calls(self):
        engine = types.SimpleNamespace(v2=self.Stub())
        self.feed.need("test")
        sessions = ["ses_%02d" % n for n in range(20)]
        for _ in range(120):
            self.now[0] += 5
            self.feed.tick(engine, sessions)
        self.assertLessEqual(len(engine.v2.calls), 50)

    def test_u4_no_text_of_a_message_reaches_the_audit_or_the_status(self):
        self.receiver.handle(self.message(text="SENTINEL-PROMPT-TEXT"))
        for _ in range(40):
            self.receiver.handle(self.message(event="idle"))
        self.assertNotIn("SENTINEL-PROMPT-TEXT", repr(self.audits) + repr(self.receiver.status()) + repr(self.feed.status()) + repr(self.feed.seen))

    def test_u5_a_pushed_claim_causes_no_write(self):
        engine = types.SimpleNamespace(v2=self.Stub())   # any call but message_list raises
        self.receiver.handle(self.message(id="msg_claimed", person=True))
        self.feed.tick(engine, [self.SESSION])
        self.assertEqual(len(engine.v2.calls), 1)

    def test_the_socket_carries_pushes_to_the_receiver_without_a_reply_and_judge_requests_as_before(self):
        state = Path(tempfile.mkdtemp(prefix="sbp"))
        self.addCleanup(shutil.rmtree, state, True)
        arrived = threading.Event()

        def on_event(raw):
            self.receiver.handle(raw)
            arrived.set()
        server = sb.JudgeServer(state, lambda text: sb.policy_reply("deny", "judged"), on_event).start()
        self.addCleanup(server.stop)
        reply = sb.ask_judge_daemon(state, json.dumps({"sessionID": self.SESSION, "tool": "shell", "arguments": "ls", "outcome": "allow"}), 2)
        self.assertEqual(reply["outcome"], "deny", "a judge request is answered as before")
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(2)
        with sb.in_directory(state):
            sock.connect(sb.POLICY_SOCKET)
        sock.sendall(self.message() + b"\n")   # no shutdown(SHUT_WR): the server ends at the newline and may close first, and macOS then refuses it (ENOTCONN)
        self.assertEqual(sock.recv(100), b"", "a push gets no reply")
        sock.close()
        self.assertTrue(arrived.wait(5), "the receiver was reached")   # the wait is only a failure bound
        self.assertEqual(self.receiver.status()["accepted"], 1)

    def test_the_socket_is_bound_for_pushes_when_the_judge_is_off_and_only_when_a_feed_runs(self):
        state = Path(tempfile.mkdtemp(prefix="sbp"))
        self.addCleanup(shutil.rmtree, state, True)
        config = {"policy": {"enabled": False}, "v2_plugin_events": "auto"}
        self.assertIsNone(sb.start_judge_server(config, state, None, time.time, types.SimpleNamespace(feed=None, audit=None)))
        engine = types.SimpleNamespace(feed=self.feed, audit=None)
        server = sb.start_judge_server(config, state, None, time.time, engine)
        self.addCleanup(server.stop)
        self.assertTrue((state / sb.POLICY_SOCKET).exists())
        self.assertIsNotNone(engine.event_receiver)
        server.stop()
        self.assertIsNone(sb.start_judge_server(dict(config, v2_plugin_events="off"), state, None, time.time, engine), "off: the gate is the only signal")


class TestEventFeedReads(unittest.TestCase):
    class Stub:
        def __init__(self, pages=None, fail=False):
            self.calls, self.pages, self.fail = [], pages or [[]], fail

        def message_list(self, session, limit=None, order=None, type=None, cursor=None):
            self.calls.append((session, limit, type))
            if self.fail:
                raise sb.V2Error("backoff", None, "skipped")
            return self.pages[0]

    def feed(self, now, audits=None):
        audit = types.SimpleNamespace(append=lambda actor, name, subject, detail: audits.append((name, detail))) if audits is not None else None
        feed = sb.EventFeed(None, audit, lambda: now[0])
        feed.connected, feed.needs_resync = True, False
        feed.need("test")   # a reader that wants the feed's reads (without one the feed only observes)
        return feed

    def test_an_assistant_message_no_event_announced_is_found_by_one_bounded_read_and_said_to_be_missed(self):
        now, audits = [1000.0], []
        feed = self.feed(now, audits)
        feed.handle(feed_line("session.step.ended", session="ses_a", assistantMessageID="msg_old"))
        engine = types.SimpleNamespace(v2=self.Stub([[{"id": "msg_new"}]]))
        feed.tick(engine, ["ses_a"])
        self.assertEqual(engine.v2.calls, [("ses_a", sb.FEED_PAGE, "assistant")], "one bounded read, newest assistant message only")
        self.assertEqual(audits, [("event.missed", {"session": "ses_a", "last_seen": "msg_old", "found": "msg_new"})])
        feed.tick(engine, ["ses_a"])
        self.assertEqual(len(engine.v2.calls), 1, "within the interval: no read")
        now[0] += sb.FEED_RECONCILE_SECONDS + 1
        feed.tick(engine, ["ses_a"])
        self.assertEqual((len(engine.v2.calls), len(audits)), (2, 1), "read again after the interval; nothing new, so nothing missed")
        self.assertEqual(feed.status()["missed"], 1)

    def test_the_reconciliation_is_spread_and_a_read_that_fails_is_tried_again(self):
        feed = self.feed([1000.0])
        engine = types.SimpleNamespace(v2=self.Stub(fail=True))
        sessions = ["s%d" % n for n in range(10)]
        feed.tick(engine, sessions)
        self.assertEqual(len(engine.v2.calls), sb.FEED_RECONCILES_PER_PASS, "at most this many per pass")
        engine.v2.fail = False
        feed.tick(engine, sessions)
        feed.tick(engine, sessions)
        self.assertEqual(len(engine.v2.calls), 3 * sb.FEED_RECONCILES_PER_PASS, "the failed ones came round again")

    def test_a_resync_is_spread_over_passes_and_a_flapping_stream_cannot_cause_a_read_storm(self):
        now, audits = [1000.0], []
        feed = self.feed(now, audits)
        feed.needs_resync = True
        engine = types.SimpleNamespace(v2=self.Stub())
        sessions = ["s%d" % n for n in range(10)]
        feed.tick(engine, sessions)
        self.assertEqual(len(engine.v2.calls), sb.FEED_RESYNC_PER_PASS, "a burst is never made: the first pass reads a few")
        self.assertTrue(feed.needs_resync, "the rest wait for the next passes")
        for _ in range(2):
            feed.tick(engine, sessions)
        self.assertEqual(sorted(c[0] for c in engine.v2.calls), sorted(sessions), "every session was read once, spread over three passes")
        self.assertFalse(feed.needs_resync)
        self.assertEqual([n for n, _ in audits].count("event.resync"), 3)
        for _ in range(5):   # the stream flaps: a new gap each time, within the minimum interval
            feed.needs_resync = True
            now[0] += 5
            feed.tick(engine, sessions)
        self.assertEqual(len(engine.v2.calls), len(sessions), "no session is read again within the minimum interval, however often the stream reconnects")

    def test_a_resync_backlog_does_not_skip_the_reconcile_of_a_session_that_is_due(self):
        now = [5000.0]
        feed = self.feed(now)
        feed.needs_resync = True
        feed.seen["old"] = {"assistant": "m", "idle_ms": None, "read": 5000.0 - sb.FEED_RECONCILE_SECONDS - 1, "event_at": None}
        engine = types.SimpleNamespace(v2=self.Stub())
        sessions = ["old"] + ["s%d" % n for n in range(8)]
        feed.tick(engine, sessions)
        read = [c[0] for c in engine.v2.calls]
        self.assertIn("old", read, "reconciled in the same pass as the resync of the others")
        self.assertEqual(len([r for r in read if r != "old"]), sb.FEED_RESYNC_PER_PASS)

    def test_a_failing_few_cannot_starve_the_rest_and_failures_are_counted(self):
        now = [1000.0]

        class Flaky:
            def __init__(f):
                f.calls = []

            def message_list(f, session, **k):
                f.calls.append(session)
                if session in ("s0", "s1", "s2", "s3"):
                    raise sb.V2Error("backoff", None, "skipped")
                return []
        feed = self.feed(now)
        feed.needs_resync = True
        engine = types.SimpleNamespace(v2=Flaky())
        sessions = ["s%d" % n for n in range(8)]
        feed.tick(engine, sessions)
        feed.tick(engine, sessions)
        self.assertTrue(set(sessions[4:]) <= set(engine.v2.calls), "the sessions after the failing four were reached on the second pass")
        self.assertEqual(feed.status()["read_errors"], 4)

    def test_the_owners_light_switch_means_the_feed_makes_no_read_of_session_history(self):
        feed = self.feed([1000.0])
        feed.needs_resync = True
        engine = types.SimpleNamespace(feed=feed, light=True, discovery=types.SimpleNamespace(agents={"a": types.SimpleNamespace(session_id="ses_a")}),
                                       v2=types.SimpleNamespace(message_list=lambda *a, **k: self.fail("a read under v2_light")), _note=lambda *a: None)
        sb.feed_tick(engine)
        self.assertTrue(feed.needs_resync, "nothing was done, nothing is forgotten")
        engine.light = False
        engine.v2 = self.Stub()
        sb.feed_tick(engine)
        self.assertEqual(len(engine.v2.calls), 1, "and with the switch off the same feed reads")

    def test_with_no_consumer_the_feed_only_observes_and_makes_no_read_at_all(self):
        now = [1000.0]

        class Counting:
            def __init__(c):
                c.calls = 0

            def message_list(c, *a, **k):
                c.calls += 1
                return []
        feed = sb.EventFeed(None, None, lambda: now[0])
        feed.connected, feed.needs_resync = True, True
        engine = types.SimpleNamespace(v2=Counting())
        sessions = ["s%d" % n for n in range(20)]
        for _ in range(360):   # 30 simulated minutes of 5 s passes, 20 idle agents, a connected quiet stream
            now[0] += 5
            feed.tick(engine, sessions)
        no_consumer = engine.v2.calls
        feed.need("a reader")
        feed.needs_resync = True
        for _ in range(360):
            now[0] += 5
            feed.tick(engine, sessions)
        print("\nfeed reads over 30 simulated minutes, 20 idle sessions, connected quiet stream: no consumer %d; with one consumer %d (resync 20 + reconcile)"
              % (no_consumer, engine.v2.calls - no_consumer))
        self.assertEqual(no_consumer, 0)
        self.assertLessEqual(engine.v2.calls, 20 + 2 * 20, "one resync read per session, then at most one reconcile read per session per 10 minutes")

    def test_the_feeds_own_idle_reopen_is_not_a_gap_and_any_other_end_is(self):
        feed = sb.EventFeed(None)
        feed.needs_resync = False
        feed.consume(iter([sb.STREAM_OPENED, sb.STREAM_IDLE]))
        self.assertTrue(feed.quiet_end)
        feed.needs_resync = False
        feed.consume(iter([sb.STREAM_OPENED]))
        self.assertFalse(feed.needs_resync, "reopened after our own idle timeout: nothing was lost to a drop")
        self.assertEqual(feed.status()["connects"], 2)
        feed.consume(iter([sb.STREAM_OPENED]))   # that connection ended some other way (no STREAM_IDLE)
        feed.needs_resync = False
        feed.consume(iter([sb.STREAM_OPENED]))
        self.assertTrue(feed.needs_resync, "a close or a drop is a gap")

    def test_an_idle_end_followed_by_a_failed_open_is_not_remembered_the_next_open_is_a_gap(self):
        feed = sb.EventFeed(None)
        feed.consume(iter([sb.STREAM_OPENED, sb.STREAM_IDLE]))
        self.assertTrue(feed.quiet_end)

        class Down:
            def stream_lines(self, path):
                raise sb.V2Unreachable("down")
        failing = sb.EventFeed(Down(), None, sleep=lambda s: failing.stop())
        failing.quiet_end = True
        failing.run()
        self.assertFalse(failing.quiet_end, "a failed open means events may have been missed: the idle exemption is gone")
        failing.needs_resync = False
        failing.stop_event.clear()
        failing.consume(iter([sb.STREAM_OPENED]))
        self.assertTrue(failing.needs_resync, "idle end, a failed open, then a successful one must resync")

    def test_the_sessions_kept_stay_bounded_when_failed_reads_name_new_ones(self):
        feed = sb.EventFeed(None, None, lambda: 1.0)
        feed.connected, feed.needs_resync = True, False
        feed.need("t")
        engine = types.SimpleNamespace(v2=types.SimpleNamespace(message_list=lambda *a, **k: (_ for _ in ()).throw(sb.V2Error("backoff", None, "x"))))
        with mock.patch.object(sb, "FEED_SESSIONS_MAX", 3):
            for n in range(10):
                feed._read(engine, "ses_%d" % n, 1.0, announced=True)
        self.assertLessEqual(feed.status()["sessions"], 3)

    def test_ids_over_the_cap_are_not_kept_and_the_generator_is_closed_when_the_feed_stops(self):
        feed = sb.EventFeed(None)
        feed.handle(feed_line("session.step.ended", session="s" * (sb.FEED_ID_MAX + 1), assistantMessageID="m"))
        feed.handle(feed_line("session.step.ended", session="ses_ok", assistantMessageID="m" * (sb.FEED_ID_MAX + 1)))
        self.assertEqual(list(feed.seen), ["ses_ok"])
        self.assertIsNone(feed.seen["ses_ok"]["assistant"], "an over-long id is dropped, the event still counts")
        closed = []

        def lines():
            try:
                yield sb.STREAM_OPENED
                yield "data: {}"
            finally:
                closed.append(True)
        gen = lines()
        feed.stop()
        feed.consume(gen)
        self.assertEqual(closed, [True], "closed at once, not when collected")

    def test_at_least_a_whole_pass_of_persistently_failing_sessions_go_to_the_back_and_the_rest_are_reached(self):
        now = [1000.0]

        class Flaky:
            def __init__(f):
                f.calls = []

            def message_list(f, session, **k):
                f.calls.append(session)
                if session in failing:
                    raise sb.V2Error("backoff", None, "skipped")
                return [{"id": "m"}]
        sessions = ["s%d" % n for n in range(sb.FEED_RESYNC_PER_PASS + 6)]
        failing = set(sessions[:sb.FEED_RESYNC_PER_PASS + 1])   # more than a whole pass of sessions keep failing
        feed = self.feed(now)
        feed.needs_resync = True
        engine = types.SimpleNamespace(v2=Flaky())
        for _ in range(4):
            now[0] += 200
            feed.tick(engine, sessions)
        self.assertTrue(set(sessions[len(failing):]) <= set(engine.v2.calls), "the healthy sessions were reached although a whole pass of others keeps failing")

    def test_a_feed_that_is_not_connected_reads_nothing_the_old_reads_are_all_there_is(self):
        feed = sb.EventFeed(None, None, lambda: 1000.0)
        feed.needs_resync = True
        feed.need("test")
        engine = types.SimpleNamespace(v2=types.SimpleNamespace(message_list=lambda *a, **k: self.fail("a read while the stream is down")))
        feed.tick(engine, ["ses_a"])

    def test_a_feed_that_breaks_never_fails_the_pass_and_is_said_once(self):
        notes = []
        feed = sb.EventFeed(None)
        feed.tick = mock.Mock(side_effect=RuntimeError("boom"))
        engine = types.SimpleNamespace(feed=feed, discovery=None, _note=lambda *a: notes.append(a))
        sb.feed_tick(engine)
        self.assertEqual(notes[0][0], "event.feed.error")
        sb.feed_tick(types.SimpleNamespace())   # no feed at all: nothing

    def test_the_status_line_says_the_stream_is_up_or_that_the_old_reads_are_in_use(self):
        with tempfile.TemporaryDirectory() as tmp:
            engine = types.SimpleNamespace(state_dir=tmp, now=lambda: 1000.0, v2=types.SimpleNamespace(calls_by_operation=lambda *a, **k: {}))
            engine.feed = sb.EventFeed(None)
            engine.feed.connected = True
            sb.record_v2_calls(engine)
            self.assertIn("events: stream", sb.v2_calls_status(tmp, 1000.0))
            engine.feed.connected = False
            sb.record_v2_calls(engine)
            self.assertIn("events: DOWN: old reads", sb.v2_calls_status(tmp, 1000.0))


class TestSourceBudgets(Base):
    """#494 (slice 2 of #467): the load alert's reads, the charter orders reads and the GitHub catch-up each have a time budget in a pass,
    stop between calls and finish over the following passes: no read twice, no finding lost, no event window dropped."""

    # -- S1: the key

    def test_s1_the_key_has_defaults_zero_means_no_limit_and_a_bad_value_names_the_key(self):
        sb.validate_source_budgets({}, "t")
        sb.validate_source_budgets({"source_budgets": {"load_alert": 0, "catch_up": 5}}, "t")
        self.assertEqual((sb.source_budget_seconds({"source_budgets": {"load_alert": 0}}, "load_alert"),
                          sb.source_budget_seconds({"source_budgets": {"catch_up": 5}}, "catch_up"),
                          sb.source_budget_seconds({}, "catch_up")), (0, 5, sb.SOURCE_BUDGET_DEFAULTS["catch_up"]))
        self.assertEqual(sb.SOURCE_BUDGET_DEFAULTS["catch_up"], 90, "the catch-up default is the bound it always had")
        for bad in ({"load_alert": -1}, {"charters": True}, {"catch_up": "9"}, {"nope": 1}):
            with self.assertRaises(sb.ConfigError) as caught:
                sb.validate_source_budgets({"source_budgets": bad}, "t")
            self.assertEqual(str(caught.exception).count("source_budgets"), 1, bad)
        with self.assertRaises(sb.ConfigError):
            sb.validate_source_budgets({"source_budgets": [1]}, "t")
        self.assertIn("source_budgets", sb.config_known_keys())

    def test_the_budget_is_never_spent_at_zero_and_is_spent_after_its_seconds(self):
        clock = [100.0]
        free, five = sb.SourceBudget(0, lambda: clock[0]), sb.SourceBudget(5, lambda: clock[0])
        clock[0] += 10_000
        self.assertEqual((free.spent(), five.spent()), (False, True))

    # -- S2: the load alert

    T0 = 1_800_000_000.0

    def load_run(self, seconds, directory):
        health = sb.load_fleet_health()
        clock, reads = [self.T0], []
        orchestrators = {"o%d" % n: {"charter": n, "repo": "acme/r%d" % n, "busy": 0, "idle": 1, "messages": 0} for n in range(1, 5)}

        def read_asks(charter, repo):
            reads.append(("asks", repo))
            clock[0] += 2
            return [{"repo": repo, "number": 100 * charter}]

        def read_charters(repo):
            reads.append(("charters", repo))
            clock[0] += 2
            return []
        passes, pending = 0, []
        directory.mkdir(parents=True, exist_ok=True, mode=0o700)
        while passes < 10:
            passes += 1
            budget = sb.SourceBudget(seconds, lambda: clock[0])
            pending = []
            ctx = health.Context(now=self.T0 + 30 * passes, state_dir=str(directory), cfg=dict(health.DEFAULTS, enabled=True), orchestrators=orchestrators,
                                 read_asks=read_asks, read_charters=read_charters, cos="cos", wake=lambda text: None, time_up=budget.spent, pending=pending)
            health.tick(ctx)
            if not pending:
                break
        lists = {n: [(a["repo"], a["number"]) for a in e["list"]] for n, e in json.loads((directory / "load.json").read_text())["asks"].items()}
        return reads, passes, lists

    def test_s2_the_load_alert_reads_once_each_over_passes_and_finds_what_an_unbudgeted_run_finds(self):
        base = self.state_dir.parent / "budget-load"
        free_reads, free_passes, free_lists = self.load_run(0, base / "free")
        reads, passes, lists = self.load_run(5, base / "budgeted")
        self.assertEqual((len(free_reads), free_passes), (8, 1))
        self.assertEqual((len(reads), len(set(reads)), passes), (8, 8, 3), "8 distinct reads over 3 passes, none twice")
        self.assertEqual(lists, free_lists, "the budgeted run finds what the unbudgeted run finds")
        self.assertEqual(sorted(reads), sorted(free_reads))

    # -- S3: the charter orders

    class OrdersEngine:
        def __init__(self, test, names, seconds):
            self.clock, self.reads, self.notes = [1000.0], [], []
            self.config = {"source_budgets": {"charters": seconds}}
            self.discovery = types.SimpleNamespace(agents={n: types.SimpleNamespace(
                name=n, fleet={"role": "coder", "charter": 1, "repo": "acme/r"}, conflict=False, problem=None, session_id="ses_" + n, created=1.0)
                for n in names})
            self.reads_obj = types.SimpleNamespace(compaction_page=lambda session, limit, now: [])

        reads_attr = None
        now = lambda self: self.clock[0]

        def charter_repo(self, observation):
            return "acme/r"

        def charter_orders(self, observation, charter):
            self.reads.append(observation.name)
            self.clock[0] += 2
            return ["approve deploys here"]

        @property
        def reads_(self):
            return self.reads_obj

        def _note(self, *args, **kwargs):
            self.notes.append(args)

    def orders_source(self, seconds):
        engine = self.OrdersEngine(self, ["a%d" % n for n in range(1, 7)], seconds)
        engine.__dict__["reads"], engine.__dict__["read_log"] = engine.reads_obj, engine.reads
        # `reads` is the log the test counts; the source reads `engine.reads.compaction_page`, so give the log object that method too
        class Log(list):
            compaction_page = staticmethod(lambda session, limit, now: [])
        log = Log()
        engine.reads = log
        source = sb.OrdersFacts()
        source.engine = engine
        return source, engine, log

    def test_s3_every_agent_is_told_its_orders_once_and_no_read_repeats(self):
        source, engine, log = self.orders_source(5)
        told, passes = [], 0
        while passes < 10:
            passes += 1
            told += [f.recipient for f in source()]
            if sb.source_states(engine)["charters"]["state"] == "done":
                break
        self.assertEqual((sorted(told), passes, len(log), len(set(log))), (["a1", "a2", "a3", "a4", "a5", "a6"], 2, 6, 6))
        free_source, free_engine, free_log = self.orders_source(0)
        self.assertEqual(sorted(f.recipient for f in free_source()), sorted(told))
        self.assertEqual(sb.source_states(free_engine)["charters"]["state"], "done")

    def test_a_budget_smaller_than_one_read_still_makes_progress(self):
        source, engine, log = self.orders_source(1)
        for _ in range(8):
            source()
        self.assertEqual(sorted(set(log)), ["a1", "a2", "a3", "a4", "a5", "a6"], "one agent a pass at least: nobody is starved")

    # -- S4 to S7: the catch-up

    def catch_up_rig(self, seconds):
        rig = GithubRig(self, config={"sweep": False, "triage": False, "source_budgets": {"catch_up": seconds}})
        rig.world.clock.t += 7200
        rig.gh.issue(12, parent=1)
        rig.pump(15)                                   # the first read of a fresh repo sets its marker
        rig.world.clock.t += 60
        rig.gh.comment(12, "while away", 5001, forward=False)
        rig.gh.pull(30)
        self.reads = []
        real = rig.hub.read_pages

        def slow(path, *args, **kwargs):
            self.reads.append(path)
            rig.world.clock.t += 2
            return real(path, *args, **kwargs)
        rig.hub.read_pages = slow
        return rig

    def run_catch_up(self, rig):
        calls = 0
        while calls < 20:
            calls += 1
            rig.hub.catch_up(rig.watch(), rig.world.clock.now())
            if GH_REPO not in rig.hub._cursors:
                break
        return calls

    def test_s4_a_budgeted_catch_up_reads_each_step_once_and_finds_what_an_unbudgeted_one_finds(self):
        free = self.catch_up_rig(0)
        before = free.hub.markers[GH_REPO]
        self.assertEqual(self.run_catch_up(free), 1)
        every, found = list(self.reads), free.keys()
        self.assertGreaterEqual(len(every), 5)
        rig = self.catch_up_rig(3)
        calls = self.run_catch_up(rig)
        self.assertGreater(calls, 1)
        self.assertEqual((len(self.reads), len(set(self.reads))), (len(every), len(set(every))), "the same reads, none twice")
        self.assertEqual(rig.keys(), found)

    def test_s5_a_stopped_catch_up_keeps_its_marker_and_reads_the_unread_part_later(self):
        rig = self.catch_up_rig(3)
        marker = rig.hub.markers[GH_REPO]
        at = rig.world.clock.now()
        rig.hub.catch_up(rig.watch(), at)
        self.assertIn(GH_REPO, rig.hub._cursors)
        self.assertEqual(rig.hub.markers[GH_REPO], marker, "the marker did not move over a window that was not read")
        first = len(self.reads)
        self.assertEqual(rig.watch().catchup_at, at, "only the budget stopped it: it goes on at the next pass")
        self.run_catch_up(rig)
        self.assertGreater(len(self.reads), first)
        self.assertGreater(rig.hub.markers[GH_REPO], marker)
        self.assertIn("github.comment:5001", rig.keys(), "the event of the unread part arrived")
        self.assertEqual(len(self.reads), len(set(self.reads)))

    def test_s5b_a_secondary_read_the_budget_stopped_is_read_later_not_dropped(self):
        rig = self.catch_up_rig(5)
        rig.gh.runs.append({"id": 9001, "name": "ci", "status": "completed", "conclusion": "success", "updated_at": rig.gh.stamp(),
                            "head_sha": "sha30", "pull_requests": [{"number": 30}], "event": "push"})
        marker = rig.hub.markers[GH_REPO]
        rig.hub.catch_up(rig.watch(), rig.world.clock.now())
        runs = lambda: [r for r in self.reads if r.startswith("repos/%s/actions/runs" % GH_REPO)]
        self.assertEqual(runs(), [], "the budget stopped it before the last step")
        self.assertEqual(rig.hub.markers[GH_REPO], marker, "a stopped secondary step does not let the marker over its window")
        self.run_catch_up(rig)
        self.assertEqual(len(runs()), 1, "the step the budget stopped is read later, once")
        self.assertGreater(rig.hub.markers[GH_REPO], marker)

    def test_s6_a_repo_that_keeps_stopping_is_said_not_starved(self):
        rig = self.catch_up_rig(1)
        for _ in range(sb.GITHUB_CATCHUP_STUCK_PASSES):
            rig.hub.catch_up(rig.watch(), rig.world.clock.now())
        self.assertIn("not finished after 3 passes", rig.watch().catch_up_error)
        self.assertEqual(rig.hub.catching_up(), ["%s (3 passes)" % GH_REPO])
        self.assertIn("not finished after 3 passes", " ".join(sb.format_github(sb.github_status(rig.world.config, rig.world.state)) + [rig.watch().catch_up_error]))
        self.run_catch_up(rig)
        self.assertEqual((rig.hub.catching_up(), rig.watch().catch_up_error), ([], None))

    def test_s7_each_source_says_pending_while_it_stops_and_done_after(self):
        rig = self.catch_up_rig(3)
        rig.hub.catch_up(rig.watch(), rig.world.clock.now())
        rig.hub.tick()
        self.assertEqual(sb.source_states(rig.world.engine)["catch_up"]["state"], "pending")
        self.assertIn(GH_REPO, sb.source_states(rig.world.engine)["catch_up"]["pending"][0])
        self.run_catch_up(rig)
        rig.hub.tick()
        self.assertEqual(sb.source_states(rig.world.engine)["catch_up"], {"state": "done", "pending": []})
        source, engine, log = self.orders_source(5)
        source()
        self.assertEqual(sb.source_states(engine)["charters"]["state"], "pending")

    def test_the_parent_read_stops_at_the_budget_and_is_read_later(self):
        health = sb.load_fleet_health()
        reads, spent = [], [True]
        pending = []
        ctx = health.Context(now=self.T0, state_dir=None, cfg=dict(health.DEFAULTS), orchestrators={}, read_parent=lambda repo, number: reads.append(number) or 7,
                             time_up=lambda: spent[0], pending=pending)
        state, problems = {}, []
        budget = health._Budget(ctx, state, self.T0)
        self.assertEqual(health._parent_of(ctx, state, budget, "acme/widget", 3, self.T0, problems), (None, False))
        self.assertEqual((reads, pending), ([], ["parent of acme/widget#3"]))
        spent[0] = False
        self.assertEqual(health._parent_of(ctx, state, budget, "acme/widget", 3, self.T0 + 30, problems), (7, True))
        self.assertEqual(health._parent_of(ctx, state, budget, "acme/widget", 3, self.T0 + 60, problems), (7, True))
        self.assertEqual(reads, [3], "read once, kept")

    # -- a repo that leaves the watched set, or is excluded, loses its cursor (rev-wake on #504)

    def test_a_repo_that_leaves_while_pending_loses_its_cursor_and_is_not_read(self):
        rig = self.catch_up_rig(3)
        rig.hub.catch_up(rig.watch(), rig.world.clock.now())
        self.assertEqual(len(rig.hub.catching_up()), 1)
        rig.hub.config = dict(rig.hub.config, github_repos=[])
        rig.hub.reconcile(rig.world.engine.discover(rig.world.clock.now()))
        self.assertEqual((rig.hub.catching_up(), rig.hub._cursors), ([], {}))
        rig.hub.tick()
        self.assertEqual(sb.source_states(rig.world.engine)["catch_up"], {"state": "done", "pending": []})
        before = len(rig.gh.api_calls)
        rig.hub.tick()
        self.assertEqual(len(rig.gh.api_calls), before, "0 reads of a repo that is not watched")

    def test_a_repo_that_rejoins_starts_a_fresh_window(self):
        rig = self.catch_up_rig(3)
        rig.hub.catch_up(rig.watch(), rig.world.clock.now())
        stale = rig.hub._cursors[GH_REPO]["since_epoch"]
        rig.hub.config = dict(rig.hub.config, github_repos=[])
        rig.hub.reconcile(rig.world.engine.discover(rig.world.clock.now()))
        rig.world.clock.t += 600
        rig.hub.config = dict(rig.hub.config, github_repos=[GH_REPO])
        rig.hub.reconcile(rig.world.engine.discover(rig.world.clock.now()))
        self.assertNotIn(GH_REPO, rig.hub._cursors)
        rig.hub.catch_up(rig.watch(), rig.world.clock.now())
        self.assertGreater(rig.hub._cursors.get(GH_REPO, {"since_epoch": 0})["since_epoch"], stale - 1, "a new window, not the old one")
        self.assertEqual(rig.hub._cursors[GH_REPO]["done"] and len(rig.hub._cursors[GH_REPO]["done"]) <= 2, True, "it began again from its first steps")

    def test_an_excluded_repo_with_a_stale_cursor_is_not_read(self):
        rig = self.catch_up_rig(3)
        rig.hub.catch_up(rig.watch(), rig.world.clock.now())
        self.assertIn(GH_REPO, rig.hub._cursors)
        rig.hub.config = dict(rig.hub.config, excluded_repos=[GH_REPO])
        before = len(rig.gh.api_calls)
        rig.hub.catch_up(rig.watch(), rig.world.clock.now())
        self.assertEqual((len(rig.gh.api_calls), rig.hub.catching_up()), (before, []), "0 reads of an excluded repo and no 'catching up' for it")

    def test_s8_the_budgeted_reads_add_no_thread_and_no_process(self):
        with mock.patch.object(threading.Thread, "start", side_effect=AssertionError("a thread was started")), \
                mock.patch.object(subprocess, "Popen", side_effect=AssertionError("a process was started")):
            rig = self.catch_up_rig(3)
            self.run_catch_up(rig)
            source, engine, log = self.orders_source(5)
            source()
            source()


class TestLoadAlert(Base):
    """#348: the load figures per orchestrator, the hourly series, the `status` lines and the once-per-episode alert to the Chief of Staff."""
    T0 = _dt.datetime(2026, 10, 14, 10, 0, tzinfo=_dt.timezone.utc).timestamp()

    def setUp(self):
        super().setUp()
        self.state_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
        os.chmod(str(self.state_dir), 0o700)
        self.health = sb.load_fleet_health()
        self.asks = {}       # orchestrator -> [numbers]
        self.reads = []
        self.woken = []
        self.fail_reads = False

    def orch(self, busy=0, idle=0, messages=0, charter=1):
        return {"charter": charter, "repo": "acme/widget", "busy": busy, "idle": idle, "messages": messages}

    def tick(self, at, orchestrators, **cfg):
        def read_asks(charter, repo):
            self.reads.append((at, charter))
            if self.fail_reads:
                raise RuntimeError("gh is down")
            return [{"repo": "acme/widget", "number": n} for n in self.asks[charter]]
        ctx = self.health.Context(now=at, state_dir=str(self.state_dir), cfg=dict(self.health.DEFAULTS, **dict({"enabled": True}, **cfg)), orchestrators=orchestrators,
                                  read_asks=read_asks, cos="cos", wake=self.woken.append, reminders=list(getattr(self, "reminders", [])), pr_refs=dict(getattr(self, "pr_refs", {})),
                                  **({"read_parent": lambda repo, n: self.parents.get(n)} if getattr(self, "parents", None) is not None else {}))
        return self.health.tick(ctx)

    def latest(self):
        return json.loads((self.state_dir / "load.json").read_text())["latest"]

    def move(self, at, number, kind="push"):
        self.health.append_moves(str(self.state_dir), [{"at": at, "repo": "acme/widget", "numbers": [number], "kind": kind}])

    # ---- #757: an ask waiting on a held PR or on a set time is not stalled
    def held_world(self, tier="human", since_ago=3600, link=True, pr=50, reminders=(), extra_asks=(), refs=None, pr_repo="acme/widget"):
        """Ask 1 (unmoved for 3 h at the second pass) and, when `link`, a held PR #pr whose body names it; returns the figures of orchestrator `o`."""
        self.asks = {1: [1] + list(extra_asks)}
        self.reminders = list(reminders)
        orchestrators = {"o": dict(self.orch(idle=1, charter=1), workers=["w1"])}
        self.tick(self.T0, orchestrators)
        late = self.T0 + 3 * 3600
        if link:
            self.pr_refs = {"%s#%d" % (pr_repo, pr): [["acme/widget", 1]] if refs is None else refs}   # what the daemon read from the current body of the notice
        if tier:
            since = _dt.datetime.fromtimestamp(late - since_ago, _dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
            (self.state_dir / "decisions.json").write_text(json.dumps({"decisions": [{"kind": "captain", "repo": pr_repo, "number": pr, "tier": tier, "since": since}]}))
        self.tick(late, orchestrators)
        return self.latest()["o"]

    def test_an_ask_with_a_held_pr_at_tier_human_waits_on_the_owner_and_is_not_stalled(self):
        got = self.held_world("human", since_ago=2 * 86400)   # the owner's wait has no limit
        self.assertEqual((got["stalled"], got["stalled_asks"], got["waiting_owner"], got["waiting_owner_pr"], got["waiting_time"]), (0, [], 1, 1, 0))

    def test_a_held_pr_row_of_tier_cos_is_the_chief_of_staffs_wait_only_for_stalled_hours(self):
        got = self.held_world("cos", since_ago=3600)
        self.assertEqual((got["stalled"], got["waiting_cos"], got["waiting_owner"], got["waiting_owner_pr"]), (0, 1, 0, 0))
        got = self.held_world("cos", since_ago=3 * 3600)    # left unescalated (or its escalation dropped by a head move) past the hours
        self.assertEqual((got["stalled"], got["stalled_asks"], got["waiting_cos"]), (1, [1], 0))

    def test_a_held_pr_whose_escalation_was_dropped_puts_the_ask_back_to_stalled(self):
        got = self.held_world("human")
        self.assertEqual(got["stalled"], 0)
        rows = json.loads((self.state_dir / "decisions.json").read_text())
        rows["decisions"][0].update(tier="cos", since=_dt.datetime.fromtimestamp(self.T0 + 3600, _dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"))   # a head move: back to cos
        (self.state_dir / "decisions.json").write_text(json.dumps(rows))
        self.tick(self.T0 + 3 * 3600 + 120, {"o": dict(self.orch(idle=1, charter=1), workers=["w1"])})
        self.assertEqual((self.latest()["o"]["stalled"], self.latest()["o"]["waiting_owner"]), (1, 0))

    def test_a_link_with_no_decision_row_does_not_exempt_the_ask(self):
        self.assertEqual(self.held_world(tier=None)["stalled"], 1)

    def test_a_pr_with_no_row_a_closed_row_or_another_asks_link_does_not_exempt_the_ask(self):
        self.assertEqual(self.held_world("human", link=False)["stalled"], 1)  # a row and no link to the ask

    def test_unreadable_or_malformed_decision_rows_are_no_held_pull_request(self):
        path = self.state_dir / "decisions.json"
        self.assertEqual(self.health.held_prs(str(self.state_dir)), [])                  # no file
        path.write_text("{not json")
        self.assertEqual(self.health.held_prs(str(self.state_dir)), [])
        path.write_text(json.dumps({"decisions": "x"}))
        self.assertEqual(self.health.held_prs(str(self.state_dir)), [])
        good = {"kind": "captain", "repo": "acme/widget", "number": 5, "tier": "human", "since": "2026-10-14T10:00:00Z"}
        path.write_text(json.dumps({"decisions": [dict(good, number=True), dict(good, repo="bad repo!"), dict(good, tier="agent"), dict(good, kind="notice"), "x", dict(good, since="garbage"), good]}))
        self.assertEqual([(r["number"], r["since"] is None) for r in self.health.held_prs(str(self.state_dir))], [(5, True), (5, False)])

    def test_a_link_reaches_the_ask_through_its_work_item_and_is_gone_when_the_reference_is_removed(self):
        self.parents = {7: 1}   # work item 7 sits under ask 1 (the cached parent read)
        got = self.held_world("human", refs=[["acme/widget", 7]])
        self.assertEqual((got["stalled"], got["waiting_owner_pr"]), (0, 1))
        self.pr_refs = {"acme/widget#50": []}   # the body no longer names it: the link is rebuilt each pass, nothing stale is kept
        self.tick(self.T0 + 3 * 3600 + 120, {"o": dict(self.orch(idle=1, charter=1), workers=["w1"])})
        self.assertEqual((self.latest()["o"]["stalled"], self.latest()["o"]["waiting_owner_pr"]), (1, 0))

    def test_a_same_repository_reference_links_through_the_pull_requests_own_repository(self):
        got = self.held_world("human", refs=[[None, 1]])
        self.assertEqual((got["stalled"], got["waiting_owner_pr"]), (0, 1))

    def test_a_reference_to_another_ask_or_another_owners_repository_leaves_the_ask_stalled(self):
        self.assertEqual(self.held_world("human", refs=[["acme/widget", 300]])["stalled"], 1)     # a held PR that names another issue
        got = self.held_world("human", refs=[["other-org/widget", 1]], pr=51)                      # the same number and repository name under another owner
        self.assertEqual((got["stalled"], got["waiting_owner_pr"]), (1, 0))

    def test_a_row_of_another_owners_repository_with_the_same_name_does_not_serve_the_ask(self):
        got = self.held_world("human", refs=[[None, 1]], pr_repo="other-org/widget")   # a same-repo `#1` of the PR's own repository, which is not this ask's
        self.assertEqual((got["stalled"], got["waiting_owner_pr"]), (1, 0))

    def test_the_notice_facts_carry_the_strict_references_of_the_current_body(self):
        self.assertEqual(sb.pr_facts_from({"state": "OPEN", "body": "Part of #3\nsee #300"})["refs"], [[None, 3]])
        self.assertEqual(sb.pr_facts_from({"state": "OPEN", "body": "see #300"})["refs"], [])

    def test_only_the_strict_forms_of_a_pull_request_body_are_references(self):
        refs = lambda body: sb.pr_body_refs(body)
        self.assertEqual(refs("PLAN: https://github.com/acme/widget/issues/757#issuecomment-5\n\nPart of #756.\nCloses acme/widget#3"), [["acme/widget", 757], [None, 756], ["acme/widget", 3]])
        self.assertEqual(refs("PLAN: acme/widget#9"), [["acme/widget", 9]])
        for body in ("see #300 for context", "fix-756-typo and #4 mentioned", "> Closes #5", "Closes #6 and more words", "intro\nPLAN: acme/widget#8", "PLAN: not a plan", None, 7):
            self.assertEqual(refs(body), [], body)

    def test_a_closed_row_does_not_exempt_the_ask(self):
        self.assertEqual(self.held_world("human")["stalled"], 0)
        rows = json.loads((self.state_dir / "decisions.json").read_text())
        rows["decisions"][0]["closed"] = True
        (self.state_dir / "decisions.json").write_text(json.dumps(rows))
        self.tick(self.T0 + 3 * 3600 + 120, {"o": dict(self.orch(idle=1, charter=1), workers=["w1"])})
        self.assertEqual(self.latest()["o"]["stalled"], 1)

    def test_a_held_pr_serves_only_the_asks_it_names(self):
        got = self.held_world("human", extra_asks=(2,))
        self.assertEqual((got["stalled_asks"], got["waiting_owner_pr"]), ([2], 1))

    def test_a_pending_reminder_due_later_that_names_the_ask_is_a_set_time_wait(self):
        later = self.T0 + 5 * 3600
        for to in ("o", "w1"):    # the orchestrator's own, and an owned worker's
            got = self.held_world(tier=None, link=False, reminders=[{"to": to, "at": later, "issue": 1, "repo": "acme/widget", "text": "x"}])
            self.assertEqual((got["stalled"], got["waiting_time"], got["waiting_owner_pr"]), (0, 1, 0), to)

    def test_a_past_due_a_stranger_s_or_another_asks_reminder_is_not_a_wait(self):
        later = self.T0 + 5 * 3600
        for item in ({"to": "o", "at": self.T0 + 3 * 3600 - 1, "issue": 1}, {"to": "stranger", "at": later, "issue": 1}, {"to": "o", "at": later, "issue": 9}, {"to": "o", "at": later, "issue": 1, "repo": "acme/other"}):
            got = self.held_world(tier=None, link=False, reminders=[dict(item, text="x")])
            self.assertEqual((got["stalled"], got["waiting_time"]), (1, 0), item)

    def test_an_owner_wait_is_counted_once_even_with_a_reminder_too(self):
        got = self.held_world("human", reminders=[{"to": "o", "at": self.T0 + 5 * 3600, "issue": 1, "text": "x"}])
        self.assertEqual((got["waiting_owner_pr"], got["waiting_time"], got["active_asks"]), (1, 0, 0))

    def test_the_load_line_says_both_counts_and_plain_asks_read_as_before(self):
        phrase = "waiting on the owner: 2 (via a held PR), on a set time: 3"
        fig = {"name": "o", "open_asks": 6, "stalled": 1, "stalled_asks": [4], "moved_1h": 0, "moved_backlog": 0, "busy": 1, "idle": 0, "messages": 0, "decisions": 0,
               "waiting_owner_pr": 2, "waiting_time": 3}
        self.assertIn(phrase, self.health.wake_text(fig, ["stalled"], self.health.DEFAULTS))
        self.assertNotIn("waiting on the owner", self.health.wake_text(dict(fig, waiting_owner_pr=0, waiting_time=0), ["stalled"], self.health.DEFAULTS))
        self.held_world("human", reminders=[{"to": "o", "at": self.T0 + 5 * 3600, "issue": 1, "text": "x"}], extra_asks=(2,))
        line = [l for l in self.health.status_lines(str(self.state_dir), self.T0) if l.strip().startswith("o ")][0]
        self.assertIn("waiting on the owner: 1 (via a held PR), on a set time: 0", line)

    def test_the_new_figures_read_nothing_from_github(self):
        self.held_world("human", reminders=[{"to": "o", "at": self.T0 + 5 * 3600, "issue": 1, "text": "x"}])
        self.assertEqual(self.reads, [(self.T0, 1), (self.T0 + 3 * 3600, 1)])   # only the hourly asks reads that were made before; the new waits add no read

    def test_each_orchestrator_has_the_five_figures_from_the_records(self):
        self.asks = {1: [10, 11, 12], 2: [20], 3: [30, 31]}
        orchestrators = {"orch-a": self.orch(busy=2, idle=1, messages=1, charter=1), "orch-b": self.orch(idle=1, charter=2), "orch-c": self.orch(busy=1, charter=3)}
        (self.state_dir / "decisions.json").write_text(json.dumps({"decisions": [{"agent": "x", "ask": 10, "repo": "acme/widget"}, {"agent": "x", "ask": 11, "repo": "acme/widget"}, {"agent": "orch-b", "ask": 20, "repo": "acme/widget", "closed": True}]}))   # owned by the ask's chain, not by the agent field)
        self.tick(self.T0, orchestrators)                      # first sight of every ask
        self.move(self.T0 + 3 * 3600 - 60, 10)                 # ask 10 moved 1 minute ago; 20 and 30 moved 3 h ago
        self.move(self.T0 + 3 * 3600 - 60, 12)
        self.tick(self.T0 + 3 * 3600, orchestrators)
        got = self.latest()
        a = got["orch-a"]
        self.assertEqual((a["open_asks"], a["stalled"], a["stalled_asks"], a["moved_1h"], a["busy"], a["idle"], a["messages"], a["decisions"]),
                         (3, 1, [11], 2, 2, 1, 1, 2))
        self.assertEqual((got["orch-b"]["open_asks"], got["orch-b"]["stalled"], got["orch-b"]["decisions"]), (1, 1, 0))
        self.assertEqual((got["orch-c"]["open_asks"], got["orch-c"]["stalled"], got["orch-c"]["oldest_stall_hours"]), (2, 2, 3.0))

    def test_five_movement_kinds_reset_the_clock_and_a_comment_does_not(self):
        self.asks = {1: [1, 2, 3, 4, 5, 6]}
        self.tick(self.T0, {"o": self.orch(busy=1, charter=1)})
        late = self.T0 + 3 * 3600
        for number, kind in ((1, "push"), (2, "pr_opened"), (3, "pr_merged")):
            self.move(late - 100, number, kind)
        ts = lambda at: _dt.datetime.fromtimestamp(at, _dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.000Z")
        with open(str(self.state_dir / "audit.jsonl"), "w") as handle:
            for entry in ({"ts": ts(late - 100), "event": "v2.synthetic", "phase": "intent", "subject": "cos",
                           "detail": {"description": "switchboard: worker report on widget#4: done"}},
                          {"ts": ts(late - 100), "event": "plan.review.consensus", "subject": "acme/widget#5", "detail": {}},
                          {"ts": ts(late - 100), "event": "github.comment", "subject": "acme/widget#6", "detail": {}}):   # a plain comment
                handle.write(json.dumps(entry) + "\n")
        self.tick(late, {"o": self.orch(busy=1, charter=1)})
        self.assertEqual((self.latest()["o"]["stalled"], self.latest()["o"]["stalled_asks"], self.latest()["o"]["moved_1h"]), (1, [6], 5))

    def test_move_rows_come_from_webhooks_and_a_comment_makes_none(self):
        pr = {"number": 7, "body": "Closes #3", "merged": True}
        rows = lambda event, action, **kw: self.health.move_rows(event, {"action": action, "pull_request": dict(pr, **kw)}, "acme/widget", 5, sb.closing_numbers)
        self.assertEqual([r["kind"] for r in rows("pull_request", "synchronize")], ["push"])
        self.assertEqual([r["kind"] for r in rows("pull_request", "opened")], ["pr_opened"])
        self.assertEqual([r["kind"] for r in rows("pull_request", "closed")], ["pr_merged"])
        self.assertEqual(rows("pull_request", "closed", merged=False), [])
        self.assertEqual(rows("pull_request", "synchronize")[0]["numbers"], [7, 3])
        self.assertEqual(self.health.move_rows("issue_comment", {"action": "created"}, "acme/widget", 5), [])

    def test_the_hourly_series_has_one_entry_per_hour_with_a_pass(self):
        self.asks = {1: [1]}
        for hour in range(6):
            self.tick(self.T0 + hour * 3600 + 120, {"o": self.orch(charter=1)})
        series = json.loads((self.state_dir / "load.json").read_text())["series"]["o"]
        self.assertEqual(sorted(series["hours"]), ["10", "11", "12", "13", "14", "15"])
        self.assertEqual(series["day"], "2026-10-14")

    def test_status_prints_one_line_per_orchestrator_with_the_figures(self):
        self.asks = {1: [1], 2: []}
        self.tick(self.T0, {"orch-a": self.orch(busy=1, charter=1), "orch-b": self.orch(idle=2, charter=2)})
        lines = self.health.status_lines(str(self.state_dir), self.T0)
        self.assertEqual(len([l for l in lines if l.strip().startswith("orch-")]), 2)
        self.assertIn("asks 1, stalled 0", lines[1])
        self.assertIn("coders 1 busy 0 idle", lines[1])
        self.assertEqual(self.health.status_lines(str(self.state_dir / "nowhere"), self.T0), [])
        status = sb.format_status(dict(self.status_skeleton(), load=lines))
        self.assertEqual(len([l for l in status.splitlines() if "asks 1, stalled 0" in l or "asks 0, stalled 0" in l]), 2)

    def status_skeleton(self):
        report = sb.collect_status(runner=lambda *a, **k: types.SimpleNamespace(returncode=1, stdout="", stderr=""), now=lambda: self.T0)
        report["load"] = []
        return report

    # ---- #796: no alert before the first full pass after a start
    def first_pass_world(self, awaiting=True, held=False, links=False, numbers=(1, 2)):
        """An engine as the daemon makes it at a start (`awaiting_first_full_pass`), one orchestrator with two asks nobody moves; `self.clock` is its time."""
        self.clock = [self.T0]
        issues = [types.SimpleNamespace(repo="acme/widget", number=n, labels=(), parked_until=None) for n in numbers]
        self.parent_fails = True

        def api(path, repo):
            if self.parent_fails:
                raise RuntimeError("the read was cut")
            return []
        intents = types.SimpleNamespace(repo="acme/widget", open_asks=lambda charter, repo: issues, _api=api)
        facts = {"acme/widget#50": {"facts": {"refs": [["acme/widget", 1]]}}} if held else {}
        engine = types.SimpleNamespace(state_dir=str(self.state_dir), now=lambda: self.clock[0], audit=None, actor="daemon", intents=intents, notice_facts=facts,
                                       awaiting_first_full_pass=awaiting, awaiting_held_links=links, config={"load_alert": self.health.validate({"enabled": True}, "x")})
        agents = {"o": types.SimpleNamespace(name="o", session_id="s", status="idle", fleet={"role": "orchestrator", "charter": 1, "repo": "acme/widget"}),
                  "cos": types.SimpleNamespace(name="cos", session_id="c", status="idle", fleet={"role": "chief-of-staff"})}
        return engine, types.SimpleNamespace(agents=agents)

    def run_ticks(self, engine, discovery, hours):
        for hour in hours:
            self.clock[0] = self.T0 + hour * 3600
            sb.load_tick(engine, discovery)
        return [r for r in sb.read_reminders(str(self.state_dir)) if "overloaded" in str(r.get("text"))]

    def test_a_fresh_start_raises_no_alert_and_says_it_is_waiting(self):   # S1 S2
        engine, discovery = self.first_pass_world()
        (self.state_dir / "decisions.json").write_text(json.dumps({"decisions": [], "provisional": True}))
        self.assertEqual(self.run_ticks(engine, discovery, (0, 3, 4)), [])
        self.assertIn("load: waiting for the first full pass", self.health.status_lines(str(self.state_dir), self.T0))

    def test_after_the_first_full_pass_the_same_stalled_state_alerts_once(self):   # S3
        engine, discovery = self.first_pass_world()
        self.run_ticks(engine, discovery, (0, 3))
        engine.awaiting_first_full_pass = False
        self.assertEqual(len(self.run_ticks(engine, discovery, (4, 7))), 1)
        self.assertNotIn("load: waiting for the first full pass", self.health.status_lines(str(self.state_dir), self.T0))

    def test_a_restart_does_not_re_arm_the_alert(self):   # S4
        engine, discovery = self.first_pass_world(awaiting=False)
        self.assertEqual(len(self.run_ticks(engine, discovery, (0, 3))), 1)
        engine, discovery = self.first_pass_world()   # restart: a new engine, the same state directory
        self.clock[0] = self.T0 + 3 * 3600
        self.assertEqual(len(self.run_ticks(engine, discovery, (4, 5))), 1)
        engine.awaiting_first_full_pass = False
        self.assertEqual(len(self.run_ticks(engine, discovery, (6, 7))), 1)

    def test_a_held_pr_that_appears_in_the_first_full_pass_is_counted_before_any_alert(self):   # S5
        engine, discovery = self.first_pass_world(held=True)
        self.assertEqual(self.run_ticks(engine, discovery, (0, 3)), [])
        (self.state_dir / "decisions.json").write_text(json.dumps({"decisions": [{"kind": "captain", "repo": "acme/widget", "number": 50, "tier": "human",
                                                                                   "since": "2026-10-14T10:00:00Z"}]}))
        engine.awaiting_first_full_pass = False
        self.assertEqual(self.run_ticks(engine, discovery, (3.1, 3.2)), [])
        self.assertEqual(self.latest()["o"]["waiting_owner_pr"], 1)

    @mock.patch.object(sb, "HELD_LINKS_WAIT_SECONDS", 20 * 3600)   # the passes below are hours apart: the bound is not what this test is about
    def test_a_held_pr_whose_links_are_cut_keeps_the_alert_quiet_until_a_pass_with_them_whole(self):   # S7
        engine, discovery = self.first_pass_world(awaiting=False, held=True, links=True, numbers=(1, 2, 3))
        (self.state_dir / "decisions.json").write_text(json.dumps({"decisions": [{"kind": "captain", "repo": "acme/widget", "number": 50, "tier": "human",
                                                                                   "since": "2026-10-14T10:00:00Z"}]}))
        self.assertEqual(self.run_ticks(engine, discovery, (0, 3, 4)), [])   # the parent read is cut every time: three asks look stalled, none is judged
        self.assertTrue(engine.awaiting_held_links)
        self.assertIn("load: waiting for held PR links", self.health.status_lines(str(self.state_dir), self.T0))
        self.parent_fails = False
        self.assertEqual(len(self.run_ticks(engine, discovery, (5,))), 1)   # the first pass with the links whole: ask 1 is the owner's wait, 2 and 3 are truly stalled: it alerts now
        self.assertFalse(engine.awaiting_held_links)
        self.assertNotIn("load: waiting for held PR links", self.health.status_lines(str(self.state_dir), self.T0))

    def test_the_wait_for_held_pr_links_lapses_after_its_bound(self):   # S7
        engine, discovery = self.first_pass_world(awaiting=False, held=True, links=True, numbers=(1, 2, 3))
        (self.state_dir / "decisions.json").write_text(json.dumps({"decisions": [{"kind": "captain", "repo": "acme/widget", "number": 50, "tier": "human",
                                                                                   "since": "2026-10-14T10:00:00Z"}]}))
        self.assertEqual(self.run_ticks(engine, discovery, (0, 0.1)), [])   # inside the bound
        self.assertEqual(len(self.run_ticks(engine, discovery, (3,))), 1)   # more than 900 s of unreadable links: the alert is not silenced for ever

    def held_row(self, number=50):
        (self.state_dir / "decisions.json").write_text(json.dumps({"decisions": [{"kind": "captain", "repo": "acme/widget", "number": number, "tier": "human",
                                                                                   "since": "2026-10-14T10:00:00Z"}]}))

    @mock.patch.object(sb, "HELD_LINKS_WAIT_SECONDS", 20 * 3600)
    def test_noticed_prs_the_reader_could_not_read_keep_the_alert_quiet_until_a_pass_reads_them(self):   # S8
        engine, discovery = self.first_pass_world(awaiting=False, links=True, numbers=(1, 2, 3))
        self.parent_fails = False
        engine.notice_unread = 2
        self.assertEqual(self.run_ticks(engine, discovery, (0, 3, 4)), [])   # three asks look stalled; the notice reads were cut: nothing is judged
        self.assertTrue(engine.awaiting_held_links)
        self.assertIn("load: waiting for held PR links", self.health.status_lines(str(self.state_dir), self.T0))
        engine.notice_unread = 0   # the next uncut pass read them all
        self.assertEqual(len(self.run_ticks(engine, discovery, (5,))), 1)
        self.assertFalse(engine.awaiting_held_links)

    @mock.patch.object(sb, "HELD_LINKS_WAIT_SECONDS", 20 * 3600)
    def test_a_human_tier_held_pr_with_no_read_references_keeps_the_alert_quiet(self):   # S8: the key-not-in-refs rule
        engine, discovery = self.first_pass_world(awaiting=False, links=True, numbers=(1, 2, 3))
        self.parent_fails = False
        self.held_row()   # a held PR with no entry in the notice facts: its references were never read
        self.assertEqual(self.run_ticks(engine, discovery, (0, 3, 4)), [])
        self.assertTrue(engine.awaiting_held_links)
        engine.notice_facts["acme/widget#50"] = {"facts": {"refs": [["acme/widget", 1]]}}
        self.assertEqual(len(self.run_ticks(engine, discovery, (5,))), 1)
        self.assertFalse(engine.awaiting_held_links)

    def stalled_world(self, count=2):
        self.asks = {1: list(range(1, count + 1))}
        self.tick(self.T0, {"o": self.orch(idle=1, charter=1)})

    def test_two_stalled_asks_wake_once_over_three_passes_with_figures_and_an_action(self):
        self.stalled_world(2)
        for hour in (2, 3, 4):
            self.tick(self.T0 + hour * 3600, {"o": self.orch(idle=1, charter=1)})
        self.assertEqual(len(self.woken), 1)
        text = self.woken[0]
        for part in ("o is overloaded", "2 open ask(s)", "2 with no real movement in 2 h", "#1, #2", "Recommended: move the stalled asks"):
            self.assertIn(part, text)

    def test_a_full_coder_team_with_a_backlog_wakes_once_and_idle_coders_do_not(self):
        self.asks = {1: [1, 2, 3], 2: [4, 5, 6]}
        both = {"full": self.orch(busy=2, idle=0, charter=1), "free": self.orch(busy=2, idle=1, charter=2)}
        self.tick(self.T0, both)
        for number in (1, 4):
            self.move(self.T0 + 3600, number)
        self.tick(self.T0 + 3700, both)
        self.assertEqual([t.split(" is ")[0] for t in self.woken], ["Load alert: full"])
        self.assertIn("split a lane or add coders", self.woken[0])

    def test_worse_wakes_again_and_recovery_then_a_new_crossing_wakes_again(self):
        self.stalled_world(2)
        o = {"o": self.orch(idle=1, charter=1)}
        self.tick(self.T0 + 2 * 3600, o)
        self.assertEqual(len(self.woken), 1)
        self.asks[1] = [1, 2, 3]
        self.tick(self.T0 + 3 * 3600 + 10, o)              # the list is re-read after an hour; ask 3 is new, 1 and 2 still stalled: 2 stalled, not worse
        self.assertEqual(len(self.woken), 1)
        self.tick(self.T0 + 5 * 3600 + 20, o)              # ask 3 has now gone 2 h too: 3 stalled, worse
        self.assertEqual(len(self.woken), 2)
        self.asks[1] = []
        self.tick(self.T0 + 6 * 3600 + 30, o)              # recovered
        self.assertEqual(len(self.woken), 2)
        self.asks[1] = [7, 8]
        self.tick(self.T0 + 7 * 3600 + 40, o)              # two new asks, first seen now
        self.tick(self.T0 + 9 * 3600 + 50, o)              # stalled again: a new crossing after recovery
        self.assertEqual(len(self.woken), 3)

    def test_configured_thresholds_are_followed(self):
        self.stalled_world(2)
        self.tick(self.T0 + 3 * 3600, {"o": self.orch(idle=1, charter=1)}, stalled_asks=3)
        self.assertEqual(self.woken, [])
        self.asks[1] = [1, 2, 3]
        self.tick(self.T0 + 4 * 3600 + 5, {"o": self.orch(idle=1, charter=1)}, stalled_asks=3)
        self.tick(self.T0 + 6 * 3600 + 10, {"o": self.orch(idle=1, charter=1)}, stalled_asks=3)
        self.assertEqual(len(self.woken), 1)
        with self.assertRaises(ValueError):
            self.health.validate({"stalled_asks": 0}, "x")
        self.assertEqual(self.health.validate(None, "x"), self.health.DEFAULTS)

    def test_reads_are_bounded_and_an_unreadable_source_means_no_wake(self):
        self.asks = {n: [n] for n in range(1, 41)}
        many = {"o%d" % n: self.orch(charter=n) for n in range(1, 41)}
        self.tick(self.T0, many)
        self.tick(self.T0 + 1800, many)
        self.assertLessEqual(len(self.reads), 30)   # the default budget: 30 reads an hour for the account (#348 amendment of PC-1)
        # an unreadable source: the cache goes stale, the asks are not believed, nobody is woken, and status says so once
        self.fail_reads = True
        self.woken.clear()
        later = {"x": self.orch(charter=1)}
        self.asks = {1: [1, 2, 3]}
        self.tick(self.T0 + 10 * 3600, later)
        self.assertEqual(self.woken, [])
        self.assertIsNone(self.latest()["x"]["open_asks"])
        lines = self.health.status_lines(str(self.state_dir), self.T0)
        self.assertEqual(len([l for l in lines if "unreadable" in l]), 1)
        self.assertIn("asks not recorded", lines[1])

    def test_the_kill_switch_keeps_the_line_and_sends_no_wake(self):
        self.stalled_world(2)
        self.tick(self.T0 + 3 * 3600, {"o": self.orch(idle=1, charter=1)}, enabled=False)
        self.assertEqual(self.woken, [])
        self.assertEqual(len([l for l in self.health.status_lines(str(self.state_dir), self.T0) if l.strip().startswith("o ")]), 1)
        self.tick(self.T0 + 4 * 3600, {"o": self.orch(idle=1, charter=1)})   # switched on later: the open episode still fires
        self.assertEqual(len(self.woken), 1)

    def test_the_fixed_text_names_nothing_and_every_name_comes_from_the_records(self):
        def render(boss):
            self.woken.clear()
            shutil.rmtree(str(self.state_dir)); self.state_dir.mkdir(mode=0o700)
            self.asks = {1: [1, 2]}
            self.tick(self.T0, {boss: self.orch(idle=1, charter=1)})
            self.tick(self.T0 + 3 * 3600, {boss: self.orch(idle=1, charter=1)})
            return self.woken[0] + "\n" + "\n".join(self.health.status_lines(str(self.state_dir), 0))
        self.assertEqual(render("orch-a").replace("orch-a", "N"), render("orch-b").replace("orch-b", "N"))

    def test_the_coder_count_leaves_out_retired_and_finished_coders(self):
        """#549: a workspace read c0/6 with six coders on its books and none busy: only live coders are counted."""
        set_retired(self.state_dir, {"c-retired": {"at": self.T0, "session": "s"}})
        (self.state_dir / "last-reports.json").write_text(json.dumps({"c-done": {"state": "done", "at": self.T0}, "c-failed": {"state": "failed", "at": self.T0}}))
        engine = types.SimpleNamespace(state_dir=str(self.state_dir), now=lambda: self.T0, audit=None, actor="daemon", intents=None,
                                       config={"load_alert": self.health.validate({"enabled": True}, "x")})
        coder = lambda name, status: types.SimpleNamespace(name=name, session_id="s", fleet={"role": "coder", "reports_to": "orch"}, status=status)
        discovery = types.SimpleNamespace(agents={
            "orch": types.SimpleNamespace(name="orch", session_id="o", fleet={"role": "orchestrator", "charter": 1, "repo": "acme/widget"}, status="idle"),
            "c-live": coder("c-live", "working"), "c-idle": coder("c-idle", "idle"), "c-retired": coder("c-retired", "idle"),
            "c-done": coder("c-done", "idle"), "c-failed": coder("c-failed", "idle")})
        sb.load_tick(engine, discovery)
        fig = self.latest()["orch"]
        self.assertEqual((fig["busy"], fig["idle"]), (1, 1))

    def _load_names(self, orchs, retired=None, bodies=None, unreadable=False):
        """Run load_tick over `orchs` ({name: session}) and return the names that got figures."""
        if retired is not None:
            set_retired(self.state_dir, retired)
        def _api(path, repo):
            if unreadable:
                raise RuntimeError("charters unreadable")
            if "labels?" in path:
                return [{"name": "x:orchestrator"}]
            return [{"number": n, "body": b} for n, b in (bodies or {}).items()]
        intents = types.SimpleNamespace(repo="acme/widget", _api=_api, open_asks=lambda charter, repo: [])
        engine = types.SimpleNamespace(state_dir=str(self.state_dir), now=lambda: self.T0, audit=None, actor="daemon", intents=intents,
                                       config={"load_alert": self.health.validate({"enabled": True}, "x")})
        discovery = types.SimpleNamespace(agents={n: types.SimpleNamespace(name=n, session_id=sid, status="idle",
                                                  fleet={"role": "orchestrator", "charter": i + 1, "repo": "acme/widget"})
                                                  for i, (n, sid) in enumerate(orchs.items())})
        sb.load_tick(engine, discovery)
        return sorted(self.latest())

    def test_a_retired_orchestrator_has_no_figures(self):   # S1
        got = self._load_names({"a": "s1", "b": "s2", "c": "s3"}, retired={"c": {"at": self.T0, "session": "s3"}})
        self.assertEqual(got, ["a", "b"])

    def test_an_orchestrator_whose_charter_says_retired_has_no_figures(self):   # S2
        got = self._load_names({"a": "s1", "b": "s2"}, bodies={2: "orchestrator: b\nstatus: retired\n", 1: "orchestrator: a\nstatus: active\n"})
        self.assertEqual(got, ["a"])

    def test_a_retired_and_a_live_charter_naming_the_same_agent_show_the_agent(self):
        got = self._load_names({"a": "s1"}, bodies={10: "orchestrator: a\nstatus: retired\n", 20: "orchestrator: a\nstatus: active\n"})
        self.assertEqual(got, ["a"])   # one live charter keeps it shown
        got = self._load_names({"a": "s1"}, bodies={10: "orchestrator: a\nstatus: active\n", 20: "orchestrator: a\nstatus: retired\n"})
        self.assertEqual(got, ["a"])

    def test_two_charters_naming_one_agent_that_both_say_retired_hide_it(self):
        got = self._load_names({"a": "s1"}, bodies={10: "orchestrator: a\nstatus: retired\n", 20: "orchestrator: a\nstatus: retired\n"})
        self.assertEqual(got, [])

    def test_a_status_line_outside_the_leading_yaml_block_does_not_retire(self):
        body = "```yaml\norchestrator: a\nstatus: active\n```\n\nquoted:\nstatus: retired\n"
        self.assertEqual(self._load_names({"a": "s1"}, bodies={1: body}), ["a"])
        self.assertTrue(self.health.charter_retired("```yaml\norchestrator: a\nstatus: retired\n```\n"))
        self.assertFalse(self.health.charter_retired("orchestrator: a\nstatus: retiredX\n"))

    def test_an_undone_retirement_and_a_never_retired_orchestrator_keep_their_rows(self):   # S3
        got = self._load_names({"a": "s1", "b": "s2"}, retired={})
        self.assertEqual(got, ["a", "b"])

    def test_an_unreadable_charter_never_hides_an_orchestrator(self):   # S4
        self.assertEqual(self._load_names({"a": "s1"}, unreadable=True), ["a"])

    def test_a_retired_entry_with_another_session_does_not_hide_the_new_session(self):   # S5
        got = self._load_names({"a": "new"}, retired={"a": {"at": self.T0, "session": "old"}})
        self.assertEqual(got, ["a"])

    def test_the_daemon_tick_without_an_ask_repo_wakes_nobody_and_says_so(self):
        self.asks = {1: [1, 2]}
        engine = types.SimpleNamespace(state_dir=str(self.state_dir), now=lambda: self.T0, audit=None, actor="daemon", intents=None,
                                       config={"load_alert": self.health.validate({"enabled": True}, "x")})
        seen = lambda name, fleet, status: types.SimpleNamespace(name=name, fleet=fleet, status=status)
        discovery = types.SimpleNamespace(agents={"orch": seen("orch", {"role": "orchestrator", "charter": 1, "repo": "acme/widget"}, "idle"),
                                                  "cos": seen("cos", {"role": "chief-of-staff"}, "idle")})
        self.assertEqual(sb.load_tick(engine, discovery), [])   # no ask repo: the asks are unreadable, so no wake
        self.assertIn("no ask repo", " ".join(json.loads((self.state_dir / "load.json").read_text())["problems"]))
        self.assertEqual(sb.read_reminders(str(self.state_dir)), [])

    def test_the_daemon_tick_turns_a_crossing_into_one_reminder_and_one_audit_line(self):
        clock = [self.T0]
        audited = []
        audit = types.SimpleNamespace(append=lambda actor, event, subject, detail: audited.append((event, subject, detail)))
        intents = types.SimpleNamespace(repo="acme/widget", open_asks=lambda charter, repo: [types.SimpleNamespace(repo="acme/widget", number=n) for n in (1, 2)])
        engine = types.SimpleNamespace(state_dir=str(self.state_dir), now=lambda: clock[0], audit=audit, actor="daemon", intents=intents,
                                       config={"load_alert": self.health.validate({"enabled": True}, "x")})
        seen = lambda name, fleet, status: types.SimpleNamespace(name=name, fleet=fleet, status=status)
        discovery = types.SimpleNamespace(agents={"orch": seen("orch", {"role": "orchestrator", "charter": 1, "repo": "acme/widget"}, "idle"),
                                                  "cos": seen("cos", {"role": "chief-of-staff"}, "idle")})
        sb.load_tick(engine, discovery)
        for hours in (3, 4):
            clock[0] = self.T0 + hours * 3600
            sb.load_tick(engine, discovery)
        reminders = sb.read_reminders(str(self.state_dir))
        self.assertEqual([r["to"] for r in reminders], ["cos"])
        self.assertIn("orch is overloaded", reminders[0]["text"])
        self.assertIn("2 with no real movement in 2 h", reminders[0]["text"])
        self.assertEqual([a[0] for a in audited], ["load.alert"])

    def test_the_move_log_survives_torn_lines_a_burst_and_a_prune(self):
        d = str(self.state_dir)
        (self.state_dir / "ask-moves.jsonl").write_text('{"at": 1, "numbers": [1], "repo": "r"}\nnot json\n{"at": 2')
        self.health.append_moves(d, [{"at": self.T0, "repo": "r", "numbers": [3], "kind": "push"}])
        self.assertEqual([r["numbers"] for r in self.health.read_moves(d, 0)], [[1], [3]])
        self.health.append_moves(d, [{"at": 5, "repo": "r", "numbers": [9], "kind": "push"} for _ in range(300)])
        self.health.prune_moves(d, self.T0)
        self.assertEqual([r["numbers"] for r in self.health.read_moves(d, 0)], [[3]])
        body = " ".join("Closes #%d." % n for n in range(1, 60))
        row = self.health.move_rows("pull_request", {"action": "opened", "pull_request": {"number": 7, "body": body}}, "r", 1, sb.closing_numbers)[0]
        self.assertEqual(len(row["numbers"]), self.health.MOVES_NUMBERS_MAX)

    def test_unreadable_decisions_and_a_torn_audit_tail_are_not_zero_and_not_fatal(self):
        self.assertIsNone(self.health.decision_items(str(self.state_dir)))
        (self.state_dir / "audit.jsonl").write_text("x" * 100 + "\n")
        with mock.patch.object(self.health, "AUDIT_TAIL_BYTES", 40):
            self.assertEqual(self.health.audit_moves(str(self.state_dir), 0), [])
        self.assertIsNone(self.health.audit_moves(str(self.state_dir / "nowhere"), 0))

    def test_the_replay_of_a_recorded_overloaded_day_says_when_it_would_have_fired(self):
        self.asks = {1: [1, 2]}
        o = {"o": self.orch(idle=1, charter=1)}
        for hour in range(0, 6):
            self.tick(self.T0 + hour * 3600 + 5, o)       # the stall builds: 2 asks unmoved from 10:00, a stall of 2 h at 12:00
        days, firings = self.health.replay(str(self.state_dir), dict(self.health.DEFAULTS))
        self.assertEqual(days, ["2026-10-14"])
        self.assertEqual([(f["orchestrator"], f["hour"]) for f in firings], [("o", "2026-10-14 12:00Z")])
        self.assertEqual(self.health.replay(str(self.state_dir), dict(self.health.DEFAULTS, stalled_asks=3))[1], [])
        self.assertIsNone(self.health.replay(str(self.state_dir), dict(self.health.DEFAULTS), "2026-01-01")[1])
        # a finished day stays replayable after the day rolls over
        self.tick(self.T0 + 24 * 3600, o)
        days, firings = self.health.replay(str(self.state_dir), dict(self.health.DEFAULTS), "2026-10-14")
        self.assertEqual((days, len(firings)), (["2026-10-14", "2026-10-15"], 1))
        with captured() as (out, err):
            self.assertEqual(sb.main(["load-replay", "--day", "2026-10-14"], runner=None), 0, err.getvalue())
        self.assertIn("would have fired 1 time(s)", out.getvalue())
        self.assertIn("o is overloaded", out.getvalue())

    def test_a_past_day_is_rebuilt_from_the_audit_and_its_archive_and_says_what_is_not_recorded(self):
        def line(ts, event, subject, detail, **extra):
            return json.dumps(dict({"ts": ts, "actor": "cli", "event": event, "subject": subject, "detail": detail}, **extra))
        archive = [line("2026-10-12T22:00:00.000Z", "v2.session.create", "coder1", {"fleet": {"reports_to": "orch", "issue": 5}}),
                   line("2026-10-12T22:00:00.000Z", "reminder.add", "orch", {"from": "orch", "issue": 6, "repo": "acme/widget"})]
        with gzip.open(str(self.state_dir / "audit-2026-10-13.jsonl.gz"), "wt") as handle:
            handle.write("\n".join(archive) + "\n")
        os.utime(str(self.state_dir / "audit-2026-10-13.jsonl.gz"), (self.T0, self.T0))
        (self.state_dir / "audit.jsonl").write_text(line("2026-10-13T01:30:00.000Z", "v2.synthetic", "cos", {"description": "switchboard: coder1 report on widget#5: done"}, phase="intent") + "\n")
        firings, notes = self.health.replay_audit(str(self.state_dir), dict(self.health.DEFAULTS), "2026-10-13")
        self.assertEqual([(f["orchestrator"], f["hour"]) for f in firings], [("orch", "2026-10-13 00:59Z"), ("orch", "2026-10-13 03:59Z")])
        self.assertIn("coders not recorded busy", firings[0]["text"])
        self.assertIn("coders busy and idle", notes)
        self.assertIsNone(self.health.replay_audit(str(self.state_dir / "nowhere"), dict(self.health.DEFAULTS), "2026-10-13")[0])
        with captured() as (out, err):
            self.assertEqual(sb.main(["load-replay", "--day", "2026-10-13"], runner=None), 0, err.getvalue())
        self.assertIn("from the audit log and its archives (best effort)", out.getvalue())
        self.assertIn("not recorded for it:", out.getvalue())
        self.assertIn("would have fired 2 time(s)", out.getvalue())

    def test_load_replay_refuses_a_bad_day_and_names_today_for_a_rebuild_with_no_series(self):
        for bad in ("foo", "2026-13-45"):
            with captured() as (out, err):
                self.assertEqual(sb.main(["load-replay", "--day", bad], runner=None), 2, bad)
            self.assertIn("load-replay: --day", err.getvalue())
        (self.state_dir / "audit.jsonl").write_text("")
        with captured() as (out, err), mock.patch.object(sb.time, "time", lambda: self.T0):
            self.assertEqual(sb.main(["load-replay", "--from-audit"], runner=None, now=lambda: self.T0), 0, err.getvalue())
        self.assertIn("load alert replay over 2026-10-14 from the audit log", out.getvalue())
        self.assertIn("would have fired 0 time(s)", out.getvalue())

    def test_a_hostile_orchestrator_name_is_one_short_clean_line_in_the_wake(self):
        self.asks = {1: [1, 2]}
        name = "o\nrm -rf\x1b[31m " + "x" * 100
        self.tick(self.T0, {name: self.orch(idle=1, charter=1)})
        self.tick(self.T0 + 3 * 3600, {name: self.orch(idle=1, charter=1)})
        text = self.woken[0]
        self.assertNotRegex(text, "[\x00-\x1f\x7f]")
        self.assertEqual(text.split(" is overloaded")[0].replace("Load alert: ", ""), ("o rm -rf [31m " + "x" * 100)[:60])

    def test_an_oversize_move_file_is_pruned_to_the_recent_rows(self):
        d = str(self.state_dir)
        with mock.patch.object(self.health, "MOVES_READ_BYTES", 2000):
            self.health.append_moves(d, [{"at": 5, "repo": "r", "numbers": [9], "kind": "push"} for _ in range(100)])
            self.health.append_moves(d, [{"at": self.T0, "repo": "r", "numbers": [4], "kind": "push"}])
            self.assertGreater((self.state_dir / "ask-moves.jsonl").stat().st_size, 2000)
            self.health.prune_moves(d, self.T0)
            self.assertEqual([r["numbers"] for r in self.health.read_moves(d, 0)], [[4]])
            self.assertLess((self.state_dir / "ask-moves.jsonl").stat().st_size, 2000)

    def test_an_orchestrator_with_no_charter_says_so_and_one_with_only_an_issue_is_read(self):
        asked = []
        def read_asks(charter, repo):
            asked.append(charter)
            return [{"repo": "acme/widget", "number": 5}]
        no_charter = {"charter": None, "repo": "acme/widget", "busy": 0, "idle": 1, "messages": 0}
        ctx = self.health.Context(now=self.T0, state_dir=str(self.state_dir), cfg=dict(self.health.DEFAULTS, enabled=True),
                                  orchestrators={"a": no_charter, "b": dict(no_charter, charter=34)}, read_asks=read_asks, cos="cos", wake=self.woken.append)
        self.health.tick(ctx)
        self.assertEqual(asked, [34])
        problems = json.loads((self.state_dir / "load.json").read_text())["problems"]
        self.assertIn("no charter recorded for a", problems)
        self.assertIsNone(self.latest()["a"]["open_asks"])
        self.assertEqual(self.latest()["b"]["open_asks"], 1)

    def test_the_charter_is_the_issue_whose_yaml_names_the_agent_never_the_agents_own_issue(self):
        seen = lambda name, fleet: types.SimpleNamespace(name=name, fleet=fleet, status="idle")
        asked, api = [], []
        labels = [{"name": "me:orchestrator"}, {"name": "me:other"}]
        issues = [{"number": 34, "body": "```yaml\norchestrator: fleetkit\n```"}, {"number": 350, "body": "```yaml\norchestrator: fleet-insight\nworkspace: x\n```"},
                  {"number": 9, "body": "no yaml"}]
        def _api(path, repo):
            api.append(path)
            return labels if "/labels" in path else issues
        intents = types.SimpleNamespace(repo="acme/widget", _api=_api, open_asks=lambda charter, repo: asked.append(charter) or [])
        engine = types.SimpleNamespace(state_dir=str(self.state_dir), now=lambda: self.T0, audit=None, actor="daemon", intents=intents,
                                       config={"load_alert": self.health.validate({"enabled": True}, "x")})
        discovery = types.SimpleNamespace(agents={
            "fleet-insight": seen("fleet-insight", {"role": "orchestrator", "issue": 34, "repo": "acme/widget"}),   # its metadata issue is another orchestrator's charter
            "fleetkit": seen("fleetkit", {"role": "orchestrator", "repo": "acme/widget"}),
            "legacy": seen("legacy", {"role": "orchestrator", "charter": 7, "repo": "acme/widget"}),   # no yaml names it: the metadata charter is the fallback
            "stray": seen("stray", {"role": "orchestrator", "issue": 9, "repo": "acme/widget"})})      # an issue that is no charter is never used
        sb.load_tick(engine, discovery)
        self.assertEqual(sorted(asked), [7, 34, 350])   # fleet-insight -> 350 (not 34); fleetkit -> 34; legacy -> 7
        self.assertEqual(len(api), 2)                   # one labels read and one issues read for the repo
        problems = json.loads((self.state_dir / "load.json").read_text())["problems"]
        self.assertIn("no charter recorded for stray", problems)
        sb.load_tick(engine, discovery)
        self.assertEqual(len(api), 2)                   # cached for an hour

    def test_a_pull_request_in_the_issues_list_never_names_a_charter(self):
        seen = lambda name, fleet: types.SimpleNamespace(name=name, fleet=fleet, status="idle")
        asked = []
        issues = [{"number": 60, "body": "orchestrator: o1", "pull_request": {"url": "u"}}, {"number": 61, "body": "orchestrator: o1"}]
        intents = types.SimpleNamespace(repo="acme/widget", _api=lambda path, repo: [{"name": "me:orchestrator"}] if "/labels" in path else issues,
                                        open_asks=lambda charter, repo: asked.append(charter) or [])
        engine = types.SimpleNamespace(state_dir=str(self.state_dir), now=lambda: self.T0, audit=None, actor="daemon", intents=intents,
                                       config={"load_alert": self.health.validate({"enabled": True}, "x")})
        sb.load_tick(engine, types.SimpleNamespace(agents={"o1": seen("o1", {"role": "orchestrator", "repo": "acme/widget"})}))
        self.assertEqual(asked, [61])

    def charters_ctx(self, at, calls, orchestrators, reads_before=()):
        def read_charters(repo):
            calls.append((at, repo))
            return [(5, "orchestrator: a")]
        return self.health.Context(now=at, state_dir=str(self.state_dir), cfg=dict(self.health.DEFAULTS), orchestrators=orchestrators,
                                   read_asks=lambda charter, repo: [], read_charters=read_charters, cos="cos", wake=self.woken.append)

    def test_the_charters_cache_expires_after_an_hour_and_a_spent_budget_refuses_the_read(self):
        calls = []
        orch = {"a": {"charter": None, "repo": "acme/widget", "busy": 0, "idle": 1, "messages": 0}}
        self.health.tick(self.charters_ctx(self.T0, calls, orch))
        self.health.tick(self.charters_ctx(self.T0 + 600, calls, orch))
        self.assertEqual(len(calls), 1)                       # cached
        self.health.tick(self.charters_ctx(self.T0 + self.health.ASKS_FRESH_SECONDS + 5, calls, orch))
        self.assertEqual(len(calls), 2)                       # expired: read again
        # a budget with fewer than 2 reads left refuses the charters read (the asks read may still use the last one)
        state = json.loads((self.state_dir / "load.json").read_text())
        now = self.T0 + 2 * self.health.ASKS_FRESH_SECONDS + 10
        state["charters"] = {}
        state["reads"] = [[now - 60, "default"]] * (self.health.READ_BUDGET_DEFAULT - 1)
        (self.state_dir / "load.json").write_text(json.dumps(state))
        self.health.tick(self.charters_ctx(now, calls, orch))
        self.assertEqual(len(calls), 2)                       # refused: no third call

    def budget_ctx(self, at, orchestrators, asks_log, charters_log=None, **extra):
        def read_asks(charter, repo):
            asks_log.append((at, repo, charter))
            return []
        kw = dict(extra)
        if charters_log is not None:
            kw["read_charters"] = lambda repo: charters_log.append((at, repo)) or []
        cfg = dict(self.health.DEFAULTS, **kw.pop("cfg", {}))
        return self.health.Context(now=at, state_dir=str(self.state_dir), cfg=cfg, orchestrators=orchestrators, read_asks=read_asks, cos="cos",
                                   wake=self.woken.append, **kw)

    def many(self, count, repo="r", first=1, charter=True):
        return {"o%d" % n: {"charter": n if charter else None, "repo": repo, "busy": 0, "idle": 1, "messages": 0} for n in range(first, first + count)}

    def test_the_read_budget_key_defaults_to_30_allows_60_and_refuses_the_rest(self):
        self.assertEqual(self.health.validate(None, "x")["read_budget"], 30)
        self.assertEqual(self.health.validate({"read_budget": 60}, "x")["read_budget"], 60)
        for bad in (61, 0, "many", True, 2.5):
            with self.assertRaises(ValueError, msg=repr(bad)) as raised:
                self.health.validate({"read_budget": bad}, "x")
            self.assertIn("read_budget", str(raised.exception))
        with self.assertRaises(sb.ConfigError):
            sb.validate_config({"load_alert": {"read_budget": 61}})

    def test_a_full_cycle_of_ten_orchestrators_on_five_repos_fits_one_hour_within_the_budget(self):
        orch = {}
        for r in range(5):
            orch.update(self.many(2, repo="repo%d" % r, first=1 + 2 * r))
        asks, charters = [], []
        for k in range(12):                                   # a pass every 5 minutes for an hour
            self.health.tick(self.budget_ctx(self.T0 + k * 300, orch, asks, charters))
        state = json.loads((self.state_dir / "load.json").read_text())
        self.assertEqual((len(asks), len(charters)), (10, 5))   # every source read once in the hour
        self.assertEqual(len(state["reads"]), 20)   # 5 x 2 + 10, well within 30
        self.assertTrue(all(state["asks"][n]["at"] >= self.T0 for n in orch))

    def test_a_hundred_orchestrators_stop_at_the_budget_and_the_oldest_are_read_first_next_hour(self):
        orch = self.many(100)
        first, second = [], []
        self.health.tick(self.budget_ctx(self.T0, orch, first, []))
        self.health.tick(self.budget_ctx(self.T0 + 600, orch, first, []))
        self.assertEqual(len(first), 28)                      # 30 reads: 2 for the charters, 28 asks lists
        self.health.tick(self.budget_ctx(self.T0 + 3700, orch, second, []))
        self.assertEqual(len(second), 28)
        self.assertEqual({c for _, _, c in first} & {c for _, _, c in second}, set())   # the ones never read come first

    def test_a_paused_account_is_skipped_not_counted_and_named_while_another_is_read(self):
        orch = dict(self.many(5, repo="work/r1"), **self.many(5, repo="own/r2", first=6))
        asks, charters = [], []
        ctx = self.budget_ctx(self.T0, orch, asks, charters, account_of=lambda repo: "work" if repo.startswith("work/") else "default",
                              paused=lambda repo: repo.startswith("work/"))
        self.health.tick(ctx)
        self.assertEqual({repo for _, repo, _ in asks}, {"own/r2"})
        self.assertEqual([repo for _, repo in charters], ["own/r2"])
        state = json.loads((self.state_dir / "load.json").read_text())
        self.assertEqual({a for _, a in state["reads"]}, {"default"})
        self.assertEqual(len(state["reads"]), 7)             # 2 for the charters and 5 asks lists, none for the paused account
        self.assertEqual([p for p in state["problems"] if "paused" in p], ["account work is paused by the rate limit: its reads wait"])
        self.assertTrue(any("paused" in l for l in self.health.status_lines(str(self.state_dir), self.T0)))

    def test_reads_answered_304_are_free_and_not_counted(self):
        orch = self.many(40)
        asks = []
        ctx = self.budget_ctx(self.T0, orch, asks, begin_read=lambda: 0, read_cost=lambda token, repo: 0)   # every read answered 304
        self.health.tick(ctx)
        self.assertEqual(len(asks), 40)                       # past the 30 budget: none was billed
        self.assertEqual(json.loads((self.state_dir / "load.json").read_text())["reads"], [])

    def test_each_account_has_its_own_count_and_neither_starves_the_other(self):
        orch = dict(self.many(40, repo="a/r"), **self.many(40, repo="b/r", first=41))
        asks = []
        ctx = self.budget_ctx(self.T0, orch, asks, account_of=lambda repo: repo.split("/")[0])
        self.health.tick(ctx)
        self.assertEqual((len([1 for _, repo, _ in asks if repo == "a/r"]), len([1 for _, repo, _ in asks if repo == "b/r"])), (30, 30))
        self.assertEqual(len(json.loads((self.state_dir / "load.json").read_text())["reads"]), 60)

    def test_old_bare_number_rows_count_for_the_default_account_and_junk_rows_are_dropped(self):
        orch = self.many(40)
        (self.state_dir / "load.json").write_text(json.dumps({"reads": [self.T0 - 60] * 25 + [["x"], "junk", [self.T0 - 60, "default", 1], [self.T0 - 99999, "default"]]}))
        asks = []
        self.health.tick(self.budget_ctx(self.T0, orch, asks))
        self.assertEqual(len(asks), 5)                        # 30 - 25 old rows left; the junk and the expired row count for nothing

    def test_a_read_that_fails_is_still_charged(self):
        def failing(charter, repo):
            raise RuntimeError("gh is down")
        ctx = self.health.Context(now=self.T0, state_dir=str(self.state_dir), cfg=dict(self.health.DEFAULTS), orchestrators=self.many(3),
                                  read_asks=failing, cos="cos", wake=self.woken.append)
        self.health.tick(ctx)
        self.assertEqual(len(json.loads((self.state_dir / "load.json").read_text())["reads"]), 3)

    def test_the_billing_snapshot_is_taken_under_the_accounts_lock_and_only_for_the_account(self):
        calls = collections.deque()
        lock = threading.Lock()
        accounts = types.SimpleNamespace(calls=calls, lock=lock, paused={}, describe=lambda repo: repo.split("/")[0])
        held = []
        class Spy(collections.deque):
            def __iter__(inner):
                held.append(lock.locked())
                return super().__iter__()
        spy = Spy()
        accounts.calls = spy
        def _api(path, repo):
            spy.append((self.T0 + len(spy) + 1, "a", "x", False))
            spy.append((self.T0 + len(spy) + 1, "b", "x", False))   # another account's read at the same moment
            return []
        seen = lambda name, fleet: types.SimpleNamespace(name=name, fleet=fleet, status="idle")
        intents = types.SimpleNamespace(repo="a/r", _api=_api, accounts=accounts, open_asks=lambda c, r: [])
        engine = types.SimpleNamespace(state_dir=str(self.state_dir), now=lambda: self.T0, audit=None, actor="daemon", intents=intents,
                                       config={"load_alert": self.health.validate(None, "x")})
        sb.load_tick(engine, types.SimpleNamespace(agents={"o": seen("o", {"role": "orchestrator", "charter": 1, "repo": "a/r"})}))
        self.assertTrue(held and all(held))                    # every iteration of the shared deque happened with the lock held
        reads = json.loads((self.state_dir / "load.json").read_text())["reads"]
        self.assertEqual({a for _, a in reads}, {"a"})         # the other account's concurrent read is not charged

    def test_the_daemon_counts_what_github_billed_and_not_the_304s_nor_a_paused_account(self):
        calls = collections.deque()
        accounts = types.SimpleNamespace(calls=calls, lock=threading.Lock(), paused={"work": self.T0 + 600}, describe=lambda repo: "work" if repo.startswith("w/") else "default")
        def _api(path, repo):
            calls.append((self.T0 + len(calls) + 1, accounts.describe(repo), "x", "etag" in path))   # a path containing 'etag' stands for a 304
            return []
        seen = lambda name, fleet: types.SimpleNamespace(name=name, fleet=fleet, status="idle")
        intents = types.SimpleNamespace(repo="own/r", _api=_api, accounts=accounts, open_asks=lambda c, r: _api("asks-etag", r) or [])
        engine = types.SimpleNamespace(state_dir=str(self.state_dir), now=lambda: self.T0, audit=None, actor="daemon", intents=intents,
                                       config={"load_alert": self.health.validate(None, "x")})
        discovery = types.SimpleNamespace(agents={"a": seen("a", {"role": "orchestrator", "charter": 1, "repo": "own/r"}),
                                                  "w": seen("w", {"role": "orchestrator", "charter": 2, "repo": "w/r"})})
        sb.load_tick(engine, discovery)
        state = json.loads((self.state_dir / "load.json").read_text())
        self.assertEqual([a for _, a in state["reads"]], ["default"])   # only the labels read (no label found: 1 call) is billed; the 304 asks read and the paused account's are not
        self.assertTrue(any("account work is paused" in p for p in state["problems"]))

    def test_many_orchestrators_with_no_charter_are_named_with_a_count(self):
        orch = {"o%d" % n: {"charter": None, "repo": None, "busy": 0, "idle": 0, "messages": 0} for n in range(9)}
        ctx = self.health.Context(now=self.T0, state_dir=str(self.state_dir), cfg=dict(self.health.DEFAULTS), orchestrators=orch,
                                  read_asks=lambda c, r: [], cos="cos", wake=self.woken.append)
        self.health.tick(ctx)
        problems = json.loads((self.state_dir / "load.json").read_text())["problems"]
        self.assertTrue(any(p.startswith("no charter recorded for o0, o1") and p.endswith("and 3 more") for p in problems), problems)

    def test_with_the_alert_off_the_line_is_still_kept_and_nobody_is_woken(self):
        seen = lambda name, fleet: types.SimpleNamespace(name=name, fleet=fleet, status="idle")
        clock = [self.T0]
        api = []
        intents = types.SimpleNamespace(repo="acme/widget", _api=lambda path, repo: api.append(path) or [],
                                        open_asks=lambda c, r: [types.SimpleNamespace(repo="acme/widget", number=n) for n in (1, 2)])
        discovery = types.SimpleNamespace(agents={"o": seen("o", {"role": "orchestrator", "charter": 3, "repo": "acme/widget"}), "cos": seen("cos", {"role": "chief-of-staff"})})
        for config in ({}, {"load_alert": self.health.validate(None, "x")}):
            shutil.rmtree(str(self.state_dir)); self.state_dir.mkdir(mode=0o700)
            engine = types.SimpleNamespace(state_dir=str(self.state_dir), now=lambda: clock[0], audit=None, actor="daemon", intents=intents, config=config)
            sb.load_tick(engine, discovery)
            clock[0] = self.T0 + 3 * 3600                    # two asks stalled 3 h: a crossing, with the alert off
            self.assertEqual(sb.load_tick(engine, discovery), [])
            self.assertEqual(sb.read_reminders(str(self.state_dir)), [])     # no wake
            lines = self.health.status_lines(str(self.state_dir), clock[0])
            self.assertEqual(len([l for l in lines if l.strip().startswith("o ")]), 1)   # the line stays
            self.assertIn("alert off", lines[0])
            clock[0] = self.T0
        self.assertTrue(api)                                 # the charter reads feed the line

    def test_a_failing_read_is_not_retried_every_pass_and_is_still_said(self):
        calls = []
        def fail(*a):
            calls.append(a)
            raise RuntimeError("gh is down")
        orch = {"a": {"charter": 3, "repo": "r", "busy": 0, "idle": 1, "messages": 0}}
        for at in (0, 10, 20, 290):
            ctx = self.health.Context(now=self.T0 + at, state_dir=str(self.state_dir), cfg=dict(self.health.DEFAULTS), orchestrators=orch,
                                      read_asks=fail, read_charters=fail, cos="cos", wake=self.woken.append)
            self.health.tick(ctx)
            problems = json.loads((self.state_dir / "load.json").read_text())["problems"]
            self.assertTrue(any("asks not readable" in p for p in problems) and any("charters not readable" in p for p in problems), (at, problems))
        self.assertEqual(len(calls), 2)                      # one charters read and one asks read, then nothing for 5 minutes
        self.health.tick(self.health.Context(now=self.T0 + 400, state_dir=str(self.state_dir), cfg=dict(self.health.DEFAULTS), orchestrators=orch,
                                             read_asks=fail, read_charters=fail, cos="cos", wake=self.woken.append))
        self.assertEqual(len(calls), 4)                      # tried again after the wait

    def test_a_metadata_charter_that_names_another_agent_is_dropped_but_an_unnamed_one_is_kept(self):
        calls = []
        def read_charters(repo):
            return [(34, "orchestrator: other"), (350, "orchestrator: fleet-insight")]
        orch = {"fleet-insight": {"charter": 34, "repo": "r", "busy": 0, "idle": 1, "messages": 0},     # 34 is another agent's: resolved by yaml to 350
                "stray": {"charter": 34, "repo": "r", "busy": 0, "idle": 1, "messages": 0},             # no yaml names it, and 34 is another's: dropped
                "legacy": {"charter": 99, "repo": "r", "busy": 0, "idle": 1, "messages": 0}}            # 99 is no charter with yaml: kept
        ctx = self.health.Context(now=self.T0, state_dir=str(self.state_dir), cfg=dict(self.health.DEFAULTS), orchestrators=orch,
                                  read_asks=lambda c, r: calls.append(c) or [], read_charters=read_charters, cos="cos", wake=self.woken.append)
        self.health.tick(ctx)
        self.assertEqual(sorted(calls), [99, 350])
        self.assertIn("no charter recorded for stray", json.loads((self.state_dir / "load.json").read_text())["problems"])

    def test_the_orchestrator_line_tolerates_crlf_and_a_trailing_comment_and_the_lowest_number_wins(self):
        names = lambda body: self.health.charter_agent(body)
        self.assertEqual(names("```yaml\r\norchestrator: ok # the name\r\nstatus: active\r\n```"), "ok")
        self.assertEqual(names("orchestrator: a.b-c  "), "a.b-c")
        self.assertIsNone(names("  orchestrator: indented"))
        self.assertIsNone(names("orchestrator: bad name"))
        ctx = self.health.Context(now=self.T0, state_dir=str(self.state_dir), cfg=dict(self.health.DEFAULTS),
                                  orchestrators={"a": {"charter": None, "repo": "r", "busy": 0, "idle": 1, "messages": 0}},
                                  read_asks=lambda c, r: self.reads.append(c) or [], read_charters=lambda r: [(9, "orchestrator: a"), (4, "orchestrator: a")], cos="cos", wake=self.woken.append)
        self.health.tick(ctx)
        self.assertEqual(self.reads, [4])

    def test_every_owner_prefix_of_the_orchestrator_label_is_read(self):
        seen = lambda name, fleet: types.SimpleNamespace(name=name, fleet=fleet, status="idle")
        paths, asked = [], []
        def _api(path, repo):
            paths.append(path)
            if "/labels" in path:
                return [{"name": "me:orchestrator"}, {"name": "you:orchestrator"}, {"name": "me:other"}]
            return [{"number": 11, "body": "orchestrator: a"}] if "me%3Aorchestrator" in path else [{"number": 12, "body": "orchestrator: b"}]
        intents = types.SimpleNamespace(repo="r", _api=_api, open_asks=lambda c, r: asked.append(c) or [])
        engine = types.SimpleNamespace(state_dir=str(self.state_dir), now=lambda: self.T0, audit=None, actor="daemon", intents=intents,
                                       config={"load_alert": self.health.validate({"enabled": True}, "x")})
        sb.load_tick(engine, types.SimpleNamespace(agents={"a": seen("a", {"role": "orchestrator", "repo": "r"}), "b": seen("b", {"role": "orchestrator", "repo": "r"})}))
        self.assertEqual(sorted(asked), [11, 12])
        self.assertEqual(len(paths), 3)

    def test_charters_that_cannot_be_read_fall_back_and_are_said(self):
        def read_charters(repo):
            raise RuntimeError("gh is down")
        no_charter = {"charter": 7, "repo": "acme/widget", "busy": 0, "idle": 1, "messages": 0}
        self.asks = {7: [1]}
        def read_asks(charter, repo):
            return [{"repo": "acme/widget", "number": n} for n in self.asks[charter]]
        ctx = self.health.Context(now=self.T0, state_dir=str(self.state_dir), cfg=dict(self.health.DEFAULTS), orchestrators={"a": no_charter},
                                  read_asks=read_asks, read_charters=read_charters, cos="cos", wake=self.woken.append)
        self.health.tick(ctx)
        self.assertEqual(self.latest()["a"]["open_asks"], 1)
        self.assertTrue(any("charters not readable" in p for p in json.loads((self.state_dir / "load.json").read_text())["problems"]))

    def test_the_busy_coders_rule_is_quiet_while_things_move_and_loud_when_stuck_or_outnumbered(self):
        def fig(**kw):
            base = {"name": "o", "open_asks": 2, "stalled": 0, "stalled_asks": [], "moved_1h": 1, "moved_backlog": 1, "busy": 2, "idle": 0, "messages": 0, "decisions": 0}
            return dict(base, **kw)
        cfg = dict(self.health.DEFAULTS)
        self.assertEqual(self.health.judge(fig(), cfg, None)[0], None)                         # busy, 0 stalled, 1 moved: no wake
        self.assertEqual(self.health.judge(fig(open_asks=9, moved_backlog=5, moved_1h=2), cfg, None)[0], None)   # outnumbered but moving
        text = self.health.judge(fig(open_asks=3, moved_backlog=0, moved_1h=0), cfg, None)[0]  # 3 asks, 0 moved in 4 h, coders full
        self.assertIn("at least twice those moved in 4 h and none moved in the last hour", text)
        text = self.health.judge(fig(stalled=1, stalled_asks=[7], moved_1h=3, moved_backlog=3, open_asks=4), cfg, None)[0]   # one ask stalled, coders full
        self.assertIn("an ask is stalled (#7)", text)
        self.assertEqual(self.health.judge(fig(open_asks=3, moved_backlog=0, moved_1h=0, idle=1), cfg, None)[0], None)   # idle coders: no
        self.assertEqual(self.health.judge(fig(stalled=1, stalled_asks=[7], idle=1), cfg, None)[0], None)                # one stalled but not full: below the 2-ask rule

    def test_references_in_a_body_and_branch_count_not_only_closes(self):
        ref = lambda body, branch=None: self.health.references(body, branch, "acme/widget")
        self.assertEqual(ref("Part of #12"), [12])
        self.assertEqual(ref("Refs #13, see also #14"), [13, 14])
        self.assertEqual(ref("PLAN: https://github.com/acme/widget/issues/348#issuecomment-1"), [348])
        self.assertEqual(ref("fixes other/repo#99 and #5"), [5])                  # another repository's number is not ours
        self.assertEqual(ref("", "feature/4022-load-fix"), [4022])
        self.assertEqual(ref("&#39; is not an issue"), [])
        row = self.health.move_rows("pull_request", {"action": "synchronize", "pull_request": {"number": 4303, "body": "Part of #4022", "head": {"ref": "x/3115-y"}}},
                                    "acme/widget", 5, sb.closing_numbers)[0]
        self.assertEqual((row["numbers"], row["refs"]), ([4303, 4022, 3115], [4022, 3115]))

    def chain_world(self, parents, asks_numbers=(100,), **extra):
        """A pass whose asks are `asks_numbers` of repo r, with `parents` {number: parent or None} as the issue parents on GitHub."""
        reads = []
        def read_parent(repo, number):
            reads.append(number)
            if number not in parents:
                raise RuntimeError("gh is down")
            return parents[number]
        orch = {"o": {"charter": 1, "repo": "r", "busy": 0, "idle": 1, "messages": 0}}
        self.asks = {1: list(asks_numbers)}
        def tick(at, rows=(), **kw):
            if rows:
                self.health.append_moves(str(self.state_dir), list(rows))
            def read_asks(charter, repo):
                return [{"repo": "r", "number": n} for n in self.asks[charter]]
            ctx = self.health.Context(now=at, state_dir=str(self.state_dir), cfg=dict(self.health.DEFAULTS, **kw.pop("cfg", {})), orchestrators=orch,
                                      read_asks=read_asks, read_parent=read_parent, cos="cos", wake=self.woken.append, **dict(extra, **kw))
            return self.health.tick(ctx)
        return tick, reads

    def move_row(self, at, refs, number=900):
        return {"at": at, "repo": "r", "numbers": [number] + list(refs), "refs": list(refs), "kind": "push"}

    def test_a_pull_request_naming_a_work_item_moves_the_ask_above_it(self):
        tick, reads = self.chain_world({200: 100})
        tick(self.T0)
        late = self.T0 + 3 * 3600
        tick(late, [self.move_row(late - 60, [200])])
        got = self.latest()["o"]
        self.assertEqual((got["stalled"], got["moved_1h"], reads), (0, 1, [200]))        # the ask 100 moved through its work item 200; one parent read

    def test_a_chain_of_three_levels_reaches_the_ask_and_a_fourth_is_never_read(self):
        tick, reads = self.chain_world({203: 202, 202: 201, 201: 100, 100: 50})
        tick(self.T0)
        late = self.T0 + 3 * 3600
        tick(late, [self.move_row(late - 60, [203])])
        self.assertEqual((self.latest()["o"]["moved_1h"], reads), (1, [203, 202, 201]))   # 3 reads reach the ask at the top; no read for the ask's own parent
        tick2, reads2 = self.chain_world({205: 204, 204: 203, 203: 202, 202: 100}, asks_numbers=(100,))
        shutil.rmtree(str(self.state_dir)); self.state_dir.mkdir(mode=0o700)
        tick2(self.T0)
        tick2(late, [self.move_row(late - 60, [205])])
        self.assertEqual((self.latest()["o"]["stalled"], reads2), (1, [205, 204, 203]))   # the ask is 4 levels up: not reached, and no 4th read

    def test_a_resolved_parent_is_never_read_again(self):
        tick, reads = self.chain_world({200: 100})
        tick(self.T0)
        late = self.T0 + 3 * 3600
        tick(late, [self.move_row(late - 60, [200])])
        tick(late + 600, [self.move_row(late + 300, [200])])
        tick(late + 3 * 3600, [self.move_row(late + 3 * 3600 - 30, [200])])
        self.assertEqual(reads, [200])
        self.assertEqual(json.loads((self.state_dir / "load.json").read_text())["parents"], {"r#200": 100})

    def test_an_unreadable_parent_is_not_guessed_and_status_counts_the_unattributed(self):
        tick, reads = self.chain_world({})                 # every parent read fails
        tick(self.T0)
        late = self.T0 + 3 * 3600
        tick(late, [self.move_row(late - 60, [300]), self.move_row(late - 30, [301], number=901)])
        got = self.latest()["o"]
        self.assertEqual((got["stalled"], got["moved_1h"]), (1, 0))                      # the ask did not get the credit
        lines = self.health.status_lines(str(self.state_dir), late)
        self.assertEqual([l.strip() for l in lines if "not attributed" in l], ["2 movement(s) not attributed (a referenced issue's parent could not be read)"])
        tick(late + 60, [])
        self.assertEqual(len(reads), 2)                                                  # a failed read waits RETRY_SECONDS

    def test_parent_reads_use_the_account_budget_and_a_spent_budget_leaves_them_unattributed(self):
        tick, reads = self.chain_world({n: 100 for n in range(200, 240)})
        tick(self.T0)
        late = self.T0 + 3 * 3600
        tick(late, [self.move_row(late - 60 + n % 3, [200 + n], number=900 + n) for n in range(40)], cfg={"read_budget": 5})
        state = json.loads((self.state_dir / "load.json").read_text())
        self.assertLessEqual(len(state["reads"]), 5)                                      # the same count as the asks and charters reads
        self.assertLess(len(reads), 5)
        self.assertGreater(state["unattributed"], 0)

    def test_parent_reads_answered_304_are_free(self):
        tick, reads = self.chain_world({n: 100 for n in range(200, 210)}, begin_read=lambda: 0, read_cost=lambda token, repo: 0)
        tick(self.T0)
        late = self.T0 + 3 * 3600
        tick(late, [self.move_row(late - 60, [200 + n], number=900 + n) for n in range(10)], cfg={"read_budget": 2})
        self.assertEqual(len(reads), 10)
        self.assertEqual(json.loads((self.state_dir / "load.json").read_text())["reads"], [])

    def test_the_daemon_reads_a_parent_from_the_issue_and_ignores_another_repository(self):
        seen = lambda name, fleet: types.SimpleNamespace(name=name, fleet=fleet, status="idle")
        paths = []
        def _api(path, repo):
            paths.append(path)
            return {"parent_issue_url": "https://api.github.com/repos/acme/widget/issues/100"} if path.endswith("/issues/200") else (
                {"parent_issue_url": "https://api.github.com/repos/other/place/issues/7"} if path.endswith("/issues/201") else [])
        intents = types.SimpleNamespace(repo="acme/widget", _api=_api, open_asks=lambda c, r: [types.SimpleNamespace(repo="acme/widget", number=100)])
        engine = types.SimpleNamespace(state_dir=str(self.state_dir), now=lambda: self.T0, audit=None, actor="daemon", intents=intents,
                                       config={"load_alert": self.health.validate(None, "x")})
        discovery = types.SimpleNamespace(agents={"o": seen("o", {"role": "orchestrator", "charter": 1, "repo": "acme/widget"})})
        sb.load_tick(engine, discovery)
        self.health.append_moves(str(self.state_dir), [{"at": self.T0, "repo": "acme/widget", "numbers": [900, 200, 201], "refs": [200, 201], "kind": "push"}])
        sb.load_tick(engine, discovery)
        parents = json.loads((self.state_dir / "load.json").read_text())["parents"]
        self.assertEqual(parents, {"acme/widget#200": 100, "acme/widget#201": 0})          # a parent in another repository is no parent here

    DAY = 86400.0

    def wait_world(self, asks, **cfg):
        """One orchestrator whose asks are `asks` (number -> {labels, parked_until}); a first pass, then one 3 hours later with nothing moved."""
        self.waits = asks
        orch = {"o": {"charter": 1, "repo": "r", "busy": 0, "idle": 1, "messages": 0}}
        def run(at):
            def read_asks(charter, repo):
                return [dict({"repo": "r", "number": n}, **self.waits[n]) for n in sorted(self.waits)]
            return self.health.tick(self.health.Context(now=at, state_dir=str(self.state_dir), cfg=dict(self.health.DEFAULTS, **cfg), orchestrators=orch,
                                                        read_asks=read_asks, cos="cos", wake=self.woken.append))
        run(self.T0)
        run(self.T0 + 3 * 3600)
        return self.latest()["o"]

    def stale_world(self, repo="acme/widget"):
        """One orchestrator over `repo`; the asks it lists are `self.listed`, and `self.read_count` counts the reads of the list."""
        self.listed, self.read_count = [1, 2], [0]
        orch = {"o": {"charter": 1, "repo": repo, "busy": 0, "idle": 1, "messages": 0}}
        def read_asks(charter, r):
            self.read_count[0] += 1
            return [{"repo": repo, "number": n} for n in self.listed]
        def tick(at, **cfg):
            return self.health.tick(self.health.Context(now=at, state_dir=str(self.state_dir), cfg=dict(self.health.DEFAULTS, **cfg), orchestrators=orch,
                                                        read_asks=read_asks, cos="cos", wake=self.woken.append))
        return tick

    def test_a_closed_reopened_or_labelled_issue_makes_the_list_stale_and_it_is_read_again_within_minutes(self):
        for action in ("closed", "reopened", "labeled", "unlabeled", "edited", "deleted", "transferred"):
            shutil.rmtree(str(self.state_dir)); self.state_dir.mkdir(mode=0o700)
            tick = self.stale_world()
            tick(self.T0)
            self.listed = [1]                                                       # ask 2 was closed
            self.assertTrue(self.health.mark_stale(str(self.state_dir), "issues", {"action": action}, "acme/widget", self.T0 + 400), action)
            tick(self.T0 + 600)                                                     # 10 minutes after the last read: well inside the hour
            self.assertEqual((self.read_count[0], self.latest()["o"]["open_asks"]), (2, 1), action)

    def test_a_sub_issue_event_marks_stale_and_other_events_do_not(self):
        d = str(self.state_dir)
        self.assertTrue(self.health.mark_stale(d, "sub_issues", {"action": "sub_issue_added"}, "acme/widget", 5))
        for event, payload in (("issues", {"action": "opened"}), ("issues", {"action": "assigned"}), ("issue_comment", {"action": "created"}), ("push", {}), ("issues", "x")):
            self.assertFalse(self.health.mark_stale(d, event, payload, "acme/widget", 6), (event, payload))
        self.assertEqual(self.health.stale_since(d, "acme/widget"), 5)

    def test_a_stale_list_is_read_at_most_once_every_five_minutes(self):
        tick = self.stale_world()
        tick(self.T0)
        self.health.mark_stale(str(self.state_dir), "issues", {"action": "closed"}, "acme/widget", self.T0 + 10)
        tick(self.T0 + 120)                                                         # 2 minutes after the last read: not yet
        self.assertEqual(self.read_count[0], 1)
        tick(self.T0 + 300)
        self.assertEqual(self.read_count[0], 2)
        self.health.mark_stale(str(self.state_dir), "issues", {"action": "closed"}, "acme/widget", self.T0 + 310)
        tick(self.T0 + 400)                                                         # a new mark, but the read was 100 s ago
        self.assertEqual(self.read_count[0], 2)
        tick(self.T0 + 600)
        self.assertEqual(self.read_count[0], 3)
        tick(self.T0 + 700)                                                         # no new mark: back to the hourly wait
        self.assertEqual(self.read_count[0], 3)

    def test_a_stale_read_stays_inside_the_account_budget(self):
        tick = self.stale_world()
        tick(self.T0, read_budget=2)                                                # the charters read is not wired: only the asks read is spent
        state = json.loads((self.state_dir / "load.json").read_text())
        state["reads"] = [[self.T0 + 1, "default"], [self.T0 + 2, "default"]]       # the account has spent its two reads this hour
        (self.state_dir / "load.json").write_text(json.dumps(state))
        self.health.mark_stale(str(self.state_dir), "issues", {"action": "closed"}, "acme/widget", self.T0 + 10)
        tick(self.T0 + 400, read_budget=2)
        self.assertEqual(self.read_count[0], 1)                                     # no read: the budget is spent, the old list stays
        tick(self.T0 + 3700, read_budget=2)                                         # the hour's reads have aged out
        self.assertEqual(self.read_count[0], 2)

    def test_an_event_for_another_repository_leaves_the_list_alone(self):
        tick = self.stale_world()
        tick(self.T0)
        self.health.mark_stale(str(self.state_dir), "issues", {"action": "closed"}, "acme/other", self.T0 + 10)
        tick(self.T0 + 900)
        self.assertEqual(self.read_count[0], 1)

    def test_the_hourly_reread_is_still_the_fallback_and_a_garbled_mark_file_is_harmless(self):
        tick = self.stale_world()
        tick(self.T0)
        (self.state_dir / self.health.STALE_MARK_FILE).write_text("not json")
        tick(self.T0 + 900)
        self.assertEqual(self.read_count[0], 1)
        tick(self.T0 + 3600)
        self.assertEqual(self.read_count[0], 2)
        self.health.mark_stale(str(self.state_dir), "issues", {"action": "closed"}, "acme/widget", self.T0 + 3700)   # over a garbled file: rewritten
        self.assertEqual(self.health.stale_since(str(self.state_dir), "acme/widget"), self.T0 + 3700)

    def test_an_ask_awaiting_the_owner_is_waiting_not_stalled(self):
        got = self.wait_world({1: {"labels": ["me:awaiting-user"]}})
        self.assertEqual((got["stalled"], got["waiting_owner"], got["waiting_cos"], got["parked"]), (0, 1, 0, 0))

    def test_an_ask_awaiting_the_chief_of_staff_is_counted_apart(self):
        got = self.wait_world({1: {"labels": ["me:awaiting-cos"]}})
        self.assertEqual((got["stalled"], got["waiting_cos"], got["waiting_owner"]), (0, 1, 0))

    def test_an_ask_awaiting_a_live_event_is_waiting_live_not_stalled(self):
        got = self.wait_world({1: {"labels": ["me:awaiting-live"]}})
        self.assertEqual((got["stalled"], got["waiting_live"], got["waiting_owner"], got["waiting_cos"], got["parked"]), (0, 1, 0, 0, 0))
        self.assertIn("stalled 0, waiting on owner 0, parked 0, waiting on cos 0, waiting live 1", [l for l in self.health.status_lines(str(self.state_dir), self.T0) if l.strip().startswith("o ")][0])

    def test_awaiting_live_ranks_below_owner_and_cos_and_above_parked(self):
        future = self.T0 + 9 * self.DAY
        got = self.wait_world({1: {"labels": ["me:awaiting-live", "me:awaiting-user"]}, 2: {"labels": ["me:awaiting-live", "me:awaiting-cos"]},
                               3: {"labels": ["me:awaiting-live", "me:parked"], "parked_until": future}, 4: {"labels": ["awaiting-live"]}})
        self.assertEqual((got["waiting_owner"], got["waiting_cos"], got["waiting_live"], got["parked"], got["stalled"]), (1, 1, 2, 0, 0))

    def test_asks_waiting_live_never_wake_the_chief_of_staff_but_a_plain_stall_beside_them_does(self):
        self.wait_world({1: {"labels": ["me:awaiting-live"]}, 2: {"labels": ["me:awaiting-live"]}, 3: {"labels": ["me:awaiting-live"]}}, enabled=True)
        self.assertEqual(self.woken, [])
        shutil.rmtree(str(self.state_dir)); self.state_dir.mkdir(mode=0o700)
        got = self.wait_world({1: {"labels": ["me:awaiting-live"]}, 2: {"labels": []}, 3: {"labels": []}, 4: {"labels": ["me:awaiting-live"]}}, enabled=True)
        self.assertEqual((got["stalled"], got["waiting_live"], len(self.woken)), (2, 2, 1))
        self.assertIn("2 with no real movement", self.woken[0] if isinstance(self.woken[0], str) else str(self.woken[0]))

    def test_a_parked_ask_with_a_future_date_is_parked_and_one_whose_date_passed_is_stalled_again(self):
        got = self.wait_world({1: {"labels": ["me:parked"], "parked_until": self.T0 + 10 * self.DAY}})
        self.assertEqual((got["stalled"], got["parked"]), (0, 1))
        shutil.rmtree(str(self.state_dir)); self.state_dir.mkdir(mode=0o700)
        got = self.wait_world({1: {"labels": ["me:parked"], "parked_until": self.T0 + 3600}})   # the date passes within the 3 hours
        self.assertEqual((got["stalled"], got["parked"]), (1, 0))

    def test_a_parked_label_without_a_valid_future_date_is_not_parked(self):
        for case in ({"labels": ["me:parked"]}, {"labels": ["me:parked"], "parked_until": None},
                     {"labels": ["me:parked"], "parked_until": self.T0 + 5000 * self.DAY}):   # no date / a date beyond the bound
            shutil.rmtree(str(self.state_dir)); self.state_dir.mkdir(mode=0o700)
            got = self.wait_world({1: case})
            self.assertEqual((got["stalled"], got["parked"]), (1, 0), case)

    def test_the_real_parser_gives_none_for_a_missing_malformed_or_impossible_date_and_the_labels_flow_from_the_asks_list(self):
        labels = ["me:parked"]
        body = lambda line: "## Intent\nx\n\n" + line + "\n"
        for line in ("", "Parked until: soon", "Parked until: 2026-02-30", "Parked until: 2026-10-20\nParked until: 2026-10-21"):
            self.assertIsNone(sb.parked_until(body(line), labels), line)
        self.assertEqual(sb.parked_until(body("Parked until: 2026-10-20"), labels), _dt.datetime(2026, 10, 21, tzinfo=_dt.timezone.utc).timestamp())
        issue = sb.IssueIntent.from_api({"number": 5, "state": "open", "title": "t", "body": body("Parked until: 2026-10-20"), "labels": [{"name": "me:parked"}, {"name": "x"}]})
        self.assertEqual((issue.labels, issue.parked_until), (["me:parked", "x"], _dt.datetime(2026, 10, 21, tzinfo=_dt.timezone.utc).timestamp()))
        self.assertEqual(self.health.PARKED_MAX_DAYS, sb.PARKED_MAX_DAYS)

    def test_a_mixed_fleet_shows_the_split_in_status_and_only_the_plain_stall_counts(self):
        got = self.wait_world({1: {"labels": []}, 2: {"labels": ["me:awaiting-user"]}, 3: {"labels": ["me:awaiting-cos"]},
                               4: {"labels": ["me:parked"], "parked_until": self.T0 + 9 * self.DAY}, 5: {"labels": []}})
        self.assertEqual((got["open_asks"], got["stalled"], got["waiting_owner"], got["waiting_cos"], got["parked"]), (5, 2, 1, 1, 1))
        self.health.append_moves(str(self.state_dir), [{"at": self.T0 + 3 * 3600 - 10, "repo": "r", "numbers": [5], "refs": [5], "kind": "push"}])
        got = self.wait_world({1: {"labels": []}, 2: {"labels": ["me:awaiting-user"]}, 3: {"labels": ["me:awaiting-cos"]},
                               4: {"labels": ["me:parked"], "parked_until": self.T0 + 9 * self.DAY}, 5: {"labels": []}})
        self.assertEqual((got["stalled"], got["stalled_asks"]), (1, [1]))
        row = [l for l in self.health.status_lines(str(self.state_dir), self.T0) if l.strip().startswith("o ")][0]
        self.assertIn("stalled 1, waiting on owner 1, parked 1, waiting on cos 1", row)

    def test_wait_labels_take_precedence_owner_then_cos_then_parked_and_the_bare_label_counts(self):
        future = self.T0 + 9 * self.DAY
        got = self.wait_world({1: {"labels": ["me:awaiting-cos", "me:awaiting-user", "me:parked"], "parked_until": future},   # all three: the owner wins
                               2: {"labels": ["me:awaiting-cos", "me:parked"], "parked_until": future},                       # cos beats parked
                               3: {"labels": ["awaiting-user"]},                                                                # a bare, unprefixed label
                               4: {"labels": ["me:parked"], "parked_until": future},
                               5: {"labels": ["unrelated:label"]}})
        self.assertEqual((got["waiting_owner"], got["waiting_cos"], got["parked"], got["stalled"]), (2, 1, 1, 1))

    def test_asks_waiting_or_parked_do_not_make_the_busy_coders_rule_fire(self):
        def fig(**kw):
            base = {"name": "o", "open_asks": 6, "active_asks": 6, "stalled": 0, "stalled_asks": [], "moved_1h": 0, "moved_backlog": 1, "busy": 2, "idle": 0,
                    "messages": 0, "decisions": 0}
            return dict(base, **kw)
        cfg = dict(self.health.DEFAULTS)
        self.assertIn("at least twice", self.health.judge(fig(), cfg, None)[0])                       # 6 active asks, 1 moved, nothing in the last hour: fires
        self.assertIsNone(self.health.judge(fig(active_asks=1, waiting_owner=3, waiting_cos=1, parked=1), cfg, None)[0])   # 5 of the 6 only wait or are parked: 1 active, no wake
        # the same through a real pass: 6 asks, 5 waiting or parked, coders full, nothing moved
        got = self.wait_world({1: {"labels": ["me:awaiting-user"]}, 2: {"labels": ["me:awaiting-user"]}, 3: {"labels": ["me:awaiting-cos"]},
                               4: {"labels": ["me:parked"], "parked_until": self.T0 + 9 * self.DAY}, 5: {"labels": ["me:parked"], "parked_until": self.T0 + 9 * self.DAY},
                               6: {"labels": []}}, enabled=True)
        self.assertEqual((got["open_asks"], got["active_asks"]), (6, 1))

    def test_waiting_asks_never_wake_the_chief_of_staff_but_plain_stalls_do(self):
        self.wait_world({1: {"labels": ["me:awaiting-user"]}, 2: {"labels": ["me:awaiting-user"]}}, enabled=True)
        for hours in (4, 5, 6):
            self.health.tick(self.health.Context(now=self.T0 + hours * 3600, state_dir=str(self.state_dir), cfg=dict(self.health.DEFAULTS, enabled=True),
                                                 orchestrators={"o": {"charter": 1, "repo": "r", "busy": 0, "idle": 1, "messages": 0}},
                                                 read_asks=lambda c, r: [dict({"repo": "r", "number": n}, **self.waits[n]) for n in sorted(self.waits)], cos="cos", wake=self.woken.append))
        self.assertEqual(self.woken, [])
        shutil.rmtree(str(self.state_dir)); self.state_dir.mkdir(mode=0o700)
        self.wait_world({1: {"labels": []}, 2: {"labels": []}}, enabled=True)
        self.assertEqual(len(self.woken), 1)

    def decisions_world(self, decisions, parents, orchestrators=None, asks=None, charters=None, tick_at=None, **extra):
        """Passes of orchestrators with charters (`charters`: name -> number) and asks, over a decisions.json of `decisions` and issue parents `parents`."""
        (self.state_dir / "decisions.json").write_text(json.dumps({"decisions": decisions}))
        reads = []
        def read_parent(repo, number):
            reads.append(number)
            if number not in parents:
                raise RuntimeError("gh is down")
            return parents[number]
        orch = orchestrators or {"a": {"charter": 1, "repo": "r", "busy": 0, "idle": 1, "messages": 0}, "b": {"charter": 2, "repo": "r", "busy": 0, "idle": 1, "messages": 0}}
        asks = asks or {1: [10], 2: [20]}
        def read_asks(charter, repo):
            return [{"repo": "r", "number": n} for n in asks[charter]]
        def tick(at=None, **kw):
            ctx = self.health.Context(now=at or self.T0, state_dir=str(self.state_dir), cfg=dict(self.health.DEFAULTS, **kw.pop("cfg", {})), orchestrators=orch,
                                      read_asks=read_asks, read_parent=read_parent, cos="cos", wake=self.woken.append, **dict(extra, **kw))
            return self.health.tick(ctx)
        return tick, reads

    def test_an_old_format_row_is_followed_through_the_issues_it_closed(self):
        tick, reads = self.chain_world({200: 100})
        tick(self.T0)
        late = self.T0 + 3 * 3600
        tick(late, [{"at": late - 60, "repo": "r", "numbers": [900, 200], "kind": "push"}])     # written before refs existed: the pull request and what it closed
        self.assertEqual((self.latest()["o"]["moved_1h"], reads), (1, [200]))

    def test_a_pull_request_under_the_charter_with_no_ask_is_charter_movement_and_credits_no_ask(self):
        tick, reads = self.chain_world({300: 1})                       # issue 300's parent is the charter 1 itself
        tick(self.T0)
        late = self.T0 + 3 * 3600
        tick(late, [self.move_row(late - 60, [300])])
        got = self.latest()["o"]
        self.assertEqual((got["charter_moves_1h"], got["moved_1h"], got["stalled"]), (1, 0, 1))
        lines = self.health.status_lines(str(self.state_dir), late)
        self.assertIn("charter moves 1h 1", [l for l in lines if l.strip().startswith("o ")][0])

    def test_charter_movement_keeps_the_busy_coders_rule_quiet(self):
        orch = {"o": {"charter": 1, "repo": "r", "busy": 2, "idle": 0, "messages": 0}}
        self.asks = {1: [10, 11, 12]}
        def tick(at, rows=()):
            if rows:
                self.health.append_moves(str(self.state_dir), list(rows))
            return self.health.tick(self.health.Context(now=at, state_dir=str(self.state_dir), cfg=dict(self.health.DEFAULTS, enabled=True), orchestrators=orch,
                                                        read_asks=lambda c, r: [{"repo": "r", "number": n} for n in self.asks[c]],
                                                        read_parent=lambda repo, n: 1, cos="cos", wake=self.woken.append))
        tick(self.T0, [{"at": self.T0 - 60, "repo": "r", "numbers": [900, 300], "refs": [300], "kind": "push"}])   # the lane is moving: no wake for outnumbered asks
        tick(self.T0 + 600)
        self.assertEqual(self.woken, [])
        shutil.rmtree(str(self.state_dir)); self.state_dir.mkdir(mode=0o700)
        tick(self.T0)                                                                                      # nothing moved at all: the same fixture fires
        self.assertEqual(len(self.woken), 1)

    def test_a_decision_belongs_to_the_charter_on_its_chain_not_to_its_agent_field(self):
        tick, reads = self.decisions_world([{"agent": "b", "ask": 500, "repo": "r"}], {500: 10, 10: 1})   # 500 -> ask 10 of orchestrator a; the field says b
        tick()
        got = self.latest()
        self.assertEqual((got["a"]["decisions"], got["b"]["decisions"]), (1, 0))

    def test_every_decision_is_attributed_to_the_charter_that_holds_it_even_with_no_agent(self):
        tick, reads = self.decisions_world([{"agent": None, "ask": 10, "repo": "r"}, {"agent": "a", "ask": 20, "repo": "r"}, {"agent": None, "ask": 600, "repo": "r"}],
                                           {600: 2})
        tick()
        got = self.latest()
        self.assertEqual((got["a"]["decisions"], got["b"]["decisions"]), (1, 2))                         # 10 -> a's ask; 20 -> b's ask; 600 -> charter 2 (b)

    def test_a_decision_whose_chain_cannot_be_resolved_belongs_to_nobody_and_status_says_so(self):
        tick, reads = self.decisions_world([{"agent": "a", "ask": 700, "repo": "r"}], {})              # the parent read fails
        tick()
        got = self.latest()
        self.assertEqual((got["a"]["decisions"], got["b"]["decisions"]), (0, 0))                        # the agent field is not used as a fallback
        lines = self.health.status_lines(str(self.state_dir), self.T0)
        self.assertEqual(len([l for l in lines if "1 decision(s) not attributed" in l]), 1)

    def test_a_notice_or_a_held_pr_is_information_and_a_real_wait_without_an_ask_is_not_attributed(self):
        tick, reads = self.decisions_world([{"kind": "notice", "ask": None, "number": 10, "repo": "r"}, {"kind": "captain", "ask": None, "number": 20, "repo": "r"},
                                            {"kind": "permission", "ask": None, "repo": "r"}, {"kind": "question", "ask": 0}, {"ask": 10, "repo": "r"}], {})
        tick()
        got = self.latest()
        self.assertEqual((got["a"]["decisions"], got["b"]["decisions"], reads), (1, 0, []))               # the own number is not a fallback
        lines = self.health.status_lines(str(self.state_dir), self.T0)
        self.assertEqual([l.strip().split(" (")[0] for l in lines if "PR notices and holds" in l], ["PR notices and holds 2"])
        self.assertEqual([l.strip().split(" (")[0] for l in lines if "not attributed" in l], ["2 decision(s) not attributed"])
        self.assertEqual(self.health.decision_items(str(self.state_dir)), ([("r", None), ("", None), ("r", 10)], 2))

    def test_a_malformed_decisions_file_counts_nothing_and_breaks_nothing(self):
        for text in ["not json", "[]", '{"decisions": 5}', '{"decisions": [1, "x", null, {"ask": true, "repo": 7}, {"ask": -3}, {"ask": 1.5}]}']:
            shutil.rmtree(str(self.state_dir)); self.state_dir.mkdir(mode=0o700)
            tick, reads = self.decisions_world([], {})
            (self.state_dir / "decisions.json").write_text(text)
            tick()
            self.assertEqual((self.latest()["a"]["decisions"], reads), (None if text in ("not json", "[]", '{"decisions": 5}') else 0, []), text)

    def test_the_decision_items_are_capped_and_a_bad_repository_is_not_read(self):
        many = [{"ask": 10, "repo": "r"} for _ in range(self.health.DECISIONS_MAX + 50)]
        (self.state_dir / "decisions.json").write_text(json.dumps({"decisions": many}))
        items, notices = self.health.decision_items(str(self.state_dir))
        self.assertEqual((len(items), notices), (self.health.DECISIONS_MAX, 0))
        (self.state_dir / "decisions.json").write_text(json.dumps({"decisions": [{"ask": 5, "repo": "../x y"}, {"ask": 6, "repo": "acme/api"}]}))
        self.assertEqual(self.health.decision_items(str(self.state_dir))[0], [("", 5), ("acme/api", 6)])

    def test_the_decision_chain_stops_at_the_depth_cap(self):
        deep = {600: 601, 601: 602, 602: 603, 603: 10}                                                   # 600 is four parents below ask 10
        tick, reads = self.decisions_world([{"ask": 600, "repo": "r"}], deep)
        tick()
        got = self.latest()
        self.assertEqual((got["a"]["decisions"], reads, self.health.PARENT_LEVELS), (0, [600, 601, 602], 3))

    def test_decision_chains_are_read_once_and_count_in_the_account_budget(self):
        tick, reads = self.decisions_world([{"agent": "a", "ask": 500, "repo": "r"}, {"agent": "a", "ask": 501, "repo": "r"}], {500: 10, 501: 10})
        for k in range(3):
            tick(self.T0 + k * 600)
        self.assertEqual(sorted(reads), [500, 501])
        state = json.loads((self.state_dir / "load.json").read_text())
        self.assertEqual(len(state["reads"]), 4)                                                        # two asks lists (a, b) and the two parents, none repeated over three passes
        self.assertEqual(state["parents"], {"r#500": 10, "r#501": 10})

    def test_an_idle_pass_rewrites_nothing(self):
        self.asks = {1: [1]}
        self.tick(self.T0, {"o": self.orch(busy=1, charter=1)})
        before = (self.state_dir / "load.json").stat().st_mtime_ns
        self.tick(self.T0 + 60, {"o": self.orch(busy=1, charter=1)})
        self.assertEqual((self.state_dir / "load.json").stat().st_mtime_ns, before)



def watch_parent(getppid=os.getppid, exit_fn=os._exit, pause=time.sleep, every=2.0, rounds=None):
    """A daemon thread that ends this run (status 143) when its parent process is gone (the parent id changes, to 1 or to a subreaper), so no run outlives the shell
    that started it. Returns the thread, or None when the parent was already init (a container's pid 1: nothing to compare with). `rounds` bounds the loop (tests)."""
    start = getppid()
    if start == 1:
        return None

    def watch():
        left = rounds
        while left is None or left > 0:
            if getppid() != start:
                exit_fn(143)
                return
            pause(every)
            left = None if left is None else left - 1
    thread = threading.Thread(target=watch, daemon=True)
    thread.start()
    return thread


def main(argv):
    watch_parent()
    loader = unittest.TestLoader()
    suite = loader.loadTestsFromModule(sys.modules[__name__])
    if argv:
        keep = unittest.TestSuite()
        for group in suite:
            for case in group:
                if any(token.lower() in case.id().lower() for token in argv):
                    keep.addTest(case)
        suite = keep

    runner = unittest.TextTestRunner(verbosity=2, stream=sys.stdout)
    result = runner.run(suite)

    passed = result.testsRun - len(result.failures) - len(result.errors) - len(result.skipped)
    if SCENARIO_REPORTS:
        print()
        print("Offline scenarios (each control must FAIL what it names):")
        for report in SCENARIO_REPORTS:
            print(format_scenario_report(report))
    print()
    print("=" * 70)
    print("test-switchboard: %d run, %d passed, %d failed, %d errored, %d skipped"
          % (result.testsRun, passed, len(result.failures), len(result.errors), len(result.skipped)))
    print("=" * 70)
    ok = result.wasSuccessful() and result.testsRun > 0
    print("RESULT: %s" % ("PASS" if ok else "FAIL"))
    return 0 if ok else 1


class TestSlice3Modules(Base):
    """#437 slice 3: the loaders come from one generator, three more modules declare their own key, and two modules added on two branches never touch a shared line."""

    OLD = [   # what validate_config said before the move (recorded from the previous program): the error text is the contract
        ("temp_janitor", {"days": 0}, "config: temp_janitor.days must be a whole number from 1 to 365, got 0"),
        ("temp_janitor", "x", "config: 'temp_janitor' must be an object with only enabled, days, keep, dir, scan_seconds, weekly_scan_seconds and daemon_apply, got 'x'"),
        ("chat_clear", {"live": "y"}, 'config: \'chat_clear\' must be {"enabled": true|false, "live": true|false}, got {\'live\': \'y\'}'),
        ("chat_clear", [1], 'config: \'chat_clear\' must be {"enabled": true|false, "live": true|false}, got [1]'),
        ("impact_floor", {"enabled": "y"}, "config: 'impact_floor.enabled' must be true or false"),
        ("impact_floor", "x", "config: 'impact_floor' must be an object"),
        ("impact_floor", {"zzz": 1}, "config: 'impact_floor' has key(s) this tool does not read: zzz"),
    ]
    GOOD = {"temp_janitor": [None, {"days": 3}], "chat_clear": [None, {"live": True}], "impact_floor": [None, {"enabled": True}]}

    def test_s1_every_loader_is_generated_and_returns_the_module_load_module_returns(self):
        tree = ast.parse(SWITCHBOARD.read_text())
        defined = {node.name for node in tree.body if isinstance(node, ast.FunctionDef)}
        self.assertEqual(len(sb.HELPER_MODULES), 22)
        self.assertEqual(defined & set(sb.HELPER_MODULES), set(), "0 of the loaders has a def of its own")
        for function, module in sb.HELPER_MODULES.items():
            with self.subTest(function=function):
                loader = getattr(sb, function)
                self.assertIs(loader(), sb.load_module(module))
                self.assertIs(loader(), loader(), "the second call returns the identical object")
                self.assertEqual(loader.__name__, function)

    def test_s2_the_moved_keys_give_the_old_results_and_the_old_error_text(self):
        for key, values in self.GOOD.items():
            for value in values:
                with self.subTest(key=key, value=value):
                    sb.validate_config({key: value})
        sb.validate_config({})
        for key, value, text in self.OLD:
            with self.subTest(key=key, value=value), self.assertRaises(sb.ConfigError) as caught:
                sb.validate_config({key: value})
            self.assertEqual(str(caught.exception), text)

    def test_s3_the_three_keys_are_declared_by_their_modules_and_in_no_shared_place(self):
        declared = sb.config_declarations()
        for key, module in (("temp_janitor", "disk_janitor"), ("chat_clear", "chat_clear"), ("impact_floor", "impact_floor")):
            with self.subTest(key=key):
                self.assertEqual(declared[key], module)
                self.assertNotIn(key, sb.TOP_LEVEL_EXTRA_KEYS)
                self.assertIn(key, sb.config_known_keys())
        source = inspect.getsource(sb.validate_config)
        for text in ('"temp_janitor"', '"chat_clear"', '"impact_floor"'):
            self.assertNotIn(text, source, "no inline block for it is left in the validation chain")

    def make_program(self, extra):
        """A copy of the real program and its modules in a scratch directory, with `extra` files added to its bin."""
        directory = Path(tempfile.mkdtemp(prefix="slice3-"))
        self.addCleanup(shutil.rmtree, directory, True)
        for path in BIN.glob("*.py"):
            shutil.copy(str(path), str(directory / path.name))
        copy_entry(directory)
        for name, text in extra.items():
            (directory / name).write_text(text)
        return directory

    def load_copy(self, directory):
        loader = importlib.machinery.SourceFileLoader("sb_copy_%d" % id(directory), str(directory / "fleet-switchboard"))
        module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
        loader.exec_module(module)
        return module

    def test_s4_a_fixture_module_with_a_key_needs_no_change_to_the_program(self):
        fixture = 'CONFIG_KEY = "slice3_key"\nCONFIG_DEFAULT = {"n": 2}\n\n\ndef validate(raw, source):\n    if not isinstance(raw, dict):\n        raise ValueError("%s: slice3 bad" % source)\n\n\ndef hello():\n    return "hi"\n'
        directory = self.make_program({"slice3_mod.py": fixture})
        before = (directory / "fleet-switchboard").read_bytes()
        copy = self.load_copy(directory)
        self.assertEqual(copy.load_module("slice3_mod").hello(), "hi", "found by name from its own file")
        self.assertEqual(copy.validate_config({})["slice3_key"], {"n": 2})
        with self.assertRaises(copy.ConfigError) as caught:
            copy.validate_config({"slice3_key": 5})
        self.assertEqual(str(caught.exception), "config: slice3 bad")
        self.assertEqual((directory / "fleet-switchboard").read_bytes(), before)

    def test_s5_two_branches_that_each_add_a_module_merge_without_a_conflict_and_both_keys_work_after_the_merge(self):
        directory = Path(tempfile.mkdtemp(prefix="slice3-merge-"))
        self.addCleanup(shutil.rmtree, directory, True)
        (directory / "bin").mkdir()
        for path in BIN.glob("*.py"):
            shutil.copy(str(path), str(directory / "bin" / path.name))
        copy_entry(directory / "bin")

        def git(*args):
            return subprocess.run(["git", "-c", "user.name=t", "-c", "user.email=t@example.com", "-c", "commit.gpgsign=false"] + list(args), cwd=str(directory),
                                  stdout=subprocess.PIPE, stderr=subprocess.STDOUT, universal_newlines=True)

        self.assertEqual(git("init", "-q", "-b", "main").returncode, 0)
        git("add", "-A"), git("commit", "-q", "-m", "base")
        for branch, key in (("one", "fixture_one"), ("two", "fixture_two")):
            git("checkout", "-q", "-b", branch, "main")
            (directory / "bin" / ("%s.py" % key)).write_text('CONFIG_KEY = "%s"\nCONFIG_DEFAULT = {"n": 1}\n\n\ndef validate(raw, source):\n    if raw is not None and not isinstance(raw, dict):\n        raise ValueError("%s: bad")\n' % (key, key))
            git("add", "-A"), git("commit", "-q", "-m", branch)
            self.assertEqual(git("diff", "--name-only", "main", branch).stdout.split(), ["bin/%s.py" % key], "0 lines of the program changed")
        git("checkout", "-q", "one")
        merged = git("merge", "--no-edit", "two")
        self.assertEqual(merged.returncode, 0, merged.stdout)
        loader = importlib.machinery.SourceFileLoader("sb_merged_%d" % id(directory), str(directory / "bin" / "fleet-switchboard"))
        program = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
        loader.exec_module(program)
        seen = []
        program.warn_unknown_config = lambda message, section="", names=(), known=(): seen.append(list(names))
        config = program.validate_config({})
        self.assertEqual((config["fixture_one"], config["fixture_two"]), ({"n": 1}, {"n": 1}), "both modules are found and defaulted after the merge, with no line in the program")
        self.assertEqual(seen, [])
        with self.assertRaises(program.ConfigError):
            program.validate_config({"fixture_two": "bad"})
        # the test fails when the behaviour breaks: a program that kept a shared key table (no declaration scan) does not know the keys
        program.config_declarations = lambda: {}
        program.validate_config({"fixture_one": {"n": 2}, "fixture_two": {"n": 3}})
        self.assertEqual(seen, [["fixture_one", "fixture_two"]], "with the declarations removed the keys are unknown: this test would fail")

    def test_a_missing_module_file_refuses_the_configuration_for_each_of_the_three_moved_keys_with_the_floor_message(self):
        for key, module, good in (("temp_janitor", "disk_janitor", {"days": 3}), ("chat_clear", "chat_clear", {"live": True}), ("impact_floor", "impact_floor", {"enabled": True})):
            with self.subTest(key=key):
                directory = Path(tempfile.mkdtemp(prefix="slice3-missing-"))
                self.addCleanup(shutil.rmtree, directory, True)
                for path in BIN.glob("*.py"):
                    if path.stem != module:   # the module file is gone
                        shutil.copy(str(path), str(directory / path.name))
                with mock.patch.object(sb, "CONFIG_DECLARATIONS_DIR", str(directory)), self.assertRaises(sb.ConfigError) as caught:
                    sb.validate_config({key: good})
                self.assertEqual(str(caught.exception), "config key %r must be declared by %s.py, and it is not (the module is missing, its CONFIG_KEY line is missing or damaged, "
                                 "or it names another key): no configuration is loaded" % (key, module))

    def test_when_two_keys_are_wrong_the_declared_modules_win_in_module_name_order_and_the_earlier_checks_win_over_them(self):
        bad = {"temp_janitor": "x", "chat_clear": "x", "impact_floor": "x"}
        with self.assertRaises(sb.ConfigError) as caught:
            sb.validate_config(dict(bad))
        self.assertIn("'chat_clear'", str(caught.exception), "chat_clear.py sorts before disk_janitor.py and impact_floor.py")
        del bad["chat_clear"]
        with self.assertRaises(sb.ConfigError) as caught:
            sb.validate_config(dict(bad))
        self.assertIn("temp_janitor", str(caught.exception), "disk_janitor.py sorts before impact_floor.py")
        with self.assertRaises(sb.ConfigError) as caught:
            sb.validate_config({"chat_clear": "x", "cpu_guard": "x"})
        self.assertIn("cpu_guard", str(caught.exception), "the checks that run before the declared ones still win")
        with self.assertRaises(sb.ConfigError) as caught:
            sb.validate_config({"chat_clear": "x", "docker_reaper": "x"})
        self.assertIn("chat_clear", str(caught.exception), "a declared module's check wins over the ones that follow it")

    def test_s6_a_default_owned_key_and_a_key_with_its_validator_in_the_program_stay_where_they_were(self):
        self.assertTrue({"reds", "heavy", "cpu_guard"} <= set(sb.DEFAULTS))
        self.assertTrue({"sweep", "triage", "plan_review", "impact_hold"} <= sb.TOP_LEVEL_EXTRA_KEYS)
        for key, value in (("sweep", "x"), ("impact_hold", "x"), ("plan_review", "x")):
            with self.subTest(key=key), self.assertRaises(sb.ConfigError):
                sb.validate_config({key: value})

    def test_s7_a_module_name_that_is_a_path_or_missing_is_refused(self):
        for name in ("../fleet_health", "/etc/passwd", "no_such_module_xyz", "a/b", ""):
            with self.subTest(name=name), self.assertRaises((ValueError, ImportError, OSError)):
                sb.load_module(name)

    def test_u2_a_missing_or_broken_module_fails_with_an_error_and_is_not_kept(self):
        directory = self.make_program({"broken_mod.py": "def (:\n"})
        copy = self.load_copy(directory)
        with self.assertRaises(SyntaxError):
            copy.load_module("broken_mod")
        with self.assertRaises(SyntaxError):
            copy.load_module("broken_mod")   # a failed import is never kept: it fails again
        with self.assertRaises(FileNotFoundError):
            copy.load_module("absent_mod")
        self.assertNotIn("broken_mod", sys.modules)


class TestConfigDeclarations(Base):
    """#437 slice 2: a module declares its own configuration key, default and validator; the shared code reads the declarations from the bin directory only."""

    FIXTURE = ('CONFIG_KEY = "fixture_key"\nCONFIG_DEFAULT = {"n": 1}\n\n\n'
               'def validate(raw, source):\n    if not isinstance(raw, dict):\n        raise ValueError("fixture: bad value")\n')

    def bin(self, must=None, **files):
        directory = Path(tempfile.mkdtemp(prefix="decl-"))
        floor = mock.patch.object(sb, "CONFIG_MUST_DECLARE", must or {})
        floor.start()
        self.addCleanup(floor.stop)
        self.addCleanup(shutil.rmtree, directory, True)
        for name, text in files.items():
            (directory / name).write_text(text)
        patcher = mock.patch.object(sb, "CONFIG_DECLARATIONS_DIR", str(directory))
        patcher.start()
        self.addCleanup(patcher.stop)
        return directory

    def warnings(self):
        seen = []
        patcher = mock.patch.object(sb, "warn_unknown_config", lambda message, section="", names=(), known=(): seen.append(list(names)))
        patcher.start()
        self.addCleanup(patcher.stop)
        return seen

    def test_s1_a_declared_key_is_known_defaulted_and_needs_no_shared_line(self):
        self.bin(**{"fixture_mod.py": self.FIXTURE})
        seen = self.warnings()
        self.assertEqual(sb.validate_config({})["fixture_key"], {"n": 1}, "the declared default is applied when the key is absent")
        self.assertEqual(sb.validate_config({"fixture_key": {"n": 5}})["fixture_key"], {"n": 5})
        self.assertEqual(seen, [], "no unknown-key warning for a declared key")
        self.assertIn("fixture_key", sb.config_known_keys())
        self.assertNotIn("fixture_key", sb.TOP_LEVEL_EXTRA_KEYS)
        self.assertNotIn("fixture_key", sb.DEFAULTS)

    def test_s2_the_declared_validator_runs_and_its_message_is_the_error(self):
        self.bin(**{"fixture_mod.py": self.FIXTURE})
        with self.assertRaises(sb.ConfigError) as caught:
            sb.validate_config({"fixture_key": "nope"})
        self.assertEqual(str(caught.exception), "fixture: bad value")

    def test_s4_a_key_declared_twice_or_owned_by_the_shared_defaults_is_refused_naming_both(self):
        self.bin(**{"one.py": self.FIXTURE, "two.py": self.FIXTURE})
        with self.assertRaises(sb.ConfigError) as caught:
            sb.config_declarations()
        self.assertIn("one.py", str(caught.exception))
        self.assertIn("two.py", str(caught.exception))
        self.bin(**{"shared.py": 'CONFIG_KEY = "poll_seconds"\n'})
        with self.assertRaises(sb.ConfigError) as caught:
            sb.config_declarations()
        self.assertIn("shared.py", str(caught.exception))
        self.assertIn("shared defaults", str(caught.exception))

    def test_s5_only_py_files_directly_in_the_bin_directory_are_read(self):
        directory = self.bin(**{"real.py": 'CONFIG_KEY = "real_key"\n', "backup.py.bak": 'CONFIG_KEY = "bak_key"\n', "notes.txt": 'CONFIG_KEY = "txt_key"\n'})
        (directory / "sub").mkdir()
        (directory / "sub" / "deep.py").write_text('CONFIG_KEY = "deep_key"\n')
        outside = Path(tempfile.mkdtemp(prefix="outside-"))
        self.addCleanup(shutil.rmtree, outside, True)
        (outside / "out.py").write_text('CONFIG_KEY = "outside_key"\n')
        (directory / "link.py").symlink_to(outside / "out.py")
        self.assertEqual(sb.config_declarations(), {"real_key": "real"}, "0 decoys: a subdirectory, a backup, a text file and a symlink are not read")

    def test_s6_shared_keys_stay_shared_and_an_undeclared_key_still_warns(self):
        self.bin(**{"fixture_mod.py": self.FIXTURE})
        seen = self.warnings()
        sb.validate_config({"reds": None, "heavy": None, "nowhere_key": 1})
        self.assertEqual(seen, [["nowhere_key"]])

    def test_the_listing_is_cached_until_a_file_changes_and_a_caller_cannot_change_the_cache(self):
        directory = self.bin(**{"one.py": 'CONFIG_KEY = "one_key"\n'})
        first = sb.config_declarations()
        first["tampered"] = "x"
        self.assertEqual(sb.config_declarations(), {"one_key": "one"}, "the returned dict is a copy")
        (directory / "two.py").write_text('CONFIG_KEY = "two_key"\n')
        self.assertEqual(sb.config_declarations(), {"one_key": "one", "two_key": "two"}, "a new file is seen")
        (directory / "one.py").write_text('CONFIG_KEY = "uno_key"  # renamed\n')
        self.assertEqual(sb.config_declarations(), {"uno_key": "one", "two_key": "two"}, "an edited file is seen")

    def test_an_unreadable_file_or_directory_fails_the_whole_configuration_naming_it(self):
        directory = self.bin(**{"locked.py": 'CONFIG_KEY = "locked_key"\n'})
        real_open = open
        def deny(path, *args, **kwargs):
            if str(path).endswith("locked.py"):
                raise PermissionError(13, "Permission denied")
            return real_open(path, *args, **kwargs)
        with mock.patch("builtins.open", deny), self.assertRaises(sb.ConfigError) as caught:
            sb.config_declarations()
        self.assertIn("locked.py", str(caught.exception))
        with mock.patch.object(sb, "CONFIG_DECLARATIONS_DIR", str(directory / "missing")), self.assertRaises(sb.ConfigError) as caught:
            sb.config_declarations()
        self.assertIn("cannot be read", str(caught.exception))

    def test_a_declaring_module_must_hold_its_key_and_a_validate(self):
        self.bin(**{"novalidate.py": 'CONFIG_KEY = "nv_key"\n'})
        with self.assertRaises(sb.ConfigError) as caught:
            sb.validate_config({})
        self.assertIn("novalidate.py", str(caught.exception))
        self.assertIn("no validate", str(caught.exception))
        self.bin(**{"liar.py": 'CONFIG_KEY = "doc_key"\nif True:\n    CONFIG_KEY = "other_key"\ndef validate(raw, source):\n    pass\n'})
        with self.assertRaises(sb.ConfigError) as caught:
            sb.validate_config({})
        self.assertIn("liar.py", str(caught.exception))
        self.assertIn("'doc_key'", str(caught.exception))

    def test_a_validator_that_fails_any_other_way_is_a_broken_module(self):
        self.bin(**{"crash.py": 'CONFIG_KEY = "crash_key"\ndef validate(raw, source):\n    raise KeyError("boom")\n'})
        with self.assertRaises(sb.ConfigError) as caught:
            sb.validate_config({})
        self.assertIn("crash.py", str(caught.exception))
        self.assertIn("no configuration is loaded", str(caught.exception))

    def test_the_declaration_line_has_its_edges(self):
        big = "#" * 1000000 + '\nCONFIG_KEY = "late_key"\n'
        self.bin(**{"commented.py": 'CONFIG_KEY = "ok_key"   # a comment\n', "single.py": "CONFIG_KEY = 'sq_key'\n", "spaced.py": 'CONFIG_KEY   =   "sp_key"\n',
                    "tabbed.py": 'CONFIG_KEY\t=\t"tb_key"\n', "typed.py": 'CONFIG_KEY: str = "ty_key"\n', "late.py": big,
                    "nested.py": 'if True:\n    CONFIG_KEY = "nested_key"\n', "text.py": '# CONFIG_KEY = "text_key"\nx = "CONFIG_KEY = \'str_key\'"\n'})
        self.assertEqual(sb.config_declarations(), {"ok_key": "commented", "sq_key": "single", "sp_key": "spaced", "tb_key": "tabbed", "ty_key": "typed"},
                         "quotes, spacing, a tab and an annotation do not matter; a nested statement, a comment, a string and a line past the 1 MB read are not declarations")

    def test_a_key_of_the_wrong_form_is_refused_naming_the_file(self):
        for text in ('CONFIG_KEY = "Upper"\n', 'CONFIG_KEY = "1key"\n', 'CONFIG_KEY = 3\n'):
            with self.subTest(text):
                self.bin(**{"badform.py": text})
                with self.assertRaises(sb.ConfigError) as caught:
                    sb.config_declarations()
                self.assertIn("badform.py", str(caught.exception))

    def test_a_required_key_whose_declaration_is_not_found_refuses_the_whole_configuration(self):
        must = {"excluded_repos": "repo_exclusion"}
        validate = 'def validate(raw, source):\n    pass\n'
        good = {"single quotes": "CONFIG_KEY = 'excluded_repos'\n", "extra spaces": 'CONFIG_KEY    =    "excluded_repos"\n', "a tab": 'CONFIG_KEY\t=\t"excluded_repos"\n'}
        for what, line in good.items():
            with self.subTest(what):
                self.bin(must=must, **{"repo_exclusion.py": line + validate})
                self.assertEqual(sb.validate_config({}).get("excluded_repos"), None)
        bad = {"commented out": '# CONFIG_KEY = "excluded_repos"\n' + validate, "truncated": 'CONFIG_KEY = "excl', "a renamed key": 'CONFIG_KEY = "excluded_repo"\n' + validate,
               "inside a string": 'x = """\nCONFIG_KEY = "excluded_repos"\n"""\n' + validate, "empty module": ""}
        for what, text in bad.items():
            with self.subTest(what):
                self.bin(must=must, **{"repo_exclusion.py": text})
                with self.assertRaises(sb.ConfigError) as caught:
                    sb.validate_config({"excluded_repos": ["acme/api"]})
                self.assertIn("repo_exclusion.py", str(caught.exception))
                self.assertIn("excluded_repos", str(caught.exception))
        self.bin(must=must)
        with self.assertRaises(sb.ConfigError) as caught:
            sb.validate_config({})
        self.assertIn("repo_exclusion.py", str(caught.exception), "the module is missing")

    def test_the_real_floor_names_the_two_moved_keys_and_the_real_modules_meet_it(self):
        self.assertEqual(sb.CONFIG_MUST_DECLARE, {"excluded_repos": "repo_exclusion", "spotlight_guard": "spotlight_guard", "temp_janitor": "disk_janitor",
                                                  "chat_clear": "chat_clear", "impact_floor": "impact_floor"})
        self.assertEqual({k: sb.config_declarations()[k] for k in sb.CONFIG_MUST_DECLARE}, sb.CONFIG_MUST_DECLARE)

    def test_s7_the_moved_keys_are_known_through_their_declarations(self):
        self.assertTrue({"spotlight_guard", "excluded_repos"} <= set(sb.config_known_keys()))
        self.assertFalse({"spotlight_guard", "excluded_repos"} & sb.TOP_LEVEL_EXTRA_KEYS)
        declared = sb.config_declarations()
        self.assertEqual((declared["excluded_repos"], declared["spotlight_guard"]), ("repo_exclusion", "spotlight_guard"))

    def test_a_declaring_module_that_cannot_load_fails_the_whole_configuration_naming_its_file(self):
        self.bin(**{"broken.py": 'CONFIG_KEY = "broken_key"\nthis is not python\n', "fine.py": 'x = (\n'})
        with self.assertRaises(sb.ConfigError) as caught:
            sb.validate_config({})
        self.assertIn("broken.py", str(caught.exception))
        self.assertNotIn("fine.py", str(caught.exception), "only a declaring module fails the load")
        self.assertIn("no configuration is loaded", str(caught.exception))

    def test_a_module_that_does_not_declare_is_never_imported(self):
        self.bin(**{"fine.py": 'raise RuntimeError("imported")\n', "decl.py": self.FIXTURE})
        self.assertEqual(sb.validate_config({})["fixture_key"], {"n": 1})

    def test_the_moved_keys_validate_as_before_and_a_bad_value_keeps_its_message(self):
        with self.assertRaises(sb.ConfigError) as caught:
            sb.validate_config({"excluded_repos": "acme/api"})
        self.assertIn("'excluded_repos' must be a list", str(caught.exception))
        with self.assertRaises(sb.ConfigError) as caught:
            sb.validate_config({"spotlight_guard": {"folders": 3}})
        self.assertIn("spotlight_guard", str(caught.exception))
        self.assertNotIn("excluded_repos", sb.validate_config({}), "an absent key with no default adds nothing")


class TestSpotlightGuard(Base):
    """Ask #438: an hourly background check that the code and temp folders are still kept out of Spotlight; read-only, no process in a normal pass."""

    def setUp(self):
        super().setUp()
        self.dirs = []
        for name in ("code", "tmp"):
            folder = self.home / name
            folder.mkdir()
            (folder / "a.txt").write_text("x")
            self.dirs.append(str(folder))
        self.world = World(self, agents=("coder",), config={})
        self.world.add_agent("cos", fleet={"role": "chief-of-staff"})
        self.engine = self.world.engine
        self.engine.config["spotlight_guard"] = {"folders": list(self.dirs)}
        self.engine.discover(self.world.clock.now())
        self.sg = sb.load_module("spotlight_guard")
        self.counts = {}
        self.calls = []
        self.fail = [None]
        self.block = [None]

        def runner(argv, **kwargs):
            self.calls.append(list(argv))
            if self.block[0] is not None:
                self.block[0].wait(30)
            if self.fail[0] is not None:
                if isinstance(self.fail[0], str):
                    return subprocess.CompletedProcess(argv, 0, self.fail[0], "")
                raise self.fail[0]
            return subprocess.CompletedProcess(argv, 0, "2026-01-01 locale noise\n%d\n" % self.counts.get(argv[2], 0), "locale noise")
        self.engine.spotlight_runner = runner

    def source(self):
        return next(s for s in self.engine.sources if isinstance(s, sb.SpotlightFacts))

    def wakes(self):
        found, problems = self.engine.collect_facts()
        self.assertEqual(problems, [])
        return [f for f in found if f.kind == "spotlight"]

    def round(self, **counts):
        """One hourly check, finished and applied. Counts by folder index (code=0, tmp=1)."""
        self.counts = {self.dirs[int(k[1:])]: v for k, v in counts.items()}
        self.world.tick(3601)
        self.wakes()                                   # the pass starts the check
        thread = self.source().thread
        if thread is not None:
            thread.join(10)
        return self.wakes()                            # the next pass collects what it found

    def lines(self):
        cfg = self.sg.settings(self.engine.config.get("spotlight_guard"))
        return self.sg.status_lines(cfg, self.sg.load(self.world.state), self.world.clock.now())

    def test_s1_zero_counts_show_both_folders_as_excluded(self):
        self.round(f0=0, f1=0)
        lines = self.lines()
        self.assertEqual(len(lines), 2)
        self.assertTrue(all("excluded from Spotlight" in line for line in lines), lines)
        self.assertFalse(any("WARN" in line for line in lines))

    def test_s2_a_nonzero_count_on_two_checks_in_a_row_warns_naming_folder_and_count(self):
        self.round(f0=120, f1=0)
        self.round(f0=120, f1=0)
        warns = [line for line in self.lines() if "WARN" in line]
        self.assertEqual(len(warns), 1)
        self.assertIn(self.dirs[0], warns[0])
        self.assertIn("120", warns[0])
        self.assertNotIn(self.dirs[1], warns[0])

    def test_s3_one_nonzero_count_then_zero_sends_no_wake_and_no_warning(self):
        self.assertEqual(self.round(f0=120, f1=0), [])
        self.assertEqual(self.round(f0=0, f1=0), [])
        self.assertFalse(any("WARN" in line for line in self.lines()))
        self.assertEqual([e for e in self.world.audit() if e["event"] == "spotlight.lost"], [])

    def test_s4_one_wake_per_episode(self):
        keys = set()
        for counts in [120] * 5 + [0] * 2 + [90] * 3:
            for fact in self.round(f0=counts, f1=0):
                keys.add(fact.key)
        self.assertEqual(len(keys), 2, keys)
        self.assertEqual(len([e for e in self.world.audit() if e["event"] == "spotlight.lost"]), 2)
        self.assertEqual(len([e for e in self.world.audit() if e["event"] == "spotlight.recovered"]), 1)

    def real_pass_round(self, **counts):
        """One hourly check through the engine's REAL pass (fact collection, batching, delivery); returns the reports of the two passes."""
        self.counts = {self.dirs[int(k[1:])]: v for k, v in counts.items()}
        self.world.tick(3601)
        first = self.engine.run_pass()
        self.source().thread.join(10)
        return [first, self.engine.run_pass()]

    def spotlight_sends(self):
        return [a for a in self.world.admissions("cos") if any(str(k).startswith("spotlight.lost:") for k in a["keys"])]

    def test_the_real_batching_path_delivers_the_wake_once_after_the_wait(self):
        self.real_pass_round(f0=120, f1=0)
        self.real_pass_round(f0=120, f1=0)                  # the second nonzero check begins the episode: the fact is pending, batching waits
        self.assertEqual(self.spotlight_sends(), [])
        self.world.tick(30)
        self.assertIn("cos", self.engine.run_pass()["waiting"], "the fact is still pending 30 s on: it is held by the 90 s wait")
        self.world.tick(70)
        report = self.engine.run_pass()
        self.assertEqual(len(self.spotlight_sends()), 1, report)
        for _ in range(5):
            self.world.tick(30)
            self.engine.run_pass()
        self.assertEqual(len(self.spotlight_sends()), 1, "delivered once: the stable key is deduplicated on every later pass")

    def test_a_restart_between_the_alarm_and_its_delivery_still_delivers_once(self):
        self.real_pass_round(f0=120, f1=0)
        self.real_pass_round(f0=120, f1=0)
        self.assertEqual(self.spotlight_sends(), [])
        index = next(i for i, source in enumerate(self.engine.sources) if isinstance(source, sb.SpotlightFacts))
        fresh = sb.SpotlightFacts()
        fresh.bind(self.engine)
        fresh.started = self.world.clock.now()              # a restart has just run its check: nothing new to find
        self.engine.sources[index] = fresh
        self.world.tick(100)
        self.engine.run_pass()
        self.assertEqual(len(self.spotlight_sends()), 1, "the open episode was restored from the file and its fact is pending again")
        self.world.tick(30)
        self.engine.run_pass()
        self.assertEqual(len(self.spotlight_sends()), 1)

    def test_a_damaged_state_file_never_reaches_a_wake_or_a_line_nor_breaks_the_pass(self):
        folder = self.dirs[0]
        Path(self.world.state, "spotlight-guard.json").write_text(json.dumps({"folders": {
            folder: {"state": "indexed", "count": "\x1b[31mevil", "streak": 2, "episode": 1.0},
            self.dirs[1]: {"state": "indexed", "count": 5, "streak": 2, "episode": float("inf")},
            "/not/guarded": {"state": "indexed", "count": 5, "streak": 2, "episode": 1.0}}, "checked_at": 1.0}))
        fresh = sb.SpotlightFacts()
        fresh.bind(self.engine)
        facts = fresh()
        self.assertEqual(len(facts), 1, "only the guarded folder with a sane episode wakes; an unguarded folder and an infinite episode wake nobody")
        self.assertNotIn("\x1b", facts[0].summary)
        self.assertIn("some entries", facts[0].summary)
        cfg = self.sg.settings(self.engine.config.get("spotlight_guard"))
        lines = self.sg.status_lines(cfg, self.sg.load(self.world.state), 1.0)
        self.assertFalse(any("\x1b" in line for line in lines), lines)

    def test_s5_a_normal_pass_starts_nothing_and_a_slow_tool_never_delays_it(self):
        gate = threading.Event()
        self.block[0] = gate
        self.addCleanup(gate.set)
        started = time.monotonic()
        self.world.tick(1)
        self.wakes()                                   # the first pass starts the check on a thread and returns at once
        for _ in range(10):
            self.world.tick(60)
            self.wakes()
        self.assertLess(time.monotonic() - started, 5, "ten passes beside a tool that blocks for 30 s")
        self.assertTrue(self.source().thread.is_alive(), "the tool is still blocked: the passes did not wait for it")
        for _ in range(100):
            if self.calls:
                break
            time.sleep(0.05)
        self.assertEqual(len(self.calls), 1, "only the first folder has been asked: the passes started no process of their own")
        gate.set()
        self.source().thread.join(10)

    def test_a_restart_restores_an_open_episode_and_no_second_wake_begins(self):
        self.round(f0=120, f1=0)
        self.round(f0=120, f1=0)
        fresh = sb.SpotlightFacts()
        fresh.bind(self.engine)
        fresh.done = self.sg.check_all(self.dirs, self.engine.spotlight_runner)
        facts = fresh()
        self.assertEqual(len([e for e in self.world.audit() if e["event"] == "spotlight.lost"]), 1, "the episode was restored from the file")
        self.assertEqual(len({f.key for f in facts}), 1)

    def test_no_chief_of_staff_means_no_wake_but_the_warning_shows(self):
        self.engine.discovery.agents.pop("cos", None)
        self.assertEqual(self.round(f0=120, f1=0), [])
        self.assertEqual(self.round(f0=120, f1=0), [])
        self.assertTrue(any("WARN" in line for line in self.lines()))

    def test_a_guard_that_is_off_makes_no_fact_and_starts_nothing(self):
        self.engine.config["spotlight_guard"] = False
        self.world.tick(3601)
        self.assertEqual(self.wakes(), [])
        self.assertEqual(self.calls, [])

    def test_a_failing_tool_exit_is_unknown(self):
        self.engine.spotlight_runner = lambda argv, **kw: subprocess.CompletedProcess(argv, 1, "0\n", "")
        self.round()
        self.assertTrue(all("unknown" in line for line in self.lines()), self.lines())

    def test_a_bad_spotlight_guard_value_is_a_config_error_at_load(self):
        for bad in ({"folders": ["/work/../etc"]}, {"folders": ["relative/dir"]}, {"enabled": "yes"}, 5):
            self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "spotlight_guard": bad})
            with self.assertRaises(sb.ConfigError) as caught:
                sb.load_config()
            self.assertIn("spotlight_guard", str(caught.exception))

    def test_a_control_character_in_a_folder_name_never_reaches_a_line(self):
        cfg = {"folders": ["/work/a\x1b[31mb"]}
        self.assertNotIn("\x1b", self.sg.status_lines(cfg, None, 0)[0])
        self.assertNotIn("\x1b", self.sg.wake_text("/work/a\x1b[31mb", 3, "fleet-switchboard"))

    def test_s6_a_missing_or_empty_folder_is_not_checked(self):
        empty = self.home / "empty"
        empty.mkdir()
        self.engine.config["spotlight_guard"] = {"folders": [str(self.home / "nope"), str(empty)]}
        self.round()
        lines = self.lines()
        self.assertEqual(len(lines), 2)
        self.assertTrue(all("not checked" in line for line in lines), lines)
        self.assertFalse(any("excluded" in line for line in lines))
        self.assertEqual(self.calls, [], "nothing to ask about")

    def test_s7_a_missing_tool_a_timeout_and_odd_output_are_unknown(self):
        for failure in (FileNotFoundError("mdfind"), subprocess.TimeoutExpired("mdfind", 5), "a count of zero, honestly\n"):
            self.fail[0] = failure
            self.assertEqual(self.round(), [])
            self.assertEqual(self.round(), [])
            lines = self.lines()
            self.assertTrue(all("unknown" in line for line in lines), (failure, lines))
            self.assertFalse(any("WARN" in line or "excluded" in line for line in lines))

    def test_s8_it_changes_no_setting_and_writes_only_its_own_file(self):
        before = {d: sorted(os.listdir(d)) for d in self.dirs}
        for _ in range(3):
            self.round(f0=0, f1=0)
        self.assertEqual({d: sorted(os.listdir(d)) for d in self.dirs}, before)
        self.assertIn("spotlight-guard.json", os.listdir(self.world.state))
        self.assertEqual([n for n in os.listdir(self.world.state) if n.endswith(".tmp")], [], "no leftover temp file")
        self.assertTrue(self.calls and all(call[0] == "mdfind" and "-count" in call and call[1] == "-onlyin" for call in self.calls), self.calls)

    def test_s8b_the_file_is_rewritten_only_when_an_answer_changed(self):
        self.round(f0=0, f1=0)
        path = Path(self.world.state) / "spotlight-guard.json"
        os.utime(path, (1, 1))
        self.round(f0=0, f1=0)
        self.assertEqual(path.stat().st_mtime, 1)
        self.round(f0=7, f1=0)
        self.assertNotEqual(path.stat().st_mtime, 1)

    def test_s9_a_bad_folder_list_is_refused_naming_the_key(self):
        for bad in ({"folders": ["/work/../etc"]}, {"folders": "not a list"}, {"folders": ["relative/dir"]}):
            with self.assertRaises(ValueError) as caught:
                self.sg.validate(bad, "config")
            self.assertIn("spotlight_guard.folders", str(caught.exception))
        self.sg.validate({"folders": ["/work/code"], "enabled": True}, "config")
        self.sg.validate(False, "config")

    def test_the_count_is_the_last_whole_number_line_of_stdout_only(self):
        self.assertEqual(self.sg.parse_count("noise\n0\n"), 0)
        self.assertEqual(self.sg.parse_count("57\n"), 57)
        for odd in ("", "abc\n", "12 files\n", "1\n2x\n"):
            self.assertIsNone(self.sg.parse_count(odd), odd)


class TestCoderBooks(Base):
    """#549: a coder finished (retired, or its final report made) is on the books but not counted among a workspace's coders."""

    def obs(self, name, session="ses_1"):
        return sb.Observation(name, session, "w1:p1", "idle", {"name": name, "role": "coder", "reports_to": "orch"})

    def test_retired_and_finished_coders_are_not_counted(self):
        retired = {"gone": {"session": "ses_1", "at": 1}, "reused": {"session": "ses_old", "at": 1}, "anysession": {"at": 1}}
        last = {"done1": {"state": "done"}, "failed1": {"state": "failed"}, "busy1": {"state": "working"}, "quiet": {"send_to": {"orch": 5}}}
        finished = lambda name, session="ses_1": sb.coder_finished(self.obs(name, session), retired, last)
        self.assertTrue(finished("gone"))
        self.assertTrue(finished("anysession"))
        self.assertFalse(finished("reused"))      # the name is taken again by a new session
        self.assertTrue(finished("done1"))
        self.assertTrue(finished("failed1"))
        self.assertFalse(finished("busy1"))
        self.assertFalse(finished("quiet"))
        self.assertFalse(finished("nobody"))


class TestRegistryEndpoint(unittest.TestCase):
    """#1074 (slice 3 of #1059): an agent without a pane has an endpoint, a liveness rule and a route function (not yet used by send); the row projections come from one tuple."""

    LOCAL = {"session": "ses_l", "pane": "p_1", "role": "coder", "repo": "o/r", "workspace": "w", "cwd": "/x"}
    CLOUD = {"session": "ses_c", "role": "orchestrator", "kind": "orchestrator", "endpoint": "https://pod.example/agent"}

    def setUp(self):
        self.reg = sb.load_module("registry")
        self.mod = sb.load_module("agent_reconcile")
        self.dir = Path(tempfile.mkdtemp(prefix="ep"))
        self.addCleanup(shutil.rmtree, self.dir, True)

    def audit(self):
        path = self.dir / "registry-audit.jsonl"
        return [json.loads(l) for l in path.read_text().splitlines()] if path.exists() else []

    def both(self):
        self.reg.upsert(self.dir, "local", self.LOCAL)
        self.reg.upsert(self.dir, "pod", self.CLOUD)

    def test_s2_a_registry_with_both_reads_whole(self):
        self.both()
        read = self.reg.read(self.dir)
        self.assertEqual((read["whole"], read["version"], sorted(read["agents"])), (True, 1, ["local", "pod"]))
        self.assertEqual(read["agents"]["pod"]["endpoint"], self.CLOUD["endpoint"])

    def test_s3_the_endpoint_reaches_every_projection_and_survives_retire_and_undo(self):
        self.both()
        row = self.reg.read(self.dir)["agents"]["pod"]
        self.assertIn("endpoint", self.reg.AGENT_FIELDS)
        self.assertIn("endpoint", self.reg.CHANGE_FIELDS)
        changed = dict(row, endpoint="https://pod2.example/agent")
        self.assertTrue(self.reg.upsert(self.dir, "pod", changed)["changed"])   # written when only the endpoint changes
        self.reg.retire(self.dir, "pod", "boss", "done")
        self.assertEqual(self.reg.read(self.dir)["retired"]["pod"]["record"]["endpoint"], "https://pod2.example/agent")
        self.reg.unretire(self.dir, "pod")
        self.assertEqual(self.reg.read(self.dir)["agents"]["pod"]["endpoint"], "https://pod2.example/agent")

    def test_s4_every_row_field_is_in_all_three_projections_or_exempt(self):
        names = {"discovery": self.reg.AGENT_FIELDS, "change": self.reg.CHANGE_FIELDS, "record": self.reg.RECORD_FIELDS}
        for field in self.reg.ROW_FIELDS:
            for projection, fields in names.items():
                self.assertTrue((field in fields) != ((field, projection) in self.reg.EXEMPT), "%s / %s" % (field, projection))
        for (field, projection), why in self.reg.EXEMPT.items():
            self.assertIn(field, self.reg.ROW_FIELDS)
            self.assertIn(projection, self.reg.PROJECTIONS)
            self.assertTrue(why)
        self.assertEqual(set(sb.RETIRED_RECORD_FIELDS), set(self.reg.RECORD_FIELDS) - set(self.reg.OPTIONAL_FIELDS))
        saved = self.reg.ROW_FIELDS
        self.addCleanup(setattr, self.reg, "ROW_FIELDS", saved)
        self.reg.ROW_FIELDS = saved + ("added",)   # a field added to the row and to no table is in all three (derivation) unless exempt: derive again
        self.assertIn("added", self.reg.fields_of("record"))

    def test_s5_u5_a_no_pane_row_is_removed_only_on_a_dead_verdict_of_a_whole_read(self):
        self.both()
        def run(check, whole=True):
            read = self.reg.read(self.dir)
            read["whole"] = whole
            return self.mod.reconcile_on_read(self.dir, read, lambda n, a: {"pane": True, "process": True}, self.reg, check)
        self.assertEqual(run(None), [])                                   # default: unknown
        self.assertEqual(run(lambda n, a: "unknown"), [])
        self.assertEqual(run(lambda n, a: "unreachable"), [])
        self.assertEqual(run(lambda n, a: 1 / 0), [])                     # a failed check
        self.assertEqual(run(lambda n, a: "dead", whole=False), [])       # a partial read
        self.assertEqual([l for l in self.audit() if l.get("event") == "reconcile_remove"], [])
        self.assertEqual(run(lambda n, a: "dead"), ["pod"])
        self.assertEqual(len([l for l in self.audit() if l.get("event") == "reconcile_remove"]), 1)
        self.assertEqual(sorted(self.reg.read(self.dir)["agents"]), ["local"])

    def test_s6_route_function(self):
        self.both()
        agents = self.reg.read(self.dir)["agents"]
        self.assertEqual(self.reg.route_for(agents["pod"]), {"via": "endpoint", "to": self.CLOUD["endpoint"]})
        self.assertEqual(self.reg.route_for(agents["local"]), {"via": "pane", "to": "p_1"})

    def test_s6_registry_route_function_and_local_baseline(self):
        self.both()
        self.assertEqual(sb.registry_route(self.dir, "pod"), {"via": "endpoint", "to": self.CLOUD["endpoint"]})
        self.assertEqual(sb.registry_route(self.dir, "local"), {"via": "pane", "to": self.LOCAL["pane"]})   # the stored baseline: byte for byte
        self.assertEqual(json.dumps(sb.registry_route(self.dir, "local"), sort_keys=True), '{"to": "%s", "via": "pane"}' % self.LOCAL["pane"])
        self.assertIsNone(sb.registry_route(self.dir, "nobody"))

    def test_u1_local_agents_only_keep_the_baseline(self):
        self.reg.upsert(self.dir, "local", self.LOCAL)
        row = self.reg.read(self.dir)["agents"]["local"]
        self.assertFalse(self.reg.upsert(self.dir, "local", row)["changed"])   # change detection: no churn
        self.reg.retire(self.dir, "local", "boss", "done")
        record = self.reg.read(self.dir)["retired"]["local"]["record"]
        self.assertNotIn("endpoint", record)
        self.reg.unretire(self.dir, "local")
        back = self.reg.read(self.dir)["agents"]["local"]
        self.assertNotIn("endpoint", back)
        self.assertEqual(sb.registry_route(self.dir, "local"), {"via": "pane", "to": self.LOCAL["pane"]})

    def _gaps(self, change_fields):
        """The (field, projection) pairs where a field is neither in the projection nor exempt (the completeness rule)."""
        names = {"discovery": self.reg.AGENT_FIELDS, "change": change_fields, "record": self.reg.RECORD_FIELDS}
        return [(f, p) for f in self.reg.ROW_FIELDS for p, fs in names.items() if f not in fs and (f, p) not in self.reg.EXEMPT]

    def test_s7_mutants_each_fail(self):
        import unittest.mock as mock
        self.both()
        self.assertEqual(self._gaps(self.reg.CHANGE_FIELDS), [])
        # mutant 1: a projection (the change test) left out of the tuple's derivation drops the endpoint
        left_out = tuple(f for f in self.reg.CHANGE_FIELDS if f != "endpoint")
        self.assertEqual(self._gaps(left_out), [("endpoint", "change")])
        # mutant 2: a no-pane row read as dead is removed with no evidence: the real code keeps it
        self.assertEqual(self.mod.reconcile_on_read(self.dir, self.reg.read(self.dir), lambda n, a: {"pane": True, "process": True}, self.reg, None), [])
        # mutant 3: a route ignoring the endpoint returns None for the endpoint row: the route test names the endpoint
        with mock.patch.object(self.reg, "route_for", lambda row: {"via": "pane", "to": row.get("pane")} if row.get("pane") else None):
            self.assertNotEqual(sb.registry_route(self.dir, "pod"), {"via": "endpoint", "to": self.CLOUD["endpoint"]})
        with mock.patch.object(self.mod, "unknown_endpoint_check", lambda n, a: "dead"):   # the mutant removes the row the real default keeps
            self.assertEqual(self.mod.reconcile_on_read(self.dir, self.reg.read(self.dir), lambda n, a: {"pane": True, "process": True}, self.reg, None), ["pod"])

    def test_s8_the_docs_state_the_endpoint_the_liveness_rule_and_the_route_rule(self):
        text = (Path(__file__).resolve().parent.parent / "docs" / "agent-registry.md").read_text()
        self.assertEqual(text.count("## Additive note (#1074)"), 1)
        for item in ("**Endpoint field.**", "**Liveness rule.**", "**Route rule.**"):
            self.assertIn(item, text)

    def test_u2_a_credential_shaped_endpoint_is_refused(self):
        for bad in ("https://user:pw@pod.example/a", "https://pod.example/a?token=abc"):
            got = self.reg.upsert(self.dir, "pod", dict(self.CLOUD, endpoint=bad))
            self.assertTrue(got["problem"], bad)
        self.assertEqual(self.reg.read(self.dir)["agents"], {})

    def test_u3_a_row_without_an_endpoint_gains_no_key(self):
        self.reg.upsert(self.dir, "local", self.LOCAL)
        self.assertNotIn("endpoint", self.reg.read(self.dir)["agents"]["local"])
        self.assertEqual(self.reg.read(self.dir)["version"], 1)

    def test_u7_no_pane_is_bound_to_an_endpoint_row(self):
        self.both()
        got = self.reg.upsert(self.dir, "pod", dict(self.CLOUD, pane="p_9"))
        self.assertTrue(got["problem"])
        self.assertIsNone(self.reg.read(self.dir)["agents"]["pod"]["pane"])


class TestReconcileOnRead(unittest.TestCase):
    """Slice 4 of #903 (#919): reconcile on read, never a question mark, dead never drawn."""

    AGENTS = {
        "alpha": {"session": "ses_a", "pane": "p_1", "role": "coder", "state": "working", "kind": "local"},
        "ghost": {"session": "ses_g", "pane": "p_9", "role": "coder", "state": "dead", "kind": "local"},
        "bare": {"session": "ses_b", "pane": "p_2", "role": "coder", "state": None, "kind": "local"},
    }

    def setUp(self):
        self.mod = sb.load_module("agent_reconcile")
        self.dir = Path(tempfile.mkdtemp(prefix="recon"))
        self.addCleanup(shutil.rmtree, self.dir, True)

    def registry(self, whole=True):
        """The REAL registry module (slice 2) over a state directory holding the three agents; `whole=False` corrupts the file so the read is partial."""
        reg = sb.load_module("registry")
        for name, agent in self.AGENTS.items():
            reg.upsert(self.dir, name, agent)
        self.reg_state(reg)
        if not whole:
            (self.dir / "registry.json").write_text("{torn")
        return reg

    def reg_state(self, reg):
        path = self.dir / "registry.json"
        doc = json.loads(path.read_text())
        for name, agent in self.AGENTS.items():
            doc["agents"][name]["state"] = agent["state"]
        path.write_text(json.dumps(doc))

    def audit_lines(self):
        path = self.dir / "registry-audit.jsonl"
        return [json.loads(l) for l in path.read_text().splitlines()] if path.exists() else []

    @staticmethod
    def live(gone=("ghost",)):
        return lambda name, agent: {"pane": name not in gone, "process": name not in gone}

    def test_s3_a_whole_read_removes_the_dead_agent_once_with_one_audit_line(self):
        reg = self.registry()
        removed = self.mod.reconcile_on_read(self.dir, reg.read(self.dir), self.live(), reg)
        self.assertEqual(removed, ["ghost"])
        lines = [l for l in self.audit_lines() if l.get("event") == "reconcile_remove"]
        self.assertEqual(len(lines), 1)
        self.assertEqual(lines[0]["evidence"]["pane_listed"], False)
        self.assertEqual(sorted(reg.read(self.dir)["agents"]), ["alpha", "bare"])

    def test_s3_a_partial_read_removes_nothing_and_asks_the_registry_nothing(self):
        reg = self.registry(whole=False)
        removed = self.mod.reconcile_on_read(self.dir, reg.read(self.dir), self.live(), reg)
        self.assertEqual(removed, [])
        self.assertEqual([l for l in self.audit_lines() if l.get("event") == "reconcile_remove"], [])
        self.assertEqual((self.dir / "registry.json").read_text(), "{torn")   # untouched

    def test_s3_a_stub_that_ignores_the_whole_flag_is_caught(self):
        """The discriminator: with a read that is not whole, a view that acted anyway would remove 1 where 0 are expected."""
        reg = self.registry(whole=False)
        forged = dict(reg.read(self.dir), agents=dict(self.AGENTS))
        self.assertEqual(self.mod.reconcile_on_read(self.dir, forged, self.live(), reg), [])   # the flag is read from the read itself

    def test_s3_the_registry_refuses_a_live_agent_even_with_whole_true(self):
        reg = self.registry()
        result = reg.reconcile_remove(self.dir, "alpha", {"state": "working", "pane_listed": False, "process_found": False}, True)
        self.assertFalse(result["changed"])   # recorded `working`: refused whatever the caller says
        self.assertIn("alpha", reg.read(self.dir)["agents"])
        self.assertFalse(reg.reconcile_remove(self.dir, "ghost", {"pane_listed": False, "process_found": False}, False)["changed"])
        self.assertTrue(self.mod.reconcile_on_read(self.dir, reg.read(self.dir), lambda n, a: {"pane": True, "process": True}, reg) == [])

    def test_s3_an_unchecked_agent_is_not_removed(self):
        """herdr could not say (None): no evidence of death, so nothing is asked of the registry."""
        reg = self.registry()
        unknown = lambda name, agent: {"pane": None, "process": None}
        self.assertEqual(self.mod.reconcile_on_read(self.dir, reg.read(self.dir), unknown, reg), [])
        self.assertIn("ghost", reg.read(self.dir)["agents"])
        broken = lambda name, agent: 1 / 0
        self.assertEqual(self.mod.reconcile_on_read(self.dir, reg.read(self.dir), broken, reg), [])

    def test_s3_a_half_known_live_check_removes_nothing(self):
        reg = self.registry()
        for live in ({"pane": False, "process": None}, {"pane": True, "process": False}, {"pane": None, "process": False}):
            self.assertEqual(self.mod.reconcile_on_read(self.dir, reg.read(self.dir), lambda n, a, live=live: live, reg), [], live)
        self.assertIn("ghost", reg.read(self.dir)["agents"])

    def test_s3_reconcile_agents_on_read_removes_through_the_real_registry_with_herdr_gone_and_keeps_it_when_herdr_is_down(self):
        class Herdr:
            def __init__(self, down):
                self.down = down

            def pane_list(self):
                if self.down:
                    raise sb.HerdrError("unavailable", "cannot run herdr: pane p_9 not found")
                return [{"pane_id": "p_1"}, {"pane_id": "p_2"}]
        reg = self.registry()
        self.assertEqual(sb.reconcile_agents_on_read(self.dir, Herdr(True)), [])
        self.assertIn("ghost", reg.read(self.dir)["agents"])
        self.assertEqual(sb.reconcile_agents_on_read(self.dir, Herdr(False)), ["ghost"])
        self.assertEqual(sorted(reg.read(self.dir)["agents"]), ["alpha", "bare"])

    def test_s3_the_callers_own_guards_with_a_recording_registry(self):
        """The caller's guards, not the registry's backstop: a recording fake counts the calls, so a removed guard shows."""
        class Recording:
            def __init__(self):
                self.calls = []

            def reconcile_remove(self, state_dir, name, evidence, whole):
                self.calls.append((name, evidence, whole))
                return {"changed": True, "problem": None}
        dead = {"ghost": {"state": "dead", "pane": "p_9"}}
        whole = {"whole": True, "agents": dead}
        cases = {
            "not whole": ({"whole": False, "agents": dead}, {"pane": False, "process": False}, 0),
            "whole key missing": ({"agents": dead}, {"pane": False, "process": False}, 0),
            "pane unchecked": (whole, {"pane": None, "process": False}, 0),
            "process unchecked": (whole, {"pane": False, "process": None}, 0),
            "process present": (whole, {"pane": False, "process": True}, 0),
            "pane present": (whole, {"pane": True, "process": False}, 0),
            "both gone": (whole, {"pane": False, "process": False}, 1),
            "recorded live": ({"whole": True, "agents": {"ghost": {"state": "working"}}}, {"pane": False, "process": False}, 0),
        }
        for label, (read, live, count) in cases.items():
            with self.subTest(case=label):
                rec = Recording()
                self.mod.reconcile_on_read(self.dir, read, lambda n, a, live=live: live, rec)
                self.assertEqual(len(rec.calls), count)
                if count:
                    self.assertEqual(rec.calls[0][2], True)
                    self.assertEqual((rec.calls[0][1]["pane_listed"], rec.calls[0][1]["process_found"]), (False, False))

    def test_s3_herdr_live_check_gives_death_evidence_only_for_a_whole_list_that_lacks_the_exact_pane_id(self):
        class Herdr:
            def __init__(self, listing=None, error=None, procs=()):
                self.listing, self.error, self.procs = listing, error, procs

            def pane_list(self):
                if self.error:
                    raise sb.HerdrError(*self.error)
                return self.listing

            def pane_process_info(self, pane):
                return list(self.procs)
        agent = {"pane": "p_1"}
        gone, unknown = {"pane": False, "process": False}, {"pane": None, "process": None}
        cases = {
            "listed and present, process running": (Herdr([{"pane_id": "p_1"}], procs=[{"cmdline": "x"}]), {"pane": True, "process": True}),
            "listed and present, no process": (Herdr([{"pane_id": "p_1"}]), {"pane": True, "process": False}),
            "listed and absent": (Herdr([{"pane_id": "p_2"}, {"pane_id": "p_3"}]), gone),
            "empty list": (Herdr([]), gone),
            "a pane whose id contains this one": (Herdr([{"pane_id": "p_10"}, {"pane_id": "xp_1"}]), gone),
            "list errors with a socket path holding the id": (Herdr(error=("exit", "connect /tmp/p_1/herdr.sock: No such file or directory")), unknown),
            "list errors: pane p_1 not found": (Herdr(error=("exit", "pane p_1 not found")), unknown),
            "list errors: structured not found": (Herdr(error=("exit", json.dumps({"code": "pane_not_found", "message": "pane p_1 not found"}))), unknown),
            "list errors: unavailable": (Herdr(error=("unavailable", "cannot run herdr: No such file or directory")), unknown),
            "list errors: timeout": (Herdr(error=("timeout", "herdr did not answer within 5s")), unknown),
            "list errors: bad json": (Herdr(error=("bad_json", "herdr returned non-JSON")), unknown),
            "list errors: bad shape": (Herdr(error=("bad_shape", "expected result.panes in herdr's reply")), unknown),
            "list is not a list": (Herdr({"panes": []}), unknown),
            "an entry without a pane_id": (Herdr([{"pane_id": "p_2"}, {"id": "p_1"}]), unknown),
            "an entry with a non-string pane_id": (Herdr([{"pane_id": 1}]), unknown),
            "an entry that is not an object": (Herdr(["p_2"]), unknown),
        }
        for label, (herdr, expected) in cases.items():
            with self.subTest(case=label):
                self.assertEqual(sb.herdr_live_check(herdr)("a", agent), expected)
        self.assertEqual(sb.herdr_live_check(Herdr([]))("a", {}), gone)

    def test_s3_herdr_live_check_never_reads_error_text(self):
        """Derived from the code: the function holds no text matching on an error (no substring test, no regex over a message)."""
        import inspect
        source = inspect.getsource(sb.herdr_live_check)
        tree = ast.parse(source)
        self.assertEqual([n.attr for n in ast.walk(tree) if isinstance(n, ast.Attribute) and n.attr in ("detail", "reason", "args", "strerror")], [])
        self.assertEqual([n for n in ast.walk(tree) if isinstance(n, ast.Call) and getattr(n.func, "id", getattr(n.func, "attr", "")) in ("str", "search", "match", "lower")], [])
        self.assertEqual([n for n in ast.walk(tree) if isinstance(n, ast.Compare) and any(isinstance(o, ast.In) for o in n.ops)], [])
        self.assertNotIn("re.", source)

    def test_s7_only_a_view_reads_ever_calls_reconcile_remove(self):
        """Derived from the code: every call of `reconcile_remove` in the program, plugins and modules sits in agent_reconcile.py (the view's
        helper) or in registry.py (its definition); the daemon's passes and sweeps hold none, so no removal exists without a read."""
        allowed = {"agent_reconcile.py", "registry.py"}
        roots = [BIN, BIN.parent / "plugins"]
        hits = []
        for root in roots:
            for path in root.rglob("*"):
                if not path.is_file() or "node_modules" in path.parts or path.name.startswith("test-") or ".test." in path.name:
                    continue
                if path.suffix not in (".py", ".mjs", ".js", ".tsx") and path.name != "fleet-switchboard":
                    continue
                if "reconcile_remove(" in path.read_text(errors="replace") and path.name not in allowed:
                    hits.append(str(path.relative_to(BIN.parent)))
        self.assertEqual(hits, [])

    def views(self):
        """The text of the four Python views drawn over a state directory that holds a dead agent, a live one and one with no state row."""
        state = self.dir / "state"
        state.mkdir()
        panes = {"agents": {n: {"session": a["session"], "pane": a["pane"], "role": "coder", "workspace": "w1"} for n, a in self.AGENTS.items()},
                 "states": {"alpha": {"state": "attached"}, "ghost": {"state": "dead", "pane": "p_9", "at": 1}}, "missing": {}}
        (state / sb.PANE_HEALTH_FILE).write_text(json.dumps(panes))
        (state / "registry.json").write_text(json.dumps({"version": 1, "agents": self.AGENTS, "retired": {}}))
        load = {"latest": {"orch": {"open_asks": 1, "stalled": 0, "oldest_stall_hours": 0, "moved_1h": 0, "messages": 0, "decisions": 0, "busy": 1, "idle": 0}}, "alert": False}
        (state / "load.json").write_text(json.dumps(load))
        (state / "decisions.json").write_text(json.dumps({"decisions": [], "at": 0}))
        recorder = sb.load_module("health_records").Recorder(lambda: 1000)
        return {
            "status": "\n".join(sb.pane_health_status_lines(state, 1000)),
            "load line": "\n".join(sb.load_fleet_health().status_lines(state, 1000)),
            "decisions": "\n".join(sb.format_decisions_status(sb.decisions_summary(state, lambda: 1000))),
            "health records": json.dumps(recorder.body()),
        }

    def test_s4_no_python_view_prints_a_question_mark_for_an_agent_state(self):
        for view, text in self.views().items():
            with self.subTest(view=view):
                self.assertNotIn("?", text.replace("`", "").replace("%s " % sb.PROG, "") if view == "decisions" else text)

    def test_s10_no_python_view_draws_the_word_dead(self):
        for view, text in self.views().items():
            with self.subTest(view=view):
                self.assertNotIn("dead", text.lower())


class TestModuleLoader(Base):
    """Ask #437 slice 1: one generic loader behind the old `load_<module>()` names."""

    OLD = {
        "load_decision_core": "decision_core", "load_plan_check": "plan_check", "load_plan_ledger": "plan_ledger",
        "load_report_fold": "report_fold", "load_triage_plan_open": "triage_plan_open", "load_pr_events": "pr_events",
        "load_disk_janitor": "disk_janitor", "load_heavy_slots": "heavy_slots", "load_cpu_guard": "cpu_guard",
        "load_health_records": "health_records", "load_reds": "reds", "load_impact_floor": "impact_floor",
        "load_plan_review": "plan_review", "load_external_adapter": "external_adapter",
        "load_decision_sync": "decision_sync", "load_work_sync": "work_sync", "load_agent_calls": "agent_calls",
        "load_triage_digest": "triage_digest", "load_dead_hint": "dead_hint", "load_fleet_health": "fleet_health",
    }

    def _copy(self, extra=None):
        """A copy of the program in a temp bin directory, with the named modules beside it, loaded as a module."""
        tmp = Path(tempfile.mkdtemp(prefix="ldtest"))
        self.addCleanup(shutil.rmtree, tmp, True)
        held = dict(sys.modules)
        self.addCleanup(lambda: (sys.modules.clear(), sys.modules.update(held)))
        copy_entry(tmp)
        for module in BIN.glob("*.py"):
            shutil.copy(module, tmp / module.name)
        for name, text in (extra or {}).items():
            (tmp / (name + ".py")).write_text(text)
        return tmp, _load("ld_" + tmp.name, tmp / "fleet-switchboard")

    def test_s1_each_old_loader_loads_its_old_path_and_caches(self):
        self.assertEqual(len(self.OLD), 20)
        for fn, name in self.OLD.items():
            first = getattr(sb, fn)()
            self.assertEqual(os.path.realpath(first.__file__), os.path.realpath(str(BIN / (name + ".py"))), fn)
            self.assertIs(getattr(sb, fn)(), first, fn)

    def test_s2_a_missing_or_broken_module_fails_as_before(self):
        tmp, mod = self._copy({"broken_one": "def (:\n"})
        with self.assertRaises(FileNotFoundError):
            mod.load_module("absent_one")
        with self.assertRaises(SyntaxError):
            mod.load_module("broken_one")
        self.assertNotIn("broken_one", sys.modules)

    def test_s4_a_new_module_loads_with_no_edit_to_the_program(self):
        tmp, mod = self._copy({"fixture_mod": "VALUE = 7\n"})
        first = mod.load_module("fixture_mod")
        self.assertEqual(first.VALUE, 7)
        self.assertIs(mod.load_module("fixture_mod"), first)

    def test_s9_concurrent_first_loads_all_get_the_finished_module_and_a_failing_one_fails_for_every_thread(self):
        tmp, mod = self._copy({
            "slow_mod": "import time\ntime.sleep(0.3)\nREADY = True\n",
            "failing_mod": "import time\ntime.sleep(0.2)\nraise RuntimeError('boom')\n"})
        got, errors, barrier = [], [], threading.Barrier(8)

        def worker(name):
            barrier.wait()
            try:
                module = mod.load_module(name)
                got.append((module, getattr(module, "READY", False)))
            except RuntimeError as err:
                errors.append(str(err))
        threads = [threading.Thread(target=worker, args=("slow_mod",)) for _ in range(8)]
        for thread in threads:
            thread.start()
        for thread in threads:
            thread.join(20)
        self.assertEqual(len(got), 8)
        self.assertEqual(len({id(module) for module, _ in got}), 1, "one object for every thread")
        self.assertTrue(all(ready for _, ready in got), "no thread saw a half-loaded module")
        barrier, errors = threading.Barrier(8), []
        threads = [threading.Thread(target=worker, args=("failing_mod",)) for _ in range(8)]
        for thread in threads:
            thread.start()
        for thread in threads:
            thread.join(20)
        self.assertEqual(errors, ["boom"] * 8, "the failing module raises for every thread")
        self.assertNotIn("failing_mod", sys.modules)

    def test_s9b_a_slow_import_never_delays_another_module_and_a_module_may_load_another(self):
        tmp, mod = self._copy({
            "slow_one": "import threading\nthreading._ld_started.set()\nthreading._ld_gate.wait(20)\nREADY = True\n",
            "quick_one": "VALUE = 1\n", "fresh_one": "VALUE = 2\n",
            "b_mod": "VALUE = 'b'\n",
            "a_mod": "import threading\nB = threading._ld_load('b_mod')\n"})
        threading._ld_started, threading._ld_gate, threading._ld_load = threading.Event(), threading.Event(), mod.load_module
        self.addCleanup(lambda: [delattr(threading, n) for n in ("_ld_started", "_ld_gate", "_ld_load") if hasattr(threading, n)])
        self.addCleanup(threading._ld_gate.set)
        quick = mod.load_module("quick_one")
        slow = threading.Thread(target=lambda: mod.load_module("slow_one"))
        slow.start()
        self.assertTrue(threading._ld_started.wait(10))
        self.assertIs(mod.load_module("quick_one"), quick, "an already loaded module needs no lock")
        self.assertEqual(mod.load_module("fresh_one").VALUE, 2, "a first load of another module does not wait for the slow import")
        self.assertTrue(slow.is_alive(), "both returned while the slow import was still running")
        threading._ld_gate.set()
        slow.join(20)
        self.assertEqual(mod.load_module("a_mod").B.VALUE, "b", "a module that loads another while it runs")

    def test_s8_a_hostile_name_is_refused(self):
        tmp, mod = self._copy()
        (tmp.parent / "outside_mod.py").write_text("VALUE = 1\n")
        self.addCleanup((tmp.parent / "outside_mod.py").unlink)
        for name in ("../outside_mod", os.path.join(os.sep, "etc", "hosts"), "a/b", "", None):
            with self.assertRaises(ValueError, msg=repr(name)):
                mod.load_module(name)
        with self.assertRaises(FileNotFoundError):
            mod.load_module("no_such_module")
        self.assertNotIn("outside_mod", sys.modules)


class TestExcludedRepos(Base):
    """Ask #446: an excluded repository is never watched and never read; an agent working in it still sends and reports; an az key command names its subscription."""

    def rig(self, excluded, **kwargs):
        return FarmRig(self, config={"excluded_repos": excluded}, **kwargs)

    def test_s1_an_excluded_repo_named_by_an_agent_and_a_charter_is_never_watched_or_read(self):
        rig = self.rig(["ACME/Web"], baseline=[ACME_API], agents={
            "web-orch": {"role": "orchestrator", "charter": 1, "repo": ACME_WEB},
            "web-coder": {"role": "worker", "repo": "acme/WEB"}})
        rig.pump(20)
        self.assertEqual(sorted(rig.hub.watches), [ACME_API], "no watch, so no forwarder")
        self.assertIsNone(rig.repo(ACME_WEB).forwarder())
        fleets = {"web-orch": {"role": "orchestrator", "charter": 1, "repo": ACME_WEB}}
        self.assertEqual(sb.watched_repos(rig.world.config, fleets), [ACME_API], "the one derivation every consumer (sweep, triage, the hub) uses")
        self.assertEqual(rig.world.engine.repos_in_play(), [ACME_API])
        calls = []
        reader = sb.IntentReader(GH_BIN, ACME_API, lambda argv, **kw: calls.append(argv) or subprocess.CompletedProcess(argv, 0, "{}", ""))
        reader.config = rig.world.config
        with self.assertRaises(sb.IntentError) as caught:
            reader.issue(5, ACME_WEB)
        self.assertEqual(caught.exception.reason, "excluded")
        self.assertEqual(calls, [], "the intent reader made no call for it")

    def test_s2_status_lists_it_once_as_excluded_and_never_as_failing(self):
        config = sb.validate_config({"github_repos": [ACME_API], "excluded_repos": [ACME_WEB]})
        lines = sb.format_github(sb.github_status(config, self.home, {"w": {"role": "worker", "repo": ACME_WEB}}))
        excluded = [line for line in lines if "excluded" in line]
        self.assertEqual(len(excluded), 1, lines)
        self.assertIn(ACME_WEB, excluded[0])
        self.assertEqual(len(lines), len([line for line in lines if "excluded" in line or ACME_API in line or "daemon not running" in line]), "no line but the excluded one, the watch and the daemon note")
        only = sb.validate_config({"excluded_repos": [ACME_WEB]})
        self.assertEqual(len(sb.format_github(sb.github_status(only, self.home))), 1, "even with nothing else watched it is said once")

    def test_s3_and_s7_a_worker_in_an_excluded_repo_still_sends_and_is_answered(self):
        rig = self.rig([ACME_WEB], agents={"web-coder": {"role": "worker", "repo": ACME_WEB, "boss": "cos"},
                                           "cos": {"role": "chief-of-staff"}})
        rig.pump(10)
        out = rig.world.engine.send("web-coder", "cos", "a question for you")
        out2 = rig.world.engine.send("cos", "web-coder", "the answer")
        self.assertEqual((out["sent"], out["action"]), (True, "wake"), out)
        self.assertEqual((out2["sent"], out2["action"]), (True, "wake"), out2)
        self.assertEqual(sorted(rig.hub.watches), [], "and the repository is still not watched")

    def test_s4_a_bad_list_is_refused_naming_the_key_and_a_cased_entry_excludes(self):
        for bad in (["not a repo"], "acme/web", ["acme/web", "ACME/web"], [5]):
            with self.assertRaises(sb.ConfigError) as caught:
                sb.validate_config({"excluded_repos": bad})
            self.assertIn("excluded_repos", str(caught.exception))
        config = sb.validate_config({"github_repos": ["acme/web"], "excluded_repos": ["ACME/Web"]})
        self.assertEqual(sb.watched_repos(config, {}), [])
        with self.assertRaises(sb.ConfigError):
            sb.validate_config({"excluded_repos": ["acme/web\n"]})   # a trailing newline is not a repository name
        both = sb.validate_config({"excluded_repos": ["acme/web"], "spotlight_guard": False})
        self.assertEqual((both["excluded_repos"], both["spotlight_guard"]), (["acme/web"], False), "both opt-in keys are known together")

    def write_mapping(self, key_source):
        path = self.home / "mapping.json"
        path.write_text(json.dumps({"base_url": "https://example.invalid", "key_source": key_source}))
        return str(path)

    def load_with(self, mapping):
        sb._WARNED_CONFIG.clear()
        out = io.StringIO()
        raw = {"external_decisions": {"enabled": True, "adapter": "mcp_rest", "mapping_file": mapping, "tier_map": {t: "x" for t in ("orchestrator", "cos", "human")},
                                      "repos": [ACME_API]}}
        with contextlib.redirect_stderr(out):
            sb.validate_config(raw, "config")
        return out.getvalue()

    def test_s5_an_az_key_command_without_a_subscription_warns_once_and_with_one_does_not(self):
        bare = self.write_mapping({"command": ["az", "keyvault", "secret", "show", "--vault-name", "vault-xyz", "--name", "secret-abc", "--query", "value", "-o", "tsv"]})
        text = self.load_with(bare)
        self.assertEqual(text.count("warning"), 1, text)
        self.assertIn("--subscription", text)
        self.assertIn("external_decisions", text)
        out = io.StringIO()
        with contextlib.redirect_stderr(out):   # a second load in the same process says nothing more
            sb.validate_config({"external_decisions": {"enabled": True, "adapter": "mcp_rest", "mapping_file": bare, "tier_map": {t: "x" for t in ("orchestrator", "cos", "human")}, "repos": [ACME_API]}}, "config")
        self.assertEqual(out.getvalue(), "")
        named = self.write_mapping({"command": ["az", "keyvault", "secret", "show", "--subscription", "00000000-0000", "--name", "n"]})
        self.assertEqual(self.load_with(named), "")
        other = self.write_mapping({"command": ["vault-tool", "get", "x"]})
        self.assertEqual(self.load_with(other), "")

    def test_the_az_check_reads_both_key_source_forms_a_rotation_and_never_raises(self):
        mod = sb.load_module("repo_exclusion")
        bare = ["az", "keyvault", "secret", "show"]
        for source, expected in (
                ({"command": bare}, True), ("command:" + json.dumps(bare), True), ([{"command": ["vault-tool"]}, {"command": bare}], True),
                ({"command": bare + ["--subscription=abc"]}, False), ({"command": bare + ["-s", "abc"]}, False),
                ("command:" + json.dumps(bare + ["--subscription", "abc"]), False), ("env:KEY", False), ("command:[not json", False), (None, False)):
            self.assertEqual(mod.az_without_subscription(self.write_mapping(source)), expected, source)
        self.assertFalse(mod.az_without_subscription(str(self.home / "no-such-file.json")))
        (self.home / "bad.json").write_text("{not json")
        self.assertFalse(mod.az_without_subscription(str(self.home / "bad.json")))

    def test_a_reader_built_with_accounts_only_still_refuses_an_excluded_repo(self):
        calls = []
        config = sb.validate_config({"excluded_repos": [ACME_WEB]})
        runner = lambda argv, **kw: calls.append(argv) or subprocess.CompletedProcess(argv, 0, "{}", "")
        reader = sb.IntentReader(GH_BIN, ACME_API, runner, accounts=sb.GhAccounts(config, runner, time.time))
        with self.assertRaises(sb.IntentError) as caught:
            reader.issue(5, ACME_WEB)
        self.assertEqual(caught.exception.reason, "excluded")
        self.assertEqual(calls, [])

    def test_the_choke_point_no_gh_read_spawns_a_process_for_an_excluded_repo_and_other_repos_still_read(self):
        rig = self.rig([ACME_WEB], baseline=[ACME_API])
        calls = []

        def counting(argv, **kwargs):
            calls.append(list(argv))
            return subprocess.CompletedProcess(argv, 0, json.dumps({"state": "OPEN", "number": 5}), "")
        engine, hub, config = rig.world.engine, rig.hub, rig.world.config
        engine.gh_runner = counting
        hub.runner = counting
        accounts = sb.GhAccounts(config, counting, time.time)
        hub.accounts = accounts
        reader = sb.IntentReader(GH_BIN, ACME_API, counting, accounts=accounts)
        for name, call in (
                ("GhAccounts.read", lambda: accounts.read(counting, "repos/%s/issues/5" % ACME_WEB, ACME_WEB, 5)),
                ("GhAccounts.read, other case", lambda: accounts.read(counting, "repos/ACME/WEB/issues/5", "ACME/WEB", 5)),
                ("read_pr_json", lambda: sb.read_pr_json(engine, ACME_WEB, 5)),
                ("read_ref_state issue", lambda: sb.read_ref_state(engine, ACME_WEB, 5, "issue")),
                ("read_ref_state pr", lambda: sb.read_ref_state(engine, ACME_WEB, 5, "pr")),
                ("the hub's gh_api", lambda: hub.gh_api("repos/%s/issues/5/comments" % ACME_WEB)),
                ("the intent reader", lambda: reader.issue(5, ACME_WEB)),
                ("the hub's child environment (the forwarder start)", lambda: hub.child_env(ACME_WEB)),
                ("the reds zip read", lambda: sb._RedsReader(config, counting, time.time, ACME_WEB).zip("repos/%s/actions/artifacts/1/zip" % ACME_WEB)),
                ("the check review measure and reds make (the same function)", lambda: sb.refuse_excluded(config, ACME_WEB))):
            with self.assertRaises((sb.RepoExcluded, sb.NoticeError, sb.GitHubUnavailable, sb.IntentError), msg=name):
                call()
            self.assertEqual(calls, [], "%s started a process for an excluded repository" % name)
        # U1: a repository that is not excluded still reads, through every one of them
        self.assertEqual(sb.read_ref_state(engine, ACME_API, 5, "issue"), "open")
        self.assertEqual(sb.read_pr_json(engine, ACME_API, 5)["number"], 5)
        self.assertEqual(accounts.read(counting, "repos/%s/issues/5" % ACME_API, ACME_API, 5).returncode, 0)
        hub.gh_api("repos/%s/issues/5/comments" % ACME_API)
        self.assertEqual(len(calls), 4, calls)   # (the 4 reads above; the excluded ones started none)

    def test_the_hub_child_environment_takes_the_config_from_its_accounts_and_no_config_at_all_allows(self):
        config = sb.validate_config({"excluded_repos": [ACME_WEB]})
        accounts = sb.GhAccounts(config, lambda *a, **k: None, time.time)
        with self.assertRaises(sb.GitHubUnavailable):
            sb.GitHubHub.child_env(types.SimpleNamespace(accounts=accounts), ACME_WEB)
        other = types.SimpleNamespace(accounts=types.SimpleNamespace(env_for=lambda repo: None))
        self.assertIsNone(sb.GitHubHub.child_env(other, ACME_WEB), "no config anywhere: the check is skipped, on purpose")
        self.assertIsNone(sb.refuse_excluded(None, ACME_WEB))

    def test_the_intent_repo_itself_being_excluded_is_not_read_either(self):
        calls = []
        reader = sb.IntentReader(GH_BIN, ACME_WEB, lambda argv, **kw: calls.append(argv) or subprocess.CompletedProcess(argv, 0, "{}", ""))
        reader.config = sb.validate_config({"excluded_repos": [ACME_WEB]})
        with self.assertRaises(sb.IntentError):
            reader.issue(5)
        self.assertEqual(calls, [])

    def test_s6_the_warning_never_prints_the_commands_other_arguments(self):
        text = self.load_with(self.write_mapping({"command": ["az", "keyvault", "secret", "show", "--vault-name", "vault-xyz", "--name", "secret-abc"]}))
        self.assertTrue(text)
        for private in ("vault-xyz", "secret-abc", "keyvault", "--vault-name"):
            self.assertNotIn(private, text)


class TestDecisionsStaleBound(unittest.TestCase):
    """Work item #449: the staleness bound of the decisions list is 180 s on both sides, and the docs say so."""

    def test_s1_the_daemon_and_plugin_bounds_are_180_seconds(self):
        self.assertEqual(sb.DECISIONS_STALE_SECONDS, 180)
        self.assertIn("export const STALE_MS = 180_000", (DECISIONS_PLUGIN / "decisions.mjs").read_text())
        self.assertIn("export const DECISIONS_STALE_MS = 180_000", (DECISIONS_PLUGIN / "health.mjs").read_text(), "the health view's copy of the bound")

    def test_s3_the_docs_no_longer_say_120_s_for_the_decisions_staleness(self):
        self.assertNotIn("older than 120 s", (DECISIONS_PLUGIN / "README.md").read_text())
        lines = (REPO / "docs" / "switchboard.md").read_text().splitlines()
        stale = [line for line in lines if "120 s" in line and ("stale" in line or "Staleness" in line or "not updating" in line or "older than" in line)]
        self.assertEqual(stale, [])
        self.assertGreaterEqual(len([line for line in lines if "180 s" in line and ("stale" in line or "Staleness" in line or "not updating" in line or "older than" in line)]), 4)


class TestAuthorityModulesGuard(unittest.TestCase):
    """Ask #532, slice 1: the code that decides who may clear, hold or merge lives in modules the owner-hold rule lists, and a module that does and is neither listed nor
    exempted BY NAME fails this guard. The vocabulary, the listing and the exemptions are all DATA in the matrix file; this test has no module name of its own."""

    def setUp(self):
        self.floor = sb.load_module("impact_floor")
        self.matrix = self.floor.load_matrix()
        self.block = self.matrix["owner_hold"]

    @staticmethod
    def authority_functions(directory, vocabulary):
        """{module path relative to the repository (bin/NAME.py): [function names]} for every module of `directory` that defines a function whose name has a word of the vocabulary."""
        import ast
        words, found = set(vocabulary), {}
        for path in sorted(Path(directory).glob("*.py")):
            tree = ast.parse(path.read_text())
            names = sorted({n.name for n in ast.walk(tree) if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef)) and words & set(n.name.strip("_").split("_"))})
            if names:
                found["bin/" + path.name] = names
        return found

    @staticmethod
    def role_checks(directory, literals):
        """{module path (bin/NAME.py): [the literal compared]} for every module of `directory` with a COMPARISON (==, !=, in, not in) against one of the role literals (the code, not a docstring):
        the second rule, independent of function names."""
        import ast
        wanted, found = set(literals), {}

        def strings(node):
            if isinstance(node, ast.Constant) and isinstance(node.value, str):
                yield node.value
            elif isinstance(node, (ast.Tuple, ast.List, ast.Set)):
                for item in node.elts:
                    yield from strings(item)
        for path in sorted(Path(directory).glob("*.py")):
            hits = set()
            for node in ast.walk(ast.parse(path.read_text())):
                if isinstance(node, ast.Compare):
                    for side in [node.left] + list(node.comparators):
                        hits |= wanted & set(strings(side))
            if hits:
                found["bin/" + path.name] = sorted(hits)
        return found

    def unlisted(self, directory, block=None):
        """The modules of `directory` that, by a function name with a word of the vocabulary OR by a comparison against a role literal, decide who may act, and are in no top tier path (as a
        path or a glob) and in no exemption."""
        block = block or self.block
        listed = {g for globs in block["top_tier_paths"].values() for g in globs}
        exempt = set(block["authority_modules"]["exempt"])
        found = set(self.authority_functions(directory, block["authority_modules"]["vocabulary"])) | set(self.role_checks(directory, block["authority_modules"]["role_literals"]))
        return sorted(m for m in found if not self.floor.matches(m, sorted(listed)) and m not in exempt)

    def test_s1_the_named_modules_are_top_tier_paths_and_every_one_is_also_in_the_floor(self):
        globs, exclude, force = self.floor.floor_for("adamkaplan/fleet-kit")
        named = [g for g in self.block["top_tier_paths"]["authority"] if g.startswith("bin/") and g.endswith(".py")]
        self.assertTrue(len(named) >= 7, "the matrix lists the authority modules of bin/")
        for module in named:
            self.assertIn(module, self.floor.top_tier_hits([module], self.matrix).get("authority", []), module + " is a top tier path")
            self.assertTrue(self.floor.floor_paths([module], globs, exclude, force), module + " is in the floor")
            self.assertEqual(self.floor.owner_decide(self.matrix, [module], [], None, self.floor.floor_paths([module], globs, exclude, force))[0], "hold", module)

    def test_the_real_bin_directory_has_no_unlisted_unexempted_authority_module(self):
        self.assertEqual(self.unlisted(BIN), [], "a module with authority code is neither a top tier path nor exempted by name in the matrix")

    def test_s2_a_new_module_with_a_clear_decision_that_is_not_listed_fails_and_is_named(self):
        with tempfile.TemporaryDirectory() as tmp:
            (Path(tmp) / "new_gate.py").write_text("def may_clear_hold(pr):\n    return True\n")
            (Path(tmp) / "harmless.py").write_text("def format_line(x):\n    return x\n")
            self.assertEqual(self.unlisted(tmp), ["bin/new_gate.py"])
            exempted = json.loads(json.dumps(self.block))
            exempted["authority_modules"]["exempt"]["bin/new_gate.py"] = "a reason"
            self.assertEqual(self.unlisted(tmp, exempted), [], "exempted by name")
            listed = json.loads(json.dumps(self.block))
            listed["top_tier_paths"]["authority"].append("bin/new_gate.py")
            self.assertEqual(self.unlisted(tmp, listed), [], "listed")

    def test_a_renamed_function_cannot_hide_a_role_check_and_a_docstring_or_an_assignment_is_not_one(self):
        with tempfile.TemporaryDirectory() as tmp:
            (Path(tmp) / "quiet_name.py").write_text('def run(kind):\n    return kind[1] == "chief-of-staff"\n')
            (Path(tmp) / "tuple_form.py").write_text('def run(role):\n    return role in ("orchestrator", "x")\n')
            (Path(tmp) / "not_a_check.py").write_text('"""the chief-of-staff and the operator"""\nNAME = "chief-of-staff"\ndef run(x):\n    return {"role": "operator"}\n')
            self.assertEqual(self.unlisted(tmp), ["bin/quiet_name.py", "bin/tuple_form.py"])
            exempted = json.loads(json.dumps(self.block))
            exempted["authority_modules"]["exempt"].update({"bin/quiet_name.py": "a reason", "bin/tuple_form.py": "a reason"})
            self.assertEqual(self.unlisted(tmp, exempted), [])
            wider = json.loads(json.dumps(self.block))
            wider["authority_modules"]["role_literals"].append("x")
            self.assertEqual(self.unlisted(tmp, wider), ["bin/quiet_name.py", "bin/tuple_form.py"])

    def test_a_caller_check_name_is_in_the_vocabulary_and_the_modules_that_gate_a_caller_are_listed(self):
        words = set(self.block["authority_modules"]["vocabulary"])
        self.assertTrue({"caller", "refuse", "refusal", "role", "chief", "operator"} <= words)
        found = set(self.authority_functions(BIN, sorted(words))) | set(self.role_checks(BIN, self.block["authority_modules"]["role_literals"]))
        listed = {g for globs in self.block["top_tier_paths"].values() for g in globs}
        self.assertTrue(found, "the guard finds the authority modules of bin/")
        for module in found:
            self.assertTrue(module in listed or module in self.block["authority_modules"]["exempt"], module)
        self.assertGreaterEqual(len(found & listed), 10, "the modules the guard finds that are listed")

    def test_every_exemption_carries_a_trace_of_where_its_values_go_and_the_limits_are_stated(self):
        exempt = self.block["authority_modules"]["exempt"]
        self.assertTrue(exempt)
        for module, reason in exempt.items():
            self.assertIn("Trace:", reason, module + ": an exemption says where its values go (no value of it feeds an authority function)")
        limits = self.block["authority_modules"]["limits"]
        self.assertTrue(isinstance(limits, list) and len(limits) >= 3 and all(isinstance(x, str) and len(x) > 40 for x in limits))
        self.assertIn("cannot see", " ".join(limits))

    def test_the_external_adapter_that_feeds_answered_by_is_listed_not_exempted(self):
        listed = {g for globs in self.block["top_tier_paths"].values() for g in globs}
        self.assertNotIn("bin/external_adapter.py", self.block["authority_modules"]["exempt"])
        self.assertIn("bin/external_adapter.py", listed)

    def test_every_exemption_names_a_real_module_with_a_reason_and_is_not_also_listed(self):
        listed = {g for globs in self.block["top_tier_paths"].values() for g in globs}
        for module, reason in self.block["authority_modules"]["exempt"].items():
            self.assertTrue((BIN.parent / module).is_file(), module + " does not exist")
            self.assertTrue(isinstance(reason, str) and len(reason) >= 20, module + " needs a reason")
            self.assertNotIn(module, listed, module + " is both exempted and listed")

    def test_s3_the_code_names_no_module_of_the_rule_the_matrix_file_does(self):
        modules = [g for g in self.block["top_tier_paths"]["authority"] if g.startswith("bin/") and g.endswith(".py")] + list(self.block["authority_modules"]["exempt"])
        self.assertTrue(len(modules) >= 12)
        for code in [BIN / "fleet-switchboard"] + sorted(BIN.glob("*.py")):   # the code; the tests (this file) name modules as fixtures
            text = code.read_text()
            for module in modules:
                self.assertNotIn('"%s"' % module, text, "%s writes the path %s in code" % (code.name, module))

    def test_the_vocabulary_is_a_usable_list_of_words(self):
        words = self.block["authority_modules"]["vocabulary"]
        self.assertTrue(words and all(isinstance(w, str) and re.fullmatch(r"[a-z]+", w) for w in words))


class TestWhoCanClear(unittest.TestCase):
    """#946: `who_can_clear`, the ONE answer to "who can clear this held pull request", over every outcome of the clear's own rule. Pure: plain dicts in, a plain dict out. Every set (the machinery globs, the
    new-file globs, the closure files, the floor classes, the never-delegated classes) is read from the matrix file, never listed here; each member is a subTest, and each has a mutant (the member removed from the rule) that must change its row."""

    H = "a" * 40
    # the refusal strings of the clear for 9 rows, stored from the code as it was before #946 moved the rule into `refusal_items` (each row: [no max_level, a max_level whose score says High])
    STORED_REFUSALS = json.loads("""{
 "closure": [
  [
   "it changes build_parser, part of the clear (head file)"
  ],
  [
   "it changes build_parser, part of the clear (head file)",
   "the score is High: High is the owner's"
  ]
 ],
 "floor-authority": [
  [],
  [
   "the score is High: High is the owner's"
  ]
 ],
 "floor-credentials": [
  [
   "it changes a credentials path (cloud/launcher/token_mint.py): that stays the owner's own clear"
  ],
  [
   "the score is High: High is the owner's"
  ]
 ],
 "floor-identity": [
  [
   "it changes a identity path (bin/switchboard-trial): that stays the owner's own clear"
  ],
  [
   "the score is High: High is the owner's"
  ]
 ],
 "machinery": [
  [
   "it changes a file that is the clear or hold machinery or that the daemon loads (bin/impact_hold.py): that stays the owner's own clear"
  ],
  [
   "it changes a file that is the clear or hold machinery or that the daemon loads (bin/impact_hold.py): that stays the owner's own clear",
   "the score is High: High is the owner's"
  ]
 ],
 "new-file": [
  [
   "it adds, deletes or renames a file under a directory the daemon loads at start (bin/new_tool.py): that stays the owner's own clear"
  ],
  [
   "it adds, deletes or renames a file under a directory the daemon loads at start (bin/new_tool.py): that stays the owner's own clear",
   "the score is High: High is the owner's"
  ]
 ],
 "no-hold": [
  [],
  [
   "the score is High: High is the owner's"
  ]
 ],
 "plain": [
  [],
  [
   "the score is High: High is the owner's"
  ]
 ],
 "unreadable": [
  [
   "the changed files cannot be read, so a change to the clear code cannot be ruled out"
  ],
  [
   "the score is High: High is the owner's",
   "the changed files cannot be read, so a change to the clear code cannot be ruled out"
  ]
 ]
}""")

    def setUp(self):
        self.floor = sb.load_module("impact_floor")
        self.module = sb.load_module("delegated_clear")
        self.matrix = self.floor.load_matrix()
        self.rule = self.matrix["owner_hold"]["delegated_clear"]
        self.block = self.rule["score"]
        self.on = {"threshold": "Serious"}

    def report(self, decision="hold", hits=None, paths=()):
        return {"pr": "acme/app#9", "head": self.H, "owner_decision": decision, "complete": True, "unknown": None, "renamed_no_source": [], "top_tier_hits": hits or {}, "changed_paths": list(paths),
                "review_action": "none", "review_class": None}

    @staticmethod
    def file(name, status="modified", previous=None):
        return dict({"filename": name, "status": status, "sha": "e" * 40, "patch": "@@ -1 +1 @@\n-a\n+b"}, **({"previous_filename": previous} if previous else {}))

    @staticmethod
    def concrete(glob):
        return glob[:-3] + "/probe.py" if glob.endswith("/**") else glob.replace("**", "probe.py").replace("*", "probe")

    def who(self, report, files, closure=None, delegation="on", rule=None, block="shipped"):
        delegation = self.on if delegation == "on" else delegation
        return self.module.who_can_clear(rule or self.rule, report, files, self.floor.matches, closure or {}, self.block if block == "shipped" else block, delegation, pr="acme/app#9")

    def expect(self, **over):
        base = {"pr": "acme/app#9", "head": self.H, "hold": True, "floor_ids": [], "owner_only": [], "min_rating": None, "must_name": [], "who": "owner or chief of staff", "unreadable": None,
                "delegation": "on", "threshold": "Serious", "needs": []}
        return dict(base, **over)

    def rows(self):
        """The 9 rows of S2: name, report, files, closure, expected."""
        credentials = next(p for p in self.matrix["owner_hold"]["top_tier_paths"]["credentials"] if not self.floor.matches(p, self.rule["clear_code_paths"]) and "*" not in p)
        identity = next(p for p in self.matrix["owner_hold"]["top_tier_paths"]["identity"] if not self.floor.matches(p, self.rule["clear_code_paths"]) and "*" not in p)
        floor_rows = []
        for cls, path in (("credentials", credentials), ("identity", identity), ("authority", "migrations/0002.sql")):
            rid = next(r for r, c in self.block["floor"]["rules"].items() if c == cls)
            floor_rows.append(("floor-" + cls, self.report(hits={cls: [path]}, paths=[path]), [self.file(path)], {},
                               self.expect(floor_ids=[rid], must_name=[rid], min_rating=self.block["floor"]["lowest_level"], who="chief of staff with a rating")))
        return [
            ("closure", self.report(paths=["bin/fleet-switchboard"]), [self.file("bin/fleet-switchboard")], {"bin/fleet-switchboard": ["it changes build_parser, part of the clear (head file)"]},
             self.expect(who="owner only", owner_only=[{"kind": "closure", "why": "changes a definition reachable from the clear (bin/fleet-switchboard)"}])),
            ("new-file", self.report(paths=["bin/new_tool.py"]), [self.file("bin/new_tool.py", "added")], {},
             self.expect(who="owner only", owner_only=[{"kind": "new-file", "why": "adds a file under a directory the daemon loads at start (bin/new_tool.py)"}])),
            ("machinery", self.report(paths=["bin/impact_hold.py"]), [self.file("bin/impact_hold.py")], {},
             self.expect(who="owner only", owner_only=[{"kind": "machinery", "why": "changes the clear or hold machinery (bin/impact_hold.py)"}])),
        ] + floor_rows + [
            ("no-hold", self.report(decision="none", paths=["docs/x.md"]), [self.file("docs/x.md")], {}, self.expect(hold=False, who="no hold")),
            ("unreadable", self.report(paths=["src/app.py"]), None, {},
             self.expect(who="unknown", unreadable=self.module.UNREAD, owner_only=[{"kind": "unreadable", "why": "the changed files cannot be read"}])),
            ("plain", self.report(paths=["src/app.py"]), [self.file("src/app.py")], {}, self.expect()),
        ]

    def test_s2_the_table_has_9_rows_and_every_row_returns_its_exact_structure(self):
        rows = self.rows()
        self.assertEqual(len(rows), 9)
        for name, report, files, closure, expected in rows:
            with self.subTest(row=name):
                self.assertEqual(self.who(report, files, closure), expected)
        self.assertEqual([r[4]["floor_ids"] for r in rows if r[0].startswith("floor-")], [["floor-credentials"], ["floor-identity"], ["floor-authority"]])
        self.assertEqual({k for r in rows for o in r[4]["owner_only"] for k in [o["kind"]]}, {"closure", "new-file", "machinery", "unreadable"})

    def test_s2_a_build_that_answers_the_same_for_every_pull_request_fails_the_rows(self):
        same = self.who(self.report(paths=["src/app.py"]), [self.file("src/app.py")])
        failed = [name for name, report, files, closure, expected in self.rows() if same != expected]
        self.assertEqual(sorted(failed), sorted(n for n, *_ in self.rows() if n != "plain"))

    def test_every_who_value_is_reachable_and_the_values_are_one_table(self):
        seen = {r[4]["who"] for r in self.rows()}
        seen.add(self.who(self.report(paths=["src/app.py"]), [self.file("src/app.py")], delegation=None)["who"])
        self.assertEqual(seen, set(self.module.WHO))
        self.assertEqual(self.who(self.report(paths=["src/app.py"]), [self.file("src/app.py")], delegation=None)["delegation"], "off")

    def test_every_kind_the_rule_can_refuse_for_is_in_the_one_table(self):
        import ast
        tree = ast.parse(Path(self.module.__file__).read_text())
        kinds = {c.args[0].value for c in ast.walk(tree) if isinstance(c, ast.Call) and getattr(c.func, "id", "") == "_item" and c.args and isinstance(c.args[0], ast.Constant)}
        self.assertEqual(kinds, set(self.module._OWNER_WORDS) | {"unreadable", "rating", "review"}, "a kind the rule can give that the line has no words for (or the reverse)")

    def test_every_machinery_path_is_owner_only_with_its_own_reason_and_removing_it_from_the_rule_changes_the_row(self):
        for glob in self.rule["clear_code_paths"]:
            with self.subTest(glob=glob):
                path = self.concrete(glob)
                self.assertTrue(self.floor.matches(path, [glob]))
                got = self.who(self.report(paths=[path]), [self.file(path)])
                self.assertEqual((got["who"], [o["kind"] for o in got["owner_only"]]), ("owner only", ["machinery"]))
                self.assertIn("machinery", got["owner_only"][0]["why"])
                mutant = dict(self.rule, clear_code_paths=[g for g in self.rule["clear_code_paths"] if g != glob])
                if not self.floor.matches(path, mutant["clear_code_paths"]) and not self.floor.matches(path, self.rule["new_file_globs"]):
                    self.assertNotEqual(self.who(self.report(paths=[path]), [self.file(path)], rule=mutant)["who"], "owner only")

    def test_every_new_file_glob_and_every_status_is_owner_only_and_a_plain_edit_is_not(self):
        verbs = {"added": "adds a file", "removed": "deletes a file", "renamed": "renames a file"}
        for glob in self.rule["new_file_globs"]:
            path = self.concrete(glob)
            for status, verb in verbs.items():
                with self.subTest(glob=glob, status=status):
                    got = self.who(self.report(paths=[path]), [self.file(path, status)])
                    self.assertEqual([(o["kind"], verb in o["why"]) for o in got["owner_only"]], [("new-file", True)])
                    mutant = dict(self.rule, new_file_globs=[g for g in self.rule["new_file_globs"] if g != glob])
                    self.assertEqual(self.who(self.report(paths=[path]), [self.file(path, status)], rule=mutant)["owner_only"], [])
            self.assertEqual(self.who(self.report(paths=[path]), [self.file(path, "modified")])["owner_only"], [], "an edit of an existing file is not a new file")

    def test_every_closure_file_is_owner_only_for_a_mapped_change_unreadable_when_unmapped_and_free_when_nothing_is_reached(self):
        for path in self.rule["closure_files"]:
            if self.floor.matches(path, self.rule["clear_code_paths"]):
                continue
            with self.subTest(path=path):
                report, files = self.report(paths=[path]), [self.file(path)]
                self.assertEqual([o["kind"] for o in self.who(report, files, {path: ["it changes f, part of the clear (head file)"]})["owner_only"]], ["closure"])
                self.assertEqual(self.who(report, files, {path: ["it changes f"]})["owner_only"][0]["why"], "changes a definition reachable from the clear (%s)" % path)
                self.assertEqual(self.who(report, files, {path: None})["who"], "unknown")
                self.assertEqual(self.who(report, files, {path: []})["who"], "owner or chief of staff")
                mutant = dict(self.rule, closure_files=[g for g in self.rule["closure_files"] if g != path])
                self.assertEqual(self.who(report, files, {path: None}, rule=mutant)["who"], "owner or chief of staff", "a path the rule does not judge is not mapped")

    def test_every_floor_class_gives_its_rule_id_and_the_lowest_rating_and_the_never_delegated_ones_are_owner_only_without_a_max_level(self):
        for rid, cls in self.block["floor"]["rules"].items():
            with self.subTest(rule=rid):
                report, files = self.report(hits={cls: ["x/p.py"]}, paths=["x/p.py"]), [self.file("x/p.py")]
                got = self.who(report, files)
                self.assertEqual((got["floor_ids"], got["must_name"], got["min_rating"], got["who"]), ([rid], [rid], self.block["floor"]["lowest_level"], "chief of staff with a rating"))
                bare = self.who(report, files, delegation={"threshold": None})
                if cls in self.rule["never_path_classes"]:
                    self.assertEqual(([o["kind"] for o in bare["owner_only"]], bare["who"]), (["class"], "owner only"))
                else:
                    self.assertEqual((bare["owner_only"], bare["who"]), ([], "owner or chief of staff"))
                self.assertEqual(self.who(report, files, delegation=None)["who"], "owner (delegation is off)" if cls not in self.rule["never_path_classes"] else "owner only")
                mutant = {"floor": {"lowest_level": "High", "rules": {k: v for k, v in self.block["floor"]["rules"].items() if k != rid}}}
                self.assertEqual(self.who(report, files, block=mutant)["floor_ids"], [], "the rule id comes from the matrix block")
        for cls in self.rule["never_path_classes"]:
            self.assertIn(cls, self.block["floor"]["rules"].values(), "every never-delegated class has a floor rule id")

    def test_the_hold_decisions_and_unreadable_inputs(self):
        for decision in ("none", "second-review"):
            self.assertEqual(self.who(self.report(decision=decision), [self.file("a")])["who"], "no hold")
        for bad in (None, {}, dict(self.report(), owner_decision="maybe")):
            self.assertEqual(self.module.who_can_clear(self.rule, bad, [], self.floor.matches, {}, self.block, self.on)["who"], "unknown")
        self.assertEqual(self.module.who_can_clear(None, None, None, None, None, self.block, self.on, pr="acme/app#9", unread="why")["unreadable"], self.module.UNREAD)
        cut = dict(self.report(), complete=False)
        self.assertEqual(self.who(cut, [self.file("a")])["who"], "unknown")
        self.assertEqual(self.who(self.report(), [self.file("a")], block=None)["who"], "unknown", "no score rule: never a confident answer")

    def test_u1_the_refusal_strings_of_the_nine_rows_are_byte_identical_to_the_stored_fixture(self):
        for name, report, files, closure, _ in self.rows():
            with self.subTest(row=name):
                got = [self.module.refusals(self.rule, report, files, self.floor.matches, closure, None),
                       self.module.refusals(self.rule, report, files, self.floor.matches, closure, {"level": "High", "reasons": ["the score is High: High is the owner's"]})]
                self.assertEqual(got, self.STORED_REFUSALS[name])

    def test_s4_the_line_names_the_level_the_matrix_gives(self):
        row = [r for r in self.rows() if r[0] == "floor-authority"][0]
        shipped = self.module.clear_line(self.who(row[1], row[2]))
        self.assertIn("at least Serious", shipped)
        medium = json.loads(json.dumps(self.block))
        medium["floor"]["lowest_level"] = "Medium"
        line = self.module.clear_line(self.who(row[1], row[2], block=medium))
        self.assertIn("at least Medium", line)
        self.assertNotIn("Serious", line.replace(" on an independent rating up to Serious", ""))
        self.assertIn("floor-authority", line)

    def test_s12_an_owner_only_line_starts_with_owner_only_and_gives_its_reason_in_words(self):
        want = {"new-file": "adds a file", "machinery": "machinery", "closure": "reachable from the clear"}
        for name, report, files, closure, _ in self.rows():
            if name in want:
                with self.subTest(row=name):
                    line = self.module.clear_line(self.who(report, files, closure))
                    self.assertTrue(line.startswith("Who can clear this: owner only: "), line)
                    self.assertIn(want[name], line)

    def test_s13_the_documented_samples_are_the_rendered_lines(self):
        text = (BIN.parent / "docs" / "switchboard.md").read_text()
        rows = {r[0]: r for r in self.rows()}
        for name in ("new-file", "floor-authority"):
            with self.subTest(sample=name):
                _, report, files, closure, _ = rows[name]
                line = self.module.clear_line(self.who(report, files, closure))
                self.assertIn("\n" + line + "\n", text, "the documentation's sample is the line the code renders")

    def test_s9_no_planted_token_and_no_home_path_reaches_the_line_and_a_reason_is_never_printed(self):
        token = "gh" + "p_" + "A1b2C3d4" * 5
        home = "/".join(["", "Us" + "ers", "alex", ".config", "fleet"])
        for planted in (token, home, "x/" + token + ".py", "../../" + home.lstrip("/"), "bin/" + home):
            with self.subTest(path=planted[:12]):
                paths = [".github/workflows/" + planted.lstrip("/")]
                got = self.who(self.report(paths=paths), [self.file(paths[0])], {})
                line = self.module.clear_line(got)
                self.assertNotIn(token, json.dumps(got) + line)
                self.assertNotIn("alex", json.dumps(got) + line)
        closure = {"bin/fleet-switchboard": ["it changes %s at %s" % (token, home)]}
        got = self.who(self.report(paths=["bin/fleet-switchboard"]), [self.file("bin/fleet-switchboard")], closure)
        self.assertNotIn(token, json.dumps(got) + self.module.clear_line(got))
        self.assertNotIn("alex", json.dumps(got) + self.module.clear_line(got))
        self.assertEqual(self.module.safe_path("bin/ok_name.py"), "bin/ok_name.py")

    def test_u4_every_token_of_the_line_over_the_rows_is_a_word_of_the_code_a_rule_id_a_level_or_a_changed_path(self):
        import ast
        tree = ast.parse(Path(self.module.__file__).read_text())
        fixed = set()
        for node in ast.walk(tree):
            if isinstance(node, ast.FunctionDef) and node.name in ("clear_line", "_why") or isinstance(node, ast.Assign) and any(getattr(t, "id", "") in ("_OWNER_WORDS", "UNREAD") for t in node.targets):
                fixed |= {w for c in ast.walk(node) if isinstance(c, ast.Constant) and isinstance(c.value, str) for w in re.findall(r"[A-Za-z0-9_./-]+", c.value)}
        allowed = fixed | set(self.block["floor"]["rules"]) | set(self.block["ladder"]) | set(self.matrix["owner_hold"]["top_tier_classes"]) | {w for r in self.rows() for p in r[1]["changed_paths"] for w in re.findall(r"[A-Za-z0-9_./-]+", p)}
        def outside(line):
            return sorted(set(re.findall(r"[A-Za-z0-9_./-]+", line)) - allowed)
        seen = 0
        for name, report, files, closure, _ in self.rows():
            for delegation in ("on", {"threshold": None}, None):
                line = self.module.clear_line(self.who(report, files, closure, delegation=delegation))
                if line is not None:
                    seen += 1
                    self.assertEqual(outside(line), [], "%s: %s" % (name, line))
        self.assertGreater(seen, 20)
        self.assertTrue(outside(line + " " + "/".join(["", "Us" + "ers", "x", ".local", "state", "fleet", "audit.log"])), "the check sees a path that is not allowed")

    def test_u5_who_can_clear_is_defined_once_and_the_daemons_line_calls_it_and_it_returns_plain_data(self):
        import ast
        count = 0
        for path in sorted(BIN.parent.rglob("*")):
            if path.is_file() and not path.name.startswith("test-") and path.suffix in ("", ".py") and ".git" not in path.parts and path.stat().st_size < 3_000_000:
                try:
                    count += len(re.findall(r"^\s*def who_can_clear\(", path.read_text(), re.M))
                except UnicodeDecodeError:
                    continue
        self.assertEqual(count, 1)
        self.assertTrue(callable(self.module.who_can_clear))
        daemon, hold = ast.parse((BIN / "fleet-switchboard").read_text()), ast.parse((BIN / "impact_hold.py").read_text())
        calls = lambda tree, fn: {getattr(c.func, "attr", getattr(c.func, "id", "")) for f in ast.walk(tree) if isinstance(f, ast.FunctionDef) and f.name == fn for c in ast.walk(f) if isinstance(c, ast.Call)}
        self.assertIn("clear_who", calls(daemon, "clear_line_post"))
        self.assertIn("who_can_clear", calls(hold, "clear_who"))
        got = self.who(self.report(paths=["src/app.py"]), [self.file("src/app.py")])
        self.assertEqual(json.loads(json.dumps(got)), got, "a plain structure: it survives a JSON round trip unchanged")

    def test_the_delegation_is_read_from_the_configuration_the_clear_reads(self):
        bound = lambda n, **extra: dict({"number": n, "sha256": "0" * 64}, **extra)
        on = lambda *orders: {"delegated_clear": {"orders": list(orders), "charter": 40}}
        self.assertIsNone(self.module.delegation_of({}, self.block))
        self.assertIsNone(self.module.delegation_of({"delegated_clear": {"orders": [], "charter": 40}}, self.block))
        self.assertEqual(self.module.delegation_of(on(bound(1)), self.block), {"threshold": None})
        self.assertEqual(self.module.delegation_of(on(bound(1, max_level="Medium"), bound(2, max_level="Serious"), bound(3)), self.block), {"threshold": "Serious"})

    def floor_row(self, cls="credentials"):
        path = next(p for p in self.matrix["owner_hold"]["top_tier_paths"][cls] if not self.floor.matches(p, self.rule["clear_code_paths"]) and "*" not in p)
        return self.report(hits={cls: [path]}, paths=[path]), [self.file(path)]

    def test_a_floor_above_every_order_is_owner_only_and_the_clear_refuses_every_rating_the_same_way(self):
        report, files = self.floor_row()
        floor = self.block["floor"]["lowest_level"]
        ladder = self.block["ladder"]
        for threshold in [l for l in self.block["delegable_levels"] if ladder.index(l) < ladder.index(floor)]:
            with self.subTest(threshold=threshold):
                got = self.who(report, files, delegation={"threshold": threshold})
                self.assertEqual((got["who"], [o["kind"] for o in got["owner_only"]]), ("owner only", ["score"]))
                line = self.module.clear_line(got)
                self.assertIn("owner only: the rating the floor needs (%s) is above what any order allows (%s)" % (floor, threshold), line)
                for level in ladder:   # the clear itself: no rating at the floor or above passes
                    self.assertTrue(self.module.level_refusal(self.block, level, threshold) or ladder.index(level) <= ladder.index(threshold))
                self.assertTrue(self.module.level_refusal(self.block, floor, threshold), "the same comparison the clear makes")
        self.assertEqual(self.who(report, files, delegation={"threshold": floor})["who"], "chief of staff with a rating")

    def test_a_mutant_that_leaves_the_floor_comparison_out_says_the_chief_of_staff_can(self):
        report, files = self.floor_row()
        source = Path(self.module.__file__).read_text()
        old = 'and level_refusal(block, out["min_rating"], out["threshold"]):'
        self.assertIn(old, source)
        scope = {"__name__": "mutant_delegated_clear", "__file__": self.module.__file__}
        exec(compile(source.replace(old, "and False:"), "mutant", "exec"), scope)
        medium = {"threshold": "Medium"}
        got = scope["who_can_clear"](self.rule, report, files, self.floor.matches, {}, self.block, medium, pr="acme/app#9")
        self.assertEqual(got["who"], "chief of staff with a rating", "the mutant says what the clear would refuse for every rating")
        self.assertEqual(self.who(report, files, delegation=medium)["who"], "owner only")

    def test_every_refusal_of_judge_is_a_row_the_line_knows_and_a_new_one_fails_here(self):
        import ast
        tree = ast.parse(Path(self.module.__file__).read_text())
        judge = next(n for n in ast.walk(tree) if isinstance(n, ast.FunctionDef) and n.name == "judge")
        sites = [n for n in ast.walk(judge) if (isinstance(n, ast.Return) and isinstance(n.value, ast.Dict) and any(isinstance(k, ast.Constant) and k.value == "reasons" for k in n.value.keys)
                 and not (isinstance(n.value.values[-1], ast.List) and not n.value.values[-1].elts) and not (isinstance(n.value.values[-1], ast.Name)))
                 or (isinstance(n, ast.Call) and getattr(n.func, "attr", "") == "append" and getattr(n.func.value, "id", "") == "reasons")
                 or (isinstance(n, ast.Assign) and any(getattr(t, "id", "") == "reasons" for t in n.targets))
]
        # each refusal of judge and what the line says of it: "static" is known from the pull request and the orders alone (the line says owner only), "rating" depends on a rating not yet made (the line says what the rating must be)
        known = {"the score rule or the rating is unknown": "unreadable (who: unknown)", "the threshold is unknown": "unreachable: the configuration refuses a max_level that is not delegable",
                 "a rating has no severity and probability the matrix knows": "rating", "no agent block": "rating", "incomplete verdict": "rating", "no independent rating": "rating",
                 "a higher uncounted rating": "rating", "floor below": "rating (the line says the least rating)", "rule not named": "rating (the line says which ids)", "append(over), the answer of level_refusal": "static (owner only, kind score)",
                 "#972 too few counted ratings": "rating", "#972 too few rater sessions": "rating", "#972 too few independent runs": "rating"}
        self.assertEqual(len(sites), len(known), "judge has a refusal this table does not: give it a row (and a line) before it ships")

    def test_s1_the_documented_cause_paragraph_names_every_recorded_refusal_kind_with_its_count_and_says_the_sample_is_thin(self):
        text = (BIN.parent / "docs" / "switchboard.md").read_text()
        start = text.index("#### Why a clear was refused (#946)")
        section = text[start:text.index("\n#", start + 10)]
        recorded = [("closure rule", 3), ("new-file rule", 1), ("credentials path, rating Medium below the floor Serious", 1), ("did not name the floor rule id", 1),
                    ("a hold label a person added", 2), ("not the Chief of Staff's own session", 1)]
        found = [name for name, count in recorded if any(name in row and re.search(r"\|\s*%d\s*\|?\s*$" % count, row) for row in section.split("\n"))]
        self.assertEqual(len(found), 6, "6 of 6 refusal kinds are named with their recorded count; found %s" % found)
        self.assertIn("thin sample", section)


class TestClearLine(TestImpactHold):
    """#946: the daemon's hold pass posts ONE line on a held pull request at its first ready head: who can clear it, from the clear's own rule (`clear_who`). Once per head, again only when the content changes,
    read back from a hidden marker on the pull request. A fake gh records every write; the reads (files, comments) are a fixture."""

    def setUp(self):
        super().setUp()
        self.comments, self.gets, self.fail_on = [], [], None
        self.floor_reads = []
        self.mapped = []
        self.set_files("migrations/0002.sql", "bin/impact_hold.py")
        for target, value in (("impact_carry_get", self.api), ("delegated_clear_map", lambda engine, runner, repo, item, base_sha, rule: self.mapped)):
            patcher = mock.patch.object(sb, target, value)
            patcher.start()
            self.addCleanup(patcher.stop)

    def set_files(self, *paths, head=LEDGER_HEAD, status="modified"):
        self.paths = list(paths)
        self.listing = [{"filename": p, "patch": "@@ -1 +1 @@\n-a\n+b", "status": status, "sha": "e" * 40} for p in paths]
        self.pr.update({"headRefOid": head, "changedFiles": len(paths), "files": [{"path": p} for p in paths]})

    def api(self, engine, runner, repo):
        def get(path):
            self.gets.append(path)
            if self.fail_on and self.fail_on in path:
                raise ValueError("the read failed")
            if "/files" in path:
                return self.listing if "page=1" in path else []
            if "/comments" in path:
                number = re.search(r"/issues/(\d+)/", path).group(1)
                return [c for c in self.comments if c.get("n", "9") == number] if "page=1" in path else []
            return {"head": {"sha": self.pr["headRefOid"]}, "base": {"sha": "b" * 40}}
        return get

    def route(self, argv, **kwargs):
        if argv[0] == FAKE_GH and argv[1:3] == ["pr", "view"] and is_floor_view(argv):
            self.floor_reads.append(int(argv[3]))
        done = super().route(argv, **kwargs)
        if argv[0] == FAKE_GH and "--method" in argv and argv[argv.index("--method") + 1] == "POST" and argv[2].endswith("/comments"):
            self.comments.append({"body": json.loads(kwargs["input"])["body"], "n": re.search(r"/issues/(\d+)/", argv[2]).group(1)})
        return done

    def posts(self):
        return [w for w in self.writes if w[0] == "POST" and w[1].endswith("/comments")]

    def markers(self):
        return [sb.CLEAR_LINE_MARKER.search(w[2]["body"]).groups() for w in self.posts()]

    def delegation(self, level="Serious"):
        self.extra_config["delegated_clear"] = {"orders": [dict(self.bound(17), max_level=level)], "charter": 40}
        self.configure()
        if hasattr(self, "engine_cached"):
            del self.engine_cached

    def test_s3_a_held_pull_request_gets_one_comment_with_the_line_and_a_draft_gets_none(self):
        self.passes(records=[self.listed(draft=True)])
        self.assertEqual(self.posts(), [], "a draft is never commented")
        self.passes(records=[self.listed()], advance=400)
        (post,) = self.posts()
        self.assertEqual(post[1], "repos/acme/app/issues/9/comments")
        self.assertIn("floor-authority", post[2]["body"])
        self.assertIn("owner only", post[2]["body"])
        self.assertIn("fleet-switchboard:from=switchboard", post[2]["body"], "signed, so it never comes back as an event")

    def test_the_line_reuses_the_floor_read_the_pass_made_and_adds_no_read_of_its_own(self):
        self.passes()
        self.assertEqual(len(self.posts()), 1, "the line was posted: the path under test ran")
        self.assertEqual(self.floor_reads, [9], "one floor read for the pull request: the line is given the report the pass judged")

    def test_s5_the_same_content_at_the_same_head_is_posted_once(self):
        for n in range(3):
            self.passes(advance=n * 400)
        self.assertEqual(len(self.posts()), 1)

    def test_s6_a_changed_content_at_the_same_head_posts_a_new_line_and_a_repeat_posts_nothing(self):
        self.set_files("migrations/0002.sql")
        self.passes()
        self.delegation()
        self.passes(advance=400)
        self.passes(advance=800)
        self.assertEqual(len(self.posts()), 2)
        (a, b), (c, d) = self.markers()
        self.assertEqual(a, c)
        self.assertNotEqual(b, d)
        self.assertIn("the owner (delegation is off here)", self.posts()[0][2]["body"])
        self.assertIn("at least Serious", self.posts()[1][2]["body"])

    def test_s7_a_new_head_with_the_same_content_gets_its_own_line(self):
        self.passes()
        self.set_files("migrations/0002.sql", "bin/impact_hold.py", head=LEDGER_NEW_HEAD)
        self.passes(records=[self.listed(head=LEDGER_NEW_HEAD)], advance=2000)
        self.assertEqual(len(self.posts()), 2)
        (a, b), (c, d) = self.markers()
        self.assertEqual((a, b == d, c), (LEDGER_HEAD[:12], True, LEDGER_NEW_HEAD[:12]))

    def test_s8_a_restart_posts_nothing_a_failed_comment_read_posts_nothing_and_the_retry_posts_once(self):
        self.passes()
        del self.engine_cached   # a new engine with no memory
        self.passes(advance=2000)
        self.assertEqual(len(self.posts()), 1, "the line is read back from the pull request's own comments")
        self.comments.clear()
        self.writes.clear()
        del self.engine_cached
        self.fail_on = "/comments"
        self.passes(advance=4000)
        self.assertEqual(self.posts(), [])
        self.assertEqual(len(self.events("clear_line.error")), 1)
        self.fail_on = None
        self.passes(advance=4000 + sb.IMPACT_RETRY_SECONDS + 1)
        self.assertEqual(len(self.posts()), 1, "retried later, and only the one")
        self.passes(advance=9000)
        self.assertEqual(len(self.posts()), 1)

    def test_s8_a_line_another_author_wrote_with_a_marker_is_not_the_daemons_own(self):
        self.comments.append({"body": sb.clear_line_marker(LEDGER_HEAD, "x") + "\nnot signed"})
        self.passes()
        self.assertEqual(len(self.posts()), 1)

    def test_s9_a_planted_token_and_home_path_in_a_file_name_or_a_reason_do_not_reach_the_posted_body(self):
        token = "gh" + "p_" + "A1b2C3d4" * 5
        home = "/".join(["", "Us" + "ers", "alex", ".config", "fleet"])
        self.mapped = ["it changes %s at %s" % (token, home)]
        self.set_files("migrations/0002.sql", ".github/workflows/" + token + ".yml", "bin/" + "/".join(["", "Us" + "ers", "alex", ".config", "fleet"]), "bin/fleet-switchboard")
        self.passes()
        (post,) = self.posts()
        self.assertNotIn(token, post[2]["body"])
        self.assertNotIn(home, post[2]["body"])
        self.assertNotIn("alex", post[2]["body"])

    def test_s11_the_dry_run_calls_no_writer_and_the_pass_makes_exactly_one_comment_post_and_no_label_call(self):
        import contextlib
        self.hold_config = {"enabled": True, "dry_run": True}
        self.reconfigure()
        self.passes()
        engine, methods, sent = self.engine_cached, [], []
        real_write, real_gh = sb._gh_write, engine.gh_runner
        engine.gh_runner = lambda argv, **kw: (methods.append(argv[argv.index("--method") + 1] if "--method" in argv else "?"), real_gh(argv, **kw))[1]
        engine.send = lambda *a, **k: sent.append(a)
        audit_before = len(self.world.audit())
        with contextlib.ExitStack() as stack:
            for target in ("change_issue_labels", "write_impact_state", "comment_as", "post_ask_comment", "_write_small", "ensure_labels"):
                stack.enter_context(mock.patch.object(sb, target, side_effect=AssertionError("a writer was called: " + target)))
            stack.enter_context(mock.patch.object(sb, "_gh_write", lambda engine, runner, repo, path, method, data=None, tolerate_missing=False: (methods.append(method), real_write(engine, runner, repo, path, method, data, tolerate_missing))[1]))
            got = sb.clear_who(engine, engine.gh_runner, "acme/app", 9)
        self.assertEqual((got["who"], got["hold"]), ("owner only", True))
        self.assertTrue(methods and set(methods) <= {"GET", "?"}, "the dry run only read (`?` is a `gh pr view`): %s" % sorted(set(methods)))
        self.assertEqual((sent, len(self.world.audit()) - audit_before, self.writes), ([], 0, []))
        self.hold_config = {"enabled": True}
        self.reconfigure()
        self.writes.clear()
        self.passes(records=[self.listed(labels=self.labelled())])
        self.assertEqual((len(self.posts()), len(self.label_writes())), (1, 0))
        self.assertEqual([w for w in self.writes if w not in self.posts()], [], "nothing else was written")

    def test_the_line_and_the_clear_read_a_changed_daemon_file_once_and_a_mutant_that_reads_again_is_seen(self):
        self.set_files("migrations/0002.sql", "bin/fleet-switchboard")
        reads = []
        counted = lambda engine, runner, repo, item, base_sha, rule: (reads.append(base_sha), ["it changes f, part of the clear (head file)"])[1]
        with mock.patch.object(sb, "delegated_clear_map", counted):
            self.passes()
            engine = self.engine_cached
            self.assertEqual(len(self.posts()), 1)
            self.assertIn("reachable from the clear", self.posts()[0][2]["body"])
            sb.delegated_clear_pr_checks(engine, engine.gh_runner, "acme/app", 9)
            self.assertEqual(len(reads), 1, "the clear uses what the line read")
            sb.delegated_clear_pr_checks(engine, engine.gh_runner, "acme/app", 9)
            self.assertEqual(len(reads), 2, "handed over once: a later clear reads for itself")
            sb.clear_who(engine, engine.gh_runner, "acme/app", 9)
            sb.load_module("delegated_clear").MAP_CACHE.clear()   # the mutant: no shared cache
            sb.delegated_clear_pr_checks(engine, engine.gh_runner, "acme/app", 9)
            self.assertEqual(len(reads), 4, "without the hand-over the clear reads again")

    def test_u2_a_pull_request_that_holds_nothing_gets_no_comment_and_the_labels_are_unchanged(self):
        self.set_files("src/app.py")
        self.passes()
        self.assertEqual(self.writes, [])
        self.assertEqual(self.events("clear_line.error"), [])

    def test_u3_a_floor_or_file_list_that_cannot_be_read_posts_no_line_notes_once_and_still_holds(self):
        self.fail_on = "/files"
        self.passes()
        self.passes(advance=sb.IMPACT_RETRY_SECONDS + 1)
        self.assertEqual(self.posts(), [])
        self.assertEqual(len(self.events("clear_line.error")), 1)
        self.assertEqual(len(self.label_writes()), 1, "the hold is applied as before")
        self.assertEqual(sorted(self.label_writes()[0][2]["labels"]), sorted(self.labelled()))

    def test_the_owner_clear_at_this_head_stops_the_line_and_a_matrix_change_is_judged_again(self):
        self.passes()
        self.assertEqual(self.run_as(None, "impact", "clear", self.PR, "--reason", "a false hold: the file is a fixture")[0], 0)
        self.comments.clear()
        self.writes.clear()
        self.passes(advance=4000)
        self.assertEqual(self.posts(), [])

    def capture(self, records=None):
        """The arguments the hold pass hands `clear_line_pass` (and nothing posted): the engine, now, rule, heads, reports."""
        for attr in ("engine_cached",):
            if hasattr(self, attr):
                delattr(self, attr)
        self.comments.clear(); self.writes.clear(); self.gets.clear()
        got = []
        with mock.patch.object(sb, "clear_line_pass", lambda *a: got.append(a)):
            self.passes(records=records)
        self.writes.clear(); self.gets.clear()
        return got[-1]

    @staticmethod
    def mutated(edits):
        """The daemon's functions with `edits` ([(function, old, new)]) applied: {name: function}. An edit whose `old` is not in the source fails the test (a stale mutant)."""
        source, made = (BIN / "fleet-switchboard").read_text(), {}
        for name in sorted({e[0] for e in edits}):
            start = source.index("def %s(" % name)
            body = source[start:source.index("\ndef ", start + 5)]
            for fn, old, new in edits:
                if fn == name:
                    assert old in body, (name, old)
                    body = body.replace(old, new, 1)
            scope = dict(sb.__dict__)
            exec(compile(body, "mutant-" + name, "exec"), scope)
            made[name] = scope[name]
        for one in made.values():
            one.__globals__.update(made)   # the mutants call each other
        return made

    def run_pass(self, args, edits=()):
        made = self.mutated(edits)
        with contextlib.ExitStack() as stack:
            for name, fn in made.items():
                stack.enter_context(mock.patch.object(sb, name, fn))
            (made.get("clear_line_pass") or sb.clear_line_pass)(*args)

    # every guard of `clear_line_pass` that stops a read or a post: (what it stops, its source line, the edit that removes it). The completeness test derives the guards from the code.
    GUARDS = {
        "memo": ("clear_line_pass", "done.get((repo, number)) == signature or ", ""),
        "budget": ("clear_line_pass", "            if spent >= CLEAR_LINE_PASS_MAX:\n                break\n", ""),
        "cleared": ("clear_line_pass", '== head:\n                continue', '== head:\n                pass'),
    }

    def test_the_guards_of_the_pass_are_each_pinned_by_a_counting_test_and_a_mutant_each(self):
        import ast
        # 1. memo: three passes at an unchanged head read once (the first) and post once
        for name, edits, want_ok in (("real", [], True), ("no memo", [self.GUARDS["memo"]], False)):
            with self.subTest(guard="memo", build=name):
                args = self.capture()
                self.run_pass(args, edits)
                after_first = len(self.gets)
                self.run_pass(args, edits)
                self.run_pass(args, edits)
                held = (len(self.gets) == after_first and len(self.posts()) == 1)
                self.assertEqual(held, want_ok, (len(self.gets), after_first, len(self.posts())))
        # 2. budget: three held pull requests, two read and posted in the first pass
        for name, edits, want_ok in (("real", [], True), ("no budget", [self.GUARDS["budget"]], False)):
            with self.subTest(guard="budget", build=name):
                args = list(self.capture())
                one = next(iter(args[3].items()))
                args[3] = {("acme/app", n): one[1] for n in (9, 10, 11)}
                args[4] = {("acme/app", n): dict(next(iter(args[4].values())), pr="acme/app#%d" % n) for n in (9, 10, 11)}
                self.run_pass(args, edits)
                read = {m.group(1) for g in self.gets for m in [re.search(r"/(?:issues|pulls)/(\d+)/", g)] if m}
                self.assertEqual(sb.CLEAR_LINE_PASS_MAX, 2, "the documented budget")
                self.assertEqual((len(read) <= sb.CLEAR_LINE_PASS_MAX and len(self.posts()) == sb.CLEAR_LINE_PASS_MAX), want_ok, (read, len(self.posts())))
        # 3. a head the head moved off between the report and the line posts nothing (either head check alone is an equivalent mutant: the other catches it)
        both = [("clear_line_pass", 'or report.get("head") != head', ""), ("clear_line_post", 'if who["head"] != head:', "if False:")]
        for name, edits, want_ok in (("real", [], True), ("only the pass check removed", both[:1], True), ("only the post check removed", both[1:], True), ("both removed", both, False)):
            with self.subTest(guard="head moved", build=name):
                args = list(self.capture())
                args[3] = {k: LEDGER_NEW_HEAD for k in args[3]}
                self.run_pass(args, edits)
                self.assertEqual(self.posts() == [], want_ok, (self.posts(), self.events("clear_line.error")))
        # 4. a head the owner cleared gets no line (the clear is run last: it stays)
        for name, edits, want_ok in (("real", [], True), ("no cleared check", [self.GUARDS["cleared"]], False)):
            with self.subTest(guard="cleared", build=name):
                args = self.capture()
                if not hasattr(self, "cleared_once"):
                    self.assertEqual(self.run_as(None, "impact", "clear", self.PR, "--reason", "a false hold: the file is a fixture")[0], 0)
                    self.cleared_once = True
                self.run_pass(args, edits)
                self.assertEqual(self.posts() == [], want_ok, self.posts())
        # completeness: a new guard (continue, break or raise before the post) is a new row above
        tree = ast.parse((BIN / "fleet-switchboard").read_text())
        fn = lambda name: next(n for n in ast.walk(tree) if isinstance(n, ast.FunctionDef) and n.name == name)
        stops = [n for n in ast.walk(fn("clear_line_pass")) if isinstance(n, (ast.Continue, ast.Break))]
        self.assertEqual(len(stops), 4, "continue/break guards of the pass: gate (hold, enforce, head, rule), memo/retry, cleared, budget: one row each above")
        raises = [n for n in ast.walk(fn("clear_line_post")) if isinstance(n, ast.Raise)]
        self.assertEqual(len(raises), 4, "raises of the post: unreadable, head moved (row above), comments not a list and too many pages (a failed read: test_s8, test_u3)")

    def three_held(self):
        return [self.listed(number=n) for n in (9, 10, 11)]

    def test_the_line_for_a_pull_request_that_holds_nothing_is_none_and_the_guard_is_pinned(self):
        module = sb.load_module("delegated_clear")
        quiet = {"floor_ids": [], "threshold": None, "owner_only": [], "min_rating": None}
        for who in ("no hold", "unknown", None):
            self.assertIsNone(module.clear_line(dict(quiet, who=who)))
        self.assertIsNone(module.clear_line(None))
        self.assertIsNone(module.clear_line("owner only"))
        self.assertIsNotNone(module.clear_line(dict(quiet, who="owner or chief of staff")))
        self.assertIn("at most Serious", module.clear_line(dict(quiet, who="owner or chief of staff", threshold="Serious")), "several orders: the line says at most")

for _name in [n for n in dir(TestImpactHold) if n.startswith("test")]:
    setattr(TestClearLine, _name, None)   # the inherited fixture only: its own tests run in TestImpactHold


class TestClearCodePathsAlwaysHeld(unittest.TestCase):
    """Ask #939: a path of the matrix's `clear_code_paths` is never delegated, so the floor also HOLDS it for the owner. One table, derived from the matrix list;
    the real floor and the real clear refusal are driven; the closure rule (modules and functions the clear merely loads) is NOT part of this (#940)."""

    def setUp(self):
        self.floor = sb.load_module("impact_floor")
        self.clear = sb.load_module("delegated_clear")
        self.matrix = self.floor.load_matrix()
        self.rule = self.matrix["owner_hold"]["delegated_clear"]
        self.listed = list(self.rule["clear_code_paths"])

    def decide(self, paths, matrix=None):
        matrix = matrix or self.matrix
        globs, exclude, force = self.floor.floor_for("adamkaplan/fleet-kit")
        return self.floor.owner_decide(matrix, paths, [], None, self.floor.floor_paths(paths, globs, exclude, force))

    @staticmethod
    def concrete(entry):
        return entry.replace("**", "sub/x.txt").replace("*", "x")

    def without(self, drop):
        matrix = json.loads(json.dumps(self.matrix))
        if drop is None:
            del matrix["owner_hold"]["delegated_clear"]
        else:
            matrix["owner_hold"]["delegated_clear"]["clear_code_paths"] = [e for e in self.listed if e != drop] or ["nothing/at/all"]
        return matrix

    def rows(self):
        return [(entry, self.concrete(entry)) for entry in self.listed]

    def reason_of(self, path, matrix=None):
        decision, reasons = self.decide([path], matrix)
        return decision, [r for r in reasons if r.startswith("clear_code_paths")]

    def test_s5_every_entry_of_the_list_is_held_with_the_reason_that_names_the_list(self):
        rows = self.rows()
        self.assertEqual(len(rows), len(self.listed))
        self.assertGreaterEqual(len(rows), 14)
        for entry, path in rows:
            decision, why = self.reason_of(path)
            self.assertEqual(decision, "hold", entry)
            self.assertEqual(len(why), 1, "%s: the reason names the list and the path" % entry)
            self.assertIn(path, why[0])

    def test_s5_a_mutant_that_drops_the_list_or_one_entry_dies(self):
        for entry, path in self.rows():
            decision, why = self.reason_of(path, self.without(entry))
            self.assertEqual(why, [], "dropping %s from the list must remove its reason" % entry)
        for entry, path in self.rows():
            with mock.patch.object(self.floor, "clear_code_paths", lambda matrix: (None, None)):
                self.assertEqual(self.reason_of(path)[1], [], entry)

    def test_s5_the_table_is_complete_for_a_new_entry(self):
        matrix = json.loads(json.dumps(self.matrix))
        matrix["owner_hold"]["delegated_clear"]["clear_code_paths"].append("brand/new/**")
        self.assertEqual(self.reason_of("brand/new/a.py", matrix)[0], "hold")   # held with no code edit: the list is the only source
        self.assertNotEqual(self.decide(["brand/new/a.py"])[0], "hold")
        self.assertEqual(len(self.rows()), len(self.rule["clear_code_paths"]), "a row per entry, derived, never hand-listed")

    def test_s2_a_rename_source_and_the_spellings_the_floor_normalises_are_held(self):
        self.assertEqual(self.reason_of("bin/plan_check.py")[0], "hold")
        for spelled in ("./bin/plan_check.py", "bin//plan_check.py", "BIN/PLAN_CHECK.PY"):
            self.assertEqual(self.reason_of(spelled)[0], "hold", spelled)
        self.assertEqual(self.decide(["bin/other_new_name.py", "bin/repo_exclusion.py"])[0], "hold", "a rename's old path is among the paths")

    def test_s2b_a_closure_module_that_is_not_on_the_list_is_decided_as_before(self):
        outside = [e for e in self.rule["closure_files"] if not self.floor.matches(e, self.listed)]
        self.assertTrue(outside)
        before = self.without(None)
        for path in outside:
            self.assertEqual(self.decide([path]), self.decide([path], before), path)
            self.assertEqual(self.reason_of(path)[1], [], path)

    def test_s3_a_pull_request_that_touches_no_listed_path_is_decided_as_before(self):
        before = self.without(None)
        for path in ("docs/notes.md", "README.md", "bin/fleet_health.py", "bin/decision_sync.py", "bin/triage_digest.py", "bin/fleet-switchboard", "cloud/launcher/app_token.py",
                     "agents/x/y.md", "skills/a/SKILL.md", "bin/test-switchboard", "docs/switchboard.md"):
            self.assertEqual(self.decide([path]), self.decide([path], before), path)

    def test_the_three_entries_the_floor_did_not_hold_before_are_held_now(self):
        before = self.without(None)
        for path in ("bin/plan_check.py", "bin/repo_exclusion.py", "templates/com.example.plist"):
            self.assertNotEqual(self.decide([path], before)[0], "hold", path)
            self.assertEqual(self.decide([path])[0], "hold", path)

    def test_a_malformed_list_holds_and_an_absent_block_does_not_widen_the_rule(self):
        for bad in ("x", [], [1], [""]):
            matrix = json.loads(json.dumps(self.matrix))
            matrix["owner_hold"]["delegated_clear"]["clear_code_paths"] = bad
            decision, reasons = self.decide(["docs/notes.md"], matrix)
            self.assertEqual(decision, "hold", bad)
            self.assertIn("clear_code_paths", reasons[0])

    def test_s4_the_clear_still_refuses_every_entry_with_its_current_reason(self):
        report = {"owner_decision": "hold", "complete": True, "unknown": None, "renamed_no_source": False, "top_tier_hits": {}, "review_action": "none", "review_class": None, "changed_paths": []}
        for entry, path in self.rows():
            files = [{"filename": path, "previous_filename": None, "status": "modified"}]
            got = self.clear.refusals(self.rule, report, files, self.floor.matches, {}, {"reasons": [], "level": "Low"})
            self.assertEqual(got, ["it changes a file that is the clear or hold machinery or that the daemon loads (%s): that stays the owner's own clear" % path], entry)

    def test_s7_one_reader_serves_the_floor_and_the_clear_and_the_rule_names_no_path(self):
        self.assertEqual(self.floor.clear_code_paths(self.matrix), (self.listed, None))
        matrix = json.loads(json.dumps(self.matrix))
        matrix["owner_hold"]["delegated_clear"]["clear_code_paths"].append("brand/new/**")   # one entry added to the matrix: the floor holds it AND the clear refuses it
        self.assertEqual(self.reason_of("brand/new/a.py", matrix)[0], "hold")
        listed, problem = self.floor.clear_code_paths(matrix)
        self.assertIsNone(problem)
        report = {"owner_decision": "hold", "complete": True, "unknown": None, "renamed_no_source": False, "top_tier_hits": {}, "review_action": "none", "review_class": None, "changed_paths": []}
        refused = self.clear.refusals(dict(matrix["owner_hold"]["delegated_clear"], clear_code_paths=listed), report,
                                      [{"filename": "brand/new/a.py", "previous_filename": None, "status": "modified"}], self.floor.matches, {}, {"reasons": [], "level": "Low"})
        self.assertEqual(len(refused), 1, refused)
        import ast
        tree = ast.parse((BIN / "impact_floor.py").read_text())
        constants = {n.value for n in ast.walk(tree) if isinstance(n, ast.Constant) and isinstance(n.value, str)}
        self.assertEqual(sorted(constants & set(self.listed)), [], "a listed path is written in the floor's code")

    def test_s6_the_docs_and_the_matrix_text_say_always_held_and_where_it_stops(self):
        docs = (BIN.parent / "docs" / "switchboard.md").read_text()
        meaning = self.rule["meaning"]
        for text in (docs, meaning):
            self.assertIn("always held", text.lower())
            self.assertIn("clear_code_paths", text)
            self.assertIn("closure", text)
            self.assertIn("#940", text)


class TestOwnerClearModule(unittest.TestCase):
    """Ask #532, slice 3: the code that decides who may clear, hold or release lives in bin/impact_hold.py (listed in the matrix), not in the daemon file. The names come from the
    module's own MOVED tuple and the paths from the matrix: this test has no list of its own."""

    def setUp(self):
        self.floor = sb.load_module("impact_floor")
        self.matrix = self.floor.load_matrix()
        self.module = sb.load_module("impact_hold")
        self.daemon = BIN / "fleet-switchboard"

    @staticmethod
    def defined(source):
        import ast
        return {n.name for n in ast.parse(source).body if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef))}

    def test_the_moved_functions_are_defined_in_the_module_and_found_in_the_daemon_under_their_old_names(self):
        self.assertGreaterEqual(len(self.module.MOVED), 8)
        self.assertEqual(self.defined(Path(self.module.__file__).read_text()) & set(self.module.MOVED), set(self.module.MOVED))
        for name in self.module.MOVED:
            self.assertTrue(callable(getattr(sb, name)), name)
            self.assertIs(getattr(sb, name).__globals__, vars(sb), name + " runs in the daemon's own globals, as before the move")

    def test_s5_s7_none_of_the_moved_functions_is_defined_in_the_daemon_file_and_one_registration_names_the_module(self):
        source = self.daemon.read_text()
        self.assertEqual(self.defined(source) & set(self.module.MOVED), set())
        self.assertEqual(source.count('load_module("impact_hold").bind('), 1)

    def test_s7_a_moved_function_copied_back_into_the_daemon_is_named(self):
        name = self.module.MOVED[0]
        copied = self.daemon.read_text() + "\n\ndef %s(*args):\n    return None\n" % name
        self.assertEqual(sorted(self.defined(copied) & set(self.module.MOVED)), [name])

    def test_s3_no_code_outside_the_matrix_names_a_top_tier_path_as_a_literal(self):
        import ast
        listed = {g for globs in self.matrix["owner_hold"]["top_tier_paths"].values() for g in globs}
        files = sorted(BIN.glob("*.py")) + [self.daemon]
        hits = []
        for path in files:
            for node in ast.walk(ast.parse(path.read_text())):
                if isinstance(node, ast.Constant) and isinstance(node.value, str) and node.value in listed:
                    hits.append("%s: %s" % (path.name, node.value))
        self.assertEqual(hits, [])

    def test_s6_a_change_to_the_module_holds_for_the_owner_and_naming_it_a_change_to_another_daemon_function_does_not(self):
        globs, exclude, force = self.floor.floor_for("adamkaplan/fleet-kit")
        floor_hit = lambda paths: self.floor.floor_paths(paths, globs, exclude, force)
        moved = self.floor.owner_decide(self.matrix, ["bin/impact_hold.py"], [], None, floor_hit(["bin/impact_hold.py"]))
        other = self.floor.owner_decide(self.matrix, ["bin/fleet-switchboard"], [], None, floor_hit(["bin/fleet-switchboard"]))
        self.assertEqual(moved[0], "hold")
        self.assertTrue(any("bin/impact_hold.py" in r for r in moved[1]), moved)
        self.assertNotEqual(other[0], "hold", other)

    def test_s8_without_the_module_the_daemon_refuses_loudly_and_names_it(self):
        import shutil
        with tempfile.TemporaryDirectory() as tmp:
            for path in list(BIN.glob("*.py")) + [self.daemon]:
                if path.name != "impact_hold.py":
                    shutil.copy(path, Path(tmp) / path.name)
            done = subprocess.run([sys.executable, str(Path(tmp) / "fleet-switchboard"), "impact", "clear", "acme/api#1", "--reason", "x"], capture_output=True, text=True, timeout=60,
                                  env=dict(os.environ, FLEET_SWITCHBOARD_STATE_DIR=tmp))
        self.assertEqual(done.returncode, 1, done.stderr)
        self.assertIn("impact_hold", done.stderr)


class TestOwnerHoldRule(unittest.TestCase):
    """Ask #451, slice 1: the owner's own clear is for credentials, identity and who may do what only. The rule is data in the impact matrix file."""

    def setUp(self):
        self.floor = sb.load_module("impact_floor")
        self.matrix = self.floor.load_matrix()

    def decide(self, paths, impacts=(), unknown=None, matrix=None):
        matrix = matrix or self.matrix
        globs, exclude, force = self.floor.floor_for("adamkaplan/fleet-kit")
        hit = self.floor.floor_paths(paths, globs, exclude, force)
        return self.floor.owner_decide(matrix, paths, list(impacts), unknown, hit)

    def test_s1_the_decision_code_names_no_path_or_class_and_agrees_with_the_file(self):
        import ast
        tree = ast.parse((BIN / "impact_floor.py").read_text())
        docstrings = set()
        for node in ast.walk(tree):
            if isinstance(node, (ast.Module, ast.FunctionDef, ast.ClassDef)) and node.body and isinstance(node.body[0], ast.Expr) \
                    and isinstance(node.body[0].value, ast.Constant):
                docstrings.add(id(node.body[0].value))
        constants = {n.value for n in ast.walk(tree) if isinstance(n, ast.Constant) and isinstance(n.value, str) and id(n) not in docstrings}
        block = self.matrix["owner_hold"]
        from_file = set(block["top_tier_classes"]) | set(block["other_classes"]) | {g for globs in block["top_tier_paths"].values() for g in globs}
        from_file |= {g for entry in block["floor"].values() for key in ("globs", "exclude", "force") for g in entry.get(key, [])}
        self.assertTrue(from_file)
        self.assertEqual(sorted(constants & from_file), [], "a path or class of the matrix file is written in the module's code")

    def test_every_top_tier_path_is_inside_the_floor_or_listed_as_outside_it(self):
        block = self.matrix["owner_hold"]
        outside = set(block["top_tier_outside_floor"])
        globs, exclude, force = self.floor.floor_for("adamkaplan/fleet-kit")
        for cls, patterns in block["top_tier_paths"].items():
            for pattern in patterns:
                sample = pattern.replace("**", "x").replace("*", "x")
                inside = bool(self.floor.floor_paths([sample], globs, exclude, force))
                self.assertTrue(inside != (pattern in outside), "%s (%s): inside the floor %s, listed as outside it %s" % (pattern, cls, inside, pattern in outside))

    def test_a_missing_or_malformed_block_holds_every_change_and_a_broken_file_is_never_read_as_no_floor(self):
        for broken in ({}, {"owner_hold": "x"}, {"owner_hold": {"top_tier_classes": ["credentials"], "other_classes": [], "top_tier_paths": {"credentials": "shims/gh"}}},
                       {"owner_hold": {"top_tier_classes": ["credentials"], "other_classes": [], "top_tier_paths": {}}}):
            decision, reasons = self.floor.owner_decide(broken, ["docs/notes.md"], [])
            self.assertEqual(decision, "hold", broken)
            self.assertIn("missing or malformed", reasons[0])
        bad = self.home_file("matrix.json", "{not json")
        with mock.patch.object(self.floor, "MATRIX_PATH", bad):
            self.floor._MATRIX_CACHE.clear()
            with self.assertRaises(self.floor.MatrixError):
                self.floor.floor_for("adamkaplan/fleet-kit")
        self.floor._MATRIX_CACHE.clear()
        self.assertTrue(self.floor.floor_for("adamkaplan/fleet-kit")[0], "the real file reads again")

    def test_an_odd_character_in_a_path_never_escapes_a_glob_and_a_suffix_never_makes_an_exact_file_match(self):
        for path in ("shims/a\nb", "shims/a\tb", "shims/a\x00b", "shims/a b ", "shims/" + "x" * 5000, "agents/x\nz.md", "agents/opencode/\x00x.md",
                     "plugins/fleet-hooks/a\nb", "SHIMS/A\nB"):
            self.assertEqual(self.decide([path])[0], "hold", repr(path[:40]))
            self.assertTrue(self.floor.matches(path, ["shims/**", "agents/**", "plugins/fleet-hooks/**"]), repr(path[:40]))
        for path in ("bin/plan_ledger.py\nx", "bin/plan_ledger.py\n", "bin/plan_ledger.py ", "bin/plan_ledger.pyx"):
            self.assertEqual(self.decide([path])[0], "none", "an exact file with a suffix is a different file: %r" % path)
        self.assertEqual(self.decide(["bin/plan_ledger.py"])[0], "hold")
        review = sb.load_module("plan_review")
        self.assertEqual(review.path_hits(["shims/a\nb", "docs/x.md"], ["shims/**"]), ["shims/a\nb"], "the held-path glob of the review tier has the same rule")

    def test_a_variant_spelling_of_a_top_tier_path_is_that_path_and_a_path_that_leaves_the_repository_holds(self):
        review = sb.load_module("plan_review")
        for path in ("Shims/GH", "shims//gh", "shims/./gh", "shims/x/../gh", "a/../shims/gh", "shims\\gh", "./shims/gh",
                     "agents/../AGENTS/opencode/../opencode/chief-of-staff.md", "BIN/Plan_Ledger.py", "bin//plan_ledger.py", "bin\\plan_ledger.py"):
            self.assertEqual(self.decide([path])[0], "hold", repr(path))
            self.assertEqual(review.path_hits([path], ["shims/**", "agents/**", "bin/plan_ledger.py"]), [path], "review tier: " + repr(path))
        for path in ("../x", "../../shims/gh", "a/../../x", "shims/../../x", "/etc/x", "/shims/gh", "~/x", "C:/x", "c:\\\\x"):
            decision, reasons = self.decide([path])
            self.assertEqual(decision, "hold", repr(path))
            self.assertTrue(any("outside the repository" in r for r in reasons), reasons)
            self.assertEqual(review.path_hits([path], ["docs/**"]), [path], "a path that cannot be read inside the repository is held by the review tier too")
            self.assertEqual(self.floor.floor_paths([path], ["docs/**"], ["docs/x/**"]), [path])
        for path in ("docs/notes.md", "docs/./notes.md", "Docs//Notes.md", "docs/a/../b.md"):
            self.assertEqual(self.decide([path])[0], "none", "a variant of a path outside the top tier stays outside: " + repr(path))

    def test_an_exclude_judges_only_the_named_file_a_force_path_and_the_two_tiers_share_one_normaliser(self):
        globs, exclude, force = ["shims/**"], ["shims/docs/**"], ["shims/docs/keep.md"]
        self.assertEqual(self.floor.floor_paths(["shims/docs/../gh"], globs, exclude), ["shims/docs/../gh"], "a spelling never moves a path into an exclude")
        self.assertEqual(self.floor.floor_paths(["shims/docs/x.md", "Shims//Docs//x.md"], globs, exclude), [], "a real excluded file stays excluded, in any spelling")
        self.assertEqual(self.floor.floor_paths(["shims/./docs/keep.md", "SHIMS/DOCS/KEEP.MD"], globs, exclude, force), ["SHIMS/DOCS/KEEP.MD", "shims/./docs/keep.md"],
                         "a force path is never excluded, in any spelling")
        review = sb.load_module("plan_review")
        for path in ("Shims/GH", "a/../x", "../x", "shims//./gh", "x\\y", "", "/", "..", "a/b/../../..", "bin\\..\\shims\\gh", "/etc/x", "~/x", "C:/x", "c:\\x", "a//b/./c/../d", "Ünï/../Ünï/x", "x\n/../y", "\u017fhims/gh", "\u212aeep/x", "ﬁle", "e\u0301", "\u00e9", "STRASSE/ß", "İ/i̇"):
            self.assertEqual(review._canonical(path), self.floor.canonical(path), repr(path))
            self.assertEqual(review._folds(path), self.floor.folds(path), "the fold copies agree: " + repr(path))

    def test_a_unicode_fold_of_a_top_tier_path_is_that_path_on_a_case_and_normalisation_insensitive_file_system(self):
        review = sb.load_module("plan_review")
        for path in ("\u017fhims/gh", "\u017fHIMS/Gh", ".github/wor\u212aflows/ci.yml", "agents/opencode/chi\u0065\u0301f.md", "BIN/PLAN_LEDGER.PY"):
            self.assertEqual(self.decide([path])[0], "hold", repr(path))
            self.assertEqual(review.path_hits([path], ["shims/**", ".github/workflows/**", "agents/**", "bin/plan_ledger.py"]), [path], "review tier: " + repr(path))
        self.assertTrue(self.floor.matches("e\u0301.txt", ["\u00e9.txt"]), "a decomposed accent is the composed one, in a glob too")
        self.assertTrue(self.floor.matches("\u00e9.txt", ["e\u0301.txt"]))
        self.assertEqual(self.floor.folds("\ufb01"), {"fi", "\ufb01"}, "a ligature folds to its letters, and its lower-case spelling is kept too")
        self.assertEqual(self.decide(["docs/\u017fhims.md"])[0], "none", "a fold of a name that matches no top tier glob stays outside")

    def test_the_fold_is_a_superset_of_the_old_lower_case_match(self):
        self.assertTrue(self.floor.matches("shims/\u00df", ["shims/?"]), "casefold turns a sharp s into ss, but the lower-case spelling is still tried")
        self.assertIn("\u00df", self.floor.folds("\u00df"))
        for text in ("SHIMS/Gh", "Agents/X.md", "\u00c9COLE"):
            self.assertTrue({text.lower()} <= self.floor.folds(text), text)

    def home_file(self, name, text):
        tmp = Path(tempfile.mkdtemp(prefix="ohr"))
        self.addCleanup(shutil.rmtree, tmp, True)
        path = tmp / name
        path.write_text(text)
        return path

    def test_a_deleted_path_a_renames_old_path_a_case_variant_and_a_cased_class_are_judged(self):
        self.assertEqual(self.decide(["docs/new-name.md", "shims/gh"])[0], "hold", "a rename out of a shim arrives as its old path")
        self.assertEqual(self.decide(["SHIMS/Git"])[0], "hold", "case-insensitive")
        self.assertEqual(self.decide(["x.py"], [("Critical", "Remote", "AVAILABILITY ")])[0], "second-review", "a class name is compared case-insensitively")
        self.assertEqual(self.decide(["x.py"], [("Critical", "Remote", "Credentials")])[0], "hold")
        self.assertEqual(self.decide(["x.py"], [("Marginal", "Remote", "credentials")])[0], "second-review", "a medium-band rating of a top tier class asks for a second review")

    def test_s2_a_change_to_the_shims_the_ledger_a_permission_block_or_the_matrix_holds_for_the_owner(self):
        for path in ("shims/gh", "shims/git", "bin/plan_ledger.py", "agents/opencode/chief-of-staff.md", "docs/review-laws/impact-matrix.json"):
            decision, reasons = self.decide([path, "docs/notes.md"])
            self.assertEqual(decision, "hold", path)
            self.assertTrue(any(path in reason for reason in reasons), (path, reasons))

    def test_s3_the_cloud_image_and_a_docs_file_do_not_hold_for_the_owner_and_the_launchd_template_does_since_it_is_on_clear_code_paths(self):
        paths = ["cloud/launcher/Dockerfile", "docs/switchboard.md"]
        decision, reasons = self.decide(paths)
        self.assertEqual((decision, reasons), ("none", []))
        for path in paths:
            self.assertNotEqual(self.decide([path])[0], "hold", path)
        decision, reasons = self.decide(["templates/com.fleet-kit.switchboard.plist"])   # #939: templates/** is on clear_code_paths, so it holds
        self.assertEqual(decision, "hold", reasons)

    def test_s4_only_a_top_tier_or_unknown_class_at_a_hold_level_holds(self):
        self.assertEqual(self.decide(["x.py"], [("Critical", "Remote", "credentials")])[0], "hold")
        self.assertEqual(self.decide(["x.py"], [("Critical", "Remote", "a-class-nobody-named")])[0], "hold")
        decision, reasons = self.decide(["x.py"], [("Critical", "Remote", "availability")])
        self.assertEqual(decision, "second-review", reasons)

    def test_s5_a_rating_with_no_class_is_top_tier(self):
        self.assertEqual(self.decide(["x.py"], [("Critical", "Remote", None)])[0], "hold")
        self.assertEqual(self.decide(["x.py"], [("Negligible", "Improbable", None)])[0], "none", "a low rating asks for nothing, class or not")

    def test_s6_a_diff_that_cannot_be_read_in_full_holds(self):
        decision, reasons = self.decide([], unknown="the file list was cut off")
        self.assertEqual(decision, "hold")
        self.assertIn("floor unknown", reasons[0])

    def test_s7_this_slices_own_files_hold_for_the_owner(self):
        decision, reasons = self.decide(["bin/impact_floor.py", "docs/review-laws/impact-matrix.json", "bin/test-switchboard"])
        self.assertEqual(decision, "hold")
        joined = " ".join(reasons)
        self.assertIn("bin/impact_floor.py", joined)
        self.assertIn("docs/review-laws/impact-matrix.json", joined)

    def test_s11_a_change_to_the_files_list_changes_the_decision_with_no_code_change(self):
        before = self.decide(["tools/new-gate.sh"])
        edited = json.loads(json.dumps(self.matrix))
        edited["owner_hold"]["top_tier_paths"]["authority"].append("tools/new-gate.sh")
        after = self.decide(["tools/new-gate.sh"], matrix=edited)
        self.assertEqual((before[0], after[0]), ("none", "hold"))
        edited["owner_hold"]["other_classes"].append("a-class-nobody-named")
        self.assertEqual(self.decide(["x.py"], [("Critical", "Remote", "a-class-nobody-named")], matrix=edited)[0], "second-review")

    def test_a_matrix_with_no_owner_hold_block_changes_nothing_for_the_old_floor_and_the_old_floor_is_read_from_the_file(self):
        globs, exclude, force = self.floor.floor_for("adamkaplan/fleet-kit")
        self.assertIn("shims/**", globs)
        self.assertIn("bin/impact_floor.py", force)
        self.assertEqual(self.floor.floor_for("someone/else"), ([], [], []))
        self.assertIsNone(self.floor.owner_hold_rule({}))
        self.assertTrue(self.floor.class_is_top_tier({}, "availability"), "no block: everything is top tier (fail closed)")


class TestDecisionIdForms(WriteWorld):
    """Ask #463: a decision is found by the natural forms of its id, and a miss names the right one."""

    def setUp(self):
        super().setUp()
        self.gh.issue(API, 2, "Which database?", labels=["me:awaiting-cos"])
        self.gh.issue(WEB, 2, "Other repo", labels=["me:awaiting-cos"])
        for number in (5, 6, 7, 9):
            self.gh.issue(API, number, "Issue %d" % number, labels=["me:awaiting-cos"])
        self.as_agent("cos")

    def test_s1_every_natural_spelling_of_the_id_finds_the_one_decision(self):
        for number, spelling in ((5, "acme/api#5"), (6, "api#6"), (7, "#7")):
            with self.subTest(spelling=spelling):
                code, out, err = self.main("decisions", "escalate", spelling)
                self.assertEqual(code, 0, err)
                self.assertEqual(self.gh.names(API, number), ["me:awaiting-user"], "the one the spelling names, and only it")
        self.assertEqual(self.gh.names(API, 9), ["me:awaiting-cos"])

    def test_s2_a_miss_lists_the_ids_that_carry_the_same_number(self):
        code, out, err = self.main("decisions", "resolve", "widget-api#9")
        self.assertEqual(code, 2)
        self.assertEqual((err + out).count("api#9"), 2, "once as the name that missed, once as the id it should have been: %s" % (err + out))
        self.assertIn("a decision numbered 9 is listed as api#9", err + out)

    def test_s3_a_number_in_two_repositories_is_refused_and_both_are_listed(self):
        before = (self.gh.names(API, 2), self.gh.names(WEB, 2))
        code, out, err = self.main("decisions", "escalate", "#2")
        self.assertEqual(code, 2)
        self.assertIn("api#2", err)
        self.assertIn("web#2", err)
        self.assertEqual((self.gh.names(API, 2), self.gh.names(WEB, 2)), before, "nothing was escalated")

    def test_s4_the_owner_and_repository_form_picks_one_of_two(self):
        code, out, err = self.main("decisions", "escalate", "acme/web#2")
        self.assertEqual(code, 0, err)
        self.assertEqual(self.gh.names(WEB, 2), ["me:awaiting-user"])
        self.assertEqual(self.gh.names(API, 2), ["me:awaiting-cos"], "the other is unchanged")

    def test_the_listed_id_still_works_and_the_role_check_is_unchanged_for_the_new_spellings(self):
        self.assertEqual(self.id_of("Which database?"), "api#2")
        self.assertEqual(self.main("decisions", "escalate", "api#2")[0], 0)
        self.assertEqual(self.gh.names(API, 2), ["me:awaiting-user"])
        self.as_agent("api-orch")
        code, out, err = self.main("decisions", "escalate", "acme/api#5")
        self.assertEqual(code, 2)
        self.assertIn("only the Chief of Staff", err)
        self.assertEqual(self.gh.names(API, 5), ["me:awaiting-cos"])


class LaneGH(FakeGH):
    """The fake GitHub for `move`: issue ids, the one sub-issue write (`replace_parent`), timelines and pulls."""

    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.writes, self.fail_write, self.timeline, self.pulls = [], False, {}, {}

    def record(self, number):
        found = super().record(number)
        found["id"] = 1000 + number
        found["labels"] = [{"name": n} for n in self.issues[number].get("labels", []) + ([sb.orchestrator_label()] if number in self.charters else [])]
        if self.issues[number].get("pr"):
            found["pull_request"] = {"url": "https://example.test/pull"}
        return found

    def serve(self, argv, kwargs):
        path = argv[2] if len(argv) > 2 else ""
        write = re.match(r"^%s(\d+)/sub_issues$" % re.escape(self.api), path)
        if write and "--method" in argv:
            self.calls.append(argv)
            body = json.loads(kwargs["input"])
            self.writes.append((int(write.group(1)), body))
            if self.fail_write:
                return subprocess.CompletedProcess(argv, 1, "", "gh: Validation Failed (HTTP 422)\n")
            child = int(body["sub_issue_id"]) - 1000
            if body.get("replace_parent") is not True:
                return subprocess.CompletedProcess(argv, 1, "", "gh: already has a parent (HTTP 422)\n")
            self.issues[child]["parent"] = int(write.group(1))
            return subprocess.CompletedProcess(argv, 0, json.dumps(self.record(int(write.group(1)))), "")
        line = re.match(r"^%s(\d+)/timeline\?per_page=100$" % re.escape(self.api), path)
        if line:
            self.calls.append(argv)
            return subprocess.CompletedProcess(argv, 0, json.dumps(self.timeline.get(int(line.group(1)), [])), "")
        pull = re.match(r"^repos/%s/pulls/(\d+)$" % re.escape(self.repo), path)
        if pull:
            self.calls.append(argv)
            return subprocess.CompletedProcess(argv, 0, json.dumps(self.pulls[int(pull.group(1))]), "")
        return super().serve(argv, kwargs)


class TestReassign(IntentCase):
    """The Chief of Staff, two orchestrators and a worker that reports to the first; `reassign` hands the worker to the second."""

    def setUp(self):
        super().setUp()
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "gh": FAKE_GH, "intent_repo": FAKE_REPO})
        self.world.add_agent("chief-of-staff", fleet={"role": "chief-of-staff"})
        self.world.add_agent("orch-a", fleet={"role": "orchestrator", "charter": 1})
        self.world.add_agent("orch-b", fleet={"role": "orchestrator", "charter": 10})
        self.world.add_agent("worker", fleet={"role": "coder", "issue": 3, "reports_to": "orch-a"})
        patcher = mock.patch.object(sb, "owner_terminal_problem", return_value=None)   # no test is a terminal; the person check is tested on its own below
        patcher.start()
        self.addCleanup(patcher.stop)
        self.as_agent("chief-of-staff")

    def main(self, *argv):
        def route(argv, **kwargs):
            return self.gh(argv, **kwargs) if argv[0] == FAKE_GH else self.world.route(argv, **kwargs)
        with captured() as (out, err):
            code = sb.main(list(argv), runner=route, now=self.world.clock.now, wait=lambda sock, s: False,
                           socket_call=self.world.herdr.socket)
        return code, out.getvalue(), err.getvalue()

    def as_agent(self, name):
        os.environ["HERDR_PANE_ID"] = self.world.panes[name]

    def boss(self, name="worker"):
        discovery = self.world.new_engine().discover(self.world.clock.now())
        return sb.boss_name(discovery, discovery.agents[name])

    def record(self):
        return Path(self.world.state) / "boss-overrides.json"

    def audit(self, event):
        return [e for e in self.world.audit() if e["event"] == event]

    def reassign(self, *extra, to="orch-b", consent="orch-a"):
        return self.main("reassign", "worker", "--to", to, "--consent-from", consent, *extra)

    def test_s20_with_the_current_bosss_consent_the_boss_changes_and_everyone_is_told(self):
        self.assertEqual(self.boss(), "orch-a")
        code, out, err = self.reassign()
        self.assertEqual((code, err), (0, ""), out)
        self.assertEqual(self.boss(), "orch-b", "1 boss record changed")
        written = self.audit("reassign")
        details = [e.get("detail") or {} for e in written]
        self.assertTrue(details and all(d.get("caller") == "chief-of-staff" and d.get("worker") == "worker" for d in details if d), "audited with the caller and the worker")
        self.assertTrue(any(d.get("from") == "orch-a" and d.get("to") == "orch-b" for d in details))
        self.assertEqual([len(self.world.admissions(n)) for n in ("orch-a", "orch-b", "worker")], [1, 1, 1])
        self.assertEqual(oct(self.record().stat().st_mode & 0o777), "0o600")
        entry = json.loads(self.record().read_text())["overrides"]["worker"]
        self.assertEqual((entry["boss"], entry["was"], entry["original"], entry["by"]), ("orch-b", "orch-a", "orch-a", "chief-of-staff"))

    def test_s20_no_consent_or_the_wrong_consent_or_an_unusable_target_changes_nothing(self):
        self.world.add_agent("coder-x", fleet={"role": "coder", "issue": 4, "reports_to": "orch-b"})
        cases = ((("reassign", "worker", "--to", "orch-b"), "needs --to"),
                 (("reassign", "worker", "--to", "orch-b", "--consent-from", "orch-b"), "CURRENT boss"),
                 (("reassign", "worker", "--to", "orch-b", "--consent-from", "chief-of-staff"), "CURRENT boss"),
                 (("reassign", "worker", "--to", "coder-x", "--consent-from", "orch-a"), "the target coder-x is not an orchestrator"),
                 (("reassign", "worker", "--to", "nobody", "--consent-from", "orch-a"), "the target nobody is not in the current discovery"),
                 (("reassign", "worker", "--to", "orch-a", "--consent-from", "orch-a"), "already reports"),
                 (("reassign", "nobody", "--to", "orch-b", "--consent-from", "orch-a"), "not a fleet agent"),
                 (("reassign", "orch-a", "--to", "orch-b", "--consent-from", "chief-of-staff"), "not a worker"))
        for argv, text in cases:
            with self.subTest(argv=argv):
                code, _, err = self.main(*argv)
                self.assertEqual(code, 2)
                self.assertIn(text, err)
                self.assertFalse(self.record().exists(), "0 changes")
        self.assertEqual(len(self.audit("reassign.refused")), len(cases), "every attempt is audited")
        self.assertEqual(self.boss(), "orch-a")

    def test_s20_a_current_boss_that_is_not_live_cannot_consent(self):
        sid = self.world.sessions.pop("orch-a")
        self.world.v2.sessions[sid]["metadata"]["fleet"]["role"] = "coder"
        code, _, err = self.reassign()
        self.assertEqual(code, 2)
        self.assertIn("the consenting boss orch-a is not an orchestrator", err)
        self.assertFalse(self.record().exists())

    def test_s20_only_the_chief_of_staff_or_the_operator_and_a_refusal_is_audited(self):
        for who in ("orch-a", "orch-b", "worker"):
            with self.subTest(who=who):
                self.as_agent(who)
                code, _, err = self.reassign()
                self.assertEqual(code, 1)
                self.assertIn("only the chief-of-staff or the operator", err)
                self.assertFalse(self.record().exists())
                self.assertEqual(self.main("reassign", "worker", "--undo")[0], 1, "a worker cannot clear one either")
        self.assertEqual(len(self.audit("reassign.refused")), 6)
        os.environ.pop("HERDR_PANE_ID", None)
        with mock.patch.object(sb, "owner_terminal_problem", return_value="not a terminal"):
            self.assertEqual(self.reassign()[0], 1)
        self.assertFalse(self.record().exists())
        self.assertEqual(self.reassign()[0], 0, "the operator at the owner's own terminal may")

    def test_s21_reports_follow_the_new_boss_and_undo_restores_the_old_one(self):
        self.assertEqual(self.reassign()[0], 0)
        before = {n: len(self.world.admissions(n)) for n in ("orch-a", "orch-b")}
        self.as_agent("worker")
        self.assertEqual(self.main("report", "done", "finished the widget")[0], 0)
        after = {n: len(self.world.admissions(n)) for n in ("orch-a", "orch-b")}
        self.assertEqual((after["orch-b"] - before["orch-b"], after["orch-a"] - before["orch-a"]), (1, 0), "1 report to the new boss, 0 to the old")
        self.as_agent("chief-of-staff")
        code, out, _ = self.main("reassign", "worker", "--undo")
        self.assertEqual(code, 0, out)
        self.assertFalse(json.loads(self.record().read_text())["overrides"])
        self.assertEqual(self.boss(), "orch-a")
        before = len(self.world.admissions("orch-a"))
        self.as_agent("worker")
        self.main("report", "done", "and again")
        self.assertEqual(len(self.world.admissions("orch-a")) - before, 1, "after --undo the report goes to the old boss")

    def test_a_second_reassign_keeps_the_launch_boss_for_undo(self):
        self.world.add_agent("orch-c", fleet={"role": "orchestrator", "charter": 11})
        self.reassign()
        self.assertEqual(self.main("reassign", "worker", "--to", "orch-c", "--consent-from", "orch-b")[0], 0)
        self.assertEqual(self.boss(), "orch-c")
        self.main("reassign", "worker", "--undo")
        self.assertEqual(self.boss(), "orch-a")

    def test_an_override_belongs_to_the_session_and_is_ignored_for_another(self):
        ra = sb.load_module("reassign")
        self.reassign()
        fleet = {"name": "worker", "role": "coder", "reports_to": "orch-a"}
        self.assertEqual(ra.overlay(self.world.state, fleet, self.world.sessions["worker"])["reports_to"], "orch-b")
        self.assertEqual(ra.overlay(self.world.state, fleet, "ses_example_other")["reports_to"], "orch-a", "a worker launched again under the name is not affected")

    def test_a_damaged_record_applies_no_override_and_blocks_a_new_one(self):
        ra = sb.load_module("reassign")
        self.reassign()
        self.record().write_text("{not json")
        self.assertEqual(self.boss(), "orch-a", "the launch-time boss applies")
        code, _, err = self.reassign()
        self.assertEqual(code, 2)
        self.assertIn("cannot be used", err)
        self.record().write_text(json.dumps({"overrides": {"worker": {"boss": "../x", "session": "s", "at": 1}, "w2": 5}}))
        self.assertEqual(ra.read_overrides(self.world.state)[0], {}, "an entry with a bad name or shape is dropped")

    def test_the_record_is_bounded_and_stale_entries_are_dropped(self):
        ra = sb.load_module("reassign")
        many = {"w%d" % i: {"boss": "orch-b", "was": "", "original": "", "session": "s", "by": "x", "at": 1.0} for i in range(ra.MAX_ENTRIES + 1)}
        with self.assertRaises(ValueError):
            ra.write_overrides(self.world.state, many)
        fresh = {"keep": {"boss": "b", "at": 1000.0}, "old": {"boss": "b", "at": 1.0}, "gone": {"boss": "b", "at": 1000.0}}
        self.assertEqual(ra.prune(fresh, {"gone": {}}, 1000.0 + ra.MAX_AGE_DAYS * 86400 - 1), 2)
        self.assertEqual(sorted(fresh), ["keep"])

    def test_a_relaunched_worker_does_not_inherit_the_old_sessions_launch_boss(self):
        ra = sb.load_module("reassign")
        self.reassign()
        old = json.loads(self.record().read_text())
        old["overrides"]["worker"]["session"] = "ses_example_previous"   # the override is of an earlier session of the same name
        old["overrides"]["worker"]["original"] = "orch-b"
        self.record().write_text(json.dumps(old))
        self.assertEqual(self.boss(), "orch-a", "the new session reports to its own boss")
        self.world.add_agent("orch-c", fleet={"role": "orchestrator", "charter": 11})
        self.assertEqual(self.main("reassign", "worker", "--to", "orch-c", "--consent-from", "orch-a")[0], 0)
        self.main("reassign", "worker", "--undo")
        self.assertEqual(self.boss(), "orch-a", "undo restores the NEW session's launch boss")

    def test_a_boss_that_changes_between_the_check_and_the_write_refuses_the_command(self):
        ra = sb.load_module("reassign")
        real = ra.locked.__enter__

        def enter(lock):
            result = real(lock)
            ra.write_overrides(self.world.state, {"worker": {"boss": "orch-b", "was": "orch-a", "original": "orch-a",
                                                           "session": self.world.sessions["worker"], "by": "someone", "at": self.world.clock.now()}})
            return result
        with mock.patch.object(ra.locked, "__enter__", enter):
            code, _, err = self.reassign()
        self.assertEqual(code, 2)
        self.assertIn("boss changed while this was being checked", err)

    def test_a_failed_write_a_failed_notice_and_an_undo_without_an_override(self):
        ra = sb.load_module("reassign")
        with mock.patch.object(ra, "write_overrides", side_effect=OSError("disk full")):
            code, _, err = self.reassign()
        self.assertEqual(code, 1)
        self.assertIn("nothing was changed", err)
        self.assertFalse(self.record().exists())
        code, out, err = self.main("reassign", "worker", "--undo")
        self.assertEqual(code, 2)
        self.assertIn("has no override to undo", err)
        with mock.patch.object(sb.Switchboard, "send", side_effect=RuntimeError("herdr is down")):
            code, out, err = self.reassign()
        self.assertEqual(code, 1)
        self.assertIn("the change stands, but these were not told", err)
        self.assertEqual(self.boss(), "orch-b", "the override stands")

    def test_a_retired_workers_override_is_dropped_by_the_next_reassign(self):
        ra = sb.load_module("reassign")
        self.world.add_agent("worker2", fleet={"role": "coder", "issue": 4, "reports_to": "orch-a"})
        self.assertEqual(self.main("reassign", "worker2", "--to", "orch-b", "--consent-from", "orch-a")[0], 0)
        set_retired(self.world.state, {"worker2": {"at": int(self.world.clock.now()), "by": "x", "reason": "done", "session": "s", "auto": False}})
        self.assertEqual(self.reassign()[0], 0)
        self.assertEqual(sorted(ra.read_overrides(self.world.state)[0]), ["worker"], "the retired worker's override is gone")

    def test_a_worker_with_no_override_keeps_its_launch_boss_through_discovery(self):
        self.reassign()
        self.world.add_agent("worker3", fleet={"role": "coder", "issue": 5, "reports_to": "orch-b"})
        self.assertEqual((self.boss("worker3"), self.boss("worker")), ("orch-b", "orch-b"))
        self.main("reassign", "worker", "--undo")
        self.assertEqual((self.boss("worker3"), self.boss("worker")), ("orch-b", "orch-a"))

    def test_typed_text_is_one_clean_bounded_line_in_the_message_and_the_audit(self):
        evil = "orch-a\x1b]0;x\x07" + "y" * 200
        code, _, err = self.main("reassign", "worker", "--to", "orch-b", "--consent-from", evil)
        self.assertEqual(code, 2)
        self.assertNotIn("\x1b", err)
        for e in self.audit("reassign.refused"):
            self.assertNotIn("\x1b", json.dumps(e))
            self.assertLessEqual(len(e["detail"]["consent"]), 64)

    def test_an_expired_override_does_not_apply(self):
        ra = sb.load_module("reassign")
        self.reassign()
        data = json.loads(self.record().read_text())
        data["overrides"]["worker"]["at"] = 1.0
        self.record().write_text(json.dumps(data))
        fleet = {"name": "worker", "reports_to": "orch-a"}
        with mock.patch.object(ra.time, "time", return_value=1.0 + (ra.MAX_AGE_DAYS + 1) * 86400):
            self.assertEqual(ra.overlay(self.world.state, fleet, self.world.sessions["worker"])["reports_to"], "orch-a")

    def test_a_dead_reassigned_workers_new_boss_may_reattach_it_and_the_old_boss_may_not(self):
        self.reassign()
        discovery = self.world.new_engine().discover(self.world.clock.now())
        sid = self.world.sessions["worker"]
        discovery.agents.pop("worker")   # it died: not discovered, its boss comes from the stored session
        engine = self.world.new_engine()
        got = {}
        for who in ("orch-b", "orch-a"):
            self.as_agent(who)
            got[who] = sb.reattach_caller_problem(engine, self.world.route, self.world.clock.now, discovery, "worker", sid)
        self.assertIsNone(got["orch-b"])
        self.assertIn("may not reattach", got["orch-a"])

    def test_a_retired_or_excluded_orchestrator_is_refused_as_the_target_and_as_the_consenting_boss(self):
        set_retired(self.world.state, {"orch-b": {"at": int(self.world.clock.now()), "by": "x", "reason": "done", "session": "s", "auto": False}})
        code, _, err = self.reassign()
        self.assertEqual(code, 2)
        self.assertIn("the target orch-b is retired", err)
        set_retired(self.world.state, {"orch-a": {"at": int(self.world.clock.now()), "by": "x", "reason": "done", "session": "s", "auto": False}})
        code, _, err = self.reassign()
        self.assertEqual(code, 2)
        self.assertIn("the consenting boss orch-a is retired", err)
        set_retired(self.world.state, {})
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "gh": FAKE_GH, "intent_repo": FAKE_REPO, "excluded_repos": [FAKE_REPO]})
        code, _, err = self.reassign()
        self.assertEqual(code, 2)
        self.assertIn("excluded or unknown", err)
        self.assertFalse(self.record().exists(), "0 writes")

    def arm_launch_reminders(self):
        """What `launch` arms for a worker with a checkpoint: a reminder for the worker, and the overdue one for its boss."""
        epoch = self.world.clock.now()
        sb.add_reminder(self.world.state, "worker", epoch + 1800, epoch, "checkpoint due: report now, one line", 3, "orch-a", FAKE_REPO,
                        condition={"while_running": "worker"})
        sb.add_reminder(self.world.state, "orch-a", epoch + 3600, epoch, "worker has not reported since launch: overdue checkpoint", 3, "worker", FAKE_REPO,
                        condition={"unless_report_from": "worker", "since": epoch})

    def overdue_texts(self, name):
        return [t for t in (a["text"] for a in self.world.admissions(name)) if "overdue checkpoint" in t]

    def test_the_overdue_reminder_follows_the_override_and_undo_points_it_back(self):
        self.arm_launch_reminders()
        code, out, err = self.reassign()
        self.assertEqual(code, 0, err)
        self.assertIn("1 overdue reminder(s) of worker now go to orch-b", out)
        self.world.tick(3700)
        self.world.engine.run_pass()
        self.assertEqual((len(self.overdue_texts("orch-b")), len(self.overdue_texts("orch-a"))), (1, 0), "only the new boss is woken")
        self.arm_launch_reminders()   # a second launch of the same arming, to test the undo direction
        sb.remove_reminders(self.world.state, {r["id"] for r in sb.read_reminders(self.world.state) if r["to"] == "orch-a"})
        epoch = self.world.clock.now()
        sb.add_reminder(self.world.state, "orch-b", epoch + 3600, epoch, "worker has not reported since launch: overdue checkpoint", 3, "worker", FAKE_REPO,
                        condition={"unless_report_from": "worker", "since": epoch})
        code, out, err = self.main("reassign", "worker", "--undo")
        self.assertEqual(code, 0, err)
        self.assertIn("overdue reminder(s) of worker now go to orch-a", out)
        self.world.tick(3700)
        self.world.engine.run_pass()
        self.assertEqual(len(self.overdue_texts("orch-a")), 1, "after --undo only the old boss is woken")
        self.assertEqual(len(self.overdue_texts("orch-b")), 1, "and the new boss is not woken a second time")

    def test_a_reminder_file_that_cannot_be_used_is_said_and_the_override_stands(self):
        with mock.patch.object(sb, "read_reminders", side_effect=sb.ReminderError("reminders.json is damaged")):
            code, out, err = self.reassign()
        self.assertEqual(code, 1)
        self.assertIn("overdue reminder was not pointed at orch-b", err)
        self.assertEqual(self.boss(), "orch-b")

    def test_the_command_is_registered_and_starts_the_daemon(self):
        self.assertIn("reassign", sb.build_parser().commands)
        self.assertTrue(getattr(sb.cmd_reassign, "ensure_on_use", False))


class LanesCase(IntentCase):
    """Charter 1 (orch-a) holds asks 2, 4, 5, 6; charter 10 belongs to orch-b. Ask 2 has a worker, a pull request and reminders."""

    ISSUES = {
        "1": {"intent": None}, "10": {"intent": None},
        "2": {"intent": "Fix the agents", "done_when": "both answer", "parent": 1, "labels": ["me:awaiting-cos"]},
        "3": {"intent": "Fix the second one", "parent": 2},
        "4": {"intent": "Second ask", "done_when": "d4", "parent": 1},
        "5": {"intent": "Another ask", "done_when": "d5", "parent": 1},
        "6": {"intent": "Fourth ask", "done_when": "d6", "parent": 1},
        "7": {"intent": "Done ask", "parent": 1, "state": "closed"},
        "11": {"intent": None, "state": "closed"}, "12": {"intent": "A pull request", "pr": True},
        "13": {"intent": "A pull request as an ask", "parent": 10, "pr": True},
    }

    def setUp(self):
        super().setUp()
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "gh": FAKE_GH, "intent_repo": FAKE_REPO})
        self.gh = LaneGH(self.ISSUES, {1, 10, 11}, self.world.clock)
        self.gh.bodies = {}
        self.gh.timeline = {2: [{"event": "cross-referenced", "source": {"issue": {"number": 40, "state": "open", "pull_request": {"url": "https://example.test/pull"}}}},
                                {"event": "cross-referenced", "source": {"issue": {"number": 41, "state": "closed", "pull_request": {"url": "https://example.test/pull"}}}}]}
        self.gh.pulls = {40: {"head": {"sha": "a" * 40, "ref": "switchboard/widget-fix"}, "title": "Fix widget"}}
        self.world.add_agent("chief-of-staff", fleet={"role": "chief-of-staff"})
        self.world.add_agent("orch-a", fleet={"role": "orchestrator", "charter": 1})
        self.world.add_agent("orch-b", fleet={"role": "orchestrator", "charter": 10})
        self.world.add_agent("worker", fleet={"role": "coder", "issue": 3, "reports_to": "orch-a"})
        for when, text in ((100, "check CI on the widget"), (200, "ping the reviewer")):
            sb.add_reminder(self.world.state, "orch-a", EPOCH + when, EPOCH, text, 2, "orch-a", FAKE_REPO)
        sb.add_reminder(self.world.state, "orch-a", EPOCH + 300, EPOCH, "another ask's reminder", 4, "orch-a", FAKE_REPO)

    def main(self, *argv):
        def route(argv, **kwargs):
            return self.gh(argv, **kwargs) if argv[0] == FAKE_GH else self.world.route(argv, **kwargs)
        with captured() as (out, err):
            code = sb.main(list(argv), runner=route, now=self.world.clock.now, wait=lambda sock, s: False,
                           socket_call=self.world.herdr.socket)
        return code, out.getvalue(), err.getvalue()

    def as_agent(self, name):
        os.environ["HERDR_PANE_ID"] = self.world.panes[name]

    def parents(self, number=2):
        return [n for n in self.gh.issues if n in (1, 10) and self.gh.issues[number].get("parent") == n]


class TestAdoption(LanesCase):
    """#838: no orphan workers. Charter 1 is orch-a's, charter 10 orch-b's; the Chief of Staff is `chief-of-staff`."""

    def setUp(self):
        super().setUp()
        patcher = mock.patch.object(sb, "owner_terminal_problem", return_value=None)
        patcher.start()
        self.addCleanup(patcher.stop)
        env = mock.patch.dict(os.environ, {}, clear=False)       # HERDR_PANE_ID and the session variable are restored after each test
        env.start()
        self.addCleanup(env.stop)
        self.as_agent("chief-of-staff")
        self.world.herdr.closed.clear()

    def boss(self, name):
        discovery = self.world.new_engine().discover(self.world.clock.now())
        return sb.boss_name(discovery, discovery.agents[name])

    def worker(self, name, boss, charter=None, issue=None, idle=True):
        fleet = {"role": "coder", "reports_to": boss}
        if charter is not None:
            fleet["charter"] = charter
        if issue is not None:
            fleet["issue"] = issue
        self.world.add_agent(name, fleet=fleet)
        if idle:
            self.world.herdr.panes[self.world.panes[name]]["status"] = "idle"

    def daemon_pass(self):
        engine = self.world.new_engine()
        engine.discover(self.world.clock.now())
        sb.pane_health_pass(engine, self.world.clock.now())   # the daemon's own order (#969): the registry takes what the pass saw BEFORE the adoption pass reads it
        sb.adoption_pass(engine, self.world.clock.now())

    def rows(self, event="boss.adopted"):
        return [e for e in self.world.audit() if e["event"] == event]

    def record_path(self):
        return Path(self.world.state) / "boss-overrides.json"

    def operator(self):
        os.environ.pop("HERDR_PANE_ID", None)
        os.environ.pop(sb.SESSION_ENV, None)

    def as_role(self, name):
        os.environ["HERDR_PANE_ID"] = self.world.panes[name]

    def test_a_pass_gives_every_worker_with_no_live_boss_its_heir_once_and_audits_it(self):   # S1 S6 S7
        self.worker("w1", "gone", charter=1)
        self.worker("w2", None, charter=1)
        self.worker("w3", "ghost", charter=10)
        self.worker("w4", "gone")
        self.daemon_pass()
        self.assertEqual([self.boss(n) for n in ("w1", "w2", "w3", "w4")], ["orch-a", "orch-a", "orch-b", "chief-of-staff"])
        mine = {"w1", "w2", "w3", "w4"}
        self.assertEqual(self.boss("worker"), "orch-a", "a worker with a live boss is not touched")
        rows = [r for r in self.rows() if r["detail"]["worker"] in mine]
        self.assertEqual(sorted((r["detail"]["worker"], r["detail"]["heir"], r["detail"]["path"]) for r in rows),
                         [("w1", "orch-a", "pass"), ("w2", "orch-a", "pass"), ("w3", "orch-b", "pass"), ("w4", "chief-of-staff", "pass")])
        self.assertTrue(all(r["detail"]["why"].startswith("boss gone") and r["detail"]["by"] == sb.ADOPT_BY_DAEMON for r in rows))
        before = len(self.rows())
        self.daemon_pass()
        self.assertEqual(len(self.rows()), before, "a second pass writes nothing")

    def test_no_heir_changes_nothing_and_says_so_once(self):   # S7
        sid = self.world.sessions["chief-of-staff"]
        self.world.v2.sessions[sid]["metadata"]["fleet"]["role"] = "coder"
        self.worker("w4", "gone")
        engine = self.world.new_engine()          # the daemon's engine lives across passes: it remembers it said so
        for _ in range(2):
            engine.discover(self.world.clock.now())
            sb.adoption_pass(engine, self.world.clock.now())
        self.assertFalse(self.record_path().exists(), "0 boss records written")
        self.assertEqual(len([r for r in self.rows("boss.no_heir") if r["detail"]["worker"] == "w4"]), 1)

    def test_a_live_boss_a_forged_live_name_and_another_charters_orchestrator_never_adopt(self):   # S8
        self.worker("forged", "orch-b", charter=1)            # a forged boss name that is a live agent
        self.worker("elsewhere", "orch-a", charter=10)        # live boss; the charter's own orchestrator is another one
        self.daemon_pass()
        self.assertEqual((self.boss("forged"), self.boss("elsewhere")), ("orch-b", "orch-a"))
        self.assertEqual([r for r in self.rows() if r["detail"]["worker"] in ("forged", "elsewhere", "worker")], [], "0 rows, 0 boss records for them")
        self.worker("orphan10", "gone", charter=10)
        self.daemon_pass()
        self.assertEqual(self.boss("orphan10"), "orch-b", "never the orchestrator of another charter")

    def test_a_retired_boss_that_still_has_a_pane_is_not_a_boss(self):   # S1
        self.worker("w1", "orch-a", charter=1)
        self.operator()
        self.assertEqual(self.main("retire", "orch-a")[0], 0)
        self.assertEqual(self.boss("w1"), "chief-of-staff", "orch-a is retired and charter 1 has no other orchestrator")

    def test_retiring_an_orchestrator_re_points_its_workers_in_the_same_command(self):   # S2
        self.world.add_agent("orch-a2", fleet={"role": "orchestrator", "charter": 1})
        self.worker("w1", "orch-a", charter=1)
        self.worker("w2", "orch-a", charter=1)
        self.as_agent("chief-of-staff")
        code, out, err = self.main("retire", "orch-a")
        self.assertEqual(code, 0, err)
        self.assertEqual([self.boss(n) for n in ("w1", "w2", "worker")], ["orch-a2"] * 3, "no daemon pass ran (worker has no charter of its own: its old boss's)")
        rows = self.rows()
        self.assertEqual(sorted(r["detail"]["worker"] for r in rows), ["w1", "w2", "worker"])
        self.assertTrue(all(r["detail"]["path"] == "retire" and r["detail"]["was"] == "orch-a" and r["detail"]["heir"] == "orch-a2" for r in rows))
        self.assertIn("adopted: w1 now reports to orch-a2", out)

    def test_retiring_an_orchestrator_with_no_replacement_gives_its_workers_to_the_chief_of_staff(self):   # S2
        self.worker("w1", "orch-a", charter=1)
        self.main("retire", "orch-a")
        self.assertEqual((self.boss("w1"), self.boss("worker")), ("chief-of-staff", "chief-of-staff"))

    def launch_orchestrator(self, name):
        return self.main("launch", name, "--agent", "coder", "--dir", str(self.home), "--headless", "--role", "orchestrator", "--charter", "1")

    def test_relaunching_an_orchestrator_under_the_same_name_leaves_no_worker_orphaned(self):   # S3
        self.worker("w1", "orch-gone", charter=1)
        code, out, err = self.launch_orchestrator("orch-gone")
        self.assertEqual(code, 0, err)
        self.assertEqual(self.boss("w1"), "orch-gone", "the relaunched agent is the live boss")
        self.assertEqual([r for r in self.rows() if r["detail"]["worker"] == "w1"], [], "nothing needed re-pointing: 0 rows for it")

    def test_a_replacement_orchestrator_inherits_the_workers_of_its_charter(self):   # S4
        self.worker("w1", "orch-a", charter=1)
        del self.world.herdr.panes[self.world.panes["orch-a"]]          # orch-a is gone
        code, out, err = self.launch_orchestrator("orch-new")
        self.assertEqual(code, 0, err)
        self.assertEqual(self.boss("w1"), "orch-new")
        self.assertEqual(sorted((r["detail"]["worker"], r["detail"]["path"]) for r in self.rows()), [("w1", "replace")])   # `worker` has no charter and its boss is gone: the next pass gives it to the Chief of Staff

    def test_moving_an_ask_re_points_its_workers_and_only_its_workers(self):   # S5
        self.worker("other", "orch-a", charter=1, issue=4)
        code, out, err = self.main("move", "2", "--to", "10")
        self.assertEqual(code, 0, err)
        self.assertEqual((self.boss("worker"), self.boss("other")), ("orch-b", "orch-a"))
        (row,) = self.rows()
        self.assertEqual((row["detail"]["worker"], row["detail"]["path"], row["detail"]["heir"]), ("worker", "move", "orch-b"))

    DAMAGED = {"corrupt": b"{not json", "truncated": b'{"overrides": {"w', "a list": b"[]", "a record that is not an object": b'{"overrides": {"w": 5}}',
               "unreadable (a directory)": "dir"}

    def damage(self, file, shape):
        path = Path(self.world.state) / file
        if path.exists() and path.is_dir():
            return
        if path.exists():
            path.unlink()
        if shape == "dir":
            path.mkdir()
        elif file == sb.RETIRED_FILE and shape == b'{"overrides": {"w": 5}}':
            path.write_bytes(b'{"w": 5}')
        else:
            path.write_bytes(shape)

    def test_a_record_that_cannot_be_read_in_full_changes_nothing_for_every_strict_record(self):   # S9 (one case per member of the table, per shape)
        files = [f for f, _ in sb.ADOPT_STRICT_RECORDS]
        self.assertEqual(files, [sb.RETIRED_FILE, "boss-overrides.json"], "the table the code loops over is the list under test")
        for file in files:
            for label, shape in self.DAMAGED.items():
                with self.subTest(file=file, shape=label):
                    self.worker("w-%d" % len(self.world.panes), "gone", charter=1)
                    (Path(self.world.state) / "registry.json").unlink(missing_ok=True)   # #969: the fake service's first-seen rows made a registry; this case is about the OLD records that have no registry yet, which fold from the damaged file
                    self.damage(file, shape)
                    before = {f: ((Path(self.world.state) / f).read_bytes() if (Path(self.world.state) / f).is_file() else None) for f in files}
                    engine = self.world.new_engine()   # the adoption pass alone: the observation pass would fold the old records and write the derived file this case is about
                    engine.discover(self.world.clock.now())
                    sb.adoption_pass(engine, self.world.clock.now())
                    self.assertEqual(self.rows(), [], "no boss written")
                    after = {f: ((Path(self.world.state) / f).read_bytes() if (Path(self.world.state) / f).is_file() else None) for f in files}
                    self.assertEqual(before, after)
                    path = Path(self.world.state) / file
                    if path.is_dir():
                        path.rmdir()
                    elif path.exists():
                        path.unlink()

    def test_an_agent_list_that_cannot_be_read_adopts_nothing(self):   # S9 (the agent list)
        self.worker("w1", "gone", charter=1)
        engine = self.world.new_engine()
        discovery = engine.discover(self.world.clock.now())
        discovery.problems.append("session list failed")
        engine.discovery = discovery
        sb.adoption_pass(engine, self.world.clock.now())
        self.assertEqual(self.rows(), [])
        self.assertEqual(sb.adopt_workers(engine, "pass", "x", discovery)[1][:20], "the agent list canno")

    def test_a_boss_set_between_the_plan_and_the_write_is_never_overwritten(self):   # judged again under the lock
        self.worker("w1", "gone", charter=1)
        real = sb._read_strict_records
        sid = self.world.sessions["w1"]

        def concurrent_reassign(state):
            records = real(state)
            module = sb.load_module("reassign")
            module.write_overrides(state, {"w1": {"boss": "orch-b", "was": "gone", "original": "gone", "session": sid, "by": "chief-of-staff", "at": float(self.world.clock.now())}})
            return records

        with mock.patch.object(sb, "_read_strict_records", concurrent_reassign):
            self.daemon_pass()
        self.assertEqual(self.boss("w1"), "orch-b", "the boss set in the gap stands")
        self.assertEqual([r for r in self.rows() if r["detail"]["worker"] == "w1"], [])

    def retired_orphan(self, name="w1", boss="gone", charter=None):
        self.worker(name, boss, charter=charter)
        self.operator()
        self.assertEqual(self.main("retire", name)[0], 0)
        self.world.herdr.closed.clear()
        self.as_agent("chief-of-staff")

    def test_the_chief_of_staff_adopts_a_retired_orphan_and_closes_it_as_its_boss(self):   # S10
        self.retired_orphan()
        pane = self.world.panes["w1"]
        retired_before = sb.read_retired(self.world.state)["w1"]
        code, out, err = self.main("retire", "w1", "--close")
        self.assertEqual(code, 0, err)
        self.assertEqual(self.world.herdr.closed, [pane])
        (closed,) = self.rows("fleetpane.closed")
        self.assertEqual((closed["subject"], closed["detail"]["pane"], closed["detail"]["by"]), ("w1", pane, "chief-of-staff"))
        self.assertIn("adopted by chief-of-staff", closed["detail"]["boss_rule"])
        self.assertNotIn("command", json.dumps(closed))
        (row,) = self.rows()
        self.assertEqual((row["detail"]["path"], row["detail"]["heir"]), ("close", "chief-of-staff"))
        module = sb.load_module("reassign")
        records = module.read_overrides(self.world.state)[0]
        module.prune(records, sb.read_retired(self.world.state), self.world.clock.now())
        self.assertIn("w1", records, "an adoption of a retired worker survives the housekeeping")

    def test_the_close_stays_refused_for_a_live_worker_a_live_boss_and_another_orchestrator(self):   # S12 U2
        self.worker("live", "gone")                                      # not retired
        self.retired_orphan("w2", "orch-a")                              # retired, boss live
        self.retired_orphan("w3", "gone")                                # retired, boss gone
        cases = [("chief-of-staff", "live"), ("chief-of-staff", "w2"), ("orch-b", "w3")]
        for who, name in cases:
            with self.subTest(who=who, worker=name):
                self.as_agent(who)
                before = {f: ((Path(self.world.state) / f).read_bytes() if (Path(self.world.state) / f).exists() else None) for f in (sb.RETIRED_FILE, "boss-overrides.json")}
                code, out, err = self.main("retire", name, "--close")
                self.assertEqual((code, self.world.herdr.closed), (1, []), err)
                after = {f: ((Path(self.world.state) / f).read_bytes() if (Path(self.world.state) / f).exists() else None) for f in before}
                self.assertEqual(before, after)
        self.assertNotIn("live", sb.read_retired(self.world.state))
        self.as_agent("chief-of-staff")
        self.assertIn("may not close live's pane", self.main("retire", "live", "--close")[2])

    # ---- close-pane
    def bare_world(self, **entry):
        wt = self.home / "wt-bare"
        wt.mkdir(exist_ok=True)
        sb.register_worktree(self.world.state, str(wt), "worker", None, "wt-bare", 1)
        base = {"pane_id": "w1:p90", "cwd": str(wt), "foreground_cwd": str(wt), "revision": 7, "processes": ["zsh"]}
        base.update(entry)
        (Path(self.world.state) / sb.BARE_PANES_FILE).unlink(missing_ok=True)      # nothing remembered of any pane: every case starts as a first run
        self.world.herdr.closed.clear()
        self.world.herdr.plain_terminals = [base]
        return base

    def test_the_chief_of_staff_closes_an_idle_bare_shell_inside_a_fleet_worktree(self):   # S11
        self.bare_world()
        code, out, err = self.main("close-pane", "w1:p90")
        self.assertEqual((code, self.world.herdr.closed), (1, []), "the first run only notes its revision")
        self.assertIn("not been seen idle", err)
        self.world.tick(11 * 60)
        code, out, err = self.main("close-pane", "w1:p90")
        self.assertEqual(code, 0, err)
        self.assertEqual(self.world.herdr.closed, ["w1:p90"])
        (row,) = self.rows("fleetpane.closed")
        self.assertEqual((row["detail"]["by"], row["detail"]["pane"]), ("chief-of-staff", "w1:p90"))
        self.assertTrue(row["detail"]["cwd"].endswith("wt-bare"))
        self.assertNotIn("command", json.dumps(row))

    # (guard, variant) -> (marker the refusal names, what a build WITHOUT the guard does: "closes" or None when another check refuses first)
    GUARD_CASES = {
        ("own-pane", "env"): ("the one you are in", "closes"),
        ("listed", "absent"): ("is not listed", None),
        ("unnamed", "pane-health record only"): ("is named by an agent record", "closes"),
        ("unnamed", "herdr agent list only"): ("is named by an agent record", "closes"),
        ("bare-shell", "a job runs"): ("has a foreground job", "closes"),
        ("bare-shell", "no process reported"): ("has a foreground job", "closes"),
        ("worktree", "outside any worktree"): ("not inside a fleet worktree", "closes"),
        ("worktree", "below an agent's own cwd"): ("not inside a fleet worktree", "closes"),
        ("idle", "first run"): ("not been seen idle", "closes"),
    }

    def break_guard(self, guard, variant):
        """The one fact that makes exactly `guard` fail, in the way `variant` says, on an otherwise closable pane. Returns the pane id."""
        self.bare_world()
        plain = self.world.herdr.plain_terminals[0]
        pane = "w1:p90"
        if guard == "own-pane":
            os.environ["HERDR_PANE_ID"] = pane
            os.environ[sb.SESSION_ENV] = self.world.sessions["chief-of-staff"]
        elif guard == "listed":
            self.world.herdr.plain_terminals = []
        elif guard == "unnamed" and variant == "pane-health record only":
            sb.load_module("registry").upsert(str(self.world.state), "ghost", {"pane": pane, "session": "ses_x"})   # a registry row only: the pane an agent record holds
        elif guard == "unnamed":   # herdr's own agent list names a pane that is no fleet agent (a session with no fleet metadata)
            self.world.herdr.plain_terminals = []
            session = self.world.v2.create_session({})
            pane = self.world.herdr.new_pane_id()
            self.world.herdr.add(pane, session, "idle", program="zsh")
            self.world.herdr.panes[pane].update({"cwd": plain["cwd"], "foreground_cwd": plain["cwd"], "revision": 7})
        elif guard == "bare-shell" and variant == "a job runs":
            plain["processes"] = ["vim"]
        elif guard == "bare-shell":
            plain["processes"] = []
        elif guard == "worktree" and variant == "outside any worktree":
            plain["cwd"] = plain["foreground_cwd"] = "/tmp"
        elif guard == "worktree":   # the owner's shell in a directory below an agent's own cwd (a repository root), not in a registered worktree
            root = self.home / "repo-root"
            (root / "docs").mkdir(parents=True, exist_ok=True)
            sb.load_module("registry").upsert(str(self.world.state), "orch", {"pane": "w9:p9", "session": "ses_y", "cwd": str(root)})
            plain["cwd"] = plain["foreground_cwd"] = str(root / "docs")
        elif guard == "idle":
            pass
        else:
            raise AssertionError("a case with no setup: %s / %s" % (guard, variant))
        return pane

    def close_pane_twice(self, pane):
        self.main("close-pane", pane)
        self.world.tick(11 * 60)
        return self.main("close-pane", pane)

    def check_guard(self, guard, variant):
        marker, without = self.GUARD_CASES[(guard, variant)]
        pane = self.break_guard(guard, variant)
        code, out, err = self.main("close-pane", pane) if guard == "idle" else self.close_pane_twice(pane)
        self.assertEqual((code, self.world.herdr.closed), (1, []), err)
        self.assertIn(marker, err)
        refused = self.rows("fleetpane.close_refused")[-1]
        self.assertIn(marker, refused["detail"]["why"])
        self.assertIn("cwd", refused["detail"])
        mutant = tuple(g for g in sb.BARE_PANE_GUARDS if g[0] != guard)      # the same case on a build without this guard
        with mock.patch.object(sb, "BARE_PANE_GUARDS", mutant):
            code, out, err = self.main("close-pane", pane)          # the first run notes the revision (and closes, when the idle guard is the one removed)
            if not self.world.herdr.closed:
                self.world.tick(11 * 60)
                code, out, err = self.main("close-pane", pane)
        if without == "closes":
            self.assertEqual((code, self.world.herdr.closed), (0, [pane]), "without the %s guard (%s) it closes: %s" % (guard, variant, err))
        else:
            self.assertEqual((code, self.world.herdr.closed), (1, []), "a pane herdr does not have cannot be closed by any build")

    def test_the_guard_table_is_whole_and_every_guard_has_a_case(self):   # S11a completeness
        guards = [g for g, _ in sb.bare_pane_guards()]
        self.assertEqual(guards, ["own-pane", "listed", "unnamed", "bare-shell", "worktree", "idle"])
        self.assertEqual({g for g, _ in self.GUARD_CASES}, set(guards), "every guard has at least one case, and no case names a guard that is not in the table")
        for guard, variant in self.GUARD_CASES:
            self.assertTrue(getattr(type(self), "test_guard_%s__%s" % (guard.replace("-", "_"), re.sub(r"\W+", "_", variant)), None), (guard, variant))

    def test_every_guard_denies_by_default_on_a_missing_empty_or_unreadable_input(self):   # the default-deny table: one row per guard
        base = {"pane": "w1:p90", "entry": {"cwd": "/x", "foreground_cwd": "/x", "revision": 3}, "held": [], "processes": [{"name": "zsh"}], "worktrees": {"/x"},
                "discovery": types.SimpleNamespace(agents={}), "health": {"agents": {}}, "window": 10, "now": 10 ** 6, "seen": {"revision": 3, "since": 0}}
        self.assertEqual([g(base) for _, g in sb.bare_pane_guards()], [None] * 6, "the base case passes every guard")
        denies = {"listed": {"entry": None}, "bare-shell": {"processes": []}, "worktree": {"entry": {}}, "idle": {"seen": None}}
        not_input_guards = {"own-pane": "reads the caller's environment, which has nothing to be missing", "unnamed": "absence of a name IS the pass; its unreadable inputs raise before the guards (tested through the command)"}
        self.assertEqual(set(denies) | set(not_input_guards), {g for g, _ in sb.bare_pane_guards()})
        for guard, change in denies.items():
            for label, ctx in ((guard, dict(base, **change)),):
                self.assertTrue(dict(sb.bare_pane_guards())[guard](ctx), "%s denies on %s" % (guard, change))
        for guard, change in (("worktree", {"entry": {"cwd": "", "foreground_cwd": None}}), ("idle", {"entry": {"cwd": "/x", "foreground_cwd": "/x"}}), ("worktree", {"worktrees": set()})):
            self.assertTrue(dict(sb.bare_pane_guards())[guard](dict(base, **change)), (guard, change))

    def test_an_unreadable_input_of_the_context_refuses_the_close(self):   # unreadable: herdr's pane list, agent list, process list, the pane-health record
        for label, patch in (("pane list", mock.patch.object(sb.HerdrClient, "pane_list", side_effect=sb.HerdrError("down", "herdr is down"))),
                             ("agent list", mock.patch.object(sb.HerdrClient, "agent_list", side_effect=sb.HerdrError("down", "herdr is down"))),
                             ("process list", mock.patch.object(sb.HerdrClient, "pane_process_info", side_effect=sb.HerdrError("down", "herdr is down")))):
            with self.subTest(label):
                self.bare_world()
                self.main("close-pane", "w1:p90")
                self.assertEqual(self.world.herdr.closed, [], "the first run only notes it")
                self.world.tick(11 * 60)
                with patch:
                    code, out, err = self.main("close-pane", "w1:p90")
                self.assertEqual((code, self.world.herdr.closed), (1, []), err)
                self.assertIn("cannot be read", err)
        self.bare_world()
        self.main("close-pane", "w1:p90")
        self.world.tick(11 * 60)
        (Path(self.world.state) / "registry.json").write_bytes(b"{not json")   # the agent list the guards read
        code, out, err = self.main("close-pane", "w1:p90")
        self.assertEqual((code, self.world.herdr.closed), (1, []), err)
        self.assertIn("cannot be read", err)

    def test_a_pane_an_agent_holds_changed_between_looks_or_unreadable_is_never_closed(self):   # S11b
        self.bare_world()
        self.main("close-pane", "w1:p90")
        self.world.tick(11 * 60)
        agent_pane = self.world.panes["worker"]
        code, out, err = self.main("close-pane", agent_pane)
        self.assertEqual((code, self.world.herdr.closed), (1, []), err)
        self.assertIn("named by an agent record", err)
        real, calls = sb.bare_pane_problem, []

        def owner_changes(*args):
            calls.append(1)
            if len(calls) == 2:
                self.world.herdr.plain_terminals[0]["processes"] = ["vim"]   # a job started between the first look and the close
            return real(*args)

        with mock.patch.object(sb, "bare_pane_problem", owner_changes):
            code, out, err = self.main("close-pane", "w1:p90")
        self.assertEqual((len(calls), code, self.world.herdr.closed), (2, 1, []), err)
        with mock.patch.object(sb.HerdrClient, "pane_list", side_effect=sb.HerdrError("down", "herdr is down")):
            code, out, err = self.main("close-pane", "w1:p90")
        self.assertEqual((code, self.world.herdr.closed), (1, []), err)
        self.assertEqual(len(self.rows("fleetpane.close_refused")), 4)

    def test_only_the_chief_of_staff_may_close_a_pane_no_record_names(self):   # S11c
        self.bare_world()
        self.world.add_agent("cos", fleet={"role": "coder"})            # named like the Chief of Staff, without the role
        self.main("close-pane", "w1:p90")
        self.world.tick(11 * 60)
        callers = [("orch-a", None), ("worker", None), ("cos", None), ("chief-of-staff", ("unknown", "an uncertain identity"))]
        for who, kind in callers:
            with self.subTest(who=who):
                self.as_agent(who)
                with mock.patch.object(sb, "gates_caller_kind", return_value=kind) if kind else mock.patch.object(sb, "BARE_PANES_FILE", sb.BARE_PANES_FILE):
                    code, out, err = self.main("close-pane", "w1:p90")
                self.assertEqual((code, self.world.herdr.closed), (1, []), err)
                self.assertIn("only the Chief of Staff", err)
        self.assertEqual(len(self.rows("fleetpane.close_refused")), 5, "each refusal is audited with the caller")

    def test_every_path_in_the_table_is_taken_by_a_real_command_and_no_other_path_is(self):   # the paths table, proved by behaviour
        seen = []
        real_adopt, real_repoint = sb.adopt_workers, sb.repoint_workers
        with mock.patch.object(sb, "adopt_workers", lambda engine, path, *a, **k: (seen.append(path), real_adopt(engine, path, *a, **k))[1]), \
                mock.patch.object(sb, "repoint_workers", lambda engine, names, heir, path, by: (seen.append(path), real_repoint(engine, names, heir, path, by))[1]):
            self.main("move", "2", "--to", "10")                                            # move
            self.worker("w-pass", "gone", charter=10)
            self.daemon_pass()                                                              # pass
            self.main("retire", "orch-a")                                                   # retire
            self.launch_orchestrator("orch-new")                                            # relaunch, replace
            self.retired_orphan("w-close", "gone")
            self.main("retire", "w-close", "--close")                                       # close
        self.assertEqual(set(seen), set(sb.ADOPT_PATHS))
        with self.assertRaises(ValueError):
            sb.write_boss_records(self.world.new_engine(), None, [(None, None, "x", "y")], "invented", "x")

    def test_an_entry_the_boss_record_reader_would_drop_is_kept_when_a_boss_is_written(self):   # the strict table is the base of the write
        self.worker("w1", "gone", charter=1)
        path = self.record_path()
        path.write_text(json.dumps({"overrides": {"stray": {"note": "not a boss entry"}}}))
        self.daemon_pass()
        self.assertEqual(self.boss("w1"), "orch-a")
        self.assertIn("stray", json.loads(path.read_text())["overrides"])

    def test_a_boss_that_is_back_or_an_heir_that_is_gone_since_the_plan_stops_the_write(self):   # judged again under the lock
        self.worker("w1", "orch-late", charter=1)
        real = sb._read_strict_records

        def boss_comes_back(state):
            records = real(state)
            self.world.add_agent("orch-late", fleet={"role": "orchestrator", "charter": 1})
            return records

        with mock.patch.object(sb, "_read_strict_records", boss_comes_back):
            self.daemon_pass()
        self.assertEqual(self.boss("w1"), "orch-late")
        self.assertEqual([r for r in self.rows() if r["detail"]["worker"] == "w1"], [])

    def test_a_damaged_record_stops_every_other_path_too_and_the_problem_is_said(self):   # S9 on retire, launch, move and close
        self.worker("w1", "orch-a", charter=1)
        self.world.herdr.panes[self.world.panes["worker"]]["status"] = "idle"
        (Path(self.world.state) / "boss-overrides.json").write_bytes(b"{not json")
        before = (Path(self.world.state) / "boss-overrides.json").read_bytes()
        code, out, err = self.main("move", "2", "--to", "10")
        self.assertIn("is not valid JSON: no worker was re-pointed", err)
        self.assertEqual(self.boss("worker"), "orch-a")
        code, out, err = self.main("retire", "orch-a")
        self.assertIn("were not re-pointed", err)
        self.assertEqual(self.boss("w1"), "orch-a", "orch-a is retired but its workers keep the record they had")
        code, out, err = self.launch_orchestrator("orch-b2")
        self.assertIn("were not re-pointed", err + out)
        self.retired_orphan("w9", "gone")
        code, out, err = self.main("retire", "w9", "--close")
        self.assertEqual((code, self.world.herdr.closed), (1, []), err)
        self.assertEqual((Path(self.world.state) / "boss-overrides.json").read_bytes(), before)
        self.assertEqual(self.rows(), [])

    def put_retired(self, name, record):   # the registry is the one source (#903); retired.json is derived output, so a hand-written file is never read
        reg = sb.load_module("registry")
        reg.unretire(self.world.state, name)
        reg.retire(self.world.state, name, record["by"], record["reason"], session=record["session"] or None, now=record["at"])
        if not record["session"]:
            reg._mutate(self.world.state, lambda doc: (doc["retired"][name].update(session=record["session"]) or True, [], None))

    def test_a_live_boss_whose_retired_record_names_no_session_keeps_its_worker(self):   # S8: a retirement covers only the session it names
        self.worker("w1", "orch-a", charter=1)
        for label, record in (("no session", {"at": 1, "by": "x", "reason": "r", "session": None}), ("another session", {"at": 1, "by": "x", "reason": "r", "session": "ses_old"}),
                              ("an empty session", {"at": 1, "by": "x", "reason": "r", "session": ""})):
            with self.subTest(label):
                self.put_retired("orch-a", record)
                self.daemon_pass()
                self.assertEqual(self.boss("w1"), "orch-a", "orch-a is live: nothing to fill")
                self.assertEqual([r for r in self.rows() if r["detail"]["worker"] == "w1"], [])
        self.put_retired("orch-a", {"at": 1, "by": "x", "reason": "r", "session": self.world.sessions["orch-a"]})
        self.daemon_pass()
        self.assertEqual(self.boss("w1"), "chief-of-staff", "a retirement that names this session does count (charter 1 has no other orchestrator)")

    def test_a_live_heir_whose_retired_record_names_no_session_is_still_an_heir(self):   # S8: the heir side of the same rule
        self.worker("w1", "gone", charter=1)
        self.put_retired("orch-a", {"at": 1, "by": "x", "reason": "r", "session": None})
        self.daemon_pass()
        self.assertEqual(self.boss("w1"), "orch-a")

    def test_the_caller_is_judged_by_role_not_by_name(self):   # U3 S11c: a real Chief of Staff under another name is allowed, an agent named for the role without it is refused
        self.bare_world()
        sid = self.world.sessions["chief-of-staff"]
        self.world.v2.sessions[sid]["metadata"]["fleet"]["role"] = "coder"            # the agent NAMED chief-of-staff has no role now
        self.world.add_agent("deputy", fleet={"role": "chief-of-staff"})
        self.as_agent("chief-of-staff")
        code, out, err = self.main("close-pane", "w1:p90")
        self.assertEqual((code, self.world.herdr.closed), (1, []))
        self.assertIn("only the Chief of Staff", err)
        self.as_agent("deputy")
        self.main("close-pane", "w1:p90")
        self.world.tick(11 * 60)
        code, out, err = self.main("close-pane", "w1:p90")
        self.assertEqual((code, self.world.herdr.closed), (0, ["w1:p90"]), err)

    def test_only_the_heir_adopts_before_a_close_and_another_caller_adopts_nothing(self):   # S12: adopt_before_close for any caller would pass the other tests
        self.retired_orphan("w1", "gone", charter=1)                       # its heir is orch-a (charter 1), not the Chief of Staff
        before = {f: ((Path(self.world.state) / f).read_bytes() if (Path(self.world.state) / f).exists() else None) for f in (sb.RETIRED_FILE, "boss-overrides.json")}
        self.as_agent("chief-of-staff")
        code, out, err = self.main("retire", "w1", "--close")
        self.assertEqual((code, self.world.herdr.closed), (1, []), err)
        self.assertIn("may not close w1's pane", err)
        self.assertEqual([r for r in self.rows() if r["detail"]["worker"] == "w1"], [], "the Chief of Staff is not its heir: 0 adoption rows")
        self.assertEqual({f: ((Path(self.world.state) / f).read_bytes() if (Path(self.world.state) / f).exists() else None) for f in before}, before)
        self.daemon_pass()                                                   # the next pass gives it to its heir, who then closes it as its boss
        self.as_agent("orch-a")
        code, out, err = self.main("retire", "w1", "--close")
        self.assertEqual(code, 0, err)
        self.assertEqual(self.world.herdr.closed, [self.world.panes["w1"]])
        (row,) = [r for r in self.rows() if r["detail"]["worker"] == "w1"]
        self.assertEqual((row["detail"]["heir"], row["detail"]["path"], row["detail"]["by"]), ("orch-a", "pass", sb.ADOPT_BY_DAEMON))

    # ---- the family: every reader of a worker's boss
    @staticmethod
    def scan(sources):
        """{"file:function"} of every function in the given {file: source text} that reads `reports_to` raw (`.get("reports_to")` or `["reports_to"]`)."""
        import ast
        found = set()
        for rel, text in sources.items():
            def walk(node, stack):
                for child in ast.iter_child_nodes(node):
                    if isinstance(child, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
                        walk(child, stack + [child.name])
                        continue
                    if (isinstance(child, ast.Call) and isinstance(child.func, ast.Attribute) and child.func.attr == "get" and child.args
                            and isinstance(child.args[0], ast.Constant) and child.args[0].value == "reports_to") \
                            or (isinstance(child, ast.Subscript) and isinstance(child.slice, ast.Constant) and child.slice.value == "reports_to"
                                and isinstance(child.ctx, ast.Load)):
                        found.add("%s:%s" % (rel, ".".join(stack[:1] if not stack or not stack[0][0].isupper() else stack[-1:])))
                    walk(child, stack)
            walk(ast.parse(text), [])
        return found

    def sites(self):
        names = ["bin/fleet-switchboard"] + sorted(str(p.relative_to(REPO)) for p in (REPO / "bin").glob("*.py"))
        return self.scan({rel: (REPO / rel).read_text() for rel in names})

    def test_every_reader_of_a_workers_boss_is_in_the_table_and_the_table_has_no_stale_member(self):   # S15
        self.assertEqual(self.sites(), set(sb.BOSS_READ_SITES), "a new raw reader must go through boss_name, or be named in BOSS_READ_SITES with its reason")

    def test_the_scan_finds_a_raw_reader_when_one_is_planted(self):   # S15 mutant: the real scan, fed a planted source, reports it
        planted = {"bin/planted.py": "def load_row(o):\n    return o.fleet.get('reports_to') == 'x'\n\ndef other(o):\n    return o.fleet['reports_to']\n\ndef safe(o):\n    return boss_name(o)\n"}
        self.assertEqual(self.scan(planted), {"bin/planted.py:load_row", "bin/planted.py:other"})
        table = set(sb.BOSS_READ_SITES) | {"bin/planted.py:other"}      # a table that names only one of the two planted readers
        self.assertNotEqual(self.sites() | self.scan(planted), table, "the table test fails on the planted reader the table does not name")

    def test_an_adopted_worker_is_seen_under_its_heir_by_every_behavioural_reader(self):   # S15
        self.worker("w1", "gone", charter=1)
        self.daemon_pass()
        engine = self.world.new_engine()
        discovery = engine.discover(self.world.clock.now())
        obs = discovery.agents["w1"]
        readers = {
            "boss_name": lambda: sb.boss_name(discovery, obs),
            "notice_boss": lambda: sb.notice_boss(engine, "w1"),
            "work rows": lambda: next(r["reports_to"] for r in sb.EngineWorkHost(engine).agents() if r["name"] == "w1"),
            "reattach caller rule (its heir may reattach)": lambda: "orch-a" if (self.as_agent("orch-a"), sb.reattach_caller_problem(engine, self.world.route, self.world.clock.now, discovery, "w1"))[1] is None else None,
        }
        for label, read in readers.items():
            with self.subTest(reader=label):
                self.assertEqual(read(), "orch-a")


for _guard, _variant in TestAdoption.GUARD_CASES:   # S11a: one case (and its mutant) per guard of the table the command loops over, per way it can fail
    setattr(TestAdoption, "test_guard_%s__%s" % (_guard.replace("-", "_"), re.sub(r"\W+", "_", _variant)), (lambda g, v: lambda self: self.check_guard(g, v))(_guard, _variant))


class TestMoveAnAsk(LanesCase):
    def setUp(self):
        super().setUp()
        self.as_agent("chief-of-staff")
        self.before = self.gh.body(2)
        self.before_labels = [l["name"] for l in self.gh.record(2)["labels"]]
        patcher = mock.patch.object(sb, "owner_terminal_problem", return_value=None)   # the tests are no terminal: the person check is patched, and tested below
        patcher.start()
        self.addCleanup(patcher.stop)

    def test_s1_the_ask_changes_parent_and_nothing_else(self):
        code, out, err = self.main("move", "2", "--to", "10")
        self.assertEqual((code, err), (0, ""), out)
        self.assertEqual(self.parents(), [10], "1 parent link, on charter 10")
        self.assertEqual(self.gh.writes, [(10, {"sub_issue_id": 1002, "replace_parent": True})], "one write, the parent link")
        self.assertEqual(getattr(self.gh, "patches", []), [], "0 edits to the ask's body")
        self.assertEqual(self.gh.body(2), self.before)
        self.assertEqual([l["name"] for l in self.gh.record(2)["labels"]], self.before_labels)
        self.assertEqual(getattr(self.gh, "comments", []), [], "0 comments written")
        self.assertEqual(self.gh.issues[2]["intent"], "Fix the agents")
        self.assertIn("moved ask #2 from charter #1 to charter #10", out)

    def test_s2_routing_follows_and_each_orchestrator_gets_one_notice(self):
        self.world.engine.intents = None
        reader = sb.IntentReader(FAKE_GH, FAKE_REPO, self.gh, self.world.clock.now, 5)
        self.assertEqual(reader.parent(2), 1)
        code, out, err = self.main("move", "2", "--to", "10")
        self.assertEqual(code, 0, err)
        reader.invalidate(2)   # what the sub-issue webhook does in the daemon
        self.assertEqual(reader.parent(2), 10)
        self.assertEqual((len(self.world.admissions("orch-a")), len(self.world.admissions("orch-b"))), (1, 1))
        self.assertEqual(self.world.admissions("worker"), [])

    def test_s17_the_handover_note_has_six_sections_and_is_sent_once(self):
        self.main("move", "2", "--to", "10")
        (note,) = [a["text"] for a in self.world.admissions("orch-b")]
        for heading in ("State", "Pull requests and heads", "Branches", "Workers", "Waits", "Reminders"):
            self.assertIn("## %s" % heading, note)
        self.assertIn("#40 at %s" % ("a" * 40), note)
        self.assertNotIn("#41", note, "a closed pull request is not handed over")
        self.assertIn("switchboard/widget-fix", note)
        self.assertIn("worker (reports to orch-a)", note)
        self.assertIn("label: me:awaiting-cos", note)

    def test_s12_the_workers_follow_the_ask_and_the_old_notice_names_them(self):
        self.main("move", "2", "--to", "10")
        sid = self.world.sessions["worker"]
        self.assertEqual(self.world.v2.sessions[sid]["metadata"]["fleet"]["reports_to"], "orch-a", "the session's own metadata is never rewritten")   # #838: the boss RECORD moves the worker, see TestAdoption
        (notice,) = [a["text"] for a in self.world.admissions("orch-a")]
        self.assertIn("worker", notice)
        self.assertIn("they now report to orch-b", notice)

    def test_s15_the_remaining_asks_of_the_old_charter_are_listed(self):
        code, out, _ = self.main("move", "2", "--to", "10")
        self.assertIn("charter #1 still holds 3 open ask(s)", out)
        for number in (4, 5, 6):
            self.assertIn("  #%d  " % number, out)
        self.assertNotIn("  #2  ", out)
        self.assertNotIn("  #7  ", out, "a closed ask is not listed")

    def test_s16_the_old_orchestrators_reminders_on_the_ask_are_carried(self):
        code, out, _ = self.main("move", "2", "--to", "10")
        self.assertIn("reminders: 2 carried", out)
        held = {(r["issue"], r["to"]) for r in sb.read_reminders(self.world.state)}
        self.assertEqual(held, {(2, "orch-b"), (4, "orch-a")}, "0 on the old orchestrator for the moved ask; another ask's reminder stays")

    def test_s16_without_a_new_orchestrator_they_are_cancelled(self):
        self.world.engine = None
        sid = self.world.sessions.pop("orch-b")
        self.world.v2.sessions[sid]["metadata"]["fleet"]["role"] = "coder"
        code, out, _ = self.main("move", "2", "--to", "10")
        self.assertIn("reminders: 2 cancelled", out)
        self.assertIn("no orchestrator is running charter #10", out)
        self.assertEqual([r["issue"] for r in sb.read_reminders(self.world.state)], [4])

    def block_named(self):
        """The live shape: the orchestrators carry no charter number in their metadata; each charter's own block names its orchestrator."""
        for name in ("orch-a", "orch-b"):
            fleet = self.world.v2.sessions[self.world.sessions[name]]["metadata"]["fleet"]
            del fleet["charter"]
            fleet["repo"] = FAKE_REPO
            sb.load_module("registry").set_charter(self.world.state, name, None, "test")   # #969: nor does the registry row: the charter's own block names the orchestrator
        self.gh.bodies = {1: "```yaml\norchestrator: orch-a\nstatus: active\n```\n", 10: "```yaml\norchestrator: orch-b\nstatus: active\n```\n"}

    def notice_lines(self):
        return [e for e in self.world.audit() if e["event"] == "lanes.move.notice"]

    def test_s1_orchestrators_named_only_by_the_charter_block_are_told_and_audited(self):
        self.block_named()
        code, out, err = self.main("move", "2", "--to", "10")
        self.assertEqual((code, err), (0, ""), out)
        (note,) = [a["text"] for a in self.world.admissions("orch-b")]
        self.assertEqual(sum("## %s" % h in note for h in sb.load_module("lanes").HANDOVER_SECTIONS), 6)
        self.assertEqual(len(self.world.admissions("orch-a")), 1)
        lines = self.notice_lines()
        self.assertEqual(sorted((l["detail"]["recipient"], l["detail"]["outcome"]) for l in lines), [("orch-a", "sent"), ("orch-b", "sent")])
        self.assertIn("reminders: 2 carried", out)
        held = {(r["issue"], r["to"]) for r in sb.read_reminders(self.world.state)}
        self.assertEqual(held, {(2, "orch-b"), (4, "orch-a")}, "the reminders follow the block-named orchestrator")

    def test_s5_a_charter_block_that_names_no_live_orchestrator_falls_back_to_the_metadata(self):
        self.gh.bodies = {10: "```yaml\norchestrator: nobody-here\n```\n"}
        code, out, err = self.main("move", "2", "--to", "10")
        self.assertEqual((code, len(self.world.admissions("orch-b"))), (0, 1), err)

    def skipped_for_new(self):
        code, out, err = self.main("move", "%s#2" % FAKE_REPO, "--to", "%s#10" % FAKE_REPO)
        self.assertEqual((code, self.parents(), self.world.admissions("orch-b")), (1, [10], []), err + out)
        self.assertEqual([l["detail"]["outcome"] for l in self.notice_lines() if l["detail"]["role"] == "new orchestrator"], ["skipped"])

    def test_a_body_naming_an_orchestrator_of_another_repository_tells_no_one(self):
        self.block_named()
        fleet = self.world.v2.sessions[self.world.sessions["orch-b"]]["metadata"]["fleet"]
        fleet["repo"] = "other-org/other-repo"
        self.skipped_for_new()

    def test_a_prose_line_before_the_block_does_not_name_the_orchestrator(self):
        self.block_named()
        self.gh.bodies[10] = "Notes:\norchestrator: orch-b\n\n```yaml\norchestrator: platform\n```\n"
        self.skipped_for_new()

    def test_a_body_naming_a_coder_tells_no_one(self):
