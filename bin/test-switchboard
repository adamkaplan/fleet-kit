    def test_review_laws_prints_fleet_kits_own_root_files_from_the_base_commit(self):
        for name in ("REVIEW_LAWS.md", "CODING_STANDARDS.md", "SECURITY_STANDARDS.md", "TEST_STANDARDS.md"):
