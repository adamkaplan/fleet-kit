def mutate(change):
    obj = copy.deepcopy(VALID)
    change(obj)
    return obj


def _set(path, value):
    def change(obj):
        target = obj
        for part in path[:-1]:
            target = target[part]
        target[path[-1]] = value
    return change


def _drop(path):
    def change(obj):
        target = obj
        for part in path[:-1]:
            target = target[part]
        del target[path[-1]]
    return change


