                     ("api", "repositories/123")):
            with self.subTest(args=args):
                done, seen = self.read_repo_run(args)
                self.assertEqual(done.returncode, 1, done.stderr)
                self.assertIsNone(seen)

    def test_s4_hostile_spellings_and_an_unreadable_record_are_refused_and_no_call_reaches_github(self):
        hostile = ("ACME-ORG/WIDGET-API", "Acme-Org/widget-api", " acme-org/widget-api", "acme-org/widget-api ", "acme-org/widget-api.git", "acme-org/*", "",
                   "acme-org/widget-api/", "acme-org/widget\u0430pi", "acme-\u212aorg/widget-api", "https://github.com/acme-org/widget-api.git/x/../../other", "acme-org/../widget-api",
                   "./acme-org/widget-api", "acme-org//widget-api")
        for spelling in hostile:
            with self.subTest(spelling=spelling):
                done, seen = self.read_repo_run(("issue", "view", "5", "-R", spelling))
                self.assertEqual(done.returncode, 1, done.stderr)
                self.assertIsNone(seen)
        for record in ('false', '""', '7', 'null', '["acme-org/widget-api"]', '"Acme-Org/Widget-Api"', '"acme-org/*"'):
            for args in (("issue", "view", "5"), ("issue", "view", "5", "-R", "acme-org/widget-api"), ("issue", "comment", "5", "--body", "x")):
                with self.subTest(record=record, args=args):
                    done, seen = self.read_repo_run(args, read_repo=record)
                    self.assertEqual(done.returncode, 1, done.stderr)
                    self.assertIsNone(seen)
        done, seen = self.read_repo_run(("issue", "view", "5", "-R", "acme-org/widget-api"), users={"acme-org/widget-service": "acme-dev"}, tokens=self.READ_TOKENS)
        self.assertEqual(done.returncode, 1, "a read repository whose account is not mapped is refused, never read as the inherited account")
        self.assertIsNone(seen)
        done, seen = self.read_repo_run(("issue", "view", "5", "-R", "acme-org/widget-api"), tokens={"acme-dev": "tok-dev"})
        self.assertEqual(done.returncode, 1, "no token for the read repository's account: refused")
        self.assertIsNone(seen)

    def test_an_unexpected_error_on_a_read_repository_call_refuses_and_the_same_error_without_one_is_as_before(self):
        """#618 PC-2: for a call that carries a read_repo, ANY unexpected exception in account_env refuses (never the inherited or stored token), one line naming the
        cause class; the same exception on a call without read_repo keeps today's answer (None). One case per distinct failing step of the read route."""
        patcher = mock.patch.dict(os.environ)   # restores the whole environment afterwards
        patcher.start()
        self.addCleanup(patcher.stop)
        for name in ("FLEET_SWITCHBOARD_OWN_GH", "GH_TOKEN", "GITHUB_TOKEN", "GH_ENTERPRISE_TOKEN"):
            os.environ.pop(name, None)   # sb.main sets the switchboard's own-gh marker in-process and earlier tests leave it set: with it the shim (by design) leaves a call alone

        class Boom(Exception):
            pass

        def raiser(*a, **k):
            raise Boom("secret-looking detail")

        def matcher(account_for):
            return type("M", (), {"account_for": staticmethod(account_for), "normal_repo": staticmethod(lambda r: r)})

        class Lk:
            failed = False

            def __init__(self, run):
                self.run = run

            def identity(self):
                return {"name": "api", "repo": "acme-org/widget-service", "own": True}

        users = lambda: dict(self.READ_USERS)
        steps = {   # step: (config_users, load_matcher, Lookup.run)
            "config": (raiser, lambda: matcher(lambda u, r: "acme-bot"), lambda *a, **k: None),
            "matcher": (users, lambda: matcher(raiser), lambda *a, **k: None),
            "token": (users, lambda: matcher(lambda u, r: "acme-bot"), raiser),
        }
        for step, (cfg, load, run) in steps.items():
            for label, extra in (("read", {"read_repo": "acme-org/widget-api"}), ("plain", {})):
                with self.subTest(step=step, call=label):
                    shim = self.shim()
                    shim.config_users, shim.load_matcher, shim.switchboard_binary = cfg, load, lambda: "sb"
                    args = ["issue", "view", "5"] + (["-R", "acme-org/widget-api"] if extra else [])
                    if extra:
                        with self.assertRaises(shim.AppMintRefused) as ctx:
                            shim.account_env("gh", Lk(run), args=args, **extra)
                        self.assertIn("Boom", str(ctx.exception))
                        self.assertNotIn("secret-looking", str(ctx.exception))
                    else:
                        self.assertIsNone(shim.account_env("gh", Lk(run), args=args))

    def test_groups_that_reach_any_repository_without_naming_one_and_attached_or_missing_flag_values_are_refused(self):
        for args in (("search", "code", "x"), ("search", "issues", "x", "--owner", "acme-org"), ("gist", "view", "abc"), ("status",), ("alias", "list"),
                     ("issue", "view", "5", "-Racme-org/other"), ("issue", "view", "5", "-R"), ("issue", "view", "5", "-R", "")):
            with self.subTest(args=args):
                done, seen = self.read_repo_run(args)
                self.assertEqual(done.returncode, 1, done.stderr)
                self.assertIsNone(seen)
        done, seen = self.read_repo_run(("issue", "view", "5", "-Racme-org/widget-api"))
        self.assertEqual((done.returncode, seen["token"]), (0, "tok-bot"), done.stderr)

    def test_an_api_path_that_walks_out_of_the_read_repository_is_refused_in_every_spelling(self):
        base = "repos/acme-org/widget-api"
        for tail in ("/../widget-service/issues", "/../../other/x", "/%2e%2e/other", "/%2E%2E/other", "/%2e./other", "/.%2E/other", "//issues", "/issues/..",
                     "/issues/.", "\\..\\other", "/%2f..%2fother", "/issues/%2E%2E"):
            for prefix in ("", "/", "https://api.github.com/"):
                with self.subTest(path=prefix + base + tail):
                    done, seen = self.read_repo_run(("api", prefix + base + tail))
                    self.assertEqual(done.returncode, 1, done.stderr)
                    self.assertIsNone(seen)
        for args in (("api", "--preview", "user", "repos/acme-org/other/issues"), ("api", "-p", "meta", "repos/acme-org/other/issues"), ("api", "--preview=user", "repos/acme-org/other/issues"),
                     ("api", "--unknown", "user", "repos/acme-org/other/issues"), ("api", "user", "repos/acme-org/other/issues"), ("api", "repos/acme-org/widget-api/issues", "extra"),
                     ("api",), ("api", "-H", "A: b", "-p", "user", "repos/acme-org/other/x")):
            with self.subTest(args=args):
                done, seen = self.read_repo_run(args)
                self.assertEqual(done.returncode, 1, done.stderr)
                self.assertIsNone(seen)
        done, seen = self.read_repo_run(("api", "-p", "x", "repos/acme-org/widget-api/issues"))
        self.assertEqual((done.returncode, seen["token"]), (0, "tok-bot"), done.stderr)
        done, seen = self.read_repo_run(("api", "repos/acme-org/widget-api/issues?per_page=5"))
        self.assertEqual((done.returncode, seen["token"]), (0, "tok-bot"), done.stderr)

    def test_s6_a_worker_without_a_read_repository_is_untouched_by_the_guard(self):
        for args in (("issue", "view", "5", "-R", "acme-org/other"), ("api", "graphql", "-f", "query=x"), ("issue", "comment", "5", "-R", "acme-org/other", "--body", "x")):
