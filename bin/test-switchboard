class TestScenarioValidator(unittest.TestCase):
    def test_the_full_fixture_is_valid(self):
        self.assertEqual(sc.validate(copy.deepcopy(VALID)), [])

    def test_valid_alternatives(self):
        alternatives = [
            _set(["problem"], None),
            _set(["control"], {"baseline": "fleet-heartbeat", "fails": ["no_machine_turn"]}),
            _set(["control"], {"variant": {"steps": {"1": {"text": "x"}}, "expect": {"one-note": {"count": 2}}},
                               "fails": ["one-note"]}),
            _set(["steps"], []),
            _drop(["issues"]),
            _drop(["tags"]),
            _set(["tiers"], ["lab-model"]),
            _set(["tags"], ["spike"]),
        ]
        for change in alternatives:
            obj = mutate(change)
            with self.subTest(obj={k: obj.get(k) for k in ("problem", "control", "steps", "tiers")}):
                self.assertEqual(sc.validate(obj), [])

    def test_each_rule_rejects_its_fixture(self):
        for what, change, needle in REJECTED:
            with self.subTest(what=what):
                errors = sc.validate(mutate(change))
                self.assertTrue(errors, "accepted: %s" % what)
                self.assertTrue(any(needle in e for e in errors), "%s: %s" % (what, errors))

    def test_every_required_key_is_required(self):
        for key in sc.REQUIRED:
            with self.subTest(key=key):
                self.assertIn("%s: required" % key, sc.validate(mutate(_drop([key]))))

    def test_not_an_object(self):
        self.assertEqual(sc.validate([VALID]), ["scenario: must be a JSON object"])

    def test_every_documented_value_is_accepted(self):
        for do in sc.ACTIONS:
            for actor in sc.STEP_ACTORS[do]:
                step = {"at": "0s", "actor": "coder" if actor == "cast" else actor, "do": do, "why": "a comment"}
                step.update(STEP_EXAMPLES[do])
                if do == "permission" and actor == "cast":
                    step = {k: v for k, v in step.items() if k not in ("to", "decision")}
                self.assertEqual(sc.validate(mutate(_set(["steps", 0], step))), [], (do, actor))
        for that in sc.EXPECTATIONS:
            item = {"that": that, "why": "a comment"}
            item.update(EXPECT_EXAMPLES[that])
            self.assertEqual(sc.validate(mutate(_set(["expect", 2], item))), [], that)
        for name in DOC_FAULTS:
            self.assertEqual(sc.validate(mutate(_set(["control", "fault"], name))), [], name)

    def test_every_field_checked_kind_has_an_example(self):
        self.assertEqual(sorted(STEP_EXAMPLES), sorted(sc.STEP_FIELDS))
        self.assertEqual(sorted(EXPECT_EXAMPLES), sorted(sc.EXPECT_FIELDS))

    def test_every_tier_is_checked_field_by_field(self):
        # One vocabulary: a Lab-only scenario has no fields of its own.
        for tiers in (["offline"], ["lab-scripted"], ["lab-model"]):
            with self.subTest(tiers=tiers):
                errors = sc.validate(mutate(lambda o: (o.update(tiers=tiers),
                                                       o["steps"][0].update(script="sleep=5 reply=DONE"),
                                                       o["expect"][0].update(role="user"))))
                self.assertTrue(any("unknown field 'script'" in e for e in errors), errors)
                self.assertTrue(any("unknown field 'role'" in e for e in errors), errors)

    def test_a_variant_is_patched_in_and_the_result_checked(self):
        patched = sc.apply_variant(VALID, {"steps": {"1": {"text": "x"}}, "expect": {"one-note": {"count": 2},
                                                                                   "1": {"why": "w"}}})
        self.assertEqual((patched["steps"][1]["text"], patched["expect"][0]["count"], patched["expect"][1]["why"]),
                         ("x", 2, "w"))
        self.assertEqual(VALID["steps"][1]["text"], "status?", "the scenario itself is not changed")
        for variant, needle in (({"cast": {}}, "unknown key"), ({"steps": {"9": {"text": "x"}}}, "not the index"),
                                ({"steps": {"one": {"text": "x"}}}, "not the index"),
                                ({"expect": {"nobody": {"count": 2}}}, "matches no expectation"),
                                ({"steps": {"1": {}}}, "non-empty object"), ("x", "must be an object")):
            with self.subTest(variant=variant):
                with self.assertRaises(sc.VariantError) as caught:
                    sc.apply_variant(VALID, variant)
                self.assertIn(needle, str(caught.exception))

    def test_durations(self):
        self.assertEqual([sc.duration_seconds(t) for t in ("0s", "10s", "2m", "2h", "150s")],
                         [0, 10, 120, 7200, 150])
        for bad in ("", "1.5s", "-1s", "1 s", "1d", None, 3):
            self.assertIsNone(sc.duration_seconds(bad), bad)


class TestScenarioFiles(Base):
    def put(self, name, obj, directory=None):
        directory = directory or self.home / "scenarios"
        directory.mkdir(parents=True, exist_ok=True)
        path = directory / name
        path.write_text(obj if isinstance(obj, str) else json.dumps(obj))
        return path

    def test_load_and_load_dir(self):
        self.put("n1.json", VALID)
        self.put("w1.json", mutate(_set(["id"], "W1")))
        self.put("README.md", "not a scenario")
        self.assertEqual(sc.load(self.home / "scenarios" / "n1.json")["id"], "N1")
        self.assertEqual([s["id"] for s in sc.load_dir(self.home / "scenarios")], ["N1", "W1"])
        self.put("x1.json", mutate(_set(["id"], "x")))
        with self.assertRaises(sc.ScenarioError) as caught:
            sc.load_dir(self.home / "scenarios")
        self.assertIn("x1.json", str(caught.exception))

    def test_load_dir_refuses_a_repeated_id(self):
        self.put("a.json", VALID)
        self.put("b.json", VALID)
        with self.assertRaises(sc.ScenarioError):
            sc.load_dir(self.home / "scenarios")

    def test_load_refuses_bad_json(self):
        with self.assertRaises(sc.ScenarioError):
            sc.load(self.put("bad.json", "{"))

    def test_coverage_lists_every_problem(self):
        scenarios = [mutate(_set(["id"], "A%d" % n)) for n in range(3)]
        scenarios[1]["problem"] = 1
        scenarios[2]["problem"] = None
        self.assertEqual(sc.coverage(scenarios), {1: ["A1"], 2: [], 3: ["A0"], 4: []})

    def test_validate_cli_exit_codes(self):
        good = self.put("n1.json", VALID)
        self.assertEqual(self.run_cli(SCENARIO, "validate", str(good)).returncode, 0)
        self.assertEqual(self.run_cli(SCENARIO, "validate", str(good.parent)).returncode, 0)
        bad = self.put("bad.json", mutate(_set(["since_pr"], 0)), self.home / "bad")
        proc = self.run_cli(SCENARIO, "validate", str(bad))
        self.assertEqual(proc.returncode, 1)
        self.assertIn("since_pr", proc.stderr)
        self.assertNotIn("Traceback", proc.stderr)
        self.assertEqual(self.run_cli(SCENARIO, "validate", str(self.put("j.json", "{", self.home / "j"))).returncode, 1)
        self.assertEqual(self.run_cli(SCENARIO, "validate", str(self.home / "missing.json")).returncode, 1)
        empty = self.home / "empty"
        empty.mkdir()
        self.assertEqual(self.run_cli(SCENARIO, "validate", str(empty)).returncode, 0)
        self.assertEqual(self.run_cli(SCENARIO, "frobnicate").returncode, 2)

    def test_validate_cli_refuses_a_repeated_id_across_files(self):
        self.put("a.json", VALID, self.home / "dup")
        self.put("b.json", VALID, self.home / "dup")
        proc = self.run_cli(SCENARIO, "validate", str(self.home / "dup"))
        self.assertEqual(proc.returncode, 1)
        self.assertIn("also used by", proc.stderr)

    def test_validate_cli_defaults_to_the_repo_scenarios(self):
        proc = self.run_cli(SCENARIO, "validate")
        self.assertEqual(proc.returncode, 0, proc.stdout + proc.stderr)
        self.assertEqual(sc.DEFAULT_DIR, REPO / "scenarios" / "switchboard")

    def test_list_and_coverage_cli(self):
        directory = self.home / "scenarios"
        for n, problem in enumerate((1, 2, 3)):
            self.put("a%d.json" % n, mutate(lambda o, n=n, p=problem: (o.update(id="A%d" % n, problem=p))))
        listing = self.run_cli(SCENARIO, "list", "--dir", str(directory))
        self.assertEqual(listing.returncode, 0)
        self.assertIn("A2", listing.stdout)
        self.assertEqual(self.run_cli(SCENARIO, "coverage", "--dir", str(directory)).returncode, 0)
        enforced = self.run_cli(SCENARIO, "coverage", "--enforce", "--dir", str(directory))
        self.assertEqual(enforced.returncode, 1)
        self.assertIn("problem(s) 4", enforced.stderr)
        self.put("a3.json", mutate(lambda o: o.update(id="A3", problem=4)))
        self.assertEqual(self.run_cli(SCENARIO, "coverage", "--enforce", "--dir", str(directory)).returncode, 0)
        self.put("bad.json", "{")
        self.assertEqual(self.run_cli(SCENARIO, "list", "--dir", str(directory)).returncode, 1)


# --------------------------------------------------------------------- the CLI

def routed(v2=(0, '{"data": {"version": "2.0.22"}}', ""), herdr=(0, '{"result": {"agents": [{}, {}]}}', "")):
    """A runner that answers the configured v2 binary and herdr differently."""
    def route(argv):
        return v2 if argv[1:2] == ["api"] else herdr
    return FakeRunner(route=route)


class TestStatus(Base):
    def status(self, runner, *argv):
        with captured() as (out, err):
            code = sb.main(["status", *argv], runner=runner)
        return code, out.getvalue(), err.getvalue()

    def test_all_ok(self):
        self.write_config({"opencode": "/opt/lab/bin/opencode", "herdr": "/opt/herdr"})
        runner = routed()
        code, out, err = self.status(runner)
        self.assertEqual(code, 0, out)
        self.assertIn("version 2.0.22", out)
        self.assertIn("2 agent(s)", out)
        self.assertEqual(err, "")
        self.assertEqual([argv for argv, _ in runner.calls],
                         [["/opt/lab/bin/opencode", "api", "server.info"], ["/opt/herdr", "agent", "list"]])
        self.assertEqual(stat.S_IMODE(self.state_dir.stat().st_mode), 0o700)

    def test_unconfigured_v2_is_reported_and_never_run(self):
        # A bare name would be resolved through PATH, which can find OpenCode v1.
        runner = routed()
        code, out, _ = self.status(runner)
        self.assertEqual(code, 1)
        self.assertRegex(out, r"(?m)^ERROR v2 +not configured: ")
        self.assertEqual([argv[0] for argv, _ in runner.calls], ["herdr"])

    def test_failures_are_one_line_each_and_exit_1(self):
        self.write_config({"opencode": "/opt/lab/bin/opencode"})
        runner = routed(v2=(1, '{"name":"ServiceUnavailable"}', "HTTP 503 Service Unavailable\n"),
                        herdr=FileNotFoundError(2, "No such file or directory"))
        code, out, err = self.status(runner)
        self.assertEqual(code, 1)
        self.assertRegex(out, r"(?m)^ERROR v2 +http 503: ")
        self.assertRegex(out, r"(?m)^ERROR herdr +unavailable: ")
        self.assertNotIn("Traceback", out + err)

    def test_json_report(self):
        self.write_config({"opencode": "/opt/lab/bin/opencode"})
        runner = routed(v2=subprocess.TimeoutExpired(["opencode"], 20), herdr=(0, "garbage", ""))
        code, out, _ = self.status(runner, "--json")
        self.assertEqual(code, 1)
        report = json.loads(out)
        self.assertFalse(report["ok"])
        self.assertIn("timeout", report["v2"]["error"])
        self.assertIn("bad_json", report["herdr"]["error"])
        self.assertTrue(report["config"]["ok"])
        self.assertTrue(report["state_dir"]["ok"])

    def test_an_unexpected_exception_is_still_one_line(self):
        self.write_config({"opencode": "/opt/lab/bin/opencode"})
        runner = routed(v2=RuntimeError("boom"))
        code, out, err = self.status(runner)
        self.assertEqual(code, 1)
        self.assertIn("unexpected RuntimeError: boom", out)
        self.assertNotIn("Traceback", out + err)

    def test_bad_config_skips_the_probes_and_says_why(self):
        self.write_config({"batch_seconds": "soon"})
        runner = routed()
        code, out, _ = self.status(runner)
        self.assertEqual(code, 1)
        self.assertIn("batch_seconds", out)
        self.assertIn("not checked: config unusable", out)
        self.assertEqual(runner.calls, [])

    def test_open_state_dir_and_bad_fault_are_reported(self):
        self.state_dir.mkdir(parents=True)
        os.chmod(str(self.state_dir), 0o755)
        os.environ[sb.FAULT_ENV] = "no-such-fault"
        code, out, _ = self.status(routed())
        self.assertEqual(code, 1)
        self.assertRegex(out, r"(?m)^ERROR state +state directory must be private")
        self.assertRegex(out, r"(?m)^ERROR lab +.*no-such-fault")

    def test_env_values_are_never_printed(self):
        self.write_config({"opencode_env": {"OPENCODE_SERVER_PASSWORD": "pw-value-123"}})
        for argv in ((), ("--json",)):
            _, out, err = self.status(routed(), *argv)
            self.assertNotIn("pw-value-123", out + err)
            self.assertIn("OPENCODE_SERVER_PASSWORD", out)

    def test_lab_faults_are_shown(self):
        self.write_config({"opencode": "/opt/lab/bin/opencode"})
        os.environ[sb.LAB_ENV] = "1"
        os.environ[sb.FAULT_ENV] = "no-batch"
        code, out, _ = self.status(routed())
        self.assertEqual(code, 0)
        self.assertIn("faults requested: no-batch", out)

    def test_real_process_with_failing_fakes_prints_no_traceback(self):
        opencode = self.fake_bin("opencode", "echo '{\"name\":\"Down\"}'\necho 'HTTP 502 Bad Gateway' >&2\nexit 1\n")
        herdr = self.fake_bin("herdr", "echo 'not json'\n")
        self.write_config({"opencode": str(opencode), "herdr": str(herdr), "call_timeout_seconds": 5})
        proc = self.run_cli(SWITCHBOARD, "status")
        self.assertEqual(proc.returncode, 1, proc.stdout + proc.stderr)
        self.assertRegex(proc.stdout, r"(?m)^ERROR v2 +http 502")
        self.assertRegex(proc.stdout, r"(?m)^ERROR herdr +bad_json")
        self.assertNotIn("Traceback", proc.stdout + proc.stderr)
        missing = self.home / "absent-binary"
        self.write_config({"opencode": str(missing), "herdr": str(missing)})
        proc = self.run_cli(SWITCHBOARD, "status", "--json")
        self.assertEqual(proc.returncode, 1)
        self.assertEqual(json.loads(proc.stdout)["v2"]["ok"], False)
        self.assertNotIn("Traceback", proc.stdout + proc.stderr)

    def test_real_process_with_working_fakes(self):
        opencode = self.fake_bin("opencode", "echo '{\"data\":{\"version\":\"2.0.22\"}}'\n")
        herdr = self.fake_bin("herdr", "echo '{\"result\":{\"agents\":[]}}'\n")
        self.write_config({"opencode": str(opencode), "herdr": str(herdr)})
        proc = self.run_cli(SWITCHBOARD, "status")
        self.assertEqual(proc.returncode, 0, proc.stdout + proc.stderr)

    def test_version_and_usage_exit_codes(self):
        proc = self.run_cli(SWITCHBOARD, "version")
        self.assertEqual(proc.returncode, 0)
        self.assertEqual(proc.stdout.strip(), "fleet-switchboard %s" % sb.VERSION)
        self.assertEqual(self.run_cli(SWITCHBOARD).returncode, 2)
        self.assertEqual(self.run_cli(SWITCHBOARD, "deliver").returncode, 2)
        self.assertEqual(self.run_cli(SWITCHBOARD, "status", "--bogus").returncode, 2)


# ------------------------------------------------- stateful fakes of v2 and herdr

EPOCH = 1800000000.0  # where every simulated clock starts
FAKE_OPENCODE = "/fake/bin/opencode"
FAKE_HERDR = "/fake/bin/herdr"


class SimClock:
    """Simulated time. Nothing in these tests sleeps."""

    def __init__(self, start=EPOCH):
        self.t = float(start)

    def now(self):
        return self.t

    def ms(self, at=None):
        return int(round((self.t if at is None else at) * 1000))


class FakeHTTP(Exception):
    def __init__(self, status, name, message):
        super().__init__(message)
        self.status, self.name, self.message = status, name, message


class Enveloped(list):
    """A list a fake operation returns with the rest of v2's answer beside `data`."""

    envelope = None


def _record_keys(record):
    """Keys of a transcript message (`metadata`) or an inbox item (`payload.metadata`)."""
    meta = record.get("metadata") or (record.get("payload") or {}).get("metadata") or {}
    keys = (meta.get("fleet") or {}).get("keys")
    return list(keys) if isinstance(keys, list) else []


class FakeV2:
    """`opencode api` with the spike-verified semantics (docs/switchboard.md, S2-S5).

    It is a runner, so the engine reaches it through V2Client._call exactly as
    it reaches the real binary. Oracles read its state directly: transcripts,
    the inbox, admissions and every model call.

    - A note (`resume` false, `steer`) on an idle session starts no turn and
      waits in the inbox; it reaches the model in the same call as the next
      turn's trigger, placed just before it.
    - A `steer` item on a busy session is injected at the next step of the turn,
      or, after the last step, delivered at the end with one more model call.
    - A `queue` item waits; it runs after the turn's final reply, never between
      steps, in the same busy span. `time.idle` is written once, at the end.
    - `resume` true on an idle session starts a turn at once.
    - inbox.update to `steer` on a waiting item starts a turn when idle; steer
      to steer is refused with 409.
    - A repeated message id is admitted once; the repeat returns the original.
      Ids are global, so a repeat aimed at another session is not admitted
      there either (the assumption the derived id is built around).

    Not modelled, and refused loudly: a fleet prompt to a busy session. (Yours is
    modelled in the transcript only: see human_prompt_while_busy.) A turn
    started by a wake lasts `wake_lasts` seconds (0 by default).
    """

    def __init__(self, clock):
        self.clock = clock
        self.sessions = {}
        self.admitted = {}     # message id -> admission, across sessions
        self.model_calls = []
        self.writes = []       # every write, with the audit line count at that moment
        self.calls = []
        self.down = False
        self.audit_path = None
        self.wake_lasts = 0
        self._ids = 0

    def _id(self, prefix):
        self._ids += 1
        return "%s_fake%06d" % (prefix, self._ids)

    # -- the runner interface
    def __call__(self, argv, **kwargs):
        argv = list(argv)
        self.calls.append(argv)
        if self.down:
            return subprocess.CompletedProcess(argv, 1, "", "error: cannot reach the OpenCode service\n")
        if argv[1:2] != ["api"] or len(argv) < 3:
            return subprocess.CompletedProcess(argv, 2, "", "fake opencode: only `api` is modelled\n")
        op, params, body, rest = argv[2], {}, None, argv[3:]
        while rest:
            flag, value, rest = rest[0], rest[1], rest[2:]
            if flag == "--param":
                name, _, val = value.partition("=")
                params[name] = val
            elif flag == "-d":
                body = json.loads(value)
            else:
                raise AssertionError("fake opencode: unexpected argument %r" % flag)
        handler = getattr(self, "op_" + op.replace(".", "_"), None)
        if handler is None:
            return subprocess.CompletedProcess(argv, 1, '{"name":"NotFound"}', "HTTP 404 Not Found\n")
        try:
            data = handler(params, body)
        except FakeHTTP as err:
            return subprocess.CompletedProcess(
                argv, 1, json.dumps({"name": err.name, "message": err.message}),
                "HTTP %d %s\n" % (err.status, err.name))
        payload = {"data": data}
        payload.update(getattr(data, "envelope", None) or {})  # PR 8: a listing's cursor
        return subprocess.CompletedProcess(argv, 0, json.dumps(payload), "")

    # -- state helpers
    def create_session(self, metadata, title="fake", agent=None, directory=None):
        sid = self._id("ses")
        self.sessions[sid] = {"id": sid, "title": title, "metadata": copy.deepcopy(metadata),
                              "agent": agent, "directory": directory,
                              "created": self.clock.now(), "idle": None, "idle_writes": [], "outcome": None,
                              "messages": [], "inbox": [], "turn": None, "turns": 0}
        return sid

    def _session(self, params):
        session = self.sessions.get(params.get("sessionID"))
        if session is None:
            raise FakeHTTP(404, "NotFound", "no such session")
        return session

    def busy(self, sid):
        return self.sessions[sid]["turn"] is not None

    def _write(self, op, sid, ident):
        lines = 0
        if self.audit_path is not None and Path(self.audit_path).exists():
            lines = len(Path(self.audit_path).read_text().splitlines())
        self.writes.append({"op": op, "session": sid, "id": ident, "at": self.clock.now(), "audit_lines": lines})

    def _message(self, s, type_, text, metadata, at, mid=None):
        message = {"id": mid or self._id("msg"), "sessionID": s["id"], "type": type_, "text": text,
                   "time": {"created": self.clock.ms(at)}}
        if metadata is not None:
            message["metadata"] = copy.deepcopy(metadata)
        s["messages"].append(message)
        return message

    def _deliver(self, s, items, at):
        """Move inbox items into the transcript; they reach the model now."""
        delivered = []
        for item in items:
            s["inbox"].remove(item)
            delivered.append(self._message(s, item.get("type", "synthetic"), item["text"], item.get("metadata"), at, item["id"]))
            if item["id"] in self.admitted:  # your own prompt is not a switchboard admission
                self.admitted[item["id"]]["delivered_at"] = at
        return delivered

    def _model_call(self, s, phase, inputs, at):
        self.model_calls.append({"session": s["id"], "at": at, "phase": phase, "turn": s["turns"],
                                 "inputs": [{"id": m["id"], "type": m["type"], "keys": _record_keys(m)}
                                            for m in inputs]})

    def _start(self, s, at, lasts=0, steps=1, prompt=None, items=()):
        """A turn starts. Waiting notes ride in front of what started it (S3)."""
        s["turns"] += 1
        items = list(items)
        notes = [i for i in s["inbox"] if i["delivery"] == "steer" and i not in items]
        inputs = self._deliver(s, notes, at) + self._deliver(s, items, at)
        if prompt is not None:
            inputs.append(self._message(s, "user", prompt[0], prompt[1], at))
        self._model_call(s, "turn_start", inputs, at)
        s["turn"] = {"steps": [at + lasts * i / steps for i in range(1, steps)], "end": at + lasts}
        if lasts <= 0 and steps <= 1:
            self._finish(s, at)

    def _finish(self, s, at):
        """The final reply; then whatever waits runs in the same busy span (S3, S4)."""
        self._message(s, "assistant", "reply", None, at)
        while s["inbox"]:
            steer = [i for i in s["inbox"] if i["delivery"] == "steer"]
            self._model_call(s, "after_reply", self._deliver(s, steer or s["inbox"][:1], at), at)
            self._message(s, "assistant", "reply", None, at)
        s["turn"] = None
        s["idle"] = at
        s["idle_writes"].append(at)
        s["outcome"] = "success"

    def advance(self):
        """Run every turn event due by now: steps, then the final reply."""
        now = self.clock.now()
        for s in self.sessions.values():
            while s["turn"] is not None:
                turn = s["turn"]
                if turn["steps"] and turn["steps"][0] <= now:
                    at = turn["steps"].pop(0)
                    steer = [i for i in s["inbox"] if i["delivery"] == "steer"]
                    self._model_call(s, "between_steps", self._deliver(s, steer, at), at)
                elif turn["end"] <= now:
                    self._finish(s, turn["end"])
                else:
                    break

    def start_turn(self, sid, text, fleet, lasts=0, steps=1, metadata=None):
        """A prompt: yours (no fleet metadata) or the fleet's, starting a turn of `steps` model calls."""
        s = self.sessions[sid]
        if s["turn"] is not None:
            if metadata is None and not fleet:  # PR 8: you type while it works
                return self.human_prompt_while_busy(sid, text)
            raise AssertionError("fake opencode: a prompt to a busy session is not modelled")
        if metadata is None and fleet:
            metadata = {"fleet": {"from": "fleet-task"}}
        self._start(s, self.clock.now(), lasts, steps, prompt=(text, metadata))

    def admissions(self, sid):
        return [a for a in self.admitted.values() if a["session"] == sid]

    def human_prompt_while_busy(self, sid, text):
        """PR 8: you send a message while the session works. It is in the transcript at once,
        as the TUI shows it, and the running turn goes on undisturbed. When the model first
        sees it, and how the TUI admits it, is spike SF1's question: nothing here says."""
        s = self.sessions[sid]
        at, mid = self.clock.now(), self._id("msg")
        item = {"id": mid, "sessionID": sid, "type": "user", "text": text, "metadata": None, "resume": False,
                "delivery": "steer", "time": {"created": self.clock.ms(at)}}
        s["inbox"].append(item)  # SF1: in the inbox at once, consumed at the next step boundary

    # -- operations
    def op_server_info(self, params, body):
        return {"version": "2.0.22-fake"}

    def op_session_create(self, params, body):
        return self._info(self.sessions[self.create_session(
            body.get("metadata") or {}, body.get("title"), body.get("agent"),
            (body.get("location") or {}).get("directory"))])

    def _info(self, s):
        return {"id": s["id"], "title": s["title"], "metadata": copy.deepcopy(s["metadata"]),
                "time": {"created": self.clock.ms(s["created"]),
                         "idle": None if s["idle"] is None else self.clock.ms(s["idle"])},
                "outcome": s["outcome"], "location": {"directory": s.get("directory")}}

    def op_session_get(self, params, body):
        return self._info(self._session(params))

    def op_session_active(self, params, body):
        return {sid: {"type": "busy"} for sid, s in self.sessions.items() if s["turn"] is not None}

    def op_session_message_list(self, params, body):
        s = self._session(params)
        messages = list(s["messages"]) if params.get("order") == "asc" else list(reversed(s["messages"]))
        if "type" in params:
            messages = [m for m in messages if m["type"] == params["type"]]
        if "limit" in params:
            return self.page_of(messages, params)
        return copy.deepcopy(messages)

    CURSOR_PREFIX = "cur_at_"

    def page_of(self, messages, params):
        """PR 8: a page and the cursor v2 returns beside it. A cursor token names the
        offset of the next page, in the listing's own order (newest first by default);
        `order` and `cursor` together are refused, as v2 says. `previous` points back."""
        start = 0
        if "cursor" in params:
            if "order" in params:
                raise FakeHTTP(400, "InvalidRequestError", "do not combine cursor with order")
            if not params["cursor"].startswith(self.CURSOR_PREFIX):
                raise FakeHTTP(400, "InvalidCursorError", "bad cursor")
            start = int(params["cursor"][len(self.CURSOR_PREFIX):])
        size = int(params["limit"])
        page = Enveloped(copy.deepcopy(messages[start:start + size]))
        more = start + size < len(messages)
        page.envelope = {"cursor": {"next": self.CURSOR_PREFIX + str(start + size) if more else None,
                                    "previous": self.CURSOR_PREFIX + str(max(0, start - size)) if start else None}}
        return page

    def op_session_synthetic(self, params, body):
        s = self._session(params)
        mid = body["id"]
        if mid in self.admitted:  # admitted once; the repeat returns the original (S2)
            return copy.deepcopy(self.admitted[mid]["record"])
        at = self.clock.now()
        record = {"id": mid, "sessionID": s["id"], "type": "synthetic"}
        item = {"id": mid, "sessionID": s["id"], "text": body["text"], "metadata": copy.deepcopy(body.get("metadata")),
                "resume": body["resume"], "delivery": body["delivery"], "time": {"created": self.clock.ms(at)}}
        fleet = (body.get("metadata") or {}).get("fleet") or {}
        self.admitted[mid] = {"id": mid, "session": s["id"], "resume": body["resume"], "delivery": body["delivery"],
                              "at": at, "delivered_at": None, "keys": list(fleet.get("keys") or []),
                              "from": fleet.get("from"), "text": body["text"], "record": record}
        self._write("session.synthetic", s["id"], mid)
        s["inbox"].append(item)
        if s["turn"] is None and body["resume"]:
            self._start(s, at, self.wake_lasts, 1, items=[item])
        return copy.deepcopy(record)

    def op_session_prompt(self, params, body):
        s = self._session(params)
        self.start_turn(s["id"], body["text"], fleet=bool((body.get("metadata") or {}).get("fleet")),
                        metadata=body.get("metadata"))
        return {"id": s["messages"][-1]["id"]}

    @staticmethod
    def _inbox_record(item):
        """An inbox item as v2 2.0.22 returns it: text and metadata under
        `payload`, and no `resume` (S3, S5)."""
        return {"id": item["id"], "sessionID": item["sessionID"], "time": copy.deepcopy(item["time"]),
                "type": item.get("type", "synthetic"), "payload": {"text": item["text"], "metadata": copy.deepcopy(item.get("metadata"))},
                "delivery": item["delivery"]}

    def op_session_inbox_list(self, params, body):
        return [self._inbox_record(item) for item in self._session(params)["inbox"]]

    def op_session_inbox_update(self, params, body):
        s = self._session(params)
        item = next((i for i in s["inbox"] if i["id"] == params.get("inboxID")), None)
        if item is None:
            raise FakeHTTP(404, "NotFound", "no such pending input")
        if body["delivery"] == "steer" and item["delivery"] == "steer":
            raise FakeHTTP(409, "Conflict", "Pending input cannot change to steer")
        self._write("session.inbox.update", s["id"], item["id"])
        item["delivery"] = body["delivery"]
        if body["delivery"] == "steer" and s["turn"] is None:
            self._start(s, self.clock.now(), self.wake_lasts, 1, items=[item])
        return self._inbox_record(item)


HERDR_ALLOWED = (["agent", "list"], ["agent", "get"], ["pane", "report-metadata"], ["notification", "show"],
                 ["pane", "process-info"], ["pane", "close"])
SOCKET_ALLOWED = ("layout.apply",)
TYPING_VERBS = (["agent", "prompt"], ["agent", "send-keys"], ["agent", "start"], ["pane", "send-text"],
                ["pane", "send-keys"], ["pane", "run"])
TOKEN_NAME = re.compile(r"^[A-Za-z0-9_-]{1,32}$")


def _usage(argv, text):
    return subprocess.CompletedProcess(argv, 2, "", "error: %s\n" % text)


def parse_flags(args, valued, bare=()):
    """(positionals, flags) of a herdr subcommand, strictly: an unknown flag, a
    flag without its value, or a repeated flag is a usage error, as in clap."""
    positional, flags, i = [], {}, 0
    while i < len(args):
        arg = args[i]
        if arg.startswith("--"):
            if arg in bare:
                flags[arg] = True
            elif arg in valued and i + 1 < len(args):
                flags.setdefault(arg, []).append(args[i + 1])
                i += 1
            else:
                raise ValueError("unexpected argument %r" % arg)
        else:
            positional.append(arg)
        i += 1
    return positional, flags


class FakeHerdr:
    """herdr 0.9.3's CLI and socket, for what the switchboard uses, as strict
    as the real one: the pane id of `report-metadata` and the title of
    `notification show` are positional, and a wrong shape is a usage error
    (exit 2), never a quiet success. Status follows the fake v2 session
    (working while a turn runs, `done` after one) unless a test pins it.

    Typing is refused (exit 2) and recorded in `typing_attempts`, except for
    the one scenario baseline, where the runner sets `allow_typing`: then
    `agent prompt` does what the TUI does, putting the text after what is in
    the input box and submitting the lot.

    Toasts follow herdr's rules: one a second, server-wide, none queued. A test
    can script other answers with `toast_replies`. A pane opened by
    `layout.apply` runs its command's argv, as a pane without a shell does.
    `launch_mode` makes the launched pane misbehave: "shell" (a shell, not the
    program), "other-session", "undetected" (herdr never names an agent).
    """

    def __init__(self, v2):
        self.v2 = v2
        self.panes = {}
        self.calls = []
        self.socket_calls = []
        self.typing_attempts = []
        self.toasts = []            # every toast shown: {"title", "body", "at"}
        self.toast_replies = []     # scripted reasons for the next notification calls
        self.closed = []
        self.input_box = {}         # pane -> the text typed in its input box
        self.allow_typing = False
        self.launch_mode = "ok"
        self.down = False
        self.socket_down = False
        self._pane_n = 0
        self._last_toast = None

    def new_pane_id(self, workspace="w1"):
        self._pane_n += 1
        return "%s:p%d" % (workspace, self._pane_n)

    def add(self, pane, session, status=None, program=None):
        self.panes[pane] = {"session": session, "status": status, "tokens": {},
                            "program": program or "%s -s %s" % (FAKE_OPENCODE, session)}

    def status(self, pane):
        entry = self.panes[pane]
        if entry["status"]:
            return entry["status"]
        session = self.v2.sessions.get(entry["session"])
        if session is None:
            return "unknown"
        if session["turn"] is not None:
            return "working"
        return "done" if session["idle"] is not None else "idle"

    def agent(self, pane):
        # herdr 0.9's shape: the session is an object, not a string (S6).
        entry = self.panes[pane]
        body = {"pane_id": pane, "agent": "opencode", "agent_status": self.status(pane),
                "workspace_id": pane.split(":")[0]}
        if entry["session"] and not entry.get("undetected"):
            body["agent_session"] = {"agent": "opencode", "kind": "id", "source": "herdr:opencode",
                                     "value": entry["session"]}
        if entry.get("tokens"):
            body["tokens"] = dict(entry["tokens"])  # values are strings, as in herdr
        return body

    # -- the CLI
    def __call__(self, argv, **kwargs):
        argv = list(argv)
        self.calls.append(argv)
        args = argv[1:]
        if self.down:
            return subprocess.CompletedProcess(argv, 1, "", "error: no herdr server\n")
        if args[:2] in TYPING_VERBS and not (self.allow_typing and args[:2] == ["agent", "prompt"]):
            self.typing_attempts.append(args)
            return _usage(argv, "fake herdr: typing refused: %r" % args)
        handler = {("agent", "list"): self._agent_list, ("agent", "get"): self._agent_get,
                   ("agent", "prompt"): self._agent_prompt, ("pane", "report-metadata"): self._report_metadata,
                   ("notification", "show"): self._notification_show, ("pane", "process-info"): self._process_info,
                   ("pane", "close"): self._pane_close}.get(tuple(args[:2]))
        if handler is None:
            return _usage(argv, "fake herdr: refused %r" % args)
        try:
            body = handler(args[2:])
        except ValueError as err:
            return _usage(argv, str(err))
        except LookupError as err:
            return subprocess.CompletedProcess(argv, 1, "", "error: %s\n" % err)
        return subprocess.CompletedProcess(argv, 0, json.dumps(body) if body is not None else "", "")

    def _pane(self, pane):
        if pane not in self.panes:
            raise LookupError("no agent in pane %s" % pane)
        return pane

    def _agent_list(self, rest):
        parse_flags(rest, ())
        return {"result": {"type": "agent_list", "agents": [self.agent(p) for p in sorted(self.panes)]}}

    def _agent_get(self, rest):
        positional, _ = parse_flags(rest, ())
        if len(positional) != 1:
            raise ValueError("agent get takes one target")
        return {"result": {"type": "agent_info", "agent": self.agent(self._pane(positional[0]))}}

    def _agent_prompt(self, rest):
        positional, _ = parse_flags(rest, ())
        pane, text = self._pane(positional[0]), " ".join(positional[1:])
        draft = self.input_box.pop(pane, "")
        self.v2.start_turn(self.panes[pane]["session"], (draft + " " + text).strip(), fleet=False)
        return {"result": {"type": "ok"}}

    def _report_metadata(self, rest):
        positional, flags = parse_flags(rest, ("--source", "--token", "--clear-token", "--seq", "--ttl-ms"))
        if len(positional) != 1:
            raise ValueError("pane report-metadata takes the pane id as its one positional argument")
        pane = self._pane(positional[0])
        source = (flags.get("--source") or [""])[0]
        if not re.match(r"^[A-Za-z0-9:._-]{1,80}$", source):
            raise ValueError("--source is required: 1-80 of [A-Za-z0-9:._-]")
        sets, clears = flags.get("--token", []), flags.get("--clear-token", [])
        if not sets and not clears:
            raise ValueError("report-metadata needs --token or --clear-token")
        tokens = self.panes[pane].setdefault("tokens", {})
        for item in sets:
            name, _, value = item.partition("=")
            if not TOKEN_NAME.match(name) or not value.strip() or len(value) > 80:
                raise ValueError("bad token %r" % item)
            tokens[name] = value
        for name in clears:
            if not TOKEN_NAME.match(name):
                raise ValueError("bad token name %r" % name)
            tokens.pop(name, None)
        return None

    def _notification_show(self, rest):
        positional, flags = parse_flags(rest, ("--body", "--sound"))
        if len(positional) != 1 or not positional[0].strip():
            raise ValueError("notification show takes the title as its one positional argument")
        title, now = positional[0], self.v2.clock.now()
        if len(title) > 80:
            raise ValueError("fake herdr: title over 80 characters")
        reason = self.toast_replies.pop(0) if self.toast_replies else None
        if reason is None and self._last_toast is not None and now - self._last_toast < 1:
            reason = "rate_limited"
        if reason is None:
            self._last_toast = now
            self.toasts.append({"title": title, "body": (flags.get("--body") or [None])[0], "at": now})
        return {"result": {"type": "notification_show", "shown": reason is None, "reason": reason or "shown"}}

    def _process_info(self, rest):
        positional, flags = parse_flags(rest, ("--pane",))
        if positional or len(flags.get("--pane", [])) != 1:
            raise ValueError("pane process-info takes --pane <ID>")
        pane = self._pane(flags["--pane"][0])
        program = self.panes[pane].get("program")
        processes = [{"cmdline": program, "name": program.split(" ")[0].rsplit("/", 1)[-1], "pid": 4242}] if program else []
        return {"result": {"type": "pane_process_info", "process_info": {
            "pane_id": pane, "foreground_processes": processes, "shell_pid": 4242}}}

    def _pane_close(self, rest):
        positional, _ = parse_flags(rest, ())
        if len(positional) != 1:
            raise ValueError("pane close takes one pane id")
        self.closed.append(self._pane(positional[0]))
        del self.panes[positional[0]]
        return {"result": {"type": "ok"}}

    # -- the socket
    def socket(self, path, method, params, timeout):
        self.socket_calls.append((method, copy.deepcopy(params)))
        if self.socket_down:
            raise sb.HerdrError("unavailable", "cannot reach herdr's socket %s" % path)
        if method != "layout.apply":
            return {"error": {"code": "unknown_method", "message": method}}
        return self._layout_apply(params)

    def _layout_apply(self, params):
        root = params.get("root") or {}
        if set(params) - {"workspace_id", "tab_label", "root"} or set(root) - {"type", "label", "cwd", "command", "env"}:
            return {"error": {"code": "invalid_request", "message": "unknown field"}}
        command = root.get("command")
        if root.get("type") != "pane" or not (isinstance(command, list) and command) \
                or not os.path.isabs(root.get("cwd") or "") or not isinstance(root.get("env"), dict) \
                or not all(isinstance(v, str) for v in root["env"].values()):
            return {"error": {"code": "invalid_request", "message": "bad layout"}}
        workspace = params["workspace_id"]
        pane = self.new_pane_id(workspace)
        session = command[2] if len(command) > 2 and command[1] == "-s" else None
        self.add(pane, session, program=" ".join(command))
        entry = self.panes[pane]
        entry["env"], entry["cwd"], entry["argv"] = dict(root["env"]), root["cwd"], list(command)
        if self.launch_mode == "shell":
            entry["program"] = "-zsh"
        elif self.launch_mode == "other-session":
            entry["session"] = next(iter(self.v2.sessions))
        elif self.launch_mode == "undetected":
            entry["undetected"] = True
        return {"id": "x", "result": {"type": "layout_apply", "layout": {
            "workspace_id": workspace, "tab_id": "%s:t%s" % (workspace, pane.split("p")[-1]),
            "root": {"type": "pane", "pane_id": pane, "label": root["label"], "cwd": root["cwd"],
                     "command": command}}}}


class World:
    """Fake v2, fake herdr and a simulated clock, and an engine on the real clients."""

    def __init__(self, test, agents=("platform", "coder"), config=None, state=None):
        os.environ[sb.LAB_ENV] = "1"  # lab facts are the event source in these tests
        self.clock = SimClock()
        self.v2 = FakeV2(self.clock)
        self.herdr = FakeHerdr(self.v2)
        self.state = sb.ensure_state_dir(state)
        self.audit_path = self.state / "audit.jsonl"
        self.v2.audit_path = self.audit_path
        self.sessions, self.panes = {}, {}
        for name in agents:
            self.add_agent(name)
        raw = {"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR}
        raw.update(config or {})
        self.config = sb.validate_config(raw)
        self.engine = self.new_engine()

    def add_agent(self, name, status=None, fleet=None):
        meta = {"name": name, "role": "coder"}
        meta.update(fleet or {})
        sid = self.v2.create_session({"fleet": meta})
        pane = self.herdr.new_pane_id()
        self.herdr.add(pane, sid, status)
        self.sessions[name], self.panes[name] = sid, pane
        return sid

    def new_engine(self, actor="daemon", writable=True):
        return sb.Switchboard(self.config, sb.V2Client(FAKE_OPENCODE, {}, self.v2, 5),
                              sb.HerdrClient(FAKE_HERDR, self.herdr, socket_call=self.herdr.socket),
                              sb.AuditLog(self.audit_path) if writable else None,
                              sb.fact_sources(self.state), self.clock.now, actor,
                              intents=getattr(self, "intents", None))

    def route(self, argv, **kwargs):
        """One runner for the CLI: each fake answers its own binary; nothing else runs."""
        if argv[0] == FAKE_OPENCODE:
            return self.v2(argv, **kwargs)
        if argv[0] == FAKE_HERDR:
            return self.herdr(argv, **kwargs)
        raise AssertionError("a test reached for a real binary: %r" % argv[0])

    def fact(self, to, key, summary="something happened", **extra):
        line = {"key": key, "recipient": to, "kind": extra.pop("kind", "lab.fact"), "summary": summary,
                "created": self.clock.now()}
        line.update(extra)
        with open(str(self.state / sb.LAB_FACTS), "a") as handle:
            handle.write(json.dumps(line) + "\n")

    def tick(self, seconds=1):
        for _ in range(int(seconds)):
            self.clock.t += 1
            self.v2.advance()

    def you(self, name, text="what is new?"):
        self.v2.start_turn(self.sessions[name], text, fleet=False)

    def admissions(self, name):
        return self.v2.admissions(self.sessions[name])

    def audit(self):
        if not self.audit_path.exists():
            return []
        return [json.loads(line) for line in self.audit_path.read_text().splitlines()]

    def model_calls(self, name, phase=None):
        return [c for c in self.v2.model_calls
                if c["session"] == self.sessions[name] and (phase is None or c["phase"] == phase)]


def fact(key, created=EPOCH, recipient="platform", **extra):
    return sb.Fact(key, recipient, extra.pop("kind", "lab.fact"), extra.pop("summary", "s %s" % key), created, **extra)


def observation(status="idle", human=None, **extra):
    return sb.Observation("platform", "ses_1", "w1:p1", status, {"name": "platform"},
                          last_human_prompt=human, **extra)


class TestFakeV2(Base):
    """The fakes are only worth what their fidelity to the spikes is worth."""

    def setUp(self):
        super().setUp()
        self.world = World(self, agents=("platform",))
        self.client = sb.V2Client(FAKE_OPENCODE, {}, self.world.v2, 5)
        self.sid = self.world.sessions["platform"]

    def synthetic(self, key, resume, delivery):
        return self.client.synthetic(self.sid, "item %s" % key, {"fleet": {"keys": [key], "from": "switchboard"}},
                                     resume, delivery, sb.derive_message_id(self.sid, [key]))

    def test_a_note_on_an_idle_session_starts_nothing_and_rides_the_next_prompt(self):
        self.synthetic("n1", False, "steer")
        self.assertEqual(self.world.model_calls("platform"), [])
        self.assertEqual([_record_keys(i) for i in self.client.inbox_list(self.sid)], [["n1"]])
        self.world.tick(30)
        self.world.you("platform", "hello")
        start = self.world.model_calls("platform")
        self.assertEqual([[i["type"] for i in c["inputs"]] for c in start], [["synthetic", "user"]])
        oldest_first = list(reversed(self.client.message_list(self.sid)))
        self.assertEqual([m["type"] for m in oldest_first[:2]], ["synthetic", "user"])

    def test_a_queued_note_comes_after_the_reply_with_a_model_call_of_its_own(self):
        self.synthetic("q1", False, "queue")
        self.world.you("platform")
        phases = [(c["phase"], [i["keys"] for i in c["inputs"]]) for c in self.world.model_calls("platform")]
        self.assertEqual(phases, [("turn_start", [[]]), ("after_reply", [["q1"]])])

    def test_a_wake_starts_an_idle_session_at_once(self):
        self.synthetic("w1", True, "queue")
        self.assertEqual([c["phase"] for c in self.world.model_calls("platform")], ["turn_start"])
        self.assertEqual(self.client.inbox_list(self.sid), [])

    def test_a_busy_wake_runs_after_the_final_reply_in_one_busy_span(self):
        self.world.v2.start_turn(self.sid, "task", fleet=True, lasts=60, steps=3)
        self.world.tick(5)
        self.synthetic("w2", True, "queue")
        self.world.tick(60)
        calls = [(c["phase"], c["at"] - EPOCH, [i["keys"] for i in c["inputs"]])
                 for c in self.world.model_calls("platform")]
        self.assertEqual(calls, [("turn_start", 0, [[]]), ("between_steps", 20, []), ("between_steps", 40, []),
                                 ("after_reply", 60, [["w2"]])])
        self.assertEqual(self.world.v2.sessions[self.sid]["idle_writes"], [EPOCH + 60])

    def test_steer_on_a_busy_session_is_injected_between_steps(self):
        self.world.v2.start_turn(self.sid, "task", fleet=True, lasts=60, steps=3)
        self.world.tick(5)
        self.synthetic("s1", True, "steer")
        self.world.tick(60)
        between = self.world.model_calls("platform", "between_steps")
        self.assertEqual([[i["keys"] for i in c["inputs"]] for c in between], [[["s1"]], []])

    def test_steer_during_a_one_step_turn_comes_at_the_end_with_another_call(self):
        self.world.v2.start_turn(self.sid, "task", fleet=True, lasts=30)
        self.world.tick(5)
        self.synthetic("s2", False, "steer")
        self.world.tick(30)
        self.assertEqual([c["phase"] for c in self.world.model_calls("platform")], ["turn_start", "after_reply"])

    def test_a_repeated_id_is_admitted_once_and_returns_the_original(self):
        first = self.synthetic("r1", True, "queue")
        again = self.synthetic("r1", True, "queue")
        self.assertEqual(first, again)
        self.assertEqual(len(self.world.admissions("platform")), 1)
        self.assertEqual(len(self.world.model_calls("platform")), 1)

    def test_a_waiting_steer_note_cannot_be_updated_to_steer(self):
        record = self.synthetic("n2", False, "steer")
        with self.assertRaises(sb.V2Error) as caught:
            self.client.inbox_update(self.sid, record["id"], "steer")
        self.assertEqual(caught.exception.status, 409)
        self.client.inbox_update(self.sid, record["id"], "queue")
        self.assertEqual(self.world.model_calls("platform"), [])
        self.client.inbox_update(self.sid, record["id"], "steer")
        self.assertEqual([c["phase"] for c in self.world.model_calls("platform")], ["turn_start"])

    def test_reads_newest_first_with_a_limit_and_metadata_intact(self):
        self.world.you("platform", "one")
        self.world.tick()
        self.world.v2.start_turn(self.sid, "two", fleet=True)
        page = self.client.message_list(self.sid, limit=2)
        self.assertEqual([m["type"] for m in page], ["assistant", "user"])
        self.assertEqual(page[1]["metadata"], {"fleet": {"from": "fleet-task"}})
        info = self.client.session_get(self.sid)
        self.assertEqual(info["metadata"]["fleet"]["name"], "platform")
        self.assertEqual(info["time"]["idle"], self.world.clock.ms())


# ------------------------------------------------------------------ the facts

class TestFacts(Base):
    def test_round_trip_and_defaults(self):
        made = sb.Fact.from_json({"key": "lab.fact:1", "recipient": "platform", "kind": "review",
                                  "summary": "s", "created": EPOCH})
        self.assertEqual(made.to_json(), {"key": "lab.fact:1", "recipient": "platform", "kind": "review",
                                          "summary": "s", "created": EPOCH, "issue": None, "batch": True,
                                          "from": None})

    def test_bad_facts_are_refused_with_the_field_named(self):
        good = {"key": "k", "recipient": "platform", "kind": "x", "summary": "s", "created": EPOCH}
        for change, needle in (({"key": ""}, "key"), ({"recipient": None}, "recipient"),
                               ({"created": "now"}, "created"),
                               ({"issue": 0}, "issue"), ({"batch": "yes"}, "batch"), ({"from": 3}, "from"),
                               ({"summary": None}, "summary"), ({"extra": 1}, "extra")):
            with self.subTest(change=change):
                with self.assertRaises(sb.FactError) as caught:
                    sb.Fact.from_json(dict(good, **change))
                self.assertIn(needle, str(caught.exception))
        with self.assertRaises(sb.FactError):
            sb.Fact.from_json({"key": "k"})

    def test_the_lab_source_reads_only_in_the_lab(self):
        world = World(self)
        world.fact("platform", "lab.fact:1")
        source = sb.lab_fact_source(world.state)
        self.assertEqual([f.key for f in source()], ["lab.fact:1"])
        os.environ[sb.LAB_ENV] = "0"
        self.assertEqual(source(), [])
        os.environ.pop(sb.LAB_ENV)
        self.assertEqual(source(), [])

    def test_a_bad_lab_line_fails_the_source_loudly(self):
        world = World(self)
        world.fact("platform", "lab.fact:1")
        with open(str(world.state / sb.LAB_FACTS), "a") as handle:
            handle.write('{"key": "lab.fact:2"}\n')
        with self.assertRaises(sb.FactError) as caught:
            sb.lab_fact_source(world.state)()
        self.assertIn(":2:", str(caught.exception))

    def test_the_registration_point_lists_the_lab_source(self):
        self.assertEqual([s.__name__ for s in sb.fact_sources(self.home)], ["lab_facts", "worker_facts", "reminder_facts", "foreground_facts"])


# ---------------------------------------------------------------- observing

class TestDiscovery(Base):
    def test_fleet_agents_are_herdr_agents_whose_session_names_them(self):
        world = World(self, agents=("platform",))
        stranger = world.v2.create_session({"other": True})
        world.herdr.add("w9:p1", stranger)
        world.herdr.panes["w9:p2"] = {"session": None, "status": "idle"}
        found = world.engine.discover(world.clock.now())
        self.assertEqual(sorted(found.agents), ["platform"])
        seen = found.agents["platform"]
        self.assertEqual((seen.session_id, seen.pane, seen.status), (world.sessions["platform"], "w1:p1", "idle"))
        self.assertEqual(seen.fleet, {"name": "platform", "role": "coder"})

    def test_inbox_items_carry_their_metadata_under_payload(self):
        # session.inbox.list in v2 2.0.22 (checked in the Lab): no top-level metadata.
        item = {"id": "msg_1", "type": "synthetic", "delivery": "queue",
                "payload": {"text": "t", "metadata": {"fleet": {"keys": ["k1"], "from": "switchboard"}}}}
        self.assertEqual(sb._fleet_keys(item), ["k1"])
        self.assertEqual(sb._fleet_meta(item)["from"], "switchboard")
        self.assertEqual(sb._fleet_keys({"metadata": {"fleet": {"keys": ["k2"]}}}), ["k2"])

    def test_a_wake_waiting_behind_a_busy_turn_is_not_sent_again(self):
        world = World(self, agents=("platform",))
        world.v2.start_turn(world.sessions["platform"], "fleet task", fleet=True, lasts=600, steps=1)
        world.fact("platform", "lab.fact:busy")
        world.tick(100)
        world.engine.run_pass()
        for _ in range(5):
            world.tick(5)
            world.engine.run_pass()
        sends = [argv for argv in world.v2.calls if argv[2:3] == ["session.synthetic"]]
        self.assertEqual(len(sends), 1, "the waiting item's keys are read from v2's inbox, so it is sent once")
        self.assertEqual(len(world.admissions("platform")), 1)

    def test_herdr_names_the_session_as_an_object_or_a_string(self):
        # herdr 0.9.3's `agent list` gives {"kind": "id", "value": "ses_..."} (S6).
        for entry, expected in (({"agent_session": {"kind": "id", "source": "herdr:opencode", "value": "ses_1"}}, "ses_1"),
                                ({"agent_session": {"value": "ses_2"}}, "ses_2"),
                                ({"agent_session": "ses_3"}, "ses_3"),
                                ({"agent_session": {"kind": "path", "value": "/tmp/x"}}, None),
                                ({"agent_session": {"kind": "id", "value": ""}}, None),
                                ({"agent_session": None}, None), ({}, None), ("ses_4", None)):
            with self.subTest(entry=entry):
                self.assertEqual(sb.agent_session(entry), expected)

    def test_status_comes_from_herdr(self):
        world = World(self, agents=())
        for herdr_status, expected in (("working", "working"), ("idle", "idle"), ("done", "idle"),
                                       ("blocked", "blocked"), ("unknown", "unknown"), ("weird", "unknown")):
            world.add_agent("a-" + herdr_status, status=herdr_status)
        found = world.engine.discover(world.clock.now()).agents
        self.assertEqual({name: o.status for name, o in found.items()},
                         {"a-working": "working", "a-idle": "idle", "a-done": "idle", "a-blocked": "blocked",
                          "a-unknown": "unknown", "a-weird": "unknown"})

    def test_idle_at_outcome_and_your_last_prompt(self):
        world = World(self, agents=("platform",))
        sid = world.sessions["platform"]
        world.you("platform", "hi")                       # yours, at 0
        world.tick(30)
        world.v2.start_turn(sid, "fleet task", fleet=True)  # the fleet's, at 30
        world.tick(10)
        seen = world.engine.discover(world.clock.now()).agents["platform"]
        self.assertEqual(seen.last_human_prompt, EPOCH)
        self.assertEqual((seen.idle_at, seen.outcome), (EPOCH + 30, "success"))
        self.assertTrue(seen.engaged(world.clock.now(), 600))

    def test_a_prompt_older_than_the_window_is_not_engagement(self):
        world = World(self, agents=("platform",))
        world.you("platform")
        world.tick(601)
        seen = world.engine.discover(world.clock.now()).agents["platform"]
        self.assertIsNone(seen.last_human_prompt)
        self.assertFalse(seen.engaged(world.clock.now(), 600))
        argv = [a for a in world.v2.calls if a[2] == "session.message.list"][-1]
        self.assertIn("limit=%d" % sb.READ_LIMIT, argv)

    def test_two_sessions_with_one_name_are_a_conflict(self):
        world = World(self, agents=("platform",))
        world.add_agent("platform")
        seen = world.engine.discover(world.clock.now()).agents["platform"]
        self.assertEqual(len(seen.conflict), 1)
        self.assertIn("more than one session", sb.hold_reason(seen))

    def test_herdr_or_v2_down_is_a_reason_not_a_crash(self):
        world = World(self, agents=("platform",))
        world.herdr.down = True
        found = world.engine.discover(world.clock.now())
        self.assertEqual(found.agents, {})
        self.assertIn("herdr unreachable", found.missing("platform"))
        world.herdr.down, world.v2.down = False, True
        self.assertIn("v2 unreachable", world.engine.discover(world.clock.now()).missing("platform"))

    def test_a_session_v2_no_longer_has_is_skipped(self):
        world = World(self, agents=("platform",))
        del world.v2.sessions[world.sessions["platform"]]
        found = world.engine.discover(world.clock.now())
        self.assertEqual((found.agents, found.problems), ({}, []))


# ------------------------------------------------------------------ deriving

class TestDerive(Base):
    def setUp(self):
        super().setUp()
        self.world = World(self, agents=("platform",))
        self.sid = self.world.sessions["platform"]
        self.client = sb.V2Client(FAKE_OPENCODE, {}, self.world.v2, 5)

    def send(self, keys, resume, delivery="queue"):
        self.client.synthetic(self.sid, "x", {"fleet": {"keys": keys, "from": "switchboard"}}, resume, delivery,
                              sb.derive_message_id(self.sid, keys))

    def plan(self, facts):
        engine = self.world.engine
        return engine.plan("platform", facts, engine.discover(self.world.clock.now()), self.world.clock.now())

    def test_keys_in_the_transcript_and_the_inbox_are_delivered(self):
        self.send(["a"], True)            # a wake: in the transcript
        self.send(["b"], False, "steer")  # a note: still in the inbox
        keys, complete = self.world.engine.delivered_keys(self.sid, EPOCH - 60)
        self.assertEqual((keys, complete), ({"a", "b"}, True))
        self.world.tick(200)
        plan = self.plan([fact("a"), fact("b"), fact("c")])
        self.assertEqual([f.key for f in plan.pending], ["c"])

    def test_nothing_pending_means_no_plan(self):
        self.send(["a"], True)
        self.world.tick(200)
        self.assertIsNone(self.plan([fact("a")]))

    def test_the_read_stops_at_the_oldest_fact(self):
        self.send(["old"], True)
        self.world.tick(600)
        keys, complete = self.world.engine.delivered_keys(self.sid, EPOCH + 300)
        self.assertEqual((keys, complete), (set(), True))

    def test_a_read_that_cannot_reach_back_holds(self):
        for n in range(3):
            self.send(["k%d" % n], True)
            self.world.tick(100)
        # PR 8 reads further pages, so the read is bounded to one page here: this test is about
        # the bound (more pages than MAX_READ_PAGES also holds: see TestMessagePaging).
        with mock.patch.object(sb, "READ_LIMIT", 2), mock.patch.object(sb, "MAX_READ_PAGES", 1):
            _, complete = self.world.engine.delivered_keys(self.sid, EPOCH - 60)
            self.assertFalse(complete)
            plan = self.plan([fact("new")])
        self.assertEqual(plan.action, "hold")
        self.assertIn("unknown", plan.reason)

    def test_no_dedupe_ignores_what_was_delivered(self):
        self.send(["a"], True)
        self.world.tick(200)
        os.environ[sb.FAULT_ENV] = "no-dedupe"
        self.assertEqual([f.key for f in self.plan([fact("a")]).pending], ["a"])


# ------------------------------------------------------------------ deciding

class TestDecide(Base):
    def decide(self, pending, seen, now=EPOCH + 100, missing=None):
        return sb.decide("platform", pending, seen, now, 90, 600, missing)

    def test_every_branch(self):
        cases = [
            # (what, pending, observation, now, action, reason contains)
            ("young batch waits", [fact("a", EPOCH + 50)], observation(), EPOCH + 100, "wait", "batching until"),
            ("ripe batch goes", [fact("a", EPOCH), fact("b", EPOCH + 50)], observation(), EPOCH + 90, "wake", ""),
            ("send skips the batch", [fact("a", EPOCH + 99, batch=False)], observation(), EPOCH + 100, "wake", ""),
            ("send carries the batch with it", [fact("a", EPOCH + 99), fact("b", EPOCH + 99, batch=False)],
             observation(), EPOCH + 100, "wake", ""),
            ("not found holds", [fact("a")], None, EPOCH + 100, "hold", "not found"),
            ("blocked holds", [fact("a")], observation("blocked"), EPOCH + 100, "hold", "blocked"),
            ("unknown holds", [fact("a")], observation("unknown"), EPOCH + 100, "hold", "status unknown"),
            ("unreadable holds", [fact("a")], observation(problem="cannot read"), EPOCH + 100, "hold", "cannot read"),
            ("working still wakes", [fact("a")], observation("working"), EPOCH + 100, "wake", ""),
            ("engaged gets a note", [fact("a")], observation(human=EPOCH + 40), EPOCH + 100, "note", "you prompted"),
            ("engagement lapses", [fact("a")], observation(human=EPOCH - 600), EPOCH + 100, "wake", ""),
        ]
        for what, pending, seen, now, action, needle in cases:
            with self.subTest(what=what):
                plan = self.decide(pending, seen, now)
                self.assertEqual(plan.action, action, plan.reason)
                self.assertIn(needle, plan.reason)
        self.assertIsNone(self.decide([], observation()))
        self.assertEqual(self.decide([fact("a")], None, missing="herdr unreachable").reason, "herdr unreachable")

    def test_faults_switch_one_safeguard_each_only_in_the_lab(self):
        young = [fact("a", EPOCH + 99)]
        engaged = observation(human=EPOCH + 90)
        os.environ[sb.FAULT_ENV] = "no-batch,no-engagement-gate"
        self.assertEqual(self.decide(young, engaged).action, "wait")  # not in the Lab: no effect
        os.environ[sb.LAB_ENV] = "1"
        os.environ[sb.FAULT_ENV] = "no-batch"
        self.assertEqual(self.decide(young, engaged).action, "note")
        os.environ[sb.FAULT_ENV] = "no-engagement-gate"
        self.assertEqual(self.decide([fact("a")], engaged).action, "wake")


# ------------------------------------------------------------------ composing

class TestCompose(unittest.TestCase):
    def test_header_then_each_item_in_full(self):
        text, carried = sb.compose("platform", [
            fact("b", EPOCH + 1, summary="Second\nwith detail", kind="review", sender="coder", issue=7),
            fact("a", EPOCH, summary="First thing"),
        ])
        self.assertEqual(text.splitlines(), [
            "[switchboard] 2 for platform: First thing",
            "- lab.fact from the fleet: First thing",
            "- review from coder (issue #7): Second",
            "  with detail",
        ])
        self.assertEqual([f.key for f in carried], ["a", "b"])

    def test_the_cap_leaves_the_rest_pending_and_says_so(self):
        facts = [fact("k%02d" % n, EPOCH + n, summary="x" * 300) for n in range(30)]
        text, carried = sb.compose("platform", facts, cap=1000)
        self.assertLessEqual(len(text), 1000)
        self.assertEqual(len(carried), 2)
        self.assertTrue(text.endswith("\u2026 and 28 more: run fleet-switchboard pending platform"))
        self.assertEqual([f.key for f in carried], ["k00", "k01"])

    def test_one_item_longer_than_the_cap_is_cut_and_says_so(self):
        text, carried = sb.compose("platform", [fact("big", summary="y" * 5000)], cap=500)
        self.assertEqual(len(text), 500)
        self.assertTrue(text.endswith("[cut at 500 characters]"))
        self.assertEqual(len(carried), 1)


# ------------------------------------------------------------------ delivering

class TestDeliver(Base):
    def setUp(self):
        super().setUp()
        self.world = World(self, agents=("platform", "coder"))

    def pass_(self):
        return self.world.engine.run_pass()

    def test_a_ripe_batch_becomes_one_wake_with_keys_and_audit_around_it(self):
        self.world.fact("platform", "lab.fact:1", "First")
        self.world.tick(30)
        self.world.fact("platform", "lab.fact:2", "Second")
        self.assertEqual(self.pass_()["waiting"], ["platform"])
        self.world.tick(60)
        report = self.pass_()
        self.assertEqual([s["keys"] for s in report["sent"]], [["lab.fact:1", "lab.fact:2"]])
        (admitted,) = self.world.admissions("platform")
        sid = self.world.sessions["platform"]
        self.assertEqual((admitted["resume"], admitted["delivery"]), (True, "queue"))
        self.assertEqual(admitted["id"], sb.derive_message_id(sid, ["lab.fact:1", "lab.fact:2"]))
        self.assertEqual(admitted["from"], "switchboard")
        self.assertTrue(admitted["text"].startswith("[switchboard] 2 for platform: First"))
        intent, result = [e for e in self.world.audit() if e["event"] == "v2.synthetic"]
        self.assertEqual((intent["phase"], result["phase"], result["ok"]), ("intent", "result", True))
        self.assertEqual(intent["detail"]["message_id"], admitted["id"])
        (write,) = self.world.v2.writes
        self.assertEqual(write["audit_lines"], len(self.world.audit()) - 1)  # the intent was on disk first
        self.world.tick(5)
        self.assertEqual(self.pass_()["sent"], [])  # delivered keys are never sent again

    def test_engaged_means_a_note_that_starts_no_turn(self):
        self.world.you("platform")
        self.world.fact("platform", "lab.fact:1")
        self.world.tick(90)
        before = len(self.world.model_calls("platform"))
        self.pass_()
        (admitted,) = self.world.admissions("platform")
        self.assertEqual((admitted["resume"], admitted["delivery"]), (False, "steer"))
        self.assertEqual(len(self.world.model_calls("platform")), before)
        self.world.tick(5)
        self.assertEqual(self.pass_()["sent"], [])  # waiting in the inbox counts as delivered

    def test_steer_not_queue_makes_wakes_steer(self):
        os.environ[sb.FAULT_ENV] = "steer-not-queue"
        self.world.fact("platform", "lab.fact:1")
        self.world.tick(90)
        self.pass_()
        (admitted,) = self.world.admissions("platform")
        self.assertEqual((admitted["resume"], admitted["delivery"]), (True, "steer"))

    def test_the_recheck_sends_nothing_when_the_agent_changed(self):
        self.world.fact("platform", "lab.fact:1")
        self.world.tick(90)
        engine = self.world.engine
        plan = engine.plan("platform", engine.collect_facts()[0], engine.discover(self.world.clock.now()),
                           self.world.clock.now())
        self.assertEqual(plan.action, "wake")
        self.world.herdr.panes[self.world.panes["platform"]]["status"] = "blocked"
        outcome = engine.deliver(plan)
        self.assertEqual((outcome["sent"], outcome["action"]), (False, "hold"))
        self.assertEqual(self.world.admissions("platform"), [])
        (recheck,) = [e for e in self.world.audit() if e["event"] == "recheck"]
        self.assertEqual((recheck["detail"]["was"], recheck["detail"]["now"]), ("wake", "hold"))
        os.environ[sb.FAULT_ENV] = "no-recheck"
        self.assertTrue(engine.deliver(plan)["sent"])

    def test_the_recheck_follows_a_pane_that_now_shows_another_session(self):
        self.world.fact("platform", "lab.fact:1")
        self.world.tick(90)
        engine = self.world.engine
        plan = engine.plan("platform", engine.collect_facts()[0], engine.discover(self.world.clock.now()),
                           self.world.clock.now())
        self.world.herdr.panes[self.world.panes["platform"]]["session"] = self.world.sessions["coder"]
        outcome = engine.deliver(plan)
        self.assertFalse(outcome["sent"])
        self.assertIn("no longer shows", outcome["reason"])

    def test_holds_are_audited_once_per_reason_and_send_nothing(self):
        self.world.herdr.panes[self.world.panes["platform"]]["status"] = "blocked"
        self.world.fact("platform", "lab.fact:1")
        self.world.tick(90)
        for _ in range(3):
            report = self.pass_()
            self.world.tick(5)
        self.assertEqual(report["held"][0]["recipient"], "platform")
        self.assertEqual(len([e for e in self.world.audit() if e["event"] == "hold"]), 1)
        self.assertEqual(self.world.v2.writes, [])
        self.world.fact("ghost", "lab.fact:2")
        self.world.tick(90)
        held = {h["recipient"]: h["reason"] for h in self.pass_()["held"]}
        self.assertIn("not found", held["ghost"])

    def test_v2_down_holds_everything(self):
        self.world.fact("platform", "lab.fact:1")
        self.world.tick(90)
        self.world.v2.down = True
        report = self.pass_()
        self.assertIn("v2 unreachable", report["held"][0]["reason"])

    def test_the_same_keys_always_derive_the_same_id(self):
        os.environ[sb.FAULT_ENV] = "no-dedupe"
        self.world.fact("platform", "lab.fact:1")
        self.world.tick(90)
        first = self.pass_()["sent"][0]["message_id"]
        self.world.tick(5)
        second = self.pass_()["sent"][0]["message_id"]
        self.assertEqual(first, second)
        self.assertEqual(len(self.world.admissions("platform")), 1)

    def test_crash_after_send_leaves_an_intent_and_the_next_pass_sends_nothing(self):
        self.world.fact("platform", "lab.fact:1")
        self.world.tick(90)
        os.environ[sb.FAULT_ENV] = "crash-after-send"
        with self.assertRaises(sb.SimulatedCrash):
            self.pass_()
        events = [(e["event"], e.get("phase")) for e in self.world.audit()]
        self.assertEqual(events, [("v2.synthetic", "intent")])
        os.environ[sb.FAULT_ENV] = ""
        self.world.engine = self.world.new_engine()
        self.world.tick(5)
        self.assertEqual(self.pass_()["sent"], [])
        self.assertEqual(len(self.world.admissions("platform")), 1)

    def test_one_agents_failure_never_stops_the_others(self):
        self.world.fact("platform", "lab.fact:1")
        self.world.fact("coder", "lab.fact:2")
        self.world.tick(90)
        real = self.world.v2.op_session_synthetic

        def flaky(params, body):
            if params["sessionID"] == self.world.sessions["coder"]:
                raise FakeHTTP(500, "InternalError", "boom")
            return real(params, body)

        self.world.v2.op_session_synthetic = flaky
        report = self.pass_()
        self.assertEqual([s["recipient"] for s in report["sent"]], ["platform"])
        self.assertEqual([e["subject"] for e in report["errors"]], ["coder"])
        failed = [e for e in self.world.audit() if e["event"] == "v2.synthetic" and e["subject"] == "coder"]
        self.assertEqual([(e["phase"], e.get("ok")) for e in failed], [("intent", None), ("result", False)])
        self.assertTrue(any(e["event"] == "error" and e["subject"] == "coder" for e in self.world.audit()))

    def test_a_failing_source_is_audited_and_the_rest_still_run(self):
        def broken():
            raise RuntimeError("source down")
        engine = self.world.engine
        engine.sources.insert(0, broken)
        self.world.fact("platform", "lab.fact:1")
        self.world.tick(90)
        self.assertEqual(len(engine.run_pass()["sent"]), 1)
        self.assertTrue(any(e["event"] == "source.error" for e in self.world.audit()))

    def test_overflow_goes_in_the_next_message(self):
        for n in range(30):
            self.world.fact("platform", "lab.fact:%02d" % n, "z" * 400)
        self.world.tick(90)
        first = self.pass_()["sent"][0]
        self.assertGreater(first["left"], 0)
        self.world.tick(5)
        second = self.pass_()["sent"][0]
        self.assertTrue(set(first["keys"]).isdisjoint(second["keys"]))

    def test_a_read_only_engine_refuses_to_write(self):
        self.world.fact("platform", "lab.fact:1")
        self.world.tick(90)
        engine = self.world.new_engine(writable=False)
        plan = engine.plan("platform", engine.collect_facts()[0], engine.discover(self.world.clock.now()),
                           self.world.clock.now())
        with self.assertRaises(RuntimeError):
            engine.deliver(plan)
        self.assertEqual(self.world.v2.writes, [])


class TestConversion(Base):
    def setUp(self):
        super().setUp()
        self.world = World(self, agents=("platform",))
        self.world.you("platform")
        self.world.fact("platform", "lab.fact:1")
        self.world.tick(90)
        self.world.engine.run_pass()
        (self.note,) = self.world.admissions("platform")
        self.assertFalse(self.note["resume"])

    def test_a_note_waits_while_you_are_engaged(self):
        self.world.tick(400)
        self.assertEqual(self.world.engine.run_pass()["converted"], [])
        self.assertIsNone(self.note["delivered_at"])

    def test_a_note_that_outlives_engagement_becomes_a_wake(self):
        self.world.tick(600 - 90)
        report = self.world.engine.run_pass()
        self.assertEqual(report["converted"], [self.note["id"]])
        self.assertIsNotNone(self.note["delivered_at"])
        updates = [w for w in self.world.v2.writes if w["op"] == "session.inbox.update"]
        self.assertEqual(len(updates), 2)
        audited = [(e["detail"]["delivery"], e["phase"]) for e in self.world.audit() if e["event"] == "v2.inbox.update"]
        self.assertEqual(audited, [("queue", "intent"), ("queue", "result"), ("steer", "intent"), ("steer", "result")])
        self.assertEqual(self.world.model_calls("platform", "turn_start")[-1]["inputs"][0]["keys"], ["lab.fact:1"])

    def test_a_blocked_agent_keeps_its_note(self):
        self.world.herdr.panes[self.world.panes["platform"]]["status"] = "blocked"
        self.world.tick(600)
        self.assertEqual(self.world.engine.run_pass()["converted"], [])


# ------------------------------------------------------------------- the CLI

class TestEngineCLI(Base):
    def setUp(self):
        super().setUp()
        self.world = World(self, agents=("platform", "coder"))
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})

    def main(self, *argv):
        with captured() as (out, err):
            code = sb.main(list(argv), runner=self.world.route, now=self.world.clock.now,
                           wait=lambda sock, seconds: False, socket_call=self.world.herdr.socket)
        return code, out.getvalue(), err.getvalue()

    def test_send_identifies_the_caller_by_its_pane_and_delivers_at_once(self):
        os.environ["HERDR_PANE_ID"] = self.world.panes["coder"]
        code, out, err = self.main("send", "platform", "--issue", "7", "PR", "is", "up")
        self.assertEqual(code, 0, err)
        (admitted,) = self.world.admissions("platform")
        self.assertEqual(out.strip(), admitted["id"])
        (key,) = admitted["keys"]
        self.assertTrue(key.startswith("send:coder:"), key)
        self.assertIn("- send from coder (issue #7): PR is up", admitted["text"])
        self.assertTrue(admitted["resume"])
        cli = [e for e in self.world.audit() if e["event"] == "v2.synthetic"]
        self.assertEqual({e["actor"] for e in cli}, {"cli"})

    def test_send_is_a_note_while_you_talk_to_the_recipient(self):
        self.world.you("platform")
        os.environ["HERDR_PANE_ID"] = self.world.panes["coder"]
        self.assertEqual(self.main("send", "platform", "hi")[0], 0)
        self.assertFalse(self.world.admissions("platform")[0]["resume"])

    def test_send_without_a_known_caller_is_refused(self):
        code, _, err = self.main("send", "platform", "hi")
        self.assertEqual(code, 1)
        self.assertIn("HERDR_PANE_ID", err)
        stranger = self.world.v2.create_session({})
        self.world.herdr.add("w5:p5", stranger)
        os.environ["HERDR_PANE_ID"] = "w5:p5"
        code, _, err = self.main("send", "platform", "hi")
        self.assertEqual(code, 1)
        self.assertIn("not a fleet agent", err)
        self.assertEqual(self.world.v2.writes, [])

    def test_from_is_only_for_the_lab(self):
        os.environ.pop(sb.LAB_ENV)
        code, _, err = self.main("send", "platform", "--from", "coder", "hi")
        self.assertEqual(code, 2)
        self.assertIn("only for the Lab", err)
        os.environ[sb.LAB_ENV] = "1"
        self.assertEqual(self.main("send", "platform", "--from", "coder", "hi")[0], 0)

    def test_a_held_send_says_why_and_sends_nothing(self):
        self.world.herdr.panes[self.world.panes["platform"]]["status"] = "blocked"
        code, out, err = self.main("send", "platform", "--from", "coder", "hi")
        self.assertEqual((code, out), (sb.EXIT_HELD, ""))
        self.assertIn("blocked", err)
        self.assertEqual(self.world.v2.writes, [])
        self.assertEqual(self.main("send", "nobody", "--from", "coder", "hi")[0], sb.EXIT_HELD)

    def test_pending_is_read_only_and_says_why(self):
        self.world.fact("platform", "lab.fact:1", "First")
        self.world.tick(10)
        code, out, _ = self.main("pending", "platform")
        self.assertEqual(code, 0)
        self.assertIn("lab.fact:1", out)
        self.assertIn("wait (batching until", out)
        code, out, _ = self.main("pending", "platform", "--json")
        self.assertEqual(json.loads(out)["plan"]["action"], "wait")
        self.assertEqual(self.world.v2.writes, [])
        self.assertEqual(self.world.audit(), [])

    def test_status_lists_the_fleet(self):
        self.world.fact("ghost", "lab.fact:9")
        code, out, _ = self.main("status")
        self.assertEqual(code, 0, out)
        self.assertIn("2 fleet agent(s)", out)
        self.assertRegex(out, r"platform +idle +ses_")
        self.assertRegex(out, r"ghost +\(not found\) +1 pending: wait")
        report = json.loads(self.main("status", "--json")[1])
        self.assertEqual([a["name"] for a in report["agents"]["list"]], ["coder", "ghost", "platform"])
        self.assertEqual(self.world.v2.writes, [])

    def test_run_once_delivers_and_reports(self):
        self.world.fact("platform", "lab.fact:1")
        self.world.tick(90)
        code, out, _ = self.main("run", "--once", "--json")
        self.assertEqual(code, 0, out)
        self.assertEqual(len(json.loads(out)["sent"]), 1)
        self.assertEqual(len(self.world.admissions("platform")), 1)

    def test_run_once_under_crash_after_send_exits_like_a_crash(self):
        self.world.fact("platform", "lab.fact:1")
        self.world.tick(90)
        os.environ[sb.FAULT_ENV] = "crash-after-send"
        code, _, err = self.main("run", "--once")
        self.assertEqual(code, sb.EXIT_CRASH)
        self.assertIn("crashed", err)

    def test_an_unconfigured_v2_is_refused_before_anything_runs(self):
        self.write_config({"herdr": FAKE_HERDR})
        for argv in (("run", "--once"), ("send", "platform", "--from", "coder", "x"), ("pending", "platform")):
            code, _, err = self.main(*argv)
            self.assertEqual(code, 1, argv)
            self.assertIn("'opencode' is not configured", err)
        self.assertEqual(self.world.v2.calls + self.world.herdr.calls, [])

    def test_real_processes_answer_in_one_line_when_v2_is_down(self):
        opencode = self.fake_bin("opencode", "echo '{\"name\":\"Down\"}'\necho 'HTTP 503 Service Unavailable' >&2\nexit 1\n")
        agent = '{"pane_id":"w1:p1","agent_status":"idle","agent_session":"ses_1"}'
        herdr = self.fake_bin("herdr", "echo '{\"result\":{\"agents\":[%s],\"agent\":%s}}'\n" % (agent, agent))
        self.write_config({"opencode": str(opencode), "herdr": str(herdr), "call_timeout_seconds": 5})
        os.environ["HERDR_PANE_ID"] = "w1:p1"
        for argv, code in ((("run", "--once"), 0), (("pending", "platform"), 0), (("send", "platform", "hi"), 1)):
            with self.subTest(argv=argv):
                proc = self.run_cli(SWITCHBOARD, *argv)
                self.assertEqual(proc.returncode, code, proc.stdout + proc.stderr)
                self.assertNotIn("Traceback", proc.stdout + proc.stderr)
        self.assertIn("v2 unreachable: http 503", self.run_cli(SWITCHBOARD, "pending", "platform").stdout)


class TestDaemon(Base):
    def setUp(self):
        super().setUp()
        self.world = World(self, agents=("platform",))

    def test_a_forgotten_fake_cannot_reach_a_real_binary(self):
        # Every test runs with PATH pinned; default clients find nothing to run.
        self.assertIsNone(shutil.which("herdr"))
        self.assertIsNone(shutil.which("opencode"))
        with self.assertRaises(sb.HerdrError) as caught:
            sb.HerdrClient(sb.DEFAULTS["herdr"]).agent_list()
        self.assertEqual(caught.exception.reason, "unavailable")

    def test_the_lock_admits_one_run(self):
        with sb.single_instance(self.world.state):
            with self.assertRaises(sb.LockError) as caught:
                with sb.single_instance(self.world.state):
                    pass
            self.assertIn("pid %d" % os.getpid(), str(caught.exception))
        with sb.single_instance(self.world.state):
            pass  # released when the holder ended
        self.assertEqual(stat.S_IMODE((self.world.state / "run.lock").stat().st_mode), 0o600)

    def test_run_refuses_while_another_holds_the_lock(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        with sb.single_instance(self.world.state):
            with captured() as (_, err):
                code = sb.main(["run", "--once"], runner=self.world.route, now=self.world.clock.now)
        self.assertEqual(code, 1)
        self.assertIn("holds", err.getvalue())

    def test_the_loop_passes_every_poll_and_survives_a_failing_pass(self):
        sleeps = []
        engine = self.world.engine
        real = engine.run_pass
        calls = []

        def run_pass():
            calls.append(1)
            if len(calls) == 2:
                raise RuntimeError("one bad pass")
            return real()

        engine.run_pass = run_pass
        self.assertEqual(sb.run_daemon(engine, self.world.state, 5, lambda sock, t: sleeps.append(t), passes=3), 3)
        self.assertEqual(sleeps, [5, 5])
        self.assertTrue(any(e["event"] == "error" and e["detail"]["step"] == "pass" for e in self.world.audit()))

    def test_run_without_once_stops_cleanly_on_interrupt(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "poll_seconds": 7})
        sleeps = []

        def wait(sock, seconds):
            sleeps.append(seconds)
            if len(sleeps) == 2:
                raise KeyboardInterrupt

        code = sb.main(["run"], runner=self.world.route, now=self.world.clock.now, wait=wait)
        self.assertEqual((code, sleeps), (0, [7, 7]))


# -------------------------------------------------- the poke socket, ensure, the plugin

class TestPoke(Base):
    def setUp(self):
        super().setUp()
        self.state = sb.ensure_state_dir()

    def test_a_poke_reaches_the_daemons_socket_and_a_burst_drains_at_once(self):
        sock = sb.open_poke_socket(self.state)
        self.addCleanup(sock.close)
        self.assertFalse(sb.wait_for_poke(sock, 0.01))
        for _ in range(3):
            self.assertTrue(sb.send_poke(self.state))
        self.assertTrue(sb.wait_for_poke(sock, 1))
        self.assertEqual(sb.drain_pokes(sock), 3)
        self.assertFalse(sb.wait_for_poke(sock, 0.05))
        self.assertEqual(stat.S_IMODE((self.state / sb.POKE_SOCKET).stat().st_mode), 0o600)

    def test_a_poke_with_no_daemon_is_false_not_an_error(self):
        self.assertFalse(sb.send_poke(self.state))  # no socket file
        self.assertFalse(sb.send_poke(self.home / "nowhere"))  # no state dir
        (self.state / sb.POKE_SOCKET).write_text("a stale file")
        self.assertFalse(sb.send_poke(self.state))  # a file nobody listens on

    def test_a_stale_socket_is_replaced(self):
        old = sb.open_poke_socket(self.state)
        old.close()  # the file stays, as after a crash
        self.assertTrue((self.state / sb.POKE_SOCKET).exists())
        new = sb.open_poke_socket(self.state)
        self.addCleanup(new.close)
        self.assertTrue(sb.send_poke(self.state))
        self.assertTrue(sb.wait_for_poke(new, 1))

    def test_the_state_dir_path_length_does_not_matter(self):
        deep = self.home
        while len(str(deep / sb.POKE_SOCKET)) < 150:
            deep = deep / "a-directory-with-a-long-name"
        deep.mkdir(parents=True)
        sock = sb.open_poke_socket(deep)
        self.addCleanup(sock.close)
        self.assertTrue(sb.send_poke(deep))
        self.assertTrue(sb.wait_for_poke(sock, 1))

    def test_the_working_directory_is_restored(self):
        before = os.getcwd()
        sb.send_poke(self.state)
        sock = sb.open_poke_socket(self.state)
        sock.close()
        self.assertEqual(os.getcwd(), before)

    def test_a_poke_to_a_full_socket_gives_up_instead_of_blocking(self):
        sock = sb.open_poke_socket(self.state)
        self.addCleanup(sock.close)
        started = time.time()
        results = [sb.send_poke(self.state) for _ in range(20000)]
        self.assertIn(False, results)  # the socket filled; the poke was dropped, not waited for
        self.assertLess(time.time() - started, 20)

    def test_the_poke_command_is_silent_fast_and_always_exits_zero(self):
        for setup in ("no state dir", "a daemon"):
            if setup == "a daemon":
                sock = sb.open_poke_socket(self.state)
                self.addCleanup(sock.close)
            started = time.time()
            result = self.run_cli(SWITCHBOARD, "poke")
            with self.subTest(setup=setup):
                self.assertEqual((result.returncode, result.stdout, result.stderr), (0, "", ""))
                self.assertLess(time.time() - started, 2)
        self.assertTrue(sb.wait_for_poke(sock, 1))  # and the one to a daemon arrived

    def test_poke_never_calls_herdr_or_v2_and_needs_no_config(self):
        def boom(argv, **kwargs):
            raise AssertionError("poke ran %r" % argv)

        with captured() as (out, err):
            code = sb.main(["poke"], runner=boom)
        self.assertEqual((code, out.getvalue(), err.getvalue()), (0, "", ""))
        self.assertFalse(self.config_file.exists())

    def test_a_poke_arms_an_alarm_that_is_disarmed_after(self):
        sb.cmd_poke(None)
        self.assertEqual(signal.alarm(0), 0)  # nothing left armed in this process


class TestDaemonWaits(Base):
    def setUp(self):
        super().setUp()
        self.world = World(self, agents=("platform",))

    def counted(self, on_pass=None):
        passes = []
        real = self.world.engine.run_pass

        def run_pass():
            passes.append(time.time())
            if on_pass:
                on_pass(len(passes))
            return real()

        self.world.engine.run_pass = run_pass
        return passes

    def test_a_poke_makes_a_pass_at_once_not_after_the_poll(self):
        passes = self.counted()
        thread = threading.Thread(target=sb.run_daemon, args=(self.world.engine, self.world.state, 30, None, 2))
        thread.start()
        deadline = time.time() + 5
        while not passes and time.time() < deadline:
            time.sleep(0.01)
        self.assertTrue(passes)
        started = time.time()
        while not sb.send_poke(self.world.state) and time.time() < deadline:
            time.sleep(0.01)  # the socket is bound just after the lock is taken
        thread.join(8)
        self.assertFalse(thread.is_alive(), "30 s poll: the poke did not wake the daemon")
        self.assertEqual(len(passes), 2)
        self.assertLess(time.time() - started, 5)

    def test_every_poke_waiting_is_drained_before_the_next_pass(self):
        def burst(number):
            if number == 1:  # three events arrive during the first pass
                for _ in range(3):
                    sb.send_poke(self.world.state)

        passes = self.counted(burst)
        sb.run_daemon(self.world.engine, self.world.state, 0.6, None, passes=3)
        # pass 2 follows the burst at once; the burst made no pass 3 of its own,
        # so pass 3 waited out the poll.
        self.assertLess(passes[1] - passes[0], 0.4)
        self.assertGreaterEqual(passes[2] - passes[1], 0.5)

    def test_the_socket_is_closed_when_the_daemon_stops(self):
        sb.run_daemon(self.world.engine, self.world.state, 5, lambda sock, t: None, passes=1)
        self.assertFalse(sb.send_poke(self.world.state))

    def test_a_socket_that_cannot_be_bound_costs_only_the_wakeups(self):
        with mock.patch.object(sb, "open_poke_socket", side_effect=OSError(48, "Address already in use")):
            waits = []
            done = sb.run_daemon(self.world.engine, self.world.state, 5, lambda sock, t: waits.append(sock),
                                 passes=2)
        self.assertEqual((done, waits), (2, [None]))
        self.assertTrue(any(e["event"] == "poke.unavailable" for e in self.world.audit()))


class TestEnsure(Base):
    def setUp(self):
        super().setUp()
        self.state = sb.ensure_state_dir()
        self.spawned = []
        self.holders = []

    def spawn(self, argv, **kwargs):
        """Stands in for Popen: records the call and, like a daemon, takes the lock."""
        self.spawned.append((argv, kwargs))
        fd = os.open(str(self.state / "run.lock"), os.O_RDWR | os.O_CREAT)
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        self.holders.append(fd)
        self.addCleanup(os.close, fd)

    def test_it_starts_a_daemon_that_shares_nothing_with_the_hook(self):
        with mock.patch.dict(os.environ, {"HERDR_PLUGIN_ID": "x", "HERDR_PLUGIN_EVENT": "startup",
                                          "HERDR_PANE_ID": "w1:p1", "HERDR_TAB_ID": "w1:t1",
                                          "HERDR_WORKSPACE_ID": "w1", "HERDR_SOCKET_PATH": "/s/h.sock"}):
            outcome = sb.ensure_daemon(self.state, self.spawn)
        self.assertEqual(outcome, "started")
        argv, kwargs = self.spawned[0]
        self.assertEqual(argv, [sys.executable, str(SWITCHBOARD.resolve()), "run"])
        self.assertEqual(kwargs["stdin"], subprocess.DEVNULL)
        self.assertIs(kwargs["close_fds"], True)
        self.assertIs(kwargs["start_new_session"], True)
        self.assertEqual(kwargs["cwd"], str(self.state))
        env = kwargs["env"]
        self.assertEqual("HERDR_SOCKET_PATH" in env, True)
        for name in ("HERDR_PLUGIN_ID", "HERDR_PLUGIN_EVENT", "HERDR_PANE_ID", "HERDR_TAB_ID", "HERDR_WORKSPACE_ID"):
            self.assertNotIn(name, env)
        self.assertEqual(stat.S_IMODE((self.state / "daemon.log").stat().st_mode), 0o600)
        self.assertNotIn(kwargs["stdout"], (subprocess.PIPE, None, sys.stdout.fileno()))
        self.assertEqual(kwargs["stdout"], kwargs["stderr"])

    def test_a_running_daemon_is_left_alone(self):
        self.spawn([], )
        self.spawned.clear()
        self.assertEqual(sb.ensure_daemon(self.state, self.spawn), "running")
        self.assertEqual(self.spawned, [])

    def test_a_daemon_that_never_takes_its_lock_is_an_error_after_the_patience(self):
        waited = []
        with self.assertRaises(sb.LockError) as caught:
            sb.ensure_daemon(self.state, lambda argv, **kw: None, patience=0.3, sleep=waited.append)
        self.assertIn("daemon.log", str(caught.exception))
        self.assertGreaterEqual(len(waited), 5)

    def test_two_ensures_are_serialised_so_only_one_starts_a_daemon(self):
        starts = []

        def slow_spawn(argv, **kwargs):
            starts.append(1)
            time.sleep(0.3)
            self.spawn(argv, **kwargs)

        threads = [threading.Thread(target=sb.ensure_daemon, args=(self.state, slow_spawn)) for _ in range(2)]
        for thread in threads:
            thread.start()
        for thread in threads:
            thread.join(10)
        self.assertEqual(len(starts), 1)

    def test_the_daemon_environment_drops_the_hooks_pane_and_plugin_variables(self):
        env = sb.daemon_environment({"HERDR_PLUGIN_ROOT": "/p", "HERDR_PLUGIN_CONTEXT_JSON": "{}",
                                     "HERDR_PANE_ID": "w1:p1", "HERDR_TAB_ID": "t", "HERDR_WORKSPACE_ID": "w",
                                     "HERDR_SOCKET_PATH": "/s", "HERDR_BIN_PATH": "/b", "HOME": "/h"})
        self.assertEqual(sorted(env), ["HERDR_BIN_PATH", "HERDR_SOCKET_PATH", "HOME"])

    def test_a_real_ensure_returns_with_pipes_open_and_a_real_poke_wakes_the_real_daemon(self):
        log = self.home / "herdr-calls.log"
        herdr = self.fake_bin("herdr", 'echo "pane=[$HERDR_PANE_ID] plugin=[$HERDR_PLUGIN_ID]" >> %s\n'
                                       'echo \'{"result":{"agents":[]}}\'\n' % log)
        opencode = self.fake_bin("opencode", "exit 1\n")
        self.write_config({"opencode": str(opencode), "herdr": str(herdr), "poll_seconds": 3600})
        env = dict(os.environ, HERDR_PANE_ID="w9:p9", HERDR_PLUGIN_ID="fleet-switchboard")
        started = time.time()
        # capture_output reads to EOF: a daemon that inherited the pipes would hang this call.
        result = subprocess.run([sys.executable, "-B", str(SWITCHBOARD), "ensure"], capture_output=True,
                                text=True, env=env, timeout=20)
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(result.stdout.strip(), "daemon started")
        self.assertLess(time.time() - started, 5)
        pid = int((self.state / "run.lock").read_text())
        self.addCleanup(lambda: os.kill(pid, signal.SIGTERM) if _alive(pid) else None)
        self.assertNotEqual(os.getsid(pid), os.getsid(0), "the daemon must have a session of its own")
        self.assertEqual(sb.ensure_daemon(self.state), "running")
        self.assertTrue(self._wait_for(lambda: log.exists() and len(log.read_text().splitlines()) >= 1))
        self.assertEqual(log.read_text().splitlines()[0], "pane=[] plugin=[]")  # the hook's identity is scrubbed
        before = len(log.read_text().splitlines())
        self.assertEqual(self.run_cli(SWITCHBOARD, "poke").returncode, 0)
        self.assertTrue(self._wait_for(lambda: len(log.read_text().splitlines()) > before),
                        "the poke did not make the daemon pass (poll is an hour)")

    @staticmethod
    def _wait_for(condition, seconds=10):
        deadline = time.time() + seconds
        while time.time() < deadline:
            if condition():
                return True
            time.sleep(0.05)
        return False


def _alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def parse_plugin_manifest(text):
    """Just enough TOML for herdr/herdr-plugin.toml: `key = "string"`, `key = ["a", "b"]`,
    and `[[table]]` headers. Anything else raises, so the file cannot drift
    past what this reads."""
    manifest, table = {}, None
    for number, raw in enumerate(text.splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        header = re.match(r"^\[\[([a-z]+)\]\]$", line)
        if header:
            table = {}
            manifest.setdefault(header.group(1), []).append(table)
            continue
        pair = re.match(r'^([a-z_]+) = (.+)$', line)
        if not pair:
            raise ValueError("line %d is not understood: %r" % (number, raw))
        try:
            value = json.loads(pair.group(2))  # these strings and arrays are valid JSON too
        except ValueError:
            value = None
        if not (isinstance(value, str) or (isinstance(value, list) and all(isinstance(v, str) for v in value))):
            raise ValueError("line %d: value is not a string or a list of strings: %r" % (number, raw))
        (table if table is not None else manifest)[pair.group(1)] = value
    return manifest


class TestPluginManifest(Base):
    PATH = REPO / "herdr" / "herdr-plugin.toml"
    EVENTS = ("pane.agent_status_changed", "pane.created", "pane.closed", "pane.exited", "pane.agent_detected")

    def manifest(self):
        return parse_plugin_manifest(self.PATH.read_text())

    def test_the_manifest_names_the_plugin_and_the_herdr_it_needs(self):
        m = self.manifest()
        self.assertEqual((m["id"], m["min_herdr_version"]), ("fleet-switchboard", "0.9.3"))
        for key in ("name", "version", "description", "platforms"):
            self.assertIn(key, m)

    def test_startup_ensures_and_every_event_pokes(self):
        m = self.manifest()
        self.assertEqual([t["command"] for t in m["startup"]], [["../bin/fleet-switchboard", "ensure"]])
        self.assertEqual(sorted(t["on"] for t in m["events"]), sorted(self.EVENTS))
        for event in m["events"]:
            self.assertEqual(event["command"], ["../bin/fleet-switchboard", "poke"], event["on"])

    def test_every_command_resolves_from_the_plugin_root_to_an_executable_subcommand(self):
        m = self.manifest()
        root = self.PATH.parent  # herdr runs hooks with the manifest's directory as cwd
        commands = [t["command"] for t in m["startup"] + m["events"]]
        choices = set(sb.build_parser()._subparsers._group_actions[0].choices)
        for command in commands:
            program = (root / command[0]).resolve()
            with self.subTest(command=command):
                self.assertEqual(program, SWITCHBOARD.resolve())
                self.assertTrue(os.access(str(program), os.X_OK))
                self.assertIn("/", command[0])  # herdr joins only a path with a slash to the root
                self.assertIn(command[1], choices)
                self.assertEqual(len(command), 2)  # no shell, no arguments to quote

    def test_the_reader_refuses_what_it_does_not_understand(self):
        for text in ('x = 1\n', 'key: "v"\n', '[table]\n', 'command = [a, b]\n'):
            with self.subTest(text=text), self.assertRaises(ValueError):
                parse_plugin_manifest(text)
        planted = self.PATH.read_text().replace("../bin/fleet-switchboard", "../bin/nowhere", 1)
        root = self.PATH.parent
        self.assertFalse((root / parse_plugin_manifest(planted)["startup"][0]["command"][0]).exists())


# --------------------------------------------------------- the restart hazard

class TestRestartGuard(Base):
    """After a herdr restart a pane can come back as a shell, and herdr resumes
    the agent by typing `opencode` into it, which may start another OpenCode.
    Nothing is delivered to a pane that does not run the configured v2."""

    def setUp(self):
        super().setUp()
        self.world = World(self, agents=("platform",))
        self.pane = self.world.panes["platform"]

    def wrong_program(self, program="/opt/homebrew/bin/opencode --session ses_x"):
        self.world.herdr.panes[self.pane]["program"] = program

    def test_runs_program_means_the_executable_alone_or_with_arguments(self):
        exe = "/v2/bin/opencode"
        for cmdline, expected in ((exe, True), (exe + " -s ses_1", True), (exe + "-v1 -s x", False),
                                  ("/opt/homebrew/bin/opencode", False), ("-zsh", False), (None, False)):
            with self.subTest(cmdline=cmdline):
                self.assertEqual(sb.runs_program(cmdline, exe), expected)

    def test_a_pane_on_another_program_is_held_and_nothing_is_written(self):
        self.wrong_program()
        self.world.fact("platform", "lab.fact:1", batch=False)
        report = self.world.engine.run_pass()
        self.assertEqual(self.world.v2.writes, [])
        self.assertEqual(report["sent"], [])
        self.assertIn("different opencode", report["held"][0]["reason"])
        self.assertTrue(any(e["event"] == "hold" and "different opencode" in e["detail"]["reason"]
                            for e in self.world.audit()))

    def test_the_guard_is_audited_even_when_nothing_is_pending(self):
        self.wrong_program()
        self.world.engine.run_pass()
        self.world.engine.run_pass()  # a steady state is audited once, not every pass
        guards = [e for e in self.world.audit() if e["event"] == "program.guard"]
        self.assertEqual(len(guards), 1)
        self.assertEqual(guards[0]["subject"], "platform")

    def test_it_is_toasted_once_and_the_hold_ends_when_the_pane_is_right(self):
        self.wrong_program("-zsh")
        self.world.fact("platform", "lab.fact:1", batch=False)
        self.world.engine.run_pass()
        self.world.tick(5)
        self.world.engine.run_pass()
        self.assertEqual([t["title"] for t in self.world.herdr.toasts], ["platform: pane runs a different opencode"])
        self.wrong_program("%s -s %s" % (FAKE_OPENCODE, self.world.sessions["platform"]))
        self.world.tick(5)
        report = self.world.engine.run_pass()
        self.assertEqual(len(report["sent"]), 1)

    def test_the_recheck_before_a_write_sees_a_pane_that_changed_meanwhile(self):
        self.world.fact("platform", "lab.fact:1", batch=False)
        engine = self.world.engine
        discovery = engine.discover(self.world.clock.now())
        facts, _ = engine.collect_facts()
        plan = engine.plan("platform", facts, discovery, self.world.clock.now())
        self.assertEqual(plan.action, "wake")
        self.wrong_program()
        outcome = engine.deliver(plan)
        self.assertFalse(outcome["sent"])
        self.assertEqual(outcome["action"], "hold")
        self.assertEqual(self.world.v2.writes, [])

    def test_send_is_refused_for_such_a_pane(self):
        self.wrong_program()
        outcome = self.world.new_engine("cli").send("coder", "platform", "hi")
        self.assertEqual(outcome["action"], "hold")
        self.assertEqual(self.world.v2.writes, [])

    def test_a_pane_that_cannot_be_read_is_held_not_assumed_fine(self):
        self.world.herdr.panes[self.pane]["program"] = None
        original = self.world.herdr._process_info

        def failing(rest):
            raise LookupError("no such pane")

        self.world.herdr._process_info = failing
        self.world.fact("platform", "lab.fact:1", batch=False)
        report = self.world.engine.run_pass()
        self.assertEqual(report["sent"], [])
        self.assertIn("cannot read what pane", report["held"][0]["reason"])
        self.world.herdr._process_info = original

    def test_a_wrapper_is_checked_by_the_executable_it_runs(self):
        world = World(self, agents=("platform",), config={
            "opencode": "/fake/bin/wrapper", "opencode_executable": FAKE_OPENCODE})
        world.fact("platform", "lab.fact:1", batch=False)
        self.assertEqual(len(world.engine.run_pass()["sent"]), 1)  # the pane runs FAKE_OPENCODE
        other = World(self, agents=("platform",), config={
            "opencode": "/fake/bin/wrapper", "opencode_executable": "/fake/bin/the-real-one"},
            state=self.home / "other")
        other.fact("platform", "lab.fact:1", batch=False)
        self.assertEqual(other.engine.run_pass()["sent"], [])

    def test_a_relative_executable_is_a_config_error(self):
        with self.assertRaises(sb.ConfigError):
            sb.validate_config({"opencode_executable": "opencode"})
        with self.assertRaises(sb.ConfigError):
            sb.validate_config({"launch_env": {"A": 1}})


# --------------------------------------------------------- the render step

class TestRender(Base):
    def setUp(self):
        super().setUp()
        self.world = World(self, agents=("platform", "coder"))
        self.engine = self.world.engine

    def pane(self, name="platform"):
        return self.world.herdr.panes[self.world.panes[name]]

    def block(self, name="platform"):
        self.pane(name)["status"] = "blocked"

    def badge_writes(self):
        return [a for a in self.world.herdr.calls if a[2:3] == ["report-metadata"]]

    def test_held_items_are_the_badge_and_it_is_written_only_when_it_changes(self):
        self.block()
        self.world.fact("platform", "lab.fact:1", batch=False)
        self.world.fact("platform", "lab.fact:2", batch=False)
        report = self.engine.run_pass()
        self.assertEqual(report["badges"], [{"agent": "platform", "count": 2}])
        self.assertEqual(self.pane()["tokens"], {"unread": "2"})
        self.assertEqual(len(self.badge_writes()), 1)
        self.world.tick(5)
        self.engine.run_pass()
        self.assertEqual(len(self.badge_writes()), 1)  # the agent list already shows 2

    def test_the_badge_is_restored_after_herdr_forgets_its_tokens(self):
        self.block()
        self.world.fact("platform", "lab.fact:1", batch=False)
        self.engine.run_pass()
        self.pane()["tokens"] = {}  # a herdr restart
        self.engine.run_pass()
        self.assertEqual(self.pane()["tokens"], {"unread": "1"})

    def test_it_clears_when_nothing_is_unread_and_not_before(self):
        self.engine.run_pass()
        self.assertEqual(self.badge_writes(), [])  # nothing unread, no token: no write
        self.block()
        self.world.fact("platform", "lab.fact:1", batch=False)
        self.engine.run_pass()
        self.pane()["status"] = None
        self.world.tick(5)
        self.engine.run_pass()  # unblocked: the item is delivered as a wake
        self.assertEqual(self.pane()["tokens"], {})
        self.assertEqual(self.badge_writes()[-1][2:], ["report-metadata", self.world.panes["platform"],
                                                      "--source", "fleet-switchboard", "--clear-token", "unread"])

    def test_a_note_is_unread_until_a_turn_carries_it(self):
        self.world.you("platform")  # you are engaged: the next item is a note
        self.world.tick(1)
        self.world.fact("platform", "lab.fact:1", batch=False)
        self.world.fact("platform", "lab.fact:2", batch=False)
        self.engine.run_pass()
        self.assertEqual(len(self.world.v2.sessions[self.world.sessions["platform"]]["inbox"]), 1)
        self.assertEqual(self.pane()["tokens"], {"unread": "2"})  # one note, two facts
        self.world.tick(5)
        self.engine.run_pass()
        self.assertEqual(self.pane()["tokens"], {"unread": "2"})
        self.world.you("platform", "and next?")  # a turn starts and carries the note
        self.world.tick(5)
        self.engine.run_pass()
        self.assertEqual(self.pane()["tokens"], {})

    def test_a_wake_is_never_unread(self):
        self.world.fact("platform", "lab.fact:1", batch=False)
        self.engine.run_pass()
        self.assertEqual(self.pane()["tokens"], {})

    def test_badge_writes_are_audited_before_and_after(self):
        self.block()
        self.world.fact("platform", "lab.fact:1", batch=False)
        self.engine.run_pass()
        entries = [e for e in self.world.audit() if e["event"] == "herdr.badge"]
        self.assertEqual([e["phase"] for e in entries], ["intent", "result"])
        self.assertEqual((entries[0]["detail"]["count"], entries[0]["detail"]["was"]), (1, None))

    def test_a_blocked_agent_is_toasted_once_until_the_reason_changes(self):
        self.block()
        for _ in range(3):
            self.engine.run_pass()
            self.world.tick(5)
        self.assertEqual([t["title"] for t in self.world.herdr.toasts], ["platform is blocked"])
        self.pane()["status"] = None
        self.engine.run_pass()
        self.world.tick(5)
        self.block()  # blocked again: a new reason after the old one cleared
        self.engine.run_pass()
        self.assertEqual(len(self.world.herdr.toasts), 2)

    def test_an_item_held_fifteen_minutes_is_toasted_and_not_before(self):
        self.world.fact("ghost", "lab.fact:1", batch=False)
        self.engine.run_pass()
        self.world.tick(14 * 60)
        self.engine.run_pass()
        self.assertEqual(self.world.herdr.toasts, [])
        self.world.tick(61)
        self.engine.run_pass()
        self.assertEqual([t["title"] for t in self.world.herdr.toasts], ["ghost: 1 item(s) held"])
        self.assertIn("ghost not found", self.world.herdr.toasts[0]["body"])
        self.world.tick(5)
        self.engine.run_pass()
        self.assertEqual(len(self.world.herdr.toasts), 1)

    def test_a_changed_hold_reason_is_a_new_toast(self):
        self.world.fact("platform", "lab.fact:1", batch=False)
        self.world.herdr.panes[self.world.panes["platform"]]["status"] = "unknown"
        self.engine.run_pass()
        self.world.tick(16 * 60)
        self.engine.run_pass()
        self.assertEqual(len(self.world.herdr.toasts), 1)
        self.block()
        self.world.tick(5)
        self.engine.run_pass()
        self.assertEqual([t["title"] for t in self.world.herdr.toasts],
                         ["platform: 1 item(s) held", "platform is blocked"])

    def test_one_notification_call_per_pass_even_with_two_reasons(self):
        self.block("platform")
        self.block("coder")
        self.engine.run_pass()
        calls = [a for a in self.world.herdr.calls if a[1] == "notification"]
        self.assertEqual(len(calls), 1)
        self.world.tick(5)
        self.engine.run_pass()
        self.assertEqual(sorted(t["title"] for t in self.world.herdr.toasts),
                         ["coder is blocked", "platform is blocked"])

    def test_rate_limited_busy_and_no_client_are_owed_and_retried_next_pass(self):
        self.block()
        self.world.herdr.toast_replies = ["rate_limited", "busy", "no_foreground_client"]
        for expected in (0, 0, 0, 1):
            report = self.engine.run_pass()
            self.assertEqual(len(self.world.herdr.toasts), expected)
            self.world.tick(5)
        self.assertEqual([t["why"] for t in report["toasts"]], ["shown"])

    def test_disabled_is_final_and_not_retried(self):
        self.block()
        self.world.herdr.toast_replies = ["disabled"]
        for _ in range(3):
            self.engine.run_pass()
            self.world.tick(5)
        self.assertEqual(len([a for a in self.world.herdr.calls if a[1] == "notification"]), 1)

    def test_the_reply_is_audited(self):
        self.block()
        self.world.herdr.toast_replies = ["rate_limited"]
        self.engine.run_pass()
        entries = [e for e in self.world.audit() if e["event"] == "herdr.notification"]
        self.assertEqual([e["phase"] for e in entries], ["intent", "result"])
        self.assertEqual(entries[1]["detail"]["reply"], {"shown": False, "reason": "rate_limited"})

    def test_a_failing_toast_never_stops_a_delivery(self):
        self.block("coder")
        self.world.fact("platform", "lab.fact:1", batch=False)
        self.world.herdr.toast_replies = []
        real = self.world.herdr._notification_show
        self.world.herdr._notification_show = lambda rest: (_ for _ in ()).throw(LookupError("herdr broke"))
        report = self.engine.run_pass()
        self.world.herdr._notification_show = real
        self.assertEqual(len(report["sent"]), 1)
        self.assertEqual([e["step"] for e in report["errors"]] if False else
                         [e["subject"] for e in report["errors"]], [None])

    def test_a_read_only_engine_renders_nothing(self):
        self.block()
        self.world.fact("platform", "lab.fact:1", batch=False)
        self.world.new_engine(writable=False).run_pass()
        self.assertEqual(self.badge_writes(), [])
        self.assertEqual(self.world.herdr.toasts, [])


# ------------------------------------------------------------------- launching

class TestLaunch(Base):
    def setUp(self):
        super().setUp()
        self.world = World(self, agents=("platform",))
        self.work = self.home / "work"
        self.work.mkdir()
        self.order = []
        v2, herdr = self.world.v2, self.world.herdr

        def tracing(label, fake):
            def run(argv, **kwargs):
                self.order.append((label, argv[1:4] if label == "herdr" else argv[2:3]))
                return fake(argv, **kwargs)
            return run

        def socket_call(*args):
            self.order.append(("socket", list(args[1:2])))
            return herdr.socket(*args)

        config = dict(self.world.config, opencode_env={"XDG_CONFIG_HOME": "/lab/config"},
                      launch_env={"FLEET_SWITCHBOARD_LAB_PANE": "1"})
        self.engine = sb.Switchboard(config, sb.V2Client(FAKE_OPENCODE, {}, tracing("v2", v2), 5),
                                     sb.HerdrClient(FAKE_HERDR, tracing("herdr", herdr), socket_call=socket_call),
                                     sb.AuditLog(self.world.audit_path), sb.fact_sources(self.world.state),
                                     self.world.clock.now, "cli")
        self.sleeps = []

    def sleep(self, seconds):
        self.sleeps.append(seconds)
        self.world.tick(seconds)

    def launch(self, **overrides):
        args = dict(name="coder", agent="coder", directory=str(self.work), workspace="w1", role="coder",
                    reports_to="platform", issue=7, brief="Add a health check", patience=5, sleep=self.sleep)
        args.update(overrides)
        return sb.launch_agent(self.engine, **args)

    def new_session(self, done):
        return self.world.v2.sessions[done["session"]]

    def test_it_creates_the_session_opens_the_tab_verifies_and_only_then_briefs(self):
        done = self.launch()
        session = self.new_session(done)
        self.assertEqual(session["metadata"], {"fleet": {"name": "coder", "role": "coder",
                                                         "reports_to": "platform", "issue": 7}})
        self.assertEqual((session["agent"], session["directory"], session["title"]),
                         ("coder", str(self.work), "coder"))
        method, params = self.world.herdr.socket_calls[0]
        self.assertEqual(method, "layout.apply")
        self.assertEqual(params["workspace_id"], "w1")
        self.assertEqual(params["root"]["command"], [FAKE_OPENCODE, "-s", done["session"]])
        self.assertEqual(params["root"]["env"], {"XDG_CONFIG_HOME": "/lab/config", "FLEET_SWITCHBOARD_LAB_PANE": "1"})
        self.assertEqual(done["pane"], "w1:p%d" % self.world.herdr._pane_n)
        brief = [m for m in session["messages"] if m["type"] == "user"]
        self.assertEqual([(m["text"], m["metadata"]) for m in brief],
                         [("Add a health check", {"fleet": {"from": "switchboard", "brief": True}})])
        opened = self.order.index(("socket", ["layout.apply"]))
        prompt = self.order.index(("v2", ["session.prompt"]))
        between = self.order[opened:prompt]  # after the tab opens and before the brief: the checks
        self.assertIn(("herdr", ["agent", "get", done["pane"]]), between)
        self.assertIn(("herdr", ["pane", "process-info", "--pane"]), between)

    def test_an_orchestrators_charter_is_recorded_so_the_chief_of_staff_can_find_its_asks(self):
        done = self.launch(name="platform2", role="orchestrator", issue=1, charter=1)
        self.assertEqual(self.new_session(done)["metadata"]["fleet"]["charter"], 1)
        self.assertNotIn("charter", self.new_session(self.launch(name="coder2"))["metadata"]["fleet"])

    def test_a_charter_must_be_an_issue_number(self):
        for bad in (0, -3, "1", True):
            with self.subTest(charter=bad), self.assertRaises(sb.LaunchError):
                self.launch(name="orch", role="orchestrator", charter=bad)

    def test_nothing_is_typed_and_focus_is_never_asked_for(self):
        self.launch()
        self.assertEqual(self.world.herdr.typing_attempts, [])
        for argv in self.world.herdr.calls:
            self.assertIn(argv[1:3], HERDR_ALLOWED)
        self.assertNotIn("focus", json.dumps(self.world.herdr.socket_calls).lower())

    def test_each_write_is_audited_before_and_after(self):
        self.launch()
        entries = [(e["event"], e["phase"]) for e in self.world.audit() if e["event"].startswith(("v2.", "herdr."))]
        self.assertEqual(entries, [("v2.session.create", "intent"), ("v2.session.create", "result"),
                                   ("herdr.layout.apply", "intent"), ("herdr.layout.apply", "result"),
                                   ("v2.session.prompt", "intent"), ("v2.session.prompt", "result")])
        layout = [e for e in self.world.audit() if e["event"] == "herdr.layout.apply"]
        self.assertEqual(layout[0]["detail"]["env_names"], ["FLEET_SWITCHBOARD_LAB_PANE", "XDG_CONFIG_HOME"])
        self.assertNotIn("/lab/config", json.dumps(layout))  # names, never values
        self.assertEqual(layout[1]["detail"]["pane"], self.world.herdr.panes and layout[1]["detail"]["pane"])

    def test_no_brief_means_no_prompt(self):
        done = self.launch(brief=None)
        self.assertEqual([m for m in self.new_session(done)["messages"] if m["type"] == "user"], [])
        self.assertNotIn(("v2", ["session.prompt"]), self.order)

    def test_a_pane_that_is_not_the_configured_program_is_refused_and_closed(self):
        for mode in ("shell", "other-session", "undetected"):
            with self.subTest(mode=mode):
                world = World(self, agents=("platform",), state=self.home / ("state-" + mode))
                world.herdr.launch_mode = mode
                engine = sb.Switchboard(world.config, sb.V2Client(FAKE_OPENCODE, {}, world.v2, 5),
                                        sb.HerdrClient(FAKE_HERDR, world.herdr, socket_call=world.herdr.socket),
                                        sb.AuditLog(world.audit_path), [], world.clock.now, "cli")
                before = set(world.herdr.panes)
                with self.assertRaises(sb.LaunchError) as caught:
                    sb.launch_agent(engine, "coder", "coder", str(self.work), "w1", "coder", brief="hello",
                                    patience=3, sleep=lambda s: world.tick(s))
                new = set(world.herdr.panes) - before
                self.assertEqual(new, set(), "the pane this launch opened must be closed")
                self.assertEqual(len(world.herdr.closed), 1)
                self.assertIn("could not verify", str(caught.exception))
                self.assertIn("session ses_", str(caught.exception))
                users = [m for s in world.v2.sessions.values() for m in s["messages"]
                         if m["type"] == "user" and m["text"] == "hello"]
                self.assertEqual(users, [], "the brief must not be sent to an unverified pane")
                self.assertTrue(any(e["event"] == "herdr.pane.close" and e["phase"] == "result"
                                    for e in world.audit()))

    def test_verification_waits_for_herdr_to_name_the_session(self):
        world = World(self, agents=("platform",), state=self.home / "late")
        world.herdr.launch_mode = "undetected"
        engine = sb.Switchboard(world.config, sb.V2Client(FAKE_OPENCODE, {}, world.v2, 5),
                                sb.HerdrClient(FAKE_HERDR, world.herdr, socket_call=world.herdr.socket),
                                sb.AuditLog(world.audit_path), [], world.clock.now, "cli")
        sleeps = []

        def sleep(seconds):
            sleeps.append(seconds)
            world.tick(seconds)
            for entry in world.herdr.panes.values():
                if sleeps and len(sleeps) == 2:
                    entry.pop("undetected", None)

        done = sb.launch_agent(engine, "coder", "coder", str(self.work), "w1", brief="hello", patience=10, sleep=sleep)
        self.assertEqual(len(sleeps), 2)
        self.assertEqual(world.herdr.closed, [])
        self.assertTrue(done["pane"])

    def test_only_the_pane_it_opened_is_ever_closed(self):
        self.world.herdr.launch_mode = "shell"
        before = dict(self.world.herdr.panes)
        with self.assertRaises(sb.LaunchError):
            self.launch(patience=2)
        self.assertEqual(self.world.herdr.panes, before)  # platform's pane untouched
        self.assertEqual(len(self.world.herdr.closed), 1)
        self.assertNotIn(self.world.herdr.closed[0], before)

    def test_a_failed_layout_closes_nothing(self):
        self.world.herdr.socket_down = True
        with self.assertRaises(sb.LaunchError) as caught:
            self.launch()
        self.assertEqual(self.world.herdr.closed, [])
        self.assertIn("no pane was opened", str(caught.exception))

    def test_a_name_already_in_use_is_refused_before_anything_is_created(self):
        before = len(self.world.v2.sessions)
        with self.assertRaises(sb.LaunchError) as caught:
            self.launch(name="platform")
        self.assertIn("already runs", str(caught.exception))
        self.assertEqual((len(self.world.v2.sessions), self.world.herdr.socket_calls), (before, []))

    def test_bad_arguments_are_refused_before_anything_is_created(self):
        cases = [dict(name="Bad Name"), dict(name=""), dict(directory="relative/dir"),
                 dict(directory=str(self.home / "missing")), dict(workspace=None), dict(agent=""), dict(issue=0)]
        for overrides in cases:
            with self.subTest(overrides=overrides), self.assertRaises(sb.LaunchError):
                self.launch(**overrides)
        self.assertEqual((self.world.v2.calls, self.world.herdr.socket_calls), ([], []))

    def test_close_is_used_by_launch_alone(self):
        tree = ast.parse(SWITCHBOARD.read_text())
        callers = set()
        for function in ast.walk(tree):
            if isinstance(function, ast.FunctionDef):
                for node in ast.walk(function):
                    if isinstance(node, ast.Attribute) and node.attr == "pane_close":
                        callers.add(function.name)
        self.assertEqual(callers, {"close_own_pane"})
        for function in ast.walk(tree):
            if isinstance(function, ast.FunctionDef) and function.name == "launch_agent":
                calls = [n.func.id for n in ast.walk(function) if isinstance(n, ast.Call)
                         and isinstance(n.func, ast.Name) and n.func.id == "close_own_pane"]
                self.assertEqual(len(calls), 1)  # guarded by `if pane`: only what it opened
        for function in ast.walk(tree):
            if isinstance(function, ast.FunctionDef) and function.name == "resume_agent":
                calls = [n for n in ast.walk(function) if isinstance(n, ast.Call)
                         and isinstance(n.func, ast.Name) and n.func.id == "close_own_pane"]
                self.assertEqual(len(calls), 1)  # a restart closes only the pane it opened itself

    def gone(self, name="platform"):
        """The agent's pane is closed (its TUI quit); its session lives on in v2."""
        session, pane = self.world.sessions[name], self.world.panes[name]
        self.world.v2.sessions[session]["directory"] = str(self.work)  # a real session always has one
        del self.world.herdr.panes[pane]
        return session

    def test_resume_opens_a_tab_on_the_same_session_and_creates_and_sends_nothing(self):
        session = self.gone()
        sessions, messages = set(self.world.v2.sessions), len(self.world.v2.sessions[session]["messages"])
        done = sb.resume_agent(self.engine, "platform", session, "w1", patience=5, sleep=self.sleep)
        self.assertEqual(done["session"], session)
        self.assertEqual(set(self.world.v2.sessions), sessions, "no new session")
        self.assertEqual(len(self.world.v2.sessions[session]["messages"]), messages, "no brief, no prompt")
        method, params = self.world.herdr.socket_calls[-1]
        self.assertEqual((method, params["root"]["command"], params["root"]["cwd"]),
                         ("layout.apply", [FAKE_OPENCODE, "-s", session], self.world.v2.sessions[session]["directory"]))
        self.assertEqual(params["root"]["env"], {"XDG_CONFIG_HOME": "/lab/config", "FLEET_SWITCHBOARD_LAB_PANE": "1"})
        found = self.engine.discover(self.world.clock.now()).agents["platform"]
        self.assertEqual((found.session_id, found.pane), (session, done["pane"]))
        self.assertEqual(self.world.herdr.typing_attempts, [])

    def test_resume_refuses_a_session_that_belongs_to_someone_else(self):
        other = self.world.add_agent("coder3", fleet={"role": "coder"})
        self.gone("platform")
        with self.assertRaises(sb.LaunchError) as caught:
            sb.resume_agent(self.engine, "platform", self.world.sessions["coder3"], "w1", patience=2, sleep=self.sleep)
        self.assertIn("belongs to", str(caught.exception))
        self.assertEqual(self.world.herdr.socket_calls, [])

    def test_resume_refuses_while_the_agent_still_has_a_pane(self):
        self.world.v2.sessions[self.world.sessions["platform"]]["directory"] = str(self.work)
        with self.assertRaises(sb.LaunchError) as caught:
            sb.resume_agent(self.engine, "platform", self.world.sessions["platform"], "w1", patience=2, sleep=self.sleep)
        self.assertIn("already runs", str(caught.exception))
        self.assertEqual(self.world.herdr.socket_calls, [])

    def test_a_resume_that_fails_verification_closes_only_its_own_pane(self):
        session = self.gone()
        self.world.herdr.launch_mode = "shell"
        before = set(self.world.herdr.panes)
        with self.assertRaises(sb.LaunchError) as caught:
            sb.resume_agent(self.engine, "platform", session, "w1", patience=2, sleep=self.sleep)
        self.assertIn("is untouched", str(caught.exception))
        self.assertEqual(len(self.world.herdr.closed), 1)
        self.assertNotIn(self.world.herdr.closed[0], before)

    def test_the_cli_resumes_by_session_and_a_plain_launch_still_needs_agent_and_dir(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        os.environ["HERDR_WORKSPACE_ID"] = "w1"
        session = self.gone()
        with captured() as (out, err):
            code = sb.main(["launch", "platform", "--resume", session], runner=self.world.route,
                           now=self.world.clock.now, socket_call=self.world.herdr.socket)
        self.assertEqual((code, json.loads(out.getvalue())["session"]), (0, session), err.getvalue())
        with captured() as (out, err):
            code = sb.main(["launch", "coder9"], runner=self.world.route, now=self.world.clock.now,
                           socket_call=self.world.herdr.socket)
        self.assertNotEqual(code, 0)
        self.assertIn("--agent and --dir", err.getvalue())

    def test_the_cli_takes_the_workspace_from_the_pane_it_runs_in(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        os.environ["HERDR_WORKSPACE_ID"] = "w1"
        argv = ["launch", "coder", "--agent", "coder", "--dir", str(self.work), "--role", "coder",
                "--reports-to", "platform", "--issue", "7", "--brief-file", "-"]
        with captured() as (out, err), mock.patch.object(sb.sys, "stdin", io.StringIO("Do the thing\n")):
            code = sb.main(argv, runner=self.world.route, now=self.world.clock.now,
                           socket_call=self.world.herdr.socket)
        self.assertEqual(code, 0, err.getvalue())
        done = json.loads(out.getvalue())
        self.assertEqual(sorted(done), ["name", "pane", "session", "tab"])
        session = self.world.v2.sessions[done["session"]]
        self.assertEqual(session["metadata"]["fleet"]["reports_to"], "platform")
        self.assertEqual(session["messages"][0]["text"], "Do the thing\n")

    def test_the_cli_without_a_workspace_is_refused(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        os.environ.pop("HERDR_WORKSPACE_ID", None)
        with captured() as (out, err):
            code = sb.main(["launch", "coder", "--agent", "coder", "--dir", str(self.work)],
                           runner=self.world.route, now=self.world.clock.now, socket_call=self.world.herdr.socket)
        self.assertEqual(code, 1)
        self.assertIn("--workspace", err.getvalue())
        self.assertEqual(self.world.herdr.socket_calls, [])

    def test_an_empty_or_missing_brief_file_is_refused(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        empty = self.home / "empty.md"
        empty.write_text("  \n")
        for path in (str(empty), str(self.home / "nope.md")):
            with self.subTest(path=path), captured() as (out, err):
                code = sb.main(["launch", "coder", "--agent", "coder", "--dir", str(self.work), "--workspace", "w1",
                                "--brief-file", path], runner=self.world.route, now=self.world.clock.now,
                               socket_call=self.world.herdr.socket)
                self.assertEqual(code, 1)
        self.assertEqual(self.world.herdr.socket_calls, [])


# --------------------------------------------------- the offline scenario runner

SCENARIO_REPORTS = []


def _matches(keys, pattern):
    return any(fnmatch.fnmatchcase(key, pattern) for key in keys)


JEV_REPLAY = REPO / "scenarios" / "jev" / "replay.json"
JEV_SCENARIO_CONFIG = {"jev": {"replay": str(JEV_REPLAY)}}  # the hand-written answers every scenario runs against


def classified_in_audit(entries, agent, text, choice):
    """True when the audit's last classification of that agent's message `text` chose `choice`."""
    found = [e for e in entries if e.get("event") == "classify"
             and (e.get("detail") or {}).get("agent") == agent
             and text in ((e["detail"].get("question") or {}).get("state") or {}).get("message", "")]
    got = found[-1]["detail"]["answer"]["choice"] if found else None
    return got == choice, "%d classification(s) of the message; the last chose %r" % (len(found), got)


class OfflineRun:
    """One scenario on the fakes: a pass every POLL seconds while the daemon
    runs, steps applied at their times, a simulated clock in 1 s ticks.
    Expectations are judged on the fakes' state, never on the engine's report."""

    POLL = 5

    def __init__(self, test, scenario, label, faults=(), baseline=None):
        self.scenario = scenario
        self.faults = sorted(faults)
        self.baseline = baseline
        self.work = test.home / "scenario-repo"
        self.work.mkdir(exist_ok=True)
        self.world = World(test, agents=(), state=test.home / "scenario-runs" / scenario["id"] / label,
                           config=dict(JEV_SCENARIO_CONFIG, **(scenario.get("config") or {})))
        launched = {step["agent"] for step in scenario["steps"] if step["do"] in ("launch", "import-v1")}
        for name, member in sorted(scenario["cast"].items()):
            if name not in launched:  # a launched agent does not exist until `launch` makes it
                self.world.add_agent(name, fleet=self.fleet_of(member))
        attach_intent_lab(self)  # PR 6: a fake GitHub when the scenario has issues
        self.world.engine = self.world.new_engine()
        self.daemon = True
        self.crashed_writes = set()
        self.launched = {}

    @staticmethod
    def fleet_of(member):
        return {key: member[key] for key in ("role", "reports_to", "issue", "charter") if key in member}

    def run(self):
        steps = list(self.scenario["steps"])
        end = max([sc.duration_seconds(step["at"]) for step in steps] or [0])
        for second in range(end + 1):
            self.world.clock.t = EPOCH + second
            self.world.v2.advance()
            while steps and sc.duration_seconds(steps[0]["at"]) == second:
                self.apply(steps.pop(0))
            if self.daemon and second % self.POLL == 0:
                self.one_pass(())
        return self

    def apply(self, step):
        do, world = step["do"], self.world
        if do == "fact" and self.baseline == "fleet-heartbeat":
            self.type_wake(step)
        elif do == "fact":
            world.fact(step["to"], step["key"], step["summary"], kind=step.get("kind", "lab.fact"),
                       issue=step.get("issue"), batch=step.get("batch", True), **{"from": step.get("from", "world")})
        elif do == "turn":
            world.v2.start_turn(world.sessions[step["actor"]], "fleet task", fleet=True,
                                lasts=sc.duration_seconds(step.get("lasts", "0s")), steps=step.get("steps", 1))
        elif do == "message":
            if step["actor"] != "you":
                raise NotImplementedError("offline: a message comes from you")
            world.v2.start_turn(world.sessions[step["to"]], step["text"], fleet=False,
                                lasts=sc.duration_seconds(step.get("lasts", "0s")))
        elif do == "draft":
            world.herdr.input_box[world.panes[step["to"]]] = step["text"]  # you, typing; nothing is sent
        elif do == "launch":
            self.launch(step)
        elif do == "pass":
            self.one_pass(step.get("faults", ()))
        elif do == "kill-daemon":
            self.daemon = False
        elif do == "restart-daemon":
            self.daemon = True
            world.engine = world.new_engine()  # a new process: nothing in memory survives
        elif do in WORKER_STEPS:
            apply_worker_step(self, step)
        elif do == "edit-intent":
            apply_edit_intent(self, step)
        elif do == "handoff":  # PR 8
            apply_handoff_step(self, step)
        elif do != "wait":
            raise NotImplementedError("the offline runner does not implement step %r" % do)

    def type_wake(self, step):
        """The baseline: today's heartbeat types the wake with `herdr agent prompt`.
        This runner is the only code allowed to; the engine never does."""
        herdr = self.world.herdr
        herdr.allow_typing = True
        herdr([FAKE_HERDR, "agent", "prompt", self.world.panes[step["to"]], "[heartbeat] " + step["summary"]])
        herdr.allow_typing = False

    def launch(self, step):
        """fleet-switchboard launch, as the CLI runs it, on the fakes."""
        name, world = step["agent"], self.world
        member = self.scenario["cast"][name]
        done = sb.launch_agent(
            world.new_engine("cli"), name, "coder" if member["role"] == "coder" else member["role"], str(self.work),
            "w1", member["role"], member.get("reports_to"), member.get("issue"), step.get("brief"),
            patience=5, sleep=lambda seconds: setattr(world.clock, "t", world.clock.t + seconds))
        world.sessions[name], world.panes[name] = done["session"], done["pane"]
        self.launched[name] = done

    def one_pass(self, step_faults):
        os.environ[sb.FAULT_ENV] = ",".join(sorted(set(self.faults) | set(step_faults)))
        first = len(self.world.v2.writes)
        try:
            self.world.engine.run_pass()
        except sb.SimulatedCrash:
            self.crashed_writes.update(range(first, len(self.world.v2.writes)))
            self.world.engine = self.world.new_engine()
        finally:
            os.environ[sb.FAULT_ENV] = ",".join(self.faults)

    # -- oracles: each returns (ok, what was observed)
    def mode_of(self, name, message_id):
        """How a delivered message reached the model, from the model calls:
        `wake` when it was the input that called the model (it started a turn
        from idle, or ran after the final reply); `note` when it rode along
        with another input, or was injected between steps. The same rule as
        the Lab's (scenarios/switchboard/README.md)."""
        for call in self.world.model_calls(name):
            ids = [i["id"] for i in call["inputs"]]
            if message_id in ids:
                woke = ids[-1] == message_id and call["phase"] in ("turn_start", "after_reply")
                return "wake" if woke else "note"
        return None

    def oracle_delivered(self, e):
        found = [a for a in self.world.admissions(e["to"])
                 if a["delivered_at"] is not None and _matches(a["keys"], e["key"])]
        if "mode" in e:
            found = [a for a in found if self.mode_of(e["to"], a["id"]) == e["mode"]]
        if "text" in e:
            found = [a for a in found if e["text"] in a["text"]]
        keys = {key for a in found for key in a["keys"] if fnmatch.fnmatchcase(key, e["key"])}
        ok = len(found) == e["count"] if "count" in e else bool(found)
        if "keys" in e:
            ok = ok and len(keys) == e["keys"]
        return ok, "%d message(s) in the transcript carry %d matching key(s)" % (len(found), len(keys))

    def oracle_message_count(self, e):
        found = [a for a in self.world.admissions(e["to"]) if a["from"] == "switchboard"]
        return len(found) == e["count"], "%d switchboard message(s) admitted" % len(found)

    def oracle_model_saw(self, e):
        when = e.get("when", "any")
        calls = [c for c in self.world.model_calls(e["agent"], None if when == "any" else when)
                 if any(_matches(i["keys"], e["key"]) for i in c["inputs"])]
        ok = len(calls) == e["count"] if "count" in e else bool(calls)
        return ok, "%d model call(s) (%s) carried it, at %s s" % (
            len(calls), when, [int(c["at"] - EPOCH) for c in calls])

    def oracle_draft_intact(self, e):
        """The fake herdr's input box still holds the draft, and no message sent it."""
        draft = " ".join(e["text"].split())
        box = " ".join(self.world.herdr.input_box.get(self.world.panes[e["agent"]], "").split())
        session = self.world.v2.sessions[self.world.sessions[e["agent"]]]
        sent = [m["id"] for m in session["messages"] if m["type"] == "user" and draft in " ".join(m["text"].split())]
        return draft in box and not sent, "input box %r; sent in: %s" % (box, ", ".join(sent) or "no message")

    def oracle_metadata_roundtrip(self, e):
        name = e["agent"]
        session = self.world.v2.sessions[self.world.sessions[name]]
        if e.get("of", "session") == "session":
            want = e["fleet"] if "fleet" in e else dict(
                {"name": name}, **self.fleet_of(self.scenario["cast"][name]))
            got = (session["metadata"] or {}).get("fleet")
            return got == want, "session.get metadata.fleet = %s; expected %s" % (got, want)
        if e.get("key"):
            found = [m for m in session["messages"] if _matches(_record_keys(m), e["key"])]
        else:
            found = [m for m in session["messages"] if m["type"] in ("user", "synthetic") and e["text"] in m["text"]]
        if not found:
            return False, "no message with %r in the transcript" % (e.get("key") or e.get("text"))
        default = {"keys": [e["key"]]} if e.get("key") else None
        want, got = e.get("fleet", default), (found[0].get("metadata") or {}).get("fleet")
        return got == want, "%s metadata.fleet = %s; expected %s" % (found[0]["type"], got, want)

    def launched_pane(self, name):
        """The pane herdr says shows this agent's session, found through herdr's agent list."""
        session = self.world.sessions[name]
        for pane in sorted(self.world.herdr.panes):
            if sb.agent_session(self.world.herdr.agent(pane)) == session:
                return pane, self.world.herdr.panes[pane]
        return None, None

    def oracle_pane_runs_v2(self, e):
        pane, entry = self.launched_pane(e["agent"])
        if pane is None:
            return False, "no herdr pane shows session %s" % self.world.sessions[e["agent"]]
        program = entry["program"] or ""
        ok = sb.runs_program(program, FAKE_OPENCODE) and program.endswith("-s " + self.world.sessions[e["agent"]])
        return ok, "pane %s runs %r (agent opencode on %s)" % (pane, program, self.world.sessions[e["agent"]])

    def oracle_no_typing(self, e):
        """The pane was started by argv, so it has no shell, and herdr was asked to type nothing."""
        pane, entry = self.launched_pane(e["agent"])
        typed = self.world.herdr.typing_attempts
        ok = entry is not None and entry.get("argv", [None])[0] == FAKE_OPENCODE and not typed
        return ok, "pane %s opened by argv %s; typing attempts: %s" % (pane, (entry or {}).get("argv"), typed or "none")
    def oracle_classified(self, e):  # PR 7: see "PR 7" below
        return classified_in_audit(self.world.audit(), e["agent"], self.scenario["steps"][e["step"]]["text"], e["as"])

    def evaluate(self):
        results = []
        for expectation in self.scenario["expect"]:
            oracle = getattr(self, "oracle_" + expectation["that"], None)
            if oracle is None:
                raise NotImplementedError("the offline runner has no oracle %r" % expectation["that"])
            ok, seen = oracle(expectation)
            results.append({"label": expectation.get("name", expectation["that"]),
                            "that": expectation["that"], "ok": ok, "seen": seen})
        return results

    def implicit(self):
        """Checked in every run: each write audited before and after (unless
        the process crashed right after it), and herdr never asked to type."""
        problems = []
        entries = self.world.audit()
        for index, write in enumerate(self.world.v2.writes):
            before = entries[:write["audit_lines"]]
            intents = [e for e in before if e.get("phase") == "intent"
                       and write["id"] in ((e.get("detail") or {}).get("message_id"),
                                           (e.get("detail") or {}).get("inbox_id"))]
            if not intents:
                problems.append("%s %s had no audit intent before it" % (write["op"], write["id"]))
                continue
            call = intents[-1]["call"]
            if index not in self.crashed_writes and not any(
                    e.get("phase") == "result" and e.get("call") == call for e in entries):
                problems.append("%s %s has no audit result" % (write["op"], write["id"]))
        for argv in self.world.herdr.calls:
            if argv[1:3] not in HERDR_ALLOWED:
                problems.append("herdr asked for %r" % argv[1:])
        problems.extend("herdr was asked to type: %r" % attempt for attempt in self.world.herdr.typing_attempts)
        problems.extend("herdr socket method %r" % method for method, _ in self.world.herdr.socket_calls
                        if method not in SOCKET_ALLOWED)
        return problems


def control_play(test, scenario):
    """The control's play and a line saying what it switched off or swapped."""
    control = scenario["control"]
    if "fault" in control:
        return OfflineRun(test, scenario, "control", [control["fault"]]).run(), "fault %s" % control["fault"]
    if control.get("baseline") == "timer-heartbeat":  # the old timer, added to the play (PR 4)
        return OfflineRun(test, with_baseline(scenario, "timer-heartbeat"), "control").run(), \
            "baseline timer-heartbeat"
    if "baseline" in control:
        return OfflineRun(test, scenario, "control", baseline=control["baseline"]).run(), \
            "baseline %s" % control["baseline"]
    return OfflineRun(test, sc.apply_variant(scenario, control["variant"]), "control").run(), "variant"


def run_scenario(test, scenario):
    """The run, then the control. Returns a report; a control that passes is a failure."""
    control = scenario["control"]
    main = OfflineRun(test, scenario, "run").run()
    checked, how = control_play(test, scenario)
    run_results, control_results = main.evaluate(), checked.evaluate()
    proves_nothing = [entry for entry in control["fails"]
                      if all(r["ok"] for r in control_results if entry in (r["label"], r["that"]))]
    return {"id": scenario["id"], "control_kind": how, "run": run_results, "control": control_results,
            "implicit": main.implicit(), "failures": [r for r in run_results if not r["ok"]],
            "proves_nothing": proves_nothing}


def format_scenario_report(report):
    lines = ["%s: run %d/%d pass; control %s:" % (
        report["id"], sum(r["ok"] for r in report["run"]), len(report["run"]), report["control_kind"])]
    for r in report["control"]:
        lines.append("    %-20s %s  (%s)" % (r["label"], "pass" if r["ok"] else "FAIL", r["seen"]))
    return "\n".join(lines)


class TestOfflineScenarios(Base):
    """One test per scenario file with the offline tier; generated below."""

    def check_report(self, report):
        detail = format_scenario_report(report)
        self.assertEqual(report["failures"], [], detail)
        self.assertEqual(report["implicit"], [], detail)
        self.assertEqual(report["proves_nothing"], [], "the control passed, so it proves nothing:\n" + detail)

    def test_the_pr2_catalog_is_present(self):
        found = {s["id"]: s for s in map(sc.load, sc.scenario_files(sc.DEFAULT_DIR))}
        for sid, control in (("W2", "steer-not-queue"), ("B1", "no-batch"), ("R2", "no-dedupe")):
            with self.subTest(scenario=sid):
                self.assertIn(sid, found)
                self.assertIn("offline", found[sid]["tiers"])
                self.assertEqual(found[sid]["since_pr"], 2)
                self.assertEqual(found[sid]["control"]["fault"], control)

    def test_a_control_that_breaks_nothing_fails_the_scenario(self):
        b1 = sc.load(sc.DEFAULT_DIR / "b1-burst.json")
        b1["control"] = {"fault": "no-recheck", "fails": ["one-message"]}
        report = run_scenario(self, b1)
        self.assertEqual(report["proves_nothing"], ["one-message"])
        with self.assertRaises(AssertionError):
            self.check_report(report)

    def test_a_wrong_expectation_fails_the_run(self):
        b1 = sc.load(sc.DEFAULT_DIR / "b1-burst.json")
        b1["expect"][0]["count"] = 2
        report = run_scenario(self, b1)
        self.assertEqual([r["label"] for r in report["failures"]], ["one-message"])

    def test_an_unknown_step_or_oracle_is_refused_not_skipped(self):
        b1 = sc.load(sc.DEFAULT_DIR / "b1-burst.json")
        b1["steps"].append({"at": "6m", "actor": "world", "do": "no-such-step"})
        with self.assertRaises(NotImplementedError):
            run_scenario(self, b1)
        b1 = sc.load(sc.DEFAULT_DIR / "b1-burst.json")
        b1["expect"].append({"that": "no-such-oracle"})
        with self.assertRaises(NotImplementedError):
            run_scenario(self, b1)


class TestPr3Scenarios(Base):
    """D1 and L1 fail when the thing they guard fails, not only when the control says so."""

    def play(self, name):
        return OfflineRun(self, sc.load(sc.DEFAULT_DIR / name), "run").run()

    def results(self, run):
        return {r["label"]: r["ok"] for r in run.evaluate()}

    def test_d1_catalog_entry(self):
        d1 = sc.load(sc.DEFAULT_DIR / "d1-draft.json")
        self.assertEqual((d1["problem"], d1["since_pr"], d1["tiers"]), (3, 3, ["offline", "lab-scripted"]))
        self.assertEqual(d1["control"]["baseline"], "fleet-heartbeat")

    def test_d1_the_engine_types_nothing_and_the_draft_survives(self):
        run = self.play("d1-draft.json")
        self.assertEqual(self.results(run), {"draft-intact": True, "delivered": True})
        self.assertEqual(run.world.herdr.typing_attempts, [])
        self.assertEqual(run.implicit(), [])
        self.assertEqual(run.world.herdr.input_box[run.world.panes["platform"]], "also check the retry path")
        self.assertTrue([m for m in run.world.v2.sessions[run.world.sessions["platform"]]["messages"]
                         if m["type"] == "synthetic"])

    def test_d1_an_engine_that_typed_would_be_caught_twice(self):
        run = self.play("d1-draft.json")
        run.world.herdr([FAKE_HERDR, "agent", "prompt", run.world.panes["platform"], "wake"])  # refused, recorded
        self.assertTrue(any("asked to type" in p for p in run.implicit()))
        run.world.herdr.allow_typing = True  # and what typing does to the box and the transcript
        run.world.herdr([FAKE_HERDR, "agent", "prompt", run.world.panes["platform"], "wake"])
        self.assertFalse(self.results(run)["draft-intact"])

    def test_d1_the_baseline_types_with_agent_prompt_and_the_draft_is_sent(self):
        d1 = sc.load(sc.DEFAULT_DIR / "d1-draft.json")
        baseline = OfflineRun(self, d1, "control", baseline="fleet-heartbeat").run()
        typed = [argv for argv in baseline.world.herdr.calls if argv[1:3] == ["agent", "prompt"]]
        self.assertEqual(len(typed), 1)
        text = typed[0][-1]
        self.assertTrue(text.startswith("[heartbeat] "))
        self.assertEqual(self.results(baseline)["draft-intact"], False)
        messages = baseline.world.v2.sessions[baseline.world.sessions["platform"]]["messages"]
        self.assertTrue(any(m["type"] == "user" and "also check the retry path" in m["text"] for m in messages))

    def test_l1_launch_oracles_pass_on_a_launch(self):
        run = self.play("l1-launch.json")
        self.assertEqual(self.results(run), {"fleet-metadata": True, "runs-v2": True,
                                             "brief-as-fleet-prompt": True, "nothing-typed": True})
        self.assertEqual(run.implicit(), [])
        self.assertNotIn("platform", run.launched)
        self.assertIn("coder", run.launched)

    def test_l1_each_oracle_fails_when_its_fact_is_false(self):
        for what, damage, label in (
                ("a shell instead of the program", lambda w, p: w.herdr.panes[p].update(program="-zsh"), "runs-v2"),
                ("another version on the pane", lambda w, p: w.herdr.panes[p].update(
                    program="/opt/other/opencode -s " + w.herdr.panes[p]["session"]), "runs-v2"),
                ("the pane was not opened by argv", lambda w, p: w.herdr.panes[p].pop("argv"), "nothing-typed"),
                ("something was typed", lambda w, p: w.herdr.typing_attempts.append(["pane", "send-text"]),
                 "nothing-typed"),
                ("the wrong session", lambda w, p: w.herdr.panes[p].update(session="ses_fake000001"), "runs-v2"),
                ("the wrong metadata", lambda w, p: w.v2.sessions[w.herdr.panes[p]["session"]]["metadata"]["fleet"]
                 .update(role="orchestrator"), "fleet-metadata")):
            with self.subTest(what=what):
                run = self.play("l1-launch.json")
                pane = run.world.panes["coder"]
                damage(run.world, pane)
                self.assertFalse(self.results(run)[label])

    def test_a_launch_that_fails_verification_fails_the_scenario_play(self):
        l1 = sc.load(sc.DEFAULT_DIR / "l1-launch.json")
        run = OfflineRun(self, l1, "bad")
        run.world.herdr.launch_mode = "shell"
        with self.assertRaises(sb.LaunchError):
            run.run()

    def test_a_scenario_names_only_known_baselines(self):
        d1 = sc.load(sc.DEFAULT_DIR / "d1-draft.json")
        d1["control"]["baseline"] = "something-else"
        self.assertTrue(any("control.baseline" in e for e in sc.validate(d1)))


class TestOneVocabulary(unittest.TestCase):
    """Both runners speak bin/fleet-scenario's vocabulary and nothing else."""

    def test_each_runner_plays_only_known_kinds(self):
        lab = _load("t_proof_switchboard", BIN / "proof-switchboard")
        self.assertLessEqual(set(lab.RUN_ACTIONS), set(sc.ACTIONS))
        self.assertLessEqual(set(lab.RUN_EXPECTATIONS), set(sc.EXPECTATIONS))
        for that in lab.RUN_EXPECTATIONS:
            self.assertTrue(callable(getattr(lab.ScenarioRun, "check_" + that, None)), that)
        offline = {name[len("oracle_"):] for name in dir(OfflineRun) if name.startswith("oracle_")}
        self.assertLessEqual(offline, set(sc.EXPECTATIONS))
        self.assertEqual(set(lab.SYNTHETIC_DEFAULTS), {"synthetic", "note", "wake"})

    def test_every_kind_has_a_field_table_and_actors(self):
        self.assertEqual(set(sc.ACTIONS), set(sc.STEP_ACTORS))
        for table in (sc.STEP_FIELDS, sc.EXPECT_FIELDS):
            for kind, fields in table.items():
                for field, (required, check) in fields.items():
                    with self.subTest(kind=kind, field=field):
                        self.assertIsInstance(required, bool)
                        self.assertIn(check, sc._CHECK_TEXT)


def _scenario_test(path):
    def test(self):
        scenario = sc.load(path)
        if "offline" not in scenario["tiers"]:
            self.skipTest("%s has no offline tier" % scenario["id"])
        report = run_scenario(self, scenario)
        SCENARIO_REPORTS.append(report)
        self.check_report(report)
    test.__doc__ = "scenario %s offline, and its control fails" % path.name
    return test


for _path in sc.scenario_files(sc.DEFAULT_DIR):
    setattr(TestOfflineScenarios, "test_scenario_" + re.sub(r"\W", "_", _path.stem), _scenario_test(_path))


# ============================================================ GitHub events (PR 5)
#
# One section: a stateful fake of GitHub and of the `gh` binary, a rig that
# wires it to a hub and an engine, the offline runner's GitHub steps and
# oracle (added to OfflineRun here, so the runner above stays as it was), and
# the tests. Nothing here reaches a network or a real `gh`.

GH_REPO = "fleet/scratch"
GH_BIN = "/fake/bin/gh"
GITHUB_STEPS = ("comment", "kill-forwarder", "occupy-hook")


class FakeProc:
    """A forwarder child: alive until it exits or is told to stop."""

    _pids = iter(range(5000, 90000))

    def __init__(self, argv):
        self.argv, self.code, self.pid = list(argv), None, next(FakeProc._pids)
        self.secret = next(a for a in argv if a.startswith("--secret="))[len("--secret="):]

    def poll(self):
        return self.code

    def terminate(self):
        self.code = -15

    def exit(self, code=1):
        self.code = code


class FakeGitHub:
    """GitHub's objects, `gh api` over them, and `gh webhook forward` as processes.

    `runner` is what the hub runs for `gh api`; `spawn` is what it runs for the
    forwarder. A forwarder that is alive carries each event to the hub, signed
    with the secret from its own argv; with none alive an event is lost, and
    only a later `gh api` read finds it. `occupied` makes every forwarder die
    at once with "Hook already exists".
    """

    def __init__(self, clock, repo=GH_REPO):
        self.clock, self.repo, self.hub = clock, repo, None
        self.issues, self.comments, self.pulls, self.reviews, self.suites, self.runs = {}, [], {}, {}, [], []
        self.procs, self.api_calls, self.occupied = [], [], False
        self.api_down, self.spawn_error, self.exit_text = False, None, "error: Hook already exists on %s\n" % repo

    def stamp(self):
        return sb.iso(self.clock.now())

    # -- objects
    def issue(self, number, title="an issue", parent=None, body="", labels=(), age=30 * 86400):
        """An issue that existed `age` seconds ago and has not changed since: outside the look-back window."""
        obj = {"id": 9000 + number, "number": number, "title": title, "body": body, "state": "open",
               "updated_at": sb.iso(self.clock.now() - age), "user": {"login": "owner"}, "labels": [{"name": n} for n in labels]}
        if parent:
            obj["parent_issue_url"] = "https://api.github.com/repos/%s/issues/%d" % (self.repo, parent)
        self.issues[number] = obj
        return obj

    def pull(self, number, closes=(), title="a change", state="open", merged=False):
        body = " ".join("Closes #%d." % n for n in closes)
        self.pulls[number] = {"id": 7000 + number, "number": number, "title": title, "body": body, "state": state,
                              "merged": merged, "updated_at": self.stamp(), "user": {"login": "coder"},
                              "head": {"sha": "sha%d" % number}}
        return self.pulls[number]

    def comment(self, number, body, cid, login="octocat", forward=True):
        issue = self.issues.get(number) or self.issue(number)
        stamp = self.stamp()
        comment = {"id": cid, "body": body, "user": {"login": login}, "created_at": stamp, "updated_at": stamp,
                   "issue_url": "https://api.github.com/repos/%s/issues/%d" % (self.repo, number)}
        self.comments.append(comment)
        issue["updated_at"] = stamp
        if forward:
            return self.send("issue_comment", {"action": "created", "issue": dict(issue), "comment": comment})

    # -- the webhook side
    def forwarder(self):
        alive = [p for p in self.procs if p.poll() is None]
        return alive[-1] if alive else None

    def send(self, event, payload, delivery="d-1"):
        """GitHub sends an event. Returns the hub's (status, text), or None when nobody forwards."""
        proc = self.forwarder()
        if proc is None:
            return None
        body = json.dumps(dict(payload, repository={"full_name": self.repo})).encode()
        headers = {"X-Hub-Signature-256": sb.sign_body(proc.secret, body), "X-GitHub-Event": event,
                   "X-GitHub-Delivery": delivery}
        return self.hub.receive("/github", headers, body)

    def kill_forwarder(self):
        proc = self.forwarder()
        if proc is not None:
            proc.exit(1)

    def spawn(self, argv, log_path):
        if self.spawn_error:
            raise OSError(self.spawn_error)
        proc = FakeProc(argv)
        self.procs.append(proc)
        if self.occupied:
            Path(log_path).write_text(self.exit_text)
            proc.exit(1)
        return proc

    # -- gh api
    def runner(self, argv, **kwargs):
        if argv[0] != GH_BIN or argv[1] != "api":
            raise AssertionError("a test reached for a real binary: %r" % argv[:2])
        path = argv[-1]
        self.api_calls.append(path)
        if self.api_down:
            return subprocess.CompletedProcess(argv, 1, "", "gh: HTTP 502\n")
        data = self.answer(path.split("?")[0][len("repos/%s/" % self.repo):], urllib_query(path))
        pages = data if "--paginate" in argv and isinstance(data, list) else [data]
        if isinstance(data, list):
            pages = [[item] for item in data] if "--paginate" in argv else [data]
        return subprocess.CompletedProcess(argv, 0, "\n".join(json.dumps(p) for p in pages), "")

    def since(self, items, query, field="updated_at"):
        floor = query.get("since", "")
        return [i for i in items if i.get(field, "") >= floor]

    def answer(self, path, query):
        parts = path.split("/")
        if path == "issues/comments":
            return self.since(self.comments, query)
        if path == "issues":
            as_issue = [dict(p, pull_request={"url": "https://api.github.com/repos/x/pulls/%d" % p["number"]})
                        for p in self.pulls.values()]
            return self.since(list(self.issues.values()) + as_issue, query)
        if parts[0] == "issues" and len(parts) == 2:
            number = int(parts[1])
            if number in self.issues:
                return self.issues[number]
            return dict(self.pulls[number], pull_request={"url": "x"}) if number in self.pulls else {"number": number}
        if path == "pulls":
            return sorted(self.pulls.values(), key=lambda p: p["updated_at"], reverse=True)
        if parts[0] == "pulls" and len(parts) == 2:
            return self.pulls.get(int(parts[1]), {})
        if parts[0] == "pulls" and parts[2:] == ["reviews"]:
            return self.reviews.get(int(parts[1]), [])
        if parts[0] == "commits" and parts[2:] == ["check-suites"]:
            return {"check_suites": [s for s in self.suites if s["sha"] == parts[1]]}
        if path == "actions/runs":
            return {"workflow_runs": self.runs}
        raise AssertionError("fake gh api: no route for %r" % path)


def urllib_query(path):
    query = {}
    for pair in path.partition("?")[2].split("&"):
        if pair:
            name, _, value = pair.partition("=")
            query[name] = value
    return query


class GithubRig:
    """A hub on fake GitHub, attached to an engine on the fake fleet, on one simulated clock."""

    def __init__(self, test, agents=None, config=None, repos=(GH_REPO,)):
        raw = {"github_repos": list(repos), "gh": GH_BIN}
        raw.update(config or {})
        self.world = World(test, agents=(), config=raw)
        for name, fleet in (agents if agents is not None else
                            {"platform": {"role": "orchestrator", "charter": 1}}).items():
            self.world.add_agent(name, fleet=fleet)
        self.gh = FakeGitHub(self.world.clock)
        self.hub = sb.GitHubHub(self.world.config, self.world.state, sb.AuditLog(self.world.audit_path),
                                self.gh.runner, self.gh.spawn, self.world.clock.now)
        self.hub.autostart, self.hub.port, self.gh.hub = False, 4711, self.hub
        self.world.engine = self.hub.attach(self.world.new_engine())

    def pump(self, seconds, every=5):
        """Simulated time: the supervisor ticks, then a pass runs, every `every` seconds."""
        for _ in range(0, int(seconds), every):
            self.world.tick(every)
            self.hub.tick()
            self.world.engine.run_pass()

    def watch(self, repo=GH_REPO):
        return self.hub.watches[repo]

    def keys(self):
        return sorted(item.key for item in self.hub.queue.values())

    def delivered(self, name="platform"):
        return sorted(k for a in self.world.admissions(name) for k in a["keys"])

    def state_text(self):
        """Every byte under the state directory, the audit log included."""
        return "\n".join(p.read_text(errors="replace") for p in sorted(self.world.state.rglob("*")) if p.is_file())


def _hub_source(name):
    return inspect.getsource(getattr(sb.GitHubHub, name))


# ------------------------------------------------ the offline runner's GitHub steps

def _github_extend_offline_run():
    """Give OfflineRun the GitHub steps (`comment`, `kill-forwarder`, `occupy-hook`) and the
    `github_watch` oracle, without touching the runner's own methods: its `apply`, `__init__`
    and `one_pass` are wrapped, and everything but GitHub goes straight through."""
    original_init, original_apply, original_pass = OfflineRun.__init__, OfflineRun.apply, OfflineRun.one_pass

    def uses_github(scenario):
        return any(s["do"] in GITHUB_STEPS for s in scenario["steps"]) or \
            any(e["that"] == "github_watch" for e in scenario["expect"])

    def build_hub(self):
        world = self.world
        self.gh = FakeGitHub(world.clock)
        self.hub = sb.GitHubHub(world.config, world.state, sb.AuditLog(world.audit_path), self.gh.runner,
                                self.gh.spawn, world.clock.now)
        self.hub.autostart, self.hub.port, self.gh.hub = False, 4711, self.hub
        for number, issue in sorted(self.scenario.get("issues", {}).items()):
            self.gh.issue(int(number), parent=issue.get("parent"))

    def init(self, test, scenario, label, faults=(), baseline=None):
        original_init(self, test, scenario, label, faults, baseline)
        self.hub = None
        if uses_github(scenario):
            raw = {"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "github_repos": [GH_REPO], "gh": GH_BIN}
            self.world.config = sb.validate_config(raw)
            build_hub(self)
            make_engine = self.world.new_engine
            self.world.new_engine = lambda *a, **k: self.hub.attach(make_engine(*a, **k))
            self.world.engine = self.world.new_engine()

    def apply(self, step):
        do = step["do"]
        if self.hub is not None and do == "restart-daemon":
            build_hub(self)  # a new process: no queue, no forwarder, no secret survives
        if do == "comment":
            self.gh.comment(int(step["issue"]), step["body"], step.get("id", 1000 + self.scenario["steps"].index(step)),
                            step.get("from", "octocat"))
        elif do == "kill-forwarder":
            self.gh.kill_forwarder()
        elif do == "occupy-hook":
            self.gh.occupied = True
        else:
            original_apply(self, step)
        if self.hub is not None and do == "kill-daemon":
            self.hub.stop()

    def one_pass(self, step_faults):
        if self.hub is not None and self.daemon:
            self.hub.tick()
        original_pass(self, step_faults)

    def oracle_github_watch(self, e):
        watch = self.hub.watches[e.get("repo", GH_REPO)]
        return watch.state == e["state"], "the watch on %s is %s (last error: %s)" % (
            watch.repo, watch.state, watch.last_error)

    OfflineRun.__init__, OfflineRun.apply, OfflineRun.one_pass = init, apply, one_pass
    OfflineRun.oracle_github_watch = oracle_github_watch


_github_extend_offline_run()

STEP_EXAMPLES.update({"comment": {"issue": 2, "body": "looks good", "id": 5001, "from": "reviewer"},
                      "kill-forwarder": {}, "occupy-hook": {}})
EXPECT_EXAMPLES["github_watch"] = {"state": "conflict", "repo": "fleet/scratch"}


# ------------------------------------------------------------------- the tests

class TestGithubConfig(Base):
    def cfg(self, **raw):
        return sb.validate_config(raw)

    def test_defaults_watch_nothing_and_name_the_documented_events(self):
        config = self.cfg()
        self.assertEqual((config["github_repos"], config["gh"], config["github_lookback_hours"],
                          config["github_port"]), ([], "gh", 24, None))
        self.assertEqual(config["github_events"], ["issues", "issue_comment", "sub_issues", "pull_request",
                                                   "pull_request_review", "check_suite", "workflow_run"])

    def test_a_config_gets_its_own_lists(self):
        first = self.cfg()
        first["github_repos"].append("a/b")
        first["github_events"].append("push")
        self.assertEqual((self.cfg()["github_repos"], len(self.cfg()["github_events"])), ([], 7))
        self.assertEqual(sb.DEFAULTS["github_repos"], [])

    def test_good_values(self):
        config = self.cfg(github_repos=["a/b", "c-d/e.f_g"], gh="/opt/gh", github_lookback_hours=0.5,
                          github_events=["issue_comment"], github_port=8123)
        self.assertEqual((config["github_repos"], config["gh"], config["github_port"]),
                         (["a/b", "c-d/e.f_g"], "/opt/gh", 8123))

    def test_bad_values_are_refused_by_name(self):
        for key, value in (("github_repos", "a/b"), ("github_repos", ["ab"]), ("github_repos", ["a/b/c"]),
                           ("github_repos", ["a/b", "a/b"]), ("github_repos", [3]), ("gh", ""), ("gh", 3),
                           ("github_lookback_hours", 0), ("github_lookback_hours", True),
                           ("github_events", []), ("github_events", ["Issues"]), ("github_events", "issues"),
                           ("github_port", 0), ("github_port", 70000), ("github_port", "80"), ("github_port", True)):
            with self.subTest(key=key, value=value):
                with self.assertRaises(sb.ConfigError) as caught:
                    self.cfg(**{key: value})
                self.assertIn(key, str(caught.exception))

    def test_an_unknown_key_is_still_refused(self):
        with self.assertRaises(sb.ConfigError):
            self.cfg(github_repo=["a/b"])


class TestGithubVerification(Base):
    SECRET = "s" * 64

    def test_the_signature_is_the_hmac_of_the_raw_body(self):
        body = b'{"a": 1}'
        header = "sha256=" + hmac.new(self.SECRET.encode(), body, hashlib.sha256).hexdigest()
        self.assertEqual(sb.sign_body(self.SECRET, body), header)
        self.assertTrue(sb.signature_matches(self.SECRET, body, header))

    def test_anything_else_is_refused(self):
        body = b"{}"
        good = sb.sign_body(self.SECRET, body)
        for what, header in (("none", None), ("empty", ""), ("no prefix", good[len("sha256="):]),
                             ("other body", sb.sign_body(self.SECRET, b"{ }")),
                             ("other secret", sb.sign_body("x" * 64, body)), ("truncated", good[:-2]),
                             ("sha1", "sha1=" + good[len("sha256="):]), ("non-ascii", "sha256=\u00e9" * 3)):
            with self.subTest(what=what):
                self.assertFalse(sb.signature_matches(self.SECRET, body, header))
        self.assertFalse(sb.signature_matches("", body, sb.sign_body("", body)), "no secret, no match")

    def test_the_comparison_is_constant_time(self):
        self.assertIn("hmac.compare_digest", inspect.getsource(sb.signature_matches))
        self.assertNotIn("==", inspect.getsource(sb.signature_matches))


class TestGithubReceive(Base):
    def setUp(self):
        super().setUp()
        self.rig = GithubRig(self)
        self.hub, self.gh = self.rig.hub, self.rig.gh
        self.hub.tick()  # starts the forwarder: a secret exists now
        self.secret = self.gh.procs[-1].secret
        self.gh.issue(12, parent=1)

    def post(self, event="issue_comment", payload=None, secret=None, signature="auto", path="/github", raw=None):
        payload = payload if payload is not None else {
            "action": "created", "issue": self.gh.issues[12],
            "comment": {"id": 5001, "body": "hi", "user": {"login": "octocat"}},
            "repository": {"full_name": GH_REPO}}
        body = raw if raw is not None else json.dumps(payload).encode()
        headers = {"X-GitHub-Event": event, "X-GitHub-Delivery": "d-1"}
        if signature == "auto":
            signature = sb.sign_body(secret or self.secret, body)
        if signature is not None:
            headers["X-Hub-Signature-256"] = signature
        return self.hub.receive(path, headers, body)

    def rejected(self):
        return [e for e in self.rig.world.audit() if e["event"] == "github.rejected"]

    def test_a_signed_event_is_accepted_and_queued_by_its_object_id(self):
        self.assertEqual(self.post()[0], 202)
        self.assertEqual(self.rig.keys(), ["github.comment:5001"])

    def test_an_unsigned_event_is_refused_audited_and_ingests_nothing(self):
        self.assertEqual(self.post(signature=None)[0], 401)
        self.assertEqual(self.rig.keys(), [])
        self.assertEqual([e["detail"]["reason"] for e in self.rejected()], ["signature missing"])

    def test_a_wrongly_signed_event_is_refused_audited_and_ingests_nothing(self):
        for what, kwargs in (("another secret", {"secret": "z" * 64}), ("garbage", {"signature": "sha256=00"}),
                             ("a stale secret", {})):
            with self.subTest(what=what):
                if what == "a stale secret":
                    self.gh.kill_forwarder()
                    self.rig.pump(10)
                    self.assertNotEqual(self.gh.procs[-1].secret, self.secret)
                code, _ = self.post(**kwargs) if what != "a stale secret" else self.post(secret=self.secret)
                self.assertEqual(code, 401)
                self.assertEqual(self.rig.keys(), [])
        self.assertEqual({e["detail"]["reason"] for e in self.rejected()}, {"signature does not match"})

    def test_the_signature_is_checked_before_the_body_is_read(self):
        # A body that is not JSON gets 401 when unsigned, and 400 only once it is signed.
        self.assertEqual(self.post(raw=b"{not json", signature=None)[0], 401)
        self.assertEqual(self.post(raw=b"{not json")[0], 400)
        self.assertEqual(self.post(raw=b"[1]")[0], 400)

    def test_only_the_github_path_answers(self):
        self.assertEqual(self.post(path="/other")[0], 404)
        self.assertEqual(self.rig.keys(), [])

    def test_an_event_for_another_repo_is_ignored(self):
        payload = {"action": "created", "issue": self.gh.issues[12], "comment": {"id": 5002},
                   "repository": {"full_name": "someone/else"}}
        self.assertEqual(self.post(payload=payload)[0], 202)
        self.assertEqual(self.rig.keys(), [])

    def test_events_nobody_handles_ingest_nothing(self):
        self.assertEqual(self.post(event="ping", payload={"zen": "x", "repository": {"full_name": GH_REPO}})[0], 202)
        self.assertEqual(self.post(event="push", payload={"repository": {"full_name": GH_REPO}})[0], 202)
        self.assertEqual(self.rig.keys(), [])

    def test_a_flood_of_bad_signatures_is_mostly_counted_not_audited(self):
        for _ in range(sb.GITHUB_REJECT_AUDITS + 30):
            self.post(signature="sha256=00")
        self.assertEqual(len(self.rejected()), sb.GITHUB_REJECT_AUDITS)
        self.rig.world.clock.t += 61
        self.post(signature="sha256=00")
        self.assertEqual(self.rejected()[-1]["detail"]["also_rejected"], 30)

    def test_a_redelivery_with_a_new_delivery_id_is_one_item(self):
        for delivery in ("d-1", "d-2"):
            self.gh.send("issue_comment", {"action": "created", "issue": self.gh.issues[12],
                                           "comment": {"id": 5001, "body": "hi"}}, delivery)
        self.assertEqual(self.rig.keys(), ["github.comment:5001"])


class TestGithubSecret(Base):
    """Invariant 7: the secret lives in memory and in the forwarder's argv, nowhere else."""

    def setUp(self):
        super().setUp()
        self.rig = GithubRig(self)
        self.hub, self.gh, self.world = self.rig.hub, self.rig.gh, self.rig.world
        self.gh.issue(12, parent=1)

    def test_each_start_gets_a_new_secret_in_argv_only(self):
        secrets_ = []
        for _ in range(3):
            self.hub.tick()
            secrets_.append(self.gh.procs[-1].secret)
            self.assertIn("--secret=%s" % secrets_[-1], self.gh.procs[-1].argv)
            self.gh.kill_forwarder()
            self.world.clock.t += 400
            self.hub.tick()  # sees the exit
            self.world.clock.t += 400
        self.assertEqual(len(set(secrets_)), 3)
        self.assertTrue(all(len(s) == 64 for s in secrets_))

    def test_a_dead_forwarder_leaves_no_secret_to_sign_with(self):
        self.hub.tick()
        self.gh.kill_forwarder()
        self.hub.tick()
        self.assertIsNone(self.rig.watch().secret)

    def run_everything(self):
        self.hub.tick()
        self.gh.comment(12, "hello", 5001)
        self.rig.pump(120)
        self.gh.kill_forwarder()
        self.rig.pump(30)
        return self.gh.procs[0].secret

    def test_the_secret_is_in_no_file_audit_status_or_error(self):
        first = self.run_everything()
        secrets_ = [p.secret for p in self.gh.procs]
        self.assertGreater(len(secrets_), 1)
        texts = [self.rig.state_text(), json.dumps(self.hub.describe()),
                 "\n".join(sb.format_github(sb.github_status(self.world.config, self.world.state)))]
        for secret in secrets_:
            for text in texts:
                self.assertNotIn(secret, text)
        self.assertNotIn(first, json.dumps(self.world.audit()))

    def test_a_secret_a_child_prints_is_scrubbed_from_what_we_report(self):
        self.hub.tick()
        proc = self.gh.procs[-1]
        self.hub.log_path(self.rig.watch()).write_text("fatal: bad secret %s\n" % proc.secret)
        proc.exit(2)
        self.hub.tick()
        watch = self.rig.watch()
        self.assertIn("exited with code 2", watch.last_error)
        self.assertNotIn(proc.secret, watch.last_error)
        self.assertNotIn(proc.secret, json.dumps(self.world.audit()))
        self.assertIn("[redacted]", watch.last_error)

    def test_a_failed_catch_up_names_no_secret_either(self):
        self.hub.tick()
        self.gh.api_down = True
        self.world.clock.t += 20
        self.hub.tick()
        self.assertIn("HTTP 502", self.rig.watch().catch_up_error)
        self.assertNotIn(self.gh.procs[-1].secret, json.dumps(self.hub.describe()))

    def test_the_hub_never_writes_the_secret_anywhere_but_memory_and_argv(self):
        source = class_source("GitHubHub")
        self.assertEqual(source.count("secrets.token_hex"), 1)
        for line in source.splitlines():
            if "watch.secret" in line:
                self.assertNotIn("audit", line)
                self.assertNotIn("write", line)

    def test_the_snapshot_status_reads_has_no_secret_and_is_private(self):
        self.hub.tick()
        path = self.world.state / sb.WATCH_FILE
        self.assertEqual(stat.S_IMODE(path.stat().st_mode), 0o600)
        self.assertNotIn(self.gh.procs[-1].secret, path.read_text())


class TestGithubListener(Base):
    def setUp(self):
        super().setUp()
        self.rig = GithubRig(self)
        self.hub, self.gh = self.rig.hub, self.rig.gh
        self.addCleanup(self.hub.stop)

    def post(self, port, body, headers):
        import http.client
        connection = http.client.HTTPConnection("127.0.0.1", port, timeout=5)
        connection.request("POST", "/github", body=body, headers=headers)
        reply = connection.getresponse()
        reply.read()
        connection.close()
        return reply.status

    def test_it_binds_localhost_only(self):
        port = self.hub.open_listener()
        self.assertEqual(self.hub.server.server_address[0], "127.0.0.1")
        self.assertEqual(self.hub.server.server_address[1], port)

    def test_it_can_be_pinned_to_a_port(self):
        probe = socket.socket()
        probe.bind(("127.0.0.1", 0))
        port = probe.getsockname()[1]
        probe.close()
        rig = GithubRig(self, config={"github_port": port})
        rig.hub.port = port
        self.addCleanup(rig.hub.stop)
        self.assertEqual(rig.hub.open_listener(), port)

    def test_a_request_over_the_socket_is_verified_like_any_other(self):
        self.hub.port = 0
        port = self.hub.open_listener()
        self.hub.tick()
        self.gh.issue(12, parent=1)
        body = json.dumps({"action": "created", "issue": self.gh.issues[12], "comment": {"id": 5001, "body": "x"},
                           "repository": {"full_name": GH_REPO}}).encode()
        headers = {"X-GitHub-Event": "issue_comment", "Content-Type": "application/json"}
        self.assertEqual(self.post(port, body, headers), 401)
        self.assertEqual(self.post(port, body, dict(headers, **{"X-Hub-Signature-256": "sha256=00"})), 401)
        self.assertEqual(self.rig.keys(), [])
        signed = dict(headers, **{"X-Hub-Signature-256": sb.sign_body(self.gh.procs[-1].secret, body)})
        self.assertEqual(self.post(port, body, signed), 202)
        self.assertEqual(self.rig.keys(), ["github.comment:5001"])

    def test_the_forwarders_url_names_the_bound_port_on_localhost(self):
        self.hub.port = 0
        port = self.hub.open_listener()
        self.hub.tick()
        argv = self.gh.procs[-1].argv
        self.assertEqual(argv[:3], [GH_BIN, "webhook", "forward"])
        self.assertIn("--url=http://127.0.0.1:%d/github" % port, argv)
        self.assertIn("--repo=%s" % GH_REPO, argv)
        self.assertIn("--events=issues,issue_comment,sub_issues,pull_request,pull_request_review,"
                      "check_suite,workflow_run", argv)

    def test_the_source_never_binds_another_address(self):
        source = inspect.getsource(sb.GitHubHub.open_listener)
        self.assertIn('("127.0.0.1", self.port)', source)
        for wide in ("0.0.0.0", '("", ', "('', ", "localhost", "::"):
            self.assertNotIn(wide, source)

    def test_stop_ends_the_listener_and_the_forwarders(self):
        self.hub.open_listener()
        self.hub.tick()
        proc = self.gh.procs[-1]
        self.hub.stop()
        self.assertEqual(proc.poll(), -15)
        self.assertIsNone(self.hub.server)


class TestGithubSupervisor(Base):
    def setUp(self):
        super().setUp()
        self.rig = GithubRig(self)
        self.hub, self.gh, self.world = self.rig.hub, self.rig.gh, self.rig.world
        self.watch = self.rig.watch()

    def at(self, seconds):
        self.world.clock.t = EPOCH + seconds
        self.hub.tick()

    def test_a_forwarder_is_started_for_each_watched_repo_and_none_other(self):
        rig = GithubRig(self, repos=("a/one", "b/two"))
        rig.hub.tick()
        self.assertEqual(sorted(a for p in rig.gh.procs for a in p.argv if a.startswith("--repo=")),
                         ["--repo=a/one", "--repo=b/two"])

    def test_it_restarts_with_exponential_backoff_up_to_a_cap(self):
        self.at(0)
        waits, now = [], 0
        for _ in range(8):
            self.gh.kill_forwarder()
            now += 1
            self.at(now)  # notices the exit
            self.assertEqual(self.watch.state, "backoff")
            waits.append(self.watch.next_start - (EPOCH + now))
            now = self.watch.next_start - EPOCH
            self.at(now)
            self.assertEqual(self.watch.state, "running")
        self.assertEqual(waits, [5, 10, 20, 40, 80, 160, 300, 300])

    def test_a_forwarder_that_stayed_up_starts_the_backoff_over(self):
        self.at(0)
        for now in (1, 7, 18):  # three quick failures
            self.gh.kill_forwarder()
            self.at(now)
            self.at(self.watch.next_start - EPOCH)
        self.assertEqual(self.watch.failures, 3)
        self.at(self.watch.started - EPOCH + sb.GITHUB_STABLE + 1)
        self.assertEqual(self.watch.failures, 0)
        self.gh.kill_forwarder()
        self.at(self.watch.started - EPOCH + sb.GITHUB_STABLE + 2)
        self.assertEqual(self.watch.next_start - self.world.clock.now(), 5)

    def test_it_does_not_restart_before_the_backoff_has_passed(self):
        self.at(0)
        self.gh.kill_forwarder()
        self.at(1)
        self.at(4)
        self.assertEqual((len(self.gh.procs), self.watch.state), (1, "backoff"))

    def test_hook_already_exists_marks_a_conflict_and_waits_long(self):
        self.gh.occupied = True
        self.at(0)
        self.at(5)
        self.assertEqual(self.watch.state, "conflict")
        self.assertIn(sb.CONFLICT_TEXT, self.watch.last_error)
        self.assertEqual(self.watch.next_start, EPOCH + 5 + sb.GITHUB_CONFLICT_RETRY)
        self.at(sb.GITHUB_CONFLICT_RETRY - 1)
        self.assertEqual(len(self.gh.procs), 1)
        self.at(5 + sb.GITHUB_CONFLICT_RETRY)
        self.assertEqual(len(self.gh.procs), 2, "it tries again once the interval has passed")

    def test_a_conflict_clears_when_the_other_forwarder_goes(self):
        self.gh.occupied = True
        self.at(0)
        self.at(5)
        self.gh.occupied = False
        self.at(5 + sb.GITHUB_CONFLICT_RETRY)
        self.assertEqual(self.watch.state, "running")

    def test_a_plain_failure_is_not_a_conflict(self):
        self.at(0)
        self.hub.log_path(self.watch).write_text("error: websocket closed\n")
        self.gh.procs[-1].exit(1)
        self.at(1)
        self.assertEqual(self.watch.state, "backoff")
        self.assertIn("websocket closed", self.watch.last_error)

    def test_a_gh_that_cannot_start_backs_off_and_says_so(self):
        self.gh.spawn_error = "No such file or directory"
        self.at(0)
        self.assertEqual((self.watch.state, self.watch.failures), ("backoff", 1))
        self.assertIn("cannot start %s" % GH_BIN, self.watch.last_error)
        self.assertIsNone(self.watch.secret)

    def test_a_tick_that_raises_is_recorded_and_the_next_still_runs(self):
        self.at(0)
        self.gh.procs[-1].poll = lambda: (_ for _ in ()).throw(RuntimeError("boom"))
        self.at(1)
        self.assertEqual(self.watch.last_error, "boom")
        self.assertTrue(any(e["event"] == "github.error" for e in self.world.audit()))

    def test_state_changes_are_audited_once_each(self):
        self.at(0)
        self.gh.kill_forwarder()
        self.at(1)
        states = [e["detail"]["state"] for e in self.world.audit() if e["event"] == "github.watch"]
        self.assertEqual(states, ["running", "backoff"])

    def test_the_supervisor_thread_ticks_until_stopped(self):
        self.hub.autostart = False
        ticks = []
        self.hub.tick = lambda: ticks.append(1)
        real_wait = self.hub.stopping.wait
        self.hub.stopping.wait = lambda t: real_wait(0.001)
        self.hub._thread(self.hub._supervise)
        time.sleep(0.05)
        self.hub.stopping.set()
        self.assertGreater(len(ticks), 2)


class TestGithubRealChild(Base):
    """The one test that starts a real process: a script of our own, never a real `gh`."""

    def setUp(self):
        super().setUp()
        self.config = sb.validate_config({"github_repos": [GH_REPO], "gh": str(self.home / "gh")})
        self.state = sb.ensure_state_dir()

    def hub(self, body):
        self.fake_bin("gh", body)
        hub = sb.GitHubHub(self.config, self.state, now=time.time, runner=lambda *a, **k: self.fail("gh api"))
        hub.port = 4711
        self.addCleanup(hub.stop)
        return hub

    def wait_for(self, check):
        deadline = time.time() + 5
        while time.time() < deadline:
            if check():
                return True
            time.sleep(0.02)
        return False

    def test_the_child_leads_its_own_session_and_writes_to_the_log_not_our_pipes(self):
        hub = self.hub('echo "forwarding $*" | sed "s/--secret=[0-9a-f]*/--secret=X/"; sleep 30\n')
        watch = hub.watches[GH_REPO]
        hub._start(watch, time.time())
        pid = watch.proc.pid
        self.assertEqual(os.getpgid(pid), pid, "its own process group: start_new_session")
        self.assertTrue(self.wait_for(lambda: "forwarding webhook forward" in hub._log_tail(watch)))
        self.assertEqual(stat.S_IMODE(hub.log_path(watch).stat().st_mode), 0o600)
        self.assertEqual(stat.S_IMODE((self.state / "logs").stat().st_mode), 0o700)
        hub.stop()
        self.assertTrue(self.wait_for(lambda: watch.proc is None))
        self.assertTrue(self.wait_for(lambda: not self.alive(pid)))

    def alive(self, pid):
        try:
            waited, _ = os.waitpid(pid, os.WNOHANG)
            return waited == 0
        except ChildProcessError:
            return False

    def test_it_sees_hook_already_exists_from_a_real_process(self):
        hub = self.hub('echo "error: Hook already exists on fleet/scratch" >&2; exit 1\n')
        watch = hub.watches[GH_REPO]
        hub._start(watch, time.time())
        self.assertTrue(self.wait_for(lambda: watch.proc.poll() is not None))
        hub._exited(watch, watch.proc.poll(), time.time())
        self.assertEqual(watch.state, "conflict")

    def test_it_inherits_none_of_our_pipes(self):
        source = inspect.getsource(sb.spawn_forwarder)
        for needle in ("stdin=subprocess.DEVNULL", "stdout=fd", "stderr=fd", "start_new_session=True", "close_fds=True"):
            self.assertIn(needle, source)
        self.assertNotIn("PIPE", source)

    def test_a_missing_gh_is_a_backoff_not_a_crash(self):
        hub = sb.GitHubHub(sb.validate_config({"github_repos": [GH_REPO], "gh": "/no/such/gh"}), self.state)
        hub.port = 4711
        hub.tick()
        self.assertEqual(hub.watches[GH_REPO].state, "backoff")
        self.assertIn("cannot start", hub.watches[GH_REPO].last_error)


class TestGithubKeys(Base):
    """Keys come from GitHub object ids, so a webhook and a catch-up of one object agree."""

    def setUp(self):
        super().setUp()
        self.rig = GithubRig(self, agents={"platform": {"role": "orchestrator", "charter": 1},
                                           "coder": {"role": "coder", "issue": 12}})
        self.gh, self.hub, self.world = self.rig.gh, self.rig.hub, self.rig.world
        self.world.clock.t += 3600
        self.gh.issue(1, title="charter")
        self.gh.issue(12, title="the work", parent=1)
        self.hub.tick()

    def catch_up_keys(self):
        items, errors = self.hub.catch_up_items(GH_REPO, self.world.clock.now())
        self.assertEqual(errors, [])
        return sorted(i.key for i in items)

    def test_a_comment(self):
        self.gh.comment(12, "hello", 5001)
        self.assertEqual(self.rig.keys(), ["github.comment:5001"])
        self.assertEqual(self.catch_up_keys(), ["github.comment:5001"])

    def test_an_issue_edit_by_its_updated_at(self):
        self.gh.issues[12]["updated_at"] = "2027-02-01T00:00:00Z"
        self.gh.issues[12]["title"] = "renamed"
        self.gh.send("issues", {"action": "edited", "issue": self.gh.issues[12]})
        self.assertEqual(self.rig.keys(), ["github.issue:9012:2027-02-01T00:00:00Z"])
        self.assertIn("github.issue:9012:2027-02-01T00:00:00Z", self.catch_up_keys())

    def test_a_label_change_and_awaiting_user_removal_is_an_event_of_interest(self):
        self.gh.issues[1]["updated_at"] = "2027-02-02T00:00:00Z"
        self.gh.send("issues", {"action": "unlabeled", "issue": self.gh.issues[1], "label": {"name": "awaiting-user"}})
        (item,) = self.hub.queue.values()
        self.assertEqual(item.key, "github.issue:9001:2027-02-02T00:00:00Z")
        self.assertIn("label awaiting-user removed", item.summary)

    def test_a_pull_request_by_its_state(self):
        self.gh.pull(30, closes=(12,))
        self.gh.send("pull_request", {"action": "opened", "pull_request": self.gh.pulls[30]})
        self.assertEqual(self.rig.keys(), ["github.pr:7030:open"])
        self.assertIn("github.pr:7030:open", self.catch_up_keys())
        merged = self.gh.pull(30, closes=(12,), state="closed", merged=True)
        self.gh.send("pull_request", {"action": "closed", "pull_request": merged})
        self.assertIn("github.pr:7030:merged", self.rig.keys())

    def test_a_review(self):
        pr = self.gh.pull(30, closes=(12,))
        review = {"id": 6001, "state": "APPROVED", "body": "ship it", "user": {"login": "rev"},
                  "submitted_at": self.gh.stamp()}
        self.gh.reviews[30] = [review]
        self.gh.send("pull_request_review", {"action": "submitted", "review": review, "pull_request": pr})
        self.assertIn("github.review:6001", self.rig.keys())
        self.assertIn("github.review:6001", self.catch_up_keys())

    def test_a_check_suite_and_a_workflow_run(self):
        pr = self.gh.pull(30, closes=(12,))
        suite = {"id": 8001, "conclusion": "failure", "sha": "sha30", "updated_at": self.gh.stamp(),
                 "pull_requests": [{"number": 30}]}
        run = {"id": 8101, "name": "ci", "conclusion": "success", "updated_at": self.gh.stamp(),
               "pull_requests": [{"number": 30}]}
        self.gh.suites, self.gh.runs = [suite], [run]
        self.gh.send("check_suite", {"action": "completed", "check_suite": suite})
        self.gh.send("workflow_run", {"action": "completed", "workflow_run": run})
        self.assertEqual(self.rig.keys(), ["github.check:8001:failure", "github.check:run-8101:success"])
        self.assertEqual(self.catch_up_keys(), ["github.check:8001:failure", "github.check:run-8101:success",
                                                "github.pr:7030:open"])

    def test_unfinished_checks_and_unhandled_actions_make_nothing(self):
        suite = {"id": 8002, "conclusion": None, "pull_requests": [{"number": 30}]}
        self.gh.send("check_suite", {"action": "requested", "check_suite": suite})
        self.gh.send("check_suite", {"action": "completed", "check_suite": suite})
        self.gh.send("issue_comment", {"action": "deleted", "issue": self.gh.issues[12], "comment": {"id": 1}})
        self.gh.send("pull_request", {"action": "synchronize", "pull_request": self.gh.pull(30)})
        self.assertEqual(self.rig.keys(), [])

    def test_a_sub_issue_event(self):
        self.gh.send("sub_issues", {"action": "sub_issue_added", "parent_issue": self.gh.issues[1],
                                    "sub_issue": self.gh.issues[12]})
        self.assertEqual(self.rig.keys(), ["github.subissue:9001:9012:sub_issue_added"])

    def test_the_delivery_id_never_makes_a_key(self):
        self.gh.send("issue_comment", {"action": "created", "issue": self.gh.issues[12],
                                       "comment": {"id": 5001, "body": "x"}}, delivery="delivery-xyz")
        self.assertFalse(any("delivery" in key for key in self.rig.keys()))

    def test_a_comment_bumping_an_issue_is_not_also_reported_as_an_issue_update(self):
        self.gh.comment(12, "hello", 5001, forward=False)
        self.assertEqual(self.catch_up_keys(), ["github.comment:5001"])

    def test_only_the_look_back_window_is_read(self):
        self.gh.comment(12, "old", 5001, forward=False)
        self.world.clock.t += 24 * 3600 + 10
        self.gh.comment(12, "new", 5002, forward=False)
        self.assertEqual(self.catch_up_keys(), ["github.comment:5002"])
        self.assertIn("since=%s" % sb.iso(self.world.clock.now() - 24 * 3600), "".join(self.gh.api_calls))


class TestGithubRouting(Base):
    def setUp(self):
        super().setUp()
        self.rig = GithubRig(self, agents={"platform": {"role": "orchestrator", "charter": 1},
                                           "web": {"role": "orchestrator", "charter": 2},
                                           "coder": {"role": "coder", "issue": 12}})
        self.gh, self.hub = self.rig.gh, self.rig.hub
        self.gh.issue(1)
        self.gh.issue(2)
        self.gh.issue(12, parent=1)
        self.gh.issue(13, parent=2)
        self.gh.issue(20)
        self.hub.tick()

    def routed(self):
        return {f.key: f.recipient for f in self.hub.facts()}

    def test_a_comment_on_a_sub_issue_goes_to_the_charters_orchestrator_not_the_worker(self):
        self.gh.comment(12, "hi", 5001)
        self.assertEqual(self.routed(), {"github.comment:5001": "platform"})

    def test_a_comment_on_the_charter_itself(self):
        self.gh.comment(1, "hi", 5001)
        self.assertEqual(self.routed(), {"github.comment:5001": "platform"})

    def test_another_orchestrators_issue_goes_to_that_one(self):
        self.gh.comment(13, "hi", 5001)
        self.assertEqual(self.routed(), {"github.comment:5001": "web"})

    def test_a_worker_alone_owning_the_issue_gets_it(self):
        self.gh.issue(40)
        self.gh.issues[40]["parent_issue_url"] = None
        agents = {"coder": {"role": "coder", "issue": 40}}
        rig = GithubRig(self, agents=agents)
        rig.gh.issue(40)
        rig.hub.tick()
        rig.gh.comment(40, "hi", 5001)
        self.assertEqual({f.key: f.recipient for f in rig.hub.facts()}, {"github.comment:5001": "coder"})

    def test_an_issue_nobody_owns_is_dropped_and_audited_once(self):
        self.gh.comment(20, "hi", 5001)
        self.assertEqual(self.routed(), {})
        self.assertEqual(self.rig.keys(), [])
        self.hub.facts()
        unrouted = [e for e in self.rig.world.audit() if e["event"] == "github.unrouted"]
        self.assertEqual([e["detail"]["keys"][0] for e in unrouted], ["github.comment:5001"])

    def test_nothing_is_dropped_while_the_fleet_cannot_be_read(self):
        self.gh.comment(12, "hi", 5001)
        self.rig.world.herdr.down = True
        self.assertEqual(self.routed(), {})
        self.assertEqual(self.rig.keys(), ["github.comment:5001"])
        self.rig.world.herdr.down = False
        self.assertEqual(self.routed(), {"github.comment:5001": "platform"})

    def test_a_pull_request_goes_to_the_owner_of_an_issue_it_closes(self):
        self.gh.pull(30, closes=(13,))
        self.gh.send("pull_request", {"action": "opened", "pull_request": self.gh.pulls[30]})
        self.assertEqual(self.routed(), {"github.pr:7030:open": "web"})

    def test_closing_keywords(self):
        self.assertEqual(sb.closing_numbers("Fixes #4, resolved: #5. closes fleet/scratch#6 and also see #7"),
                         [4, 5, 6])
        self.assertEqual(sb.closing_numbers(None), [])

    def test_a_pull_request_that_closes_nothing_owned_is_dropped(self):
        self.gh.pull(31, closes=(20,))
        self.gh.send("pull_request", {"action": "opened", "pull_request": self.gh.pulls[31]})
        self.assertEqual(self.routed(), {})

    def test_a_check_suite_is_routed_through_the_prs_in_its_payload(self):
        self.gh.pull(30, closes=(12,))
        suite = {"id": 8001, "conclusion": "failure", "pull_requests": [{"number": 30}]}
        self.gh.send("check_suite", {"action": "completed", "check_suite": suite})
        self.assertEqual(self.routed(), {"github.check:8001:failure": "platform"})
        self.assertIn("repos/%s/pulls/30" % GH_REPO, self.gh.api_calls)

    def test_a_check_for_a_pr_nobody_owns_is_dropped(self):
        self.gh.pull(32, closes=(20,))
        self.gh.send("check_suite", {"action": "completed", "check_suite": {
            "id": 8002, "conclusion": "success", "pull_requests": [{"number": 32}]}})
        self.gh.send("check_suite", {"action": "completed", "check_suite": {
            "id": 8003, "conclusion": "success", "pull_requests": []}})
        self.assertEqual(self.routed(), {})

    def test_lookups_are_made_only_when_the_payload_does_not_settle_it(self):
        self.gh.comment(12, "hi", 5001)  # the payload names the parent: no gh api
        self.routed()
        self.assertEqual(self.gh.api_calls, [])

    def test_a_lookup_that_fails_keeps_the_item_and_is_not_repeated_every_pass(self):
        self.gh.pull(30, closes=(12,))
        self.gh.send("check_suite", {"action": "completed", "check_suite": {
            "id": 8001, "conclusion": "failure", "pull_requests": [{"number": 30}]}})
        self.gh.api_down = True
        self.assertEqual(self.routed(), {})
        self.assertEqual(self.rig.keys(), ["github.check:8001:failure"])
        calls = len(self.gh.api_calls)
        self.routed()
        self.assertEqual(len(self.gh.api_calls), calls, "retried only after the retry interval")
        self.gh.api_down = False
        self.rig.world.clock.t += sb.GITHUB_LOOKUP_RETRY + 1
        self.assertEqual(self.routed(), {"github.check:8001:failure": "platform"})

    def test_a_looked_up_parent_chain_is_followed(self):
        self.gh.issue(14, parent=12)           # a grandchild; its webhook payload names no parent
        self.gh.issues[14].pop("parent_issue_url")
        self.gh.issues[14]["parent_issue_url"] = None
        self.gh.comments.append({"id": 5009, "body": "deep", "user": {"login": "x"}, "issue_url":
                                 "https://api.github.com/repos/%s/issues/14" % GH_REPO,
                                 "updated_at": self.gh.stamp()})
        self.gh.issues[14]["parent_issue_url"] = "https://api.github.com/repos/%s/issues/12" % GH_REPO
        items, _ = self.hub.catch_up_items(GH_REPO, self.rig.world.clock.now())
        self.hub.enqueue(items)
        self.assertEqual(self.routed(), {"github.comment:5009": "platform"})

    def test_an_item_older_than_the_look_back_window_expires(self):
        self.gh.comment(12, "hi", 5001)
        self.rig.world.clock.t += 24 * 3600 + 1
        self.assertEqual(self.routed(), {})
        self.assertEqual(self.rig.keys(), [])

    def test_the_nearest_issue_wins_between_orchestrators(self):
        agents = {"outer": {"role": "orchestrator", "charter": 1}, "inner": {"role": "orchestrator", "charter": 12}}
        rig = GithubRig(self, agents=agents)
        rig.gh.issue(12, parent=1)
        rig.hub.tick()
        rig.gh.comment(12, "hi", 5001)
        self.assertEqual({f.key: f.recipient for f in rig.hub.facts()}, {"github.comment:5001": "inner"})

    def test_the_fact_carries_the_issue_the_author_and_a_summary(self):
        self.gh.comment(12, "please look\nat this", 5001, login="octocat")
        (fact_,) = self.hub.facts()
        self.assertEqual((fact_.issue, fact_.sender, fact_.kind), (12, "octocat", "github.comment"))
        self.assertEqual(fact_.summary, "@octocat commented on #12: please look at this")


class TestGithubDelivery(Base):
    """The queue holds an item until the engine has delivered it; nothing else is stored."""

    def setUp(self):
        super().setUp()
        self.rig = GithubRig(self)
        self.gh, self.hub, self.world = self.rig.gh, self.rig.hub, self.rig.world
        self.gh.issue(12, parent=1)
        self.hub.tick()

    def test_a_webhook_is_delivered_once_after_the_batch_window_and_leaves_the_queue(self):
        self.gh.comment(12, "hello", 5001)
        self.rig.pump(60)
        self.assertEqual(self.rig.delivered(), [])
        self.assertEqual(self.rig.keys(), ["github.comment:5001"], "held in memory until delivered")
        self.rig.pump(60)
        self.assertEqual(self.rig.delivered(), ["github.comment:5001"])
        self.assertEqual(self.rig.keys(), [])

    def test_an_item_that_is_held_stays_queued(self):
        self.world.herdr.panes[self.world.panes["platform"]]["status"] = "blocked"
        self.gh.comment(12, "hello", 5001)
        self.rig.pump(200)
        self.assertEqual(self.rig.delivered(), [])
        self.assertEqual(self.rig.keys(), ["github.comment:5001"])

    def test_the_same_object_seen_again_after_delivery_is_not_delivered_again(self):
        self.gh.comment(12, "hello", 5001)
        self.rig.pump(120)
        self.gh.send("issue_comment", {"action": "created", "issue": self.gh.issues[12],
                                       "comment": self.gh.comments[0]}, "d-2")
        self.assertEqual(self.rig.keys(), ["github.comment:5001"], "queued again: the queue stores nothing")
        self.rig.pump(200)
        self.assertEqual(self.rig.delivered(), ["github.comment:5001"])
        self.assertEqual(self.rig.keys(), [], "the transcript already had it, so it was acknowledged")

    def test_the_repeat_is_delivered_again_when_dedupe_is_off(self):
        os.environ[sb.FAULT_ENV] = "no-dedupe"
        self.gh.comment(12, "hello", 5001)
        self.rig.pump(120)
        self.gh.send("issue_comment", {"action": "created", "issue": self.gh.issues[12],
                                       "comment": self.gh.comments[0]}, "d-2")
        self.gh.comment(12, "another", 5002)  # a new key makes a new message id, so v2 admits the repeat
        self.rig.pump(200)
        self.assertEqual(self.rig.delivered(), ["github.comment:5001"] * 2 + ["github.comment:5002"])

    def test_a_restart_loses_the_queue_and_the_catch_up_gets_it_back(self):
        self.gh.comment(12, "hello", 5001)
        self.assertEqual(self.rig.keys(), ["github.comment:5001"])
        stored = [p for p in self.world.state.rglob("*") if p.is_file() and p.name != "audit.jsonl"]
        for path in stored:
            self.assertNotIn("github.comment:5001", path.read_text(errors="replace"), path.name)
        restarted = GithubRig(self)  # a new process: nothing in memory
        self.assertEqual(restarted.keys(), [])
        restarted.gh.comments, restarted.gh.issues = self.gh.comments, self.gh.issues
        restarted.world.clock.t = self.world.clock.now()
        restarted.hub.tick()
        restarted.pump(15)
        self.assertEqual(restarted.keys(), ["github.comment:5001"], "the catch-up read brings it back")

    def test_a_sent_key_is_acknowledged_even_when_only_the_delivery_path_saw_it(self):
        self.gh.comment(12, "hello", 5001)
        self.rig.pump(120)
        self.assertEqual(self.rig.keys(), [])
        source = inspect.getsource(sb.Switchboard.deliver)
        self.assertIn("self._acknowledge(keys)", source)

    def test_facts_the_source_has_are_the_engines_and_status_reads_them_without_acknowledging(self):
        self.gh.comment(12, "hello", 5001)
        engine = self.hub.attach(self.world.new_engine(writable=False))
        facts, problems = engine.collect_facts()
        self.assertEqual(([f.key for f in facts], problems), (["github.comment:5001"], []))
        self.assertEqual(self.rig.keys(), ["github.comment:5001"])


class TestGithubCatchUp(Base):
    def setUp(self):
        super().setUp()
        self.rig = GithubRig(self)
        self.gh, self.hub, self.world = self.rig.gh, self.rig.hub, self.rig.world
        self.world.clock.t += 7200
        self.gh.issue(12, parent=1)

    def test_one_read_follows_each_start_and_nothing_polls(self):
        self.hub.tick()
        self.assertEqual(self.gh.api_calls, [], "not before the forwarder has had time to connect")
        self.rig.pump(10)
        first = len(self.gh.api_calls)
        self.assertGreater(first, 0)
        self.rig.pump(3000)
        self.assertEqual(len(self.gh.api_calls), first, "a quiet, healthy forwarder is never polled")

    def test_a_restarted_forwarder_is_followed_by_another_read_that_recovers_the_gap(self):
        self.rig.pump(15)
        self.gh.kill_forwarder()
        self.gh.comment(12, "while down", 5001)
        self.assertEqual(self.rig.keys(), [], "the event was lost: nobody was forwarding")
        self.rig.pump(5)  # exit seen, backoff
        self.rig.pump(20)  # restart, then the read
        self.assertEqual(self.rig.keys() or self.rig.delivered(), ["github.comment:5001"])

    def test_a_webhook_and_a_catch_up_of_one_object_are_one_delivery(self):
        self.rig.pump(15)
        self.gh.comment(12, "both ways", 5001)  # webhook now
        self.gh.kill_forwarder()
        self.rig.pump(30)  # restart + catch-up reads the same comment
        self.rig.pump(200)
        self.assertEqual(self.rig.delivered(), ["github.comment:5001"])

    def test_a_failed_read_is_retried_and_reported(self):
        self.gh.api_down = True
        self.rig.pump(15)
        self.assertIn("HTTP 502", self.rig.watch().catch_up_error)
        self.gh.comment(12, "later", 5001, forward=False)
        self.gh.api_down = False
        self.rig.pump(sb.GITHUB_LOOKUP_RETRY + 10)
        self.assertIsNone(self.rig.watch().catch_up_error)
        self.assertEqual(self.rig.keys() or self.rig.delivered(), ["github.comment:5001"])

    def test_one_failing_read_does_not_stop_the_others(self):
        self.gh.comment(12, "x", 5001, forward=False)
        original = self.gh.answer

        def answer(path, query):
            if path == "pulls":
                raise AssertionError("never mind")
            return original(path, query)

        self.gh.answer = lambda path, query: (_ for _ in ()).throw(sb.GitHubUnavailable("pulls down")) \
            if path == "pulls" else original(path, query)
        self.gh.runner_original = self.gh.runner
        self.hub.runner = lambda argv, **kw: (subprocess.CompletedProcess(argv, 1, "", "gh: HTTP 500")
                                              if argv[-1].split("?")[0].endswith("/pulls") else self.gh.runner(argv))
        items, errors = self.hub.catch_up_items(GH_REPO, self.world.clock.now())
        self.assertEqual([i.key for i in items], ["github.comment:5001"])
        self.assertEqual(len(errors), 1)
        self.assertIn("pulls", errors[0])

    def test_paginated_output_is_read_page_by_page(self):
        self.assertEqual(sb.decode_json_stream('[{"a": 1}]\n[{"a": 2}]\n{"b": 3}'), [[{"a": 1}], [{"a": 2}], {"b": 3}])
        self.assertEqual(sb.decode_json_stream(""), [])
        with self.assertRaises(ValueError):
            sb.decode_json_stream("[{")
        self.gh.comment(12, "a", 5001, forward=False)
        self.gh.comment(12, "b", 5002, forward=False)
        items, errors = self.hub.catch_up_items(GH_REPO, self.world.clock.now())
        self.assertEqual(sorted(i.key for i in items), ["github.comment:5001", "github.comment:5002"])

    def test_gh_that_cannot_run_or_answers_nonsense_is_an_unavailable_read(self):
        for runner in (lambda argv, **kw: (_ for _ in ()).throw(FileNotFoundError("no gh")),
                       lambda argv, **kw: subprocess.CompletedProcess(argv, 0, "<html>", ""),
                       lambda argv, **kw: (_ for _ in ()).throw(subprocess.TimeoutExpired(argv, 5))):
            self.hub.runner = runner
            with self.assertRaises(sb.GitHubUnavailable):
                self.hub.gh_api("repos/x/y/issues")


class TestGithubStatus(Base):
    def setUp(self):
        super().setUp()
        self.rig = GithubRig(self)
        self.hub, self.gh, self.world = self.rig.hub, self.rig.gh, self.rig.world

    def status(self):
        return sb.github_status(self.world.config, self.world.state)

    def test_no_watched_repo_adds_no_lines(self):
        self.assertEqual(sb.format_github(sb.github_status(sb.validate_config({}), self.world.state)), [])

    def test_without_a_daemon_it_says_the_state_is_unknown(self):
        lines = sb.format_github(self.status())
        self.assertIn("older events are lost", lines[0])
        self.assertIn("daemon not running", lines[1])

    def test_a_snapshot_of_a_live_daemon_shows_each_watch(self):
        self.hub.tick()
        report = self.status()
        self.assertTrue(report["daemon"])
        self.assertEqual([(w["repo"], w["state"]) for w in report["watches"]], [(GH_REPO, "running")])
        self.assertIn("%s" % GH_REPO, sb.format_github(report)[1])

    def test_a_conflict_is_reported_as_one(self):
        self.gh.occupied = True
        self.hub.tick()
        self.world.clock.t += 5
        self.hub.tick()
        text = "\n".join(sb.format_github(self.status()))
        self.assertIn("conflict", text)
        self.assertIn("catch-up reads only", text)

    def test_repeated_failures_show(self):
        self.gh.spawn_error = "nope"
        for _ in range(3):
            self.world.clock.t += 400
            self.hub.tick()
        self.assertIn("3 failure(s)", "\n".join(sb.format_github(self.status())))

    def test_a_snapshot_of_a_dead_pid_is_not_believed(self):
        self.hub.tick()
        path = self.world.state / sb.WATCH_FILE
        data = json.loads(path.read_text())
        data["pid"] = 2 ** 22 + 1234567
        path.write_text(json.dumps(data))
        self.assertFalse(self.status()["daemon"])

    def test_stop_marks_the_snapshot_as_no_daemon(self):
        self.hub.tick()
        self.hub.stop()
        self.assertFalse(self.status()["daemon"])

    def test_a_snapshot_for_other_repos_is_not_shown(self):
        self.hub.tick()
        other = sb.validate_config({"github_repos": ["x/y"]})
        self.assertEqual(sb.github_status(other, self.world.state)["watches"], [])

    def test_the_status_command_includes_github(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "github_repos": [GH_REPO]})
        with captured() as (out, _):
            code = sb.main(["status", "--json"], runner=self.world.route, now=self.world.clock.now)
        report = json.loads(out.getvalue())
        self.assertEqual((code, report["github"]["repos"]), (0, [GH_REPO]))
        with captured() as (out, _):
            sb.main(["status"], runner=self.world.route, now=self.world.clock.now)
        self.assertIn("github", out.getvalue())


class TestGithubDaemon(Base):
    def setUp(self):
        super().setUp()
        self.world = World(self, agents=("platform",))
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})

    def test_no_repo_means_no_hub_and_no_change_to_the_daemon(self):
        engine, state, config = sb.build_engine(self.world.route, self.world.clock.now, "daemon")
        before = list(engine.sources)
        self.assertIsNone(sb.attach_github(engine, config, state, self.world.route, self.world.clock.now))
        self.assertEqual(engine.sources, before)

    def test_with_repos_the_hub_is_a_fact_source_and_the_daemon_starts_it_only_inside_its_lock(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "github_repos": [GH_REPO]})
        started = []
        with mock.patch.object(sb, "spawn_forwarder", side_effect=lambda *a: started.append(a)), \
                mock.patch.object(sb.signal, "signal"), mock.patch.object(sb.GitHubHub, "open_listener", return_value=1):
            with sb.single_instance(self.world.state):
                with captured():
                    code = sb.main(["run"], runner=self.world.route, now=self.world.clock.now)
            self.assertEqual((code, started), (1, []), "the lock is refused before anything starts")

    def test_the_daemon_runs_the_hub_alongside_the_passes_and_stops_it_at_the_end(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "github_repos": [GH_REPO]})
        gh = FakeGitHub(self.world.clock)
        sleeps = []

        def sleep(sock, seconds):
            sleeps.append(seconds)
            if len(sleeps) == 2:
                raise KeyboardInterrupt

        runner = lambda argv, **kw: self.world.route(argv, **kw) if argv[0] != "gh" else gh.runner(argv)
        with mock.patch.object(sb, "spawn_forwarder", side_effect=gh.spawn), \
                mock.patch.object(sb.signal, "signal") as handler, \
                mock.patch.object(sb.GitHubHub, "open_listener", return_value=4711), \
                mock.patch.object(sb.GitHubHub, "_supervise"), mock.patch.object(sb.GitHubHub, "_thread"):
            code = sb.main(["run"], runner=runner, now=self.world.clock.now, wait=sleep)
        self.assertEqual((code, sleeps), (0, [5, 5]))
        self.assertEqual(handler.call_args[0][0], sb.signal.SIGTERM)
        self.assertTrue((self.world.state / sb.WATCH_FILE).exists())
        self.assertIsNone(json.loads((self.world.state / sb.WATCH_FILE).read_text())["pid"], "stopped")

    def test_run_once_never_starts_a_forwarder(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "github_repos": [GH_REPO]})
        with mock.patch.object(sb, "spawn_forwarder") as spawn:
            code = sb.main(["run", "--once"], runner=self.world.route, now=self.world.clock.now)
        self.assertEqual(code, 0)
        spawn.assert_not_called()

    def test_the_engine_never_types_into_a_pane_for_github_either(self):
        self.assertEqual(herdr_typing_violations(SWITCHBOARD.read_text()), [])


class TestGithubScenarios(Base):
    def test_the_catalog_has_g1_to_g3_and_the_spike(self):
        found = {s["id"]: s for s in map(sc.load, sc.scenario_files(sc.DEFAULT_DIR))}
        for sid in ("G1", "G2", "G3"):
            self.assertIn("offline", found[sid]["tiers"])
            self.assertEqual(found[sid]["since_pr"], 5)
            self.assertEqual(found[sid]["control"]["fault"], "no-dedupe")
        self.assertIn("spike", found["SG1"]["tags"])
        self.assertNotIn("offline", found["SG1"]["tiers"])

    def test_the_vocabulary_has_the_github_kinds(self):
        for do in ("kill-forwarder", "occupy-hook"):
            self.assertEqual(sc.STEP_ACTORS[do], ("world",))
        self.assertEqual(sorted(sc.STEP_FIELDS["comment"]), ["body", "from", "id", "issue"])
        self.assertEqual(sc.WATCH_STATES, sb.WATCH_STATES)

    def test_a_scenario_that_loses_its_forwarder_without_catch_up_loses_the_comment(self):
        g2 = sc.load(sc.DEFAULT_DIR / "g2-forwarder-dies.json")
        run = OfflineRun(self, g2, "nocatchup")
        run.hub.catch_up = lambda watch, now: setattr(watch, "catchup_at", None)
        run.run()
        results = {r["label"]: r["ok"] for r in run.evaluate()}
        self.assertTrue(results["first-once"])
        self.assertFalse(results["second-once"])
        self.assertFalse(results["third-once"])


# ------------------------------------------------------- portability and hygiene

def _stdlib_roots():
    paths = {sysconfig.get_paths()[k] for k in ("stdlib", "platstdlib")}
    return tuple(os.path.realpath(p) for p in paths)


class TestHygiene(unittest.TestCase):
    FILES = ("fleet-switchboard", "fleet-scenario", "test-switchboard", "proof-switchboard", "switchboard-trial")

    def test_every_file_is_executable_with_the_portable_shebang(self):
        for name in self.FILES:
            path = BIN / name
            with self.subTest(name=name):
                self.assertTrue(os.access(str(path), os.X_OK), name)
                self.assertEqual(path.read_text().splitlines()[0], "#!/usr/bin/env python3", name)

    def test_standard_library_only(self):
        roots = _stdlib_roots()
        for name in self.FILES:
            tree = ast.parse((BIN / name).read_text())
            modules = set()
            for node in ast.walk(tree):
                if isinstance(node, ast.Import):
                    modules.update(alias.name.split(".")[0] for alias in node.names)
                elif isinstance(node, ast.ImportFrom) and node.level == 0:
                    modules.add(node.module.split(".")[0])
            for module in sorted(modules):
                with self.subTest(name=name, module=module):
                    spec = importlib.util.find_spec(module)
                    self.assertIsNotNone(spec, "%s imports %s, which is not installed" % (name, module))
                    origin = spec.origin or ""
                    if origin in ("built-in", "frozen") or module in sys.builtin_module_names:
                        continue
                    real = os.path.realpath(origin)
                    self.assertTrue(real.startswith(roots) and "site-packages" not in real,
                                    "%s imports %s from %s" % (name, module, origin))

    def test_sys_is_imported_wherever_stderr_or_exit_is_used(self):
        for name in self.FILES:
            source = (BIN / name).read_text()
            if "sys.stderr" in source or "sys.exit" in source:
                self.assertIn("\nimport sys\n", source, name)

    def test_no_personalisation(self):
        # Assembled from fragments so this test file does not itself become the
        # thing the check is looking for.
        pattern = re.compile("|".join(["jan" + "us", "sp" + "ire", "adk" + "aplan",
                                       "/Us" + "ers/", "direc" + "tor(?!y|ies)"]), re.IGNORECASE)
        for name in self.FILES:
            for number, line in enumerate((BIN / name).read_text().splitlines(), 1):
                self.assertIsNone(pattern.search(line), "%s:%d %s" % (name, number, line))

    def test_scenario_runs_are_not_committed(self):
        ignored = (REPO / ".gitignore").read_text().splitlines()
        self.assertIn("scenario-runs/", ignored)

    def test_ci_runs_this_suite_and_the_validator(self):
        workflow = (REPO / ".github" / "workflows" / "test.yml").read_text()
        self.assertIn("bin/test-switchboard 2>&1", workflow)
        self.assertIn("run: bin/fleet-scenario validate", workflow)


# ======================================================================
# PR 4: worker events, reminders, toasts and their scenarios
#
# Everything below extends the fakes and the offline scenario runner by
# attachment (`adds_to`), so the shared classes above stay as they were.
# ===============================================================
def adds_to(cls):
    """Attach the decorated function to `cls` under its own name."""
    def attach(function):
        setattr(cls, function.__name__, function)
        return function
    return attach


# ---- the fakes learn permission asks and forms

@adds_to(FakeV2)
def ask_permission(self, sid, action="shell", resources=("echo hi",), timed=False):
    """A pending permission request, as `session.permission.list` shows it."""
    asks = self.__dict__.setdefault("asks", {})
    ask = {"id": self._id("per"), "sessionID": sid, "action": action, "resources": list(resources)}
    if timed:
        ask["time"] = {"created": self.clock.ms()}
    asks.setdefault(sid, []).append(ask)
    return ask


@adds_to(FakeV2)
def answer_permissions(self, sid):
    """You answer: the asks go, and the blocked turn goes on to its end."""
    self.__dict__.setdefault("asks", {}).pop(sid, None)
    turn = self.sessions[sid]["turn"]
    if turn is not None:
        turn["steps"], turn["end"] = [], self.clock.now()
    self.advance()


@adds_to(FakeV2)
def op_session_permission_list(self, params, body):
    self._session(params)
    return copy.deepcopy(self.__dict__.setdefault("asks", {}).get(params["sessionID"], []))


@adds_to(FakeV2)
def op_session_form_list(self, params, body):
    self._session(params)
    return copy.deepcopy(self.__dict__.setdefault("forms", {}).get(params["sessionID"], []))


class ClosingRunner:
    """herdr's runner that closes a pane the moment the engine reads it with
    `agent get`: the pane closes between the decision and the delivery."""

    def __init__(self, herdr, pane):
        self.herdr, self.pane, self.fired = herdr, pane, False

    def __call__(self, argv, **kwargs):
        if list(argv[1:3]) == ["agent", "get"] and argv[3:4] == [self.pane] and not self.fired:
            self.fired = True
            del self.herdr.panes[self.pane]
        return self.herdr(argv, **kwargs)


# ---- the offline runner learns the PR 4 steps and oracles

WORKER_STEPS = ("away", "permission", "close-pane", "delete-state", "timer-heartbeat")
HEARTBEAT_EVERY = 30 * 60  # the old timer's cadence, for the Q1 baseline


def apply_worker_step(run, step):
    world, do = run.world, step["do"]
    if do == "away":
        return  # you simply prompt nothing more
    if do == "permission" and step["actor"] != "you":
        name = step["actor"]  # a turn that cannot finish until you answer
        world.v2.start_turn(world.sessions[name], "fleet task", fleet=True, lasts=86400)
        world.v2.ask_permission(world.sessions[name])
        world.herdr.panes[world.panes[name]]["status"] = "blocked"
    elif do == "permission":
        name = step["to"]
        world.herdr.panes[world.panes[name]]["status"] = None
        world.v2.answer_permissions(world.sessions[name])
    elif do == "close-pane":
        world.engine.herdr.runner = ClosingRunner(world.herdr, world.panes[step["agent"]])
    elif do == "delete-state":
        shutil.rmtree(str(world.state))
        sb.ensure_state_dir(world.state)  # what the next start of the daemon does first
    else:  # timer-heartbeat: the old fleet-heartbeat wakes each orchestrator whether or not anything happened
        for name, member in sorted(run.scenario["cast"].items()):
            if member["role"] in ("orchestrator", "chief-of-staff"):
                ses = world.sessions[name]
                keys = ["heartbeat:%s:%d" % (name, world.clock.now())]
                world.engine.v2.synthetic(ses, "heartbeat: anything new?", {"fleet": {"keys": keys, "from": "fleet-heartbeat"}},
                                          True, "queue", sb.derive_message_id(ses, keys))


def with_baseline(scenario, baseline):
    """The scenario as the control plays it: itself, or the old timer heartbeat added to it."""
    if baseline is None:
        return scenario
    if baseline != "timer-heartbeat":
        raise NotImplementedError("the offline runner has no baseline %r" % baseline)
    played = copy.deepcopy(scenario)
    end = max(sc.duration_seconds(step["at"]) for step in played["steps"])
    beats = [{"at": "%ds" % at, "actor": "world", "do": "timer-heartbeat"}
             for at in range(HEARTBEAT_EVERY, end + 1, HEARTBEAT_EVERY)]
    played["steps"] = sorted(played["steps"] + beats, key=lambda step: sc.duration_seconds(step["at"]))
    return played


def _toasts(world):
    shown = []
    for argv in world.herdr.calls:
        if argv[1:3] == ["notification", "show"]:
            shown.append({"title": argv[3], "body": argv[argv.index("--body") + 1] if "--body" in argv else ""})
    return shown


@adds_to(OfflineRun)
def oracle_toast(self, e):
    shown = [t for t in _toasts(self.world)
             if e.get("agent", "") in t["title"] + " " + t["body"] and e.get("text", "") in t["title"] + " " + t["body"]]
    return bool(shown), "%d matching toast(s) of %d: %s" % (
        len(shown), len(_toasts(self.world)), [t["title"] for t in shown][:3])


@adds_to(OfflineRun)
def oracle_no_machine_turn(self, e):
    """A model call a fleet message started: a turn from idle, or a continuation after the final reply,
    whose last input is a synthetic message or a prompt the fleet sent."""
    sid = self.world.sessions[e["agent"]]
    messages = {m["id"]: m for m in self.world.v2.sessions[sid]["messages"]}
    machine = []
    for call in self.world.model_calls(e["agent"]):
        last = messages.get(call["inputs"][-1]["id"]) if call["inputs"] else None
        if call["phase"] in ("turn_start", "after_reply") and last is not None and (
                last["type"] == "synthetic" or (last["type"] == "user" and "fleet" in (last.get("metadata") or {}))):
            machine.append(int(call["at"] - EPOCH))
    return not machine, "%d model call(s), %d started by a fleet message, at %s s" % (
        len(self.world.model_calls(e["agent"])), len(machine), machine[:5])


@adds_to(OfflineRun)
def oracle_within(self, e):
    if "key" not in e:
        raise NotImplementedError("the offline runner's `within` needs a key")
    step_at = EPOCH + sc.duration_seconds(self.scenario["steps"][e["step"]]["at"])
    found = [a for a in self.world.admissions(e["agent"]) if a["delivered_at"] is not None and _matches(a["keys"], e["key"])]
    if not found:
        return False, "no message with key %r was delivered" % e["key"]
    answered = [c["at"] for c in self.world.model_calls(e["agent"])
                if any(i["id"] == found[0]["id"] for i in c["inputs"])]
    delivered = found[0]["delivered_at"] - step_at
    took = min(answered) - step_at if answered else None
    return (took is not None and delivered <= e["seconds"] and took <= e["seconds"],
            "delivered %.0f s and answered %s s after step %d (limit %g s)" % (
                delivered, "never" if took is None else "%.0f" % took, e["step"], e["seconds"]))


# ---- worker facts

class PR4Base(Base):
    def setUp(self):
        super().setUp()
        self.world = self.make_world()
        self.coder = self.world.sessions["coder"]

    def make_world(self, **kwargs):
        world = World(self, agents=("platform",), **kwargs)
        world.add_agent("coder", fleet={"role": "coder", "reports_to": "platform", "issue": 2})
        return world

    def source(self, kind=None):
        return next(s for s in self.world.engine.sources if isinstance(s, kind or sb.WorkerFacts))

    def derive(self, world=None):
        world = world or self.world
        world.engine.discover(world.clock.now())
        return next(s for s in world.engine.sources if isinstance(s, sb.WorkerFacts))()

    def finish_turn(self, name="coder", lasts=0):
        self.world.v2.start_turn(self.world.sessions[name], "fleet task", fleet=True, lasts=lasts)

    def block(self, name="coder", **kwargs):
        self.world.v2.start_turn(self.world.sessions[name], "fleet task", fleet=True, lasts=86400)
        self.world.herdr.panes[self.world.panes[name]]["status"] = "blocked"
        return self.world.v2.ask_permission(self.world.sessions[name], **kwargs)

    def toasts(self):
        return _toasts(self.world)


class TestWorkerIdleFacts(PR4Base):
    def test_a_finished_worker_is_a_fact_for_the_one_it_reports_to(self):
        self.finish_turn()
        (found,) = self.derive()
        self.assertEqual(found.key, "worker.idle:%s:%d" % (self.coder, EPOCH * 1000))
        self.assertEqual((found.recipient, found.kind, found.issue, found.sender), ("platform", "worker.idle", 2, "coder"))
        self.assertEqual(found.created, EPOCH)
        self.assertIn("coder finished its turn (success): reply", found.summary)

    def test_deriving_again_gives_the_same_facts_and_writes_nothing(self):
        self.finish_turn()
        first = [f.to_json() for f in self.derive()]
        self.world.tick(30)
        self.assertEqual([f.to_json() for f in self.derive()], first)
        self.assertEqual(self.world.v2.writes, [])
        self.assertEqual(self.world.audit(), [])

    def test_each_turn_has_its_own_key(self):
        self.finish_turn()
        (one,) = self.derive()
        self.world.tick(60)
        self.finish_turn()
        (two,) = self.derive()
        self.assertNotEqual(one.key, two.key)

    def test_a_completion_older_than_the_look_back_is_not_news(self):
        self.finish_turn()
        self.world.clock.t += 25 * 3600
        self.assertEqual(self.derive(), [])

    def test_the_look_back_is_configurable(self):
        world = self.make_world(config={"worker_lookback_hours": 48})
        world.v2.start_turn(world.sessions["coder"], "fleet task", fleet=True)
        world.clock.t += 25 * 3600
        self.assertEqual(len(self.derive(world)), 1)
        world.clock.t += 24 * 3600
        self.assertEqual(self.derive(world), [])

    def test_the_look_back_must_be_a_positive_number(self):
        with self.assertRaises(sb.ConfigError):
            sb.validate_config({"worker_lookback_hours": 0})

    def test_a_worker_that_is_working_or_blocked_is_not_idle(self):
        self.finish_turn()
        self.world.tick(5)
        self.finish_turn(lasts=100)
        self.assertEqual(self.derive(), [])
        self.world.herdr.panes[self.world.panes["coder"]]["status"] = "blocked"
        self.assertEqual(self.derive(), [])

    def test_only_agents_with_a_reports_to_are_workers(self):
        self.finish_turn("platform")
        self.assertEqual(self.derive(), [])
        world = World(self, agents=(), state=self.home / "other-state")
        world.add_agent("loner", fleet={"reports_to": "loner"})
        world.v2.start_turn(world.sessions["loner"], "fleet task", fleet=True)
        self.assertEqual(self.derive(world), [])

    def test_an_ambiguous_worker_is_skipped(self):
        self.finish_turn()
        twin = self.world.add_agent("twin", fleet={"reports_to": "platform"})
        self.world.v2.sessions[twin]["metadata"]["fleet"]["name"] = "coder"
        self.world.v2.start_turn(twin, "fleet task", fleet=True)
        self.assertEqual(self.derive(), [])

    def test_the_summary_is_the_last_reply_cut_short_and_read_once_per_turn(self):
        self.finish_turn()
        self.world.v2.sessions[self.coder]["messages"][-1]["text"] = "word " * 400
        (found,) = self.derive()
        self.assertLessEqual(len(found.summary), len("coder finished its turn (success): ") + sb.SUMMARY_CAP)
        self.assertTrue(found.summary.endswith("\u2026"))
        self.derive()
        reads = [c for c in self.world.v2.calls if "type=assistant" in c and "sessionID=" + self.coder in c]
        self.assertEqual(len(reads), 1)

    def test_a_reply_in_content_parts_is_read_too(self):
        self.finish_turn()
        message = self.world.v2.sessions[self.coder]["messages"][-1]
        message.pop("text")
        message["content"] = [{"type": "text", "text": "PONG"}, {"type": "tool"}]
        (found,) = self.derive()
        self.assertTrue(found.summary.endswith(": PONG"))

    def test_one_workers_trouble_never_hides_another(self):
        self.finish_turn()
        other = self.world.add_agent("coder2", fleet={"reports_to": "platform"})
        self.world.v2.start_turn(other, "fleet task", fleet=True)
        real = self.world.engine.v2.message_list

        def flaky(session_id, **kwargs):
            if session_id == self.coder and kwargs.get("type") == "assistant":
                raise sb.V2Error("timeout", None, "slow")
            return real(session_id, **kwargs)

        with mock.patch.object(self.world.engine.v2, "message_list", flaky):
            facts = self.derive()
        self.assertEqual([f.sender for f in facts], ["coder2"])
        self.assertIn("source.error", [e["event"] for e in self.world.audit()])

    def test_the_worker_source_is_the_one_a_fault_removes(self):
        self.finish_turn()
        os.environ[sb.FAULT_ENV] = "no-worker-source"
        self.assertEqual(self.derive(), [])
        os.environ.pop(sb.FAULT_ENV)
        self.assertEqual(len(self.derive()), 1)

    def test_the_lab_can_ignore_what_happened_before_a_play(self):
        self.finish_turn()
        os.environ[sb.LAB_WORKER_SINCE_ENV] = str(EPOCH + 10)
        self.assertEqual(self.derive(), [])
        os.environ[sb.LAB_WORKER_SINCE_ENV] = str(EPOCH - 10)
        self.assertEqual(len(self.derive()), 1)
        os.environ[sb.LAB_WORKER_SINCE_ENV] = "soon"
        with self.assertRaises(sb.FactError):
            self.derive()

    def test_outside_the_lab_the_since_variable_is_ignored(self):
        self.finish_turn()
        os.environ.pop(sb.LAB_ENV)
        os.environ[sb.LAB_WORKER_SINCE_ENV] = str(EPOCH + 10)
        self.assertEqual(len(self.derive()), 1)

    def test_a_read_only_engine_derives_without_writing(self):
        self.finish_turn()
        engine = self.world.new_engine(writable=False)
        engine.discover(self.world.clock.now())
        self.assertEqual(len(engine.collect_facts()[0]), 1)
        self.assertEqual(self.world.v2.writes, [])


class TestWorkerDelivery(PR4Base):
    def test_a_worker_finishing_is_delivered_once_as_a_wake_with_its_issue(self):
        self.finish_turn()
        self.world.tick(90)
        report = self.world.engine.run_pass()
        self.assertEqual([s["action"] for s in report["sent"]], ["wake"])
        (message,) = self.world.admissions("platform")
        self.assertEqual(message["keys"], ["worker.idle:%s:%d" % (self.coder, EPOCH * 1000)])
        self.assertIn("(issue #2)", message["text"])
        self.assertIn("worker.idle from coder", message["text"])
        for _ in range(3):
            self.world.tick(5)
            self.assertEqual(self.world.engine.run_pass()["sent"], [])
        self.assertEqual(len(self.world.admissions("platform")), 1)

    def test_a_restarted_daemon_does_not_resend_what_the_transcript_holds(self):
        self.finish_turn()
        self.world.tick(90)
        self.world.engine.run_pass()
        self.world.engine = self.world.new_engine()
        self.world.tick(30)
        self.assertEqual(self.world.engine.run_pass()["sent"], [])
        self.assertEqual(len(self.world.admissions("platform")), 1)

    def worker_keys_sent(self):
        return [k for a in self.world.admissions("platform") for k in a["keys"] if k.startswith("worker.idle")]

    def deliver_then_a_later_fact(self, fault=None):
        self.finish_turn()
        self.world.tick(90)
        self.world.engine.run_pass()
        self.world.fact("platform", "lab.fact:later")
        self.world.tick(90)
        if fault:
            os.environ[sb.FAULT_ENV] = fault
        self.world.engine.run_pass()

    def test_a_key_in_the_transcript_is_never_sent_again_in_a_later_message(self):
        self.deliver_then_a_later_fact()
        self.assertEqual(len(self.worker_keys_sent()), 1)

    def test_without_that_check_the_later_message_carries_it_again(self):
        self.deliver_then_a_later_fact("no-dedupe")
        self.assertEqual(len(self.worker_keys_sent()), 2)

    def test_an_orchestrator_that_is_gone_holds_the_item(self):
        self.finish_turn()
        del self.world.herdr.panes[self.world.panes["platform"]]
        self.world.tick(90)
        report = self.world.engine.run_pass()
        self.assertEqual(report["sent"], [])
        self.assertEqual(report["held"][0]["recipient"], "platform")

    def test_engaged_with_the_orchestrator_the_item_is_a_note(self):
        self.world.you("platform")
        self.finish_turn()
        self.world.tick(90)
        self.assertEqual([s["action"] for s in self.world.engine.run_pass()["sent"]], ["note"])
        self.assertEqual(self.world.model_calls("platform", "turn_start")[-1]["inputs"][0]["type"], "user")

    def test_a_long_transcript_does_not_hide_an_old_delivery(self):
        # Only synthetic messages are read for keys, so chatter cannot push a delivery out of the read.
        self.finish_turn()
        self.world.tick(90)
        self.world.engine.run_pass()
        for n in range(sb.READ_LIMIT + 20):
            self.world.v2._message(self.world.v2.sessions[self.world.sessions["platform"]], "assistant", "chat", None,
                                   self.world.clock.now())
        self.world.tick(5)
        self.assertEqual(self.world.engine.run_pass()["sent"], [])
        self.assertEqual(self.world.engine.run_pass()["held"], [])
        reads = [c for c in self.world.v2.calls if "type=synthetic" in c]
        self.assertTrue(reads)


class TestWorkerBlockedFacts(PR4Base):
    def test_a_pending_permission_request_is_a_blocked_fact(self):
        ask = self.block()
        (found,) = self.derive()
        self.assertEqual(found.key, "worker.blocked:%s:%s" % (self.coder, ask["id"]))
        self.assertEqual((found.recipient, found.kind, found.issue, found.sender, found.batch),
                         ("platform", "worker.blocked", 2, "coder", False))
        self.assertIn("shell echo hi", found.summary)

    def test_a_request_with_its_time_is_batched_from_that_time(self):
        self.block(timed=True)
        (found,) = self.derive()
        self.assertTrue(found.batch)
        self.assertEqual(found.created, EPOCH)

    def test_only_a_blocked_worker_is_asked(self):
        self.world.v2.ask_permission(self.coder)  # herdr says idle: nothing is read
        self.assertEqual(self.derive(), [])
        self.assertFalse([c for c in self.world.v2.calls if "session.permission.list" in c])

    def test_when_you_answer_the_fact_is_gone(self):
        self.block()
        self.assertEqual(len(self.derive()), 1)
        self.world.herdr.panes[self.world.panes["coder"]]["status"] = None
        self.world.v2.answer_permissions(self.coder)
        kinds = [f.kind for f in self.derive()]
        self.assertEqual(kinds, ["worker.idle"])

    def test_the_blocked_fact_reaches_the_orchestrator_at_once_and_the_human_gets_one_toast(self):
        self.block()
        self.world.engine.run_pass()
        self.assertEqual(len(self.world.admissions("platform")), 1)
        (toast,) = self.toasts()
        self.assertIn("coder", toast["title"])
        self.assertIn("shell echo hi", toast["body"])
        self.assertIn("issue #2", toast["body"])
        for _ in range(3):
            self.world.tick(5)
            self.world.engine.run_pass()
        self.assertEqual(len(self.toasts()), 1, "once per request, not once per pass")
        self.assertEqual(len(self.world.admissions("platform")), 1)
        events = [(e["event"], e["phase"]) for e in self.world.audit() if e["event"] == "herdr.notification"]
        self.assertEqual(events, [("herdr.notification", "intent"), ("herdr.notification", "result")])

    def test_a_new_request_after_the_answer_is_a_new_toast(self):
        self.block()
        self.world.engine.run_pass()
        self.world.herdr.panes[self.world.panes["coder"]]["status"] = None
        self.world.v2.answer_permissions(self.coder)
        self.world.tick(5)
        self.world.engine.run_pass()
        self.block()
        self.world.tick(5)
        self.world.engine.run_pass()
        self.assertEqual(len(self.toasts()), 2)

    def test_a_toast_that_failed_is_tried_again_next_pass(self):
        self.block()
        failing = mock.patch.object(self.world.engine.herdr, "notification_show",
                                    side_effect=[sb.HerdrError("exit", "no ui"), {"shown": True, "reason": None}])
        with failing as shown:
            self.world.engine.run_pass()
            self.world.tick(5)
            self.world.engine.run_pass()
            self.world.tick(5)
            self.world.engine.run_pass()
        self.assertEqual(shown.call_count, 2)
        results = [e["ok"] for e in self.world.audit() if e["event"] == "herdr.notification" and e["phase"] == "result"]
        self.assertEqual(results, [False, True])

    def test_a_read_only_engine_never_toasts(self):
        self.block()
        engine = self.world.new_engine(writable=False)
        engine.run_pass()
        self.assertEqual(self.toasts(), [])

    def test_there_is_one_toast_path_the_render_step(self):
        """PR 3's render owns every toast; a second mechanism would be a second way to do it."""
        source = SWITCHBOARD.read_text()
        self.assertNotIn("ToastBoard", source)
        calls = [n for n in ast.walk(ast.parse(source)) if isinstance(n, ast.Call)
                 and isinstance(n.func, ast.Attribute) and n.func.attr == "notification_show"]
        self.assertEqual(len(calls), 1, "only render_toast asks herdr for a toast")

    def test_a_reason_toasts_once_and_toasts_again_after_it_lapses(self):
        ask = self.block()
        self.world.engine.run_pass()
        self.world.tick(5)
        self.world.engine.run_pass()
        self.assertEqual(len(self.toasts()), 1, "a steady reason is toasted once")
        self.world.v2.answer_permissions(self.world.sessions["coder"])
        self.world.herdr.panes[self.world.panes["coder"]]["status"] = None
        self.world.tick(5)
        self.world.engine.run_pass()
        self.world.tick(5)
        self.block()
        self.world.engine.run_pass()
        self.assertEqual(len(self.toasts()), 2, "the reason came back after it lapsed")

    def test_questions_are_blocked_facts_too(self):
        self.block()
        self.world.v2.__dict__.setdefault("forms", {})[self.coder] = [{"id": "frm_1", "title": "Which database?"}]
        found = self.derive()
        self.assertEqual(len(found), 2)
        question = next(f for f in found if f.key.endswith(":frm_1"))
        self.assertIn("question", question.summary)
        self.assertIn("Which database?", question.summary)

    def test_a_v2_without_the_form_operation_is_asked_once(self):
        self.block()
        with mock.patch.object(FakeV2, "op_session_form_list", None):
            self.assertEqual(len(self.derive()), 1)
            self.derive()
            self.derive()
        self.assertTrue(self.source()._no_forms)
        self.assertEqual(len([c for c in self.world.v2.calls if "session.form.list" in c]), 1)

    def test_one_workers_permission_failure_never_hides_another(self):
        self.block()
        other = self.world.add_agent("coder2", fleet={"reports_to": "platform"})
        self.world.v2.start_turn(other, "fleet task", fleet=True)
        real = self.world.engine.v2.permission_list

        def failing(session_id):
            raise sb.V2Error("timeout", None, "slow")

        with mock.patch.object(self.world.engine.v2, "permission_list", failing):
            facts = self.derive()
        self.assertEqual([f.sender for f in facts], ["coder2"])
        self.assertEqual(self.source().toasts(), [])


class TestV2ClientPR4(Base):
    def test_argv_of_the_two_new_reads(self):
        for call, op in ((lambda c: c.permission_list(SES), "session.permission.list"),
                         (lambda c: c.form_list(SES), "session.form.list")):
            runner = FakeRunner()
            call(sb.V2Client("/opt/lab/bin/opencode", {}, runner, 7))
            self.assertEqual(runner.argv, ["/opt/lab/bin/opencode", "api", op, "--param", "sessionID=" + SES])
        self.assertEqual(class_source("V2Client").count("self.runner("), 1)


class TestUnreachableToast(PR4Base):
    def close_before_the_recheck(self):
        self.world.engine.herdr.runner = ClosingRunner(self.world.herdr, self.world.panes["platform"])

    def test_a_pane_closed_between_deciding_and_delivering_holds_and_toasts(self):
        self.finish_turn()
        self.world.tick(90)
        self.close_before_the_recheck()
        report = self.world.engine.run_pass()
        self.assertEqual((report["sent"], self.world.admissions("platform")), ([], []))
        (toast,) = self.toasts()
        self.assertIn("platform", toast["title"])
        self.assertIn("nothing sent", toast["body"])
        self.assertIn("recheck", [e["event"] for e in self.world.audit()])
        self.world.tick(5)
        self.world.engine.run_pass()
        self.assertEqual(len(self.toasts()), 1, "later passes hold quietly")

    def test_without_the_recheck_it_is_sent_anyway(self):
        self.finish_turn()
        self.world.tick(90)
        self.close_before_the_recheck()
        os.environ[sb.FAULT_ENV] = "no-recheck"
        self.world.engine.run_pass()
        self.assertEqual(len(self.world.admissions("platform")), 1)
        self.assertEqual(self.toasts(), [])

    def test_a_recheck_that_found_the_agent_busy_again_is_not_a_toast(self):
        self.finish_turn()
        self.world.tick(90)
        self.world.herdr.panes[self.world.panes["platform"]]["status"] = None
        real = self.world.engine.reobserve

        def blocked_now(previous, now):
            fresh, why = real(previous, now)
            fresh.status = "blocked"
            return fresh, why

        with mock.patch.object(self.world.engine, "reobserve", blocked_now):
            self.world.engine.run_pass()
        self.assertEqual(self.toasts(), [])


class TestNoteConversionFault(Base):
    def test_the_fault_leaves_the_note_waiting(self):
        world = World(self, agents=("platform",))
        world.you("platform")
        world.fact("platform", "lab.fact:1")
        world.tick(90)
        world.engine.run_pass()
        world.tick(600)
        os.environ[sb.FAULT_ENV] = "no-note-conversion"
        self.assertEqual(world.engine.run_pass()["converted"], [])
        os.environ.pop(sb.FAULT_ENV)
        self.assertEqual(len(world.engine.run_pass()["converted"]), 1)


# ---- reminders

class TestReminders(PR4Base):
    def remind(self, to="platform", delay=600, text="look at the build", **kwargs):
        return sb.add_reminder(self.world.state, to, self.world.clock.now() + delay, self.world.clock.now(),
                               text, **kwargs)

    def reminder_facts(self):
        return self.source(sb.ReminderFacts)()

    def test_when_is_a_delay_or_a_zoned_time(self):
        self.assertEqual(sb.parse_when("30m", 100), 100 + 1800)
        self.assertEqual(sb.parse_when("+2h", 0), 7200)
        self.assertEqual(sb.parse_when("1d", 0), 86400)
        self.assertEqual(sb.parse_when("45s", 5), 50)
        self.assertEqual(sb.parse_when("2030-01-02T09:00:00Z", 0), 1893574800.0)
        self.assertEqual(sb.parse_when("2030-01-02T10:00:00+01:00", 0), 1893574800.0)
        for bad in ("soon", "30", "30x", "2030-01-02T09:00:00", "-5m", ""):
            with self.subTest(bad=bad), self.assertRaises(sb.ReminderError):
                sb.parse_when(bad, 0)

    def test_the_file_is_private_and_written_whole(self):
        self.remind()
        path = self.world.state / sb.REMINDERS
        self.assertEqual(stat.S_IMODE(path.stat().st_mode), 0o600)
        self.assertEqual(len(json.loads(path.read_text())["reminders"]), 1)
        self.assertEqual([p.name for p in self.world.state.iterdir() if p.name.endswith(".tmp")], [])

    def test_a_write_that_fails_leaves_the_old_file_and_no_temporary(self):
        self.remind(text="first")
        path = self.world.state / sb.REMINDERS
        before = path.read_text()
        with mock.patch.object(sb.json, "dump", side_effect=OSError("disk full")):
            with self.assertRaises(OSError):
                self.remind(text="second")
        self.assertEqual(path.read_text(), before)
        self.assertEqual([p.name for p in self.world.state.iterdir() if ".tmp" in p.name], [])

    def test_a_reminder_is_a_fact_only_once_it_is_due(self):
        self.remind(delay=600, issue=2, sender="coder")
        self.assertEqual(self.reminder_facts(), [])
        self.world.tick(600)
        (found,) = self.reminder_facts()
        self.assertTrue(found.key.startswith("reminder:"))
        self.assertEqual((found.recipient, found.kind, found.issue, found.sender, found.batch, found.created),
                         ("platform", "reminder", 2, "coder", False, EPOCH + 600))
        self.assertEqual(found.summary, "look at the build")

    def test_a_due_reminder_is_delivered_then_pruned_once_it_is_in_the_transcript(self):
        item = self.remind(delay=10)
        self.world.tick(10)
        report = self.world.engine.run_pass()
        self.assertEqual(len(report["sent"]), 1)
        (message,) = self.world.admissions("platform")
        self.assertEqual(message["keys"], ["reminder:" + item["id"]])
        self.assertEqual(sb.read_reminders(self.world.state), [], "pruned in the pass that saw it delivered")
        self.assertIn("reminder.prune", [e["event"] for e in self.world.audit()])
        self.world.tick(5)
        self.assertEqual(self.world.engine.run_pass()["sent"], [])

    def test_a_reminder_stays_until_it_is_delivered(self):
        self.remind(delay=10)
        del self.world.herdr.panes[self.world.panes["platform"]]
        self.world.tick(10)
        self.world.engine.run_pass()
        self.assertEqual(len(sb.read_reminders(self.world.state)), 1)

    def test_pruning_removes_only_the_delivered_ones(self):
        one, two = self.remind(delay=10), self.remind(to="coder", delay=10)
        self.world.tick(10)
        del self.world.herdr.panes[self.world.panes["coder"]]
        self.world.engine.run_pass()
        self.assertEqual([r["id"] for r in sb.read_reminders(self.world.state)], [two["id"]])

    def test_a_crash_between_delivery_and_pruning_sends_nothing_twice(self):
        item = self.remind(delay=10)
        self.world.tick(10)
        with mock.patch.object(sb, "prune_delivered_reminders", side_effect=RuntimeError("killed")):
            self.world.engine.run_pass()
        self.assertEqual(len(sb.read_reminders(self.world.state)), 1)
        self.world.engine = self.world.new_engine()
        self.world.tick(5)
        self.assertEqual(self.world.engine.run_pass()["sent"], [])
        self.assertEqual(sb.read_reminders(self.world.state), [])
        self.assertEqual(len(self.world.admissions("platform")), 1)

    def test_a_corrupt_file_is_reported_and_never_overwritten(self):
        path = self.world.state / sb.REMINDERS
        path.write_text("{not json")
        self.assertEqual(self.world.engine.collect_facts()[1][0].split(":")[0], "reminder_facts")
        self.assertIn("source.error", [e["event"] for e in self.world.audit()])
        with self.assertRaises(sb.ReminderError):
            self.remind()
        self.assertEqual(path.read_text(), "{not json")

    def test_a_reminder_needs_a_recipient_and_text(self):
        for to, text in (("", "x"), ("platform", "  ")):
            with self.assertRaises(sb.ReminderError):
                sb.add_reminder(self.world.state, to, 1, 0, text)

    def test_deleting_the_state_directory_loses_the_audit_and_reminders_not_yet_due_and_nothing_else(self):
        self.finish_turn()
        self.remind(delay=3600)
        self.world.tick(60)
        self.world.engine.run_pass()      # nothing is due yet
        self.world.engine.audit.append("daemon", "note", None, {"n": 1})
        self.assertTrue(self.world.audit())
        shutil.rmtree(str(self.world.state))
        sb.ensure_state_dir(self.world.state)
        self.world.engine = self.world.new_engine()
        self.world.tick(60)
        report = self.world.engine.run_pass()
        self.assertEqual(len(report["sent"]), 1, "the worker's finished turn is still delivered")
        self.world.tick(5)
        self.assertEqual(self.world.engine.run_pass()["sent"], [])
        self.assertEqual(len(self.world.admissions("platform")), 1)
        self.assertEqual(sb.read_reminders(self.world.state), [], "the reminder is the loss")
        self.world.tick(3600)
        self.assertEqual(self.world.engine.run_pass()["sent"], [])


class TestRemindCLI(PR4Base):
    def setUp(self):
        super().setUp()
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.state_dir = self.world.state

    def main(self, *argv):
        with captured() as (out, err):
            code = sb.main(list(argv), self.world.route, self.world.clock.now, lambda s: None)
        return code, out.getvalue(), err.getvalue()

    def test_remind_stores_one_reminder_and_audits_it(self):
        code, out, err = self.main("remind", "platform", "30m", "--issue", "2", "--from", "coder", "check", "the", "build")
        self.assertEqual(code, 0, err)
        (item,) = sb.read_reminders(self.world.state)
        self.assertEqual((item["to"], item["text"], item["issue"], item["from"], item["at"]),
                         ("platform", "check the build", 2, "coder", EPOCH + 1800))
        self.assertEqual(out.strip(), item["id"])
        self.assertIn("reminder.add", [e["event"] for e in self.world.audit()])

    def test_remind_identifies_the_caller_by_its_pane(self):
        os.environ["HERDR_PANE_ID"] = self.world.panes["coder"]
        code, _, err = self.main("remind", "platform", "1h", "later")
        self.assertEqual(code, 0, err)
        self.assertEqual(sb.read_reminders(self.world.state)[0]["from"], "coder")

    def test_from_is_only_for_the_lab(self):
        os.environ.pop(sb.LAB_ENV)
        code, _, err = self.main("remind", "platform", "1h", "--from", "coder", "later")
        self.assertEqual(code, 2)
        self.assertIn("only for the Lab", err)
        self.assertEqual(sb.read_reminders(self.world.state), [])

    def test_a_bad_when_is_one_line_and_stores_nothing(self):
        code, _, err = self.main("remind", "platform", "tomorrow-ish", "--from", "coder", "later")
        self.assertEqual(code, 1)
        self.assertIn("when must be", err)
        self.assertNotIn("Traceback", err)
        self.assertEqual(sb.read_reminders(self.world.state), [])

    def test_without_a_pane_it_says_so(self):
        code, _, err = self.main("remind", "platform", "1h", "later")
        self.assertEqual(code, 1)
        self.assertIn("HERDR_PANE_ID", err)


# ---- the scenarios and the validator

PR4_CATALOG = {"N1": 3, "N2": 3, "W1": 4, "W3": 4, "Q1": 3, "R1": 4, "H1": None, "R3": None}


class TestScenarioVocabularyPR4(Base):
    def put(self, name, obj, directory=None):
        directory = directory or (self.home / "scenarios")
        directory.mkdir(parents=True, exist_ok=True)
        path = directory / name
        path.write_text(json.dumps(obj))
        return path

    def test_a_scenario_may_shorten_the_engine_timing(self):
        scenario = mutate(lambda o: o.update(config={"engaged_minutes": 3, "batch_seconds": 30}))
        self.assertEqual(sc.validate(scenario), [])

    def test_bad_config_is_refused_field_by_field(self):
        for config, word in (({}, "non-empty"), ([], "non-empty"), ({"poll_seconds": 5}, "unknown key"),
                             ({"engaged_minutes": 0}, "engaged_minutes"), ({"batch_seconds": "90"}, "batch_seconds"),
                             ({"engaged_minutes": True}, "engaged_minutes")):
            with self.subTest(config=config):
                errors = sc.validate(mutate(lambda o, c=config: o.update(config=c)))
                self.assertTrue(any(word in e for e in errors), errors)

    def test_every_config_key_is_one_the_engine_reads(self):
        self.assertLessEqual(set(sc.CONFIG_KEYS), set(sb.DEFAULTS))

    def test_delete_state_is_a_world_step_without_fields(self):
        step = {"at": "100h", "actor": "world", "do": "delete-state"}
        self.assertEqual(sc.validate(mutate(lambda o: o["steps"].append(step))), [])
        errors = sc.validate(mutate(lambda o: o["steps"].append(dict(step, actor="you"))))
        self.assertTrue(any("cannot delete-state" in e for e in errors), errors)
        errors = sc.validate(mutate(lambda o: o["steps"].append(dict(step, path="/"))))
        self.assertTrue(any("unknown field" in e for e in errors), errors)

    def test_delivered_may_name_text_it_must_carry(self):
        self.assertEqual(sc.validate(mutate(lambda o: o["expect"][0].update(text="issue #2"))), [])
        self.assertTrue(sc.validate(mutate(lambda o: o["expect"][0].update(text=2))))

    def test_coverage_through_a_pr_enforces_only_the_problems_due_by_then(self):
        directory = self.home / "scenarios"
        self.put("a.json", mutate(lambda o: o.update(id="A1", problem=3)))
        run = lambda *a: self.run_cli(SCENARIO, "coverage", "--dir", str(directory), *a)
        self.assertEqual(run("--enforce", "--through-pr", "2").returncode, 0)
        late = run("--enforce", "--through-pr", "4")
        self.assertEqual(late.returncode, 1)
        self.assertIn("problem(s) 4", late.stderr)
        self.assertEqual(run("--enforce").returncode, 1)
        self.assertIn("not due until PR 4", run("--through-pr", "2").stdout)
        self.put("b.json", mutate(lambda o: o.update(id="B1", problem=4)))
        self.assertEqual(run("--enforce", "--through-pr", "4").returncode, 0)
        self.assertEqual(run("--enforce", "--through-pr", "7").returncode, 1)

    def test_the_repo_covers_problems_3_and_4_by_pr_4(self):
        proc = self.run_cli(SCENARIO, "coverage", "--enforce", "--through-pr", "4")
        self.assertEqual(proc.returncode, 0, proc.stdout + proc.stderr)
        self.assertEqual(self.run_cli(SCENARIO, "coverage", "--enforce", "--through-pr", "1").returncode, 0)

    def test_due_prs_follow_the_catalog(self):
        self.assertEqual(set(sc.PROBLEM_DUE_PR), set(sc.PROBLEMS))
        found = sc.load_dir()
        firsts = [s["since_pr"] for s in found if s["problem"] == 4]
        self.assertEqual(min(firsts), sc.PROBLEM_DUE_PR[4])


class TestPR4Catalog(unittest.TestCase):
    def test_every_catalog_row_is_present_with_its_control(self):
        found = {s["id"]: s for s in map(sc.load, sc.scenario_files(sc.DEFAULT_DIR))}
        for sid, problem in PR4_CATALOG.items():
            with self.subTest(scenario=sid):
                self.assertIn(sid, found)
                self.assertEqual(found[sid]["since_pr"], 4)
                self.assertEqual(found[sid]["problem"], problem)
                self.assertIn("offline", found[sid]["tiers"])
                self.assertTrue(set(found[sid]["control"]) & {"fault", "baseline"})

    def test_the_lab_tier_can_play_every_scenario_that_claims_it(self):
        lab = _load("t_proof_pr4", BIN / "proof-switchboard")
        fs = lab.fleet_scenario()
        for path in sc.scenario_files(sc.DEFAULT_DIR):
            scenario = sc.load(path)
            if "lab-scripted" in scenario["tiers"] and scenario["since_pr"] >= 4 and "spike" not in scenario.get("tags", ()):
                with self.subTest(scenario=scenario["id"]):
                    self.assertEqual(lab.unsupported(scenario, fs), [])
                    self.assertTrue(lab.uses_engine(scenario))

    def test_the_two_hour_scenario_is_offline_only_for_now(self):
        self.assertEqual(sc.load(sc.DEFAULT_DIR / "q1-quiet-two-hours.json")["tiers"], ["offline"])


class TestOfflineScenariosPR4(Base):
    def run_named(self, name, edit=None):
        scenario = sc.load(sc.DEFAULT_DIR / name)
        if edit:
            edit(scenario)
        return run_scenario(self, scenario)

    def test_the_baseline_is_the_old_timer_not_a_fault(self):
        scenario = sc.load(sc.DEFAULT_DIR / "q1-quiet-two-hours.json")
        played = with_baseline(scenario, "timer-heartbeat")
        beats = [s for s in played["steps"] if s["do"] == "timer-heartbeat"]
        self.assertEqual([sc.duration_seconds(s["at"]) for s in beats], [1800, 3600, 5400, 7200])
        self.assertEqual(with_baseline(scenario, None), scenario)
        with self.assertRaises(NotImplementedError):
            with_baseline(scenario, "something-else")

    def test_a_quiet_two_hours_fails_under_the_old_timer_and_passes_without_it(self):
        report = self.run_named("q1-quiet-two-hours.json")
        self.assertEqual(report["failures"], [])
        self.assertEqual(report["proves_nothing"], [])
        self.assertFalse(next(r for r in report["control"] if r["label"] == "no-turns")["ok"])

    def test_n2_converts_the_note_and_its_control_leaves_it_waiting(self):
        report = self.run_named("n2-note-outlives-you.json")
        self.assertEqual(report["failures"], [])
        self.assertFalse(next(r for r in report["control"] if r["label"] == "converted")["ok"])

    def test_n1_with_the_gate_removed_wakes_the_orchestrator(self):
        report = self.run_named("n1-note-while-engaged.json")
        control = {r["label"]: r["ok"] for r in report["control"]}
        self.assertFalse(control["no-machine-turn"])
        self.assertFalse(control["noted"])

    def test_the_scenario_config_reaches_the_engine(self):
        scenario = sc.load(sc.DEFAULT_DIR / "n2-note-outlives-you.json")
        run = OfflineRun(self, scenario, "probe")
        self.assertEqual(run.world.engine.engaged_seconds, scenario["config"]["engaged_minutes"] * 60)

    def test_the_within_oracle_judges_delivery_and_answer_against_a_step(self):
        scenario = sc.load(sc.DEFAULT_DIR / "w1-worker-done-away.json")
        run = OfflineRun(self, scenario, "within").run()
        e = {"that": "within", "agent": "platform", "step": 1, "seconds": 150, "key": "worker.idle:*"}
        self.assertTrue(run.oracle_within(e)[0])
        self.assertFalse(run.oracle_within(dict(e, seconds=60))[0], "batching alone takes 90 s")
        self.assertFalse(run.oracle_within(dict(e, key="nothing:*"))[0])
        with self.assertRaises(NotImplementedError):
            run.oracle_within({k: v for k, v in e.items() if k != "key"})

    def test_the_toast_oracle_matches_agent_and_text(self):
        scenario = sc.load(sc.DEFAULT_DIR / "w3-worker-blocked.json")
        run = OfflineRun(self, scenario, "toast").run()
        self.assertTrue(run.oracle_toast({"that": "toast", "agent": "coder", "text": "shell"})[0])
        self.assertFalse(run.oracle_toast({"that": "toast", "agent": "platform"})[0])
        self.assertFalse(run.oracle_toast({"that": "toast", "text": "no such words"})[0])

    def test_the_lab_toast_oracle_reads_the_argv_the_real_client_writes(self):
        """The shim logs the argv the engine's HerdrClient built; the Lab oracle must read that shape."""
        lab = _load("t_proof_toast", BIN / "proof-switchboard")
        runner = FakeRunner((0, '{"result": {"type": "notification_show", "shown": true, "reason": "shown"}}', ""))
        sb.HerdrClient("herdr", runner, 5).notification_show("Fleet: coder is blocked", "coder is waiting: shell")
        engine = types.SimpleNamespace(shim_log=lambda: [{"kind": "toast", "argv": runner.argv[1:]}])
        run = types.SimpleNamespace(engine=engine)
        for item, want in (({"agent": "coder", "text": "waiting"}, True), ({"text": "is blocked"}, True),
                           ({"agent": "platform"}, False), ({"text": "no such words"}, False)):
            self.assertEqual(lab.ScenarioRun.check_toast(run, item)[0], want, item)

    def test_no_machine_turn_sees_a_wake_and_ignores_a_note_and_your_prompt(self):
        world = World(self, agents=("platform",))
        run = type("Run", (), {})()
        run.world = world
        check = lambda: OfflineRun.oracle_no_machine_turn(run, {"agent": "platform"})[0]
        world.you("platform")
        self.assertTrue(check())
        world.fact("platform", "lab.fact:1")
        world.tick(90)
        world.engine.run_pass()   # a note: you are engaged
        self.assertTrue(check())
        world.tick(700)
        world.engine.run_pass()   # converted to a wake
        self.assertFalse(check())

    def test_h1_closes_the_pane_in_the_race_and_every_write_is_audited(self):
        report = self.run_named("h1-pane-closed-mid-delivery.json")
        self.assertEqual(report["failures"], [])
        self.assertEqual(report["implicit"], [])


# ---- the Lab runner's herdr shim (the Lab itself cannot run here)

class TestLabHerdrShim(Base):
    def setUp(self):
        super().setUp()
        self.lab = _load("t_proof_shim", BIN / "proof-switchboard")
        self.real = self.fake_bin("real-herdr", 'echo "$@" >> "$0.calls"; echo \'{"result": {}}\'\n')
        self.shim = self.home / "herdr-shim"
        self.lab.write_herdr_shim(str(self.shim), str(self.home), str(self.real))

    def run_shim(self, *args):
        return subprocess.run([str(self.shim), *args], capture_output=True, text=True, env=dict(os.environ))

    def calls(self):
        path = Path(str(self.real) + ".calls")
        return path.read_text().splitlines() if path.exists() else []

    def log(self):
        path = self.home / self.lab.SHIM_LOG
        return [json.loads(line) for line in path.read_text().splitlines()] if path.exists() else []

    def test_it_passes_everything_through_untouched(self):
        proc = self.run_shim("agent", "list")
        self.assertEqual((proc.returncode, proc.stdout.strip()), (0, '{"result": {}}'))
        self.assertEqual(self.calls(), ["agent list"])
        self.assertEqual(self.log(), [])

    def test_it_records_each_toast_it_is_asked_for_and_still_passes_it_on(self):
        self.run_shim("notification", "show", "--title", "Fleet: coder is blocked", "--body", "waiting")
        (entry,) = self.log()
        self.assertEqual(entry["kind"], "toast")
        self.assertEqual(entry["argv"], ["notification", "show", "--title", "Fleet: coder is blocked", "--body", "waiting"])
        self.assertEqual(len(self.calls()), 1)

    def test_an_armed_close_fires_once_on_the_next_read_of_that_pane(self):
        (self.home / self.lab.SHIM_ARM).write_text("w1:p2\n")
        self.run_shim("agent", "get", "w1:p1")
        self.assertEqual(self.calls(), ["agent get w1:p1"], "another pane is left alone")
        self.run_shim("agent", "get", "w1:p2")
        self.assertEqual(self.calls(), ["agent get w1:p1", "pane close w1:p2", "agent get w1:p2"])
        self.assertEqual([e["kind"] for e in self.log()], ["closed"])
        self.run_shim("agent", "get", "w1:p2")
        self.assertEqual(self.calls()[-1], "agent get w1:p2")
        self.assertEqual(len([c for c in self.calls() if c.startswith("pane close")]), 1)

    def test_nothing_is_closed_unless_armed(self):
        self.run_shim("agent", "get", "w1:p2")
        self.assertEqual(self.calls(), ["agent get w1:p2"])

# =========================================================== PR 6: intent lines
#
# One section: a fake GitHub, the offline runner's intent steps and oracles,
# and the tests. Nothing here reaches a real gh, herdr or OpenCode: every
# transport is a fake, and the base class's PATH holds none of them.

import datetime  # noqa: E402  (this section's only import)

FAKE_GH = "/fake/bin/gh"
FAKE_REPO = "acme/fleet"
ISSUES_API = "repos/%s/issues/" % FAKE_REPO


def _utc(epoch):
    return datetime.datetime.fromtimestamp(epoch, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def intent_body(intent, done_when, revision=0):
    """An issue body: an `## Intent` section when either line is given."""
    parts = ["Some text before.\n"]
    if intent is not None or done_when is not None:
        parts.append("## Intent\n")
        if intent is not None:
            parts.append(intent + "\n")
        if done_when is not None:
            parts.append("Done when: %s\n" % done_when)
    if revision:
        parts.append("\n## Notes\nrevision %d\n" % revision)
    return "".join(parts)


class FakeGH:
    """`gh api` over a scenario's issues. A runner, like the other fakes.

    Serves GET only, by path: an issue, its parent (404 without one) and a
    charter's sub-issues. Any other shape of call raises, so a write cannot
    pass for a read. `issues` is a scenario's table: number -> intent,
    done_when, parent. A charter's body is its yaml block.
    """

    def __init__(self, issues, charters, clock):
        self.issues = {int(n): dict(v) for n, v in issues.items()}
        self.charters, self.clock = set(charters), clock
        self.revision, self.updated = {}, {}
        self.calls, self.down = [], False

    def body(self, number):
        if number in self.charters:
            line = self.issues[number].get("authority")  # PR 9: a charter's Standing authority line
            return "```yaml\norchestrator: platform\nstatus: active\n```\n\nThe charter.\n" + (
                "\nStanding authority: %s\n" % line if line else "")
        issue = self.issues[number]
        return intent_body(issue.get("intent"), issue.get("done_when"), self.revision.get(number, 0))

    def record(self, number):
        return {"number": number, "state": self.issues[number].get("state", "open"),
                "title": "Issue %d" % number, "body": self.body(number),
                "updated_at": self.updated.get(number, "2027-01-01T00:00:00Z")}

    def edit(self, number, **fields):
        """Edit the intent fields (None removes a line); the body always changes. (old, new) bodies."""
        old = self.body(number)
        self.issues[number].update(fields)
        self.revision[number] = self.revision.get(number, 0) + 1
        self.updated[number] = _utc(self.clock.now())
        return old, self.body(number)

    def __call__(self, argv, **kwargs):
        argv = list(argv)
        self.calls.append(argv)
        if "--method" in argv:  # PR 8: the handoff comment, the one write
            return self.post_comment(argv, kwargs)
        if len(argv) != 3 or argv[:2] != [FAKE_GH, "api"]:
            raise AssertionError("fake gh serves `gh api <path>` only, a GET; got %r" % argv)
        if self.down:
            return subprocess.CompletedProcess(argv, 1, "", "gh: network unreachable\n")
        match = re.match(r"^%s(\d+)(/parent|/sub_issues\?per_page=100)?$" % re.escape(ISSUES_API), argv[2])
        if not match or int(match.group(1)) not in self.issues:
            return subprocess.CompletedProcess(argv, 1, "", "gh: Not Found (HTTP 404)\n")
        number, tail = int(match.group(1)), match.group(2)
        if tail == "/parent":
            parent = self.issues[number].get("parent")
            body = self.record(parent) if parent in self.issues else None
        elif tail:
            body = [self.record(n) for n in sorted(self.issues) if self.issues[n].get("parent") == number]
        else:
            body = self.record(number)
        if body is None:
            return subprocess.CompletedProcess(argv, 1, "", "gh: Not Found (HTTP 404)\n")
        return subprocess.CompletedProcess(argv, 0, json.dumps(body), "")


@adds_to(FakeGH)
def post_comment(self, argv, kwargs):
    """PR 8: `gh api repos/R/issues/N/comments --method POST --input -` with {"body": ...} on stdin,
    and nothing else. Any other write raises, so a stray write cannot pass for the handoff."""
    path = argv[2] if len(argv) > 2 else ""
    found = re.match(r"^%s(\d+)/comments$" % re.escape(ISSUES_API), path)
    if argv[:2] != [FAKE_GH, "api"] or argv[3:] != ["--method", "POST", "--input", "-"] or not found:
        raise AssertionError("fake gh writes only a comment: gh api <issues>/N/comments --method POST --input -; got %r"
                             % (argv,))
    if "stdin" in kwargs:
        raise AssertionError("a write passes its body as input, not stdin")
    if self.down:
        return subprocess.CompletedProcess(argv, 1, "", "gh: network unreachable\n")
    number = int(found.group(1))
    if number not in self.issues:
        return subprocess.CompletedProcess(argv, 1, "", "gh: Not Found (HTTP 404)\n")
    comments = self.__dict__.setdefault("comments", [])
    comments.append({"issue": number, "body": json.loads(kwargs["input"])["body"]})
    return subprocess.CompletedProcess(argv, 0, json.dumps({
        "id": 9000 + len(comments), "html_url": "https://example.test/%s/issues/%d#c%d" % (FAKE_REPO, number, len(comments))}), "")


def attach_intent_lab(run):
    """The offline runner's seam: a scenario with `issues` gets a fake GitHub and a reader over it."""
    run.ask_gh = None
    if "issues" not in run.scenario:
        return
    charters = {m["charter"] for m in run.scenario["cast"].values() if "charter" in m}
    run.ask_gh = FakeGH(run.scenario["issues"], charters, run.world.clock)
    run.world.intents = sb.IntentReader(FAKE_GH, FAKE_REPO, run.ask_gh, run.world.clock.now, 5)


def apply_edit_intent(run, step):
    """`edit-intent`: edit the fake issue, then do what PR 5's webhook handler
    will do: invalidate the cache, and turn the event into an item for the
    Chief of Staff and a toast for you, with the pure functions under test."""
    world = run.world
    fields = {name: step[name] for name in ("intent", "done_when") if name in step}
    old, new = run.ask_gh.edit(step["issue"], **fields)
    world.intents.invalidate(step["issue"])
    payload = {"action": "edited", "changes": {"body": {"from": old}}, "sender": {"login": "you"},
               "issue": {"number": step["issue"], "body": new, "updated_at": run.ask_gh.updated[step["issue"]]}}
    cos = next(name for name, member in sorted(run.scenario["cast"].items()) if member["role"] == "chief-of-staff")
    change = sb.intent_change_fact(payload, cos)
    if change is not None:
        with open(str(world.state / sb.LAB_FACTS), "a") as handle:
            handle.write(json.dumps(change.to_json()) + "\n")
    toast = sb.intent_change_toast(payload)
    if toast is not None:
        with world.engine.audit.external("daemon", "herdr.notification", "you", toast):
            world.engine.herdr.notification_show(toast["title"], toast["body"])


def apply_handoff_step(run, step):
    """PR 8, `handoff`: the cast member runs `fleet-switchboard handoff` for an ask, as the
    Chief of Staff's model would. The brief is posted on the fake GitHub, and the subagent is
    launched (into the fakes) with the cast member as the one it reports to."""
    world = run.world
    sb.handoff_ask(world.new_engine("cli"), step["actor"], step["issue"], step["brief"],
                   directory=str(run.work), workspace="w1", patience=5,
                   sleep=lambda seconds: setattr(world.clock, "t", world.clock.t + seconds))


@adds_to(OfflineRun)
def oracle_handed_off(self, e):
    """PR 8: a brief on the ask (the fake GitHub's comments) and a `cos-subagent` session for it (the fake v2)."""
    comments = [c for c in getattr(self.ask_gh, "comments", []) if c["issue"] == e["issue"]
                and c["body"].startswith("## Handoff: ask %d\n" % e["issue"])]
    subagents = [s for s in self.world.v2.sessions.values()
                 if (s["metadata"].get("fleet") or {}).get("role") == sb.COS_SUBAGENT
                 and (s["metadata"].get("fleet") or {}).get("issue") == e["issue"]]
    return bool(comments) and bool(subagents), "%d brief comment(s) on #%d; %d cos-subagent session(s) for it" % (
        len(comments), e["issue"], len(subagents))


def _delivered_texts(run, name):
    return [a["text"] for a in run.world.admissions(name) if a["delivered_at"] is not None]


def _ask_of(issues, number):
    parent = (issues.get(str(number)) or {}).get("parent")
    if parent and (issues.get(str(parent)) or {}).get("parent"):
        return parent, number
    return number, None


def _oracle_message_has_intent(self, e):
    issues = self.scenario["issues"]
    ask, work = _ask_of(issues, e["issue"])
    need = [issues[str(ask)]["intent"] or "no intent recorded"]
    if issues[str(ask)].get("done_when"):
        need.append("Done when: %s" % issues[str(ask)]["done_when"])
    if work:
        need.append(issues[str(work)]["intent"] or "no intent recorded")
    texts = _delivered_texts(self, e["to"])
    ok = any(all(part in text for part in need) for text in texts)
    return ok, "%d delivered message(s); one must carry %r" % (len(texts), need)


def _oracle_message_shows(self, e):
    texts = _delivered_texts(self, e["to"])
    return any(e["text"] in text for text in texts), "%d delivered message(s) to %s" % (len(texts), e["to"])


def _oracle_intent_gap(self, e):
    gaps = sb.fleet_overview(self.world.engine, None).get("intent_gaps", [])
    return e["issue"] in gaps, "status lists %s as lacking an Intent section" % (gaps,)


def _oracle_judged(self, e):
    return True, "not evaluated offline: a model's text is judged only in the lab-model tier"


for _oracle in (_oracle_message_has_intent, _oracle_message_shows, _oracle_intent_gap, _oracle_judged):
    setattr(OfflineRun, _oracle.__name__[1:], _oracle)


# ------------------------------------------------------------------ the tests

CHARTER_BODY = "```yaml\norchestrator: platform\nstatus: active\n```\n"


class TestIntentParsing(unittest.TestCase):
    def test_the_first_line_is_the_intent_and_done_when_is_its_own_line(self):
        body = "Intro\n\n## Intent\nFix the agents.\nDone when: both answer.\n\n## Notes\nx\n"
        self.assertEqual(sb.parse_intent(body), ("Fix the agents.", "both answer."))

    def test_missing_parts_are_none(self):
        self.assertEqual(sb.parse_intent("no section at all"), (None, None))
        self.assertEqual(sb.parse_intent("## Intent\nJust this\n"), ("Just this", None))
        self.assertEqual(sb.parse_intent("## Intent\nDone when: later\n"), (None, "later"))
        self.assertEqual(sb.parse_intent("## Intent\n\n## Next\nDone when: not mine\n"), (None, None))
        self.assertEqual(sb.parse_intent(None), (None, None))

    def test_tolerates_crlf_heading_levels_case_and_bullets(self):
        body = "### intent  \r\n- Make it work\r\n- **Done when:** it works\r\n"
        self.assertEqual(sb.parse_intent(body), ("- Make it work", "it works"))

    def test_the_section_ends_at_the_next_heading_and_fences_are_ignored(self):
        body = "```\n## Intent\nnot this\n```\n## Intent\nthis\n```\n## Other\n```\nDone when: x\n## After\nno\n"
        self.assertEqual(sb.parse_intent(body), ("this", "x"))


class IntentCase(Base):
    """A world with a fake GitHub: charter 1, ask 2 under it, work item 3 under the ask."""

    ISSUES = {
        "1": {"intent": None},
        "2": {"intent": "Fix the agents", "done_when": "both answer", "parent": 1},
        "3": {"intent": "Fix the second one", "parent": 2},
        "4": {"intent": None, "parent": 1},
        "5": {"intent": "Another ask", "done_when": "it is done", "parent": 1},
    }

    def setUp(self):
        super().setUp()
        self.config = {"gh": FAKE_GH, "intent_repo": FAKE_REPO}
        self.world = World(self, agents=("platform", "coder"), config=self.config)
        self.gh = FakeGH(self.ISSUES, {1}, self.world.clock)
        self.reader = sb.IntentReader(FAKE_GH, FAKE_REPO, self.gh, self.world.clock.now, 5)
        self.world.intents = self.reader
        self.world.engine = self.world.new_engine()

    def tick(self, seconds):
        self.world.tick(seconds)


class TestIntentReader(IntentCase):
    def test_reads_the_intent_lines_of_an_issue(self):
        issue = self.reader.issue(2)
        self.assertEqual((issue.intent, issue.done_when, issue.charter), ("Fix the agents", "both answer", False))
        self.assertTrue(self.reader.issue(1).charter)

    def test_a_work_item_resolves_to_its_ask_and_the_charter_is_never_repeated(self):
        self.assertEqual(self.reader.ask_of(3), (2, 3))
        self.assertEqual(self.reader.ask_of(2), (2, None))
        ask, ask_lines, work, work_lines = self.reader.header(3)
        self.assertEqual((ask, work), (2, 3))
        self.assertEqual(ask_lines, ["Ask #2 Intent: Fix the agents", "Done when: both answer"])
        self.assertEqual(work_lines, ["Work item #3 Intent: Fix the second one"])
        self.assertIsNone(self.reader.header(1))

    def test_missing_intent_renders_as_such(self):
        self.assertEqual(self.reader.header(4)[1], ["Ask #4: no intent recorded"])
        self.gh.issues[2]["done_when"] = None
        self.reader.invalidate(2)
        self.assertEqual(self.reader.header(2)[1], ["Ask #2 Intent: Fix the agents", "Done when: not recorded"])

    def test_the_cache_serves_until_invalidated_or_expired(self):
        self.reader.issue(2)
        calls = len(self.gh.calls)
        self.gh.edit(2, intent="Changed")
        self.assertEqual(self.reader.issue(2).intent, "Fix the agents")
        self.assertEqual(len(self.gh.calls), calls)
        self.reader.invalidate(2)
        self.assertEqual(self.reader.issue(2).intent, "Changed")
        self.assertEqual(self.reader.issue(2).updated_at, self.gh.updated[2])
        self.world.clock.t += sb.INTENT_TTL + 1
        self.gh.edit(2, intent="Again")
        self.assertEqual(self.reader.issue(2).intent, "Again")

    def test_a_failed_read_is_not_cached(self):
        self.gh.down = True
        with self.assertRaises(sb.IntentError):
            self.reader.issue(2)
        self.gh.down = False
        self.assertEqual(self.reader.issue(2).intent, "Fix the agents")

    def test_it_only_ever_issues_plain_gets(self):
        self.reader.header(3)
        self.reader.open_asks(1)
        for argv in self.gh.calls:
            self.assertEqual(argv[:2], [FAKE_GH, "api"])
            self.assertEqual(len(argv), 3, argv)  # no -X, -f, -F, --input or --method
        self.assertNotRegex(class_source("IntentReader"), r"\"(-X|-f|-F|--method|--input|--field)\"")

    def test_open_asks_are_the_open_sub_issues_of_a_charter(self):
        self.gh.issues[5]["state"] = "closed"
        self.assertEqual([i.number for i in self.reader.open_asks(1)], [2, 4])

    def test_missing_intent_lists_the_chain_without_the_charter(self):
        self.assertEqual(self.reader.missing_intent(4), [4])
        self.assertEqual(self.reader.missing_intent(3), [])
        self.assertEqual(self.reader.missing_intent(1), [])

    def test_invalid_config_is_refused(self):
        for raw in ({"intent_repo": "not a repo"}, {"intent_repo": 7}, {"intent_required": "yes"}, {"gh": ""}):
            with self.subTest(raw=raw), self.assertRaises(sb.ConfigError):
                sb.validate_config(raw)
        self.assertEqual(sb.validate_config({"intent_repo": "a/b"})["intent_required"], True)


class TestIntentCompose(IntentCase):
    def section(self):
        return sb.section_resolver(self.world.engine, None)

    def compose(self, facts):
        return sb.compose("platform", facts, section=self.section())

    def test_an_item_about_a_work_item_sits_under_its_ask(self):
        text, _ = self.compose([fact("a", issue=3, sender="coder", summary="PR up")])
        self.assertEqual(text.splitlines()[1:], [
            "", "Ask #2 Intent: Fix the agents", "Done when: both answer",
            "Work item #3 Intent: Fix the second one", "- lab.fact from coder (issue #3): PR up"])

    def test_several_asks_get_one_section_each_never_interleaved(self):
        text, _ = self.compose([
            fact("a", EPOCH, issue=2), fact("b", EPOCH + 1, issue=5), fact("c", EPOCH + 2, issue=2),
            fact("d", EPOCH + 3, issue=3)])
        lines = text.splitlines()
        heads = [i for i, line in enumerate(lines) if line.startswith("Ask #")]
        self.assertEqual([lines[i][:6] for i in heads], ["Ask #2", "Ask #5"])
        ask2, ask5 = lines[heads[0]:heads[1]], lines[heads[1]:]
        self.assertEqual(sum("(issue #" in line for line in ask2), 3)
        self.assertEqual(sum("(issue #" in line for line in ask5), 1)
        self.assertTrue(all("issue #5" not in line for line in ask2))
        self.assertLessEqual(len([line for line in ask2 if line and not line.startswith("- ")]), 4)

    def test_facts_without_an_issue_get_no_header_and_come_first(self):
        text, _ = self.compose([fact("a", EPOCH + 1, issue=2), fact("b", EPOCH)])
        lines = text.splitlines()
        self.assertEqual(lines[1], "- lab.fact from the fleet: s b")
        self.assertEqual(sum(line.startswith("Ask #") for line in lines), 1)

    def test_the_charter_is_never_repeated(self):
        text, _ = self.compose([fact("a", issue=1)])
        self.assertNotIn("Ask #", text)
        self.assertIn("(issue #1)", text)

    def test_missing_intent_says_so(self):
        text, _ = self.compose([fact("a", issue=4)])
        self.assertIn("Ask #4: no intent recorded", text)

    def test_an_unreachable_github_does_not_stop_the_message(self):
        self.gh.down = True
        text, carried = self.compose([fact("a", issue=2)])
        self.assertIn("Ask #2: intent unavailable", text)
        self.assertEqual(len(carried), 1)

    def test_no_intent_header_fault_omits_headers(self):
        os.environ[sb.FAULT_ENV] = "no-intent-header"
        self.assertIsNone(self.section())
        text, _ = sb.compose("platform", [fact("a", issue=2)], section=self.section())
        self.assertNotIn("Ask #", text)

    def test_the_fault_only_works_in_the_lab(self):
        os.environ[sb.FAULT_ENV] = "no-intent-header"
        os.environ.pop(sb.LAB_ENV)
        self.assertIsNotNone(self.section())

    def test_the_engine_delivers_with_the_headers(self):
        self.world.fact("platform", "lab.fact:1", "hello", issue=3, **{"from": "coder"})
        self.tick(90)
        self.world.engine.run_pass()
        (admitted,) = self.world.admissions("platform")
        self.assertIn("Ask #2 Intent: Fix the agents", admitted["text"])

    def test_without_an_ask_repo_nothing_changes(self):
        world = World(self)
        self.assertIsNone(world.engine.intents)
        self.assertIsNone(sb.section_resolver(world.engine, None))


class TestIntentSend(IntentCase):
    def setUp(self):
        super().setUp()
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "gh": FAKE_GH, "intent_repo": FAKE_REPO})

    def route(self, argv, **kwargs):
        return self.gh(argv) if argv[0] == FAKE_GH else self.world.route(argv, **kwargs)

    def main(self, *argv):
        with captured() as (out, err):
            code = sb.main(list(argv), runner=self.route, now=self.world.clock.now, wait=lambda sock, s: False)
        return code, out.getvalue(), err.getvalue()

    def test_send_refuses_without_an_issue_and_writes_nothing(self):
        code, _, err = self.main("send", "platform", "--from", "coder", "hi")
        self.assertEqual(code, sb.EXIT_USAGE)
        self.assertIn("send needs --issue", err)
        self.assertEqual(self.world.v2.writes, [])

    def test_send_with_an_issue_delivers_under_its_ask(self):
        os.environ[sb.LAB_ENV] = "1"
        code, _, err = self.main("send", "platform", "--from", "coder", "--issue", "3", "PR", "is", "up")
        self.assertEqual(code, 0, err)
        (admitted,) = self.world.admissions("platform")
        self.assertIn("Ask #2 Intent: Fix the agents\nDone when: both answer\nWork item #3", admitted["text"])

    def test_intent_required_false_turns_the_refusal_off(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "gh": FAKE_GH,
                           "intent_repo": FAKE_REPO, "intent_required": False})
        self.assertEqual(self.main("send", "platform", "--from", "coder", "hi")[0], 0)

    def test_without_an_ask_repo_send_needs_no_issue(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.assertEqual(self.main("send", "platform", "--from", "coder", "hi")[0], 0)

    def test_the_refusal_is_the_safeguard(self):
        with mock.patch.object(sb, "intent_refusal", lambda config, issue: None):
            self.assertEqual(self.main("send", "platform", "--from", "coder", "hi")[0], 0)


class TestIntentCLI(IntentCase):
    def setUp(self):
        super().setUp()
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "gh": FAKE_GH, "intent_repo": FAKE_REPO})
        self.cos = self.world.add_agent("chief-of-staff", fleet={"role": "chief-of-staff"})
        self.world.add_agent("platform2", fleet={"role": "orchestrator", "charter": 1})
        self.world.add_agent("orch", fleet={"role": "orchestrator", "charter": 1})
        self.world.add_agent("worker", fleet={"role": "coder", "issue": 3})

    def main(self, *argv):
        def route(argv, **kwargs):
            return self.gh(argv) if argv[0] == FAKE_GH else self.world.route(argv, **kwargs)
        with captured() as (out, err):
            code = sb.main(list(argv), runner=route, now=self.world.clock.now, wait=lambda sock, s: False)
        return code, out.getvalue(), err.getvalue()

    def as_agent(self, name):
        os.environ["HERDR_PANE_ID"] = self.world.panes[name]

    def test_intent_prints_the_ask_and_the_work_item(self):
        code, out, _ = self.main("intent", "3")
        self.assertEqual(code, 0)
        self.assertEqual(out.splitlines(), ["Ask #2 Intent: Fix the agents", "Done when: both answer",
                                            "Work item #3 Intent: Fix the second one"])
        self.assertIn("is a charter", self.main("intent", "1")[1])
        self.assertIn("no intent recorded", self.main("intent", "4")[1])

    def test_intent_without_an_ask_repo_says_what_to_set(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        code, _, err = self.main("intent", "2")
        self.assertEqual(code, 1)
        self.assertIn("intent_repo", err)

    def test_an_orchestrator_sees_the_asks_under_its_charter(self):
        self.as_agent("orch")
        code, out, _ = self.main("intents")
        self.assertEqual(code, 0)
        self.assertEqual(out.splitlines(), [
            "#2  [orch]  Fix the agents  | Done when: both answer",
            "#4  [orch]  no intent recorded  | Done when: not recorded",
            "#5  [orch]  Another ask  | Done when: it is done"])

    def test_closed_asks_are_left_out(self):
        self.gh.issues[2]["state"] = "closed"
        self.as_agent("orch")
        self.assertNotIn("#2 ", self.main("intents")[1])

    def test_the_chief_of_staff_sees_every_orchestrators_asks(self):
        self.as_agent("chief-of-staff")
        out = self.main("intents")[1].splitlines()
        self.assertEqual(len(out), 6)
        self.assertEqual({line.split("  ")[1] for line in out}, {"[orch]", "[platform2]"})

    def test_a_coder_sees_the_ask_of_its_issue(self):
        self.as_agent("worker")
        self.assertEqual(self.main("intents")[1].splitlines(), ["#2  [worker]  Fix the agents  | Done when: both answer"])

    def test_intents_needs_a_fleet_caller(self):
        code, _, err = self.main("intents")
        self.assertEqual(code, 1)
        self.assertIn("HERDR_PANE_ID", err)

    def test_status_lists_the_issues_agents_refer_to_that_lack_an_intent(self):
        self.world.fact("platform", "lab.fact:1", issue=4)
        self.world.add_agent("holder", fleet={"role": "coder", "issue": 4})
        code, out, _ = self.main("status")
        self.assertIn("no Intent section: #4", out)
        report = json.loads(self.main("status", "--json")[1])
        self.assertEqual(report["agents"]["intent_gaps"], [4])
        self.assertEqual(self.world.v2.writes, [])

    def test_status_is_unchanged_without_an_ask_repo(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.assertNotIn("intent_gaps", json.loads(self.main("status", "--json")[1])["agents"])


class TestIntentChange(unittest.TestCase):
    def payload(self, old, new, action="edited", updated="2027-01-15T08:00:00Z", **extra):
        body = {"action": action, "issue": {"number": 7, "body": new, "updated_at": updated},
                "sender": {"login": "alice"}, "changes": {"body": {"from": old}}}
        body.update(extra)
        return body

    OLD = "## Intent\nAdd a health check\nDone when: GET /health returns 200\n"

    def test_an_intent_edit_is_an_item_for_the_chief_of_staff_showing_old_and_new(self):
        new = "## Intent\nAdd a readiness check\nDone when: GET /health returns 200\n"
        change = sb.intent_change_fact(self.payload(self.OLD, new))
        self.assertEqual((change.key, change.recipient, change.issue, change.kind, change.sender),
                         ("intent.edit:7:2027-01-15T08:00:00Z", "chief-of-staff", 7, "intent.edit", "alice"))
        self.assertEqual(change.summary.splitlines(), [
            "The Intent section of #7 was edited on GitHub:", "Intent: Add a health check -> Add a readiness check"])
        self.assertEqual(change.created, datetime.datetime(2027, 1, 15, 8, 0, tzinfo=datetime.timezone.utc).timestamp())

    def test_a_done_when_change_is_shown_too_and_a_missing_side_is_none(self):
        new = "## Intent\nAdd a health check\n"
        summary = sb.intent_change_fact(self.payload(self.OLD, new), "cos").summary
        self.assertIn("Done when: GET /health returns 200 -> (none)", summary)
        self.assertNotIn("Intent: Add a health check ->", summary)
        added = sb.intent_change_fact(self.payload("nothing here", self.OLD)).summary
        self.assertIn("Intent: (none) -> Add a health check", added)

    def test_an_edit_that_leaves_the_intent_alone_is_nothing(self):
        new = self.OLD + "\n## Notes\nmore text\n"
        self.assertIsNone(sb.intent_change_fact(self.payload(self.OLD, new)))
        self.assertIsNone(sb.intent_change_toast(self.payload(self.OLD, new)))

    def test_other_events_are_nothing(self):
        new = "## Intent\nChanged\n"
        self.assertIsNone(sb.intent_change_fact(self.payload(self.OLD, new, action="opened")))
        title_edit = self.payload(self.OLD, new)
        del title_edit["changes"]["body"]
        self.assertIsNone(sb.intent_change_fact(title_edit))
        self.assertIsNone(sb.intent_change_fact("not a payload"))

    def test_the_toast_is_a_title_and_a_body(self):
        toast = sb.intent_change_toast(self.payload(self.OLD, "## Intent\nNew\nDone when: GET /health returns 200\n"))
        self.assertEqual(toast, {"title": "Intent changed on #7", "body": "Intent: Add a health check -> New"})

    def test_the_key_makes_a_redelivered_event_one_item(self):
        new = "## Intent\nNew\n"
        a = sb.intent_change_fact(self.payload(self.OLD, new))
        b = sb.intent_change_fact(self.payload(self.OLD, new))
        c = sb.intent_change_fact(self.payload(self.OLD, new, updated="2027-01-15T09:00:00Z"))
        self.assertEqual(a.key, b.key)
        self.assertNotEqual(a.key, c.key)

    def test_a_payload_without_updated_at_is_refused(self):
        bad = self.payload(self.OLD, "## Intent\nNew\n", updated=None)
        with self.assertRaises(sb.FactError):
            sb.intent_change_fact(bad)


AGENT_FILES = tuple(sorted((REPO / "agents" / "opencode").glob("*.md"))
                    + sorted((REPO / "agents" / "copilot").glob("*.agent.md")))
SHARED_MAXIMS = ("Festina lente", "Chesterton's fence", "Cut the root, not the branch", "Outcomes, not mechanics",
                 "Say it failed", "A diagnosis is not a mandate", "Don't widen the ask",
                 "Permission doesn't travel", "An empty queue is not a mandate")
COS_ONLY_MAXIMS = ("The last message stands alone", "No change, no message",
                   "Evidence, consequence, options, recommendation")
RUBRIC = ("grows the contract", "can't be undone", "speaks for your principal", "a key that isn't yours",
          "ready for your principal's eyes", "stuck after trying")
ROLE_LINE_LIMITS = {"coder": 120, "orchestrator": 178, "chief-of-staff": 162, "cos-subagent": 70}  # lines; they must not grow
ROLE_BYTE_LIMITS = {"coder": 5300, "orchestrator": 9000, "chief-of-staff": 8300, "cos-subagent": 3500}
WORKER_ROLES = ("coder", "cos-subagent")  # PR 8: the roles that do an assignment, not a judgement of others


def role_of(path):
    return path.name.split(".")[0]


def maxims_block(text):
    match = re.search(r"^## Maxims\n(.*?)(?=^## )", text, re.S | re.M)
    return match.group(1) if match else ""


class TestAgentDefinitions(unittest.TestCase):
    def test_there_are_eight_role_files(self):
        self.assertEqual(sorted(role_of(p) for p in AGENT_FILES),
                         sorted(["coder", "orchestrator", "chief-of-staff", "cos-subagent"] * 2))

    def test_each_has_a_short_maxims_block_with_its_roles_phrases(self):
        for path in AGENT_FILES:
            with self.subTest(file=str(path.relative_to(REPO))):
                block = maxims_block(path.read_text())
                self.assertTrue(block, "no ## Maxims block")
                self.assertLessEqual(len([line for line in block.splitlines() if line.strip()]), 12)
                role = role_of(path)
                for phrase in SHARED_MAXIMS:
                    self.assertIn(phrase, block)
                self.assertEqual("Trust, but verify" in block, role not in WORKER_ROLES)
                for phrase in COS_ONLY_MAXIMS:
                    self.assertEqual(phrase in block, role == "chief-of-staff", phrase)

    def test_the_maxims_come_before_the_rest_of_the_body(self):
        for path in AGENT_FILES:
            with self.subTest(file=path.name):
                headings = re.findall(r"^## (.*)$", path.read_text(), re.M)
                self.assertEqual(headings[0], "Maxims")

    def test_chief_of_staff_and_orchestrator_carry_the_rubric(self):
        for path in AGENT_FILES:
            text = path.read_text()
            with self.subTest(file=path.name):
                for phrase in RUBRIC:
                    self.assertEqual(phrase in text, role_of(path) not in WORKER_ROLES, phrase)

    def test_each_explains_a_switchboard_message_and_forbids_typing_into_a_pane(self):
        for path in AGENT_FILES:
            text = path.read_text()
            with self.subTest(file=path.name):
                self.assertIn("[switchboard]", text)
                self.assertIn("fleet-switchboard send", text)
                self.assertRegex(text, r"never by typing")
        for path in AGENT_FILES:
            if role_of(path) == "chief-of-staff":
                self.assertIn("Done when", path.read_text())

    def test_a_switchboard_wake_is_never_told_to_run_heartbeat_ack(self):
        """The trial found the Chief of Staff running `heartbeat-ack` after a [switchboard] wake, against a
        state directory that does not exist there. Only a `Heartbeat` message may send an agent to it."""
        for path in AGENT_FILES:
            if role_of(path) not in ("chief-of-staff", "orchestrator"):
                continue
            text = path.read_text()
            section = " ".join(text.split("## Wake protocol", 1)[1].split("\n## ", 1)[0].split())
            with self.subTest(file=path.name):
                self.assertIn("[switchboard]", section)
                self.assertIn("does not apply to you", section)
                self.assertIn("starting `Heartbeat`", section)
                self.assertNotIn("heartbeat-ack --pane", text, "no unconditional ack command in the role file")
                self.assertNotIn("You run under the heartbeat service", text)

    def test_the_role_files_keep_their_frontmatter_and_placeholders(self):
        for path in AGENT_FILES:
            text = path.read_text()
            with self.subTest(file=path.name):
                self.assertTrue(text.startswith("---\n"))
                self.assertRegex(text.split("\n---\n")[0], r"(?m)^name: %s$" % role_of(path))
                self.assertRegex(text, r"(?m)^model: __(PROVIDER__/__MODEL_ID|MODEL_ID)__$")

    def test_the_role_files_do_not_grow(self):
        for path in AGENT_FILES:
            text = path.read_text()
            role = role_of(path)
            with self.subTest(file=path.name):
                self.assertLessEqual(len(text.splitlines()), ROLE_LINE_LIMITS[role])
                self.assertLessEqual(len(text.encode("utf-8")), ROLE_BYTE_LIMITS[role])

    def test_the_skills_carry_the_ask_level(self):
        charter = (REPO / "skills" / "fleet-charter" / "SKILL.md").read_text()
        for phrase in ("## Intent", "Done when:", "ask", "work item", "never widen"):
            self.assertIn(phrase, charter, phrase)
        coordination = (REPO / "skills" / "fleet-coordination" / "SKILL.md").read_text()
        for phrase in ("ASK:", "fleet-switchboard intent"):
            self.assertIn(phrase, coordination, phrase)


class TestIntentScenarios(Base):
    def test_a_variant_may_patch_the_issues(self):
        i2 = sc.load(sc.DEFAULT_DIR / "i2-no-intent-recorded.json")
        patched = sc.apply_variant(i2, i2["control"]["variant"])
        self.assertEqual(patched["issues"]["2"]["intent"], "Add a health check")
        self.assertIsNone(i2["issues"]["2"]["intent"])
        with self.assertRaises(sc.VariantError):
            sc.apply_variant(i2, {"issues": {"2": {}}})

    def test_the_pr6_catalog_is_present(self):
        found = {s["id"]: s for s in map(sc.load, sc.scenario_files(sc.DEFAULT_DIR))}
        for sid, tiers in (("I1", {"offline", "lab-model"}), ("I2", {"offline"}),  # the Lab runner cannot yet play
                           ("I3", {"offline"}),  # `message_shows` and `edit-intent`
                           ("I4", {"lab-model"}),
                           ("K1", {"lab-model"}), ("K2", {"lab-model"})):
            with self.subTest(scenario=sid):
                self.assertIn(sid, found)
                self.assertEqual(set(found[sid]["tiers"]), tiers)
                self.assertEqual(found[sid]["since_pr"], 6)
        for sid in ("K1", "K2", "I4"):
            self.assertEqual(found[sid]["control"]["fault"], "no-maxims")
        self.assertEqual(found["I1"]["control"]["fault"], "no-intent-header")

    def test_i3_surfaces_the_change_and_its_control_does_not(self):
        report = run_scenario(self, sc.load(sc.DEFAULT_DIR / "i3-intent-edited.json"))
        self.assertEqual([r["label"] for r in report["control"] if r["ok"]], [])
        self.assertEqual(report["failures"], [])

    def test_the_offline_runner_does_not_pass_judged_off_as_a_control_failure(self):
        report = run_scenario(self, sc.load(sc.DEFAULT_DIR / "i1-report-carries-intent.json"))
        judged = [r for r in report["run"] if r["that"] == "judged"]
        self.assertEqual(len(judged), 1)
        self.assertIn("not evaluated offline", judged[0]["seen"])
        self.assertNotIn("flags-divergence", report["proves_nothing"])
