    def test_the_summary_and_exit_follow_the_enforced_gates_and_all_asks_for_the_whole_board(self):
        self.pr["body"] = "PLAN: acme/app#7"   # no canon line: G5 is open, and a repo need not enforce it
        self.all_proven()
        code, out, err = self.run_as("coder", "gates", self.PR)
        self.assertEqual(code, 1, "shadow or unlisted: the whole board, as before")
        self.assertIn("NOT READY", out)
        board = self.gates()[1]
        open_rows = [r["gate"] for r in board["gates"] if r["status"] in ("missing", "waiting")]
        self.assertTrue(open_rows, "this PR has a gate open that a repo may not enforce (G5 canon)")
        with mock.patch.object(sb, "enforced_gates_of", lambda ctx: ["G0a", "G1"]):
            code, out, err = self.run_as("coder", "gates", self.PR)
            self.assertEqual(code, 0, out)
            first = out.splitlines()[0]
            self.assertIn("READY for the enforced gates (G0a, G1); not enforced: ", first)
            self.assertIn("%s missing" % open_rows[0], first)
            self.assertEqual(self.run_as("coder", "gates", self.PR, "--all")[0], 1, "--all: the full board decides the exit")
            code, report, err = self.gates()
            self.assertEqual((code, report["enforced"], report["ready_enforced"], report["ready"]), (0, ["G0a", "G1"], True, False))
        with mock.patch.object(sb, "enforced_gates_of", lambda ctx: ["G0a", "G1", "G5"]):
            code, out, err = self.run_as("coder", "gates", self.PR)
            self.assertEqual(code, 1)
            self.assertIn("NOT READY for the enforced gates (G0a, G1, G5): open G5", out.splitlines()[0])

    def test_a_proof_missing_on_an_enforced_gate_is_not_ready_for_the_enforced_gates(self):
        with mock.patch.object(sb, "enforced_gates_of", lambda ctx: ["G0a", "G1"]):
