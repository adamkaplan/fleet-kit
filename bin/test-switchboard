    TIMEOUT_WRITES = ("timeout 5 gh secret set X --body view", "timeout 5 gh repo delete o/r view", "timeout 5 gh api repos/o/r/issues -X POST -f t=view",
                      "timeout 5 gh workflow run ci.yml --ref view", "timeout 5 gh pr merge 5 --body view")

    def test_az_reads_are_allowed_generally_and_every_secret_reading_or_writing_verb_stays_denied(self):
        for path in self.PATHS:
            with self.subTest(file=path.name):
                _, rules = self.parse(path)
                for command in self.AZ_READS + ("gh issue create --title x --body y", "fleet-switchboard disk", "fleet-switchboard disk janitor --apply",
                                                "timeout 30 gh pr view 5", "timeout 30 gh issue list --repo acme/api"):
                    self.assertEqual(self.evaluate(rules, "shell", command), "allow", command)
                for command in self.TIMEOUT_WRITES + ("fleet-switchboard disk prune --docker /bin/sh", "fleet-switchboard disk prune --docker=/bin/sh", "fleet-switchboard disk --docker /tmp/x report",
                                                      "fleet-switchboard disk reap-docker --apply --docker /tmp/x/docker", "fleet-switchboard disk report --docker=/bin/sh"):
                    self.assertEqual(self.evaluate(rules, "shell", command), "deny", command)
                for command in ("fleet-switchboard disk prune", "fleet-switchboard disk prune --dry-run", "fleet-switchboard disk report"):
                    self.assertEqual(self.evaluate(rules, "shell", command), "allow", command)
                for command in self.AZ_SECRETS + self.AZ_MORE_SECRETS:
                    self.assertEqual(self.evaluate(rules, "shell", command), "deny", command)
                    self.assertEqual(self.evaluate(rules, "shell", "timeout 30 " + command), "deny", "timeout 30 " + command)

    READ_ONLY_ADDED = ("fleet-switchboard review measure --since 7", "fleet-switchboard review laws acme/api#5", "fleet-switchboard impact floor acme/api#5 --json",
                       "fleet-switchboard impact hold --dry-run", "fleet-switchboard pr-explain acme/api#5 --check", "fleet-switchboard agents verify")

    def test_the_review_and_impact_reads_are_allowed_and_each_is_read_only_and_the_writes_next_to_them_are_not(self):
        """The cos list gains six read-only lines: review measure, review laws, impact floor, impact hold --dry-run, pr-explain and agents verify
        (`gates *`, `plan *` and `status *` were already there). Each prints and writes nothing. The write subcommands of the same words stay denied."""
        _, rules = self.rules()
        for command in self.READ_ONLY_ADDED:
            self.assertEqual(self.evaluate(rules, "shell", command), "allow", command)
        # no blanket `timeout ? fleet-switchboard *` any more: a write behind a timeout prefix is denied, like the bare one (the Chief of Staff needs no prefix)
        for command in ("timeout 30 fleet-switchboard review record acme/api#5 --reviewer code --block f", "timeout 30 fleet-switchboard impact clear acme/api#5 --reason x",
                        "timeout 30 fleet-switchboard verdict --all --pr acme/api#5", "timeout 5 fleet-switchboard send x y", "timeout 30 fleet-switchboard review laws acme/api#5"):
            self.assertEqual(self.evaluate(rules, "shell", command), "deny", command)
        for command in ("fleet-switchboard verdict --all --pr acme/api#5", "fleet-switchboard review record acme/api#5 --reviewer code --block f"):
            self.assertEqual(self.evaluate(rules, "shell", command), "deny", command)
        self.assertEqual(self.evaluate(rules, "shell", "fleet-switchboard review record acme/api#5 --reviewer code --block f"), "deny")
        self.assertEqual(self.evaluate(rules, "shell", "fleet-switchboard impact clear acme/api#5 --reason x"), "deny")
        self.assertEqual(self.evaluate(rules, "shell", "fleet-switchboard impact hold"), "deny")
        self.assertEqual(self.evaluate(rules, "shell", "fleet-switchboard agents install"), "deny")
        for gate in ("fleet-switchboard gates mode acme/app enforce", "timeout 30 fleet-switchboard gates mode acme/app ENFORCE", "fleet-switchboard gates on",
                     "timeout 5 fleet-switchboard waive acme/app#5 --gates G8 --reason x", "timeout 5 fleet-switchboard decisions batch --title x"):
            self.assertEqual(self.evaluate(rules, "shell", gate), "deny", gate)   # the collapsed denies still catch both the bare and the timeout forms

    def test_retire_is_allowed_for_the_chief_of_staff_and_every_write_next_to_it_stays_denied(self):
        _, rules = self.rules()
        for command in ("fleet-switchboard retire worker --reason done", "fleet-switchboard retire --undo worker", "fleet-switchboard retire worker"):
            self.assertEqual(self.evaluate(rules, "shell", command), "allow", command)
        for command in ("timeout 30 fleet-switchboard retire worker", "fleet-switchboard review record acme/api#5 --reviewer code --block f",
                        "fleet-switchboard impact clear acme/api#5 --reason x", "fleet-switchboard verdict --all --pr acme/api#5",
                        "herdr pane close w1:p1", "herdr tab close w1:t1", "fleet-switchboard gates mode acme/app enforce"):
            self.assertEqual(self.evaluate(rules, "shell", command), "deny", command)        # no raw herdr, and the other writes are as before
        for path in self.PATHS:
            _, lines, _ = self.block(path)
            self.assertLess(len(lines), self.MAX_BLOCK_LINES)

    def test_the_subagent_has_the_same_list_without_handoff_or_launch(self):
        _, rules = self.parse(self.PATHS[1])
        self.assertEqual(self.evaluate(rules, "shell", "fleet-switchboard send x y"), "allow")
        self.assertEqual(self.evaluate(rules, "shell", "fleet-switchboard handoff --issue 5"), "deny")
        self.assertEqual(self.evaluate(rules, "shell", "fleet-switchboard launch v --agent orchestrator"), "deny")
        for command in ("fleet-switchboard reattach x", "fleet-switchboard relaunch x", "fleet-switchboard retire x"):
            self.assertEqual(self.evaluate(rules, "shell", command), "deny", command)
        self.assertEqual(self.evaluate(rules, "shell", "make build"), "deny")

    def test_the_prose_matches_the_rules(self):
        text = self.PATH.read_text()
        self.assertIn("I don't have a problem with you using gh to write comments or close/merge PRs", text)
        self.assertIn("route the work to the owning orchestrator", text)
        self.assertIn("keeps you **focused on your job**", text)
        self.assertNotIn("never merge,", text)
        self.assertNotIn("ASKS your principal", text)  # one story: a denial is hard and nothing asks


class TestCosTriageAllowRule(unittest.TestCase):
    """The Chief of Staff definitions allow `fleet-switchboard triage *` with one rule each, and no other switchboard allow rule is added."""
    FILES = ("agents/opencode/chief-of-staff.md", "agents/opencode/cos-subagent.md")
    RULE = '  - {action: shell, resource: "fleet-switchboard triage *", effect: allow}'

    def _lines(self, rel):
        return (REPO / rel).read_text().splitlines()

    def test_each_file_carries_exactly_one_triage_allow_rule_and_no_deny_or_wider_rule(self):
        for rel in self.FILES:
            with self.subTest(file=rel):
                lines = self._lines(rel)
                self.assertEqual(lines.count(self.RULE), 1)
                triage = [l for l in lines if "fleet-switchboard triage" in l and l.lstrip().startswith("- {action:")]
                self.assertEqual(triage, [self.RULE])  # no second triage rule, no deny, no variant
                for l in lines:  # fail closed: nothing allows the whole command or a wildcard prefix
                    if l.lstrip().startswith("- {action: shell") and "effect: allow" in l:
                        self.assertNotRegex(l, r'resource: "fleet-switchboard \*"')
                        self.assertNotRegex(l, r'resource: "\*+fleet-switchboard')

    def test_the_switchboard_allow_rules_are_the_fixed_old_list_plus_triage_move_reassign(self):
        old = {
            "chief-of-staff.md": "send report remind intent intents status pending whoami notice decisions orders gates waive plan labels handoff launch reattach relaunch retire disk".split(),
            "cos-subagent.md": "send report remind intent intents status disk pending whoami version notice decisions orders gates waive plan labels".split(),
        }
        for rel in self.FILES:
            with self.subTest(file=rel):
                got = [m.group(1) for l in self._lines(rel) for m in [re.match(r'  - \{action: shell, resource: "fleet-switchboard ([a-z]+) \*", effect: allow\}$', l)] if m]
                self.assertEqual(sorted(got), sorted(old[rel.split("/")[-1]] + ["triage", "move", "reassign"]))


class TestCosDelegatedClearPermission(unittest.TestCase):
    """Ask #720: the Chief of Staff definition allows the delegated clear (`impact clear * --under-order *`) and no other impact command beyond the
    two read-only ones. The copilot definition has no per-command list (a `tools:` allow-list and prose), so the line is only in the opencode one."""
    RULE = '  - {action: shell, resource: "fleet-switchboard impact clear * --under-order *", effect: allow}'
    PATH = REPO / "agents" / "opencode" / "chief-of-staff.md"

    def test_S1_the_line_once_and_the_other_impact_permissions_are_the_two_read_only_ones(self):
        lines = self.PATH.read_text().splitlines()
        self.assertEqual(lines.count(self.RULE), 1)
        others = [l for l in lines if l.lstrip().startswith("- {action: shell") and "fleet-switchboard impact " in l and l != self.RULE]
        self.assertEqual(others, ['  - {action: shell, resource: "fleet-switchboard impact floor *", effect: allow}',
                                  '  - {action: shell, resource: "fleet-switchboard impact hold --dry-run*", effect: allow}'])

    def test_S1_the_copilot_definition_names_no_impact_command(self):
        text = (REPO / "agents" / "copilot" / "chief-of-staff.agent.md").read_text()
        self.assertNotIn("fleet-switchboard impact", text)
        self.assertNotIn("--under-order", text)

    def test_S2_last_match_wins_allows_only_the_delegated_clear(self):
        _, rules = TestChiefOfStaffNativePermissions.parse(self.PATH)
        verdicts = [TestChiefOfStaffNativePermissions.evaluate(rules, "shell", c) for c in (
            "fleet-switchboard impact clear 5 --reason why",
            "fleet-switchboard impact clear 5 --reason why --under-order 1",
            "fleet-switchboard impact waive 5")]
        self.assertEqual(verdicts, ["deny", "allow", "deny"])


class TestVerdictRecordingText(unittest.TestCase):
    """The reviewer and tester roles record their verdict in ONE command as the last step of the review they already do (text only)."""
    ONE = 'fleet-switchboard verdict --all --pr <repo#N> --as reviewer|tester --result pass|fail --head <full head sha> --evidence'

    def test_the_skill_and_the_coder_definitions_say_the_one_command_and_the_per_scenario_fallback(self):
        for rel in ("skills/fleet-coordination/SKILL.md", "agents/opencode/coder.md", "agents/copilot/coder.agent.md"):
            with self.subTest(file=rel):
                text = " ".join((REPO / rel).read_text().split())
                self.assertIn(self.ONE, text)
                self.assertIn("per-scenario form" if "SKILL" in rel else "until it is merged, record each scenario", text)
                self.assertIn("A push voids it", text)
                self.assertIn("fleet-switchboard verdict <scenario> --pr <repo#N> --as reviewer|tester --result pass|fail --head <full head sha>", text)  # the spelled-out fallback
                self.assertIn("Never record a verdict on a PR you wrote", text)

    def test_the_orchestrator_definitions_point_at_it_and_the_planning_skill_says_owner_evaluators_are_rare(self):
        for rel in ("agents/opencode/orchestrator.md", "agents/copilot/orchestrator.agent.md"):
            with self.subTest(file=rel):
                self.assertIn("Reviewers and testers record their verdicts when they finish", (REPO / rel).read_text())
        planning = " ".join((REPO / "skills" / "fleet-planning" / "SKILL.md").read_text().split())
        self.assertIn("Owner evaluators are rare", planning)
        self.assertIn("a coder's only extra step is `prove`", planning)


class TestChatClearOffers(unittest.TestCase):
    """#457 slice 1: the offers, the person's messages and the checks no model can waive. Fixtures only: nothing here touches a real PR."""

    NAMES = {"merge-captain": "u:merge-captain", "hold-impact": "u:hold-impact", "hold-credential": "u:hold-credential",
             "hold-policy": "u:hold-policy", "hold-security": "u:hold-security", "hold-contract": "u:hold-contract",
             "hold-prod-config": "u:hold-prod-config", "hold-other-area": "u:hold-other-area", "hold-owner": "u:hold-owner", "parked": "u:parked"}

    def setUp(self):
        self.cc = sb.load_module("chat_clear")
        self.tmp = tempfile.TemporaryDirectory()
        self.addCleanup(self.tmp.cleanup)
        self.state = self.tmp.name

    def hold(self, number, labels, head="a" * 40, repo="acme/widget", summary="touches the gate"):
        return {"pr": "%s#%d" % (repo, number), "head": head, "labels": labels, "summary": summary}

    def offers(self, *numbers, head="a" * 40):
        holds = [self.hold(n, ["u:hold-impact"], head=head) for n in numbers]
        return self.cc.refresh_offers(self.state, holds, self.NAMES, 1000)["offers"]

    def test_the_owner_tier_labels_are_offered_however_they_were_put_on_and_other_holds_and_parked_are_not(self):
        for labels in (["u:hold-impact"], ["u:hold-credential"], ["u:hold-policy"], ["u:merge-captain"],
                       [{"name": "u:hold-credential"}, {"name": "u:parked"}]):
            self.assertTrue(self.cc.is_offerable(self.NAMES, labels), labels)
        for labels in (["u:parked"], [], ["u:hold-impact", "u:hold-security"], ["u:merge-captain", "u:hold-prod-config"], ["bug"]):
            self.assertFalse(self.cc.is_offerable(self.NAMES, labels), labels)
        self.assertEqual(self.cc.owner_tier_labels(self.NAMES, ["u:parked", "u:hold-credential", "u:merge-captain"]),
                         ["u:hold-credential", "u:merge-captain"], "only owner-tier labels, never parked")

    def test_an_offer_keeps_the_head_he_was_shown_until_a_question_shows_him_the_new_one(self):
        self.offers(366)
        refreshed = self.cc.refresh_offers(self.state, [self.hold(366, ["u:hold-impact"], head="b" * 40)], self.NAMES, 2000)
        self.assertEqual(refreshed["offers"]["acme/widget#366"]["head"], "a" * 40, "a push does not change what he was shown")
        self.assertEqual(refreshed["added"], [])
        offer = self.cc.read_offers(self.state)["acme/widget#366"]
        self.assertFalse(self.cc.head_matches(offer, "b" * 40), "a push after the offer clears nothing")
        self.assertTrue(self.cc.head_matches(offer, "a" * 40))
        self.assertTrue(self.cc.show(self.state, "acme/widget#366", "b" * 40, 3000))
        self.assertTrue(self.cc.head_matches(self.cc.read_offers(self.state)["acme/widget#366"], "b" * 40))
        self.assertFalse(self.cc.show(self.state, "acme/widget#999", "b" * 40, 3000), "no offer, nothing moved")

    def test_a_pr_that_is_no_longer_held_loses_its_offer_and_an_unchanged_set_writes_nothing(self):
        self.offers(366, 389)
        path = Path(self.state) / "chat-clear-offers.json"
        writes = []
        real = self.cc.write_offers
        self.cc.write_offers = lambda *a, **k: writes.append(a) or real(*a, **k)
        self.addCleanup(setattr, self.cc, "write_offers", real)
        same = self.cc.refresh_offers(self.state, [self.hold(366, ["u:hold-impact"]), self.hold(389, ["u:hold-impact"])], self.NAMES, 1001)
        self.assertEqual((same["added"], same["dropped"]), ([], []))
        self.assertEqual(writes, [], "nothing changed: write_offers was not called")
        gone = self.cc.refresh_offers(self.state, [self.hold(389, ["u:hold-impact"]), self.hold(400, ["u:parked"])], self.NAMES, 1002)
        self.assertEqual(sorted(gone["offers"]), ["acme/widget#389"])
        self.assertEqual(gone["dropped"], ["acme/widget#366"])
        self.assertEqual(oct(path.stat().st_mode & 0o777), "0o600")

    def entry(self, **kw):
        return dict({"head": "a" * 40, "shown": True, "shown_at": 1000, "labels": ["u:hold-impact"], "summary": "s"}, **kw)

    def test_an_unreadable_or_oversized_offers_file_offers_nothing_and_a_bad_entry_is_dropped_alone(self):
        path = Path(self.state) / "chat-clear-offers.json"
        path.write_text("{not json")
        self.assertEqual(self.cc.read_offers(self.state), {})
        path.write_text(json.dumps({"offers": {"bad key": self.entry(), "acme/widget#1": self.entry(head=""), "acme/widget#2": self.entry()}}))
        self.assertEqual(sorted(self.cc.read_offers(self.state)), ["acme/widget#2"])
        path.write_text(" " * (self.cc.OFFERS_MAX_BYTES + 1))
        self.assertEqual(self.cc.read_offers(self.state), {})
        self.assertEqual(self.cc.read_offers(Path(self.state) / "nowhere"), {})

    def test_a_damaged_entry_is_dropped_never_defaulted_to_shown_and_never_touches_the_others(self):
        path = Path(self.state) / "chat-clear-offers.json"
        bad = {"no_shown": {k: v for k, v in self.entry().items() if k != "shown"}, "shown_str": self.entry(shown="true"), "shown_one": self.entry(shown=1),
               "shown_null": self.entry(shown=None), "no_at": {k: v for k, v in self.entry().items() if k != "shown_at"}, "at_str": self.entry(shown_at="1000"),
               "at_neg": self.entry(shown_at=-1), "at_bool": self.entry(shown_at=True), "labels_str": self.entry(labels="u:hold-impact"),
               "labels_mixed": self.entry(labels=["u:hold-impact", 5]), "no_summary": {k: v for k, v in self.entry().items() if k != "summary"},
               "summary_int": self.entry(summary=5), "head_int": self.entry(head=5), "not_dict": "x"}
        entries = {"acme/widget#%d" % (100 + n): v for n, v in enumerate(bad.values())}
        entries["acme/widget#1"] = self.entry()
        entries["acme/widget#2"] = self.entry(shown=False)
        path.write_text(json.dumps({"offers": entries}))
        loaded = self.cc.read_offers(self.state)
        self.assertEqual(sorted(loaded), ["acme/widget#1", "acme/widget#2"], "every damaged entry is dropped, the 2 whole ones are kept as they were")
        self.assertIs(loaded["acme/widget#2"]["shown"], False)
        refreshed = self.cc.refresh_offers(self.state, [self.hold(100, ["u:hold-impact"], head="c" * 40), self.hold(1, ["u:hold-impact"])], self.NAMES, 2000)
        self.assertIs(refreshed["offers"]["acme/widget#100"]["shown"], False, "a PR whose entry was damaged is recorded again as NOT shown")
        self.assertIs(refreshed["offers"]["acme/widget#1"]["shown"], True, "a whole entry beside the damaged ones keeps what it was")
        self.assertEqual(len(refreshed["damaged"]), len(bad))
        for n, shape in enumerate(bad):   # every damaged shape, held again, comes back as NOT shown
            path.write_text(json.dumps({"offers": {"acme/widget#%d" % (300 + n): bad[shape]}}))
            again = self.cc.refresh_offers(self.state, [self.hold(300 + n, ["u:hold-impact"])], self.NAMES, 3000 + n)
            self.assertIs(again["offers"]["acme/widget#%d" % (300 + n)]["shown"], False, shape)
        path.write_text(json.dumps({"offers": {"acme/widget#1": self.entry(), "acme/widget#2": self.entry(shown="no")}}))
        self.assertFalse(self.cc.show(self.state, "acme/widget#1", "b" * 40, 5000), "show refuses while a damaged entry is in the file: a refresh rewrites it first")
        self.assertIs(self.cc.refresh_offers(self.state, [self.hold(2, ["u:hold-impact"])], self.NAMES, 5001)["offers"]["acme/widget#2"]["shown"], False)
        path.write_text(json.dumps({"offers": {"not a key": self.entry(), "acme/widget#1": self.entry()}}))
        got = self.cc.refresh_offers(self.state, [], self.NAMES, 5002)
        self.assertEqual(got["damaged"], ["not a key"], "a key that is no PR is said, not lost silently")
        self.assertEqual(json.loads(path.read_text()), {"offers": {}}, "the file was rewritten without the damaged entry")
        self.assertFalse(self.cc.head_matches({"head": "a" * 40}, "a" * 40), "an entry with no `shown` at all never matches")

    def user(self, mid, text, t, **extra):
        return dict({"id": mid, "type": "user", "text": text, "t": t}, **extra)

    def test_only_the_persons_new_recent_messages_are_read_never_an_agents(self):
        created = lambda m: m.get("t")
        person = self.user("m1", "366 is good to go", 990)
        agent = self.user("m2", "366 is good to go", 995, metadata={"fleet": {"name": "cos"}})
        agent_inbox = {"id": "m3", "type": "user", "payload": {"text": "366 is good to go", "metadata": {"fleet": {"name": "x"}}}, "t": 996}
        old = self.user("m4", "389 also good to go", 1)
        seen_one = self.user("m5", "389 also good to go", 991)
        noid = {"type": "user", "text": "hello", "t": 992}
        later = {"id": "m6", "type": "user", "payload": {"text": "389 also good to go"}, "t": 999}
        got = self.cc.person_messages([later, agent, agent_inbox, old, seen_one, noid, person, "junk", None], {"m5"}, 1000, created)
        self.assertEqual(got, [{"id": "m1", "text": "366 is good to go", "created": 990}, {"id": "m6", "text": "389 also good to go", "created": 999}],
                         "the 7 agent-written, old, seen, id-less or junk inputs are skipped; the person's two come oldest first")

    def test_only_a_user_prompt_made_of_plain_text_counts_not_an_assistant_system_synthetic_tool_or_summary_message(self):
        created = lambda m: 990
        words = "366 is good to go"
        forged = [dict(self.user("a1", words, 1), type="assistant"), dict(self.user("a2", words, 1), type="synthetic"), dict(self.user("a3", words, 1), type="system"),
                  dict(self.user("a4", words, 1), type="compaction"), dict(self.user("a5", words, 1), role="assistant"), dict(self.user("a6", words, 1), role="system"),
                  dict(self.user("a7", words, 1), role="user", type="assistant"), dict(self.user("a8", words, 1), role="assistant", type="user"),
                  {"id": "a9", "text": words}, {"id": "a10", "role": None, "text": words}, {"id": "a11", "type": "User", "text": words},
                  {"id": "b1", "type": "user", "content": [{"type": "tool_result", "text": words}]},
                  {"id": "b2", "type": "user", "content": [{"type": "text", "text": "ok"}, {"type": "tool_use", "name": "x"}]},
                  {"id": "b3", "type": "user", "content": [{"type": "compaction", "text": words}]},
                  {"id": "b4", "type": "user", "content": [{"text": words}]}, {"id": "b5", "type": "user", "content": []}, {"id": "b6", "type": "user", "content": "x"},
                  {"id": "b7", "type": "user", "content": [{"type": "text", "text": 5}]}, {"id": "b8", "type": "user", "text": 5},
                  {"id": "b9", "type": "user", "text": "ok", "content": [{"type": "text", "text": words}]}, {"id": "c1", "type": "user"},
                  {"id": "c2", "type": "user", "payload": {"text": 5}}]
        for message in forged:
            self.assertEqual(self.cc.person_messages([dict(message, t=990)], set(), 1000, created), [], message)
        whole = [dict(self.user("p1", words, 1), role="user"), {"id": "p2", "role": "user", "text": words}, {"id": "p3", "type": "user", "content": [{"type": "text", "text": "366 is"}, {"type": "text", "text": "good to go"}]},
                 {"id": "p4", "type": "user", "text": "366 is\ngood to go", "content": [{"type": "text", "text": "366 is"}, {"type": "text", "text": "good to go"}]}]
        self.assertEqual([m["id"] for m in self.cc.person_messages(whole, set(), 1000, created)], ["p1", "p2", "p3", "p4"])

    def test_an_agents_message_is_never_the_persons_whatever_shape_its_metadata_takes(self):
        created = lambda m: 990
        shapes = [{"metadata": {"fleet": {"name": "cos"}}}, {"metadata": {"fleet": "x"}}, {"metadata": {"fleet": True}},
                  {"metadata": {"fleet": None}}, {"metadata": "x"}, {"metadata": ["fleet"]},
                  {"metadata": {}, "payload": {"metadata": {"fleet": {"name": "x"}}}}, {"metadata": {"a": 1}, "payload": {"metadata": {"fleet": 1}}},
                  {"payload": "x"}, {"payload": {"metadata": "x"}}]
        for n, shape in enumerate(shapes):
            message = dict(shape, id="a%d" % n, type="user", text="366 is good to go")
            self.assertEqual(self.cc.person_messages([message], set(), 1000, created), [], shape)
        person = [self.user("p1", "366", 1), self.user("p2", "366", 1, metadata={}), self.user("p3", "366", 1, metadata={"a": 1}, payload={"metadata": {}})]
        self.assertEqual([m["id"] for m in self.cc.person_messages(person, set(), 1000, created)], ["p1", "p2", "p3"])

    def test_the_age_the_future_the_cap_and_the_text_length_of_messages(self):
        times = {"edge": 100, "over": 99, "ahead": 1060, "farahead": 1061, "none": None, "str": "100", "nan": float("nan"), "bool": True}
        created = lambda m: times.get(m["id"], 1000)
        ids = lambda prompts: [m["id"] for m in self.cc.person_messages(prompts, set(), 1000, created, max_age=900)]
        self.assertEqual(ids([{"id": k, "type": "user", "text": "x"} for k in times]), ["edge", "ahead"], "exactly max_age old is read, one second older and a time too far ahead are not, no time or a non-number is not")
        long = {"id": "long", "type": "user", "content": [{"type": "text", "text": "a" * 5000}, {"type": "text", "text": "b"}]}
        self.assertEqual(len(self.cc.person_messages([long], set(), 1000, created)[0]["text"]), self.cc.TEXT_MAX)
        many = [{"id": "m%d" % n, "type": "user", "text": "x"} for n in range(80)]
        self.assertEqual(len(self.cc.person_messages(many, set(), 1000, created)), self.cc.MESSAGES_SCANNED)

    def test_at_most_offers_max_offers_the_existing_ones_first_and_the_summary_is_cut_and_clean(self):
        self.offers(7)
        holds = [self.hold(n, ["u:hold-impact"]) for n in range(100, 100 + self.cc.OFFERS_MAX + 1)] + [self.hold(7, ["u:hold-impact"])]
        got = self.cc.refresh_offers(self.state, holds, self.NAMES, 1005)
        self.assertEqual(len(got["offers"]), self.cc.OFFERS_MAX)
        self.assertTrue(got["capped"])
        self.assertIn("acme/widget#7", got["offers"], "an offer that already existed is kept before a new one is taken")
        long = self.cc.refresh_offers(self.state, [self.hold(1, ["u:hold-impact"], summary="x\x1b[31m" + "ab " * 200 + "\n")], self.NAMES, 1006)["offers"]["acme/widget#1"]["summary"]
        self.assertEqual(len(long), self.cc.SUMMARY_MAX)
        self.assertNotIn("\x1b", long)

    def test_head_matches_refuses_what_is_not_a_shown_exact_head(self):
        offer = {"head": "a" * 40, "shown": True}
        self.assertTrue(self.cc.head_matches(offer, "a" * 40))
        for current in (None, "", 5, "b" * 40):
            self.assertFalse(self.cc.head_matches(offer, current), repr(current))
        for bad in (None, "x", {"head": "a" * 40, "shown": False}, {"head": "a" * 40, "shown": "yes"}):
            self.assertFalse(self.cc.head_matches(bad, "a" * 40), repr(bad))

    def test_a_file_that_cannot_be_used_is_set_aside_and_what_is_recorded_after_it_is_not_clearable_until_shown(self):
        path = Path(self.state) / "chat-clear-offers.json"
        path.write_text("{not json")
        got = self.cc.refresh_offers(self.state, [self.hold(366, ["u:hold-impact"])], self.NAMES, 1000)
        self.assertIn("cannot be read", got["problem"])
        self.assertEqual(got["quarantined"], "chat-clear-offers.json.corrupt-1000")
        self.assertEqual((Path(self.state) / got["quarantined"]).read_text(), "{not json", "the bad file is kept, never overwritten")
        offer = got["offers"]["acme/widget#366"]
        self.assertFalse(offer["shown"])
        self.assertFalse(self.cc.head_matches(offer, "a" * 40), "recorded after a loss and never shown: nothing clears")
        self.assertTrue(self.cc.show(self.state, "acme/widget#366", "a" * 40, 1001))
        self.assertTrue(self.cc.head_matches(self.cc.read_offers(self.state)["acme/widget#366"], "a" * 40))

    def test_a_missing_label_name_makes_a_pr_not_offerable_and_a_lock_held_elsewhere_changes_nothing(self):
        names = {k: v for k, v in self.NAMES.items() if k != "hold-contract"}
        self.assertFalse(self.cc.is_offerable(names, ["u:hold-impact"]), "a hold it cannot name is a hold it cannot see")
        self.offers(366)
        with self.cc._locked(self.state):
            with self.assertRaises(self.cc.OffersBusy):
                self.cc.refresh_offers(self.state, [], self.NAMES, 2000, lock_seconds=0)
            with self.assertRaises(self.cc.OffersBusy):
                self.cc.show(self.state, "acme/widget#366", "b" * 40, 2000, lock_seconds=0)
        self.assertEqual(self.cc.read_offers(self.state)["acme/widget#366"]["head"], "a" * 40, "a busy lock changed nothing")

    def test_a_failed_write_leaves_no_temporary_file_and_the_old_offers(self):
        self.offers(366)
        real = os.replace
        def boom(*a):
            raise OSError("disk full")
        os.replace = boom
        try:
            with self.assertRaises(OSError):
                self.cc.write_offers(self.state, {})
        finally:
            os.replace = real
        self.assertEqual(sorted(p.name for p in Path(self.state).iterdir() if p.name.startswith("chat-clear-offers.json.")), [])
        self.assertIn("acme/widget#366", self.cc.read_offers(self.state))

    def test_a_hold_that_gains_another_hold_label_loses_its_offer_and_a_malformed_hold_is_skipped(self):
        self.offers(366)
        got = self.cc.refresh_offers(self.state, [self.hold(366, ["u:hold-impact", "u:hold-security"]), {"pr": None, "head": "a", "labels": ["u:hold-impact"]},
                                                  {"pr": "acme/widget#5", "head": 7, "labels": ["u:hold-impact"]}, {"head": "a"}], self.NAMES, 1010)
        self.assertEqual((got["offers"], got["dropped"]), ({}, ["acme/widget#366"]))
        path = Path(self.state) / "chat-clear-offers.json"
        asides = set()
        for body in (" " * (self.cc.OFFERS_MAX_BYTES + 1), json.dumps([1]), json.dumps({"offers": 5})):
            path.write_text(body)
            got = self.cc.refresh_offers(self.state, [], self.NAMES, 1011)
            self.assertTrue(got["problem"] and got["quarantined"], body[:10])
            self.assertTrue(got["quarantined"].startswith("chat-clear-offers.json.corrupt-1011"))
            asides.add(got["quarantined"])
            self.assertFalse(path.exists(), "the unusable file was set aside, not rewritten in place")
        self.assertEqual(len(asides), 3, "three unusable files, three distinct aside names")

    def test_a_non_ascii_summary_is_kept_whole(self):
        got = self.cc.refresh_offers(self.state, [self.hold(1, ["u:hold-impact"], summary="caf\u00e9 \u2014 gate")], self.NAMES, 1)
        self.assertEqual(got["offers"]["acme/widget#1"]["summary"], "caf\u00e9 \u2014 gate")
        self.assertEqual(self.cc.read_offers(self.state)["acme/widget#1"]["summary"], "caf\u00e9 \u2014 gate")
        self.assertIn("caf\u00e9".encode("utf-8"), (Path(self.state) / "chat-clear-offers.json").read_bytes(), "written as UTF-8, not escaped")
        lone = self.cc.refresh_offers(self.state, [self.hold(2, ["u:hold-impact"], summary="bad \ud800 text")], self.NAMES, 2)
        self.assertEqual(lone["offers"]["acme/widget#2"]["summary"], "bad ? text", "a lone surrogate never stops a refresh")
        twice = self.cc.refresh_offers(self.state, [self.hold(3, ["u:hold-impact"], head="a" * 40), self.hold(3, ["u:hold-impact"], head="b" * 40)], self.NAMES, 3)
        self.assertEqual((twice["added"], twice["offers"]["acme/widget#3"]["head"]), (["acme/widget#3"], "a" * 40), "a PR twice in one read is offered once")

    def test_every_run_of_digits_is_a_number_however_it_is_joined_and_one_message_names_one(self):
        n = self.cc.numbers_in
        self.assertEqual(n("366 is good to go"), [366])
        self.assertEqual(n("#389 also good to go"), [389])
        self.assertEqual(n("366 and 389, 366 again"), [366, 389])
        self.assertEqual(n("the launchd one is good to go"), [])
        self.assertEqual(n("all impacts cleared"), [])
        for joined in ("366-367", "366/367", "366,367", "366, 367", "366..367", "366...367", "366+367", "366&367", "366 and 367", "366 & 367", "#366 #367", "366;367", "366_367", "366 to 367", "366\u2013367"):
            self.assertEqual(n(joined), [366, 367], joined)
        self.assertEqual(n("0.97 sure, v2.0.28"), [0, 97, 2, 28], "digits inside decimals and versions are numbers too: it fails toward asking")
        self.assertEqual(n("\u0663\u0666\u0666 and \uff13\uff16\uff16"), [], "only ASCII digits are digits")
        self.assertLessEqual(len(str(max(n("9" * 5000 + " 1")))), self.cc.TEXT_MAX, "a huge digit run never raises and is cut at the text cap")

    def test_the_screen_never_lets_a_judge_widen_what_the_message_and_the_offers_say(self):
        offers = self.offers(366, 389, 400)    # shown at 1000
        sc = lambda text, o=offers, created=1001, now=1002: self.cc.screen(text, o, created, now)
        self.assertEqual(sc("366 is good to go"), {"verdict": "candidate", "pr": "acme/widget#366"})
        self.assertEqual(sc("366 is good to go.")["verdict"], "candidate", "a full stop after the number is fine")
        self.assertEqual(sc("#366 is good to go")["verdict"], "candidate")
        for text, why in (("all impacts cleared", "no_number"), ("the launchd one is good to go", "no_number"), ("366 and 389 are good to go", "several_numbers"),
                          ("366-367 are good to go", "several_numbers"), ("366/367 are good to go", "several_numbers"), ("366, 389 good to go", "several_numbers"),
                          ("366..389 good to go", "several_numbers"), ("366+389 good to go", "several_numbers"), ("366&389 good to go", "several_numbers"),
                          ("abc366 is good to go", "unclear_number"), ("366abc is good to go", "unclear_number"), ("366_ is good to go", "unclear_number"),
                          ("_366 is good to go", "unclear_number"), ("0366 is good to go", "unclear_number"), ("3.66 is good to go", "several_numbers"),
                          ("v366.1 is good to go", "several_numbers"), ("500 is good to go", "not_offered")):
            got = sc(text)
            self.assertEqual((got["verdict"], got["why"]), ("question", why), text)
        self.assertEqual(sc("366 is good to go", {})["why"], "no_offers")
        twice = {"acme/widget#366": self.entry(), "acme/other#366": self.entry(head="b" * 40)}
        got = sc("366 is good to go", twice)
        self.assertEqual((got["why"], got["prs"]), ("ambiguous_number", ["acme/other#366", "acme/widget#366"]))

    def test_a_message_that_reaches_the_text_cap_is_a_question_whatever_it_says_and_odd_text_is_no_number(self):
        offers = self.offers(366)
        for text in ("9" * 5000 + " is good to go", "366 is good to go" + " " * self.cc.TEXT_MAX + "389", "366 is good to go" + " " * (self.cc.TEXT_MAX - len("366 is good to go"))):
            self.assertEqual(self.cc.screen(text, offers, 1001, 1002)["why"], "too_long", len(text))
        under = "366 is good to go" + " " * (self.cc.TEXT_MAX - len("366 is good to go") - 1)
        self.assertEqual(len(under), self.cc.TEXT_MAX - 1)
        self.assertEqual(self.cc.screen(under, offers, 1001, 1002)["verdict"], "candidate", "one under the cap is read whole")
        self.assertEqual(self.cc.screen("9" * (self.cc.TEXT_MAX - 1), offers, 1001, 1002)["why"], "not_offered", "a long digit run under the cap is one number, never an error")
        self.assertEqual(self.cc.screen(None, offers, 1001, 1002)["why"], "no_number")
        self.assertEqual(self.cc.screen(5, offers, 1001, 1002)["why"], "no_number")

    def test_a_key_with_a_trailing_newline_is_no_pr_and_entries_past_the_cap_come_back_not_shown(self):
        path = Path(self.state) / "chat-clear-offers.json"
        path.write_text(json.dumps({"offers": {"acme/widget#1\n": self.entry(), "acme/widget#2": self.entry()}}))
        loaded, problem, damaged = self.cc._load(self.state)
        self.assertEqual(sorted(loaded), ["acme/widget#2"])
        self.assertEqual(damaged, {"acme/widget#1\n"}, "the key with the newline is said, not lost")
        extra = self.cc.OFFERS_MAX + 2
        many = {"acme/widget#%d" % n: self.entry() for n in range(1, extra + 1)}
        path.write_text(json.dumps({"offers": many}))
        loaded, problem, damaged = self.cc._load(self.state)
        self.assertEqual(sorted(loaded), sorted("acme/widget#%d" % n for n in range(1, self.cc.OFFERS_MAX + 1)), "the first OFFERS_MAX in file order are kept")
        self.assertEqual(damaged, {"acme/widget#%d" % n for n in range(self.cc.OFFERS_MAX + 1, extra + 1)}, "the 2 past the cap are said, not silently lost")
        first = "acme/widget#%d" % (self.cc.OFFERS_MAX + 1)
        got = self.cc.refresh_offers(self.state, [self.hold(self.cc.OFFERS_MAX + 1, ["u:hold-impact"])], self.NAMES, 9000)
        self.assertEqual(list(got["offers"]), [first])
        self.assertIs(got["offers"][first]["shown"], False, "a PR that was past the cap and is held alone is recorded as NOT shown")
        self.assertEqual(got["damaged"], sorted(damaged))

    def test_a_message_counts_only_if_it_was_written_after_the_offer_was_shown_and_an_offer_expires(self):
        offers = self.offers(366)   # shown_at 1000
        sc = lambda created, now: self.cc.screen("366 is good to go", offers, created, now)
        self.assertEqual(sc(999, 1100)["why"], "before_offer", "written before the offer was shown")
        self.assertEqual(sc(1000, 1100)["why"], "before_offer", "the same second: refused")
        self.assertEqual(sc(1001, 1100)["verdict"], "candidate", "one second after: counts")
        last = 1000 + self.cc.OFFER_TTL
        self.assertEqual(sc(1001, last)["verdict"], "candidate", "exactly the lifetime old: still counts")
        self.assertEqual(sc(1001, last + 1)["why"], "expired")
        for bad in (None, "1001", float("nan"), True):
            self.assertEqual(sc(bad, 1100)["why"], "no_time", repr(bad))
        self.assertEqual(self.cc.screen("366 is good to go", offers, 1001, None)["why"], "no_time")
        self.assertEqual(sc(1000 + self.cc.MESSAGE_SKEW + 101, 1100)["why"], "no_time", "a message from the future")
        self.assertEqual(self.cc.screen("366 is good to go", {"acme/widget#366": self.entry(shown_at=2000)}, 2001, 1000)["why"], "no_time", "an offer shown in the future")
        for bad in ({"head": "a" * 40}, {"head": "a" * 40, "shown_at": "1000"}, {"head": "a" * 40, "shown_at": 1.5}):
            self.assertEqual(self.cc.screen("366 is good to go", {"acme/widget#366": bad}, 1001, 1100)["why"], "no_time", bad)
        self.cc.show(self.state, "acme/widget#366", "a" * 40, 5000)   # shown again at 5000: an older message no longer counts
        again = self.cc.read_offers(self.state)
        self.assertEqual(self.cc.screen("366 is good to go", again, 4000, 5100)["why"], "before_offer")
        self.assertEqual(self.cc.screen("366 is good to go", again, 5001, 5100)["verdict"], "candidate")

    def test_this_module_has_no_command_and_no_caller_in_the_cli_and_writes_no_label(self):
        source = (Path(sb.__file__).parent / "chat_clear.py").read_text()
        for word in ("subprocess", "urllib", "socket", "change_issue_labels"):
            self.assertNotIn(word, source, "slice 1 reaches nothing: no process, no network, no GitHub write")
        import ast
        main = (Path(sb.__file__).parent / "fleet-switchboard").read_text()
        for fn in [n for n in ast.walk(ast.parse(main)) if isinstance(n, ast.FunctionDef) and n.name.startswith("cmd_")]:
            self.assertNotIn("chat_clear", ast.get_source_segment(main, fn), "%s: no command reaches the chat clear (slice 3's hook is the daemon's alone; TestChatClearHook S7 counts the call sites)" % fn.name)


class _StubJev:
    """A judge that answers from a table: {option: probability} for the options the question offers (the rest 0); counts its calls."""

    def __init__(self, picks=None, error=None, junk=None):
        self.picks, self.error, self.junk, self.calls = picks or {}, error, junk, []

    def decide(self, state, questions):
        self.calls.append((state, questions))
        if self.error is not None:
            raise self.error
        criteria = questions["clears"]["criteria"]
        if self.junk is not None:
            return {"model": "m", "answers": {"clears": self.junk}, "usage": {}, "latency_ms": 1}
        probabilities = {option: self.picks.get(option, 0.0) for option in criteria}
        probabilities.setdefault("nothing", 0.0)
        total = sum(probabilities.values()) or 1.0
        probabilities = {k: v / total for k, v in probabilities.items()}
        top = max(probabilities, key=lambda k: probabilities[k])
        return {"model": "m", "answers": {"clears": {"type": "choice", "choice": top, "probabilities": probabilities}}, "usage": {}, "latency_ms": 7}


class TestChatClearJudge(unittest.TestCase):
    """#457 slice 2: the judge's one question and the decision. Fixtures only; nothing is cleared by this slice."""

    P366, P389, P400 = "acme/widget#366", "acme/widget#389", "acme/widget#400"

    def setUp(self):
        self.cc = sb.load_module("chat_clear")
        self.offers = {pr: {"head": "%08x" % (n * 4097) + "0" * 32, "shown": True, "shown_at": 1000, "labels": ["u:hold-impact"], "summary": "touches the gate %d" % n}
                       for pr, n in ((self.P366, 366), (self.P389, 389), (self.P400, 400))}

    def decide(self, text, jev, offers=None, created=1001, now=1002, **kw):
        return self.cc.decide(jev, text, self.offers if offers is None else offers, created, now, **kw)

    def test_a_confident_judge_that_picks_the_one_candidate_clears_and_one_call_is_made_with_the_offers(self):
        jev = _StubJev({self.P366: 0.97, "several": 0.01, "asks": 0.01, "nothing": 0.01})
        got = self.decide("366 is good to go", jev)
        self.assertEqual((got["action"], got["pr"], got["why"]), ("clear", self.P366, "confirmed"))
        self.assertEqual(len(jev.calls), 1)
        state, questions = jev.calls[0]
        self.assertEqual(state["message"], "366 is good to go")
        self.assertEqual([h["pr"] for h in state["held"]], [self.P366, self.P389, self.P400])
        self.assertEqual(list(questions["clears"]["criteria"]), [self.P366, self.P389, self.P400, "several", "asks", "nothing"])

    def test_the_judge_never_widens_a_wrong_pr_a_number_less_message_or_a_hedge_is_a_question_whatever_it_says(self):
        for text, why in (("the launchd one is good to go", "no_number"), ("366 is not good to go", "hedged"), ("is 366 good to go?", "hedged"),
                          ("366 is good to go once CI passes", "hedged"), ("366 and 389 are good to go", "several_numbers"), ("500 is good to go", "not_offered")):
            jev = _StubJev({self.P366: 0.99})   # a judge that would clear 366 at 0.99
            got = self.decide(text, jev)
            self.assertEqual((got["action"], got["why"]), ("ask", why), text)
            self.assertEqual(len(jev.calls), 1, text)
        jev = _StubJev({self.P389: 0.99})
        got = self.decide("366 is good to go", jev)
        self.assertEqual((got["action"], got["why"]), ("ask", "jev"), "the judge picks ANOTHER offer: not a confirmation")
        for choice in ("several", "asks"):
            got = self.decide("366 is good to go", _StubJev({choice: 0.99}))
            self.assertEqual(got["action"], "ask", choice)

    def test_a_message_from_before_the_offer_a_cut_message_and_an_old_offer_are_asked_about_never_cleared(self):
        jev = _StubJev({self.P366: 0.99})
        for kw, why in ((dict(created=1000), "before_offer"), (dict(created=999), "before_offer"), (dict(now=1000 + self.cc.OFFER_TTL + 1), "expired"), (dict(created=None), "no_time")):
            got = self.decide("366 is good to go", jev, **kw)
            self.assertEqual((got["action"], got["why"]), ("ask", why), kw)
            self.assertIn("Nothing was cleared", got["question"])
        got = self.decide("366 is good to go" + " " * self.cc.TEXT_MAX, jev)
        self.assertEqual((got["action"], got["why"]), ("ask", "too_long"))
        self.assertEqual(self.decide("366 is good to go", jev)["action"], "clear", "the same message, in time, clears")

    def test_the_floor_is_an_allow_list_curly_apostrophes_exceptions_and_times_are_never_a_plain_clearing_sentence(self):
        jev = _StubJev({self.P366: 0.99})
        for text in ("366 isn\u2019t good to go", "366 isn't good to go", "366 don\u2019t clear", "366 won\u2019t be ready, but good to go", "366 is good to go except the docs",
                     "366 is not yet good to go", "366 is good to go only after review", "366 is good to go without the tests", "366 is pending, good to go later",
                     "366 is good to go tomorrow", "366 first then good to go", "366 is almost good to go", "366 is good to go soon", "366 is good to go while CI runs",
                     "366 is still good to go", "366 good to go lol", "please do not clear 366 good to go", "366 is good to go \u2014 wait", "366 is good to go\nand 5 more words"):
            got = self.decide(text, jev)
            self.assertEqual((got["action"], got["why"]), ("ask", "hedged" if "\n" not in text else "several_numbers"), text)
        self.assertEqual(self.decide("nope, 366", jev)["action"], "none", "a refusal with no clearing words in it is not about clearing: nothing is asked, nothing cleared")
        for text in ("366 is good to go", "366 is good to go.", "#366 is good to go", "366 good to go", "ok to merge 366, thanks", "366 looks good, go ahead", "Please ship 366", "366 is cleared"):
            self.assertEqual(self.decide(text, jev)["action"], "clear", text)

    def test_a_report_about_the_past_is_not_a_grant_only_a_present_state_or_an_instruction_clears(self):
        jev = _StubJev({self.P366: 0.99})
        past = ("366 was merged", "366 was good to go", "366 shipped", "366 released", "366 merged", "366 cleared yesterday", "366 was cleared", "366 were cleared", "366 has been cleared",
                "366 had been approved", "366 already cleared", "366 got merged", "366 is done", "366 went out", "366 was good, go ahead", "cleared 366", "approved 366",
                "last 366 good to go", "earlier 366 is good to go", "366 good to go yesterday", "366 is already good to go", "366 has been good to go", "366 was approved",
                "I cleared 366", "I approved 366", "we shipped 366", "366 was released", "366 released yesterday", "366 would be good to go", "366 had good to go",
                "366. I cleared it", "366 I cleared it", "366 you approved it", "366 I approved", "366 you cleared it", "366 cleared it", "366 approved it", "please cleared 366",
                "366 good to go cleared", "366 also cleared it", "366 is cleared it", "366 cleared, I think", "366 is approved by you", "thanks for the 366 approved", "thank you for 366 cleared", "you 366 approved", "thanks 366 cleared", "for 366 cleared", "then 366 cleared", "now 366 approved", "ok 366 cleared", "lgtm 366 approved", "a pr 366 approved", "ok 366 is approved, thanks", "366 thanks for the release", "366 thank you for the merge", "366 thanks for the approve", "366 good to go, thanks for the clear", "366 thanks ship", "366 thank you merge")
        for text in past:
            got = self.decide(text, jev)
            self.assertNotEqual(got["action"], "clear", text)
            if self.cc.CLEARISH.search(text):
                self.assertEqual((got["action"], got["why"]), ("ask", "hedged"), text)
        for text in ("366 is cleared", "366 cleared", "clear 366", "366 is approved", "366 approved", "approve 366", "ship 366", "release 366", "merge 366", "366 is good to go",
                     "366 also good to go", "#366 is cleared.", "366 cleared, thanks", "366 is approved, thank you", "ok to merge 366, thanks", "ship 366, thank you", "please clear 366 thanks", "366 also approved", "ok to merge 366", "go ahead ship 366", "please clear 366"):
            self.assertEqual(self.decide(text, jev)["action"], "clear", text)
        for word in ("i", "was", "were", "had", "has", "have", "been", "got", "already", "merged", "shipped", "released", "done", "went", "yesterday", "earlier", "last"):
            self.assertNotIn(word, self.cc.PLAIN_WORDS, word)

    def test_a_bad_nan_boolean_or_lower_bar_is_the_floor_and_the_bar_can_only_be_raised(self):
        for bar in (None, "x", [], float("nan"), True, 2, -1, 0, 0.1, 0.9, float("inf")):
            jev = _StubJev({self.P366: 0.85, "asks": 0.15})
            self.assertEqual(self.decide("366 is good to go", jev, min_confidence=bar)["action"], "ask", repr(bar))
            self.assertEqual(self.decide("366 is good to go", _StubJev({self.P366: 0.95, "asks": 0.05}), min_confidence=bar)["action"], "clear", repr(bar))
        self.assertEqual(self.decide("366 is good to go", _StubJev({self.P366: 0.95, "asks": 0.05}), min_confidence=0.97)["action"], "ask")

    def test_an_answer_whose_choice_is_not_an_option_not_the_most_probable_tied_or_not_numbers_confirms_nothing(self):
        for junk in ({"type": "choice", "choice": "acme/widget#999", "probabilities": {"acme/widget#999": 0.99}},
                     {"type": "choice", "choice": self.P366, "probabilities": {self.P366: 0.95, self.P389: 0.97}},
                     {"type": "choice", "choice": self.P366, "probabilities": {self.P366: 0.95, self.P389: 0.95}},
                     {"type": "choice", "choice": self.P366, "probabilities": {self.P366: True}},
                     {"type": "choice", "choice": self.P366, "probabilities": {self.P366: 1.5}},
                     {"type": "choice", "choice": self.P366, "probabilities": {self.P366: 0.95, "x": "y"}},
                     {"type": "choice", "choice": self.P366, "probabilities": {self.P366: float("nan")}},
                     {"type": "choice", "choice": ["list"], "probabilities": {self.P366: 0.95}}, {"type": "choice", "choice": None, "probabilities": {}}):
            got = self.decide("366 is good to go", _StubJev(junk=junk))
            self.assertEqual((got["action"], got["why"]), ("ask", "jev"), junk)
            self.assertFalse(got["judge"]["confident"], junk)

    def test_every_reason_screen_can_give_has_a_sentence_and_nothing_that_looks_like_a_secret_reaches_the_judge_or_the_question(self):
        reasons = set()
        offers = dict(self.offers)
        twice = {self.P366: self.offers[self.P366], "acme/other#366": dict(self.offers[self.P366])}
        for text, o, created, now in (("x", offers, 1001, 1002), ("366 and 389", offers, 1001, 1002), ("500 good to go", offers, 1001, 1002), ("abc366 good to go", offers, 1001, 1002),
                                      ("366 is not good", offers, 1001, 1002), ("9" * self.cc.TEXT_MAX, offers, 1001, 1002), ("366 good to go", twice, 1001, 1002),
                                      ("366 good to go", offers, 1000, 1002), ("366 good to go", offers, 1001, 1000 + self.cc.OFFER_TTL + 5), ("366 good to go", offers, None, 1002)):
            reasons.add(self.cc.screen(text, o, created, now)["why"])
        reasons.discard(None)
        self.assertEqual(reasons - set(self.cc.REASONS), set(), "a reason without a sentence would reach the owner as a raw code")
        token = "ghp_" + "A1b2C3d4" * 4
        secret_offers = {self.P366: dict(self.offers[self.P366], summary="touches %s and Bearer abcdefghijklmnop0123456789 and %s" % (token, "f" * 40))}
        jev = _StubJev({self.P366: 0.99})
        got = self.decide("366 is good to go", jev, offers=secret_offers)
        self.assertEqual(got["action"], "clear")
        self.assertNotIn(token, json.dumps(jev.calls) + json.dumps(got["judge"]))
        self.assertNotIn("f" * 40, json.dumps(jev.calls))
        self.assertIn("[secret]", json.dumps(jev.calls))
        stub = _StubJev({self.P366: 0.99})
        asked = self.decide("366 is good to go once %s" % token, stub, offers=secret_offers)
        self.assertEqual(asked["action"], "ask")
        self.assertEqual(len(stub.calls), 1, "the judge is still asked, and what it is sent holds no secret")
        sent = stub.calls[0][0]["message"]
        self.assertIn("[secret]", sent)
        self.assertNotIn(token, json.dumps(stub.calls))
        self.assertNotIn(token, asked["question"])
        self.assertNotIn("abcdefghijklmnop0123456789", asked["question"])
        shapes = ("github_pat_" + "a1B2c3D4" * 3, "sk-" + "a1B2c3D4" * 3, "xoxb-" + "1234567890" * 2, "AKIA" + "ABCDEFGH0123", "gho_" + "A1b2C3d4" * 3, "G" * 20 + "H" * 20 + "+/==",
                  "f" * 40, "Bearer " + "x" * 20)
        for shape in shapes:
            self.assertEqual(self.cc._clean("see %s here" % shape, 200), "see [secret] here", shape)
        for near in ("a" * 39 + " b", "ghp_short", "sk-short", "AKIA123", "a-normal-path/with/words and-numbers-12345"):
            self.assertEqual(self.cc._clean(near, 200), near, "a near miss is kept: %s" % near)

    def test_a_question_without_a_mark_a_symbol_and_a_sum_over_one_never_reach_a_clear(self):
        jev = _StubJev({self.P366: 0.99})
        for text in ("is 366 good to go", "was 366 approved", "is 366 ok to merge", "are 366 and ... good to go", "be 366 good to go", "366 good to go \u274c", "366 good to go /s",
                     "366 good to go :)", "366 good to go - maybe", "366 good to go (not really)", "366 good to go; wait", "366 \U0001F44D good to go", "366 is good to go\u2026"):
            got = self.decide(text, jev)
            self.assertEqual(got["action"], "ask", text)
            self.assertIn(got["why"], ("hedged", "no_number"), text)
        for text in ("366, is it good to go", "366 was it ok to merge", "366 is it good to go", "ok to merge 366 is it", "366 good to go, are you ok", "366 good to go be ok",
                     "366 good to go \uff15", "366 \u0663 good to go"):
            got = self.decide(text, jev)
            self.assertEqual((got["action"], got["why"]), ("ask", "hedged"), text)
        for text in ("366 is good to go", "366 is good to go!", "ok to merge #366, thanks.", "Ship 366 now", "366 is approved", "366 good to go"):
            self.assertEqual(self.decide(text, jev)["action"], "clear", text)
        self.assertEqual(self.decide(None, jev)["action"], "none", "a non-string message is read as empty: no clearing words, nothing")
        # a judge answer that is not validated can never say "not about clearing": the owner is still asked
        for junk in ({"type": "choice", "choice": "nothing", "probabilities": {"nothing": 5}}, {"type": "choice", "choice": "nothing", "probabilities": {"nothing": 0.9, "asks": 0.9}},
                     {"type": "choice", "choice": "nothing", "probabilities": {"nothing": 0.5, "asks": 0.5}}, {"type": "choice", "choice": "nothing", "probabilities": {"nothing": 0.9, "asks": 0.2, "x": -0.1}}):
            got = self.decide("all good to go", _StubJev(junk=junk))
            self.assertEqual(got["action"], "ask", junk)
            self.assertIs(got["judge"]["validated"], False, "an answer that failed a check can never say 'not about clearing'")
        got = self.decide("all good to go", _StubJev({"nothing": 0.9, "asks": 0.1}))
        self.assertEqual(got["action"], "none", "a validated answer that says nothing stays quiet")
        under = self.decide("366 is good to go", _StubJev(junk={"type": "choice", "choice": self.P366, "probabilities": {self.P366: 0.95}}))
        self.assertEqual((under["action"], under["why"]), ("ask", "jev"), "probabilities that add up to 0.95 are not an answer")
        extra = self.decide("366 is good to go", _StubJev(junk={"type": "choice", "choice": self.P366, "probabilities": {self.P366: 0.95, "asks": 0.05, "bogus": 0.0}}))
        self.assertEqual(extra["action"], "clear")
        self.assertNotIn("bogus", extra["judge"]["probabilities"], "only offered options are kept")
        for junk in ({"type": "choice", "choice": self.P366, "probabilities": {self.P366: 0.95, self.P389: 0.9}},
                     {"type": "choice", "choice": "nothing", "probabilities": ["x"]}, {"type": "choice", "choice": "nothing", "probabilities": {"nothing": "y"}},
                     {"type": "choice", "choice": "nothing", "probabilities": {"nothing": 0.9, 5: 0.1}}, {"type": "choice", "choice": 5, "probabilities": {"nothing": 1.0}}):
            for text in ("366 is good to go", "all good to go, thanks"):
                got = self.decide(text, _StubJev(junk=junk))   # the decision never raises on a malformed answer
                self.assertEqual(got["action"], "ask", (text, junk))

    def test_all_impacts_cleared_asks_once_and_names_all_three_holds(self):
        jev = _StubJev({"several": 0.95})
        got = self.decide("all impacts cleared", jev)
        self.assertEqual(len(jev.calls), 1, "one judge call, one question")
        self.assertEqual((got["action"], got["why"]), ("ask", "no_number"))
        for pr in (self.P366, self.P389, self.P400):
            self.assertIn(pr, got["question"])
        self.assertEqual(got["shown"], [self.P366, self.P389, self.P400])
        self.assertEqual(got["question"].count("Nothing was cleared"), 1)

    def test_an_unreachable_unsure_or_unreadable_judge_confirms_nothing_and_asks(self):
        class Down(Exception):
            reason = "unreachable"
        for jev, fragment in ((_StubJev(error=Down("secret-token-in-text")), "jev unreachable"), (_StubJev({self.P366: 0.60, self.P389: 0.40}), "unsure"),
                              (_StubJev(junk={"type": "choice", "choice": "x"}), "no probabilities"), (_StubJev(junk="junk"), "unreadable"), (None, "no judge")):
            got = self.decide("366 is good to go", jev)
            self.assertEqual((got["action"], got["why"]), ("ask", "jev"), fragment)
            self.assertIn(fragment, got["judge"]["reason"])
            self.assertFalse(got["judge"]["confident"])
            self.assertNotIn("secret-token", json.dumps(got["judge"]), "an error's text is never kept")
        self.assertEqual(self.decide("366 is good to go", _StubJev({self.P366: 0.89, "asks": 0.11}))["action"], "ask", "0.89 is below the bar")
        self.assertEqual(self.decide("366 is good to go", _StubJev({self.P366: 0.95, "asks": 0.05}), min_confidence=0.99)["action"], "ask", "a higher configured bar raises it")
        self.assertEqual(self.decide("366 is good to go", _StubJev({self.P366: 0.91, "asks": 0.09}), min_confidence=0.1)["action"], "clear", "a lower configured bar never lowers it below 0.9... and 0.91 passes")
        self.assertEqual(self.decide("366 is good to go", _StubJev({self.P366: 0.85, "asks": 0.15}), min_confidence=0.1)["action"], "ask")

    def test_chat_that_is_not_about_clearing_costs_no_judge_call_and_no_question_and_nothing_held_means_nothing(self):
        jev = _StubJev({self.P366: 0.99})
        for text in ("what is the weather", "thanks, 366 looks interesting", ""):
            got = self.decide(text, jev)
            self.assertEqual((got["action"], got["question"]), ("none", None), text)
        self.assertEqual(jev.calls, [], "no clearing words: the judge was not called")
        got = self.decide("366 is good to go", jev, offers={})
        self.assertEqual((got["action"], got["why"]), ("none", "no_offers"))
        self.assertEqual(jev.calls, [])
        got = self.decide("all good to go, thanks", _StubJev({"nothing": 0.9}))
        self.assertEqual((got["action"], got["why"]), ("none", "not about clearing"), "the judge says it is not about clearing: the owner is not asked")
        got = self.decide("366 is good to go", _StubJev({"nothing": 0.95}))
        self.assertEqual(got["action"], "none")

    def test_the_question_names_the_new_head_cleans_control_characters_and_is_bounded(self):
        offers = {"acme/widget#%d" % n: {"head": "a" * 40, "summary": "s\x1b[31m%d\n" % n} for n in range(30)}
        text = self.cc.question_text("hedged", offers)
        self.assertNotIn("\x1b", text)
        self.assertEqual(text.count("\n- "), self.cc.QUESTION_OFFERS_MAX)
        self.assertIn("and 20 more", text)
        one = self.cc.question_text("jev", offers, ["acme/widget#3"], {"acme/widget#3": "b" * 40})
        self.assertIn("it has a new head, bbbbbbbb, since you were shown this one", one)
        self.assertIn("`3 is good to go`", one)

    def test_the_real_replay_judge_reads_todays_three_messages_and_the_state_names_no_secret(self):
        rules = [{"contains": "all impacts cleared", "choice": {"several": 0.95, "asks": 0.05}},
                 {"contains": "389 also", "choice": {self.P389: 0.96, "nothing": 0.04}},
                 {"contains": "366 is good", "choice": {self.P366: 0.97, "asks": 0.03}}]
        with tempfile.TemporaryDirectory() as tmp:
            path = Path(tmp) / "replay.json"
            path.write_text(json.dumps({"rules": rules}))
            jev = sb.ReplayJev(str(path), "m")
            got = {text: self.decide(text, jev) for text in ("366 is good to go", "389 also good to go", "all impacts cleared")}
        self.assertEqual([(g["action"], g["pr"]) for g in got.values()], [("clear", self.P366), ("clear", self.P389), ("ask", None)])
        self.assertEqual(got["all impacts cleared"]["judge"]["jev_choice"], "several")


class TestChatClearHook(Base):
    """#457 slice 3: the daemon hook that records the offers, reads the owner's NEW messages in the Chief of Staff's session, judges each once and (only when `chat_clear.live`) clears.
    Fixtures only: a fake gh records every call, the decisions are written by hand, and nothing real is touched."""

    PR, REPO, NUMBER = "acme/app#9", "acme/app", 9
    H1, H2 = "a" * 40, "b" * 40

    def setUp(self):
        super().setUp()
        self.writes, self.reads, self.t0 = [], 0, None
        self.live = False
        self.build()

    def build(self, live=None, extra=None):
        chat = {"live": self.live if live is None else live}
        self.writes.clear()
        for stale in Path(sb.ensure_state_dir(None)).glob("chat-clear*"):
            stale.unlink()
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "gh": FAKE_GH, "chat_clear": chat})   # the owner's file: the hook reads it afresh every pass
        impact = Path(sb.ensure_state_dir(None)) / sb.IMPACT_STATE_FILE
        if impact.exists():
            impact.unlink()
        self.world = World(self, agents=("cos", "coder"), config=dict({"gh": FAKE_GH, "jev": {"replay": "/fake/replay.json"}, "chat_clear": chat}, **(extra or {})))
        self.world.v2.sessions[self.world.sessions["cos"]]["metadata"]["fleet"]["role"] = "chief-of-staff"
        self.engine = self.world.new_engine("daemon")
        self.engine.gh_runner, self.engine.state_dir = self.route, self.world.state
        self.names = sb.label_names(self.engine.config)
        self.jev = self.engine.jev = FakeJev(self.picks(self.PR, 0.97))
        self.pr = {"state": "OPEN", "headRefOid": self.H1, "title": "t", "labels": [{"name": self.names["merge-captain"]}, {"name": self.names["hold-impact"]}]}
        self.engine.discover(self.world.clock.now())

    def picks(self, option, top=0.97):
        def answer(state, questions):
            criteria = list(questions["clears"]["criteria"])
            rest = [o for o in criteria if o != option]
            probabilities = {option: top}
            probabilities.update({o: (1 - top) / len(rest) for o in rest})
            return {"clears": {"type": "choice", "choice": option, "probabilities": probabilities}}
        return answer

    def route(self, argv, **kwargs):
        if argv[0] == FAKE_GH and argv[1:3] == ["pr", "view"]:
            self.reads += 1
            return subprocess.CompletedProcess(argv, 0, json.dumps(self.pr), "")
        if argv[0] == FAKE_GH and "--method" in argv:
            method = argv[argv.index("--method") + 1]
            if method == "GET":
                return subprocess.CompletedProcess(argv, 0, "{}", "")
            self.writes.append((method, argv[2], json.loads(kwargs["input"]) if kwargs.get("input") else None))
            return subprocess.CompletedProcess(argv, 0, "{}", "")
        return self.world.route(argv, **kwargs)

    def decisions(self, head=None, holds=("impact",), number=None, repo=None, kind="captain"):
        return [{"kind": kind, "repo": repo or self.REPO, "number": number or self.NUMBER, "head": head or self.H1, "holds": list(holds),
                 "headline": "#9 changes the migrations", "review_evidence": "reviewed at aaaaaaaa by rev"}]

    def hook(self, decisions=None):
        self.engine.discover(self.world.clock.now())
        sb.decisions_from_notices(self.engine, self.world.clock.now())               # the REAL notice reader marks the input, as in every pass
        sb.chat_clear_pass(self.engine, self.decisions() if decisions is None else decisions, self.world.clock.now())

    def test_the_offers_are_kept_while_the_notice_read_is_not_whole_and_dropped_only_by_a_whole_pass(self):
        self.hook()                                                                  # the PR is held: its offer records the head shown
        cc = sb.load_module("chat_clear")
        before = cc.read_offers(self.world.state)
        self.assertEqual(len(before), 1)
        now = self.world.clock.now()
        item = {"repo": "acme/api", "number": 99, "created": now, "note": None, "from": "platform"}
        skipped = {"at": 0, "facts": None, "stale": True, "skipped": True, "confirmed": None, "error": "budget"}
        with mock.patch.object(sb, "read_pr_notices", return_value=[item]), mock.patch.object(sb, "notice_facts", return_value=skipped):
            sb.decisions_from_notices(self.engine, now)                              # the REAL reader: one noticed PR unread
        self.assertFalse(sb.whole(self.engine, "notices")[0])
        sb.chat_clear_pass(self.engine, [], now)                                     # the held PR is absent from this list: no evidence it left
        self.assertEqual(cc.read_offers(self.world.state), before)                   # the head the person was shown is kept
        self.assertIn("whole.skipped", [e["event"] for e in self.world.audit()])
        self.hook(decisions=[])                                                      # a whole pass without the PR: its offer goes
        self.assertEqual(cc.read_offers(self.world.state), {})

    def say(self, text, lasts=0, **kw):
        self.world.tick(5)
        self.world.v2.start_turn(self.world.sessions["cos"], text, fleet=False, lasts=lasts, **kw)

    def shown_then_say(self, text, decisions=None):
        self.hook(decisions)            # the offer is recorded (shown) first
        self.say(text)
        self.hook(decisions)

    def events(self, name):
        return [e for e in self.world.audit() if e["event"] == name]

    def label_deletes(self):
        return sorted(w[1].rsplit("/", 1)[1].replace("%3A", ":") for w in self.writes if w[0] == "DELETE")

    def comments(self):
        return [w for w in self.writes if w[1].endswith("/comments")]

    def cos_texts(self):
        return [a["text"] for a in self.world.admissions("cos") if "chat clear" in a["text"]]

    def test_s1_live_a_confirmed_clear_is_made_at_the_shown_head_and_quotes_his_words_in_the_comment_the_audit_and_the_reply(self):
        self.live = True
        self.build()
        self.shown_then_say("9 is good to go")
        self.assertEqual(self.label_deletes(), sorted([self.names["hold-impact"], self.names["merge-captain"]]))
        self.assertEqual([w for w in self.writes if w[0] == "POST" and w[1].endswith("/labels")], [], "a clear never ADDS a label")
        (comment,) = self.comments()
        self.assertIn("9 is good to go", comment[2]["body"])
        self.assertIn("`%s`" % self.H1[:8], comment[2]["body"])
        (cleared,) = self.events("gate.hold_cleared")
        self.assertEqual((cleared["detail"]["head"], cleared["detail"]["reason"], cleared["detail"]["by"]), (self.H1, "9 is good to go", "owner (chat)"))
        self.assertTrue(cleared["detail"]["via"].startswith("chat:"))
        (verdict,) = [e for e in self.events("chat_clear.verdict") if e["detail"]["action"] == "clear"]
        self.assertEqual((verdict["detail"]["quote"], verdict["detail"]["live"], verdict["detail"]["would_clear"]), ("9 is good to go", True, True))
        self.assertTrue(any("Cleared acme/app#9" in t and "9 is good to go" in t for t in self.cos_texts()), self.cos_texts())
        self.assertEqual(sb.read_impact_state(self.world.state)[0]["clears"][self.PR]["head"], self.H1, "the head-bound state stops the daemon re-adding it")

    def test_s2_the_default_is_shadow_the_verdict_is_logged_with_probabilities_and_nothing_is_written_or_sent(self):
        self.shown_then_say("9 is good to go")
        self.assertEqual(self.writes, [])
        self.assertEqual(self.cos_texts(), [])
        self.assertEqual(self.events("gate.hold_cleared"), [])
        (verdict,) = self.events("chat_clear.verdict")
        detail = verdict["detail"]
        self.assertEqual((detail["live"], detail["would_clear"], detail["action"], detail["quote"]), (False, True, "clear", "9 is good to go"))
        self.assertGreaterEqual(detail["probabilities"][self.PR], 0.9)
        self.assertEqual(sb.chat_clear_config({}), {"enabled": True, "live": False})
        for value in ("yes", 1, None, "true", [True]):
            self.assertEqual(sb.chat_clear_config({"chat_clear": {"live": value}}), {"enabled": True, "live": False}, "only a real true is live: %r" % (value,))
        self.assertEqual(sb.chat_clear_config({"chat_clear": {"live": True}}), {"enabled": True, "live": True})
        self.assertEqual(sb.chat_clear_config({"chat_clear": {"enabled": False, "live": True}}), {"enabled": False, "live": True})
        for bad in ({"live": "true"}, {"live": 1}, {"other": True}, [True], "live"):
            with self.assertRaises(sb.ConfigError, msg=bad):
                sb.validate_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "chat_clear": bad})
        self.assertEqual(sb.validate_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "chat_clear": {"live": True}})["chat_clear"], {"live": True})

    def test_s12_in_shadow_an_unsure_message_is_logged_once_and_nothing_is_sent(self):
        self.jev.rule = self.picks(self.PR, 0.6)
        self.hook()
        self.say("9 is good to go")
        for _ in range(3):
            self.hook()
            self.world.tick(5)
        (verdict,) = self.events("chat_clear.verdict")
        self.assertEqual((verdict["detail"]["action"], verdict["detail"]["live"], verdict["detail"]["why"]), ("ask", False, "jev"))
        self.assertIn("unsure", verdict["detail"]["reason"])
        self.assertEqual((self.writes, self.cos_texts()), ([], []))
        self.assertEqual(len(self.jev.calls), 1)

    def test_s3_the_same_words_from_an_agent_or_with_fleet_metadata_are_never_read_and_cost_no_call(self):
        self.live = True
        self.build()
        self.hook()
        self.world.tick(5)
        self.world.v2.start_turn(self.world.sessions["cos"], "9 is good to go", fleet=True, lasts=0)
        self.hook()
        self.assertEqual((self.jev.calls, self.writes, self.events("chat_clear.verdict")), ([], [], []))
        cc = sb.load_module("chat_clear")
        for message in ({"id": "a1", "type": "assistant", "text": "9 is good to go", "time": {"created": 1}}, {"id": "a2", "type": "user", "content": [{"type": "tool_result", "text": "9 is good to go"}]},
                        {"id": "a3", "type": "synthetic", "text": "9 is good to go"}, {"id": "a4", "role": "assistant", "type": "user", "text": "9 is good to go"}):
            self.assertEqual(cc.person_messages([message], set(), 100, lambda m: 99), [], message)

    def test_s4_unsure_several_hedged_unreachable_and_another_pr_write_nothing_and_ask_once_per_message(self):
        self.live = True
        for text, rule, fragment in (("all impacts cleared", self.picks("several", 0.95), "names no pull request number"), ("9 is good to go once CI passes", self.picks(self.PR, 0.99), "not a plain clearing sentence"),
                                     ("9 is good to go", self.picks(self.PR, 0.6), "could not be sure"), ("9 is good to go", None, "could not be sure"),
                                     ("9 is good to go", self.picks("acme/app#10", 0.99), "could not be sure")):
            with self.subTest(text=text, fragment=fragment):
                self.build()
                verdicts_before = len(self.events("chat_clear.verdict"))
                self.jev.rule = rule
                decisions = self.decisions() + self.decisions(number=10)
                self.shown_then_say(text, decisions)
                self.assertEqual(self.writes, [])
                (asked,) = self.cos_texts()
                self.assertIn(fragment, asked)
                self.assertIn("acme/app#9", asked)
                for _ in range(3):
                    self.world.tick(5)
                    self.hook(decisions)
                self.assertEqual(len(self.cos_texts()), 1, "one question per message, however many passes")
                self.assertEqual(len(self.events("chat_clear.verdict")) - verdicts_before, 1)

    def test_s5_a_push_after_the_offer_clears_nothing_and_the_question_shows_the_new_head(self):
        self.live = True
        self.build()
        self.hook()
        self.say("9 is good to go")
        self.pr["headRefOid"] = self.H2   # the push
        self.hook(self.decisions(head=self.H2))
        self.assertEqual(self.writes, [])
        (asked,) = self.cos_texts()
        self.assertIn("new head since you were shown it", asked)
        self.assertIn(self.H2[:8], asked)
        (verdict,) = self.events("chat_clear.verdict")
        self.assertEqual((verdict["detail"]["action"], verdict["detail"]["why"]), ("ask", "head_changed"))
        self.assertEqual(sb.load_module("chat_clear").read_offers(self.world.state)[self.PR]["head"], self.H2, "the question put the new head in front of him")
        self.say("9 also good to go")
        self.hook(self.decisions(head=self.H2))
        self.assertEqual(self.label_deletes(), sorted([self.names["hold-impact"], self.names["merge-captain"]]), "after he was shown the new head, his next words clear it")
        self.assertEqual(sb.read_impact_state(self.world.state)[0]["clears"][self.PR]["head"], self.H2, "the state is bound to the head he was shown and GitHub confirmed")

    def test_s5b_a_head_that_moves_between_the_decision_and_the_effect_is_refused_at_the_point_of_effect(self):
        self.live = True
        self.build()
        self.hook()
        self.say("9 is good to go")
        self.pr["headRefOid"] = self.H2   # GitHub's head moved after the daemon's picture was made
        self.hook()
        self.assertEqual(self.label_deletes(), [])
        self.assertEqual(len(self.events("chat_clear.failed")), 1)
        (asked,) = self.cos_texts()
        self.assertIn("no longer held for you or its labels changed", asked)
        self.assertEqual(sb.read_impact_state(self.world.state)[0]["clears"], {})

    def test_s6_only_owner_tier_hold_labels_and_the_captain_marker_are_removed_and_another_hold_is_never_offered_or_touched(self):
        self.live = True
        self.build()
        self.pr["labels"] = [{"name": self.names["hold-credential"]}, {"name": self.names["parked"]}, {"name": "bug"}]
        self.shown_then_say("9 is good to go", self.decisions(holds=("credential",)))
        self.assertEqual(self.label_deletes(), [self.names["hold-credential"]], "the credential hold goes; parked, bug and the rest stay")
        self.build()
        self.pr["labels"] = [{"name": self.names["hold-impact"]}, {"name": self.names["hold-security"]}, {"name": self.names["merge-captain"]}]
        self.shown_then_say("9 is good to go", self.decisions(holds=("impact", "security")))
        self.assertEqual(self.writes, [], "a PR that also has another hold label is never offered, so never touched")
        self.assertEqual(self.jev.calls, [], "and with nothing offered nothing is judged")
        self.build()
        self.pr["labels"] = [{"name": self.names["parked"]}]
        self.shown_then_say("9 is good to go", self.decisions(holds=()))   # a row with no owner-tier label
        self.assertEqual(self.writes, [], "his words name it, but at the point of effect it carries no owner-tier label: refused, nothing removed")
        self.assertEqual(len(self.events("chat_clear.failed")), 1)

    def test_s7_nothing_but_the_daemons_publish_calls_the_hook_and_no_command_takes_text_as_the_owners_word(self):
        import ast
        tree = ast.parse((Path(sb.__file__)).read_text())
        callers = {}
        for fn in [n for n in ast.walk(tree) if isinstance(n, ast.FunctionDef)]:
            for call in [c for c in ast.walk(fn) if isinstance(c, ast.Call)]:
                name = call.func.id if isinstance(call.func, ast.Name) else None
                if name in ("chat_clear_pass", "_chat_clear_act", "chat_clear_apply", "_chat_clear_pass"):
                    callers.setdefault(name, set()).add(fn.name)
        self.assertEqual(callers, {"chat_clear_pass": {"publish_decisions"}, "_chat_clear_pass": {"chat_clear_pass"}, "_chat_clear_act": {"_chat_clear_pass"}, "chat_clear_apply": {"_chat_clear_act"}})
        self.assertFalse([n for n in callers if any(f.startswith("cmd_") for f in callers[n])], "no command calls the chat clear")
        self.live = True
        self.build(live=True)
        self.hook()
        self.say("9 is good to go")
        cli = self.world.new_engine("cli")   # a command's engine with everything else the daemon's has: only the actor differs
        cli.gh_runner, cli.jev, cli.state_dir, cli.discovery = self.route, self.jev, self.world.state, self.engine.discovery
        cli.audit = self.engine.audit
        self.assertEqual(cli.actor, "cli")
        sb.chat_clear_pass(cli, self.decisions(), self.world.clock.now())
        self.assertEqual((self.writes, self.jev.calls), ([], []), "only the daemon's engine runs it")
        sb.chat_clear_pass(self.engine, self.decisions(), self.world.clock.now())
        self.assertEqual(len(self.jev.calls), 1, "the same state with the daemon's actor does run")

    def test_s8_the_quote_is_one_line_at_most_300_characters_with_no_control_characters_and_no_secret(self):
        self.live = True
        self.build()
        self.hook()
        self.say("9 is good to go" + " ok" * 200)   # a plain sentence that passes the floor and is far over the quote limit
        self.hook()
        (comment,) = self.comments()
        (cleared,) = self.events("gate.hold_cleared")
        (verdict,) = self.events("chat_clear.verdict")
        self.assertEqual(verdict["detail"]["action"], "clear", "the long plain sentence passed the floor")
        for text in (cleared["detail"]["reason"], verdict["detail"]["quote"]):
            self.assertLessEqual(len(text), 300)
            self.assertTrue(text.startswith("9 is good to go ok ok"))
            self.assertNotIn("\n", text)
        # a message that is refused still has its words quoted, with control characters and secret-like strings taken out, in the log and in the reply
        self.build()
        token = "ghp_" + "A1b2C3d4" * 4
        self.hook()
        self.say("9 is good to go %s \x1b[31m\n\t once CI passes" % token)   # the secret sits inside the first 300 characters
        self.hook()
        self.assertEqual(self.writes, [])
        (refused,) = self.events("chat_clear.verdict")[-1:]
        self.assertEqual(refused["detail"]["action"], "ask")
        self.assertIn("[secret]", refused["detail"]["quote"])
        self.assertNotIn(token, refused["detail"]["quote"])
        for text in (json.dumps(self.events("chat_clear.verdict")), "\n".join(self.cos_texts())):
            self.assertNotIn(token, text)
            self.assertNotIn("\x1b", text)
        self.assertIn("[secret]", "\n".join(self.cos_texts()))
        # an @mention or a code span in his words never renders in the public comment
        self.build()
        self.hook()
        self.say("9 is good to go @someone `x`")
        self.hook()
        self.assertEqual(self.comments(), [], "the floor refuses the @ and the backtick: nothing is cleared or commented")
        cc = sb.load_module("chat_clear")
        self.assertEqual(cc.quote("a @b `c`"), "a @b `c`")
        self.build(live=True)
        self.hook()
        sb.chat_clear_apply(self.engine, cc, self.PR, sb.load_module("chat_clear").read_offers(self.world.state)[self.PR], "ok @someone `x`", "m1", self.world.clock.now())
        (comment,) = self.comments()
        self.assertNotIn("@someone", comment[2]["body"])
        self.assertNotIn("`x`", comment[2]["body"])

    def test_s9_with_nothing_held_nothing_is_read_or_asked_and_each_message_is_judged_once_across_passes_and_restarts(self):
        self.live = True
        self.build()
        self.say("9 is good to go")
        self.hook(decisions=[])
        self.assertEqual((self.jev.calls, self.events("chat_clear.verdict")), ([], []), "no offer: his messages are not even read")
        self.world.v2.sessions[self.world.sessions["cos"]]["messages"].clear()
        self.hook()
        self.say("all impacts cleared")
        for _ in range(4):
            self.hook()
        self.assertEqual(len(self.jev.calls), 1, "ONE Jev call for the one new message, however many passes")
        self.engine = self.world.new_engine("daemon")   # a restart: the handled messages are remembered on disk
        self.engine.gh_runner, self.engine.jev, self.engine.state_dir = self.route, self.jev, self.world.state
        self.hook()
        self.assertEqual(len(self.jev.calls), 1, "and not again after a restart")
        self.assertEqual(len(self.cos_texts()), 1)
        for n in range(5):
            self.say("is 9 good to go %d" % n)
        self.hook()
        self.assertEqual(len(self.jev.calls), 1 + sb.CHAT_CLEAR_NEW_PER_PASS, "exactly the cap of new messages is judged in one pass")

    def test_s10_a_clear_stays_for_its_head_and_the_daemon_judges_a_new_head_again(self):
        self.live = True
        self.build()
        self.shown_then_say("9 is good to go")
        state = sb.read_impact_state(self.world.state)[0]
        self.assertEqual(state["clears"][self.PR]["head"], self.H1)
        report = {"pr": self.PR, "head": self.H1, "reasons": ["x"], "floor_paths": [], "globs": []}
        self.assertEqual(sb.apply_impact_hold(self.engine, self.REPO, 9, report, {"labels": []}), 0, "the same head: the daemon does not re-add the hold")
        self.assertEqual([w for w in self.writes if w[0] == "POST"], [w for w in self.writes if w[1].endswith("/comments")])
        self.pr["headRefOid"] = self.H2   # the pull request really is at the new head (#891: a write is only for the head the pull request has when it is read)
        self.assertGreater(sb.apply_impact_hold(self.engine, self.REPO, 9, dict(report, head=self.H2), {"labels": []}), 0, "a new head is judged and held again")

    def test_s11_the_core_removes_only_owner_tier_labels_and_refuses_anything_else_or_a_moved_head(self):
        self.build(live=True)
        with self.assertRaises(RuntimeError):
            sb.impact_clear_core(self.engine, self.route, self.REPO, 9, "owner (chat)", "x" * 12, remove=[self.names["parked"]])
        with self.assertRaises(RuntimeError):
            sb.impact_clear_core(self.engine, self.route, self.REPO, 9, "owner (chat)", "x" * 12, remove=[self.names["hold-impact"], "bug"])
        with self.assertRaises(RuntimeError):
            sb.impact_clear_core(self.engine, self.route, self.REPO, 9, "owner (chat)", "x" * 12, remove=[])
        with self.assertRaises(sb.NoticeError):
            sb.impact_clear_core(self.engine, self.route, self.REPO, 9, "owner (chat)", "x" * 12, remove=[self.names["hold-impact"]], head=self.H2)
        self.assertEqual(self.writes, [])
        self.assertEqual(sb.read_impact_state(self.world.state)[0]["clears"], {}, "a refused clear leaves no state")
        for label in ("hold-impact", "hold-credential", "hold-policy", "merge-captain"):
            self.writes.clear()
            sb.impact_clear_core(self.engine, self.route, self.REPO, 9, "owner (chat)", "x" * 12, remove=[self.names[label]], head=self.H1)
            self.assertEqual(self.label_deletes(), [self.names[label]])

    def test_a_hold_label_added_or_a_close_between_the_two_reads_is_refused_by_the_core_on_the_read_it_clears_from(self):
        self.live = True
        for change in ({"labels": lambda names: [{"name": names["hold-impact"]}, {"name": names["hold-security"]}]}, {"state": lambda names: "CLOSED"}):
            self.build()
            self.hook()
            self.say("9 is good to go")
            reads = {"n": 0}
            real = self.route

            def second_read_differs(argv, **kwargs):
                if argv[0] == FAKE_GH and argv[1:3] == ["pr", "view"]:
                    reads["n"] += 1
                    if reads["n"] == 2:
                        changed = dict(self.pr, **{k: f(self.names) for k, f in change.items()})
                        return subprocess.CompletedProcess(argv, 0, json.dumps(changed), "")
                return real(argv, **kwargs)

            self.engine.gh_runner = second_read_differs
            self.hook()
            self.assertEqual(self.writes, [], change)
            self.assertEqual(reads["n"], 2, "the pre-read and the core's own read")
            self.assertEqual(sb.read_impact_state(self.world.state)[0]["clears"], {}, "no clear state for a refused clear")
            (failed,) = self.events("chat_clear.failed")[-1:]
            self.assertIn("changed since the owner was shown it" if "labels" in change else "is not open any more", failed["detail"]["error"], change)
            self.assertIn("no longer held for you", "\n".join(self.cos_texts()), change)

    def test_a_failed_point_of_effect_read_refuses_and_the_read_goes_through_the_repos_own_account_for_the_current_head(self):
        self.live = True
        self.build()
        self.hook()
        self.say("9 is good to go")
        real = self.route

        def failing(argv, **kwargs):
            if argv[0] == FAKE_GH and argv[1:3] == ["pr", "view"]:
                return subprocess.CompletedProcess(argv, 1, "", "HTTP 502")
            return real(argv, **kwargs)

        self.engine.gh_runner = failing
        self.hook()
        self.assertEqual(self.writes, [])
        self.assertEqual(sb.read_impact_state(self.world.state)[0]["clears"], {})
        self.assertEqual(len(self.events("chat_clear.failed")), 1, "a read that fails refuses the clear: one question, no write")
        seen = []
        self.build(live=True)
        self.engine.accounts = sb.GhAccounts({"gh": FAKE_GH, "call_timeout_seconds": 5, "gh_users": {"acme/*": "acct-app"}}, lambda argv, **k: subprocess.CompletedProcess(argv, 0, "tok-app\n", ""), self.world.clock.now, environ={})
        real = self.route

        def watching(argv, **kwargs):
            if argv[0] == FAKE_GH and argv[1:3] == ["pr", "view"]:
                seen.append(kwargs.get("env", {}).get("GH_TOKEN"))
            return real(argv, **kwargs)

        self.engine.gh_runner = watching
        self.hook()
        self.say("9 is good to go")
        self.hook()
        self.assertTrue(seen and all(token == "tok-app" for token in seen), "every point-of-effect read runs as the repo's own account: %r" % seen)
        self.assertEqual(len(seen), 2, "one pre-read and the core's own read, nothing from memory")

    def live_verdicts(self):
        return [e["detail"]["live"] for e in self.events("chat_clear.verdict")]

    def test_live_is_confirmed_by_the_current_config_file_every_pass_and_an_invalid_file_or_the_kill_file_means_shadow_at_once(self):
        self.live = True
        valid = {"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "gh": FAKE_GH}
        cases = ((dict(valid, chat_clear={"live": True}), True), (dict(valid, chat_clear={"live": False}), False), (dict(valid), False), (dict(valid, chat_clear={"live": "true"}), False),
                 (dict(valid, chat_clear={"live": 1}), False), (dict(valid, chat_clear=None), False), (dict(valid, chat_clear={"live": True, "enabled": False}), False),
                 ("{not json", False), (dict(valid, chat_clear={"live": True, "other": 1}), False), (dict(valid, github_poll_seconds=-5, chat_clear={"live": True}), False))
        for file, live in cases:
            self.build()                       # this daemon runs on a config that says live
            self.write_config(file)            # ... and the file on disk now says something else
            self.hook()
            self.say("9 is good to go")
            self.hook()
            (verdict,) = self.events("chat_clear.verdict")[-1:]
            self.assertEqual(verdict["detail"]["live"], live, file)
            self.assertEqual(bool(self.label_deletes()), live, "labels are removed only while the current file confirms live: %r" % (file,))
            self.assertEqual(bool(self.cos_texts() or self.writes), live)

    def test_a_config_that_becomes_invalid_while_live_is_shadow_in_the_next_pass_and_says_so_once_and_the_kill_file_is_the_panic_stop(self):
        self.live = True
        self.build()
        self.hook()
        self.assertEqual([e["detail"]["mode"] for e in self.events("chat_clear.mode")], [], "live from the first pass: nothing to announce")
        self.write_config("{broken")
        self.hook()
        self.hook()
        modes = self.events("chat_clear.mode")
        self.assertEqual([m["detail"]["mode"][:23] for m in modes], ["shadow (config invalid: "[:23]], "said ONCE, loudly")
        self.assertIn("config invalid: ", modes[0]["detail"]["mode"])
        self.assertTrue(modes[0]["detail"]["why"].startswith("config invalid: "), "and the reason is said, so the owner knows what to fix")
        self.say("9 is good to go")
        self.hook()
        self.assertEqual((self.writes, self.live_verdicts()), ([], [False]))
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "gh": FAKE_GH, "chat_clear": {"live": True}})
        self.say("9 also good to go")
        self.hook()
        self.assertEqual(self.live_verdicts(), [False, True], "a valid file that says live puts it back")
        self.assertEqual(self.events("chat_clear.mode")[-1]["detail"]["mode"], "live")
        # the kill file
        self.build()
        self.hook()
        (Path(self.world.state) / sb.CHAT_CLEAR_OFF_FILE).write_text("")
        self.say("9 is good to go")
        self.hook()
        self.assertEqual((self.writes, self.live_verdicts()[-1:]), ([], [False]), "the kill file forces shadow")
        self.assertEqual(self.events("chat_clear.mode")[-1]["detail"]["mode"], "shadow (kill file)")
        (Path(self.world.state) / sb.CHAT_CLEAR_OFF_FILE).unlink()
        os.symlink("/nonexistent/chat-clear-target", str(Path(self.world.state) / sb.CHAT_CLEAR_OFF_FILE))   # a DANGLING symlink is still the panic stop
        self.say("9 also good to go")
        self.hook()
        self.assertEqual(self.live_verdicts()[-1:], [False], "a dangling symlink kill file reads as present")
        self.assertEqual(self.events("chat_clear.mode")[-1]["detail"]["mode"], "shadow (kill file)")
        (Path(self.world.state) / sb.CHAT_CLEAR_OFF_FILE).unlink()
        self.say("9 is also good to go")
        self.hook()
        self.assertEqual(self.live_verdicts()[-1:], [True], "removed: back to the config's value")
        self.assertEqual(bool(self.label_deletes()), True)

    def test_a_kill_file_or_a_broken_config_that_appears_between_two_messages_of_one_pass_stops_the_second_one(self):
        self.live = True
        self.build()
        self.hook()
        self.say("all impacts cleared")
        self.world.tick(1)
        self.world.v2.start_turn(self.world.sessions["cos"], "9 is good to go", fleet=False, lasts=0)
        order = []
        real_act = sb._chat_clear_act

        def spy(engine, cc_, cfg, message, verdict, offers, heads, now):
            order.append((message["text"], cfg["live"]))
            if len(order) == 1:
                (Path(self.world.state) / sb.CHAT_CLEAR_OFF_FILE).write_text("")   # the stop is hit after the first message was handled
            return real_act(engine, cc_, cfg, message, verdict, offers, heads, now)

        with mock.patch.object(sb, "_chat_clear_act", spy):
            self.hook()
        self.assertEqual([live for _, live in order], [True, False], "the second message of the same pass is judged shadow: %r" % order)
        self.assertEqual(self.label_deletes(), [], "nothing was cleared by the second message")
        self.build()
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "gh": FAKE_GH, "chat_clear": {"live": True}})
        Path(self.config_file).unlink()
        self.hook()
        self.say("9 is good to go")
        self.hook()
        self.assertEqual((self.writes, self.live_verdicts()[-1:]), ([], [False]), "a config file that is gone is not live")

    def test_the_hook_fails_quietly_and_never_clears_on_trouble(self):
        self.live = True
        self.build()
        self.hook()
        self.say("9 is good to go")
        with mock.patch.object(sb.load_module("chat_clear"), "decide", side_effect=RuntimeError("boom")):
            self.hook()
        self.assertEqual(self.writes, [])
        self.assertEqual(len(self.events("chat_clear.error")), 1, "an exception in the pass is audited and swallowed, never raised")
        self.build(live=True)
        self.hook()
        self.say("9 is good to go")
        with mock.patch.object(self.engine, "send", side_effect=RuntimeError("down")):
            self.hook()
        self.assertEqual(self.label_deletes(), sorted([self.names["hold-impact"], self.names["merge-captain"]]), "the clear is made; a reply that cannot be sent is audited")
        self.assertEqual(len(self.events("chat_clear.reply_failed")), 1)
        self.build(live=True)
        self.hook()
        self.say("9 is good to go")
        cleared_before = len(self.events("gate.hold_cleared"))
        with mock.patch.object(sb, "comment_as", side_effect=RuntimeError("no comment")):
            self.hook()
        self.assertEqual(len(self.events("chat_clear.comment_failed")), 1)
        self.assertEqual(len(self.events("gate.hold_cleared")) - cleared_before, 1, "the clear stands; only the comment failed")

    def test_enabled_false_reads_nothing_and_judges_nothing_and_v2_light_still_reads_once(self):
        self.live = True
        self.build(extra={"chat_clear": {"live": True, "enabled": False}})
        self.hook()
        self.say("9 is good to go")
