    def test_972_the_higher_run_is_the_score_in_both_orders_and_the_lower_never_blocks(self):
        module = sb.load_module("delegated_clear")
        for order in (("Serious", "Medium"), ("Medium", "Serious")):
            with self.subTest(order=order):
                self.writes.clear()
                self.score_config("Serious")
                self.scored_pr()
                reason = self.two(*order)
                code, out, err = self.under(reason=reason)
                self.assertEqual(code, 0, err)
                cleared = self.events("gate.hold_cleared")[-1]
                self.assertEqual((cleared["detail"]["score"], cleared["detail"]["threshold"]), ("Serious", "Serious"))
                self.assertEqual(sorted(r["cell"] for r in cleared["detail"]["runs"]), sorted(order))
                self.assertEqual(len(cleared["detail"]["runs"]), 2)
                self.assertEqual(sorted(r["id"] for r in cleared["detail"]["runs"]), [int(x) for x in sorted(__import__("re").findall(r"#(\d+)=", reason))])
                self.ledger_reset()

    def test_972_two_runs_above_the_threshold_are_refused_by_score_not_by_count(self):
        for levels, threshold, words in ((("High", "High"), "Serious", "the score is High"), (("High", "Low"), "Serious", "the score is High"), (("Medium", "Medium"), "Low", "above the threshold")):
            with self.subTest(levels=levels):
                self.writes.clear()
                self.score_config(threshold)
                self.scored_pr()
                reason = self.two(*levels)
                code, out, err = self.under(reason=reason)
                self.assertEqual(code, 2, err)
                self.assertIn(words, err)
                self.assertNotIn("required", err)
                self.assertEqual(self.deletes(), [])
                self.ledger_reset()

    def test_972_the_reason_must_name_both_runs_with_their_own_cells(self):
        self.score_config("Serious")
        self.scored_pr()
        first, second = [int(x) for x in __import__("re").findall(r"#(\d+)=", self.two("Medium", "Low"))]
        for reason, words in (("only the first run is named: #%d=Medium" % first, "#%d" % second), ("both named: #%d=Medium, #%d=Serious" % (first, second), "wrong cell"),
                              ("names the runs but no cell: #%d and #%d" % (first, second), "its cell"), ("by rater only: rev=Medium", "#%d" % second)):
            code, out, err = self.under(reason=reason)
            self.assertEqual(code, 2, err)
            self.assertIn(words, err)
            self.assertEqual(self.deletes(), [], reason)
        code, out, err = self.under(reason="by rater names: rev=Medium, rev2=Low")
        self.assertEqual(code, 0, err)

    def test_972_the_owners_own_clear_needs_no_second_run_and_no_order_stays_refused(self):
        self.score_config("Serious")
