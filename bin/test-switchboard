    def test_an_old_modification_time_with_a_recent_change_time_is_kept(self):
        restored = self.old("restored-from-tar", days=30, directory=True)
        for p in (restored / "inner.txt", restored):
            os.utime(str(p), (time.time() - 30 * 86400,) * 2)   # a tar or cp -a restore: old mtimes, a change time of just now
        self.shift(1)
        code, out, err = self.run_cli("--apply")
        self.assertTrue(restored.exists())
        self.shift(10)
        code, out, err = self.run_cli("--apply")
        self.assertFalse(restored.exists(), "the same tree is removed once its change time is old too")

    def test_a_state_directory_with_no_record_at_all_keeps_everything(self):
