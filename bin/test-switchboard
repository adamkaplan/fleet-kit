class TestMessagePaging(Base):
    """V2Client reads past one page by following v2's cursor (PR 4's known gap)."""

    def setUp(self):
        super().setUp()
        self.world = World(self, agents=("cos",))
        self.sid = self.world.sessions["cos"]
        self.client = sb.V2Client(FAKE_OPENCODE, {}, self.world.v2, 5)

    def fill(self, count, step=1):
        for number in range(count):
            self.world.v2.sessions[self.sid]["messages"].append(
                {"id": "msg_p%05d" % number, "sessionID": self.sid, "type": "synthetic", "text": "x",
                 "metadata": {"fleet": {"keys": ["k%d" % number], "from": "switchboard"}},
                 "time": {"created": self.world.clock.ms(EPOCH + number * step)}})

    def test_the_cursor_argv_is_strict(self):
        runner = FakeRunner(default=(0, '{"data": [], "cursor": {"next": null, "previous": null}}', ""))
        client = sb.V2Client("/opt/lab/bin/opencode", {}, runner, 7)
        self.assertEqual(client.message_page(SES, 200, "synthetic", "cur_9"), ([], {"next": None, "previous": None}))
        self.assertEqual(runner.argv, ["/opt/lab/bin/opencode", "api", "session.message.list", "--param", "sessionID=" + SES,
                                       "--param", "limit=200", "--param", "type=synthetic", "--param", "cursor=cur_9"])
        self.assertNotIn("order=desc", runner.argv)  # v2: a cursor is not combined with order
        for bad in ("", 7, "x" * (sb.CURSOR_LIMIT + 1)):
            with self.subTest(cursor=bad), self.assertRaises(ValueError):
                client.message_page(SES, 200, "synthetic", bad)

    def test_a_listing_without_a_cursor_object_gives_none(self):
        client = sb.V2Client(FAKE_OPENCODE, {}, FakeRunner(default=(0, '{"data": [{"id": "m"}]}', "")), 5)
        self.assertEqual(client.message_page(SES, 5), ([{"id": "m"}], None))

    def test_450_messages_are_read_in_three_pages_and_none_is_missed(self):
        self.fill(450)
        keys, complete = self.world.engine.delivered_keys(self.sid, EPOCH - 60)
        self.assertTrue(complete)
        self.assertEqual(keys, {"k%d" % n for n in range(450)})
        reads = [c for c in self.world.v2.calls if c[2] == "session.message.list" and "type=synthetic" in c]
        self.assertEqual(len(reads), 3)
        self.assertTrue(all("limit=%d" % sb.READ_LIMIT in c for c in reads))
        self.assertEqual([c for c in reads[1:] if "order=desc" in c or "order=asc" in c], [])

    def test_a_recipient_with_450_synthetic_messages_is_not_held(self):
        self.fill(450)
        engine = self.world.engine
        plan = engine.plan("cos", [fact("brand-new", EPOCH, recipient="cos")], engine.discover(EPOCH + 1000), EPOCH + 1000)
        self.assertEqual(plan.action, "wake", plan.reason)

    def test_the_read_stops_at_the_oldest_fact_without_reading_every_page(self):
        self.fill(450)
        # the newest 200 are k250..k449, made at EPOCH+250 and later: a horizon of EPOCH+300 lies in the first page
        keys, complete = self.world.engine.delivered_keys(self.sid, EPOCH + 300)
        self.assertTrue(complete)
        self.assertEqual(len([c for c in self.world.v2.calls if c[2] == "session.message.list"]), 1,
                         "the first page reaches the horizon, so no cursor is followed")

    def test_more_pages_than_the_bound_hold_rather_than_guess(self):
        self.fill(450)
        with mock.patch.object(sb, "MAX_READ_PAGES", 2):
            _, complete = self.world.engine.delivered_keys(self.sid, EPOCH - 60)
        self.assertFalse(complete)

    def test_a_cursor_that_does_not_walk_older_holds_and_says_so(self):
        self.fill(450)
        original = self.world.v2.page_of

        def stuck(messages, params):
            page = original(messages, params)
            page.envelope["cursor"]["next"] = self.world.v2.CURSOR_PREFIX + "0"  # always the first page again
            return page
        self.world.v2.page_of = stuck
        engine = self.world.engine
        plan = engine.plan("cos", [fact("brand-new", EPOCH, recipient="cos")], engine.discover(EPOCH + 1000), EPOCH + 1000)
        self.assertEqual(plan.action, "hold")
        self.assertIn("cannot read what cos already has", plan.reason)

    def test_a_full_page_with_no_next_cursor_is_the_end_not_a_hold(self):
        self.fill(sb.READ_LIMIT)
        keys, complete = self.world.engine.delivered_keys(self.sid, EPOCH - 60)
        self.assertTrue(complete)
        self.assertEqual(len(keys), sb.READ_LIMIT)
        self.assertEqual(len([c for c in self.world.v2.calls if c[2] == "session.message.list"]), 1)

    def test_an_answer_with_no_cursor_and_a_full_page_still_holds(self):
        self.fill(sb.READ_LIMIT)
        self.world.v2.page_of = lambda messages, params: copy.deepcopy(messages[:int(params["limit"])])
        _, complete = self.world.engine.delivered_keys(self.sid, EPOCH - 60)
        self.assertFalse(complete)


class TestClassifierModeConfig(Base):
    JEV = {"jev": {"replay": "/fake/replay.json"}}

    def test_shadow_is_the_default_and_act_is_the_only_other_mode(self):
        self.assertEqual(sb.validate_config({})["classifier_mode"], "shadow")
        self.assertEqual(sb.validate_config(dict(self.JEV, classifier_mode="act"))["classifier_mode"], "act")
        with self.assertRaises(sb.ConfigError) as caught:
            sb.validate_config(dict(self.JEV, classifier_mode="enforce"))
        self.assertIn("shadow, act", str(caught.exception))

    def test_acting_without_a_decision_model_is_refused(self):
        with self.assertRaises(sb.ConfigError) as caught:
            sb.validate_config({"classifier_mode": "act"})
        self.assertIn("jev", str(caught.exception))

    def test_acting_is_off_in_the_engine_unless_both_are_set(self):
        world = World(self, agents=("cos",), config=dict(self.JEV, classifier_mode="act"))
        self.assertTrue(sb.acting(world.engine))
        world.engine.jev = None
        self.assertFalse(sb.acting(world.engine))
        self.assertFalse(sb.acting(World(self, agents=("cos",), state=self.home / "s2", config=self.JEV).engine))


class ActingCase(IntentCase):
    """A Chief of Staff on ask 5 with a background subagent on ask 2, a fake GitHub, and a fake Jev."""

    MODE = "act"

    def setUp(self):
        super().setUp()
        self.config = {"gh": FAKE_GH, "intent_repo": FAKE_REPO, "jev": {"replay": "/fake/replay.json"},
                       "classifier_mode": self.MODE}
        self.world = World(self, agents=(), config=self.config, state=self.home / "acting")
        self.gh = FakeGH(self.ISSUES, {1}, self.world.clock)
        self.reader = sb.IntentReader(FAKE_GH, FAKE_REPO, self.gh, self.world.clock.now, 5)
        self.world.intents = self.reader
        self.cos = self.world.add_agent("cos", fleet={"role": "chief-of-staff", "issue": 5})
        self.world.add_agent("cos-2", fleet={"role": "cos-subagent", "reports_to": "cos", "issue": 2})
        self.answer = "new"
        self.world.engine = self.world.new_engine()
        self.use_jev(self.world.engine)

    def use_jev(self, engine):
        self.jev = engine.jev = FakeJev(lambda state, questions: confident(
            self.answer, 0.95, tuple(questions[sb.CLASSIFY_ID]["criteria"])))

    def restart(self):
        self.world.engine = self.world.new_engine()
        self.use_jev(self.world.engine)

    def work(self, lasts=60, steps=6):
        self.world.v2.start_turn(self.cos, "fleet task", fleet=True, lasts=lasts, steps=steps)

    def say(self, text):
        self.world.v2.start_turn(self.cos, text, fleet=False)

    def passes(self, count=1):
        for _ in range(count):
            self.world.engine.run_pass()
            self.world.tick(5)

    def decorations(self):
        return [a for a in self.world.admissions("cos") if any(k.startswith("decoration:") for k in a["keys"])]

    def decision_entries(self):
        return [e for e in self.world.audit() if e["event"] == "foreground.decision"]


class TestActingClassifier(ActingCase):
    def test_new_while_busy_hands_off_first_as_a_note(self):
        self.work()
        self.say("Also, the billing export?")
        self.passes(3)
        (note,) = self.decorations()
        self.assertEqual((note["resume"], note["delivery"]), (False, "steer"))
        yours = [m for m in self.world.v2.sessions[self.cos]["messages"]
                 if m["type"] == "user" and m["text"] == "Also, the billing export?"]
        self.assertEqual(note["keys"], ["decoration:%s:%s" % (self.cos, yours[0]["id"])])
        self.assertIn("fleet-switchboard handoff --issue 5 --brief-file -", note["text"])
        self.assertIn("Another ask", note["text"])
        self.assertIsNotNone(note["delivered_at"], "a note rides into the running turn at its next step")

    def test_it_is_delivered_once_however_many_passes_follow(self):
        self.work()
        self.say("Also, the billing export?")
        self.passes(8)
        self.assertEqual(len(self.decorations()), 1)
        self.assertEqual(len(self.jev.calls), 1)

    def test_new_while_idle_adds_nothing(self):
        self.world.v2.sessions[self.world.sessions["cos-2"]]["metadata"]["fleet"].pop("issue")
        self.say("Also, the billing export?")
        self.passes(3)
        self.assertEqual(self.jev.calls, [], "idle and no other ask: nothing to choose between")
        self.world.v2.sessions[self.world.sessions["cos-2"]]["metadata"]["fleet"]["issue"] = 2
        self.world.tick(30)
        self.say("And the billing export again?")
        self.passes(3)
        self.assertEqual(len(self.jev.calls), 1)
        self.assertEqual(self.world.admissions("cos"), [])
        self.assertEqual(self.decision_entries()[-1]["detail"]["decoration"], None)

    def test_current_adds_nothing(self):
        self.answer = "current"
        self.work()
        self.say("How is it going?")
        self.passes(3)
        self.assertEqual(self.world.admissions("cos"), [])
        self.assertEqual(self.decision_entries()[0]["detail"]["decoration"], None)

    def test_unsure_and_unreachable_add_nothing(self):
        self.jev.rule = lambda state, questions: {sb.CLASSIFY_ID: choice_answer("new", {"current": 0.3, "2": 0.3, "new": 0.4})}
        self.work()
        self.say("Something vague")
        self.passes(2)
        self.assertEqual(self.world.admissions("cos"), [])
        self.assertEqual(self.decision_entries()[0]["detail"]["choice"], "current")
        self.jev.rule = "unreachable"
        self.world.tick(5)
        self.say("Another vague thing")
        self.passes(2)
        self.assertEqual(self.world.admissions("cos"), [])
        self.assertEqual(len(self.decision_entries()), 2)

    def test_an_ask_with_an_owner_names_the_ask_the_owner_and_the_command(self):
        self.answer = "2"
        self.work()
        self.say("The agents still fail on staging")
        self.passes(3)
        (note,) = self.decorations()
        self.assertIn("This is about ask 2 (Intent: Fix the agents).", note["text"])
        self.assertIn("cos-2 is working on it in the background.", note["text"])
        self.assertIn('fleet-switchboard send cos-2 --issue 2 "..."', note["text"])
        self.assertIn("Then continue with what you were doing.", note["text"])
        self.assertIn("Ask #2 Intent: Fix the agents", note["text"], "grouped under the ask's own Intent lines")
        self.assertIn("Done when: both answer", note["text"])

    def test_an_owned_ask_is_decorated_when_idle_too(self):
        self.answer = "2"
        self.say("The agents still fail on staging")
        self.passes(3)
        self.assertEqual(len(self.decorations()), 1)

    def test_the_doc_s_decoration_wording_is_what_is_sent(self):
        doc = (REPO / "docs" / "switchboard.md").read_text()
        block = doc.split("#### Decorate: work that already has an owner", 1)[1].split("```text\n", 1)[1].split("```", 1)[0]
        wanted = " ".join(block.split())
        ask = {"issue": 615, "owner": "cos-615", "intent": 'fix the project agents that show "Agent unavailable"'}
        self.assertEqual("[switchboard] " + " ".join(sb.owned_ask_text(ask).split()), wanted)

    def test_without_github_the_decoration_still_names_the_owner(self):
        self.answer = "2"
        self.gh.down = True
        self.reader.invalidate(2)
        self.reader.invalidate(5)
        self.say("The agents still fail on staging")
        self.passes(3)
        (note,) = self.decorations()
        self.assertIn("cos-2 is working on it", note["text"])
        self.assertNotIn("(Intent:", note["text"])

    def test_a_decoration_is_never_a_wake_and_nothing_is_typed(self):
        self.work()
        self.say("Also, the billing export?")
        self.passes(3)
        self.assertEqual([c for c in self.world.model_calls("cos") if c["phase"] in ("turn_start", "after_reply")
                          and any(i["keys"] and i["keys"][0].startswith("decoration:") for i in c["inputs"])], [])
        self.assertEqual(self.world.herdr.typing_attempts, [])

    def test_only_a_chief_of_staff_is_decorated(self):
        self.world.v2.sessions[self.cos]["metadata"]["fleet"]["role"] = "orchestrator"
        self.work()
        self.say("Also, the billing export?")
        self.passes(3)
        self.assertEqual((self.jev.calls, self.world.admissions("cos")), ([], []))

    def test_the_decision_is_audited_and_the_classification_is_no_longer_marked_shadow(self):
        self.work()
        self.say("Also, the billing export?")
        self.passes(2)
        (decision,) = self.decision_entries()
        self.assertEqual((decision["detail"]["choice"], decision["detail"]["decoration"]), ("new", "handoff"))
        classify = [e for e in self.world.audit() if e["event"] == "classify"]
        self.assertFalse(classify[0]["detail"]["shadow"])
        options = classify[0]["detail"]["question"]["state"]["open_asks"]
        self.assertEqual([a["intent"] for a in options], ["Fix the agents"], "asks arrive with their Intent")

    def test_acting_does_not_need_shadow_judges(self):
        self.world.engine.config = dict(self.world.engine.config, shadow_judges=False)
        self.work()
        self.say("Also, the billing export?")
        self.passes(3)
        self.assertEqual(len(self.decorations()), 1)

    def test_the_no_classify_fault_switches_it_off_in_the_lab(self):
        os.environ[sb.FAULT_ENV] = "no-classify"
        self.work()
        self.say("Also, the billing export?")
        self.passes(3)
        self.assertEqual((self.jev.calls, self.world.admissions("cos")), ([], []))


