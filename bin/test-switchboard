    def test_s10_one_pull_request_whose_runs_keep_failing_is_announced_once_an_hour_with_the_count(self):
        self.engine.hub.owner = None
        self.chief("boss")
        self.add(1480, 580, names=["t"], age=300)
        self.go()
        self.add(1481, 580, names=["t"], age=200)
        self.add(1482, 580, names=["t"], age=100)
        self.add(1483, 581, names=["t"], age=90)
        self.world.tick(self.module.LIST_SECONDS + 1)
        self.go()
        self.assertEqual([("#580" in l, "#581" in l) for _, l in self.sent], [(True, False), (False, True)], "the 2nd pull request is not held back; the 2 later runs of the 1st are not announced")
        self.assertEqual(len([e for e in self.world.audit() if e["event"] == "queue_ejection.suppressed"]), 1, "the newest run of a pull request decides: 1 suppressed")
        self.world.tick(self.module.UNOWNED_HOURLY + 10)
        self.add(1484, 580, names=["t"], age=30)
        self.go()
        self.assertIn("1 earlier failed run", self.sent[-1][1])
        self.assertIn("#580", self.sent[-1][1])

    def test_s7_an_unowned_pull_request_with_no_chief_is_said_and_woken_once_one_exists(self):
