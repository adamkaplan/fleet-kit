    def test_t12_is_ours_through_the_merged_prs_author_and_a_fresh_read_of_a_closed_issue_drops_it(self):
        self.charter()
        self.add(170, created=60, labels=["kind"], author="stranger")          # not assigned to us, not in a chain, opened by someone else
        self.merged_pr(230, "PLAN: acme/api#170", author="bot")                # but the merged PR is ours
        self.go(passes=1)
        self.assertEqual(self.only("T12"), ["acme/api#170"])
        self.assertNotIn(("OO", "acme/api#170"), self.found())
        self.hub.live["acme/api"] = {170: dict(self.hub.open["acme/api"][170], state="closed")}   # a fresh read shows it closed since
        self.world.tick(sb.TRIAGE_TTL + 5)
        state = sb.triage_state(self.engine)
        self.assertFalse(sb.triage_verify(self.engine, state, "T12", "acme/api#170", self.engine.config["triage"], self.world.clock.now(), [10]))

