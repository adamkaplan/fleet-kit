        self.assertIn("cleared the impact hold of acme/app#9", lines[0])
        (cleared,) = self.events("gate.hold_cleared")
        self.assertNotIn("via", cleared["detail"])


class GitHubOverGit:
    """The slice of GitHub's REST answers the carry reads, produced from a REAL git repository (so a merge, a conflict, a rebase, a binary file and a rename are the real thing):
    pulls/N, pulls/N/files, compare/A...B and commits/SHA, with GitHub's shapes (a patch starts at the first hunk and is absent for a binary file, files are paged by 100)."""

    def __init__(self, repo_dir, branch="feature", base="main", number=7):
        self.dir, self.branch, self.base, self.number = str(repo_dir), branch, base, number
        self.calls, self.fail, self.changed_files_override = [], None, None

    def git(self, *args, check=True):
        done = subprocess.run(["git", "-C", self.dir] + list(args), capture_output=True, text=True)
        if check and done.returncode != 0:
            raise RuntimeError("git %s: %s" % (" ".join(args), done.stderr.strip()))
        return done.stdout

    def rev(self, ref):
        return self.git("rev-parse", ref).strip()

    def files_between(self, a, b):
        key = (self.rev(a), self.rev(b))
        self.cache = getattr(self, "cache", {})
        if key not in self.cache:
            self.cache[key] = self._files_between(a, b)
        return self.cache[key]

    def _files_between(self, a, b):
        merge_base = self.git("merge-base", a, b).strip()
        names = [line.split("\t") for line in self.git("diff", "-M", "--name-status", merge_base, b).splitlines()]
        patches = [section for section in ("\n" + self.git("diff", "-M", merge_base, b)).split("\ndiff --git ")[1:]]
        tree_b = {line.split("\t")[1]: line.split()[2] for line in self.git("ls-tree", "-r", b).splitlines()}
        tree_base = {line.split("\t")[1]: line.split()[2] for line in self.git("ls-tree", "-r", merge_base).splitlines()}
        out = []
        for parts, section in zip(names, patches):
            code, paths = parts[0], parts[1:]
            path, previous = paths[-1], (paths[0] if code.startswith("R") else None)
            status = {"A": "added", "M": "modified", "D": "removed", "R": "renamed"}[code[0]]
            patch = section[section.index("\n@@") + 1:].rstrip("\n") if "\n@@" in section else None
            changes = sum(1 for l in (patch or "").splitlines() if l[:1] in "+-" and not l.startswith(("+++", "---")))
            blob = tree_base[path] if status == "removed" else tree_b[path]
            item = {"filename": path, "status": status, "sha": blob, "changes": changes}
            if previous:
                item["previous_filename"] = previous
            if patch is not None:
                item["patch"] = patch
            out.append(item)
        return out

    def page(self, items, query):
        number = int(query.get("page", ["1"])[0])
        return items[(number - 1) * 100:number * 100]

    def get(self, path):
        self.calls.append(path)
        if self.fail and self.fail in path:
            raise RuntimeError("HTTP 502 for %s" % path)
        head = self.rev(self.branch)
        key = (path, head, self.base, self.changed_files_override)   # a git repository is immutable by sha: the same question at the same tip has the same answer
        self.answers = getattr(self, "answers", {})
        if key not in self.answers:
            self.answers[key] = self._answer(path, head)
        return self.answers[key]

    def _answer(self, path, head):
        route, _, query = path.partition("?")
        query = dict(q.split("=", 1) for q in query.split("&") if q)
        query = {k: [v] for k, v in query.items()}
        parts = route.split("/")                      # repos / owner / repo / ...
        tail = "/".join(parts[3:])
        if tail == "pulls/%d" % self.number:
            files = self.files_between(self.base, head)
            return {"head": {"sha": head}, "base": {"ref": self.base}, "changed_files": self.changed_files_override if self.changed_files_override is not None else len(files)}
        if tail == "pulls/%d/files" % self.number:
            return self.page(self.files_between(self.base, head), query)
        if tail.startswith("compare/"):
            a, b = tail[len("compare/"):].split("...")
            if self.rev(a) == self.rev(b):
                status = "identical"
            elif subprocess.run(["git", "-C", self.dir, "merge-base", "--is-ancestor", a, b]).returncode == 0:
                status = "ahead"
            elif subprocess.run(["git", "-C", self.dir, "merge-base", "--is-ancestor", b, a]).returncode == 0:
                status = "behind"
            else:
                status = "diverged"
            commits = []
            for line in self.git("rev-list", "--parents", "--reverse", "%s..%s" % (a, b)).splitlines():
                sha, *parents = line.split()
                commits.append({"sha": sha, "parents": [{"sha": p} for p in parents]})
            return {"status": status, "total_commits": len(commits), "commits": self.page(commits, query), "files": self.page(self.files_between(a, b), query)}
        if tail.startswith("commits/"):
            sha = tail[len("commits/"):]
            parents = self.git("rev-list", "--parents", "-n", "1", sha).split()[1:]
            files = []
            if parents:
                for line in self.git("diff", "--name-status", parents[0], sha).splitlines():
                    code, path = line.split("\t")[0], line.split("\t")[-1]
                    files.append({"filename": path, "status": {"A": "added", "M": "modified", "D": "removed"}.get(code[0], "modified"), "sha": self.rev("%s:%s" % (sha if code[0] != "D" else parents[0], path))})
            return {"sha": sha, "parents": [{"sha": p} for p in parents], "files": self.page(files, query)}
        raise RuntimeError("the fake GitHub has no answer for %s" % path)


def build_carry_repo(directory):
    """A real git repository (neutral names): `main` with a few files and a `feature` branch whose own change is a.txt edited and c.txt added. Returns the GitHubOverGit over it."""
    directory = Path(directory)
    directory.mkdir(parents=True, exist_ok=True)
    api = GitHubOverGit(directory)
    g = api.git

    def write(path, text):
        target = directory / path
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(text)

    g("init", "-q", "-b", "main")
    g("config", "user.email", "dev@example.test")
    g("config", "user.name", "Dev")
    g("config", "commit.gpgsign", "false")
    write("README.md", "widget api\n")
    write("a.txt", "one\ntwo\nthree\nfour\nfive\nsix\nseven\n")
    write("src/x.py", "def x():\n    return 1\n")
    g("add", "-A")
    g("commit", "-q", "-m", "base")
    g("checkout", "-q", "-b", "feature")
    write("a.txt", "one\nTWO\nthree\nfour\nfive\nsix\nseven\n")
    write("c.txt", "new file\n")
    g("add", "-A")
    g("commit", "-q", "-m", "the change")
    return api


class TestClearCarry(unittest.TestCase):
    """#510: an owner clear carries over a pure merge of main and over nothing else. Every case runs on a REAL git repository (neutral names)."""

    REPO = "acme-org/widget-api"

    def setUp(self):
        self.cc = sb.load_module("clear_carry")
        self.tmp = tempfile.TemporaryDirectory()
        self.addCleanup(self.tmp.cleanup)
        self.dir = Path(self.tmp.name) / "repo"
        self.api = build_carry_repo(self.dir)
        self.cleared = self.api.rev("feature")
        self.fp = self.fingerprint()

    def write(self, path, text, binary=False):
        target = self.dir / path
        target.parent.mkdir(parents=True, exist_ok=True)
        (target.write_bytes if binary else target.write_text)(text)

    def fingerprint(self):
        fingerprint, head, files = self.cc.own_change_fingerprint(self.api.get, self.REPO, 7)
        self.assertEqual(head, self.api.rev("feature"))
        return fingerprint

    def main_moves(self, *names, edit=None):
        g = self.api.git
        g("checkout", "-q", "main")
        for name in names:
            self.write(name, "from main %s\n" % name)
        if edit:
            self.write(*edit)
        g("add", "-A")
        g("commit", "-q", "-m", "main moves")
        g("checkout", "-q", "feature")

    def merge_main(self):
        self.api.git("merge", "-q", "--no-edit", "main")
        return self.api.rev("feature")

    def decide(self, new):
        return self.cc.decide(self.api.get, self.REPO, 7, self.cleared, self.fp, new)

    def test_s1_a_pure_merge_of_main_carries_the_clear_and_the_fingerprint_is_the_original(self):
        self.main_moves("m1.txt", "m2.txt", "m3.txt")
        new = self.merge_main()
        verdict = self.decide(new)
        self.assertEqual((verdict["carried"], verdict["reason"], verdict["fingerprint"], verdict["from"], verdict["to"]), (True, None, self.fp, self.cleared, new))

    def test_s2_a_commit_of_its_own_an_edited_line_an_added_or_a_removed_file_void_the_clear(self):
        g = self.api.git
        for label, change in (("a commit of its own", lambda: (self.write("d.txt", "d\n"), g("add", "-A"), g("commit", "-q", "-m", "own"))),
                              ("an edited line", lambda: (self.write("a.txt", "one\nTWO!\nthree\nfour\nfive\nsix\nseven\n"), g("commit", "-q", "-am", "edit"))),
                              ("an added file", lambda: (self.write("e.txt", "e\n"), g("add", "-A"), g("commit", "-q", "-m", "add"))),
                              ("a removed file", lambda: (g("rm", "-q", "c.txt"), g("commit", "-q", "-m", "remove")))):
            with self.subTest(label):
                g("checkout", "-q", "-B", "feature", self.cleared)
                self.main_moves("m_%s.txt" % label.replace(" ", "_"))
                self.merge_main()
                change()
                verdict = self.decide(self.api.rev("feature"))
                self.assertFalse(verdict["carried"], label)
                self.assertIn("commit of the pull request's own", verdict["reason"])
        # an "evil merge": main merged, and the merge commit itself edits or adds a file
        for label, edit in (("edits a cleared file", lambda: self.write("c.txt", "changed in the merge\n")), ("adds a file", lambda: self.write("d.txt", "sneaked in\n"))):
            with self.subTest(label):
                g("checkout", "-q", "-B", "feature", self.cleared)
                self.main_moves("n_%s.txt" % label.replace(" ", "_"))
                g("merge", "-q", "--no-commit", "--no-ff", "main")
                edit()
                g("add", "-A")
                g("commit", "-q", "-m", "merge main (and more)")
                verdict = self.decide(self.api.rev("feature"))
                self.assertFalse(verdict["carried"], label)
                self.assertIn("relative to both parents", verdict["reason"])

    def test_s3_a_conflict_resolved_by_hand_voids_the_clear_even_though_the_file_list_is_the_same(self):
        g = self.api.git
        self.main_moves(edit=("a.txt", "one\nTWO from main\nthree\nfour\nfive\nsix\nseven\n"))
        done = subprocess.run(["git", "-C", str(self.dir), "merge", "--no-edit", "main"], capture_output=True, text=True)
        self.assertNotEqual(done.returncode, 0, "the merge conflicts in a.txt")
        self.write("a.txt", "one\nTWO resolved by hand\nthree\nfour\nfive\nsix\nseven\n")
        g("add", "-A")
        g("commit", "-q", "-m", "merge main, conflict resolved")
        verdict = self.decide(self.api.rev("feature"))
        self.assertFalse(verdict["carried"])
        self.assertIn("a.txt", verdict["reason"])
        self.assertIn("relative to both parents", verdict["reason"])
        same_files = self.cc.own_change(self.api.get, self.REPO, 7)[0]
        self.assertEqual(sorted(f["path"] for f in same_files), ["a.txt", "c.txt"], "the same two files: only the content check catches it")

    def test_s4_a_rewritten_history_with_the_same_final_diff_is_void(self):
        g = self.api.git
        self.main_moves("m1.txt")
        g("rebase", "-q", "main")
        new = self.api.rev("feature")
        self.assertNotEqual(new, self.cleared)
        self.assertEqual(self.fingerprint(), self.fp, "the rebased pull request has exactly the same own change")
        verdict = self.decide(new)
        self.assertFalse(verdict["carried"])
        self.assertIn("rewritten history", verdict["reason"])

    def test_s5_a_cut_file_list_an_omitted_patch_and_a_read_error_void_the_clear_and_name_what_could_not_be_read(self):
        self.main_moves("m1.txt")
        new = self.merge_main()
        self.api.changed_files_override = 5
        verdict = self.decide(new)
        self.assertFalse(verdict["carried"])
        self.assertIn("cut: GitHub lists 2 of 5 files", verdict["reason"])
        self.api.changed_files_override = None
        self.api.fail = "/compare/"
        verdict = self.decide(new)
        self.assertFalse(verdict["carried"])
        self.assertIn("could not be read", verdict["reason"])
        self.api.fail = None
        g = self.api.git
        g("checkout", "-q", "-B", "feature", self.cleared)
        self.write("blob.dat", bytes(range(256)) * 4, binary=True)
        g("add", "-A")
        g("commit", "-q", "-m", "binary")
        with self.assertRaises(self.cc.CarryVoid) as raised:
            self.cc.own_change_fingerprint(self.api.get, self.REPO, 7)
        self.assertIn("patch of blob.dat is omitted", str(raised.exception))
        binary_cleared = self.api.rev("feature")
        self.main_moves("m2.txt")
        merged = self.merge_main()
        verdict = self.cc.decide(self.api.get, self.REPO, 7, binary_cleared, "sha256:" + "0" * 64, merged)
        self.assertFalse(verdict["carried"])
        self.assertIn("omitted", verdict["reason"])
        verdict = self.cc.decide(self.api.get, self.REPO, 7, self.cleared, None, new)
        self.assertEqual((verdict["carried"], verdict["reason"]), (False, "no fingerprint was recorded with the clear"))
        self.assertFalse(self.cc.decide(self.api.get, self.REPO, 7, self.cleared, "not-a-hash", new)["carried"])

    def test_a_merge_of_a_side_branch_a_retargeted_base_and_a_head_that_moves_mid_read_all_void(self):
        g = self.api.git
        g("checkout", "-q", "-b", "side", self.cleared)
        self.write("side.txt", "side\n")
        g("add", "-A")
        g("commit", "-q", "-m", "side")
        g("checkout", "-q", "feature")
        g("merge", "-q", "--no-ff", "--no-edit", "side")
        verdict = self.decide(self.api.rev("feature"))
        self.assertFalse(verdict["carried"])
        self.assertIn("not on main", verdict["reason"])
        g("checkout", "-q", "-B", "feature", self.cleared)
        self.main_moves("m1.txt")
        new = self.merge_main()
        self.assertTrue(self.decide(new)["carried"])
        g("branch", "release", self.cleared)
        self.api.base = "release"
        self.assertFalse(self.decide(new)["carried"], "a retargeted base is a different change")
        self.api.base = "main"
        calls = {"n": 0}
        real = self.cc.pull_head

        def moving(get, repo, number):
            calls["n"] += 1
            head, pull = real(get, repo, number)
            return (head if calls["n"] == 1 else "0" * 40), pull
        self.cc.pull_head = moving
        self.addCleanup(setattr, self.cc, "pull_head", real)
        self.assertFalse(self.decide(new)["carried"])

    def test_s6_successive_merges_are_each_compared_with_the_original_and_an_own_change_makes_the_next_void(self):
        g = self.api.git
        carried = []
        for n in (1, 2, 3):
            self.main_moves("m%d.txt" % n)
            carried.append(self.decide(self.merge_main())["carried"])   # each decided when it is the current head, against the ORIGINAL cleared head and fingerprint
        self.assertEqual(carried, [True, True, True], "three merges, three carries")
        self.write("a.txt", "one\nTWO\nthree\nfour\nfive\nsix\nSEVEN\n")
        g("commit", "-q", "-am", "own change after the second merge")
        self.main_moves("m4.txt")
        fourth = self.merge_main()
        verdict = self.decide(fourth)
        self.assertFalse(verdict["carried"], "a change of its own after a carry makes every later head void")

    def test_a_pure_merge_whose_own_change_is_not_the_one_cleared_is_void_at_the_last_check_and_each_merge_is_compared_with_the_original(self):
        g = self.api.git
        self.main_moves("m1.txt")
        new = self.merge_main()
        wrong = "sha256:" + "1" * 64
        verdict = self.cc.decide(self.api.get, self.REPO, 7, self.cleared, wrong, new)
        self.assertFalse(verdict["carried"], "the merge chain and the merges are clean: only the fingerprint comparison can refuse this")
        self.assertIn("is not the one the owner cleared", verdict["reason"])
        self.assertEqual(verdict["fingerprint"], self.fp, "the verdict carries the fingerprint it computed, for the audit")
        # drift: a pure merge whose own change differs from the ORIGINAL but equals the PREVIOUS head's is still void
        self.assertTrue(self.cc.decide(self.api.get, self.REPO, 7, self.cleared, self.fp, new)["carried"])
        previous_fp = self.fingerprint()
        self.assertEqual(previous_fp, self.fp)
        drifted = "sha256:" + "2" * 64            # what a build comparing with an earlier carried head would hold after a small change slipped in
        self.main_moves("m2.txt")
        second = self.merge_main()
        self.assertFalse(self.cc.decide(self.api.get, self.REPO, 7, self.cleared, drifted, second)["carried"])

    def test_a_pure_rename_and_a_renamed_and_edited_file_carry_over_a_merge_and_an_edit_after_the_clear_does_not(self):
        g = self.api.git
        g("checkout", "-q", "-B", "feature", "main")
        g("mv", "src/x.py", "src/y.py")
        g("commit", "-q", "-m", "rename")
        cleared = self.api.rev("feature")
        files, _, _ = self.cc.own_change(self.api.get, self.REPO, 7)
        self.assertEqual([(f["path"], f["status"], f["previous"]) for f in files], [("src/y.py", "renamed", "src/x.py")])
        fp = self.fingerprint()
        self.main_moves("m1.txt")
        new = self.merge_main()
        self.assertTrue(self.cc.decide(self.api.get, self.REPO, 7, cleared, fp, new)["carried"], "a pure rename's blob id pins its content")
        # a rename that is also edited carries too (its patch is present and pinned); an edit AFTER the clear does not
        g("checkout", "-q", "-B", "feature", "main")
        g("mv", "src/x.py", "src/z.py")
        self.write("src/z.py", "def x():\n    return 2\n")
        g("add", "-A")
        g("commit", "-q", "-m", "rename and edit")
        edited = self.api.rev("feature")
        edited_fp = self.fingerprint()
        self.main_moves("m2.txt")
        merged = self.merge_main()
        self.assertTrue(self.cc.decide(self.api.get, self.REPO, 7, edited, edited_fp, merged)["carried"])
        self.write("src/z.py", "def x():\n    return 3\n")
        g("commit", "-q", "-am", "edit after the clear")
        self.main_moves("m3.txt")
        verdict = self.cc.decide(self.api.get, self.REPO, 7, edited, edited_fp, self.merge_main())
        self.assertFalse(verdict["carried"])
        self.assertIn("commit of the pull request's own", verdict["reason"])

    def test_s8_there_is_one_fingerprint_function_and_the_carry_code_holds_no_path_or_class_literal(self):
        import ast
        main = Path(sb.__file__).read_text() + "\n" + (Path(sb.__file__).parent / "impact_hold.py").read_text()   # #532: the clear's wrapper moved to bin/impact_hold.py, still "the switchboard's" code
        module = Path(sb.__file__).parent / "clear_carry.py"
        text = module.read_text()
        defs = [n.name for src in (main, text) for n in ast.walk(ast.parse(src)) if isinstance(n, ast.FunctionDef) and "fingerprint" in n.name]
        self.assertEqual(sorted(defs), ["clear_fingerprint", "fingerprint_of", "own_change_fingerprint"], "one computation (fingerprint_of), one entry point (own_change_fingerprint) and the clear's wrapper")
        calls = [n for n in ast.walk(ast.parse(main)) if isinstance(n, ast.Call) and getattr(n.func, "attr", None) == "own_change_fingerprint"]
        self.assertEqual(len(calls), 1, "the clear's wrapper is the only caller in the switchboard; the carry's decide calls the same function inside the module")
        imports = sorted(a.name for n in ast.walk(ast.parse(text)) if isinstance(n, ast.Import) for a in n.names)
        self.assertEqual(imports, ["hashlib", "json"], "the carry imports no floor, glob or class code: it decides from GitHub's answers alone")


class TestConflictCarry(unittest.TestCase):
    """#815: an owner clear carries over a merge of main whose conflict was resolved by hand, only on unchanged added and removed LINES, with no protected path touched and a confirmation. Real git."""

    REPO = "acme-org/widget-api"
    RESOLVED = "zero\none\nTWO\nTHREE\nfour\nfive\nsix\nseven\n"

    def setUp(self):
        self.cc = sb.load_module("clear_carry")
        self.tmp = tempfile.TemporaryDirectory()
        self.addCleanup(self.tmp.cleanup)
        self.dir = Path(self.tmp.name) / "repo"
        self.api = build_carry_repo(self.dir)
        self.base_main = self.api.rev("main")
        self.arm()

    def arm(self):
        self.cleared = self.api.rev("feature")
        self.fp = self.cc.own_change_fingerprint(self.api.get, self.REPO, 7)[0]
        self.lfp = self.cc.own_change_fingerprint(self.api.get, self.REPO, 7, lines=True)[0]

    def write(self, path, text):
        target = self.dir / path
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(text)

    def conflict_merge(self, resolved=None, main_files=(), after=None):
        """Main edits the line next to the pull request's (a real conflict) and moves the file down; the merge is resolved by hand. `after()` may change more before the merge commit."""
        g = self.api.git
        g("checkout", "-q", "main")
        self.write("a.txt", "zero\none\ntwo\nTHREE\nfour\nfive\nsix\nseven\n")
        for path in main_files:
            self.write(path, "from main\n")
        g("add", "-A")
        g("commit", "-q", "-m", "main moves")
        g("checkout", "-q", "feature")
        self.assertNotEqual(subprocess.run(["git", "-C", str(self.dir), "merge", "--no-commit", "--no-ff", "main"], capture_output=True).returncode, 0, "the fixture must really conflict")
        self.write("a.txt", resolved or self.RESOLVED)
        if after:
            after()
        g("add", "-A")
        g("commit", "-q", "-m", "merge main, conflict resolved")
        return self.api.rev("feature")

    def decide(self, new, confirm=lambda head: "ledger entry 1", protected="table", lines=True):
        return self.cc.decide(self.api.get, self.REPO, 7, self.cleared, self.fp, new, lines_fingerprint=self.lfp if lines else None, confirm=confirm,
                              protected=sb.impact_floor.carry_never_paths() if protected == "table" else protected)

    def test_s1_a_conflict_resolved_by_hand_with_the_lines_unchanged_carries_only_through_the_lines_route(self):
        new = self.conflict_merge()
        pure = self.cc.decide(self.api.get, self.REPO, 7, self.cleared, self.fp, new)
        self.assertFalse(pure["carried"], "the pure route refuses it, as before")
        self.assertIn("both parents", pure["reason"])
        verdict = self.decide(new)
        self.assertEqual((verdict["carried"], verdict["route"], verdict["reason"], verdict["confirmation"], verdict["from"], verdict["to"], verdict["lines_fingerprint"]),
                         (True, "lines", None, "ledger entry 1", self.cleared, new, self.lfp))

    def test_the_lines_fingerprint_ignores_context_and_line_numbers_and_sees_every_added_or_removed_line(self):
        patch = "@@ -1,3 +1,3 @@\n one\n-two\n+TWO\n three"
        moved = "@@ -40,5 +41,5 @@\n zero\n one\n-two\n+TWO\n THREE\n four"
        self.assertEqual(self.cc.changed_lines(patch), ["-two", "+TWO"])
        self.assertEqual(self.cc.changed_lines(patch), self.cc.changed_lines(moved))
        for other in ("@@ -1,3 +1,3 @@\n one\n-two\n+TWO!\n three", "@@ -1,3 +1,3 @@\n one\n-twp\n+TWO\n three", "@@ -1,3 +1,3 @@\n one\n+TWO\n three", "@@ -1,3 +1,4 @@\n one\n-two\n+TWO\n+x\n three"):
            self.assertNotEqual(self.cc.changed_lines(patch), self.cc.changed_lines(other), other)
        self.assertEqual(self.cc.changed_lines("@@ -1 +1 @@\n-a\n\\ No newline at end of file\n+b"), ["-a", "\\ No newline at end of file", "+b"])
        self.assertEqual(self.cc.changed_lines("@@ -1 +1 @@\n a\n\\ No newline at end of file\n-b\n+c"), ["-b", "+c"], "a marker after a context line is about the surroundings")

    def test_s2_one_added_or_removed_line_that_differs_is_refused_and_so_is_a_commit_of_its_own(self):
        def edit(path, text):
            return lambda: self.write(path, text)
        cases = (("an added line edited", dict(resolved=self.RESOLVED.replace("TWO\n", "TWO!\n")), "a.txt"),
                 ("a removed line kept", dict(resolved=self.RESOLVED.replace("TWO\n", "two\nTWO\n")), "a.txt"),
                 ("the change dropped", dict(resolved=self.RESOLVED.replace("TWO", "two")), "a.txt"),
                 ("a line added by the resolution", dict(resolved=self.RESOLVED + "extra\n"), "a.txt"),
                 ("the added file edited", dict(after=edit("c.txt", "new file edited\n")), "c.txt"),
                 ("the added file dropped", dict(after=lambda: self.api.git("rm", "-q", "-f", "c.txt")), "c.txt"),
                 ("a file added by the resolution", dict(after=edit("d.txt", "sneaked in\n")), "d.txt"))
        for label, kwargs, named in cases:
            with self.subTest(label):
                g = self.api.git
                g("checkout", "-q", "-B", "feature", self.cleared)
                g("branch", "-q", "-f", "main", self.base_main)
                verdict = self.decide(self.conflict_merge(**kwargs))
                self.assertFalse(verdict["carried"], label)
                self.assertEqual(verdict["route"], None, label)
                self.assertIn("differs", verdict["reason"], label)
                self.assertFalse(verdict["waiting"], "a changed line is not a missing confirmation: %s" % label)
        g = self.api.git
        g("checkout", "-q", "-B", "feature", self.cleared)
        g("branch", "-q", "-f", "main", self.base_main)
        new = self.conflict_merge()
        self.write("e.txt", "own\n")
        g("add", "-A")
        g("commit", "-q", "-m", "own")
        verdict = self.decide(self.api.rev("feature"))
        self.assertFalse(verdict["carried"])
        self.assertIn("commit of the pull request's own", verdict["reason"])

    def test_s3_every_member_of_the_table_is_refused_when_a_merge_touches_it_or_the_pull_request_changes_it(self):
        table = sb.impact_floor.carry_never_paths()
        self.assertGreaterEqual(len(table), 4)
        for path in table:
            for how in ("a merge touches it", "the pull request's own change touches it"):
                with self.subTest(path=path, how=how):
                    self.tearDown_repo()
                    g = self.api.git
                    if how.startswith("the pull"):
                        self.write(path, "own change\n")
                        g("add", "-A")
                        g("commit", "-q", "-m", "own change in a protected path")
                    self.arm()
                    verdict = self.decide(self.conflict_merge(main_files=([path] if not how.startswith("the pull") else [])))
                    self.assertFalse(verdict["carried"], (path, how))
                    self.assertIn("never carried", verdict["reason"], (path, how))
                    self.assertFalse(verdict["waiting"])

    def tearDown_repo(self):
        shutil.rmtree(str(self.dir))
        self.api = build_carry_repo(self.dir)

    def test_a_protected_path_is_matched_in_any_case_and_spelling(self):
        for spelled in ("BIN/Impact_Hold.py", "./bin/impact_hold.py", "bin\\impact_hold.py", "/bin/impact_hold.py"):
            self.assertEqual(self.cc._norm(spelled), "bin/impact_hold.py", spelled)
        self.assertEqual(self.cc._norm(".github/x"), ".github/x", "a leading dot of a name is not a ./ prefix")

    def test_a_rename_away_from_a_protected_path_and_an_odd_spelling_are_refused_through_decide(self):
        g = self.api.git
        g("checkout", "-q", "main")
        self.write("bin/impact_hold.py", "x = 1\n")
        g("add", "-A")
        g("commit", "-q", "-m", "main gets the file")
        self.base_main = self.api.rev("main")
        g("checkout", "-q", "feature")
        g("merge", "-q", "--no-edit", "main")
        g("mv", "bin/impact_hold.py", "bin/other_name.py")
        g("commit", "-q", "-m", "the pull request renames it away")
        self.arm()
        verdict = self.decide(self.conflict_merge())
        self.assertFalse(verdict["carried"], "the rename's previous path is a protected path")
        self.assertIn("impact_hold.py", verdict["reason"])
        self.tearDown_repo()
        self.base_main = self.api.rev("main")
        self.arm()
        verdict = self.decide(self.conflict_merge(main_files=["BIN/Impact_Hold.py"]))
        self.assertFalse(verdict["carried"], "an odd spelling is the same path")
        self.assertIn("never carried", verdict["reason"])

    def test_the_table_is_the_clear_code_the_matrix_names_and_every_clear_or_hold_module(self):
        table = set(sb.impact_floor.carry_never_paths())
        root = Path(sb.__file__).resolve().parent.parent
        matrix = json.loads((root / "docs/review-laws/impact-matrix.json").read_text())
        listed = set(matrix["owner_hold"]["delegated_clear"]["clear_code_paths"]) if "owner_hold" in matrix else set(matrix["delegated_clear"]["clear_code_paths"])
        self.assertEqual(sorted(table - listed), [], "every protected path is one the matrix lists as the clear's own code")
        exact = {x for x in listed if "*" not in x}
        self.assertEqual(sorted(exact - table), [], "every exact path the matrix lists as the clear's own code is never carried (plan_ledger decides who may confirm)")
        left_out = sorted(listed - table)
        self.assertTrue(all("*" in x for x in left_out), "only the directory globs are left out, on purpose: %s" % left_out)
        for path in table:
            self.assertTrue((root / path).exists(), path)
        named = {"bin/%s" % p.name for p in (root / "bin").glob("*.py") if re.search(r"clear|hold|floor", p.name)}
        self.assertEqual(sorted(named - table), [], "a bin module named for the clear, the hold or the floor is in the table")
        self.assertIn("docs/review-laws/impact-matrix.json", table)

    def test_s4_the_confirmation_is_asked_for_exactly_this_head_and_an_empty_answer_leaves_the_carry_waiting(self):
        new = self.conflict_merge()
        asked = []
        for label, confirm in (("none", lambda head: None), ("empty", lambda head: ""), ("a void", lambda head: (_ for _ in ()).throw(self.cc.CarryVoid("no confirmation at this head")))):
            verdict = self.decide(new, confirm=lambda head, c=confirm: (asked.append(head), c(head))[1])
            self.assertFalse(verdict["carried"], label)
            self.assertTrue(verdict["waiting"], label)
            self.assertIn("no confirmation", verdict["reason"], label)
        self.assertEqual(set(asked), {new})
        self.assertFalse(self.decide(new, confirm=None)["carried"], "no confirmation source: refused")
        self.assertFalse(self.decide(new, lines=False)["carried"], "a clear with no lines fingerprint: refused")

    def test_s3_no_table_given_refuses_the_conflict_route(self):
        new = self.conflict_merge()
        for protected in (None, (), []):
            self.assertFalse(self.decide(new, protected=protected)["carried"], repr(protected))

    def test_u2_a_cut_omitted_or_unreadable_input_refuses_the_carry(self):
        new = self.conflict_merge(after=lambda: (self.dir / "b.bin").write_bytes(b"\x00\x01\xff\xfe" * 8))
        verdict = self.decide(new)
        self.assertFalse(verdict["carried"], "an omitted patch (a binary file) is never read as unchanged")
        g = self.api.git
        g("checkout", "-q", "-B", "feature", self.cleared)
        g("branch", "-q", "-f", "main", self.base_main)
        new = self.conflict_merge()
        self.assertTrue(self.decide(new)["carried"], "control: the same merge without the binary file carries")
        for label, setup in (("the file list is cut", lambda: setattr(self.api, "changed_files_override", 99)), ("a read fails", lambda: setattr(self.api, "fail", "/files"))):
            with self.subTest(label):
                setup()
                self.addCleanup(setattr, self.api, "changed_files_override", None)
                self.addCleanup(setattr, self.api, "fail", None)
                verdict = self.decide(new)
                self.assertFalse(verdict["carried"], label)
                self.assertTrue(verdict["reason"], label)
                self.api.changed_files_override, self.api.fail = None, None
        # the head moves while it is read
        real = self.api.get
        moved = []

        def get(path):
            answer = real(path)
            if path.endswith("pulls/7/files?per_page=100&page=1") and not moved:
                moved.append(1)
                self.api.git("commit", "-q", "--allow-empty", "-m", "moved")
            return answer
        self.api.get = get
        self.assertFalse(self.decide(new)["carried"])


class TestClearMarker(Base):
    """#522: the owner's clear also changes the first line `MERGE: captain` of the body to `MERGE: automatic`, through ONE shared function, never on a carry, never undoing the clear."""

    REPO, PR = "acme-org/widget-api", "acme-org/widget-api#7"
    HEAD = "a" * 40
    BODY = "MERGE: captain\r\n\r\nPLAN: x\nMERGE: captain (quoted later)\n\ttail  \n"

    def setUp(self):
        super().setUp()
        self.world = World(self, agents=("cos",), config={"gh": FAKE_GH, "impact_hold": {"enabled": True}})
        self.engine = self.world.new_engine("daemon")
        self.engine.gh_runner, self.engine.state_dir = self.route, self.world.state
        self.names = sb.label_names(self.engine.config)
        self.body, self.head, self.writes, self.reads = self.BODY, self.HEAD, [], 0
        self.read_fails, self.write_fails, self.change_between = False, False, None
        self.labels = [self.names["merge-captain"], self.names["hold-impact"]]

    def route(self, argv, **kwargs):
        if argv[0] == FAKE_GH and argv[1:3] == ["pr", "view"]:
            if self.read_fails:
                return subprocess.CompletedProcess(argv, 1, "", "HTTP 502")
            raw = {"state": "OPEN", "headRefOid": self.head, "title": "t", "labels": [{"name": n} for n in self.labels], "body": self.body}
            self.reads = getattr(self, "reads", 0) + 1
            if self.change_between is not None and self.reads == 1:   # the clear's own read (which the edit reuses) is the first: the re-read before the write sees another body
                self.body, self.change_between = self.change_between, None
            return subprocess.CompletedProcess(argv, 0, json.dumps(raw), "")
        if argv[0] == FAKE_GH and argv[1] == "api" and "--method" in argv:
            method = argv[argv.index("--method") + 1]
            if method == "PATCH":
                if self.write_fails:
                    return subprocess.CompletedProcess(argv, 1, "", "HTTP 403")
                self.writes.append(json.loads(kwargs["input"])["body"])
                self.body = self.writes[-1]
                return subprocess.CompletedProcess(argv, 0, "{}", "")
            if method == "DELETE":
                self.labels = [l for l in self.labels if not argv[2].endswith("/" + urllib.parse.quote(l, safe=""))]
            return subprocess.CompletedProcess(argv, 0, "{}", "")
        return self.world.route(argv, **kwargs)

    def clear(self, **kwargs):
        return sb.impact_clear_core(self.engine, self.route, self.REPO, 7, "owner", "a false hold: it is a fixture", **kwargs)

    def events(self, name):
        return [e for e in self.world.audit() if e["event"] == name]

    def test_s1_s8_the_clear_changes_only_the_first_line_and_every_other_byte_stays(self):
        lines = self.clear()
        self.assertEqual(self.body, "MERGE: automatic\r\n\r\nPLAN: x\nMERGE: captain (quoted later)\n\ttail  \n")
        self.assertEqual(len(self.writes), 1)
        self.assertIn("changed the first line of the body of %s from MERGE: captain to MERGE: automatic" % self.PR, lines)
        self.assertNotIn(self.names["hold-impact"], self.labels)

    def test_s2_the_chat_clear_goes_through_the_same_shared_function(self):
        calls = []
        real = sb.neutralise_marker
        sb.neutralise_marker = lambda *a, **k: (calls.append(a), real(*a, **k))[1]
        self.addCleanup(setattr, sb, "neutralise_marker", real)
        self.clear(remove=[self.names["hold-impact"], self.names["merge-captain"]], head=self.HEAD, via="chat:m1")
        self.assertEqual(len(calls), 1)
        self.assertTrue(self.body.startswith("MERGE: automatic"))

    def test_s3_a_body_whose_first_line_is_not_the_marker_is_not_written(self):
        for body in ("Title\nMERGE: captain\n", "", "MERGE: automatic\n", "\n\nMERGE: captainship\n"):
            self.body, self.writes = body, []
            self.assertEqual(sb.marker_edit(body) is None, True, body)
            self.clear()
            self.assertEqual((self.writes, self.body), ([], body))

    def test_a_blank_lines_before_the_marker_are_kept_and_the_first_non_empty_line_is_the_one(self):
        self.body = "\n  \nMERGE: captain\nrest"
        self.clear()
        self.assertEqual(self.body, "\n  \nMERGE: automatic\nrest")

    def test_s4_one_audit_line_holds_the_head_and_both_versions_of_the_line(self):
        self.clear()
        (line,) = self.events("gate.clear_marker")
        self.assertEqual(line["detail"], {"head": self.HEAD, "before": "MERGE: captain", "after": "MERGE: automatic"})

    def test_s5_a_body_that_cannot_be_read_or_written_or_changed_meanwhile_leaves_the_clear_standing_and_says_so(self):
        for label, arrange in (("read", lambda: setattr(self, "read_fails", True)),
                               ("write", lambda: setattr(self, "write_fails", True)),
                               ("changed", lambda: setattr(self, "change_between", "MERGE: captain\nan edit by someone\n"))):
            self.setUp()
            arrange()
            if label == "read":
                self.read_fails = False   # the clear itself reads the PR; only the body edit's reads fail
                real = sb.read_pr_json
                count = {"n": 0}

                def flaky(*a, **k):
                    count["n"] += 1
                    if count["n"] > 1:
                        raise sb.NoticeError("gh pr view failed: HTTP 502")
                    return real(*a, **k)
                sb.read_pr_json = flaky
                self.addCleanup(setattr, sb, "read_pr_json", real)
            lines = self.clear()
            self.assertTrue(any("marker line remains" in l for l in lines), (label, lines))
            self.assertEqual(self.writes, [], label)
            self.assertNotIn(self.names["hold-impact"], self.labels, "the clear stands: " + label)
            self.assertEqual(len(self.events("gate.clear_marker_failed")), 1, label)
            self.assertEqual(self.events("gate.clear_marker"), [])
            if label == "read":
                sb.read_pr_json = real

    def test_s6_no_clear_no_edit_and_a_head_that_is_not_the_cleared_one_is_refused_before_any_write(self):
        self.assertEqual(self.writes, [])
        report = {"pr": self.PR, "head": self.HEAD, "reasons": ["a floor path"], "floor_paths": ["x"], "globs": ["x"]}
        sb.apply_impact_hold(self.engine, self.REPO, 7, report, {"labels": []})
        self.assertEqual(self.writes, [], "the daemon's hold pass never edits a body")
        with self.assertRaises(sb.NoticeError):
            self.clear(head="b" * 40, remove=[self.names["hold-impact"]])
        self.assertEqual((self.writes, self.body), ([], self.BODY))
        self.assertEqual(sb.neutralise_marker(self.engine, self.route, self.REPO, 7, "c" * 40), [], "a head the owner did not clear is not touched")
        self.assertEqual(self.writes, [])

    def test_a_failing_audit_after_the_write_never_fails_the_clear_and_says_what_is_true(self):
        real = self.engine.audit.append

        def append(actor, event, *rest, **kw):
            if event == "gate.clear_marker":
                raise OSError("disk full")
            return real(actor, event, *rest, **kw)
        self.engine.audit.append = append
        lines = self.clear()
        self.assertTrue(self.body.startswith("MERGE: automatic"))
        self.assertNotIn(self.names["hold-impact"], self.labels)
        self.assertEqual(self.events("gate.clear_marker"), [])
        self.assertFalse(any("marker line remains" in l for l in lines), lines)
        self.assertTrue(any("audit line of that change could not be written" in l for l in lines), lines)

    def test_the_text_of_the_line_is_printed_as_one_line_without_control_characters(self):
        self.body = "MERGE: captain\x1b[31m red\x07 bell\nrest\n"
        lines = self.clear()
        self.assertFalse(any(re.search(r"[\x00-\x08\x0b-\x1f\x7f]", l) for l in lines), lines)
        self.assertTrue(self.body.startswith("MERGE: automatic\x1b[31m red"), "the body keeps its bytes: only the printed text is cleaned")

    def test_a_head_that_moves_between_the_two_reads_and_a_write_that_does_not_stick_are_both_said(self):
        real = sb.read_pr_json
        count = {"n": 0}

        def moving(*a, **k):
            count["n"] += 1
            raw = real(*a, **k)
            if count["n"] == 2:
                raw = dict(raw, headRefOid="d" * 40)
            return raw
        sb.read_pr_json = moving
        self.addCleanup(setattr, sb, "read_pr_json", real)
        lines = self.clear()
        self.assertTrue(any("marker line remains" in l for l in lines), lines)
        self.assertEqual(self.writes, [])
        sb.read_pr_json = real
        self.setUp()
        route = self.route

        def drops(argv, **kwargs):
            if argv[1] == "api" and "PATCH" in argv:
                return subprocess.CompletedProcess(argv, 0, "{}", "")   # said fine, never stored
            return route(argv, **kwargs)
        self.engine.gh_runner = drops
        lines = sb.impact_clear_core(self.engine, drops, self.REPO, 7, "owner", "a false hold: it is a fixture")
        self.assertTrue(any("marker line remains" in l and "read back" in l for l in lines), lines)
        self.assertEqual(self.body, self.BODY)

    def test_the_marker_edit_is_pure_and_follows_the_gates_own_reading(self):
        for body in ("MERGE: captain", "  MERGE: captain: pending\nx", "\n\nMERGE: captain\r\nMERGE: captain\r\n"):
            new, before, after = sb.marker_edit(body)
            self.assertEqual(sb.pr_marker(new), "automatic", body)
            self.assertEqual(len(new.splitlines()), len(body.splitlines()))
            self.assertEqual(after, before.replace("MERGE: captain", "MERGE: automatic"))
            self.assertEqual(new.replace("MERGE: automatic", "MERGE: captain", 1), body)
        self.assertIsNone(sb.marker_edit(None))
        self.assertFalse(sb.pr_marker_state([], sb.marker_edit("MERGE: captain\n")[0], now=0)["captain"])


class CharterRig:
    """The shared setUp and helpers of the charter classes (a mixin, so a class that only needs the rig does not re-run another class's tests)."""

    REPO = "acme-org/widget-api"

    def setUp(self):
        super().setUp()
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "gh": FAKE_GH, "intent_repo": self.REPO})
        self.world = World(self, agents=(), config={"gh": FAKE_GH, "impact_hold": {"enabled": True}})
        self.world.add_agent("cos", fleet={"role": "chief-of-staff"})
        self.engine = self.world.new_engine("daemon")
        self.engine.state_dir = self.world.state
        self.registry = sb.load_module("registry")
        self.parents = {3: 1, 4: 1, 5: 4, 9: 1, 1: None}
        self.engine.intents = types.SimpleNamespace(parent=lambda number, repo=None: self.parents.get(number), repo=self.REPO, header=lambda *a, **k: None)
        patcher = mock.patch.object(sb.IntentReader, "parent", lambda reader, number, repo=None: self.parents[number])   # #1143: the command's guard reads the same parents
        patcher.start()
        self.addCleanup(patcher.stop)


    def orchestrator(self, name, charter=None, issue=None, registry=True):
        """A running orchestrator whose live SESSION metadata says `charter` and `issue`; its registry row (the first-seen fill the pass makes) holds the metadata charter unless `registry` is a value or False."""
        fleet = {"role": "orchestrator", "repo": self.REPO}
        if charter is not None:
            fleet["charter"] = charter
        if issue is not None:
            fleet["issue"] = issue
        sid = self.world.add_agent(name, fleet=fleet)   # (the harness fills the registry row from the metadata charter, as the pass does for a first-seen agent)
        row = self.registry.read(self.world.state)["agents"].get(name)
        if row is None:
            self.registry.upsert(self.world.state, name, {"session": sid, "pane": self.world.panes[name], "role": "orchestrator", "charter": None, "repo": self.REPO})
        if registry is not True:
            self.set_registry(name, registry)

    def set_registry(self, name, charter):
        got = self.registry.set_charter(self.world.state, name, charter, "test")
        self.assertIsNone(got["problem"], got)

    def lane(self, number=1):
        agents = self.engine.discover(self.world.clock.now()).agents
        orchestrators = {n: a for n, a in agents.items() if (a.fleet or {}).get("role") == "orchestrator"}
        return sb._lane_of_issue(self.engine, self.REPO, 3 if number == 1 else number, orchestrators)

    def run_as(self, who, *argv):
        if who is None:
            os.environ.pop("HERDR_PANE_ID", None)
        else:
            os.environ["HERDR_PANE_ID"] = self.world.panes[who]
        with captured() as (out, err):
            code = sb.main(list(argv), runner=self.world.route, now=self.world.clock.now, wait=lambda sock, seconds: False, socket_call=self.world.herdr.socket)
        return code, out.getvalue(), err.getvalue()


    def row(self, name):
        return self.registry.read(self.world.state)["agents"][name]


class TestOneCharter(CharterRig, Base):
    """#969: an orchestrator's charter is the registry row's `charter`, the one record; the lane lookup reads it and the live session's metadata (written once at launch) is never a second owner. Every test
    drives the REAL lookups (`_lane_of_issue`, `lanes.charter_orchestrators`) over the REAL registry module and the real discovery of the fake service."""

    # the shapes of a lookup: how the registry and the session metadata name charter 1, and what the lookup says. One table, driven row by row.
    def shape_session_issue_only(self):
        self.orchestrator("orch-a", charter=1)
        self.orchestrator("orch-b", charter=2, issue=1, registry=None)   # the real case: its metadata `issue` is orch-a's charter; its registry row has no charter

    def shape_session_charter_only(self):
        self.orchestrator("orch-a", charter=1)
        self.orchestrator("orch-b", charter=1, registry=None)   # its metadata charter says 1 too; the registry row has none

    def shape_registry_two(self):
        self.orchestrator("orch-a", charter=1)
        self.orchestrator("orch-b", charter=1)

    def shape_no_orchestrator(self):
        self.orchestrator("orch-a", charter=2)

    def shape_metadata_only_no_registry_owner(self):
        self.orchestrator("orch-a", charter=1, registry=None)   # the session says 1, the registry gives it to nobody: the lookup is no more generous than the registry

    def shape_one(self):
        self.orchestrator("orch-a", charter=1)
        self.orchestrator("orch-b", charter=2)

    SHAPES = {   # shape name -> expected lookup result (a one-owner result, a many result with both names, or None)
        "session_issue_only": ("one", "orch-a"),
        "session_charter_only": ("one", "orch-a"),
        "registry_two": ("many", ["orch-a", "orch-b"], 1),
        "no_orchestrator": None,
        "metadata_only_no_registry_owner": None,
        "one": ("one", "orch-a"),
    }

    def test_every_shape_of_the_lookup_says_what_the_registry_says(self):
        for name, expected in self.SHAPES.items():
            with self.subTest(shape=name):
                self.setUp()
                getattr(self, "shape_" + name)()
                found = self.lane()
                self.assertEqual(found, expected)

    def test_the_shapes_table_has_every_shape_method(self):
        methods = {n[len("shape_"):] for n in dir(self) if n.startswith("shape_")}
        self.assertEqual(methods, set(self.SHAPES))

    def test_an_unreadable_registry_gives_no_lane(self):
        self.shape_one()
        (Path(self.world.state) / "registry.json").write_text("{not json")
        self.assertIsNone(self.lane())

    def test_the_metadata_of_a_session_is_not_read_for_a_lane_even_when_the_registry_has_no_row(self):
        self.world.add_agent("orch-a", fleet={"role": "orchestrator", "charter": 1, "repo": self.REPO})
        (Path(self.world.state) / "registry.json").unlink()   # no row at all: the metadata must not stand in for it
        self.assertIsNone(self.lane())

    def test_charter_orchestrators_of_move_reads_the_registry_too(self):
        lanes = sb.load_module("lanes")
        namespace = types.SimpleNamespace(engine=self.engine, **{n: getattr(sb, n) for n in lanes.NEEDS})
        for name, expected in (("session_issue_only", ["orch-a"]), ("session_charter_only", ["orch-a"]), ("registry_two", []), ("no_orchestrator", []), ("one", ["orch-a"])):
            with self.subTest(shape=name):
                self.setUp()
                getattr(self, "shape_" + name)()
                namespace.engine = self.engine
                discovery = self.engine.discover(self.world.clock.now())
                self.assertEqual(lanes.charter_orchestrators(namespace, discovery, self.REPO, 1), expected)

    # -- the pass: the registry keeps its charter, a first-seen agent takes the launch value, a disagreement is said once

    def health(self):
        self.engine.discover(self.world.clock.now())
        sb.pane_health_pass(self.engine, self.world.clock.now())

    def test_the_pass_keeps_a_corrected_charter_fills_a_first_seen_agent_and_says_a_disagreement_once(self):
        self.orchestrator("orch-b", charter=1)           # first seen: the launch value is the row's
        self.assertEqual(self.row("orch-b")["charter"], 1)
        self.set_registry("orch-b", 7)                   # corrected through the command
        for _ in range(3):
            self.health()
        self.assertEqual(self.row("orch-b")["charter"], 7, "the pass must not copy the session's metadata over the registry")
        said = [e for e in self.world.audit() if e["event"] == "charter.disagree"]
        self.assertEqual(len(said), 1)
        self.assertEqual((said[0]["subject"], said[0]["detail"]["session_charter"]), ("orch-b", 1))
        self.world.add_agent("orch-new", fleet={"role": "orchestrator", "charter": 9, "repo": self.REPO})
        (Path(self.world.state) / "registry.json").write_text(json.dumps({"version": 1, "agents": {}, "retired": {}}))
        self.health()
        self.assertEqual(self.row("orch-new")["charter"], 9, "a first-seen agent takes its launch value")

    def test_a_disagreement_is_said_once_per_agent_and_value_by_the_helper_itself(self):
        notes = []
        engine = types.SimpleNamespace(state_dir=self.world.state, _note=lambda event, subject, detail: notes.append((event, subject, detail["session_charter"])))
        for value in (4, 4, 4, 5, 5, 4):
            sb.charter_disagreement_once(engine, "orch-b", value)
        self.assertEqual(notes, [("charter.disagree", "orch-b", 4), ("charter.disagree", "orch-b", 5)])

    def test_adoption_and_the_plan_wake_route_name_the_registrys_owner_and_not_the_session_metadata(self):
        self.shape_session_charter_only()     # orch-a owns charter 1 in the registry; orch-b's session metadata says 1 too
        self.world.add_agent("worker", fleet={"role": "coder", "charter": 1, "repo": self.REPO, "issue": 40})
        discovery = self.engine.discover(self.world.clock.now())
        heir, why = sb.adoption_heir(self.engine, discovery, {}, discovery.agents["worker"])
        self.assertEqual((heir, why), ("orch-a", "the charter's orchestrator"))
        items = {5: {"parent": 4}, 4: {"parent": 1}}
        ctx = {"charters": {1}, "asks": {4}}
        route = sb.plan_wake_route(5, items, ctx, discovery, ["cos"], sb.registry_owners(self.engine))
        self.assertEqual(route, (["orch-a"], "work item"))
        self.assertEqual(sb.plan_wake_route(5, items, ctx, discovery, ["cos"]), ([], "work item"), "no registry owners given: nobody is guessed from the metadata")

    def test_the_asks_of_the_chief_of_staff_and_of_an_orchestrator_follow_the_registrys_corrected_charter(self):
        self.orchestrator("orch-b", charter=1)            # launched with charter 1 ...
        self.set_registry("orch-b", 7)                    # ... and corrected through the command
        self.engine.intents = types.SimpleNamespace(open_asks=lambda charter, repo=None: ["ask-under-%s" % charter], repo=self.REPO, header=lambda *a, **k: None)
        now = self.world.clock.now()
        cos = sb.asks_of_caller(self.engine, {"name": "cos", "role": "chief-of-staff", "repo": self.REPO}, now)
        self.assertEqual(cos, [("orch-b", "ask-under-7")])
        orch = sb.asks_of_caller(self.engine, {"name": "orch-b", "role": "orchestrator", "charter": 1, "repo": self.REPO}, now)
        self.assertEqual(orch, [("orch-b", "ask-under-7")])
        self.set_registry("orch-b", None)
        self.assertEqual(sb.asks_of_caller(self.engine, {"name": "cos", "role": "chief-of-staff", "repo": self.REPO}, now), [], "no registry charter: no asks, never the launch value")

    def test_the_load_figures_and_the_tester_gate_follow_a_registry_row_and_use_the_launch_value_only_without_one(self):
        self.orchestrator("orch-b", charter=1)
        self.set_registry("orch-b", 7)
        fleet = {"role": "orchestrator", "charter": 1, "repo": self.REPO}
        self.assertEqual(sb.charter_or_first_seen(self.engine, "orch-b", fleet), 7)               # the row wins over the stale launch value
        self.set_registry("orch-b", None)
        self.assertIsNone(sb.charter_or_first_seen(self.engine, "orch-b", fleet))                  # a row with no charter is an answer
        self.assertEqual(sb.charter_or_first_seen(self.engine, "not-yet-seen", fleet), 1)          # no row yet: the launch value (the pass fills it at first sight)
        self.assertIsNone(sb.charter_or_first_seen(self.engine, "not-yet-seen", {"role": "orchestrator", "charter": True}))

    def test_the_load_tick_asks_the_registrys_charter_not_the_launch_value(self):
        self.orchestrator("orch-b", charter=1)
        self.set_registry("orch-b", 7)
        asked = []
        seen = types.SimpleNamespace(name="orch-b", fleet={"role": "orchestrator", "charter": 1, "repo": self.REPO}, status="idle")
        intents = types.SimpleNamespace(repo=self.REPO, _api=lambda path, repo: ([{"name": "me:orchestrator"}] if "/labels" in path else []), open_asks=lambda charter, repo: asked.append(charter) or [])
        state = self.world.state / "load-state"
        state.mkdir(exist_ok=True, mode=0o700)
        engine = types.SimpleNamespace(state_dir=str(self.world.state), now=lambda: 1_792_000_000, audit=None, actor="daemon", intents=intents, config={"load_alert": sb.load_fleet_health().validate({"enabled": True}, "x")})
        sb.load_tick(engine, types.SimpleNamespace(agents={"orch-b": seen}))
        self.assertEqual(asked, [7], "the registry's corrected charter, never the stale launch value 1")

    def test_the_notice_router_and_the_triage_context_never_take_an_orchestrators_issue_for_a_charter(self):
        """The recorded shape: aaa-orch was launched with ANOTHER charter's number as its issue (charter 2, issue 1); zzz-orch holds charter 1 in the registry. Charter 1's owner is zzz-orch."""
        self.orchestrator("aaa-orch", charter=2, issue=1)
        self.orchestrator("zzz-orch", charter=1)
        agents = self.engine.discover(self.world.clock.now()).agents
        view = sb.registry_charter_view(self.engine)
        self.assertEqual(sb.pick_owner({n: a for n, a in agents.items() if n.endswith("-orch")}, [1], self.REPO, view=view), "zzz-orch")
        self.assertEqual(sb.pick_owner({n: a for n, a in agents.items() if n.endswith("-orch")}, [2], self.REPO, view=view), "aaa-orch")
        self.set_registry("aaa-orch", 9)    # corrected: the launch charter 2 is no longer owned
        view = sb.registry_charter_view(self.engine)
        self.assertIsNone(sb.pick_owner({n: a for n, a in agents.items() if n.endswith("-orch")}, [2], self.REPO, view=view))
        ctx = sb.triage_context(self.engine, self.REPO, {}, types.SimpleNamespace(agents={n: a for n, a in agents.items() if n.endswith("-orch")}))
        self.assertEqual((ctx["charters"], ctx["owned"]), ({1, 9}, {1, 9}), "the metadata issue 1 of aaa-orch and its launch charter 2 are not owned")
        coder = types.SimpleNamespace(name="worker", fleet={"role": "coder", "issue": 40, "repo": self.REPO}, status="idle")
        self.assertEqual(sb.owned_numbers("worker", coder.fleet, view), {40}, "a coder owns its own issue")

    RETIRED_FALLBACK_READERS = {"adoption_heir": "an orphan of a RETIRED boss finds the charter in the boss's retirement record"}   # one row per reader that falls back to registry_retired_owners

    def test_the_readers_that_fall_back_to_a_retired_orchestrators_record_are_derived_from_the_code_and_each_has_its_row(self):
        callers = set()
        for node in ast.walk(ast.parse((REPO / "bin" / "fleet-switchboard").read_text())):
            if isinstance(node, ast.FunctionDef) and node.name != "registry_retired_owners":
                if any(isinstance(s, ast.Call) and isinstance(s.func, ast.Name) and s.func.id == "registry_retired_owners" for s in ast.walk(node)):
                    callers.add(node.name)
        self.assertEqual(callers, set(self.RETIRED_FALLBACK_READERS), "a reader that reads a retired orchestrator's kept charter needs a row and a test here")

    def test_adoption_heir_finds_the_live_orchestrator_of_the_charter_a_retired_boss_kept(self):
        self.orchestrator("orch-old", charter=1)
        self.orchestrator("orch-new", charter=1)
        self.world.add_agent("worker", fleet={"role": "coder", "reports_to": "orch-old", "repo": self.REPO})   # no charter of its own: its boss's
        self.assertEqual(self.registry.retire(self.world.state, "orch-old", "test", "retired", session=self.world.sessions["orch-old"], now=self.world.clock.now())["problem"], None)
        discovery = self.engine.discover(self.world.clock.now())
        retired = self.registry.read(self.world.state)["retired"]
        heir, why = sb.adoption_heir(self.engine, discovery, retired, discovery.agents["worker"])
        self.assertEqual((heir, why), ("orch-new", "the charter's orchestrator"))
        self.assertEqual(sb.registry_retired_owners(self.engine), {"orch-old": 1})

    def test_a_workers_charter_through_its_boss_is_the_registrys(self):
        self.orchestrator("orch-b", charter=1)
        self.set_registry("orch-b", 7)
        self.world.add_agent("worker", fleet={"role": "coder", "reports_to": "orch-b", "repo": self.REPO})
        discovery = self.engine.discover(self.world.clock.now())
        owners = sb.registry_owners(self.engine)
        self.assertEqual(sb.worker_charter(discovery, discovery.agents["worker"], owners)[0], 7)
        self.assertIsNone(sb.worker_charter(discovery, discovery.agents["worker"])[0], "without the registry's owners a boss's launch value is never read")

    def test_registry_charter_is_pure_and_total(self):
        cases = (({}, "a", 3, (3, None)), ({"a": {"charter": 5}}, "a", 3, (5, 3)), ({"a": {"charter": 5}}, "a", 5, (5, None)), ({"a": {"charter": None}}, "a", 3, (None, 3)),
                 ({"a": {"charter": 5}}, "a", None, (5, None)), ({"a": {"charter": 5}}, "a", True, (5, None)), ({}, "a", "3", (None, None)))
        for registered, name, session, expected in cases:
            with self.subTest(registered=registered, session=session):
                self.assertEqual(sb.registry_charter(registered, name, session), expected)

    # -- the command

    def test_charter_set_is_audited_refused_for_an_agent_and_for_a_bad_value(self):
        self.orchestrator("orch-b", charter=1)
        self.world.add_agent("worker", fleet={"role": "coder", "reports_to": "orch-b", "repo": self.REPO})
        before = self.row("orch-b")
        code, out, err = self.run_as("worker", "charter", "set", "orch-b", "9")
        self.assertEqual(code, 1, err)
        self.assertEqual(self.row("orch-b"), before)
        code, out, err = self.run_as("cos", "charter", "set", "orch-b", "nine")
        self.assertEqual(code, 2, err)
        self.assertEqual(self.row("orch-b"), before)
        code, out, err = self.run_as("cos", "charter", "set", "worker", "9")
        self.assertEqual(code, 2, err)
        code, out, err = self.run_as("cos", "charter", "set", "orch-b", "9", "--replace")
        self.assertEqual(code, 0, err)
        self.assertEqual(self.row("orch-b")["charter"], 9)
        done = [e for e in self.world.audit() if e["event"] == "charter.set"]
        self.assertEqual([(e["detail"]["old"], e["detail"]["new"]) for e in done], [(1, 9)])
        registry_audit = [json.loads(l) for l in (Path(self.world.state) / "registry-audit.jsonl").read_text().splitlines() if '"charter"' in l]
        self.assertEqual([(e["old"], e["new"]) for e in registry_audit if e.get("event") == "charter"], [(1, 9)])
        code, out, err = self.run_as("cos", "charter", "set", "orch-b", "none", "--replace")
        self.assertEqual((code, self.row("orch-b")["charter"]), (0, None))
        self.assertEqual(len([e for e in self.world.audit() if e["event"] == "charter.refused"]), 3)

    # -- the sweep and the report

    def test_a_charter_two_orchestrators_record_is_a_sweep_finding_naming_both_and_the_report_prints_it(self):
        self.shape_registry_two()
        state = types.SimpleNamespace(repos={}, sources={}, unattributed=0)
        found = sb.sweep_findings(self.engine, state, [], self.REPO, self.world.clock.now(), dict(sb.SWEEP_DEFAULTS), None)
        self.assertIn(("S10", "%s#1" % self.REPO), found)
        self.assertEqual(state.sources[("S10", "%s#1" % self.REPO)]["match"], "recorded by orch-a, orch-b")
        code, out, err = self.run_as(None, "agents", "charters")
        self.assertEqual(code, 0, err)
        self.assertIn("charter #1 of %s is recorded by 2 orchestrators in the registry: orch-a, orch-b" % self.REPO, out)
        self.setUp()
        self.shape_one()
        state = types.SimpleNamespace(repos={}, sources={}, unattributed=0)
        self.assertEqual([f for f in sb.sweep_findings(self.engine, state, [], self.REPO, self.world.clock.now(), dict(sb.SWEEP_DEFAULTS), None) if f[0] == "S10"], [])

    def test_the_report_shows_the_record_that_names_the_charter_for_the_orchestrator_that_does_not_own_it(self):
        self.shape_session_issue_only()
        code, out, err = self.run_as(None, "agents", "charters", "--json")
        self.assertEqual(code, 0, err)
        rows = {r["name"]: r for r in json.loads(out)["orchestrators"]}
        self.assertEqual((rows["orch-b"]["registry_charter"], rows["orch-b"]["meta_charter"], rows["orch-b"]["meta_issue"]), (None, 2, 1))
        self.assertEqual(rows["orch-b"]["metadata_names_other_charter"], [{"charter": 1, "field": "issue", "owner": "orch-a"}])
        self.assertEqual(rows["orch-a"]["metadata_names_other_charter"], [])

    def test_the_registry_writer_refuses_what_it_should(self):
        self.shape_one()
        self.assertIsNotNone(self.registry.set_charter(self.world.state, "ghost", 1, "t")["problem"])
        self.assertIsNotNone(self.registry.set_charter(self.world.state, "orch-a", True, "t")["problem"])
        self.assertIsNotNone(self.registry.set_charter(self.world.state, "orch-a", -2, "t")["problem"])
        self.assertEqual(self.registry.set_charter(self.world.state, "orch-a", 1, "t"), {"changed": False, "problem": None})

    @staticmethod
    def functions_reading_charter():
        """{(file, function): (the function's AST node, whether it enumerates the agents)} for every function that reads a fleet's `charter`, DERIVED from the code."""
        found = {}
        for rel in ["bin/fleet-switchboard", "bin/impact_hold.py", "bin/lanes.py", "bin/fleet_health.py", "bin/registry.py", "bin/reassign.py"] + ["bin/" + str(f.relative_to(BIN)) for f in SWITCHBOARD_SOURCE_FILES if f != SWITCHBOARD]:
            tree = ast.parse((REPO / rel).read_text())
            for node in ast.walk(tree):
                if not isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
                    continue
                reads, enumerates = False, False
                for sub in ast.walk(node):
                    key = None
                    if isinstance(sub, ast.Call) and isinstance(sub.func, ast.Attribute) and sub.func.attr == "get" and sub.args and isinstance(sub.args[0], ast.Constant):
                        key = sub.args[0].value
                    elif isinstance(sub, ast.Subscript) and isinstance(sub.slice, ast.Constant):
                        key = sub.slice.value
                    reads = reads or key == "charter"
                    if isinstance(sub, (ast.For, ast.comprehension)) and isinstance(sub.iter, ast.Tuple) and any(isinstance(e, ast.Constant) and e.value in ("charter",) for e in sub.iter.elts):
                        reads = True   # a loop over a tuple of field names that holds "charter" (the key is read as the loop variable)
                    if isinstance(sub, (ast.For, ast.comprehension)) and "agents" in ast.unparse(sub.iter) and re.search(r"\.agents\b|agents\.values|discover\(|\.items\(\)|\.values\(\)", ast.unparse(sub.iter)):
                        enumerates = True
                if reads:
                    found[(rel, node.name)] = (node, enumerates)
        return found

    def test_every_reader_of_an_agents_charter_is_in_the_table_and_its_claim_is_checked_against_the_code(self):
        """The readers of a fleet's `charter` are DERIVED from the code and each must be classified; the classification is CHECKED, not trusted: an `own` reader may not enumerate other agents, a `registry` reader
        must read the registry, a `set` reader is the only kind that may enumerate without naming an owner (listed by name)."""
        found = self.functions_reading_charter()
        self.assertEqual(sorted(set(found) - set(self.READERS)), [], "classify each new reader of a charter in READERS")
        for key in sorted(set(self.READERS) - set(found)):   # a `registry` row names a function that now reads the registry instead of the key: it must really do so
            self.assertEqual(self.READERS[key].split(":", 1)[0], "registry", key)
        for key, (node, enumerates) in found.items():
            kind = self.READERS[key].split(":", 1)[0]
            self.assertIn(kind, ("registry", "writer", "display", "own", "set"), key)
            source = ast.unparse(node)
            if kind == "own":
                self.assertFalse(enumerates, "%s is classified `own` but enumerates the agents" % (key,))
            if kind == "registry":
                self.assertTrue("registry" in source or "owners" in source or "orchestrator_charters" in source, "%s is classified `registry` but never reads the registry" % (key,))
        self.assertEqual(sorted(k for k, (n, e) in found.items() if e and self.READERS[k].startswith("set:")), [("bin/fleet-switchboard", "seam_applies")])

    READERS = {   # (file, function) -> "kind: reason". registry: decides who owns a charter and reads the registry's charter (#969); writer / display: writes or shows the registry row; own: reads ONE agent's own launch context and enumerates no other agent
        # (CHECKED against the code below); set: asks only whether a number is a charter, never counts or names an owner
        ("bin/fleet-switchboard", "guard"): "registry: the charter set guard, on the registry lock's own read",
        ("bin/impact_hold.py", "_lane_of_issue"): "registry: the lane lookup", ("bin/lanes.py", "charter_orchestrators"): "registry: move's lookup",
        ("bin/fleet-switchboard", "adoption_heir"): "registry: the heir of an orphan", ("bin/fleet-switchboard", "plan_wake_route"): "registry: the orchestrator a plan wakes",
        ("bin/fleet-switchboard", "asks_of_caller"): "registry: the asks an agent is accountable for", ("bin/fleet-switchboard", "register_item_tester"): "registry: the launching orchestrator's charter gates a registration",
        ("bin/fleet-switchboard", "load_tick"): "registry: an orchestrator's charter in the load figures", ("bin/fleet-switchboard", "worker_charter"): "registry: a worker's boss's charter (the worker's own is its launch context)",
        ("bin/fleet-switchboard", "charter_or_first_seen"): "registry: the row's charter, else the launch value of an agent with no row yet",
        ("bin/fleet-switchboard", "registry_retired_owners"): "registry: the charter a retired orchestrator's record kept",
        ("bin/registry.py", "orchestrator_charters"): "registry: the one reading", ("bin/registry.py", "duplicate_charters"): "registry: duplicates", ("bin/registry.py", "set_charter"): "writer: the audited setter",
        ("bin/registry.py", "change"): "writer: the registry's own writer", ("bin/fleet-switchboard", "registry_charter"): "writer: the pass's rule over the registry row",
        ("bin/fleet-switchboard", "pane_health_pass"): "writer: writes the registry row through registry_charter", ("bin/fleet-switchboard", "charters_report"): "display: both records, read-only",
        ("bin/fleet-switchboard", "cmd_agents_charters"): "display: the report", ("bin/fleet-switchboard", "cmd_charter"): "writer: the audited command",
        ("bin/fleet-switchboard", "record_launch_charter"): "writer: a launch writes the registry row (first sight; a relaunch under the name is a new launch)",
        ("bin/impact_hold.py", "clear_lane"): "display: carries the lookup's `charter` into the notice line", ("bin/impact_hold.py", "_notify_clear_body"): "display: words the notice line",
        ("bin/fleet-switchboard", "seam_applies"): "set: is this issue number known as a charter",
        ("bin/fleet-switchboard", "owned_numbers"): "registry: the numbers an agent owns (an orchestrator: its row's charter only; others: their own assignment)",
        ("bin/fleet-switchboard", "registry_charter_view"): "registry: every row's charter", ("bin/fleet-switchboard", "triage_context"): "registry: charters via owned_numbers (an orchestrator's issue is never a charter)",
        ("bin/switchboard/judge_request.py", "identify"): "own: copies the caller's own launch fields into its context",
        ("bin/fleet-switchboard", "resume_agent"): "own: one agent's own repo lookup", ("bin/fleet-switchboard", "charter_pane_update"): "own: one agent's own charter for its pane",
        ("bin/fleet-switchboard", "_fleet_repo"): "own: one agent's own repo", ("bin/fleet-switchboard", "read_order_notices"): "own: the order notices' own records",
        ("bin/fleet-switchboard", "order_groups"): "own: groups order notices", ("bin/fleet-switchboard", "decisions_from_order_notices"): "own: words order notices",
        ("bin/switchboard/judge_request.py", "resolve_policy_context"): "own: one agent's own launch context", ("bin/fleet-switchboard", "_valid_context"): "own: a cached own context",
        ("bin/fleet-switchboard", "charter_orders"): "own: an agent's own charter's orders", ("bin/switchboard/judge_request.py", "charter_guard"): "own: an agent's own charters",
        ("bin/switchboard/judge_request.py", "ask_context_of"): "own: an agent's own ask context", ("bin/fleet-switchboard", "__call__"): "own: an orchestrator's own orders",
        ("bin/fleet_health.py", "figures"): "own: the health figures of one agent from the registry-derived info", ("bin/fleet_health.py", "_resolve_charters"): "own: the registry-derived info",
        ("bin/fleet_health.py", "_refresh_asks"): "own: the registry-derived info", ("bin/switchboard/import_v1.py", "_import_fleet"): "own: the launch/import writer of the session's metadata",
    }



class TestCharterSetGuard(CharterRig, Base):
    """#1143: the Chief of Staff's `charter set` guard, its audit and its read-back; the permission diff of the definition."""

    def setUp(self):
        super().setUp()

    def audit_lines(self):
        return [e for e in self.world.audit() if e["event"].startswith("charter.") and e["event"] != "charter.disagree"]

    def test_non_orchestrator_is_refused_and_audited(self):
        self.world.add_agent("worker", fleet={"role": "coder", "reports_to": "orch-b", "repo": self.REPO})
        self.registry.upsert(self.world.state, "worker", {"session": "s-w", "pane": self.world.panes["worker"], "role": "coder", "charter": None, "repo": self.REPO})
        code, out, err = self.run_as("cos", "charter", "set", "worker", "3")
        self.assertIn(code, (1, 2))
        self.assertIn("not an orchestrator", err)
        self.assertEqual(len(self.audit_lines()), 1)
        self.assertEqual(self.audit_lines()[0]["detail"]["why"], "not an orchestrator")   # the command's own guard, before the registry writer

    def test_held_by_another_and_not_a_sub_issue_are_refused(self):
        self.orchestrator("orch-a", registry=3)
        self.orchestrator("orch-b", registry=None)
        code, out, err = self.run_as("cos", "charter", "set", "orch-b", "3")
        self.assertIn("already held by orch-a", err)
        code, out, err = self.run_as("cos", "charter", "set", "orch-b", "5")
        self.assertIn("not a sub-issue", err)
        code, out, err = self.run_as("cos", "charter", "set", "orch-b", "1")
        self.assertIn("not a sub-issue", err)
        self.assertIsNone(self.row("orch-b")["charter"])
        self.assertEqual([e["event"] for e in self.audit_lines()], ["charter.refused"] * 3)

    def test_changing_a_set_charter_needs_replace(self):
        self.orchestrator("orch-b", registry=3)
        code, out, err = self.run_as("cos", "charter", "set", "orch-b", "4")
        self.assertIn("--replace", err)
        self.assertEqual(self.row("orch-b")["charter"], 3)
        code, out, err = self.run_as("cos", "charter", "set", "orch-b", "4", "--replace")
        self.assertEqual(code, 0, err)
        self.assertEqual(self.row("orch-b")["charter"], 4)

    def test_success_is_audited_once_and_reads_the_row_back(self):
        self.orchestrator("orch-b", registry=None)
        code, out, err = self.run_as("cos", "charter", "set", "orch-b", "3")
        self.assertEqual(code, 0, err)
        self.assertIn("orch-b", out)
        self.assertIn("charter=#3", out)
        lines = self.audit_lines()
        self.assertEqual(len(lines), 1)
        detail = lines[0]["detail"]
        self.assertEqual((detail["caller"], detail["orchestrator"], detail["old"], detail["new"]), ("cos", "orch-b", None, 3))

    def without(self, why):
        """A mutant registry writer: a guard verdict with this `why` is ignored (the branch is skipped)."""
        real = self.registry.set_charter

        def mutant(state_dir, name, charter, by, now=None, check=None):
            return real(state_dir, name, charter, by, now=now, check=lambda doc, row: (lambda v: None if v and v[0] == why else v)(check(doc, row)))
        return mock.patch.object(self.registry, "set_charter", mutant)

    def retire(self, name):
        self.registry._mutate(self.world.state, lambda doc: (doc["retired"].__setitem__(name, {"at": "2026-01-01T00:00:00Z"}) or True, [], None))

    def unreadable(self, reader, number, repo=None):
        raise RuntimeError("HTTP 502")

    def test_an_unreadable_parent_is_refused_unverified_and_nothing_is_written(self):
        self.orchestrator("orch-b", registry=None)
        before = (Path(self.world.state) / "registry.json").read_text()
        with mock.patch.object(sb.IntentReader, "parent", self.unreadable):
            code, out, err = self.run_as("cos", "charter", "set", "orch-b", "3")
        self.assertIn(code, (1, 2))
        self.assertIn("cannot read #3's parent", err)
        self.assertEqual((Path(self.world.state) / "registry.json").read_text(), before)
        self.assertEqual([e["detail"]["why"] for e in self.audit_lines()], ["unverified"])

    def test_mutant_an_unreadable_parent_passes(self):
        self.orchestrator("orch-b", registry=None)
        with mock.patch.object(sb.IntentReader, "parent", self.unreadable), self.without("unverified"):
            code, out, err = self.run_as("cos", "charter", "set", "orch-b", "3")
        self.assertEqual(self.row("orch-b")["charter"], 3)   # the write the real guard refuses: test_an_unreadable_parent... fails for this mutant

    def test_a_retired_holder_does_not_hold_the_issue(self):
        self.orchestrator("orch-a", registry=3)
        self.orchestrator("orch-b", registry=None)
        self.retire("orch-a")
        code, out, err = self.run_as("cos", "charter", "set", "orch-b", "3")
        self.assertEqual(code, 0, err)
        self.assertEqual(self.row("orch-b")["charter"], 3)

    def test_mutant_a_retired_holder_still_holds(self):
        self.orchestrator("orch-a", registry=3)
        self.orchestrator("orch-b", registry=None)
        self.retire("orch-a")
        real = self.registry.set_charter
        mutant = lambda state_dir, name, charter, by, now=None, check=None: real(state_dir, name, charter, by, now=now, check=lambda doc, row: (
            ("already held by", "held by a retired holder") if any(o.get("charter") == charter for n, o in doc["agents"].items() if n != name) else check(doc, row)))
        with mock.patch.object(self.registry, "set_charter", mutant):
            code, out, err = self.run_as("cos", "charter", "set", "orch-b", "3")
        self.assertIsNone(self.row("orch-b")["charter"])   # the refusal test_a_retired_holder_does_not_hold_the_issue forbids

    def test_a_holder_in_another_repo_does_not_count(self):
        self.orchestrator("orch-a", registry=3)
        self.registry.upsert(self.world.state, "orch-a", {"session": "s-a", "pane": self.world.panes["orch-a"], "role": "orchestrator", "charter": 3, "repo": "other-org/elsewhere"})
        self.orchestrator("orch-b", registry=None)
        code, out, err = self.run_as("cos", "charter", "set", "orch-b", "3")
        self.assertEqual(code, 0, err)
        self.assertEqual(self.row("orch-b")["charter"], 3)

    def test_mutant_a_holder_in_another_repo_counts(self):
        self.orchestrator("orch-a", registry=3)
        self.registry.upsert(self.world.state, "orch-a", {"session": "s-a", "pane": self.world.panes["orch-a"], "role": "orchestrator", "charter": 3, "repo": "other-org/elsewhere"})
        self.orchestrator("orch-b", registry=None)
        real = self.registry.set_charter
        mutant = lambda state_dir, name, charter, by, now=None, check=None: real(state_dir, name, charter, by, now=now, check=lambda doc, row: (
            ("already held by", "held elsewhere") if any(o.get("charter") == charter for n, o in doc["agents"].items() if n != name) else check(doc, row)))
        with mock.patch.object(self.registry, "set_charter", mutant):
            self.run_as("cos", "charter", "set", "orch-b", "3")
        self.assertIsNone(self.row("orch-b")["charter"])

    def test_setting_the_same_value_needs_no_replace_and_says_unchanged(self):
        self.orchestrator("orch-b", registry=3)
        code, out, err = self.run_as("cos", "charter", "set", "orch-b", "3")
        self.assertEqual(code, 0, err)
        self.assertIn("(unchanged)", out)
        code, out, err = self.run_as("cos", "charter", "set", "orch-b", "3", "--replace")   # --replace on a lane that already holds the same value: the same, no error
        self.assertEqual(code, 0, err)
        self.assertEqual(self.row("orch-b")["charter"], 3)
        self.assertEqual([e["detail"]["changed"] for e in self.audit_lines()], [False, False])

    def test_mutant_the_same_value_needs_replace(self):
        self.orchestrator("orch-b", registry=3)
        real = self.registry.set_charter
        mutant = lambda state_dir, name, charter, by, now=None, check=None: real(state_dir, name, charter, by, now=now, check=lambda doc, row: (
            ("--replace", "needs --replace") if row.get("charter") is not None else check(doc, row)))
        with mock.patch.object(self.registry, "set_charter", mutant):
            code, out, err = self.run_as("cos", "charter", "set", "orch-b", "3")
        self.assertNotEqual(code, 0)   # test_setting_the_same_value_needs_no_replace... asserts 0

    def refused_caller_audit(self):
        self.orchestrator("orch-b", registry=None)
        with mock.patch.object(sb, "move_caller", lambda *a, **k: ("evil\n<b>x</b>", "coder")):
            code, out, err = self.run_as("cos", "charter", "set", "orch-b", "3")
        return code, err, self.audit_lines()

    def test_a_refused_caller_is_audited_through_charter_safe(self):
        code, err, lines = self.refused_caller_audit()
        self.assertEqual(code, 1, err)
        self.assertIsNone(self.row("orch-b")["charter"])
        (line,) = lines
        self.assertEqual((line["event"], line["detail"]["why"], line["detail"]["role"]), ("charter.refused", "caller", "coder"))
        self.assertEqual(line["detail"]["caller"], "evil??b?x??b?")
        self.assertNotIn("<", err)

    def test_mutant_a_refused_caller_is_audited_raw(self):
        with mock.patch.object(sb, "charter_safe", lambda text: str(text)):
            code, err, lines = self.refused_caller_audit()
        self.assertIn("\n", lines[0]["detail"]["caller"])   # the raw caller: test_a_refused_caller_is_audited_through_charter_safe fails for it

    WHYS = {"absent": "ghost", "retired": "orch-r", "not an orchestrator": "worker", "value": "orch-b"}

    def observed_whys(self, writer):
        self.orchestrator("orch-r", registry=None)
        self.retire("orch-r")
        self.registry.upsert(self.world.state, "worker", {"session": "s-w", "pane": "p-w", "role": "coder", "charter": None, "repo": self.REPO})
        self.orchestrator("orch-b", registry=None)
        return {why: writer(self.world.state, name, "x" if why == "value" else 3, "test").get("why") for why, name in self.WHYS.items()}

    def test_every_registry_refusal_carries_a_why_code(self):
        self.assertEqual(self.observed_whys(self.registry.set_charter), {k: k for k in self.WHYS})

    def test_mutant_each_why_code_is_pinned(self):
        for code in self.WHYS:
            real = self.registry.set_charter
            mutant = lambda *a, _code=code, **k: {key: val for key, val in real(*a, **k).items() if not (key == "why" and val == _code)}
            with self.subTest(code=code):
                self.setUp() if code != "absent" else None
                self.assertNotEqual(self.observed_whys(mutant), {k: k for k in self.WHYS})

    def test_from_is_refused_outright_in_and_out_of_the_lab(self):
        self.orchestrator("orch-b", registry=None)
        self.world.add_agent("worker", fleet={"role": "coder", "reports_to": "orch-b", "repo": self.REPO})
        for lab in (False, True):
            with mock.patch.dict(os.environ):
                os.environ.pop(sb.LAB_ENV, None)
                if lab:
                    os.environ[sb.LAB_ENV] = "1"
                for who in ("cos", "worker", None):
                    code, out, err = self.run_as(who, "charter", "set", "orch-b", "3", "--from", "cos")
                    self.assertEqual(code, 2, (lab, who, err))
                    self.assertIn("--from is not accepted", err)
        self.assertIsNone(self.row("orch-b")["charter"])
        self.assertEqual([e["detail"]["why"] for e in self.audit_lines()], ["from"] * 6)

    def test_mutant_from_is_honoured_and_writes(self):
        self.orchestrator("orch-b", registry=None)
        with mock.patch.dict(os.environ, {sb.LAB_ENV: "1"}), mock.patch.object(sb, "charter_from_refusal", lambda args: None):
            code, out, err = self.run_as(None, "charter", "set", "orch-b", "3", "--from", "cos")
        self.assertEqual(self.row("orch-b")["charter"], 3)   # what test_from_is_refused_outright... forbids

    def test_the_definition_adds_exactly_one_charter_permission_and_nothing_wider(self):
        text = (Path(sb.__file__).resolve().parent.parent / "agents/opencode/chief-of-staff.md").read_text()
        allows = [l for l in text.splitlines() if l.lstrip().startswith("- {action: shell") and "charter" in l]
        self.assertEqual(len(allows), 1)
        self.assertIn('resource: "fleet-switchboard charter set *"', allows[0])
        self.assertNotIn("charter *", text)

class TestCharterSetRaceAndSanitising(CharterRig, Base):
    """#1143 (panel): the guard's checks and the write are ONE registry lock; the lane, issue and --replace arguments are validated and escaped in every sink."""

    HOSTILE = ("a\nfake.line", "x" * 300, "<b>&bold;`rm`</b>", "9\n9", "-1", "0", "12345678901234")

    def audit_lines(self):
        return [e for e in self.world.audit() if e["event"].startswith("charter.") and e["event"] != "charter.disagree"]

    def run_two(self, outside_the_lock=False):
        """Two callers set DIFFERENT orchestrators to the SAME issue, driven by events, never by sleeps. The hook sits in the registry's critical section (the guard): caller A, once inside it, signals and then waits
        until B has STARTED its call and (for a bounded wait that only the broken code needs to end early) until B's own check has run. B starts only after A is provably inside. With the one lock B's check cannot
        run until A has left, so A's wait ends by its bound and the outcome is the same on any machine; with the check outside the lock B's check runs at once. The parents are read before the lock (nothing slow in it)."""
        import threading
        self.orchestrator("orch-a", registry=None)
        self.orchestrator("orch-b", registry=None)
        os.environ["HERDR_PANE_ID"] = self.world.panes["cos"]   # set once, here, before any thread: the callers share one identity
        a_in, b_started, b_checked, codes = threading.Event(), threading.Event(), threading.Event(), {}
        real = self.registry.set_charter

        def spy_of(name, check):
            def spy(doc, row):
                verdict = check(doc, row)
                if name == "orch-a":
                    a_in.set()
                    b_started.wait(10)
                    b_checked.wait(1.0)
                else:
                    b_checked.set()
                return verdict
            return spy

        def hooked(state_dir, name, charter, by, now=None, check=None):
            if name == "orch-b":
                a_in.wait(10)       # B tries only once A is inside its critical section
                b_started.set()
            if outside_the_lock:    # the mutant: the check on an earlier read, then the write (the old order)
                doc = self.registry.read(state_dir)
                verdict = spy_of(name, check)(doc, doc["agents"][name])
                return {"changed": False, "problem": verdict[1], "why": verdict[0]} if verdict else real(state_dir, name, charter, by, now=now)
            return real(state_dir, name, charter, by, now=now, check=spy_of(name, check))

        def one(name):
            codes[name] = sb.main(["charter", "set", name, "3"], runner=self.world.route, now=self.world.clock.now, wait=lambda sock, seconds: False, socket_call=self.world.herdr.socket)

        with captured() as (out, err), mock.patch.object(self.registry, "set_charter", hooked):   # ONE capture in this thread: no thread swaps the process's stderr
            threads = [threading.Thread(target=one, args=(n,)) for n in ("orch-a", "orch-b")]
            [t.start() for t in threads]
            [t.join(30) for t in threads]
        held = [n for n in ("orch-a", "orch-b") if self.row(n)["charter"] == 3]
        return (codes, err.getvalue()), held

    def test_two_concurrent_sets_of_one_issue_cannot_both_pass(self):
        codes, held = self.run_two()
        self.assertEqual(len(held), 1, (codes, held))
        self.assertEqual(sorted(codes[0].values()), [0, 2])

    def test_mutant_checks_outside_the_lock_lets_both_pass(self):
        codes, held = self.run_two(outside_the_lock=True)
        self.assertEqual(len(held), 2, (codes, held))   # the race the single lock closes: this mutant makes test_two_concurrent_sets_of_one_issue_cannot_both_pass fail, every time

    def test_the_parents_are_read_before_the_lock_and_never_inside_it(self):
        self.orchestrator("orch-b", registry=None)
        seen = []
        real_parent = lambda reader, number, repo=None: (seen.append(("parent", number)), self.parents[number])[1]
        real = self.registry.set_charter

        def spy(state_dir, name, charter, by, now=None, check=None):
            def inner(doc, row):
                seen.append(("lock",))
                return check(doc, row)
            return real(state_dir, name, charter, by, now=now, check=inner)
        with mock.patch.object(sb.IntentReader, "parent", real_parent), mock.patch.object(self.registry, "set_charter", spy):
            code, out, err = self.run_as("cos", "charter", "set", "orch-b", "3")
        self.assertEqual(code, 0, err)
        self.assertEqual(seen, [("parent", 3), ("parent", 1), ("lock",)])   # the GitHub reads, then the registry's critical section; none inside it

    def test_hostile_values_are_refused_and_escaped_in_every_sink(self):
        self.orchestrator("orch-b", registry=None)
        before = (Path(self.world.state) / "registry.json").read_text()
        for bad in self.HOSTILE:
            for argv in (("orch-b", bad), (bad, "3")):
                code, out, err = self.run_as("cos", "charter", "set", *argv)
                self.assertEqual(code, 2, (argv, err))
                self.assertEqual(err.count("\n"), 1, err)           # one line: no injected line
                self.assertNotIn("<", err + out)
                self.assertNotIn("&", err + out)
                self.assertLess(len(err), 260)
        self.assertEqual((Path(self.world.state) / "registry.json").read_text(), before)
        for e in self.audit_lines():
            self.assertTrue(all("\n" not in str(v) and "<" not in str(v) and len(str(v)) <= 120 for v in e["detail"].values()), e)
        self.assertEqual(len(self.audit_lines()), 2 * len(self.HOSTILE))

    def test_replace_is_a_flag_with_no_value(self):
        self.orchestrator("orch-b", registry=3)
        code, out, err = self.run_as("cos", "charter", "set", "orch-b", "4", "--replace", "split\nreason")
        self.assertNotEqual(code, 0)
        self.assertEqual(self.row("orch-b")["charter"], 3)
        code, out, err = self.run_as("cos", "charter", "set", "orch-b", "4", "--replace")
        self.assertEqual(code, 0, err)
        (done,) = [e for e in self.audit_lines() if e["event"] == "charter.set"]
        self.assertIs(done["detail"]["replace"], True)

    def test_the_stdout_row_escapes_a_hostile_repo(self):
        self.orchestrator("orch-b", registry=None)
        self.registry.upsert(self.world.state, "orch-b", {"session": "s-x", "pane": self.world.panes["orch-b"], "role": "orchestrator", "charter": None, "repo": "acme\n<b>x</b>"})
        with mock.patch.object(sb.IntentReader, "parent", lambda reader, number, repo=None: self.parents[number]):
            code, out, err = self.run_as("cos", "charter", "set", "orch-b", "3")
        self.assertEqual(code, 0, err)
        self.assertNotIn("<", out)
        self.assertEqual(out.count("\n"), 2, out)

    def test_a_mutant_without_the_escape_shows_the_hostile_text(self):
        """One escape for every sink: with it removed the hostile value shows in the audit and on stderr (so the tests above fail for it)."""
        self.orchestrator("orch-b", registry=None)
        with mock.patch.object(sb, "charter_safe", lambda text: str(text)):
            code, out, err = self.run_as("cos", "charter", "set", "orch-b", "<b>x\ny")
        self.assertIn("<b>", err)
        self.assertIn("<b>", json.dumps([e["detail"] for e in self.audit_lines()]))
        self.registry.upsert(self.world.state, "orch-b", {"session": "s-x", "pane": self.world.panes["orch-b"], "role": "orchestrator", "charter": None, "repo": "acme<b>"})
        with mock.patch.object(sb, "charter_safe", lambda text: str(text)):
            code, out, err = self.run_as("cos", "charter", "set", "orch-b", "3")
        self.assertIn("<b>", out)


class TestClearNotice(Base):
    """#541: the owner's clear tells the Chief of Staff and the orchestrator whose lane merges it, once, after the clear is recorded, through ONE function."""

    REPO, PR, HEAD = "acme-org/widget-api", "acme-org/widget-api#7", "a" * 40

    def setUp(self):
        super().setUp()
        self.world = World(self, agents=(), config={"gh": FAKE_GH, "impact_hold": {"enabled": True}})
        self.world.add_agent("cos", fleet={"role": "chief-of-staff"})
        self.world.add_agent("orch-a", fleet={"role": "orchestrator", "charter": 1, "repo": self.REPO})
        self.world.add_agent("orch-b", fleet={"role": "orchestrator", "charter": 50, "repo": self.REPO})
        self.world.add_agent("worker", fleet={"role": "coder", "issue": 3, "reports_to": "orch-a", "repo": self.REPO})
        self.engine = self.world.new_engine("daemon")
        self.engine.gh_runner, self.engine.state_dir = self.route, self.world.state
        self.names = sb.label_names(self.engine.config)
        self.body, self.head, self.fail_send = "PLAN: https://github.com/acme-org/widget-api/issues/3#issuecomment-1\n\nthe change\n", self.HEAD, False
        self.labels = [self.names["merge-captain"], self.names["hold-impact"]]
        self.parents = {3: 2, 2: 1, 1: None}
        self.order = []
        self.plan_result = "pass"
        real_checked = sb.checked_plan
        sb.checked_plan = lambda *a, **k: {"result": self.plan_result, "defects": [], "scenarios_parsed": []}   # the plan check at this moment (the gates' own function is patched: no GitHub here)
        self.addCleanup(setattr, sb, "checked_plan", real_checked)
        self.record_plan("%s#3" % self.REPO)   # the plan the LEDGER records for this pull request (written by `prove`, not by the PR body)
        self.engine.intents = types.SimpleNamespace(parent=lambda number, repo=None: self.parents.get(number), repo=self.REPO, header=lambda *a, **k: None, ask_of=lambda number, repo=None: (number, None))

    def route(self, argv, **kwargs):
        if argv[0] == FAKE_GH and argv[1:3] == ["pr", "view"]:
            if getattr(self, "unreadable", False):
                return subprocess.CompletedProcess(argv, 1, "", "HTTP 502")
            raw = {"state": getattr(self, "pr_state", "OPEN"), "headRefOid": self.head, "title": "t", "labels": [{"name": n} for n in self.labels], "body": self.body}
            return subprocess.CompletedProcess(argv, 0, json.dumps(raw), "")
        if argv[0] == FAKE_GH and argv[1] == "api" and "--method" in argv:
            self.order.append(argv[argv.index("--method") + 1] + " " + argv[2].rsplit("/", 1)[-1])
            if argv[argv.index("--method") + 1] == "PATCH":
                self.body = json.loads(kwargs["input"])["body"]
            return subprocess.CompletedProcess(argv, 0, "{}", "")
        return self.world.route(argv, **kwargs)

    def clear(self, reason="a false hold: it is a fixture", **kwargs):
        return sb.impact_clear_core(self.engine, self.route, self.REPO, 7, "owner", reason, **kwargs)

    def told(self, name):
        """The notice line of each delivered message that holds one (the delivery wraps it: a header and the sender's line)."""
        found = []
        for a in self.world.admissions(name):
            match = re.search(r"(owner cleared [^\n]*|owner's clear carried [^\n]*)", a["text"])
            if match:
                found.append(match.group(1))
        return found

    def events(self, name):
        return [e for e in self.world.audit() if e["event"] == name]

    def test_s1_s2_the_chief_of_staff_and_the_lane_get_one_line_with_the_pull_request_the_head_the_reason_and_the_lane(self):
        sb.record_pr_notice(self.world.state, self.REPO, 7, "worker", "ready", self.world.clock.now(), boss="orch-a")
        self.clear()
        line = 'owner cleared %s at %s: "a false hold: it is a fixture"; orch-a merges it' % (self.PR, "a" * 8)
        self.assertEqual((self.told("cos"), self.told("orch-a")), ([line], [line]))
        self.assertEqual(self.told("orch-b"), [])
        (event,) = self.events("gate.clear_notified")
        self.assertEqual((event["detail"]["lane"], event["detail"]["lane_from"], sorted(event["detail"]["sent"])), ("orch-a", "the pull request's plan and the notice", ["chief-of-staff", "orch-a"]))

    def no_ledger_plan(self):
        for name in ("plan-ledger.jsonl", "plan-ledger.head"):
            (Path(self.world.state) / name).unlink()

    def record_plan(self, ref):
        sb.plan_ledger.append_entry(self.world.state, {"kind": "proof", "pr": self.PR, "scenario": "S1", "plan_ref": ref, "result": "pass", "by": "coder", "head": self.HEAD}, self.world.clock.now())

    def lane_event(self):
        (event,) = self.events("gate.clear_notified")
        return event["detail"]["lane"], event["detail"]["lane_from"], sorted(event["detail"]["sent"])

    def test_s1_a_plan_lane_and_a_notice_lane_that_agree_tell_that_lane(self):
        sb.record_pr_notice(self.world.state, self.REPO, 7, "worker", "ready", self.world.clock.now())   # the worker's boss is orch-a, the plan sits under charter 1 (orch-a)
        self.clear()
        self.assertEqual(self.lane_event(), ("orch-a", "the pull request's plan and the notice", ["chief-of-staff", "orch-a"]))

    def test_a_plan_lane_and_a_notice_lane_that_disagree_are_unclear_and_only_the_chief_of_staff_is_told(self):
        sb.record_pr_notice(self.world.state, self.REPO, 7, "orch-b", "ready", self.world.clock.now())   # orchestrator B recorded the notice; the plan sits under A's charter
        self.clear()
        (line,) = self.told("cos")
        self.assertIn("lane unclear: plan lane orch-a, notice by orch-b", line)
        self.assertNotIn("merges it", line)
        self.assertEqual((self.told("orch-a"), self.told("orch-b")), ([], []), "neither lane is told to merge")
        (event,) = self.events("gate.clear_notified")
        self.assertEqual((event["detail"]["lane"], event["detail"]["lane_unclear"], event["detail"]["sent"]), (None, ["orch-a", "orch-b"], ["chief-of-staff"]))
        self.clear()
        self.assertEqual(len(self.events("gate.clear_notified")), 1, "audited once")

    def test_s2_a_moved_ask_counts_under_the_charter_it_has_now(self):
        cache, live = {2: 1}, {3: 2, 2: 50, 1: None, 50: None}   # the cache still says charter 1 for ask 2; today it is charter 50
        self.engine.intents = types.SimpleNamespace(parent=lambda number, repo=None: cache[number] if number in cache else live.get(number), invalidate=lambda number, repo=None: cache.pop(number, None),
                                                    repo=self.REPO, header=lambda *a, **k: None, ask_of=lambda number, repo=None: (number, None))
        self.clear()
        self.assertEqual(self.lane_event()[:2], ("orch-b", "the pull request's plan"))
        self.assertEqual(self.told("orch-a"), [])

    def test_s3_a_plan_in_another_repository_is_not_used_and_the_notice_sender_decides(self):
        self.body = "no plan line here\n"
        self.no_ledger_plan()
        self.record_plan("other-org/widget-web#3")
        sb.record_pr_notice(self.world.state, self.REPO, 7, "worker", "ready", self.world.clock.now(), boss="orch-a")
        self.clear()
        self.assertEqual(self.lane_event()[:2], ("orch-a", "the notice"))

    def test_s4_a_charter_nobody_runs_falls_to_the_notice_sender_and_no_orchestrator_is_guessed(self):
        self.parents = {3: 2, 2: 99, 99: None}   # charter 99 has no running orchestrator
        sb.record_pr_notice(self.world.state, self.REPO, 7, "orch-b", "ready", self.world.clock.now())
        self.clear()
        self.assertEqual(self.lane_event(), ("orch-b", "the notice", ["chief-of-staff", "orch-b"]))
        self.assertEqual(self.told("orch-a"), [], "not the repository's other orchestrator")

    def test_s5_with_no_plan_the_notice_senders_boss_is_the_lane_as_before(self):
        self.body = "no plan link here\n"
        self.no_ledger_plan()
        sb.record_pr_notice(self.world.state, self.REPO, 7, "worker", "ready", self.world.clock.now())
        self.clear()
        self.assertEqual(self.lane_event()[:2], ("orch-a", "the notice"))

    def test_s6_with_no_plan_and_no_notice_the_line_says_lane_unknown_and_only_the_chief_of_staff_is_told(self):
        self.body = "no plan link here\n"
        self.no_ledger_plan()
        self.clear()
        (line,) = self.told("cos")
        self.assertIn("lane unknown", line)
        self.assertEqual((self.told("orch-a"), self.told("orch-b")), ([], []))
        self.assertEqual(self.lane_event(), (None, None, ["chief-of-staff"]))

    def test_with_only_a_ledger_plan_and_no_body_link_the_ledgers_first_plan_decides(self):
        self.body = "no plan line in the body\n"
        self.clear()
        self.assertEqual(self.lane_event()[:2], ("orch-a", "the pull request's plan"))

    def test_a_plan_that_does_not_pass_the_plan_check_is_ignored_and_the_notice_decides(self):
        self.plan_result = "fail"
        sb.record_pr_notice(self.world.state, self.REPO, 7, "orch-b", "ready", self.world.clock.now())
        self.clear()
        self.assertEqual(self.lane_event()[:2], ("orch-b", "the notice"), "an invalid plan names no lane: no disagreement either")
        self.head = "c" * 40
        self.no_ledger_plan()
        self.body = "no plan line\n"
        self.plan_result = "fail"
        self.clear()
        self.assertEqual([e["detail"]["lane"] for e in self.events("gate.clear_notified")][-1], "orch-b")

    def test_two_orchestrators_on_one_charter_are_never_picked_between_and_the_line_names_them(self):
        self.world.add_agent("orch-a2", fleet={"role": "orchestrator", "charter": 1, "repo": self.REPO})
        self.clear()
        (line,) = self.told("cos")
        self.assertIn("lane unknown: charter #1 has 2 orchestrators: orch-a, orch-a2", line)
        self.assertEqual((self.told("orch-a"), self.told("orch-a2"), self.told("orch-b")), ([], [], []))
        (event,) = self.events("gate.clear_notified")
        self.assertEqual((event["detail"]["lane"], event["detail"]["candidates"], event["detail"]["sent"]), (None, ["orch-a", "orch-a2"], ["chief-of-staff"]))

    def test_a_worker_that_owns_the_work_item_is_never_taken_for_the_lane(self):
        self.parents = {3: 2, 2: 99, 99: None}   # the plan's own chain reaches a worker's issue (3) but no running orchestrator
        self.clear()
        self.assertEqual(self.lane_event(), (None, None, ["chief-of-staff"]))
        self.assertEqual(self.told("worker"), [])

    def test_the_lane_follows_the_plan_link_up_to_the_charter_when_there_is_no_notice(self):
        self.clear()
        self.assertEqual(len(self.told("orch-a")), 1, "ask 2 sits under charter 1")
        self.assertEqual(self.told("orch-b"), [])
        self.assertEqual(self.events("gate.clear_notified")[0]["detail"]["lane_from"], "the pull request's plan")

    def test_s8_a_lane_that_cannot_be_found_says_lane_unknown_to_the_chief_of_staff_only_and_nobody_is_guessed(self):
        self.no_ledger_plan()
        self.body = "no plan here\n"
        self.clear()
        (line,) = self.told("cos")
        self.assertIn("lane unknown", line)
        self.assertEqual((self.told("orch-a"), self.told("orch-b")), ([], []))
        self.parents = {3: 99}   # a plan under an ask nobody runs
        self.body = "PLAN: https://github.com/acme-org/widget-api/issues/3#issuecomment-1\n"
        self.head = "b" * 40
        self.clear()
        self.assertEqual((self.told("orch-a"), self.told("orch-b")), ([], []))

    def test_s3_the_chat_clear_goes_through_the_same_single_function(self):
        calls = []
        real = sb.notify_clear
        sb.notify_clear = lambda *a, **k: (calls.append(a[1]), real(*a, **k))[1]
        self.addCleanup(setattr, sb, "notify_clear", real)
        self.clear(remove=[self.names["hold-impact"], self.names["merge-captain"]], head=self.HEAD, via="chat:m1")
        self.assertEqual(calls, ["clear"])
        self.assertEqual(len(self.told("cos")), 1)

    def test_s5_a_refused_clear_and_a_head_that_already_had_its_notice_send_nothing(self):
        with self.assertRaises(sb.NoticeError):
            self.clear(head="b" * 40, remove=[self.names["hold-impact"]])   # the head the owner was shown is not the PR's
        self.assertEqual(self.told("cos"), [])
        self.clear()
        self.clear()
        self.assertEqual(len(self.told("cos")), 1, "once per pull request, head and kind")
        self.head = "c" * 40
        self.clear()
        self.assertEqual(len(self.told("cos")), 2, "a new head is a new notice")

    def test_s6_a_send_that_fails_leaves_the_clear_standing_and_is_audited(self):
        def broken(sender, recipient, text, **kwargs):
            raise RuntimeError("herdr is down")
        self.engine.send = broken
        lines = self.clear()
        self.assertIn("cleared the impact hold", lines[0])
        self.assertEqual(sb.read_impact_state(self.world.state)[0]["clears"][self.PR]["head"], self.HEAD, "the clear is recorded")
        self.assertEqual(self.events("gate.hold_cleared")[0]["detail"]["head"], self.HEAD)
        (event,) = self.events("gate.clear_notify_failed")
        self.assertTrue(event["detail"]["failed"])
        self.assertEqual(self.told("cos"), [])

    def test_a_send_that_answers_not_sent_is_audited_as_a_failed_notice_and_the_clear_stands(self):
        real = self.engine.send
        self.engine.send = lambda sender, recipient, text, **kw: {"sent": False, "action": "hold", "reason": "no pane shows %s" % recipient}
        lines = self.clear()
        self.assertIn("cleared the impact hold", lines[0])
        (event,) = self.events("gate.clear_notify_failed")
        self.assertEqual(len(event["detail"]["failed"]), 2, "both recipients: cos and the lane")
        self.assertEqual(self.events("gate.clear_notified"), [])
        self.engine.send = real

    def test_a_token_hidden_behind_a_control_character_never_reaches_the_line(self):
        token = "ghp_" + "a1B2c3D4e5F6g7H8i9J0" * 2
        sb.notify_clear(self.engine, "clear", self.REPO, 7, self.HEAD, reason=token[:12] + "\x07" + token[12:], body="")
        (line,) = self.told("cos")
        self.assertNotIn(token[12:], line)
        self.assertNotIn("a1B2c3D4e5F6g7H8i9J0", line)

    def test_the_notice_is_last_and_a_send_that_blocks_neither_delays_nor_alters_the_clear(self):
        self.body = "MERGE: captain\n\nPLAN: https://github.com/acme-org/widget-api/issues/3\n"
        release = threading.Event()
        real = self.engine.send

        def slow(sender, recipient, text, **kw):
            self.order.append("SEND " + recipient)
            release.wait(1.5)
            return real(sender, recipient, text, **kw)
        self.engine.send = slow
        self.addCleanup(release.set)
        with mock.patch.object(sb, "NOTIFY_CLEAR_DEADLINE_SECONDS", 0.2):
            began = time.monotonic()
            lines = self.clear()
            elapsed = time.monotonic() - began
        self.assertLess(elapsed, 1.0, "the clear did not wait for the blocked send")
        self.assertTrue(self.body.startswith("MERGE: automatic"), "the marker edit is done")
        self.assertTrue(lines[0].startswith("cleared the impact hold") and any("MERGE: automatic" in l for l in lines))
        sends = [i for i, step in enumerate(self.order) if step.startswith("SEND")]
        self.assertTrue(sends and all(any(step.startswith("PATCH") for step in self.order[:i]) for i in sends), "the marker edit happened BEFORE the send was attempted: %s" % self.order)
        (event,) = self.events("gate.clear_notify_failed")
        self.assertIn("notice not sent: timed out", event["detail"]["error"])
        release.set()
        for late in [t for t in threading.enumerate() if t.name == "clear-notice"]:
            late.join(5)   # the late thread has finished: whatever it would have audited is already there
        self.assertEqual(len(self.events("gate.clear_notify_failed")), 1, "the late thread audits nothing more")
        self.assertEqual(self.events("gate.clear_notified"), [])

    def test_an_interrupt_or_an_exit_inside_the_send_leaves_the_clear_complete(self):
        for what in (KeyboardInterrupt, SystemExit):
            self.setUp()
            self.body = "MERGE: captain\nrest\n"

            def bad(sender, recipient, text, **kw):
                raise what()
            self.engine.send = bad
            lines = self.clear()
            self.assertTrue(lines[0].startswith("cleared the impact hold"), what)
            self.assertTrue(self.body.startswith("MERGE: automatic"), what)
            self.assertEqual(sb.read_impact_state(self.world.state)[0]["clears"][self.PR]["head"], self.HEAD, what)

    def test_an_interrupt_while_waiting_for_the_notice_is_audited_and_the_clear_stands(self):
        with mock.patch.object(sb.threading.Thread, "join", side_effect=KeyboardInterrupt()):
            lines = self.clear()
        self.assertTrue(lines[0].startswith("cleared the impact hold"))
        (event,) = self.events("gate.clear_notify_failed")
        self.assertIn("interrupted (KeyboardInterrupt)", event["detail"]["error"])

    def test_s7_the_reason_is_quoted_bounded_on_one_line_with_no_control_character_and_no_token(self):
        token = "ghp_" + "a1B2c3D4e5F6g7H8i9J0" * 2
        reason = "line one\nline two\x1b[31m \x07 " + token + " " + "x" * 500
        sb.notify_clear(self.engine, "clear", self.REPO, 7, self.HEAD, reason=reason, body="")
        (line,) = self.told("cos")
        quote = line.split('"', 1)[1].rsplit('"', 1)[0]
        self.assertLessEqual(len(quote), 300)
        self.assertEqual(line.count("\n"), 0)
        self.assertFalse(re.search(r"[\x00-\x1f\x7f-\x9f]", line))
        self.assertNotIn(token, line)

    def test_the_line_has_no_other_wording_than_the_asked_for_one_and_the_audit_names_both_recipients(self):
        self.clear()
        (line,) = self.told("cos")
        self.assertRegex(line, r'^owner cleared acme-org/widget-api#7 at aaaaaaaa: ".*"; (orch-a merges it|lane unknown)$')

    def test_the_notice_changes_nothing_about_what_the_clear_removes(self):
        self.clear()
        (cleared,) = self.events("gate.hold_cleared")
        self.assertEqual(cleared["detail"]["removed"], [self.names["hold-impact"], self.names["merge-captain"]], "#742: the author's merge label comes off with the clear")


    # ---- #827: a recorded clear's notice is never lost: pending record, the daemon pass, one reminder

    def pending(self):
        return sb._read_small(self.world.state, sb.CLEAR_PENDING_FILE)

    def delivered(self):
        return sb._read_small(self.world.state, sb.CLEAR_NOTIFIED_FILE)

    def later(self, seconds=sb.CLEAR_NOTICE_CLAIM_SECONDS + 1):
        self.world.clock.t += seconds
        return self.world.clock.now()

    def pass_(self, seconds=None):
        sb.clear_notice_pass(self.engine, self.later() if seconds is None else self.later(seconds))

    def block_sends(self):
        """Every send blocks until released: the notice times out at the deadline, as a slow send does under load. Returns the event."""
        release = threading.Event()
        self.addCleanup(release.set)
        self.real_send = self.engine.send
        self.send_returned = []

        def slow(*a, **k):
            release.wait(30)   # only a safety: the tests release it themselves
            self.send_returned.append(1)
            return self.real_send(*a, **k)
        self.engine.send = slow
        return release

    def settle(self):
        for late in [t for t in threading.enumerate() if t.name == "clear-notice"]:
            late.join(5)

    def test_s2_a_notice_that_times_out_is_pending_the_command_says_queued_and_the_next_pass_delivers_it_exactly_once(self):
        release = self.block_sends()
        with mock.patch.object(sb, "NOTIFY_CLEAR_DEADLINE_SECONDS", 0.05):
            lines = self.clear()
        self.assertEqual((release.is_set(), self.send_returned), (False, []), "the command returned while the send was still blocked: it did not wait for it (no clock)")
        self.assertTrue(any("queued for delivery" in l for l in lines), lines)
        key = sb._clear_notice_key(self.REPO, 7, self.HEAD, "clear")
        self.assertIn(key, self.pending())
        self.assertNotIn(key, self.delivered())
        release.set()
        self.settle()   # the late thread of the command may finish its own sends: it is the same record, told once
        self.engine.send = self.real_send
        self.pass_()
        self.pass_()
        self.assertEqual(len(self.told("cos")), 1)
        self.assertEqual(self.pending(), {})
        self.assertIn(key, self.delivered())

    def test_s2_a_notice_cut_off_with_the_process_is_delivered_by_the_pass_to_both_recipients(self):
        sb.record_pr_notice(self.world.state, self.REPO, 7, "worker", "ready", self.world.clock.now(), boss="orch-a")
        self.engine.send = lambda *a, **k: (_ for _ in ()).throw(KeyboardInterrupt())   # the process dies in the first send
        self.clear()
        key = sb._clear_notice_key(self.REPO, 7, self.HEAD, "clear")
        self.assertIn(key, self.pending())
        self.assertEqual((self.told("cos"), self.told("orch-a")), ([], []))
        self.engine.send = self.world.new_engine("daemon").send
        self.pass_()
        self.assertEqual((len(self.told("cos")), len(self.told("orch-a"))), (1, 1))
        self.assertEqual(self.pending(), {})

    def test_s3_a_delivered_notice_is_never_repeated_and_only_the_recipient_not_yet_told_is_told_on_a_retry(self):
        sb.record_pr_notice(self.world.state, self.REPO, 7, "worker", "ready", self.world.clock.now(), boss="orch-a")
        real = self.engine.send
        self.engine.send = lambda s, r, t, **k: {"sent": False, "reason": "down"} if r == "orch-a" else real(s, r, t, **k)
        self.clear()
        key = sb._clear_notice_key(self.REPO, 7, self.HEAD, "clear")
        self.assertEqual(self.pending()[key]["sent"], ["chief-of-staff"])
        self.engine.send = real
        self.pass_()
        self.pass_()
        self.pass_()
        self.assertEqual((len(self.told("cos")), len(self.told("orch-a"))), (1, 1), "cos was told once, the lane once")
        self.assertEqual(self.pending(), {})
        sb.notify_clear(self.engine, "clear", self.REPO, 7, self.HEAD, reason="again", body="")
        self.assertEqual((len(self.told("cos")), len(self.told("orch-a"))), (1, 1), "a delivered notice is not made again")

    def make_pending(self, kind):
        """One pending notice of `kind`, made by the real `notify_clear` with a send that fails; every kind of `sb.CLEAR_NOTICE_KINDS` has its own call."""
        self.engine.send = lambda *a, **k: {"sent": False, "reason": "down"}
        extra = {"clear": dict(reason="a fixture"), "carry": dict(previous="f" * 40)}[kind]
        sb.notify_clear(self.engine, kind, self.REPO, 7, self.HEAD, body="", **extra)
        self.assertEqual(list(self.pending()), [sb._clear_notice_key(self.REPO, 7, self.HEAD, kind)])
        self.engine.send = self.world.new_engine("daemon").send

    def test_the_kinds_table_is_complete_derived_from_the_callers(self):
        import ast
        seen = set()
        for path in (BIN / "fleet-switchboard", BIN / "impact_hold.py"):
            for node in ast.walk(ast.parse(path.read_text())):
                if isinstance(node, ast.Call) and getattr(node.func, "id", "") == "notify_clear" and len(node.args) > 1 and isinstance(node.args[1], ast.Constant):
                    seen.add(node.args[1].value)
        self.assertEqual(seen, set(sb.CLEAR_NOTICE_KINDS), "every kind a caller notifies is in the table, and the table holds no other")
        sb.clear_notice_record(self.engine, "nonsense", self.REPO, 7, self.HEAD)
        self.assertEqual(self.pending(), {}, "a kind outside the table is never recorded")

    def test_s4_for_every_kind_a_pull_request_merged_or_closed_or_with_a_new_head_drops_the_pending_record_and_sends_nothing(self):
        for kind in sb.CLEAR_NOTICE_KINDS:
            for label, state, head in (("merged", "MERGED", self.HEAD), ("closed", "CLOSED", self.HEAD), ("head changed", "OPEN", "b" * 40)):
                with self.subTest(kind=kind, why=label):
                    self.setUp()
                    self.make_pending(kind)
                    self.pr_state, self.head = state, head
                    self.pass_()
                    self.assertEqual(self.pending(), {})
                    self.assertEqual(self.world.admissions("cos"), [])
                    (event,) = self.events("gate.clear_notice_dropped")
                    self.assertTrue(event["detail"]["why"], label)

    def test_s8_for_every_kind_a_pull_request_that_cannot_be_read_whole_keeps_the_record_and_sends_nothing(self):
        for kind in sb.CLEAR_NOTICE_KINDS:
            with self.subTest(kind=kind):
                self.setUp()
                self.make_pending(kind)
                self.unreadable = True
                self.pass_()
                self.assertEqual(len(self.pending()), 1)
                self.assertEqual((self.world.admissions("cos"), self.events("gate.clear_notice_dropped")), ([], []))
                self.unreadable = False
                self.pass_()
                self.assertEqual((len(self.world.admissions("cos")), self.pending()), (1, {}))

    def test_s2_for_every_kind_and_the_standing_order_variant_a_failed_notice_is_pending_and_the_pass_delivers_it_once(self):
        order = {"number": 5, "text": "clear fixtures", "by": "cos"}
        paths = [(kind, {}) for kind in sb.CLEAR_NOTICE_KINDS] + [("clear", {"under_order": order})]
        for kind, extra in paths:
            with self.subTest(kind=kind, extra=sorted(extra)):
                self.setUp()
                self.engine.send = lambda *a, **k: {"sent": False, "reason": "down"}
                kw = dict(extra, **({"previous": "f" * 40} if kind == "carry" else {"reason": "a fixture"}))
                sb.notify_clear(self.engine, kind, self.REPO, 7, self.HEAD, body="", **kw)
                self.assertIn(sb._clear_notice_key(self.REPO, 7, self.HEAD, kind), self.pending())
                self.engine.send = self.world.new_engine("daemon").send
                self.pass_()
                self.pass_()
                (told,) = self.world.admissions("cos")
                self.assertEqual(self.pending(), {})
                self.assertIn(self.HEAD[:8], told["text"])
                self.assertEqual(("under the owner's standing order" in told["text"], "carried" in told["text"]), (bool(extra), kind == "carry"))

    def test_the_notice_wording_is_the_same_whether_the_command_or_the_pass_sends_it(self):
        self.engine.send = lambda *a, **k: {"sent": False, "reason": "down"}
        self.clear(reason="the same words")
        self.engine.send = self.world.new_engine("daemon").send
        self.pass_()
        (line,) = self.told("cos")
        self.assertTrue(line.startswith('owner cleared %s at %s: "the same words"; ' % (self.PR, "a" * 8)), line)

    def test_a_token_in_the_reason_is_never_written_to_the_pending_file(self):
        token = "ghp_" + "a1B2c3D4e5F6g7H8i9J0" * 2
        self.engine.send = lambda *a, **k: {"sent": False, "reason": "down"}
        self.clear(reason="x " + token)
        self.assertNotIn("a1B2c3D4e5F6g7H8i9J0", (Path(self.world.state) / sb.CLEAR_PENDING_FILE).read_text())

    # -- the one reminder

    def ready_pr(self, mergeable="MERGEABLE", ready=True, state="open", head=None, examined=None, whole=True):
        picture = self.engine.__dict__.setdefault("ci_record_state", sb.CiRecordState())
        head = head or self.HEAD
        picture.pr_state["%s#7" % self.REPO] = {"state": state, "head": head, "mergeable": mergeable, "gates": {"ready": ready, "missing": []}, "examined_head": examined or head}
        sb.read_mark(self.engine, "pulls:" + self.REPO, whole, "" if whole else "cut", self.world.clock.now())

    def reminders(self):
        return [a for a in self.world.admissions("orch-a") if "cleared, merge it" in a["text"]]

    def test_s6_one_reminder_per_head_after_the_delay_and_a_new_cleared_head_gets_its_own(self):
        sb.record_pr_notice(self.world.state, self.REPO, 7, "worker", "ready", self.world.clock.now(), boss="orch-a")
        self.clear()
        self.ready_pr()
        self.pass_(14 * 60 - sb.CLEAR_NOTICE_CLAIM_SECONDS - 1)
        self.assertEqual(self.reminders(), [], "not before clear_remind_minutes")
        self.pass_(120)
        self.pass_()
        self.pass_()
        self.assertEqual(len(self.reminders()), 1)
        self.head = "c" * 40
        self.clear()
        self.ready_pr(head="c" * 40)
        self.pass_(15 * 60)
        self.pass_()
        self.assertEqual(len(self.reminders()), 2)

    def count_sends(self, only=None, to=None):
        """Wrap the engine's send: every call to it is counted (the ones whose text holds `only`, when given); a send that always fails. Returns the list of calls."""
        calls = []

        def down(sender, recipient, text, **kw):
            if (only is None or only in text) and (to is None or recipient == to):
                calls.append(self.world.clock.now())
                return {"sent": False, "reason": "down"}
            return self.real_send(sender, recipient, text, **kw)
        self.real_send = self.world.new_engine("daemon").send
        self.engine.send = down
        return calls

    def run_cadence(self, seconds, step=5):
        """The daemon's REAL pass cadence: a pass every `step` seconds of the fake clock for `seconds` (never one jump per pass)."""
        for _ in range(seconds // step):
            sb.clear_notice_pass(self.engine, self.later(step))

    def test_s3_for_every_kind_a_lane_that_is_down_for_ten_minutes_still_gets_the_notice_when_it_is_back_and_the_retries_are_spaced(self):
        for kind in sb.CLEAR_NOTICE_KINDS:
            with self.subTest(kind=kind):
                self.setUp()
                calls = self.count_sends(to="chief-of-staff")
                extra = {"clear": dict(reason="a fixture"), "carry": dict(previous="f" * 40)}[kind]
                sb.notify_clear(self.engine, kind, self.REPO, 7, self.HEAD, body="", **extra)
                self.assertEqual(len(calls), 1, "the command tries once")
                self.run_cadence(55)
                self.assertEqual(len(calls), 1, "nothing is retried in the first minute: the 5 s passes do not spend the tries")
                self.run_cadence(545)   # ten minutes in all
                self.assertEqual(len(calls), 1 + len(sb.CLEAR_NOTICE_BACKOFF[:3]), "retries after the backoff steps (1, 2 and 5 minutes), not one per pass")
                self.assertEqual(len(self.pending()), 1, "ten minutes down: still pending, not given up")
                self.assertEqual(self.events("gate.clear_notice_abandoned"), [])
                self.engine.send = self.real_send   # the lane is back
                self.run_cadence(sb.CLEAR_NOTICE_BACKOFF[3] + 5)
                self.assertEqual(self.pending(), {})
                self.assertEqual(len(self.world.admissions("cos")), 1, "told once")

    def test_s3_for_every_kind_a_notice_pending_for_longer_than_the_age_bound_is_given_up_loudly_never_by_a_count(self):
        for kind in sb.CLEAR_NOTICE_KINDS:
            with self.subTest(kind=kind):
                self.setUp()
                calls = self.count_sends(to="chief-of-staff")
                extra = {"clear": dict(reason="a fixture"), "carry": dict(previous="f" * 40)}[kind]
                sb.notify_clear(self.engine, kind, self.REPO, 7, self.HEAD, body="", **extra)
                self.run_cadence(3600)
                self.assertEqual(len(self.pending()), 1, "an hour of failures is not a reason to give up")
                before = len(calls)
                sb.clear_notice_pass(self.engine, self.later(sb.CLEAR_NOTICE_MAX_AGE_SECONDS))
                (event,) = self.events("gate.clear_notice_abandoned")
                self.assertIn("gave up", event["detail"]["why"])
                self.assertEqual((self.pending(), len(calls)), ({}, before))

    def test_a_malformed_pending_entry_is_quarantined_and_the_notices_after_it_are_still_delivered(self):
        self.make_pending("clear")
        pending = self.pending()
        (good,) = pending
        for label, bad in {"at": {"at": "x"}, "claimed": {"claimed": "y"}, "next_at": {"next_at": []}, "not a notice": {"kind": "nope"}, "under_order": {"under_order": 3}}.items():
            with self.subTest(label):
                poisoned = dict(pending, poison=dict(dict(pending[good], number=9), **bad))
                poisoned["poison"]["at"] = poisoned["poison"].get("at", 0)
                sb._write_small(self.world.state, sb.CLEAR_PENDING_FILE, poisoned)
                sb.clear_notice_pass(self.engine, self.later())
                self.assertEqual(self.pending(), {}, "the good one is delivered and the poison is gone")
                self.assertTrue(self.events("gate.clear_notice_quarantined"))
                self.world.admissions("cos").clear() if False else None
                self.setUp()
                self.make_pending("clear")
                pending = self.pending()
                (good,) = pending

    def test_the_cap_of_pending_notices_audits_what_it_drops(self):
        filler = {sb._clear_notice_key(self.REPO, 100 + i, "e" * 40, "clear"): {"repo": self.REPO, "number": 100 + i, "head": "e" * 40, "kind": "clear", "at": i + 1, "claimed": 0, "attempts": 0, "sent": []} for i in range(sb.CLEAR_PENDING_MAX)}
        sb._write_small(self.world.state, sb.CLEAR_PENDING_FILE, filler)
        self.engine.send = lambda *a, **k: {"sent": False, "reason": "down"}
        sb.notify_clear(self.engine, "clear", self.REPO, 7, self.HEAD, reason="x", body="")
        self.assertEqual(len(self.pending()), sb.CLEAR_PENDING_MAX)
        (event,) = self.events("gate.clear_notice_dropped_cap")
        self.assertIn("oldest", event["detail"]["why"])

    def test_a_corrupt_pending_file_is_kept_aside_and_audited_never_overwritten_silently(self):
        path = Path(self.world.state) / sb.CLEAR_PENDING_FILE
        path.write_text("{ this is not json")
        self.engine.send = lambda *a, **k: {"sent": False, "reason": "down"}
        sb.notify_clear(self.engine, "clear", self.REPO, 7, self.HEAD, reason="x", body="")
        self.assertEqual(Path(str(path) + ".corrupt").read_text(), "{ this is not json")
        self.assertTrue(self.events("gate.clear_notice_corrupt"))
        self.assertEqual(len(self.pending()), 1, "the new notice is recorded in a fresh file")

    def test_one_pull_request_is_read_once_per_pass_however_many_notices_are_pending_for_it(self):
        self.make_pending("clear")
        self.engine.send = lambda *a, **k: {"sent": False, "reason": "down"}
        sb.notify_clear(self.engine, "carry", self.REPO, 7, self.HEAD, body="", previous="f" * 40)
        self.engine.send = self.world.new_engine("daemon").send
        self.assertEqual(len(self.pending()), 2)
        self.later()
        reads = []
        real = sb.read_pr_json
        with mock.patch.object(sb, "read_pr_json", side_effect=lambda *a, **k: (reads.append(1), real(*a, **k))[1]):
            sb.clear_notice_pass(self.engine, self.later())
        self.assertEqual(len(reads), 1)

    def test_a_reminder_send_that_always_fails_is_spaced_by_the_backoff_given_up_only_by_age_and_never_recorded_as_sent(self):
        sb.record_pr_notice(self.world.state, self.REPO, 7, "worker", "ready", self.world.clock.now(), boss="orch-a")
        self.clear()
        self.ready_pr()
        calls = self.count_sends(only="cleared, merge it")
        self.run_cadence(15 * 60)
        first = len(calls)
        self.assertEqual(first, 1, "the first reminder is tried once at the delay")
        self.run_cadence(10 * 60)
        self.assertEqual(len(calls), 1 + len(sb.CLEAR_NOTICE_BACKOFF[:3]) - 1 + (1 if sb.CLEAR_NOTICE_BACKOFF[0] + sb.CLEAR_NOTICE_BACKOFF[1] + sb.CLEAR_NOTICE_BACKOFF[2] <= 10 * 60 else 0), "spaced by the backoff, not one per pass")
        self.assertEqual(self.events("gate.clear_remind_abandoned"), [])
        sb.clear_notice_pass(self.engine, self.later(sb.CLEAR_NOTICE_MAX_AGE_SECONDS))
        self.assertEqual(self.events("gate.clear_reminded"), [], "a reminder that was never delivered is not recorded as sent")
        (event,) = self.events("gate.clear_remind_abandoned")
        self.assertIn("down", event["detail"]["error"])

    def test_s7_no_reminder_when_not_mergeable_not_ready_not_open_at_the_cleared_head_or_not_examined_there(self):
        cases = {"conflicting": dict(mergeable="CONFLICTING"), "gates not ready": dict(ready=False), "draft": dict(state="draft"), "gone": dict(state="gone"),
                 "head moved": dict(head="d" * 40, examined="d" * 40), "not examined at the head": dict(examined="d" * 40)}
        for label, kw in cases.items():
            with self.subTest(label):
                self.setUp()
                sb.record_pr_notice(self.world.state, self.REPO, 7, "worker", "ready", self.world.clock.now(), boss="orch-a")
                self.clear()
                self.ready_pr(**kw)
                self.pass_(16 * 60)
                self.assertEqual(self.reminders(), [], label)

    def test_s8_a_list_that_is_not_whole_gives_no_reminder_and_the_reminder_comes_when_it_is(self):
        sb.record_pr_notice(self.world.state, self.REPO, 7, "worker", "ready", self.world.clock.now(), boss="orch-a")
        self.clear()
