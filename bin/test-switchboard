    def floor_matchers(self):
        return sb.impact_floor.matches, {}

    def test_the_spellings_of_a_machinery_path_are_all_refused_and_a_new_bin_file_and_a_rename_are_refused(self):
        module = sb.load_module("delegated_clear")
        rule = sb.impact_floor.load_matrix()["owner_hold"]["delegated_clear"]
        good = {"owner_decision": "hold", "complete": True, "unknown": None, "renamed_no_source": [], "top_tier_hits": {"authority": ["x"]}, "review_action": "none", "review_class": None, "changed_paths": []}
        import unicodedata
        refused = ["BIN/CHAT_CLEAR.PY", "./bin/chat_clear.py", "bin//chat_clear.py", "docs/../bin/chat_clear.py", "bin/chat_cl\u00e9ar.py".replace("\u00e9", "e"), unicodedata.normalize("NFD", "bin/delegated_clear.py"),
                   "bin/impact_hold.py", "bin/plan_check.py", "bin/plan_ledger.py", "bin/repo_exclusion.py", "shims/gh", "plugins/fleet-hooks/x.mjs", ".github/workflows/ci.yml", "docs/review-laws/impact-matrix.json", "DOCS/REVIEW-LAWS/IMPACT-MATRIX.JSON"]
        for path in refused:
            for shape in ({"filename": path, "status": "modified"}, {"filename": "docs/ok.md", "previous_filename": path, "status": "renamed"}):
                self.assertTrue(module.refusals(rule, good, [shape], sb.impact_floor.matches, {}), (path, shape))
        for shape in ({"filename": "bin/newmodule.py", "status": "added"}, {"filename": "bin/gone.py", "status": "removed"}, {"filename": "BIN/Newmodule.py", "status": "added"},
                      {"filename": "docs/was_bin.py", "previous_filename": "bin/anything.py", "status": "renamed"}, {"filename": "bin/b.py", "previous_filename": "bin/a.py", "status": "renamed"}):
            self.assertTrue(module.refusals(rule, good, [shape], sb.impact_floor.matches, {}), shape)
        self.assertTrue(module.refusals(rule, good, [{"filename": "a\x00b", "status": "modified"}], sb.impact_floor.matches, {}), "a path with a NUL cannot be told: refused")
        for allowed in ({"filename": "docs/switchboard.md", "status": "modified"}, {"filename": "README.md", "status": "modified"}, {"filename": "bin/test-switchboard", "status": "modified"},
                        {"filename": "bin/decision_core.py", "status": "modified"}, {"filename": "bin/lanes.py", "status": "modified"}, {"filename": "bin/triage_digest.py", "status": "modified"}):
            self.assertEqual(module.refusals(rule, good, [allowed], sb.impact_floor.matches, {allowed["filename"]: []}), [], allowed)
        self.assertTrue(module.refusals(rule, good, [{"filename": "bin/fleet-switchboard", "status": "modified"}], sb.impact_floor.matches, {}), "the daemon file with no mapping: refused")
        self.assertEqual(module.refusals(rule, good, [{"filename": "bin/fleet-switchboard", "status": "modified"}], sb.impact_floor.matches, {"bin/fleet-switchboard": []}), [])

    def real_source(self):
        return (BIN / "fleet-switchboard").read_text()

    def edit_one_line_under(self, source, name):
        """The source with one comment added at the end of the first body line of module-level function `name` (a one-line change right under the def), and its unified diff."""
        import difflib
        lines = source.split("\n")
        i = next(k for k, l in enumerate(lines) if l.startswith("def %s(" % name))
        j = i
        while not lines[j].rstrip().endswith(":"):
            j += 1
        head = list(lines)
        head[j + 1] = head[j + 1] + "  # x"
        diff = "\n".join(list(difflib.unified_diff(lines, head, lineterm="", n=3))[2:])
        return "\n".join(head), diff

    def closure_check(self, head, diff):
        rule = sb.impact_floor.load_matrix()["owner_hold"]["delegated_clear"]
        return sb.load_module("delegated_clear").closure_refusals(self.real_source(), head, diff, sb.load_module("delegated_clear").daemon_roots(rule), set(rule["clear_entry_points"]), False, rule["dynamic_actions"])

    def test_the_five_functions_hunk_headers_missed_are_refused_by_the_ast_on_the_real_daemon_file(self):
        source = self.real_source()
        for name in ("fetch_orders", "_intent_reader", "impact_carry_get", "read_pr_json"):
            head, diff = self.edit_one_line_under(source, name)
            self.assertTrue(self.closure_check(head, diff), name)

    def test_an_unrelated_edit_in_the_daemon_file_is_allowed_and_a_new_call_into_the_clear_is_refused(self):
        source = self.real_source()
        for name in ("cmd_triage", "format_decisions_status", "decisions_from_notices", "triage_pass"):
            self.assertIn("def %s(" % name, source)
            head, diff = self.edit_one_line_under(source, name)
            self.assertEqual(self.closure_check(head, diff), [], name)
        import difflib
        lines = source.split("\n")
        i = next(k for k, l in enumerate(lines) if l.startswith("def format_decisions_status("))
        j = i
        while not lines[j].rstrip().endswith(":"):
            j += 1
        head = list(lines)
        head[j + 1] = "    impact_clear_core(None, None, 'a/b', 1, 'someone', 'a long enough reason')\n" + head[j + 1]
        diff = "\n".join(list(difflib.unified_diff(lines, head, lineterm="", n=3))[2:])
        reasons = self.closure_check("\n".join(head), diff)
        self.assertTrue(reasons and "clear entry point" in " ".join(reasons), reasons)

    def test_a_global_the_clear_reads_a_top_level_statement_a_syntax_error_and_a_cut_patch_are_refused(self):
        import difflib
        source = self.real_source()
        lines = source.split("\n")
        def refuse(new_lines):
            diff = "\n".join(list(difflib.unified_diff(lines, new_lines, lineterm="", n=3))[2:])
            return self.closure_check("\n".join(new_lines), diff)
        k = next(i for i, l in enumerate(lines) if l.startswith("PROG = "))
        changed = list(lines); changed[k] = 'PROG = "other"'
        self.assertTrue(refuse(changed), "a module-level binding the clear reads")
        self.assertTrue(refuse(lines + ["if True:", "    pass"]), "a new top-level statement")
        self.assertTrue(refuse(lines[:k] + ["def broken(:"] + lines[k:]), "a syntax error after the change")
        self.assertTrue(self.closure_check(source, None), "no patch")
        self.assertTrue(self.closure_check(source, "@@ garbage @@"), "a hunk header that cannot be read")
        comment = list(lines); comment.insert(k, "# a comment between the definitions")
        self.assertEqual(refuse(comment), [], "a comment between top-level statements changes nothing")

    def test_a_name_read_through_a_binding_is_followed_to_what_it_runs(self):
        source = self.real_source()
        lines = source.split("\n")
        import difflib
        def refuse(new_lines):
            diff = "\n".join(list(difflib.unified_diff(lines, new_lines, lineterm="", n=1))[2:])
            return self.closure_check("\n".join(new_lines), diff)
        k = next(i for i, l in enumerate(lines) if l.strip() == '"load_impact_floor": "impact_floor",')
        mutant = list(lines)
        mutant[k] = mutant[k].replace('"impact_floor"', '"lanes"')
        self.assertNotEqual(mutant, lines, "the mutant changed the loader table")
        self.assertTrue(refuse(mutant), "load_impact_floor, generated from the table, returning another module")
        k = next(i for i, l in enumerate(lines) if l.startswith("def _make_loader("))
        mutant = list(lines)
        mutant.insert(k + 1, "    # touched")
        self.assertTrue(refuse(mutant), "the function that makes the loaders")
        k = next(i for i, l in enumerate(lines) if l.startswith("class _LazyImpactFloor"))
        mutant = list(lines)
        mutant.insert(k + 2, "    # touched")
        self.assertTrue(refuse(mutant), "a line in the lazy loader class")
        k = next(i for i, l in enumerate(lines) if l.startswith("class _LazyPlanLedger"))
        mutant = list(lines)
        mutant.insert(k + 2, "    # touched")
        self.assertTrue(refuse(mutant), "a line in the lazy ledger class")

    def synthetic(self, base, head):
        import difflib
        diff = "\n".join(list(difflib.unified_diff(base.split("\n"), head.split("\n"), lineterm="", n=1))[2:])
        return sb.load_module("delegated_clear").closure_refusals(base, head, diff, ["root"], {"root"})

    def test_a_class_the_clear_refers_to_runs_only_the_methods_it_reads_and_the_special_ones(self):
        base = "class Source:\n    def __init__(self):\n        self.a = 1\n\n    def read(self):\n        return 1\n\n    def other(self):\n        return 2\n\nREGISTRY = (Source,)\n\ndef root():\n    return REGISTRY\n"
        self.assertEqual(self.synthetic(base, base.replace("return 2", "return 3")), [], "a method nothing reads is not run")
        self.assertTrue(self.synthetic(base, base.replace("self.a = 1", "self.a = 2")), "a special method of a class the clear refers to runs")
        reader = base.replace("    return REGISTRY", "    return REGISTRY[0]().read()")
        self.assertTrue(self.synthetic(reader, reader.replace("return 1", "return 9")), "a method the clear reads by name (an attribute) is in the closure")
        self.assertEqual(self.synthetic(reader, reader.replace("return 2", "return 9")), [], "the other member still is not")
        mutant = base.replace("    return REGISTRY", "    return REGISTRY, Source.other")
        self.assertTrue(self.synthetic(mutant, mutant.replace("return 2", "return 3")), "a mutant that makes the clear read the other member refuses an edit to it")
        self.assertTrue(self.synthetic(base, base.replace("REGISTRY = (Source,)", "REGISTRY = (Source, Other)")), "the binding the clear reads")

    def test_a_line_holding_two_statements_is_judged_by_both_and_a_dropped_reference_to_the_clear_is_refused(self):
        base = "def root():\n    return 1\n\nHARMLESS = 1\n\ndef other():\n    return root\n"
        self.assertTrue(self.synthetic(base, base.replace("HARMLESS = 1", "HARMLESS = 1; root = lambda: 2")), "a second statement on the changed line rebinds the clear")
        self.assertTrue(self.synthetic(base, base.replace("HARMLESS = 1", "HARMLESS = 1; OTHER = 2")), "a changed line with two statements is refused")
        self.assertTrue(self.synthetic(base, base.replace("return root", "return None")), "removing a reference to a clear entry point is refused (the base is read too)")
        self.assertEqual(self.synthetic(base, base.replace("HARMLESS = 1", "HARMLESS = 2")), [])

    def test_the_glue_that_maps_a_daemon_file_reads_both_blobs_and_refuses_what_it_cannot_read(self):
        import base64
        module = sb.load_module("delegated_clear")
        text = base64.b64encode(b"def a():\n    return 1\n").decode()
        self.assertEqual(module.decode_blob({"encoding": "base64", "content": text}), "def a():\n    return 1\n")
        wrapped = base64.b64encode(("def a():\n    return 1\n" * 20).encode()).decode()
        wrapped = "\n".join(wrapped[i:i + 60] for i in range(0, len(wrapped), 60)) + "\n"
        self.assertGreater(wrapped.count("\n"), 2)
        self.assertEqual(module.decode_blob({"encoding": "base64", "content": wrapped}), "def a():\n    return 1\n" * 20, "the API wraps base64 every 60 characters")
        for bad in (None, {}, {"encoding": "utf-8", "content": "x"}, {"encoding": "base64", "content": "!!!"}, {"encoding": "base64", "content": base64.b64encode(b"\xff\xfe").decode()}):
            self.assertIsNone(module.decode_blob(bad), bad)
        rule = sb.impact_floor.load_matrix()["owner_hold"]["delegated_clear"]
        answers = {}
        def fake(engine, runner, repo, path):
            for key, value in answers.items():
                if key in path:
                    if isinstance(value, Exception):
                        raise value
                    return value
            raise sb.IntentError("not found")
        item = {"filename": "bin/fleet-switchboard", "sha": "headsha", "patch": "@@ -1,2 +1,2 @@\n def a():\n-    return 1\n+    return 2"}
        answers.update({"contents/bin/fleet-switchboard": {"type": "file", "sha": "basesha"}, "git/blobs/basesha": {"encoding": "base64", "content": text},
                        "git/blobs/headsha": {"encoding": "base64", "content": base64.b64encode(b"def a():\n    return 2\n").decode()}})
        with mock.patch.object(sb, "_gh_json", fake):
            self.assertEqual(sb.delegated_clear_map(None, None, "acme-org/widget-api", item, "b" * 40, rule), [])
            self.assertIsNone(sb.delegated_clear_map(None, None, "acme-org/widget-api", dict(item, patch=None), "b" * 40, rule), "no patch")
            answers["git/blobs/headsha"] = {"encoding": "base64", "content": "!!!"}
            self.assertIsNone(sb.delegated_clear_map(None, None, "acme-org/widget-api", item, "b" * 40, rule), "a blob that does not decode")
            answers["contents/bin/fleet-switchboard"] = [{"name": "x"}]
            self.assertIsNone(sb.delegated_clear_map(None, None, "acme-org/widget-api", item, "b" * 40, rule), "a directory, not a file")
            self.assertIsNone(sb.delegated_clear_map(None, None, "acme-org/widget-api", item, None, rule), "no merge-base: refused")
            self.assertTrue(rule["closure_roots"], "the roots are named")

    def test_a_repeated_order_number_makes_the_whole_feature_off(self):
        module = sb.load_module("delegated_clear")
        entry = lambda n, h: {"number": n, "sha256": h * 64}
        config = {"delegated_clear": {"orders": [entry(17, "a"), entry(17, "b")], "charter": 40}}
        self.assertIsNone(module.settings(config))
        with self.assertRaises(ValueError):
            module.validate(config["delegated_clear"], "config")

    def test_the_refusals_table_of_the_pure_module(self):
        module = sb.load_module("delegated_clear")
        rule = sb.impact_floor.load_matrix()["owner_hold"]["delegated_clear"]
        good = {"owner_decision": "hold", "complete": True, "unknown": None, "renamed_no_source": [], "top_tier_hits": {"authority": ["x"]}, "review_action": "none", "review_class": None, "changed_paths": ["x"]}
        files = [{"filename": "docs/x.md", "patch": "@@ -1 +1 @@\n-a\n+b"}]
        self.assertEqual(module.refusals(rule, good, files, *self.floor_matchers()), [])
        cases = (("complete false", dict(good, complete=False)), ("unknown", dict(good, unknown="3 of 9 files")), ("renamed", dict(good, renamed_no_source=["a"])),
                 ("unreadable decision", dict(good, owner_decision=None)), ("credentials upper case", dict(good, top_tier_hits={"Credentials": ["shims/gh"]})),
                 ("review class mixed case", dict(good, review_class="Identity")), ("no review", dict(good, review_action=None)))
        for label, report in cases:
            self.assertTrue(module.refusals(rule, report, files, *self.floor_matchers()), label)
        self.assertTrue(module.refusals(rule, good, None, *self.floor_matchers()), "no file list")
        self.assertTrue(module.refusals(rule, good, [{"filename": "bin/fleet-switchboard"}], *self.floor_matchers()), "the daemon file")
        self.assertTrue(module.refusals(rule, good, [{"filename": "docs/x.md", "previous_filename": "bin/chat_clear.py"}], *self.floor_matchers()), "a rename out of a clear-code file")
        self.assertTrue(module.refusals(dict(rule, clear_code_paths="x"), good, files, *self.floor_matchers()), "a malformed rule")
        self.assertTrue(module.refusals(None, good, files, *self.floor_matchers()))
        self.assertFalse(module.caller_is_chief(("agent", "x", "orchestrator")))
        self.assertFalse(module.caller_is_chief(("person", "me")))
        self.assertFalse(module.caller_is_chief(("agent", "x")))
        self.assertTrue(module.caller_is_chief(("agent", "x", "chief-of-staff")))

    def test_s7_the_clear_is_bound_to_the_head_and_the_chief_of_staff_can_revoke_under_the_order(self):
