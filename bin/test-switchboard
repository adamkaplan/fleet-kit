    def test_nothing_in_the_triage_can_write_to_github(self):
        source = Path(sb.__file__).read_text() if hasattr(sb, "__file__") else ""
        text = open(str(REPO / "bin" / "fleet-switchboard")).read()
        start, end = text.index("# ---- #130: the triage function"), text.index("# ---- the daily friction wake")
        section = text[start:end]
        for forbidden in ("--method", "-X ", "issue edit", "issue comment", "issue close", "add-label", "--add-label",
                          "assignee", "POST", "PATCH", "DELETE", "subprocess", "gh_api("):
            if forbidden == "assignee":
                continue   # the word appears as a field NAME read from a record
            self.assertNotIn(forbidden, section, forbidden)
        self.assertTrue(all(c.split("?")[0].split("/")[-1] in ("issues", "comments") or "/issues/" in c for c in self.hub.calls))

    def test_config_is_validated_off_by_false_and_absent_adds_nothing(self):
        base = {"opencode": FAKE_OPENCODE}
        self.assertNotIn("triage", sb.validate_config(dict(base)))
        self.assertFalse(sb.validate_config(dict(base, triage={}))["triage"]["enabled"])
        self.assertIs(sb.validate_config(dict(base, triage=False))["triage"], False)
        for bad in ({"enabled": "yes"}, {"repos": ["notarepo"]}, {"sla": {"t1_days": 0}}, {"sla": {"nope": 1}},
                    {"required_labels": {"a/b": "kind"}}, {"sla_overrides": {"a/b": {"t1_days": -1}}}):
            with self.assertRaises(sb.ConfigError):
                sb.validate_config(dict(base, triage=bad))
        self.assertEqual(sb.triage_sla({"sla": {"t1_days": 2}, "sla_overrides": {"a/b": {"t1_days": 5}}}, "a/b")["t1_days"], 5)

    def test_other_owner_flags_are_not_our_findings_and_never_wake_cos_alone(self):
        self.charter()
        self.add(180, created=40, updated=40, author="stranger")                  # only an OO flag
        self.go(enabled=True)
        self.assertEqual(self.only("OO"), ["acme/api#180"])                      # audited
        self.assertEqual(sb.triage_summary(self.world.state)["counts"], {})      # not counted as ours
        self.assertEqual(sb.triage_summary(self.world.state)["total"], 0)
        self.assertEqual(sb.triage_summary(self.world.state)["other_owner"], 1)
        self.assertEqual([k for k in self.engine.triage.facts if "summary" not in k], [])   # never a wake on its own
        self.add(181, created=3, labels=["kind"])                                 # a real finding of ours
        self.world.tick(sb.TRIAGE_TTL + 5)
        self.go(enabled=True)
        ((_, (text, _)),) = [(k, v) for k, v in self.engine.triage.facts.items() if "summary" not in k]
        self.assertIn("acme/api#181 T1", text)
        self.assertNotIn("acme/api#180", text)
        self.assertIn("Also 1 other-owner flag(s)", text)                         # a count only, when a wake happens anyway
        self.assertIn("1 other-owner flag(s)", "\n".join(sb.triage_status_lines(sb.triage_summary(self.world.state))))

    def test_the_summary_is_every_24_hours_since_the_last_one_not_per_calendar_day(self):
        self.charter()
        self.add(190, created=3, labels=["kind"])
        self.go(enabled=True)
        count = lambda: len([e for e in self.world.audit() if e["event"] == "triage.summary"])
        self.assertEqual(count(), 1)
        first = self.engine.triage.summarised
        self.world.tick(23 * 3600)
        self.go(passes=2, enabled=True)
        self.assertEqual(count(), 1)                                              # 23 h later: not yet, even across midnight
        self.world.tick(3600 + 5)
        self.go(passes=2, enabled=True)
        self.assertEqual(count(), 2)
        self.assertGreaterEqual(self.engine.triage.summarised - first, 86400)
        self.assertIn("other-owner flags", [e for e in self.world.audit() if e["event"] == "triage.summary"][0]["detail"]["text"])

    def many_unowned(self, count, other=0):
        for n in range(100, 100 + count):
            self.add(n, created=3, labels=["kind"])                 # ours (bot) and unowned: a T1
        for n in range(500, 500 + other):
            self.add(n, created=3, labels=["kind"], author="someone-else")   # not ours: an other-owner flag

    def run_minutes(self, minutes, step=15):
        seen = []
        for _ in range(int(minutes * 60 // step)):
            self.world.tick(step)
            sb.triage_pass(self.engine, [], self.world.clock.now(), ())
            seen.append(sb.triage_summary(self.world.state))
        return seen

    def test_after_a_restart_our_findings_are_confirmed_before_any_other_owner_flag_and_it_drains(self):
        self.charter()
        self.many_unowned(40, other=60)
        real = self.hub._read_one

        def slow(repo, path, now, fresh=False):   # each fresh read takes a second: the pass's 10 s bound, not the call budget, is the limit
            self.world.tick(1)
            return real(repo, path, now, fresh)
        self.hub._read_one = slow
        seen = self.run_minutes(20)
        ours = seen[-1]["total"]   # each unowned issue is a T1 and a T3 (no next step)
        first_all_ours = next(c for c in seen if c["total"] >= ours)
        self.assertGreaterEqual(first_all_ours["unchecked_other_owner"], 50, "ours were done while the flags still waited")
        self.assertEqual(first_all_ours["unchecked"], first_all_ours["unchecked_other_owner"])
        self.assertEqual(seen[-1]["unchecked"], 0, "and the whole list drains within a bounded number of passes")
        unchecked = [c["unchecked"] for c in seen]
        self.assertEqual(unchecked[unchecked.index(0):], [0] * (len(unchecked) - unchecked.index(0)), "and stays drained at the TTL")

    def test_our_findings_are_checked_before_the_other_owner_flags(self):
        self.charter()
        self.many_unowned(10, other=60)
        self.engine.config["triage"]["calls_per_pass"] = 40
        first = None
        for _ in range(4):
            self.world.tick(15)
            sb.triage_pass(self.engine, [], self.world.clock.now(), ())
            first = first or sb.triage_summary(self.world.state)
        self.assertEqual(first["counts"].get("T1"), 10, "all ten of ours checked in the very first pass, ahead of 60 flags")
        self.assertGreater(first["unchecked_other_owner"], 0)
        self.assertEqual(first["unchecked"], first["unchecked_other_owner"])

    def test_every_finding_is_reached_within_a_bounded_number_of_passes_and_the_oldest_age_is_reported(self):
        self.charter()
        self.many_unowned(10, other=80)
        self.engine.config["triage"]["calls_per_pass"] = 10
        seen = self.run_minutes(20)
        self.assertEqual(seen[-1]["unchecked"], 0)
        self.assertTrue(any(c["oldest_unchecked_seconds"] > 0 for c in seen))
        lines = "\n".join(sb.triage_status_lines(dict(seen[0], unchecked=5, unchecked_other_owner=3, oldest_unchecked_seconds=185)))
        self.assertIn("5 finding(s) not checked this pass (call budget or a failed read) (3 of them other-owner flags); oldest unchecked for 3m", lines)

    def seven_repos(self):
        repos = ["acme/r%d" % i for i in range(7)]
        for repo in repos:
            self.hub.open[repo] = {1: tri_issue(self.now, 1, created=3, updated=0.2, labels=["kind"], repo=repo)}   # unowned: a T1
        self.engine.config["triage"]["repos"] = repos
        return repos

    def test_the_default_budget_covers_a_seven_repo_fleet_in_two_passes(self):
        self.assertEqual(sb.TRIAGE_CALLS_PER_PASS, 30)
        repos = self.seven_repos()
        self.world.tick(1)
        sb.triage_pass(self.engine, [], self.world.clock.now(), ())
        first = len(self.hub.calls)
        self.assertLessEqual(first, 30)
        self.world.tick(1)
        sb.triage_pass(self.engine, [], self.world.clock.now(), ())
        read = {r for r, u in self.engine.triage.units if u == "issues"}
        self.assertEqual(read, set(repos))                          # every repo's issues are in after two passes
        self.assertTrue(all((r, u) in self.engine.triage.units for r in repos
                            for u in ("issues", "comments", "closed:osuser:awaiting-user", "closed:osuser:awaiting-cos")))
        self.assertLessEqual(len(self.hub.calls), 60)

    def test_unchecked_reaches_zero_in_steady_state_and_the_cache_keeps_it_cheap(self):
        self.seven_repos()
        for _ in range(8):
            self.world.tick(1)
            sb.triage_pass(self.engine, [], self.world.clock.now(), ())
        current = sb.triage_summary(self.world.state)
        self.assertEqual((current["unchecked"], current["unchecked_units"], current["counts"]), (0, {}, {"T1": 7}))
        calls = len(self.hub.calls)
        for _ in range(5):                                             # inside the 15-minute cache: no gh call at all
            self.world.tick(1)
            sb.triage_pass(self.engine, [], self.world.clock.now(), ())
        self.assertEqual(len(self.hub.calls), calls)

    def test_the_budget_is_configurable_and_the_cap_is_enforced(self):
        self.seven_repos()
        worst = 0
        for _ in range(6):
            before = len(self.hub.calls)
            self.world.tick(1)
            self.go(passes=0)
            self.engine.config["triage"]["calls_per_pass"] = 8
            sb.triage_pass(self.engine, [], self.world.clock.now(), ())
            worst = max(worst, len(self.hub.calls) - before)
        self.assertLessEqual(worst, 8)
        base = {"opencode": FAKE_OPENCODE}
        self.assertEqual(sb.validate_config(dict(base, triage={"calls_per_pass": 100}))["triage"]["calls_per_pass"], 100)
        for bad in ({"calls_per_pass": 101}, {"calls_per_pass": 3}, {"calls_per_pass": "30"}, {"pass_seconds": 0},
                    {"pass_seconds": 61}):
            with self.assertRaises(sb.ConfigError):
                sb.validate_config(dict(base, triage=bad))

    def test_the_precision_sheet_is_local_deduplicated_and_summarised(self):
        import importlib.machinery, importlib.util
        loader = importlib.machinery.SourceFileLoader("triage_sample", str(REPO / "bin" / "triage-sample"))
        spec = importlib.util.spec_from_loader("triage_sample", loader)
        tool = importlib.util.module_from_spec(spec)
        loader.exec_module(tool)
        self.charter()
        self.add(170, created=3, updated=0.2, labels=["kind"])
        self.add(171, created=3, updated=0.2, labels=["kind"])
        self.go()
        self.world.tick(60)
        self.go(passes=1)
        out = Path(self.home) / "sheet.jsonl"
        code = tool.main(["--audit", str(self.world.audit_path), "--out", str(out), "--days", "1"])
        self.assertEqual(code, 0)
        rows = [json.loads(l) for l in out.read_text().splitlines()]
        self.assertEqual(sorted((r["rule"], r["ref"]) for r in rows), [("T1", "acme/api#170"), ("T1", "acme/api#171")])
        self.assertEqual({(r["label"], r["note"]) for r in rows}, {(None, None)})
        self.assertEqual(oct(out.stat().st_mode & 0o777), "0o600")
        rows[0]["label"], rows[1]["label"] = "TP", "fp"
        out.write_text("\n".join(json.dumps(r) for r in rows) + "\n")
        text = tool.format_summary(tool.summarise(str(out)))
        self.assertIn("T1      1    1           0  50%", text)
        self.assertEqual(tool.main(["--audit", str(self.world.audit_path), "--out", str(REPO / "triage-sheet.jsonl")]), 2)
        self.assertFalse((REPO / "triage-sheet.jsonl").exists())     # refused inside a git working tree

    def test_triage_false_turns_it_fully_off(self):
        self.engine.config["triage"] = False
        sb.triage_pass(self.engine, [], self.now, ())
        self.assertEqual((self.hub.calls, getattr(self.engine, "triage", None)), ([], None))


# ======================================================================
# #138: an agent is never taken for another. The caller is identified by its OWN session (OPENCODE_SESSION_ID, unique)
# in the switchboard's registry, never by inherited variables; a pane that names another session is a diagnostic; the
# gh shim sets GH_TOKEN from the account of the resolved identity. Live case: a restart left one agent's shell with
# another agent's pane, role, repo and token.
# ======================================================================
class TestIdentityCheck(ReportBase):
    def setUp(self):
        super().setUp()
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        os.environ.pop(sb.SESSION_ENV, None)
        sb._WARNED_PANES.clear()

    def mix(self):
        """The live case: the pane (and so the role, repo and token) of `coder`, the session of `platform`."""
        os.environ["HERDR_PANE_ID"] = self.world.panes["coder"]
        os.environ[sb.SESSION_ENV] = self.world.sessions["platform"]

    def call(self, *argv, runner=None):
        with captured() as (out, err):
            code = sb.main(list(argv), runner=runner or self.world.route, now=self.world.clock.now)
        return code, out.getvalue(), err.getvalue()

    def test_the_live_mix_is_taken_from_the_session_and_the_pane_is_only_a_warning(self):
        self.mix()
        code, out, err = self.call("whoami")
        self.assertEqual((code, out.strip()), (0, "platform"))                       # NOT the coder of the pane
        self.assertIn("warning: HERDR_PANE_ID %s belongs to session %s (coder)" % (self.world.panes["coder"], self.coder), err)
        self.assertIn("but this session is %s (platform)" % self.world.sessions["platform"], err)
        self.assertIn("this session runs in pane %s" % self.world.panes["platform"], err)
        self.assertIn("identity is taken from the session", err)
        code, err2 = self.call("whoami")[0], self.call("whoami")[2]
        self.assertEqual((code, err2), (0, ""))                                      # one warning per process

    def test_every_identity_bearing_command_acts_as_the_session_not_the_pane(self):
        self.mix()
        code, out, err = self.call("send", "coder", "--issue", "2", "hello")
        self.assertEqual(code, 0, err)
        (message,) = self.world.admissions("coder")
        self.assertTrue(message["keys"][0].startswith("send:platform:"), message["keys"])   # from platform, never from coder
        code, _, err = self.call("report", "done", "x")
        self.assertIn("platform reports to nobody", err)                              # resolved as platform, which has no boss
        code, _, err = self.call("remind", "coder", "5m", "later")
        self.assertEqual(code, 0, err)
        (reminder,) = sb.read_reminders(self.world.state)
        self.assertEqual(reminder["from"], "platform")
        engine = self.world.engine
        self.assertEqual(sb.identify_caller(engine.herdr, engine.v2, os.environ), "platform")
        self.assertEqual(sb.caller_fleet(engine.herdr, engine.v2, os.environ)["name"], "platform")
        self.assertEqual(sb.decision_actor(engine, types.SimpleNamespace(sender=None))[0], "platform")

    def test_a_session_the_registry_does_not_know_is_refused_everywhere_and_never_read_as_you(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "intent_repo": "acme/api"})
        os.environ["HERDR_PANE_ID"] = self.world.panes["coder"]
        os.environ[sb.SESSION_ENV] = "ses_unknownunknownunknown00"
        cases = [("whoami",), ("send", "platform", "--issue", "2", "hello"), ("report", "done", "all done"),
                 ("remind", "platform", "5m", "later"), ("notice", "pr", "acme/api#7"), ("notice", "withdraw", "acme/api#7"),
                 ("notice", "ack", "x"), ("orders", "add", "--charter", "2", "do it"), ("orders", "remove", "--charter", "2", "1"),
                 ("decisions", "resolve", "#1"), ("decisions", "escalate", "#1", "--reason", "r"),
                 ("decisions", "answer", "#1", "yes"), ("decisions", "supersede", "#1", "--by", "2"), ("decisions",),
                 ("intents",)]
        for argv in cases:
            with self.subTest(argv=argv):
                code, _, err = self.call(*argv)
                self.assertNotEqual(code, 0, argv)
                self.assertIn("cannot tell who you are", err)
        self.assertEqual((self.world.admissions("platform"), self.world.admissions("coder")), ([], []))
        self.assertEqual(sb.read_reminders(self.world.state), [])
        engine = self.world.engine
        with self.assertRaises(sb.IdentityUncertain):
            sb.decision_actor(engine, types.SimpleNamespace(sender=None))           # never (None, None): that is the person

    def test_a_known_session_that_is_not_a_fleet_agent_is_a_person_and_a_missing_pane_is_no_obstacle(self):
        engine = self.world.engine
        person = self.world.v2.create_session({})                                   # a session of one's own TUI
        os.environ[sb.SESSION_ENV] = person
        self.assertEqual(sb.decision_actor(engine, types.SimpleNamespace(sender=None)), (None, None))
        code, _, err = self.call("whoami")
        self.assertNotEqual(code, 0)
        self.assertIn("is not a fleet agent", err)
        os.environ[sb.SESSION_ENV] = self.coder                                     # an agent that lost HERDR_PANE_ID
        os.environ.pop("HERDR_PANE_ID", None)
        code, out, err = self.call("whoami")
        self.assertEqual((code, out.strip()), (0, "coder"))                         # its session says who it is

    def test_with_neither_session_nor_pane_it_cannot_tell_who_you_are(self):
        os.environ.pop("HERDR_PANE_ID", None)
        code, _, err = self.call("whoami")
        self.assertNotEqual(code, 0)
        self.assertIn("cannot tell who you are", err)
        self.assertIn("HERDR_PANE_ID", err)

    def test_a_matching_pair_and_an_unset_session_change_nothing(self):
        os.environ["HERDR_PANE_ID"] = self.world.panes["coder"]
        os.environ[sb.SESSION_ENV] = self.coder
        code, out, err = self.call("whoami")
        self.assertEqual((code, out.strip(), err), (0, "coder", ""))
        os.environ.pop(sb.SESSION_ENV)                                              # today's behaviour: by the pane
        code, out, err = self.call("whoami")
        self.assertEqual((code, out.strip()), (0, "coder"))
        code, _, err = self.call("report", "done", "from the pane")
        self.assertEqual(code, 0, err)

    # -- the gh shim: the name, and the token

    def shim(self):
        import importlib.machinery, importlib.util
        loader = importlib.machinery.SourceFileLoader("gh_shim", str(REPO / "shims" / "gh"))
        spec = importlib.util.spec_from_loader("gh_shim", loader)
        module = importlib.util.module_from_spec(spec)
        loader.exec_module(module)
        return module

    def test_the_gh_shim_falls_back_to_the_anonymous_name_and_never_blocks(self):
        shim = self.shim()
        fake = Path(self.home) / "sb-bin"
        fake.write_text("#!/bin/sh\necho 'fleet-switchboard: cannot tell who you are' >&2\nexit 1\n")
        fake.chmod(0o755)
        os.environ["FLEET_SWITCHBOARD_BIN"] = str(fake)
        self.assertEqual(shim.my_name(), "agent")
        os.environ["FLEET_SWITCHBOARD_BIN"] = "relative/bin"
        self.assertEqual((shim.my_name(), shim.account_env("/usr/bin/gh")), ("agent", None))

    def run_gh_shim(self, repo, users, token_for=None, who_repo_exit=0, inherited="inherited-personal-token", args=(),
                    wedge=False, seconds=None, extra_env=None, own=None, ident_extra=""):
        """The real shim in a subprocess with a fake gh and a fake switchboard. The fake gh logs which GH_TOKEN it ran with
        (in a test file only); `gh auth token --user NAME` answers from `token_for`. Returns (done, log)."""
        home = Path(self.home)
        bindir = home / "shimbin"
        bindir.mkdir(exist_ok=True)
        log = home / "shim-log.json"
        tokens = home / "tokens.json"
        tokens.write_text(json.dumps(token_for or {}))
        (bindir / "gh").write_text(
            "#!/usr/bin/env python3\nimport json,os,sys\n"
            "if sys.argv[1:3]==['auth','token']:\n"
            "    t=json.load(open(%r)).get(sys.argv[4])\n"
            "    if t is None: sys.stderr.write('no token\\n'); sys.exit(1)\n"
            "    print(t); sys.exit(0)\n"
            "json.dump({'argv': sys.argv[1:], 'token': os.environ.get('GH_TOKEN')}, open(%r,'w'))\nprint('gh ran')\n"
            % (str(tokens), str(log)))
        (bindir / "gh").chmod(0o755)
        if wedge:   # a daemon or v2 that never answers
            (bindir / "sb").write_text("#!/bin/sh\nsleep 30\n")
        else:
            (bindir / "sb").write_text(
                "#!/bin/sh\nif [ \"$1\" = whoami ] && [ \"$2\" = --json ]; then [ %d -ne 0 ] && exit %d; "
                "echo '{\"name\": \"api\", \"repo\": %s%s%s}'; exit 0; fi\n"
                "[ \"$1\" = whoami ] && echo api && exit 0\nexit 2\n"
                % (who_repo_exit, who_repo_exit, json.dumps(repo) if repo else "null", "" if own is None else ", \"own\": %s" % ("true" if own else "false"), ident_extra))
        (bindir / "sb").chmod(0o755)
        config = home / "xdg-config" / "fleet-switchboard"
        config.mkdir(parents=True, exist_ok=True)
        (config / "config.json").write_text(json.dumps({"gh_users": users} if users is not None else {}))
        environ = {"PATH": "%s:%s:%s" % (SHIM.parent, bindir, SAFE_PATH), "HOME": str(home),
                   "XDG_CONFIG_HOME": str(home / "xdg-config"), "FLEET_SWITCHBOARD_BIN": str(bindir / "sb"),
                   "FLEET_REAL_GH": str(bindir / "gh"), "GH_TOKEN": inherited}
        if seconds is not None:
            environ["FLEET_SHIM_LOOKUP_SECONDS"] = str(seconds)
        environ.update(extra_env or {})
        if log.exists():
            log.unlink()
        started = time.monotonic()
        done = subprocess.run([sys.executable, str(SHIM)] + list(args or ("issue", "list")), capture_output=True, text=True,
                              env=environ, timeout=60)
        self.shim_seconds = time.monotonic() - started
        return done, (json.loads(log.read_text()) if log.exists() else None)

    def test_a_caller_with_no_repo_of_its_own_acts_as_the_account_of_the_repo_an_issue_or_pr_command_names_and_nothing_else_picks_one(self):
        users = {"acme/*": "acct-personal", "other-org/*": "acct-other"}
        tokens = {"acct-personal": "tok-personal", "acct-other": "tok-other"}
        cases = (
            (("issue", "list", "-R", "acme/api"), "tok-personal"), (("pr", "view", "5", "--repo", "other-org/svc"), "tok-other"),
            (("issue", "create", "--repo=acme/api", "--title", "t"), "tok-personal"), (("issue", "comment", "https://github.com/other-org/svc/issues/4", "--body", "x"), "tok-other"),
            (("pr", "ready", "https://github.com/acme/api/pull/9"), "tok-personal"), (("pr", "edit", "5", "-R", "other-org/svc", "--add-label", "x"), "tok-other"),
            (("issue", "close", "3", "-Racme/api"), "tok-personal"))
        for args, expected in cases:
            with self.subTest(args=args):
                done, seen = self.run_gh_shim(None, users, tokens, args=args)
                self.assertEqual(done.returncode, 0, done.stderr)
                self.assertEqual(seen["token"], expected)
        for args in (("pr", "merge", "5", "-R", "acme/api"), ("repo", "view", "acme/api"), ("secret", "set", "X", "-R", "acme/api"),
                     ("workflow", "run", "ci.yml", "-R", "acme/api"), ("run", "rerun", "7", "-R", "acme/api"), ("api", "repos/acme/api/issues"),
                     ("issue", "list", "-R", "unmapped/repo")):
            with self.subTest(no_pick=args):     # only issue and pr commands (never merge) pick an account by what they name; the rest keep the inherited token
                done, seen = self.run_gh_shim(None, users, tokens, args=args)
                self.assertTrue(seen is None or seen["token"] == "inherited-personal-token", (args, seen))
        done, seen = self.run_gh_shim("acme/api", users, tokens, args=("issue", "list", "-R", "other-org/svc"))
        self.assertEqual(seen["token"], "tok-personal", "a caller WITH a repo keeps its own account: what it names never overrides it")
        # what a body, a title or a second flag says never picks the account: a repo is taken only from the real flag or the target URL
        for args in (("issue", "comment", "5", "--body", "https://github.com/other-org/svc/issues/1"), ("issue", "comment", "5", "--body", "-Rother-org/svc"),
                     ("issue", "create", "--title", "https://github.com/other-org/svc/pull/1"), ("issue", "comment", "5", "-R", "acme/api", "-R", "other-org/svc", "--body", "x"),
                     ("issue", "create", "-t", "-R", "--body", "other-org/svc")):
            with self.subTest(steer=args):
                done, seen = self.run_gh_shim(None, users, tokens, args=args)
                self.assertTrue(seen is None or seen["token"] == "inherited-personal-token", (args, seen))
        shim = self.shim()
        self.assertEqual(shim.explicit_repo(["issue", "comment", "5", "--body", "x", "-R", "acme/api"]), "acme/api")
        self.assertEqual(shim.explicit_repo(["pr", "view", "https://github.com/other-org/svc/pull/3"]), "other-org/svc")
        self.assertIsNone(shim.explicit_repo(["issue", "comment", "5", "--body", "https://github.com/other-org/svc/issues/1"]))
        # fail closed like a failed lookup: the account's token cannot be had, so an issue write is refused instead of run as the wrong account
        done, seen = self.run_gh_shim(None, users, {"acct-personal": "tok-personal"}, args=("issue", "comment", "3", "-R", "other-org/svc", "--body", "x"))
        self.assertNotEqual(done.returncode, 0)
        self.assertIn("account lookup failed, retry", done.stderr)
        self.assertIsNone(seen)
        done, seen = self.run_gh_shim(None, users, {"acct-personal": "tok-personal"}, args=("issue", "list", "-R", "other-org/svc"))
        self.assertEqual((done.returncode, seen["token"]), (0, "inherited-personal-token"), "a read still falls through")

    READ_USERS = {"acme-org/widget-service": "acme-dev", "acme-org/widget-api": "acme-bot"}
    READ_TOKENS = {"acme-dev": "tok-dev", "acme-bot": "tok-bot"}

    def read_repo_run(self, args, read_repo='"acme-org/widget-api"', users=None, tokens=None, **kw):
        return self.run_gh_shim("acme-org/widget-service", users or self.READ_USERS, tokens or self.READ_TOKENS, args=args, own=True,
                                ident_extra=', "read_repo": %s' % read_repo, **kw)

    def test_s1_a_worker_with_a_read_repository_reads_it_as_that_repositorys_account_and_its_own_repository_as_before(self):
        for args in (("issue", "view", "5", "-R", "acme-org/widget-api"), ("pr", "view", "https://github.com/acme-org/widget-api/pull/3"),
                     ("api", "repos/acme-org/widget-api/issues/5"), ("api", "-H", "Accept: x", "repos/acme-org/widget-api/pulls", "--jq", ".[0]"),
                     ("issue", "list", "--repo=acme-org/widget-api"), ("repo", "view", "acme-org/widget-api")):
            with self.subTest(args=args):
                done, seen = self.read_repo_run(args)
                self.assertEqual(done.returncode, 0, done.stderr)
                self.assertEqual(seen["token"], "tok-bot")
        for args in (("issue", "view", "5"), ("issue", "view", "5", "-R", "Acme-Org/Widget-Service"), ("issue", "comment", "5", "--body", "see acme-org/widget-api and https://github.com/x/y/issues/1")):
            with self.subTest(own=args):
                done, seen = self.read_repo_run(args)
                self.assertEqual((done.returncode, seen["token"]), (0, "tok-dev"), done.stderr)

    def test_s2_every_write_on_the_read_repository_is_refused_and_no_call_reaches_github(self):
        writes = (("issue", "comment", "5", "-R", "acme-org/widget-api", "--body", "x"), ("issue", "edit", "5", "-R", "acme-org/widget-api", "--title", "t"),
                  ("pr", "merge", "3", "-R", "acme-org/widget-api"), ("api", "-X", "POST", "repos/acme-org/widget-api/issues"),
                  ("api", "repos/acme-org/widget-api/issues", "-f", "title=t"), ("pr", "close", "3", "--repo", "acme-org/widget-api"),
                  ("issue", "create", "-R", "acme-org/widget-api", "--title", "t"), ("api", "-X", "DELETE", "repos/acme-org/widget-api/issues/comments/1"))
        for args in writes:
            with self.subTest(args=args):
                done, seen = self.read_repo_run(args)
                self.assertEqual(done.returncode, 1, done.stderr)
                self.assertIsNone(seen)
                self.assertIn("read only", done.stderr)

    def test_s3_a_repository_that_is_neither_the_workers_own_nor_the_declared_one_is_refused_for_reads_and_writes(self):
        for args in (("issue", "view", "5", "-R", "acme-org/other"), ("pr", "view", "https://github.com/acme-org/other/pull/1"), ("api", "repos/acme-org/other/issues"),
