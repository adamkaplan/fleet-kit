    def test_stats_count_records_by_actor_and_minutes_to_merge_for_merged_prs_only(self):
        entries = [{"pr": "acme/app#9", "kind": "proof", "by": "coder", "ts": 1000}, {"pr": "acme/app#9", "kind": "verdict", "by": "rev", "ts": 1300},
                   {"pr": "acme/app#9", "kind": "verdict", "by": sb.plan_ledger.CI_RECORDER, "ts": 1200},
                   {"pr": "acme/app#10", "kind": "proof", "by": "coder", "ts": 5000}]
        got = sb.gates_stats_core(entries, lambda pr: 1000 + 1800 if pr.endswith("#9") else None)
        self.assertEqual(got["unmerged"], 1)
        (row,) = got["prs"]
        self.assertEqual((row["pr"], row["records"], row["manual_records"], row["automatic_records"], row["minutes_to_merge"]),
                         ("acme/app#9", 3, 2, 1, 30.0))
        self.assertEqual(row["by"], {"coder": 1, "rev": 1, "switchboard": 1})

    def test_stats_command_reads_the_ledger_and_the_merge_time(self):
        self.assertEqual(self.prove("coder", "S1")[0], 0)
