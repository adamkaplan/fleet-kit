               "codes": {"off": "DisabledError", "decided": "AlreadyDecided", "clash": "Conflict",
                         "slow": "RateLimited"}},
    "options": {"id_prefix": "c", "key_marker": "ref:"}, "defaults": {"recommendation": "proceed"}}


def fake_mapping(base_url, channel="tool", **over):
    data = copy.deepcopy(FAKE_MAPPING)
    data["base_url"], data["channel"] = base_url, channel
    for key, value in over.items():
        if isinstance(value, dict) and isinstance(data.get(key), dict):
            data[key].update(value)
        else:
            data[key] = value
    return data


class ExternalAdapterCase(unittest.TestCase):
    """A fake server, and an adapter on it with recorded sleeps and a controllable clock."""

    def setUp(self):
        self.server = FakeDoorServer()
        self.addCleanup(self.server.close)
        self.slept, self.clock_now = [], [0.0]
        self.tmp = Path(tempfile.mkdtemp(prefix="ext-adapter-"))
        self.addCleanup(shutil.rmtree, self.tmp, True)

    def adapter(self, channel="tool", **over):
        return EA.McpRestAdapter(fake_mapping(self.server.url, channel, **over), sleep=self.slept.append,
                                 clock=lambda: self.clock_now[0], environ={"FAKE_DOOR_KEY": FakeDoorServer.KEY})

    def push(self, adapter, d, key):
        """The port's operation for a decision-shaped dict (op, external_id, status, reason are the operation's)."""
        d = dict(d)
        op, ext, reason = d.pop("op", None), d.pop("external_id", None), d.pop("reason", None)
        if op is None:
            op = "raise" if not ext else ("withdraw" if d.get("status") == "withdrawn" else "revise")
        operation = {"op": op, "key": "dk:" + key, "external_id": ext, "revision": 1, "decision": d}
        if reason:
            operation["note"] = reason
        done = adapter.push(operation, key)
        assert set(done) == {"external_id", "url"}, done
        return done["external_id"]

    def decision(self, **over):
        found = {"title": "Ship it?", "body": "The build is green.", "tier": "orchestrator",
                 "recommendation": "yes", "options": ["approve", {"label": "hold", "cost": "a day"}]}
        found.update(over)
        return found

    def answer_fields(self, **over):
        found = {"answer_id": "a-1", "how": "yes", "chosen": "k1", "words": "approve", "who": {"type": "person"}}
        found.update(over)
        return found


class TestExternalAdapterMapping(ExternalAdapterCase):
    def good(self):
        return fake_mapping("http://127.0.0.1:9")

    def refused(self, data, needle):
        with self.assertRaises(EA.MappingError) as ctx:
            EA.MappingFile.from_dict(data)
        self.assertIn(needle, str(ctx.exception))

    def test_a_good_mapping_loads_from_a_file(self):
        path = self.tmp / "m.json"
        path.write_text(json.dumps(self.good()))
        mapping = EA.MappingFile.load(path)
        self.assertEqual(mapping.channel, "tool")
        self.assertEqual(mapping.to_external("tier", "reserved"), "sealed")
        self.assertEqual(mapping.to_generic("tier", "major"), "high")

    def test_refusals(self):
        data = self.good()
        data["surprise"] = 1
        self.refused(data, "unknown top-level keys")
        data = self.good()
        data["api_key"] = "x"
        self.refused(data, "never inline")
        data = self.good()
        data["key_source"] = "sk-literal-key-value"
        self.refused(data, "never inline")
        data = self.good()
        data["base_url"] = "http://example.invalid"
        self.refused(data, "loopback")
        data = self.good()
        data["base_url"] = "http://user:pw@127.0.0.1:9"
        self.refused(data, "credential")
        data = self.good()
        data["work_interval"] = 30
        self.refused(data, "work_interval")
        data = self.good()
        data["tier_map"].pop("cos")
        self.refused(data, "tier_map")
        data = self.good()
        data["roles"][0]["role"] = "king"
        self.refused(data, "role rule")
        data = self.good()
        data["operations"]["work_put"]["tool"] = "w"
        self.refused(data, "HTTP only")
        data = self.good()
        data["operations"]["revise"]["http"]["path"] = "/items/revise"
        self.refused(data, "{id}")
        data = self.good()
        data["enums"]["tier"].pop("high")
        self.refused(data, "enums.tier")
        data = self.good()
        data["fields"]["raise"].pop("floor")
        self.refused(data, "fields.raise.floor")
        data = self.good()
        data["errors"]["codes"]["x"] = "NoSuchClass"
        self.refused(data, "errors.codes")
        data = self.good()
        data["operations"].pop("feed")
        self.refused(data, "operations.feed")
        data = self.good()
        data["key_source"] = ["env:A", "env:B", "env:C"]
        self.refused(data, "two for a rotation")

    def test_a_bad_file_is_refused(self):
        with self.assertRaises(EA.MappingError):
            EA.MappingFile.load(self.tmp / "missing.json")
        (self.tmp / "bad.json").write_text("{nope")
        with self.assertRaises(EA.MappingError):
            EA.MappingFile.load(self.tmp / "bad.json")

    def test_the_port_and_the_capabilities(self):
        adapter = self.adapter()
        self.assertIsInstance(adapter, sb.decision_core.ExternalDecisionAdapter)
        for name in ("push", "pull", "revise", "withdraw", "acted", "work", "lookup", "options", "idempotent_raise"):
            self.assertIn(name, adapter.capabilities)
        self.assertNotIn("status", adapter.capabilities)
        data = fake_mapping(self.server.url)
        for name in ("work_put", "work_patch", "work_finish", "work_get", "work_list", "acted"):
            data["operations"].pop(name)
        slim = EA.McpRestAdapter(data, environ={"FAKE_DOOR_KEY": "k"})
        self.assertNotIn("work", slim.capabilities)
        self.assertNotIn("acted", slim.capabilities)
        self.assertIsNone(slim.work)


class TestExternalAdapterKeys(ExternalAdapterCase):
    def test_env_source(self):
        self.assertEqual(EA.load_key(EA.parse_key_source("env:K"), environ={"K": " abc \n"}).reveal(), "abc")
        with self.assertRaises(EA.KeySourceError):
            EA.load_key(EA.parse_key_source("env:K"), environ={})

    def test_file_source_needs_mode_0600(self):
        path = self.tmp / "key"
        path.write_text("file-key-value\n")
        os.chmod(path, 0o600)
        self.assertEqual(EA.load_key(EA.parse_key_source("file:%s" % path)).reveal(), "file-key-value")
        for mode in (0o644, 0o640, 0o604, 0o660):
            os.chmod(path, mode)
            with self.assertRaises(EA.KeySourceError) as ctx:
                EA.load_key(EA.parse_key_source("file:%s" % path))
            self.assertIn("0600", str(ctx.exception))
            self.assertNotIn("file-key-value", str(ctx.exception))
        with self.assertRaises(EA.KeySourceError):
            EA.load_key(EA.parse_key_source("file:%s" % (self.tmp / "absent")))

    def test_command_source_runs_without_a_shell_and_is_held_in_memory(self):
        argv = [sys.executable, "-c", "print('cmd-key-value')"]
        self.assertEqual(EA.load_key(EA.parse_key_source({"command": argv})).reveal(), "cmd-key-value")
        self.assertEqual(EA.load_key(EA.parse_key_source("command:" + json.dumps(argv))).reveal(), "cmd-key-value")
        # a shell metacharacter is an argument, not a shell
        marker = self.tmp / "ran"
        argv = [sys.executable, "-c", "import sys; print(sys.argv[1])", "x; touch %s" % marker]
        EA.load_key(EA.parse_key_source({"command": argv}))
        self.assertFalse(marker.exists())

    def test_command_timeout_failure_and_empty_output(self):
        slow = [sys.executable, "-c", "import time; time.sleep(5)"]
        started = time.time()
        with self.assertRaises(EA.KeySourceError) as ctx:
            EA.load_key(EA.parse_key_source({"command": slow, "timeout": 0.3}))
        self.assertIn("did not answer", str(ctx.exception))
        self.assertLess(time.time() - started, 3)
        bad = [sys.executable, "-c", "import sys; print('leaked-key-value'); sys.exit(3)"]
        with self.assertRaises(EA.KeySourceError) as ctx:
            EA.load_key(EA.parse_key_source({"command": bad}))
        self.assertIn("exit 3", str(ctx.exception))
        self.assertNotIn("leaked-key-value", str(ctx.exception))
        with self.assertRaises(EA.KeySourceError):
            EA.load_key(EA.parse_key_source({"command": [sys.executable, "-c", "pass"]}))
        with self.assertRaises(EA.KeySourceError):
            EA.load_key(EA.parse_key_source({"command": ["/nonexistent/binary-xyz"]}))

    def test_the_key_never_appears_in_any_text(self):
        key = FakeDoorServer.KEY
        adapter = self.adapter("http")
        texts = [repr(adapter.keys.current()), str(adapter.keys.current()), repr(adapter.keys)]
        with self.assertRaises(EA.CredentialError) as ctx:  # the server echoes the credential it was shown
            self.server.fail_next("raise", 401, {"code": "cred", "message": "refused Key %s for %s" % (key, key)})
            self.push(adapter, self.decision(), "k-1")
        texts.append(str(ctx.exception))
        self.assertIn("[key]", str(ctx.exception))
        self.server.fail_next("raise", 400, {"code": "bad", "message": "Bearer %s" % key})
        with self.assertRaises(EA.InvalidRequest) as ctx:
            self.push(adapter, self.decision(), "k-2")
        texts.append(str(ctx.exception))
        self.server.fail_next("raise", 500, {"code": "x", "message": key}, count=5)
        with self.assertRaises(EA.Unavailable) as ctx:
            self.push(adapter, self.decision(), "k-3")
        texts.append(str(ctx.exception))
        self.server.down = True
        texts.append(str(adapter.health()))
        self.server.down = False
        self.server.fail_next(None, 401, {"code": "cred", "message": key})
        texts.append(str(adapter.health()))
        for text in texts:
            self.assertNotIn(key, text)
        with self.assertRaises(TypeError):
            import pickle
            pickle.dumps(adapter.keys.current())
        self.assertEqual(EA.scrub("a %s b Bearer abc.def" % key, [EA.Secret(key)]), "a [key] b Bearer [key]")

    def test_a_refused_key_rotates_to_the_next_source(self):
        env = {"OLD": "stale-key", "NEW": FakeDoorServer.KEY}
        data = fake_mapping(self.server.url, "http", key_source=["env:OLD", "env:NEW"])
        adapter = EA.McpRestAdapter(data, sleep=self.slept.append, environ=env)
        self.assertEqual(self.push(adapter, self.decision(), "k-1")[:3], "it-")
        self.assertEqual(adapter.keys.index, 1)

    def test_a_bad_source_is_found_at_start(self):
        adapter = EA.McpRestAdapter(fake_mapping(self.server.url), environ={})
        self.assertIn("not set", adapter.start())
        self.assertIsNone(self.adapter().start())
        self.assertIn("not set", adapter.health())


class TestExternalAdapterOperations(ExternalAdapterCase):
    def each_channel(self):
        for channel in ("tool", "http"):
            self.setUp()
            yield channel
            self.server.close()

    def test_raise_maps_the_decision_over_both_channels(self):
        for channel in self.each_channel():
            adapter = self.adapter(channel)
            ident = self.push(adapter, self.decision(), "decision-key-1")
            sent = [a for c, o, a in self.server.requests if o == "raise"][0]
            self.assertEqual(self.server.log[-1], (channel, "raise"))
            self.assertEqual(sent["label"], "routine", channel)
            self.assertEqual(sent["floor"], "minor")
            self.assertEqual(sent["seat"], "seat-1")
            self.assertEqual(sent["body"], "Ship it?\n\nThe build is green.\n\nref: dk:decision-key-1")
            self.assertEqual(sent["advice"], "yes")
            self.assertEqual(sent["choices"], [{"name": "approve", "key": "c1"},
                                               {"name": "hold", "price": "a day", "key": "c2"}])
            self.assertEqual(str(uuid.UUID(sent["op_id"])), sent["op_id"])
            self.assertEqual(self.server.items[ident]["floor"], "minor")

    def test_the_floor_follows_the_tier_and_a_hint_may_only_raise_it(self):
        adapter = self.adapter("http")
        for tier, hint, floor in (("orchestrator", None, "minor"), ("cos", None, "major"), ("human", None, "sealed"),
                                  ("orchestrator", "moderate", "middling"), ("cos", "low", "major")):
            self.push(adapter, self.decision(tier=tier, consequence=hint), "k-%s-%s" % (tier, hint))
            self.assertEqual(self.server.requests[-1][2]["floor"], floor)
        with self.assertRaises(EA.InvalidRequest):
            self.push(adapter, self.decision(tier="nobody"), "k-x")

    def test_options_with_their_own_ids_and_optional_fields(self):
        adapter = self.adapter("tool")
        self.push(adapter, self.decision(options=[{"label": "a", "id": "mine-1", "recommended": True}],
                                   grounds="g", stakes="s", evidence=[{"text": "t", "link": "http://127.0.0.1/e"}]),
                     "k-o")
        sent = self.server.requests[-1][2]
        self.assertEqual(sent["choices"], [{"name": "a", "preferred": True, "key": "mine-1"}])
        self.assertEqual((sent["because"], sent["stakes"]), ("g", "s"))
        self.assertEqual(sent["refs"], [{"note": "t", "href": "http://127.0.0.1/e"}])

    def test_a_recommendation_is_required_or_defaulted(self):
        adapter = self.adapter("http")
        self.push(adapter, self.decision(recommendation=None), "k-d")
        self.assertEqual(self.server.requests[-1][2]["advice"], "proceed")
        data = fake_mapping(self.server.url, "http")
        data.pop("defaults")
        bare = EA.McpRestAdapter(data, environ={"FAKE_DOOR_KEY": FakeDoorServer.KEY})
        with self.assertRaises(EA.InvalidRequest):
            self.push(bare, self.decision(recommendation=None), "k-e")

    def test_revise_withdraw_and_acted_over_both_channels(self):
        for channel in self.each_channel():
            adapter = self.adapter(channel)
            ident = self.push(adapter, self.decision(), "k-1")
            self.assertEqual(self.push(adapter, {"op": "revise", "external_id": ident, "body": "new words"}, "k-r"), ident)
            self.assertEqual(self.server.items[ident]["body"], "new words\n\nref: dk:k-r")
            self.assertEqual(self.server.log[-1], (channel, "revise"))
            self.server.items[ident]["answer"] = {"answer_id": "a-1"}
            self.assertEqual(adapter.acted(ident, "a-1", "done", "did it", "k-a"), ident)
            self.assertEqual(self.server.requests[-1][2]["result"], "did")
            with self.assertRaises(EA.Conflict):
                adapter.acted(ident, "not-an-answer", "done")
            second = self.push(adapter, self.decision(), "k-2")
            self.push(adapter, {"external_id": second, "status": "withdrawn", "reason": "gone"}, "k-w")
            self.assertEqual(self.server.items[second]["withdrawn"], {"why": "gone"})
            self.assertEqual(self.server.log[-1], (channel, "withdraw"))
            self.push(adapter, {"op": "withdraw", "external_id": second}, "k-w")  # idempotent

    def test_revise_and_withdraw_after_a_decision_are_refused(self):
        adapter = self.adapter("tool")
        ident = self.push(adapter, self.decision(), "k-1")
        self.server.items[ident].update(state="closed", answer={"answer_id": "a-1"})
        with self.assertRaises(EA.AlreadyDecided):
            self.push(adapter, {"op": "revise", "external_id": ident, "body": "late"}, "k-r")
        with self.assertRaises(EA.AlreadyDecided):
            self.push(adapter, {"op": "withdraw", "external_id": ident}, "k-w")
        with self.assertRaises(EA.InvalidRequest):
            self.push(adapter, {"op": "revise", "external_id": ident}, "k-r2")

    def test_status_without_a_mapping_for_it_is_a_local_only_no_op_not_an_error(self):
        adapter = self.adapter()
        self.assertNotIn("status", adapter.capabilities)
        before = len(self.server.log)
        self.assertEqual(self.push(adapter, {"op": "status", "external_id": "x", "status": "s"}, "k"), "x")
        self.assertEqual(len(self.server.log), before, "nothing was sent: the engine must not retry it forever")

    def test_idempotent_replay_and_conflict(self):
        for channel in self.each_channel():
            adapter = self.adapter(channel)
            first = self.push(adapter, self.decision(), "same-key")
            self.assertEqual(self.push(adapter, self.decision(), "same-key"), first)
            self.assertEqual(len(self.server.items), 1)
            with self.assertRaises(EA.Conflict):
                self.push(adapter, self.decision(body="a different body"), "same-key")
            other = self.push(adapter, self.decision(), "another-key")
            self.assertNotEqual(other, first)
            # a key that already is a UUID is kept as it is
            ident = str(uuid.uuid4())
            self.push(adapter, self.decision(), ident)
            self.assertEqual(self.server.requests[-1][2]["op_id"], ident)

    def test_lookup_finds_an_item_by_its_decision_key(self):
        adapter = self.adapter("http")
        first = self.push(adapter, self.decision(), "k-1")
        self.assertEqual(adapter.lookup("dk:k-1"), {"external_id": first, "revision": 1})
        self.assertIsNone(adapter.lookup("dk:never-raised"))
        self.assertIsNone(adapter.lookup("dk:k"))  # a prefix of a key is not the key
        self.server.items[first]["withdrawn"] = {"why": "x"}
        self.assertIsNone(adapter.lookup("dk:k-1"))
        bare = fake_mapping(self.server.url, "http")
        bare["options"] = {"id_prefix": "c"}
        self.assertIsNone(EA.McpRestAdapter(bare, environ={"FAKE_DOOR_KEY": FakeDoorServer.KEY}).lookup("dk:k-1"))

    def test_read_items_are_normalised(self):
        adapter = self.adapter("tool")
        ident = self.push(adapter, self.decision(), "k-1")
        self.server.items[ident].update(state="closed", answer=self.answer_fields(), ask_back=None)
        found = adapter.read_items()
        self.assertEqual(len(found), 1)
        self.assertEqual(found[0]["external_id"], ident)
        self.assertEqual(found[0]["status"], "decided")
        self.assertEqual(found[0]["answer"]["option_id"], "k1")
        self.assertEqual(found[0]["answer"]["by"]["role"], "human")

    def test_health(self):
        adapter = self.adapter("http")
        self.assertIsNone(adapter.health())
        self.server.disabled = True
        self.assertIn("disabled", adapter.health())
        self.server.disabled = False
        self.server.down = True
        self.assertIn("request failed", adapter.health())
        self.server.down = False
        data = fake_mapping(self.server.url)
        data["key_source"] = "env:NOT_SET_ANYWHERE"
        self.assertIn("not set", EA.McpRestAdapter(data, environ={}).health())


class TestExternalAdapterErrors(ExternalAdapterCase):
    def test_http_statuses_map_to_the_hierarchy_and_4xx_is_not_retried(self):
        cases = ((401, "cred", EA.CredentialError), (403, "off", EA.DisabledError), (404, "nf", EA.NotFound),
                 (400, "bad", EA.InvalidRequest), (415, "media", EA.InvalidRequest), (409, "clash", EA.Conflict),
                 (422, "odd", EA.InvalidRequest), (409, "decided", EA.AlreadyDecided))
        adapter = self.adapter("http")
        for status, code, cls in cases:
            self.slept.clear()
            before = len(self.server.requests)
            self.server.fail_next("raise", status, {"code": code, "message": "m"})
            with self.assertRaises(cls) as ctx:
                self.push(adapter, self.decision(), "k-%d" % status)
            self.assertIs(type(ctx.exception), cls)
            self.assertEqual(self.slept, [], status)
            self.assertEqual(len(self.server.requests), before)  # the injected reply is the one and only call

    def test_a_4xx_is_asked_once(self):
        adapter = self.adapter("http")
        for status in (400, 401, 403, 404, 409):
            self.server.fail_next("raise", status, {"code": "z", "message": "m"}, count=10)
            with self.assertRaises(EA.AdapterError):
                self.push(adapter, self.decision(), "k")
            self.assertEqual(len([1 for i in self.server.inject if i["count"] == 9]), 1, status)
            self.server.inject.clear()

    def test_429_honours_retry_after_then_succeeds(self):
        adapter = self.adapter("http")
        self.server.fail_next("raise", 429, {"code": "slow", "message": "later"}, {"Retry-After": "2"})
        self.assertTrue(self.push(adapter, self.decision(), "k-1").startswith("it-"))
        self.assertEqual(self.slept, [2.0])

    def test_a_long_retry_after_is_reported_not_slept(self):
        adapter = self.adapter("http")
        self.server.fail_next("raise", 429, {"code": "slow", "message": "later"}, {"Retry-After": "60"})
        with self.assertRaises(EA.RateLimited) as ctx:
            self.push(adapter, self.decision(), "k-1")
        self.assertEqual(ctx.exception.retry_after, 60.0)
        self.assertEqual(self.slept, [])
        self.server.fail_next("raise", 429, {"code": "slow", "message": "later", "retry_after_s": 7})
        with self.assertRaises(EA.RateLimited) as ctx:
            self.push(adapter, self.decision(), "k-2")
        self.assertEqual(ctx.exception.retry_after, 7.0)  # no header: the mapped body field
        self.server.fail_next("raise", 429, {"code": "x", "message": "later"}, count=10)
        with self.assertRaises(EA.RateLimited) as ctx:
            self.push(adapter, self.decision(), "k-3")
        self.assertEqual(ctx.exception.retry_after, 1.0)  # neither: the default (short: slept, then given up)
        self.assertEqual(self.slept, [1.0, 1.0])

    def test_5xx_is_retried_with_a_doubling_delay_and_a_cap(self):
        adapter = self.adapter("http")
        self.server.fail_next("raise", 503, count=2)
        self.assertTrue(self.push(adapter, self.decision(), "k-1").startswith("it-"))
        self.assertEqual(self.slept, [0.5, 1.0])
        self.slept.clear()
        self.server.fail_next("raise", 500, count=10)
        with self.assertRaises(EA.Unavailable):
            self.push(adapter, self.decision(), "k-2")
        self.assertEqual(self.slept, [0.5, 1.0])  # three attempts, two waits
        self.slept.clear()
        many = self.adapter("http", retry={"attempts": 5})
        self.server.inject.clear()
        self.server.fail_next("raise", 500, count=10)
        with self.assertRaises(EA.Unavailable):
            self.push(many, self.decision(), "k-3")
        self.assertEqual(self.slept, [0.5, 1.0, 1.5, 1.5])  # capped at max_delay

    def test_a_timeout_a_dropped_connection_and_a_closed_port_are_unavailable_and_retried(self):
        data = fake_mapping(self.server.url, "http", timeouts={"request": 0.3}, retry={"attempts": 2})
        adapter = EA.McpRestAdapter(data, sleep=self.slept.append, environ={"FAKE_DOOR_KEY": FakeDoorServer.KEY})
        self.server.delay = 1.0
        with self.assertRaises(EA.Unavailable):
            self.push(adapter, self.decision(), "k-1")
        self.assertEqual(self.slept, [0.5])
        self.server.delay = 0
        self.server.down = True
        with self.assertRaises(EA.Unavailable):
            self.push(adapter, self.decision(), "k-2")
        self.server.down = False
        probe = socket.socket()
        probe.bind(("127.0.0.1", 0))
        port = probe.getsockname()[1]
        probe.close()
        data["base_url"] = "http://127.0.0.1:%d" % port
        self.slept.clear()
        with self.assertRaises(EA.Unavailable):
            self.push(EA.McpRestAdapter(data, sleep=self.slept.append,
                                        environ={"FAKE_DOOR_KEY": FakeDoorServer.KEY}), self.decision(), "k-3")
        self.assertEqual(self.slept, [0.5])

    def test_tool_channel_refusals_map_by_code(self):
        adapter = self.adapter("tool")
        for code, cls in (("off", EA.DisabledError), ("decided", EA.AlreadyDecided), ("clash", EA.Conflict),
                          ("slow", EA.RateLimited), ("nf", EA.InvalidRequest), ("bad", EA.InvalidRequest)):
            self.slept.clear()
            self.server.fail_next("raise", 400, {"code": code, "message": "refused: %s" % code, "retry_after_s": 90},
                                  level="result")
            with self.assertRaises(cls) as ctx:
                self.push(adapter, self.decision(), "k-" + code)
            self.assertIs(type(ctx.exception), cls)
            self.assertEqual(self.slept, [])

    def test_tool_channel_credential_and_schema_failures(self):
        adapter = self.adapter("tool")
        self.server.fail_next("raise", 401, {"code": "cred", "message": "no"}, level="http")
        with self.assertRaises(EA.CredentialError):
            self.push(adapter, self.decision(), "k-1")
        self.server.fail_next("raise", 503, level="http")
        self.assertTrue(self.push(adapter, self.decision(), "k-2").startswith("it-"))  # retried
        # schema failures arrive as text, not JSON
        with self.assertRaises(EA.InvalidRequest) as ctx:
            adapter.door.mcp.call_tool("item_raise", {"bad_schema": 1})
        self.assertIn("validation", str(ctx.exception))
        with self.assertRaises(EA.InvalidRequest):
            adapter.door.mcp.call_tool("no_such_tool", {})

    def test_the_tool_session_sse_and_expiry(self):
        adapter = self.adapter("tool")
        self.assertEqual(adapter.door.mcp.list_tools()[:2], ["seats_list", "item_raise"])
        self.assertEqual(adapter.door.mcp.session, "sess-1")
        self.push(adapter, self.decision(), "k-1")
        self.assertEqual(self.server.sid, 1)  # one session for all of it
        self.server.sessions.clear()  # the server forgot it
        self.push(adapter, self.decision(), "k-2")
        self.assertEqual(self.server.sid, 2)
        self.server.session_miss = 400   # some servers answer a session they forgot with a 400
        self.server.sessions.clear()
        self.push(adapter, self.decision(), "k-2b")
        self.assertEqual(self.server.sid, 3)
        with self.assertRaises(EA.InvalidRequest):   # a real 400 with a good session is asked once, not looped
            self.server.fail_next("raise", 400, {"code": "bad", "message": "m"}, count=2)
            self.push(adapter, self.decision(), "k-2c")
        self.assertEqual(self.server.sid, 4)
        self.server.session_miss = 404
        self.server.sse = True
        fresh = self.adapter("tool")
        self.assertTrue(self.push(fresh, self.decision(), "k-3").startswith("it-"))
        self.assertEqual(fresh.pull_normalised(None)[1], 0)

    def test_a_list_of_messages_is_joined(self):
        adapter = self.adapter("tool")
        self.server.fail_next("raise", 400, {"code": "bad", "message": ["first", "second"]}, level="result")
        with self.assertRaises(EA.InvalidRequest) as ctx:
            self.push(adapter, self.decision(), "k-1")
        self.assertIn("first; second", str(ctx.exception))

    def test_a_redirect_is_never_followed(self):
        adapter = self.adapter("http")
        self.server.fail_next("raise", 302, {"code": "x", "message": "moved"}, {"Location": "http://127.0.0.1:1/"})
        with self.assertRaises(EA.InvalidRequest):
            self.push(adapter, self.decision(), "k-1")


class TestExternalAdapterFeed(ExternalAdapterCase):
    def test_the_cursor_is_stable_when_nothing_happened_and_a_repeat_is_safe(self):
        for channel in ("tool", "http"):
            self.server.changes.clear()
            self.server.seq = 100
            adapter = self.adapter(channel)
            events, cursor = adapter.pull_normalised(None)
            self.assertEqual(events, [])
            self.server.add_change("rating", "it-1", level="major", floor="minor")
            self.server.add_change("restated", "it-1", gap=7, body="x", rerate=True)  # gaps are normal
            events, cursor = adapter.pull_normalised(0)
            self.assertEqual([e["seq"] for e in events], [101, 108])
            self.assertEqual(cursor, 108)
            again, same = adapter.pull_normalised(0)
            self.assertEqual(([e["event_id"] for e in again], same), ([e["event_id"] for e in events], 108))
            nothing, kept = adapter.pull_normalised(cursor)
            self.assertEqual((nothing, kept), ([], 108))
            self.assertEqual(adapter.pull_normalised(cursor)[1], 108)
            ahead, held = adapter.pull_normalised(500)  # never goes backwards
            self.assertEqual((ahead, held), ([], 500))

    def test_the_result_unpacks_and_reads_by_name(self):
        result = self.adapter().pull_normalised(None)
        events, cursor = result
        self.assertEqual((result["events"], result["next_cursor"], result.events, result.next_cursor),
                         (events, cursor, events, cursor))

    def test_events_are_normalised(self):
        s = self.server
        s.add_change("rating", "it-1", level="major", floor="minor")
        s.add_change("answer", "it-1", **self.answer_fields())
        s.add_change("answer", "it-2", **self.answer_fields(answer_id="a-2", how="reword", chosen=None, words="do B",
                                                           who={"type": "owner_bot"}))
        s.add_change("answer", "it-3", **self.answer_fields(answer_id="a-3", how="no", chosen=None,
                                                           words="the original", no_reason="too risky",
                                                           who={"type": "bot"}))
        s.add_change("answer", "it-4", **self.answer_fields(answer_id="a-4", how="ask", chosen=None, words=None,
                                                           ask_back="which branch?"))
        s.add_change("flip", "it-1", **self.answer_fields(answer_id="a-5", how="no", chosen=None, no_reason="changed my mind"),
                     replaces=self.answer_fields())
        s.add_change("pull", "it-5", why="gone")
        s.add_change("restated", "it-6", body="new text", rerate=True)
        s.add_change("seat_paused", None)
        for channel in ("tool", "http"):
            events = self.adapter(channel).pull_normalised(None)[0]
            by = {e["seq"]: e for e in events}
            self.assertEqual([e["type"] for e in events],
                             ["rated", "answered", "answered", "answered", "sent_back", "reversed", "withdrawn",
                              "revised", "other"])
            self.assertEqual((by[101]["tier"], by[101]["floor"]), ("high", "low"))
            a = by[102]["answer"]
            self.assertEqual((a["id"], a["disposition"], a["meaning"], a["option_id"], a["text"]),
                             ("a-1", "accept", "allow", "k1", "approve"))
            self.assertEqual(by[102]["by"]["role"], "human")
            self.assertEqual((by[103]["answer"]["disposition"], by[103]["answer"]["meaning"],
                              by[103]["answer"]["option_id"], by[103]["answer"]["text"], by[103]["by"]["role"]),
                             ("edit", "text", None, "do B", "cos"))
            self.assertEqual((by[104]["answer"]["disposition"], by[104]["answer"]["meaning"],
                              by[104]["answer"]["rejection"], by[104]["by"]["role"]),
                             ("reject", "deny", "too risky", "orchestrator"))
            self.assertNotIn("answer", by[105])
            self.assertEqual(by[105]["clarification"], "which branch?")
            self.assertEqual(by[106]["answer"]["disposition"], "reject")
            self.assertEqual(by[106]["replaces"]["id"], "a-1")
            self.assertEqual(by[106]["replaces"]["option_id"], "k1")
            self.assertEqual(by[107]["reason"], "gone")
            self.assertEqual((by[108]["text"], by[108]["awaits_rating"]), ("new text", True))
            self.assertEqual(by[109]["raw_kind"], "seat_paused")
            self.assertEqual(len({e["event_id"] for e in events}), len(events))

    def test_an_unknown_answerer_has_no_role(self):
        self.server.add_change("answer", "it-1", **self.answer_fields(who={"type": "stranger"}))
        event = self.adapter().pull_normalised(None)[0][0]
        self.assertEqual(event["by"]["role"], "unknown")
        self.assertEqual(event["by"]["raw"], {"type": "stranger"})


class TestExternalAdapterPort(ExternalAdapterCase):
    """The step-4 port shape: push(operation) -> {external_id, url}, pull_changes -> (events, cursor)."""

    def test_pull_changes_yields_port_events_only(self):
        s = self.server
        s.add_change("rating", "it-1", level="major", floor="minor")
        s.add_change("answer", "it-1", **self.answer_fields())
        s.add_change("answer", "it-2", **self.answer_fields(answer_id="a-2", how="ask", chosen=None, words=None,
                                                           ask_back="which?", who={"type": "bot"}))
        s.add_change("flip", "it-1", **self.answer_fields(answer_id="a-3", how="no", chosen=None, words="x",
                                                         no_reason="nope", who={"type": "owner_bot"}),
                     replaces=self.answer_fields())
        s.add_change("pull", "it-3", why="gone")
        s.add_change("restated", "it-4", body="b", rerate=True)
        s.add_change("answer", "it-5", **self.answer_fields(answer_id="a-5", who={"type": "stranger"}))
        for channel in ("tool", "http"):
            events, cursor = self.adapter(channel).pull_changes(None)
            self.assertEqual([e["type"] for e in events], ["answered", "clarify", "reversed", "withdrawn", "answered"])
            a, c, r, w, u = events
            self.assertEqual((a["answered_by"], a["option_id"], a["text"], a["external_id"]),
                             ("human", "k1", "approve", "it-1"))
            self.assertEqual((c["answered_by"], c["text"], c["option_id"]), ("project agent", "which?", None))
            self.assertEqual((r["answered_by"], r["text"], r["replaces"]["id"]), ("owner's agent", "nope", "a-1"))
            self.assertEqual(w["text"], "gone")
            self.assertEqual(u["answered_by"], "unknown")
            self.assertEqual(cursor, 106 + 1)  # the cursor moves past the changes that are not port events
            for e in events:
                self.assertTrue({"event_id", "external_id", "type", "answered_by", "option_id", "text", "at"} <= set(e))

    def test_a_raise_returns_the_id_and_the_operation_floor_is_used(self):
        adapter = self.adapter("tool")
        operation = {"op": "raise", "key": "dk:1", "external_id": None, "revision": 1, "floor": "high",
                     "decision": {"title": "T", "headline": "A longer headline", "tier": "orchestrator",
                                  "agent": "coder1", "repo": "acme/api", "ask": 7, "display_id": "#7",
                                  "rows": {"1": "first", "2": "second"}}}
        done = adapter.push(operation, "dk:1")
        self.assertEqual(set(done), {"external_id", "url"})
        sent = self.server.requests[-1][2]
        self.assertEqual(sent["floor"], "major")  # the operation's floor, not the tier_map's
        self.assertEqual(sent["label"], "routine")
        self.assertEqual(sent["body"], "T\n\nA longer headline\n\nFrom: coder1 in acme/api on #7\n\n"
                                       "1. first\n2. second\n\nref: dk:1")
        again = adapter.push(operation, "dk:1")
        self.assertEqual(again, done)
        operation.update(op="revise", external_id=done["external_id"], revision=2)
        operation["decision"]["title"] = "T2"
        self.assertEqual(adapter.push(operation, "dk:1:r2")["external_id"], done["external_id"])
        operation.update(op="withdraw", note="superseded")
        self.assertEqual(adapter.push(operation, "dk:1:w")["external_id"], done["external_id"])
        self.assertEqual(self.server.items[done["external_id"]]["withdrawn"], {"why": "superseded"})
        with self.assertRaises(EA.InvalidRequest):
            adapter.push({"op": "dance", "decision": {}}, "k")
        with self.assertRaises(EA.InvalidRequest):
            adapter.push({"op": "revise", "external_id": None, "decision": {"title": "x"}}, "k")

    def test_an_error_is_raised_for_the_engine_to_retry(self):
        adapter = self.adapter("http")
        self.server.down = True
        with self.assertRaises(Exception):
            adapter.pull_changes(None)

    def test_every_page_of_a_truncated_read_is_followed_over_both_channels(self):
        for channel in ("tool", "http"):
            self.server.items.clear()
            self.server.changes.clear()
            self.server.page_size = 2
            adapter = self.adapter(channel)
            ids = [self.push(adapter, self.decision(title="item %d" % n), "k-%d-%s" % (n, channel)) for n in range(5)]
            self.assertEqual(sorted(i["external_id"] for i in adapter.read_items()), sorted(ids))
            self.assertEqual(adapter.lookup("dk:k-4-%s" % channel)["external_id"], ids[4], "found on the last page")
            for n in range(5):
                self.server.add_change("answer", ids[n], **self.answer_fields(answer_id="a-%d" % n))
            events, cursor = adapter.pull_changes(None)
            self.assertEqual([e["answer_id"] for e in events], ["a-%d" % n for n in range(5)])
            self.assertEqual(cursor, self.server.seq)
            self.assertEqual(adapter.pull_changes(cursor), ([], cursor))
            self.assertGreaterEqual(self.server.count("feed", channel), 4)

    def test_permanent_errors_are_marked_and_transient_ones_are_not(self):
        for cls in (EA.CredentialError, EA.DisabledError, EA.NotFound, EA.InvalidRequest, EA.Conflict,
                    EA.AlreadyDecided, EA.MappingError, EA.KeySourceError, EA.Unsupported):
            self.assertTrue(cls("x").permanent, cls.__name__)
        self.assertFalse(EA.RateLimited("x", 1).permanent)
        self.assertFalse(EA.Unavailable("x").permanent)
        adapter = self.adapter("http")
        for status, code, permanent in ((404, "nf", True), (400, "bad", True), (401, "cred", True),
                                        (409, "decided", True), (403, "off", True), (500, "x", False),
                                        (429, "slow", False)):
            self.server.inject.clear()
            self.server.fail_next("raise", status, {"code": code, "message": "m"}, {"Retry-After": "99"}, count=9)
            with self.assertRaises(EA.AdapterError) as ctx:
                self.push(adapter, self.decision(), "k-%d" % status)
            self.assertIs(ctx.exception.permanent, permanent, status)

    def test_a_cursor_that_goes_back_is_ignored(self):
        adapter = self.adapter("http")
        adapter.door.call = lambda *a, **k: {"cursor": 3, "feed": []}
        self.assertEqual(adapter.pull_changes(10)[1], 10)

    def test_scrub_takes_out_a_key_with_url_unsafe_characters(self):
        self.assertEqual(EA.scrub("x a/b+c y", [EA.Secret("a/b+c")]), "x [key] y")
        self.assertEqual(EA.scrub("x a%2Fb%2Bc y", [EA.Secret("a/b+c")]), "x [key] y")


class TestExternalAdapterWork(ExternalAdapterCase):
    def test_put_is_idempotent_and_goes_over_http_only(self):
        adapter = self.adapter("tool")
        first = adapter.work.put("w-1", "Build the thing", kind="assignment", state="running", doer="coder")
        self.assertTrue(first["recorded"])
        self.assertEqual(first["item"]["state"], "going")
        again = adapter.work.put("w-1", "Build the thing", kind="assignment", state="running", doer="coder")
        self.assertFalse(again["recorded"])
        self.assertEqual(self.server.count("work_put", "tool"), 0)
        self.assertEqual(self.server.count("work_put", "http"), 2)
        self.assertEqual(adapter.work.get("w-1")["item"]["title"], "Build the thing")
        self.assertEqual(len(adapter.work.list()), 1)
        with self.assertRaises(EA.InvalidRequest):
            adapter.work.put("w-2", "t", unmapped_field=1)
        with self.assertRaises(EA.Unsupported):
            adapter.door.call("work_put", {}, ident="w", force="tool")

    def test_a_waiting_or_blocked_state_carries_a_reason_where_the_mapping_names_one(self):
        adapter = self.adapter()
        adapter.work.put("w-8", "t", state="awaiting", progress="needs a review")
        self.assertEqual(self.server.tasks[("seat-1", "w-8")]["why_state"], "needs a review")
        adapter.work.put("w-7", "t", state="blocked")
        self.assertEqual(self.server.tasks[("seat-1", "w-7")]["why_state"], "blocked")
        adapter.work.put("w-6", "t", state="running", progress="going")
        self.assertNotIn("why_state", self.server.tasks[("seat-1", "w-6")])
        self.clock_now[0], self.server.now = 100, 1100.0
        adapter.work.patch("w-6", state="blocked")
        self.assertEqual(self.server.tasks[("seat-1", "w-6")]["why_state"], "going", "the last progress line")
        adapter.work.put("w-5", "t", state="awaiting", state_reason="given")
        self.assertEqual(self.server.tasks[("seat-1", "w-5")]["why_state"], "given")

    def test_an_empty_line_is_not_sent(self):
        adapter = self.adapter()
        first = adapter.work.put("w-9", "t", state="running", progress="", doer="  ")
        self.assertTrue(first["recorded"])
        self.assertNotIn("progress", self.server.tasks[("seat-1", "w-9")])
        self.assertEqual(adapter.work.patch("w-9", progress=" "), {"sent": False, "unchanged": True})

    def test_updates_are_coalesced_and_the_last_state_wins(self):
        adapter = self.adapter()
        adapter.work.put("w-1", "t", state="running")
        self.server.now, self.clock_now[0] = 1000.0, 0.0
        first = adapter.work.patch("w-1", progress="a")
        self.assertEqual((first["sent"], first["deferred"]), (False, True))  # the put just recorded: wait
        self.clock_now[0] = 30
        adapter.work.patch("w-1", progress="b")
        second = adapter.work.patch("w-1", progress="c", doer="d")
        self.assertAlmostEqual(second["due_in"], 30)
        self.assertEqual(self.server.count("work_patch"), 0)
        self.server.now, self.clock_now[0] = 1061.0, 61
        self.assertEqual(adapter.work.flush()["w-1"]["sent"], True)
        self.assertEqual(self.server.count("work_patch"), 1)
        task = self.server.tasks[("seat-1", "w-1")]
        self.assertEqual((task["progress"], task["doer"]), ({"text": "c"}, "d"))  # b was never sent
        again = adapter.work.patch("w-1", progress="c")
        self.assertEqual(again, {"sent": False, "unchanged": True})
        self.assertEqual(adapter.work.flush(), {})

    def test_a_rate_limit_defers_and_keeps_the_pending_state(self):
        adapter = self.adapter()
        adapter.work.put("w-1", "t")
        self.clock_now[0] = 100  # our clock says it is due, the server's says it is not
        self.server.now = 1010.0
        result = adapter.work.patch("w-1", progress="x")
        self.assertEqual((result["sent"], result["deferred"], result["due_in"]), (False, True, 60.0))
        self.assertEqual(self.slept, [])  # not slept: reported
        self.assertEqual(adapter.work.flush(), {})  # still deferred by the wait
        self.clock_now[0], self.server.now = 161, 1100.0
        self.assertTrue(adapter.work.flush()["w-1"]["sent"])
        self.assertEqual(self.server.tasks[("seat-1", "w-1")]["progress"], {"text": "x"})

    def test_finish_is_final_and_idempotent(self):
        adapter = self.adapter()
        adapter.work.put("w-1", "t")
        adapter.work.patch("w-1", progress="pending")
        done = adapter.work.finish("w-1", "done", "all good")
        self.assertEqual(done["item"]["end"], {"state": "ok", "said": "all good"})
        self.assertNotIn("w-1", adapter.work.items)  # pending dropped
        adapter.work.finish("w-1", "done", "all good")  # the same outcome again is fine
        with self.assertRaises(EA.Conflict):
            adapter.work.finish("w-1", "failed", "no")
        self.server.now = 5000.0
        with self.assertRaises(EA.Conflict):
            adapter.door.call("work_patch", {"progress": "late"}, ident="w-1", force="http")

    def test_work_errors_map_like_the_rest(self):
        adapter = self.adapter()
        self.server.disabled = True
        with self.assertRaises(EA.DisabledError):
            adapter.work.put("w-1", "t")
        self.server.disabled = False
        with self.assertRaises(EA.NotFound):
            adapter.work.get("never")

    def test_the_interval_is_at_least_a_minute(self):
        self.assertEqual(self.adapter().work.interval, 60.0)


class TestExternalAdapterHygiene(unittest.TestCase):
    # Fragments, so this list does not spell the words it forbids.
    DENYLIST = ["sp" + "ire", "ven" + "ue", "jan" + "us", "plug" + "in", "spp" + "k", "under" + "study",
                "fleet-conn" + "ector", "don" + "ald", "/api/" + "plugin", "open" + "router"]

    def test_the_module_names_no_product(self):
        text = EXTERNAL_ADAPTER.read_text().lower()
        for word in self.DENYLIST:
            self.assertNotIn(word, text, "the module must stay generic: %r" % word)

    def test_the_module_is_stdlib_only_and_python_3_9_syntax(self):
        tree = ast.parse(EXTERNAL_ADAPTER.read_text(), feature_version=(3, 9))
        allowed = {"collections", "hashlib", "http", "importlib", "json", "os", "re", "stat", "subprocess", "sys",
                   "time", "urllib", "uuid", "abc"}
        found = set()
        for node in ast.walk(tree):
            if isinstance(node, ast.Import):
                found.update(a.name.split(".")[0] for a in node.names)
            elif isinstance(node, ast.ImportFrom):
                found.add((node.module or "").split(".")[0])
        self.assertLessEqual(found, allowed)

    def test_it_imports_under_python_3_9(self):
        old = shutil.which("python3.9") or ("/usr/bin/python3" if os.path.exists("/usr/bin/python3") else None)
        if old is None:
            self.skipTest("no python 3.9 interpreter to import it with")
        shown = subprocess.run([old, "-c", "import sys; print(sys.version_info[:2])"], capture_output=True,
                               text=True).stdout.strip()
        if shown != "(3, 9)":
            self.skipTest("no python 3.9 interpreter (found %s)" % shown)
        done = subprocess.run([old, "-I", "-B", "-c",
                               "import importlib.util as u; s = u.spec_from_file_location('ea', %r); m = "
                               "u.module_from_spec(s); s.loader.exec_module(m); print(m.McpRestAdapter.__name__)"
                               % str(EXTERNAL_ADAPTER)], capture_output=True, text=True, timeout=60)
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual(done.stdout.strip(), "McpRestAdapter")

    def test_no_sudo_anywhere_in_it(self):
        self.assertNotIn("sudo", EXTERNAL_ADAPTER.read_text())


# ---------------------------------------------------------------- external decision systems (the sync engine)

class FakeExternal(sb.decision_core.ExternalDecisionAdapter):
    """An in-process adapter: items by outside id, idempotent by key, a switch for down, and a queue of events."""

    def __init__(self):
        self.up, self.items, self.applied_keys, self.calls, self.events = True, {}, {}, [], []
        self.lose_ack = False   # apply the next write, then fail as if the answer was lost

    def health(self):
        return None if self.up else "the fake is down"

    def push(self, operation, idempotency_key):
        self.calls.append((operation["op"], operation["key"], idempotency_key))
        if not self.up:
            raise ConnectionError("the fake is down")
        if idempotency_key in self.applied_keys:
            return self.applied_keys[idempotency_key]
        op = operation["op"]
        if op == "raise":
            ext = "ext-%d" % (len(self.items) + 1)
            self.items[ext] = {"key": operation["key"], "decision": operation["decision"], "floor": operation["floor"],
                               "state": "open", "notes": [], "revisions": [operation["revision"]]}
        else:
            ext = operation["external_id"]
            item = self.items[ext]
            if op == "revise":
                item["decision"], item["floor"] = operation["decision"], operation["floor"]
                item["revisions"].append(operation["revision"])
            elif op == "status":
                item["floor"] = operation["floor"]
                if operation.get("note"):
                    item["notes"].append(operation["note"])
            elif op == "withdraw":
                item["state"] = "withdrawn"
        answer = {"external_id": ext}
        self.applied_keys[idempotency_key] = answer
        if self.lose_ack:
            self.lose_ack = False
            raise ConnectionError("the answer was lost")
        return answer

    def lookup(self, key):
        for ext, item in self.items.items():
            if item["key"] == key:
                return {"external_id": ext, "revision": item["revisions"][-1]}
        return None

    def pull_changes(self, cursor):
        start = cursor or 0
        return list(self.events[start:]), len(self.events)

    def open_items(self):
        return {e: i for e, i in self.items.items() if i["state"] == "open"}


class ExternalWorld(BaselineWorld):
    TIERS = {"orchestrator": "floor-a", "cos": "floor-b", "human": "floor-c"}

    def setUp(self):
        super().setUp()
        self.fake = FakeExternal()
        sb.register_external_adapter("fake", lambda settings, mapping, state: self.fake)
        self.addCleanup(sb.EXTERNAL_ADAPTERS.pop, "fake", None)
        self.mapping = self.home / "mapping.json"
        self.mapping.write_text("{}")

    def turn_on(self, **extra):
        section = dict({"enabled": True, "adapter": "fake", "repos": [API], "mapping_file": str(self.mapping),
                        "tier_map": self.TIERS, "tiers": ["orchestrator", "cos", "human"], "poll_seconds": 1, "retry_base_seconds": 5,
                        "retry_max_seconds": 60},
                       **extra)
        self.set_config(external_decisions=section)
        self.owner_orders(section)

    JUDGE_ALLOWS = {"hard_to_reverse": 0.0, "speaks_for_you": 0.0, "outside_scope": 0.0, "outside_intent": 0.0}

    def set_judge(self, noul=None, error=None):
        """What the (replayed, never real) decision model says to the judge's four questions."""
        rule = {"error": error} if error else {"noul": dict(self.JUDGE_ALLOWS, **(noul or {}))}
        (self.home / "judge.json").write_text(json.dumps({"rules": [rule]}))

    def owner_orders(self, section):
        """The owner's standing orders and a judge that allows, so an answer by the owner's agent is applied (the
        inbound judge consults both); a test sets `orders_text` (None: no file) or `judge_off` before turn_on."""
        if getattr(self, "judge_off", False):
            return
        orders = getattr(self, "orders_text", "Decide the repo's routine questions for me. Never merge, deploy or spend.")
        path = self.home / "orders.md"
        if orders is None:
            if path.exists():
                path.unlink()
        else:
            path.write_text(orders)
        self.set_judge()
        self.set_config(external_decisions=section, policy={**LEGACY_POLICY, "enabled": True}, jev={"replay": str(self.home / "judge.json")},
                        cos_orders_file=str(path))

    def run_pass(self, seconds=5):
        self.daemon_pass(seconds)

    def audit_events(self, prefix="external."):
        lines = (self.world.state / "audit.jsonl").read_text().splitlines()
        found = [json.loads(l) for l in lines if l.strip()]
        return [e for e in found if str(e.get("event", "")).startswith(prefix)]

    def event(self, ext, kind="answered", by="human", eid=None, **more):
        eid = eid or "ev-%d" % (len(self.fake.events) + 1)
        self.fake.events.append(dict({"event_id": eid, "external_id": ext, "type": kind, "answered_by": by,
                                      "option_id": "yes", "text": "go ahead"}, **more))
        return eid

    def ext_of(self, kind):
        found = [e for e, i in self.fake.items.items() if i["decision"]["kind"] == kind]
        self.assertEqual(len(found), 1, self.fake.items)
        return found[0]


class TestExternalTiers(ExternalWorld):
    """Issue 82: `external_decisions.tiers` says which fleet tiers are pushed; the default is the human's only."""

    def two(self):
        self.gh.issue(API, 2, "Which database?", labels=["me:awaiting-cos"])        # the Chief of Staff's
        self.gh.issue(API, 3, "Pick the cache layer", labels=["me:awaiting-user"])  # yours

    def pushed(self):
        return sorted(i["decision"]["title"] for i in self.fake.items.values() if i["state"] == "open")

    def test_the_default_is_the_human_tier_only(self):
        got = sb.validate_config({"external_decisions": {}})["external_decisions"]
        self.assertEqual(got["tiers"], ["human"])
        self.turn_on(tiers=got["tiers"])
        self.two()
        self.run_pass()
        self.assertEqual(self.pushed(), ["Pick the cache layer"])
        self.assertEqual([c[0] for c in self.fake.calls], ["raise"], "the cos item was never sent")

    def test_cos_turns_back_on_in_one_line_and_an_item_of_an_unpushed_tier_is_withdrawn_once(self):
        self.turn_on(tiers=["cos", "human"])
        self.two()
        self.run_pass()
        self.assertEqual(self.pushed(), ["Pick the cache layer", "Which database?"])
        cos_ext = [e for e, i in self.fake.items.items() if i["decision"]["title"] == "Which database?"][0]
        self.turn_on(tiers=["human"])   # the one line, the other way
        self.run_pass()
        self.run_pass()
        self.assertEqual(self.pushed(), ["Pick the cache layer"])
        self.assertEqual(self.fake.items[cos_ext]["state"], "withdrawn")
        self.assertEqual([c[0] for c in self.fake.calls].count("withdraw"), 1, "withdrawn once, not every pass")
        self.assertEqual(len(self.cmd("you", "decisions")["out"].splitlines()) > 0, True, "it stays a local decision")
        # switching back raises it again
        self.turn_on(tiers=["cos", "human"])
        self.run_pass()
        self.run_pass()
        self.assertEqual(self.pushed(), ["Pick the cache layer", "Which database?"])

    def test_a_late_answer_on_an_item_withdrawn_for_its_tier_is_known_as_closed(self):
        self.turn_on(tiers=["cos", "human"])
        self.two()
        self.run_pass()
        cos_ext = [e for e, i in self.fake.items.items() if i["decision"]["title"] == "Which database?"][0]
        self.turn_on(tiers=["human"])
        self.run_pass()
        comments = len(self.gh.comments)
        self.event(cos_ext, by="human")
        self.run_pass()
        self.assertEqual(len(self.gh.comments), comments, "nothing is delivered")
        self.assertEqual([e["event"] for e in self.audit_events("external.closed")], ["external.closed"])

    def test_an_empty_list_pushes_nothing_and_is_valid(self):
        self.turn_on(tiers=[])
        self.two()
        self.run_pass()
        self.assertEqual(self.fake.calls, [])

    def test_hostile_values_are_refused(self):
        good = {"enabled": True, "adapter": "fake", "repos": [API], "mapping_file": "/tmp/m.json", "tier_map": ExternalWorld.TIERS}
        for bad in ("human", None, ["boss"], ["human", "human"], [1], [["human"]], {"human": True}, ["Human"], [""], True):
            with self.subTest(bad=bad), self.assertRaises(sb.ConfigError):
                sb.validate_config({"external_decisions": dict(good, tiers=bad)})
        for ok in ([], ["human"], ["cos", "human"], ["orchestrator", "cos", "human"]):
            self.assertEqual(sb.validate_config({"external_decisions": dict(good, tiers=ok)})["external_decisions"]["tiers"], ok)


class TestJudgeSample(unittest.TestCase):
    """bin/judge-sample (issue 87): a stratified, reproducible sample from the audit log, never written inside the repo."""

    def row(self, i, verdict, agent="coder-a", shadow=True):
        state = {"arguments": "cmd %d" % i, "intent": "i", "done_when": "d", "tool": "shell", "role": "coder"}
        return {"event": "policy.judge", "ts": "2026-10-08T00:00:%02dZ" % (i % 60), "detail": {
            "shadow": shadow, "judged": True, "verdict": verdict, "agent": agent, "role": "coder", "tool": "shell", "ask": 1,
            "fired": ["outside_intent"], "answers": {}, "thresholds": {}, "reason": "r", "question": {"state": state}}}

    def test_it_draws_each_kind_distinct_reproducible_and_refuses_the_repo(self):
        with tempfile.TemporaryDirectory() as tmp:
            audit = Path(tmp) / "audit.jsonl"
            rows = [self.row(i, v, agent="a%d" % (i % 3)) for i, v in enumerate(["would-deny", "would-ask", "unchanged"] * 20)]
            rows += [self.row(0, "would-deny", agent="a0"), self.row(1, "would-deny", shadow=False)]  # a repeat, and a non-shadow
            audit.write_text("\n".join(json.dumps(r) for r in rows) + "\nnot json\n")
            out = Path(tmp) / "s.jsonl"
            cmd = [sys.executable, str(REPO / "bin" / "judge-sample"), "--audit", str(audit), "--out", str(out), "--deny", "5", "--ask", "4", "--control", "3"]
            self.assertEqual(subprocess.run(cmd, capture_output=True, text=True).returncode, 0)
            first = out.read_text()
            got = [json.loads(l) for l in first.splitlines()]
            self.assertEqual(sorted(r["verdict"] for r in got).count("would-deny"), 5)
            self.assertEqual((len(got), len({(r["arguments"], r["verdict"]) for r in got})), (12, 12))
            self.assertTrue(all(r["label"] is None and r["intent"] == "i" for r in got))
            subprocess.run(cmd, capture_output=True, text=True)
            self.assertEqual(out.read_text(), first, "the same seed gives the same sample")
            bad = subprocess.run(cmd[:-6] + ["--out", str(REPO / "bin" / "never.jsonl")], capture_output=True, text=True)
            self.assertEqual(bad.returncode, 2)
            self.assertFalse((REPO / "bin" / "never.jsonl").exists())

    def test_since_keeps_only_later_verdicts_and_a_short_kind_gives_what_there_is(self):
        with tempfile.TemporaryDirectory() as tmp:
            audit = Path(tmp) / "audit.jsonl"
            rows = []
            for i, v in enumerate(["would-deny", "would-ask", "unchanged"] * 4):
                row = self.row(i, v)
                row["ts"] = "2026-10-08T22:%02d:00.000Z" % (10 + i)   # 22:10 ... 22:21
                rows.append(row)
            bad = self.row(99, "would-deny")
            bad["ts"] = "garbage"
            rows.append(bad)
            audit.write_text("\n".join(json.dumps(r) for r in rows) + "\n")
            out = Path(tmp) / "s.jsonl"

            def run(*extra):
                return subprocess.run([sys.executable, str(REPO / "bin" / "judge-sample"), "--audit", str(audit), "--out", str(out),
                                       "--deny", "40", "--ask", "40", "--control", "40", *extra], capture_output=True, text=True)
            done = run("--since", "2026-10-08T22:14:00Z")
            self.assertEqual(done.returncode, 0, done.stderr)
            got = [json.loads(l) for l in out.read_text().splitlines()]
            self.assertTrue(all(r["ts"] >= "2026-10-08T22:14" for r in got))
            self.assertEqual(len(got), 8, "the garbage ts and the verdicts before 22:14 are out; 22:14 itself is in")
            self.assertIn("fewer than asked", done.stdout)
            self.assertIn("deny 2 of 40", done.stdout)
            self.assertIn("since 2026-10-08T22:14:00Z", done.stdout)
            for given in ("2026-10-08T22:14:00+00:00", "2026-10-08T22:14:00", "2026-10-08T23:14:00+01:00"):
                run("--since", given)
                self.assertEqual(len(out.read_text().splitlines()), 8, given)
            self.assertEqual(len(run("--since", "2026-10-08T22:15:00Z") and out.read_text().splitlines()), 7)
            self.assertEqual(run("--since", "yesterday").returncode, 2)
            self.assertEqual(run().returncode, 0)
            self.assertEqual(len(out.read_text().splitlines()), 13, "no --since: every verdict, including the one with no readable time")


class TestExternalDecisionConfig(unittest.TestCase):
    def check(self, section):
        return sb.validate_config({"external_decisions": section})["external_decisions"]

    def test_off_by_default_and_filled_when_absent(self):
        self.assertNotIn("external_decisions", sb.validate_config({}), "a config that never names it has no such key")
        for raw in ({"external_decisions": None}, {"external_decisions": {}}):
            found = sb.validate_config(raw)["external_decisions"]
            self.assertIs(found["enabled"], False)
            self.assertEqual((found["repos"], found["kinds"]), ([], ["issue", "report"]))

    def test_each_key_is_checked(self):
        good = {"enabled": True, "adapter": "fake", "repos": [API], "mapping_file": "/tmp/m.json",
                "tier_map": ExternalWorld.TIERS}
        self.assertTrue(self.check(good)["enabled"])
        for bad in ({"enabled": "yes"}, {"adapter": "Bad Name"}, {"repos": ["nope"]}, {"repos": "acme/api"},
                    {"kinds": ["permission"]}, {"kinds": []}, {"mapping_file": "relative.json"},
                    {"tier_map": {"cos": "x"}}, {"tier_map": {"orchestrator": "", "cos": "b", "human": "c"}},
                    {"poll_seconds": 0}, {"retry_base_seconds": 10, "retry_max_seconds": 5},
                    {"outbox_alarm_depth": 0}):
            with self.subTest(bad=bad), self.assertRaises(sb.ConfigError):
                self.check(dict(good, **bad))
        with self.assertRaises(sb.ConfigError):
            sb.validate_config({"external_decisions": []})

    def test_enabled_needs_its_adapter_mapping_tiers_and_a_repo(self):
        for missing in ("adapter", "mapping_file", "tier_map", "repos"):
            good = {"enabled": True, "adapter": "fake", "repos": [API], "mapping_file": "/tmp/m.json",
                    "tier_map": ExternalWorld.TIERS}
            good.pop(missing)
            with self.subTest(missing=missing), self.assertRaises(sb.ConfigError):
                self.check(good)


class TestExternalDecisionRules(unittest.TestCase):
    core = sb.decision_core

    def test_keys_are_stable_and_the_idempotency_key_follows_the_operation(self):
        a = self.core.decision_key("issue:acme/api#2")
        self.assertEqual(a, self.core.decision_key("issue:acme/api#2"))
        self.assertNotEqual(a, self.core.decision_key("issue:acme/api#3"))
        k = self.core.idempotency_key(a, "revise", 2)
        self.assertEqual(k, self.core.idempotency_key(a, "revise", 2))
        self.assertEqual(len({k, self.core.idempotency_key(a, "revise", 3), self.core.idempotency_key(a, "raise", 2),
                              self.core.idempotency_key(self.core.decision_key("x"), "revise", 2)}), 4)

    def test_authority_follows_the_role_of_the_answerer(self):
        ok = lambda role, tier: self.core.answer_authority(role, tier)[0]
        self.assertEqual([ok("project_agent", t) for t in ("orchestrator", "cos", "human")], [True, False, False])
        self.assertEqual([ok("owner_agent", t) for t in ("orchestrator", "cos", "human")], [True, True, False])
        self.assertEqual([ok("human", t) for t in ("orchestrator", "cos", "human")], [True, True, True])
        self.assertFalse(ok(None, "cos"))
        self.assertFalse(ok("human", "nobody"))
        self.assertEqual([self.core.normalize_role(x) for x in ("project agent", "Owner's agent", "human", "robot")],
                         ["project_agent", "owner_agent", "human", None])

    def test_a_permission_request_and_a_notice_never_go_out(self):
        for kind in ("permission", "notice"):
            self.assertFalse(self.core.goes_outward({"kind": kind, "repo": API}, [API], ("issue", "report", "question")))
        self.assertTrue(self.core.goes_outward({"kind": "issue", "repo": API}, [API]))
        self.assertFalse(self.core.goes_outward({"kind": "issue", "repo": WEB}, [API]))
        self.assertFalse(self.core.goes_outward({"kind": "question", "repo": API}, [API]))
        self.assertTrue(self.core.goes_outward({"kind": "question", "repo": API}, [API], ("question",)))

    def test_the_payload_carries_no_credential(self):
        payload = self.core.outward_payload({"title": "use Bearer abcdef123456 and sk-abcdefghij1234", "headline": "h",
                                             "kind": "report", "id": "#2", "tier": "cos"}, "floor-b")
        self.assertNotIn("abcdef123456", json.dumps(payload))
        self.assertNotIn("sk-abcdefghij1234", json.dumps(payload))


class TestExternalDecisionSync(ExternalWorld):
    def test_off_means_no_call_and_no_file(self):
        self.gh.issue(API, 2, "Which database?", labels=["me:awaiting-cos"])
        self.say("api-orch", "question", "Which table?")
        self.run_pass()
        self.run_pass()
        self.assertEqual(self.fake.calls, [])
        self.assertEqual(sorted(p.name for p in self.world.state.iterdir() if p.name.startswith("external")), [])
        self.assertEqual([e for e in self.file_body()["errors"] if e["source"] == "external"], [])
        self.assertNotIn("external", self.cmd("you", "status")["out"])

    def test_enabled_but_a_repo_not_listed_is_not_sent(self):
        self.turn_on(repos=[WEB])
        self.gh.issue(API, 2, "Which database?", labels=["me:awaiting-cos"])
        self.run_pass()
        self.assertEqual(self.fake.calls, [])

    def test_raise_revise_tier_change_and_withdraw(self):
        self.turn_on()
        self.gh.issue(API, 2, "Which database?", labels=["me:awaiting-cos"])
        self.gh.issue(WEB, 4, "Pick the cache layer", labels=["me:awaiting-user"])           # a repo not switched on
        self.ask_permission("api-coder")                                                         # a permission: local only
        self.prs[7] = pr_view_json()
        self.cmd("api-coder", "notice", "pr", "acme/api#7", "look")                              # a notice: local only
        self.say("api-orch", "question", "Which table should hold the totals?", 6)
        self.run_pass()
        self.assertEqual(sorted(i["decision"]["kind"] for i in self.fake.items.values()), ["issue", "report"])
        self.assertEqual(sorted((i["decision"]["kind"], i["floor"]) for i in self.fake.items.values()),
                         [("issue", "floor-b"), ("report", "floor-b")])
        self.assertTrue(all(c[0] == "raise" for c in self.fake.calls))
        self.assertEqual(len(self.fake.calls), 2, "the permission, the notice and the other repo stayed local")
        # the same pass again: nothing more to say
        self.run_pass()
        self.assertEqual(len(self.fake.calls), 2)
        # a re-asked question is a revise of the same item, not a second one
        before = self.ext_of("report")
        self.say("api-orch", "question", "Which table, really? The first answer is moot.", 6)
        self.run_pass()
        self.run_pass()
        self.assertEqual(self.ext_of("report"), before)
        self.assertEqual(len(self.fake.items), 2)
        self.assertEqual(self.fake.items[before]["revisions"], [1, 2])
        self.assertIn("really", self.fake.items[before]["decision"]["title"])
        # escalating is a tier change
        self.assertEqual(self.cmd("cos", "decisions", "escalate", "api#2")["code"], 0)
        self.run_pass()
        self.assertEqual(self.fake.items[self.ext_of("issue")]["floor"], "floor-c")
        # resolving withdraws it
        self.assertEqual(self.cmd("you", "decisions", "resolve", "api#2")["code"], 0)  # escalated: the owner's tier, so you resolve it
        self.run_pass()
        self.assertEqual(self.fake.items[self.ext_of("issue")]["state"], "withdrawn")

    @mock.patch.object(sb, "adoption_pass", new=lambda *a, **k: None)   # #838: a boss that is gone is replaced by an adoption within a pass; this test is about the pass that sees it unreadable first (adoption is TestAdoption's)
    def test_an_unreadable_boss_does_not_stop_an_answered_report_of_another_boss_leaving(self):
        """#80: web-orch is gone (its reports cannot be read); api-coder's answered question still leaves."""
        self.turn_on(repos=[API, WEB])
        self.say("api-coder", "question", "Which table should hold the totals?", 6)
        self.say("web-coder", "question", "Which cache layer?", 4)
        self.run_pass()
        self.assertEqual(len(self.fake.open_items()), 2)
        self.world.herdr.panes.pop(self.world.panes["web-orch"])
        self.send("api-orch", "api-coder", "use the totals table", 6)
        self.run_pass()
        self.run_pass()
        self.assertTrue([e for e in self.fresh()["errors"] if e["source"] == "reports"], "web-orch is unreadable")
        open_titles = sorted(i["decision"]["title"] for i in self.fake.open_items().values())
        self.assertEqual(len(open_titles), 1, open_titles)
        self.assertIn("cache", open_titles[0], "only the unreadable boss's report is kept")

    def test_the_stale_role_name_boss_does_not_freeze_withdrawals(self):
        """#80: a worker that reports to the role name `chief-of-staff` while the agent is `cos` raises no error."""
        self.turn_on()
        self.add_worker("alias-coder", boss="chief-of-staff")
        self.say("api-coder", "question", "Which table should hold the totals?", 6)
        self.run_pass()
        self.assertEqual([e for e in self.fresh()["errors"] if e["source"] == "reports"], [])
        self.send("api-orch", "api-coder", "use the totals table", 6)
        self.run_pass()
        self.run_pass()
        self.assertEqual(self.fake.open_items(), {})

    def test_the_outbox_retries_and_a_lost_answer_does_not_make_a_second_item(self):
        self.turn_on()
        self.gh.issue(API, 2, "Which database?", labels=["me:awaiting-cos"])
        self.fake.lose_ack = True
        self.run_pass()
        self.assertEqual(len(self.fake.items), 1, "the write landed; its answer was lost")
        self.assertEqual(len(json.loads((self.world.state / "external-outbox.json").read_text())["ops"]), 1)
        self.run_pass(1)   # inside the backoff: no new try
        self.assertEqual(len(self.fake.calls), 1)
        self.run_pass(10)
        self.assertEqual(len(self.fake.items), 1, "the retry carried the same idempotency key")
        self.assertEqual(len(set(c[2] for c in self.fake.calls)), 1)
        self.assertEqual(json.loads((self.world.state / "external-outbox.json").read_text())["ops"], [])

    def test_a_down_adapter_is_a_visible_error_and_hides_nothing_locally(self):
        self.turn_on()
        self.fake.up = False
        self.gh.issue(API, 2, "Which database?", labels=["me:awaiting-cos"])
        self.say("api-orch", "question", "Which table?")
        self.run_pass()
        body = self.file_body()
        self.assertEqual(sorted(d["kind"] for d in body["decisions"]), ["issue", "report"])
        self.assertEqual([e["error"] for e in body["errors"] if e["source"] == "external"],
                         ["external decision system is down: the fake is down"])
        self.assertIn("external  down: the fake is down; outbox 2", self.cmd("you", "status")["out"])
        self.assertEqual(self.fake.calls, [])
        # local answering still works while it is down
        self.assertEqual(self.cmd("you", "decisions", "resolve", "api#2")["code"], 0)
        self.fake.up = True
        self.run_pass()
        self.run_pass()
        self.assertEqual([i["decision"]["kind"] for i in self.fake.open_items().values()], ["report"])
        self.assertIn("external  ok; outbox 0", self.cmd("you", "status")["out"])

    def test_a_failing_read_of_a_source_is_not_an_answer_and_withdraws_nothing(self):
        self.turn_on()
        self.gh.issue(API, 2, "Which database?", labels=["me:awaiting-cos"])
        self.run_pass()
        self.assertEqual(len(self.fake.open_items()), 1)
        with baseline_failing_source("github"):
            self.run_pass()
            self.run_pass()
        self.assertEqual(len(self.fake.open_items()), 1)

    def test_reconcile_rebuilds_the_link_table_from_the_adapter(self):
        self.turn_on()
        self.gh.issue(API, 2, "Which database?", labels=["me:awaiting-cos"])
        self.run_pass()
        (self.world.state / "external-links.json").unlink()
        self.world.engine.external_sync = None
        self.run_pass()
        self.run_pass()
        self.assertEqual(len(self.fake.items), 1)
        links = json.loads((self.world.state / "external-links.json").read_text())["links"]
        self.assertEqual([l["external_id"] for l in links.values()], ["ext-1"])
        self.assertEqual([e["event"] for e in self.audit_events("external.linked")], ["external.linked"])

    def test_an_answer_is_applied_once_for_a_report_an_issue_and_a_batch(self):
        self.turn_on()
        self.gh.issue(API, 2, "Which database?", labels=["me:awaiting-user"])                  # human tier
        self.say("api-coder", "question", "Which table should hold the totals?", 6)           # orchestrator tier
        self.assertEqual(self.raise_batch()["code"], 0)                                        # a batch, cos tier
        self.run_pass()
        self.assertEqual(len(self.fake.items), 3)
        report, batch = self.ext_of("report"), [e for e, i in self.fake.items.items() if i["decision"].get("batch")][0]
        issue = [e for e, i in self.fake.items.items() if i["decision"]["kind"] == "issue" and not i["decision"].get("batch")][0]
        first = self.event(report, by="project agent", text="use the totals table")
        self.event(report, by="project agent", eid=first)                                      # the same event again
        self.event(issue, by="human", text="postgres")
        self.event(batch, by="owner's agent", option_id="as_recommended", text="fine")
        before = self.mark()
        self.run_pass()
        sent = [t for t in self.notes_to("api-coder") if "Answered outside by the project agent" in t]
        self.assertEqual(len(sent), 1, "applied once, the duplicate ignored")
        self.assertFalse([t for t in self.notes_to("api-coder") if "answer changed" in t], "the duplicate is not a reversal")
        self.assertEqual(self.audit_events("external.reversed"), [])
        self.assertIn("use the totals table", sent[0])
        self.assertEqual(self.labels()["acme/api#2"], [], "the issue's labels are off")
        comments = [c["body"] for c in self.gh.comments[before["comments"]:]]
        self.assertTrue(any("Answered outside by the human: postgres" in c for c in comments), comments)
        self.assertTrue(any("Answer to this batch" in c for c in comments), comments)
        self.run_pass()
        self.assertEqual([d["id"] for d in self.file_body()["decisions"]], [])
        self.assertEqual(sorted(i["state"] for i in self.fake.items.values()), ["open", "open", "open"],
                         "answered outside: nothing is withdrawn outside")
        answered = self.audit_events("external.answered")
        self.assertEqual(sorted(e["detail"]["role"] for e in answered), ["human", "owner_agent", "project_agent"])

    def test_a_role_below_the_decisions_tier_is_not_applied(self):
        self.turn_on()
        self.gh.issue(API, 2, "A cos issue", labels=["me:awaiting-cos"])
        self.gh.issue(API, 3, "A human issue", labels=["me:awaiting-user"])
        self.run_pass()
        cos_item = [e for e, i in self.fake.items.items() if i["decision"]["display_id"] == "api#2"][0]
        human_item = [e for e, i in self.fake.items.items() if i["decision"]["display_id"] == "api#3"][0]
        self.event(cos_item, by="project agent")
        self.event(human_item, by="owner's agent")
        self.event(human_item, by="somebody else")
        before = self.mark()
        self.run_pass()
        self.assertEqual(self.labels()["acme/api#2"], ["me:awaiting-cos"])
        self.assertEqual(self.labels()["acme/api#3"], ["me:awaiting-user"])
        self.assertEqual(len(self.gh.comments), before["comments"])
        refused = self.audit_events("external.refused")
        self.assertEqual(len(refused), 3)
        self.run_pass()
        self.assertTrue(any("not applied" in n for n in self.fake.items[cos_item]["notes"]), "pushed back as a note")
        self.assertEqual(sorted(d["id"] for d in self.file_body()["decisions"]), ["api#2", "api#3"], "both stay")
        # equal or higher is applied
        self.event(cos_item, by="owner's agent")
        self.event(human_item, by="human")
        self.run_pass()
        self.assertEqual(self.labels()["acme/api#2"], [])
        self.assertEqual(self.labels()["acme/api#3"], [])

    def test_clarify_goes_to_the_agent_and_is_not_an_answer(self):
        self.turn_on()
        self.say("api-orch", "question", "Which table?", 6)
        self.run_pass()
        ext = self.ext_of("report")
        self.event(ext, kind="clarify", by="owner's agent", text="which environment is this for?")
        self.run_pass()
        self.assertTrue(any("which environment is this for?" in t for t in self.notes_to("api-orch")))
        self.assertEqual([d["kind"] for d in self.file_body()["decisions"]], ["report"], "still open")
        self.assertEqual(self.audit_events("external.answered"), [])
        # the agent's next question is a revise of the same item
        self.say("api-orch", "question", "Which table, for production?", 6)
        self.run_pass()
        self.run_pass()
        self.assertEqual(self.fake.items[ext]["revisions"], [1, 2])
        self.assertEqual(len(self.fake.items), 1)

    def test_a_reversal_tells_the_agent_and_undoes_nothing(self):
        self.turn_on()
        self.gh.issue(API, 2, "Which database?", labels=["me:awaiting-user"])
        self.say("api-coder", "question", "Which table?", 6)
        self.run_pass()
        report = self.ext_of("report")
        self.event(report, by="human", text="use totals")
        self.run_pass()
        self.run_pass()
        sends = len(self.notes_to("api-coder"))
        self.event(report, kind="reversed", by="human", text="actually use the daily table")
        self.run_pass()
        later = self.notes_to("api-coder")[sends:]
        self.assertEqual(len(later), 1)
        self.assertIn("answer changed: actually use the daily table", later[0])
        self.assertEqual(len(self.audit_events("external.reversed")), 1)

    def test_an_answer_for_an_unknown_or_closed_decision_is_an_orphan_and_delivers_nothing(self):
        self.turn_on()
        self.gh.issue(API, 2, "Which database?", labels=["me:awaiting-user"])
        self.run_pass()
        ext = self.ext_of("issue")
        self.event("ext-nope", by="human")
        before = self.mark()
        self.run_pass()
        self.assertEqual([e["event"] for e in self.audit_events("external.orphan")], ["external.orphan"])
        self.assertEqual(len(self.gh.comments), before["comments"])
        # answered here first: a later outside answer finds it closed
        self.assertEqual(self.cmd("you", "decisions", "resolve", "api#2")["code"], 0)
        self.run_pass()
        self.event(ext, by="human")
        count = len(self.gh.comments)
        self.run_pass()
        self.assertEqual(len(self.gh.comments), count)
        self.assertEqual([e["event"] for e in self.audit_events("external.closed")], ["external.closed"])

    def test_a_decision_with_no_floor_tier_for_its_tier_is_left_alone_and_status_says_off_when_off(self):
        self.turn_on()
        self.run_pass()
        line = self.cmd("you", "status")["out"]
        self.assertIn("external  ok; outbox 0; last pull", line)
        self.set_config()
        self.assertNotIn("external", self.cmd("you", "status")["out"])


class TestExternalInboundJudge(ExternalWorld):
    """An answer by the owner's agent is applied only when the owner's standing orders, consulted by the same
    judge the Chief of Staff's own answers go through, allow it. Fails safe. The model is always a replay."""

    def cos_issue(self):
        self.gh.issue(API, 2, "Which database?", labels=["me:awaiting-cos"])
        self.run_pass()
        return self.ext_of("issue")

    def answer(self, ext, **more):
        eid = self.event(ext, by="owner's agent", text="use postgres", **more)
        self.run_pass()
        return eid

    def applied(self):
        return self.labels()["acme/api#2"] == []

    def test_within_the_orders_the_answer_is_applied(self):
        self.turn_on()
        ext = self.cos_issue()
        self.answer(ext)
        self.assertTrue(self.applied())
        self.assertEqual([e["detail"]["role"] for e in self.audit_events("external.answered")], ["owner_agent"])

    def test_outside_the_orders_it_is_not_applied_the_decision_stays_and_the_reason_is_pushed_back(self):
        self.turn_on()
        ext = self.cos_issue()
        self.set_judge(noul={"hard_to_reverse": 0.9})
        self.answer(ext)
        self.assertFalse(self.applied())
        (denied,) = self.audit_events("external.judged")
        self.assertIn("outside the owner's standing orders", denied["detail"]["reason"])
        self.assertIn("hard to reverse", denied["detail"]["reason"])
        self.run_pass()
        self.assertTrue(any("not applied: outside the owner's standing orders" in n for n in self.fake.items[ext]["notes"]))
        self.assertEqual([d["id"] for d in self.file_body()["decisions"]], ["api#2"], "it stays open at its tier")
        self.run_pass(30)   # settled: not tried again
        self.assertEqual(len(self.audit_events("external.judged")), 1)

    def test_a_judge_that_cannot_answer_leaves_it_open_and_a_later_allow_applies_it_once(self):
        self.turn_on()
        ext = self.cos_issue()
        self.set_judge(error="timeout")
        eid = self.answer(ext)
        self.assertFalse(self.applied())
        self.assertEqual(len(self.audit_events("external.judge_unavailable")), 1)
        self.assertEqual(self.audit_events("external.answered"), [])
        self.run_pass(1)   # inside the backoff: not asked again
        self.assertEqual(len(self.audit_events("external.judge_unavailable")), 1)
        self.set_judge()   # the model is back
        self.run_pass(10)
        self.assertTrue(self.applied())
        self.assertEqual(len(self.audit_events("external.answered")), 1)
        self.event(ext, by="owner's agent", eid=eid)   # the same event again
        self.run_pass()
        self.assertEqual(len(self.audit_events("external.answered")), 1)
        self.assertEqual(self.audit_events("external.reversed"), [])

    def test_a_dead_judge_does_not_spin_it_is_asked_a_bounded_number_of_times_and_then_not_applied(self):
        self.turn_on()
        ext = self.cos_issue()
        self.set_judge(error="timeout")
        self.answer(ext)
        for _ in range(12):
            self.run_pass(120)
        tries = self.audit_events("external.judge_unavailable")
        self.assertEqual(len(tries), 5)
        (denied,) = self.audit_events("external.judged")
        self.assertIn("could not be asked after 5 tries", denied["detail"]["reason"])
        self.assertFalse(self.applied())
        self.run_pass(120)
        self.assertEqual(len(self.audit_events("external.judge_unavailable")), 5)

    def test_a_duplicate_of_an_answer_waiting_for_the_judge_is_not_a_second_try(self):
        self.turn_on()
        ext = self.cos_issue()
        self.set_judge(error="timeout")
        eid = self.answer(ext)
        self.event(ext, by="owner's agent", eid=eid, text="use postgres")   # the same event, delivered again
        self.run_pass(1)
        self.assertEqual(len(self.audit_events("external.judge_unavailable")), 1)

    def test_a_dead_judge_does_not_hold_up_other_answers(self):
        self.turn_on()
        self.gh.issue(API, 2, "A cos issue", labels=["me:awaiting-cos"])
        self.gh.issue(API, 3, "A human issue", labels=["me:awaiting-user"])
        self.run_pass()
        cos_item = [e for e, i in self.fake.items.items() if i["decision"]["display_id"] == "api#2"][0]
        human_item = [e for e, i in self.fake.items.items() if i["decision"]["display_id"] == "api#3"][0]
        self.set_judge(error="timeout")
        self.event(cos_item, by="owner's agent")
        self.event(human_item, by="human")
        self.run_pass()
        self.assertEqual(self.labels()["acme/api#3"], [], "the human's answer was applied past the parked one")
        self.assertEqual(self.labels()["acme/api#2"], ["me:awaiting-cos"])

    def test_no_orders_file_means_none_stated_and_the_answer_goes_to_the_owner(self):
        self.orders_text = None
        self.turn_on()
        ext = self.cos_issue()
        self.answer(ext)
        self.assertFalse(self.applied())
        (denied,) = self.audit_events("external.judged")
        self.assertIn("no standing orders are stated", denied["detail"]["reason"])
        self.orders_text = "<!-- only a comment -->"
        self.owner_orders(self.world.config["external_decisions"])
        self.answer(ext, eid="other")
        self.assertFalse(self.applied(), "a file with only the template's comment states nothing")

    def test_a_judge_that_is_not_on_is_not_a_yes(self):
        self.judge_off = True
        self.turn_on()
        ext = self.cos_issue()
        self.answer(ext)
        self.assertFalse(self.applied())
        (denied,) = self.audit_events("external.judged")
        self.assertIn("policy judge is not on", denied["detail"]["reason"])

    def test_the_judge_only_tightens_it_never_lets_through_what_role_authority_refuses(self):
        self.turn_on()
        ext = self.cos_issue()
        eid = self.event(ext, by="project agent", text="go")       # below the cos tier; the judge would allow
        self.run_pass()
        self.assertFalse(self.applied())
        self.assertEqual(len(self.audit_events("external.refused")), 1)
        self.assertEqual(self.audit_events("external.judged"), [])

    def test_the_project_agent_and_the_human_are_not_judged(self):
        self.turn_on()
        self.gh.issue(API, 3, "A human issue", labels=["me:awaiting-user"])
        self.say("api-coder", "question", "Which table?", 6)
        self.run_pass()
        human_item, report = self.ext_of("issue"), self.ext_of("report")
        self.set_judge(noul={"hard_to_reverse": 0.99, "speaks_for_you": 0.99})   # a judge that would deny everything
        self.event(human_item, by="human", text="yes")
        self.event(report, by="project agent", text="use totals")
        self.run_pass()
        self.assertEqual(self.labels()["acme/api#3"], [])
        self.assertTrue([t for t in self.notes_to("api-coder") if "use totals" in t])
        self.assertEqual(self.audit_events("external.judged"), [])

    def test_the_audit_names_the_reason_and_holds_no_credential(self):
        self.turn_on()
        ext = self.cos_issue()
        self.set_judge(noul={"speaks_for_you": 0.9})
        self.event(ext, by="owner's agent", text="deploy it with Bearer abcdef123456 and sk-abcdefghij1234")
        self.run_pass()
        raw = (self.world.state / "audit.jsonl").read_text()
        self.assertNotIn("abcdef123456", raw)
        self.assertNotIn("sk-abcdefghij1234", raw)
        (denied,) = self.audit_events("external.judged")
        self.assertIn("speaks for you", denied["detail"]["reason"])


# ---------------------------------------------------------------------------------------------------------------
# The generic adapter wired into the daemon (external_decisions.adapter = "mapping"): off means nothing is loaded;
# on builds it once, runs its key source once, and every failure is a `down: <why>` that never touches the local list.


class TestExternalWiring(ExternalWorld):
    TIERS = {"orchestrator": "low", "cos": "high", "human": "reserved"}

    def setUp(self):
        super().setUp()
        self.door = FakeDoorServer()
        self.addCleanup(self.door.close)
        self.runs = self.home / "key-runs"
        self.key_command = [sys.executable, "-c", "import sys; open(%r, 'a').write('x'); print(%r)"
                            % (str(self.runs), FakeDoorServer.KEY)]
        self.write_mapping()

    def write_mapping(self, **over):
        over.setdefault("key_source", {"command": self.key_command, "timeout": 5})
        data = fake_mapping(self.door.url, "tool", **over)
        self.mapping.write_text(json.dumps(data))

    def wire(self, **extra):
        self.turn_on(adapter="mapping", **extra)

    def key_runs(self):
        return len(self.runs.read_text()) if self.runs.exists() else 0

    def everything(self):
        """Every text the daemon leaves behind or shows: state files, the audit, status, the decision list."""
        found = [self.cmd("you", "status")["out"], self.cmd("you", "decisions", "--fresh")["out"]]
        for path in self.world.state.rglob("*"):
            if path.is_file():
                found.append(path.read_text(errors="replace"))
        return "\n".join(found)

    def test_on_builds_the_adapter_once_and_runs_the_key_command_once(self):
        self.wire()
        self.say("api-orch", "question", "Which table should hold the totals?", 6)
        self.run_pass()
        self.run_pass()
        self.run_pass()
        self.assertEqual(len(self.door.items), 1)
        item = list(self.door.items.values())[0]
        self.assertEqual(item["floor"], "major")  # the engine's floor name (high: an orchestrator's report is the cos's) in the adapter's words
        self.assertEqual(self.key_runs(), 1)
        self.assertIn("external  ok; outbox 0", self.cmd("you", "status")["out"])
        self.assertEqual([e["event"] for e in self.audit_events("external.started")], ["external.started"])
        self.assertEqual(self.door.count("raise"), 1)

    def test_a_new_engine_in_the_same_process_builds_its_own_adapter(self):
        self.wire()
        self.say("api-orch", "question", "Which table?", 6)
        self.run_pass()
        self.assertEqual(self.key_runs(), 1)
        self.world.engine = self.world.new_engine()   # a daemon restart: the key source runs again, and only once
        self.run_pass()
        self.run_pass()
        self.assertEqual(self.key_runs(), 2)
        self.assertEqual(len(self.door.items), 1, "the restart raised nothing twice")

    def test_off_loads_nothing_and_imports_nothing(self):
        self.gh.issue(API, 2, "Which database?", labels=["me:awaiting-cos"])
        with mock.patch.dict(sys.modules):
            sys.modules.pop("external_adapter", None)
            self.run_pass()                                       # no external_decisions at all
            self.assertNotIn("external_adapter", sys.modules)
            self.wire(enabled=False)                               # named, but off
            self.run_pass()
            self.run_pass()
            self.assertNotIn("external_adapter", sys.modules)
        self.assertEqual(self.key_runs(), 0)
        self.assertEqual(self.door.log, [])
        self.assertEqual(sorted(p.name for p in self.world.state.iterdir() if p.name.startswith("external")), [])
        self.assertNotIn("external", self.cmd("you", "status")["out"])

    def test_another_adapter_name_never_loads_this_one(self):
        self.turn_on()   # the fake
        self.say("api-orch", "question", "Which table?", 6)
        with mock.patch.dict(sys.modules):
            sys.modules.pop("external_adapter", None)
            self.run_pass()
            self.assertNotIn("external_adapter", sys.modules)

    def failure(self, name, setup, reason):
        """A failure mode: a pass never raises, the status says down and why, the local list is whole, the audit
        records it, the key command did not spin, and the key is nowhere."""
        setup()
        self.say("api-orch", "question", "Which table (%s)?" % name, 6)
        self.run_pass()
        body = self.file_body()
        self.assertEqual([d["kind"] for d in body["decisions"]], ["report"], name)
        ours = [e["error"] for e in body["errors"] if e["source"] == "external"]
        self.assertEqual(len(ours), 1, (name, ours))
        self.assertIn("external decision system is down", ours[0])
        self.assertIn(reason, ours[0], name)
        self.assertIn("external  down: ", self.cmd("you", "status")["out"])
        self.assertIn(reason, self.cmd("you", "status")["out"])
        self.assertEqual(len(self.audit_events("external.down")), 1, name)
        self.assertEqual(self.door.log, [], name)
        self.assertNotIn(FakeDoorServer.KEY, self.everything(), name)
        return body

    def test_every_failure_mode_is_a_down_status_and_leaves_the_local_list_alone(self):
        def missing():
            self.wire()
            self.mapping.unlink()

        def not_json():
            self.wire()
            self.mapping.write_text("{nope")

        def invalid():
            self.wire()
            data = json.loads(self.mapping.read_text())
            data["surprise"] = 1
            self.mapping.write_text(json.dumps(data))

        def command_fails():
            self.key_command = [sys.executable, "-c", "import sys; print('%s'); sys.exit(3)" % FakeDoorServer.KEY]
            self.write_mapping()
            self.wire()

        def command_hangs():
            self.key_command = [sys.executable, "-c", "import time; time.sleep(30)"]
            self.write_mapping()
            data = json.loads(self.mapping.read_text())
            data["key_source"]["timeout"] = 0.5
            self.mapping.write_text(json.dumps(data))
            self.wire()

        def env_missing():
            self.write_mapping(key_source="env:SURELY_NOT_SET_ANYWHERE_123")
            self.wire()

        def file_loose():
            path = self.home / "loose-key"
            path.write_text(FakeDoorServer.KEY)
            os.chmod(path, 0o644)
            self.write_mapping(key_source="file:%s" % path)
            self.wire()

        def unknown_adapter():
            self.turn_on(adapter="nobody-by-this-name")

        cases = (("mapping file missing", missing, "mapping file cannot be read"),
                 ("mapping not json", not_json, "mapping file cannot be read"),
                 ("mapping invalid", invalid, "mapping invalid"),
                 ("key command fails", command_fails, "exit 3"),
                 ("key command hangs", command_hangs, "did not answer"),
                 ("key env missing", env_missing, "not set"),
                 ("key file mode", file_loose, "0600"),
                 ("adapter not registered", unknown_adapter, "no adapter named"))
        for name, setup, reason in cases:
            with self.subTest(name):
                self.setUp()
                try:
                    self.failure(name, setup, reason)
                finally:
                    self.door.close()

    def test_a_failed_start_is_retried_only_after_a_backoff_and_then_recovers(self):
        self.key_command = [sys.executable, "-c", "import sys; open(%r, 'a').write('x'); sys.exit(1)" % str(self.runs)]
        self.write_mapping()
        self.wire()
        self.say("api-orch", "question", "Which table?", 6)
        self.run_pass(1)
        self.run_pass(1)
        self.run_pass(1)
        self.assertEqual(self.key_runs(), 1, "inside the backoff the key command is not run again")
        self.assertEqual(len(self.audit_events("external.down")), 1)
        self.key_command = [sys.executable, "-c", "import sys; open(%r, 'a').write('x'); print(%r)"
                            % (str(self.runs), FakeDoorServer.KEY)]
        self.write_mapping()   # the operator fixed it
        self.run_pass(10)
        self.assertEqual(self.key_runs(), 2)
        self.run_pass(1)
        self.assertIn("external  ok", self.cmd("you", "status")["out"])
        self.assertEqual(len(self.door.items), 1)
        self.assertEqual(len(self.audit_events("external.started")), 1)

    def test_down_later_grows_the_outbox_and_up_again_drains_it_without_duplicates(self):
        self.wire()
        self.say("api-orch", "question", "Which table?", 6)
        self.run_pass()
        self.assertEqual(len(self.door.items), 1)
        self.door.down = True
        self.say("api-orch", "question", "Which other table?", 7)
        self.run_pass()
        self.assertIn("external  down", self.cmd("you", "status")["out"])
        self.assertEqual(len(self.file_body()["decisions"]), 2)
        self.door.down = False
        self.run_pass(70)
        self.run_pass(70)
        self.assertEqual(len(self.door.items), 2, "no duplicates")
        self.assertIn("external  ok; outbox 0", self.cmd("you", "status")["out"])

    def test_the_key_is_nowhere_even_when_the_other_side_echoes_it(self):
        self.wire()
        self.door.fail_next("raise", 401, {"code": "cred", "message": "refused Key %s" % FakeDoorServer.KEY}, count=9)
        self.say("api-orch", "question", "Which table?", 6)
        self.run_pass()
        self.run_pass(10)
        text = self.everything()
        self.assertNotIn(FakeDoorServer.KEY, text)
        self.assertIn("refused", text)

    def test_work_items_flow_through_the_adapters_work_client(self):
        self.write_mapping()
        self.wire(work_items=True)
        self.add_worker("api-w1", issue=5)
        self.say("api-orch", "question", "Which table?", 6)
        self.run_pass()
        self.run_pass()
        tasks = list(self.door.tasks.values())
        self.assertGreaterEqual(len(tasks), 1, self.door.log)   # one per assignment the world holds
        self.assertEqual(len(tasks), self.door.count("work_put", "http"))
        for task in tasks:
            self.assertIn(task["state"], ("going", "paused", "stuck", "waiting"))
            self.assertNotIn("serves", task, "a field the mapping does not name is not sent")
            self.assertTrue(task["kind"])
        self.run_pass()
        self.run_pass()
        self.assertEqual(len(self.door.tasks), len(tasks), "idempotent: nothing is created twice")
        self.assertEqual(self.door.count("work_put", "http"), len(tasks))
        self.assertNotIn(FakeDoorServer.KEY, self.everything())
        adapter = self.world.engine.external_sync.adapter
        self.assertTrue({"title", "kind", "state", "progress"} <= adapter.work.fields)
        self.assertNotIn("progress_text", adapter.work.fields)

    def test_a_failing_work_sink_never_blocks_the_decision_sync(self):
        self.wire(work_items=True)
        self.add_worker("api-w1", issue=5)
        self.say("api-orch", "question", "Which table?", 6)
        self.door.fail_next("work_put", 400, {"code": "bad", "message": "no"}, count=50)
        self.run_pass()
        self.run_pass()
        self.assertEqual(len(self.door.items), 1, "the decision still went out")
        self.assertEqual(len(self.file_body()["decisions"]), 1)

    def test_loading_the_script_imports_nothing_of_the_adapter(self):
        code = ("import importlib.machinery as m, importlib.util as u, sys\n"
                "l = m.SourceFileLoader('x_sb', %r); s = u.spec_from_loader('x_sb', l); mod = u.module_from_spec(s)\n"
                "l.exec_module(mod)\n"
                "print('external_adapter' in sys.modules, 'mapping' in mod.EXTERNAL_ADAPTERS)\n" % str(SWITCHBOARD))
        done = subprocess.run([sys.executable, "-B", "-c", code], capture_output=True, text=True, timeout=60)
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual(done.stdout.strip(), "False True", "registered by name, loaded by nobody")

    def test_the_loader_is_the_one_the_core_uses(self):
        text = SWITCHBOARD.read_text()
        self.assertIs(sb.load_external_adapter(), sb.load_module("external_adapter"))   # #437: the loaders are generated from HELPER_MODULES, not written as a def each
        self.assertEqual(sb.HELPER_MODULES["load_external_adapter"], "external_adapter")
        self.assertNotIn("\nimport external_adapter", text)
        self.assertNotIn("\nfrom external_adapter", text)


# ---------------------------------------------------------------- work items from worker assignments

class FakeWorkSink(sb.work_sync.WorkSink):
    interval = 60

    def __init__(self):
        self.calls, self.down, self.defer = [], False, None

    def _do(self, *call):
        if self.down:
            raise ConnectionError("the sink is down")
        self.calls.append(call)

    def put(self, work_id, title, **fields):
        self._do("put", work_id, title, fields)

    def patch(self, work_id, **fields):
        if self.defer:
            return {"sent": False, "deferred": True, "due_in": self.defer}
        self._do("patch", work_id, fields)

    def finish(self, work_id, end, summary, **fields):
        self._do("finish", work_id, end, summary)

    def kinds(self):
        return [c[0] for c in self.calls]


class FakeWorkHost(sb.work_sync.Host):
    def __init__(self):
        self.agent_list, self.report_list, self.link_table, self.events = [], [], {}, []

    def agents(self):
        return list(self.agent_list)

    def reports(self):
        return list(self.report_list)

    def title_of(self, repo, issue):
        return "The ask %s#%d" % (repo.split("/")[1], issue)

    def links(self):
        return self.link_table

    def audit(self, event, subject, detail):
        self.events.append((event, subject, detail))


def worker(name="w1", issue=2, repo="acme/api", status="idle", **more):
    return dict({"name": name, "role": "coder", "reports_to": "boss", "repo": repo, "issue": issue, "status": status,
                 "intent": None}, **more)


def report(state, text="", at=1, sender="w1", issue=2):
    return {"sender": sender, "issue": issue, "repo": "acme/api", "state": state, "text": text, "at": at}


class TestWorkItemRules(unittest.TestCase):
    ws = sb.work_sync

    def test_the_key_and_the_item_id_are_stable_and_per_assignment(self):
        a = self.ws.work_id_of(self.ws.assignment_key("w1", "acme/api", 2))
        self.assertEqual(a, self.ws.work_id_of(self.ws.assignment_key("w1", "acme/api", 2)))
        self.assertEqual(len({a, self.ws.work_id_of(self.ws.assignment_key("w1", "acme/api", 3)),
                              self.ws.work_id_of(self.ws.assignment_key("w2", "acme/api", 2)),
                              self.ws.work_id_of(self.ws.assignment_key("w1", "acme/web", 2))}), 4)

    def test_the_state_of_an_assignment(self):
        cases = [("idle", [], ("queued", None)), ("working", [], ("running", None)),
                 ("working", [report("question", "which?")], ("running", None)),
                 ("idle", [report("question", "which?")], ("awaiting", None)),
                 ("idle", [report("blocked", "stuck")], ("blocked", None)),
                 ("blocked", [], ("blocked", None)), ("idle", [report("working", "on it")], ("awaiting", None)),
                 ("idle", [report("paused", "later")], ("awaiting", None)),
                 ("idle", [report("working", "x", 1), report("done", "shipped", 2)], ("done", "done")),
                 ("working", [report("failed", "broke")], ("failed", "failed")),
                 ("idle", [report("withdrawn", "moot")], ("cancelled", "cancelled")),
                 ("idle", [report("done", "old", 1), report("working", "again", 2)], ("awaiting", None))]
        for status, mine, want in cases:
            with self.subTest(status=status, reports=[r["state"] for r in mine]):
                state, end, _ = self.ws.state_of(status, mine)
                self.assertEqual((state, end), want)
        self.assertEqual(self.ws.state_of("idle", [report("question", "which table?")])[2], "which table?")

    def test_serves_is_the_outside_item_id_when_the_ask_is_linked_else_the_issue_ref(self):
        links = {"k": {"repo": "acme/api", "ask": 2, "external_id": "ext-9"}}
        self.assertEqual(self.ws.serves_of(links, "acme/api", 2), "ext-9")
        self.assertEqual(self.ws.serves_of(links, "acme/api", 3), "acme/api#3")
        self.assertEqual(self.ws.serves_of({}, "acme/api", 2), "acme/api#2")
        self.assertEqual(self.ws.serves_of({"k": dict(links["k"], withdrawn=True)}, "acme/api", 2), "acme/api#2")

    def test_which_agents_are_assignments_and_their_fields(self):
        host = FakeWorkHost()
        agents = [worker("w1"), worker("noissue", issue=None), worker("noboss", reports_to=None),
                  worker("norepo", repo=None), worker("w2", issue=5, intent="Ship the parser. More text.")]
        found = self.ws.assignments(agents, [], host.title_of, {})
        self.assertEqual(sorted(a["agent"] for a in found.values()), ["w1", "w2"])
        by = {a["agent"]: a for a in found.values()}
        self.assertEqual((by["w1"]["title"], by["w1"]["kind"], by["w1"]["state"], by["w1"]["serves"]),
                         ("The ask api#2", "coder", "queued", "acme/api#2"))
        self.assertEqual(by["w2"]["title"], "Ship the parser")


class TestWorkSyncPump(unittest.TestCase):
    def setUp(self):
        self.dir = Path(tempfile.mkdtemp())
        self.addCleanup(shutil.rmtree, str(self.dir), True)
        self.sink, self.host, self.t = FakeWorkSink(), FakeWorkHost(), [1000.0]
        self.settings = {"work_grace_seconds": 600, "work_outbox_alarm_depth": 3, "retry_base_seconds": 5,
                         "retry_max_seconds": 60}
        self.pump = self.make()

    def make(self):
        return sb.work_sync.WorkSync(self.settings, self.dir, self.sink, self.host, lambda: self.t[0])

    def cycle(self, advance=0):
        self.t[0] += advance
        return self.pump.cycle()

    def test_first_sight_is_one_put_and_nothing_more_while_nothing_changes(self):
        self.host.agent_list = [worker()]
        self.cycle()
        self.cycle(100)
        self.assertEqual(self.sink.kinds(), ["put"])
        _, work_id, title, fields = self.sink.calls[0]
        self.assertEqual((title, fields["state"], fields["kind"], fields["serves"]), ("The ask api#2", "queued", "coder", "acme/api#2"))
        self.assertEqual(work_id, sb.work_sync.work_id_of("w1|acme/api|2"))

    def test_a_change_is_patched_once_per_interval_and_the_last_state_wins(self):
        self.host.agent_list = [worker()]
        self.cycle()
        self.host.agent_list = [worker(status="working")]
        self.cycle(10)                                            # inside the interval: held
        self.assertEqual(self.sink.kinds(), ["put"])
        self.host.report_list = [report("question", "which table?")]
        self.host.agent_list = [worker(status="idle")]            # the state moved again: still one write due
        self.cycle(10)
        self.assertEqual(self.sink.kinds(), ["put"])
        self.cycle(50)                                            # the interval has run out
        self.assertEqual(self.sink.kinds(), ["put", "patch"])
        self.assertEqual(self.sink.calls[1][2], {"state": "awaiting", "progress": "which table?"})
        self.cycle(10)
        self.assertEqual(self.sink.kinds(), ["put", "patch"])
        self.host.agent_list = [worker(status="working")]
        self.cycle(61)                                            # and again after another interval
        self.assertEqual(self.sink.kinds(), ["put", "patch", "patch"])

    def test_the_interval_is_the_sinks_and_never_below_a_minute(self):
        self.sink.interval = 5
        self.assertEqual(self.pump.interval, 60)
        self.sink.interval = 300
        self.assertEqual(self.pump.interval, 300)

    def test_an_assignment_that_ends_is_finished_exactly_once(self):
        self.host.agent_list = [worker(status="working")]
        self.cycle()
        self.host.report_list = [report("done", "shipped the parser")]
        self.host.agent_list = [worker(status="idle")]
        self.cycle(1)
        self.assertEqual(self.sink.kinds(), ["put", "finish"])
        self.assertEqual(self.sink.calls[1][2:], ("done", "shipped the parser"))
        for _ in range(3):
            self.cycle(500)
        self.host.agent_list = []
        self.cycle(5000)
        self.assertEqual(self.sink.kinds(), ["put", "finish"], "finished once, never again, not cancelled later")

    def test_a_restart_makes_no_duplicate(self):
        self.host.agent_list = [worker()]
        self.cycle()
        self.pump = self.make()                                   # the daemon restarted: the state file is read again
        self.cycle(100)
        self.assertEqual(self.sink.kinds(), ["put"])
        (self.dir / "work-items.json").unlink()                   # even a lost state file: the same id, the put is idempotent
        self.pump = self.make()
        self.cycle(100)
        self.assertEqual({c[1] for c in self.sink.calls}, {sb.work_sync.work_id_of("w1|acme/api|2")})

    def test_an_agent_that_disappears_is_cancelled_after_the_grace_period(self):
        self.host.agent_list = [worker(status="working")]
        self.cycle()
        self.host.agent_list = []
        self.cycle(100)
        self.cycle(400)
        self.assertEqual(self.sink.kinds(), ["put"])
        self.cycle(200)
        self.assertEqual(self.sink.kinds(), ["put", "finish"])
        self.assertEqual(self.sink.calls[1][2], "cancelled")

    def test_a_sink_that_is_down_never_raises_and_drains_when_it_is_back(self):
        self.sink.down = True
        self.host.agent_list = [worker(), worker("w2", issue=3)]
        status = self.cycle()
        self.assertEqual((status["open"], status["outbox"], status["errors"]), (2, 2, 2))
        self.assertIn("down", status["error"])
        self.assertEqual(self.sink.calls, [])
        self.cycle(1)                                             # inside the backoff: not tried
        self.assertEqual(len([e for e in self.host.events if e[0] == "work.failed"]), 2)
        self.sink.down = False
        status = self.cycle(10)
        self.assertEqual((status["outbox"], status["errors"]), (0, 0))
        self.assertEqual(self.sink.kinds(), ["put", "put"])

    def test_a_deep_outbox_is_an_alarm_and_nothing_is_dropped(self):
        self.sink.down = True
        self.host.agent_list = [worker("w%d" % n, issue=n + 1) for n in range(5)]
        status = self.cycle()
        self.assertTrue(status["alarm"])
        self.assertEqual(status["outbox"], 5)

    def test_a_deferred_patch_is_kept_and_tried_later(self):
        self.host.agent_list = [worker()]
        self.cycle()
        self.sink.defer = 30
        self.host.agent_list = [worker(status="working")]
        self.cycle(100)
        self.assertEqual(self.sink.kinds(), ["put"])
        self.sink.defer = None
        self.cycle(10)                                            # inside the deferral
        self.assertEqual(self.sink.kinds(), ["put"])
        self.cycle(30)
        self.assertEqual(self.sink.kinds(), ["put", "patch"])

    def test_two_assignments_for_one_agent_are_two_items(self):
        self.host.agent_list = [worker(issue=2, status="working")]
        self.cycle()
        self.host.agent_list = [worker(issue=3, status="working")]   # reassigned to another ask
        self.cycle(1)
        ids = [c[1] for c in self.sink.calls if c[0] == "put"]
        self.assertEqual(len(set(ids)), 2)
        self.cycle(700)                                           # the first is no longer held: cancelled
        self.assertEqual([c[2] for c in self.sink.calls if c[0] == "finish"], ["cancelled"])

    def test_the_audit_names_each_write_and_holds_no_secret(self):
        self.host.agent_list = [worker()]
        self.host.report_list = [report("question", "use Bearer abcdef123456 or sk-abcdefghij1234?")]
        self.cycle()
        self.assertEqual([e[0] for e in self.host.events], ["work.put"])
        self.assertNotIn("abcdef123456", json.dumps(self.sink.calls))
        self.assertNotIn("abcdef123456", (self.dir / "work-items.json").read_text())


class TestWorkItemsThroughTheDaemon(ExternalWorld):
    def setUp(self):
        super().setUp()
        self.sink = FakeWorkSink()
        self.fake.work = self.sink

    def test_off_means_the_sink_is_never_touched(self):
        self.turn_on()
        self.run_pass()
        self.run_pass()
        self.assertEqual(self.sink.calls, [])
        self.assertNotIn("work items", self.cmd("you", "status")["out"])

    def test_on_a_worker_assignment_becomes_one_item_linked_to_its_ask_and_status_says_so(self):
        self.gh.issue(API, 2, "Which database?", labels=["me:awaiting-cos"])
        self.turn_on(work_items=True)
        self.run_pass()
        self.run_pass()
        puts = [c for c in self.sink.calls if c[0] == "put"]
        self.assertEqual(len(puts), 3, [c[1] for c in puts])   # the three coders of the world, each holding an issue
        mine = [c for c in puts if c[3]["serves"] == "ext-1"]
        self.assertEqual(len(mine), 1, "the item of the api worker on issue 2 serves the outside item of the decision on it")
        self.assertEqual(sorted(c[3]["serves"] for c in puts if c[3]["serves"] != "ext-1"), ["acme/web#2", "acme/web#3"])
        self.assertIn("work items  3 open, last write", self.cmd("you", "status")["out"])

    def test_without_a_work_sink_it_is_a_no_op(self):
        del self.fake.work
        self.turn_on(work_items=True)
        self.run_pass()
        self.assertEqual(self.sink.calls, [])


class PermanentRefusal(Exception):
    permanent = True


class Unavailable(Exception):
    permanent = False
    retry_after = 3


class PickyExternal(FakeExternal):
    """A fake that refuses chosen operations: `refuse[op]` is the exception to raise instead of applying it."""

    def __init__(self):
        super().__init__()
        self.refuse, self.seen = {}, []

    def push(self, operation, idempotency_key):
        self.seen.append(operation)
        if operation["op"] in self.refuse and self.up:
            self.calls.append((operation["op"], operation["key"], idempotency_key))
            raise self.refuse[operation["op"]]
        return super().push(operation, idempotency_key)


class TestSyncSentBack(ExternalWorld):
    """An item the outside system sent back for clarification stays open outside while the agent revises."""

    def setUp(self):
        super().setUp()
        self.fake = PickyExternal()

    def links(self):
        return json.loads((self.world.state / "external-links.json").read_text())["links"]

    def worker_question(self):
        self.turn_on()
        self.say("api-coder", "question", "Which table should hold the totals?", 6)
        self.run_pass()
        return self.ext_of("report")

    def orchestrator_question(self):
        self.turn_on()
        self.say("api-orch", "question", "Which table should hold the totals?", 6)
        self.run_pass()
        return self.ext_of("report")

    def clarify(self, ext, eid=None, by="owner's agent"):
        self.event(ext, kind="clarify", by=by, text="which environment is this for?", eid=eid)

    def check_kept_open(self, ext, agent):
        self.run_pass()
        self.run_pass()
        self.assertTrue([t for t in self.notes_to(agent) if "which environment is this for?" in t])
        self.assertEqual([d["kind"] for d in self.file_body()["decisions"]], [], "the note answered it here")
        self.assertEqual(self.fake.items[ext]["state"], "open", "and the outside item stays open")
        (link,) = self.links().values()
        self.assertIn("sent_back_at", link)
        self.assertEqual(link["clarification"], "which environment is this for?")
        self.assertNotIn("withdraw", [c[0] for c in self.fake.calls])

    def test_a_workers_report_clarified_is_kept_open_outside_and_a_revision_revises_it(self):
        ext = self.worker_question()
        self.clarify(ext)
        self.check_kept_open(ext, "api-coder")
        self.say("api-coder", "question", "Which table, for production?", 6)
        self.run_pass()
        self.run_pass()
        self.assertEqual(self.fake.items[ext]["revisions"], [1, 2])
        self.assertEqual(len(self.fake.items), 1)
        (link,) = self.links().values()
        self.assertNotIn("sent_back_at", link)
        self.assertEqual(self.fake.items[ext]["state"], "open")

    def test_an_orchestrators_report_clarified_is_kept_open_the_same_way(self):
        ext = self.orchestrator_question()
        self.clarify(ext)
        self.check_kept_open(ext, "api-orch")
        self.say("api-orch", "question", "Which table, for production?", 6)
        self.run_pass()
        self.run_pass()
        self.assertEqual(self.fake.items[ext]["revisions"], [1, 2])

    def test_no_revision_within_the_bound_withdraws_it_with_a_reason_never_silently(self):
        ext = self.worker_question()
        self.clarify(ext)
        self.check_kept_open(ext, "api-coder")
        self.run_pass(sb.decision_core.SENT_BACK_TIMEOUT - 3600)    # not yet
        self.assertEqual(self.fake.items[ext]["state"], "open")
        self.run_pass(7200)
        self.run_pass()
        self.assertEqual(self.fake.items[ext]["state"], "withdrawn")
        (withdraw,) = [o for o in self.fake.seen if o["op"] == "withdraw"]
        self.assertEqual(withdraw["note"], "no revision after clarification")
        self.assertEqual(len(self.audit_events("external.sent_back_expired")), 1)

    def test_a_duplicate_clarify_event_is_not_a_second_note(self):
        ext = self.worker_question()
        eid = self.event(ext, kind="clarify", by="owner's agent", text="which environment is this for?")
        self.run_pass()
        self.event(ext, kind="clarify", by="owner's agent", text="which environment is this for?", eid=eid)
        self.run_pass()
        self.run_pass()
        self.assertEqual(len([t for t in self.notes_to("api-coder") if "which environment is this for?" in t]), 1)
        self.assertEqual(len(self.audit_events("external.clarify")), 1)

    def test_the_sent_back_state_survives_a_restart(self):
        ext = self.worker_question()
        self.clarify(ext)
        self.check_kept_open(ext, "api-coder")
        self.world.engine.external_sync = None            # the daemon restarted: the link table is read again
        self.run_pass()
        self.run_pass()
        self.assertEqual(self.fake.items[ext]["state"], "open")
        (link,) = self.links().values()
        self.assertIn("sent_back_at", link)
        self.say("api-coder", "question", "Which table, for production?", 6)
        self.run_pass()
        self.run_pass()
        self.assertEqual(self.fake.items[ext]["revisions"], [1, 2])


class TestPermanentRefusals(ExternalWorld):
    def setUp(self):
        super().setUp()
        self.fake = PickyExternal()

    def raised(self):
        return [c for c in self.fake.calls if c[0] == "raise"]

    def test_a_permanent_refusal_is_tried_once_audited_once_and_shown_and_withdraws_nothing(self):
        self.turn_on()
        self.fake.refuse["raise"] = PermanentRefusal("422: the body is invalid")
        self.gh.issue(API, 2, "Which database?", labels=["me:awaiting-cos"])
        for _ in range(4):
            self.run_pass(120)
        self.assertEqual(len(self.raised()), 1)
        self.assertEqual(json.loads((self.world.state / "external-outbox.json").read_text())["ops"], [])
        (event,) = self.audit_events("external.permanent_failure")
        self.assertIn("the body is invalid", event["detail"]["error"])
        self.assertIn("1 permanent failure(s)", self.cmd("you", "status")["out"])
        self.assertEqual([d["id"] for d in self.file_body()["decisions"]], ["api#2"], "the local decision stays")
        self.assertEqual(self.fake.items, {})

    def test_an_ordinary_error_and_a_rate_limit_are_retried_with_backoff(self):
        self.turn_on()
        self.fake.refuse["raise"] = ConnectionError("unreachable")
        self.gh.issue(API, 2, "Which database?", labels=["me:awaiting-cos"])
        self.run_pass()
        self.run_pass(1)
        self.assertEqual(len(self.raised()), 1, "inside the backoff")
        self.run_pass(10)
        self.run_pass(30)
        self.assertGreaterEqual(len(self.raised()), 3)
        self.assertEqual(self.audit_events("external.permanent_failure"), [])
        before = len(self.raised())
        self.fake.refuse["raise"] = Unavailable("429: slow down")
        for _ in range(4):
            self.run_pass(120)
        self.assertGreater(len(self.raised()), before)
        self.assertEqual(self.audit_events("external.permanent_failure"), [])
        self.fake.refuse.clear()
        self.run_pass(200)
        self.assertEqual(len(self.fake.items), 1, "and it lands once the other side is back")

    def test_a_later_change_of_the_decision_enqueues_a_fresh_operation(self):
        self.turn_on()
        self.fake.refuse["raise"] = PermanentRefusal("422: invalid")
        self.gh.issue(API, 2, "Which database?", labels=["me:awaiting-cos"])
        for _ in range(3):
            self.run_pass(120)
        self.assertEqual(len(self.raised()), 1)
        self.fake.refuse.clear()
        self.run_pass(120)
        self.assertEqual(len(self.raised()), 1, "nothing changed: still not tried again")
        self.gh.issues[(API, 2)]["title"] = "Which database should it use?"
        self.run_pass(120)
        self.assertEqual(len(self.fake.items), 1)
        self.assertEqual(len(self.raised()), 2)
        self.assertEqual(self.audit_events("external.permanent_failure")[0]["event"], "external.permanent_failure")

    def test_a_refused_withdraw_is_not_looped_and_leaves_it_to_the_inbound_answer(self):
        self.turn_on()
        self.gh.issue(API, 2, "Which database?", labels=["me:awaiting-cos"])
        self.run_pass()
        self.fake.refuse["withdraw"] = PermanentRefusal("409: already decided")
        self.assertEqual(self.cmd("you", "decisions", "resolve", "api#2")["code"], 0)
        for _ in range(4):
            self.run_pass(120)
        self.assertEqual(len([c for c in self.fake.calls if c[0] == "withdraw"]), 1)
        self.assertEqual(len(self.audit_events("external.permanent_failure")), 1)
        self.assertEqual(self.fake.items[self.ext_of("issue")]["state"], "open")


class AlreadyDecidedRefusal(Exception):
    """What the real adapter raises for a 409 "already decided": a permanent refusal that says it is settled outside."""

    permanent = True
    settled_outside = True


class TestSettledOutside(ExternalWorld):
    """Ask #53: an "already decided (or closed)" reply to a revise or withdraw is the other side's answer, not a failure."""

    def setUp(self):
        super().setUp()
        self.fake = PickyExternal()
        self.pulls = 0
        real = self.fake.pull_changes

        def counting(cursor):
            self.pulls += 1
            return real(cursor)
        self.fake.pull_changes = counting

    def links(self):
        return json.loads((self.world.state / "external-links.json").read_text())["links"]

    def count_line(self):
        return self.cmd("you", "status")["out"]

    def open_decision(self):
        self.turn_on()
        self.gh.issue(API, 2, "Which database?", labels=["me:awaiting-cos"])
        self.run_pass()
        return self.ext_of("issue")

    def test_s1_a_withdraw_answered_already_decided_is_settled_outside_and_counts_for_nothing(self):
        self.open_decision()
        self.fake.refuse["withdraw"] = AlreadyDecidedRefusal("409: already decided")
        self.assertEqual(self.cmd("you", "decisions", "resolve", "api#2")["code"], 0)
        for _ in range(3):
            self.run_pass(120)
        self.assertEqual(len([c for c in self.fake.calls if c[0] == "withdraw"]), 1, "not tried again")
        self.assertEqual(len(self.audit_events("external.settled_outside")), 1)
        self.assertEqual(self.audit_events("external.permanent_failure"), [])
        self.assertNotIn("permanent failure", self.count_line())

    def test_s2_a_revise_answered_already_decided_or_closed_is_the_same(self):
        ext = self.open_decision()
        self.fake.refuse["revise"] = AlreadyDecidedRefusal("409: already decided or closed")
        self.gh.issues[(API, 2)]["title"] = "Which database should it use?"
        for _ in range(3):
            self.run_pass(120)
        (event,) = self.audit_events("external.settled_outside")
        self.assertEqual((event["detail"]["op"], event["detail"]["dropped_ops"]), ("revise", 1))
        self.assertEqual(self.audit_events("external.permanent_failure"), [])
        self.assertNotIn("permanent failure", self.count_line())
        (link,) = self.links().values()
        self.assertTrue(link["decided_outside"])
        self.assertNotIn("last_error", link)

    def test_s3_nothing_more_is_queued_for_a_settled_link_and_the_answer_is_pulled_and_applied(self):
        ext = self.open_decision()
        self.fake.refuse["revise"] = AlreadyDecidedRefusal("409: already decided")
        self.gh.issues[(API, 2)]["title"] = "Which database should it use?"
        self.run_pass(120)
        revises = len([c for c in self.fake.calls if c[0] == "revise"])
        self.assertEqual(revises, 1)
        pulls = self.pulls
        self.gh.issues[(API, 2)]["title"] = "Which database should the service use?"   # changes again: still no operation for it
        self.fake.refuse.clear()
        for _ in range(3):
            self.run_pass(120)
        self.assertEqual(len([c for c in self.fake.calls if c[0] in ("revise", "withdraw", "status")]), revises)
        self.assertEqual(json.loads((self.world.state / "external-outbox.json").read_text())["ops"], [])
        self.assertGreater(self.pulls, pulls, "the answer is looked for")
        self.event(ext, kind="answered", by="human")
        self.run_pass(120)
        self.assertEqual(len(self.audit_events("external.answered")), 1, "the answer that was decided outside is applied here")

    def test_s3_the_settle_pulls_on_the_same_cycle(self):
        self.turn_on(poll_seconds=600)   # a long poll: only the settle itself can make the pull happen now
        self.gh.issue(API, 2, "Which database?", labels=["me:awaiting-cos"])
        self.run_pass()
        ext = self.ext_of("issue")
        self.fake.refuse["revise"] = AlreadyDecidedRefusal("409: already decided")
        self.event(ext, kind="answered", by="human")
        self.gh.issues[(API, 2)]["title"] = "Which database should it use?"
        self.run_pass(1)   # one cycle: the flush settles, and the pull of that same cycle takes the answer
        self.assertEqual(len(self.audit_events("external.settled_outside")), 1)
        self.assertEqual(len(self.audit_events("external.answered")), 1)

    def test_s4_a_real_permanent_error_still_counts(self):
        self.turn_on()
        self.fake.refuse["raise"] = PermanentRefusal("400: invalid request")
        self.gh.issue(API, 2, "Which database?", labels=["me:awaiting-cos"])
        for _ in range(3):
            self.run_pass(120)
        self.assertEqual(len(self.audit_events("external.permanent_failure")), 1)
        self.assertEqual(self.audit_events("external.settled_outside"), [])
        self.assertIn("1 permanent failure(s)", self.count_line())

    def test_s6_other_permanent_refusals_are_counted_and_none_is_settled(self):
        for name in ("invalid request", "unknown item", "refused credential"):
            with self.subTest(name=name):
                self.setUp()
                self.turn_on()
                self.fake.refuse["raise"] = PermanentRefusal("4xx: %s" % name)
                self.gh.issue(API, 2, "Which database?", labels=["me:awaiting-cos"])
                self.run_pass(120)
                self.assertEqual((len(self.audit_events("external.permanent_failure")), len(self.audit_events("external.settled_outside"))), (1, 0))

    def test_s5_a_failure_is_cleared_when_its_link_closes_and_a_failed_raise_with_no_link_stays(self):
        ext = self.open_decision()
        self.fake.refuse["revise"] = PermanentRefusal("400: invalid request")
        self.gh.issues[(API, 2)]["title"] = "Which database should it use?"
        self.run_pass(120)
        self.assertIn("1 permanent failure(s)", self.count_line())
        self.fake.refuse.clear()
        self.event(ext, kind="answered", by="human")
        self.run_pass(120)
        self.assertNotIn("permanent failure", self.count_line(), "its link closed: the old failure is not a failure to show")
        self.fake.refuse["raise"] = PermanentRefusal("400: invalid request")
        self.gh.issue(API, 3, "Another one?", labels=["me:awaiting-cos"])
        self.run_pass(120)
        self.run_pass(120)
        self.assertIn("1 permanent failure(s)", self.count_line(), "a failed raise has no link and still counts")

    def test_s5_a_settled_failure_entry_of_the_same_decision_is_cleared(self):
        ext = self.open_decision()
        self.fake.refuse["revise"] = PermanentRefusal("400: invalid request")
        self.gh.issues[(API, 2)]["title"] = "Which database should it use?"
        self.run_pass(120)
        self.assertIn("1 permanent failure(s)", self.count_line())
        self.fake.refuse["withdraw"] = AlreadyDecidedRefusal("409: already decided")
        self.fake.refuse.pop("revise")
        self.assertEqual(self.cmd("you", "decisions", "resolve", "api#2")["code"], 0)
        self.run_pass(120)
        self.run_pass(120)
        self.assertNotIn("permanent failure", self.count_line())

    def test_the_settled_flag_lives_in_the_link_file_and_survives_a_restart(self):
        ext = self.open_decision()
        self.fake.refuse["revise"] = AlreadyDecidedRefusal("409: already decided")
        self.gh.issues[(API, 2)]["title"] = "Which database should it use?"
        self.run_pass(120)
        (link,) = self.links().values()
        self.assertTrue(link["decided_outside"], "written to external-links.json")
        self.world.engine.external_sync = None            # the daemon restarted: the link table is read again
        revises = len([c for c in self.fake.calls if c[0] == "revise"])
        self.fake.refuse.clear()
        self.gh.issues[(API, 2)]["title"] = "Which database should the service use?"
        for _ in range(3):
            self.run_pass(120)
        self.assertEqual(len([c for c in self.fake.calls if c[0] == "revise"]), revises, "still settled after the restart: nothing is revised")
        self.event(ext, kind="answered", by="human")
        self.run_pass(120)
        self.assertEqual(len(self.audit_events("external.answered")), 1)

    def test_an_old_link_file_without_the_flag_keeps_todays_behaviour_and_a_corrupt_one_is_rebuilt(self):
        ext = self.open_decision()
        path = self.world.state / "external-links.json"
        body = json.loads(path.read_text())
        for link in body["links"].values():
            link.pop("decided_outside", None)
        path.write_text(json.dumps(body))
        self.world.engine.external_sync = None
        self.gh.issues[(API, 2)]["title"] = "Which database should it use?"
        self.run_pass(120)
        self.run_pass(120)
        self.assertEqual(self.fake.items[ext]["revisions"], [1, 2], "no flag: the revise goes as it always did")
        path.write_text("{not json")
        self.world.engine.external_sync = None
        self.run_pass(120)
        self.run_pass(120)
        self.assertEqual(len(self.fake.items), 1, "a corrupt file is rebuilt by lookup, never trusted")

    def test_the_settle_sends_nothing_new_and_pulls_once_per_cycle(self):
        self.turn_on(poll_seconds=600)
        self.gh.issue(API, 2, "Which database?", labels=["me:awaiting-cos"])
        self.run_pass()
        self.fake.refuse["revise"] = AlreadyDecidedRefusal("409: already decided")
        self.gh.issues[(API, 2)]["title"] = "Which database should it use?"
        sent = len(self.fake.calls)
        pulls = self.pulls
        self.run_pass(1)
        self.assertEqual(len(self.fake.calls) - sent, 1, "only the revise that was refused: the settle itself sends nothing")
        self.assertEqual(self.pulls - pulls, 1, "one pull on that cycle, not a loop")
        self.run_pass(1)
        self.assertEqual(self.pulls - pulls, 1, "and the long poll applies again after it")

    def test_a_damaged_flag_value_is_never_a_settle_only_the_boolean_true_is(self):
        ext = self.open_decision()
        path = self.world.state / "external-links.json"
        for bad in ("false", "no", 0, 1, [], [1], {}, "true", "yes", None):
            with self.subTest(bad=bad):
                body = json.loads(path.read_text())
                for link in body["links"].values():
                    link["decided_outside"] = bad
                    link["decided_outside_at"] = 5
                path.write_text(json.dumps(body))
                self.world.engine.external_sync = None
                revises = len([c for c in self.fake.calls if c[0] == "revise"])
                self.gh.issues[(API, 2)]["title"] = "Which database should it use %s?" % json.dumps(bad)
                self.run_pass(120)
                self.run_pass(120)
                self.assertGreater(len([c for c in self.fake.calls if c[0] == "revise"]), revises, "not settled: its revise went out")
                (link,) = self.links().values()
                self.assertNotIn("decided_outside", link, "normalised away when the file is loaded")
                self.assertNotIn("settled outside", self.count_line())

    def test_a_settled_link_waiting_for_its_answer_stays_visible_in_status_with_its_age(self):
        ext = self.open_decision()
        self.fake.refuse["revise"] = AlreadyDecidedRefusal("409: already decided")
        self.gh.issues[(API, 2)]["title"] = "Which database should it use?"
        self.run_pass(120)
        self.run_pass(300)
        self.assertRegex(self.count_line(), r"settled outside, waiting for its answer: 1 \(oldest \d+[ms]\)")
        self.assertNotIn("permanent failure", self.count_line())
        self.fake.refuse.clear()
        self.event(ext, kind="answered", by="human")
        self.run_pass(120)
        self.assertNotIn("settled outside", self.count_line(), "the answer was applied: nothing is waiting")

    def test_a_settled_link_that_closes_by_withdrawal_stops_being_counted(self):
        self.open_decision()
        self.fake.refuse["revise"] = AlreadyDecidedRefusal("409: already decided")
        self.gh.issues[(API, 2)]["title"] = "Which database should it use?"
        self.run_pass(120)
        self.assertIn("settled outside, waiting for its answer: 1", self.count_line())
        self.assertEqual(self.cmd("you", "decisions", "resolve", "api#2")["code"], 0)
        self.run_pass(120)
        self.run_pass(120)
        self.assertNotIn("waiting for its answer", self.count_line(), "it closed here: not waiting any more")

    def test_s7_what_is_pushed_for_other_decisions_is_unchanged_after_a_settle(self):
        self.open_decision()
        self.fake.refuse["revise"] = AlreadyDecidedRefusal("409: already decided")
        self.gh.issues[(API, 2)]["title"] = "Which database should it use?"
        self.run_pass(120)
        self.fake.refuse.clear()
        self.gh.issue(API, 3, "Another decision?", labels=["me:awaiting-cos"])
        self.run_pass(120)
        self.assertEqual(len([c for c in self.fake.calls if c[0] == "raise"]), 2, "the new decision is raised once, as before")

    def test_an_already_decided_reply_to_a_raise_has_no_link_to_settle_so_it_stays_a_permanent_refusal_tried_once(self):
        self.turn_on()
        self.fake.refuse["raise"] = AlreadyDecidedRefusal("409: already decided: Bearer abc123secret")
        self.gh.issue(API, 2, "Which database?", labels=["me:awaiting-cos"])
        for _ in range(3):
            self.run_pass(120)
        self.assertEqual(len([c for c in self.fake.calls if c[0] == "raise"]), 1, "not looped")
        self.assertEqual(self.audit_events("external.settled_outside"), [])
        (event,) = self.audit_events("external.permanent_failure")
        self.assertNotIn("abc123secret", json.dumps(event), "outside text is redacted")

    def test_the_settled_audit_reason_is_redacted(self):
        ext = self.open_decision()
        self.fake.refuse["revise"] = AlreadyDecidedRefusal("409: already decided: Bearer abc123secret")
        self.gh.issues[(API, 2)]["title"] = "Which database should it use?"
        self.run_pass(120)
        (event,) = self.audit_events("external.settled_outside")
        self.assertNotIn("abc123secret", json.dumps(event))

    def test_the_real_adapter_error_says_it_is_settled_outside_and_only_that_one(self):
        self.assertTrue(EA.AlreadyDecided.settled_outside)
        self.assertFalse(EA.AdapterError.settled_outside)
        for cls in (EA.Conflict, EA.InvalidRequest, EA.NotFound, EA.CredentialError, EA.DisabledError, EA.Unsupported, EA.MappingError):
            self.assertFalse(getattr(cls, "settled_outside", False), cls.__name__)


LINK_HARNESS = r"""
import * as d from "%(url)s";
const now = Date.parse("2026-03-04T12:00:00Z");
const iso = (ms) => new Date(ms).toISOString();
const dec = (id, extra) => ({ id, tier: "human", kind: "issue", title: "t " + id, headline: "t " + id, since: iso(now - 60000), ...extra });
const list = [
  dec("web#5", { repo: "acme/web", ask: 5 }),
  dec("rep#6", { repo: "acme/web", ask: "6", kind: "report" }),
  dec("batch#7", { repo: "acme/api", ask: 7, rows: [{ text: "a: b" }] }),
  dec("pr:web#9", { repo: "acme/web", kind: "notice", number: 9, state: "open" }),
  dec("untagged", { kind: "report" }),
  dec("norepo", { ask: 3 }),
  dec("nonum", { repo: "acme/web", ask: null }),
  dec("nonumnotice", { repo: "acme/web", kind: "notice" }),
];
const bad = ["acme/web/../x", "../web", "a b/c", "acme/web\x1b", "acme/web#1", "/web", "acme/", "acme//web", "https://evil/x", "acme/web?q=1", ".", "a/.."];
const evil = "\x1b]8;;https://evil.example\x07click\x1b]8;;\x07 \x9b31m \x1b\\";
const snap = { status: "ok", decisions: list, errors: [], ageMs: 0 };
const view = d.buildView(snap, now, 34, d.viewOf({ FLEET_SWITCHBOARD_ROLE: "chief-of-staff" }));
const plain = d.viewLines(view);
const entries = view.sections.flatMap((s) => s.groups.flatMap((g) => g.entries));
const withEvilTitle = d.entryOf(dec("web#5", { repo: "acme/web", ask: 5, title: evil, headline: evil }), now);
console.log(JSON.stringify({
  urls: Object.fromEntries(list.map((x) => [x.id, d.urlOf(x)])),
  badRepos: bad.map((r) => d.urlOf({ id: "x", repo: r, ask: 1, title: "t" })),
  badNumbers: [0, -1, 1.5, "1x", "01", "", null, undefined, "1 ", 1e12, [1], { n: 1 }].map((n) => d.urlOf({ id: "x", repo: "acme/web", ask: n, title: "t" })),
  badNoticeNumbers: [0, "9/../x", null].map((n) => d.urlOf({ id: "x", repo: "acme/web", kind: "notice", number: n, title: "t" })),
  entryUrls: Object.fromEntries(entries.map((e) => [e.key, "url" in e ? e.url : "ABSENT"])),
  plain,
  stripped: d.stripControls(evil),
  safe: [d.safeUrl("https://github.com/acme/web/issues/5"), d.safeUrl("https://github.com/acme/web/pull/9"),
         d.safeUrl("https://github.com/acme/web/issues/5\x07"), d.safeUrl("https://github.com/acme/web/issues/5\x1b]8;;"),
         d.safeUrl("http://github.com/acme/web/issues/5"), d.safeUrl("https://evil.example/acme/web/issues/5"),
         d.safeUrl("https://github.com/acme/web/issues/5 "), d.safeUrl(null), d.safeUrl(5)],
  evilEntry: withEvilTitle,
  widths: plain.map((l) => l.length),
}));
"""


@unittest.skipUnless(NODE, "node is not installed: the decisions plugin tests need it (skipped, not passed)")
class TestDecisionsPanelLinks(Base):
    """Issue 66: a row links to its issue or PR (the TUI draws it as an OSC 8 link and copies it on click)."""

    def setUp(self):
        super().setUp()
        script = self.home / "link-harness.mjs"
        script.write_text(LINK_HARNESS % {"url": (DECISIONS_PLUGIN / "decisions.mjs").resolve().as_uri()})
        done = subprocess.run([NODE, str(script)], capture_output=True, text=True, timeout=60)
        self.assertEqual(done.returncode, 0, done.stderr)
        self.r = json.loads(done.stdout.strip().splitlines()[-1])

    def test_url_of_every_kind(self):
        u = self.r["urls"]
        self.assertEqual(u["web#5"], "https://github.com/acme/web/issues/5")      # an issue decision
        self.assertEqual(u["rep#6"], "https://github.com/acme/web/issues/6")      # a report with an issue number (string)
        self.assertEqual(u["batch#7"], "https://github.com/acme/api/issues/7")    # a batch
        self.assertEqual(u["pr:web#9"], "https://github.com/acme/web/pull/9")     # a heads-up: its PR

    def test_a_row_without_a_repo_or_a_number_has_no_link_and_is_otherwise_unchanged(self):
        u = self.r["urls"]
        for key in ("untagged", "norepo", "nonum", "nonumnotice"):
            self.assertIsNone(u[key], key)
        for key in ("untagged", "norepo", "nonum", "nonumnotice"):
            self.assertEqual(self.r["entryUrls"].get(key, "ABSENT"), "ABSENT", key)  # no url key at all
        self.assertEqual(self.r["entryUrls"]["web#5"], "https://github.com/acme/web/issues/5")

    def test_a_repo_or_number_that_is_not_strictly_valid_gives_no_url(self):
        self.assertEqual(self.r["badRepos"], [None] * len(self.r["badRepos"]))
        self.assertEqual(self.r["badNumbers"], [None] * len(self.r["badNumbers"]))
        self.assertEqual(self.r["badNoticeNumbers"], [None, None, None])

    def test_the_plain_text_view_and_its_width_are_unchanged_by_links(self):
        text = "\n".join(self.r["plain"])
        self.assertNotIn("\x1b", text)
        self.assertNotIn("github.com", text)  # the link is an attribute the terminal gets, never visible text
        self.assertTrue(all(w <= 34 for w in self.r["widths"]))

    def test_a_malicious_title_cannot_reach_the_link_or_an_escape(self):
        entry = self.r["evilEntry"]
        self.assertEqual(entry["url"], "https://github.com/acme/web/issues/5")  # from repo and ask only
        self.assertNotIn("evil", entry["url"])
        self.assertEqual(self.r["stripped"], "]8;;https://evil.example" + "click]8;; " + "31m " + "\\")
        self.assertEqual(" ".join(entry["lines"]).count("\x1b"), 0)  # and none is drawn from a title
        for control in ("\x1b", "\x07", "\x9b", "\x9d", "\x9c"):
            self.assertNotIn(control, self.r["stripped"])

    def test_only_a_url_the_panel_could_have_built_may_be_given_to_the_terminal(self):
        good1, good2, *rest = self.r["safe"]
        self.assertEqual((good1, good2), ("https://github.com/acme/web/issues/5", "https://github.com/acme/web/pull/9"))
        self.assertEqual(rest, [None] * len(rest))




class TestPlanReviewCommands(LedgerBase):
    """#109 part 2, slice R2: `plan review start|verdict|respond|status|abandon`, the ledger records and the lane launching (fake herdr)."""

    PLAN2 = LEDGER_PLAN.replace("Commissioning works.", "Commissioning works, with a rollback section.")

    def setUp(self):
        super().setUp()
        self.work = self.home / "work"
        self.work.mkdir()
        self.world.add_agent("orch", fleet={"role": "orchestrator"})
        self.world.add_agent("cos", fleet={"role": "chief-of-staff"})
        self.plan_issue2 = {"number": 8, "state": "open", "title": "plan v2", "body": self.PLAN2, "updated_at": "2026-01-01T00:00:00Z",
                            "parent_issue_url": "https://api.github.com/repos/acme/app/issues/7"}   # a plan issue under the ask #7
        self.enable()

    def enable(self, **more):
        cfg = {"enabled": True, "dir": str(self.work), "workspace": "w1", "max_parallel": 6}
        cfg.update(more)
        self.extra_config = {"plan_review": cfg}
        self.configure()

    def route(self, argv, **kwargs):
        if argv[0] == FAKE_GH and re.search(r"/issues/(8|9|1[0-9])$", argv[2]):
            return subprocess.CompletedProcess(argv, 0, json.dumps(self.plan_issue2), "")
        return super().route(argv, **kwargs)

    def review(self, who, *argv, stdin=None):
        os.environ["HERDR_WORKSPACE_ID"] = "w1"
        if who is None:
            os.environ.pop("HERDR_PANE_ID", None)
        else:
            os.environ["HERDR_PANE_ID"] = self.world.panes.get(who) or who
        with captured() as (out, err), mock.patch.object(sb, "owner_terminal_problem", lambda *a, **k: None), \
                mock.patch.object(sys, "stdin", io.StringIO(stdin or "")):
            code = sb.main(["plan", "review", *argv], runner=self.route, now=self.world.clock.now,
                           wait=lambda sock, seconds: False, socket_call=self.world.herdr.socket)
        return code, out.getvalue(), err.getvalue()

    def start(self, who="orch", source="acme/app#7", ask="acme/app#7", *more):
        code, out, err = self.review(who, "start", source, "--ask", ask, "--json", *more)
        return code, (json.loads(out) if out.strip().startswith("{") else None), err

    def block(self, lane, plan_hash, verdict="approve", lines=()):
        return "```verdict\nlane: %s\nplan_hash: %s\nverdict: %s\n%s\n```\n" % (lane, plan_hash, verdict, "\n".join(lines))

    def lane_verdict(self, started, lane, verdict="approve", lines=(), who=None):
        pane = next(p for l, n, p in started["launched"] if l == lane)
        return self.review(who or pane, "verdict", started["review"], "--lane", lane, "--json", stdin=self.block(lane, started["plan_hash"], verdict, lines))

    def kinds(self, kind=None):
        rows = [e for e in self.ledger() if e["kind"] in sb.plan_ledger.REVIEW_KINDS]
        return [e for e in rows if kind is None or e["kind"] == kind]

    def test_it_is_off_by_default_and_refuses_every_command(self):
        self.extra_config = None
        self.configure()
        for argv in (("start", "acme/app#7", "--ask", "acme/app#7"), ("status", "rv1"), ("abandon", "rv1", "--reason", "x" * 30)):
            code, out, err = self.review("orch", *argv)
            self.assertEqual(code, 2)
            self.assertIn("plan review engine is off", err)
        self.assertEqual(self.kinds(), [])

    def test_start_opens_a_full_review_for_an_ask_launches_the_lanes_and_records_them(self):
        code, got, err = self.start()
        self.assertEqual(code, 0, err)
        self.assertEqual((got["tier"], got["lanes"]), ("full", ["L1", "L2", "L3", "L4", "L5", "L6"]))
        self.assertEqual(len(got["launched"]), 6)
        (round_entry,) = self.kinds("round")
        self.assertEqual((round_entry["round"], round_entry["closing"], round_entry["lineage"], round_entry["by"]),
                         (1, False, "acme/app#7", "orch"))
        self.assertEqual(round_entry["plan_hash"], got["plan_hash"])
        sessions = {e["lane"]: e["session"] for e in self.kinds("lane_session")}
        self.assertEqual(sorted(sessions), got["lanes"])
        self.assertEqual(sessions["L2"], "planrev-%s-l2-r1" % got["review"])
        self.assertEqual(sb.plan_ledger.read_ledger(self.world.state)[1], None, "the chain holds")
        self.assertEqual([e for e in self.ledger() if e["kind"] == "consensus"], [], "this slice never writes a consensus")

    def test_the_lane_brief_carries_the_snapshot_the_ask_and_the_untrusted_warning(self):
        seen = []
        real = sb.launch_agent

        def spy(engine, name, agent, *a, **k):
            seen.append((name, agent, k.get("brief")))
            return real(engine, name, agent, *a, **k)
        with mock.patch.object(sb, "launch_agent", spy):
            code, got, err = self.start()
        self.assertEqual(code, 0, err)
        self.assertEqual({a for _, a, _ in seen}, {"plan-reviewer"})
        brief = dict((n.rsplit("-", 2)[1], b) for n, _, b in seen)["l2"]
        for needle in ("lane L2", "UNTRUSTED", got["plan_hash"], "Commissioning works", "bad build that passes", "plan_hash: " + got["plan_hash"]):
            self.assertIn(needle, brief)

    def test_only_a_person_an_orchestrator_or_the_chief_of_staff_may_start_and_a_failing_plan_is_refused(self):
