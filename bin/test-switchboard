class TestDecorationIsAFact(ActingCase):
    def test_a_restart_classifies_once_more_and_the_transcript_stops_a_second_delivery(self):
        self.work()
        self.say("Also, the billing export?")
        self.passes(3)
        self.assertEqual(len(self.decorations()), 1)
        self.restart()
        self.passes(3)
        self.assertEqual(len(self.jev.calls), 1, "the new process classified the newest message once")
        self.assertEqual(len(self.decorations()), 1, "the key is in the transcript: never delivered again")
        self.assertEqual(len(self.world.v2.writes), 1)

    def test_the_same_state_gives_the_same_key_after_a_restart(self):
        self.work()
        self.say("Also, the billing export?")
        self.passes(1)
        first = [f.key for f in self.world.engine.collect_facts()[0]]
        self.restart()
        self.world.engine.discover(self.world.clock.now())
        self.world.engine.run_pass()
        second = [f.key for f in self.world.engine.collect_facts()[0]]
        self.assertEqual(first, second)
        self.assertEqual(len(first), 1)

    def test_the_crash_after_send_fault_does_not_double_deliver(self):
        self.work()
        self.say("Also, the billing export?")
        os.environ[sb.FAULT_ENV] = "crash-after-send"
        with self.assertRaises(sb.SimulatedCrash):
            self.world.engine.run_pass()
        os.environ[sb.FAULT_ENV] = ""
        self.restart()
        self.passes(3)
        self.assertEqual(len(self.decorations()), 1)

    def test_a_newer_message_replaces_a_decoration_nobody_has_received(self):
        self.work()
        self.say("Also, the billing export?")
        engine = self.world.engine
        engine.run_pass()
        source = sb.foreground_source(engine)
        first = [f.key for f in source()]
        self.world.tick(5)
        self.answer = "current"
        self.say("Never mind, how is it going?")
        self.assertEqual(source(), [], "the first message is no longer your newest")
        self.assertEqual(len(first), 1)

    def test_a_handoff_decoration_lapses_when_the_chief_of_staff_has_stopped_working(self):
        self.work(lasts=20, steps=2)
        self.say("Also, the billing export?")
        engine = self.world.engine
        engine.run_pass()
        self.assertEqual(len(sb.foreground_source(engine)()), 1)
        self.world.tick(30)
        engine.discover(self.world.clock.now())
        self.assertEqual(sb.foreground_source(engine)(), [], "idle: nothing is left to hand off")

    def test_a_decoration_lapses_with_the_engagement_window(self):
        self.work(lasts=2000, steps=2)
        self.say("Also, the billing export?")
        engine = self.world.engine
        engine.run_pass()
        self.assertEqual(len(sb.foreground_source(engine)()), 1)
        self.world.tick(11 * 60)
        engine.discover(self.world.clock.now())
        self.assertEqual(sb.foreground_source(engine)(), [])
        self.assertEqual(sb.foreground_source(engine).decisions, {})

    def test_it_is_a_batch_free_fact_for_the_chief_of_staff(self):
        self.work()
        self.say("Also, the billing export?")
        self.world.engine.run_pass()
        (found,) = sb.foreground_source(self.world.engine)()
        self.assertEqual((found.kind, found.recipient, found.batch), (sb.DECORATION, "cos", False))
        self.assertTrue(found.key.startswith("decoration:%s:msg_" % self.cos))

    def test_the_source_is_registered_and_the_engine_has_no_second_way_to_write(self):
        self.assertIsNotNone(sb.foreground_source(self.world.engine))
        source = SWITCHBOARD.read_text()
        section = source.split("# PR 8: foreground and background", 1)[1].split("# Worker events, reminders", 1)[0]
        for forbidden in ("v2.synthetic(", "v2.prompt(", "herdr.agent_prompt"):
            self.assertNotIn(forbidden, section.split("def launch_agent")[0], forbidden)
        self.assertNotIn(".synthetic(", section)


class HandoffCase(IntentCase):
    BRIEF = ("Done so far: found that the staging config drops the project binding\n"
             "Next steps:\n1. patch the binding\n2. redeploy staging\nWatch out for: production is untouched\n")

    def setUp(self):
        super().setUp()
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "gh": FAKE_GH, "intent_repo": FAKE_REPO})
        self.cos = self.world.add_agent("cos", fleet={"role": "chief-of-staff"})
        self.work = self.home / "work"
        self.work.mkdir()
        self.order = []
        os.environ["HERDR_PANE_ID"] = self.world.panes["cos"]

    def route(self, argv, **kwargs):
        if argv[0] == FAKE_GH:
            self.order.append("gh")
            return self.gh(argv, **kwargs)
        if argv[0] == FAKE_OPENCODE and argv[2:3] == ["session.create"]:
            self.order.append("session.create")
        return self.world.route(argv, **kwargs)

    def main(self, brief=None, *extra, issue="2"):
        path = self.home / "brief.md"
        path.write_text(self.BRIEF if brief is None else brief)
        with captured() as (out, err):
            code = sb.main(["handoff", "--issue", issue, "--brief-file", str(path), "--dir", str(self.work),
                            "--workspace", "w1"] + list(extra), runner=self.route, now=self.world.clock.now,
                           socket_call=self.world.herdr.socket)
        return code, out.getvalue(), err.getvalue()

    def comments(self):
        return self.gh.__dict__.get("comments", [])

    def subagents(self):
        return [s for s in self.world.v2.sessions.values()
                if (s["metadata"].get("fleet") or {}).get("role") == "cos-subagent"]

    def assertNothingWritten(self):
        self.assertEqual(self.comments(), [])
        self.assertEqual(self.subagents(), [])
        self.assertEqual([c for c in self.gh.calls if "--method" in c], [])


class TestBriefParsing(unittest.TestCase):
    def test_the_sections_are_read_with_or_without_markup(self):
        parsed = sb.parse_brief("## Handoff: ask 2\nGoal: retyped, ignored\n**Done so far:** a\nb\n"
                                "## Next steps\n1. c\n- Watch out for: d\n")
        self.assertEqual(parsed, {"goal": "retyped, ignored", "done so far": "a\nb", "next steps": "1. c",
                                  "watch out for": "d"})

    def test_a_brief_without_done_so_far_or_next_steps_is_refused(self):
        for text, missing in (("Next steps: x\n", "Done so far"), ("Done so far: x\n", "Next steps"),
                              ("Watch out for: x\n", "Done so far and no Next steps"),
                              ("Done so far:\nNext steps: x\n", "Done so far")):
            with self.subTest(brief=text), self.assertRaises(sb.HandoffRefused) as caught:
                sb.parse_brief(text)
            self.assertIn(missing, str(caught.exception))

    def test_words_outside_the_sections_are_refused_not_dropped(self):
        with self.assertRaises(sb.HandoffRefused) as caught:
            sb.parse_brief("Please take over.\nDone so far: a\nNext steps: b\n")
        self.assertIn("outside its sections", str(caught.exception))

    def test_an_oversized_brief_is_refused(self):
        with self.assertRaises(sb.HandoffRefused):
            sb.parse_brief("Done so far: " + "x" * sb.BRIEF_LIMIT + "\nNext steps: b")

    def test_the_markdown_is_the_docs_with_goal_from_the_ask(self):
        issue = sb.IssueIntent(615, "open", "t", "Fix the agents", "both answer", None, False)
        text = sb.handoff_markdown(issue, {"goal": "mine", "done so far": "a", "next steps": "b"})
        self.assertEqual(text, "## Handoff: ask 615\nGoal: Fix the agents (Done when: both answer)\n"
                               "Done so far: a\nNext steps: b\nWatch out for: nothing noted")
        bare = sb.IssueIntent(7, "open", "t", None, None, None, False)
        self.assertIn("Goal: no intent recorded\n", sb.handoff_markdown(bare, {"done so far": "a", "next steps": "b"}))


class TestHandoff(HandoffCase):
    def test_it_posts_the_brief_once_launches_the_subagent_and_prints_one_json_line(self):
        code, out, err = self.main()
        self.assertEqual(code, 0, err)
        (comment,) = self.comments()
        self.assertEqual(comment["issue"], 2)
        self.assertEqual(comment["body"], "## Handoff: ask 2\nGoal: Fix the agents (Done when: both answer)\n"
                         "Done so far: found that the staging config drops the project binding\n"
                         "Next steps: 1. patch the binding\n2. redeploy staging\nWatch out for: production is untouched")
        (posted,) = [c for c in self.gh.calls if "--method" in c]
        self.assertEqual(posted, [FAKE_GH, "api", "repos/%s/issues/2/comments" % FAKE_REPO,
                                  "--method", "POST", "--input", "-"])
        (line,) = out.splitlines()
        done = json.loads(line)
        self.assertEqual((done["name"], done["role"], done["reports_to"], done["issue"]), ("cos-2", "cos-subagent", "cos", 2))
        self.assertTrue(done["comment"].startswith("https://"))
        self.assertTrue({"session", "pane", "tab"} <= set(done))

    def test_the_subagent_is_a_fleet_agent_for_the_ask_reporting_to_the_caller_in_its_own_tab(self):
        _, out, _ = self.main()
        done = json.loads(out)
        session = self.world.v2.sessions[done["session"]]
        self.assertEqual(session["metadata"], {"fleet": {"name": "cos-2", "role": "cos-subagent",
                                                         "reports_to": "cos", "issue": 2}})
        self.assertEqual((session["agent"], session["directory"]), ("cos-subagent", str(self.work)))
        method, params = self.world.herdr.socket_calls[0]
        self.assertEqual((method, params["workspace_id"]), ("layout.apply", "w1"))
        self.assertEqual(params["root"]["command"], [FAKE_OPENCODE, "-s", done["session"]])
        self.assertNotIn("focus", json.dumps(self.world.herdr.socket_calls).lower())

    def test_the_subagent_is_briefed_with_the_brief_and_told_how_to_report(self):
        _, out, _ = self.main()
        session = self.world.v2.sessions[json.loads(out)["session"]]
        (prompt,) = [m for m in session["messages"] if m["type"] == "user"]
        self.assertEqual(prompt["metadata"], {"fleet": {"from": "switchboard", "brief": True}})
        self.assertIn("## Handoff: ask 2\nGoal: Fix the agents (Done when: both answer)", prompt["text"])
        self.assertIn('fleet-switchboard send cos --issue 2 "..."', prompt["text"])

    def test_the_record_comes_before_the_launch_and_every_write_is_audited(self):
        self.main()
        self.assertLess(self.order.index("gh"), self.order.index("session.create"))
        events = [(e["event"], e["phase"]) for e in self.world.audit() if e["event"].startswith(("github.", "v2.session"))]
        self.assertEqual(events[:2], [("github.comment", "intent"), ("github.comment", "result")])
        comment = [e for e in self.world.audit() if e["event"] == "github.comment"]
        self.assertEqual(comment[0]["detail"]["issue"], 2)
        self.assertNotIn("Next steps", json.dumps(comment), "the audit holds the size, not the brief")

    def test_nothing_is_typed(self):
        self.main()
        self.assertEqual(self.world.herdr.typing_attempts, [])
        for argv in self.world.herdr.calls:
            self.assertIn(argv[1:3], HERDR_ALLOWED)

    def test_the_goal_the_chief_of_staff_wrote_is_replaced_and_it_is_told(self):
        code, out, err = self.main("Goal: something else entirely\n" + self.BRIEF)
        self.assertEqual(code, 0)
        self.assertNotIn("something else entirely", self.comments()[0]["body"])
        self.assertIn("Goal line in your brief was replaced", err)
        self.assertNotIn("replaced_goal", out)

    def test_each_refusal_writes_nothing_at_all(self):
        refusals = [
            ("Next steps: x\n", {}, 2, "Done so far"),
            ("Done so far: x\n", {}, 2, "Next steps"),
            ("hello\n" + HandoffCase.BRIEF, {}, 2, "outside its sections"),
            (None, {"issue": "1"}, 2, "charter"),
            (None, {"issue": "99"}, 1, "not_found"),
            (None, {"extra": ("--name", "Not A Name")}, 2, "name must match"),
        ]
        for brief, kwargs, code, words in refusals:
            with self.subTest(words=words):
                extra = kwargs.get("extra", ())
                got, _, err = self.main(brief, *extra, issue=kwargs.get("issue", "2"))
                self.assertEqual((got, words in err), (code, True), err)
                self.assertNothingWritten()

    def test_a_closed_ask_and_a_name_in_use_are_refused_before_anything_is_written(self):
        self.gh.issues[2]["state"] = "closed"
        self.reader.invalidate(2)
        code, _, err = self.main()
        self.assertEqual((code, "closed" in err), (2, True))
        self.assertNothingWritten()
        self.gh.issues[2]["state"] = "open"
        self.reader.invalidate(2)
        self.world.add_agent("cos-2", fleet={"role": "cos-subagent", "issue": 2})
        before = len(self.world.v2.sessions)
        code, _, err = self.main()
        self.assertEqual((code, "already runs" in err), (2, True))
        self.assertEqual((self.comments(), len(self.world.v2.sessions)), ([], before))

    def test_without_an_ask_repo_it_says_what_to_set(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        code, _, err = self.main()
        self.assertEqual((code, "intent_repo" in err), (2, True))
        self.assertNothingWritten()

    def test_a_github_that_cannot_post_stops_before_any_subagent_exists(self):
        original = self.gh.post_comment
        self.gh.post_comment = lambda argv, kwargs: subprocess.CompletedProcess(argv, 1, "", "gh: boom\n")
        before = len(self.world.v2.sessions)
        code, _, err = self.main()
        self.gh.post_comment = original
        self.assertEqual(code, 1)
        self.assertIn("boom", err)
        self.assertEqual(len(self.world.v2.sessions), before)

    def test_a_launch_that_fails_after_the_comment_says_the_brief_was_posted(self):
        self.world.herdr.launch_mode = "shell"
        engine = self.world.new_engine("cli")
        with self.assertRaises(sb.LaunchError) as caught:
            sb.handoff_ask(engine, "cos", 2, self.BRIEF, directory=str(self.work), workspace="w1", patience=3,
                           sleep=lambda seconds: self.world.tick(seconds))
        self.assertIn("the brief was posted on ask #2", str(caught.exception))
        self.assertEqual(len(self.comments()), 1)
        self.assertEqual(len(self.world.herdr.closed), 1, "the pane it opened is closed again")

    def test_it_needs_a_caller_it_can_identify(self):
        os.environ.pop("HERDR_PANE_ID")
        code, _, err = self.main()
        self.assertEqual((code, "HERDR_PANE_ID" in err), (1, True))
        self.assertNothingWritten()

    def test_the_brief_can_come_from_standard_input(self):
        with mock.patch.object(sys, "stdin", io.StringIO(self.BRIEF)):
            with captured() as (out, err):
                code = sb.main(["handoff", "--issue", "2", "--brief-file", "-", "--dir", str(self.work),
                                "--workspace", "w1"], runner=self.route, now=self.world.clock.now,
                               socket_call=self.world.herdr.socket)
        self.assertEqual(code, 0, err.getvalue())
        self.assertEqual(len(self.comments()), 1)

    def test_an_empty_brief_is_refused(self):
        code, _, err = self.main("   \n")
        self.assertEqual((code, "empty" in err), (1, True))
        self.assertNothingWritten()

    def test_the_handoff_is_the_only_github_write_and_the_reader_stays_read_only(self):
        self.main()
        writes = [c for c in self.gh.calls if len(c) != 3]
        self.assertEqual(len(writes), 1)
        self.assertNotRegex(class_source("IntentReader"), r"\"(-X|-f|-F|--method|--input|--field)\"")
        source = SWITCHBOARD.read_text()
        self.assertEqual(source.count('"--method"'), 1)


class TestForegroundScenarios(Base):
    def test_the_pr8_catalog_is_present_with_its_tiers_and_controls(self):
        found = {s["id"]: s for s in map(sc.load, sc.scenario_files(sc.DEFAULT_DIR))}
        for sid, tiers in (("F1", {"offline", "lab-model"}), ("F2", {"offline", "lab-model"}),
                           ("F3", {"offline", "lab-model"}), ("F4", {"offline", "lab-scripted"})):
            with self.subTest(scenario=sid):
                self.assertEqual((set(found[sid]["tiers"]), found[sid]["since_pr"], found[sid]["problem"]), (tiers, 8, 2))
        for sid in ("F1", "F2", "F3"):
            self.assertEqual(found[sid]["config"], {"classifier_mode": "act"})
        self.assertEqual(found["F2"]["control"]["variant"], {"steps": {"1": {"text": "Also, can you look at the billing export?"}}})
        self.assertEqual({sid: found[sid]["control"].get("fault") for sid in ("F1", "F3", "F4")},
                         {"F1": "no-classify", "F3": "no-classify", "F4": "no-engagement-gate"})

    def test_the_scenarios_run_and_their_controls_fail_what_they_name(self):
        for sid, name in (("F1", "f1-unrelated-while-busy"), ("F2", "f2-current-work"),
                          ("F3", "f3-ask-with-an-owner"), ("F4", "f4-subagent-finishes")):
            with self.subTest(scenario=sid):
                report = run_scenario(self, sc.load(sc.DEFAULT_DIR / (name + ".json")))
                self.assertEqual(report["failures"], [])
                self.assertEqual(report["implicit"], [])
                self.assertEqual(report["proves_nothing"], [])
                self.assertEqual(sorted(r["label"] for r in report["control"] if not r["ok"]) != [], True)

    def test_f1_decorates_with_the_handoff_and_f3_names_the_owner(self):
        f1 = OfflineRun(self, sc.load(sc.DEFAULT_DIR / "f1-unrelated-while-busy.json"), "run").run()
        self.assertTrue(all(r["ok"] for r in f1.evaluate()))
        texts = _delivered_texts(f1, "cos")
        self.assertTrue(any("fleet-switchboard handoff --issue 610" in t for t in texts))
        f3 = OfflineRun(self, sc.load(sc.DEFAULT_DIR / "f3-ask-with-an-owner.json"), "run").run()
        self.assertTrue(all(r["ok"] for r in f3.evaluate()))
        self.assertTrue(any("fleet-switchboard send cos-615 --issue 615" in t for t in _delivered_texts(f3, "cos")))

    def test_f2_the_control_decorates_the_same_message_once_it_is_unrelated(self):
        f2 = sc.load(sc.DEFAULT_DIR / "f2-current-work.json")
        control, _ = control_play(self, f2)
        self.assertEqual(len(_delivered_texts(control, "cos")), 1)

    def test_f4_carries_the_asks_intent_lines_offline(self):
        f4 = sc.load(sc.DEFAULT_DIR / "f4-subagent-finishes.json")
        f4["expect"].append({"name": "intent-lines", "that": "message_has_intent", "to": "cos", "issue": 615})
        run = OfflineRun(self, f4, "run").run()
        results = {r["label"]: r for r in run.evaluate()}
        self.assertTrue(results["intent-lines"]["ok"], results["intent-lines"]["seen"])
        self.assertTrue(results["noted"]["ok"])

    def test_the_handoff_step_leaves_a_brief_and_a_subagent_and_without_it_nothing(self):
        f1 = sc.load(sc.DEFAULT_DIR / "f1-unrelated-while-busy.json")
        run = OfflineRun(self, f1, "run").run()
        self.assertTrue({r["label"]: r["ok"] for r in run.evaluate()}["handed-off"])
        without = copy.deepcopy(f1)
        without["steps"] = [s for s in without["steps"] if s["do"] != "handoff"]
        run = OfflineRun(self, without, "run").run()
        self.assertFalse({r["label"]: r["ok"] for r in run.evaluate()}["handed-off"])

    def test_the_vocabulary_knows_the_new_config_and_step(self):
        self.assertIn("handoff", sc.STEP_FIELDS)
        self.assertEqual(sc.STEP_ACTORS["handoff"], ("cast",))
        scenario = sc.load(sc.DEFAULT_DIR / "f2-current-work.json")
        scenario["config"] = {"classifier_mode": "enforce"}
        self.assertTrue([e for e in sc.validate(scenario) if "classifier_mode" in e])
        scenario["config"] = {"classifier_mode": "act", "batch_seconds": 5}
        self.assertEqual(sc.validate(scenario), [])
        scenario["config"] = {"colour": "red"}
        self.assertTrue([e for e in sc.validate(scenario) if "colour" in e])

    def test_j1_and_f5_still_run_in_shadow_mode(self):
        for name in ("j1-shadow-classifier.json", "f5-jev-unsure.json"):
            with self.subTest(scenario=name):
                scenario = sc.load(sc.DEFAULT_DIR / name)
                self.assertNotIn("classifier_mode", scenario.get("config", {}))
                report = run_scenario(self, scenario)
                self.assertEqual(report["failures"] + report["proves_nothing"], [])


class TestPR8Source(unittest.TestCase):
    def test_the_foreground_section_is_one_clearly_marked_block(self):
        source = SWITCHBOARD.read_text()
        self.assertEqual(source.count("\n# PR 8: foreground and background"), 1)

    def test_the_engine_still_never_types(self):
        self.assertEqual(herdr_typing_violations(SWITCHBOARD.read_text()), [])

    def test_no_top_level_name_is_defined_twice_in_the_big_files(self):
        for name in ("fleet-switchboard", "test-switchboard", "fleet-scenario", "proof-switchboard"):
            seen = {}
            for node in ast.parse((BIN / name).read_text()).body:
                names = [node.name] if isinstance(node, (ast.FunctionDef, ast.ClassDef)) else [
                    t.id for t in getattr(node, "targets", []) if isinstance(t, ast.Name)]
                for each in names:
                    self.assertNotIn(each, seen, "%s defines %s twice (lines %s and %s)" % (name, each, seen.get(each), node.lineno))
                    seen[each] = node.lineno


class TestNoticeRace(ActingCase):
    """SF1: your message is consumed at the next step boundary T; the decoration must be in v2's inbox before it."""

    def start(self):
        self.work(lasts=10, steps=2)      # one step boundary, at EPOCH + 5
        self.world.tick(1)
        self.say("Also, the billing export?")
        self.yours = self.world.v2.sessions[self.cos]["inbox"][-1]["id"]

    def calls_with(self, message_id):
        return [c for c in self.world.model_calls("cos") if message_id in [i["id"] for i in c["inputs"]]]

    def test_your_message_is_seen_in_the_inbox_before_any_boundary(self):
        self.start()
        self.assertEqual([m for m in self.world.v2.sessions[self.cos]["messages"] if m["type"] == "user"][-1:][0]["text"],
                         "fleet task", "not yet in the transcript")
        self.world.clock.t = EPOCH + 1.2
        self.world.engine.run_pass()
        self.assertEqual(len(self.jev.calls), 1)
        self.assertEqual(len(self.decorations()), 1)

    def test_a_decoration_sent_0_2_s_before_the_boundary_arrives_with_your_message(self):
        self.start()
        self.world.clock.t = EPOCH + 4.8
        self.world.engine.run_pass()
        self.world.clock.t = EPOCH + 5
        self.world.v2.advance()
        (call,) = self.calls_with(self.yours)
        self.assertEqual(call["phase"], "between_steps")
        self.assertTrue(any(k.startswith("decoration:") for i in call["inputs"] for k in i["keys"]))
        self.assertEqual([e for e in self.world.audit() if e["event"] == "foreground.late"], [])

    def test_a_decoration_sent_after_the_boundary_is_late_and_audited(self):
        self.start()
        self.world.clock.t = EPOCH + 5
        self.world.v2.advance()
        self.world.clock.t = EPOCH + 5.2
        self.world.engine.run_pass()
        (call,) = self.calls_with(self.yours)
        self.assertFalse(any(i["keys"] for i in call["inputs"]), "the model saw the bare message first")
        (late,) = [e for e in self.world.audit() if e["event"] == "foreground.late"]
        self.assertEqual((late["detail"]["decoration"], late["detail"]["agent"]), ("handoff", "cos"))
        self.assertEqual(late["detail"]["message_id"], self.yours)

    def test_a_decoration_is_a_note_not_a_wake_even_while_your_message_waits_in_the_inbox(self):
        self.start()
        self.world.engine.run_pass()
        (note,) = self.decorations()
        self.assertEqual((note["resume"], note["delivery"]), (False, "steer"))

    def test_late_is_not_logged_when_nothing_is_decorated(self):
        self.answer = "current"
        self.start()
        self.world.tick(6)
        self.world.engine.run_pass()
        self.assertEqual([e for e in self.world.audit() if e["event"] == "foreground.late"], [])


class TestBusyPoll(ActingCase):
    def waits(self, passes=2):
        waits = []
        sb.run_daemon(self.world.engine, self.world.state, 5, lambda sock, t: waits.append(t), passes=passes)
        return waits

    def test_the_default_is_one_second_and_must_be_positive(self):
        self.assertEqual(sb.validate_config({})["busy_poll_seconds"], 1)
        for bad in (0, -1, "1", True):
            with self.subTest(bad=bad), self.assertRaises(sb.ConfigError):
                sb.validate_config({"busy_poll_seconds": bad})

    def test_the_daemon_polls_fast_only_while_a_chief_of_staff_works(self):
        self.assertEqual(self.waits(2), [5])  # the pass sees an idle fleet
        self.work()
        self.assertEqual(self.waits(2), [1])  # ... and a working Chief of Staff
        self.world.tick(120)
        self.assertEqual(self.waits(3), [5, 5])

    def test_a_busy_worker_or_orchestrator_does_not_speed_it_up(self):
        self.world.v2.start_turn(self.world.sessions["cos-2"], "fleet task", fleet=True, lasts=60, steps=6)
        self.assertEqual(self.waits(3), [5, 5])

    def test_shadow_mode_never_polls_fast(self):
        self.world.engine.config = dict(self.world.engine.config, classifier_mode="shadow")
        self.work()
        self.assertEqual(self.waits(3), [5, 5])


class TestNativeChildSession(Base):
    def test_a_pane_less_child_with_the_parents_fleet_metadata_is_not_a_second_agent(self):
        world = World(self, agents=("cos",))
        child = world.v2.create_session({"fleet": {"name": "cos", "role": "chief-of-staff"}})
        world.v2.sessions[child]["parentID"] = world.sessions["cos"]  # herdr shows no pane for it
        found = world.engine.discover(world.clock.now())
        self.assertEqual(list(found.agents), ["cos"])
        self.assertEqual((found.agents["cos"].session_id, found.agents["cos"].conflict), (world.sessions["cos"], []))
# ============================================================================
# PR 9: the tool-call policy judge, its plugin and scenarios P1 to P6
#
# One section, so the stack rebases cleanly: the offline runner learns the
# `tool-call` step and the `policy_outcome` oracle by attachment (as PR 4 and
# PR 5 did), then the tests. Nothing here reaches a real binary or a network:
# Jev is a replay file, a fake or a fake opener; v2 and GitHub are the fakes.
# ============================================================================
POLICY_REPLAY = REPO / "scenarios" / "jev" / "policy.json"
FLEET_HOOKS = REPO / "plugins" / "fleet-hooks"
NODE = shutil.which("node")  # found before each test narrows PATH


class PolicyCountingJev:
    """Wraps a decision model and counts how often it was asked."""

    def __init__(self, inner):
        self.inner, self.calls = inner, 0

    def decide(self, state, questions):
        self.calls += 1
        return self.inner.decide(state, questions)


def policy_raw_config(**policy):
    """A validated config with the judge on, answering from the replay file."""
    return sb.validate_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "gh": FAKE_GH,
                               "intent_repo": FAKE_REPO, "policy": dict({"enabled": True}, **policy),
                               "jev": {"replay": str(POLICY_REPLAY)}})


class PolicyRig:
    """What a scenario's tool-call steps share: the judge, its Jev, and what each step answered."""

    def __init__(self, run):
        world = run.world
        self.config = policy_raw_config()
        self.jev = PolicyCountingJev(sb.build_jev(self.config))
        self.judge = sb.PolicyJudge(self.config, world.engine.v2, getattr(world, "intents", None), self.jev,
                                    sb.AuditLog(world.audit_path), world.state, world.clock.now)
        self.results = {}


def _policy_stricter(reply_outcome, configured):
    order = sb.POLICY_REQUEST_OUTCOMES.index
    return order(reply_outcome) > order(configured)


def apply_tool_call(run, step):
    """`tool-call`: the plugin's JSON through `judge-tool`'s own path (parse, judge_request), against the fakes.

    An ask then blocks the agent as v2 would after the hook sets `ask`, with the
    judge's reason as the request's message, when the reply tightened the outcome.
    """
    world, name = run.world, step["actor"]
    rig = run.policy = getattr(run, "policy", None) or PolicyRig(run)
    index = next(i for i, s in enumerate(run.scenario["steps"]) if s is step)
    configured = step.get("configured", "allow")
    request = sb.parse_policy_request(json.dumps({"sessionID": world.sessions[name], "tool": step["tool"],
                                                  "arguments": step["arguments"], "outcome": configured}))
    before, saved = rig.jev.calls, os.environ.get(sb.FAULT_ENV)
    os.environ[sb.FAULT_ENV] = ",".join(run.faults)
    try:
        reply, judge = sb.judge_request(request, rig.config, lambda: rig.judge)
    finally:
        os.environ[sb.FAULT_ENV] = saved or ""
    rig.results[index] = {"agent": name, "reply": reply, "jev_calls": rig.jev.calls - before}
    if reply["outcome"] == "ask":
        apply_worker_step(run, {"do": "permission", "actor": name})
        ask = world.v2.asks[world.sessions[name]][-1]
        ask.update(action=step["tool"], resources=[step["arguments"]])
        if _policy_stricter(reply["outcome"], configured):
            ask["message"] = reply["reason"]


def oracle_policy_outcome(self, e):
    rig = getattr(self, "policy", None)
    found = rig.results.get(e["step"]) if rig else None
    if found is None or found["agent"] != e["agent"]:
        return False, "step %d made no tool call by %s" % (e["step"], e["agent"])
    reply = found["reply"]
    wanted = [("outcome", e["outcome"]), ("judged", e.get("judged")), ("cached", e.get("cached")),
              ("jev_calls", e.get("jev_calls"))]
    got = dict(reply, jev_calls=found["jev_calls"])
    ok = all(want is None or got[key] == want for key, want in wanted)
    ok = ok and e.get("reason", "") in reply["reason"]
    return ok, "step %d: outcome %s, judged %s, cached %s, Jev asked %d time(s), reason %r" % (
        e["step"], reply["outcome"], reply["judged"], reply["cached"], found["jev_calls"], reply["reason"])


def _policy_extend_offline_run():
    original_apply = OfflineRun.apply

    def apply(self, step):
        if step["do"] == "tool-call":
            apply_tool_call(self, step)
        else:
            original_apply(self, step)

    OfflineRun.apply = apply
    OfflineRun.oracle_policy_outcome = oracle_policy_outcome


_policy_extend_offline_run()

STEP_EXAMPLES["tool-call"] = {"tool": "shell", "arguments": "git push --force", "configured": "ask"}
EXPECT_EXAMPLES["policy_outcome"] = {"agent": "coder", "step": 0, "outcome": "ask", "reason": "hard to reverse",
                                     "judged": True, "cached": False, "jev_calls": 1}


# ------------------------------------------------------------------- config

class TestPolicyConfig(Base):
    def test_off_by_default_with_documented_defaults(self):
        policy = sb.validate_config({})["policy"]
        self.assertEqual(policy, {"enabled": False, "budget_ms": 900, "thresholds": {}, "cache_seconds": 300,
                                  "cache_entries": 200})

    def check_rejected(self, policy, fragment, **extra):
        with self.assertRaises(sb.ConfigError) as caught:
            sb.validate_config(dict({"policy": policy}, **extra))
        self.assertIn(fragment, str(caught.exception))

    def test_unknown_subkeys_are_rejected_by_name(self):
        self.check_rejected({"budgetms": 5}, "budgetms")
        self.check_rejected({"enabled": False, "extra": 1}, "extra")

    def test_each_value_is_checked(self):
        for policy, fragment in (({"enabled": "yes"}, "policy.enabled"), ({"budget_ms": 0}, "policy.budget_ms"),
                                 ({"budget_ms": "9"}, "policy.budget_ms"), ({"budget_ms": True}, "policy.budget_ms"),
                                 ({"cache_seconds": -1}, "policy.cache_seconds"),
                                 ({"cache_entries": 0}, "policy.cache_entries"),
                                 ({"cache_entries": 99999}, "policy.cache_entries"),
                                 ({"thresholds": []}, "policy.thresholds"),
                                 ({"thresholds": {"outside_intent": 0}}, "policy.thresholds.outside_intent"),
                                 ({"thresholds": {"outside_intent": 1.5}}, "policy.thresholds.outside_intent"),
                                 ({"thresholds": {"nothing": 0.5}}, "names no question")):
            with self.subTest(policy=policy):
                self.check_rejected(policy, fragment)
        self.check_rejected("on", "must be an object")

    def test_enabling_needs_a_decision_model(self):
        self.check_rejected({"enabled": True}, "needs a 'jev' object")
        config = sb.validate_config({"policy": {"enabled": True, "budget_ms": 400, "thresholds": {"outside_scope": 0.8}},
                                     "jev": {}})
        self.assertEqual((config["policy"]["budget_ms"], config["policy"]["thresholds"]), (400, {"outside_scope": 0.8}))

    def test_the_fault_exists_and_works_only_in_the_lab(self):
        self.assertIn("no-policy-judge", sb.KNOWN_FAULTS)
        os.environ[sb.FAULT_ENV] = "no-policy-judge"
        os.environ.pop(sb.LAB_ENV, None)
        request = {"configured": "allow", "tool": "shell"}
        self.assertIsNone(sb.policy_unjudged_reason(policy_raw_config(), request))
        os.environ[sb.LAB_ENV] = "1"
        self.assertIn("no-policy-judge", sb.policy_unjudged_reason(policy_raw_config(), request))


# ------------------------------------------------------------------ request

class TestPolicyRequest(unittest.TestCase):
    GOOD = {"sessionID": "ses_0123abcd", "tool": "shell", "arguments": "git status", "outcome": "ask"}

    def parse(self, **change):
        return sb.parse_policy_request(json.dumps(dict(self.GOOD, **change)))

    def test_a_good_request(self):
        self.assertEqual(self.parse(), {"session": "ses_0123abcd", "tool": "shell", "arguments": "git status",
                                        "configured": "ask"})

    def test_arguments_may_be_missing_or_structured_and_are_bounded(self):
        self.assertEqual(self.parse(arguments=None)["arguments"], "")
        self.assertEqual(self.parse(arguments={"b": 1, "a": 2})["arguments"], '{"a":2,"b":1}')
        self.assertEqual(len(self.parse(arguments="x" * 99999)["arguments"]), sb.POLICY_ARG_LIMIT)

    def test_every_malformed_request_is_refused(self):
        bad = ["", "not json", "[]", "7", '"x"', "null", json.dumps({}),
               json.dumps(dict(self.GOOD, sessionID="x; rm -rf /")), json.dumps(dict(self.GOOD, sessionID="--help")),
               json.dumps(dict(self.GOOD, sessionID=7)), json.dumps(dict(self.GOOD, tool="rm")),
               json.dumps(dict(self.GOOD, tool=None)), json.dumps(dict(self.GOOD, outcome="hard-deny")),
               json.dumps(dict(self.GOOD, outcome="permit")), json.dumps({k: v for k, v in self.GOOD.items() if k != "outcome"})]
        for text in bad:
            with self.subTest(text=text[:50]):
                with self.assertRaises(sb.PolicyRequestError):
                    sb.parse_policy_request(text)

    def test_the_tool_names_are_the_documented_nine(self):
        self.assertEqual(sb.POLICY_TOOLS, ("shell", "edit", "webfetch", "subagent", "read", "glob", "grep", "skill", "other"))
        self.assertEqual(sb.POLICY_PASS_THROUGH, ("read", "glob", "grep", "skill"))


class TestPolicyRedaction(unittest.TestCase):
    def test_credential_shapes_are_removed(self):
        for secret, text in (
                ("sk-or-test-0123456789abcdef", "curl -H 'Authorization: Bearer sk-or-test-0123456789abcdef' x"),
                ("ghp_0123456789abcdefABCDEF", "git push https://ghp_0123456789abcdefABCDEF@host/r"),
                ("hunter2hunter2", "deploy --password hunter2hunter2"),
                ("s3cr3tvalue99", "API_TOKEN=s3cr3tvalue99 ./run"),
                ("AKIA0123456789ABCDEF", "aws --key AKIA0123456789ABCDEF s3 ls"),
                ("realpass", "git clone https://user:realpass@example.test/r.git")):
            with self.subTest(secret=secret):
                self.assertNotIn(secret, sb.redact_command_text(text))

    def test_a_known_key_is_removed_wherever_it_appears_and_ordinary_text_survives(self):
        self.assertNotIn("KEYVALUE", sb.redact_command_text("echo KEYVALUE", ["KEYVALUE"]))
        self.assertEqual(sb.redact_command_text("git log --oneline -5"), "git log --oneline -5")
        self.assertEqual(sb.redact_command_text(None), "")


# ------------------------------------------------------- standing authority

class TestStandingAuthority(unittest.TestCase):
    def test_the_line_in_the_charter_prose(self):
        body = "```yaml\norchestrator: platform\n```\n\nStanding authority: may merge green PRs\n\nMore.\n"
        self.assertEqual(sb.parse_standing_authority(body), "may merge green PRs")

    def test_forms_that_count(self):
        for line in ("standing authority: may merge", "- Standing authority: may merge", "**Standing authority:** may merge",
                     "  Standing Authority :   may merge  "):
            with self.subTest(line=line):
                self.assertEqual(sb.parse_standing_authority("text\n" + line + "\n"), "may merge")

    def test_absent_empty_none_or_fenced_is_none_stated(self):
        for body in (None, "", "no such line", "Standing authority:", "Standing authority: none",
                     "Standing authority: None stated.", "```\nStanding authority: may merge\n```\n",
                     "~~~\nStanding authority: may merge\n~~~\n", "A Standing authority: may merge (not at line start)"):
            with self.subTest(body=body):
                self.assertIsNone(sb.parse_standing_authority(body))

    def test_the_first_line_wins(self):
        self.assertEqual(sb.parse_standing_authority("Standing authority: one\nStanding authority: two\n"), "one")

    def test_the_skill_documents_it_in_one_short_paragraph(self):
        text = (REPO / "skills" / "fleet-charter" / "SKILL.md").read_text()
        self.assertEqual(text.count("Standing authority:"), 2)  # the syntax line and the example line
        self.assertIn("none stated", text)


# ------------------------------------------------------------------- caches

class TestPolicyCache(Base):
    def make(self, ttl=60, limit=3, name="c.json"):
        self.clock = SimClock()
        return sb.BoundedFileCache(self.home / name, self.clock.now, ttl, limit)

    def test_round_trip_expiry_and_privacy(self):
        cache = self.make()
        self.assertTrue(cache.put("k", {"answers": {"a": 0.1}}))
        self.assertEqual(cache.get("k"), {"answers": {"a": 0.1}})
        self.assertEqual(stat.S_IMODE(os.stat(str(self.home / "c.json")).st_mode), 0o600)
        self.clock.t += 59
        self.assertIsNotNone(cache.get("k"))
        self.clock.t += 2
        self.assertIsNone(cache.get("k"))

    def test_it_is_bounded_and_drops_the_oldest(self):
        cache = self.make(limit=3)
        for number in range(6):
            self.clock.t += 1
            cache.put("k%d" % number, number)
        data = json.loads((self.home / "c.json").read_text())["entries"]
        self.assertEqual(sorted(data), ["k3", "k4", "k5"])

    def test_expired_entries_are_not_kept_in_the_file(self):
        cache = self.make(ttl=10)
        cache.put("old", 1)
        self.clock.t += 11
        cache.put("new", 2)
        self.assertEqual(sorted(json.loads((self.home / "c.json").read_text())["entries"]), ["new"])

    def test_writes_are_atomic_and_leave_no_temp_file(self):
        cache = self.make()
        for number in range(5):
            cache.put("k%d" % number, number)
        self.assertEqual(sorted(p.name for p in self.home.glob("c.json*")), ["c.json"])

    def test_a_failed_write_is_not_an_error_and_cleans_up(self):
        cache = self.make(name="missing-dir/c.json")
        self.assertFalse(cache.put("k", 1))
        self.assertIsNone(cache.get("k"))

    def test_corrupt_oversized_or_wrongly_shaped_files_read_as_empty(self):
        cache = self.make()
        for text in ("{not json", "[]", '{"entries": []}', '{"entries": {"k": 5}}',
                     '{"entries": {"k": {"at": "x", "value": 1}}}', "x" * (sb.POLICY_CACHE_BYTES + 1)):
            with self.subTest(text=text[:30]):
                (self.home / "c.json").write_text(text)
                self.assertIsNone(cache.get("k"))
        self.assertTrue(cache.put("k", 1))  # and the next write replaces the bad file
        self.assertEqual(cache.get("k"), 1)

    def test_an_entry_from_the_future_is_not_trusted(self):
        cache = self.make()
        cache.put("k", 1)
        self.clock.t -= 1000
        self.assertIsNone(cache.get("k"))

    def test_a_ttl_of_zero_turns_it_off(self):
        cache = self.make(ttl=0)
        self.assertFalse(cache.put("k", 1))
        self.assertFalse((self.home / "c.json").exists())
        self.assertIsNone(cache.get("k"))


# ---------------------------------------------------------- the judge itself

def policy_replay_file(home, rules, name="replay.json"):
    path = Path(home) / name
    path.write_text(json.dumps({"rules": rules}))
    return str(path)


LOW = {"outside_intent": 0.0, "hard_to_reverse": 0.0, "speaks_for_you": 0.0, "outside_scope": 0.0}


class PolicyCase(IntentCase):
    """A world with a fake GitHub (charter 1, ask 2, work item 3), a configured judge, and the CLI wired to both."""

    ISSUES = dict(IntentCase.ISSUES, **{"1": {"intent": None, "authority": "may merge green PRs"}})

    def setUp(self):
        super().setUp()
        self.cos = self.world.add_agent("chief-of-staff", fleet={"role": "chief-of-staff"})
        self.orch = self.world.add_agent("orch", fleet={"role": "orchestrator", "charter": 1, "issue": 2,
                                                       "reports_to": "chief-of-staff"})
        self.coder = self.world.add_agent("worker", fleet={"role": "coder", "issue": 3, "reports_to": "orch"})
        self.plain = self.world.v2.create_session({})  # a session with no metadata.fleet
        self.configure()
        # The daemon's end of the judge socket, on the same fakes: judge-tool reaches Jev only through it.
        self.server = sb.JudgeServer(self.world.state, sb.make_judge_handler(self.route, self.world.clock.now)).start()
        self.addCleanup(self.server.stop)

    def configure(self, rules=None, **policy):
        replay = policy_replay_file(self.home, rules or [{"noul": LOW}])
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "gh": FAKE_GH, "intent_repo": FAKE_REPO,
                           "jev": {"replay": replay}, "policy": dict({"enabled": True}, **policy)})

    def route(self, argv, **kwargs):
        if argv[0] == FAKE_GH:
            return self.gh(argv)
        return self.world.route(argv, **kwargs)

    def judge_tool(self, session, tool="shell", arguments="git status", outcome="allow", raw=None):
        text = raw if raw is not None else json.dumps({"sessionID": session, "tool": tool, "arguments": arguments,
                                                       "outcome": outcome})
        with mock.patch.object(sys, "stdin", io.StringIO(text)), captured() as (out, err):
            code = sb.main(["judge-tool"], runner=self.route, now=self.world.clock.now)
        lines = out.getvalue().splitlines()
        self.assertEqual(code, 0, err.getvalue())
        self.assertEqual(len(lines), 1, "exactly one line of output: %r" % out.getvalue())
        return json.loads(lines[0])

    def audit_events(self):
        return [e for e in self.world.audit() if e["event"] == "policy.judge"]

    def direct_judge(self, jev, **policy):
        config = policy_raw_config(**policy)
        return sb.PolicyJudge(config, self.world.engine.v2, self.reader, jev, sb.AuditLog(self.world.audit_path),
                              self.world.state, self.world.clock.now)


class TestJudgeTool(PolicyCase):
    def test_the_reply_has_the_documented_fields(self):
        reply = self.judge_tool(self.coder)
        self.assertEqual(set(reply), {"outcome", "reason", "judged", "cached", "latency_ms"})
        self.assertEqual((reply["outcome"], reply["judged"], reply["cached"]), ("allow", True, False))
        self.assertIsInstance(reply["latency_ms"], int)

    def test_reads_globs_greps_and_skills_never_call_jev_or_v2(self):
        for tool in sb.POLICY_PASS_THROUGH:
            for configured in ("allow", "ask"):
                with self.subTest(tool=tool, configured=configured):
                    reply = self.judge_tool(self.coder, tool, "src/x.py", configured)
                    self.assertEqual((reply["outcome"], reply["judged"]), (configured, False))
        self.assertEqual(self.world.v2.writes, [])
        self.assertEqual(self.audit_events(), [], "an unjudged call is not audited: reads would flood the log")

    def test_a_configured_deny_is_final_and_the_judge_is_not_consulted(self):
        self.configure([{"noul": LOW}])
        reply = self.judge_tool(self.coder, "shell", "rm -rf build", "deny")
        self.assertEqual((reply["outcome"], reply["judged"]), ("deny", False))
        self.assertIn("final", reply["reason"])
        self.assertEqual(self.audit_events(), [])

    def test_off_means_the_configured_outcome_untouched(self):
        self.configure([{"noul": {"outside_intent": 1.0}}], enabled=False)
        reply = self.judge_tool(self.coder, "edit", "billing/x.py", "allow")
        self.assertEqual((reply["outcome"], reply["judged"]), ("allow", False))
        self.assertIn("not enabled", reply["reason"])

    def test_a_session_that_is_not_a_fleet_agent_is_not_judged(self):
        reply = self.judge_tool(self.plain, "shell", "ls", "ask")
        self.assertEqual((reply["outcome"], reply["judged"]), ("ask", False))
        self.assertIn("not a fleet agent", reply["reason"])

    def test_an_unknown_session_keeps_the_configured_outcome(self):
        reply = self.judge_tool("ses_doesnotexist", "shell", "ls", "ask")
        self.assertEqual((reply["outcome"], reply["judged"]), ("ask", False))
        self.assertIn("configured outcome stands", reply["reason"])

    def test_hard_to_reverse_asks_and_the_reason_says_so(self):
        self.configure([{"noul": dict(LOW, hard_to_reverse=0.9)}])
        reply = self.judge_tool(self.coder, "shell", "git push --force", "allow")
        self.assertEqual((reply["outcome"], reply["judged"]), ("ask", True))
        self.assertIn("hard to reverse", reply["reason"])
        self.assertIn("git push --force", reply["reason"])

    def test_each_ask_question_asks(self):
        for question in sb.POLICY_ASK_FOR:
            with self.subTest(question=question):
                self.configure([{"noul": dict(LOW, **{question: 0.9})}])
                self.assertEqual(self.judge_tool(self.coder, "shell", "x %s" % question)["outcome"], "ask")

    def test_outside_intent_is_a_hard_deny_that_says_to_escalate_not_argue(self):
        self.configure([{"noul": dict(LOW, outside_intent=0.9)}])
        reply = self.judge_tool(self.coder, "edit", "billing/export.py", "allow")
        self.assertEqual((reply["outcome"], reply["judged"]), ("deny", True))
        for fragment in ("Do not retry", "Escalate", "Chief of Staff", "fleet-switchboard send", "ask #2"):
            self.assertIn(fragment, reply["reason"])
        self.assertNotIn("awaiting-user", reply["reason"], "a coder escalates to the Chief of Staff")

    def test_an_orchestrators_denial_also_names_the_awaiting_user_label(self):
        self.configure([{"noul": dict(LOW, outside_intent=0.9)}])
        reply = self.judge_tool(self.orch, "edit", "billing/export.py", "ask")
        self.assertEqual(reply["outcome"], "deny")
        self.assertIn("awaiting-user", reply["reason"])
        self.assertIn("Chief of Staff", reply["reason"])

    def test_with_no_ask_the_intent_question_cannot_fire(self):
        no_ask = self.world.add_agent("freelance", fleet={"role": "orchestrator", "charter": 1})
        self.configure([{"noul": dict(LOW, outside_intent=1.0)}])
        reply = self.judge_tool(no_ask, "edit", "anything.py", "allow")
        self.assertEqual((reply["outcome"], reply["judged"]), ("allow", True))
        self.assertIsNone(self.audit_events()[-1]["detail"]["ask"])

    def test_with_no_ask_the_scope_question_cannot_fire_but_the_consequential_ones_still_do(self):
        no_ask = self.world.add_agent("cos2", fleet={"role": "chief-of-staff"})
        self.configure([{"noul": dict(LOW, outside_scope=1.0)}])
        self.assertEqual(self.judge_tool(no_ask, "shell", "gh issue list", "allow")["outcome"], "allow")
        for question in ("hard_to_reverse", "speaks_for_you"):
            with self.subTest(question=question):
                self.configure([{"noul": dict(LOW, **{question: 0.9})}])
                self.assertEqual(self.judge_tool(no_ask, "shell", "x %s" % question, "allow")["outcome"], "ask")

    def test_thresholds_come_from_the_config(self):
        self.configure([{"noul": dict(LOW, hard_to_reverse=0.6)}], thresholds={"hard_to_reverse": 0.9})
        self.assertEqual(self.judge_tool(self.coder, "shell", "a")["outcome"], "allow")
        self.configure([{"noul": dict(LOW, hard_to_reverse=0.6)}], thresholds={"hard_to_reverse": 0.55})
        self.assertEqual(self.judge_tool(self.coder, "shell", "b")["outcome"], "ask")

    def test_jev_is_told_the_role_the_ask_and_the_standing_authority(self):
        seen = []
        jev = FakeJev(lambda state, questions: seen.append(state) or noul_answers(**LOW))
        judge = self.direct_judge(jev)
        judge.decide(sb.parse_policy_request(json.dumps(
            {"sessionID": self.coder, "tool": "shell", "arguments": "gh pr merge 5", "outcome": "allow"})))
        state = seen[0]
        self.assertEqual((state["role"], state["standing_authority"]), ("coder", "may merge green PRs"))
        self.assertIn("Fix the agents (work item: Fix the second one)", state["intent"])
        self.assertEqual(state["done_when"], "both answer")
        self.assertEqual(state["tool"], "shell")
        self.assertIn("gh pr merge 5", state["arguments"])

    def test_no_standing_authority_is_stated_as_none_stated(self):
        seen = []
        jev = FakeJev(lambda state, questions: seen.append(state) or noul_answers(**LOW))
        no_charter_authority = self.world.add_agent("w2", fleet={"role": "coder", "issue": 5})
        self.gh.issues[1]["authority"] = None
        self.direct_judge(jev).decide(sb.parse_policy_request(json.dumps(
            {"sessionID": no_charter_authority, "tool": "shell", "arguments": "gh pr merge 5", "outcome": "allow"})))
        self.assertTrue(seen[0]["standing_authority"].startswith("none stated"))
        self.assertIn("merge", seen[0]["standing_authority"])

    def test_every_question_answer_and_outcome_goes_to_the_audit_log(self):
        self.configure([{"noul": dict(LOW, hard_to_reverse=0.9)}])
        self.judge_tool(self.coder, "shell", "git push --force", "allow")
        detail = self.audit_events()[-1]["detail"]
        self.assertEqual((detail["agent"], detail["role"], detail["tool"], detail["configured"], detail["outcome"]),
                         ("worker", "coder", "shell", "allow", "ask"))
        self.assertEqual(detail["fired"], ["hard_to_reverse"])
        self.assertEqual(detail["answers"]["hard_to_reverse"], 0.9)
        self.assertEqual(detail["question"]["ids"], list(sb.POLICY_QUESTIONS))
        self.assertEqual(detail["question"]["state"]["standing_authority"], "may merge green PRs")
        self.assertEqual((detail["ask"], detail["judged"], detail["cached"]), (2, True, False))
        self.assertIn("latency_ms", detail)

    def test_a_failure_to_judge_is_audited_with_its_reason(self):
        self.configure([{"error": "unreachable"}])
        self.judge_tool(self.coder, "shell", "git push", "ask")
        detail = self.audit_events()[-1]["detail"]
        self.assertEqual((detail["outcome"], detail["judged"]), ("ask", False))
        self.assertIn("unreachable", detail["reason"])

    def test_the_fault_turns_the_judge_off_in_the_lab(self):
        self.configure([{"noul": dict(LOW, outside_intent=0.9)}])
        os.environ[sb.FAULT_ENV] = "no-policy-judge"
        reply = self.judge_tool(self.coder, "edit", "billing/x.py", "allow")
        self.assertEqual((reply["outcome"], reply["judged"]), ("allow", False))


class TestJudgeToolNeverLoosens(PolicyCase):
    """Invariant 9, end to end through the CLI, with a decision model that does everything wrong."""

    HOSTILE = {
        "answers all low": [{"noul": LOW}],
        "answers nothing at all": [{"noul": {}}],
        "unreachable": [{"error": "unreachable"}],
        "times out": [{"error": "timeout"}],
        "invalid": [{"error": "invalid"}],
        "unauthorized": [{"error": "unauthorized"}],
        "has no rule": [{"contains": "no such text", "noul": LOW}],
    }

    def via_the_daemon_handler(self, session, tool, arguments, outcome):
        """The daemon's own reply, before judge-tool's guard sees it: the combiner must hold by itself."""
        return sb.make_judge_handler(self.route, self.world.clock.now)(json.dumps(
            {"sessionID": session, "tool": tool, "arguments": arguments, "outcome": outcome}))

    def test_the_daemons_own_reply_is_never_looser_either(self):
        order = sb.POLICY_REQUEST_OUTCOMES.index
        for name, rules in self.HOSTILE.items():
            for configured in ("allow", "ask"):
                with self.subTest(jev=name, configured=configured):
                    self.configure(rules)
                    reply = self.via_the_daemon_handler(self.coder, "shell", "d %s %s" % (name, configured), configured)
                    self.assertGreaterEqual(order(reply["outcome"]), order(configured))

    def test_no_answer_and_no_judgement_is_ever_looser_than_configured(self):
        order = sb.POLICY_REQUEST_OUTCOMES.index
        for name, rules in self.HOSTILE.items():
            for configured in ("allow", "ask"):
                for tool in ("shell", "edit", "webfetch", "subagent", "other"):
                    with self.subTest(jev=name, configured=configured, tool=tool):
                        self.configure(rules)
                        reply = self.judge_tool(self.coder, tool, "do %s %s %s" % (name, configured, tool), configured)
                        self.assertGreaterEqual(order(reply["outcome"]), order(configured))
                        self.assertEqual(reply["outcome"], configured)

    def test_a_loud_answer_can_only_tighten(self):
        order = sb.POLICY_REQUEST_OUTCOMES.index
        for answer in ({"outside_intent": 1.0}, {"hard_to_reverse": 1.0}, {"speaks_for_you": 1.0}, {"outside_scope": 1.0}):
            for configured in ("allow", "ask"):
                with self.subTest(answer=answer, configured=configured):
                    self.configure([{"noul": dict(LOW, **answer)}])
                    reply = self.judge_tool(self.coder, "shell", "x", configured)
                    self.assertGreaterEqual(order(reply["outcome"]), order(configured))

    def test_the_loosening_fault_reaches_the_daemons_reply_but_not_the_clients_output(self):
        self.configure([{"noul": LOW}])
        request = sb.parse_policy_request(json.dumps(
            {"sessionID": self.coder, "tool": "shell", "arguments": "x", "outcome": "ask"}))
        os.environ[sb.FAULT_ENV] = "judge-loosens"
        loosened = sb.make_judge_handler(self.route, self.world.clock.now)(json.dumps(
            {"sessionID": self.coder, "tool": "shell", "arguments": "y", "outcome": "ask"}))
        self.assertEqual(loosened["outcome"], "allow", "the control: the fault makes the judge's word replace the configured one")
        self.assertEqual(self.judge_tool(self.coder, "shell", "z", "ask")["outcome"], "ask",
                         "judge-tool's own guard refuses a looser reply, so a Lab run through the real plugin cannot show the fault")
        self.assertEqual(request["configured"], "ask")

    def test_a_daemon_that_answers_looser_is_ignored_by_the_client(self):
        for configured, rogue in (("ask", "allow"), ("deny", "ask"), ("deny", "allow")):
            with self.subTest(configured=configured, rogue=rogue):
                self.server.handle = lambda text, rogue=rogue: sb.policy_reply(rogue, "trust me", True)
                reply = self.judge_tool(self.coder, "shell", "q", configured) if configured != "deny" else None
                if reply is not None:
                    self.assertEqual(reply["outcome"], configured)
                    self.assertIn("looser", reply["reason"])
        self.assertEqual(sb.never_looser(sb.policy_reply("allow", "x"), "deny")["outcome"], "deny")


class TestJudgeToolRequestHandling(PolicyCase):
    def test_malformed_requests_keep_the_configured_outcome_and_exit_zero(self):
        for text, expected in (("", "allow"), ("not json", "allow"), ("[]", "allow"), ("{}", "allow"),
                               (json.dumps({"sessionID": "nope", "tool": "shell", "outcome": "ask"}), "ask"),
                               (json.dumps({"sessionID": "ses_x1", "tool": "rm", "outcome": "ask"}), "ask"),
                               (json.dumps({"sessionID": "ses_x1", "tool": "shell", "outcome": "hard-deny"}), "allow"),
                               ('{"outcome": "deny", "tool": 5}', "deny")):
            with self.subTest(text=text):
                reply = self.judge_tool(None, raw=text)
                self.assertEqual((reply["outcome"], reply["judged"]), (expected, False))
                self.assertIn("unusable request", reply["reason"])
        self.assertEqual(self.audit_events(), [])

    def test_an_oversized_request_is_refused(self):
        text = json.dumps({"sessionID": self.coder, "tool": "shell", "outcome": "ask", "arguments": "x" * 70000})
        reply = self.judge_tool(None, raw=text)
        self.assertEqual((reply["outcome"], reply["judged"]), ("allow", False), "the cut-off text cannot be read: no change")
        self.assertIn("larger than", reply["reason"])

    def test_a_broken_config_still_exits_zero_with_the_configured_outcome(self):
        self.write_config("{broken")
        reply = self.judge_tool(self.coder, "shell", "x", "ask")
        self.assertEqual((reply["outcome"], reply["judged"]), ("ask", False))
        self.assertIn("the judge failed", reply["reason"])

    def test_a_bad_fault_name_still_exits_zero(self):
        os.environ[sb.FAULT_ENV] = "no-such-fault"
        self.assertEqual(self.judge_tool(self.coder, "shell", "x", "ask")["outcome"], "ask")

    def test_an_unexpected_error_inside_the_judge_cannot_escape(self):
        with mock.patch.object(sb, "build_policy_judge", side_effect=RuntimeError("boom")):
            reply = self.judge_tool(self.coder, "shell", "x", "ask")
        self.assertEqual((reply["outcome"], reply["judged"]), ("ask", False))
        self.assertIn("RuntimeError", reply["reason"])

    def test_without_an_opencode_binary_the_judge_cannot_identify_and_says_so(self):
        self.write_config({"herdr": FAKE_HERDR, "intent_repo": FAKE_REPO, "gh": FAKE_GH, "policy": {"enabled": True},
                           "jev": {"replay": policy_replay_file(self.home, [{"noul": LOW}])}})
        reply = self.judge_tool(self.coder, "shell", "x", "ask")
        self.assertEqual((reply["outcome"], reply["judged"]), ("ask", False))

    def test_the_command_is_registered_and_listed(self):
        with captured() as (out, _):
            self.assertEqual(sb.main(["--help"]), 0)
        self.assertIn("judge-tool", out.getvalue())


class TestJudgeToolBudget(PolicyCase):
    class Blocking:
        def __init__(self, release, inner):
            self.release, self.inner, self.calls = release, inner, 0

        def decide(self, state, questions):
            self.calls += 1
            self.release.wait(10)
            return self.inner.decide(state, questions)

    def request(self, outcome="allow", arguments="git push --force"):
        return sb.parse_policy_request(json.dumps(
            {"sessionID": self.coder, "tool": "shell", "arguments": arguments, "outcome": outcome}))

    def test_no_answer_within_the_budget_keeps_the_configured_outcome(self):
        release = threading.Event()
        self.addCleanup(release.set)
        jev = self.Blocking(release, FakeJev(noul_answers(**dict(LOW, hard_to_reverse=0.9))))
        judge = self.direct_judge(jev, budget_ms=60)
        started = time.monotonic()
        reply = judge.decide(self.request())
        self.assertLess(time.monotonic() - started, 5, "the call must not wait for Jev")
        self.assertEqual((reply["outcome"], reply["judged"]), ("allow", False))
        self.assertIn("no answer within 60 ms", reply["reason"])
        self.assertIn("asking the decision model", reply["reason"])
        self.assertGreaterEqual(reply["latency_ms"], 55)
        self.assertEqual(self.audit_events()[-1]["detail"]["outcome"], "allow")

    def test_a_late_answer_fills_the_cache_so_the_next_identical_call_is_fast_and_right(self):
        release = threading.Event()
        jev = self.Blocking(release, FakeJev(noul_answers(**dict(LOW, hard_to_reverse=0.9))))
        judge = self.direct_judge(jev, budget_ms=60)
        self.assertEqual(judge.decide(self.request())["outcome"], "allow")
        release.set()
        judge.finish_late()
        again = self.direct_judge(jev, budget_ms=60).decide(self.request())
        self.assertEqual((again["outcome"], again["judged"], again["cached"]), ("ask", True, True))
        self.assertEqual(jev.calls, 1)

    def test_a_slow_cold_ask_lookup_is_inside_the_budget_too(self):
        class SlowGH:
            def __init__(self, inner, release):
                self.inner, self.release = inner, release

            def __call__(self, argv, **kwargs):
                self.release.wait(10)
                return self.inner(argv, **kwargs)

        release = threading.Event()
        self.addCleanup(release.set)
        self.reader.runner = SlowGH(self.gh, release)
        jev = FakeJev(noul_answers(**LOW))
        reply = self.direct_judge(jev, budget_ms=60).decide(self.request())
        self.assertEqual((reply["outcome"], reply["judged"], len(jev.calls)), ("allow", False, 0))
        self.assertIn("resolving the ask", reply["reason"])

    def test_the_budget_is_the_config_value(self):
        self.assertEqual(self.direct_judge(FakeJev(noul_answers(**LOW))).settings["budget_ms"], 900)


class TestJudgeToolCache(PolicyCase):
    def request(self, **change):
        body = dict({"sessionID": self.coder, "tool": "shell", "arguments": "git push --force", "outcome": "allow"}, **change)
        return sb.parse_policy_request(json.dumps(body))

    def setUp(self):
        super().setUp()
        self.jev = PolicyCountingJev(FakeJev(noul_answers(**dict(LOW, hard_to_reverse=0.9))))
        self.judge = self.direct_judge(self.jev)

    def test_an_identical_call_is_answered_from_the_cache_in_a_new_process(self):
        first = self.judge.decide(self.request())
        again = self.direct_judge(self.jev).decide(self.request())  # a new object: nothing in memory is shared
        self.assertEqual((first["cached"], again["cached"], self.jev.calls), (False, True, 1))
        self.assertEqual((first["outcome"], again["outcome"]), ("ask", "ask"))
        self.assertEqual(again["judged"], True)

    def test_a_different_session_tool_or_arguments_is_judged_afresh(self):
        self.judge.decide(self.request())
        self.judge.decide(self.request(arguments="git push --force origin dev"))
        self.judge.decide(self.request(tool="other"))
        self.judge.decide(self.request(sessionID=self.orch))
        self.assertEqual(self.jev.calls, 4)

    def test_a_different_configured_outcome_reuses_the_answers_but_never_loosens(self):
        self.judge.decide(self.request(outcome="allow"))
        stricter = self.judge.decide(self.request(outcome="ask"))
        self.assertEqual((stricter["outcome"], stricter["cached"], self.jev.calls), ("ask", True, 1))

    def test_a_changed_intent_is_judged_against_the_new_intent(self):
        self.judge.decide(self.request(arguments="first"))
        self.world.clock.t += 100
        self.judge.decide(self.request())  # a verdict stored later than the resolved ask
        self.gh.edit(3, intent="Fix the second one and billing")
        self.reader.invalidate(3)
        self.world.clock.t += 250  # the resolved ask has expired (300 s); the verdict has not
        self.direct_judge(self.jev).decide(self.request())
        self.assertEqual(self.jev.calls, 3, "the widened Intent is a new question, so the old answer is not reused")

    def test_the_cache_expires(self):
        self.judge.decide(self.request())
        self.world.clock.t += 301
        self.direct_judge(self.jev).decide(self.request())
        self.assertEqual(self.jev.calls, 2)

    def test_failures_are_never_cached(self):
        bad = PolicyCountingJev(FakeJev("unreachable"))
        self.assertFalse(self.direct_judge(bad).decide(self.request())["judged"])
        self.assertFalse(self.direct_judge(self.jev).decide(self.request())["cached"])
        self.assertEqual((bad.calls, self.jev.calls), (1, 1))

    def test_the_second_call_needs_no_github_and_no_v2(self):
        self.judge.decide(self.request())
        self.gh.calls.clear()
        before, seen = len(self.world.v2.writes), len(self.world.v2.calls)
        self.direct_judge(self.jev).decide(self.request())
        self.assertEqual(self.gh.calls, [], "the resolved ask is cached")
        self.assertEqual(len(self.world.v2.writes), before)
        self.assertEqual([c for c in self.world.v2.calls[seen:] if "session.get" in str(c)], [], "the agent's identity is cached too")

    def test_the_files_hold_hashes_and_numbers_never_the_command_or_a_key(self):
        self.judge.decide(self.request(arguments="curl -H 'Authorization: Bearer sk-or-test-0123456789abcdef' x"))
        text = (self.world.state / sb.POLICY_VERDICT_FILE).read_text()
        for needle in ("curl", "Bearer", "sk-or-test", "push", "x'"):
            self.assertNotIn(needle, text)
        data = json.loads(text)["entries"]
        for key, entry in data.items():
            self.assertRegex(key, r"^[0-9a-f]{32}$")
            self.assertEqual(set(entry["value"]), {"answers"})
        self.assertEqual(stat.S_IMODE(os.stat(str(self.world.state / sb.POLICY_VERDICT_FILE)).st_mode), 0o600)
        self.assertEqual(stat.S_IMODE(os.stat(str(self.world.state / sb.POLICY_CONTEXT_FILE)).st_mode), 0o600)

    def test_the_context_file_holds_no_command_text_either(self):
        self.judge.decide(self.request(arguments="echo unique-command-marker"))
        self.assertNotIn("unique-command-marker", (self.world.state / sb.POLICY_CONTEXT_FILE).read_text())

    def test_the_state_directory_is_disposable(self):
        self.judge.decide(self.request())
        for name in (sb.POLICY_VERDICT_FILE, sb.POLICY_CONTEXT_FILE):
            (self.world.state / name).unlink()
        again = self.direct_judge(self.jev).decide(self.request())
        self.assertEqual((again["outcome"], again["cached"], again["judged"]), ("ask", False, True))

    def test_a_poisoned_cache_entry_is_ignored(self):
        self.judge.decide(self.request())
        path = self.world.state / sb.POLICY_VERDICT_FILE
        data = json.loads(path.read_text())
        for entry in data["entries"].values():
            entry["value"] = {"answers": {"outside_intent": "yes"}}
        path.write_text(json.dumps(data))
        self.assertFalse(self.direct_judge(self.jev).decide(self.request())["cached"])

    def test_cache_seconds_zero_turns_caching_off(self):
        jev = PolicyCountingJev(FakeJev(noul_answers(**LOW)))
        judge = self.direct_judge(jev, cache_seconds=0)
        for _ in range(2):
            judge.decide(self.request())
        self.assertEqual(jev.calls, 2)
        self.assertFalse((self.world.state / sb.POLICY_VERDICT_FILE).exists())


class TestJudgeToolSecrets(PolicyCase):
    """The OpenRouter key and credential-shaped arguments appear nowhere but the request's Authorization header."""

    def setUp(self):
        super().setUp()
        os.environ["OPENROUTER_API_KEY"] = KEY_VALUE
        body = jev_reply(noul_answers(**dict(LOW, hard_to_reverse=0.9)))
        self.opener = FakeOpener(body)
        self.client = sb.JevClient(dict(JEV_SETTINGS), opener=self.opener)
        self.config = policy_raw_config()
        self.judge = sb.PolicyJudge(self.config, self.world.engine.v2, self.reader, self.client,
                                    sb.AuditLog(self.world.audit_path), self.world.state, self.world.clock.now)

    def everything_written(self):
        text = (self.world.audit_path).read_text()
        for name in (sb.POLICY_VERDICT_FILE, sb.POLICY_CONTEXT_FILE):
            path = self.world.state / name
            text += path.read_text() if path.exists() else ""
        return text

    def decide(self, arguments):
        return self.judge.decide(sb.parse_policy_request(json.dumps(
            {"sessionID": self.coder, "tool": "shell", "arguments": arguments, "outcome": "allow"})))

    def test_the_key_is_sent_only_as_the_authorization_header(self):
        reply = self.decide("git push --force")
        self.assertEqual(reply["outcome"], "ask")
        sent = self.opener.calls[0]
        self.assertEqual(sent["headers"]["Authorization"], "Bearer " + KEY_VALUE)
        self.assertNotIn(KEY_VALUE, json.dumps(sent["body"]))
        self.assertNotIn(KEY_VALUE, json.dumps(reply))
        self.assertNotIn(KEY_VALUE, self.everything_written())

    def test_a_key_or_token_inside_the_command_reaches_neither_jev_nor_a_file_nor_the_reply(self):
        for secret in (KEY_VALUE, "ghp_0123456789abcdefABCDEF", "hunter2hunter2"):
            with self.subTest(secret=secret):
                bare = " -H 'X: %s'" % secret if secret.startswith(("sk-", "ghp_")) else ""  # only prefixed shapes are caught bare
                reply = self.decide("curl -u me:x --password %s --token=%s https://example.test/?auth=%s%s"
                                    % (secret, secret, secret, bare))
                self.assertNotIn(secret, json.dumps(self.opener.calls[-1]["body"]))
                self.assertNotIn(secret, json.dumps(reply))
                self.assertNotIn(secret, self.everything_written())

    def test_a_failing_jev_leaks_nothing_into_the_reply_or_the_audit(self):
        self.opener.reply = http_error(401, ("bad key %s" % KEY_VALUE).encode())
        reply = self.decide("git push")
        self.assertEqual((reply["outcome"], reply["judged"]), ("allow", False))
        self.assertNotIn(KEY_VALUE, json.dumps(reply))
        self.assertNotIn(KEY_VALUE, self.everything_written())

    def test_the_cli_never_has_a_key_in_its_arguments(self):
        # judge-tool takes no options at all: nothing a caller could put a key into.
        parser = sb.build_parser()
        args = parser.parse_args(["judge-tool"])
        self.assertEqual(vars(args), {"action": "judge-tool"})
        with self.assertRaises(SystemExit), captured():
            parser.parse_args(["judge-tool", "--key", "x"])


CANARY = "canary-key-7f3a9c1e5b2d"  # a made-up key: it only has to be findable


class TestJudgeSocket(PolicyCase):
    """The daemon holds the key; judge-tool talks to it over $STATE/judge.sock."""

    def sock_path(self):
        return self.world.state / sb.POLICY_SOCKET

    def raw_exchange(self, payload, shutdown=True, timeout=5):
        conn = sb.socket.socket(sb.socket.AF_UNIX, sb.socket.SOCK_STREAM)
        conn.settimeout(timeout)
        with sb.in_directory(self.world.state):
            conn.connect(sb.POLICY_SOCKET)
        try:
            try:
                conn.sendall(payload)
                if shutdown:
                    conn.shutdown(sb.socket.SHUT_WR)
            except OSError:
                pass  # the daemon answered and hung up before it had read everything
            try:
                return sb.read_judge_line(conn, 10 ** 6)
            except ConnectionResetError:
                return b""  # hung up on with unread input: the reply may be lost with the reset
        finally:
            conn.close()

    def test_the_socket_is_private_and_named_in_the_state_directory(self):
        self.assertEqual(stat.S_IMODE(os.stat(str(self.sock_path())).st_mode), 0o600)
        self.assertEqual(os.stat(str(self.sock_path())).st_uid, os.getuid())

    def test_it_is_private_even_under_a_permissive_umask(self):
        self.server.stop()
        before = os.umask(0)
        try:
            server = sb.JudgeServer(self.world.state, lambda text: sb.policy_reply("allow", "x")).start()
        finally:
            os.umask(before)
        self.addCleanup(server.stop)
        self.assertEqual(stat.S_IMODE(os.stat(str(self.sock_path())).st_mode), 0o600)

    def test_one_request_one_reply_per_connection(self):
        raw = self.raw_exchange(json.dumps({"sessionID": self.coder, "tool": "shell", "arguments": "ls",
                                            "outcome": "allow"}).encode())
        self.assertEqual(json.loads(raw)["outcome"], "allow")
        self.assertEqual(raw.count(b"\n"), 1)

    def test_oversize_input_is_refused_and_never_judged(self):
        calls = []
        self.server.handle = lambda text: calls.append(text) or sb.policy_reply("allow", "x")
        raw = self.raw_exchange(b'{"outcome": "ask", "x": "' + b"a" * (sb.POLICY_STDIN_LIMIT + 5000) + b'"}')
        self.assertEqual(calls, [])
        if raw:
            self.assertIn("larger than", json.loads(raw)["reason"])

    def test_a_silent_client_is_dropped_after_the_read_timeout(self):
        with mock.patch.object(sb, "POLICY_READ_SECONDS", 0.2):
            self.server.stop()
            server = sb.JudgeServer(self.world.state, lambda text: sb.policy_reply("allow", "x")).start()
            self.addCleanup(server.stop)
            started = time.monotonic()
            self.assertEqual(self.raw_exchange(b"", shutdown=False, timeout=5), b"")
            self.assertLess(time.monotonic() - started, 3)

    def test_a_stale_socket_file_is_replaced(self):
        self.server.stop()
        self.sock_path().write_text("stale")
        server = sb.JudgeServer(self.world.state, lambda text: sb.policy_reply("deny", "x")).start()
        self.addCleanup(server.stop)
        self.assertEqual(json.loads(self.raw_exchange(b'{"outcome": "deny"}'))["outcome"], "deny")

    def test_stopping_removes_the_socket(self):
        self.server.stop()
        self.assertFalse(self.sock_path().exists())

    def test_a_dead_daemon_yields_the_configured_outcome(self):
        self.server.stop()
        for state in ("missing", "stale"):
            if state == "stale":
                self.sock_path().write_text("not a socket")
            with self.subTest(socket=state):
                reply = self.judge_tool(self.coder, "shell", "git push --force", "ask")
                self.assertEqual((reply["outcome"], reply["judged"]), ("ask", False))
                self.assertIn("not reachable", reply["reason"])
                self.assertIn("configured outcome stands", reply["reason"])

    def test_a_late_daemon_yields_the_configured_outcome_without_waiting_for_it(self):
        release = threading.Event()
        self.addCleanup(release.set)
        self.server.handle = lambda text: release.wait(10) and sb.policy_reply("deny", "late")
        self.configure([{"noul": LOW}], budget_ms=100)
        started = time.monotonic()
        reply = self.judge_tool(self.coder, "shell", "x", "ask")
        self.assertLess(time.monotonic() - started, 4)
        self.assertEqual((reply["outcome"], reply["judged"]), ("ask", False))
        self.assertIn("did not answer in time", reply["reason"])

    def test_a_daemon_that_answers_garbage_is_ignored(self):
        for answer in (None, "x", {"outcome": "permit"}, {}):
            with self.subTest(answer=answer):
                self.server.handle = lambda text, answer=answer: answer
                reply = self.judge_tool(self.coder, "shell", "x", "ask")
                self.assertEqual((reply["outcome"], reply["judged"]), ("ask", False))

    def test_the_daemon_judges_with_its_own_key_and_the_client_has_none(self):
        os.environ["OPENROUTER_API_KEY"] = CANARY
        opener = FakeOpener(jev_reply(noul_answers(**dict(LOW, hard_to_reverse=0.9))))
        original = sb.build_jev
        with mock.patch.object(sb, "build_jev", lambda config: sb.JevClient(dict(JEV_SETTINGS), opener=opener)):
            reply = self.judge_tool(self.coder, "shell", "git push --force", "allow")
        self.assertEqual(reply["outcome"], "ask")
        self.assertEqual(opener.calls[0]["headers"]["Authorization"], "Bearer " + CANARY)
        self.assertIsNotNone(original)

    def test_judge_tool_reads_no_environment_variable_and_never_names_jev(self):
        source = SWITCHBOARD.read_text()
        tree = ast.parse(source)
        wanted = {"cmd_judge_tool", "ask_judge_daemon", "never_looser", "read_judge_line", "parse_policy_request",
                  "policy_unjudged_reason", "policy_reply", "_guess_configured"}
        found = {n.name: n for n in ast.walk(tree) if isinstance(n, ast.FunctionDef) and n.name in wanted}
        self.assertEqual(set(found), wanted)
        for name, node in found.items():
            names = {n.id for n in ast.walk(node) if isinstance(n, ast.Name)} | \
                {n.attr for n in ast.walk(node) if isinstance(n, ast.Attribute)}
            strings = {n.value for n in ast.walk(node) if isinstance(n, ast.Constant) and isinstance(n.value, str)}
            with self.subTest(function=name):
                self.assertEqual(sorted(names & {"environ", "getenv", "environb", "key_env", "JevClient", "build_jev",
                                                 "ReplayJev", "decide", "build_policy_judge", "PolicyJudge"}), [])
                self.assertFalse([s for s in strings if "OPENROUTER" in s or "key_env" in s])

    def test_run_as_a_real_process_with_a_canary_in_its_environment_the_canary_goes_nowhere(self):
        self.server.stop()  # no daemon: the real process falls back, and must not have used the canary at all
        env = dict(os.environ, OPENROUTER_API_KEY=CANARY)
        done = subprocess.run([sys.executable, "-B", str(SWITCHBOARD), "judge-tool"], capture_output=True, text=True,
                              env=env, input=json.dumps({"sessionID": self.coder, "tool": "shell",
                                                         "arguments": "echo " + CANARY, "outcome": "ask"}))
        self.assertEqual(done.returncode, 0, done.stderr)
        reply = json.loads(done.stdout)
        self.assertEqual((reply["outcome"], reply["judged"]), ("ask", False))
        everything = done.stdout + done.stderr + (self.world.audit_path.read_text() if self.world.audit_path.exists() else "")
        for path in self.world.state.iterdir():
            if path.is_file():
                everything += path.read_text(errors="replace")
        self.assertNotIn(CANARY, everything.replace("echo " + CANARY, ""), "only the command the caller itself sent may contain it")
        self.assertNotIn(CANARY, done.stdout + done.stderr)

    def test_the_cli_run_starts_the_socket_only_when_the_judge_is_enabled(self):
        self.server.stop()
        config = sb.load_config()
        started = sb.start_judge_server(config, self.world.state, self.route, self.world.clock.now)
        self.addCleanup(started.stop)
        self.assertTrue(self.sock_path().exists())
        started.stop()
        self.configure(enabled=False)
        self.assertIsNone(sb.start_judge_server(sb.load_config(), self.world.state, self.route, self.world.clock.now))
        self.assertFalse(self.sock_path().exists())


class TestJudgeToolWritesNothingElsewhere(unittest.TestCase):
    """One AST test: the policy section never writes to GitHub or herdr."""

    START, END = "# PR 9: the tool-call policy judge", "def build_parser():"
    FORBIDDEN_NAMES = {"HerdrClient", "herdr", "notification_show", "pane_report_metadata", "agent_prompt",
                       "agent_send_keys", "launch_agent", "send_poke", "cmd_send", "cmd_launch", "GitHubHub"}
    WRITE_FLAGS = ("--method", "-X", "--input", "-f", "-F", "--field", "--raw-field", "POST", "PATCH", "PUT", "DELETE")
    WRITE_PHRASES = ("issue comment", "issue edit", "pr merge", "pr comment", "sub_issues", "/comments", "/labels")

    def section(self):
        source = SWITCHBOARD.read_text()
        start = source.index(self.START)
        return source[source.rindex("\n# ====", 0, start):source.index(self.END, start)]

    def test_no_herdr_and_no_github_write_is_reachable_from_the_section(self):
        tree = ast.parse(self.section())
        names = {n.id for n in ast.walk(tree) if isinstance(n, ast.Name)} | \
            {n.attr for n in ast.walk(tree) if isinstance(n, ast.Attribute)}
        self.assertEqual(sorted(names & self.FORBIDDEN_NAMES), [])
        strings = [n.value for n in ast.walk(tree) if isinstance(n, ast.Constant) and isinstance(n.value, str)]
        for text in strings:
            self.assertNotIn(text, self.WRITE_FLAGS)
            for phrase in self.WRITE_PHRASES:
                self.assertNotIn(phrase, text)

    def test_its_only_github_reads_are_get_calls_through_the_reader(self):
        tree = ast.parse(self.section())
        calls = [n for n in ast.walk(tree) if isinstance(n, ast.Call) and isinstance(n.func, ast.Attribute)
                 and n.func.attr == "_api"]
        self.assertEqual(len(calls), 1)
        self.assertEqual(herdr_typing_violations(SWITCHBOARD.read_text()), [], "the engine still never types")

    def test_the_section_is_one_clearly_marked_block(self):
        self.assertEqual(SWITCHBOARD.read_text().count("\n# PR 9: the tool-call policy judge"), 1)


class TestPolicyBlockedToast(PR4Base):
    """Shared behaviour: a hook's message on a permission request is the toast's reason."""

    def blocked(self, message=None):
        ask = self.block(resources=["git push --force"])
        if message:
            ask["message"] = message
        (fact,) = [f for f in self.derive() if f.kind == sb.WORKER_BLOCKED]
        self.world.engine.run_pass()
        (toast,) = self.toasts()
        return fact, toast

    def test_the_reason_leads_the_toast_and_goes_to_the_boss(self):
        fact, toast = self.blocked("Needs your yes: hard to reverse (shell: git push --force).")
        self.assertIn("waiting for you: Needs your yes: hard to reverse", toast["body"])
        self.assertIn("(reason given: Needs your yes: hard to reverse", fact.summary)

    def test_without_a_message_the_toast_is_as_before(self):
        fact, toast = self.blocked()
        self.assertIn("waiting for you: shell git push --force", toast["body"])
        self.assertNotIn("reason given", fact.summary)


# ------------------------------------------------------------------ scenarios

class TestPolicyScenarios(Base):
    """P1 to P6: the files exist, run offline, and their controls fail what they say."""

    EXPECTED = {"P1": "no-policy-judge", "P2": "no-policy-judge", "P3": "no-policy-judge", "P4": "judge-loosens",
                "P5": "judge-loosens", "P6": None}

    def load(self, sid):
        return next(s for s in map(sc.load, sc.scenario_files(sc.DEFAULT_DIR)) if s["id"] == sid)

    def test_the_catalog_is_present_with_honest_tiers(self):
        for sid, fault in self.EXPECTED.items():
            with self.subTest(scenario=sid):
                scenario = self.load(sid)
                self.assertEqual(scenario["since_pr"], 9)
                self.assertIn("offline", scenario["tiers"])
                self.assertEqual(scenario["control"].get("fault"), fault)
                self.assertNotIn("lab-scripted", scenario["tiers"], "the real plugin is not built into the Lab runner yet")

    def test_each_scenario_is_in_the_offline_suite(self):
        for sid in self.EXPECTED:
            name = "test_scenario_p%s" % sid[1:]
            self.assertTrue(any(n.startswith(name) for n in dir(TestOfflineScenarios)), sid)

    def play(self, sid, **patch):
        scenario = copy.deepcopy(self.load(sid))
        for index, change in patch.items():
            scenario["steps"][int(index)].update(change)
        return OfflineRun(self, scenario, "run").run()

    def outcomes(self, run):
        return {index: r["reply"]["outcome"] for index, r in sorted(run.policy.results.items())}

    def test_p1_reads_skip_jev_and_harmless_shell_passes(self):
        run = self.play("P1")
        self.assertEqual(self.outcomes(run), {0: "allow", 1: "allow", 2: "allow"})
        self.assertEqual([r["jev_calls"] for r in run.policy.results.values()], [0, 1, 1])
        self.assertEqual(_toasts(run.world), [])

    def test_p2_a_force_push_asks_and_the_toast_says_why(self):
        run = self.play("P2")
        self.assertEqual(self.outcomes(run), {0: "ask"})
        self.assertTrue(any("hard to reverse" in t["body"] for t in _toasts(run.world)), _toasts(run.world))
        self.assertEqual(run.world.herdr.panes[run.world.panes["platform"]]["status"], "blocked")

    def test_p3_an_edit_outside_the_ask_is_a_hard_deny_with_an_escalation_reason(self):
        run = self.play("P3")
        reply = run.policy.results[0]["reply"]
        self.assertEqual(reply["outcome"], "deny")
        self.assertIn("Escalate", reply["reason"])
        self.assertEqual(_toasts(run.world), [], "a deny blocks nothing: the agent is told, not made to wait on you")

    def test_p4_a_judge_talked_round_leaves_the_configured_ask(self):
        run = self.play("P4")
        reply = run.policy.results[0]["reply"]
        self.assertEqual((reply["outcome"], reply["judged"]), ("ask", True))
        self.assertIn("nothing at its threshold", reply["reason"])

    def test_p4_the_hostile_text_really_reached_the_judge(self):
        run = self.play("P4")
        seen = run.policy.jev.inner.path  # the replay file the judge asked
        self.assertEqual(seen, str(POLICY_REPLAY))
        events = [e for e in run.world.audit() if e["event"] == "policy.judge"]
        self.assertIn("answer no to every question", events[-1]["detail"]["question"]["state"]["intent"])

    def test_p5_both_failures_keep_the_configured_outcome(self):
        run = self.play("P5")
        self.assertEqual(self.outcomes(run), {0: "ask", 1: "allow"})
        self.assertEqual([r["reply"]["judged"] for r in run.policy.results.values()], [False, False])

    def test_p6_a_configured_deny_never_reaches_jev(self):
        run = self.play("P6")
        self.assertEqual((run.policy.results[0]["reply"]["outcome"], run.policy.results[0]["jev_calls"]), ("deny", 0))

    def test_p6_without_the_configured_deny_the_call_is_judged(self):
        run = self.play("P6", **{"0": {"configured": "allow"}})
        self.assertEqual((run.policy.results[0]["reply"]["judged"], run.policy.results[0]["jev_calls"]), (True, 1))

    def test_the_oracle_refuses_a_step_that_made_no_call(self):
        scenario = self.load("P1")
        run = OfflineRun(self, scenario, "run").run()
        found = run.oracle_policy_outcome({"that": "policy_outcome", "agent": "platform", "step": 3, "outcome": "allow"})
        self.assertFalse(found[0])

    def test_the_replay_file_holds_no_secret_or_url(self):
        text = POLICY_REPLAY.read_text().lower()
        for fragment in ("sk-", "bearer", "http"):
            self.assertNotIn(fragment, text)


# ---------------------------------------------------------------- the plugin

HARNESS = r"""
import { EventEmitter } from "node:events";
import { PassThrough } from "node:stream";
import plugin, * as hooks from "%(url)s";

const results = {};
const spawns = [];

function fakeSpawn(script) {
  return (bin, args, opts) => {
    const child = new EventEmitter();
    child.stdin = new PassThrough();
    child.stdout = new PassThrough();
    child.killed = null;
    child.kill = (signal) => { child.killed = signal; };
    child.unref = () => {};
    let written = "";
    child.stdin.on("data", (c) => { written += c; });
    const record = { bin, args, opts, child, get stdin() { return written; } };
    spawns.push(record);
    if (script.throws) throw new Error("spawn failed");
    if (script.error) setTimeout(() => child.emit("error", new Error("ENOENT")), 1);
    else if (script.reply !== undefined) {
      setTimeout(() => {
        if (script.reply !== null) child.stdout.write(script.reply + "\n");
        if (script.close !== false) child.emit("close", 0);
      }, script.delayMs || 1);
    }
    return child;
  };
}

async function run(name, input, script, timeoutMs = 300) {
  const spawnFn = fakeSpawn(script);
  const handler = hooks.makeHandler({ bin: "/abs/fleet-switchboard", timeoutMs, spawnFn });
  const started = Date.now();
  await handler(input);
  const last = spawns[spawns.length - 1];
  results[name] = { effect: input.effect, message: input.message, ms: Date.now() - started,
                    killed: last ? last.child.killed : null, spawned: spawns.length };
}

const base = (effect) => ({ sessionID: "ses_abc", agent: "coder", action: "shell", resources: ["git push --force"], effect });
const reply = (outcome, reason = "why") => JSON.stringify({ outcome, reason, judged: true, cached: false, latency_ms: 5 });

%(body)s

console.log(JSON.stringify(results));
"""

HARNESS_CASES = r"""
await run("tighten-allow-to-ask", base("allow"), { reply: reply("ask", "Needs your yes") });
await run("tighten-allow-to-deny", base("allow"), { reply: reply("deny", "Denied") });
await run("tighten-ask-to-deny", base("ask"), { reply: reply("deny", "Denied") });
await run("never-loosen-ask-to-allow", base("ask"), { reply: reply("allow", "fine") });
await run("never-loosen-deny-to-ask", base("deny"), { reply: reply("ask", "fine") });
await run("same-ask-changes-nothing", base("ask"), { reply: reply("ask", "same") });
await run("timeout-keeps-configured", base("allow"), { reply: undefined }, 80);
await run("garbage-keeps-configured", base("allow"), { reply: "not json at all" });
await run("bad-outcome-keeps-configured", base("allow"), { reply: JSON.stringify({ outcome: "permit", reason: "x" }) });
await run("no-line-keeps-configured", base("allow"), { reply: null });
await run("spawn-error-keeps-configured", base("allow"), { error: true });
await run("spawn-throws-keeps-configured", base("allow"), { throws: true });
await run("bad-input-spawns-nothing", { action: "shell", effect: "allow" }, { reply: reply("deny") });
const spawnedBefore = spawns.length;
await run("unlisted-action-spawns-nothing", { sessionID: "ses_abc", action: "read", resources: ["a"], effect: "allow" }, { reply: reply("deny") });
results["unlisted-spawned"] = spawns.length - spawnedBefore;
results["request"] = hooks.requestOf({ sessionID: "ses_q", action: "shell", resources: ["a", 5, "b"], effect: "ask" });
results["tools"] = ["shell", "bash", "edit", "write", "webfetch", "task", "subagent", "read", "glob", "grep", "skill", "mcp_x", "toString", "constructor", undefined]
  .map((a) => hooks.toolOf(a));
results["stricter"] = [["ask","allow"],["allow","ask"],["ask","deny"],["ask","ask"],["ask","bogus"]]
  .map(([r, c]) => hooks.isStricter({ outcome: r }, c));
results["settings"] = [
  hooks.settingsOf({ FLEET_SWITCHBOARD_BIN: "fleet-switchboard" }),
  hooks.settingsOf({}),
  hooks.settingsOf({ FLEET_SWITCHBOARD_BIN: "/abs/x", FLEET_HOOKS_TIMEOUT_MS: "250" }),
  hooks.settingsOf({ FLEET_SWITCHBOARD_BIN: "/abs/x", FLEET_HOOKS_TIMEOUT_MS: "nope" }),
];
process.env.OPENROUTER_API_KEY = "canary-in-service-env";
process.env.FLEET_SWITCHBOARD_LAB = "1";
await run("env-probe", base("allow"), { reply: reply("allow") });
const probe = spawns[spawns.length - 1];
results["child-env"] = { keys: Object.keys(probe.opts.env).sort(), hasCanary: JSON.stringify(probe.opts.env).includes("canary") };
const first = spawns[0];
results["spawn-shape"] = { bin: first.bin, args: first.args, shell: first.opts.shell, stdio: first.opts.stdio,
                           stdin: JSON.parse(first.stdin) };
const registered = [];
await plugin.setup({ permission: { hook: (name, fn) => registered.push([name, typeof fn]) } }, { FLEET_SWITCHBOARD_BIN: "/abs/x" });
const unregistered = [];
await plugin.setup({ permission: { hook: (name) => unregistered.push(name) } }, {});
await plugin.setup({ permission: { hook: (name) => unregistered.push(name) } }, { FLEET_SWITCHBOARD_BIN: "relative/x" });
results["registration"] = { registered, unregistered, id: plugin.id, setupIsFunction: typeof plugin.setup };
"""


@unittest.skipUnless(NODE, "node is not installed: the fleet-hooks plugin tests need it (skipped, not passed)")
class TestFleetHooksPlugin(Base):
    def run_harness(self, body, index=None):
        source = Path(index or FLEET_HOOKS / "index.js")
        script = self.home / "harness.mjs"
        script.write_text(HARNESS % {"url": source.resolve().as_uri(), "body": body})
        done = subprocess.run([NODE, str(script)], capture_output=True, text=True, timeout=60)
        self.assertEqual(done.returncode, 0, done.stderr)
        return json.loads(done.stdout.strip().splitlines()[-1])

    def setUp(self):
        super().setUp()
        self.results = self.run_harness(HARNESS_CASES)

    def effect(self, name):
        return self.results[name]["effect"], self.results[name].get("message")

    def test_a_stricter_reply_is_applied_with_its_reason(self):
        self.assertEqual(self.effect("tighten-allow-to-ask"), ("ask", "Needs your yes"))
        self.assertEqual(self.effect("tighten-allow-to-deny"), ("deny", "Denied"))
        self.assertEqual(self.effect("tighten-ask-to-deny"), ("deny", "Denied"))

    def test_a_reply_that_is_not_stricter_is_never_applied(self):
        self.assertEqual(self.effect("never-loosen-ask-to-allow"), ("ask", None))
        self.assertEqual(self.effect("never-loosen-deny-to-ask"), ("deny", None))
        self.assertEqual(self.effect("same-ask-changes-nothing"), ("ask", None))

    def test_a_hung_child_is_killed_and_the_configured_outcome_stands(self):
        result = self.results["timeout-keeps-configured"]
        self.assertEqual((result["effect"], result.get("message"), result["killed"]), ("allow", None, "SIGKILL"))
        self.assertLess(result["ms"], 1000)

    def test_every_unusable_reply_leaves_the_configured_outcome(self):
        for name in ("garbage-keeps-configured", "bad-outcome-keeps-configured", "no-line-keeps-configured",
                     "spawn-error-keeps-configured", "spawn-throws-keeps-configured"):
            with self.subTest(case=name):
                self.assertEqual(self.effect(name), ("allow", None))

    def test_input_without_a_session_spawns_nothing(self):
        self.assertEqual(self.effect("bad-input-spawns-nothing"), ("allow", None))

    def test_the_request_and_the_spawn(self):
        self.assertEqual(self.results["request"], {"sessionID": "ses_q", "tool": "shell", "arguments": "a\nb", "outcome": "ask"})
        shape = self.results["spawn-shape"]
        self.assertEqual((shape["bin"], shape["args"], shape["shell"]), ("/abs/fleet-switchboard", ["judge-tool"], False))
        self.assertEqual(shape["stdio"], ["pipe", "pipe", "ignore"])
        self.assertEqual(shape["stdin"], {"sessionID": "ses_abc", "tool": "shell", "arguments": "git push --force",
                                          "outcome": "allow"})

    def test_actions_map_to_the_cli_tool_kinds(self):
        self.assertEqual(self.results["tools"], ["shell", None, "edit", None, "webfetch", "subagent", "subagent", None, None,
                                                 None, None, None, None, None, None])

    def test_an_action_the_plugin_does_not_forward_spawns_nothing_and_keeps_the_configured_outcome(self):
        self.assertEqual(self.effect("unlisted-action-spawns-nothing"), ("allow", None))
        self.assertEqual(self.results["unlisted-spawned"], 0)

    def test_the_child_gets_a_short_allow_list_of_variables_never_the_services_whole_environment(self):
        env = self.results["child-env"]
        self.assertFalse(env["hasCanary"])
        self.assertNotIn("OPENROUTER_API_KEY", env["keys"])
        self.assertIn("FLEET_SWITCHBOARD_LAB", env["keys"])
        self.assertLessEqual(set(env["keys"]) - {"FLEET_SWITCHBOARD_LAB"},
                             {"PATH", "HOME", "TMPDIR", "LANG", "XDG_CONFIG_HOME", "XDG_STATE_HOME", "XDG_RUNTIME_DIR"})

    def test_stricter_is_strict(self):
        self.assertEqual(self.results["stricter"], [True, False, False, False, False])

    def test_the_binary_comes_from_the_environment_never_from_path(self):
        none, empty, given, bad_timeout = self.results["settings"]
        self.assertIsNone(none["bin"])
        self.assertIsNone(empty["bin"])
        self.assertEqual((given["bin"], given["timeoutMs"]), ("/abs/x", 250))
        self.assertEqual(bad_timeout["timeoutMs"], 1500)

    def test_registration_is_one_evaluate_hook_and_only_when_configured(self):
        registration = self.results["registration"]
        self.assertEqual(registration["registered"], [["evaluate", "function"]])
        self.assertEqual(registration["unregistered"], [])
        self.assertEqual((registration["id"], registration["setupIsFunction"]), ("fleet.hooks", "function"))

    def test_with_a_real_child_process(self):
        """The shipped plugin against two real scripts (no opencode, no herdr): one answers, one hangs."""
        answers = self.fake_bin("answers", "cat > /dev/null\necho '{\"outcome\":\"ask\",\"reason\":\"real\"}'\n")
        hangs = self.fake_bin("hangs", "cat > /dev/null\nsleep 30\n")
        body = ('const real = (bin, t) => { const h = hooks.makeHandler({ bin, timeoutMs: t });'
                ' const i = { sessionID: "ses_r", action: "shell", resources: ["x"], effect: "allow" };'
                ' const s = Date.now(); return h(i).then(() => ({ effect: i.effect, message: i.message, ms: Date.now() - s })); };'
                'results["real-answer"] = await real(%s, 5000); results["real-hang"] = await real(%s, 300);'
                % (json.dumps(str(answers)), json.dumps(str(hangs))))
        results = self.run_harness(body)
        self.assertEqual((results["real-answer"]["effect"], results["real-answer"]["message"]), ("ask", "real"))
        self.assertEqual(results["real-hang"]["effect"], "allow")
        self.assertLess(results["real-hang"]["ms"], 3000)

    def test_it_exports_the_default_definition_v2_requires(self):
        text = (FLEET_HOOKS / "index.js").read_text()
        self.assertIn("export default {", text)
        self.assertIn('id: "fleet.hooks"', text)
        package = json.loads((FLEET_HOOKS / "package.json").read_text())
        self.assertEqual(package["type"], "module")


class TestFleetHooksSource(unittest.TestCase):
    def test_the_plugin_holds_no_policy_and_reaches_nothing_else(self):
        code = "\n".join(re.sub(r"//.*$", "", line) for line in (FLEET_HOOKS / "index.js").read_text().splitlines())
        for needle in ("jev", "openrouter", "herdr", "fetch(", "exec(", "execSync", "process.env.PATH", "http"):
            self.assertNotIn(needle, code.lower(), needle)
        self.assertEqual(re.findall(r'\["judge-tool"\]', code), ['["judge-tool"]'])

    def test_it_is_not_installed_or_linked_anywhere(self):
        for path in ("install.sh", "bin/fleet-doctor"):
            file = REPO / path
            if file.exists():
                self.assertNotIn("fleet-hooks", file.read_text(), path)

    def test_the_new_files_carry_no_personalisation(self):
        pattern = re.compile("|".join(["jan" + "us", "sp" + "ire", "adk" + "aplan", "/Us" + "ers/", "direc" + "tor(?!y|ies)"]),
                             re.IGNORECASE)
        files = list(FLEET_HOOKS.iterdir()) + [POLICY_REPLAY] + sorted(sc.DEFAULT_DIR.glob("p[1-6]-*.json"))
        self.assertGreaterEqual(len(files), 10)
        for path in files:
            for number, line in enumerate(path.read_text().splitlines(), 1):
                self.assertIsNone(pattern.search(line), "%s:%d %s" % (path.name, number, line))
# ======================================================================
# PR 10: moving a v1 session into v2 (import-v1), the cutover runbook, M1
#
# One section. It extends the fakes and the offline runner by attachment, so
# nothing above changes except one line in OfflineRun.__init__ (an agent that
# an `import-v1` step creates does not exist beforehand, as with `launch`).
# Nothing here runs a real binary: v1 is a fake that answers `export` only.
# ======================================================================
FAKE_V1 = "/fake/bin/opencode-v1"
V1_FIXTURES = REPO / "scenarios" / "v1-fixtures"
V1_MAIN = V1_FIXTURES / "chief-of-staff-export.json"
V1_CHILD = V1_FIXTURES / "subagent-export.json"
V1_MAIN_ID, V1_CHILD_ID = "ses_fixture00000000000001", "ses_fixture00000000000002"
CUTOVER_DOC = REPO / "docs" / "switchboard-cutover.md"


def v1_export(path=V1_MAIN):
    return json.loads(path.read_text())


class FakeV1:
    """The OpenCode v1 binary as the import sees it: it answers `export <id>` from
    a table of exports and refuses to be asked anything else, so a test fails if
    the command ever runs v1 for another purpose."""

    def __init__(self, exports=None):
        self.exports = {i: json.dumps(e) for i, e in (exports or {}).items()}
        self.calls = []

    def __call__(self, argv, **kwargs):
        argv = list(argv)
        self.calls.append(argv)
        if len(argv) != 3 or argv[:2] != [FAKE_V1, "export"]:
            raise AssertionError("v1 may only be asked `export <id>`; got %r" % argv)
        if argv[2] not in self.exports:
            return subprocess.CompletedProcess(argv, 1, "", "Session not found: %s\n" % argv[2])
        return subprocess.CompletedProcess(argv, 0, self.exports[argv[2]], "")


# ---- an independent statement of what v2's import accepts (from its OpenAPI
# document), so the fake does not just re-run the converter's own checker

FAKE_IMPORT_FIELDS = {
    "body": {"info", "messages", "location"},
    "info": {"id", "parentID", "fork", "projectID", "agent", "model", "cost", "tokens", "outcome", "time", "title",
             "subpath", "metadata", "permissions", "revert", "location"},
    "user": {"id", "metadata", "time", "text", "files", "agents", "skills", "type"},
    "assistant": {"id", "metadata", "time", "type", "agent", "model", "content", "snapshot", "finish", "rawFinish",
                  "providerState", "cost", "tokens", "error", "retry"},
    "text": {"type", "text", "state"}, "reasoning": {"type", "text", "state", "time"},
    "tool": {"type", "id", "name", "executed", "providerState", "providerResultState", "state", "time"},
}


def _unknown_fields(item, kind):
    return ["%s: %s" % (kind, name) for name in sorted(set(item) - FAKE_IMPORT_FIELDS[kind])]


def _fake_message_problems(message):
    kind = message.get("type") if isinstance(message, dict) else None
    if kind not in ("user", "assistant"):
        return ["message of type %r (the fake models user and assistant)" % kind]
    problems = _unknown_fields(message, kind)
    if not str(message.get("id", "")).startswith("msg_"):
        problems.append("message id must start with msg_")
    if not _is_ms(message.get("time", {}).get("created")):
        problems.append("message time.created must be a number")
    if kind == "user" and not isinstance(message.get("text"), str):
        problems.append("user text must be a string")
    for part in message.get("content", []) if kind == "assistant" else []:
        ptype = part.get("type")
        if ptype not in ("text", "reasoning", "tool"):
            problems.append("content of type %r" % ptype)
        else:
            problems.extend(_unknown_fields(part, ptype))
        if ptype == "tool" and part.get("state", {}).get("status") not in ("streaming", "running", "completed", "error"):
            problems.append("tool state %r" % part.get("state"))
    if kind == "assistant" and not all(isinstance(message.get(k), t) for k, t in (("agent", str), ("model", dict), ("content", list))):
        problems.append("assistant needs agent, model and content")
    return problems


def _is_ms(value):
    return isinstance(value, (int, float)) and not isinstance(value, bool)


def fake_import_problems(body):
    """Everything the fake v2 refuses in an import body."""
    if not isinstance(body, dict):
        return ["body must be an object"]
    problems = ["body: " + n for n in sorted(set(body) - FAKE_IMPORT_FIELDS["body"])]
    info, messages = body.get("info"), body.get("messages")
    if not isinstance(info, dict) or not isinstance(messages, list):
        return problems + ["info and messages are required"]
    problems.extend(_unknown_fields(info, "info"))
    for name in ("id", "projectID", "cost", "tokens", "time", "location"):
        if name not in info:
            problems.append("info.%s is required" % name)
    if not str(info.get("id", "")).startswith("ses"):
        problems.append("info.id must start with ses")
    if not _is_ms(info.get("time", {}).get("created")) or not _is_ms(info.get("time", {}).get("updated")):
        problems.append("info.time needs created and updated numbers")
    if not isinstance(info.get("location", {}).get("directory"), str):
        problems.append("info.location.directory must be a string")
    for message in messages:
        problems.extend(_fake_message_problems(message))
    return problems


@adds_to(FakeV2)
def op_experimental_session_import(self, params, body):
    """Strict: a bad body is 400, a repeated session id 409, a missing parent 404 (OpenAPI)."""
    problems = fake_import_problems(body)
    if problems:
        raise FakeHTTP(400, "InvalidRequestError", "; ".join(problems[:4]))
    info = body["info"]
    if info["id"] in self.sessions:
        raise FakeHTTP(409, "ConflictError", "session %s exists" % info["id"])
    if info.get("parentID") and info["parentID"] not in self.sessions:
        raise FakeHTTP(404, "SessionNotFoundError", "parent %s does not exist" % info["parentID"])
    lines = len(Path(self.audit_path).read_text().splitlines()) if self.audit_path and Path(self.audit_path).exists() else 0
    self.__dict__.setdefault("import_writes", []).append({"session": info["id"], "audit_lines": lines,
                                                          "body": copy.deepcopy(body)})
    self.sessions[info["id"]] = {
        "id": info["id"], "title": info.get("title"), "metadata": copy.deepcopy(info.get("metadata") or {}),
        "agent": info.get("agent"), "directory": info["location"]["directory"],
        "created": info["time"]["created"] / 1000.0, "idle": None, "idle_writes": [], "outcome": None,
        "messages": [dict(copy.deepcopy(m), sessionID=info["id"]) for m in body["messages"]],
        "inbox": [], "turn": None, "turns": 0, "parentID": info.get("parentID")}
    return self._info(self.sessions[info["id"]])


def _fake_list_page(self, argv):
    params = dict(value.partition("=")[::2] for flag, value in zip(argv[3::2], argv[4::2]) if flag == "--param")
    rows = [s for s in reversed(list(self.sessions.values()))
            if "directory" not in params or s["directory"] in (None, params["directory"])]
    size = min(int(params.get("limit", 50)), self.__dict__.get("list_page_cap", 1000))
    start = int(params.get("cursor") or 0)
    following = str(start + size) if start + size < len(rows) else None
    body = {"data": [self._info(s) for s in rows[start:start + size]], "cursor": {"previous": None, "next": following}}
    return subprocess.CompletedProcess(argv, 0, json.dumps(body), "")


_fake_call_before_pr10 = FakeV2.__call__


def _fake_call_with_session_list(self, argv, **kwargs):
    if not self.down and list(argv[1:3]) == ["api", "session.list"]:
        self.calls.append(list(argv))
        return _fake_list_page(self, list(argv))
    return _fake_call_before_pr10(self, argv, **kwargs)


FakeV2.__call__ = _fake_call_with_session_list


# ---- the offline runner: the `import-v1` step and its two oracles

def _import_fleet_of(name, member):
    fleet = sb.fleet_record(name, member["role"], member.get("reports_to"), member.get("issue"))
    if "charter" in member:
        fleet["charter"] = member["charter"]
    return fleet


def _fixture_path(name):
    path = (REPO / "scenarios" / name).resolve()
    if (REPO / "scenarios").resolve() not in path.parents:
        raise ValueError("a scenario fixture must live under scenarios/: %s" % name)
    return path


def apply_import_v1(run, step):
    """`import-v1`: the command's own function on the fakes, then the pane a person opens on the imported
    session (the runbook's step; the engine never does it), so herdr names the agent."""
    world, name = run.world, step["agent"]
    export = json.loads(_fixture_path(step["fixture"]).read_text())
    engine = world.new_engine("cli")
    with mock.patch.dict(os.environ, {sb.FAULT_ENV: ",".join(run.faults)}):
        report = sb.import_v1_session(engine.v2, engine.audit, export,
                                      _import_fleet_of(name, run.scenario["cast"][name]),
                                      world.config["import_body_limit_bytes"])
    pane = world.herdr.new_pane_id()
    world.herdr.add(pane, report["v2_session"])
    world.sessions[name], world.panes[name] = report["v2_session"], pane
    run.__dict__.setdefault("imports", {})[name] = {"export": export, "report": report}


def _import_oracle_imported_messages(self, e):
    """v2 holds the session with one message per v1 message, same order and timestamps, and the typed text."""
    record = self.__dict__.get("imports", {}).get(e["agent"])
    if record is None:
        return False, "no import-v1 step ran for %s" % e["agent"]
    source = record["export"]["messages"]
    held = self.world.v2.sessions[self.world.sessions[e["agent"]]]["messages"]
    want = [({"user": "user", "assistant": "assistant"}[m["info"]["role"]], m["info"]["time"]["created"]) for m in source]
    got = [(m["type"], m["time"]["created"]) for m in held]
    typed = [" ".join(p["text"] for p in m["parts"] if p["type"] == "text" and not p.get("synthetic") and not p.get("ignored"))
             for m in source if m["info"]["role"] == "user"]
    held_text = [m["text"].replace("\n\n", " ") for m in held if m["type"] == "user"]
    ok = got == want and typed == held_text and len(held) == e.get("count", len(source))
    return ok, "v2 holds %d message(s) of %d in v1; same order and timestamps: %s; same typed text: %s" % (
        len(held), len(source), got == want, typed == held_text)


def _import_oracle_lists_asks(self, e):
    """`intents`, run as the agent, lists the ask: found as the command finds it (pane -> session -> fleet)."""
    world = self.world
    try:
        fleet = sb.caller_fleet(world.engine.herdr, world.engine.v2, {"HERDR_PANE_ID": world.panes[e["agent"]]})
    except (sb.CallerError, sb.V2Error, KeyError) as err:
        return False, "`intents` cannot tell who %s is: %s" % (e["agent"], err)
    rows = sb.asks_of_caller(world.engine, fleet, world.clock.now())
    return e["issue"] in [issue.number for _, issue in rows], "`intents` lists %s for %s" % (
        ["#%d" % issue.number for _, issue in rows], fleet["name"])


def _import_extend_offline_run():
    """Give OfflineRun `import-v1`, `imported_messages` and `lists_asks`, and one more implicit check: every
    import was audited before it was sent. Wraps `apply` and `implicit`; nothing else is touched."""
    original_apply, original_implicit = OfflineRun.apply, OfflineRun.implicit

    def apply(self, step):
        if step["do"] == "import-v1":
            apply_import_v1(self, step)
        else:
            original_apply(self, step)

    def implicit(self):
        problems = original_implicit(self)
        entries = self.world.audit()
        for write in getattr(self.world.v2, "import_writes", []):
            before = [e for e in entries[:write["audit_lines"]] if e.get("event") == "v2.session.import"
                      and e.get("phase") == "intent" and (e.get("detail") or {}).get("v2_session") == write["session"]]
            after = [e for e in entries if e.get("event") == "v2.session.import" and e.get("phase") == "result"
                     and e.get("ok") and e.get("call") in {b["call"] for b in before}]
            if not before or not after:
                problems.append("import of %s was not audited before and after" % write["session"])
        return problems

    OfflineRun.apply, OfflineRun.implicit = apply, implicit
    OfflineRun.oracle_imported_messages = _import_oracle_imported_messages
    OfflineRun.oracle_lists_asks = _import_oracle_lists_asks


_import_extend_offline_run()
STEP_EXAMPLES["import-v1"] = {"agent": "coder", "fixture": "v1-fixtures/chief-of-staff-export.json"}
EXPECT_EXAMPLES["imported_messages"] = {"agent": "coder", "count": 7}
EXPECT_EXAMPLES["lists_asks"] = {"agent": "coder", "issue": 2}


# ---- the converter

def convert(export=None, **kwargs):
    return sb.convert_v1_export(v1_export() if export is None else export, kwargs.pop("fleet", {"name": "chief", "role": "chief-of-staff"}),
                                **kwargs)


class TestImportV1Converter(unittest.TestCase):
    def setUp(self):
        self.export = v1_export()
        self.out = convert(self.export)

    def test_one_v2_message_per_v1_message_in_the_same_order_with_the_same_times(self):
        source = self.export["messages"]
        got = self.out["messages"]
        self.assertEqual(len(got), len(source))
        self.assertEqual([m["type"] for m in got], [m["info"]["role"] for m in source])
        self.assertEqual([m["time"]["created"] for m in got], [m["info"]["time"]["created"] for m in source])
        self.assertEqual(got[1]["time"]["completed"], source[1]["info"]["time"]["completed"])

    def test_ids_are_v2s_and_the_same_every_time(self):
        again = convert(v1_export())
        self.assertEqual(self.out["info"]["id"], again["info"]["id"])
        self.assertRegex(self.out["info"]["id"], r"^ses_[0-9a-f]{26}$")
        ids = [m["id"] for m in self.out["messages"]]
        self.assertEqual(ids, [m["id"] for m in again["messages"]])
        for i in ids:
            self.assertRegex(i, r"^msg_[0-9a-f]{26}$")
        self.assertEqual(ids, sorted(ids), "sorting by id keeps the order")
        self.assertEqual(len(set(ids)), len(ids))

    def test_another_session_gets_other_ids(self):
        other = v1_export()
        other["info"]["id"] = "ses_fixture00000000000009"
        self.assertNotEqual(convert(other)["info"]["id"], self.out["info"]["id"])
        self.assertNotEqual(convert(other)["messages"][0]["id"], self.out["messages"][0]["id"])

    def test_the_fleet_metadata_is_stamped_with_where_it_came_from(self):
        self.assertEqual(self.out["info"]["metadata"],
                         {"fleet": {"name": "chief", "role": "chief-of-staff", "imported_from": "v1:" + V1_MAIN_ID}})

    def test_no_fleet_means_no_metadata(self):
        self.assertNotIn("metadata", convert(fleet=None)["info"])

    def test_the_fault_removes_the_metadata_only_in_the_lab(self):
        os.environ[sb.FAULT_ENV] = "no-import-metadata"
        self.assertIn("metadata", convert()["info"])
        os.environ[sb.LAB_ENV] = "1"
        try:
            self.assertNotIn("metadata", convert()["info"])
        finally:
            os.environ.pop(sb.LAB_ENV)
            os.environ.pop(sb.FAULT_ENV)

    def test_the_session_info_is_summed_and_located(self):
        info = self.out["info"]
        self.assertEqual(info["location"], {"directory": "/work/example-repo"})
        self.assertEqual(info["projectID"], "fixture-project")
        self.assertEqual(info["title"], "Chief of Staff (fixture)")
        self.assertAlmostEqual(info["cost"], 4 * 0.0125)
        self.assertEqual(info["tokens"]["input"], 4 * 1200)
        self.assertEqual(info["time"]["created"], self.export["info"]["time"]["created"])
        self.assertGreaterEqual(info["time"]["updated"], self.out["messages"][-1]["time"]["created"])
        self.assertNotIn("idle", info["time"], "an import must not look like a finished worker turn")
        self.assertNotIn("parentID", info)

    def test_the_converted_session_passes_the_schema(self):
        info = self.out["info"]
        self.assertEqual(sb.v2_import_problems(info, self.out["messages"], info["location"]), [])

    def test_user_text_files_and_agents(self):
        first = self.out["messages"][0]
        self.assertEqual(first["text"], "Plan the work for the platform charter and list what is open.")
        inline, reference = first["files"]
        self.assertEqual(inline, {"mime": "text/plain", "data": "aGVsbG8gd29ybGQ=", "source": {"type": "inline"},
                                  "name": "note.txt"})
        self.assertEqual(reference["source"], {"type": "uri", "uri": "file:///work/example-repo/PLAN.md"})
        self.assertEqual(reference["mention"], {"start": 0, "end": 8, "text": "@PLAN.md"})
        self.assertEqual(first["agents"], [{"name": "explore", "mention": {"start": 9, "end": 17, "text": "@explore"}}])

    def test_assistant_content_keeps_its_order_and_tool_calls(self):
        content = self.out["messages"][1]["content"]
        self.assertEqual([c["type"] for c in content], ["reasoning", "text", "tool", "tool"])
        self.assertEqual(content[0]["time"], {"created": 1790000002100, "completed": 1790000002400})
        done, failed = content[2], content[3]
        self.assertEqual((done["id"], done["name"], done["state"]["status"]), ("call_1", "read", "completed"))
        self.assertEqual(done["state"]["input"], {"filePath": "/work/example-repo/PLAN.md"})
        self.assertEqual(done["state"]["content"], [
            {"type": "text", "text": "# Plan\nTwo asks are open."},
            {"type": "file", "uri": "data:image/png;base64,iVBORw0KGgo=", "mime": "image/png", "name": "chart.png"}])
        self.assertEqual(done["state"]["metadata"], {"preview": "# Plan", "title": "PLAN.md"})
        self.assertEqual(done["time"], {"created": 1790000002500, "ran": 1790000002500, "completed": 1790000002600})
        self.assertEqual(failed["state"], {"status": "error", "input": {"command": "false"},
                                           "error": {"type": "error", "message": "Command exited with code 1"}})

    def test_pending_and_running_tools_and_a_snapshot(self):
        third = self.out["messages"][2]
        self.assertEqual(third["content"][0]["state"], {"status": "streaming", "input": "{\"pattern\": \"ask"})
        self.assertEqual(third["content"][1]["state"]["status"], "running")
        second = self.out["messages"][1]
        self.assertEqual(second["snapshot"], {"start": "snap-aaaa", "end": "snap-bbbb", "files": ["PLAN.md", "notes/todo.md"]})

    def test_finish_error_and_retry_are_mapped(self):
        fifth = self.out["messages"][4]
        self.assertEqual(fifth["finish"], "length")
        self.assertEqual(fifth["error"], {"type": "MessageAbortedError", "message": "The operation was aborted"})
        self.assertEqual(fifth["retry"], {"attempt": 2, "at": 1790000062500,
                                          "error": {"type": "APIError", "message": "rate limited"}})
        odd = v1_export()
        odd["messages"][1]["info"]["finish"] = "other"
        got = convert(odd)["messages"][1]
        self.assertEqual((got["finish"], got["rawFinish"]), ("unknown", "other"))

    def test_what_has_no_equivalent_is_listed_not_lost(self):
        kinds = sorted((d["kind"], d["message"][-2:]) for d in self.out["dropped"])
        self.assertEqual(kinds, [
            ("compaction", "04"), ("ignored-text", "04"), ("snapshot", "02"), ("step-marker", "02"),
            ("step-marker", "02"), ("step-marker", "03"), ("step-marker", "03"), ("subtask", "04"),
            ("synthetic-text", "01"), ("unknown:future-kind", "05")])
        for item in self.out["dropped"]:
            self.assertEqual(sorted(item), ["kind", "message", "part", "reason"])
            self.assertTrue(item["message"].startswith("msg_fixture"), "named by the v1 id")
            self.assertTrue(item["reason"])

    def test_what_was_filled_in_is_listed(self):
        self.assertEqual([(d["field"], d["message"][-2:]) for d in self.out["defaulted"]], [("file.data", "01")])
        bare = v1_export()
        for key in ("agent", "mode", "modelID", "providerID"):
            bare["messages"][6]["info"].pop(key, None)
        got = convert(bare)
        self.assertEqual(got["messages"][6]["agent"], "build")
        self.assertEqual(got["messages"][6]["model"], {"id": "unknown", "providerID": "unknown"})
        self.assertEqual({"agent", "model"}, {d["field"] for d in got["defaulted"] if d["message"].endswith("07")})

    def test_the_tool_output_limit_cuts_and_says_so(self):
        got = convert(tool_output_limit=5)
        self.assertEqual(got["messages"][1]["content"][2]["state"]["content"][0]["text"], "# Pla")
        self.assertIn("tool.output", [d["field"] for d in got["defaulted"]])

    def test_a_summary_counts_by_kind(self):
        rows = sb.summarise_dropped(self.out["dropped"])
        self.assertEqual(rows[0]["kind"], "step-marker")
        self.assertEqual(rows[0]["count"], 4)
        self.assertEqual(sum(r["count"] for r in rows), len(self.out["dropped"]))

    def test_an_export_that_would_lose_a_message_is_refused(self):
        cases = {
            "not an object": lambda e: [],
            "no messages": lambda e: {"info": e["info"]},
            "bad session id": lambda e: e["info"].update(id="x"),
            "no directory": lambda e: e["info"].pop("directory"),
            "relative directory": lambda e: e["info"].update(directory="work"),
            "no info on a message": lambda e: e["messages"][0].pop("info"),
            "unknown role": lambda e: e["messages"][0]["info"].update(role="system"),
            "no time": lambda e: e["messages"][0]["info"].pop("time"),
            "no id": lambda e: e["messages"][0]["info"].pop("id"),
        }
        for name, change in cases.items():
            with self.subTest(case=name):
                export = v1_export()
                replaced = change(export)
                if isinstance(replaced, (list, dict)) and name in ("not an object", "no messages"):
                    export = replaced
                with self.assertRaises(sb.ImportV1Error):
                    convert(export)

    def test_the_fixture_has_no_personal_text(self):
        for path in (V1_MAIN, V1_CHILD):
            text = path.read_text().lower()
            for fragment in ("/us" + "ers/", "/ho" + "me/", "@", "sk-", "bearer", "http"):
                self.assertNotIn(fragment, text.replace("@plan.md", "").replace("@explore", ""), (path.name, fragment))

    def test_every_part_kind_the_converter_handles_is_in_the_fixture(self):
        kinds = {p["type"] for m in v1_export()["messages"] for p in m["parts"]}
        self.assertLessEqual({"text", "reasoning", "tool", "file", "agent", "step-start", "step-finish", "patch",
                              "snapshot", "retry", "subtask", "compaction"}, kinds)
        states = {p["state"]["status"] for m in v1_export()["messages"] for p in m["parts"] if p["type"] == "tool"}
        self.assertEqual(states, {"pending", "running", "completed", "error"})


class TestImportOrder(unittest.TestCase):
    def test_a_parent_comes_before_its_child_whatever_the_input_order(self):
        parent, child = v1_export(), v1_export(V1_CHILD)
        for given in ([child, parent], [parent, child]):
            self.assertEqual([e["info"]["id"] for e in sb.import_order(given)], [V1_MAIN_ID, V1_CHILD_ID])

    def test_a_parent_outside_the_batch_is_assumed_to_exist(self):
        self.assertEqual([e["info"]["id"] for e in sb.import_order([v1_export(V1_CHILD)])], [V1_CHILD_ID])

    def test_a_cycle_is_refused(self):
        a, b = v1_export(), v1_export(V1_CHILD)
        a["info"]["parentID"] = V1_CHILD_ID
        with self.assertRaises(sb.ImportV1Error):
            sb.import_order([a, b])

    def test_the_child_points_at_the_parents_new_id(self):
        child = convert(v1_export(V1_CHILD), fleet=None)["info"]
        self.assertEqual(child["parentID"], convert()["info"]["id"])


# ---- the schema checker

def converted_body():
    out = convert()
    return copy.deepcopy(out["info"]), copy.deepcopy(out["messages"])


class TestImportSchemaChecker(unittest.TestCase):
    """Each case breaks one thing v2 would refuse; the checker must name it."""

    def problems(self, change):
        info, messages = converted_body()
        location = change(info, messages, {"directory": info["location"]["directory"]})
        return sb.v2_import_problems(info, messages, location if isinstance(location, dict) else None)

    def test_the_untouched_conversion_is_clean(self):
        self.assertEqual(self.problems(lambda i, m, l: None), [])

    def test_each_malformed_case_is_rejected_and_named(self):
        cases = [
            ("session id without ses", lambda i, m, l: i.update(id="abc"), "$.info.id"),
            ("no projectID", lambda i, m, l: i.pop("projectID"), "$.info.projectID: required"),
            ("no location", lambda i, m, l: i.pop("location"), "$.info.location: required"),
            ("cost as text", lambda i, m, l: i.update(cost="1"), "$.info.cost"),
            ("tokens missing a field", lambda i, m, l: i["tokens"].pop("reasoning"), "$.info.tokens.reasoning: required"),
            ("an unknown session field", lambda i, m, l: i.update(slug="x"), "$.info.slug: not a field"),
            ("time not a number", lambda i, m, l: i["time"].update(created="now"), "$.info.time.created"),
            ("metadata not an object", lambda i, m, l: i.update(metadata=[]), "$.info.metadata"),
            ("NaN cost", lambda i, m, l: i.update(cost=float("nan")), "not plain JSON"),
            ("message id without msg_", lambda i, m, l: m[0].update(id="x"), "$.messages[0]"),
            ("message with no text", lambda i, m, l: m[0].pop("text"), "text: required"),
            ("an unknown message field", lambda i, m, l: m[0].update(role="user"), "role: not a field"),
            ("an unknown message type", lambda i, m, l: m[0].update(type="human"), "matches none"),
            ("a boolean as a time", lambda i, m, l: m[0]["time"].update(created=True), "$.messages[0].time.created"),
            ("assistant without a model", lambda i, m, l: m[1].pop("model"), "model: required"),
            ("assistant content not a list", lambda i, m, l: m[1].update(content="x"), "content"),
            ("an unknown content type", lambda i, m, l: m[1]["content"].append({"type": "image"}), "matches none"),
            ("a tool without a name", lambda i, m, l: m[1]["content"][2].pop("name"), "name: required"),
            ("an unknown tool status", lambda i, m, l: m[1]["content"][2]["state"].update(status="done"),
             "$.messages[1].content[2].state: matches none"),
            ("a completed tool with text content", lambda i, m, l: m[1]["content"][2]["state"].update(content="x"), "content"),
            ("a tool error as a bare string", lambda i, m, l: m[1]["content"][3]["state"].update(error="x"), "error"),
            ("a finish v2 does not know", lambda i, m, l: m[1].update(finish="other"), "finish"),
            ("file data that is not base64", lambda i, m, l: m[0]["files"][0].update(data="not base64!"), "data"),
            ("a file source of an unknown kind", lambda i, m, l: m[0]["files"][0].update(source={"type": "x"}), "files"),
            ("a uri source without its uri", lambda i, m, l: m[0]["files"][1].update(source={"type": "uri"}), "uri"),
            ("agents as text", lambda i, m, l: m[0].update(agents="explore"), "agents"),
            ("a repeated message id", lambda i, m, l: m[1].update(id=m[0]["id"]), "used twice"),
            ("a retry without its attempt", lambda i, m, l: m[4]["retry"].pop("attempt"), "attempt"),
            ("a location without a directory", lambda i, m, l: l.clear() or l, "directory: required"),
        ]
        for name, change, needle in cases:
            with self.subTest(case=name):
                found = self.problems(change)
                self.assertTrue(found, "accepted: %s" % name)
                self.assertTrue(any(needle in p for p in found), "%s: %s" % (name, found))

    def test_the_checker_is_independent_of_the_fakes_check_and_agrees_with_it(self):
        info, messages = converted_body()
        self.assertEqual(fake_import_problems({"info": info, "messages": messages, "location": info["location"]}), [])
        info["slug"] = "x"
        self.assertTrue(fake_import_problems({"info": info, "messages": messages}))

    def test_a_union_names_the_branch_the_tag_selects(self):
        found = self.problems(lambda i, m, l: m[1]["content"][2]["state"].update(status="completed", content="x"))
        self.assertTrue(any("$.messages[1].content[2].state.content" in p for p in found), found)


# ---- the client

class TestImportV1Client(Base):
    def client(self, **kwargs):
        runner = FakeRunner(**kwargs)
        return sb.V2Client("/opt/lab/bin/opencode", {}, runner, 7), runner

    def test_argv_of_the_import(self):
        client, runner = self.client()
        info, messages = {"id": "ses_a"}, [{"id": "msg_a"}]
        client.session_import(info, messages, {"directory": "/work"})
        self.assertEqual(runner.argv[:3], ["/opt/lab/bin/opencode", "api", "experimental.session.import"])
        self.assertEqual(runner.argv[3], "-d")
        self.assertEqual(json.loads(runner.argv[4]), {"info": info, "messages": messages, "location": {"directory": "/work"}})
        self.assertEqual(len(runner.argv), 5, "no --param: the body names the session")

    def test_the_location_is_left_out_when_not_given(self):
        client, runner = self.client()
        client.session_import({"id": "ses_a"}, [])
        self.assertNotIn("location", json.loads(runner.argv[4]))

    def test_the_arguments_are_checked_before_anything_runs(self):
        client, runner = self.client()
        for call in (lambda: client.session_import({"id": "x"}, []), lambda: client.session_import({}, []),
                     lambda: client.session_import("ses_a", []), lambda: client.session_import({"id": "ses_a"}, "x")):
            with self.assertRaises(ValueError):
                call()
        self.assertEqual(runner.calls, [])

    def test_the_list_keeps_its_cursor(self):
        body = {"data": [{"id": "ses_1"}], "cursor": {"previous": None, "next": "c2"}}
        client, runner = self.client(default=(0, json.dumps(body), ""))
        self.assertEqual(client.session_list_page("/work", "c1", 50), ([{"id": "ses_1"}], "c2"))
        self.assertEqual(runner.argv, ["/opt/lab/bin/opencode", "api", "session.list", "--param", "limit=50",
                                       "--param", "directory=/work", "--param", "cursor=c1"])
        last = {"data": [], "cursor": {"previous": "p", "next": None}}
        client, _ = self.client(default=(0, json.dumps(last), ""))
        self.assertEqual(client.session_list_page(), ([], None))

    def test_a_list_without_data_is_an_error(self):
        client, _ = self.client(default=(0, "{}", ""))
        with self.assertRaises(sb.V2Error):
            client.session_list_page()

    def test_the_other_calls_still_unwrap_data(self):
        client, _ = self.client(default=(0, '{"data": {"id": "ses_1"}, "cursor": {}}', ""))
        self.assertEqual(client.session_get("ses_1"), {"id": "ses_1"})

    def test_still_one_runner_call(self):
        self.assertEqual(class_source("V2Client").count("self.runner("), 1)


class TestImportV1Config(Base):
    def test_the_defaults(self):
        self.assertEqual(sb.V1_MOVE_DEFAULTS, {"v1_opencode": None, "import_body_limit_bytes": 120000})
        self.assertIsNone(sb.load_config()["v1_opencode"])

    def test_v1_must_be_an_absolute_path_and_not_the_v2_binary(self):
        for raw, word in (({"v1_opencode": "opencode"}, "absolute"), ({"v1_opencode": 3}, "absolute"),
                          ({"v1_opencode": "/a/b", "opencode": "/a/b"}, "same binary"),
                          ({"import_body_limit_bytes": 10}, "at least"), ({"import_body_limit_bytes": True}, "at least"),
                          ({"import_body_limit_bytes": "9"}, "at least")):
            with self.subTest(raw=raw):
                with self.assertRaises(sb.ConfigError) as caught:
                    sb.validate_config(raw)
                self.assertIn(word, str(caught.exception))
        self.assertEqual(sb.validate_config({"v1_opencode": FAKE_V1, "opencode": FAKE_OPENCODE})["v1_opencode"], FAKE_V1)


# ---- the command

class ImportCase(Base):
    """The CLI over the three fakes: v2, herdr and the v1 binary."""

    def setUp(self):
        super().setUp()
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "v1_opencode": FAKE_V1,
                           "gh": FAKE_GH, "intent_repo": FAKE_REPO})
        self.world = World(self, agents=())
        self.v1 = FakeV1({V1_MAIN_ID: v1_export(), V1_CHILD_ID: v1_export(V1_CHILD)})

    def route(self, argv, **kwargs):
        if argv[0] == FAKE_V1:
            return self.v1(argv, **kwargs)
        return self.world.route(argv, **kwargs)

    def main(self, *argv):
        with captured() as (out, err):
            code = sb.main(list(argv), runner=self.route, now=self.world.clock.now, wait=lambda sock, s: False)
        return code, out.getvalue(), err.getvalue()

    def import_main(self):
        return self.main("import-v1", "--session", V1_MAIN_ID, "--name", "chief", "--role", "chief-of-staff")

    def imports(self):
        return getattr(self.world.v2, "import_writes", [])

    def imported(self):
        return [s for s in self.world.v2.sessions.values() if "imported_from" in (s["metadata"].get("fleet") or {})]


class TestImportV1Command(ImportCase):
    def test_a_session_read_through_v1_lands_in_v2_with_every_message(self):
        code, out, err = self.import_main()
        self.assertEqual((code, err), (0, ""), out)
        (session,) = self.imported()
        self.assertEqual(len(session["messages"]), len(v1_export()["messages"]))
        self.assertEqual(session["metadata"]["fleet"], {"name": "chief", "role": "chief-of-staff",
                                                         "imported_from": "v1:" + V1_MAIN_ID})
        self.assertIn("imported: v1 %s -> v2 %s, 7 message(s)" % (V1_MAIN_ID, session["id"]), out)
        self.assertEqual(self.v1.calls, [[FAKE_V1, "export", V1_MAIN_ID]], "v1 was only asked to export")

    def test_the_body_names_the_location_beside_the_info(self):
        self.import_main()
        body = self.imports()[0]["body"]
        self.assertEqual(body["location"], {"directory": "/work/example-repo"})
        self.assertEqual(body["location"], body["info"]["location"])
        self.assertEqual(sorted(body), ["info", "location", "messages"])

    def test_the_dropped_items_are_printed_and_audited_never_silent(self):
        code, out, _ = self.import_main()
        self.assertIn("dropped 10 item(s):", out)
        self.assertRegex(out, r"4\s+step-marker")
        self.assertRegex(out, r"1\s+synthetic-text")
        self.assertIn("filled in 1 value(s)", out)
        intent = [e for e in self.world.audit() if e["event"] == "v2.session.import" and e["phase"] == "intent"]
        self.assertEqual(len(intent), 1)
        detail = intent[0]["detail"]
        self.assertEqual((detail["dropped_total"], detail["messages"]), (10, 7))
        self.assertEqual(len(detail["dropped_examples"]), 10)
        self.assertEqual({r["kind"] for r in detail["dropped_by_kind"]}, {d["kind"] for d in detail["dropped_examples"]})

    def test_the_audit_is_written_before_and_after_the_write(self):
        self.import_main()
        entries = [e for e in self.world.audit() if e["event"] == "v2.session.import"]
        self.assertEqual([e["phase"] for e in entries], ["intent", "result"])
        self.assertTrue(entries[1]["ok"])
        self.assertEqual(self.imports()[0]["audit_lines"], 1, "the intent line was already on disk")

    def test_the_audit_names_no_message_text(self):
        export = v1_export()
        export["messages"][0]["parts"][0]["text"] = "SENTINEL-PRIVATE-TEXT"
        export["messages"][1]["parts"][3]["state"]["output"] = "SENTINEL-OUTPUT"
        self.v1.exports[V1_MAIN_ID] = json.dumps(export)
        os.environ["OPENROUTER_API_KEY"] = "sk-or-test-0123456789abcdef"
        code, out, err = self.import_main()
        self.assertEqual(code, 0)
        for text in (self.world.audit_path.read_text(), out, err):
            self.assertNotIn("SENTINEL", text)
            self.assertNotIn("sk-or-test", text)

    def test_the_same_session_twice_imports_once(self):
        self.import_main()
        code, out, _ = self.import_main()
        self.assertEqual(code, 0)
        self.assertIn("already imported (nothing done)", out)
        self.assertEqual(len(self.imports()), 1)
        self.assertEqual(len(self.imported()), 1)
        self.assertEqual(len([e for e in self.world.audit() if e["event"] == "v2.session.import"]), 2, "one write only")

    def test_found_by_listing_across_pages(self):
        for n in range(5):
            self.world.v2.create_session({"fleet": {"name": "other%d" % n}}, directory="/work/example-repo")
        self.import_main()
        for n in range(5):  # newer sessions push the import down the listing
            self.world.v2.create_session({"fleet": {"name": "later%d" % n}}, directory="/work/example-repo")
        self.world.v2.list_page_cap = 3
        code, out, _ = self.import_main()
        self.assertIn("already imported", out)
        self.assertEqual(len(self.imports()), 1)

    def test_a_listing_too_long_to_read_is_refused_not_assumed_empty(self):
        for n in range(4):
            self.world.v2.create_session({}, directory="/work/example-repo")
        self.world.v2.list_page_cap = 1
        with mock.patch.object(sb, "V1_LIST_MAX_PAGES", 2):
            code, _, err = self.import_main()
        self.assertEqual(code, 1)
        self.assertIn("cannot prove", err)
        self.assertEqual(self.imports(), [])

    def test_a_dry_run_writes_nothing_anywhere(self):
        code, out, _ = self.main("import-v1", "--file", str(V1_MAIN), "--name", "chief", "--dry-run")
        self.assertEqual(code, 0)
        self.assertIn("would import", out)
        self.assertIn("7 message(s)", out)
        self.assertEqual(self.imports(), [])
        self.assertEqual(self.world.v2.sessions, {})
        self.assertFalse(self.world.audit_path.exists(), "not even an audit line")
        self.assertEqual(self.v1.calls, [])

    def test_json_output_carries_the_dropped_list(self):
        code, out, _ = self.main("import-v1", "--file", str(V1_MAIN), "--name", "chief", "--dry-run", "--json")
        report = json.loads(out)
        self.assertEqual((report["status"], report["messages"], len(report["dropped"])), ("dry-run", 7, 10))

    def test_v1_is_never_touched_beyond_one_export(self):
        self.import_main()
        self.import_main()
        self.assertEqual(self.v1.calls, [[FAKE_V1, "export", V1_MAIN_ID]] * 2)

    def test_the_agent_is_found_by_its_metadata_once_a_pane_shows_it(self):
        self.import_main()
        (session,) = self.imported()
        self.world.herdr.add(self.world.herdr.new_pane_id(), session["id"])
        engine = self.world.new_engine("cli", writable=False)
        agent = engine.discover(self.world.clock.now()).agents["chief"]
        self.assertEqual((agent.session_id, agent.fleet["role"], agent.fleet["imported_from"]),
                         (session["id"], "chief-of-staff", "v1:" + V1_MAIN_ID))

    def test_an_imported_session_does_not_look_like_a_worker_that_just_finished(self):
        code, _, _ = self.main("import-v1", "--session", V1_MAIN_ID, "--name", "orch", "--role", "orchestrator",
                               "--reports-to", "chief")
        self.assertEqual(code, 0)
        (session,) = self.imported()
        self.world.herdr.add(self.world.herdr.new_pane_id(), session["id"])
        engine = self.world.new_engine("cli", writable=False)
        engine.discover(self.world.clock.now())
        source = sb.WorkerFacts()
        source.bind(engine)
        self.assertEqual(source(), [], "no time.idle on the import, so nobody is told it 'finished'")


class TestImportV1AsAProcess(Base):
    def test_a_dry_run_through_the_real_entry_point_and_a_script_standing_in_for_v2(self):
        v2 = self.fake_bin("opencode-v2", 'echo \'{"data": [], "cursor": {"previous": null, "next": null}}\'\n')
        self.write_config({"opencode": str(v2)})
        proc = self.run_cli(SWITCHBOARD, "import-v1", "--file", str(V1_MAIN), "--name", "chief", "--dry-run")
        self.assertEqual(proc.returncode, 0, proc.stderr)
        self.assertIn("would import: v1 %s" % V1_MAIN_ID, proc.stdout)
        self.assertFalse(self.state_dir.exists(), "a dry run does not even make the state directory")

    def test_the_command_is_listed_in_help(self):
        self.assertIn("import-v1", self.run_cli(SWITCHBOARD, "--help").stdout)


class TestImportV1Refusals(ImportCase):
    def assertRefused(self, argv, word, writes=0):
        code, out, err = self.main(*argv)
        self.assertEqual(code, 1, out + err)
        self.assertIn(word, err)
        self.assertEqual(len(self.imports()), writes)
        self.assertNotIn("Traceback", err)
        return err

    def test_no_v1_binary_configured_means_no_session_import(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.assertRefused(("import-v1", "--session", V1_MAIN_ID, "--name", "chief"), "v1_opencode")
        self.assertEqual(self.v1.calls, [])

    def test_a_file_needs_no_v1_binary(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR})
        self.assertEqual(self.main("import-v1", "--file", str(V1_MAIN), "--name", "chief")[0], 0)

    def test_no_v2_binary_configured(self):
        self.write_config({"v1_opencode": FAKE_V1})
        self.assertRefused(("import-v1", "--file", str(V1_MAIN), "--name", "chief"), "'opencode' is not configured")

    def test_a_session_id_that_is_not_one(self):
        for bad in ("-x", "ses", "ses_a b", "../ses_1", "ses_1;rm"):
            with self.subTest(bad=bad):
                self.assertRefused(("import-v1", "--session=" + bad, "--name", "chief"), "--session")
        self.assertEqual(self.v1.calls, [])

    def test_a_session_v1_does_not_have(self):
        self.assertRefused(("import-v1", "--session", "ses_nothere", "--name", "chief"), "Session not found")

    def test_v1_that_cannot_run_or_hangs(self):
        for failure, word in ((FileNotFoundError(2, "No such file or directory"), "cannot run"),
                              (subprocess.TimeoutExpired([FAKE_V1], 1), "did not finish")):
            with self.subTest(word=word):
                self.route = lambda argv, f=failure, **kw: (_ for _ in ()).throw(f) if argv[0] == FAKE_V1 \
                    else self.world.route(argv, **kw)
                self.assertRefused(("import-v1", "--session", V1_MAIN_ID, "--name", "chief"), word)

    def test_bad_json_from_v1_or_a_file(self):
        self.v1.exports[V1_MAIN_ID] = "Exporting session...\n{"
        self.assertRefused(("import-v1", "--session", V1_MAIN_ID, "--name", "chief"), "not valid JSON")
        bad = self.home / "bad.json"
        bad.write_text("not json")
        self.assertRefused(("import-v1", "--file", str(bad), "--name", "chief"), "not valid JSON")
        self.assertRefused(("import-v1", "--file", str(self.home / "missing.json"), "--name", "chief"), "cannot read")

    def test_json_that_is_not_an_export(self):
        wrong = self.home / "wrong.json"
        wrong.write_text('{"info": {}, "messages": []}')
        self.assertRefused(("import-v1", "--file", str(wrong), "--name", "chief"), "not a usable v1 export")

    def test_a_conversion_that_breaks_the_schema_sends_nothing(self):
        real = sb.convert_v1_export

        def broken(export, fleet=None, tool_output_limit=None, directory=None):
            out = real(export, fleet, tool_output_limit, directory)
            out["messages"][1]["content"][0]["type"] = "thought"
            return out
        with mock.patch.object(sb, "convert_v1_export", broken):
            err = self.assertRefused(("import-v1", "--session", V1_MAIN_ID, "--name", "chief"), "breaks v2's schema")
        self.assertIn("messages[1].content[0]", err)
        self.assertEqual([c for c in self.world.v2.calls if "experimental.session.import" in c], [])
        self.assertEqual([c for c in self.world.v2.calls if "session.list" in c], [], "not even a read")
        self.assertFalse(self.world.audit_path.exists())

    def test_a_body_too_long_for_one_argument_is_refused_with_the_way_out(self):
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "v1_opencode": FAKE_V1,
                           "import_body_limit_bytes": 4000})
        err = self.assertRefused(("import-v1", "--file", str(V1_MAIN), "--name", "chief"), "bytes")
        self.assertIn("--tool-output-limit", err)

    def test_a_tool_output_limit_gets_it_under_the_limit(self):
        export = v1_export()
        export["messages"][1]["parts"][3]["state"]["output"] = "x" * 8000
        big = self.home / "big.json"
        big.write_text(json.dumps(export))
        self.write_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR, "import_body_limit_bytes": 9000})
        self.assertRefused(("import-v1", "--file", str(big), "--name", "chief"), "bytes")
        code, out, _ = self.main("import-v1", "--file", str(big), "--name", "chief", "--tool-output-limit", "100")
        self.assertEqual(code, 0)
        self.assertIn("tool output cut from 8000 to 100", out)

    def test_a_child_before_its_parent_is_refused_and_after_it_goes_in(self):
        args = ("import-v1", "--session", V1_CHILD_ID, "--name", "explorer")
        err = self.assertRefused(args, "import the parent first")
        self.assertIn(sb.v1_target_id("ses", V1_MAIN_ID), err)
        self.assertEqual(self.main("import-v1", "--session", V1_MAIN_ID, "--name", "chief")[0], 0)
        self.assertEqual(self.main(*args)[0], 0)
        parent, child = (s for s in self.world.v2.sessions.values() if s["metadata"])
        self.assertEqual(child["parentID"], parent["id"])
        self.assertEqual([i["session"] for i in self.imports()], [parent["id"], child["id"]])

    def test_a_409_is_already_imported_not_an_error_and_not_a_second_copy(self):
        self.import_main()
        (session,) = self.imported()
        session["metadata"] = {}  # the listing no longer shows where it came from; the id still collides
        code, out, err = self.import_main()
        self.assertEqual((code, err), (0, ""))
        self.assertIn("already imported", out)
        self.assertEqual(len(self.imports()), 1)

    def test_a_name_and_numbers_are_checked(self):
        self.assertRefused(("import-v1", "--file", str(V1_MAIN), "--name", "Chief Of Staff"), "--name")
        self.assertRefused(("import-v1", "--file", str(V1_MAIN), "--name", "chief", "--issue", "0"), "--issue")
        self.assertRefused(("import-v1", "--file", str(V1_MAIN), "--name", "chief", "--charter", "-2"), "--charter")
        self.assertRefused(("import-v1", "--file", str(V1_MAIN), "--name", "chief", "--tool-output-limit", "0"),
                           "--tool-output-limit")

    def test_one_source_and_a_name_are_required(self):
        self.assertEqual(self.main("import-v1", "--name", "chief")[0], 2)
        self.assertEqual(self.main("import-v1", "--file", "a", "--session", "ses_1", "--name", "chief")[0], 2)
        self.assertEqual(self.main("import-v1", "--file", "a")[0], 2)

    def test_v2_unreachable_is_an_error_and_nothing_is_claimed(self):
        self.world.v2.down = True
        code, _, err = self.import_main()
        self.assertEqual(code, 1)
        self.assertIn("cannot reach", err)
        self.assertEqual(self.imports(), [])

    def test_a_failed_import_is_audited_as_failed(self):
        real = sb.V2Client.session_import

        def fail(self, *a, **k):
            raise sb.V2Error("http", 400, "bad body")
        with mock.patch.object(sb.V2Client, "session_import", fail):
            code, _, err = self.import_main()
        self.assertEqual(code, 1)
        results = [e for e in self.world.audit() if e["event"] == "v2.session.import" and e["phase"] == "result"]
        self.assertEqual([r["ok"] for r in results], [False])
        self.assertIs(sb.V2Client.session_import, real)


# ---- measured v2 import rules (Lab import spike), each a rule of the converter

V2_SHAPE = V1_FIXTURES / "v2-export-shape.json"


class TestImportMeasuredRules(ImportCase):
    def test_ids_start_with_ses_and_msg_and_never_repeat_across_sessions(self):
        parent, child = convert(), convert(v1_export(V1_CHILD), fleet=None)
        ids = [m["id"] for c in (parent, child) for m in c["messages"]]
        self.assertEqual(len(ids), len(set(ids)), "v2 answers 500 to a message id it already holds")
        self.assertTrue(all(i.startswith("msg") for i in ids))
        self.assertTrue(parent["info"]["id"].startswith("ses") and child["info"]["id"].startswith("ses"))
        self.assertNotEqual(parent["info"]["id"], child["info"]["id"])
        self.assertEqual({i for i in ids}, {m["id"] for c in (convert(), convert(v1_export(V1_CHILD), fleet=None))
                                            for m in c["messages"]}, "a re-run mints the same ids")

    def test_the_same_v1_message_ids_in_two_sessions_still_get_different_ids(self):
        other = v1_export()
        other["info"]["id"] = "ses_fixture00000000000009"
        a, b = convert(), convert(other)
        self.assertEqual(set(m["id"] for m in a["messages"]) & set(m["id"] for m in b["messages"]), set())

    def test_v1_bash_is_v2_shell(self):
        export = v1_export()
        export["messages"][1]["parts"][4]["tool"] = "bash"
        names = [c["name"] for c in convert(export)["messages"][1]["content"] if c["type"] == "tool"]
        self.assertEqual(names, ["read", "shell"])
        self.assertEqual(convert()["messages"][1]["content"][3]["name"], "bash".replace("bash", "shell"))

    def test_only_text_reasoning_and_tool_reach_assistant_content_and_the_rest_is_dropped_loudly(self):
        out = convert()
        kinds = {c["type"] for m in out["messages"] if m["type"] == "assistant" for c in m["content"]}
        self.assertEqual(kinds, {"text", "reasoning", "tool"})
        self.assertEqual({m["type"] for m in out["messages"]}, {"user", "assistant"}, "no idle, no fabricated markers")
        self.assertIn("unknown:future-kind", {d["kind"] for d in out["dropped"]})

    def test_the_directory_flag_overrides_what_v1_recorded(self):
        out = convert(directory="/work/elsewhere")
        self.assertEqual(out["info"]["location"], {"directory": "/work/elsewhere"})
        bare = v1_export()
        bare["info"].pop("directory")
        self.assertEqual(convert(bare, directory="/work/x")["info"]["location"], {"directory": "/work/x"})
        with self.assertRaises(sb.ImportV1Error):
            convert(bare)
        code, _, err = self.main("import-v1", "--file", str(V1_MAIN), "--name", "chief", "--dir", "rel")
        self.assertEqual(code, 1)
        self.assertIn("--dir", err)
        self.assertEqual(self.main("import-v1", "--file", str(V1_MAIN), "--name", "chief", "--dir", "/work/x")[0], 0)
        self.assertEqual(self.imported()[0]["directory"], "/work/x")

    def test_what_v2_really_exports_passes_our_schema_and_ours_has_the_same_shape(self):
        sample = json.loads(V2_SHAPE.read_text())
        real = [m for m in sample["messages"] if m["type"] in ("user", "assistant")]
        self.assertEqual({m["type"] for m in sample["messages"]}, {"user", "assistant", "idle"})
        self.assertEqual(sb.v2_import_problems(
            {k: v for k, v in sample["info"].items() if k not in ("outcome",)}, real, sample["info"]["location"]), [])
        ours = convert()["messages"]
        for kind in ("user", "assistant"):
            theirs_keys = set().union(*[set(m) for m in real if m["type"] == kind])
            our_keys = set().union(*[set(m) for m in ours if m["type"] == kind])
            self.assertLessEqual(our_keys - {"files", "agents", "error", "retry", "rawFinish"}, theirs_keys | {"id"}, kind)
        tool = next(c for m in real if m["type"] == "assistant" for c in m["content"] if c["type"] == "tool")
        mine = next(c for m in ours for c in m.get("content", []) if c["type"] == "tool" and c["state"]["status"] == "completed")
        self.assertLessEqual(set(mine) - {"executed"}, set(tool))
        self.assertLessEqual(set(mine["state"]), set(tool["state"]))
        self.assertEqual(tool["name"], "shell")

    def test_the_shape_fixture_is_synthetic(self):
        text = V2_SHAPE.read_text()
        for fragment in ("/us" + "ers/", "/ho" + "me/", "fleet-switchboard", "lab-"):
            self.assertNotIn(fragment, text)


# ---- B: an imported agent is a fleet agent like any other (M1's offline half)

class TestImportedAgentIsSeen(ImportCase):
    ISSUES = {"1": {"intent": None},
              "2": {"intent": "Add a health check", "done_when": "GET /health returns 200", "parent": 1},
              "3": {"intent": "Write the rollout note", "done_when": "the note is merged", "parent": 1}}

    def setUp(self):
        super().setUp()
        self.gh = FakeGH(self.ISSUES, {1}, self.world.clock)
        self.world.intents = sb.IntentReader(FAKE_GH, FAKE_REPO, self.gh, self.world.clock.now, 5)
        self.world.config = sb.validate_config({"opencode": FAKE_OPENCODE, "herdr": FAKE_HERDR,
                                                "gh": FAKE_GH, "intent_repo": FAKE_REPO})
        self.world.engine = self.world.new_engine()
        self.world.add_agent("platform", fleet={"role": "orchestrator", "charter": 1})

    def route(self, argv, **kwargs):
        return self.gh(argv) if argv[0] == FAKE_GH else super().route(argv, **kwargs)

    def test_intents_lists_the_open_asks_of_an_imported_chief_of_staff(self):
        self.assertEqual(self.import_main()[0], 0)
        (session,) = self.imported()
        pane = self.world.herdr.new_pane_id()
        self.world.herdr.add(pane, session["id"])
        os.environ["HERDR_PANE_ID"] = pane
        code, out, err = self.main("intents")
        self.assertEqual((code, err), (0, ""))
        self.assertEqual(out.splitlines(), [
            "#2  [platform]  Add a health check  | Done when: GET /health returns 200",
            "#3  [platform]  Write the rollout note  | Done when: the note is merged"])

    def test_without_the_import_metadata_the_agent_is_a_stranger(self):
        os.environ[sb.LAB_ENV], os.environ[sb.FAULT_ENV] = "1", "no-import-metadata"
        self.assertEqual(self.import_main()[0], 0)
        (session,) = [s for s in self.world.v2.sessions.values() if s["messages"]]
        pane = self.world.herdr.new_pane_id()
        self.world.herdr.add(pane, session["id"])
        os.environ["HERDR_PANE_ID"] = pane
        code, _, err = self.main("intents")
        self.assertEqual(code, 1)
        self.assertIn("not a fleet agent", err)

    def test_status_shows_the_imported_agent_by_name(self):
        self.import_main()
        (session,) = self.imported()
        self.world.herdr.add(self.world.herdr.new_pane_id(), session["id"])
        report = json.loads(self.main("status", "--json")[1])
        names = [a["name"] for a in report["agents"]["list"]]
        self.assertIn("chief", names)


# ---- M1, the oracles, and the control

class TestM1(Base):
    PATH = sc.DEFAULT_DIR / "m1-v1-session-imported.json"

    def test_the_scenario_is_valid_and_in_the_catalog_shape(self):
        scenario = sc.load(self.PATH)
        self.assertEqual((scenario["id"], scenario["since_pr"], scenario["problem"]), ("M1", 10, None))
        self.assertEqual(scenario["tiers"], ["offline", "lab-model"])
        self.assertEqual(scenario["control"]["fault"], "no-import-metadata")
        self.assertEqual(sc.validate(scenario), [])

    def test_offline_it_passes_and_its_control_fails_what_it_names(self):
        report = run_scenario(self, sc.load(self.PATH))
        self.assertEqual(report["failures"], [], format_scenario_report(report))
        self.assertEqual(report["implicit"], [])
        self.assertEqual(report["proves_nothing"], [])
        self.assertEqual(sorted(r["label"] for r in report["control"] if not r["ok"]),
                         ["ask-2-listed", "ask-3-listed", "fleet-metadata"])
        self.assertTrue(next(r for r in report["control"] if r["label"] == "same-messages")["ok"],
                        "the messages are copied with or without metadata")

    def test_the_lab_model_tier_is_validated_only(self):
        lab = _load("t_proof_m1", BIN / "proof-switchboard")
        scenario = sc.load(self.PATH)
        self.assertNotIn("lab-scripted", scenario["tiers"])
        self.assertNotIn("import-v1", lab.RUN_ACTIONS)

    def test_a_variant_that_drops_a_message_fails_the_message_oracle(self):
        scenario = sc.load(self.PATH)
        run = OfflineRun(self, scenario, "dropped").run()
        self.assertTrue(run.oracle_imported_messages({"that": "imported_messages", "agent": "chief-of-staff"})[0])
        session = run.world.v2.sessions[run.world.sessions["chief-of-staff"]]
        session["messages"].pop(3)
        self.assertFalse(run.oracle_imported_messages({"that": "imported_messages", "agent": "chief-of-staff"})[0])

    def test_reordered_or_retimed_messages_fail_it_too(self):
        run = OfflineRun(self, sc.load(self.PATH), "reordered").run()
        e = {"that": "imported_messages", "agent": "chief-of-staff"}
        messages = run.world.v2.sessions[run.world.sessions["chief-of-staff"]]["messages"]
        messages[0], messages[1] = messages[1], messages[0]
        self.assertFalse(run.oracle_imported_messages(e)[0])
        messages[0], messages[1] = messages[1], messages[0]
        messages[2]["time"]["created"] += 1
        self.assertFalse(run.oracle_imported_messages(e)[0])
        messages[2]["time"]["created"] -= 1
        messages[0]["text"] = "something else"
        self.assertFalse(run.oracle_imported_messages(e)[0])

    def test_the_count_field_must_match(self):
        run = OfflineRun(self, sc.load(self.PATH), "count").run()
        e = {"that": "imported_messages", "agent": "chief-of-staff"}
        self.assertTrue(run.oracle_imported_messages(dict(e, count=7))[0])
        self.assertFalse(run.oracle_imported_messages(dict(e, count=6))[0])

    def test_the_oracles_say_so_when_there_was_no_import(self):
        scenario = sc.load(self.PATH)
        scenario["steps"] = [s for s in scenario["steps"] if s["do"] != "import-v1"]
        run = OfflineRun(self, scenario, "none").run()
        ok, seen = run.oracle_imported_messages({"that": "imported_messages", "agent": "chief-of-staff"})
        self.assertFalse(ok)
        self.assertIn("no import-v1 step", seen)

    def test_a_fixture_outside_the_repo_is_refused(self):
        with self.assertRaises(ValueError):
            _fixture_path("../../../etc/passwd")

    def test_the_vocabulary_is_in_the_readme_and_the_tables(self):
        readme = (REPO / "scenarios" / "switchboard" / "README.md").read_text()
        for word in ("`import-v1`", "`imported_messages`", "`lists_asks`", "v1-fixtures"):
            self.assertTrue(word in readme, word)
        self.assertEqual(set(sc.STEP_FIELDS["import-v1"]), {"agent", "fixture"})
        self.assertEqual(sc.STEP_ACTORS["import-v1"], ("world",))
        self.assertEqual(set(sc.EXPECT_FIELDS["imported_messages"]), {"agent", "count"})
        self.assertEqual(set(sc.EXPECT_FIELDS["lists_asks"]), {"agent", "issue"})


# ---- the runbook and the section's hygiene

FORBIDDEN_IN_PUBLIC_TEXT = re.compile("|".join(["jan" + "us", "sp" + "ire", "adk" + "aplan", "/Us" + "ers/",
                                                "/ho" + "me/", "direc" + "tor(?!y|ies)"]), re.IGNORECASE)


class TestCutoverRunbook(unittest.TestCase):
    def setUp(self):
        self.text = CUTOVER_DOC.read_text()

    def test_it_is_clean_of_names_and_home_paths(self):
        for number, line in enumerate(self.text.splitlines(), 1):
            self.assertIsNone(FORBIDDEN_IN_PUBLIC_TEXT.search(line), "%s:%d %s" % (CUTOVER_DOC.name, number, line))

    def test_it_has_the_sections_the_cutover_needs(self):
        for heading in ("Preconditions", "The shared-directory hazard", "Backups", "Import, one agent at a time",
                        "Start the switchboard", "Keep `fleet-heartbeat`", "Rollback", "What not to do", "Go / no-go"):
            self.assertIsNotNone(re.search(r"(?m)^#{2,3} .*%s" % re.escape(heading), self.text), heading)

    def test_it_names_the_hazards_and_the_commands(self):
        for needle in ("XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_STATE_HOME", "XDG_CACHE_HOME", "TMPDIR", "HOME",
                       "absolute path", "herdr plugin link", "fleet-switchboard import-v1", "--dry-run",
                       "fleet-switchboard ensure", "fleet-heartbeat", "v1_opencode", "message count",
                       "fleet-switchboard intents", "never type"):
            self.assertTrue(needle.lower() in self.text.lower(), needle)

    def test_it_has_no_keys_or_secrets(self):
        for fragment in ("sk-", "bearer ", "password=", "token="):
            self.assertNotIn(fragment, self.text.lower())

    def test_every_command_it_shows_exists(self):
        for command in re.findall(r"fleet-switchboard ([a-z0-9-]+)", self.text):
            self.assertIn(command, ("import-v1", "ensure", "status", "intents", "run", "pending", "send", "launch",
                                    "version", "poke", "intent", "remind"), command)

    def test_the_readme_links_it_in_one_line(self):
        readme = (REPO / "README.md").read_text()
        self.assertEqual(len([line for line in readme.splitlines() if "switchboard-cutover.md" in line]), 1)


PRE_EXISTING_REDEFINITIONS = {}  # names a bin file already defined twice before PR 10 (none)


class TestPR10Source(unittest.TestCase):
    SECTION = "\n# PR 10: move a v1 session into v2"

    def test_the_section_is_one_clearly_marked_block(self):
        self.assertEqual(SWITCHBOARD.read_text().count(self.SECTION), 1)

    def test_the_engine_still_never_types(self):
        self.assertEqual(herdr_typing_violations(SWITCHBOARD.read_text()), [])

    def test_the_import_command_runs_only_the_clients_it_is_given(self):
        source = SWITCHBOARD.read_text()
        start = source.index(self.SECTION)
        section = source[start:source.index("\ndef build_parser")]
        self.assertNotIn("subprocess.run", section, "the runner is injected")
        self.assertNotIn("herdr", section.replace("herdr's", "").lower().replace("herdr_", ""))

    def test_no_top_level_name_is_defined_twice_in_any_bin_file(self):
        for name in ("fleet-switchboard", "fleet-scenario", "test-switchboard", "proof-switchboard"):
            tree = ast.parse((BIN / name).read_text())
            seen = {}
            for node in tree.body:
                names = []
                if isinstance(node, (ast.FunctionDef, ast.ClassDef)):
                    names = [node.name]
                elif isinstance(node, ast.Assign):
                    names = [t.id for t in node.targets if isinstance(t, ast.Name)]
                for defined in names:
                    seen.setdefault(defined, []).append(node.lineno)
            repeated = {n: lines for n, lines in seen.items()
                        if len(lines) > 1 and n not in PRE_EXISTING_REDEFINITIONS.get(name, ())}
            self.assertEqual(repeated, {}, name)

    def test_the_v1_binary_is_asked_for_nothing_but_export(self):
        source = SWITCHBOARD.read_text()
        calls = re.findall(r'runner\(\[binary, "([a-z-]+)"', source)
        self.assertEqual(calls, ["export"])


# ---------------------------------------------------------------------- runner

# ======================================================================
# The trial driver (bin/switchboard-trial): the same isolation as the Lab, with a
# real model. Nothing here starts a real binary.
# ======================================================================

TRIAL = _load("t_switchboard_trial", BIN / "switchboard-trial")


class TestTrialDriver(Base):
    def trial(self):
        return TRIAL.Trial(self.home / "trial")

    def test_its_root_is_never_a_live_directory(self):
        root = str(self.trial().root)
        for live in ("~/.config/opencode", "~/.local/share/opencode", "~/.local/state/opencode",
                     "~/.config/herdr", "~/.local/state/herdr"):
            self.assertFalse(root.startswith(os.path.expanduser(live)), live)

    def fake_gh(self, token="canary-gh"):
        """A gh that answers `auth token` and records the GH_CONFIG_DIR it was asked under."""
        path = self.home / "fake-gh"
        path.write_text('#!/bin/sh\necho "$GH_CONFIG_DIR" > "%s"\necho "$HOME" > "%s"\n[ -n "%s" ] && echo "%s"\n[ -n "%s" ]\n'
                        % (self.home / "gh-config-seen", self.home / "gh-home-seen", token, token, token))
        path.chmod(0o755)
        return str(path)

    def wrapper_env(self, gh_token="canary-gh", **extra):
        trial = self.trial()
        trial.gh_bin, trial.gh_config_dir = self.fake_gh(gh_token), "/real/gh"
        probe = trial.wrapper_text().rsplit("exec ", 1)[0] + 'env\n'
        env = dict({"PATH": SAFE_PATH}, **extra)
        return subprocess.run([shutil.which("sh"), "-c", probe], env=env, capture_output=True, text=True).stdout

    def test_the_wrapper_takes_every_credential_out_before_it_gives_agents_the_gh_token(self):
        text = self.trial().wrapper_text()
        self.assertLess(text.index('unset "$name"'), text.index('export GH_TOKEN="$GH_FOR_AGENTS"'),
                        "the token is added after the strip")
        self.assertIn("_API_KEY", text)  # the OpenRouter key is of this shape
        self.assertIn("COPILOT", text)
        self.assertNotIn("OPENROUTER", text, "the wrapper never names the key, it strips by shape")
        out = self.wrapper_env(OPENROUTER_API_KEY="canary-key", SOME_SECRET="canary-secret", KEEP_ME="yes",
                               GH_TOKEN="ambient-gh", GITHUB_TOKEN="ambient-github")
        self.assertIn("GH_TOKEN=canary-gh", out)
        self.assertIn("KEEP_ME=yes", out)
        for canary in ("canary-key", "canary-secret", "ambient-gh", "ambient-github"):
            self.assertNotIn(canary, out)

    def test_the_token_comes_from_the_users_real_gh_config_not_the_trials_home(self):
        """The trial found agents with no GH_TOKEN: the token was handed to the service only, but the
        agents' shell runs in the pane's process. The wrapper asks gh on every start."""
        self.wrapper_env()
        self.assertEqual((self.home / "gh-config-seen").read_text().strip(), "/real/gh")
        self.assertNotIn("GH_CONFIG_DIR", self.wrapper_env(), "agents do not inherit the real gh config dir")

    def test_gh_runs_under_the_users_real_home_because_macos_keeps_its_token_in_the_login_keychain(self):
        trial = self.trial()
        trial.gh_bin, trial.gh_config_dir = self.fake_gh(), "/real/gh"
        probe = trial.wrapper_text().rsplit("exec ", 1)[0] + 'env\n'
        subprocess.run([shutil.which("sh"), "-c", probe], env={"PATH": SAFE_PATH, "HOME": "/users-real-home"},
                       capture_output=True, text=True)
        self.assertEqual((self.home / "gh-home-seen").read_text().strip(), "/users-real-home")

    def test_the_gh_token_is_never_written_to_the_trials_files(self):
        trial = self.trial()
        trial.gh_bin, trial.gh_config_dir = self.fake_gh(), "/real/gh"
        self.assertNotIn("canary-gh", trial.wrapper_text())
        self.assertNotIn("FLEET_TRIAL_GH_TOKEN", inspect.getsource(TRIAL))

    def test_agents_find_fleet_switchboard_on_their_path(self):
        probe = self.trial().wrapper_text().rsplit("exec ", 1)[0] + 'command -v fleet-switchboard\n'
        out = subprocess.run([shutil.which("sh"), "-c", probe], env={"PATH": SAFE_PATH}, capture_output=True, text=True)
        self.assertEqual(out.stdout.strip(), str(BIN / "fleet-switchboard"))

    def test_up_names_the_models_v2_does_list_when_the_configured_one_is_missing(self):
        trial = self.trial()
        listing = subprocess.CompletedProcess([], 0, "github-copilot/a github-copilot/b other/c\n", "")
        with mock.patch.object(TRIAL.Trial, "wrapper_run", return_value=listing):
            self.assertIsNone(trial.model_problem("github-copilot/a"))
            problem = trial.model_problem("github-copilot/zzz")
        self.assertIn("github-copilot/a, github-copilot/b", problem)
        self.assertNotIn("other/c", problem)

    def test_the_wrapper_without_a_gh_login_gives_agents_none(self):
        self.assertNotIn("GH_TOKEN", self.wrapper_env(gh_token="", GH_TOKEN="ambient"))

    def test_the_switchboard_env_points_at_the_trials_dirs_and_the_real_herdr(self):
        trial = self.trial()
        with mock.patch.dict(os.environ, {"HERDR_PANE_ID": "w1:p1", "HERDR_SOCKET_PATH": "/run/herdr.sock"}):
            env = TRIAL.Trial(self.home / "trial").switchboard_env()
        self.assertEqual(env["XDG_CONFIG_HOME"], str(trial.config_home))
        self.assertEqual(env["XDG_STATE_HOME"], str(trial.state_home))
        self.assertEqual(env["HERDR_SOCKET_PATH"], "/run/herdr.sock")
        self.assertNotIn("HERDR_PANE_ID", env, "the daemon is not a pane")
        with mock.patch.dict(os.environ, {"XDG_CONFIG_HOME": "/home/u/.config"}):
            self.assertEqual(TRIAL.Trial(self.home / "trial").switchboard_env()["GH_CONFIG_DIR"], "/home/u/.config/gh",
                             "the daemon's gh keeps the account the user logged in, not an empty one under the trial's dir")

    def test_an_uninitialised_trial_says_what_to_run(self):
        with self.assertRaises(TRIAL.TrialError) as caught:
            self.trial().require_init()
        self.assertIn("init", str(caught.exception))

    def test_up_refuses_without_a_copilot_login(self):
        trial = self.trial()
        trial.root.mkdir(parents=True)
        trial.save({"repo": "o/r", "charter": 1})
        with mock.patch.object(TRIAL.Trial, "logged_in", return_value=False), \
                self.assertRaises(TRIAL.TrialError) as caught:
            TRIAL.cmd_up(trial, None)
        self.assertIn("login", str(caught.exception))

    def test_the_empty_pane_herdr_makes_with_the_workspace_is_closed_once_agents_exist(self):
        trial = self.trial()
        trial.root.mkdir(parents=True)
        trial.save({"repo": "o/r", "spare_pane": "wX:p1"})
        closed = []

        def herdr(*args, **kwargs):
            if args[:2] == ("pane", "list"):
                return {"panes": [{"pane_id": "wX:p1"}, {"pane_id": "wX:p2"}]}
            closed.append(args)
            return {}

        with mock.patch.object(trial.proof, "herdr", herdr):
            self.assertTrue(trial.close_spare_pane())
            self.assertEqual(closed, [("pane", "close", "wX:p1")])
            self.assertNotIn("spare_pane", trial.settings())
            self.assertFalse(trial.close_spare_pane(), "recorded once, closed once")

    def test_the_spare_pane_is_kept_while_it_is_the_only_pane(self):
        trial = self.trial()
        trial.root.mkdir(parents=True)
        trial.save({"spare_pane": "wX:p1"})
        calls = []
        with mock.patch.object(trial.proof, "herdr", lambda *a, **k: calls.append(a) or {"panes": [{"pane_id": "wX:p1"}]}):
            self.assertFalse(trial.close_spare_pane())
        self.assertNotIn(("pane", "close", "wX:p1"), calls)

    def test_a_running_service_is_never_restarted_by_up(self):
        trial = self.trial()
        calls = []

        def wrapper_run(*args, **kwargs):
            calls.append(args)
            return subprocess.CompletedProcess([], 0, "http://127.0.0.1:49380\n" if args == ("service", "status") else "", "")

        with mock.patch.object(TRIAL.Trial, "wrapper_run", side_effect=wrapper_run):
            self.assertEqual(trial.ensure_service(), "already running")
        self.assertEqual(calls, [("service", "status")], "nothing but a status read")

    def test_a_stopped_service_is_started_through_the_wrapper(self):
        trial = self.trial()
        calls = []

        def wrapper_run(*args, **kwargs):
            calls.append((args, kwargs))
            return subprocess.CompletedProcess([], 0, "stopped\n" if args == ("service", "status") else "", "")

        with mock.patch.object(TRIAL.Trial, "wrapper_run", side_effect=wrapper_run):
            self.assertIn("started", trial.ensure_service())
        self.assertEqual(calls[-1], (("service", "start"), {}), "no environment is passed: the wrapper builds it")

    def restart_rig(self, running=("cos", "platform"), sessions=None):
        """A trial whose agents, sessions and herdr are stubs that record what the driver does."""
        trial = self.trial()
        trial.root.mkdir(parents=True, exist_ok=True)
        trial.save({"repo": "o/r", "charter": 1})
        sessions = sessions if sessions is not None else {"cos": "ses_cos", "platform": "ses_platform"}
        panes = {"cos": "wT:p2", "platform": "wT:p3"}
        log = []
        trial.observation = lambda name: {"session": sessions[name], "pane": panes[name]} if name in running else None
        trial.latest_session = lambda name: sessions.get(name)
        trial.workspace_id = lambda create=False: "wT"
        trial.ensure_service = lambda: "already running"
        trial.close_pane = lambda pane, workspace: log.append(("close", pane, workspace))
        trial.resume = lambda workspace, name, session: log.append(("resume", name, session)) or {"pane": "wT:p9"}
        trial.launch = lambda *a, **k: log.append(("launch", a[1])) or {"pane": "wT:p8"}
        return trial, log

    def run_restart(self, trial, names):
        with mock.patch.object(TRIAL, "Trial", return_value=trial), captured():
            return TRIAL.cmd_restart(trial, types.SimpleNamespace(names=names))

    def test_restart_closes_each_pane_then_reopens_the_same_session(self):
        trial, log = self.restart_rig()
        self.run_restart(trial, [])
        self.assertEqual(log, [("close", "wT:p2", "wT"), ("resume", "cos", "ses_cos"),
                               ("close", "wT:p3", "wT"), ("resume", "platform", "ses_platform")])

    def test_restart_of_one_agent_touches_only_that_one(self):
        trial, log = self.restart_rig()
        self.run_restart(trial, ["platform"])
        self.assertEqual(log, [("close", "wT:p3", "wT"), ("resume", "platform", "ses_platform")])

    def test_restart_after_down_resumes_the_session_without_closing_anything(self):
        trial, log = self.restart_rig(running=())
        self.run_restart(trial, ["cos"])
        self.assertEqual(log, [("resume", "cos", "ses_cos")])

    def test_restart_refuses_an_agent_that_never_existed_and_an_unknown_name(self):
        trial, log = self.restart_rig(running=(), sessions={})
        with self.assertRaises(TRIAL.TrialError) as caught:
            self.run_restart(trial, ["cos"])
        self.assertIn("run `switchboard-trial up`", str(caught.exception))
        with self.assertRaises(TRIAL.TrialError):
            self.run_restart(trial, ["stranger"])
        self.assertEqual(log, [])

    def test_a_pane_outside_the_trials_workspace_is_never_closed(self):
        trial = self.trial()
        with mock.patch.object(trial.proof, "herdr", lambda *a, **k: {"pane": {"workspace_id": "wLIVE"}}
                               if a[:2] == ("pane", "get") else self.fail("closed %r" % (a,))):
            with self.assertRaises(TRIAL.TrialError) as caught:
                trial.close_pane("wLIVE:p1", "wT")
        self.assertIn("refusing to close", str(caught.exception))

    def test_up_resumes_an_agent_that_has_a_session_and_no_pane_and_creates_one_that_never_existed(self):
        trial, log = self.restart_rig(running=("platform",), sessions={"cos": "ses_cos", "platform": "ses_platform"})
        self.assertIn("resumed session ses_cos", trial.ensure_agent("cos", "wT", "/d", "o/r", 1))
        self.assertEqual(trial.ensure_agent("platform", "wT", "/d", "o/r", 1), "already running")
        trial2, log2 = self.restart_rig(running=(), sessions={})
        self.assertIn("created", trial2.ensure_agent("cos", "wT", "/d", "o/r", 1))
        self.assertEqual(log2, [("launch", "cos")])

    def test_up_fresh_creates_a_new_session_even_when_one_exists(self):
        trial, log = self.restart_rig(running=(), sessions={"cos": "ses_cos"})
        self.assertIn("created", trial.ensure_agent("cos", "wT", "/d", "o/r", 1, fresh=True))
        self.assertEqual(log, [("launch", "cos")])

    def test_the_newest_session_with_the_agents_name_is_the_one_resumed(self):
        trial = self.trial()
        body = {"data": [{"id": "ses_old", "time": {"created": 1}, "metadata": {"fleet": {"name": "cos"}}},
                         {"id": "ses_new", "time": {"created": 9}, "metadata": {"fleet": {"name": "cos"}}},
                         {"id": "ses_other", "time": {"created": 99}, "metadata": {"fleet": {"name": "platform"}}},
                         {"id": "ses_plain", "time": {"created": 99}, "metadata": None}]}
        done = subprocess.CompletedProcess([], 0, json.dumps(body), "")
        with mock.patch.object(TRIAL.Trial, "wrapper_run", return_value=done):
            self.assertEqual(trial.latest_session("cos"), "ses_new")
            self.assertIsNone(trial.latest_session("coder"))

    def test_the_parser_knows_its_commands(self):
        parser = TRIAL.build_parser()
        for argv in (["init", "--repo", "o/r", "--charter", "1"], ["login"], ["up"], ["up", "--fresh"], ["restart"],
                     ["restart", "cos"], ["status"], ["down"]):
            self.assertIn(parser.parse_args(argv).action, TRIAL.COMMANDS)

    def test_the_service_port_is_not_the_labs(self):
        self.assertEqual(TRIAL.SERVICE_PORT, 49380)
        self.assertNotEqual(TRIAL.SERVICE_PORT, 49374)


def main(argv):
    loader = unittest.TestLoader()
    suite = loader.loadTestsFromModule(sys.modules[__name__])
    if argv:
        keep = unittest.TestSuite()
        for group in suite:
            for case in group:
                if any(token.lower() in case.id().lower() for token in argv):
                    keep.addTest(case)
        suite = keep

    runner = unittest.TextTestRunner(verbosity=2, stream=sys.stdout)
    result = runner.run(suite)

    passed = result.testsRun - len(result.failures) - len(result.errors) - len(result.skipped)
    if SCENARIO_REPORTS:
        print()
        print("Offline scenarios (each control must FAIL what it names):")
        for report in SCENARIO_REPORTS:
            print(format_scenario_report(report))
    print()
    print("=" * 70)
    print("test-switchboard: %d run, %d passed, %d failed, %d errored, %d skipped"
          % (result.testsRun, passed, len(result.failures), len(result.errors), len(result.skipped)))
    print("=" * 70)
    ok = result.wasSuccessful() and result.testsRun > 0
    print("RESULT: %s" % ("PASS" if ok else "FAIL"))
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
