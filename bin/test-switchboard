    def test_awaiting_live_expiry_reads_each_timeline_once_cached_while_the_issue_is_unchanged_and_inside_the_call_limit(self):
        self.charter()
        for n in (120, 121, 122):
            self.add(n, created=30, updated=3, assignees=["bot"], labels=["kind", self.LIVE], body="Next: go")
            self.timeline(n, label_days=1)
        self.go(passes=1)
        reads = lambda: [c for c in self.hub.calls if "/timeline" in c]
        self.assertEqual(len(reads()), 3)
        self.go(passes=3)
        self.assertEqual(len(reads()), 3)                                       # cached: nothing new while the issue is unchanged
        self.hub.open["acme/api"][121] = tri_issue(self.world.clock.now(), 121, created=30, updated=0.1, assignees=["bot"], labels=["kind", self.LIVE], body="Next: go")
        self.world.tick(sb.TRIAGE_TTL + 5)                                      # the list is read again
        self.go(passes=1)
        self.assertEqual(len(reads()), 4)                                       # a new update (a re-added label, a comment) is read again, once
        # the call limit: with a pass budget too small for all of them the rest are shown as unknown, and no pass reads more than it may
        self.hub.calls.clear()
        state = sb.triage_state(self.engine)
        state.live.clear()
        budget = [4]
        sb.triage_read_live(self.engine, state, ["acme/api"], self.world.clock.now(), budget, reserve=2)
        self.assertEqual((len([c for c in self.hub.calls if "/timeline" in c]), budget[0]), (2, 2))

    def test_awaiting_live_days_is_a_module_declared_key_with_default_14_and_a_checked_value(self):
        self.assertIn("awaiting_live_days", sb.config_declarations())
        self.assertEqual(sb.validate_config({})["awaiting_live_days"], 14)
        self.assertEqual(sb.validate_config({"awaiting_live_days": 3.5})["awaiting_live_days"], 3.5)
        for bad in (0, -1, True, "14", 366):
            with self.assertRaises(sb.ConfigError, msg=repr(bad)):
                sb.validate_config({"awaiting_live_days": bad})

    def test_t1_an_explicit_owner_line_in_the_body_is_an_owner(self):
        self.charter()
        for n, body in ((300, "Owner: the platform orchestrator"), (301, "- **Owner:** ops\nmore"), (302, "owned by ops-lead"),
                        (303, "Owner:"), (304, "the owner is unknown"), (305, "> Owner: someone"), (306, "no owner here"),
                        (307, "`Owner: x`")):
