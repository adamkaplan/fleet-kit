    def test_t12_an_open_plan_issue_whose_pr_merged_is_that_finding_with_the_pr_link_and_not_no_owner(self):
        self.charter()
        self.add(130, created=60, labels=["kind"])                         # unowned and old: it would be T1
        self.add(131, created=60, labels=["kind"])
        self.merged_pr(200, "Part of #130.")
        self.merged_pr(201, "PLAN: https://github.com/acme/api/issues/131\n\nCloses #999")
        self.go()
        self.assertEqual(self.only("T12"), ["acme/api#130", "acme/api#131"])
        self.assertEqual((self.only("T1"), self.only("T11")), ([], []))
        row = [e for e in self.world.audit() if e["event"] == "triage.finding" and e["detail"]["ref"] == "acme/api#130" and e["detail"]["rule"] == "T12"][0]
        self.assertEqual((row["detail"]["what"], row["detail"]["evidence"]["pr"], row["detail"]["evidence"]["pr_url"]),
                         ("plan issue still open after its PR merged", 200, "https://github.com/acme/api/pull/200"))   # the link is rebuilt, not the record's html_url
        self.assertFalse(row["detail"]["applied"])

    def ledger(self, *rows):
        """Write a real hash-chained plan ledger into the state dir (proof / verdict rows for acme/api#200)."""
        for kind, scenario, result in rows:
            sb.plan_ledger.append_entry(self.world.state, {"kind": kind, "pr": "acme/api#200", "scenario": scenario, "result": result,
                                                           "evaluator": "tester", "plan_hash": "sha256:x", "head": "a" * 40, "by": "someone"}, self.world.clock.now())

