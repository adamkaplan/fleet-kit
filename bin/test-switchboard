        self.assertNotIn("under_order", self.events("gate.hold_cleared")[0]["detail"])
        code, out, err = self.run_as(None, "impact", "clear", self.PR, "--under-order", "17", "--reason", "the owner judges the hold false")
        self.assertEqual(code, 2)
        self.assertIn("--under-order is for the Chief of Staff", err)

