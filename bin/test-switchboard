#!/usr/bin/env python3
"""test-switchboard — offline tests for fleet-switchboard and fleet-scenario.

Runs with no herdr, no OpenCode, no GitHub and no network. Every test gets a
fresh temp HOME with its own XDG config and state directories, and the only
transports are fakes. Run it before you install anything and after you change
anything.

    bin/test-switchboard            # everything
    bin/test-switchboard V2Client   # only tests whose name contains "V2Client"

The last line printed is `RESULT: PASS` or `RESULT: FAIL`, and the exit code
is non-zero on failure.
"""
import ast
import contextlib
import copy
import fcntl
import fnmatch
import hashlib
import hmac
import importlib.machinery
import importlib.util
import inspect
import io
import json
import os
from pathlib import Path
import re
import shutil
import signal
import socket
import stat
import subprocess
import sys
import sysconfig
import tempfile
import threading
import time
import types
import unittest
from unittest import mock

BIN = Path(__file__).resolve().parent
REPO = BIN.parent
SWITCHBOARD = BIN / "fleet-switchboard"
SCENARIO = BIN / "fleet-scenario"


def _load(name, path):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


sb = _load("t_fleet_switchboard", SWITCHBOARD)
sc = _load("t_fleet_scenario", SCENARIO)


def class_source(name, method=None):
    """The source of a class in bin/fleet-switchboard, or of one of its methods."""
    source = SWITCHBOARD.read_text()
    for node in ast.parse(source).body:
        if isinstance(node, ast.ClassDef) and node.name == name:
            if method is None:
                return ast.get_source_segment(source, node)
            for inner in node.body:
                if isinstance(inner, ast.FunctionDef) and inner.name == method:
                    return ast.get_source_segment(source, inner)
    raise LookupError("%s.%s not found" % (name, method))


@contextlib.contextmanager
def captured():
    out, err = io.StringIO(), io.StringIO()
    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
        yield out, err


# --------------------------------------------------------------------- fakes

class FakeRunner:
    """Stands in for subprocess.run. Records every call; answers from a script.

    Every call gets `default`, or `route(argv)` when a route is given. An
    answer is (returncode, stdout, stderr), or an exception instance to raise.
    """

    def __init__(self, default=(0, '{"data": {}}', ""), route=None):
        self.calls = []
        self.default = default
        self.route = route

    @property
    def argv(self):
        return self.calls[-1][0]

    @property
    def kwargs(self):
        return self.calls[-1][1]

    def __call__(self, argv, **kwargs):
        self.calls.append((list(argv), kwargs))
        answer = self.route(argv) if self.route else self.default
        if isinstance(answer, BaseException):
            raise answer
        code, stdout, stderr = answer
        return subprocess.CompletedProcess(argv, code, stdout, stderr)


SAFE_PATH = "/usr/bin:/bin"


class Base(unittest.TestCase):
    def setUp(self):
        tmp = tempfile.TemporaryDirectory()
        self.addCleanup(tmp.cleanup)
        self.home = Path(tmp.name).resolve()
        patcher = mock.patch.dict(os.environ, {
            "HOME": str(self.home),
            "XDG_CONFIG_HOME": str(self.home / "xdg-config"),
            "XDG_STATE_HOME": str(self.home / "xdg-state"),
            # A test that forgets to inject a fake must fail, not reach the
            # machine's real herdr or OpenCode: neither lives in these.
            "PATH": SAFE_PATH,
        })
        patcher.start()
        self.addCleanup(patcher.stop)
        for name in (sb.LAB_ENV, sb.FAULT_ENV, "HERDR_PANE_ID"):
            os.environ.pop(name, None)
        self.config_file = self.home / "xdg-config" / "fleet-switchboard" / "config.json"
        self.state_dir = self.home / "xdg-state" / "fleet-switchboard"

    def write_config(self, obj):
        self.config_file.parent.mkdir(parents=True, exist_ok=True)
        self.config_file.write_text(obj if isinstance(obj, str) else json.dumps(obj))

    def fake_bin(self, name, body):
        path = self.home / name
        path.write_text("#!/bin/sh\n" + body)
        os.chmod(str(path), 0o755)
        return path

    def run_cli(self, path, *argv):
        return subprocess.run([sys.executable, "-B", str(path), *argv],
                              capture_output=True, text=True, env=dict(os.environ))


# ------------------------------------------------------------------ the config

class TestConfig(Base):
    def test_missing_file_means_every_default(self):
        self.assertFalse(self.config_file.exists())
        self.assertEqual(sb.load_config(), {
            "opencode": None, "opencode_env": {}, "opencode_executable": None, "launch_env": {},
            "herdr": "herdr", "batch_seconds": 90, "engaged_minutes": 10, "call_timeout_seconds": 20, "poll_seconds": 5,
            "worker_lookback_hours": 24,
            "github_repos": [], "gh": "gh", "github_lookback_hours": 24, "github_port": None,
            "github_events": ["issues", "issue_comment", "sub_issues", "pull_request", "pull_request_review",
                              "check_suite", "workflow_run"],
            "intent_repo": None, "intent_required": True,
            "classifier_mode": "shadow", "busy_poll_seconds": 1,  # PR 8
            "policy": sb.POLICY_DEFAULTS,  # PR 9
            **sb.V1_MOVE_DEFAULTS})  # PR 10: pinned in TestImportV1Config

    def test_path_follows_xdg_config_home(self):
        self.assertEqual(sb.config_path(), self.config_file)

    def test_default_path_is_under_home_when_xdg_is_unset_or_relative(self):
        for value in (None, "relative/dir"):
            with self.subTest(value=value):
                if value is None:
                    os.environ.pop("XDG_CONFIG_HOME", None)
                else:
                    os.environ["XDG_CONFIG_HOME"] = value
                self.assertEqual(sb.config_path(), self.home / ".config/fleet-switchboard/config.json")

    def test_overrides_replace_only_what_they_name(self):
        self.write_config({"opencode": "/opt/lab/bin/opencode", "opencode_env": {"XDG_DATA_HOME": "/tmp/lab"},
                           "batch_seconds": 5, "call_timeout_seconds": 2.5})
        config = sb.load_config()
        self.assertEqual(config["opencode"], "/opt/lab/bin/opencode")
        self.assertEqual(config["opencode_env"], {"XDG_DATA_HOME": "/tmp/lab"})
        self.assertEqual(config["batch_seconds"], 5)
        self.assertEqual(config["call_timeout_seconds"], 2.5)
        self.assertEqual(config["herdr"], "herdr")
        self.assertEqual(config["engaged_minutes"], 10)

    def test_defaults_are_not_shared_between_loads(self):
        sb.load_config()["opencode_env"]["LEAK"] = "1"
        self.assertEqual(sb.load_config()["opencode_env"], {})
        self.assertEqual(sb.DEFAULTS["opencode_env"], {})

    def test_bad_values_are_refused_with_the_key_named(self):
        cases = [
            ({"opencode": 7}, "'opencode'"),
            ({"opencode": ""}, "'opencode'"),
            ({"opencode": "opencode"}, "'opencode'"),
            ({"opencode": "bin/opencode"}, "'opencode'"),
            ({"herdr": None}, "'herdr'"),
            ({"herdr": ["herdr"]}, "'herdr'"),
            ({"opencode_env": ["A=1"]}, "'opencode_env'"),
            ({"opencode_env": {"A": 1}}, "'opencode_env'"),
            ({"opencode_env": {"BAD NAME": "x"}}, "'opencode_env'"),
            ({"batch_seconds": "90"}, "'batch_seconds'"),
            ({"batch_seconds": True}, "'batch_seconds'"),
            ({"batch_seconds": 0}, "'batch_seconds'"),
            ({"engaged_minutes": -1}, "'engaged_minutes'"),
            ({"engaged_minutes": None}, "'engaged_minutes'"),
            ({"call_timeout_seconds": "20"}, "'call_timeout_seconds'"),
            ({"poll_seconds": 0}, "'poll_seconds'"),
            ({"surprise": 1}, "surprise"),
        ]
        for raw, needle in cases:
            with self.subTest(raw=raw):
                self.write_config(raw)
                with self.assertRaises(sb.ConfigError) as caught:
                    sb.load_config()
                self.assertIn(needle, str(caught.exception))

    def test_malformed_files_are_refused(self):
        for text, needle in (("{not json", "not valid JSON"), ("[1, 2]", "JSON object"), ('"x"', "JSON object")):
            with self.subTest(text=text):
                self.write_config(text)
                with self.assertRaises(sb.ConfigError) as caught:
                    sb.load_config()
                self.assertIn(needle, str(caught.exception))


# ------------------------------------------------------------------- the state

class TestStateDir(Base):
    def test_created_private_under_xdg_state_home_whatever_the_umask(self):
        # 0o277 strips owner bits from mkdir's mode, so only an explicit chmod
        # yields exactly 0700; 0 would let a looser mode through if one were asked for.
        for umask in (0, 0o022, 0o277):
            with self.subTest(umask=oct(umask)):
                if self.state_dir.exists():
                    self.state_dir.rmdir()
                self.state_dir.parent.mkdir(parents=True, exist_ok=True)
                old = os.umask(umask)
                try:
                    path = sb.ensure_state_dir()
                finally:
                    os.umask(old)
                self.assertEqual(path, self.state_dir)
                self.assertEqual(stat.S_IMODE(path.stat().st_mode), 0o700)

    def test_missing_parents_are_created_too(self):
        self.assertFalse(self.state_dir.parent.exists())
        self.assertEqual(stat.S_IMODE(sb.ensure_state_dir().stat().st_mode), 0o700)

    def test_default_is_under_home_when_xdg_is_unset(self):
        os.environ.pop("XDG_STATE_HOME", None)
        self.assertEqual(sb.state_dir_path(), self.home / ".local/state/fleet-switchboard")

    def test_existing_private_dir_is_accepted(self):
        self.state_dir.mkdir(parents=True, mode=0o700)
        os.chmod(str(self.state_dir), 0o700)
        self.assertEqual(sb.ensure_state_dir(), self.state_dir)

    def test_group_or_world_readable_dir_is_refused_not_repaired(self):
        for mode in (0o750, 0o705, 0o755, 0o777):
            with self.subTest(mode=oct(mode)):
                self.state_dir.mkdir(parents=True, exist_ok=True)
                os.chmod(str(self.state_dir), mode)
                with self.assertRaises(sb.ConfigError) as caught:
                    sb.ensure_state_dir()
                self.assertIn("private", str(caught.exception))
                self.assertEqual(stat.S_IMODE(self.state_dir.stat().st_mode), mode)

    def test_a_file_in_its_place_is_refused(self):
        self.state_dir.parent.mkdir(parents=True)
        self.state_dir.write_text("")
        os.chmod(str(self.state_dir), 0o600)
        with self.assertRaises(sb.ConfigError):
            sb.ensure_state_dir()


# ------------------------------------------------------------- OpenCode v2

SES = "ses_0123456789abcdef"
MSG = "msg_0123456789abcdef0123456789"


class TestV2Client(Base):
    def client(self, **runner_args):
        runner = FakeRunner(**runner_args)
        return sb.V2Client("/opt/lab/bin/opencode", {"XDG_DATA_HOME": "/tmp/lab-data"}, runner, 7), runner

    def test_argv_for_every_method(self):
        meta = {"fleet": {"name": "coder", "role": "coder"}}
        cases = [
            (lambda c: c.server_info(), ["server.info"]),
            (lambda c: c.session_create("build", "Coder", "/srv/repo", meta),
             ["session.create", "-d", json.dumps(
                 {"agent": "build", "location": {"directory": "/srv/repo"}, "metadata": meta, "title": "Coder"},
                 separators=(",", ":"), sort_keys=True)]),
            (lambda c: c.session_create("build", "Coder", "/srv/repo", meta, permissions=[{"action": "deny"}]),
             ["session.create", "-d", json.dumps(
                 {"agent": "build", "location": {"directory": "/srv/repo"}, "metadata": meta,
                  "permissions": [{"action": "deny"}], "title": "Coder"},
                 separators=(",", ":"), sort_keys=True)]),
            (lambda c: c.session_get(SES), ["session.get", "--param", "sessionID=" + SES]),
            (lambda c: c.session_active(), ["session.active"]),
            (lambda c: c.message_list(SES), ["session.message.list", "--param", "sessionID=" + SES]),
            (lambda c: c.message_list(SES, limit=20, order="desc", type="synthetic", cursor="cur_1"),
             ["session.message.list", "--param", "sessionID=" + SES, "--param", "limit=20",
              "--param", "order=desc", "--param", "type=synthetic", "--param", "cursor=cur_1"]),
            (lambda c: c.synthetic(SES, "[switchboard] hi", {"fleet": {"keys": ["a"]}}, False, "queue", MSG),
             ["session.synthetic", "--param", "sessionID=" + SES, "-d", json.dumps(
                 {"delivery": "queue", "id": MSG, "metadata": {"fleet": {"keys": ["a"]}},
                  "resume": False, "text": "[switchboard] hi"}, separators=(",", ":"), sort_keys=True)]),
            (lambda c: c.prompt(SES, "brief"),
             ["session.prompt", "--param", "sessionID=" + SES, "-d", '{"text":"brief"}']),
            (lambda c: c.prompt(SES, "brief", metadata={"fleet": {}}, delivery="queue", resume=True),
             ["session.prompt", "--param", "sessionID=" + SES, "-d",
              '{"delivery":"queue","metadata":{"fleet":{}},"resume":true,"text":"brief"}']),
            (lambda c: c.inbox_list(SES), ["session.inbox.list", "--param", "sessionID=" + SES]),
            (lambda c: c.inbox_update(SES, MSG, "steer"),
             ["session.inbox.update", "--param", "sessionID=" + SES, "--param", "inboxID=" + MSG,
              "-d", '{"delivery":"steer"}']),
        ]
        for call, tail in cases:
            client, runner = self.client()
            call(client)
            with self.subTest(op=tail[0]):
                self.assertEqual(runner.argv, ["/opt/lab/bin/opencode", "api"] + tail)
                self.assertEqual(runner.kwargs["timeout"], 7)
                self.assertTrue(runner.kwargs["capture_output"])
                self.assertEqual(runner.kwargs["stdin"], subprocess.DEVNULL)

    def test_every_call_goes_through_one_method(self):
        source = class_source("V2Client")
        self.assertEqual(source.count("self.runner("), 1)
        self.assertEqual(source.count('"api"'), 1)
        self.assertIn("self.runner(", class_source("V2Client", "_call"))

    def test_env_is_the_process_env_with_the_config_env_on_top(self):
        os.environ["XDG_DATA_HOME"] = "/live/data"
        os.environ["SOMETHING_ELSE"] = "kept"
        client, runner = self.client()
        client.server_info()
        env = runner.kwargs["env"]
        self.assertEqual(env["XDG_DATA_HOME"], "/tmp/lab-data")
        self.assertEqual(env["SOMETHING_ELSE"], "kept")
        self.assertEqual(os.environ["XDG_DATA_HOME"], "/live/data")

    def test_data_envelope_is_unwrapped(self):
        client, _ = self.client(default=(0, '{"data": {"ses_1": {"type": "running"}}}', ""))
        self.assertEqual(client.session_active(), {"ses_1": {"type": "running"}})
        client, _ = self.client(default=(0, '{"data": {}}', ""))
        self.assertEqual(client.session_active(), {})
        client, _ = self.client(default=(0, '[{"id": "msg_1"}]', ""))
        self.assertEqual(client.message_list(SES), [{"id": "msg_1"}])
        client, _ = self.client(default=(0, "  \n", ""))
        self.assertIsNone(client.server_info())

    def test_http_error_carries_its_status_and_body(self):
        client, _ = self.client(default=(1, '{"name":"NotFound","message":"no such session"}',
                                         "HTTP 404 Not Found\n"))
        with self.assertRaises(sb.V2Error) as caught:
            client.session_get(SES)
        err = caught.exception
        self.assertEqual((err.reason, err.status), ("http", 404))
        self.assertIn("no such session", err.detail)
        self.assertIn("404", str(err))

    def test_nonzero_exit_without_http_status(self):
        client, _ = self.client(default=(1, "", "error: cannot find the service\nmore\n"))
        with self.assertRaises(sb.V2Error) as caught:
            client.server_info()
        self.assertEqual((caught.exception.reason, caught.exception.status), ("exit", None))
        self.assertNotIn("\n", caught.exception.detail)
        client, _ = self.client(default=(3, "", ""))
        with self.assertRaises(sb.V2Error) as caught:
            client.server_info()
        self.assertIn("exit 3", str(caught.exception))

    def test_timeout_and_missing_binary(self):
        client, _ = self.client(default=subprocess.TimeoutExpired(["x"], 7))
        with self.assertRaises(sb.V2Error) as caught:
            client.session_active()
        self.assertEqual(caught.exception.reason, "timeout")
        client, _ = self.client(default=FileNotFoundError(2, "No such file or directory"))
        with self.assertRaises(sb.V2Error) as caught:
            client.session_active()
        self.assertEqual(caught.exception.reason, "unavailable")

    def test_bad_json_on_success(self):
        client, _ = self.client(default=(0, "Commands:\n  opencode api\n", ""))
        with self.assertRaises(sb.V2Error) as caught:
            client.server_info()
        self.assertEqual(caught.exception.reason, "bad_json")

    def test_errors_never_carry_the_environment(self):
        client = sb.V2Client("/opt/lab/bin/opencode", {"OPENCODE_SERVER_PASSWORD": "hunter2-value"},
                             FakeRunner(default=(1, "", "HTTP 401 Unauthorized")), 7)
        with self.assertRaises(sb.V2Error) as caught:
            client.server_info()
        self.assertNotIn("hunter2-value", str(caught.exception))

    def test_arguments_are_checked_before_anything_runs(self):
        client, runner = self.client()
        bad = [
            lambda: client.synthetic(SES, "t", {}, "false", "queue", MSG),
            lambda: client.synthetic(SES, "t", {}, False, "interrupt", MSG),
            lambda: client.synthetic(SES, "t", {}, False, "queue", "abc"),
            lambda: client.message_list(SES, order="newest"),
            lambda: client.session_create("build", "t", "relative/dir", {}),
            lambda: client.inbox_update(SES, MSG, "now"),
            lambda: client.prompt(SES, "t", delivery="later"),
        ]
        for call in bad:
            with self.assertRaises(ValueError):
                call()
        self.assertEqual(runner.calls, [])


# ------------------------------------------------------------------- herdr

FORBIDDEN_HERDR = ("prompt", "send-keys", "send-text", "run", "focus")


def herdr_typing_violations(source):
    """Every way `source` could make herdr type into a pane or move focus.

    Used on bin/fleet-switchboard, and on a planted violation to show it bites.
    """
    found = []
    tree = ast.parse(source)
    tokens = [node.value for node in ast.walk(tree)
              if isinstance(node, ast.Constant) and isinstance(node.value, str) and not re.search(r"\s", node.value)]
    for token in tokens:
        if token in ("send-keys", "send-text"):
            found.append(token)
        if "focus" in token.lower() and not token.startswith("--no-"):
            found.append(token)
    for node in ast.walk(tree):
        if isinstance(node, ast.ClassDef) and node.name == "HerdrClient":
            for inner in ast.walk(node):
                if isinstance(inner, ast.Constant) and inner.value in FORBIDDEN_HERDR:
                    found.append("HerdrClient uses %r" % inner.value)
    for token in tokens:  # the socket: any herdr method but the one allowed is a way in
        if re.match(r"^(agent|pane|tab|workspace|terminal|layout|window|input)\.", token) \
                and token not in SOCKET_ALLOWED:
            found.append("socket method %s" % token)
    for pattern in (r"""["']agent["']\s*,\s*["'](prompt|send-keys)["']""",
                    r"""["']pane["']\s*,\s*["'](send-text|send-keys|run)["']"""):
        found.extend(m.group(0) for m in re.finditer(pattern, source))
    return found


class TestHerdrClient(Base):
    def client(self, stdout='{"result": {"agents": [], "agent": {}, "shown": true, "reason": "shown", '
                            '"process_info": {"foreground_processes": []}}}'):
        runner = FakeRunner(default=(0, stdout, ""))
        return sb.HerdrClient("/opt/herdr", runner), runner

    def test_argv_for_every_method(self):
        cases = [
            (lambda c: c.agent_list(), ["agent", "list"]),
            (lambda c: c.agent_get("w1:p2"), ["agent", "get", "w1:p2"]),
            # herdr 0.9.3: the pane id is the first positional argument, not --pane.
            (lambda c: c.pane_report_metadata_token("w1:p2", "unread", 3),
             ["pane", "report-metadata", "w1:p2", "--source", "fleet-switchboard", "--token", "unread=3"]),
            (lambda c: c.pane_report_metadata_token("w1:p2", "unread", 4, ttl_ms=60000),
             ["pane", "report-metadata", "w1:p2", "--source", "fleet-switchboard", "--token", "unread=4",
              "--ttl-ms", "60000"]),
            (lambda c: c.pane_clear_token("w1:p2", "unread"),
             ["pane", "report-metadata", "w1:p2", "--source", "fleet-switchboard", "--clear-token", "unread"]),
            # The title is positional, not --title.
            (lambda c: c.notification_show("Held", "coder is blocked"),
             ["notification", "show", "Held", "--body", "coder is blocked"]),
            (lambda c: c.notification_show("Held"), ["notification", "show", "Held"]),
            (lambda c: c.pane_process_info("w1:p2"), ["pane", "process-info", "--pane", "w1:p2"]),
            (lambda c: c.pane_close("w1:p2"), ["pane", "close", "w1:p2"]),
        ]
        for call, tail in cases:
            client, runner = self.client()
            call(client)
            with self.subTest(tail=tail):
                self.assertEqual(runner.argv, ["/opt/herdr"] + tail)
                self.assertEqual(runner.kwargs["stdin"], subprocess.DEVNULL)

    def test_the_strict_fake_refuses_the_old_argv_shapes(self):
        world = World(self, agents=("platform",))
        pane = world.panes["platform"]
        for argv in (["pane", "report-metadata", "--pane", pane, "--source", "x", "--token", "unread=1"],
                     ["notification", "show", "--title", "t", "--body", "b"],
                     ["pane", "report-metadata", pane, "--token", "unread=1"]):
            with self.subTest(argv=argv):
                self.assertEqual(world.herdr([FAKE_HERDR] + argv).returncode, 2)
        self.assertEqual(world.herdr.panes[pane]["tokens"], {})
        self.assertEqual(world.herdr.toasts, [])

    def test_token_and_toast_inputs_are_checked_before_herdr_is_asked(self):
        client, runner = self.client()
        for bad in (lambda: client.pane_report_metadata_token("w1:p1", "bad name", 1),
                    lambda: client.pane_report_metadata_token("w1:p1", "unread", "x" * 81),
                    lambda: client.pane_report_metadata_token("w1:p1", "unread", ""),
                    lambda: client.pane_clear_token("w1:p1", "no/slash")):
            with self.assertRaises(ValueError):
                bad()
        self.assertEqual(runner.calls, [])
        client.notification_show("t" * 200, "b" * 500)
        self.assertEqual((len(runner.argv[3]), len(runner.argv[5])), (80, 240))

    def test_a_toast_reply_says_whether_it_was_shown_and_why_not(self):
        for reason, shown in (("shown", True), ("rate_limited", False), ("no_foreground_client", False),
                              ("disabled", False), ("busy", False)):
            client, _ = self.client('{"result": {"type": "notification_show", "shown": %s, "reason": "%s"}}'
                                    % ("true" if shown else "false", reason))
            with self.subTest(reason=reason):
                self.assertEqual(client.notification_show("t"), {"shown": shown, "reason": reason})
        client, _ = self.client('{"result": {}}')
        with self.assertRaises(sb.HerdrError):
            client.notification_show("t")

    def test_replies_are_unwrapped_and_checked(self):
        client, _ = self.client('{"result": {"agents": [{"pane_id": "w1:p2"}]}}')
        self.assertEqual(client.agent_list(), [{"pane_id": "w1:p2"}])
        client, _ = self.client('{"result": {"agent": {"agent_status": "idle"}}}')
        self.assertEqual(client.agent_get("w1:p2"), {"agent_status": "idle"})
        client, _ = self.client('{"result": {"process_info": {"foreground_processes": [{"cmdline": "x y"}]}}}')
        self.assertEqual(client.pane_process_info("w1:p2"), [{"cmdline": "x y"}])
        client, _ = self.client('{"result": {}}')
        for call in (client.agent_list, lambda: client.pane_process_info("w1:p2")):
            with self.assertRaises(sb.HerdrError) as caught:
                call()
            self.assertEqual(caught.exception.reason, "bad_shape")

    def test_failures_map_to_one_error_type(self):
        for answer, reason in (((1, "", "no server\n"), "exit"), ((0, "nope", ""), "bad_json"),
                               (subprocess.TimeoutExpired(["herdr"], 15), "timeout"),
                               (FileNotFoundError(2, "No such file"), "unavailable")):
            with self.subTest(reason=reason):
                client = sb.HerdrClient("/opt/herdr", FakeRunner(default=answer))
                with self.assertRaises(sb.HerdrError) as caught:
                    client.agent_list()
                self.assertEqual(caught.exception.reason, reason)

    def test_it_can_only_read_badge_toast_open_a_program_and_close_its_own_pane(self):
        public = sorted(name for name, _ in inspect.getmembers(sb.HerdrClient, inspect.isfunction)
                        if not name.startswith("_"))
        self.assertEqual(public, ["agent_get", "agent_list", "notification_show", "open_tab_running",
                                  "pane_clear_token", "pane_close", "pane_process_info",
                                  "pane_report_metadata_token"])

    def test_the_socket_admits_one_method_and_sends_no_focus_key(self):
        sent = []

        def socket_call(path, method, params, timeout):
            sent.append((path, method, params))
            return {"result": {"layout": {"tab_id": "w1:t2", "root": {"pane_id": "w1:p3"}}}}

        client = sb.HerdrClient("/opt/herdr", FakeRunner(), socket_call=socket_call, socket_path="/s/herdr.sock")
        self.assertEqual(client.open_tab_running("w1", "coder", "/work", ["/bin/oc", "-s", "ses_1"], {"A": "b"}),
                         {"tab_id": "w1:t2", "pane_id": "w1:p3"})
        path, method, params = sent[0]
        self.assertEqual((path, method), ("/s/herdr.sock", "layout.apply"))
        self.assertEqual(params, {"workspace_id": "w1", "tab_label": "coder", "root": {
            "type": "pane", "label": "coder", "cwd": "/work", "command": ["/bin/oc", "-s", "ses_1"],
            "env": {"A": "b"}}})
        self.assertNotIn("focus", json.dumps(params).lower())
        with self.assertRaises(ValueError):
            client._socket("pane.send_text", {})
        self.assertEqual(len(sent), 1)

    def test_a_socket_error_or_odd_reply_is_a_herdr_error(self):
        for reply in ({"error": {"code": "workspace_not_found"}}, {"result": {}}, {"result": {"layout": {}}}):
            client = sb.HerdrClient("/opt/herdr", FakeRunner(), socket_call=lambda *a, r=reply: r)
            with self.subTest(reply=reply), self.assertRaises(sb.HerdrError):
                client.open_tab_running("w1", "c", "/w", ["/x"], {})

    def test_the_real_socket_call_speaks_one_json_line_each_way(self):
        path = str(self.home / "s.sock")
        server = sb.socket.socket(sb.socket.AF_UNIX, sb.socket.SOCK_STREAM)
        server.bind(path)
        server.listen(1)
        seen = []

        def serve():
            conn, _ = server.accept()
            seen.append(conn.recv(65536))
            conn.sendall(b'{"id":"x","result":{"ok":true}}\n')
            conn.close()

        thread = threading.Thread(target=serve)
        thread.start()
        try:
            reply = sb.unix_socket_call(path, "layout.apply", {"a": 1}, 5)
        finally:
            thread.join(5)
            server.close()
        self.assertEqual(reply, {"id": "x", "result": {"ok": True}})
        self.assertEqual(json.loads(seen[0]), {"id": "fleet-switchboard:layout.apply", "method": "layout.apply",
                                               "params": {"a": 1}})
        self.assertTrue(seen[0].endswith(b"\n"))
        with self.assertRaises(sb.HerdrError) as caught:
            sb.unix_socket_call(str(self.home / "nobody.sock"), "layout.apply", {}, 1)
        self.assertEqual(caught.exception.reason, "unavailable")

    def test_the_socket_path_follows_herdr(self):
        self.assertEqual(sb.herdr_socket_path({"HERDR_SOCKET_PATH": "/x/h.sock"}), "/x/h.sock")
        self.assertEqual(sb.herdr_socket_path({"XDG_CONFIG_HOME": "/cfg"}), "/cfg/herdr/herdr.sock")

    def test_no_call_it_makes_types_or_moves_focus(self):
        client, runner = self.client()
        client.agent_list()
        client.agent_get("w1:p2")
        client.pane_report_metadata_token("w1:p2", "unread", 1, ttl_ms=5)
        client.pane_clear_token("w1:p2", "unread")
        client.notification_show("t", "b")
        client.pane_process_info("w1:p2")
        client.pane_close("w1:p2")
        for argv, _ in runner.calls:
            subcommands = argv[1:3]
            for word in FORBIDDEN_HERDR:
                self.assertNotIn(word, subcommands, argv)
            self.assertFalse(any("focus" in part and not part.startswith("--no-") for part in argv), argv)

    def test_source_never_names_a_typing_or_focus_command(self):
        self.assertEqual(herdr_typing_violations(SWITCHBOARD.read_text()), [])

    def test_the_source_scan_catches_a_planted_violation(self):
        # A gate never seen failing is decoration.
        planted = SWITCHBOARD.read_text().replace(
            "    def notification_show(self, title, body=None):",
            "    def wake(self, pane, text):\n        return self._call(\"agent\", \"prompt\", pane, text)\n\n"
            "    def notification_show(self, title, body=None):")
        self.assertNotEqual(planted, SWITCHBOARD.read_text())
        self.assertTrue(herdr_typing_violations(planted))
        for snippet in ('x = ["pane", "send-text", p]', 'x = ("pane", "run", p)', 'x = ["tab", "focus"]',
                        'x = "pane.send_text"', 'x = "agent.prompt"', 'y = {"focus": True}'):
            with self.subTest(snippet=snippet):
                self.assertTrue(herdr_typing_violations(snippet))
        self.assertEqual(herdr_typing_violations('x = ["tab", "create", "--no-focus"]'), [])
        self.assertEqual(herdr_typing_violations('x = "layout.apply"; y = "run.lock"'), [])


# ----------------------------------------------------------------- the audit

class TestAuditLog(Base):
    def setUp(self):
        super().setUp()
        self.path = sb.ensure_state_dir() / "audit.jsonl"
        self.audit = sb.AuditLog(self.path)

    def entries(self):
        return [json.loads(line) for line in self.path.read_text().splitlines()]

    def test_append_writes_one_json_line_per_entry(self):
        self.audit.append("daemon", "hold", "coder", {"why": "blocked"})
        self.audit.append("daemon", "pass", None)
        entries = self.entries()
        self.assertEqual(len(entries), 2)
        first = entries[0]
        self.assertEqual({k: first[k] for k in ("actor", "event", "subject", "detail")},
                         {"actor": "daemon", "event": "hold", "subject": "coder", "detail": {"why": "blocked"}})
        self.assertRegex(first["ts"], r"^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d\.\d{3}Z$")

    def test_append_never_rewrites_what_is_there(self):
        self.path.write_text('{"earlier": true}\n')
        os.chmod(str(self.path), 0o600)
        self.audit.append("cli", "send", "platform")
        lines = self.path.read_text().splitlines()
        self.assertEqual(lines[0], '{"earlier": true}')
        self.assertEqual(len(lines), 2)

    def test_file_is_private(self):
        old = os.umask(0)
        try:
            self.audit.append("cli", "send", "platform")
        finally:
            os.umask(old)
        self.assertEqual(stat.S_IMODE(self.path.stat().st_mode), 0o600)

    def test_each_write_is_flushed_to_disk(self):
        with mock.patch.object(sb.os, "fsync", wraps=os.fsync) as fsync:
            self.audit.append("cli", "send", "platform")
        self.assertEqual(fsync.call_count, 1)

    def test_external_writes_intent_then_result(self):
        with self.audit.external("daemon", "v2.synthetic", "platform", {"message_id": MSG}) as outcome:
            self.assertEqual([e["phase"] for e in self.entries()], ["intent"])
            outcome["receipt"] = "msg_x"
        intent, result = self.entries()
        self.assertEqual((intent["phase"], result["phase"]), ("intent", "result"))
        self.assertEqual(intent["call"], result["call"])
        self.assertEqual(intent["detail"], {"message_id": MSG})
        self.assertTrue(result["ok"])
        self.assertEqual(result["detail"], {"receipt": "msg_x"})
        self.assertEqual((result["event"], result["subject"]), ("v2.synthetic", "platform"))

    def test_external_records_the_error_and_reraises(self):
        with self.assertRaises(sb.V2Error):
            with self.audit.external("daemon", "v2.synthetic", "platform"):
                raise sb.V2Error("http", 503, "service down")
        intent, result = self.entries()
        self.assertEqual(intent["phase"], "intent")
        self.assertFalse(result["ok"])
        self.assertIn("V2Error", result["error"])
        self.assertIn("503", result["error"])

    def test_credentials_are_redacted_at_any_depth(self):
        self.audit.append("daemon", "config", "x", {
            "token": "t-1", "api_key": "k-2", "Password": "p-3", "client_secret": "s-4",
            "Authorization": "Bearer a-5", "OPENROUTER_API_KEY": "k-6",
            "nested": [{"headers": {"authorization": "Bearer b-7"}}, {"accessToken": "t-8"}],
            "keys": ["worker.idle:ses_1:1700000000"], "plain": "visible"})
        text = self.path.read_text()
        for secret in ("t-1", "k-2", "p-3", "s-4", "a-5", "k-6", "b-7", "t-8"):
            self.assertNotIn(secret, text)
        detail = self.entries()[0]["detail"]
        self.assertEqual(detail["token"], sb.REDACTED)
        self.assertEqual(detail["nested"][0]["headers"]["authorization"], sb.REDACTED)
        self.assertEqual(detail["plain"], "visible")
        # The fact keys a message covers are what the audit exists to show.
        self.assertEqual(detail["keys"], ["worker.idle:ses_1:1700000000"])

    def test_external_redacts_both_entries(self):
        with self.audit.external("daemon", "x", "y", {"secret": "s-1"}) as outcome:
            outcome["token"] = "t-2"
        text = self.path.read_text()
        self.assertNotIn("s-1", text)
        self.assertNotIn("t-2", text)


# ------------------------------------------------------------------ the faults

DOC_FAULTS = ("no-engagement-gate", "no-recheck", "no-dedupe", "steer-not-queue", "no-batch",
              "no-intent-header", "no-classify", "crash-after-send", "no-policy-judge",
              "judge-loosens", "no-maxims", "no-worker-source", "no-note-conversion",
              "no-import-metadata")


class TestFaults(Base):
    def test_the_list_is_the_documented_one(self):
        self.assertEqual(tuple(sb.KNOWN_FAULTS), DOC_FAULTS)
        self.assertEqual(sc.KNOWN_FAULTS, DOC_FAULTS)

    def test_off_outside_the_lab(self):
        os.environ[sb.FAULT_ENV] = "no-batch"
        self.assertFalse(sb.fault("no-batch"))
        for marker in ("0", "true", "yes", ""):
            os.environ[sb.LAB_ENV] = marker
            self.assertFalse(sb.fault("no-batch"), marker)

    def test_on_in_the_lab_only_for_named_faults(self):
        os.environ[sb.LAB_ENV] = "1"
        self.assertFalse(sb.fault("no-batch"))
        os.environ[sb.FAULT_ENV] = " no-batch , no-recheck,"
        self.assertTrue(sb.fault("no-batch"))
        self.assertTrue(sb.fault("no-recheck"))
        self.assertFalse(sb.fault("no-dedupe"))

    def test_an_unknown_name_raises_in_or_out_of_the_lab(self):
        for lab in ("1", None):
            with self.subTest(lab=lab):
                if lab:
                    os.environ[sb.LAB_ENV] = lab
                else:
                    os.environ.pop(sb.LAB_ENV, None)
                os.environ[sb.FAULT_ENV] = "no-batch,no-bacth"
                with self.assertRaises(sb.FaultError) as caught:
                    sb.fault("no-batch")
                self.assertIn("no-bacth", str(caught.exception))
        os.environ.pop(sb.FAULT_ENV)
        with self.assertRaises(sb.FaultError):
            sb.fault("not-a-fault")


# ------------------------------------------------------------- the message id

class TestMessageId(unittest.TestCase):
    def test_shape(self):
        self.assertRegex(sb.derive_message_id("ses_1", ["a"]), r"^msg_[0-9a-f]{26}$")

    def test_pinned_canonical_form(self):
        # A change here changes every id, and v2 would admit retried messages twice.
        canonical = json.dumps(["ses_1", ["a", "b"]], separators=(",", ":"))
        expected = "msg_" + hashlib.sha256(canonical.encode()).hexdigest()[:26]
        self.assertEqual(sb.derive_message_id("ses_1", ["b", "a"]), expected)

    def test_stable_and_independent_of_order_and_duplicates(self):
        first = sb.derive_message_id("ses_1", ["worker.idle:ses_2:10", "reminder:3"])
        self.assertEqual(first, sb.derive_message_id("ses_1", ["reminder:3", "worker.idle:ses_2:10"]))
        self.assertEqual(first, sb.derive_message_id("ses_1", ("reminder:3", "reminder:3", "worker.idle:ses_2:10")))
        self.assertEqual(first, sb.derive_message_id("ses_1", iter(["worker.idle:ses_2:10", "reminder:3"])))

    def test_recipient_and_keys_both_matter(self):
        base = sb.derive_message_id("ses_1", ["a"])
        self.assertNotEqual(base, sb.derive_message_id("ses_2", ["a"]))
        self.assertNotEqual(base, sb.derive_message_id("ses_1", ["a", "b"]))
        # No ambiguity from joining: one key with a comma is not two keys.
        self.assertNotEqual(sb.derive_message_id("ses_1", ["a,b"]), sb.derive_message_id("ses_1", ["a", "b"]))

    def test_nothing_to_derive_from_is_refused(self):
        for recipient, keys in (("ses_1", []), ("", ["a"]), ("ses_1", [""]), ("ses_1", [1])):
            with self.subTest(recipient=recipient, keys=keys):
                with self.assertRaises(ValueError):
                    sb.derive_message_id(recipient, keys)


