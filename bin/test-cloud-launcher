#!/bin/sh
# test-cloud-launcher: offline tests for the cloud-worker launcher (fake kubectl, fake clock). Prints RESULT: PASS.
# The chain is the list file bin/test-cloud-launcher.chain, ONE entry per line (a path), sorted, with one fixed last line.
# (It used to be ONE shell line of more than forty commands joined by &&; every member appended to it and every pair conflicted.)
# Every entry runs even when one fails: each failure is named in a FAILED line and in the closing line `failed entries: N: <names>`, then RESULT: FAIL (exit 1). The completeness checks (NOT RUN) stop the run before any entry.
# To add a test: add one line to bin/test-cloud-launcher.chain at its alphabetical place, ABOVE the fixed last line (even if it sorts after it).
cd "$(dirname "$0")/.." || exit 1
LIST=bin/test-cloud-launcher.chain
# Completeness check: every test_*.py must be listed in $LIST, or named here with a reason; every listed entry must exist.
EXCEPTIONS="test_cloud_pod_deadline.py:slow(26s),not-yet-chained test_cloud_stop_nonce.py:slow(57s),not-yet-chained test_reaper_record_family.py:did-not-finish-in-120s,not-yet-chained"
[ -f "$LIST" ] || { echo "NOT RUN: $LIST is missing"; echo "RESULT: FAIL"; exit 1; }
for f in cloud/launcher/tests/test_*.py; do
  [ -e "$f" ] || continue
  n=$(basename "$f")
  grep -qx "cloud/launcher/tests/$n" "$LIST" && continue
  case " $EXCEPTIONS " in *" $n:"*) continue ;; esac
  echo "NOT RUN: $n is neither chained nor in EXCEPTIONS"; echo "RESULT: FAIL"; exit 1
done
for f in bin/test-cloud-cost-*; do
  [ -e "$f" ] || continue
  n=$(basename "$f")
  grep -qx "bin/$n" "$LIST" && continue
  echo "NOT RUN: bin/$n is not chained"; echo "RESULT: FAIL"; exit 1
done
# Every bin/test-cloud-* script must be listed in $LIST or named here with a reason (a third, wider check).
BIN_EXCEPTIONS="test-cloud-hub:own-ci-step test-cloud-hub-relay:own-ci-step test-cloud-relay:own-ci-step test-cloud-relay-daemon:own-ci-step test-cloud-channel:own-ci-step test-cloud-channel-server:own-ci-step test-cloud-cli:own-ci-step test-cloud-client:own-ci-step test-cloud-launcher:this-script test-cloud-neutral-names:own-ci-step test-cloud-way-back:own-ci-step test-cloud-worker:own-ci-step"
for f in bin/test-cloud-*; do
  [ -e "$f" ] || continue
  n=$(basename "$f")
  case "$n" in *.chain|*.parallel) continue ;; esac
  grep -qx "bin/$n" "$LIST" && continue
  case " $BIN_EXCEPTIONS " in *" $n:"*) continue ;; esac
  echo "NOT RUN: bin/$n is in no chain list entry and not in BIN_EXCEPTIONS"; echo "RESULT: FAIL"; exit 1
done
last=$(grep -v '^[[:space:]]*$' "$LIST" | tail -n 1)
if [ -n "$last" ] && [ "$last" != "cloud/worker/tests/test_cloud_prepush_preflight.py" ]; then
  echo "NOT RUN: the last line of $LIST must be cloud/worker/tests/test_cloud_prepush_preflight.py (found $last); add new entries above it"; echo "RESULT: FAIL"; exit 1
fi
count=0
seen=" "
while IFS= read -r e; do
  [ -n "$(printf %s "$e" | tr -d ' \t')" ] || continue
  case "$e" in
    /*|..|../*|*/../*) echo "NOT RUN: entry outside the repository: $e"; echo "RESULT: FAIL"; exit 1 ;;
  esac
  [ -L "$e" ] && { echo "NOT RUN: entry is a symlink: $e"; echo "RESULT: FAIL"; exit 1; }
  case "$seen" in *" $e "*) echo "NOT RUN: duplicate entry $e in $LIST"; echo "RESULT: FAIL"; exit 1 ;; esac
  seen="$seen$e "
  [ -f "$e" ] || { echo "NOT RUN: $e is listed in $LIST but does not exist"; echo "RESULT: FAIL"; exit 1; }
  count=$((count + 1))
done < "$LIST"
if [ "$count" -eq 0 ]; then echo "NOT RUN: the chain list holds no entry"; echo "RESULT: FAIL"; exit 1; fi
# Arguments ("$@") go only to the entries that took them in the old one-line chain; the others run without arguments.
ARGS_ENTRIES=" test_cloud_worker.py test_cloud_stack.py test_cloud_stack_wait.py test_cw_names.py test_cloud_k1.py test_driver.py test_run_record.py test_cloud_allowlist.py test_cloud_settings.py test_cloud_preflight_wired.py "
# The PARALLEL list ($PAR, entries also in $LIST) runs in 3 lanes beside the serial loop (#1390): each entry uses its own temporary directory, binds no fixed port, and writes to its own output file, replayed whole after the run.
PAR=bin/test-cloud-launcher.parallel
[ -f "$PAR" ] || PAR=/dev/null   # no parallel list: every entry runs serially
OUT=$(mktemp -d) || exit 1
trap 'rm -rf "$OUT"' EXIT
run_entry() { # $1 = entry; runs it with the arguments it took in the old chain; prints its own RUN and TIME lines
  e=$1; shift
  case "$ARGS_ENTRIES" in *" $(basename "$e") "*) a=1 ;; *) a=0 ;; esac
  echo "RUN $e"
  t0=$(date +%s)
  case "$e" in
    *.py) if [ $a = 1 ]; then python3 "$e" "$@"; else python3 "$e"; fi ;;
    *) if [ $a = 1 ]; then "$e" "$@"; else "$e"; fi ;;
  esac || { echo "FAILED: $e"; return 1; }
  echo "TIME $e $(( $(date +%s) - t0 ))s"
}
is_parallel() { grep -qx "$1" "$PAR"; }
while IFS= read -r e; do
  [ -n "$e" ] || continue
  grep -qx "$e" "$LIST" || { echo "NOT RUN: parallel entry $e is not in $LIST"; echo "RESULT: FAIL"; exit 1; }
done < "$PAR"
lane() { # $1 = lane number: every 3rd entry of $PAR, one after the other, output in $OUT/<entry>.out, status in $OUT/<entry>.rc
  l=$1; shift; n=0
  while IFS= read -r e; do
    [ -n "$e" ] || continue
    n=$((n + 1))
    [ $(( (n - 1) % 3 )) = "$l" ] || continue
    f=$(printf %s "$e" | tr / _)
    run_entry "$e" "$@" > "$OUT/$f.out" 2>&1
    echo $? > "$OUT/$f.rc"
  done < "$PAR"
}
pids=""
for l in 0 1 2; do lane "$l" "$@" & pids="$pids $!"; done
ran=0
failed=""   # every failing entry runs to the end of the chain and is named here (#1547); a hung entry is ended by the workflow step's time limit
killtree() { for c in $(pgrep -P "$1" 2>/dev/null); do killtree "$c"; done; kill "$1" 2>/dev/null; }
trap 'for p in $pids; do killtree "$p"; done; killtree $$; exit 143' TERM INT
while IFS= read -r e; do
  [ -n "$(printf %s "$e" | tr -d ' \t')" ] || continue
  is_parallel "$e" && continue
  run_entry "$e" "$@" & sp=$!   # in the background so that the trap above acts at once while the entry runs
  pids="$pids $sp"
  wait $sp || failed="$failed $e"
  ran=$((ran + 1))
done < "$LIST"
wait
while IFS= read -r e; do
  [ -n "$e" ] || continue
  f=$(printf %s "$e" | tr / _)
  cat "$OUT/$f.out"
  [ "$(cat "$OUT/$f.rc" 2>/dev/null)" = 0 ] || failed="$failed $e"
  ran=$((ran + 1))
done < "$PAR"
echo "ran $ran entries"
if [ -n "$failed" ]; then
  nf=0; for x in $failed; do nf=$((nf + 1)); done
  echo "failed entries: $nf:$failed"
  echo "RESULT: FAIL"
  exit 1
fi
echo "RESULT: PASS"
