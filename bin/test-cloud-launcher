#!/bin/sh
# test-cloud-launcher: offline tests for the cloud-worker launcher (fake kubectl, fake clock). Prints RESULT: PASS.
cd "$(dirname "$0")/.." || exit 1
# Completeness check: every test_*.py must be named below, or listed here with a reason.
EXCEPTIONS="test_cloud_pod_deadline.py:slow(26s),not-yet-chained test_cloud_stop_nonce.py:slow(57s),not-yet-chained test_reaper_record_family.py:did-not-finish-in-120s,not-yet-chained"
for f in cloud/launcher/tests/test_*.py; do
  n=$(basename "$f")
  grep -q "tests/$n" "$0" && continue
  case " $EXCEPTIONS " in *" $n:"*) continue ;; esac
  echo "NOT RUN: $n is neither chained nor in EXCEPTIONS"; echo "RESULT: FAIL"; exit 1
done
for f in bin/test-cloud-cost-*; do
  n=$(basename "$f")
  grep -q "bin/$n" "$0" && continue
  echo "NOT RUN: bin/$n is not chained"; echo "RESULT: FAIL"; exit 1
done
if python3 cloud/launcher/tests/test_cloud_worker.py "$@" && python3 cloud/launcher/tests/test_cloud_stack.py "$@" && python3 cloud/launcher/tests/test_cloud_stack_wait.py "$@" && python3 cloud/launcher/tests/test_cw_names.py "$@" && python3 cloud/launcher/tests/test_cloud_k1.py "$@" && python3 cloud/launcher/tests/test_driver.py "$@" && python3 cloud/launcher/tests/test_run_record.py "$@" && python3 cloud/launcher/tests/test_cloud_allowlist.py "$@" && python3 cloud/launcher/tests/test_cloud_settings.py "$@" && python3 cloud/launcher/tests/test_cloud_preflight_wired.py "$@" && python3 cloud/launcher/tests/test_cloud_docs_wording.py && python3 cloud/launcher/tests/test_reaper_managed.py && python3 cloud/launcher/tests/test_app_token.py && python3 cloud/launcher/tests/test_git_token_renewal.py && python3 cloud/launcher/tests/test_cloud_pod_replaced.py && python3 cloud/launcher/tests/test_token_read_at_call.py && python3 cloud/launcher/tests/test_preflight.py && python3 cloud/launcher/tests/test_issues_read.py && python3 cloud/launcher/tests/test_stub_cleanup.py && python3 cloud/launcher/tests/test_model_credential.py && python3 cloud/launcher/tests/test_orchestrator_agent.py && python3 cloud/launcher/tests/test_cloud_shapes.py && python3 cloud/launcher/tests/test_vault_check_pins.py && python3 cloud/worker/tests/test_guard_table.py && python3 cloud/worker/tests/test_cw_gh_comments.py && python3 cloud/worker/tests/test_pr_edit.py && python3 cloud/worker/tests/test_pr_edit_hardening.py && bin/test-cloud-cost-report && python3 cloud/launcher/tests/test_cloud_hub_manifest.py && python3 cloud/launcher/tests/test_cluster_token_refresh.py && python3 cloud/launcher/tests/test_cw_minter_manifest.py && python3 cloud/launcher/tests/test_stack_registry_pod.py && python3 cloud/launcher/tests/test_stack_registry_check.py && python3 cloud/worker/tests/test_stack_pull.py && python3 cloud/worker/tests/test_identity_image.py && python3 cloud/launcher/tests/test_stack_model_key.py && python3 cloud/worker/tests/test_stack_up.py && python3 cloud/launcher/tests/test_cloud_pr_preflight.py && python3 cloud/worker/tests/test_question_denied.py && python3 cloud/worker/tests/test_entrypoint_question.py && python3 cloud/launcher/tests/test_cloud_status_summary.py; then echo "RESULT: PASS"; else echo "RESULT: FAIL"; exit 1; fi
