#!/bin/sh
# test-cloud-launcher: offline tests for the cloud-worker launcher (fake kubectl, fake clock). Prints RESULT: PASS.
# The chain is the list file bin/test-cloud-launcher.chain, ONE entry per line (a path), sorted, with one fixed last line.
# (It used to be ONE shell line of more than forty commands joined by &&; every member appended to it and every pair conflicted.)
# To add a test: add one line to bin/test-cloud-launcher.chain at its alphabetical place, ABOVE the fixed last line (even if it sorts after it).
cd "$(dirname "$0")/.." || exit 1
LIST=bin/test-cloud-launcher.chain
# Completeness check: every test_*.py must be listed in $LIST, or named here with a reason; every listed entry must exist.
EXCEPTIONS="test_cloud_pod_deadline.py:slow(26s),not-yet-chained test_cloud_stop_nonce.py:slow(57s),not-yet-chained test_reaper_record_family.py:did-not-finish-in-120s,not-yet-chained"
[ -f "$LIST" ] || { echo "NOT RUN: $LIST is missing"; echo "RESULT: FAIL"; exit 1; }
for f in cloud/launcher/tests/test_*.py; do
  [ -e "$f" ] || continue
  n=$(basename "$f")
  grep -qx "cloud/launcher/tests/$n" "$LIST" && continue
  case " $EXCEPTIONS " in *" $n:"*) continue ;; esac
  echo "NOT RUN: $n is neither chained nor in EXCEPTIONS"; echo "RESULT: FAIL"; exit 1
done
for f in bin/test-cloud-cost-*; do
  [ -e "$f" ] || continue
  n=$(basename "$f")
  grep -qx "bin/$n" "$LIST" && continue
  echo "NOT RUN: bin/$n is not chained"; echo "RESULT: FAIL"; exit 1
done
# Every bin/test-cloud-* script must be listed in $LIST or named here with a reason (a third, wider check).
BIN_EXCEPTIONS="test-cloud-hub:own-ci-step test-cloud-hub-relay:own-ci-step test-cloud-relay:own-ci-step test-cloud-relay-daemon:own-ci-step test-cloud-channel:own-ci-step test-cloud-channel-server:own-ci-step test-cloud-cli:own-ci-step test-cloud-client:own-ci-step test-cloud-launcher:this-script test-cloud-neutral-names:own-ci-step test-cloud-way-back:own-ci-step test-cloud-worker:own-ci-step"
for f in bin/test-cloud-*; do
  [ -e "$f" ] || continue
  n=$(basename "$f")
  case "$n" in *.chain|*.parallel) continue ;; esac
  grep -qx "bin/$n" "$LIST" && continue
  case " $BIN_EXCEPTIONS " in *" $n:"*) continue ;; esac
  echo "NOT RUN: bin/$n is in no chain list entry and not in BIN_EXCEPTIONS"; echo "RESULT: FAIL"; exit 1
done
last=$(grep -v '^[[:space:]]*$' "$LIST" | tail -n 1)
if [ -n "$last" ] && [ "$last" != "cloud/worker/tests/test_cloud_prepush_preflight.py" ]; then
  echo "NOT RUN: the last line of $LIST must be cloud/worker/tests/test_cloud_prepush_preflight.py (found $last); add new entries above it"; echo "RESULT: FAIL"; exit 1
fi
count=0
seen=" "
while IFS= read -r e; do
  [ -n "$(printf %s "$e" | tr -d ' \t')" ] || continue
  case "$e" in
    /*|..|../*|*/../*) echo "NOT RUN: entry outside the repository: $e"; echo "RESULT: FAIL"; exit 1 ;;
  esac
  [ -L "$e" ] && { echo "NOT RUN: entry is a symlink: $e"; echo "RESULT: FAIL"; exit 1; }
  case "$seen" in *" $e "*) echo "NOT RUN: duplicate entry $e in $LIST"; echo "RESULT: FAIL"; exit 1 ;; esac
  seen="$seen$e "
  [ -f "$e" ] || { echo "NOT RUN: $e is listed in $LIST but does not exist"; echo "RESULT: FAIL"; exit 1; }
  count=$((count + 1))
done < "$LIST"
if [ "$count" -eq 0 ]; then echo "NOT RUN: the chain list holds no entry"; echo "RESULT: FAIL"; exit 1; fi
# Arguments ("$@") go only to the entries that took them in the old one-line chain; the others run without arguments.
ARGS_ENTRIES=" test_cloud_worker.py test_cloud_stack.py test_cloud_stack_wait.py test_cw_names.py test_cloud_k1.py test_driver.py test_run_record.py test_cloud_allowlist.py test_cloud_settings.py test_cloud_preflight_wired.py "
# The PARALLEL list ($PAR, entries also in $LIST) runs in 3 lanes beside the serial loop (#1390): each entry uses its own temporary directory, binds no fixed port, and writes its test output to its own file, replayed whole after the run.
# Diagnostics (#1414): a lane prints its RUN and TIME lines to the real output AS THEY HAPPEN (every line names its entry), so a hung lane shows as a RUN line with no TIME line.
# An interrupt or a terminate signal stops every lane and the serial entry with all their descendants and exits non-zero. A group is NOT used (set -m
# needs a terminal: under dash with no tty it fails and "kill -- -pgid" reaches nothing); the descendants are found with ps (POSIX) and ended together.
# (A shell cannot trap a signal that was ignored when it started: an INT sent to a script started with INT ignored does nothing.)
# When a serial entry fails, no lane starts a NEW entry; the script waits for the entries in flight for at most LANE_WAIT seconds (default 300, the
# slowest entry measured is about 300; the environment variable CHAIN_LANE_WAIT overrides it, for tests), then stops every lane and its loop, replays
# their output, and only then prints RESULT: FAIL (status 1). After the exit no lane process is left and nothing writes into the removed directory.
LANE_WAIT=${CHAIN_LANE_WAIT:-300}
# After the TERM, a descendant that ignores it gets KILL once KILL_GRACE seconds have passed (default 5; CHAIN_KILL_GRACE overrides it, for tests).
KILL_GRACE=${CHAIN_KILL_GRACE:-5}
PAR=bin/test-cloud-launcher.parallel
[ -f "$PAR" ] || PAR=/dev/null   # no parallel list: every entry runs serially
OUT=$(mktemp -d) || exit 1
lp0=; lp1=; lp2=; cur=   # the process ids: the three lanes and the running serial entry
descendants() { # $1 = pid: print it and every process below it (from one ps listing)
  ps -A -o pid= -o ppid= | awk -v root="$1" '{ p[NR] = $1; q[NR] = $2 } END { s[root] = 1; do { c = 0; for (i = 1; i <= NR; i++) if ((q[i] in s) && !(p[i] in s)) { s[p[i]] = 1; c = 1 } } while (c); for (k in s) print k }'
}
stop_groups() { # stop every lane (loop and entry in flight) and the running serial entry, each with all its descendants
  : > "$OUT/stop"
  all=
  for l in 0 1 2; do
    eval "p=\$lp$l"
    [ -z "$p" ] || [ -e "$OUT/lane$l.done" ] || all="$all $(descendants "$p")"
  done
  [ -z "$cur" ] || all="$all $(descendants "$cur")"
  # shellcheck disable=SC2086
  [ -z "$all" ] || kill -TERM $all 2>/dev/null
  for l in 0 1 2; do
    eval "p=\$lp$l"
    [ -z "$p" ] || wait "$p" 2>/dev/null
  done
  # A descendant that ignores TERM gets KILL after a short grace (KILL_GRACE seconds): the survivors of the SAME roots (the pids listed above, and what
  # still hangs below the same roots now) are ended; a pid is never an empty word, 0, 1 or this script's own pid.
  if [ -n "$all" ]; then
    g=0
    while [ "$g" -lt "$KILL_GRACE" ]; do
      left=0
      for x in $all; do kill -0 "$x" 2>/dev/null && left=1; done
      [ "$left" = 0 ] && break
      sleep 1
      g=$((g + 1))
    done
    more=
    for l in 0 1 2; do
      eval "p=\$lp$l"
      [ -z "$p" ] || [ -e "$OUT/lane$l.done" ] || more="$more $(descendants "$p")"
    done
    [ -z "$cur" ] || more="$more $(descendants "$cur")"
    surv=
    for x in $all $more; do
      case "$x" in ''|0|1|$$) continue ;; esac
      kill -0 "$x" 2>/dev/null && surv="$surv $x"
    done
    # shellcheck disable=SC2086
    [ -z "$surv" ] || kill -KILL $surv 2>/dev/null
  fi
  return 0
}
trap 'rc=$?; trap - EXIT; rm -rf "$OUT"; exit $rc' EXIT
trap 'stop_groups; exit 130' INT
trap 'stop_groups; exit 143' TERM
LOGF=
run_entry() { # $1 = entry; runs it with the arguments it took in the old chain; prints its own RUN and TIME lines (and, in a lane, copies them to the entry's file: the replay stays whole)
  e=$1; shift
  case "$ARGS_ENTRIES" in *" $(basename "$e") "*) a=1 ;; *) a=0 ;; esac
  note() { echo "$1"; [ -z "$LOGF" ] || echo "$1" >> "$LOGF"; }
  body() {
    case "$e" in
      *.py) if [ $a = 1 ]; then python3 "$e" "$@"; else python3 "$e"; fi ;;
      *) if [ $a = 1 ]; then "$e" "$@"; else "$e"; fi ;;
    esac
  }
  note "RUN $e"
  t0=$(date +%s)
  if [ -n "$LOGF" ]; then body "$@" >> "$LOGF" 2>&1; else body "$@"; fi || { note "FAILED: $e"; return 1; }
  note "TIME $e $(( $(date +%s) - t0 ))s"
}
is_parallel() { grep -qx "$1" "$PAR"; }
while IFS= read -r e; do
  [ -n "$e" ] || continue
  grep -qx "$e" "$LIST" || { echo "NOT RUN: parallel entry $e is not in $LIST"; echo "RESULT: FAIL"; exit 1; }
done < "$PAR"
lane() { # $1 = lane number: every 3rd entry of $PAR, one after the other, test output in $OUT/<entry>.out, status in $OUT/<entry>.rc
  l=$1; shift; n=0
  while IFS= read -r e; do
    [ -n "$e" ] || continue
    [ ! -e "$OUT/stop" ] || break   # a serial entry failed: start no new entry
    n=$((n + 1))
    [ $(( (n - 1) % 3 )) = "$l" ] || continue
    f=$(printf %s "$e" | tr / _)
    LOGF="$OUT/$f.out"
    run_entry "$e" "$@" < /dev/null
    echo $? > "$OUT/$f.rc"
    LOGF=
  done < "$PAR"
  : > "$OUT/lane$l.done"
}
for l in 0 1 2; do
  lane "$l" "$@" < /dev/null &
  eval "lp$l=\$!"
done
replay() { # print every parallel entry's own output, whole
  while IFS= read -r e; do
    [ -n "$e" ] || continue
    f=$(printf %s "$e" | tr / _)
    [ ! -f "$OUT/$f.out" ] || cat "$OUT/$f.out"
  done < "$PAR"
}
ran=0
fail=0
while IFS= read -r e; do
  [ -n "$(printf %s "$e" | tr -d ' \t')" ] || continue
  is_parallel "$e" && continue
  run_entry "$e" "$@" < /dev/null &
  cur=$!
  wait "$cur" && { cur=; ran=$((ran + 1)); continue; }
  cur=
  : > "$OUT/stop"   # no lane starts a new entry from now on
  # a serial entry failed: wait (bounded) for the entries in flight, replay what they wrote, only then say RESULT: FAIL
  waited=0
  while [ "$waited" -lt "$LANE_WAIT" ]; do
    alive=0
    for l in 0 1 2; do [ -e "$OUT/lane$l.done" ] || alive=1; done
    [ "$alive" = 0 ] && break
    sleep 1
    waited=$((waited + 1))
  done
  stop_groups
  replay
  echo "RESULT: FAIL"
  exit 1
done < "$LIST"
wait
replay
while IFS= read -r e; do
  [ -n "$e" ] || continue
  f=$(printf %s "$e" | tr / _)
  [ "$(cat "$OUT/$f.rc" 2>/dev/null)" = 0 ] || { echo "RESULT: FAIL"; exit 1; }
  ran=$((ran + 1))
done < "$PAR"
echo "ran $ran entries"
echo "RESULT: PASS"
