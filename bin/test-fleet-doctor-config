#!/usr/bin/env python3
"""test-fleet-doctor-config — offline tests for fleet-doctor's config precedence
and its harness-neutral skills check.

Runs the real bin/fleet-doctor on a hermetic PATH with a temp HOME: stub
`herdr`, `gh`, `systemctl`, `launchctl` and `uname`, no network, and no real
config. The PATH holds only the stubs plus symlinks to the ordinary utilities
the script needs, so nothing installed on this machine can leak into a test.

Same style as bin/test-fleet-doctor (adamkaplan/fleet-kit#4); kept as a
separate file so the two do not collide.

    bin/test-fleet-doctor-config            # everything
    bin/test-fleet-doctor-config Unit       # only tests whose name contains "Unit"

Prints RESULT: PASS or RESULT: FAIL, and exits non-zero on failure.
"""
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import unittest

BIN = Path(__file__).resolve().parent
DOCTOR = BIN / "fleet-doctor"

UTILITIES = ("bash", "sh", "env", "mktemp", "rm", "cat", "sed", "awk", "grep",
             "head", "tr", "python3", "whoami", "sleep", "kill", "printf")

# Every stub logs "<name> <args>" and then runs its body.
STUB = """#!/bin/sh
printf '%(name)s %%s\\n' "$*" >> "%(log)s"
%(body)s
exit 0
"""

GH_BODY = """
case "$1 $2" in
  "auth status") echo "Logged in to github.com account tester (keyring)"; echo "Token scopes: 'repo'" ;;
esac
"""


class DoctorRun:
    """One fleet-doctor run in a scratch HOME."""

    def __init__(self, tmp, os_name="Linux", launchctl_list=""):
        self.tmp = Path(tmp)
        self.home = self.tmp / "home"
        self.home.mkdir()
        self.path_dir = self.tmp / "path"
        self.path_dir.mkdir()
        self.log = self.tmp / "calls.log"
        self.log.touch()
        for tool in UTILITIES:
            real = shutil.which(tool)
            if real:
                (self.path_dir / tool).symlink_to(real)
        self.stub("uname", "echo %s" % os_name)
        self.stub("herdr", "")
        self.stub("gh", GH_BODY)
        self.stub("systemctl", 'echo inactive; exit 3')
        self.stub("launchctl", "printf '%%s\\n' '%s'" % launchctl_list)
        # A heartbeat config that fleet-doctor will accept as "installed".
        self.fake_herdr = self.tmp / "fake-herdr"
        self.fake_herdr.write_text("#!/bin/sh\n")
        self.fake_herdr.chmod(0o755)
        self.hb_conf = self.tmp / "hb-config.json"
        self.hb_conf.write_text(json.dumps({"herdr": str(self.fake_herdr)}))

    def stub(self, name, body):
        path = self.path_dir / name
        path.write_text(STUB % {"name": name, "log": self.log, "body": body})
        path.chmod(0o755)

    def config_file(self, **kv):
        cfg = self.home / ".config" / "fleet-kit"
        cfg.mkdir(parents=True, exist_ok=True)
        (cfg / "config").write_text("".join("%s=%s\n" % item for item in kv.items()))

    def run(self, **env_extra):
        env = {"PATH": str(self.path_dir), "HOME": str(self.home), "TMPDIR": str(self.tmp)}
        env.update(env_extra)
        proc = subprocess.run([str(self.path_dir / "bash"), str(DOCTOR)], env=env,
                              stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                              universal_newlines=True, timeout=60)
        self.output = proc.stdout
        self.calls = self.log.read_text()
        return proc

    def line(self, check):
        for line in self.output.splitlines():
            parts = line.split(None, 2)
            if len(parts) >= 2 and parts[1] == check:
                return line
        raise AssertionError("no %r line in output:\n%s" % (check, self.output))


class Case(unittest.TestCase):
    def setUp(self):
        self._tmp = tempfile.TemporaryDirectory()
        self.addCleanup(self._tmp.cleanup)

    def doctor(self, **kw):
        return DoctorRun(self._tmp.name, **kw)


class EnvBeatsFile(Case):
    """The usage text promises env first, file second. Hold it to that."""

    def test_heartbeat_unit_env_beats_file(self):
        d = self.doctor()
        d.config_file(FLEET_HEARTBEAT_UNIT="file.service", FLEET_HEARTBEAT_CONF=d.hb_conf)
        d.run(FLEET_HEARTBEAT_UNIT="x.service")
        self.assertIn("systemctl --user is-active x.service", d.calls)
        self.assertNotIn("file.service", d.calls)

    def test_heartbeat_unit_file_used_when_env_unset(self):
        d = self.doctor()
        d.config_file(FLEET_HEARTBEAT_UNIT="file.service", FLEET_HEARTBEAT_CONF=d.hb_conf)
        d.run()
        self.assertIn("systemctl --user is-active file.service", d.calls)

    def test_heartbeat_conf_env_beats_file(self):
        d = self.doctor()
        d.config_file(FLEET_HEARTBEAT_CONF=d.tmp / "no-such.json")
        d.run(FLEET_HEARTBEAT_CONF=str(d.hb_conf))
        self.assertIn(str(d.fake_herdr), d.line("heartbeat"))

    def test_heartbeat_label_env_beats_file(self):
        d = self.doctor(os_name="Darwin", launchctl_list="123 0 env.label")
        d.config_file(FLEET_HEARTBEAT_LABEL="file.label", FLEET_HEARTBEAT_CONF=d.hb_conf)
        d.run(FLEET_HEARTBEAT_LABEL="env.label")
        self.assertIn("LaunchAgent loaded", d.line("heartbeat"))

    def test_herdr_socket_env_beats_file(self):
        d = self.doctor()
        d.config_file(HERDR_SOCKET_PATH=d.tmp / "file.sock")
        d.run(HERDR_SOCKET_PATH=str(d.tmp / "env.sock"))
        self.assertIn("env.sock", d.line("herdr"))
        self.assertNotIn("file.sock", d.line("herdr"))

    def test_repo_env_beats_file(self):
        d = self.doctor()
        d.config_file(FLEET_REPO="file/repo")
        d.run(FLEET_REPO="env/repo")
        self.assertIn("gh api repos/env/repo", d.calls)
        self.assertNotIn("file/repo", d.calls)

    def test_prefix_env_beats_file(self):
        d = self.doctor()
        d.config_file(FLEET_REPO="some/repo", FLEET_PREFIX="filepfx")
        d.run(FLEET_PREFIX="envpfx")
        self.assertIn("envpfx:orchestrator", d.output)
        self.assertNotIn("filepfx", d.output)


class HarnessNeutralSkills(Case):
    """Section 5 checks ~/.agents/skills whatever agent CLI is installed."""

    def link_skills(self, d, names, with_skill_md=True):
        repo = d.tmp / "repo-skills"
        skills = d.home / ".agents" / "skills"
        skills.mkdir(parents=True, exist_ok=True)
        for name in names:
            src = repo / name
            src.mkdir(parents=True)
            if with_skill_md:
                (src / "SKILL.md").write_text("# %s\n" % name)
            (skills / name).symlink_to(src)

    def test_both_linked_is_ok_without_copilot(self):
        d = self.doctor()
        self.link_skills(d, ["fleet-charter", "fleet-coordination"])
        d.run()
        self.assertTrue(d.line("agents-skills").startswith("ok"), d.line("agents-skills"))
        # The copilot path is unchanged: still a skipped WARN when it is absent.
        self.assertIn("skipped — copilot not installed", d.line("skills"))

    def test_one_missing_warns_and_names_it(self):
        d = self.doctor()
        self.link_skills(d, ["fleet-charter"])
        d.run()
        line = d.line("agents-skills")
        self.assertTrue(line.startswith("WARN"), line)
        # Exactly the missing one is listed, not the present one.
        self.assertIn("~/.agents/skills: fleet-coordination (", line)

    def test_dir_without_skill_md_warns(self):
        d = self.doctor()
        self.link_skills(d, ["fleet-charter", "fleet-coordination"], with_skill_md=False)
        d.run()
        self.assertTrue(d.line("agents-skills").startswith("WARN"), d.line("agents-skills"))

    def test_dangling_link_warns(self):
        d = self.doctor()
        self.link_skills(d, ["fleet-charter", "fleet-coordination"])
        shutil.rmtree(str(d.tmp / "repo-skills" / "fleet-charter"))
        d.run()
        line = d.line("agents-skills")
        self.assertTrue(line.startswith("WARN"), line)
        self.assertIn("fleet-charter", line)


if __name__ == "__main__":
    argv = [sys.argv[0]]
    if len(sys.argv) > 1:
        argv += ["-k", sys.argv[1]]
    prog = unittest.main(argv=argv, exit=False, verbosity=2)
    ok = prog.result.wasSuccessful() and prog.result.testsRun > 0
    print("RESULT: PASS" if ok else "RESULT: FAIL")
    sys.exit(0 if ok else 1)
