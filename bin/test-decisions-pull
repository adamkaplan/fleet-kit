#!/usr/bin/env python3
"""test-decisions-pull: offline tests for bin/decisions_pull.py (slice 4a of the plan on #1059, ask #1078).

The real pull() runs against a temporary state directory with a fake source and a fixed clock. Each rule has one mutant: the module's
source is changed in one place and the same check must then fail.

    bin/test-decisions-pull
"""
import importlib.machinery
import importlib.util
import io
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import time
import types
import unittest
from pathlib import Path

BIN = Path(__file__).resolve().parent
SOURCE = (BIN / "decisions_pull.py").read_text()
NOW = 1_800_000_000.0
BODY = {"generation": 7, "written_at": "2026-10-22T10:00:00Z", "daemon_pid": 42, "errors": [],
        "decisions": [{"id": "gh:1", "title": "Pick one", "tier": "human", "repo": "a/b", "ask": 1}]}


def load(source=SOURCE):
    module = types.ModuleType("decisions_pull_under_test")
    exec(compile(source, "decisions_pull.py", "exec"), module.__dict__)
    return module


def mutant(old, new):
    assert SOURCE.count(old) == 1, old
    return load(SOURCE.replace(old, new))


def good(body=BODY):
    return lambda: (json.dumps(body)).encode()


def down(module):
    def fetch():
        raise module.Unreachable("down")
    return fetch


def pull_quiet(module, state, fetch, now=NOW, err=None, age=0, **kw):
    return module.pull(state, fetch, now, err=err or io.StringIO(), age=None if age is None else (lambda: age), **kw)


def fresh_file(state, text="OLD\n", age=5):
    path = Path(state) / "decisions.json"
    path.write_text(text)
    os.utime(path, (NOW - age, NOW - age))
    return path


def breaks_as(*kinds):
    """A check whose wrong build fails by the very error the rule guards against (the mutant lets it escape): that named error is the
    failed assertion. Any other error (a NameError, a SyntaxError) still escapes and is not a kill."""
    def wrap(check):
        def run(module):
            try:
                check(module)
            except kinds as err:
                raise AssertionError("%s escaped: %s" % (type(err).__name__, err))
        run.__name__ = check.__name__
        return run
    return wrap


# ---- the checks: each takes a module and raises AssertionError when the rule is broken
def check_shape_is_the_daemons(module):
    with tempfile.TemporaryDirectory() as state:
        assert pull_quiet(module, state, good(), NOW) == "wrote"
        path = Path(state) / "decisions.json"
        expected = json.dumps(BODY, indent=1, sort_keys=True) + "\n"
        assert path.read_text() == expected, path.read_text()
        assert (path.stat().st_mode & 0o777) == 0o600
        assert path.stat().st_mtime == NOW


def check_unknown_keys_are_dropped(module):
    with tempfile.TemporaryDirectory() as state:
        pull_quiet(module, state, good(dict(BODY, secret="x")), NOW)
        assert "secret" not in json.loads((Path(state) / "decisions.json").read_text())


def check_write_is_atomic(module):
    with tempfile.TemporaryDirectory() as state:
        path = fresh_file(state)
        seen = []
        real = os.replace
        module.os.replace = lambda a, b: (seen.append((Path(b).read_text(), Path(a).read_text() != "")), real(a, b))
        try:
            pull_quiet(module, state, good(), NOW)
        finally:
            module.os.replace = real
        assert seen == [("OLD\n", True)], seen  # the old file was whole until the rename
        assert [p.name for p in Path(state).iterdir()] == ["decisions.json"]


def check_failed_write_leaves_old_file(module):
    with tempfile.TemporaryDirectory() as state:
        path = fresh_file(state)
        real = os.replace
        def boom(a, b):
            raise OSError("disk")
        module.os.replace = boom
        try:
            try:
                pull_quiet(module, state, good(), NOW)
                raise AssertionError("no error")
            except OSError:
                pass
        finally:
            module.os.replace = real
        assert path.read_text() == "OLD\n"
        assert [p.name for p in Path(state).iterdir()] == ["decisions.json"], "temp file left"


def check_unreachable_marks_stale(module):
    with tempfile.TemporaryDirectory() as state:
        path = fresh_file(state)
        assert pull_quiet(module, state, down(module), NOW) == "marked-stale"
        assert path.read_text() == "OLD\n"
        assert NOW - path.stat().st_mtime > 180


def check_stale_never_made_fresher(module):
    with tempfile.TemporaryDirectory() as state:
        path = fresh_file(state, age=9999)
        pull_quiet(module, state, down(module), NOW)
        assert path.stat().st_mtime == NOW - 9999


def check_unreachable_without_file_creates_none(module):
    with tempfile.TemporaryDirectory() as state:
        assert pull_quiet(module, state, down(module), NOW) == "untouched"
        assert list(Path(state).iterdir()) == []


def check_garbage_leaves_file_untouched(module):
    for raw in (b"not json", b"[]", b"{}", b'{"decisions": {}, "errors": []}', b'{"decisions": []}', b"\xff\xfe", b'{"decisions": [], "errors": []}' + b" " * (9 * 1024 * 1024)):
        with tempfile.TemporaryDirectory() as state:
            path = fresh_file(state)
            before = (path.read_bytes(), path.stat().st_mtime)
            assert pull_quiet(module, state, lambda: raw, NOW) == "untouched", raw[:20]
            assert (path.read_bytes(), path.stat().st_mtime) == before, raw[:20]
            assert [p.name for p in Path(state).iterdir()] == ["decisions.json"]


class FakeProc:
    """A Popen stand-in: stdout is a pipe-like stream; kill is recorded."""
    def __init__(self, data, code=0, hang=False):
        self.stdout = io.BytesIO(data)
        self.asked = []
        read = self.stdout.read
        self.stdout.read = lambda n=-1: (self.asked.append(n), read(n))[1]
        self.code, self.killed, self.hang = code, False, hang
    def kill(self):
        self.killed = True
    def poll(self):
        return None if (self.hang and not self.killed) else self.code
    def wait(self):
        return -9 if self.killed else self.code


@breaks_as(OSError)
def check_command_failure_is_unreachable(module):
    try:
        module.command_fetch(["x"], popen=lambda argv, **kw: FakeProc(b'{"decisions": [], "errors": []}', 1))
        raise AssertionError("a failed command was believed")
    except module.Unreachable:
        pass
    def cannot_start(argv, **kw):
        raise FileNotFoundError(argv[0])
    try:
        module.command_fetch(["x"], popen=cannot_start)
        raise AssertionError("a missing command was believed")
    except module.Unreachable:
        pass


def check_real_timeout_is_unreachable(module):
    try:
        module.command_fetch([sys.executable, "-c", "import time; time.sleep(30)"], timeout=0.5)
        raise AssertionError("a timeout was believed")
    except module.Unreachable as why:
        assert "timed out" in str(why), str(why)


def check_output_is_bounded_and_process_killed(module):
    procs = []
    def popen(argv, **kw):
        procs.append(FakeProc(b"x" * (module.MAX_BYTES + 500), hang=True))
        return procs[0]
    data = module.command_fetch(["x"], popen=popen)
    assert len(data) == module.MAX_BYTES + 1, len(data)  # read no more than the cap and one byte
    assert procs[0].killed
    assert procs[0].asked == [module.MAX_BYTES + 1], procs[0].asked
    with tempfile.TemporaryDirectory() as state:
        path = fresh_file(state)
        assert pull_quiet(module, state, lambda: data) == "untouched"
        assert path.read_text() == "OLD\n"


def check_real_source_that_prints_more_is_cut(module):
    code = "import sys; sys.stdout.write('x' * %d); sys.stdout.flush()" % (module.MAX_BYTES * 2)
    data = module.command_fetch([sys.executable, "-c", code])
    assert len(data) == module.MAX_BYTES + 1, len(data)


def check_nan_and_infinity_are_garbage(module):
    for text in (b'{"decisions": [{"id": "a", "title": "t", "n": NaN}], "errors": []}', b'{"decisions": [], "errors": [], "x": Infinity}',
                 b'{"decisions": [], "errors": [-Infinity]}'):
        with tempfile.TemporaryDirectory() as state:
            path = fresh_file(state)
            assert pull_quiet(module, state, lambda: text) == "untouched", text
            assert path.read_text() == "OLD\n"


def check_items_must_have_the_plugins_types(module):
    bad = [{"decisions": ["x"], "errors": []}, {"decisions": [1], "errors": []}, {"decisions": [None], "errors": []},
           {"decisions": [], "errors": [1]}, {"decisions": [], "errors": [None]}, {"decisions": [], "errors": [["a"]]}]
    for body in bad:
        with tempfile.TemporaryDirectory() as state:
            path = fresh_file(state)
            assert pull_quiet(module, state, good(body)) == "untouched", body
            assert path.read_text() == "OLD\n"
    with tempfile.TemporaryDirectory() as state:   # strings and objects in errors are fine
        assert pull_quiet(module, state, good({"decisions": [], "errors": ["a", {"m": 1}]})) == "wrote"


def check_item_count_is_capped(module):
    n = module.MAX_ITEMS
    for body in ({"decisions": [{}] * (n + 1), "errors": []}, {"decisions": [], "errors": ["e"] * (n + 1)}):
        with tempfile.TemporaryDirectory() as state:
            assert pull_quiet(module, state, good(body)) == "untouched"
    with tempfile.TemporaryDirectory() as state:
        assert pull_quiet(module, state, good({"decisions": [{}] * n, "errors": ["e"] * n})) == "wrote"


def check_control_characters_are_stripped(module):
    esc = "\x1b]0;pwned\x07\x1b[31mred\x9b"
    body = dict(BODY, decisions=[{"id": "gh:1", "title": "Pick" + esc + "\none", "nested": {"k" + esc: ["a" + esc]}}], errors=["e" + esc])
    with tempfile.TemporaryDirectory() as state:
        pull_quiet(module, state, good(body))
        text = (Path(state) / "decisions.json").read_text()
        assert not re.search("[\\x00-\\x09\\x0b-\\x1f\\x7f-\\x9f]", text), repr(text)
        written = json.loads(text)
        assert written["decisions"][0]["title"] == "Pick]0;pwned[31mredone"
        assert written["decisions"][0]["id"] == "gh:1"


@breaks_as(OSError)
def check_temp_file_is_exclusive_private_and_random(module):
    with tempfile.TemporaryDirectory() as state:
        names = []
        real_open = os.open
        def spy(path, flags, mode=0o777, **kw):
            if str(path).endswith(".pull.tmp"):
                names.append((Path(path).name, flags, mode))
            return real_open(path, flags, mode, **kw)
        os.open = spy
        try:
            pull_quiet(module, state, good())
            pull_quiet(module, state, good())
        finally:
            os.open = real_open
        assert len(names) == 2 and names[0][0] != names[1][0], names   # a random part, not only the pid
        assert str(os.getpid()) in names[0][0]
        for _, flags, mode in names:
            for flag in (os.O_EXCL, os.O_NOFOLLOW, os.O_CREAT):
                assert flags & flag, flags
            assert mode == 0o600
        # a planted symlink at the temp name is replaced, not followed
        victim = Path(state) / "victim"
        victim.write_text("KEEP")
        module._token = lambda: "fixed"
        link = Path(state) / ("decisions.json.%d.fixed.pull.tmp" % os.getpid())
        os.symlink(str(victim), str(link))
        assert pull_quiet(module, state, good()) == "wrote"
        assert victim.read_text() == "KEEP"
        assert not link.exists() and not link.is_symlink()
        # a plain file in the way is also cleared
        link.write_text("junk")
        assert pull_quiet(module, state, good()) == "wrote"
        assert json.loads((Path(state) / "decisions.json").read_text())["generation"] == 7


def check_group_is_killed_when_a_grandchild_holds_the_pipe(module):
    code = ("import subprocess, sys; subprocess.Popen([sys.executable, '-c', 'import time; time.sleep(20)']); "
            "sys.stdout.write('{}'); sys.stdout.flush()")
    start = time.time()
    try:
        module.command_fetch([sys.executable, "-c", code], timeout=1)
        raise AssertionError("a source held open by a grandchild was believed")
    except module.Unreachable as why:
        assert "timed out" in str(why), str(why)
    assert time.time() - start < 10, "blocked past the deadline"


@breaks_as(RecursionError)
def check_deep_nesting_and_key_collisions_are_garbage(module):
    deep = "[" * 200 + "]" * 200
    collide = '{"decisions": [{"a\\u0001": 1, "a": 2}], "errors": []}'
    for text in ('{"decisions": [{"x": %s}], "errors": []}' % deep, collide):
        with tempfile.TemporaryDirectory() as state:
            path = fresh_file(state)
            err = io.StringIO()
            assert pull_quiet(module, state, lambda: text.encode(), err=err) == "untouched"
            assert path.read_text() == "OLD\n"
            assert "untouched" in err.getvalue() and len(err.getvalue().splitlines()) == 1, err.getvalue()
    # with the depth cap out of the way the recursion limit is hit: still Garbage, not a crash
    module.MAX_DEPTH = 10 ** 6
    text = '{"decisions": [{"x": %s}], "errors": []}' % ("[" * 1200 + "]" * 1200)
    with tempfile.TemporaryDirectory() as state:
        path = fresh_file(state)
        assert pull_quiet(module, state, lambda: text.encode()) == "untouched"
        assert path.read_text() == "OLD\n"


@breaks_as(RecursionError)
def check_clean_itself_overflowing_is_garbage(module):
    """clean() (not json.loads) hits the recursion limit: the structure is pre-built, json.loads is replaced by one returning it, the depth cap is
    lifted and the limit lowered only around pull(). Independent of how many frames a comprehension costs in this Python."""
    deep = []
    for _ in range(400):
        deep = [deep]
    body = dict(BODY, decisions=[{"id": "gh:1", "x": deep}])
    module.json = types.SimpleNamespace(loads=lambda text, **kw: body, dump=json.dump)
    module.MAX_DEPTH = 10 ** 6
    with tempfile.TemporaryDirectory() as state:
        path = fresh_file(state)
        err = io.StringIO()
        frames, frame = 0, sys._getframe()
        while frame:
            frames, frame = frames + 1, frame.f_back
        old = sys.getrecursionlimit()
        sys.setrecursionlimit(frames + 150)
        try:
            result = module.pull(state, lambda: b"{}", NOW, err=err, age=lambda: 0)
        finally:
            sys.setrecursionlimit(old)
        assert result == "untouched", result
        assert path.read_text() == "OLD\n"
        assert "nested too deeply" in err.getvalue(), err.getvalue()


def check_depth_boundary(module):
    def levels(n):  # n containers in all: the body, the decisions list, the decision, then lists
        inner = []
        for _ in range(n - 4):
            inner = [inner]
        return json.dumps(dict(BODY, decisions=[{"id": "gh:1", "x": inner}])).encode()
    for n, expected in ((module.MAX_DEPTH, module.WROTE), (module.MAX_DEPTH + 1, module.UNTOUCHED)):
        with tempfile.TemporaryDirectory() as state:
            fresh_file(state)
            assert pull_quiet(module, state, lambda: levels(n)) == expected, n


def check_reasons_are_said_on_stderr(module):
    secret = "SECRET-BODY-TEXT"
    with tempfile.TemporaryDirectory() as state:
        err = io.StringIO()
        fresh_file(state)
        module.pull(state, lambda: ('{"x": "%s"}' % secret).encode(), NOW, err=err, age=lambda: 0)
        lines = err.getvalue().splitlines()
        assert len(lines) == 1 and "not the daemon's decisions list" in lines[0] and "untouched" in lines[0], lines
        assert secret not in err.getvalue()
        err = io.StringIO()
        def fetch():
            raise module.Unreachable("exit 7")
        module.pull(state, fetch, NOW, err=err, age=lambda: 0)
        lines = err.getvalue().splitlines()
        assert len(lines) == 1 and "unreachable (exit 7)" in lines[0] and "marked" in lines[0], lines
    with tempfile.TemporaryDirectory() as state:
        err = io.StringIO()
        module.pull(state, fetch, NOW, err=err, age=lambda: 0)
        lines = err.getvalue().splitlines()
        assert len(lines) == 1 and "unreachable (exit 7)" in lines[0] and "no decisions.json to mark stale" in lines[0], lines
    with tempfile.TemporaryDirectory() as state:
        err = io.StringIO()
        module.pull(state, good(), NOW, err=err, age=lambda: 0)
        assert err.getvalue() == "", err.getvalue()


def check_stale_ages_the_descriptor_not_the_path(module):
    """A write_atomic that renames in between the open and the utime must not be aged: the aging goes through the open descriptor."""
    with tempfile.TemporaryDirectory() as state:
        path = fresh_file(state)
        real = os.utime
        def racing(target, times):
            # a puller renames a new file in, then our utime arrives
            new = Path(state) / "new.tmp"
            new.write_text("NEW\n")
            real(str(new), (NOW, NOW))
            os.replace(str(new), str(path))
            return real(target, times)
        module.os.utime = racing
        try:
            assert module.mark_stale(path, NOW) is True
        finally:
            module.os.utime = real
        assert path.read_text() == "NEW\n"
        assert path.stat().st_mtime == NOW, "the new file was aged"


def check_directory_is_fsynced_after_rename(module):
    with tempfile.TemporaryDirectory() as state:
        events = []
        real_fsync, real_replace = os.fsync, os.replace
        module.os.fsync = lambda fd: (events.append(("fsync", stat.S_ISDIR(os.fstat(fd).st_mode))), real_fsync(fd))
        module.os.replace = lambda a, b: (events.append(("replace", False)), real_replace(a, b))
        try:
            pull_quiet(module, state, good())
        finally:
            module.os.fsync, module.os.replace = real_fsync, real_replace
        assert events == [("fsync", False), ("replace", False), ("fsync", True)], events


def daemon_source():
    """The daemon's whole source: the entry and every part of its manifest, in manifest order."""
    lines = [n.strip() for n in (BIN / "fleet-switchboard.parts").read_text().splitlines() if n.strip() and not n.lstrip().startswith("#")]
    return "\n".join((BIN / n).read_text() for n in lines)


# ---- #1158: freshness from the supplied age, not from the body
OLD_WRITTEN = "2026-10-22T08:00:00Z"   # 2 h before NOW's day is irrelevant: the checks below set written_at explicitly


def iso_at(epoch):
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(epoch))


def body_with(**kw):
    return dict(BODY, **kw)


def held_state(state, **kw):
    """A held decisions.json written by the pull itself (so its shape is the real one), then aged to 5 s."""
    load_ = load()
    pull_quiet(load_, state, good(body_with(**kw)), NOW - 5)
    return Path(state) / "decisions.json"


def check_idle_healthy_daemon_is_fresh(module):          # S3
    with tempfile.TemporaryDirectory() as state:
        body = body_with(written_at=iso_at(NOW - 7200))
        assert pull_quiet(module, state, good(body), NOW, age=20) == "wrote"
        assert abs((NOW - (Path(state) / "decisions.json").stat().st_mtime) - 20) <= 1


def check_stopped_daemon_is_stale(module):               # S4
    with tempfile.TemporaryDirectory() as state:
        path = fresh_file(state, age=5)
        before = path.read_bytes()
        assert pull_quiet(module, state, good(body_with(written_at=iso_at(NOW))), NOW, age=400) == "marked-stale"
        assert NOW - path.stat().st_mtime > 180 and path.read_bytes() == before


def check_future_written_at_is_not_trusted(module):      # S5
    with tempfile.TemporaryDirectory() as state:
        path = fresh_file(state)
        before = path.read_bytes()
        assert pull_quiet(module, state, good(body_with(written_at=iso_at(NOW + 600))), NOW, age=0) == "marked-stale"
        assert path.read_bytes() == before and NOW - path.stat().st_mtime > 180


def check_future_tolerance_is_small(module):
    with tempfile.TemporaryDirectory() as state:
        assert pull_quiet(module, state, good(body_with(written_at=iso_at(NOW + 30))), NOW) == "wrote"


def check_bad_age_is_unreachable(module):                # S6
    for age in (None, -1, "-5", "abc", "1.5", "", 86401, 10 ** 12 + 1):
        with tempfile.TemporaryDirectory() as state:
            path = fresh_file(state)
            result = pull_quiet(module, state, good(), NOW, age=age)
            assert result == "marked-stale", (age, result)
            assert path.read_text() == "OLD\n"


def check_restart_at_generation_one_is_accepted(module):  # S7
    with tempfile.TemporaryDirectory() as state:
        held_state(state, generation=40, daemon_pid=7)
        assert pull_quiet(module, state, good(body_with(generation=1, daemon_pid=9)), NOW) == "wrote"
        got = json.loads((Path(state) / "decisions.json").read_text())
        assert (got["generation"], got["daemon_pid"]) == (1, 9)


def check_same_pid_lower_generation_is_refused(module):   # S8
    with tempfile.TemporaryDirectory() as state:
        path = held_state(state, generation=40, daemon_pid=7)
        assert pull_quiet(module, state, good(body_with(generation=3, daemon_pid=7)), NOW) == "marked-stale"
        assert json.loads(path.read_text())["generation"] == 40


def check_huge_generation_cannot_block(module):          # S9
    with tempfile.TemporaryDirectory() as state:
        assert pull_quiet(module, state, good(body_with(generation=2 ** 62)), NOW) == "untouched"
        assert pull_quiet(module, state, good(body_with(generation=5)), NOW) == "wrote"
        assert json.loads((Path(state) / "decisions.json").read_text())["generation"] == 5


def check_out_of_bound_held_generation_recovers(module):  # S10
    with tempfile.TemporaryDirectory() as state:
        path = Path(state) / "decisions.json"
        path.write_text(json.dumps(body_with(generation=2 ** 62)))
        assert pull_quiet(module, state, good(body_with(generation=5)), NOW) == "wrote"   # an out-of-bound held generation counts as none
        assert json.loads(path.read_text())["generation"] == 5
        path.unlink()
        assert pull_quiet(module, state, good(body_with(generation=4)), NOW) == "wrote"
    with tempfile.TemporaryDirectory() as state:     # an in-bound held generation: refused, then the flag accepts once, and the message names it
        held_state(state, generation=40, daemon_pid=7)
        err = io.StringIO()
        assert pull_quiet(module, state, good(body_with(generation=3, daemon_pid=7)), NOW, err=err) == "marked-stale"
        assert "--reset-generation" in err.getvalue() and "decisions.json" in err.getvalue()
        assert pull_quiet(module, state, good(body_with(generation=3, daemon_pid=7)), NOW, reset_generation=True) == "wrote"


def check_age_limit_matches_the_plugin(module):          # S13
    for age, want in ((180, "wrote"), (181, "marked-stale")):
        with tempfile.TemporaryDirectory() as state:
            fresh_file(state)
            assert pull_quiet(module, state, good(), NOW, age=age) == want, age


def check_equal_generation_is_written(module):           # S14
    with tempfile.TemporaryDirectory() as state:
        path = held_state(state, generation=7, daemon_pid=42)
        assert pull_quiet(module, state, good(body_with(generation=7, daemon_pid=42)), NOW, age=2) == "wrote"
        assert json.loads(path.read_text())["generation"] == 7 and NOW - path.stat().st_mtime < 5


def check_generation_bound_is_exact(module):             # S15
    for gen, want in ((0, "wrote"), (2 ** 31 - 1, "wrote"), (2 ** 31, "untouched"), (True, "untouched"), (-1, "untouched"), ("3", "untouched")):
        with tempfile.TemporaryDirectory() as state:
            assert pull_quiet(module, state, good(body_with(generation=gen)), NOW) == want, gen


def check_refusal_does_not_echo_the_body(module):        # S16
    secret = "SECRET-ghp_abc123"
    cases = [body_with(generation=2 ** 62, note=secret), body_with(written_at=iso_at(NOW + 999), note=secret),
             dict(body_with(note=secret), decisions="x"), body_with(daemon_pid=7, generation=1, note=secret)]
    for case in cases:
        with tempfile.TemporaryDirectory() as state:
            held_state(state, generation=40, daemon_pid=7)
            err = io.StringIO()
            pull_quiet(module, state, good(case), NOW, err=err)
            assert secret not in err.getvalue()
    with tempfile.TemporaryDirectory() as state:
        err = io.StringIO()
        pull_quiet(module, state, lambda: secret.encode(), NOW, err=err)
        assert secret not in err.getvalue()


def check_unchanged_fresh_body_is_rewritten_as_before(module):   # U1
    with tempfile.TemporaryDirectory() as state:
        pull_quiet(module, state, good(), NOW - 100)
        path = Path(state) / "decisions.json"
        assert pull_quiet(module, state, good(), NOW, age=20) == "wrote"
        assert path.read_text() == json.dumps(BODY, indent=1, sort_keys=True) + "\n"
        assert (path.stat().st_mode & 0o777) == 0o600 and path.stat().st_mtime == NOW - 20


def check_unreachable_and_garbage_as_before(module):     # U2
    with tempfile.TemporaryDirectory() as state:
        path = fresh_file(state)
        assert pull_quiet(module, state, down(module), NOW, age=0) == "marked-stale"
        assert path.read_text() == "OLD\n"
    with tempfile.TemporaryDirectory() as state:
        path = fresh_file(state)
        before = (path.read_bytes(), path.stat().st_mtime)
        assert pull_quiet(module, state, lambda: b"garbage", NOW, age=0) == "untouched"
        assert (path.read_bytes(), path.stat().st_mtime) == before


def check_age_command_unreachable_is_stale(module):
    with tempfile.TemporaryDirectory() as state:
        path = fresh_file(state)
        def no_age():
            raise module.Unreachable("down")
        assert module.pull(state, good(), NOW, err=io.StringIO(), age=no_age) == "marked-stale"
        assert NOW - path.stat().st_mtime > 180


def check_cli_age_command(module):
    import contextlib
    with tempfile.TemporaryDirectory() as state:
        src = ["--", sys.executable, "-c", "import json,sys; print(json.dumps(%r))" % (BODY,)]

        def run(*extra):
            out = io.StringIO()
            with contextlib.redirect_stdout(out), contextlib.redirect_stderr(io.StringIO()):
                module.main(["--state", state] + list(extra) + src)
            return out.getvalue().strip()
        assert run() == "untouched"      # no age command = a missing age, and there is no file yet to age: exactly "untouched", never "wrote"
        assert run("--age-command", "%s -c 'print(30)'" % sys.executable) == "wrote"
        assert run("--age-command", "%s -c 'print(500)'" % sys.executable) == "marked-stale"


def daemon_keys():
    """The keys the daemon's DecisionStore.publish writes into decisions.json, read from its source."""
    text = daemon_source()
    start = text.index("    def publish(self, decisions, errors, now, provisional=False):")
    block = text[start:text.index("temp = path.with_name", start)]
    keys = set(re.findall(r'body = \{(.*?)\}', block, re.S)[0].replace("\n", " ").split('"')[1::2])
    keys = {k for k in keys if re.fullmatch(r"[a-z_]+", k) and ('"%s":' % k) in block}
    keys |= set(re.findall(r'body\["([a-z_]+)"\] = ', block))
    return keys


def check_kept_keys_are_the_daemons(module):
    keys = daemon_keys()
    assert {"generation", "written_at", "daemon_pid", "decisions", "errors", "provisional"} <= keys, keys
    assert set(module.KEPT_KEYS) == keys, (set(module.KEPT_KEYS) ^ keys)


def hub(body, **extra):
    """A hub response: the decisions body plus age_seconds in ONE object, the shape the plan (#1158) gives GET /decisions."""
    return good(dict(body, **extra))


def check_hub_age_is_judged_from_the_response(module):    # S26, S3, S4 through the one response
    cases = (({}, "marked-stale"), ({"age_seconds": "20"}, "marked-stale"), ({"age_seconds": -1}, "marked-stale"),
             ({"age_seconds": 25.3}, "marked-stale"), ({"age_seconds": True}, "marked-stale"), ({"age_seconds": None}, "marked-stale"),
             ({"age_seconds": 86401}, "marked-stale"), ({"age_seconds": 400}, "marked-stale"), ({"age_seconds": 20}, "wrote"))
    for extra, want in cases:
        with tempfile.TemporaryDirectory() as state:
            path = fresh_file(state)
            assert pull_quiet(module, state, hub(BODY, **extra), NOW, age=None) == want, extra
            if want == "wrote":
                assert "age_seconds" not in json.loads(path.read_text()), "age_seconds was written"
                assert path.read_text() == json.dumps(BODY, indent=1, sort_keys=True) + "\n"
                assert path.stat().st_mtime == NOW - 20
            else:
                assert path.read_text() == "OLD\n" and NOW - path.stat().st_mtime > 180, extra


def check_hub_idle_daemon_with_old_written_at_is_fresh(module):
    with tempfile.TemporaryDirectory() as state:
        body = body_with(written_at=iso_at(NOW - 7200))
        assert pull_quiet(module, state, hub(body, age_seconds=20), NOW, age=None) == "wrote"
        assert abs((NOW - (Path(state) / "decisions.json").stat().st_mtime) - 20) <= 1


def check_plain_file_body_age_seconds_is_ignored(module):     # panel 4: a plain file's own age_seconds never skips --age-command
    for body_age, command_age, want in ((0, 400, "marked-stale"), (400, 20, "wrote")):
        with tempfile.TemporaryDirectory() as state:
            path = fresh_file(state)
            err = io.StringIO()
            assert pull_quiet(module, state, hub(BODY, age_seconds=body_age), NOW, err=err, age=command_age) == want, (body_age, command_age)
            assert "is ignored" in err.getvalue(), err.getvalue()
            if want == "wrote":
                assert "age_seconds" not in json.loads(path.read_text())
    with tempfile.TemporaryDirectory() as state:         # the command IS run
        ran = []
        def command():
            ran.append(1)
            return 20
        assert module.pull(state, hub(BODY, age_seconds=0), NOW, err=io.StringIO(), age=command) == "wrote" and ran == [1]


def check_plain_file_source_uses_the_age_command(module):   # S17
    for age, want in ((20, "wrote"), (400, "marked-stale")):
        with tempfile.TemporaryDirectory() as state:
            path = fresh_file(state)
            err = io.StringIO()
            assert pull_quiet(module, state, good(), NOW, err=err, age=age) == want, age
            assert "ignored" not in err.getvalue(), err.getvalue()
            if want == "wrote":
                assert abs((NOW - path.stat().st_mtime) - 20) <= 1


def check_response_age_edges_and_one_fetch(module):       # panel 6
    def raw(text):
        return lambda: text.encode()
    body = json.dumps(BODY)[:-1]
    cases = (("NaN", "marked-stale"), ("Infinity", "marked-stale"), ("-Infinity", "marked-stale"),
             ("86400", "wrote"), ("86401", "marked-stale"), (str(10 ** 12 + 1), "marked-stale"))
    for text, want in cases:
        with tempfile.TemporaryDirectory() as state:
            path = fresh_file(state)
            calls = []
            def fetch():
                calls.append(1)
                return (body + ', "age_seconds": %s}' % text).encode()
            if want == "wrote":      # a day old is over the 180 s limit: accepted as an age, then judged stale
                want = "marked-stale"
            assert pull_quiet(module, state, fetch, NOW, age=None) == want, text
            assert calls == [1], "fetch ran %d times" % len(calls)
            assert path.read_text() == "OLD\n" and NOW - path.stat().st_mtime > 180, text
    with tempfile.TemporaryDirectory() as state:         # 86400 itself is a believed age (not unreachable): it is judged by the 180 s limit
        err = io.StringIO()
        pull_quiet(module, state, raw(body + ', "age_seconds": 86400}'), NOW, err=err, age=None)
        assert "over a day" not in err.getvalue() and "not an integer" not in err.getvalue() and "86400 s old" in err.getvalue(), err.getvalue()
    with tempfile.TemporaryDirectory() as state:
        err = io.StringIO()
        pull_quiet(module, state, raw(body + ', "age_seconds": %d}' % (10 ** 12 + 1)), NOW, err=err, age=None)
        assert "over a day" in err.getvalue() or "not a non-negative integer" in err.getvalue(), err.getvalue()
    with tempfile.TemporaryDirectory() as state:
        err = io.StringIO()
        pull_quiet(module, state, raw(body + ', "age_seconds": 86401}'), NOW, err=err, age=None)
        assert "over a day" in err.getvalue(), err.getvalue()


def check_written_at_formats(module):                     # low b
    for stamp in (iso_at(NOW + 600), iso_at(NOW + 600)[:-1] + "+00:00", iso_at(NOW + 600)[:-1] + ".250Z",
                  iso_at(NOW + 600)[:-1] + ".123456789+00:00", iso_at(NOW + 600)[:-1] + "+00:00"):
        with tempfile.TemporaryDirectory() as state:
            path = fresh_file(state)
            assert pull_quiet(module, state, good(body_with(written_at=stamp)), NOW, age=5) == "marked-stale", stamp
    for stamp in (iso_at(NOW + 30)[:-1] + ".5+00:00", iso_at(NOW - 600)[:-1] + "+00:00", "garbage", 5):
        with tempfile.TemporaryDirectory() as state:
            assert pull_quiet(module, state, good(body_with(written_at=stamp)), NOW, age=5) == "wrote", stamp


def check_interleaved_pulls_cannot_lower_the_generation(module):   # panel 5
    import threading
    with tempfile.TemporaryDirectory() as state:
        held = fresh_file(state, json.dumps(body_with(generation=5, daemon_pid=42)), age=5)
        real = module.write_atomic
        started, results = threading.Event(), {}
        def slow(path, body, now, written=None):
            if body["generation"] == 9:
                started.set()
                time.sleep(0.5)            # pull B runs now; without the lock it checks against the old generation 5
            return real(path, body, now, written)
        module.write_atomic = slow
        def second():
            started.wait(5)
            results["b"] = pull_quiet(module, state, good(body_with(generation=7, daemon_pid=42)), NOW, age=5)
        thread = threading.Thread(target=second)
        thread.start()
        try:
            results["a"] = pull_quiet(module, state, good(body_with(generation=9, daemon_pid=42)), NOW, age=5)
        finally:
            thread.join(10)
            module.write_atomic = real
        assert results == {"a": "wrote", "b": "marked-stale"}, results
        assert json.loads(held.read_text())["generation"] == 9, "a lower generation overwrote a higher one"


def _hold_lock(state):
    import fcntl
    fd = os.open(state, os.O_RDONLY)
    fcntl.flock(fd, fcntl.LOCK_EX)
    return fd


def check_held_lock_skips_within_the_bound_and_writes_nothing(module):
    import threading
    with tempfile.TemporaryDirectory() as state:
        held = fresh_file(state, "OLD\n", age=5)
        before = (held.read_bytes(), held.stat().st_mtime_ns)
        fd = _hold_lock(state)
        out, err = {}, io.StringIO()
        def run():
            start = time.monotonic()
            out["r"] = pull_quiet(module, state, good(), NOW, err=err, age=5)
            out["t"] = time.monotonic() - start
        thread = threading.Thread(target=run, daemon=True)
        try:
            thread.start()
            thread.join(8)
            assert not thread.is_alive(), "the pull hangs on a held lock"
        finally:
            os.close(fd)
            thread.join(8)   # a blocked pull wakes on release: let it finish before the directory is removed
        assert out["r"] == "untouched" and out["t"] < 4, out
        assert "lock" in err.getvalue() and len(err.getvalue().splitlines()) == 1, err.getvalue()
        assert (held.read_bytes(), held.stat().st_mtime_ns) == before, "the held file changed without the lock"


def check_free_lock_writes(module):
    with tempfile.TemporaryDirectory() as state:
        fresh_file(state, "OLD\n", age=5)
        assert pull_quiet(module, state, good(), NOW, age=5) == "wrote"
        assert json.loads((Path(state) / "decisions.json").read_text())["generation"] == 7


def held_with(state, **kw):
    """A held file written by the pull itself, with the given keys removed (value None in kw removes the key)."""
    body = {k: v for k, v in body_with(**kw).items() if not (k in kw and kw[k] is _ABSENT)}
    pull_quiet(load(), state, good(body), NOW - 5)
    return Path(state) / "decisions.json"


_ABSENT = object()


def check_unusable_held_pid_is_judged_by_generation_alone(module):   # S18
    for held_pid in (_ABSENT, None, "7", True, [7], 1.5):
        for source_pid in (42, _ABSENT, held_pid):
            for gen, label in ((3, "lower"), (40, "same")):
                with tempfile.TemporaryDirectory() as state:
                    path = held_with(state, generation=40, daemon_pid=held_pid)
                    source = {k: v for k, v in body_with(generation=gen, daemon_pid=source_pid).items() if v is not _ABSENT}
                    assert pull_quiet(module, state, good(source), NOW) == "wrote", (held_pid, source_pid, label)
                    assert json.loads(path.read_text())["generation"] == gen


def check_pid_change_with_higher_generation_is_written(module):   # S19
    with tempfile.TemporaryDirectory() as state:
        path = held_state(state, generation=5, daemon_pid=7)
        assert pull_quiet(module, state, good(body_with(generation=9, daemon_pid=11)), NOW) == "wrote"
        got = json.loads(path.read_text())
        assert (got["generation"], got["daemon_pid"]) == (9, 11)


def check_same_pid_restart_at_generation_one(module):     # S20
    with tempfile.TemporaryDirectory() as state:
        path = held_state(state, generation=40, daemon_pid=7)
        again = good(body_with(generation=1, daemon_pid=7))
        err = io.StringIO()
        assert pull_quiet(module, state, again, NOW, err=err) == "marked-stale"
        assert json.loads(path.read_text())["generation"] == 40 and "--reset-generation" in err.getvalue()
        assert pull_quiet(module, state, again, NOW, reset_generation=True) == "wrote"
        assert json.loads(path.read_text())["generation"] == 1


