{
  "id": "R1",
  "title": "The daemon is killed while a worker finishes, then restarted",
  "problem": 4,
  "since_pr": 4,
  "tiers": ["offline", "lab-scripted"],
  "cast": {
    "platform": {"role": "orchestrator", "charter": 1},
    "coder": {"role": "coder", "reports_to": "platform", "issue": 2}
  },
  "steps": [
    {"at": "0s", "actor": "coder", "do": "turn", "lasts": "20s"},
    {"at": "10s", "actor": "world", "do": "kill-daemon", "why": "Down while the worker finishes at about 20 s"},
    {"at": "50s", "actor": "world", "do": "restart-daemon",
     "why": "A new process remembers nothing: the finished turn is derived again from v2"},
    {"at": "2m", "actor": "world", "do": "fact", "to": "platform", "key": "lab.fact:r1-later",
     "summary": "Another event", "why": "A later message: with no dedupe it would carry the worker's key again"},
    {"at": "4m", "actor": "world", "do": "wait"}
  ],
  "expect": [
    {"name": "worker-once", "that": "delivered", "to": "platform", "key": "worker.idle:*", "count": 1, "keys": 1},
    {"name": "later", "that": "delivered", "to": "platform", "key": "lab.fact:r1-later", "count": 1}
  ],
  "control": {"fault": "no-dedupe", "fails": ["worker-once"]}
}
